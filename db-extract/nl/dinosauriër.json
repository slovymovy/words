                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b9d16f3-bd7f-3da1-a234-13dfdd71bb0b",
                                        "entry_id": "cfeaf571-8c9d-3ffc-a636-c9bf135949a6",
                                        "glosses": [
                                            "Tiergruppe aus der Gruppe der Sauropsiden, die die ausgestorbenen Dinosaurier^([2]) und die rezenten Vögel umfasst"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44a8ae69-bb8f-4248-bb49-c1f4465323c8",
                                                "sense_id": "2b9d16f3-bd7f-3da1-a234-13dfdd71bb0b",
                                                "text": "Die Dinosaurier sind nicht ausgestorben, sie leben in Gestalt der Vögel bis heute."
                                            },
                                            {
                                                "example_id": "106139d4-eb90-4fe5-913d-ef12e470b705",
                                                "sense_id": "2b9d16f3-bd7f-3da1-a234-13dfdd71bb0b",
                                                "text": "Einer der bekanntesten Dinosaurier ist der Tyrannosaurus rex."
                                            },
                                            {
                                                "example_id": "95842ef0-0c66-44e0-a055-88f418e33ed8",
                                                "sense_id": "2b9d16f3-bd7f-3da1-a234-13dfdd71bb0b",
                                                "text": "„Vermutlich die älteste Baumpflanze der Erde, die sogar die Dinosaurier noch gesehen haben müssen, ist der Ginkgo, der Fächerblattbaum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05b2cb53-cf9e-3759-a62c-ffa3f99b0a58",
                                        "entry_id": "cfeaf571-8c9d-3ffc-a636-c9bf135949a6",
                                        "glosses": [
                                            "nach dem Mesozoikum ausgestorbenes, meist großes Reptil"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2bd2f79-0eab-4d05-8446-ab9137c74128",
                                                "sense_id": "05b2cb53-cf9e-3759-a62c-ffa3f99b0a58",
                                                "text": "Einer der bekanntesten Dinosaurier ist der Tyrannosaurus rex."
                                            },
                                            {
                                                "example_id": "df2c71a8-0ff2-4eb8-9fb2-6aedc9ebcefb",
                                                "sense_id": "05b2cb53-cf9e-3759-a62c-ffa3f99b0a58",
                                                "text": "„Vermutlich die älteste Baumpflanze der Erde, die sogar die Dinosaurier noch gesehen haben müssen, ist der Ginkgo, der Fächerblattbaum.“"
                                            },
                                            {
                                                "example_id": "e617aa59-6d23-4b57-82fc-d7fec52e17cb",
                                                "sense_id": "05b2cb53-cf9e-3759-a62c-ffa3f99b0a58",
                                                "text": "Die Dinosaurier wer'n immer trauriger - (Schlager)"
                                            },
                                            {
                                                "example_id": "d69dd71f-0a22-4a29-a96c-a774fbc3b9d2",
                                                "sense_id": "05b2cb53-cf9e-3759-a62c-ffa3f99b0a58",
                                                "text": "Es war wohl ein Meteoriteneinschlag, der die Dinosaurier auslöschte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9aa01ee6-7218-3cfb-bd3b-a72c78cb9413",
                                        "entry_id": "cfeaf571-8c9d-3ffc-a636-c9bf135949a6",
                                        "glosses": [
                                            "etwas Altes, nicht mehr Zeitgemäßes"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3d5800-3edc-49ab-be8b-a8ac42241772",
                                                "sense_id": "9aa01ee6-7218-3cfb-bd3b-a72c78cb9413",
                                                "text": "Für Umweltschützer sind Braunkohlekraftwerke Dinosaurier der Energiegewinnung."
                                            },
                                            {
                                                "example_id": "5b67fee7-e2c9-4242-bb88-e93f3f126525",
                                                "sense_id": "9aa01ee6-7218-3cfb-bd3b-a72c78cb9413",
                                                "text": "Mit über 45 Dienstjahren ist er ein Dinosaurier in seiner Branche."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
