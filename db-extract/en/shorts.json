                                        "tags": [
                                            "Anglicism",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc79e26-f70d-4105-9e6b-28c17161fdca",
                                                "sense_id": "97909dea-6a30-331e-8ab9-3fc12c24d79c",
                                                "text": "Bon, faut que je file, ma belle. Je vais être short sur ma pause dej sinon."
                                            },
                                            {
                                                "example_id": "c5b1a486-7deb-48f8-af10-04a318a0ddef",
                                                "sense_id": "97909dea-6a30-331e-8ab9-3fc12c24d79c",
                                                "text": "Allongé sur un divan, juste un short très short autour des reins, l’acteur lisait, lorsque nous nous annonçâmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88ce05aa-4268-3c04-834e-237fb6d5e93f",
                                        "entry_id": "4913dd25-a971-376a-97c8-35083fd78d7c",
                                        "glosses": [
                                            "Pris de court."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d1e2796-aa6b-4249-b154-ca1a03e9e8f0",
                                                "sense_id": "88ce05aa-4268-3c04-834e-237fb6d5e93f",
                                                "text": "Les spéculateurs sont shorts quand le marché monte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
