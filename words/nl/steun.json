                    "sense_id": "a51b0e90-a4c4-3f2c-b202-1403717b5eea",
                    "sense_definition": "Hulp of bijstand van morele of materiële aard.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_help",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dankzij de <w>steun</w> van een studiebeurs kon ze naar de universiteit.",
                            "target_lang_translations": {
                                "en": "Thanks to the <w>support</w> of a scholarship, she was able to go to university.",
                                "ru": "Благодаря <w>поддержке</w> стипендии она смогла поступить в университет.",
                                "it": "Grazie al <w>sostegno</w> di una borsa di studio, ha potuto frequentare l'università."
                            }
                        },
                        {
                            "text": "De burgemeester vroeg om de <w>steun</w> van de burgers voor het nieuwe plan.",
                            "target_lang_translations": {
