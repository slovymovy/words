                        "entry_id": "b5dd016e-1f40-3ea7-99b0-3bb5c6edb082",
                        "glosses": [
                            "A portion of fermenting dough diluted to a paste with water and then cooked."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "195f150b-8aa6-4584-b7b3-820ce4a44a83",
                                "sense_id": "c87f7158-c5be-350f-b4d6-73d2e61135c5",
                                "text": "A portion of the fermented paste may be mixed with three parts of water and boiled, resulting in an absit."
                            },
                            {
                                "example_id": "bcc3118c-eb28-4cc2-a918-e4dea936fdb9",
                                "sense_id": "c87f7158-c5be-350f-b4d6-73d2e61135c5",
                                "text": "The cooking gelatinizes the starch and makes the absit viscous."
                            },
                            {
                                "example_id": "8b201242-fc7a-4b0d-8ff4-62a8268b2deb",
                                "sense_id": "c87f7158-c5be-350f-b4d6-73d2e61135c5",
                                "text": "An absit is not made, and the baking is carried out on an open hotplate."
                            }
                        ]
                    }
