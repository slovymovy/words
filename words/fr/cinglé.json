        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4372fa1a-6a52-38b2-8f5e-e971e5643569",
                    "sense_definition": "Personne dont le comportement est fou, insensé ou déraisonnable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "folie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce conducteur roule à contresens sur l'autoroute, c'est un véritable <w>cinglé</w>.",
                            "target_lang_translations": {
                                "en": "This driver is driving the wrong way along the motorway. He's a real <w>nutcase</w>.",
                                "ru": "Этот водитель едет против движения по автостраде, он настоящий <w>псих</w>.",
                                "de": "Dieser Fahrer fährt auf der Autobahn in die falsche Richtung. Er ist ein echter <w>Verrückter</w>.",
                                "es": "Este conductor circula en sentido contrario por la autopista, es un verdadero <w>loco</w>.",
                                "zh": "这个司机竟然逆向行驶在高速公路上，真是个<w>疯子</w>。"
                            }
                        },
                        {
                            "text": "Ne fais pas attention à ce que raconte ce <w>cinglé</w>, il invente toujours n'importe quoi.",
                            "target_lang_translations": {
                                "en": "Don't pay any attention to what that <w>crackpot</w> says; he always talks complete nonsense.",
                                "ru": "Не обращай внимания на то, что говорит этот <w>псих</w>, он всегда несёт всякую чушь.",
                                "de": "Achte nicht darauf, was dieser <w>Spinner</w> erzählt, er erfindet immer irgendwelchen Unsinn.",
                                "es": "No le hagas caso a lo que cuenta ese <w>chiflado</w>, siempre inventa disparates.",
                                "zh": "别理那个<w>神经病</w>说的话，他总是胡编乱造。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fou",
                        "taré"
                    ],
                    "common_phrases": [
