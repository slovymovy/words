                "senses": [
                    {
                        "sense_id": "f65ed790-6b89-3989-91f4-a421e33b6a86",
                        "entry_id": "4c78e93c-3c50-3625-9824-2ada8cf267e9",
                        "glosses": [
                            "Darstellung eines Bühnenwerkes im Theater vor Publikum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4bebb1-9a3a-4b53-a728-cc0e896058b0",
                                "sense_id": "f65ed790-6b89-3989-91f4-a421e33b6a86",
                                "text": "„Sie saß da wie eine Zuschauerin in einer Theateraufführung.“"
                            },
                            {
                                "example_id": "fb172d4d-ec7d-416f-a379-bd5d68c4d365",
                                "sense_id": "f65ed790-6b89-3989-91f4-a421e33b6a86",
                                "text": "„Es gab keinen Ball, keine Schlittenfahrt, keine Theateraufführung, ohne dass Julie dabeigewesen wäre.“"
                            },
                            {
                                "example_id": "47cd1105-c0fe-49a9-b6eb-80f40fa56874",
                                "sense_id": "f65ed790-6b89-3989-91f4-a421e33b6a86",
                                "text": "„Es gab keine Theateraufführungen, jedoch Maskenbälle, auf denen man den Adel, die Bürger und die einfachen Mädchen traf; man gab auch kleine Gesellschaften, bei denen man Pharao spielte und sich mit geringen Kosten unterhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
