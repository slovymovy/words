                                            {
                                                "example_id": "8426c73b-46c5-40bd-91d6-15aa8b696a58",
                                                "sense_id": "78e04f22-4831-3c3e-a1c2-7af63f9e77a4",
                                                "text": "„Die Folgen der Grausamkeiten spürt Elisa bis heute, trotz jahrelanger Psychotherapie.“"
                                            },
