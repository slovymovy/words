                        "glosses": [
                            "Verdeckung einer Lichtquelle durch einen natürlichen Vorgang"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d12676e0-0f51-3329-8f66-b94ec23846f2",
