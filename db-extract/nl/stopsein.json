                            {
                                "example_id": "f10cd654-82cf-4c67-b871-9a9363ed5342",
                                "sense_id": "8e20c915-9ce6-3a36-b5b6-f27a8e259d4c",
                                "text": "Volgens de Belgische politie begon de achtervolging nadat de man in Kapellen ten noorden van Antwerpen een stopsein had genegeerd."
                            },
                            {
                                "example_id": "95829d11-c675-42d9-b67a-e4aebde0d7d2",
                                "sense_id": "8e20c915-9ce6-3a36-b5b6-f27a8e259d4c",
                                "text": "Door het gladde spoor gleed een metro voorbij een stopsein, aldus de IVW maandag. Dat gebeurde nadat de bestuurder van die metro al op de rem had getrapt. Het glijden is waarschijnlijk het gevolg van een niet goed functionerende smeerinstallatie."
                            }
                        ]
