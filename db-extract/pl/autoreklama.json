                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb13a5a-487a-4bfb-a676-929040bb290b",
                                "sense_id": "1a5ff705-150f-3689-a6c9-6bb12bb73502",
                                "text": "Początkowo sprawa wyglądała na żart gazety i autoreklamę ciemnoskórej, zamieszkałej w Londynie rosyjskiej fotomodelki Angeli Ermakowej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84980415-3ab1-41b5-abb7-f27a545e621a",
