                        "glosses": [
                            "Disposed to gripe; gripey."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd9579f-1423-4098-8ef5-61c4a170e151",
                                "sense_id": "07ef8ba9-5a02-3683-a7c7-2443e52b9d80",
                                "text": "Our imp, with gripeful longing, sought The nearest beer-saloon, A dozen brimming schooners bought And stowed in his \"galleon;\""
                            },
                            {
                                "example_id": "f5d679a6-d0cc-457d-8313-a288a9f28b85",
                                "sense_id": "07ef8ba9-5a02-3683-a7c7-2443e52b9d80",
                                "text": "It has been my good or my bad fortune, take it as you will, to watch the fabrication of \"fiz,\" in certain parts of the Palatinate, and I have been specially privileged to see the most gripeful of all gripy wines that I have ever attempted to drink, the famous Silesian Grüneberger, turned indifferently into Duc de Montebello or Heidsick Monopole, or anyone's Carte Blanche or Carte Noire."
                            },
                            {
                                "example_id": "da22b82b-fc8e-4820-b720-92e1a7ee506f",
                                "sense_id": "07ef8ba9-5a02-3683-a7c7-2443e52b9d80",
                                "text": "His attitude changed. He was less gripeful and more grateful."
                            },
                            {
                                "example_id": "40dc7de4-b1bd-4505-9ba0-6adc4856fc74",
                                "sense_id": "07ef8ba9-5a02-3683-a7c7-2443e52b9d80",
                                "text": "I don't know if any microbes and other germs have the ability to bite or sting, they are certainly included in this \"gripeful” critique."
                            }
                        ]
                    }
                ],
