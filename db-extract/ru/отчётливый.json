                        "sense_id": "414a1e6c-1a29-340e-88d4-ceaf35a4c623",
                        "entry_id": "b69c0938-a708-3079-ae1a-0bd87f08eecf",
                        "glosses": [
                            "ясно выраженный, чётко сформулированный"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9cc4ae4-59d0-47a7-894d-fffbd56ad4e6",
                        "source_entry_id": "b69c0938-a708-3079-ae1a-0bd87f08eecf",
                        "target_lang_word": "distinct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a870a38-a62e-37e3-8671-f0232dab8f95",
                                        "entry_id": "5fde17e5-b4c8-3d29-810c-78901a0bfca8",
                                        "glosses": [
                                            "Capable of being perceived very clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ccc2a0e-8694-4aed-9fd5-059c9f5cefd5",
                                                "sense_id": "5a870a38-a62e-37e3-8671-f0232dab8f95",
                                                "text": "Her voice was distinct despite the heavy traffic."
                                            },
                                            {
                                                "example_id": "a61e15de-9c9d-4bf1-9ee3-0c39a05c45bd",
                                                "sense_id": "5a870a38-a62e-37e3-8671-f0232dab8f95",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0195025a-4a1e-3110-81b4-4f34cc2bee26",
                                        "entry_id": "5fde17e5-b4c8-3d29-810c-78901a0bfca8",
                                        "glosses": [
                                            "Different from one another (with the preferable adposition being \\\"from\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82efcf97-ff9e-4c23-adfb-ff4fa544d8a6",
                                                "sense_id": "0195025a-4a1e-3110-81b4-4f34cc2bee26",
                                                "text": "Horses are distinct from zebras."
                                            },
                                            {
                                                "example_id": "c7cd9dd5-c882-4c56-b013-38270a48047c",
                                                "sense_id": "0195025a-4a1e-3110-81b4-4f34cc2bee26",
                                                "text": "“Yes, there are two distinct sets of footprints, both wearing rubber shoes—one I think ordinary plimsolls, the other goloshes,” replied the sergeant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa1f21a-95d6-3c22-a69a-d6e333822728",
                                        "entry_id": "5fde17e5-b4c8-3d29-810c-78901a0bfca8",
                                        "glosses": [
                                            "Noticeably different from others; distinctive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a34302d-5374-4573-bf4a-0d916a49cce1",
                                                "sense_id": "9aa1f21a-95d6-3c22-a69a-d6e333822728",
                                                "text": "Olga's voice is quite distinct because of her accent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62837b05-82d7-3e81-81dc-425db3671814",
                                        "entry_id": "5fde17e5-b4c8-3d29-810c-78901a0bfca8",
                                        "glosses": [
                                            "Separate in place; not conjunct or united; with from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16c415b6-9e03-47ea-88b0-a82858169f1b",
                                                "sense_id": "62837b05-82d7-3e81-81dc-425db3671814",
                                                "text": "The intention was that the two armies which marched out together should afterward be distinct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c64aa6f8-1349-3941-80d3-3c2a0c667b0e",
                                        "entry_id": "5fde17e5-b4c8-3d29-810c-78901a0bfca8",
                                        "glosses": [
                                            "Distinguished; having the difference marked; separated by a visible sign; marked out; specified."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f958a8-01fe-4ae5-9552-352b764459fb",
                                                "sense_id": "c64aa6f8-1349-3941-80d3-3c2a0c667b0e",
                                                "text": "Wherever thus created — for no place / Is yet distinct by name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4476cbd0-296f-38c9-ad4f-182885001ced",
                                        "entry_id": "5fde17e5-b4c8-3d29-810c-78901a0bfca8",
                                        "glosses": [
                                            "Marked; variegated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02d6ff5-11f1-484d-a51a-7d82c837c7df",
                                                "sense_id": "4476cbd0-296f-38c9-ad4f-182885001ced",
                                                "text": "The which [place] was dight / With divers flowres distinct with rare delight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "distinct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b904256-4921-3480-91de-4748a5796f2a",
                                        "entry_id": "6ed2af63-d869-3598-b34c-4006b0ffd710",
                                        "glosses": [
                                            "To distinguish; to make a distinction."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9283784d-27e6-46d1-a737-655ed8076749",
                                                "sense_id": "0b904256-4921-3480-91de-4748a5796f2a",
                                                "text": "Here every means is made use of to do away all distincting between federal and antifederal and I suspect with no very friendly design to the federal cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a2919d-0ae8-4452-bf3b-9591a88fd64c",
                        "source_entry_id": "b69c0938-a708-3079-ae1a-0bd87f08eecf",
                        "target_lang_word": "clear-cut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clear-cut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                        "entry_id": "c5576879-af96-3555-a6be-055b6e7bfc75",
                                        "glosses": [
                                            "Alternative form of clear cut."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f6e15a3-adaa-47fb-9329-893400f14f9f",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "The differences between slang, colloquialism and jargon are not clear-cut."
                                            },
                                            {
                                                "example_id": "54ede724-5491-4a57-89d8-cfc79e87e1f3",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "The most striking passage of the poem is the descant on nobility, which occupies nine out of the twenty-nine stanzas. Some of the lines in this have all the incisiveness of the clearest-cut aphorism."
                                            },
                                            {
                                                "example_id": "40ee1b37-1143-4db8-b962-067ac31e451d",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "When you deal for “Heart’s Haven” you are playing with a big-time picture. It is the clearest-cut answer to the query, “What does the public want?” that has been given by any picture released in months."
                                            },
                                            {
                                                "example_id": "5829fc30-00d8-4c85-a80a-c66070073e35",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "Legislation was to Mencius a phase of external discipline futile in the making of morality. To live naturally is to achieve virtue. He recognized the ancients, and acknowledged that a few of them were perfect (cf. Bk. IV, Pt. I, 4), but he insisted that men—himself, at least—could do without them, for of what value, said he, were they, if virtue lies within you? His theory is clearer-cut than anything Confucius had proposed; wherein he makes a weighty contribution."
                                            },
                                            {
                                                "example_id": "b7dd0bb1-eaad-4c1e-a3e7-ee390622c014",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "One of the questions which seem to recur more often that most is the reason for selection of the red light as a danger signal on railways. As in so many cases there is no clear-cut answer."
                                            },
                                            {
                                                "example_id": "6a32d881-c20e-4240-b5df-163da9cc6786",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "I want to congratulate you on the two outstanding articles in the April and May issues, which I believe would lend themselves excellently for combination in one booklet as they seem to complement each other and are to my mind the clearest-cut answers to modernism and unbelief."
                                            },
                                            {
                                                "example_id": "e6606e5b-2980-49e3-bccb-1eded0b17eeb",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "There were frequent assertions in the past that the “advice and consent” clause meant something more than the ratification of treaties and a late telephone call, but the fact of the matter is that Senator Fulbright’s reading of the Constitution is now widely accepted. Even with domestic matters, where the constitutional position is clearer-cut than with foreign affairs, it is the President who drafts the legislative program."
                                            },
                                            {
                                                "example_id": "4386a45e-89f8-4751-a0f6-fbf36fbfc4c9",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "I had no doubt as to how the vast majority of voters would respond. I was convinced that given such a clear-cut choice, the American people would elect to move forward with a program of social progress."
                                            },
                                            {
                                                "example_id": "359761c2-0f2c-4900-b4bc-6f945775e614",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "Altogether, they admit that the difficulties of mind-brain antimony have not been by any means surmounted; in fact, they are better off than Aristotle only in the sense that their taxonomy so much emphasized by Toulmin is clearer-cut than that of the Greeks or of Aquinas, and that they have the advantage of 2,500 years of additional biological studies which, with all the advances made, at least did not bring about reductionism, although they did not seem to bear as clearly on the subject of dualism."
                                            },
                                            {
                                                "example_id": "466e6fa4-30a7-4dbf-8b28-0706a6795214",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "France were supposedly a team in pieces, beaten by Tonga just a week ago and with coach Marc Lievremont publicly berating his players, but so clear-cut was their victory that much of the atmosphere had been sucked from the contest long before the end."
                                            },
                                            {
                                                "example_id": "fcb57af5-e5f5-474b-9278-58ac397baba2",
                                                "sense_id": "c0156192-cd7e-34df-b8af-563dc63203eb",
                                                "text": "While in the most serious cases mounting an investigation is usually mandatory, there are other occasions where it is less clear-cut or when it is concluded that an investigation would not fulfil RAIB's objectives to improve safety or prevent future accidents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
