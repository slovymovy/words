            {
                "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                "word": "dreadnought",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "da66213e-2767-4f4e-b010-8fe8ec11b031",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
