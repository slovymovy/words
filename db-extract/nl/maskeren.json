                ],
                "senses": [
                    {
                        "sense_id": "d715110f-3430-382f-a25e-ee70d72bce2e",
                        "entry_id": "2886cc47-915e-37c0-b39d-58676795322a",
                        "glosses": [
                            "zich ~: een masker opzetten."
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "2a9433fb-0096-4440-8a4e-d0d17dab572d",
                                "sense_id": "d715110f-3430-382f-a25e-ee70d72bce2e",
                                "text": "Zij maskerden zich voor een gemaskerd bal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37fd2625-ae8d-446f-8fd2-23d012e547bf",
                        "source_entry_id": "2886cc47-915e-37c0-b39d-58676795322a",
                        "source_sense_id": "d715110f-3430-382f-a25e-ee70d72bce2e",
                        "target_lang_word": "masquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9da71f53-56ae-3d72-8782-2fa2e3543d58",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Mettre un masque à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c63246-777e-43fc-8926-d1fcaaca1c05",
                                                "sense_id": "9da71f53-56ae-3d72-8782-2fa2e3543d58",
                                                "text": "À de rares exceptions près, à Paris, les hommes ne se masquent point : un homme en domino paraît ridicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ed4829-46e3-32f5-9aef-a47949a00a7b",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Le déguiser en lui mettant, outre le masque, des habits qui ne soient pas les siens."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a78f95-a524-403e-826b-da77aea40af8",
                                                "sense_id": "93ed4829-46e3-32f5-9aef-a47949a00a7b",
                                                "text": "Je vous masquerai, et vous ne serez pas reconnu."
                                            },
                                            {
                                                "example_id": "89a93df3-d32d-4c83-9bf7-e3ee7564b29f",
                                                "sense_id": "93ed4829-46e3-32f5-9aef-a47949a00a7b",
                                                "text": "On le masqua en arlequin."
                                            },
                                            {
                                                "example_id": "6de1aae1-32ed-40cb-a31a-b98f031743d8",
                                                "sense_id": "93ed4829-46e3-32f5-9aef-a47949a00a7b",
                                                "text": "Nous nous masquâmes pour aller au bal."
                                            },
                                            {
                                                "example_id": "2b8ade56-c2d6-4378-8335-48d0979f9a73",
                                                "sense_id": "93ed4829-46e3-32f5-9aef-a47949a00a7b",
                                                "text": "Un hypocrite qui se masque sous les dehors de la dévotion."
                                            },
                                            {
                                                "example_id": "9df716eb-5caf-435b-bcce-a40d23800549",
                                                "sense_id": "93ed4829-46e3-32f5-9aef-a47949a00a7b",
                                                "text": "Le vice se masque souvent sous l’apparence de la vertu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f1bd44-3a92-3b69-af91-e5705f82a9f3",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Couvrir ou cacher une chose de manière à en ôter la vue."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "748b5409-d9f8-464a-a850-10c521ab6c69",
                                                "sense_id": "e4f1bd44-3a92-3b69-af91-e5705f82a9f3",
                                                "text": "C'est ainsi qu'à la ferme de la Faille près de Sainte-Marie-en-Chaux, […], le Ranunculus fluitans déploie seul ses longues chevelures sur de larges étendues, masquant presque totalement les galets du fond."
                                            },
                                            {
                                                "example_id": "46a0ac29-fb9d-4c20-8a1b-4d7e79d46ea4",
                                                "sense_id": "e4f1bd44-3a92-3b69-af91-e5705f82a9f3",
                                                "text": "Nos animaux porteurs, débarrassés de leurs bâts, se sont égaillés parmi les arbres dans la direction d'une vallée boisée qui masque une mare saline."
                                            },
                                            {
                                                "example_id": "813e5e57-3799-454c-a8dc-9df865d1751f",
                                                "sense_id": "e4f1bd44-3a92-3b69-af91-e5705f82a9f3",
                                                "text": "Un camion de transport, un grumier, chargé de billes de sapins et dérobé par l'auteur du larcin, avait été placé sur la place, devant le monument pour masquer ce dernier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22837681-60f2-39c8-813f-12ecbea1a69e",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Cacher quelque chose sous de fausses apparences."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2272ada-9a25-4082-9992-7f2808d13a57",
                                                "sense_id": "22837681-60f2-39c8-813f-12ecbea1a69e",
                                                "text": "Masquer ses desseins, sa conduite."
                                            },
                                            {
                                                "example_id": "36a6d732-23f2-4aed-aa34-b777f8d0d069",
                                                "sense_id": "22837681-60f2-39c8-813f-12ecbea1a69e",
                                                "text": "La Cibot monta, vola, pour être exact, de la loge à l’appartement de ses deux messieurs, et se montra le visage masqué de tendresse, sur le seuil de la chambre où gémissaient Pons et Schmucke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5835a95-4273-3743-ac92-c62f45744b2a",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Positionner des troupes devant une place forte ou une armée pour la neutraliser sans pour autant l'attaquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b277e03-06a0-4efc-a44e-ae5176bc186b",
                                                "sense_id": "c5835a95-4273-3743-ac92-c62f45744b2a",
                                                "text": "Tandis qu'une partie de l’Armée Française recevait de front, dans la région de Charleroi. le choc de l'ennemi, la IIIᵉ Armée masquant la place forte de Metz, devait attaquer celui-ci de flanc, de Virton au nord de Longuyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a5d568e-ed47-3cae-9cef-7758e060b560",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Élever un ouvrage, disposer un obstacle ou un rideau devant une batterie pour que l’ennemi ne l’aperçoive pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6139f0e2-cbbb-435a-bf1a-8f75e2b3afd2",
                                                "sense_id": "3a5d568e-ed47-3cae-9cef-7758e060b560",
                                                "text": "Masquer une batterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf127448-47cc-33fe-a7fc-0c0b617c4ba6",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Recouvrir un mets d'une préparation quelconque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "474fc5c6-fdf7-3309-8a6f-298f8ac3459b",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Faire la tête, se renfrogner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5a5cd4-244d-4d86-ae7a-e4768118d25f",
                                                "sense_id": "474fc5c6-fdf7-3309-8a6f-298f8ac3459b",
                                                "text": "Lyse se masque immédiat …."
                                            },
                                            {
                                                "example_id": "6740e3dd-9d8b-4c58-aa89-60c5f4317d08",
                                                "sense_id": "474fc5c6-fdf7-3309-8a6f-298f8ac3459b",
                                                "text": "Il ne se masque pas. Rien ne les masque, les flics. Ils ont déjà accepté d'être flics, alors ils peuvent bien accepter tout le reste, après ça."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb2660e-bf80-3fc2-9a04-9c69a4e9fe27",
                                        "entry_id": "32ffc750-c97c-3dd8-a5e9-358d456d9c37",
                                        "glosses": [
                                            "Masquer en grand."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c657ce0d-b9bf-4136-b7a6-758754eeda8e",
                                                "sense_id": "0fb2660e-bf80-3fc2-9a04-9c69a4e9fe27",
                                                "text": "Le 10 février 1828, par 30° S. et 46° E. (43° 40' m. P. ), le navire de la compagnie le Buckingamshire éprouva un ouragan de la partie de l'E., qui, après avoir sauté au N. O., ne souffla pas avec moins de violence. Ce navire masqua après avoir eu ses huniers enlevés, ainsi que son porte-manteau et ses bastingages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
