                ],
                "senses": [
                    {
                        "sense_id": "27b3089a-e315-3ef9-be7f-135076cd5c30",
                        "entry_id": "2f16ce26-585b-3dab-bd02-6e41ce37bb30",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f230c77b-09c6-4c73-a6e4-e9730c6d836d",
                                "sense_id": "27b3089a-e315-3ef9-be7f-135076cd5c30",
                                "text": "Mój nauczyciel matematyki ma na imię Szczepan."
                            },
                            {
                                "example_id": "75e72443-3302-4b6f-900c-f97f64910c5b",
                                "sense_id": "27b3089a-e315-3ef9-be7f-135076cd5c30",
                                "text": "Pielgrzymkę prowadził ratownik i przewodnik tatrzański, ksiądz Szczepan Gacek, proboszcz parafii pw. Przemienienia Pańskiego w Gliczarowie"
                            },
                            {
                                "example_id": "7e5e6b58-9447-417d-b403-f05c8c46166e",
                                "sense_id": "27b3089a-e315-3ef9-be7f-135076cd5c30",
                                "text": "W Kościele katolickim na 26 grudnia (drugi dzień świąt Bożego Narodzenia) przypada wspomnienie św. Szczepana męczennika, patrona kamieniarzy, kucharzy i tkaczy."
                            },
                            {
                                "example_id": "a4c4553f-4840-428d-aa5c-623f20b8c284",
                                "sense_id": "27b3089a-e315-3ef9-be7f-135076cd5c30",
                                "text": "Szczepanowie dzień swego patrona, czyli imieniny, obchodzą 26 grudnia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b232b8c-0865-4c2c-982c-d72369696794",
                        "source_entry_id": "2f16ce26-585b-3dab-bd02-6e41ce37bb30",
                        "source_sense_id": "27b3089a-e315-3ef9-be7f-135076cd5c30",
                        "target_lang_word": "Štěpán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Štěpán",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "567e1407-93c6-31ed-87f1-b9bf7962f23b",
                                        "entry_id": "b2fc0159-ecaa-391c-a93a-5981662acd4c",
                                        "glosses": [
                                            "mužské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182803c0-3161-4bc0-a8b1-dfbf31a4511f",
                                                "sense_id": "567e1407-93c6-31ed-87f1-b9bf7962f23b",
                                                "text": "Koleda, koleda, Štěpáne, co to neseš ve džbáně?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Štěpán",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d27a88c2-9f0c-302c-b456-bb662061c7a7",
                                        "entry_id": "b22f9552-c183-37a3-8052-2f082f543dc0",
                                        "glosses": [
                                            "české příjmení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa2abc4-6a75-443d-86b3-868d32405929",
                                                "sense_id": "d27a88c2-9f0c-302c-b456-bb662061c7a7",
                                                "text": "Pražský komunistický tajemník Miroslav Štěpán byl jediným pohlavárem odsouzeným po Listopadu za trestné činy přímo spojené s výkonem stranických funkcí."
                                            },
                                            {
                                                "example_id": "3fd3221b-80c6-4001-b583-199a59c839c3",
                                                "sense_id": "d27a88c2-9f0c-302c-b456-bb662061c7a7",
                                                "text": "Na Štěpána bez Štěpána!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0e4c4ff-a5cb-4403-a671-7567afaeddf7",
                        "source_entry_id": "2f16ce26-585b-3dab-bd02-6e41ce37bb30",
