                    },
                    {
                        "translation_id": "e310ac33-db0c-40f2-988a-cd28d6d6488f",
                        "source_entry_id": "6fbb7ef7-4cf3-3cd2-96b4-a4759d9a6330",
                        "source_sense_id": "35df28ca-93ba-3ac4-909e-74f35777271b",
                        "source_sense_description": "the act of becoming unravelled (collapsing)",
                        "target_lang_word": "Zusammenbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                        "entry_id": "64c84be7-06eb-325e-b6e1-2d18ba88b763",
                                        "glosses": [
                                            "wirtschaftlicher oder finanzieller Absturz einer Person oder eines Systems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08f4ec42-bf00-44fc-b293-8641de606bab",
                                                "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                                "text": "Als Anklage gegen den Urheber des Schneeballsystemes erhoben wurde, bedeutete das gleichzeitig den Zusammenbruch des gesamten Systemes."
                                            },
                                            {
                                                "example_id": "5971e91a-847b-4c3b-93ed-f7a61cd1cf60",
                                                "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                                "text": "Wer kennt schon alle Gründe für den Zusammenbruch des Kommunismus?"
                                            },
                                            {
                                                "example_id": "d7160420-ad77-4521-8787-4edb1b7810a6",
                                                "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            },
                                            {
                                                "example_id": "e4b4559e-eaf5-4a0d-b845-eca2c903b577",
                                                "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                                "text": "„Wer den Zusammenbruch von 1933 begreifen will, muß die Ereignisse der Jahre 1918 und 1919 in Deutschland kennen, von denen ich hier erzähle.“"
                                            },
                                            {
                                                "example_id": "2fdc4649-80d2-44c7-a39e-c9a1c47f69ef",
                                                "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                                "text": "[…] die Welt trägt heute wohl ein so großes Risiko für einen Zusammenbruch wie noch nie."
                                            },
                                            {
                                                "example_id": "d7d77926-5c0f-4730-87c0-723169886629",
                                                "sense_id": "ef773d30-7a9a-3911-b0c8-1f41c2052f4c",
                                                "text": "„Der Zusammenbruch war offenkundig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27a8ef53-bce7-3920-94e8-41c4e0e6774d",
                                        "entry_id": "64c84be7-06eb-325e-b6e1-2d18ba88b763",
                                        "glosses": [
                                            "plötzliche gesundheitliche Schädigung des Körpers ohne äußere Einwirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b958819e-85e5-4323-9061-41bb591b00fe",
                                                "sense_id": "27a8ef53-bce7-3920-94e8-41c4e0e6774d",
                                                "text": "Seit ihrem Zusammenbruch nach dem Tode ihres Mannes war sie nie wieder die Alte."
                                            },
                                            {
                                                "example_id": "d413fc71-0aa5-4fbf-9b19-c1877b8d754a",
                                                "sense_id": "27a8ef53-bce7-3920-94e8-41c4e0e6774d",
                                                "text": "„Sie war so groß, daß sie Zusammenbrüche verhinderte, während hier die Erschöpfung durch die so nahe Rettung, die plötzlich wieder in Frage gestellt wurde, sie eher verstärkte.“"
                                            },
                                            {
                                                "example_id": "e0cb5611-645e-421c-9a51-5ad8925c7c56",
                                                "sense_id": "27a8ef53-bce7-3920-94e8-41c4e0e6774d",
                                                "text": "„Dazwischen lag ein turbulentes Leben mit gesundheitlichen Zusammenbrüchen in immer kürzer werdenden Abständen.“"
                                            },
                                            {
                                                "example_id": "6eaf2c8b-49f3-4691-b651-c13d73939967",
                                                "sense_id": "27a8ef53-bce7-3920-94e8-41c4e0e6774d",
                                                "text": "„Am Ende der Gymnasialzeit stand der körperliche Zusammenbruch und die völlige Abwendung vom Christentum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80d43287-c291-4c48-af60-2b969e5cd050",
                        "source_entry_id": "6fbb7ef7-4cf3-3cd2-96b4-a4759d9a6330",
                        "source_sense_id": "35df28ca-93ba-3ac4-909e-74f35777271b",
                        "source_sense_description": "the act of becoming unravelled (collapsing)",
                        "target_lang_word": "Kollaps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kollaps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb1cfa33-8991-3f97-a5e5-3645a10c923f",
                                        "entry_id": "62e7261f-5580-3c3a-be37-e1ceed619b0f",
                                        "glosses": [
                                            "plötzliches Ende der Funktionsfähigkeit eines Körpers oder Systems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc83c55e-4af6-4147-9296-d73c61ac14e3",
                                                "sense_id": "bb1cfa33-8991-3f97-a5e5-3645a10c923f",
                                                "text": "Erwin erlitt einen Kollaps."
                                            },
                                            {
                                                "example_id": "10af5572-eefc-4be1-88d2-b660684e315b",
                                                "sense_id": "bb1cfa33-8991-3f97-a5e5-3645a10c923f",
                                                "text": "„Nur mit Mühe und staatlicher Hilfe waren ihre Institute dem Kollaps entkommen, der die ganze Weltwirtschaft mit in den Abgrund zu reißen drohte.“"
                                            },
                                            {
                                                "example_id": "6a37fe17-8caa-4926-9d3b-90adb0c5d388",
                                                "sense_id": "bb1cfa33-8991-3f97-a5e5-3645a10c923f",
                                                "text": "„Aufgrund der Schwere ihres Kollapses sei es für längere Zeit unmöglich, Konzerte zu geben, hatten die Ärzte gesagt; sie müsse erst an Körper, Geist und Seele gesund werden.“"
                                            },
                                            {
                                                "example_id": "0b8b493c-2c0c-47dd-a8ba-dcfa3e9bfd8c",
                                                "sense_id": "bb1cfa33-8991-3f97-a5e5-3645a10c923f",
                                                "text": "„Die sogenannte Kleine Eiszeit zwischen 1550 und 1750 geht Ruddiman zufolge auf den Kollaps der indigenen Kulturen zurück.“"
                                            },
                                            {
                                                "example_id": "d421def9-9d38-424a-afd1-981fa9226240",
                                                "sense_id": "bb1cfa33-8991-3f97-a5e5-3645a10c923f",
                                                "text": "„Offenbar gehörte nicht viel dazu, eine Stadt wie Berlin lahmzulegen. Ein paar unpassierbare Straßen und schon drohte der Kollaps.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
