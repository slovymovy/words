                },
                {
                    "sense_id": "720d3df4-00dd-3c66-b724-5b476e027923",
                    "sense_definition": "A quad bike; a small open vehicle with four wheels designed for off-road use.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire weekend riding his <w>quad</w> through the muddy forest trails.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные, катаясь на своем <w>квадроцикле</w> по грязным лесным тропам."
                            }
                        },
                        {
                            "text": "You should always wear a helmet when you are driving a <w>quad</w> in the desert.",
                            "target_lang_translations": {
                                "ru": "Всегда следует надевать шлем, когда едешь на <w>квадроцикле</w> в пустыне."
