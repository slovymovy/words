                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расколол",
                                "target_lang_sense_clarification": "прошедшее время от раскалывать"
                            },
                            {
                                "target_lang_word": "разорвал",
                                "target_lang_sense_clarification": "прошедшее время от разрывать"
                            }
