                        "translation_id": "f08863b6-3c3a-4ca7-ae9f-59bfef61b33d",
                        "source_entry_id": "b08c50d8-8f3e-3cfd-8225-4476a0245323",
                        "source_sense_id": "8096aa2a-8b9f-3c07-a48f-361d96a89e45",
                        "target_lang_word": "phrenologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phrenologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735179fc-c352-3be5-9906-3f746e61c8c9",
                                        "entry_id": "0874ed22-0b3e-3be8-a607-c19b8d7a00f6",
                                        "glosses": [
                                            "An adherent or practitioner of phrenology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc57cace-9dac-4544-bbb8-ce698687e6cb",
                                                "sense_id": "735179fc-c352-3be5-9906-3f746e61c8c9",
                                                "text": "The phrenologist, who regulates heart and mind by undulations of the skull, has another system."
                                            },
                                            {
                                                "example_id": "51282ec3-4fc8-4e6e-8fe2-752540ff2c58",
                                                "sense_id": "735179fc-c352-3be5-9906-3f746e61c8c9",
                                                "text": "One significance weakness of phrenology in the eyes of most anatomists, as Anne Harrington has shown, was that the brain comprised two structurally identical cerebral hemispheres, separated by a longitudinal fissure, whereas phrenologists held that the material sub-stratum of various mental faculties was located in only one hemisphere, and not its twin."
                                            },
                                            {
                                                "example_id": "bb40735c-c09d-4de3-b306-64a5ca14281b",
                                                "sense_id": "735179fc-c352-3be5-9906-3f746e61c8c9",
                                                "text": "During a skull reading, a phrenologist would measure and carefully feel a person’s head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d80eddf-98ae-4746-9d43-ebd903408b28",
                        "source_entry_id": "b08c50d8-8f3e-3cfd-8225-4476a0245323",
                        "source_sense_id": "8096aa2a-8b9f-3c07-a48f-361d96a89e45",
