                "senses": [
                    {
                        "sense_id": "949f260d-74d1-39ad-a95e-4eff02ff63fc",
                        "entry_id": "48dff9ba-3f93-373a-a683-cd927b241a0f",
                        "glosses": [
                            "Apostasier une religion qui consacre la circoncision (judaïsme ou islam)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c70faa-bb39-46a0-a7dc-f45506090c07",
                                "sense_id": "949f260d-74d1-39ad-a95e-4eff02ff63fc",
                                "text": "Les turcs acceptoient plus tost la mort très aspre que de se descirconcire pour se baptiser."
                            },
                            {
                                "example_id": "a613877c-53d0-4502-a5fc-a165b7d86968",
                                "sense_id": "949f260d-74d1-39ad-a95e-4eff02ff63fc",
                                "text": "Une fois décirconcis, vous pourrez suivre vos spéculations, placer à gros intérêt, donner des fonds sur nantissement, ruiner mille jeunes gens, duper vos associés, sans que personne ait le plus petit mot à dire."
                            },
                            {
                                "example_id": "ae908f45-6728-46c8-bcd0-1eff3588e056",
                                "sense_id": "949f260d-74d1-39ad-a95e-4eff02ff63fc",
                                "text": "Comme la circoncision est quelque chose de physique qui ne peut être défait, décirconcire et décirconcision ne sont pas de bons mots."
                            }
                        ]
                    },
                    {
                        "sense_id": "79f0f883-7d8b-3551-adb0-90036c65cf92",
                        "entry_id": "48dff9ba-3f93-373a-a683-cd927b241a0f",
                        "glosses": [
                            "Reconstituer le prépuce d’une personne circoncise, le restaurer."
                        ],
