                "senses": [
                    {
                        "sense_id": "5d31244c-6f09-3a7b-81b3-3b48d3eb9d59",
                        "entry_id": "6ff1a0e1-db38-3b7b-80e1-404a2529a0f3",
                        "glosses": [
                            "Par ellipse, horloge fabriquée en Franche-Comté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14375e0a-2bfe-4bb5-b3c1-9fe630c62f91",
                                "sense_id": "5d31244c-6f09-3a7b-81b3-3b48d3eb9d59",
                                "text": "La salle est vide, ils sont les seules clients du café, on entend le tic-tac d’une grosse comtoise, le patron nettoie son zinc en bavardant avec le passeur."
                            },
                            {
                                "example_id": "de8d77fb-b36c-4781-900c-1b616905be55",
                                "sense_id": "5d31244c-6f09-3a7b-81b3-3b48d3eb9d59",
                                "text": "Ma fille, nichée sur mes genoux, la tête dans mon cou, demeurait le plus souvent sage ou bien battait des jambes dans le vide pour marquer le temps comme le balancier d’une comtoise."
                            },
                            {
                                "example_id": "41adc98b-05d3-4c4e-81c1-0fa07c4551fd",
                                "sense_id": "5d31244c-6f09-3a7b-81b3-3b48d3eb9d59",
                                "text": "Je reconnaissais la comtoise de chêne, définitivement arrêtée sur un heure, sur un moment du passé."
                            }
                        ]
                    }
                ],
