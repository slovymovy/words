                    {
                        "sense_id": "4292abb7-729f-30fe-9824-245245c3984f",
                        "entry_id": "de486187-09bb-338f-a5e9-37f677a3c0d2",
                        "glosses": [
                            "kupka ziemi wyrzuconej przez kreta, kretowisko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc07771-496d-4671-bb9b-980468973f6e",
                                "sense_id": "4292abb7-729f-30fe-9824-245245c3984f",
                                "text": "Świeżego koziego gnoju posypać na kretowinach, a sam zapach wypędza nieproszonych gości"
                            },
                            {
                                "example_id": "99beeb35-d009-405c-a7ab-1484f5bce89b",
                                "sense_id": "4292abb7-729f-30fe-9824-245245c3984f",
                                "text": "W każdą kretowinę zdechłych raków nakłaść, bo krety od smrodu tego zdychać muszą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
