                "senses": [
                    {
                        "sense_id": "ffcbb2a3-a2bb-3397-8af3-7097874bc7a4",
                        "entry_id": "341c032b-3827-347c-bde4-6620d576027b",
                        "glosses": [
                            "сорт минеральной воды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db3ece7-65bf-4e70-9779-8aeee0b01635",
                                "sense_id": "ffcbb2a3-a2bb-3397-8af3-7097874bc7a4",
                                "text": "Поздно пить боржоми, когда почки отказали."
                            },
                            {
                                "example_id": "934a101f-3275-44f0-bfb0-03fb2e4b7a1d",
                                "sense_id": "ffcbb2a3-a2bb-3397-8af3-7097874bc7a4",
                                "text": "Я предлагала боржоми, но со мной не считаются…"
                            },
                            {
                                "example_id": "24090cd0-7819-42a4-bb3a-d5e0045f22e0",
                                "sense_id": "ffcbb2a3-a2bb-3397-8af3-7097874bc7a4",
                                "text": "Третья стадия, когда все уже несколько раз переменили места и теперь каждый вяло ест из чужой тарелки остатки чужой еды, пьет водку из фужера и запивает боржоми из рюмки-наперстка."
                            }
                        ]
                    }
                ],
