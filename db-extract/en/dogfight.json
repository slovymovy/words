                    {
                        "translation_id": "27077b85-5525-48fc-b52e-17c99b16349c",
                        "source_entry_id": "52689d34-46c5-3da1-967f-e325d18622b1",
                        "source_sense_id": "25d76245-c15a-3c1c-b96b-55744992299e",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Nahkampf",
