                    {
                        "sense_id": "ea0eb7fc-2ff5-35f0-a21f-e011bcef2376",
                        "entry_id": "cc123456-9487-35b5-ac5f-e4337b4078b7",
                        "glosses": [
                            "Latino-américain, d’origine latino-américaine."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "26e06458-6b29-44c1-8e8a-f5f2add038d9",
                                "sense_id": "ea0eb7fc-2ff5-35f0-a21f-e011bcef2376",
                                "text": "When the artists choose to create phenotypically dark and/or non-Caucasian featured Latinx superheroes, they offer not only a richer and more complete representation of what it means to look and be Latinx but another way for the writers to efficiently use the verbal elements to further complicate Latinx identity and experience by offering a greater range of backstories."
                            }
                        ]
                    }
