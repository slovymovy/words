                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5770e6dd-3b23-4219-8c42-6c8ffcb94dc9",
                                                "sense_id": "b1d13d4f-96d2-3513-a55d-b093322d1660",
                                                "text": "He was the defiant homesteader, the crusty senior member of a research team who understood Algol and Fortran but couldn't read the secrets of his own heart."
                                            },
                                            {
                                                "example_id": "dcf4202b-b559-4d49-862d-8a37762284a9",
                                                "sense_id": "b1d13d4f-96d2-3513-a55d-b093322d1660",
                                                "text": "Algol, on the other hand, introduced the notion of block structure, in which the programmer could group lists of statements, effectively creating one instruction out of a list of instructions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
