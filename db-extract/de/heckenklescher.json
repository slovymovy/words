                "senses": [
                    {
                        "sense_id": "7df397e4-157a-33d2-bd4d-13d369f7e771",
                        "entry_id": "eaef3fe2-0e0b-3ff2-be51-b210fe28ad79",
                        "glosses": [
                            "lokale, abwertende Bezeichnung für die Weinsorte Uhudler oder Schilcher in der Steiermark"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2876dc0-926a-479e-8a10-3134ee31c996",
                                "sense_id": "7df397e4-157a-33d2-bd4d-13d369f7e771",
                                "text": "Gestern habe ich einen Heckenklescher getrunken."
                            },
                            {
                                "example_id": "89f83c11-eaa9-4e7e-97be-1e7e98bf1e52",
                                "sense_id": "7df397e4-157a-33d2-bd4d-13d369f7e771",
                                "text": "„Ein Heckenklescher, so sagen sie, sei der Schilcher und nichts sonst, ein Direktträger, ein saurer, billiger Hauswein, eine Gefährdung der trinkenden Menschheit, weil er Methylalkohol enthalte und daher auf die Dauer blind mache, […]“"
                            },
                            {
                                "example_id": "ed10a47b-d475-40a0-ba01-6ba4f6c95e8b",
                                "sense_id": "7df397e4-157a-33d2-bd4d-13d369f7e771",
                                "text": "„Und deshalb nahmen sie es auch geduldig bis humorvoll zur Kenntnis, wenn ihr Schilcher von Zugereisten schnöderweise als Rabiatperle, Beuschlreißer, Messerstecherwein, Hemmadspratzer oder schlicht als Heckenklescher bezeichnet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3293fbe6-8c00-32b4-838a-b8c8d384b525",
                        "entry_id": "eaef3fe2-0e0b-3ff2-be51-b210fe28ad79",
                        "glosses": [
                            "abwertend für einen sauren Wein (Steiermark)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461f2a44-4ff4-4c7f-91eb-f976a8d4ae17",
                                "sense_id": "3293fbe6-8c00-32b4-838a-b8c8d384b525",
                                "text": "\"Nun, ein wenig Süße würde ihm heuer sicherlich gut tun nach diesem doch eher verregneten Sommer, sonst könnte es heißen: der 97er sei ein „Sauerampfer\", oder wie ich es einmal in der Steiermark gehört habe: Heckenklescher, Nordhang, sonnenarm.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
