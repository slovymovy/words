                            },
                            {
                                "example_id": "11dca38e-bddc-430d-bd0c-fd577b6a1df1",
                                "sense_id": "6d98471b-1bf1-3528-8ad9-e147831b7f65",
                                "text": "подвести́ дом под кры́шу",
