                "senses": [
                    {
                        "sense_id": "07f311b8-fe4d-3494-8c8d-c92900d0c40c",
                        "entry_id": "476ab88e-07f1-3058-afd2-f226e514f7d3",
                        "glosses": [
                            "to become picky with food, having had too much to eat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "725e2d5b-6730-3d3e-9408-f4e42f7f3739",
                        "entry_id": "476ab88e-07f1-3058-afd2-f226e514f7d3",
                        "glosses": [
                            "to start taking things for granted, to become greedy, picky or self-obsessed due to having a life of abundance, being coddled, having good living/working/etc. conditions"
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "85fbce80-28f1-4683-b120-f4c85ee7c184",
                                "sense_id": "725e2d5b-6730-3d3e-9408-f4e42f7f3739",
                                "text": "Бога́тые лю́ди, кото́рые и так зажрали́сь, хотя́т ещё бо́льше де́нег.",
                                "translation": "Rich people who are already wealthy want even more money.",
                                "english": "Rich people who are already wealthy want even more money."
                            }
                        ]
                    }
                ],
