                                    {
                                        "sense_id": "343e1afb-e124-35f7-b16b-6fd858518220",
                                        "entry_id": "f2eee5ff-a30a-3578-9626-d673d73de2c3",
                                        "glosses": [
                                            "Spécialiste de l’anthropologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0187af54-9653-4011-9019-ec2cb87d6a8a",
                                                "sense_id": "343e1afb-e124-35f7-b16b-6fd858518220",
                                                "text": "Comme il s’agissait de l’alimentation de base de cette mère, je me devais, en tant qu’anthropologue, de respecter la culture locale et de ne pas intervenir dans une pratique alimentaire si répandue."
                                            },
                                            {
                                                "example_id": "d139b3c1-c1c9-4d26-b619-5b8664866055",
                                                "sense_id": "343e1afb-e124-35f7-b16b-6fd858518220",
                                                "text": "Or, ce que je vais découvrir en Amazonie, c’est le processus de destruction des environnements que l’on qualifie de “naturels”… mais qui sont en partie le produit d’actions humaines, comme l’ont montré mes travaux et ceux d’autres anthropologues."
                                            },
                                            {
                                                "example_id": "a2a0c873-d971-4102-9100-9c1bfcfca972",
                                                "sense_id": "343e1afb-e124-35f7-b16b-6fd858518220",
                                                "text": "« Il y a sans doute un tabou encore un peu prégnant à Noël, mais je crois que la tendance va se démocratiser au fur et à mesure », estime Dominique Desjeux, anthropologue spécialiste de la consommation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bad3b17b-bc1d-4026-b51e-4becf2d73e10",
                        "source_entry_id": "7c29e4ac-ff69-3302-aaff-7381c9b955dc",
                        "source_sense_id": "a4783801-7bb1-336d-bf5d-ea2f3b3c78b1",
                        "source_sense_description": "one who is versed in anthropology",
                        "target_lang_word": "Anthropologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthropologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e87cbe67-188d-3963-843f-86bbab290ffa",
                                        "entry_id": "ed828e9a-9353-3424-8386-d7a0af9edb0a",
                                        "glosses": [
                                            "ein Wissenschaftler, der sich mit der Anthropologie beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9592cb3-3007-40bc-a758-fb153b2a66ea",
                                                "sense_id": "e87cbe67-188d-3963-843f-86bbab290ffa",
                                                "text": "„Die Anthropologen konnten nachweisen, dass der Besitzer mit etwa 25 bis 30 Jahren starb.“"
                                            },
                                            {
                                                "example_id": "bcd9fa06-ed86-4305-85ac-31f3ed0a84df",
                                                "sense_id": "e87cbe67-188d-3963-843f-86bbab290ffa",
                                                "text": "„Der Anthropologe Jomo Kenyatta, charismatischer Führer der KAU und Teil des gemäßigten Flügels, distanziert sich von den Mau-Mau und fordert ein Ende der Gewalt.“"
                                            },
                                            {
                                                "example_id": "e0fee1f7-1f03-4859-9e38-ee8cc47d5a14",
                                                "sense_id": "e87cbe67-188d-3963-843f-86bbab290ffa",
                                                "text": "„Frühe Archäologen und Anthropologen fanden immer mehr Ähnlichkeiten zwischen den indigenen Bevölkerungen der polaren Regionen Sibiriens, Nordamerikas und Grönlands.“"
                                            },
                                            {
                                                "example_id": "2a21cbb5-1082-4117-bc27-2830a1855919",
                                                "sense_id": "e87cbe67-188d-3963-843f-86bbab290ffa",
                                                "text": "„Außerdem befassen sich noch die Althistoriker mit den Kelten, die die Berichte antiker Autoren auswerten, sowie Genetiker und Anthropologen, die versuchen, aus Knochen und anderen biologischen Materialien Befunde abzuleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c32fd63-fa09-48ae-915c-eecf8e279709",
                        "source_entry_id": "7c29e4ac-ff69-3302-aaff-7381c9b955dc",
                        "source_sense_id": "a4783801-7bb1-336d-bf5d-ea2f3b3c78b1",
