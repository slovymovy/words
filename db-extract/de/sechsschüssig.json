                ],
                "senses": [
                    {
                        "sense_id": "3daa7313-d35a-3794-bf7c-32b6e4724051",
                        "entry_id": "fd8268bc-50cd-3450-8d1e-006d741d326a",
                        "glosses": [
                            "sechs Patronen enthaltend, über sechs Schuss verfügend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d41cd27-857c-488c-b43e-4169989c06b1",
                                "sense_id": "3daa7313-d35a-3794-bf7c-32b6e4724051",
                                "text": "„Bei unserem Abschluss händigte man jedem von uns Ausweise, einen sechsschüssigen Revolver vom Typ .38 Smith & Wesson Model 10 und sechs Patronen aus und gab uns die Anweisung, die Stadt so schnell wie möglich zu verlassen.“"
                            },
                            {
                                "example_id": "155470c0-1cc2-4b68-8433-12b756a35154",
                                "sense_id": "3daa7313-d35a-3794-bf7c-32b6e4724051",
                                "text": "„Floridas Cops und Deputy Sheriffs mussten so schnell wie möglich lernen, anstatt wie bisher gegen nicht allzu gefährliche sechsschüssige Revolver nun in regelrechten Straßenschlachten gegen Schwerbewaffnete vorzugehen, die skrupellos töteten und den eigenen Tod nicht fürchteten, um ihr Millionengeschäft zu verteidigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
