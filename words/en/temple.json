                            {
                                "target_lang_word": "храм",
                                "target_lang_sense_clarification": "общее название культового здания"
                            },
                            {
                                "target_lang_word": "капище",
                                "target_lang_sense_clarification": "языческий храм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e75657ea-4b6e-3315-9143-596c51c27340",
                    "sense_definition": "A Jewish house of worship, particularly one belonging to a Reform or Conservative congregation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family attends <w>temple</w> every Friday evening for the Sabbath service.",
                            "target_lang_translations": {
                                "ru": "Семья посещает <w>синагогу</w> каждый вечер пятницы для субботнего богослужения."
                            }
                        },
                        {
                            "text": "Our local <w>temple</w> is hosting a community event for the upcoming holiday.",
                            "target_lang_translations": {
                                "ru": "Наш местный <w>храм</w> организует общественное мероприятие к предстоящему празднику."
                            }
                        }
                    ],
                    "synonyms": [
                        "synagogue"
                    ],
                    "common_phrases": [
                        "go to temple",
                        "jewish temple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Еврейский молитвенный дом, особенно принадлежащий к реформистскому или консервативному течению."
