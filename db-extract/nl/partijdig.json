                                "target_senses": [
                                    {
                                        "sense_id": "88d75a68-01d0-3b1a-9abb-60dfaafd9e8e",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Existing as a part or portion; incomplete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8ab1f8-faa6-4f08-8d24-3301513f6b4e",
                                                "sense_id": "88d75a68-01d0-3b1a-9abb-60dfaafd9e8e",
                                                "text": "So far, I have only pieced together a partial account of the incident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cd500c-9353-3f74-8ac2-141064d660bb",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Describing a property that holds only when an algorithm terminates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "479e3aca-f79d-494a-b5b0-90f956545df7",
                                                "sense_id": "14cd500c-9353-3f74-8ac2-141064d660bb",
                                                "text": "It's easy to prove partial correctness, but it's not obvious that it is also totally correct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3b9c7a-3b5c-327b-9c6b-0d17b1c4cb47",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Biased in favor of a person, side, or point of view, especially when dealing with a competition or dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3765c680-03e6-4dea-988f-16ffedc6bad5",
                                                "sense_id": "da3b9c7a-3b5c-327b-9c6b-0d17b1c4cb47",
                                                "text": "The referee is blatantly partial!"
                                            },
                                            {
                                                "example_id": "f3be1a35-ef85-40fc-93ef-096f4162c5a9",
                                                "sense_id": "da3b9c7a-3b5c-327b-9c6b-0d17b1c4cb47",
                                                "text": "God is not partial; he does not play favorites."
                                            },
                                            {
                                                "example_id": "a1ab9dea-a337-42e9-9cb1-4309fe6547b4",
                                                "sense_id": "da3b9c7a-3b5c-327b-9c6b-0d17b1c4cb47",
                                                "text": "17th century, Alexander Pope, a letter\npartial parent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45be7c50-2254-393c-9ee6-aacb4bb434e5",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Having a predilection for something."
                                        ],
                                        "tags": [
                                            "followed by the preposition to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07cc2fd-a15c-494d-bc33-e039f7751b16",
                                                "sense_id": "45be7c50-2254-393c-9ee6-aacb4bb434e5",
                                                "text": "not partial to an ostentatious display"
                                            },
                                            {
                                                "example_id": "c3ada6ce-074e-4e03-8d70-a28ae9a8a1c4",
                                                "sense_id": "45be7c50-2254-393c-9ee6-aacb4bb434e5",
                                                "text": "But if a woman is partial to a man, and does not endeavour to conceal it, he must find it out."
                                            },
                                            {
                                                "example_id": "9c617e81-95e9-4fa2-937a-7280dc0fe355",
                                                "sense_id": "45be7c50-2254-393c-9ee6-aacb4bb434e5",
                                                "text": "of"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18751d77-3a9c-3cec-ae80-635ae2a60ca5",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Of or relating to a partial derivative or partial differential."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db6953be-1816-3c0e-8107-419c7dbe01eb",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Subordinate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db0c49ec-2b99-387e-9b3f-663c5ad655df",
                                        "entry_id": "fbd57e2d-e577-3050-a923-b66ac48a27ab",
                                        "glosses": [
                                            "Having a wordplay element, but no definition."
                                        ],
                                        "tags": [
                                            "of a clue"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141456bd-613c-45a0-b5ef-aa61c30883c8",
                                                "sense_id": "db0c49ec-2b99-387e-9b3f-663c5ad655df",
                                                "text": "Twelve six- letter lights form a group; these have only partial clues."
                                            },
                                            {
                                                "example_id": "22a1135a-dba1-4c60-bce6-3ec574341f4e",
                                                "sense_id": "db0c49ec-2b99-387e-9b3f-663c5ad655df",
                                                "text": "Fourteen solutions are men of a kind. Each begins with a different letter, and their (partial) clues begin with the same letter as their solutions."
                                            }
                                        ]
                                    }
                                ]
                            },
