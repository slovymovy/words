                "senses": [
                    {
                        "sense_id": "d4ac3b52-096e-3e1a-a03d-258af2bfa038",
                        "entry_id": "c0ff6ebe-7661-3e91-9fbb-a9d061ff1575",
                        "glosses": [
                            "Bezeichnung für Wörter, die eine eigenständige, lexikalische Bedeutung haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b44cb8-8cd0-4d72-b790-aeeeeeb06c7d",
                                "sense_id": "d4ac3b52-096e-3e1a-a03d-258af2bfa038",
                                "text": "Wörter mit eigenständiger, lexikalischer Bedeutung wie „Haus“, „Tier“, „Wolke“ sind Autosemantika."
                            },
                            {
                                "example_id": "37bc3daf-2b30-424c-8ae6-99b14463bb67",
                                "sense_id": "d4ac3b52-096e-3e1a-a03d-258af2bfa038",
                                "text": "Substantive, Verben, Adjektive und Adverbien sind Autosemantika."
                            },
                            {
                                "example_id": "fb103d4f-a845-428c-b9e2-5ed2f102d8e9",
                                "sense_id": "d4ac3b52-096e-3e1a-a03d-258af2bfa038",
                                "text": "„Autosemantika sind relativ selbständige, begriffliche Bedeutung tragende Einheiten, die benennen und dabei das Einzelne der Klasse zuordnen, wie Substantive, Verben, Adjektive, Adverbien, bestimmte Präpositionen…“"
                            },
                            {
                                "example_id": "0acb0e88-98b3-4a65-8524-eeb5bce8125e",
                                "sense_id": "d4ac3b52-096e-3e1a-a03d-258af2bfa038",
                                "text": "„Je enger gefaßt die Textsorte, desto mehr Autosemantika sind unter den häufigsten Wörtern zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
