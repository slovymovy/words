                                "target_senses": [
                                    {
                                        "sense_id": "ea6a8ece-dd4d-3063-98c4-b970cb4a87d3",
                                        "entry_id": "ba5ad38e-8fae-3551-bb96-d19b6d86006a",
                                        "glosses": [
                                            "Robe portée par une femme lors de son mariage, de couleur spécifique selon les traditions et la culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c77bc82-e2cd-453e-b272-e0edc1655155",
                                                "sense_id": "ea6a8ece-dd4d-3063-98c4-b970cb4a87d3",
                                                "text": "Si vous saviez comme mademoiselle est jolie avec sa robe de mariée, la guirlande de roses blanches, les barbes de dentelle, le bouquet de fleurs d’orange."
                                            },
                                            {
                                                "example_id": "e26137a9-0483-4ada-b2e3-c3e839b34428",
                                                "sense_id": "ea6a8ece-dd4d-3063-98c4-b970cb4a87d3",
                                                "text": "Après la danse, vous irez chercher ma robe de mariée et vous la descendrez dans cette pièce !"
                                            },
                                            {
                                                "example_id": "270cdac7-f23a-4c6d-ac7e-0ec3d18f887e",
                                                "sense_id": "ea6a8ece-dd4d-3063-98c4-b970cb4a87d3",
                                                "text": "Mais il y a aussi les robes de mariée et de cérémonie, toutes aussi superbes et inédites les unes que les autres, ainsi que des tenues pour les invitées avec les accessoires, étoles et chapeaux pour être en beauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
