                ],
                "senses": [
                    {
                        "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                        "entry_id": "94aa5c75-6d27-376e-88ff-ae4dbacbdfe9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815a7f89-f8a9-462f-990b-9c1b2784420d",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Frau Hertle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "263dda9b-ec46-47a8-bb3b-397e0f81c1a9",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Herr Hertle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e49d75e-c60f-4e06-bd87-0e14533657e3",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Die Hertles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "812b7791-b2b1-4c08-945e-aa97f97365ca",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Der Hertle trägt nie die Schals, die die Hertle ihm strickt."
                            },
                            {
                                "example_id": "e0476f0b-456e-433a-aa26-afe3f29645db",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hertle kommt, geht der Herr Hertle.“"
                            },
                            {
                                "example_id": "072ff3ec-46b9-4b55-bb6a-3b39adbe85cf",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Hertle kommt und geht."
                            },
                            {
                                "example_id": "a54da79a-07c9-45a4-a668-91612861eed4",
                                "sense_id": "016756d6-8bee-3b87-8246-8eb0c1e17668",
                                "text": "Hertles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
