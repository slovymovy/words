                "senses": [
                    {
                        "sense_id": "91034294-b5a8-3901-92d9-d07aabf450ea",
                        "entry_id": "40cd7eee-6e94-3b34-b40d-b564a233917b",
                        "glosses": [
                            "een deel van een uiting dat een ondergeschikte rol speelt ten opzichte van de hoofdzin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4356300-d08e-4cf0-94c5-1904c1596aa4",
                                "sense_id": "91034294-b5a8-3901-92d9-d07aabf450ea",
                                "text": "Maar wat is hier nu de hoofdzin en wat is de bijzin?"
                            },
                            {
                                "example_id": "14bbbb7e-0036-4c6b-a1d1-72685beef272",
                                "sense_id": "91034294-b5a8-3901-92d9-d07aabf450ea",
                                "text": "Ik ga naar school, omdat het moet. omdat het moet is hier de bijzin."
                            },
                            {
                                "example_id": "fa40c855-793f-4bc7-b2a2-510746aa379a",
                                "sense_id": "91034294-b5a8-3901-92d9-d07aabf450ea",
                                "text": "Deze trailnaam had ze gekregen vanwege haar fascinatie voor het boek ‘Slaughterhouse five’ van Kurt Vonnegut, waarin vaak de bijzin ‘so it goes’ terugkomt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c55c64fb-9001-4f0a-85f1-f58a4f9eddf6",
                        "source_entry_id": "40cd7eee-6e94-3b34-b40d-b564a233917b",
                        "source_sense_id": "91034294-b5a8-3901-92d9-d07aabf450ea",
                        "source_sense_description": "een deel van een uiting dat een ondergeschikte rol speelt ten opzichte van de hoofdzin",
                        "target_lang_word": "Nebensatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebensatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                        "entry_id": "9efa1e8e-3269-3e9c-a67e-5296e9c5c36d",
                                        "glosses": [
                                            "untergeordneter Teilsatz, der für sich allein keinen grammatisch korrekten Satz ergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc110dc3-d619-40aa-b984-6d6ad496aa88",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "In dem Satz: „Es ist beruhigend, dass du da bist.“ ist „Es ist beruhigend“ der Hauptsatz und „dass du da bist“ der Nebensatz."
                                            },
                                            {
                                                "example_id": "c20c544f-3720-4518-956c-a5eb3ed8fdd8",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "In einem deutschen Nebensatz steht die finite Verbform an letzter Stelle."
                                            },
                                            {
                                                "example_id": "31d90f1a-3c5b-44b8-b656-1b8d3f9e8419",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "„Die bekannteste alternative Bezeichnung für den Nebensatz ist im deutschsprachigen Raum der Terminus Gliedsatz.“"
                                            },
                                            {
                                                "example_id": "183c92ed-58ea-4fbc-985c-a23c491dd131",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "„Die drei Formen sind Hauptsatz, Nebensatz und die sogenannte adverbiale Bestimmung (Umstandsbestimmung).“"
                                            },
                                            {
                                                "example_id": "e52f4f73-2d7d-49d9-97c5-d25623d8c394",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "„Er solle bitte schön noch einmal »drüberschauen« und die doch recht zahlreichen Nebensätze in seinem Text in Hauptsätze verwandeln.“"
                                            },
                                            {
                                                "example_id": "9fa950bd-99e2-4586-8558-9b50d1bf57a2",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "„Es tauchen ja immer dieselben Hauptwörter auf, ohne komplizierte Nebensätze oder Begründungen.“"
                                            },
                                            {
                                                "example_id": "dbd3f78d-450f-4236-bc33-5645d8e8b070",
                                                "sense_id": "5e2c1515-61c5-3fa1-8a3f-3f5f6ea1fa37",
                                                "text": "„Kommt im Englischen zwischen Haupt- und Nebensatz ein Komma?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
