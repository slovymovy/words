                        "source_sense_id": "f6420c22-8b22-3735-968f-7f462c91fc87",
                        "source_sense_description": "element that does not have the properties of a metal",
                        "target_lang_word": "non-métal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
