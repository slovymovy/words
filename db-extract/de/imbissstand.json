                                                "text": "Cornes de cerf et de snack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b623512e-e520-3f13-92d6-dbb36fc7c7e2",
                                        "entry_id": "dbb11d42-23af-3b94-a360-42b720654950",
                                        "glosses": [
                                            "Produit à grignoter quand on a faim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b28b289-59e6-4058-931b-9ce6faa7687b",
                                                "sense_id": "b623512e-e520-3f13-92d6-dbb36fc7c7e2",
                                                "text": "Il faut supprimer les sucres raffinés : plats ultratransformés, pâtisseries, snacks et pains industriels."
                                            },
                                            {
                                                "example_id": "c765b7ba-f31a-4ad4-ae31-f6e679761ed1",
                                                "sense_id": "b623512e-e520-3f13-92d6-dbb36fc7c7e2",
                                                "text": "Idée de bouchée , de mordre dans la nourriture, déverbatif de to snack"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d30657-1b6c-3584-b4f0-6c2029b24292",
