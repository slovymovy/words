                                                "sense_id": "7eebf5aa-52cb-3de3-88d3-501e5e986d44",
                                                "text": "As they say a little critical learning makes one proud; if there were more it would condensate and compact itself into less room"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "condensate",
                                "target_lang_code": "en",
