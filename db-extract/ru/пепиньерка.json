                "senses": [
                    {
                        "sense_id": "f0103303-2db0-3c7b-8b0a-9c3858329f94",
                        "entry_id": "a1d59917-3ed7-3a52-b371-8166852f08b8",
                        "glosses": [
                            "истор. девушка, окончившая закрытое среднее учебное заведение и оставленная при нём для педагогической практики"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e325b3-5a65-44b4-9e40-450bccd706fa",
                                "sense_id": "f0103303-2db0-3c7b-8b0a-9c3858329f94",
                                "text": "Итак, пепиньерка есть девица — и не может быть недевицей, так точно и недевица не может быть пепиньеркой."
                            },
                            {
                                "example_id": "5711b474-2f89-4810-ac93-978278bee1de",
                                "sense_id": "f0103303-2db0-3c7b-8b0a-9c3858329f94",
                                "text": "Кончив курс, Людочка не колеблясь приняла предложение Maman остаться пепиньеркой при младшем классе."
                            }
                        ]
                    }
