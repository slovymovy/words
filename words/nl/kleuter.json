                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kleuter</w> de hele middag met de kinderen in de zandbak.",
                            "target_lang_translations": {
                                "en": "I <w>play like a child</w> all afternoon with the kids in the sandbox."
                            }
                        },
                        {
                            "text": "Wanneer ik met mijn neefje speel, <w>kleuter</w> ik gezellig mee.",
                            "target_lang_translations": {
                                "en": "When I play with my nephew, I <w>join in the childish fun</w>."
                            }
