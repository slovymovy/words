                                "example_id": "3bd57dee-9803-4418-b522-920f0ee1b22f",
                                "sense_id": "ae3b81e4-1aa9-32de-a664-26f264fd5fbb",
                                "text": "S’il ne parvenait pas à les mettre à exécution alors qu’il jouissait de son temps et de ses mouvements, comment y parvenir lorsque le réemprisonneraient les horaires et les servitudes d’un vendeur de la Samar ?"
                            },
                            {
                                "example_id": "438e5fa2-9e6e-46cf-8ee1-90fe25c7386d",
                                "sense_id": "ae3b81e4-1aa9-32de-a664-26f264fd5fbb",
                                "text": "Arina en profite pour prendre le pouvoir et réemprisonner tout le monde, sauf Bella et Harvey, qu'elle mène à la torture."
                            }
                        ]
                    }
