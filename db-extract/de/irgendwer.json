                        "source_entry_id": "df4d31a8-379b-3257-baf4-8210c993c58e",
                        "source_sense_id": "c0d022d9-683e-3ca1-84bf-b12388c0063d",
                        "source_sense_description": "eine oder mehrere unbestimmte Person(en)",
                        "target_lang_word": "n’importe qui",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "n’importe qui",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "313146ee-ca90-35fc-a8fd-29a1aa0e7490",
                                        "entry_id": "9c26b18c-a65f-3ec8-8ed7-283f1783cb9d",
                                        "glosses": [
                                            "Indique une personne dont l’identité importe peu et que l’on peut choisir librement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a6fd18-ca60-472c-b448-0a5c3d04f873",
                                                "sense_id": "313146ee-ca90-35fc-a8fd-29a1aa0e7490",
                                                "text": "« Le président tanzanien peut exproprier n’importe qui, toute terre lui appartenant », dénonce Thomas Bart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1368e84c-8b1c-346c-9ac7-631db1c2b95a",
                                        "entry_id": "9c26b18c-a65f-3ec8-8ed7-283f1783cb9d",
                                        "glosses": [
                                            "Anonyme, inconnu, une personne parmi d'autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d4f043-f1a5-471e-ae74-3640573082b4",
                                                "sense_id": "1368e84c-8b1c-346c-9ac7-631db1c2b95a",
                                                "text": "N’importe qui a pu venir ici."
                                            },
                                            {
                                                "example_id": "24265065-bc7a-4c57-bb67-60a530402b7d",
                                                "sense_id": "1368e84c-8b1c-346c-9ac7-631db1c2b95a",
                                                "text": "N’importe qui aurait fait la même chose à ma place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b0a885-bc2f-39eb-b7c8-e147eb2e05af",
                                        "entry_id": "9c26b18c-a65f-3ec8-8ed7-283f1783cb9d",
                                        "glosses": [
                                            "Sans notoriété, étranger à un groupe donné, sans talent particulier."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8be39d-9749-425a-9ff3-241ae9305728",
                                                "sense_id": "f3b0a885-bc2f-39eb-b7c8-e147eb2e05af",
                                                "text": "Ce n'est pas n’importe qui, c'est une physicienne reconnue."
                                            },
                                            {
                                                "example_id": "b95963dc-7c11-4a72-848b-f94fb7655a65",
                                                "sense_id": "f3b0a885-bc2f-39eb-b7c8-e147eb2e05af",
                                                "text": "N’importe qui ne peut pas entrer, il faut présenter sa carte."
                                            },
                                            {
                                                "example_id": "d5b585f7-f71f-4bd8-9d8f-bb9b32ca19bd",
                                                "sense_id": "f3b0a885-bc2f-39eb-b7c8-e147eb2e05af",
                                                "text": "Nous ne pouvons confier une telle mission à n'importe qui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd4a3b8a-2dd6-45d0-b9a8-30c1f5a79b5d",
                        "source_entry_id": "df4d31a8-379b-3257-baf4-8210c993c58e",
