{
    "word_family": [
        "dolly",
        "dollhouse",
        "dollface"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e9152eb-0658-3210-a75b-a4986b3d1fd4",
                    "sense_definition": "A small figure resembling a human being that is used as a toy.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toy_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl sat on the floor playing with her <w>doll</w>.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка сидела на полу и играла со своей <w>куклой</w>.",
                                "zh": "小女孩坐在地板上玩她的<w>娃娃</w>。"
                            }
                        },
                        {
                            "text": "She has a large collection of porcelain <w>dolls</w> in her bedroom.",
                            "target_lang_translations": {
                                "ru": "У неё в спальне большая коллекция фарфоровых <w>кукол</w>.",
                                "zh": "她的卧室里收藏了许多瓷制<w>玩偶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rag doll",
                        "paper doll",
                        "play with dolls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрушка в виде фигурки человека.",
                        "zh": "一种模仿人类外形的玩具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кукла",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "пупс",
                                "target_lang_sense_clarification": "кукла в виде младенца"
                            },
                            {
                                "target_lang_word": "лялька",
                                "target_lang_sense_clarification": "разговорное, детское"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩偶",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "娃娃",
                                "target_lang_sense_clarification": "常用口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c15c92-fcbf-311a-a4af-375d6e016bca",
                    "sense_definition": "A good-natured, cooperative, or helpful person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be a <w>doll</w> and fetch me a glass of water, please.",
                            "target_lang_translations": {
                                "ru": "Будь <w>душкой</w>, принеси мне стакан воды, пожалуйста.",
                                "zh": "做个<w>好心人</w>，帮我拿杯水好吗？"
                            }
                        },
                        {
                            "text": "She was such a <w>doll</w> for helping me organize the event.",
                            "target_lang_translations": {
                                "ru": "Она была просто <w>золотом</w>, раз помогла мне организовать мероприятие.",
                                "zh": "她真是个<w>大好人</w>，帮我组织了这次活动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be a doll"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Милый, отзывчивый или готовый помочь человек; душка.",
                        "zh": "指性格好、乐于助人的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душка",
                                "target_lang_sense_clarification": "о милом человеке"
                            },
                            {
                                "target_lang_word": "золото",
                                "target_lang_sense_clarification": "перен. о ценном, полезном человеке"
                            },
                            {
                                "target_lang_word": "умница",
                                "target_lang_sense_clarification": "похвала за помощь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好心人",
                                "target_lang_sense_clarification": "指乐于助人的人"
                            },
                            {
                                "target_lang_word": "大好人",
                                "target_lang_sense_clarification": "强调性格极好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efce7ea7-15ef-3ea0-916d-397f303c1acc",
                    "sense_definition": "A term of endearment for a darling or sweetheart.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>doll</w>, are you ready to go to the cinema?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>куколка</w>, ты готова идти в кино?",
                                "zh": "嘿<w>宝贝</w>，准备好去看电影了吗？"
                            }
                        },
                        {
                            "text": "He called his wife <w>doll</w> when he wanted to be affectionate.",
                            "target_lang_translations": {
                                "ru": "Он называл жену <w>куколкой</w>, когда хотел проявить нежность.",
                                "zh": "他想表达爱意时会叫妻子<w>亲爱的</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к любимому человеку или красивой девушке.",
                        "zh": "对爱人或亲近之人的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куколка",
                                "target_lang_sense_clarification": "ласковое прозвище"
                            },
                            {
                                "target_lang_word": "крошка",
                                "target_lang_sense_clarification": "распространенное обращение"
                            },
                            {
                                "target_lang_word": "пупсик",
                                "target_lang_sense_clarification": "иронично-ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝贝",
                                "target_lang_sense_clarification": "常用昵称"
                            },
                            {
                                "target_lang_word": "亲爱的",
                                "target_lang_sense_clarification": "亲昵称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d782ea91-9f2f-3ae6-a283-72f8e60a8b82",
                    "sense_definition": "An attractive young woman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie star was described as a beautiful <w>doll</w> in the magazines.",
                            "target_lang_translations": {
                                "ru": "В журналах кинозвезду описывали как красивую <w>куклу</w>.",
                                "zh": "杂志将这位电影明星描述为一位漂亮的<w>美女</w>。"
                            }
                        },
                        {
                            "text": "He tried to impress the pretty <w>doll</w> at the bar.",
                            "target_lang_translations": {
                                "ru": "Он пытался произвести впечатление на хорошенькую <w>куколку</w> в баре.",
                                "zh": "他试图给酒吧里的那位<w>漂亮宝贝</w>留下深刻印象。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательная молодая женщина (часто с оттенком поверхностности).",
                        "zh": "指外表非常漂亮的年轻女性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кукла",
                                "target_lang_sense_clarification": "красивая, но бездушная"
                            },
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "лялька",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美女",
                                "target_lang_sense_clarification": "指漂亮女性"
                            },
                            {
                                "target_lang_word": "漂亮宝贝",
                                "target_lang_sense_clarification": "带有赞美色彩的称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dddaed82-dd4c-3f8a-a8d2-1f195eae3d09",
                    "sense_definition": "To dress oneself or someone else smartly and attractively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent hours <w>dolling</w> herself up for the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Она часами <w>прихорашивалась</w> перед свадебным приёмом.",
                                "zh": "她花了几个小时为婚宴<w>打扮</w>自己。"
                            }
                        },
                        {
                            "text": "They got all <w>dolled</w> up for their night out on the town.",
                            "target_lang_translations": {
                                "ru": "Они <w>вырядились</w> для вечеринки в городе.",
                                "zh": "他们为了晚上的外出游玩而<w>盛装打扮</w>了一番。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doll up"
                    ],
                    "common_phrases": [
                        "get dolled up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наряжаться, прихорашиваться, чтобы выглядеть привлекательно.",
                        "zh": "指精心打扮，使自己看起来更漂亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наряжаться",
                                "target_lang_sense_clarification": "красиво одеваться"
                            },
                            {
                                "target_lang_word": "прихорашиваться",
                                "target_lang_sense_clarification": "наводить красоту"
                            },
                            {
                                "target_lang_word": "вырядиться",
                                "target_lang_sense_clarification": "разг. одеться слишком броско"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打扮",
                                "target_lang_sense_clarification": "通用动词"
                            },
                            {
                                "target_lang_word": "盛装打扮",
                                "target_lang_sense_clarification": "强调精心修饰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "85f11e52-0404-3948-aac7-35c34609d5b5",
                    "sense_definition": "A diminutive of the female given name Dorothy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her name was Dorothy, but everyone called her <w>Doll</w>.",
                            "target_lang_translations": {
                                "ru": "Её звали Дороти, но все называли её <w>Долл</w>.",
                                "zh": "她叫多萝西，但大家都叫她<w>多尔</w>。"
                            }
                        },
                        {
                            "text": "Aunt <w>Doll</w> came to visit us last summer.",
                            "target_lang_translations": {
                                "ru": "Тётя <w>Долл</w> приезжала к нам прошлым летом.",
                                "zh": "<w>多尔</w>阿姨去年夏天来看望我们。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма женского имени Дороти.",
                        "zh": "女性名字 Dorothy 的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Долл",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多尔",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daa986c1-2324-31d8-8a9f-69663d3aacaa",
                    "sense_definition": "A township and rural village in Sutherland, Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Doll</w> during their trip to the Highlands.",
                            "target_lang_translations": {
                                "ru": "Во время поездки по Хайленду они посетили маленькую деревню <w>Долл</w>.",
                                "zh": "他们在去高地旅行时参观了<w>多尔</w>小村庄。"
                            }
                        },
                        {
                            "text": "<w>Doll</w> is located in the Highland council area of Scotland.",
                            "target_lang_translations": {
                                "ru": "<w>Долл</w> находится в шотландской области Хайленд.",
                                "zh": "<w>多尔</w>位于苏格兰的高地议会区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посёлок и деревня в Сазерленде, Шотландия.",
                        "zh": "苏格兰萨瑟兰的一个村庄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Долл",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}