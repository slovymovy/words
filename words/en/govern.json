{
    "word_family": [
        "government",
        "governor",
        "governance",
        "governess",
        "governable",
        "ungovernable",
        "misgovern"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96312edc-3203-37b5-9b35-06a9d52afcb2",
                    "sense_definition": "To officially control and lead a country, state, or organization, making decisions about laws and public policy.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elected party will <w>govern</w> the country for the next four years.",
                            "target_lang_translations": {
                                "ru": "Избранная партия будет <w>управлять</w> страной следующие четыре года.",
                                "zh": "当选政党将在未来四年内<w>治理</w>这个国家。"
                            }
                        },
                        {
                            "text": "It is often difficult to <w>govern</w> a nation with such diverse cultures and traditions.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>управлять</w> нацией с такими разнообразными культурами и традициями.",
                                "zh": "要<w>治理</w>一个拥有如此多元文化和传统的国家往往很困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "lead",
                        "administer",
                        "command",
                        "manage"
                    ],
                    "common_phrases": [
                        "govern a country",
                        "right to govern",
                        "govern the nation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководить страной, штатом или организацией, принимая решения о законах и государственной политике.",
                        "zh": "正式控制并领导一个国家、州或组织，对法律和公共政策做出决策。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "руководить, осуществлять власть"
                            },
                            {
                                "target_lang_word": "править",
                                "target_lang_sense_clarification": "быть правителем, царствовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治理",
                                "target_lang_sense_clarification": "管理国家或地区"
                            },
                            {
                                "target_lang_word": "统治",
                                "target_lang_sense_clarification": "掌握政权，进行管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4247b5d-0e58-388d-9e6f-1c3fa2647da3",
                    "sense_definition": "To have a direct effect on something or to determine how a situation develops.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Supply and demand usually <w>govern</w> the prices of goods in a free market.",
                            "target_lang_translations": {
                                "ru": "Спрос и предложение обычно <w>определяют</w> цены на товары на свободном рынке.",
                                "zh": "在自由市场中，供需关系通常<w>决定</w>商品价格。"
                            }
                        },
                        {
                            "text": "Strict safety regulations <w>govern</w> how the chemical plant operates.",
                            "target_lang_translations": {
                                "ru": "Строгие правила безопасности <w>регулируют</w> работу химического завода.",
                                "zh": "严格的安全法规<w>调节</w>着化工厂的运作方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "determine",
                        "dictate",
                        "influence",
                        "control",
                        "decide"
                    ],
                    "common_phrases": [
                        "govern the outcome",
                        "rules govern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать прямое влияние на что-либо или определять, как будет развиваться ситуация.",
                        "zh": "对某事产生直接影响，或决定某种情况的发展方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "обуславливать исход или характер"
                            },
                            {
                                "target_lang_word": "регулировать",
                                "target_lang_sense_clarification": "упорядочивать, устанавливать порядок"
                            },
                            {
                                "target_lang_word": "влиять",
                                "target_lang_sense_clarification": "оказывать воздействие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "起决定性作用"
                            },
                            {
                                "target_lang_word": "调节",
                                "target_lang_sense_clarification": "使事物按一定规律运行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da84274b-0a0d-347c-9359-80108a39824f",
                    "sense_definition": "To control or restrain the actions, behavior, or emotions of oneself or others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must learn to <w>govern</w> your temper when you are in a professional environment.",
                            "target_lang_translations": {
                                "ru": "Вы должны научиться <w>сдерживать</w> свой гнев в профессиональной среде.",
                                "zh": "在职场环境中，你必须学会<w>克制</w>自己的脾气。"
                            }
                        },
                        {
                            "text": "He struggled to <w>govern</w> his emotions after hearing the shocking news.",
                            "target_lang_translations": {
                                "ru": "Ему было трудно <w>контролировать</w> свои эмоции после того, как он услышал шокирующие новости.",
                                "zh": "听到这个令人震惊的消息后，他努力<w>控制</w>自己的情绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "control",
                        "restrain",
                        "check",
                        "curb"
                    ],
                    "common_phrases": [
                        "govern oneself",
                        "govern one's temper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контролировать или сдерживать действия, поведение или эмоции (свои или чужие).",
                        "zh": "控制或克制自己或他人的行为、举止或情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдерживать",
                                "target_lang_sense_clarification": "не давать воли чувствам или порывам"
                            },
                            {
                                "target_lang_word": "контролировать",
                                "target_lang_sense_clarification": "держать под наблюдением и властью"
                            },
                            {
                                "target_lang_word": "владеть",
                                "target_lang_sense_clarification": "уметь управлять собой (владеть собой)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "克制",
                                "target_lang_sense_clarification": "抑制自己的情绪或欲望"
                            },
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "掌握住不使任意活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec72c58a-ffa4-3242-9d2a-49573763fde4",
                    "sense_definition": "To control the speed, pressure, or flow of a machine or system automatically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A specific valve is used to <w>govern</w> the flow of fuel into the engine.",
                            "target_lang_translations": {
                                "ru": "Специальный клапан используется, чтобы <w>регулировать</w> подачу топлива в двигатель.",
                                "zh": "一个特殊的阀门被用来<w>调节</w>进入发动机的燃料流量。"
                            }
                        },
                        {
                            "text": "The mechanism is designed to <w>govern</w> the speed of the turbine to prevent overheating.",
                            "target_lang_translations": {
                                "ru": "Механизм предназначен для того, чтобы <w>регулировать</w> скорость турбины для предотвращения перегрева.",
                                "zh": "该机制旨在<w>调节</w>涡轮机的速度以防止过热。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regulate",
                        "limit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автоматически контролировать скорость, давление или поток в машине или системе.",
                        "zh": "自动控制机器或系统中的速度、压力或流量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулировать",
                                "target_lang_sense_clarification": "настраивать или поддерживать параметры механизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调节",
                                "target_lang_sense_clarification": "调整参数以保持正常运行"
                            },
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "限制或管理机械运作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a0f088-9e3b-3f25-91c7-def0a85886cf",
                    "sense_definition": "To require that a specific grammatical case or preposition be used with a word.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Latin, certain prepositions <w>govern</w> the accusative case while others take the ablative.",
                            "target_lang_translations": {
                                "ru": "В латыни определенные предлоги <w>управляют</w> винительным падежом, тогда как другие требуют аблатива.",
                                "zh": "在拉丁语中，某些介词<w>支配</w>宾格，而另一些则要求夺格。"
                            }
                        },
                        {
                            "text": "Transitive verbs typically <w>govern</w> a direct object in English sentences.",
                            "target_lang_translations": {
                                "ru": "Переходные глаголы в английских предложениях обычно <w>управляют</w> прямым дополнением.",
                                "zh": "在英语句子中，及物动词通常<w>支配</w>直接宾语。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Требовать использования определенного грамматического падежа или предлога с данным словом.",
                        "zh": "要求某个词必须与特定的语法格或介词连用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "грамматический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支配",
                                "target_lang_sense_clarification": "语法中要求特定格或词类"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}