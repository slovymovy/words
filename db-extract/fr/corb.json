                        "sense_id": "1e06bb14-f034-3bd8-a3ac-7a9d17f6b577",
                        "entry_id": "ec985c87-851f-3f20-a0fd-ed74eac1ab9c",
                        "glosses": [
                            "Espèce de poisson osseux marin comestible, un sciaenidé de l'Atlantique et la Méditerrannée, de couleur sombre comme un corbeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33af5a5-f575-406b-8dcd-5e5d1f8369a5",
                                "sense_id": "1e06bb14-f034-3bd8-a3ac-7a9d17f6b577",
                                "text": "Le Corb (Corbina nigra, Cuv.) se rencontre dans les mêmes parages que l’Ombrine et, à peu près, pendant toute l’année."
                            }
                        ]
                    }
                ],
