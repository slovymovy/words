                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5e0f6268-4ddb-3783-bd06-9ebfbf5c55ec",
                        "entry_id": "363a421e-5491-3b5e-89d4-6df496ce20c2",
                        "glosses": [
                            "chustka"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "d0a40d6f-5c71-4b83-bb7f-4d60183fcf1a",
                                "sense_id": "5e0f6268-4ddb-3783-bd06-9ebfbf5c55ec",
                                "text": "Jezus malusieńki / leży nagusieńki, / płacze z zimna, nie dała Mu / Matusia sukienki. / Bo uboga była, / rąbek z głowy zdjęła, / w który Dziecię owinąwszy, / siankiem Je okryła"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ce8a83e3-d826-3b86-9f44-bdd3b578b193",
                        "entry_id": "363a421e-5491-3b5e-89d4-6df496ce20c2",
                        "glosses": [
                            "obłączek paznokcia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f435f6-9c32-4633-a5f6-761e7abbd9ba",
                                "sense_id": "ce8a83e3-d826-3b86-9f44-bdd3b578b193",
                                "text": "Białe zabarwienie rąbka wynika ze słabszego przylegania płytki paznokcia do macierzy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
