                        "target_lang_word": "Bevollmächtigter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bevollmächtigter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3071af0f-ff0c-3dfe-a3aa-57fce7cfb2f6",
                                        "entry_id": "a45f5d3e-3d51-368f-a5b3-2e428c874525",
                                        "glosses": [
                                            "Person, die mit einer Vollmacht ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6cf37e-2232-4585-aa8c-fc0585f81fe6",
                                                "sense_id": "3071af0f-ff0c-3dfe-a3aa-57fce7cfb2f6",
                                                "text": "Der Bevollmächtigte verhandelte mit Vertretern der Gewerkschaft."
                                            },
                                            {
                                                "example_id": "08106a14-5204-4390-ba1b-e8b5c21c8c3f",
                                                "sense_id": "3071af0f-ff0c-3dfe-a3aa-57fce7cfb2f6",
                                                "text": "„Im Sommer 1829 entsendet Paris einen Bevollmächtigten nach Algier, der die Affäre geräuschlos durch Verhandlungen beenden soll.“"
                                            },
                                            {
                                                "example_id": "9848ab47-abc3-44bd-a436-b8589695e1e5",
                                                "sense_id": "3071af0f-ff0c-3dfe-a3aa-57fce7cfb2f6",
                                                "text": "„Am nächsten Tage sitzt der Richter mit den Schöffen und dem Bevollmächtigten des Königs vor einem wackeligen Tisch in dem baufälligen, kalten und leckgewordenen Rechts- und Gerichtshaus, von dem man im vorigen Jahr die Gerichtsglocke weggeholt hat.“"
                                            },
                                            {
                                                "example_id": "ae45f887-12fa-4642-b66b-c557941b8f51",
                                                "sense_id": "3071af0f-ff0c-3dfe-a3aa-57fce7cfb2f6",
                                                "text": "„Neu müssen Schweizer Hersteller Prothesen, Verbandsmaterial oder Röntgengeräte auch in der EU zertifizieren lassen und dort einen Bevollmächtigten ernennen, der für fehlbare Produkte haftet.“"
                                            },
                                            {
                                                "example_id": "797c25df-72d3-4049-84bc-5b1dccd6cb65",
                                                "sense_id": "3071af0f-ff0c-3dfe-a3aa-57fce7cfb2f6",
                                                "text": "„Simon Geib, zweiter Bevollmächtigter der IG Metall in Neunkirchen, sieht auch in der eingeschlagenen Strategie von Purem zum Wasserstoff einen Erfolg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
