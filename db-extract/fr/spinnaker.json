                                "target_senses": [
                                    {
                                        "sense_id": "f4dff6d3-df1e-333e-aabf-b29f6d5984a9",
                                        "entry_id": "ef86cba2-fa94-3b27-a8a4-32eddb530805",
                                        "glosses": [
                                            "A sail supplemental to the mainsail, especially a triangular one, used on yachts for running before the wind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spinnaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dae5f58-956e-319e-8e84-9a39dfc5b784",
                                        "entry_id": "a0e8779c-691a-3f27-9827-f123fc4cfc51",
                                        "glosses": [
                                            "To sail using a spinnaker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c320f27-9b54-489e-b9da-67826c9b3352",
                                                "sense_id": "9dae5f58-956e-319e-8e84-9a39dfc5b784",
                                                "text": "On the port tack layline , you're defenseless against starboard tackers — you have to dip them , no matter how much you may lose doing it — and the wind shadow of boats spinnakering away from the mark can cost you plenty."
                                            },
                                            {
                                                "example_id": "8c1c7c82-9142-439f-851d-d0a43e154711",
                                                "sense_id": "9dae5f58-956e-319e-8e84-9a39dfc5b784",
                                                "text": "We spinnakered out into the Atlantic and, fortunately, the wind died as night fell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
