                                    {
                                        "sense_id": "eea706f9-c260-3bda-b511-c5231a7a9606",
                                        "entry_id": "34fc0723-0443-3413-9afa-a04229334701",
                                        "glosses": [
                                            "A háček ⟨ ˇ ⟩."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1c08bd3-c6de-4b4f-ab3b-31227aeb7e30",
                                                "sense_id": "eea706f9-c260-3bda-b511-c5231a7a9606",
                                                "text": "[…] the more conventional semivocalic j and the caret (ˇ) respectively."
                                            },
                                            {
                                                "example_id": "2428c365-fa24-4f4f-8862-6a0bf713a490",
                                                "sense_id": "eea706f9-c260-3bda-b511-c5231a7a9606",
                                                "text": "The caret (ˇ), háček, is used over the following consonants: c, d, n, t, r, s, and z to indicate the soft sound. The caret (ˇ) is also used over the vowel e (See Pronunciation II, b, p, v)."
                                            },
                                            {
                                                "example_id": "37971dc3-fa81-4882-b27e-1b9aac1fa219",
                                                "sense_id": "eea706f9-c260-3bda-b511-c5231a7a9606",
                                                "text": "In contemporary Czech, the “hook” or caret is no longer in use for lower-case t and d when the latter are palatal; instead, an apostrophe is used (t’, d’) This development is clearly connected with the practical difficulty encountered in printing a caret over letter stems that are too thin."
                                            }
                                        ]
