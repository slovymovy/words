        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                    "sense_definition": "Personne qui manque de connaissances ou d'instruction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne traite pas ton camarade d'<w>ignorant</w> simplement parce qu'il n'a pas compris la consigne.",
                            "target_lang_translations": {
                                "en": "Don't call your classmate an <w>ignoramus</w> just because he didn't understand the instructions.",
                                "ru": "Не называй товарища <w>невеждой</w> только потому, что он не понял задание.",
                                "de": "Nenn deinen Mitschüler nicht gleich einen <w>Ignoranten</w>, nur weil er die Anweisung nicht verstanden hat.",
                                "es": "No llames <w>ignorante</w> a tu compañero solo porque no ha entendido la instrucción.",
                                "zh": "不要只因为同学没听懂指令，就把他当成<w>无知者</w>。"
                            }
                        },
                        {
                            "text": "Cet <w>ignorant</w> donne des conseils sur un sujet qu'il ne maîtrise absolument pas.",
                            "target_lang_translations": {
                                "en": "This <w>ignoramus</w> is giving advice on a subject he has absolutely no grasp of.",
                                "ru": "Этот <w>невежда</w> даёт советы по теме, в которой он совершенно не разбирается.",
                                "de": "Dieser <w>Ignorant</w> gibt Ratschläge zu einem Thema, das er absolut nicht beherrscht.",
                                "es": "Este <w>ignorante</w> da consejos sobre un tema que no domina en absoluto.",
                                "zh": "这个<w>无知者</w>却对自己完全不懂的话题给出建议。"
                            }
                        }
                    ],
                    "antonyms": [
                        "savant",
                        "érudit"
                    ],
                    "common_phrases": [
                        "faire l'ignorant",
                        "passer pour un ignorant"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who lacks knowledge or education.",
                        "ru": "Человек, не обладающий достаточными знаниями или образованием.",
                        "de": "Person, der es an Wissen oder Bildung fehlt.",
                        "es": "Persona que carece de conocimientos o de instrucción.",
                        "zh": "指缺乏知识或教育的人。"
