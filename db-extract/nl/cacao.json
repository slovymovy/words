                        "source_sense_id": "1bb675f1-0c7b-3a59-8bcb-db46fcf73419",
                        "source_sense_description": "product verkregen uit de bonen van de cacaoboom dat onder andere wordt gebruikt...",
                        "target_lang_word": "Kakao",
