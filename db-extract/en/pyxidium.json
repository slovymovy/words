                "entry_id": "9217daa6-53e0-3816-8338-fea7961e950c",
                "word": "pyxidium",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f0fd715b-1c84-41ed-b5eb-084cb9d8b119",
                        "entry_id": "9217daa6-53e0-3816-8338-fea7961e950c",
                        "tags": [
                            "plural"
                        ],
                        "form": "pyxidia"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e0f3d28-8b4e-36ed-ab7a-567a4f95dcdd",
                        "entry_id": "9217daa6-53e0-3816-8338-fea7961e950c",
                        "glosses": [
                            "A seed capsule in the form of a box, the seeds being released when the top splits off."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14048910-a155-438a-aa4c-195f86cf837b",
                                "sense_id": "0e0f3d28-8b4e-36ed-ab7a-567a4f95dcdd",
                                "text": "Key to Species of Cariniana Inflorescence predominantly terminal and subterminal; pyxidium without teeth at line of opercular dehiscence."
                            },
                            {
                                "example_id": "f65cacf6-694c-4916-8d83-af24d87dad6b",
                                "sense_id": "0e0f3d28-8b4e-36ed-ab7a-567a4f95dcdd",
                                "text": "The pyxidium has the trigonoidly cylindrical or obconical form of that of Couratari, but it is much thicker, heavier, and more solid in substance."
                            },
                            {
                                "example_id": "84ae48cb-0c9e-4632-a8e5-7fdfec7e36ff",
                                "sense_id": "0e0f3d28-8b4e-36ed-ab7a-567a4f95dcdd",
                                "text": "The capsule of gold−beater's skin, in which the grubs of the Cione are enclosed, divides itself, at the moment of liberation, into two hemispheres \"of a regularity so perfect that they recall exactly the bursting of the pyxidium when the seed is distributed\"."
                            },
                            {
                                "example_id": "fe5fc62e-7363-4a19-939c-ee414390d0c5",
                                "sense_id": "0e0f3d28-8b4e-36ed-ab7a-567a4f95dcdd",
                                "text": "A fruit of this kind is sometimes termed a pyxidium; that is, a little chest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb8e9d60-1864-4da1-af66-8c8a26b49130",
                        "source_entry_id": "9217daa6-53e0-3816-8338-fea7961e950c",
                        "source_sense_id": "0e0f3d28-8b4e-36ed-ab7a-567a4f95dcdd",
                        "source_sense_description": "a seed capsule in the form of a box",
                        "target_lang_word": "torebka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
