                    {
                        "sense_id": "a1bf835f-fa0f-3927-beec-5f8366fe51bb",
                        "entry_id": "af0f037e-7a11-33b6-aa44-1086368a0e72",
                        "glosses": [
                            "Wisdom which comes after the event."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b161862-1797-4946-8d9d-a9ad411d1983",
                                "sense_id": "a1bf835f-fa0f-3927-beec-5f8366fe51bb",
                                "text": "After wits are dearely bought, / Let thy fore-wit guide thy thought."
                            },
                            {
                                "example_id": "56e4bb0a-268a-419e-ae4d-5611dfda0744",
                                "sense_id": "a1bf835f-fa0f-3927-beec-5f8366fe51bb",
                                "text": "1692, Roger L’Estrange (translator), Fables of Æsop, London: R. Sare et al., Fable 162, “A Nightingale and a Bat,”\nThere’s No Recalling of what’s Gone and Past; so that After-Wit comes too Late when the Mischief is Done."
                            },
                            {
                                "example_id": "e4870df5-18b3-404a-89f7-2e8345543f42",
                                "sense_id": "a1bf835f-fa0f-3927-beec-5f8366fe51bb",
                                "text": "Trust me, dear Yorick, this unwary pleasantry of thine will sooner or later bring thee into scrapes and difficulties, which no after-wit can extricate thee out of."
                            },
                            {
                                "example_id": "6b0cea5e-5110-4423-900b-831698445587",
                                "sense_id": "a1bf835f-fa0f-3927-beec-5f8366fe51bb",
                                "text": "There is always a danger of afterwit in estimating the early achievements of men who have achieved fame […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "56aa0b41-e6bf-35d8-91e0-0e14be579fef",
                        "entry_id": "af0f037e-7a11-33b6-aa44-1086368a0e72",
                        "glosses": [
                            "The lack of forethought."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
