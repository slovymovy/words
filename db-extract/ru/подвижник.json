                "senses": [
                    {
                        "sense_id": "a5735369-4d76-30b5-9fe9-04fee682aea0",
                        "entry_id": "f0578e8c-cf6a-3bfe-9fbb-e2dc3f505ee4",
                        "glosses": [
                            "религ. тот, кто изнуряет себя лишениями, постом, молитвами во имя служения Богу"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "241cd46e-6862-383f-b686-c1044896fcd6",
                        "entry_id": "f0578e8c-cf6a-3bfe-9fbb-e2dc3f505ee4",
                        "glosses": [
                            "перен., высок. тот, кто самоотверженно трудится, борется за достижение высоких целей на каком-либо тяжёлом поприще"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ae677ca-05a1-45ca-b7cc-c9060789fd71",
                        "source_entry_id": "f0578e8c-cf6a-3bfe-9fbb-e2dc3f505ee4",
                        "source_sense_description": "тот, кто изнуряет себя лишениями, постом, молитвами",
                        "target_lang_word": "ascetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "444278e1-5e93-3cb6-aeaf-3e349cb13f68",
                                        "entry_id": "5ea763f0-cb48-3a45-b281-326a613919d5",
                                        "glosses": [
                                            "Of or relating to ascetics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2110839d-1dba-39b6-8876-6b2f3e954231",
                                        "entry_id": "5ea763f0-cb48-3a45-b281-326a613919d5",
                                        "glosses": [
                                            "Characterized by rigorous self-denial or self-discipline; austere; abstinent; involving a withholding of physical pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00debe80-d937-421b-bc42-f1c3248c1faf",
                                                "sense_id": "2110839d-1dba-39b6-8876-6b2f3e954231",
                                                "text": "In a word, the stern, ascetic rigor of the temple discipline, which had been so long exchanged for prodigal and licentious indulgence, seemed at once to have revived at Templestowe under the severe eye of Lucas Beaumanoir."
                                            },
                                            {
                                                "example_id": "e089caf5-1ae7-4fed-a444-01add2b241c0",
                                                "sense_id": "2110839d-1dba-39b6-8876-6b2f3e954231",
                                                "text": "1999, Alan Davies, Tradition and Modernity in Protestant Christianity, Karigoudar Ishwaran (editor), Ascetic Culture: Renunciation and Worldly Engagement, page 30,\nThe rich communal life of the most ascetic Protestants, for example, the Hutterites and the Old Order Mennonites, with their nineteenth century dress and preference for antiquated technology, refutes such superficial judgments."
                                            },
                                            {
                                                "example_id": "4a20c349-5157-4d23-a82d-be7fbc0e9dee",
                                                "sense_id": "2110839d-1dba-39b6-8876-6b2f3e954231",
                                                "text": "2004, Phyllis G. Jestice, Ascetics as Holy People, Phyllis G. Jestice (editor), Holy People of the World: A Cross-Cultural Encyclopedia, Volume 1: Entries A to G, page 70,\nThroughout the hagiographical tradition, though, holy people have engaged in more ascetic practices than the population at large, usually proceeding two or three degrees beyond what is expected among the merely pious."
                                            },
                                            {
                                                "example_id": "93603df8-962d-4b91-ad04-8bf09dddaf06",
                                                "sense_id": "2110839d-1dba-39b6-8876-6b2f3e954231",
                                                "text": "This experience enables Nāgārjuna to recognize that desire is the root cause of suffering and motivates him to turn to a more ascetic lifestyle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ascetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5eea5a1-2083-3da4-9112-dd0f915cbcc6",
                                        "entry_id": "de31fa22-2084-34a6-8a34-e772aae72f5f",
                                        "glosses": [
                                            "One who is devoted to the practice of self-denial, either through seclusion or stringent abstinence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8832d9e0-6ab4-47af-9d97-8ab9ed85d085",
                                                "sense_id": "f5eea5a1-2083-3da4-9112-dd0f915cbcc6",
                                                "text": "First, the technical terms used to signify hindu ascetics, hermits, mendicants and some related terms are analysed in their religious meaning with the view of avoiding a good deal of confusion that exists in such studies."
                                            },
                                            {
                                                "example_id": "5accd25a-111c-402d-9269-4866f1eb3099",
                                                "sense_id": "f5eea5a1-2083-3da4-9112-dd0f915cbcc6",
                                                "text": "Female ascetics find shelter in a wide variety of establishments and vary greatly in the degree to which they travel."
                                            },
                                            {
                                                "example_id": "ba177e7a-8c1e-4ea9-be93-ca7f17eccd3e",
                                                "sense_id": "f5eea5a1-2083-3da4-9112-dd0f915cbcc6",
                                                "text": "The ascetics were not only concerned with abstinence from food, and much of the contemporary literature stresses sexual desire and civil ambition as other important dangers to avoid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1095db88-2023-4611-a95c-009f0d94eb8f",
                        "source_entry_id": "f0578e8c-cf6a-3bfe-9fbb-e2dc3f505ee4",
                        "source_sense_description": "тот, кто самоотверженно трудится, борется за достижение высоких целей",
                        "target_lang_word": "sadhu",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadhu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23c64824-bdff-313a-a7ed-95cbe1d0863c",
                                        "entry_id": "c02dc763-57af-3c87-8833-ad167675302e",
                                        "glosses": [
                                            "An ascetic or practitioner of yoga (yogi) who has given up pursuit of the first three Hindu goals of life: kama (enjoyment), artha (practical objectives) and even dharma (duty)."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dd4fb94-4708-407b-945b-18b428291384",
                                                "sense_id": "23c64824-bdff-313a-a7ed-95cbe1d0863c",
                                                "text": "Then again these figures take no account of the thousands of beggars who travel free in India. Many of these are religious \"Sadhus\", dressed often in nothing but a loin-cloth, or even less, and their bodies smeared with ashes. A large number of these men are nothing but impostors, but the Hindu railway staff usually are afraid to interfere with them."
                                            },
                                            {
                                                "example_id": "d152fd5b-34e8-4a66-ba9d-a27896191115",
                                                "sense_id": "23c64824-bdff-313a-a7ed-95cbe1d0863c",
                                                "text": "It was clad in white in the manner of an Indian sadu or holy man, and it was walking barefoot on the grubby pavements."
                                            },
                                            {
                                                "example_id": "e4b8291b-fbf4-4a9c-9625-b968ec157c85",
                                                "sense_id": "23c64824-bdff-313a-a7ed-95cbe1d0863c",
                                                "text": "So for the meanwhile I continued with my ritualised observances, obsessively counting the number of steps it took me to walk to any given location, carefully avoiding the cracks in the pavement for fear that the bears of the id might get me, and attending to my bodily functions with the pure metrical devotion of a sadhu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c35547e-016a-4afa-a2c2-112833e55df8",
                        "source_entry_id": "f0578e8c-cf6a-3bfe-9fbb-e2dc3f505ee4",
                        "source_sense_description": "тот, кто самоотверженно трудится, борется за достижение высоких целей",
                        "target_lang_word": "sapient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sapient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e24f259-9859-3ef4-b460-2ec1123aebe0",
                                        "entry_id": "b01c27ee-374f-3704-8662-cc20eb36931e",
                                        "glosses": [
                                            "Possessing discernment and wisdom; learned, wise."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bfe9e3b-ef27-4747-8fa7-bbbbf07b6836",
                                                "sense_id": "5e24f259-9859-3ef4-b460-2ec1123aebe0",
                                                "text": "[To Edgar] Come ſit thou here moſt learned Iuſtice / [To the Fool] Thou ſapient ſir ſit here, […]"
                                            },
                                            {
                                                "example_id": "00e273fe-26b0-4725-8866-d616d31bb1ba",
                                                "sense_id": "5e24f259-9859-3ef4-b460-2ec1123aebe0",
                                                "text": "Spot more delicious then thoſe Gardens feign’d / Or of reviv’d Adonis, or renovvnd / Alcinous, hoſt of old Laertes Son [Odysseus], / Or that, not Myſtic, vvhere the Sapient King [Solomon] / Held dalliance vvith his faire Egyptian Spouſe."
                                            },
                                            {
                                                "example_id": "e5b4a88b-72ad-4d02-8a6f-6c17ca2fbb88",
                                                "sense_id": "5e24f259-9859-3ef4-b460-2ec1123aebe0",
                                                "text": "What is it but a vain and curious skill, / If sapient Germany must lie deprest, / Beneath the brutal sword?"
                                            },
                                            {
                                                "example_id": "55db3546-5eb3-430f-b789-d7d1f499b315",
                                                "sense_id": "5e24f259-9859-3ef4-b460-2ec1123aebe0",
                                                "text": "She had five or six cows; but it was observed by her sapient neighbours that she sold more butter every year than other farmers' wives who had twenty."
                                            },
                                            {
                                                "example_id": "f25e3d56-8e8a-40af-a174-2a902f94f31e",
                                                "sense_id": "5e24f259-9859-3ef4-b460-2ec1123aebe0",
                                                "text": "Another way my sapient Guide conduct me / Forth from the quiet to the air that trembles; / And to a place I come where nothing shines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                        "entry_id": "b01c27ee-374f-3704-8662-cc20eb36931e",
                                        "glosses": [
                                            "Attempting to appear discerning or wise."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f50942-783c-4b1d-aef7-007df6f59d4e",
                                                "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                                "text": "Novv tell me, dignified and ſapient ſir, / My man of morals, nurtur'd in the ſhades / Of Academus, is this falſe or true?"
                                            },
                                            {
                                                "example_id": "42492172-c3dd-4c7b-9f60-a02e81568b23",
                                                "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                                "text": "VVell! but a leſſening of prodigal expences, and the œconomy vvhich has been introduced by the virtuous and ſapient aſſembly, makes amends for the loſſes ſuſtained in the receipt of revenue."
                                            },
                                            {
                                                "example_id": "ffeac8b3-988a-4208-ba9c-8b40388cd93f",
                                                "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                                "text": "I think I seem them at their work—these sapient trouble-tombs."
                                            },
                                            {
                                                "example_id": "c3ac0c7f-e1e9-45e3-8def-b2de299ea634",
                                                "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                                "text": "Then the group of women at the gate separated with many a sapient comment."
                                            },
                                            {
                                                "example_id": "5590b032-1060-427f-8ef2-ce05fbbc191f",
                                                "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                                "text": "A man would blush to say to himself in the darkness of the night the things he stands up on a platform in the garish light of day to stuff into the ears of a multitude whose intelligence he pretends that he esteems. […] Therefore, why be sapient and solemn about it, like an editorial in a newspaper?"
                                            },
                                            {
                                                "example_id": "ed8a8888-7a97-4717-84f8-773a38735f86",
                                                "sense_id": "f2ef09ea-0389-3d74-9908-2ccc43a86d06",
                                                "text": "In Europe I had been told by sapient academics that there wasn't really any class system in the United States: well, you couldn't prove that by the conditions in California's agribusinesses, or indeed its urban factories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279b0d0c-9ec8-3083-bf04-89943890317a",
                                        "entry_id": "b01c27ee-374f-3704-8662-cc20eb36931e",
                                        "glosses": [
                                            "Followed by of: aware or knowledgeable of."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3bdb385-bbbb-3f91-bc41-99849babce3b",
                                        "entry_id": "b01c27ee-374f-3704-8662-cc20eb36931e",
                                        "glosses": [
                                            "Of a lifeform or species: possessing intelligence or a high degree of self-awareness."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aefd65d9-e983-4823-bfa9-095148ad73c0",
                                                "sense_id": "a3bdb385-bbbb-3f91-bc41-99849babce3b",
                                                "text": "When EXPLORATION blazed through space / The first sky-trail to far-flung stars, / And found men, sapient, on Mars, / He gained renown's most honored place."
                                            },
                                            {
                                                "example_id": "1f186ebb-dc12-4a2a-9fdc-9f0c8a9d3733",
                                                "sense_id": "a3bdb385-bbbb-3f91-bc41-99849babce3b",
                                                "text": "It was inhabited by a sapient humanoid race, and some of them were civilized enough to put it in Class V, and Colonial Office doctrine on Class V planets was rigid."
                                            },
                                            {
                                                "example_id": "5b979de4-3e07-4260-a31c-c85b552eb465",
                                                "sense_id": "a3bdb385-bbbb-3f91-bc41-99849babce3b",
                                                "text": "Nessus had not spoken mockingly; but Speaker reacted with rage. \"What sapient being would not fear such power?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45908230-2901-31fd-bbb8-c05e764fe5f0",
                                        "entry_id": "b01c27ee-374f-3704-8662-cc20eb36931e",
                                        "glosses": [
                                            "Of, pertaining to, or characteristic of Homo sapiens (modern human beings)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3b8fb04-41d6-3c93-ac4e-1afb007022e9",
                                        "entry_id": "b01c27ee-374f-3704-8662-cc20eb36931e",
                                        "glosses": [
                                            "Having a (good) flavour or taste; sapid."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sapient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff7f267-8c4e-32ac-9fcf-7df84b29f9f7",
                                        "entry_id": "ba2026ff-b3f6-311e-9370-d0cd19e5e434",
                                        "glosses": [
                                            "A wise person; a sage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2054eda1-422e-45a1-a818-cb6815f45c17",
                                                "sense_id": "6ff7f267-8c4e-32ac-9fcf-7df84b29f9f7",
                                                "text": "\"She canna do that,\" said another sapient of the same profession— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010f1872-eb44-3014-a65a-6064727d628a",
                                        "entry_id": "ba2026ff-b3f6-311e-9370-d0cd19e5e434",
                                        "glosses": [
                                            "An intelligent, self-aware being."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b1e7ab-7075-4c90-9993-8988ed38c4e7",
                                                "sense_id": "010f1872-eb44-3014-a65a-6064727d628a",
                                                "text": "Every since Trausti had shown him the X-rays, Leif had a theory that Halla Dannto was of non-Earth origin. It seemed to him a possibility that the Cold War Corps of March might have contacted hitherto unknown sapients on some just discovered interstellar planet, and were using them in the cold war against the Jacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5016c870-9842-34ee-b3a6-1a9640943b49",
                                        "entry_id": "ba2026ff-b3f6-311e-9370-d0cd19e5e434",
                                        "glosses": [
                                            "A human being of the species Homo sapiens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
