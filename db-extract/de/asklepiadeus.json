                                        "examples": [
                                            {
                                                "example_id": "a27f85de-32b4-4df8-b18b-dd592d415117",
                                                "sense_id": "366c6548-5da9-3d33-89c1-0c21cceb321a",
                                                "text": "Un asclépiade."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asclépiade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2262cd-3eb8-3c8d-8391-4833c97f07b9",
                                        "entry_id": "24533294-953a-3cc2-a194-15e12d1d738d",
                                        "glosses": [
                                            "Genre de plantes à fleurs qui produit des graines laineuses, dont une seule espèce, le dompte-venin, croît naturellement dans nos climats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4369c3db-1fa3-4cf6-b1bd-21c41e43aec7",
                                                "sense_id": "1d2262cd-3eb8-3c8d-8391-4833c97f07b9",
                                                "text": "[…] une innombrable quantité de tiges d’asclépiades dont les feuilles et les ombrelles de quinze ou vingt fleurs étoilées sont si épaisses […]"
                                            },
                                            {
                                                "example_id": "f93cdfe6-1196-4f04-be87-f2236c35dcfd",
                                                "sense_id": "1d2262cd-3eb8-3c8d-8391-4833c97f07b9",
                                                "text": "Une autre histoire, moins dénuée de sens, m’attendait au sommet de la colline où un carré envahi par les épilobes, les asclépiades et les vernonies, […]."
                                            },
                                            {
                                                "example_id": "5e6418f8-1d53-4057-b67b-40b9851c25ee",
                                                "sense_id": "1d2262cd-3eb8-3c8d-8391-4833c97f07b9",
                                                "text": "La chenille se nourrit essentiellement sur des asclépiades, des plantes à latex abondant (d’où leur dénomination anglaise de milkweed, « herbe à lait »)."
                                            },
                                            {
                                                "example_id": "8ce55ac2-e3ab-40ef-b18d-61ea3292d05f",
                                                "sense_id": "1d2262cd-3eb8-3c8d-8391-4833c97f07b9",
                                                "text": "En 2016 déjà, cette équipe avait prouvé dans une étude un lien direct entre les pesticides et le déclin de l’asclépiade, une herbacée vivace dont les papillons dépendent pour leur nourriture et leur reproduction."
                                            }
                                        ]
                                    }
                                ]
                            }
