                ],
                "senses": [
                    {
                        "sense_id": "93e1c4de-5168-3146-8a53-ec3efe7deb6c",
                        "entry_id": "6a80893f-92bd-3266-ac8b-a53dc75921b0",
                        "glosses": [
                            "dreiviertellanger Mantel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ebfcf1-bbcd-4b4d-9b55-ff7aed75a9e6",
                                "sense_id": "93e1c4de-5168-3146-8a53-ec3efe7deb6c",
                                "text": "„Paletot und Regenschirm hing Herr Mechmed an den Kleiderhaken, und es kann zugestanden werden, daß die kleine, untersetzte Gestalt, die jetzt, zerfallen und morbid, aber freundlich lächelnd, auf Flametti zukam, den mysteriösen Gestus jener Leute hatte, die im Traum wiederkehren.“"
                            },
                            {
                                "example_id": "9720e4c5-c342-4f3b-8755-03df5d333d9f",
                                "sense_id": "93e1c4de-5168-3146-8a53-ec3efe7deb6c",
                                "text": "„Er besaß einen schwarzen Paletot.“"
                            },
                            {
                                "example_id": "a5a8fb1b-33ee-4aa4-9603-ff60fe983c95",
                                "sense_id": "93e1c4de-5168-3146-8a53-ec3efe7deb6c",
                                "text": "„Alsdann zieht Großvater den Paletot mit dem Samtkragen an, den er auf einer Nachlaßauktion kaufte, aber noch nie getragen hat.“"
                            },
                            {
                                "example_id": "a2c49e33-d8a4-481a-8b08-ad5479773911",
                                "sense_id": "93e1c4de-5168-3146-8a53-ec3efe7deb6c",
                                "text": "„Während sie in diesen Anblick vertieft waren, ging ein Mann mit graumeliertem Haar in einem schwarzen Paletot den Pfad entlang und fuhr dabei mit seinem Spazierstock rasselnd über sämtliche Gitterstäbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
