                                        "glosses": [
                                            "A reclining chair with a long seat, which can support the outstretched legs of a sitter normally with one armrest."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6418a15b-2c93-4d3b-8ceb-37a73b5afa95",
                                                "sense_id": "9e4e2137-6483-3fbf-ba9e-38bfa1593f66",
                                                "text": "Hey, you, over there / On the chaise longue, in your underwear / What are you doing sitting down? / You should be horizontal now"
                                            }
