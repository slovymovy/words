                    {
                        "form_id": "3b8e907d-ff0e-4200-bfa7-8eb0c8be0891",
                        "entry_id": "bab86f0b-270d-3971-8d6d-924f4efc7562",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Parallelgesellschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c44809fe-5946-3541-8eb4-762b4397b8cf",
                        "entry_id": "bab86f0b-270d-3971-8d6d-924f4efc7562",
                        "glosses": [
                            "kleiner Teil der Gesellschaft, der seine eigene Kultur und Tradition pflegt, die sich von der der Mehrheit unterscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56cafac-6086-4231-9506-c48f7cdb36f5",
                                "sense_id": "c44809fe-5946-3541-8eb4-762b4397b8cf",
                                "text": "„Parallelgesellschaften sind wichtig und gut sowohl für Einwanderer als auch für die Mehrheitsgesellschaft.“"
                            },
                            {
                                "example_id": "c685b042-7711-42e5-be9b-0f4a0705e47e",
                                "sense_id": "c44809fe-5946-3541-8eb4-762b4397b8cf",
                                "text": "„Ich lehne mich nicht aus dem Fenster, wenn ich behaupte, dass sich Parallelgesellschaften mit festen Strukturen herausgebildet haben, die bereits heute nicht mehr einfach aufzulösen sind.“"
                            },
                            {
                                "example_id": "1d6d9f54-5f78-4288-b79c-cfe7ae51c810",
                                "sense_id": "c44809fe-5946-3541-8eb4-762b4397b8cf",
                                "text": "„Dabei befürchtete er: „Wenn tausende Kinder in Wien in islamische Kindergärten gehen und dort in einem rein muslimischen Umfeld aufwachsen, dann schadet das der Integration und schafft Parallelgesellschaften.““"
                            },
                            {
                                "example_id": "7e7e2896-9915-4527-a5a4-88ccfcde97a6",
                                "sense_id": "c44809fe-5946-3541-8eb4-762b4397b8cf",
                                "text": "„Manchmal ist eine Parallelgesellschaft nicht nur von Nachteil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
