        "fr-extract.jsonl": [
            {
                "entry_id": "b78cc601-2549-37e8-9a7a-e7fce935bcab",
                "word": "gonflette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ff04792-56fb-4f04-b02f-61ba5d216680",
                        "entry_id": "b78cc601-2549-37e8-9a7a-e7fce935bcab",
                        "tags": [
                            "plural"
                        ],
                        "form": "gonflettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "234b8042-3023-3f29-8b1c-cac9cdcb8d77",
                        "entry_id": "b78cc601-2549-37e8-9a7a-e7fce935bcab",
                        "glosses": [
                            "Musculation intensive pour développer le volume musculaire."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0d37d3e9-df7a-4142-9385-32363cea9302",
                                "sense_id": "234b8042-3023-3f29-8b1c-cac9cdcb8d77",
                                "text": "– Son régime alimentaire était devenu tout un truc. Il prononçait des mots comme électrolytes, indices glycémiques et acides aminés. Il fallait qu’elle lui fasse de la viande à tous les repas. C’était un gouffre, sa gonflette."
                            },
                            {
                                "example_id": "2a3d6ab7-05c8-4f70-8427-6f324a51d2f9",
                                "sense_id": "234b8042-3023-3f29-8b1c-cac9cdcb8d77",
                                "text": "Il fait de la gonflette à haute dose."
                            },
                            {
                                "example_id": "11cf913e-4a67-4517-9290-db94e6b1e8e4",
                                "sense_id": "234b8042-3023-3f29-8b1c-cac9cdcb8d77",
                                "text": "Pour obtenir cette harmonie plastique et de gros muscles, ils faisaient ce qu’on appelait : « la gonflette »."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c187f7c-3904-3a51-a6ba-985c12b0f6b1",
                        "entry_id": "b78cc601-2549-37e8-9a7a-e7fce935bcab",
                        "glosses": [
                            "Musculature exagérément développée, résultat d'exercices culturistes ou de prise de substances anabolisantes."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d9460988-9d6b-4bdc-94d8-e94b54bed8c9",
                                "sense_id": "7c187f7c-3904-3a51-a6ba-985c12b0f6b1",
                                "text": "À bas la gonflette, vive le naturel !"
                            },
                            {
                                "example_id": "45973fd1-9f5c-4541-97fd-33a81007b631",
                                "sense_id": "7c187f7c-3904-3a51-a6ba-985c12b0f6b1",
                                "text": "Athlète tout en gonflette – mais enfin, le résultat est là, on peut s’y méprendre et, après tout, l’essentiel n’est-il pas d’être de bonne compagnie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee652b98-1a7f-4b5d-bfec-74ab976c102d",
                        "source_entry_id": "b78cc601-2549-37e8-9a7a-e7fce935bcab",
                        "target_lang_word": "Bodybuilding",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bodybuilding",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acd68aca-3cec-39e7-a934-6d62106044d8",
                                        "entry_id": "184efa88-7356-3c6d-a696-9f9c078a9fb8",
                                        "glosses": [
                                            "Sportart, bei der die Modellierung des Körpers durch gezielte Muskelübungen, in der Regel unter Verwendung von Fitnessgeräten, im Mittelpunkt steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeccdbba-c7fb-4fd1-a5b6-f8bdd0fd1a46",
                                                "sense_id": "acd68aca-3cec-39e7-a934-6d62106044d8",
                                                "text": "Durch das Bodybuilding werden die Körpermuskel gestärkt und vergrößert."
                                            },
                                            {
                                                "example_id": "0e3a75c6-8d18-4242-a8eb-dc15e7995360",
                                                "sense_id": "acd68aca-3cec-39e7-a934-6d62106044d8",
                                                "text": "„Ich habe schon immer viele Sportfotos gemacht, aber ich war fasziniert davon, wie extrem der Sport und der Lebensstil Bodybuilding war.“"
                                            },
                                            {
                                                "example_id": "f0a33603-6c0f-4ac0-9cd9-de8726fe2eeb",
                                                "sense_id": "acd68aca-3cec-39e7-a934-6d62106044d8",
                                                "text": "„Die Jugendlichen hören ihm zu, weil er Bilder zeigt, auf denen er eingeölt bei Bodybuilding-Wettkämpfen seine imposanten Oberarme zeigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fdcdec4-3db1-4df7-b48e-8ea99d837783",
                        "source_entry_id": "b78cc601-2549-37e8-9a7a-e7fce935bcab",
                        "target_lang_word": "Muskelpaket",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskelpaket",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac22c3b8-3c2b-3692-9538-ac2e75ca193d",
                                        "entry_id": "1e6d1aaa-ea07-3a0a-b731-0be0f0463dd3",
                                        "glosses": [
                                            "auffallend kräftige Muskeln, die wie gebündelt wirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dff6f31-02ee-49e3-8427-00797c6f3ccb",
                                                "sense_id": "ac22c3b8-3c2b-3692-9538-ac2e75ca193d",
                                                "text": "„Große Muskelpakete sprangen auf Nacken und Schultern heraus.“"
                                            },
                                            {
                                                "example_id": "8bff9349-0672-49b3-af6c-0e252318794c",
                                                "sense_id": "ac22c3b8-3c2b-3692-9538-ac2e75ca193d",
                                                "text": "„Die Figuren waren überlebensgroß aufgeblasen, die Muskelpakete strotzten, die Ellbogen standen spitz und böse heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
