    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfbf7bf6-7428-32be-9dcd-e30587d5a57e",
                    "sense_definition": "To cause a train or vehicle to come off the tracks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "railway_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy collision caused the engine to <w>derail</w>."
                        },
                        {
                            "text": "The storm caused a tree to fall and <w>derail</w> the train."
                        }
                    ],
                    "synonyms": [
                        "unrail"
                    ],
                    "common_phrases": [
                        "derail the train"
                    ]
                },
                {
                    "sense_id": "cb6bf2a5-eb8f-34b9-b58b-94ab70535efc",
                    "sense_definition": "To come off the tracks, as a train or vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "railway_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train began to <w>derail</w> after hitting a large rock on the tracks."
                        },
                        {
                            "text": "It is very dangerous when a high-speed train starts to <w>derail</w>."
                        }
                    ]
                },
                {
                    "sense_id": "a4cee13c-c908-3714-ab8d-bb859c04c83d",
                    "sense_definition": "To cause a plan, process, or discussion to fail or stop making progress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected argument threatened to <w>derail</w> the entire project."
                        },
                        {
                            "text": "A sudden scandal can easily <w>derail</w> a political campaign."
                        }
                    ],
                    "common_phrases": [
                        "derail the project",
                        "derail the plans"
                    ]
                },
                {
                    "sense_id": "7e20804a-6c0e-377c-a7f6-fa0157e0aea5",
                    "sense_definition": "To deviate or wander away from a planned course or topic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting started well but began to <w>derail</w> when people started shouting."
                        },
                        {
                            "text": "The discussion will <w>derail</w> if we keep talking about unrelated issues."
                        }
                    ],
                    "common_phrases": [
                        "conversation will derail"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d45b38d-405a-353d-a1ae-c477735bcffe",
                    "sense_definition": "A safety device placed on railway tracks to force a train to leave the tracks to prevent a collision.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The safety inspector checked that the <w>derail</w> was functioning correctly."
                        },
                        {
                            "text": "A <w>derail</w> was installed to protect the main line from runaway cars."
                        }
                    ],
                    "synonyms": [
                        "derailer"
                    ],
                    "common_phrases": [
                        "install a derail"
                    ]
                },
                {
                    "sense_id": "383377ae-be28-389f-b2a7-a1da04216454",
                    "sense_definition": "An act of distracting or diverting a conversation from its main subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant interruptions were a deliberate <w>derail</w> of the debate."
                        },
                        {
                            "text": "The moderator tried to stop the <w>derail</w> of the important discussion."
                        }
                    ],
                    "common_phrases": [
                        "cause a derail"
                    ]
                }
            ]
        }
    ]
}