                                            {
                                                "example_id": "41c089fe-aaf6-46da-9755-0e3fdebff113",
                                                "sense_id": "23a6aee1-1c7e-3a70-bde1-807baeab1f9b",
                                                "text": "En 2002, le Canada ratifie le Protocole de Palerme sur la traite des personnes."
                                            }
                                        ]
                                    },
