                    {
                        "translation_id": "bcce15bb-7f43-44be-8bcc-c3b5ff0d6237",
                        "source_entry_id": "4d073875-29c4-3cdd-84e2-577319e344cb",
                        "source_sense_description": "распорядитель церемоний",
                        "target_lang_word": "M.C.",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "M.C.",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3704c09b-e1f2-338f-b7fa-734ba0b78185",
                                        "entry_id": "5d70a6bd-292c-390d-9a1c-d6ff483d8afc",
                                        "glosses": [
                                            "Initialism of master of ceremonies."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8778c4-d67d-4cdb-91d2-4188781e9b56",
                                                "sense_id": "3704c09b-e1f2-338f-b7fa-734ba0b78185",
                                                "text": "But the Oscars host, Jimmy Kimmel, doesn’t seem to have gotten the message. His commercial promoting the Oscars includes several references to Rock, a former host himself. And the spot, a spoof of “Top Gun: Maverick,” explains that ABC was intent on finding an M.C. “who’s unflappable — and unslappable.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b89eadcd-07e9-4540-9321-afc9ffe1fea1",
                        "source_entry_id": "4d073875-29c4-3cdd-84e2-577319e344cb",
                        "source_sense_description": "распорядитель церемоний",
                        "target_lang_word": "Zeremonienmeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeremonienmeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bffdb59-039e-3f2f-97bc-6695440d09c1",
                                        "entry_id": "306c0308-fe2d-3de9-b7a7-7b51e17cf4fc",
                                        "glosses": [
                                            "Person, die dafür zuständig ist, dass bei einem bedeutsamen Ereignis die Abläufe in angemessenen Formen vonstatten gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f8ac4e-1d7d-4a1d-a6c6-e63cdd001f40",
                                                "sense_id": "9bffdb59-039e-3f2f-97bc-6695440d09c1",
                                                "text": "„Dann kam der Zeremonienmeister der Universität in einer blauen Uniform, geschmückt mit Orden und Ehrenzeichen.“"
                                            },
                                            {
                                                "example_id": "47b1b46e-1efe-4bfe-9bd5-484b7032eed9",
                                                "sense_id": "9bffdb59-039e-3f2f-97bc-6695440d09c1",
                                                "text": "„Unser Zeremonienmeister trug weder eine Uniform noch irgendwelche Insignien zur Schau: seine Würde verkörperte sich allein durch seine Miene.“"
                                            },
                                            {
                                                "example_id": "e56cd5bb-2599-4be4-b2f9-ca178a4e9641",
                                                "sense_id": "9bffdb59-039e-3f2f-97bc-6695440d09c1",
                                                "text": "„Er fühlte sich bereits als Zeremonienmeister.“"
                                            },
                                            {
                                                "example_id": "89ba5093-303a-46c5-a5f5-84f187c6a56a",
                                                "sense_id": "9bffdb59-039e-3f2f-97bc-6695440d09c1",
                                                "text": "„Der keltische Zeremonienmeister, der früher einmal katholischer Priester war, wird ihnen ein Band über die Hände legen und sie mit einem Knoten fürs Leben verbinden, mit einer Adlerfeder wird er die Kräfte der Luft beschwören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
