                "senses": [
                    {
                        "sense_id": "abc24760-af5d-3701-b978-b48386511aae",
                        "entry_id": "85d88340-abd8-369f-b536-f540819dcfe3",
                        "glosses": [
                            "Verbund gleichartiger Zellen (Gewebe), die im Wesentlichen das Atmungsorgan Lunge ausmachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dab4076-8f57-4bd7-93c8-b5597c6dca01",
                                "sense_id": "abc24760-af5d-3701-b978-b48386511aae",
                                "text": "Eine Pneumonie ist eine Entzündung des Lungengewebes."
                            },
                            {
                                "example_id": "5b5772e3-5dda-4b4f-8709-d1259917fc63",
                                "sense_id": "abc24760-af5d-3701-b978-b48386511aae",
                                "text": "„Diese Partikel gelangen mit dem Luftstrom tief in die Lunge, wo sie das zarte Lungengewebe schädigen. Kleine Zellschäden kann der Körper durch ein eigenes Reparatursystem beheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
