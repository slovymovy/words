                                    {
                                        "sense_id": "568ec70b-0e81-32ba-b774-2ba3ff8f589a",
                                        "entry_id": "a194a47c-fc98-332d-9ef3-817c1e92c8b1",
                                        "glosses": [
                                            "Either of two breeds of dog (the smooth fox terrier and the wire fox terrier) bred for fox hunting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59f420e-ba46-4210-8d1f-370905480ea6",
                                                "sense_id": "568ec70b-0e81-32ba-b774-2ba3ff8f589a",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            },
                                            {
                                                "example_id": "c72955d4-22cc-40f3-aaf1-0e10be729f85",
                                                "sense_id": "568ec70b-0e81-32ba-b774-2ba3ff8f589a",
                                                "text": "After our fox-terrier had killed several of the Stationmaster's chickens and a peace offering had been made by my father in the form of cigars, I found that the way had been made clear for me to visit the junction box, and what a thrill it was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
