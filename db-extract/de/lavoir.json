                                "target_senses": [
                                    {
                                        "sense_id": "4e24e52c-55c4-35f6-9a4d-ec5b38db61f3",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Bassin public alimenté en eau aménagé pour rincer le linge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b80723ff-6ad3-3b97-a3b1-c50e7b6805de",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Bassin public alimenté en eau aménagé pour rincer le linge.",
                                            "Emplacement dans une ville où l’on peut laver le linge moyennant une rétribution."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cbae69e-711f-4b11-af9f-fe2f51ba13f8",
                                                "sense_id": "b80723ff-6ad3-3b97-a3b1-c50e7b6805de",
                                                "text": "Et voici le lavoir tari, où l’on peut vérifier, dans la vase qui garde les empreintes, quels chevaux ont l’habitude de se baigner."
                                            },
                                            {
                                                "example_id": "0981f552-ffe9-4210-a850-398be80eadd7",
                                                "sense_id": "b80723ff-6ad3-3b97-a3b1-c50e7b6805de",
                                                "text": "Il y avait beau temps, au lavoir communal ou sous les auvents d’aisseaux qu’on échangeait d’oreille à oreille de petites réflexions et qu’on se faisait part d’observations particulières […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c223cef-b020-317c-8a8c-e7f13ba9965e",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Bassin public alimenté en eau aménagé pour rincer le linge.",
                                            "Sorte de vaste bac avec un plan incliné pour laver le linge."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e0912c-fefd-4ac9-abb5-a4a5686e8fbd",
                                                "sense_id": "3c223cef-b020-317c-8a8c-e7f13ba9965e",
                                                "text": "Je gagnai le vestibule à tâtons, entre la cuisine et la buanderie. Je cherchais toujours. Disparue, l’essoreuse à linge, remplacé, l'ancien lavoir. À la place, un évier moderne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53e9908b-58c0-31c0-9cb6-b5ad918459a5",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Bassin public alimenté en eau aménagé pour rincer le linge.",
                                            "Blanchisserie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9efe5faf-37d4-4fd2-be9a-02ef479d0bb4",
                                                "sense_id": "53e9908b-58c0-31c0-9cb6-b5ad918459a5",
                                                "text": "Elle venait encore au lavoir, il y a quelques années, par plaisir, seulement pour rincer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "632edf3d-bdf3-3c42-8710-c106bbc7883d",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Dans les communautés et dans les sacristies, lieu où on se lave les mains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84c1e90c-0847-3feb-bd54-8a5045fe4c64",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Appareil destiné à laver les substances que l’on emploie dans les manufactures ; machine dont on se sert pour laver le minerai, dans les mines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2906828d-8844-4384-8b34-f29815cdcb1c",
                                                "sense_id": "84c1e90c-0847-3feb-bd54-8a5045fe4c64",
                                                "text": "La mine brute est lavée dans des lavoirs à bras suivant les procédés que nous avons déjà décrits."
                                            },
                                            {
                                                "example_id": "ce225253-d815-4859-986a-bb2a2ff0ce9c",
                                                "sense_id": "84c1e90c-0847-3feb-bd54-8a5045fe4c64",
                                                "text": "Tel est le but des courbes de lavabilité des charbons imaginées par Hanappe, vers l'année 1912 et dont l'usage est devenu courant dans tous les lavoirs français et belges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cd2128-5549-3d9f-8009-2675d69057c3",
                                        "entry_id": "380c244b-3053-3ce6-b0e5-0ee9ac00aa27",
                                        "glosses": [
                                            "Accessoire destiné à être vissé sur la baguette du fusil et qui permet de coincer un chiffon pour ensuite l'introduite dans l'âme du canon afin de le nettoyer l'arme."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ece6ba8-57e3-42bd-9961-3b683fe14a45",
                                                "sense_id": "72cd2128-5549-3d9f-8009-2675d69057c3",
                                                "text": "Lavoir : Accessoire de nettoyage du canon d'une arme dans lequel est ménagé une ouverture pour le passage d'un chiffon. Le lavoir comporte une partie filetée soit mâle soit femelle de façon à se visser sur l'extrémité d'une baguette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
