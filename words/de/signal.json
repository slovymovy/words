                },
                {
                    "sense_id": "e837e504-7a57-3ab5-9e00-625c65479edb",
                    "sense_definition": "Ereignis, Verhalten oder Umstand, der als Anzeichen, Aufforderung oder Warnung verstanden und gedeutet wird.",
