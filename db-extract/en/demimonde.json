                                    {
                                        "sense_id": "ca4d41ca-ee91-3d96-a299-6f728e056f63",
                                        "entry_id": "b0f3f09f-d259-385c-84fe-c7f93bb0e086",
                                        "glosses": [
                                            "Gesamtheit der natürlichen und sozialen Lebensverhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f956fa9-dd9f-4505-bdd0-70495207a686",
                                                "sense_id": "ca4d41ca-ee91-3d96-a299-6f728e056f63",
                                                "text": "Der Autor hat lange unter den Fischern gelebt, um das Milieu seines Romans genau kennenzulernen."
                                            },
                                            {
                                                "example_id": "addbdb8f-3418-481c-9b09-561081b63a83",
                                                "sense_id": "ca4d41ca-ee91-3d96-a299-6f728e056f63",
                                                "text": "„Irgendwie hatte das neue Milieu meinen Widerstand wachgerufen.“"
                                            },
                                            {
                                                "example_id": "f0b031db-3af3-43f9-a884-1bab686e0fb9",
                                                "sense_id": "ca4d41ca-ee91-3d96-a299-6f728e056f63",
                                                "text": "„Auch von anderen seines Milieus hörte ich solche Sätze.“"
                                            },
                                            {
                                                "example_id": "dbbb5bfd-4aad-4e95-9bc3-e59acb632bda",
                                                "sense_id": "ca4d41ca-ee91-3d96-a299-6f728e056f63",
                                                "text": "Dafür haben die Forscher Daten aus den Jahren 2011 bis 2015 ausgewertet und kommen zu dem Schluss, dass die sozialien Milieus sich als weitgehend undurchlässig erweisen."
                                            },
                                            {
                                                "example_id": "cde98fd8-14d4-4c8e-8bb2-624e339eab06",
                                                "sense_id": "ca4d41ca-ee91-3d96-a299-6f728e056f63",
                                                "text": "„All diesen Büchern machten sie den Vorwurf, daß sie nichts über das Milieu, das Zeitalter, das Kostüm der Personen aussagten.“"
                                            }
                                        ],
