                "senses": [
                    {
                        "sense_id": "04aa33e7-fcba-3569-b02d-b77160cfdf09",
                        "entry_id": "c9cda80d-4df8-3b23-9c48-0d87899a557f",
                        "glosses": [
                            "Person mit fundiertem Wissen und meist auch umfangreicher persönlicher Erfahrung im Bereich des Laufens/Laufsports"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "a8719b2f-cc86-4aff-b8cc-f40abd639731",
                                "sense_id": "04aa33e7-fcba-3569-b02d-b77160cfdf09",
                                "text": "„Unsere Laufexperten geben euch Tipps für eine ökonomische Lauftechnik und entspanntes Atmen mit Synchronität von Atem- und Schrittfrequenz.“"
                            },
                            {
                                "example_id": "a49fa0a7-7f68-4335-ba5d-b7bf529d89ce",
                                "sense_id": "04aa33e7-fcba-3569-b02d-b77160cfdf09",
                                "text": "„Laufexperte Viktor Röthlin erklärt die wichtigsten Punkte, die es vor einem kurzen Laufwettkampf über 5–10 Kilometer zu beachten gilt.“"
                            },
                            {
                                "example_id": "1e1f5fac-2434-4dd7-ad6b-198fe0ce1845",
                                "sense_id": "04aa33e7-fcba-3569-b02d-b77160cfdf09",
                                "text": "„Die Fachberatung erfolgt von Laufexperten und basiert auf technischen Analyse-Tools.“"
                            },
                            {
                                "example_id": "454a36ab-832a-4893-9565-0b6429e71512",
                                "sense_id": "04aa33e7-fcba-3569-b02d-b77160cfdf09",
                                "text": "„‚Lasst euch nicht von den vielen Fachbegriffen verunsichern’, rät der Laufexperte.“"
                            },
                            {
                                "example_id": "3795444e-5f6e-4261-80bf-310cb6da5fa6",
                                "sense_id": "04aa33e7-fcba-3569-b02d-b77160cfdf09",
                                "text": "„Angelehnt an das Stadtradeln haben Laufexperten aus Leer/Ostfriesland ein Angebot für Wanderer, Walker, Spaziergänger und Läufer geschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
