                            "comparative"
                        ],
                        "form": "more bloodless"
                    },
                    {
                        "form_id": "dff286b3-bd30-4996-9326-b664ba0e7846",
                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most bloodless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                        "glosses": [
                            "Lacking blood; ashen, anaemic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "334a993b-cbe4-42b3-9c3b-d1546dc307a7",
                                "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                "text": "My bloodleſſe bodie waxeth chill and colde,\nAnd with my blood my life ſlides through my wound,\nMy ſoule begins to take her flight to hell,\nAnd ſummones all my ſences to depart: […]"
                            },
                            {
                                "example_id": "8f8e0272-4018-4b37-bdbb-652d5179b2e5",
                                "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                "text": "Thou dost not slumber: see, thy two sons’ heads,\nThy warlike hand, thy mangled daughter here:\nThy other banish’d son, with this dear sight\nStruck pale and bloodless; and thy brother, I,\nEven like a stony image, cold and numb."
                            },
                            {
                                "example_id": "5eaf6041-0c98-4a50-bae0-4941a27606c8",
                                "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                "text": "The face was white and thoroughly bloodless with some kind of foundation cream; it stank of powder and a gardenia-like perfume."
                            }
                        ]
                    },
                    {
                        "sense_id": "5db9e638-d478-30b4-a5d0-32b6c59ab4bd",
                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                        "glosses": [
                            "Taking place without loss of blood."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c0ea6b-10b6-4ed5-98cd-b30a806bbde5",
                                "sense_id": "5db9e638-d478-30b4-a5d0-32b6c59ab4bd",
                                "text": "a bloodless conquest; a bloodless coup d'état; a bloodless revolution; a bloodless victory"
                            },
                            {
                                "example_id": "00d089de-e563-414d-9ef8-81dd2f0039ca",
                                "sense_id": "5db9e638-d478-30b4-a5d0-32b6c59ab4bd",
                                "text": "Now and then a gaudy peacock would run from his shelter in the lauhala trees, but no wild boars came out, so we returned from our raid bloodless and spoilless."
                            }
                        ]
                    },
                    {
                        "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                        "glosses": [
                            "Lacking emotion, passion or vivacity."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe98337-4166-4bda-ae09-58783b2f52df",
                                "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                "text": "Those Philharmonic subscribers who considered Guest Conductor Igor Stravinsky too bloodless and ascetic […] last week found his successor, Georges Enesco, more to their taste."
                            },
                            {
                                "example_id": "64725b35-e17b-4077-9aee-1748c662ebc7",
                                "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                "text": "Many of them are leaving us — the words. Gone into hiding […] Now they lurk, uncaged, behind other words, behind trending, brittle, bloodless little wokeisms […]"
                            },
                            {
                                "example_id": "aa6fe84a-d783-4bda-8c55-2f3b5dfc3970",
                                "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                "text": "There is plenty of commentary, even among users of other platforms, about how Threads is bloodless (and owned by Mark Zuckerberg), Mastodon is inscrutable, and Bluesky is humorless."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fca3ab7-3ee2-4c86-9dc3-190e25e275a2",
                        "source_entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                        "source_sense_description": "lacking blood",
                        "target_lang_word": "blutarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blutarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa29e684-4444-3723-8d04-5566d2f3cb37",
                                        "entry_id": "76cedd20-aac7-37ab-bb5c-393773685f29",
                                        "glosses": [
                                            "mit einem Mangel an Blut beziehungsweise roten Blutkörperchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602f4784-227e-4a7b-b408-4838739b6318",
                                                "sense_id": "aa29e684-4444-3723-8d04-5566d2f3cb37",
                                                "text": "„Blutarme und herzschwache Fettleibige sollten keine anstrengenden Bergtouren unternehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88ee8558-8232-3723-be77-b25f428eee8a",
                                        "entry_id": "76cedd20-aac7-37ab-bb5c-393773685f29",
                                        "glosses": [
                                            "farblos, unscheinbar, blass"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2806b86c-63c9-4d49-9512-773fd6f85b24",
                                                "sense_id": "88ee8558-8232-3723-be77-b25f428eee8a",
                                                "text": "„Andererseits darf sie dabei die ohnehin blutarme amerikanische Wirtschaft nicht zusätzlich schwächen.“"
                                            },
                                            {
                                                "example_id": "8af71d2e-98bc-4ae3-852f-a7d752d9a1cd",
                                                "sense_id": "88ee8558-8232-3723-be77-b25f428eee8a",
                                                "text": "„Diese lässt den Film mitunder recht blutarm wirken.“"
                                            },
                                            {
                                                "example_id": "da02caa4-533c-486c-9535-0d1a7bd8aa81",
                                                "sense_id": "88ee8558-8232-3723-be77-b25f428eee8a",
                                                "text": "„Die Story ist rudimentär, und die Figuren sind derart blutarm, dass selbst ein Hochkaräter wie Christian Redl eigentümlich blass bleibt.“"
                                            },
                                            {
                                                "example_id": "bb4bcc5b-127e-4603-a4b7-0aedb8341db1",
                                                "sense_id": "88ee8558-8232-3723-be77-b25f428eee8a",
                                                "text": "„Unter Anführung des Argentiniers Mauricio Pochettino stürmten die mit vielen englischen Talenten bestückten Lilienweißen heißblütig bis auf den zweiten Platz, während Wengers blutarme Techniker-Equipe die Qualifikation für die Champions League verpasste und zur Strafe in der ungeliebten Europa League spielen muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "blutarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c0db381-8408-343e-b3fe-406245b01e6f",
                                        "entry_id": "6a055c64-5f89-3a89-9b26-fcac1f5be46f",
                                        "glosses": [
                                            "keinerlei Besitz habend; vollkommen mittellos; sehr arm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14461038-55a0-44b6-a991-29a159878bbc",
                                                "sense_id": "3c0db381-8408-343e-b3fe-406245b01e6f",
                                                "text": "„Durch diese räuberischen Ueberfälle, welche noch zweimal wiederholt wurden, sind die meisten Familien blutarm geworden.“"
                                            },
                                            {
                                                "example_id": "3069e4ec-c529-4741-80a8-55a92997fc30",
                                                "sense_id": "3c0db381-8408-343e-b3fe-406245b01e6f",
                                                "text": "„So gesund hatte der Kandidat ohnehin nicht ausgesehen, sagte er sich, war wohl ein blutarmer jüdischer Buchhalter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a58d95-afb5-4aa7-ab02-3a4c97bc49f9",
