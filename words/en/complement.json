{
    "word_family": [
        "complementary",
        "complementation",
        "complementarity"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "083f3a7e-0bbd-3eda-a0ed-62e983090d1e",
                    "sense_definition": "To provide what a partner lacks and lack what the partner provides, thus forming a balanced or harmonious whole.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "complete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flavors of the pepper and garlic <w>complement</w> each other, giving a very rich taste in combination.",
                            "target_lang_translations": {
                                "ru": "Вкусы перца и чеснока <w>дополняют</w> друг друга, создавая очень насыщенный вкус в сочетании."
                            }
                        },
                        {
                            "text": "I believe our talents really <w>complement</w> each other in this project.",
                            "target_lang_translations": {
                                "ru": "Я верю, что наши таланты действительно <w>дополняют</w> друг друга в этом проекте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "complement each other"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнять друг друга, создавая сбалансированное или гармоничное целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "взаимно сочетаться"
                            },
                            {
                                "target_lang_word": "взаимно дополнять",
                                "target_lang_sense_clarification": "о партнерах или качествах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cff9ed3-7058-36fb-bffc-9eaa669a65eb",
                    "sense_definition": "To complete, to bring to perfection, or to make something whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We believe your addition will <w>complement</w> the team perfectly.",
                            "target_lang_translations": {
                                "ru": "Мы верим, что ваше присоединение идеально <w>дополнит</w> команду."
                            }
                        },
                        {
                            "text": "A fine wine will <w>complement</w> a good meal and enhance the overall experience.",
                            "target_lang_translations": {
                                "ru": "Хорошее вино <w>дополнит</w> вкусный ужин и улучшит общее впечатление."
                            }
                        }
                    ],
                    "common_phrases": [
                        "complement the team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершать, доводить до совершенства или делать что-либо полным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "делать более полным"
                            },
                            {
                                "target_lang_word": "дополнить",
                                "target_lang_sense_clarification": "завершить образ или состав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aca5a66-f1a3-3f08-a5b2-a4ca693cc6a5",
                    "sense_definition": "To change a voltage, number, color, or other value to its mathematical or logical opposite.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical-change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In binary arithmetic, you can <w>complement</w> the bits to perform subtraction.",
                            "target_lang_translations": {
                                "ru": "В двоичной арифметике вы можете <w>инвертировать</w> биты для выполнения вычитания."
                            }
                        },
                        {
                            "text": "The software allows you to <w>complement</w> the colors in the image to find their opposites.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет <w>находить дополнение</w> к цветам на изображении, чтобы найти их противоположности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять значение (число, цвет, бит) на его математическую или логическую противоположность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвертировать",
                                "target_lang_sense_clarification": "логическое или битовое значение"
                            },
                            {
                                "target_lang_word": "находить дополнение",
                                "target_lang_sense_clarification": "математическое действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40b28b7e-788a-3b7e-a976-591b7bc8527c",
                    "sense_definition": "Obsolete spelling or misspelling of <w>compliment</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, he wrote that he would <w>complement</w> her on her singing.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи он написал, что сделает ей <w>комплимент</w> по поводу её пения."
                            }
                        },
                        {
                            "text": "It is a common error to <w>complement</w> someone when you mean to praise them.",
                            "target_lang_translations": {
                                "ru": "Частой ошибкой является написание <w>complement</w>, когда вы хотите кого-то похвалить."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical spelling"
                        },
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее или ошибочное написание слова 'compliment' (комплимент)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить комплименты",
                                "target_lang_sense_clarification": "ошибочное написание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47f6c499-fae3-34d7-b871-d8f59827c5db",
                    "sense_definition": "Something that completes or combines with something else to make a whole; a harmonious partner or addition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new scarf is a perfect <w>complement</w> to her outfit.",
                            "target_lang_translations": {
                                "ru": "Новый шарф — идеальное <w>дополнение</w> к её наряду."
                            }
                        },
                        {
                            "text": "London's Kings Place established itself as a venue for imaginative programming, a <w>complement</w> to the evergreen Wigmore Hall.",
                            "target_lang_translations": {
                                "ru": "Лондонский Кингс-Плейс зарекомендовал себя как площадка для креативных программ, <w>дополнение</w> к неизменному Вигмор-холлу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perfect complement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что завершает или сочетается с чем-то другим для создания целого; гармоничное дополнение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "к одежде, интерьеру или набору"
                            },
                            {
                                "target_lang_word": "добавка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e694ba7b-90ce-30ce-9261-ed70cf35f414",
                    "sense_definition": "The full amount or number required to make something complete.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "totality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship sailed once it had its full <w>complement</w> of sailors on board.",
                            "target_lang_translations": {
                                "ru": "Корабль отплыл, как только на борту был <w>полный состав</w> моряков."
                            }
                        },
                        {
                            "text": "Some 11 members of the council's <w>complement</w> of 15 stepped down on Tuesday.",
                            "target_lang_translations": {
                                "ru": "Около 11 членов из <w>штатного состава</w> совета в 15 человек ушли в отставку во вторник."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full complement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный состав или количество, необходимое для укомплектования чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный состав",
                                "target_lang_sense_clarification": "команды или экипажа"
                            },
                            {
                                "target_lang_word": "штатная численность",
                                "target_lang_sense_clarification": "организации"
                            },
                            {
                                "target_lang_word": "комплект",
                                "target_lang_sense_clarification": "полный набор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2d9e7a1-3afc-3939-8ca8-6900cee5cfbf",
                    "sense_definition": "A word or group of words that completes a grammatical construction in the predicate, describing the subject or object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the sentence 'He is a doctor', the phrase 'a doctor' serves as a subject <w>complement</w>.",
                            "target_lang_translations": {
                                "ru": "В предложении «Он врач» фраза «врач» служит <w>дополнением</w> к подлежащему."
                            }
                        },
                        {
                            "text": "Verbs like 'become' or 'seem' typically require a <w>complement</w> to make sense.",
                            "target_lang_translations": {
                                "ru": "Глаголы типа «становиться» или «казаться» обычно требуют <w>дополнения</w>, чтобы иметь смысл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "subject complement",
                        "object complement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово или группа слов, завершающая грамматическую конструкцию в сказуемом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "второстепенный член предложения"
                            },
                            {
                                "target_lang_word": "комплемент",
                                "target_lang_sense_clarification": "в лингвистической теории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49549f77-d245-36d2-a2ad-c17f36a0f7e2",
                    "sense_definition": "The color which, when mixed with a given color, produces a neutral gray, black, or white.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>complement</w> of blue is orange on the standard color wheel.",
                            "target_lang_translations": {
                                "ru": "<w>Дополнительным цветом</w> к синему на стандартном цветовом круге является оранжевый."
                            }
                        },
                        {
                            "text": "Artists often use a <w>complement</w> to create high contrast in their paintings.",
                            "target_lang_translations": {
                                "ru": "Художники часто используют <w>дополнительный цвет</w> для создания высокого контраста в своих картинах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "color complement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвет, который при смешивании с данным цветом дает нейтральный серый, черный или белый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный цвет",
                                "target_lang_sense_clarification": "в теории цвета"
                            },
                            {
                                "target_lang_word": "комплементарный цвет",
                                "target_lang_sense_clarification": "противоположный в цветовом круге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2756b61e-6a0b-306f-8773-77632343566c",
                    "sense_definition": "In set theory, the set containing elements that are not members of a given set.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>complement</w> of the odd numbers is the even numbers, relative to the natural numbers.",
                            "target_lang_translations": {
                                "ru": "<w>Дополнением</w> к нечетным числам являются четные числа относительно множества натуральных чисел."
                            }
                        },
                        {
                            "text": "To find the <w>complement</w>, you must identify all elements in the universal set not in set A.",
                            "target_lang_translations": {
                                "ru": "Чтобы найти <w>дополнение</w>, вы должны определить все элементы универсального множества, не входящие в множество А."
                            }
                        }
                    ],
                    "common_phrases": [
                        "relative complement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В теории множеств: множество, содержащее элементы, не входящие в данное множество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "абсолютное дополнение множества"
                            },
                            {
                                "target_lang_word": "разность множеств",
                                "target_lang_sense_clarification": "относительное дополнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e694576-e680-383f-83a8-88a3319b6c88",
                    "sense_definition": "A group of blood proteins that work with antibodies to destroy pathogens during an immune response.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>complement</w> system plays a vital role in the body's innate immune defense.",
                            "target_lang_translations": {
                                "ru": "Система <w>комплемента</w> играет жизненно важную роль в врожденной иммунной защите организма."
                            }
                        },
                        {
                            "text": "Deficiencies in <w>complement</w> proteins can lead to increased susceptibility to infections.",
                            "target_lang_translations": {
                                "ru": "Дефицит белков <w>комплемента</w> может привести к повышенной восприимчивости к инфекциям."
                            }
                        }
                    ],
                    "synonyms": [
                        "alexin"
                    ],
                    "common_phrases": [
                        "complement system"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа белков крови, участвующих в иммунном ответе для уничтожения патогенов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплемент",
                                "target_lang_sense_clarification": "система белков сыворотки крови"
                            },
                            {
                                "target_lang_word": "алексин",
                                "target_lang_sense_clarification": "устаревший термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b852bfb-4505-3f03-84bd-032611bbc6ef",
                    "sense_definition": "A nucleotide sequence in which each base is replaced by its corresponding pairing partner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A DNA molecule is formed from two strands, each of which is the <w>complement</w> of the other.",
                            "target_lang_translations": {
                                "ru": "Молекула ДНК образована из двух цепей, каждая из которых является <w>комплементарной</w> другой."
                            }
                        },
                        {
                            "text": "The researcher synthesized a <w>complement</w> to the viral RNA sequence.",
                            "target_lang_translations": {
                                "ru": "Исследователь синтезировал <w>комплементарную последовательность</w> к вирусной РНК."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "genetics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность нуклеотидов, в которой каждое основание заменено на соответствующее парное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплементарная последовательность",
                                "target_lang_sense_clarification": "в генетике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50812fbd-270c-37f4-906f-8c886b660d69",
                    "sense_definition": "An angle which, when added to a given angle, results in a right angle (90 degrees).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If an angle is 30 degrees, its <w>complement</w> is 60 degrees.",
                            "target_lang_translations": {
                                "ru": "Если угол равен 30 градусам, его <w>дополнение до прямого угла</w> составляет 60 градусов."
                            }
                        },
                        {
                            "text": "The sum of an angle and its <w>complement</w> is always ninety degrees.",
                            "target_lang_translations": {
                                "ru": "Сумма угла и его <w>дополнения до прямого угла</w> всегда равна девяноста градусам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "geometry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол, который при сложении с данным углом дает прямой угол (90 градусов)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение до прямого угла",
                                "target_lang_sense_clarification": "в геометрии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc382b64-04f2-336e-a54a-610663da82df",
                    "sense_definition": "Obsolete spelling or misspelling of <w>compliment</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book described him as a man of <w>complements</w> and fine manners.",
                            "target_lang_translations": {
                                "ru": "В старой книге он описывался как человек, умеющий говорить <w>комплименты</w> и обладающий изысканными манерами."
                            }
                        },
                        {
                            "text": "It was once common to see <w>complement</w> used where we now use compliment.",
                            "target_lang_translations": {
                                "ru": "Когда-то было обычным делом видеть написание <w>complement</w> там, где мы сейчас используем compliment."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical spelling"
                        },
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее или ошибочное написание слова 'compliment' (любезность, похвала)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплимент",
                                "target_lang_sense_clarification": "ошибочное написание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}