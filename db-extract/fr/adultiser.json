                "senses": [
                    {
                        "sense_id": "cc2afd9e-cf27-3714-b862-4f123c9f63d2",
                        "entry_id": "12aa6d55-bfbc-3f05-b3eb-75d654e9821f",
                        "glosses": [
                            "Donner un caractère adulte à (un enfant…), traiter (un enfant) comme un adulte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2b4071a-7236-472f-ba88-e3f2e134c53a",
                                "sense_id": "cc2afd9e-cf27-3714-b862-4f123c9f63d2",
                                "text": "Si on cessait d'adultiser l'enfance?"
                            },
                            {
                                "example_id": "796c73f8-4326-44c0-8662-16c245efdbb4",
                                "sense_id": "cc2afd9e-cf27-3714-b862-4f123c9f63d2",
                                "text": "Veillez à laisser votre enfant vivre une vie d'enfant, sans « l'adultiser » trop tôt, recommande Françoise Peille."
                            },
                            {
                                "example_id": "178c72be-3ff3-4ea6-ab4a-b45be6e9f126",
                                "sense_id": "cc2afd9e-cf27-3714-b862-4f123c9f63d2",
                                "text": "La joie à l’école, ce serait à la fois qu’on soit heureux d’étre jeune et heureux de s’« adultiser » en faisant appel à la médiation de l’adulte enseignant ;"
                            }
                        ]
                    }
