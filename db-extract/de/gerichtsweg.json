                "senses": [
                    {
                        "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                        "entry_id": "980b7e84-942a-341a-820e-32e45c1ba6a9",
                        "glosses": [
                            "unter Hinzuziehung eines Gerichts, gerichtlich"
                        ],
                        "tags": [
                            "Justiz"
                        ],
                        "examples": [
                            {
                                "example_id": "3db881ea-89ec-4312-b47e-8c256e147504",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„In Missouri und South Dakota erreichten Häftlinge auf dem Gerichtswege die Einstellung von Hinrichtungen mit der Giftspritze.“"
                            },
                            {
                                "example_id": "a8fbe580-fde6-42da-beae-a8f4f6bbe1d9",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„»Vielleicht müssen wir das auf dem Gerichtsweg durchsetzen.«“"
                            },
                            {
                                "example_id": "70ce3545-38ea-4932-afa3-90757820b684",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„Die Bürgerrechtsorganisation National Association for the Advancement of Colored People – kurz NAACP - bekämpfte die Diskriminierung von Afroamerikanern auf dem Gerichtsweg.“"
                            },
                            {
                                "example_id": "c4f56451-7a84-4eaf-9e43-effd69682a17",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„Auch wenn Trumps Bemühen von Tag zu Tag aufs Neue scheitert, die Präsidentenwahl auf dem Gerichtsweg zu kippen - die Zahl seiner Anhänger, die glauben, die Wahl sei manipuliert, steigt.“"
                            },
                            {
                                "example_id": "c73d5b22-3e0b-4acf-8596-44e237e4652c",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„Der AUA-Bordbetriebsrat wollte allerdings auf dem Gerichtsweg sicherstellen, auch nach dem Betriebsübergang für die AUA-Piloten und Flugbegleiter zuständig zu sein. Der Antrag auf einstweilige Verfügung wurde vom Landesgericht Korneuburg abgewiesen,“ […]."
                            },
                            {
                                "example_id": "1dc1af28-2518-409c-a376-0e587bef88c0",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "[Olympische Sommerspiele 2008:] „Der Dreispringer Charles Friedek scheiterte mit seinem Versuch, eine Teilnahme auf dem Gerichtsweg zu erzwingen.“"
                            },
                            {
                                "example_id": "4d80c55c-9eb6-4357-bb89-7e67630afadf",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "[Olympische Sommerspiele 2008:] „Die Schwimmerin Vipa Bernhardt, die sich ihre Teilnahme ebenfalls auf dem Gerichtsweg erstreiten wollte, zog ihren Antrag später zurück.“"
                            },
                            {
                                "example_id": "39fbea94-2e6c-4014-bb93-9f62f98b7b51",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„Mehrere Frauen und Männer aus Europa, auch aus Deutschland, sitzen bis heute in diesen kurdischen Lagern – ehemalige IS-Unterstützer, die versuchen über den Gerichtsweg ihre Rückkehr nach Deutschland zu erstreiten.“"
                            },
                            {
                                "example_id": "ff8f44ed-e5bc-4bc5-a70d-4d31accea71c",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "„»Also beschlossen wir, unsererseits der Polizei mit dem Gerichtsweg zu drohen, weil sich ihre Schikanen auf unseren Vertrieb auswirkten.«“"
                            },
                            {
                                "example_id": "ffc68a74-9d71-4d2a-844f-0433a3a6a33c",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "Patienten haben oft weder die Energie noch die Zeit, um einen langen Gerichtsweg in Angriff zu nehmen, meint Stefan Greuter."
                            },
                            {
                                "example_id": "1c6c9558-9943-4392-8662-e478a83c1f16",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "[Schmähgedichte gegen Politiker:] „Im antiken Rom hätte es theoretisch Möglichkeiten der juristischen Gegenwehr gegeben. »Aber da war man als Politiker nicht gut beraten, den Gerichtsweg zu beschreiten. Man musste das entweder aushalten können oder noch besser: Man musste entsprechend virtuos zurückschlagen können.«“"
                            },
                            {
                                "example_id": "ca349336-469b-40fe-ba18-c4149dffab65",
                                "sense_id": "ffdbe3c4-323b-3995-9d35-996ff44d5d06",
                                "text": "Die Finanzprokuratur hat jetzt drei Monate Zeit, auf die Eingabe zu reagieren, zu zahlen oder einen Vorschlag zu machen, danach wird der Gerichtsweg beschritten werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
