                                "example_id": "b70cced6-4365-4fad-80e7-534afc81fe74",
                                "sense_id": "29d3fc53-248e-337d-8af4-d0cf9e084487",
                                "text": "Garouter : Courir les chemins et hanter les croisées dans les ténèbres de la nuit, après être devenu garou."
                            }
