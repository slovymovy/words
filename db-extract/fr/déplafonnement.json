                    {
                        "sense_id": "06f02db0-ea53-3079-9466-61a65acb5ec3",
                        "entry_id": "3ca3ae5a-cd7b-335a-8e00-7a28945aae11",
                        "glosses": [
                            "Suppression d’un prix plafond."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "c2498dd8-4cb3-4616-8c71-e70363ec4e61",
                                "sense_id": "06f02db0-ea53-3079-9466-61a65acb5ec3",
                                "text": "Le déplafonnement, mesure simple à mettre en œuvre, devrait avoir un effet incitatif sur l’emploi puisque le coût de l’heure supplémentaire de régressif devient constant et conduirait à plus d’équité."
                            },
                            {
                                "example_id": "a69a0de7-b5e2-4dc2-a8a8-7e4673913025",
                                "sense_id": "06f02db0-ea53-3079-9466-61a65acb5ec3",
                                "text": "Les pilotes dénoncent le déplafonnement de leur âge limite d'activité en vol à 65 ans, prévu dans un amendement parlementaire au budget de la Sécurité sociale pour 2009."
                            },
                            {
                                "example_id": "7a71d4cc-f48d-445b-994c-0758795ea722",
                                "sense_id": "06f02db0-ea53-3079-9466-61a65acb5ec3",
                                "text": "Très souvent le bailleur essaye d’imposer le déplafonnement du loyer au moment de son renouvellement."
                            }
                        ]
                    }
