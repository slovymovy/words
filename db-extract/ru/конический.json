                                "target_senses": [
                                    {
                                        "sense_id": "8ff7dc7d-c831-3128-85fb-96d21221dbe3",
                                        "entry_id": "c86a4cec-5a8f-34e0-a496-0b7e03125b04",
                                        "glosses": [
                                            "Of or relating to a cone or cones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8584eef1-f08f-496b-9194-a97ea0b30608",
                                                "sense_id": "8ff7dc7d-c831-3128-85fb-96d21221dbe3",
                                                "text": "He anſwers, That this Motion is Conical; and judgeth, that by the Conick path all the Phænomena of Comets can, without any inconveniency, be readily ſolved; even of that, which (by Hiſtory) in fifty days, paſſed through more then the 12 Signs of the Zodiack; And of that, which in two days run through eight Signs: and of another, which in 48 days poſted through all the Signs, contra ſeriem."
                                            }
                                        ]
                                    },
                                    {
