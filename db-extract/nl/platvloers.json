                    {
                        "translation_id": "dfaf0971-c043-45b6-acdf-d1d890daccf9",
                        "source_entry_id": "69bdca4d-5606-3743-a5ea-236a85b33780",
                        "source_sense_id": "d9af7746-a431-3ed8-b8f5-e3d8d5faff0c",
                        "source_sense_description": "laag bij de grond, onbeschaafd",
                        "target_lang_word": "corny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3702af26-580a-3f14-bfcb-830beb8c8c50",
                                        "entry_id": "4f042904-5971-30b4-9085-09451c59f03b",
                                        "glosses": [
                                            "Boring and unoriginal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93663808-63b6-4514-843c-f4197cf621cd",
                                                "sense_id": "3702af26-580a-3f14-bfcb-830beb8c8c50",
                                                "text": "The duct tape and wire was a pretty corny solution."
                                            },
                                            {
                                                "example_id": "b1c8409f-5755-4500-b164-c3091bb7f460",
                                                "sense_id": "3702af26-580a-3f14-bfcb-830beb8c8c50",
                                                "text": "I mean if a boy's mother was sort of fat or corny-looking or something, and if somebody’s father was one of those guys that wear those suits with very big shoulders and corny black-and-white shoes, then old Haas would just shake hands with them and give them a phony smile and then he'd go talk, for maybe a half an hour, with somebody else's parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef860df-bac4-32a9-8a00-2b3a3bab4b76",
                                        "entry_id": "4f042904-5971-30b4-9085-09451c59f03b",
                                        "glosses": [
                                            "Hackneyed or excessively sentimental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b8aad17-f3b6-4379-8b49-f5fc1064883f",
                                                "sense_id": "3ef860df-bac4-32a9-8a00-2b3a3bab4b76",
                                                "text": "The movie was okay, but the love scene was really corny."
                                            },
                                            {
                                                "example_id": "35fbbf0d-930b-46d1-8062-a9ab0a90904a",
                                                "sense_id": "3ef860df-bac4-32a9-8a00-2b3a3bab4b76",
                                                "text": "He sent a bouquet of twelve red roses and a card: \"Roses are red, Violets are blue, Sugar is sweet, And so are you.\" How corny is that!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0bc18e6-b156-31e7-8594-3195703c5959",
                                        "entry_id": "4f042904-5971-30b4-9085-09451c59f03b",
                                        "glosses": [
                                            "Uncool, stupid, lame."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c17f13c-f906-4b33-ba90-4262c4178d41",
                                                "sense_id": "f0bc18e6-b156-31e7-8594-3195703c5959",
                                                "text": "Dreya shakes her head and rolls her eyes. \"I'm going to bed. Y'all corny.\""
                                            },
                                            {
                                                "example_id": "b331495c-3d7e-4b8c-a0bd-626dcd07347f",
                                                "sense_id": "f0bc18e6-b156-31e7-8594-3195703c5959",
                                                "text": "“You and your silly bitch better give me fifty feet before both y'all corny asses get slam dunked in that pool.”"
                                            },
                                            {
                                                "example_id": "7e25dbb1-0de9-4ae6-bab2-98c6b15bb1e6",
                                                "sense_id": "f0bc18e6-b156-31e7-8594-3195703c5959",
                                                "text": "Y'all haters corny with that Illuminati mess"
                                            },
                                            {
                                                "example_id": "a9b37160-fe75-4090-b392-79c7eaadde2b",
                                                "sense_id": "f0bc18e6-b156-31e7-8594-3195703c5959",
                                                "text": "\"No, no, no,\" James said Wednesday (via ESPN). \"That's wack. That's wack. Why? You got to earn your spot to be in the postseason. No consolation for finishing last. That's corny. That's corny. That's wack. To play for what? What are they playing for?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                                        "entry_id": "4f042904-5971-30b4-9085-09451c59f03b",
                                        "glosses": [
                                            "Containing corn."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d792ac-3a41-41ac-a274-a571ae86469f",
                                                "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                                                "text": "Country Cornbread Muffins (page 290) / Marlene Says: The cool crunchy salad and slightly sweet corny muffins are perfect partners to the creamy, spicy black bean soup."
                                            },
                                            {
                                                "example_id": "ce499a98-d0ff-4513-b197-d34ecc285dcf",
                                                "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                                                "text": "There are cornbread recipes, and there are cornbread recipes. This one absolutely sings. Based on her daddy’s, and then her sister’s, beloved skillet-made bread, Maggie’s own recipe developed over time. It’s more about method, she says, but using stone-ground cornmeal and whole buttermilk are just as important. And a hot, seasoned cast-iron skillet is a must. What emerges is a rich “corny” bread, an almost melting soft interior encased in a ridiculously toothsome crust."
                                            },
                                            {
                                                "example_id": "90e3b079-3867-40f6-a7e0-6abb54979da4",
                                                "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                                                "text": "“CORNY” BREAD MUFFINS + HONEY BUTTER (GRAIN-, DAIRY-, SOY-, NIGHTSHADE-FREE) Well, making cornbread without corn is kinda tricky, but since corn is indeed a grain, “real” cornbread will not be found here."
                                            },
                                            {
                                                "example_id": "6a882989-b5f5-4af6-8ca0-83781dddaa69",
                                                "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                                                "text": "Fiesta Corny Muffins / Cornbread goes with everything: salad, soup, and chili."
                                            },
                                            {
                                                "example_id": "675339f6-1a0c-464c-b00d-59595fd1e137",
                                                "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                                                "text": "Have beans, bacon, and cornbread for dinner.[…]Have peas, bacon, and corny bread for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a47aa8-5e8f-3e49-94cf-78830f3ba96b",
                                        "entry_id": "4f042904-5971-30b4-9085-09451c59f03b",
                                        "glosses": [
                                            "Producing corn or grain; furnished with grains of corn."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da612f7d-adeb-4874-a5e1-86fb38917aaa",
                                                "sense_id": "e9a47aa8-5e8f-3e49-94cf-78830f3ba96b",
                                                "text": "The corny ear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62fe56ea-fec3-363b-82cb-d27438c251e3",
                                        "entry_id": "4f042904-5971-30b4-9085-09451c59f03b",
                                        "glosses": [
                                            "Tipsy; drunk."
                                        ],
                                        "tags": [
                                            "UK",
