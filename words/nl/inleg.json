                    "target_lang_definitions": {
                        "en": "an extra strip of fabric on the inside of a garment, often at a hem, to allow for adjustments"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inlay",
                                "target_lang_sense_clarification": "fabric insert"
