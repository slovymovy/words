                    {
                        "translation_id": "93ac555e-b0ee-442e-a41b-ed4298825a46",
                        "source_entry_id": "a52a70b4-2565-3922-89f0-7c67846b710f",
                        "source_sense_description": "framework",
                        "target_lang_word": "pergola",
                        "target_lang_code": "nl",
