                    },
                    {
                        "form_id": "27fbfd75-90a5-45be-8d90-a9aa279d6e97",
                        "entry_id": "bb5abc98-e321-3d03-be2f-0d0f3d55047c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "non-fumeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1cf3a70-d755-3134-bd56-b41d95982ae4",
                        "entry_id": "bb5abc98-e321-3d03-be2f-0d0f3d55047c",
                        "glosses": [
                            "Personne qui ne fume pas de tabac, par opposition aux fumeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281085e0-fda1-48d0-9c1f-9a59ac0ce1d0",
                                "sense_id": "f1cf3a70-d755-3134-bd56-b41d95982ae4",
                                "text": "On dirait en vérité que c’est le non-fumeur qui a besoin d’excuses."
                            },
                            {
                                "example_id": "38221d7d-d569-4991-8ca1-8bdff631e434",
                                "sense_id": "f1cf3a70-d755-3134-bd56-b41d95982ae4",
                                "text": "Une enquête menée auprès du public en 1957 révélait en effet que 70 % des non-fumeurs et 64 % des fumeurs citaient les problèmes de santé comme l’un des désavantages majeurs de la consommation des cigarettes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a60ef5ec-3865-4064-8262-f3d1858e2a24",
                        "source_entry_id": "bb5abc98-e321-3d03-be2f-0d0f3d55047c",
                        "source_sense_id": "f1cf3a70-d755-3134-bd56-b41d95982ae4",
                        "target_lang_word": "Nichtraucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtraucher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10a3f328-e6f1-36a1-9347-fcae37955613",
                                        "entry_id": "751c74b5-8ac8-326e-bde0-07c81e8bdfab",
                                        "glosses": [
                                            "Person, die keinen Tabak in verbrannter Form inhaliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c068a55-5e30-4a90-91cc-3f5bd43f8b5b",
                                                "sense_id": "10a3f328-e6f1-36a1-9347-fcae37955613",
                                                "text": "„Zigarre gefällig?“ - „Nein danke, ich bin strikter Nichtraucher.“"
                                            },
                                            {
                                                "example_id": "137cd70d-970d-4440-9e4c-42dc804e94f9",
                                                "sense_id": "10a3f328-e6f1-36a1-9347-fcae37955613",
                                                "text": "„Die von den Wirten zur Abtrennung errichteten Glastüren stehen meist offen, um die Arbeit des Personals zu erleichtern, und ebenso oft sind Nichtraucher gezwungen, durch den Raucherbereich zu gehen, um etwa zu den Toiletten oder überhaupt erst zum Nichtraucherbereich zu gelangen – was der Verwaltungsgerichtshof bereits 2013 als nicht gesetzeskonform moniert hatte.“"
                                            },
                                            {
                                                "example_id": "fc2dec06-e545-47a5-bb33-8c24e4b6e70d",
                                                "sense_id": "10a3f328-e6f1-36a1-9347-fcae37955613",
                                                "text": "„Auf Nichtraucher Rücksicht zu nehmen gilt für rund drei viertel aller Bundesbürger als Zeichen guten Benehmens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f213746-11bf-3365-9ae2-0856ea32be26",
                                        "entry_id": "751c74b5-8ac8-326e-bde0-07c81e8bdfab",
                                        "glosses": [
                                            "Ort, an dem das Rauchen nicht erlaubt ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9fce531-ad81-4147-b6d3-35506cd6cb36",
                                                "sense_id": "5f213746-11bf-3365-9ae2-0856ea32be26",
                                                "text": "„Ich muss Sie bitten, Ihre Zigarette auszumachen. Dieses Abteil ist ein Nichtraucher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
