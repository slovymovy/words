{
    "word_family": [
        "mad",
        "madden",
        "madness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "955834e8-03e7-306f-9691-4f887f1daffd",
                    "sense_definition": "Causing extreme frustration or annoyance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frustrating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>maddening</w> when the computer crashes right before I save my work.",
                            "target_lang_translations": {
                                "de": "Es ist <w>zum Verrücktwerden</w>, wenn der Computer abstürzt, kurz bevor ich meine Arbeit speichere."
                            }
                        },
                        {
                            "text": "The <w>maddening</w> sound of the dripping tap kept me awake all night.",
                            "target_lang_translations": {
                                "de": "Das <w>nervenaufreibende</w> Geräusch des tropfenden Wasserhahns hielt mich die ganze Nacht wach."
                            }
                        }
                    ],
                    "synonyms": [
                        "frustrating",
                        "annoying",
                        "exasperating"
                    ],
                    "common_phrases": [
                        "maddening delay",
                        "maddening silence"
                    ],
                    "target_lang_definitions": {
                        "de": "Extrem frustrierend oder nervenaufreibend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zum Verrücktwerden",
                                "target_lang_sense_clarification": "idiomatisch für eine Situation, die einen wahnsinnig macht"
                            },
                            {
                                "target_lang_word": "nervenaufreibend",
                                "target_lang_sense_clarification": "etwas, das die Nerven stark beansprucht"
                            },
                            {
                                "target_lang_word": "zum Verzweifeln",
                                "target_lang_sense_clarification": "etwas, das einen an den Rand der Verzweiflung bringt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9804b983-cd56-3771-9bdf-d7895487dcb4",
                    "sense_definition": "Causing someone to lose their sanity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner endured the <w>maddening</w> isolation of the dark cell for many years.",
                            "target_lang_translations": {
                                "de": "Der Gefangene ertrug über viele Jahre die <w>in den Wahnsinn treibende</w> Isolation der dunklen Zelle."
                            }
                        },
                        {
                            "text": "He felt a <w>maddening</w> pressure building inside his mind as the deadline approached.",
                            "target_lang_translations": {
                                "de": "Er spürte einen <w>wahnsinnig machenden</w> Druck in seinem Kopf, als die Frist näher rückte."
                            }
                        }
                    ],
                    "synonyms": [
                        "dementing"
                    ],
                    "target_lang_definitions": {
                        "de": "Den Verstand raubend oder in den Wahnsinn treibend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wahnsinnig machend",
                                "target_lang_sense_clarification": "wörtlich: den Verstand raubend"
                            },
                            {
                                "target_lang_word": "in den Wahnsinn treibend",
                                "target_lang_sense_clarification": "beschreibt einen Prozess, der jemanden den Verstand verlieren lässt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f78014ed-92de-3676-a336-7b83e330eec7",
                    "sense_definition": "Present participle and gerund of <w>madden</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise was <w>maddening</w> the neighbors.",
                            "target_lang_translations": {
                                "de": "Der ständige Lärm war dabei, die Nachbarn <w>in den Wahnsinn zu treiben</w>."
                            }
                        },
                        {
                            "text": "He spent his days <w>maddening</w> his rivals with clever tricks.",
                            "target_lang_translations": {
                                "de": "Er verbrachte seine Tage damit, seine Rivalen mit cleveren Tricks <w>in den Wahnsinn zu treiben</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb madden."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens von 'madden' (in den Wahnsinn treiben)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "in den Wahnsinn treibend",
                                "target_lang_sense_clarification": "jemanden verrückt machen"
                            },
                            {
                                "target_lang_word": "aufreibend",
                                "target_lang_sense_clarification": "jemanden stark belasten oder nerven"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}