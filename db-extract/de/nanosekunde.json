                ],
                "senses": [
                    {
                        "sense_id": "9e8a737c-c669-36af-807e-98379187e599",
                        "entry_id": "ab457028-dafe-36d5-978e-511c92f4566d",
                        "glosses": [
                            "eine Milliardstel Sekunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "572b2c9d-d4ed-45fe-a0de-4331bb6cf033",
                                "sense_id": "9e8a737c-c669-36af-807e-98379187e599",
                                "text": "Das Licht legt in einer Nanosekunde etwa 0,3 Meter zurück."
                            },
                            {
                                "example_id": "08962126-d79c-4cee-98bb-1e708c7d19fa",
                                "sense_id": "9e8a737c-c669-36af-807e-98379187e599",
                                "text": "„Ferdinand hat einen kleinen Rückfall, legt auf einem Spiegel ein par Bahnen aus, sie findet ihn draußen auf der Toilette, wo er mit einer der anderen frohen Mütter rammelt, und in einer Nanosekunde ist sie von der großen, stolzen, souveränen, unverletzlichen Mama auf einen geistigen Gnom reduziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41e7c41f-ac67-432d-b486-d848d87ecd93",
                        "source_entry_id": "ab457028-dafe-36d5-978e-511c92f4566d",
                        "source_sense_id": "9e8a737c-c669-36af-807e-98379187e599",
                        "source_sense_description": "eine Milliardstel Sekunde",
                        "target_lang_word": "nanosecond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanosecond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98d591f0-76f3-3082-9ede-4cdf854ce2a5",
                                        "entry_id": "fbf1c810-cddd-3cda-ace8-c8e8d82a3ad4",
                                        "glosses": [
                                            "An SI unit of time equal to 10⁻⁹ seconds. Symbol: ns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f43fd2-6df8-4c9d-b9ed-a14c4422bee9",
                                                "sense_id": "98d591f0-76f3-3082-9ede-4cdf854ce2a5",
                                                "text": "Holonyms: microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "b413c78d-8b7e-4a3a-84f2-d7e4670b37d0",
                                                "sense_id": "98d591f0-76f3-3082-9ede-4cdf854ce2a5",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond"
                                            },
                                            {
                                                "example_id": "006beead-de47-400f-9dc3-9461265c7ff9",
                                                "sense_id": "98d591f0-76f3-3082-9ede-4cdf854ce2a5",
                                                "text": "Since the tiny magnetic domains have to travel only submolecular distances, it is possible to read and write magnetic regions with different polarization as quickly as a single nanosecond — far faster than existing storage technologies."
                                            },
                                            {
                                                "example_id": "11ed2c13-8853-4f8b-b16e-5e5258888a41",
                                                "sense_id": "98d591f0-76f3-3082-9ede-4cdf854ce2a5",
                                                "text": "“We were heavily involved in also trading: people on Wall Street were buying our stuff to save a few nanoseconds on the wire, the banks were doing crazy things like pulling the fibres under the Hudson taut to make them a little big shorter, to save a few nanoseconds between their datacentre and the stock exchange,” he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "344d6f5e-3dd7-492b-8626-8a7f81ccfd44",
                        "source_entry_id": "ab457028-dafe-36d5-978e-511c92f4566d",
                        "source_sense_id": "9e8a737c-c669-36af-807e-98379187e599",
                        "source_sense_description": "eine Milliardstel Sekunde",
                        "target_lang_word": "nanoseconde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanoseconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "441b71ad-3d12-36f3-8e43-51cdd283581a",
                                        "entry_id": "af823f37-0b86-399a-ad0a-2edd123ab3f3",
                                        "glosses": [
                                            "Unité de mesure de temps du Système international (SI), valant 10⁻⁹ seconde, et dont le symbole est ns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a037df95-a8a1-48d7-a547-5391fe20aab6",
                                                "sense_id": "441b71ad-3d12-36f3-8e43-51cdd283581a",
                                                "text": "Cela doit faire au moins une nanoseconde de différence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f6e9401-d145-3f0b-9e85-8c6a46ebf6c4",
                                        "entry_id": "af823f37-0b86-399a-ad0a-2edd123ab3f3",
                                        "glosses": [
                                            "Infime partie de temps."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61fc9622-4be5-4aeb-805a-d7e72949493d",
                                                "sense_id": "6f6e9401-d145-3f0b-9e85-8c6a46ebf6c4",
                                                "text": "Il y eut avant tout les autres jours les autres fois les autres voix qui vont suivre, plusieurs jours plusieurs fois plusieurs voix jusqu’à ce que aucun ne se distingue aucune ne traverse plus le mur du son de mon corps. Ce fut un magma de jours, d’heures et de nanoSEcondes. Un magma de voix diverses, une multitude de chants sans tête pensante sans coryphée sans harmonie particulière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
