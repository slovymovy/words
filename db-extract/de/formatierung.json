                        "entry_id": "4110ffde-b935-3313-99d6-3f89d56cc298",
                        "glosses": [
                            "Handlung und Ereignis, bei dem einem Datenträger ein neues für die Aufnahme von Daten nötiges Format zugewiesen wird"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "1d008259-5427-4c99-b306-20af76e32682",
                                "sense_id": "ed5f0d6b-b06d-385c-a266-5ad634aed462",
                                "text": "Bei der Formatierung sollte man keine weiteren Programme starten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d464a9d2-7ea5-3548-a354-8804bb6524da",
                        "entry_id": "4110ffde-b935-3313-99d6-3f89d56cc298",
                        "glosses": [
                            "das durch [1] entstandene Format"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "21673fb0-5ef5-4741-a033-1423060ce166",
                                "sense_id": "d464a9d2-7ea5-3548-a354-8804bb6524da",
                                "text": "Die Formatierung von Festplatte C:\\ ist fehlerhaft."
                            },
                            {
                                "example_id": "087d2320-94c7-4f52-bb03-1db032029e7c",
                                "sense_id": "d464a9d2-7ea5-3548-a354-8804bb6524da",
                                "text": "„Hier wäre Kursivierung ideal, aber Formatierungen gehen schnell verloren, wo es hektisch zugeht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
