                        "entry_id": "e2b5f98d-3815-3893-8ef1-89a4a96bc94e",
                        "glosses": [
                            "een werkwoordswijs waarmee men een wens of onzekerheid tot uitdrukking kan brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808a0995-6d2b-4c66-b87a-3aae13f04493",
                                "sense_id": "e3b5d622-09a8-32c1-a5ef-e3e870860003",
                                "text": "Lang leve de koningin!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad96ecc7-dd8c-4d80-80df-987c16645d1d",
                        "source_entry_id": "e2b5f98d-3815-3893-8ef1-89a4a96bc94e",
                        "source_sense_id": "e3b5d622-09a8-32c1-a5ef-e3e870860003",
                        "source_sense_description": "een werkwoordswijs waarmee men een wens of onzekerheid tot uitdrukking kan brengen.",
                        "target_lang_word": "Konjunktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konjunktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d7f5c8-64ce-3f79-b76e-597cd5f3b526",
                                        "entry_id": "a5ce96e3-5053-39c4-a120-a55bb01d6fe5",
                                        "glosses": [
                                            "derjenige der Modi, der das Geschehen nicht als wirklich, sondern nur als vorgestellt (Irrealität, Potenzialität) oder von einem anderen behauptet (Referat) darstellt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c6bd61-9cc9-4f37-a98a-6bdcd2c4d09e",
                                                "sense_id": "d4d7f5c8-64ce-3f79-b76e-597cd5f3b526",
                                                "text": "„Der Indikativ eines beliebigen Gliedsatzes geht ebenfalls in den Konjunktiv über (Angleichung).“"
                                            },
                                            {
                                                "example_id": "142afc99-b3a6-4bf6-84e9-eab9e23c5e61",
                                                "sense_id": "d4d7f5c8-64ce-3f79-b76e-597cd5f3b526",
                                                "text": "„Der Mann behauptete, er hätte mich gesehen.“ Das Wort „hätte“ steht im Konjunktiv."
                                            },
                                            {
                                                "example_id": "0b189a5c-8ab8-46bb-b041-071f7d4ca853",
                                                "sense_id": "d4d7f5c8-64ce-3f79-b76e-597cd5f3b526",
                                                "text": "„Noch haben wir in Deutschland diese Möglichkeitsform, den Konjunktiv, und können auf diese Weise unterscheiden zwischen dem, was wirklich ist, und dem, was geschehen könnte.“"
                                            },
                                            {
                                                "example_id": "ff2ce558-9859-4309-bcdb-685e2c8010d1",
                                                "sense_id": "d4d7f5c8-64ce-3f79-b76e-597cd5f3b526",
                                                "text": "„Dabei lassen wir uns von der Annahme leiten, daß der Konjunktiv in der Sprache der Politik neue Aufgaben übernimmt, dies vor allem in Staaten, in denen verschiedene Parteien das politische System repräsentieren.“"
                                            },
                                            {
                                                "example_id": "901d1399-c662-458a-ac7e-9309ab096473",
                                                "sense_id": "d4d7f5c8-64ce-3f79-b76e-597cd5f3b526",
                                                "text": "„In meinem Tagebuch war ich, wenn mir meine Geschichte zu intim wurde, in Präteritum und Konjunktiv geflüchtet, hatte direkte und indirekte Rede gekehrt, Gegenwart in Vergangenheit entrückt, hatte Distanz geschaffen, das Geschehen entschärft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5001af2c-20bc-4568-b588-f8a8cabcc8ba",
