                ],
                "senses": [
                    {
                        "sense_id": "e8f8ad5c-593a-39a2-97f1-57c4e0a4ab97",
                        "entry_id": "b99d0d50-903b-3ee3-9a49-f73d4e75ffe3",
                        "glosses": [
                            "der Kopf eines Schafes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "433b7fdc-93e4-45e2-9923-579e2f15de3e",
                                "sense_id": "e8f8ad5c-593a-39a2-97f1-57c4e0a4ab97",
                                "text": "„In der Ferne zeichnete sich nun ein Pfeiler der Bosporus-Brücke ab, dahinter breitete sich über eine Hügellandschaft der asiatische Teil Istanbuls aus, Üsküdar, wo wir essen und trinken wollten und staunend an Metzgerläden hängende Bündel ausgewaschener Därme und auf der Ladefläche eines Lastwagens Reihen abgeschlagener, sorgfältig nach Farbe und Größe sortierter Schafsköpfe begutachten würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bb92799e-c001-3144-9152-90252f9a4b7a",
                        "entry_id": "b99d0d50-903b-3ee3-9a49-f73d4e75ffe3",
                        "glosses": [
                            "dummer, einfältiger Mensch"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "1844f958-eda5-4ee3-86b4-fb76135e4e1c",
                                "sense_id": "bb92799e-c001-3144-9152-90252f9a4b7a",
                                "text": "Du Schafskopf!"
                            },
                            {
                                "example_id": "b6bbf4a1-1149-40d6-a8fa-36c05676b85f",
                                "sense_id": "bb92799e-c001-3144-9152-90252f9a4b7a",
                                "text": "„Man sagte uns, es gäbe nichts zum Essen, aber ich lachte den Wirt aus; es gab Butter, Eier, Makkaroni, Reis, Parmesan, Brot und guten Wein; und dieser Schafskopf sah nicht, daß man daraus ein ausgezeichnetes Mahl bereiten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
