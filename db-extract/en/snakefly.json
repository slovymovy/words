                        "sense_id": "15585609-a19e-39de-85df-3ab15a660dd7",
                        "entry_id": "5ef1ebf9-7e76-3c5b-a5c6-c4b3e54e0e34",
                        "glosses": [
                            "Any insect of the order Raphidioptera."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da537247-7715-489e-8d56-457caad8a5c8",
                                "sense_id": "15585609-a19e-39de-85df-3ab15a660dd7",
                                "text": "Although sexual behavior is not well studied in the order, observations exist for members of both snakefly families."
                            },
                            {
                                "example_id": "0445b13a-4e7a-4f92-9779-812e9bb8c993",
                                "sense_id": "15585609-a19e-39de-85df-3ab15a660dd7",
                                "text": "Adult snakeflies stalk their prey in a manner similar to snakes. When an insect comes within reach, the snakefly will strike, catching the victim with its jaws."
                            },
                            {
                                "example_id": "eae00ba9-75b4-404d-9a66-5a1f5406e5c7",
                                "sense_id": "15585609-a19e-39de-85df-3ab15a660dd7",
                                "text": "The order snakeflies (Raphidioptera) consists predominantly of saproxylic predators (Aspöck, 2002). Snakeflies have an almost worldwide distribution, mostly occurring in temperate regions and in mountainous areas closer to the equator."
                            }
                        ]
                    }
                ],
