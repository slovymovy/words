                "translations": [
                    {
                        "translation_id": "50bc916d-74d4-4e50-9cc9-132b5c5d5c83",
                        "source_entry_id": "243ee731-2594-3e27-9c48-51626ce1f552",
                        "source_sense_id": "158b7820-a7de-377a-b81c-62369245d4c0",
                        "source_sense_description": "een gebedssnoer met 165 kralen",
                        "target_lang_word": "Rosenkranz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosenkranz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbcc8dce-3a7e-3720-8b29-1ac068d4d800",
                                        "entry_id": "3e9bc984-1d9d-365e-973b-5e5e81613c06",
                                        "glosses": [
                                            "eine Form des Gebetes, Rosenkranzgebet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccfe2da-63ee-4e22-b276-c9317b2435fc",
                                                "sense_id": "fbcc8dce-3a7e-3720-8b29-1ac068d4d800",
                                                "text": "Er betet den Rosenkranz."
                                            },
                                            {
                                                "example_id": "78aaf285-88dd-4249-9d47-6600c432149d",
                                                "sense_id": "fbcc8dce-3a7e-3720-8b29-1ac068d4d800",
                                                "text": "„Jeden Samstag betet sie den Rosenkranz in der Dorfkapelle.“"
                                            },
                                            {
                                                "example_id": "ae9d8264-22a4-4519-ab72-410e36eddd6b",
                                                "sense_id": "fbcc8dce-3a7e-3720-8b29-1ac068d4d800",
                                                "text": "„Um mich heil ins Tageslicht zu geleiten, brauchte es jetzt Bannsprüche und Beschwörungsformeln, Gebetsmühlen, Rosenkränze und Litaneien.“"
                                            },
                                            {
                                                "example_id": "5721a32b-612a-40c2-81c7-620eada404ca",
                                                "sense_id": "fbcc8dce-3a7e-3720-8b29-1ac068d4d800",
                                                "text": "„Da seine Predigten mit Stellen aus griechischen Autoren gespickt waren, die er auf lateinisch zitierte, sagte ich ihm eines Tages, er müsse sie auf italienisch zitieren, denn die Frauen, die ihm zuhörten und dazu ihren Rosenkranz beteten, verstünden Latein ebensowenig wie Griechisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1972cc26-9914-3d7e-8bcc-50e3adbb2142",
                                        "entry_id": "3e9bc984-1d9d-365e-973b-5e5e81613c06",
                                        "glosses": [
                                            "Perlenschnur, die als Zählkette für das Rosenkranzgebet dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68425429-63fa-4b6d-bb08-fc88b0070c35",
                                                "sense_id": "1972cc26-9914-3d7e-8bcc-50e3adbb2142",
                                                "text": "„Als er schließlich im Sarg lag, mußten sie ihm die Hände mit Draht zusammenbinden, dann den Rosenkranz durch die Schlingen ziehen, weil sie sich nicht mehr falten ließen.“"
                                            },
                                            {
                                                "example_id": "6b239fe5-038b-41b9-9607-26eaeb430650",
                                                "sense_id": "1972cc26-9914-3d7e-8bcc-50e3adbb2142",
                                                "text": "„Unser ältester Landwehrmann, Bauernknecht aus Berchtesgaden, zieht seinen Rosenkranz hervor und betet leise.“"
                                            },
                                            {
                                                "example_id": "c3a7557f-8584-4101-9ea2-77016ebfcaf6",
                                                "sense_id": "1972cc26-9914-3d7e-8bcc-50e3adbb2142",
                                                "text": "„Mir erteilte er ihn sehr nachdrücklich und schenkte mir noch einen Rosenkranz aus Achat mit einem dünnen Goldkettchen, der wohl zwölf Zechinen wert war.“"
                                            },
                                            {
                                                "example_id": "d89ea721-0ebf-42e0-bc98-74d383502ae8",
                                                "sense_id": "1972cc26-9914-3d7e-8bcc-50e3adbb2142",
                                                "text": "„Gegen Ende seines Lebens schlich er resigniert aus einer nur scheinbar universellen Macht und setzte sich in einem spanischen Kloster zur Ruhe, die Reichsinsignien mit dem Rosenkranz vertauschend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0dc718a-962b-43d2-936f-a76c4d397efd",
                        "source_entry_id": "243ee731-2594-3e27-9c48-51626ce1f552",
                        "source_sense_id": "158b7820-a7de-377a-b81c-62369245d4c0",
