                "senses": [
                    {
                        "sense_id": "45ff48e8-6271-31da-a960-5d8ec31e3cca",
                        "entry_id": "87054ef7-b723-3b2c-982c-034986b3e404",
                        "glosses": [
                            "den Anschein erweckend, durch die (eiszeitliche) Einwirkung von Eis/sich bewegenden Eismassen (Gletschern) geschaffen worden zu sein, jedoch einen anderen Ursprung habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae15320-f62a-41f8-b797-991edc826f51",
                                "sense_id": "45ff48e8-6271-31da-a960-5d8ec31e3cca",
                                "text": "„In der Alten Welt gehören zu den periglazialen Verfirnungen das Zentralplateau der Auvergne, Vogesen und Schwarzwald, Jura, Harz, Böhmerwald, Riesengebirge, während andere Vergletscherungsangaben (Pfälzer Wald, Rhön, Venn usw.), weil sie pseudoglazial sind, einzuziehen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
