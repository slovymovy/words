{
    "word_family": [
        "vaporize",
        "vaporization",
        "vaporous",
        "vapid",
        "evaporate",
        "evaporation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73632afd-762b-3924-a1c0-cfd1bd233760",
                    "sense_definition": "The gaseous state of a substance that is normally a solid or liquid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gas_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When water is heated to its boiling point, it turns into water <w>vapor</w>.",
                            "target_lang_translations": {
                                "ru": "Когда вода нагревается до температуры кипения, она превращается в водяной <w>пар</w>."
                            }
                        },
                        {
                            "text": "The scientist measured the concentration of mercury <w>vapor</w> in the laboratory air.",
                            "target_lang_translations": {
                                "ru": "Ученый измерил концентрацию <w>паров</w> ртути в воздухе лаборатории."
                            }
                        }
                    ],
                    "synonyms": [
                        "gas"
                    ],
                    "antonyms": [
                        "solid",
                        "liquid"
                    ],
                    "common_phrases": [
                        "water vapor",
                        "mercury vapor",
                        "vapor pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Газообразное состояние вещества, которое обычно является твердым или жидким."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пар",
                                "target_lang_sense_clarification": "физическое состояние вещества"
                            },
                            {
                                "target_lang_word": "газ",
                                "target_lang_sense_clarification": "агрегатное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac4edcd1-8daa-3e35-abb8-fac40370f25c",
                    "sense_definition": "Cloudy diffused matter such as mist, steam or fumes suspended in the air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gas_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thick <w>vapor</w> rose from the hot springs, obscuring our view of the mountains.",
                            "target_lang_translations": {
                                "ru": "Густой <w>туман</w> поднимался от горячих источников, закрывая вид на горы."
                            }
                        },
                        {
                            "text": "The morning <w>vapor</w> clung to the surface of the lake until the sun rose higher.",
                            "target_lang_translations": {
                                "ru": "Утренняя <w>дымка</w> держалась над поверхностью озера, пока солнце не поднялось выше."
                            }
                        }
                    ],
                    "synonyms": [
                        "mist",
                        "steam",
                        "fumes",
                        "haze",
                        "fog"
                    ],
                    "common_phrases": [
                        "morning vapor",
                        "thick vapor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Облакообразное рассеянное вещество, такое как туман, дым или испарения, взвешенные в воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "испарения",
                                "target_lang_sense_clarification": "дымка или влага в воздухе"
                            },
                            {
                                "target_lang_word": "дымка",
                                "target_lang_sense_clarification": "легкий туман"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "499678a8-0bc1-3ece-9686-ee8d0032f66e",
                    "sense_definition": "Any medicinal agent designed for administration in the form of inhaled vapour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a medicinal <w>vapor</w> to help clear the patient's congested lungs.",
                            "target_lang_translations": {
                                "ru": "Врач прописал лечебную <w>ингаляцию</w>, чтобы помочь очистить заложенные легкие пациента."
                            }
                        },
                        {
                            "text": "She used a soothing <w>vapor</w> to ease her cough during the night.",
                            "target_lang_translations": {
                                "ru": "Она использовала успокаивающий <w>пар</w>, чтобы облегчить кашель ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "inhalant"
                    ],
                    "common_phrases": [
                        "medicinal vapor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое лекарственное средство, предназначенное для введения в форме вдыхаемых паров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ингаляция",
                                "target_lang_sense_clarification": "лекарственные пары"
                            },
                            {
                                "target_lang_word": "пар",
                                "target_lang_sense_clarification": "лечебное испарение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "340e2797-a150-32b8-aaa7-1e44212c1d87",
                    "sense_definition": "Something insubstantial, fleeting, or transitory; unreal fancy or idle talk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His promises of wealth turned out to be mere <w>vapor</w> once the investigation began.",
                            "target_lang_translations": {
                                "ru": "Его обещания богатства оказались лишь <w>пустыми словами</w>, как только началось расследование."
                            }
                        },
                        {
                            "text": "The poet described human life as a fleeting <w>vapor</w> that appears for a moment and then vanishes.",
                            "target_lang_translations": {
                                "ru": "Поэт описал человеческую жизнь как мимолетный <w>призрак</w>, который появляется на мгновение и затем исчезает."
                            }
                        }
                    ],
                    "synonyms": [
                        "fancy",
                        "chimera"
                    ],
                    "antonyms": [
                        "substance",
                        "reality"
                    ],
                    "common_phrases": [
                        "mere vapor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то несущественное, мимолетное или преходящее; нереальная фантазия или пустые разговоры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "нечто нереальное"
                            },
                            {
                                "target_lang_word": "пустое",
                                "target_lang_sense_clarification": "не имеющее веса или значения"
                            },
                            {
                                "target_lang_word": "дым",
                                "target_lang_sense_clarification": "метафора чего-то преходящего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7065ea49-a17c-34ea-82c9-3b92e631444d",
                    "sense_definition": "A nervous disorder characterized by depression, anxiety, or hysteria.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Victorian novels, characters often suffered from a fit of the <w>vapors</w> after receiving bad news.",
                            "target_lang_translations": {
                                "ru": "В викторианских романах персонажи часто страдали от приступа <w>вапора</w>, получив плохие новости."
                            }
                        },
                        {
                            "text": "She felt an attack of the <w>vapors</w> coming on and had to sit down immediately.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала приближение приступа <w>хандры</w> и была вынуждена немедленно сесть."
                            }
                        }
                    ],
                    "synonyms": [
                        "depression",
                        "hysteria",
                        "melancholy"
                    ],
                    "common_phrases": [
                        "fit of the vapors",
                        "attack of the vapors"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historically used for nervous ailments"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нервное расстройство, характеризующееся депрессией, тревогой или истерией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вапор",
                                "target_lang_sense_clarification": "устаревшее название нервного припадка"
                            },
                            {
                                "target_lang_word": "хандра",
                                "target_lang_sense_clarification": "уныние или меланхолия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3859413-4b96-3310-a0c7-e3284472acab",
                    "sense_definition": "To turn into vapor or to cause a substance to turn into vapor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat of the sun began to <w>vapor</w> the remaining puddles on the pavement.",
                            "target_lang_translations": {
                                "ru": "Сильная жара от солнца начала <w>испарять</w> оставшиеся лужи на тротуаре."
                            }
                        },
                        {
                            "text": "If you leave the alcohol uncovered, it will slowly <w>vapor</w> away into the room.",
                            "target_lang_translations": {
                                "ru": "Если оставить спирт открытым, он будет медленно <w>испаряться</w> в комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "evaporate",
                        "vaporize"
                    ],
                    "antonyms": [
                        "condense"
                    ],
                    "common_phrases": [
                        "vapor away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращаться в пар или заставлять вещество превращаться в пар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испарять",
                                "target_lang_sense_clarification": "превращать в газ"
                            },
                            {
                                "target_lang_word": "испаряться",
                                "target_lang_sense_clarification": "переходить в газообразное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d09098c0-2fe9-3c3d-affb-58e6c671b884",
                    "sense_definition": "To emit vapor or fumes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot soup started to <w>vapor</w> as soon as it was poured into the cold bowl.",
                            "target_lang_translations": {
                                "ru": "Горячий суп начал <w>парить</w>, как только его налили в холодную миску."
                            }
                        },
                        {
                            "text": "The chemicals in the beaker began to <w>vapor</w> when the reaction reached its peak.",
                            "target_lang_translations": {
                                "ru": "Химикаты в стакане начали <w>дымиться</w>, когда реакция достигла своего пика."
                            }
                        }
                    ],
                    "synonyms": [
                        "fume",
                        "steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять пар или испарения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дымиться",
                                "target_lang_sense_clarification": "выпускать пар или дым"
                            },
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "испускать пар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad87fa9b-651d-3471-a78a-ccd941735baa",
                    "sense_definition": "To use insubstantial language; to boast or bluster.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire evening <w>vaporing</w> about his supposed connections to the royal family.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>разглагольствуя</w> о своих предполагаемых связях с королевской семьей."
                            }
                        },
                        {
                            "text": "Instead of taking action, the politician continued to <w>vapor</w> about future reforms.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы действовать, политик продолжал <w>пустословить</w> о будущих реформах."
                            }
                        }
                    ],
                    "synonyms": [
                        "boast",
                        "bluster",
                        "brag"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать пустые слова; хвастаться или бахвалиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "пустословить"
                            },
                            {
                                "target_lang_word": "бахвалиться",
                                "target_lang_sense_clarification": "хвастаться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}