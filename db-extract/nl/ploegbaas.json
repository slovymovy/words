                "senses": [
                    {
                        "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                        "entry_id": "4b8bdada-afc5-3077-adb2-fa46196e63bb",
                        "glosses": [
                            "foreman, ganger, supervisor, team leader"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "423b0d09-0505-440e-ab27-cf949c047d3c",
                                "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                                "text": "De ploegbaas gaf instructies aan de arbeiders op de bouwplaats.",
                                "translation": "The foreman gave instructions to the workers at the construction site.",
                                "english": "The foreman gave instructions to the workers at the construction site."
                            },
                            {
                                "example_id": "70bd9293-6dde-46f7-b1ab-98b1c17b5cf9",
                                "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                                "text": "De ervaren ploegbaas leidde het team bij de aanleg van de weg.",
                                "translation": "The experienced foreman led the team in road construction.",
                                "english": "The experienced foreman led the team in road construction."
                            },
                            {
                                "example_id": "9b687c56-f77a-4d57-abd3-144b3f719f12",
                                "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                                "text": "De bouwploeg bestaat uit een ploegbaas en een aantal geschoolde arbeiders.",
                                "translation": "The construction gang consists of a ganger and a number of skilled workers.",
                                "english": "The construction gang consists of a ganger and a number of skilled workers."
                            },
                            {
                                "example_id": "91f4a34d-6048-44eb-ac20-dc52d4f17af1",
                                "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                                "text": "De ploegbaas verdeelde de taken en zorgde ervoor dat alles soepel verliep.",
                                "translation": "The ganger assigned tasks and ensured that everything ran smoothly.",
                                "english": "The ganger assigned tasks and ensured that everything ran smoothly."
                            },
                            {
                                "example_id": "cac82c2d-4c27-4436-a122-97669c54b4ef",
                                "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                                "text": "Als ploegbaas is hij verantwoordelijk voor het toezicht op de productielijn.",
                                "translation": "As a supervisor, he is responsible for overseeing the production line.",
                                "english": "As a supervisor, he is responsible for overseeing the production line."
                            },
                            {
                                "example_id": "6bf09752-d0df-4448-81ae-db5b513f0fc1",
                                "sense_id": "8ded9d58-f47f-3e8c-a1ee-291748f9955e",
                                "text": "De ploegbaas motiveert het team om hun doelen te bereiken.",
                                "translation": "The team leader motivates the team to achieve their goals.",
                                "english": "The team leader motivates the team to achieve their goals."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
