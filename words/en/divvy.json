                    "sense_definition": "A foolish person",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put it down and stop being a <w>divvy</w>!",
                            "target_lang_translations": {
                                "fr": "Pose ça et arrête de faire l'<w>idiot</w> !",
                                "cs": "Polož to a přestaň být <w>hlupák</w>!",
                                "ru": "Положи это и перестань быть <w>придурком</w>!"
