                        "glosses": [
                            "In a beery manner; while smelling of, or under the influence of, beer."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "298c297b-40ce-45f8-9662-0715ff062972",
                                "sense_id": "99624ec7-e438-3812-a167-834bd7e942b6",
                                "text": "The politically ambitious and the beerily dissolute artisan of whom you read in the newspapers by no means constitute all the odder varieties of the species."
                            },
                            {
                                "example_id": "0b4b470c-63e0-48c9-8478-8381ee18e1e4",
                                "sense_id": "99624ec7-e438-3812-a167-834bd7e942b6",
                                "text": "Hamper bent to Dunbar and whispered, beerily, in his ear . . ."
                            },
                            {
                                "example_id": "af7b1ecf-83ba-4bf8-8542-da7df338f9a3",
                                "sense_id": "99624ec7-e438-3812-a167-834bd7e942b6",
                                "text": "He belched beerily. Well, eating would have to wait."
                            }
                        ]
                    }
