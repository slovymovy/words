                "translations": [
                    {
                        "translation_id": "ca6019bb-1723-4c25-8d48-d5c39017a888",
                        "source_entry_id": "faa219c9-fb6c-3de2-bf5d-85ecdce7def8",
                        "source_sense_id": "12c15f75-013f-366b-bfa0-b5d08a2a05b7",
                        "source_sense_description": "heel erg scherp",
                        "target_lang_word": "messerscharf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "messerscharf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df953185-86fa-3184-8148-3a13d9af5050",
                                        "entry_id": "08dc26f5-830c-3cc4-9912-8ddc6c181a54",
                                        "glosses": [
                                            "scharf, wie die Klinge eines Messers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae8d8b63-815c-4381-aff6-8dfccb6ecd0e",
                                                "sense_id": "df953185-86fa-3184-8148-3a13d9af5050",
                                                "text": "Der Boden war übersät mit messerscharfen Splittern."
                                            },
                                            {
                                                "example_id": "f1c9bada-ac6f-439f-9e7a-3f3f1d8d2d63",
                                                "sense_id": "df953185-86fa-3184-8148-3a13d9af5050",
                                                "text": "„Und Entsetzen drang mit grellen Bildern wie messerscharfe Glasscherben auf sie ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ca7e572-a46d-3523-bf04-0be343bf5b3e",
                                        "entry_id": "08dc26f5-830c-3cc4-9912-8ddc6c181a54",
                                        "glosses": [
                                            "mit einem schnellen, beweglichen Geist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c34a64c-2aeb-4c7f-be46-4779b311dc42",
                                                "sense_id": "2ca7e572-a46d-3523-bf04-0be343bf5b3e",
                                                "text": "Daraus schloss sie mit messerscharfem Verstand, dass der Fehler nicht hier lag."
                                            },
                                            {
                                                "example_id": "d68e1fee-1b8f-46a5-89e4-a65a8a307818",
                                                "sense_id": "2ca7e572-a46d-3523-bf04-0be343bf5b3e",
                                                "text": "„Während mein Großvater groß und laut war, war meine Großmutter ruhig, besonnen und mit einem messerscharfen Verstand gesegnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff739b1-c434-4ac3-a900-091e82091961",
                        "source_entry_id": "faa219c9-fb6c-3de2-bf5d-85ecdce7def8",
                        "source_sense_id": "12c15f75-013f-366b-bfa0-b5d08a2a05b7",
