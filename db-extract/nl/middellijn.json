                "senses": [
                    {
                        "sense_id": "0cc5b811-2e10-3a86-a4c1-7f6877eef0c2",
                        "entry_id": "187df567-b130-3359-8bf9-99aa709d3f55",
                        "glosses": [
                            "een rechte lijn, getrokken door twee punten en het middelpunt van een cirkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3be4a1-8bda-4fee-9931-c83cd259f7bf",
                                "sense_id": "0cc5b811-2e10-3a86-a4c1-7f6877eef0c2",
                                "text": "Een middellijn verdeelt een cirkel in twee gelijke stukken."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e19c40-3b8c-3bc3-883b-2ed1121e695e",
                        "entry_id": "187df567-b130-3359-8bf9-99aa709d3f55",
                        "glosses": [
                            "de afstand tussen twee punten van een cirkel, gemeten langs een rechte lijn die door het middelpunt van de cirkel gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fac89482-5a02-48a4-ad28-e73642fd7bb3",
                                "sense_id": "20e19c40-3b8c-3bc3-883b-2ed1121e695e",
                                "text": "Van de rechte lijnen die twee punten van een cirkel verbinden, heeft de middellijn de maximale lengte en die is gelijk aan tweemaal de straal."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0f8756a-05a5-3fd9-a33f-3a754a6e4e68",
                        "entry_id": "187df567-b130-3359-8bf9-99aa709d3f55",
                        "glosses": [
                            "lijn tussen de twee serveervakken"
                        ],
                        "tags": [
                            "badminton"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11f8155a-bfdb-4edb-b581-6d0030f66b39",
                        "source_entry_id": "187df567-b130-3359-8bf9-99aa709d3f55",
                        "source_sense_id": "0cc5b811-2e10-3a86-a4c1-7f6877eef0c2",
                        "source_sense_description": "middellijn",
                        "target_lang_word": "Durchmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                        "entry_id": "a3805785-8a68-3915-971e-6c3506997e89",
                                        "glosses": [
                                            "Entfernung zwischen den Schnittpunkten eines Kreises mit einer Geraden, die dessen Mittelpunkt schneidet"
                                        ],
                                        "tags": [
                                            "Mathematik, Geometrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75df5b1a-efd6-487a-b521-3f9b8f860a5c",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "Die Hälfte eines Durchmessers nennt man Radius (Halbmesser)."
                                            },
                                            {
                                                "example_id": "44299641-b368-4595-a6df-2d16e685ca17",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "„Den doppelten Radius eines Kreises nennt man Durchmesser.“"
                                            },
                                            {
                                                "example_id": "5fb64c71-e3fa-4acc-b905-0212489fee5b",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "„Das Augustus-Mausoleum mit 89 Meter Durchmesser sollte von der Dauerhaftigkeit des Imperiums künden.“"
                                            },
                                            {
                                                "example_id": "a225de47-c57a-49fc-be4d-773cb11c652d",
                                                "sense_id": "177884ae-6cce-3a5d-bfea-cabbc822ef4b",
                                                "text": "„Die Erde hat einen Durchmesser von über 12.000 km, aber die Biosphäre misst an keiner Stelle mehr als rund 25 km.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be2657b0-b220-37d3-8960-90b670ff275e",
                                        "entry_id": "a3805785-8a68-3915-971e-6c3506997e89",
                                        "glosses": [
                                            "eine längstmögliche Sehne eines Kreises"
                                        ],
                                        "tags": [
                                            "Mathematik, Geometrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0baa6d-43bb-4894-957e-a3fe95806004",
                                                "sense_id": "be2657b0-b220-37d3-8960-90b670ff275e",
                                                "text": "„Auch diese Strecke selbst wird gelegentlich als ein Durchmesser der Sphäre bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4fee006-38ac-47ac-94a6-31cccc846dd4",
                        "source_entry_id": "187df567-b130-3359-8bf9-99aa709d3f55",
