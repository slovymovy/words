            "senses": [
                {
                    "sense_id": "af7f24c9-cdf2-319a-9b08-50dc923a45c0",
                    "sense_definition": "Algal organisms viewed collectively or as a mass; algal growth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_organism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pond was covered in a thick layer of green <w>algae</w>.",
                            "target_lang_translations": {
                                "it": "Lo stagno era coperto da un denso strato di <w>alghe</w> verdi."
                            }
                        },
                        {
                            "text": "An <w>algae</w> bloom can be harmful to fish in the bay.",
                            "target_lang_translations": {
                                "it": "Una fioritura di <w>alghe</w> può essere dannosa per i pesci nella baia."
                            }
                        }
                    ],
                    "synonyms": [
                        "seaweed"
                    ],
                    "common_phrases": [
                        "algae bloom",
                        "green algae"
                    ],
                    "target_lang_definitions": {
