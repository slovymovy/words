                    }
                ],
                "senses": [
                    {
                        "sense_id": "08fc6e2c-bc26-3fed-b1af-c4b2fbbfe011",
                        "entry_id": "4408f5e1-ed71-3d0d-aca6-62fd87fdcc1d",
                        "glosses": [
                            "vast, ample, extensive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0554a2a9-4baf-4981-865b-252ab3e5635e",
                                "sense_id": "08fc6e2c-bc26-3fed-b1af-c4b2fbbfe011",
                                "text": "В поня́тиях францу́за-буржуа́ вселе́нная есть не что ино́е, как обши́рная сце́на, где даё́тся бесконе́чное театра́льное представле́ние, в кото́ром оди́н лицеме́р подаё́т ре́плику друго́му.",
                                "translation": "As the French bourgeois sees it, the universe is nothing but a vast stage where an endless theatrical performance is being presented, with one hypocrite giving the cue to another.",
                                "english": "As the French bourgeois sees it, the universe is nothing but a vast stage where an endless theatrical performance is being presented, with one hypocrite giving the cue to another."
                            },
                            {
                                "example_id": "321760f4-c966-4d0b-827a-4b53f50354f2",
                                "sense_id": "08fc6e2c-bc26-3fed-b1af-c4b2fbbfe011",
                                "text": "Новобра́чная ― облада́тельница обши́рных поме́стий на ю́ге России\nNovobráčnaja ― obladátelʹnica obšírnyx poméstij na júge Rossii",
                                "translation": "The bride possesses vast estates in southern Russia",
                                "english": "The bride possesses vast estates in southern Russia"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
