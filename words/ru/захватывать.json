{
    "word_family": [
        "захват",
        "захватчик",
        "захватывающе",
        "захватывающий",
        "перехватывать",
        "схватывать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69ff6a8f-318a-357e-ab4e-4835e944ecc8",
                    "sense_definition": "Брать с собой в дорогу, уходя или уезжая куда-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "take_along",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не забудь <w>захватывать</w> зонт каждый раз, когда выходишь на улицу осенью.",
                            "target_lang_translations": {
                                "tr": "Sonbaharda her dışarı çıktığında şemsiyeni <w>yanına almayı</w> unutma."
                            }
                        },
                        {
                            "text": "Перед долгой поездкой мы всегда стараемся <w>захватывать</w> с собой немного еды и тёплые вещи.",
                            "target_lang_translations": {
                                "tr": "Uzun bir yolculuktan önce her zaman yanımıza biraz yiyecek ve sıcak tutacak giysiler <w>almaya</w> çalışırız."
                            }
                        }
                    ],
                    "synonyms": [
                        "прихватывать"
                    ],
                    "antonyms": [
                        "оставлять"
                    ],
                    "common_phrases": [
                        "захватывать с собой"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yere giderken veya yola çıkarken yanına almak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yanına almak",
                                "target_lang_sense_clarification": "giderken beraberinde götürmek"
                            },
                            {
                                "target_lang_word": "götürmek",
                                "target_lang_sense_clarification": "beraberinde taşımak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "945de964-6cca-3e07-b7b7-fe72d913090c",
                    "sense_definition": "Хватая, брать, зажимать руками, пальцами или каким-либо приспособлением.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grasp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот робот может аккуратно <w>захватывать</w> даже самые мелкие детали на конвейере.",
                            "target_lang_translations": {
                                "tr": "Bu robot, konveyördeki en küçük parçaları bile hassas bir şekilde <w>kavrayabilir</w>."
                            }
                        },
                        {
                            "text": "Хищная птица привыкла <w>захватывать</w> добычу своими острыми когтями прямо на лету.",
                            "target_lang_translations": {
                                "tr": "Yırtıcı kuş, avını doğrudan uçarken keskin pençeleriyle <w>yakalamaya</w> alışkındır."
                            }
                        }
                    ],
                    "synonyms": [
                        "схватывать",
                        "хватать"
                    ],
                    "antonyms": [
                        "отпускать",
                        "освобождать"
                    ],
                    "common_phrases": [
                        "захватывать пальцами",
                        "захватывать клешнями"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ellerle, parmaklarla veya bir aletle sıkıca tutmak, kavramak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kavramak",
                                "target_lang_sense_clarification": "sıkıca tutmak"
                            },
                            {
                                "target_lang_word": "yakalamak",
                                "target_lang_sense_clarification": "tutup bırakmamak"
                            },
                            {
                                "target_lang_word": "tutmak",
                                "target_lang_sense_clarification": "elle veya aletle yakalamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9749a6ab-684c-304e-8db6-1094841855c9",
                    "sense_definition": "Силой овладевать чужой территорией, властью или имуществом.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "seize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вражеские войска продолжали <w>захватывать</w> один город за другим.",
                            "target_lang_translations": {
                                "tr": "Düşman birlikleri birbiri ardına şehirleri <w>işgal etmeye</w> devam etti."
                            }
                        },
                        {
                            "text": "Разбойники пытались <w>захватывать</w> торговые суда, проходящие через узкий пролив.",
                            "target_lang_translations": {
                                "tr": "Haydutlar, dar boğazdan geçen ticaret gemilerini <w>ele geçirmeye</w> çalışıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "завладевать",
                        "овладевать"
                    ],
                    "antonyms": [
                        "освобождать"
                    ],
                    "common_phrases": [
                        "захватывать власть",
                        "захватывать территорию"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başka bir ülkenin toprağını, gücü veya mülkü zorla ele geçirmek, işgal etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ele geçirmek",
                                "target_lang_sense_clarification": "zorla sahip olmak"
                            },
                            {
                                "target_lang_word": "işgal etmek",
                                "target_lang_sense_clarification": "toprak veya bölge için"
                            },
                            {
                                "target_lang_word": "zapt etmek",
                                "target_lang_sense_clarification": "güç kullanarak almak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eb69bd2-93df-3563-b503-1d66203c1c07",
                    "sense_definition": "Сильно увлекать, полностью поглощать чьё-либо внимание или чувства.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "captivate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Интересный сюжет книги начинает <w>захватывать</w> читателя с самых первых страниц.",
                            "target_lang_translations": {
                                "tr": "Kitabın ilginç konusu, daha ilk sayfalardan itibaren okuyucuyu <w>sarmaya</w> başlıyor."
                            }
                        },
                        {
                            "text": "Эта прекрасная музыка способна глубоко <w>захватывать</w> душу каждого слушателя.",
                            "target_lang_translations": {
                                "tr": "Bu güzel müzik, her dinleyicinin ruhunu derinden <w>etkileme</w> yeteneğine sahiptir."
                            }
                        }
                    ],
                    "synonyms": [
                        "овладевать"
                    ],
                    "common_phrases": [
                        "захватывать дух",
                        "захватывать внимание"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin dikkatini veya duygularını tamamen kendine çekmek, büyülemek, sarmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sarmak",
                                "target_lang_sense_clarification": "ilgisini bütünüyle çekmek"
                            },
                            {
                                "target_lang_word": "büyülemek",
                                "target_lang_sense_clarification": "kendine hayran bırakmak"
                            },
                            {
                                "target_lang_word": "etkilemek",
                                "target_lang_sense_clarification": "derinden hissettirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc3699d-6ce7-312b-b7de-486c8283fd2c",
                    "sense_definition": "Занимать, заполнять собой какое-либо пространство или распространяться на него.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "occupy_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Огонь начал быстро <w>захватывать</w> соседние деревянные постройки.",
                            "target_lang_translations": {
                                "tr": "Yangın, komşu ahşap binaları hızla <w>sarmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Густой туман стал постепенно <w>захватывать</w> всю низину у реки.",
                            "target_lang_translations": {
                                "tr": "Yoğun sis, nehir kenarındaki tüm vadiyi yavaş yavaş <w>kaplamaya</w> başladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "захватывать пространство"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir alanı kaplamak, doldurmak veya oraya yayılmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kaplamak",
                                "target_lang_sense_clarification": "yayılıp doldurmak"
                            },
                            {
                                "target_lang_word": "sarmak",
                                "target_lang_sense_clarification": "her tarafına yayılmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bc30b94-e0c3-3f60-8e6a-97a9049fffa6",
                    "sense_definition": "Загрязнять или портить внешний вид вещи частым прикосновением рук.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит постоянно <w>захватывать</w> руками белые страницы новой книги.",
                            "target_lang_translations": {
                                "tr": "Yeni bir kitabın beyaz sayfalarını sürekli ellerinle <w>kirletmemelisin</w>."
                            }
                        },
                        {
                            "text": "Если так небрежно <w>захватывать</w> воротник пальто, он быстро потеряет свой вид.",
                            "target_lang_translations": {
                                "tr": "Paltonun yakasını böyle özensizce <w>hırpalarsan</w>, görünümünü çabucak kaybeder."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sık sık dokunarak bir şeyin dış görünüşünü kirletmek veya yıpratmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kirletmek",
                                "target_lang_sense_clarification": "elle dokunarak lekelemek"
                            },
                            {
                                "target_lang_word": "yıpratmak",
                                "target_lang_sense_clarification": "hırpalamak, eskitmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}