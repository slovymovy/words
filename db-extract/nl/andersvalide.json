                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "8574b1ff-5129-4f7c-93f7-b3895665800d",
                                "sense_id": "50e005fe-3598-301f-9848-9043b85a8c61",
                                "text": "Rellen tijdens match andersvalide Duivels;"
                            },
                            {
                                "example_id": "53501524-687a-4b56-946e-ab8891be108e",
                                "sense_id": "50e005fe-3598-301f-9848-9043b85a8c61",
                                "text": "In de jaren negentig ontstaan diverse groeperingen die opkomen voor burgerrechten voor mensen met een handicap. Aanvankelijk zetten zij zich af tegen het medisch model dat invaliditeit waardeert. De term 'mindervalide' duidt dan ook niet zozeer op de lichamelijke of geestelijke beperking, maar op de veroordeling door de maatschappij tot minderwaardigheid. Andersvalide is een reactie op deze evolutie, en is eerder eufemistisch bedoeld, soms ook cynisch."
                            }
                        ]
                    }
