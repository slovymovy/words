                            {
                                "example_id": "f1dc22ca-eaa3-41c1-9a7f-4ef8769a2464",
                                "sense_id": "c35ec9c6-42cf-3d64-bdf9-5c0968714001",
                                "text": "Огребать кучу мусора в яму."
                            }
                        ]
                    },
                    {
                        "sense_id": "a907c3fe-39a5-3339-8769-090c38da0cd9",
                        "entry_id": "8072177c-4f23-3b55-b231-d2b68cbc7f87",
                        "glosses": [
                            "перен. сниж. добывать в большом количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37434a8-6e57-4077-9ddd-abe8a4cd2747",
                                "sense_id": "a907c3fe-39a5-3339-8769-090c38da0cd9",
                                "text": "Огребать песок с карьера."
                            },
                            {
                                "example_id": "4017ac61-f660-4c2b-84d1-251c04fa40ed",
                                "sense_id": "a907c3fe-39a5-3339-8769-090c38da0cd9",
                                "text": "Под «бонапартистом» я разумею вообще всякого, кто смешивает выражение «отечество» с выражением «ваше превосходительство» и даже отдаёт предпочтение последнему перед первым. Таких людей во всех странах множество, а у нас до того довольно, что хоть лопатами огребай."
                            }
                        ]
                    },
                    {
