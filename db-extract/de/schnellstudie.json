                "senses": [
                    {
                        "sense_id": "36a900d4-e1ac-3985-ac30-4575bc43ba41",
                        "entry_id": "dc062e1b-4de9-33f2-bb20-c599683a423d",
                        "glosses": [
                            "wissenschaftliche Untersuchung, die innerhalb eines kurzen Zeitraums (nach einem bestimmten Ereignis) durchgeführt wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5d5cb945-9f10-489e-9fc1-8b47e21937c5",
                                "sense_id": "36a900d4-e1ac-3985-ac30-4575bc43ba41",
                                "text": "„Das Hochwasser an der Ahr war mit hoher Wahrscheinlichkeit ein Klimawandel-Ereignis. Das bestätigen Forscher in einer ersten Schnellstudie.“"
                            },
                            {
                                "example_id": "c40df964-c1b8-4c1e-86fb-9dbd578eb087",
                                "sense_id": "36a900d4-e1ac-3985-ac30-4575bc43ba41",
                                "text": "„Eine Schnellstudie der World Weather Attribution Group hatte in der vergangenen Woche nahegelegt, dass die Hitzewelle in Amerika ohne den Klimawandel »nahezu unmöglich« wäre.“"
                            },
                            {
                                "example_id": "d742e2ed-5fc7-45c9-b394-01c5f9f6b003",
                                "sense_id": "36a900d4-e1ac-3985-ac30-4575bc43ba41",
                                "text": "„Wird eine solche Schnellstudie begleitend zur Verfahrensentwicklung in einem frühen Stadium durchgeführt, kann sie sehr wirkungsvoll die Richtung und die Zielsetzungen der biotechnologischen Verfahrensentwicklung beeinflussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
