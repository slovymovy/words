                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837af872-71e4-493b-b509-9a183e424e81",
                                                "sense_id": "0eff83f5-8d6f-38cc-935e-430953271ea8",
                                                "text": "Semitské jazyky se vyvíjely způsobem dosti podobným, národy a kmeny jimi mluvící žily za podobných podmínek a většinou se vzájemně stýkaly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7ddb24c-5a74-3841-8457-5a871d771a3f",
