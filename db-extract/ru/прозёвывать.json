                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70b52d2-6add-4bfe-96b6-522abdd41b76",
                                                "sense_id": "38abe7b2-4596-3a42-b9c7-d01706a148b1",
                                                "text": "Avoir peur de manquer."
                                            },
                                            {
                                                "example_id": "a0a413d5-eb0a-4a6b-8816-2e1dc3d2f56e",
                                                "sense_id": "38abe7b2-4596-3a42-b9c7-d01706a148b1",
                                                "text": "Les deux sœurs ont toujours été parmi ceux qu’on appelle, à Maupeyrou, les heureux de ce monde. Et, en effet, elles n’ont jamais « manqué »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
