                        "sense_id": "81901312-54b4-364f-9ea1-fa27fb8dc695",
                        "entry_id": "cf36bb3d-e0bb-3478-a0de-c88fb77a2689",
                        "glosses": [
                            "carefree, merry and boisterous"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4c7542-54aa-42df-b171-28b2bade3945",
                                "sense_id": "81901312-54b4-364f-9ea1-fa27fb8dc695",
                                "text": "Tin Maung gave an order and in due course the head-waiter arrived, a rollicking Shan with shining bald head and Manchu moustaches, carrying a dish heaped with scrawny chickens' limbs, jaundiced with curry, a bowl of rice and a couple of aluminium plates."
                            },
                            {
                                "example_id": "521751aa-7dab-4f66-b7c1-c0dbb94d8b74",
                                "sense_id": "81901312-54b4-364f-9ea1-fa27fb8dc695",
                                "text": "The episode’s unwillingness to fully commit to the pathos of the Bart-and-Laura subplot is all the more frustrating considering its laugh quota is more than filled by a rollicking B-story that finds Homer, he of the iron stomach and insatiable appetite, filing a lawsuit against The Frying Dutchman when he’s hauled out of the eatery against his will after consuming all of the restaurant’s shrimp (plus two plastic lobsters)."
                            }
                        ]
                    }
                ],
