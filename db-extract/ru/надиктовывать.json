                                "target_senses": [
                                    {
                                        "sense_id": "6952e6fa-5151-304f-aec0-e9a15b4e108a",
                                        "entry_id": "a79e9f96-891e-3966-af84-1922d6e0e215",
                                        "glosses": [
                                            "An order or command."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f75780b-b545-4938-89fa-0ccd69e72da0",
                                                "sense_id": "6952e6fa-5151-304f-aec0-e9a15b4e108a",
                                                "text": "I must obey the dictates of my conscience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dictate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7dc5653-ddd8-3842-994b-2f896ef6377a",
                                        "entry_id": "155d2e00-69c3-3ca6-b22a-ea9a5c4ac450",
                                        "glosses": [
                                            "To order, command, control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c05ae0-d8df-46f2-86b5-a829b1ad6c93",
                                                "sense_id": "a7dc5653-ddd8-3842-994b-2f896ef6377a",
                                                "text": "Trademark Owners will nevertheless try to dictate how their marks are to be represented, but dictionary publishers with spine can resist such pressure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "199fd62f-d79f-34c3-8a6e-6d2c1ddc101a",
                                        "entry_id": "155d2e00-69c3-3ca6-b22a-ea9a5c4ac450",
                                        "glosses": [
                                            "To speak in order for someone to write down the words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208f3ade-9c40-458d-8f65-9de6f75350c4",
                                                "sense_id": "199fd62f-d79f-34c3-8a6e-6d2c1ddc101a",
                                                "text": "She is dictating a letter to a stenographer."
                                            },
                                            {
                                                "example_id": "89c753fb-4b43-4a8f-9e43-fb5d97201883",
                                                "sense_id": "199fd62f-d79f-34c3-8a6e-6d2c1ddc101a",
                                                "text": "The French teacher dictated a passage from Victor Hugo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07818b21-dcdb-357e-b0ee-b0d9ec74a82d",
                                        "entry_id": "155d2e00-69c3-3ca6-b22a-ea9a5c4ac450",
                                        "glosses": [
                                            "To determine or decisively affect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c306fa2-bc57-488d-9000-e201763c95b2",
                                                "sense_id": "07818b21-dcdb-357e-b0ee-b0d9ec74a82d",
                                                "text": "He had offered, and been refused! There was that in her own nature, which sympathised with the pride, for such she held to be the motive, dictating the refusal."
                                            },
                                            {
                                                "example_id": "44c157ef-f751-490d-9076-97d9380c273d",
                                                "sense_id": "07818b21-dcdb-357e-b0ee-b0d9ec74a82d",
                                                "text": "Geology dictates the approximate location of the tunnel."
                                            },
                                            {
                                                "example_id": "6ac5b4c7-09bc-402c-93de-077966cfe92b",
                                                "sense_id": "07818b21-dcdb-357e-b0ee-b0d9ec74a82d",
                                                "text": "I didn't lay this bar, or the restaurant for that matter, out on paper. The design was dictated by the materials."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
