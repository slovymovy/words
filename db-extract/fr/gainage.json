                                "target_senses": [
                                    {
                                        "sense_id": "e09a7570-9750-3586-a6d5-0c74b4de262a",
                                        "entry_id": "5056551a-d59e-3064-8716-30eabd23a7cf",
                                        "glosses": [
                                            "A long, broad and thick piece of timber, as opposed to a board which is less thick."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40c8e616-175a-3d89-8a49-4641287c8356",
                                        "entry_id": "5056551a-d59e-3064-8716-30eabd23a7cf",
                                        "glosses": [
                                            "A political issue that is of concern to a faction or a party of the people and the political position that is taken on that issue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e18618-f512-4529-b8a8-b3aa2ef344d4",
                                                "sense_id": "40c8e616-175a-3d89-8a49-4641287c8356",
                                                "text": "Germanization was a central plank of German conservative thinking in the 19th and 20th centuries."
                                            },
                                            {
                                                "example_id": "d8fc1fce-d0a2-49d5-89bf-bbb4c46361b0",
                                                "sense_id": "40c8e616-175a-3d89-8a49-4641287c8356",
                                                "text": "When Mr. Dole had been asked at the Republican convention about the same immigration amendment—one of the more conservative and sensitive planks—he did not oppose it, but said he would have to think long and hard before supporting it."
                                            },
                                            {
                                                "example_id": "41ba9290-1c25-403a-81f0-0c270e67891d",
                                                "sense_id": "40c8e616-175a-3d89-8a49-4641287c8356",
                                                "text": "In the 1970s, a group of ideologically inspired economists captured the ears and minds of politicians. The central plank of their ‘neo-liberal’ model was that growth and development depended on market competitiveness; […]"
                                            },
                                            {
                                                "example_id": "b86e8808-fde0-4824-bb1b-4b6050ea67b7",
                                                "sense_id": "40c8e616-175a-3d89-8a49-4641287c8356",
                                                "text": "The party, whose official name (Bündnis 90/Die Grünen) translates as Alliance '90/The Greens, grew out of an assortment of social protest movements of the 1980s that eventually unified. Their supporters marched for everything from ending nuclear power to enacting gay rights — while maintaining the key plank of environmental protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b551bc0c-8f8c-38da-86fe-9b5a3c374c20",
                                        "entry_id": "5056551a-d59e-3064-8716-30eabd23a7cf",
                                        "glosses": [
                                            "Physical exercise in which one holds a pushup position for a measured length of time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "476201bc-59d9-3bb6-b3e7-6fe0b047a666",
                                        "entry_id": "5056551a-d59e-3064-8716-30eabd23a7cf",
                                        "glosses": [
                                            "A stupid person, idiot."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99592f63-826a-360d-a97b-effbfc2790fe",
                                        "entry_id": "5056551a-d59e-3064-8716-30eabd23a7cf",
                                        "glosses": [
                                            "That which supports or upholds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eacc0f6-0502-4ab1-8da7-06a1c0dc42c8",
                                                "sense_id": "99592f63-826a-360d-a97b-effbfc2790fe",
                                                "text": "His charity is a better plank than the faith of an intolerant and bitter-minded bigot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fdb0183-23a7-3154-a460-df56950984ab",
                                        "entry_id": "ae0cb403-5774-3a2a-a9cc-64e02a6fd6d7",
                                        "glosses": [
                                            "To cover something with planking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a43403-334f-4a39-9969-6bb2ca8e0519",
                                                "sense_id": "0fdb0183-23a7-3154-a460-df56950984ab",
                                                "text": "to plank a floor or a ship"
                                            },
                                            {
                                                "example_id": "47bed66a-b73d-4e8c-bdfb-2c482c0cdfd9",
                                                "sense_id": "0fdb0183-23a7-3154-a460-df56950984ab",
                                                "text": "Plank'd with pine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306abac8-5fa0-3e68-a046-2f9a3344af2b",
                                        "entry_id": "ae0cb403-5774-3a2a-a9cc-64e02a6fd6d7",
                                        "glosses": [
                                            "To bake (fish, etc.) on a piece of cedar lumber."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e29fb344-54c5-4027-89bf-2f967d3c836c",
                                                "sense_id": "306abac8-5fa0-3e68-a046-2f9a3344af2b",
                                                "text": "Along the lower river, planked shad dinners (baked and broiled) were highly popular during the late nineteenth and early twentieth centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c50a49fa-8365-35b6-bdf8-703311ac6d87",
                                        "entry_id": "ae0cb403-5774-3a2a-a9cc-64e02a6fd6d7",
                                        "glosses": [
                                            "To lay down, as on a plank or table; to stake or pay cash."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9307f7-dd1d-443d-89a7-651a0e515cda",
                                                "sense_id": "c50a49fa-8365-35b6-bdf8-703311ac6d87",
                                                "text": "to plank money in a wager"
                                            },
                                            {
                                                "example_id": "f9476fd7-d487-4a78-8b81-d22758ca0b88",
                                                "sense_id": "c50a49fa-8365-35b6-bdf8-703311ac6d87",
                                                "text": "Joe planked the money down in the officer of a newspaper editor and awaited results. There weren't any."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0a99745-d51e-3163-b781-48f3118912e9",
                                        "entry_id": "ae0cb403-5774-3a2a-a9cc-64e02a6fd6d7",
                                        "glosses": [
                                            "To harden, as hat bodies, by felting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfaca802-3a06-34e9-8074-877872ffd118",
                                        "entry_id": "ae0cb403-5774-3a2a-a9cc-64e02a6fd6d7",
                                        "glosses": [
                                            "To splice together the ends of slivers of wool, for subsequent drawing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb2f106-bfe5-37e5-8ee4-939720f563cc",
                                        "entry_id": "ae0cb403-5774-3a2a-a9cc-64e02a6fd6d7",
                                        "glosses": [
                                            "To pose for a photograph while lying rigid, face down, arms at side, in an unusual place."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1e8ae38-2f53-4aaf-a7b2-2d09f10570f7",
                                                "sense_id": "fbb2f106-bfe5-37e5-8ee4-939720f563cc",
                                                "text": "The woman, known as Claudia, fell from a 2m wall after earlier demonstrating the wrong way to plank on a small stool while holding a bottle of wine. A friend said some guests had not heard of planking and Claudia was demonstrating how ridiculous it was."
                                            },
                                            {
                                                "example_id": "689572c6-9698-4ebf-930b-dc49146d26d3",
                                                "sense_id": "fbb2f106-bfe5-37e5-8ee4-939720f563cc",
                                                "text": "Perth man Simon Carville became an internet sensation after he was photographed planking naked in the arms of famous Perth statue the Eliza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
