        "nl-extract.jsonl": [
            {
                "entry_id": "5ef2e966-a9fe-3eeb-b096-f97ffe17aeae",
                "word": "strijdend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a739a868-a4e3-3f52-afc9-0c1ea793530c",
                        "entry_id": "5ef2e966-a9fe-3eeb-b096-f97ffe17aeae",
                        "glosses": [
                            "gevecht voerend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a229fc-fb80-4c8c-a154-73f0c92ec14c",
                                "sense_id": "a739a868-a4e3-3f52-afc9-0c1ea793530c",
                                "text": "De VN probeert de strijdende partijen alsnog aan tafel te krijgen."
                            },
                            {
                                "example_id": "1c4556dd-17ad-4943-a2d0-1720b44a3399",
                                "sense_id": "a739a868-a4e3-3f52-afc9-0c1ea793530c",
                                "text": "Tot waaiervorming kwam het echter nooit. In de slotfase werd de moedig strijdende kopgroep ingerekend en zo werd het inderdaad een koninklijke sprint in Nîmes."
                            },
                            {
                                "example_id": "e1a828eb-bca9-4787-a91b-e020ed34ff4f",
                                "sense_id": "a739a868-a4e3-3f52-afc9-0c1ea793530c",
                                "text": "Bertens had op het eind wel liefst acht matchpoints nodig om de partij af te maken tegen de dapper strijdende Badosa, die vrijdag nog in twee sets (6-1, 6-2) won van Arantxa Rus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07645e65-1387-4342-8879-758fb92062f6",
                        "source_entry_id": "5ef2e966-a9fe-3eeb-b096-f97ffe17aeae",
                        "source_sense_id": "a739a868-a4e3-3f52-afc9-0c1ea793530c",
                        "source_sense_description": "gevecht voerend",
                        "target_lang_word": "fighting",
                        "target_lang_code": "en",
