                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d37712b-936f-36c0-9eb4-a120f8933615",
                                        "entry_id": "c6a40a62-def6-3686-88d1-e0ae6de92cce",
                                        "glosses": [
                                            "Having the power of acting; hence, exerting force, physical or moral; active in the production of effects."
                                        ],
                                        "tags": [],
                                        "examples": [
