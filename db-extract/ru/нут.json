                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a2cb645-3012-3a26-9ec1-ab8293bfab04",
                                        "entry_id": "a852dcae-dfbf-384d-8f02-6d16ad73d018",
                                        "glosses": [
                                            "A seed of this plant, often used as a food."
