                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28691005-48f1-3b9a-baf0-091993725203",
                                        "entry_id": "9172ff0c-7112-33d0-89ed-53e9db0a3595",
                                        "glosses": [
                                            "To no useful purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10276f6d-0167-4bd6-b1a8-3ce0bb964a9f",
                                                "sense_id": "28691005-48f1-3b9a-baf0-091993725203",
                                                "text": "Mr. Civil, warned and guided by distant axe-whangs, had found them, and had been unsparing in his condemnation of Jim's stupid waste of time in coming an unnecessary mile to chop down a tree uselessly far away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76e1dd17-7133-423f-923f-d6aa57839747",
                        "source_entry_id": "97ab519b-4e3d-355c-b807-e8c921877de9",
                        "source_sense_id": "b871842b-c158-3014-a45b-9ae6510c7f50",
                        "target_lang_word": "inutilement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inutilement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                        "entry_id": "eb335352-0374-3444-86de-fdf091289a9f",
                                        "glosses": [
                                            "Sans utilité, d’une manière inutile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b18a0f7-703d-4bcb-b4d1-38bc1925121c",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "Combien de fois pria-t-il le Sauveur des âmes, en baisant la croix, que son sang répandu pour lui ne le fût pas inutilement !"
                                            },
                                            {
                                                "example_id": "553f3fb7-6937-4ec9-8749-ac82d417aaf7",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "C’était le sort des Français de vaincre inutilement en Italie ; les journées d’Agnadel, de Fornoue, de Ravenne, de Marignan, de Cérisoles, en sont des témoignages immortels."
                                            },
                                            {
                                                "example_id": "a2ef0bb4-92b5-4768-9831-95da388996c5",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "Séparé des divisions qui avaient inutilement tenté de le joindre, le général Serrurier désespéra de recevoir du secours."
                                            },
                                            {
                                                "example_id": "1a16cc84-4cca-4ed1-802a-a7b1314a3a08",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "C’était inutilement que la mer était ouverte aux troupes britanniques, puisque sur toutes les côtes de l’Amérique on se préparait à les repousser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "242e19a4-dbaa-4ef4-878f-500920336c4e",
                        "source_entry_id": "97ab519b-4e3d-355c-b807-e8c921877de9",
                        "source_sense_id": "b871842b-c158-3014-a45b-9ae6510c7f50",
