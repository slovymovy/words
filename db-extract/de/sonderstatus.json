                "senses": [
                    {
                        "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                        "entry_id": "528f16bc-bfb1-3e36-82a1-e9f002618222",
                        "glosses": [
                            "besondere Stellung, besonderer Stand im rechtlichen, sozialen oder politischen Sinne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8e77b8-e87b-4274-871c-ce2fb6f762c4",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Als solche hatten sie in irgendeiner Form einen an die Krone gebundenen Sonderstatus inne, ohne dass dieser hier inhaltlich bewertet werden soll.“"
                            },
                            {
                                "example_id": "e2b05852-8e86-453c-95d0-daed9b5257a0",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Zweitens wurde im Zusammenhang mit der sozialistischen Integration im Ostblock der Sonderstatus der DDR als Teil einer Nation obsolet.“"
                            },
                            {
                                "example_id": "e7883f1f-856d-477f-be95-9deaa057e522",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Wesentliche Elemente des Sonderstatus waren der eigene Gerichtsstand und wirtschaftliche Privilegien (Steuerfreiheit).“"
                            },
                            {
                                "example_id": "974593e2-4931-4415-8ad0-0374e96e2efb",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Funchal wird Inselhauptstadt und Madeira bekommt einen Sonderstatus.“"
                            },
                            {
                                "example_id": "4295e50c-b48f-474b-8932-cd2a5ddc11d7",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Damit definiert er einen Sonderstatus für diejenigen, die auf diese Hilfe angewiesen sind.“"
                            },
                            {
                                "example_id": "2f66cd67-7fd3-463f-b2cd-e864cd16fd60",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Zu den Banken mit einem gesetzlichen Sonderstatus gehören beispielsweise Volksbanken, Kreditgenossenschaften und Agrarkreditkassen.“"
                            },
                            {
                                "example_id": "2c85114f-ecc9-49fd-8497-8761afb8eb93",
                                "sense_id": "ee2c5122-8249-3d08-a962-8396bce16671",
                                "text": "„Zum einen wird festgehalten, dass tonsurierte Geistliche und Juden, die Waffen führen, ihren rechtlichen Sonderstatus verlieren und behandelt werden wie alle anderen Laien auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
