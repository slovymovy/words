                ],
                "senses": [
                    {
                        "sense_id": "f0ae7c1d-3d4c-3adc-aa0d-f3876bfa17b4",
                        "entry_id": "c5412f33-a4c9-339e-8b9c-f3395c8b19a1",
                        "glosses": [
                            "Wert aller Leistungen, die innerhalb eines Jahres im Inland erbracht wurden"
                        ],
                        "tags": [
                            "Volkswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "9ff843b2-6a38-449b-aba2-971da23f1102",
                                "sense_id": "f0ae7c1d-3d4c-3adc-aa0d-f3876bfa17b4",
                                "text": "Vergleicht man die Bruttoinlandsprodukte der beiden Länder, stellt man eine positive Tendenz fest."
                            },
                            {
                                "example_id": "cb41e2ec-77a4-45e5-a8d9-7d5fcc4c89c8",
                                "sense_id": "f0ae7c1d-3d4c-3adc-aa0d-f3876bfa17b4",
                                "text": "Das Bruttoinlandsprodukt stieg von Juli bis September um 0,5 Prozent im Vergleich zum Frühjahr, teilte das Statistische Bundesamt mit."
                            },
                            {
                                "example_id": "61c92e47-80a2-4da1-9ac9-ed76eba28512",
                                "sense_id": "f0ae7c1d-3d4c-3adc-aa0d-f3876bfa17b4",
                                "text": "„Das Bruttoinlandsprodukt ist in den vergangenen zwei Jahren um mindestens 18 Prozent gefallen und die Währung nur noch wenig wert, die Staatsschuld hat sich mehr als verdoppelt.“"
                            },
                            {
                                "example_id": "c0ffacaa-752f-4643-83fd-6100cac0283c",
                                "sense_id": "f0ae7c1d-3d4c-3adc-aa0d-f3876bfa17b4",
                                "text": "„Vierzig Prozent des Bruttoinlandsprodukts stammen daraus und rund achtzig Prozent der staatlichen Einnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
