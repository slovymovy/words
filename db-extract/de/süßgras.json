                        "glosses": [
                            "Botanik: meist krautige Pflanze mit zylindrischen hohlen Halmen und linealischen Laubblättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0157dec-c1d2-446d-bc98-3ea21a6fbb08",
                                "sense_id": "0f117924-fd46-3fa2-a00e-be01987860c7",
                                "text": "Die Menschheit ernährt sich zum allergrößten Teil von Süßgräsern."
                            },
                            {
                                "example_id": "04058430-b771-4e24-b97c-48f702c553f2",
                                "sense_id": "0f117924-fd46-3fa2-a00e-be01987860c7",
                                "text": "Der Mais ist ein einhäusiges Süßgras; sein weiblicher Blütenstand ist ein Kolben, der in große Hüllblätter eingeschlossen ist."
                            },
                            {
                                "example_id": "9dbd93cc-cbf4-400f-b712-54b36ec8c8b3",
                                "sense_id": "0f117924-fd46-3fa2-a00e-be01987860c7",
                                "text": "Auch der Weizen ist ein Süßgras."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c05d775-7cfa-36cb-b7fc-488578e0f496",
                        "entry_id": "3bd3b58f-3795-30aa-9433-3d887c4453c4",
                        "glosses": [
                            "Taxonomie, im Plural: Familie aus der Ordnung Süßgrasartige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3df2d5c-a142-450e-be3a-5bc019dc7062",
                                "sense_id": "0c05d775-7cfa-36cb-b7fc-488578e0f496",
                                "text": "Mit ungefähr 12.000 Arten ist die Familie Süßgräser eine der größten innerhalb der Bedecktsamer."
                            }
