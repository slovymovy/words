        "fr-extract.jsonl": [
            {
                "entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                "word": "consistoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c116906e-46f7-4209-9852-ec194f55fe24",
                        "entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "consistoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5ea6b3d-34f8-3383-aeba-30f7351b5997",
                        "entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                        "glosses": [
                            "Assemblée de cardinaux convoquée par le pape pour les consulter et leur demander leur avis sur quelques affaires importantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee46004f-f978-4d4d-b2d4-50f03f533687",
                                "sense_id": "b5ea6b3d-34f8-3383-aeba-30f7351b5997",
                                "text": "Dans un consistoire présidé par le souverain pontife, et auquel assistaient les patriarches d'Antioche et de Jérusalem et un grand nombre de cardinaux, on donna lecture des pièces officiellement constatées sur la vie et la sainteté d'Élisabeth."
                            },
                            {
                                "example_id": "2e371a96-1cf6-4f24-98e6-f0ca3f3398c3",
                                "sense_id": "b5ea6b3d-34f8-3383-aeba-30f7351b5997",
                                "text": "Mais en ce printemps, trois évènements alimentent les interrogations, parmi lesquels la tenue le 27 août d'un consistoire pour créer une vingtaine de nouveaux cardinaux – dont de futurs électeurs en cas de conclave –, une période très inhabituelle pour cet évènement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec541306-3852-3155-b2a5-4531dcc886f1",
                        "entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                        "glosses": [
                            "Assemblée de pasteurs ou de rabbins et de laïques réunis pour délibérer des affaires de leur religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf270b41-6e5b-4567-bd87-92bc792cea36",
                                "sense_id": "ec541306-3852-3155-b2a5-4531dcc886f1",
                                "text": "Consistoire protestant, israélite."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8ade1a6-ce12-3a8e-b2fc-1d83fa22c6e2",
                        "entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                        "glosses": [
                            "Réunion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34fab55-dce0-41db-a3af-f47fbedc9940",
                                "sense_id": "e8ade1a6-ce12-3a8e-b2fc-1d83fa22c6e2",
                                "text": "Je voulais prier aussi, moi ; mais la prière expirait sur mes lèvres, mon esprit était tellement bouleversé, qu’il me semblait bien plutôt assister à un consistoire de démons qu’à une réunion de prêtres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba55f177-06b6-4c75-8331-528201a627b2",
                        "source_entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                        "target_lang_word": "Konsistorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "77af01da-d3c4-417b-8a06-e08ffac35e88",
                        "source_entry_id": "afca4528-584e-30ec-a633-0b83d7f420a0",
                        "target_lang_word": "consistory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consistory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5c26395-e39e-3f0c-b2cc-0b269e8d6ea0",
                                        "entry_id": "59b26708-861b-3dae-ba5c-940d7e995e9f",
                                        "glosses": [
                                            "A solemn assembly or council."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2214331-2cea-42ec-9d6d-742b69cf36b6",
                                                "sense_id": "a5c26395-e39e-3f0c-b2cc-0b269e8d6ea0",
                                                "text": "To council summons all his mighty peers, / Within thick clouds and dark tenfold involved, / A gloomy consistory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7dd0712-8aeb-354c-920a-f5bd557dd88e",
                                        "entry_id": "59b26708-861b-3dae-ba5c-940d7e995e9f",
                                        "glosses": [
                                            "The spiritual court of a diocesan bishop held before his chancellor or commissioner in his cathedral church or elsewhere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "452c0cae-ab8f-46b1-bfce-229d80557ad2",
                                                "sense_id": "a7dd0712-8aeb-354c-920a-f5bd557dd88e",
                                                "text": "1860-1876, Walter Hook, Lives of the Archbishops of Canterbury\nIn 1551 we find Bertholier excommunicated by the consistory because he would not allow that he had done wrong in asserting that he was as good a man as Calvin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e342563d-0788-3961-8907-0a6994bd4c09",
                                        "entry_id": "59b26708-861b-3dae-ba5c-940d7e995e9f",
                                        "glosses": [
                                            "An assembly of prelates; a session of the College of Cardinals at Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "722c57e0-7cbb-4dab-b357-ef9c107b3c5a",
                                                "sense_id": "e342563d-0788-3961-8907-0a6994bd4c09",
                                                "text": "Pius […][was] then hearing of causes in consistory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64129c67-393b-3414-b46a-47772afa5a4d",
                                        "entry_id": "59b26708-861b-3dae-ba5c-940d7e995e9f",
                                        "glosses": [
                                            "A church tribunal or governing body, especially of elders in a Reformed church."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a1d9260-c102-3b61-b750-286cd794722a",
                                        "entry_id": "59b26708-861b-3dae-ba5c-940d7e995e9f",
                                        "glosses": [
                                            "A civil court of justice."
                                        ],
                                        "tags": [
                                            "Early",
                                            "Modern",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b32b3a9-633d-4430-8ee9-7c8253a415e2",
                                                "sense_id": "6a1d9260-c102-3b61-b750-286cd794722a",
                                                "text": "And so were many greate and heighnous maters Obiected against S. Ambrose, because he refused to haue the cause betwene himselfe and the Heretike Auxentius, to be tried in the Consistorie of the Emperour, before Secular Iudges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
