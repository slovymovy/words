                    {
                        "sense_id": "15ae47ab-a1fb-3357-9f8f-9d059a8109a7",
                        "entry_id": "6d272d9e-73d0-393c-abfa-f34b9185f1b0",
                        "glosses": [
                            "Tourisme dans des tribus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e8079c-a16d-4ca0-a8b2-9e1c64db76eb",
                                "sense_id": "15ae47ab-a1fb-3357-9f8f-9d059a8109a7",
                                "text": "Les expériences d’ethnotourisme bien menées peuvent être profitables tant aux visités qu’aux visiteurs."
                            },
                            {
                                "example_id": "1d8b8eb5-1578-4dd5-84c9-79f4ca60416e",
                                "sense_id": "15ae47ab-a1fb-3357-9f8f-9d059a8109a7",
                                "text": "L’impact du tourisme international sur les Bushmen d'Afrique australe compare deux types d'ethnotourisme pratiqués en Namibie ou au Botswana : un tourisme de luxe, contrôlé par des entrepreneurs blancs ; et un tourisme communautaire, contrôlé directement par les Bushmen."
                            },
                            {
                                "example_id": "1a7b576f-bb08-4831-adbd-e9802231786f",
                                "sense_id": "15ae47ab-a1fb-3357-9f8f-9d059a8109a7",
                                "text": "Des peuples natifs ont gagné leur indépendance grâce aux arts et à l’artisanat (Inuit, certaines tribus indiennes) et au développement récent de l’ethnotourisme."
                            }
                        ]
                    }
