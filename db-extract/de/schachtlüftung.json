                "senses": [
                    {
                        "sense_id": "e29d01c2-6fdf-3e02-8d70-533f01c0672b",
                        "entry_id": "73db5a44-9e55-3fdb-bf63-975389613c20",
                        "glosses": [
                            "Wohnungslüftung und Freie Lüftung eines Raums durch innen aufsteigende Schächte im umbauten Raum, insbesondere für Küchen, Sanitärbereiche im Innenraum oder Aufzüge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0752d56-42a1-492a-ab83-9780657dfde9",
                                "sense_id": "e29d01c2-6fdf-3e02-8d70-533f01c0672b",
                                "text": "„Die Schachtlüftung ist bei innen liegenden Sanitärräumen und Küchen häufig zu finden.“"
                            },
                            {
                                "example_id": "a4fa8ce4-439b-442a-83fd-468f933dc5da",
                                "sense_id": "e29d01c2-6fdf-3e02-8d70-533f01c0672b",
                                "text": "„Freie Lüftung: Lüftung mit Förderung der Luft durch Druckunterschiede infolge Wind und/oder Temperaturdifferenzen zwischen außen und innen; z.B. Fensterlüftung, Schachtlüftung, Dachaufsatzlüftung und Lüftung durch sonstige Lüftungsöffnungen.“"
                            },
                            {
                                "example_id": "e59b7989-d471-42df-9c21-e6954cb53d0c",
                                "sense_id": "e29d01c2-6fdf-3e02-8d70-533f01c0672b",
                                "text": "„Die Schachtlüftung funktioniert ebenfalls über Außenluftdurchlässe.“"
                            },
                            {
                                "example_id": "13d4c5dd-3efa-4012-9c49-ddd53f422f33",
                                "sense_id": "e29d01c2-6fdf-3e02-8d70-533f01c0672b",
                                "text": "„Durch die Anordnung sogenannter Lüftungsaufsätze (Sauger) verbessert sich die Schachtlüftung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
