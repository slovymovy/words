                "senses": [
                    {
                        "sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
                        "entry_id": "1095a8b9-ce79-36cd-833e-6ad174415a29",
                        "glosses": [
                            "eine Zigarette"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "c399e061-a18d-4f3b-8690-6579046fc6d6",
                                "sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
                                "text": "Zahlreiche Jugendliche hängen am Glimmstängel."
                            },
                            {
                                "example_id": "21aa62e8-b704-416f-b124-7312a7f72d00",
                                "sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
                                "text": "Ein Leben ohne Glimmstängel ist nicht so einfach."
                            },
                            {
                                "example_id": "fe3af6d9-eb13-4f7b-8ec5-91bd61b8b22d",
                                "sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
                                "text": "Die Sucht nach dem Glimmstängel überwinden."
                            },
                            {
                                "example_id": "4e1541a1-8f57-43e9-a928-573a01f0bf13",
                                "sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
                                "text": "„Die Glimmstängel werden sich auch heuer wieder verteuern, obwohl die Tabaksteuer erstmals seit zehn Jahren nicht mehr steigt, sagt Josef Prirschl mit Blick auf die Industrie, die einiges Geld in die Rückverfolgbarkeit ihrer Produkte investiert habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1339622a-14a8-4ca9-bc45-3475b7e78a73",
                        "source_entry_id": "1095a8b9-ce79-36cd-833e-6ad174415a29",
                        "source_sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
                        "source_sense_description": "scherzhaft: eine Zigarette",
                        "target_lang_word": "cigarette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigarette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                        "entry_id": "57fa2e45-df1b-322c-ae27-ed03bb8bee83",
                                        "glosses": [
                                            "A small cigar consisting of tobacco or another substance, wrapped up in a thin roll with paper, intended for smoking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5555ad1-5a01-4290-a2cb-fc5a8f6a47ad",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "d5a6538b-8577-4998-8638-6cdf9b25066e",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "He rose to light my cigarette, then sank back into his wicker chair contentedly. The tea was weak, but not cold, thanks to the hot-plate."
                                            },
                                            {
                                                "example_id": "261a6cc7-99cb-4681-b044-3d30caf923ce",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "Tobacconist: Right. I want to try you on a course of these: one twenty times a day. Have you taken them before?\nPatient: Um, what is it?\nTobacconist: It's a simple nicotinal arsenous monoxid preparation taken bronchially as an infumation.\nPatient: Infumation?\nTobacconist: Yes, you just light the end and breathe it.\nPatient: What, like cigarettes?\nTobacconist: You know them then. Actually, it's a bit hard to admit but they're basically an herbal remedy... A leaf originally from the Americas, I believe, called tobacco.\nPatient: But medicated?\nTobacconist: Medicated? No.\nPatient: These are ordinary cigarettes?\nTobacconist: That's right.\nPatient: But they're terribly bad for you, aren't they?\nTobacconist: I hardly think I would be prescribing them if they were bad for you.\nPatient: Twenty a day?\nTobacconist: Yes, ideally moving on to about thirty or forty."
                                            },
                                            {
                                                "example_id": "cd8836ae-394e-418f-b169-5b715fb15c41",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "Grandma has an occasional cigarette, as well as Uncle Jimmy and Aunt Julie, and our kids give them crap about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cigarette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c195951c-aa2a-3811-9b5a-b7c55f4b5948",
                                        "entry_id": "8dd3baa2-9c61-3b4f-b2ac-5294e19bdc43",
                                        "glosses": [
                                            "To give someone a cigarette, or to light one for them."
                                        ],
                                        "tags": [
                                            "rare",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c951b3ca-aa75-4ba5-9b3f-2d16fcfb6a09",
                                                "sense_id": "c195951c-aa2a-3811-9b5a-b7c55f4b5948",
                                                "text": "Could someone cigarette me?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0004a14d-0507-40ff-9b7b-4e4e3fcb3be6",
                        "source_entry_id": "1095a8b9-ce79-36cd-833e-6ad174415a29",
                        "source_sense_id": "1184fe85-a5d8-326b-b5c8-ef86d8b69fd2",
