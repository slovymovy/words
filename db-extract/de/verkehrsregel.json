                ],
                "senses": [
                    {
                        "sense_id": "9bdc4767-14d6-3913-8dad-e831138a5b7a",
                        "entry_id": "b1cbbec6-806d-33da-8f39-aa235278fffe",
                        "glosses": [
                            "Vorschrift, wie sich die Verkehrsteilnehmer zu verhalten haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a37254e-4da7-42f7-8c23-2ee97dce5316",
                                "sense_id": "9bdc4767-14d6-3913-8dad-e831138a5b7a",
                                "text": "„Irgendwelche eindeutigen Verkehrsregeln schien es nicht zu geben.“"
                            },
                            {
                                "example_id": "054c70bf-b67d-4788-88c0-932c2bfcb71e",
                                "sense_id": "9bdc4767-14d6-3913-8dad-e831138a5b7a",
                                "text": "„Für den Motorfahrzeug- und Fahrradverkehr gelten gem. Art 1 Abs. 2 SVG erster Halbsatz die Verkehrsregeln auf allen öffentlichen Strassen.“"
                            },
                            {
                                "example_id": "4e589269-7bd0-4769-965d-e245113ed722",
                                "sense_id": "9bdc4767-14d6-3913-8dad-e831138a5b7a",
                                "text": "„Es sollte nachdenklich stimmen, dass der Verstoß gegen Verkehrsregeln (also das destruktive Moment) bei Kindern häufig in höherem Ansehen steht, offensichtlich zu mehr Prestigegewinn in der Peergroup verhilft als die Regelerfüllung.“"
                            },
                            {
                                "example_id": "362f0349-0cab-436c-98f5-23a454dcacb2",
                                "sense_id": "9bdc4767-14d6-3913-8dad-e831138a5b7a",
                                "text": "„In Deutschland existieren unzählige Verkehrsregeln, die sowohl die Sicherheit im Straßenverkehr als auch einen reibungslosen Verkehrsfluss gewährleisten sollen.“"
                            },
                            {
                                "example_id": "bfc99ff6-d722-45ed-897c-72fea44375c2",
                                "sense_id": "9bdc4767-14d6-3913-8dad-e831138a5b7a",
                                "text": "„Schlimmer als Autofahrer, die Verkehrsregeln missachten, sind solche, die sich dabei auch noch im Recht fühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
