    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2020381a-75c4-322c-a8b4-9d92db749a9d",
                    "sense_definition": "Seen, understood, or interpreted in a particular way by an individual, which may or may not reflect reality.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is often a big difference between <w>perceived</w> danger and real threat.",
                            "target_lang_translations": {
                                "nl": "Er is vaak een groot verschil tussen <w>ervaren</w> gevaar en een echte dreiging."
                            }
                        },
                        {
                            "text": "Her <w>perceived</w> lack of experience made the team hesitant to trust her leadership at first.",
                            "target_lang_translations": {
                                "nl": "Haar <w>vermeende</w> gebrek aan ervaring zorgde ervoor dat het team haar leiderschap eerst niet zo goed durfde te vertrouwen."
                            }
                        }
                    ],
                    "synonyms": [
                        "supposed",
                        "apparent",
                        "seeming"
                    ],
                    "antonyms": [
                        "actual",
                        "real"
                    ],
                    "common_phrases": [
                        "perceived risk",
                        "perceived threat",
                        "perceived value",
                        "perceived importance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zoals het door iemand wordt gezien, begrepen of geïnterpreteerd, wat wel of niet met de werkelijkheid overeenkomt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "waargenomen",
                                "target_lang_sense_clarification": "zoals gepercipieerd door de zintuigen of de geest"
                            },
                            {
                                "target_lang_word": "vermeend",
                                "target_lang_sense_clarification": "vermoed of verondersteld, maar niet bewezen"
                            },
                            {
                                "target_lang_word": "gepercipieerd",
                                "target_lang_sense_clarification": "formeel: zoals het ervaren of gezien wordt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63909af9-6628-399d-86ca-240f94098d38",
                    "sense_definition": "Generally accepted or regarded as true or real by most people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>perceived</w> wisdom was that interest rates would remain stable throughout the year.",
                            "target_lang_translations": {
                                "nl": "De <w>algemeen aangenomen</w> opvatting was dat de rente het hele jaar stabiel zou blijven."
                            }
                        },
                        {
                            "text": "Despite the <w>perceived</w> truth of the rumor, no evidence was ever found to support it.",
                            "target_lang_translations": {
                                "nl": "Ondanks de <w>veronderstelde</w> waarheid van het gerucht, werd er nooit enig bewijs gevonden om het te ondersteunen."
                            }
                        }
                    ],
                    "synonyms": [
                        "accepted",
                        "acknowledged"
                    ],
                    "common_phrases": [
                        "perceived wisdom",
                        "perceived truth"
                    ],
                    "target_lang_definitions": {
                        "nl": "Algemeen aanvaard of door de meeste mensen als waar of werkelijk beschouwd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "algemeen aangenomen",
                                "target_lang_sense_clarification": "door de meeste mensen geloofd"
                            },
                            {
                                "target_lang_word": "vermeend",
                                "target_lang_sense_clarification": "verondersteld als waarheid"
                            },
                            {
                                "target_lang_word": "gangbaar",
                                "target_lang_sense_clarification": "gebruikelijk of geaccepteerd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d15781c5-7a2e-3a99-90a7-a7805145c924",
                    "sense_definition": "simple past and past participle of <w>perceive</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>perceived</w> a subtle shift in his mood during the meeting.",
                            "target_lang_translations": {
                                "nl": "Zij <w>bespeurde</w> een subtiele verandering in zijn humeur tijdens de vergadering."
                            }
                        },
                        {
                            "text": "He <w>perceived</w> the threat immediately and took appropriate action.",
                            "target_lang_translations": {
                                "nl": "Hij <w>nam</w> de dreiging direct <w>waar</w> en nam passende maatregelen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van opmerken, waarnemen of bespeuren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nam waar",
                                "target_lang_sense_clarification": "verleden tijd van waarnemen"
                            },
                            {
                                "target_lang_word": "opgemerkt",
                                "target_lang_sense_clarification": "voltooid deelwoord van opmerken"
                            },
                            {
                                "target_lang_word": "bespeurde",
                                "target_lang_sense_clarification": "verleden tijd van bespeuren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
