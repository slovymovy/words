                        "entry_id": "8d093ec0-49ec-3c1f-85aa-c78119cdd0c8",
                        "glosses": [
                            "A fine, transparent type of muslin, usually stiffened."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c7ab22-35f0-4f8c-a2be-5013c3715a16",
                                "sense_id": "da44ae09-cd49-3823-b004-e22e65ce2f98",
                                "text": "“I took it to garden-parties after I came out, with my hair curled and an organdie hat on top of the whole thing […].”"
                            },
                            {
                                "example_id": "eb2dce57-6d14-4bf8-819b-f1c2a0a6e0c7",
                                "sense_id": "da44ae09-cd49-3823-b004-e22e65ce2f98",
                                "text": "Beside them stood a puzzled female dwarf with a hideously rouged face as if ready for the circus; she was clad in white organdie with a marriage veil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
