                "senses": [
                    {
                        "sense_id": "b73383d0-7ad4-3bc3-9936-05db0ef84f8f",
                        "entry_id": "9a4c2bb3-4e53-313d-a0ef-273c259d2318",
                        "glosses": [
                            "Putin apologist, someone who holds positive views of the Russian government"
                        ],
                        "tags": [
                            "derogatory",
                            "informal",
                            "masculine",
                            "strong",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b5707843-05b6-45f3-8022-eeb4ae55d1f9",
                                "sense_id": "b73383d0-7ad4-3bc3-9936-05db0ef84f8f",
                                "text": "Es ist eine sehr polnische Sicht, gerade wenn Kerski über deutsche Putinversteher spricht, die Polen vorwerfen, sie wären hysterisch gegenüber Russland."
                            },
                            {
                                "example_id": "a9153398-650a-4b5b-9e61-400ed9eee452",
                                "sense_id": "b73383d0-7ad4-3bc3-9936-05db0ef84f8f",
                                "text": "Merkel, Rühe, Verheugen, auch die grüne Grande Dame Vollmer – da steht ein Häuflein naiver Putinversteher gegen seriöse Charaktere wie Trump und Johnson."
                            }
                        ]
                    }
