                                        ],
                                        "tags": [
                                            "deeltjesfysica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10080e27-20da-4b60-bc23-b6d8c279f9a3",
                                                "sense_id": "8300b4c9-2dbd-34f2-9390-3076017d9ca6",
                                                "text": "Volgens WMAP bestaat vier procent van de massa van het heelal uit hadronen."
                                            },
                                            {
                                                "example_id": "09fc7ae0-e524-4d2a-bbba-1aa3fe636cea",
                                                "sense_id": "8300b4c9-2dbd-34f2-9390-3076017d9ca6",
                                                "text": "Nu hebben deeltjesfysicus Benjamin Dönigus van de Goethe-universiteit Frankfurt in Duitsland en zijn collega’s van de Large Hadron Collider (LHC) bij CERN in Genève de lat nog hoger gelegd. Ze hebben een nog zwaardere antimateriekern gemaakt: antihyperhelium-4."
                                            }
