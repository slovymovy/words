                    "sense_id": "e65f7c38-b4b8-3e53-9f76-a1a614d5720a",
                    "sense_definition": "Établir la vérité ou la réalité de quelque chose au moyen de faits, d'arguments ou de témoignages.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a réussi à <w>prouver</w> l'innocence de son client avec de nouveaux documents.",
                            "target_lang_translations": {
                                "en": "The lawyer managed to <w>prove</w> his client's innocence with new documents.",
                                "ru": "Адвокату удалось <w>доказать</w> невиновность своего клиента с помощью новых документов.",
                                "nl": "De advocaat slaagde erin de onschuld van zijn cliënt met nieuwe documenten <w>aan te tonen</w>.",
                                "de": "Dem Anwalt gelang es, mit neuen Dokumenten die Unschuld seines Mandanten <w>zu beweisen</w>.",
                                "pl": "Adwokatowi udało się <w>udowodnić</w> niewinność swojego klienta dzięki nowym dokumentom.",
                                "it": "L'avvocato è riuscito a <w>provare</w> l'innocenza del suo cliente con nuovi documenti.",
                                "cs": "Advokátovi se podařilo s novými dokumenty <w>prokázat</w> nevinu svého klienta.",
                                "tr": "Avukat, yeni belgelerle müvekkilinin masumiyetini <w>kanıtlamayı</w> başardı.",
                                "es": "El abogado logró <w>probar</w> la inocencia de su cliente con nuevos documentos.",
                                "zh": "律师凭借新的证据，成功<w>证明</w>了当事人无罪。"
                            }
                        },
                        {
                            "text": "Cette analyse rigoureuse <w>prouve</w> le contraire de ce que les experts pensaient.",
                            "target_lang_translations": {
                                "en": "This rigorous analysis <w>proves</w> the opposite of what the experts believed.",
                                "ru": "Этот строгий анализ <w>доказывает</w> обратное тому, что думали эксперты.",
                                "nl": "Deze grondige analyse <w>bewijst</w> juist het tegendeel van wat de experts dachten.",
                                "de": "Diese gründliche Analyse <w>beweist</w> das Gegenteil dessen, was die Experten dachten.",
                                "pl": "Ta dokładna analiza <w>dowodzi</w> dokładnie przeciwnego tego, co myśleli eksperci.",
                                "it": "Questa analisi rigorosa <w>dimostra</w> il contrario di ciò che pensavano gli esperti.",
                                "cs": "Tato důkladná analýza <w>dokazuje</w> opak toho, co si experti mysleli.",
                                "tr": "Bu titiz analiz, uzmanların düşündüğünün tam tersini <w>kanıtlıyor</w>.",
                                "es": "Este análisis riguroso <w>demuestra</w> justo lo contrario de lo que pensaban los expertos.",
                                "zh": "这项严谨的分析<w>证明</w>了专家们的看法恰恰相反。"
                            }
                        }
                    ],
                    "synonyms": [
