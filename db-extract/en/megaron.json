                        "source_entry_id": "af92db63-01f5-3e0c-9dea-ff845c1925fe",
                        "source_sense_id": "b16a5e52-79e2-311b-a486-e4790a62b1ec",
                        "source_sense_description": "Mycenean rectangular hall",
