                                    {
                                        "sense_id": "3e9152eb-0658-3210-a75b-a4986b3d1fd4",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "A small figure resembling a human being that is used as a toy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d782ea91-9f2f-3ae6-a283-72f8e60a8b82",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "An attractive young woman."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d653313-5fed-444b-a9fa-25e74893c5ce",
                                                "sense_id": "d782ea91-9f2f-3ae6-a283-72f8e60a8b82",
                                                "text": "Some fine day we may have the country raised, and the gendarmes down upon us from Strasburg, and all owing to your pretty doll, with her cunning ways of coming over you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efce7ea7-15ef-3ea0-916d-397f303c1acc",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "A term of endearment: darling, sweetheart."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Scotland",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "373c13a2-05a3-473f-96e8-cddb603a4d51",
                                                "sense_id": "efce7ea7-15ef-3ea0-916d-397f303c1acc",
                                                "text": "\"They didn't sell cigarettes where you were, doll?\" Palmer asked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c15c92-fcbf-311a-a4af-375d6e016bca",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "A good-natured, cooperative or helpful person."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f14fd38f-32cd-4d15-95bb-9ac0e9ab2b7b",
                                                "sense_id": "49c15c92-fcbf-311a-a4af-375d6e016bca",
                                                "text": "Won't you be a doll and fetch me a glass of water?"
                                            },
                                            {
                                                "example_id": "c502ff65-cb2d-4c94-b7cd-f750de5197ef",
                                                "sense_id": "49c15c92-fcbf-311a-a4af-375d6e016bca",
                                                "text": "2017, Chunk in \"Skate-lebrity\", The ZhuZhus\nOw! These things are defective. Pipsqueak, be a doll, I need a new pair, pronto!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5006160-94c8-32d1-bb80-fdbb742cbcd7",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "The smallest or pet pig in a litter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e0737d2-37d2-34de-a24d-c2d636343dc1",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "A short signal post mounted on a bracket mounted on the main signal post, or on a signal gantry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e79d72-b72b-4890-9bfb-1c3799871f8a",
                                                "sense_id": "7e0737d2-37d2-34de-a24d-c2d636343dc1",
                                                "text": "The signals are on a three-doll bracket post; one doll carries two [signal] arms, one above the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3faed816-155e-35f3-a9a1-81245ff20408",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "A barbiturate or amphetamine pill."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973bb1fa-14f6-4df5-b954-b6462b4f7f9d",
                                                "sense_id": "3faed816-155e-35f3-a9a1-81245ff20408",
                                                "text": "Each night she looked at the bottle of Seconals with affection. She never could do this without the dolls. She would have spent sleepless nights, smoking, worrying—and she would have lost her nerve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769e2ba9-d878-345e-9de4-f990972d3134",
                                        "entry_id": "01ed2205-81fe-3519-94c9-93ff483e5c91",
                                        "glosses": [
                                            "A transgender woman or transfeminine person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
