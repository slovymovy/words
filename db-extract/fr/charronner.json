                "senses": [
                    {
                        "sense_id": "6c99b34f-57ff-3eae-85ef-a1f2b0516869",
                        "entry_id": "2ca4353e-feef-3827-a1fb-e0c9a751d531",
                        "glosses": [
                            "Travailler en tant que charron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139e2dfd-efd2-4358-bb97-1ad79546eac1",
                                "sense_id": "6c99b34f-57ff-3eae-85ef-a1f2b0516869",
                                "text": "Voici venir LA FIN DU MONDE ! — disaient marchands, artisans. trafiquants ; — à quoi bon acheter, trafiquer, tisser la toile, forger le fer, charronner le bois, ouvrer des étoffes ?"
                            },
                            {
                                "example_id": "29130b28-e00e-41ec-875a-1b7db84e270f",
                                "sense_id": "6c99b34f-57ff-3eae-85ef-a1f2b0516869",
                                "text": "Dès sa première communion, gagé par l'un ou par l'autre, […], il était sans l'avoir appris devenu habille à menuiser, à charronner, à réparer un coutre, à ferrer un cheval."
                            },
                            {
                                "example_id": "e0e8599b-5a07-4efe-8b1c-c88a0304d121",
                                "sense_id": "6c99b34f-57ff-3eae-85ef-a1f2b0516869",
                                "text": "Ton frêne pour « charronner », tu te le mettras où je pense !"
                            }
                        ]
                    }
                ],
