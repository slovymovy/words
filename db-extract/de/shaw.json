                "senses": [
                    {
                        "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                        "entry_id": "8518bd0f-d30a-3465-83b0-34bf9b942b86",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86641bc-4702-4cba-900e-29149220de8f",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Frau Shaw ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "89ec493e-463a-4c49-8995-72eab2b3711e",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Herr Shaw wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9ed8990a-d0c1-407c-bfe6-a8e40274c972",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Die Shaws fliegen heute nach Dublin."
                            },
                            {
                                "example_id": "5d5a06ff-a2b7-4974-9f40-32c4a6c973b5",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Der Shaw trägt nie die Schals, die die Shaw ihm strickt."
                            },
                            {
                                "example_id": "92c887f9-1180-4aa1-a896-c078d33910a9",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Shaw kommt, geht der Herr Shaw.“"
                            },
                            {
                                "example_id": "e5844179-3490-49be-8644-030008c0e588",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Shaw kommt und geht."
                            },
                            {
                                "example_id": "89582d47-06fc-4628-822e-00c181cf7688",
                                "sense_id": "27fccc71-1b14-34c6-b888-4445697e5410",
                                "text": "Shaws kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
