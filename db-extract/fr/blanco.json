                "senses": [
                    {
                        "sense_id": "02b5f65b-16ec-314a-84e8-14aa5cf2ee11",
                        "entry_id": "403c6d1a-cbd1-3044-b42c-a105d114a487",
                        "glosses": [
                            "Correcteur liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d005742b-93ca-4e74-bcd3-bedcf1a82764",
                                "sense_id": "02b5f65b-16ec-314a-84e8-14aa5cf2ee11",
                                "text": "Ces blagues pourraient me jouer des tours. Il a effacé la phrase avec du blanco."
                            },
                            {
                                "example_id": "2f8afd10-fc6c-418e-b758-9e1d988a2253",
                                "sense_id": "02b5f65b-16ec-314a-84e8-14aa5cf2ee11",
                                "text": "Sam grimaça. Son fils devait en effet porter le nom de famille de Marti, et sur son certificat de naissance figurait forcément la mention « de père inconnu ». […]. Il faudrait bien plus qu'un coup de blanco sur un papier pour réparer tout ça."
                            },
                            {
                                "example_id": "7ab67a8b-0606-4042-b27b-dc71710e6cac",
                                "sense_id": "02b5f65b-16ec-314a-84e8-14aa5cf2ee11",
                                "text": "— Pas grand-chose, ai-je répondu en contemplant le flocon que j'avais dessiné sur l'ongle de mon pouce avec du blanco."
                            }
                        ]
                    },
                    {
                        "sense_id": "268e0193-cd05-3dfb-a52a-8afbdb0e2214",
                        "entry_id": "403c6d1a-cbd1-3044-b42c-a105d114a487",
                        "glosses": [
                            "Ruban correcteur."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "546919bf-f619-3a16-9619-b444d9e8ec92",
                        "entry_id": "403c6d1a-cbd1-3044-b42c-a105d114a487",
                        "glosses": [
                            "Exemplaire d’un livre relié mais non imprimé, qui permet à l’éditeur de se faire une idée précise de l’objet fini et d’en éprouver la présentation."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "1edb4b9a-6f68-475f-9075-85717c85c9ea",
                                "sense_id": "546919bf-f619-3a16-9619-b444d9e8ec92",
                                "text": "Réalisez un blanco [maquette en blanc] avec le papier d'impression pour déterminer de façon précise l'épaisseur des cahiers et définir ainsi la mesure du dos."
                            }
                        ]
                    }
