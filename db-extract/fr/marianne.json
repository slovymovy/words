                    },
                    {
                        "translation_id": "b42ceaab-9743-44f2-a076-365c9e28241c",
                        "source_entry_id": "9e75c7c7-f4d7-3fd0-8f0d-34eda5d8625e",
                        "source_sense_id": "b7db7272-cc64-39c3-83ab-c0e5f80d6af5",
                        "source_sense_description": "Prénom équivalent",
                        "target_lang_word": "Mary Ann",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mary Ann",
