                    {
                        "translation_id": "dc401257-89fe-46db-86ee-a1eb513a48a4",
                        "source_entry_id": "8ce23495-fea6-382f-a5cf-2db3077ae122",
                        "target_lang_word": "Schiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4328aa2a-16a7-35e6-8afe-bfcac644e3c7",
                                        "entry_id": "300eaff2-9c2a-30ea-b0b8-dfaaa4b2e869",
                                        "glosses": [
                                            "großes Wasserfahrzeug (in der Regel mit über 10 m Rumpflänge, sonst ist es ein Boot)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c00b16-f45b-456a-af3e-d5f4f0ddf274",
                                                "sense_id": "4328aa2a-16a7-35e6-8afe-bfcac644e3c7",
                                                "text": "Schau dir mal dieses große Schiff an!"
                                            },
                                            {
                                                "example_id": "5fb619ac-b655-4fd9-a55e-02acd28670df",
                                                "sense_id": "4328aa2a-16a7-35e6-8afe-bfcac644e3c7",
                                                "text": "„Die Niederlage der athenischen Flotte im Nildelta gegen persische Schiffe beendet die griechische Intervention im ägyptischen Aufstand.“"
                                            },
                                            {
                                                "example_id": "bcd2a953-ac64-4923-99a1-23d96ae469af",
                                                "sense_id": "4328aa2a-16a7-35e6-8afe-bfcac644e3c7",
                                                "text": "„Wir steuern, obschon das Schiff jetzt sehr langsam in Schritttempo fährt, gegen eine starke Strömung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32705703-027a-308a-8ff3-fe21e8aee155",
                                        "entry_id": "300eaff2-9c2a-30ea-b0b8-dfaaa4b2e869",
                                        "glosses": [
                                            "lang gestreckter Raum einer Kirche oder Kathedrale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d3150e-a6ab-493c-b7f3-b082bdc255b3",
                                                "sense_id": "32705703-027a-308a-8ff3-fe21e8aee155",
                                                "text": "„Kirchen werden - insbesondere wenn es sich um Basiliken handelt - in verschiedene Schiffe aufgeteilt (Saalkirchen sind einschiffig bei Hallenkirchen gibt es Seitenschiffe die gleich hoch wie das Hauptschiff sind).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34b7fd76-ba77-331d-b40b-9e5b8c9e8d12",
                                        "entry_id": "300eaff2-9c2a-30ea-b0b8-dfaaa4b2e869",
                                        "glosses": [
                                            "eine Metallplatte mit an drei Seiten aufgebogenem Rand, die zum Sammeln des Drucksatzes benutzt wird"
                                        ],
                                        "tags": [
                                            "Drucktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd41f9d-3ec4-41a4-866b-0d35178abced",
                                                "sense_id": "34b7fd76-ba77-331d-b40b-9e5b8c9e8d12",
                                                "text": "Der Winkelhaken, Hauptwerkzeug der Setzer. Er ist in der Breite verstellbar und nimmt die Einzelbuchstaben aus Blei zeilenweise auf. Danach werden die Zeilen ausgehoben (Ungeübte schmeißen bei diesem Vorgang wieder alles zusammen, was sie vorher mühsam gesetzt haben) und dann auf ein Schiff (Metallblech mit Rahmen) gestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbf5437d-36fd-444e-a64b-fe8e2d452dd9",
                        "source_entry_id": "8ce23495-fea6-382f-a5cf-2db3077ae122",
                        "target_lang_word": "festmachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "festmachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8102cd39-18dd-3a03-82cf-2d7b23198245",
                                        "entry_id": "19a71054-928a-302e-9453-b0e0a4e7fe06",
                                        "glosses": [
                                            "vor dem Abfallen, Runterrutschen, Wegblasen oder Ähnlichem sichern; etwas befestigen"
                                        ],
                                        "tags": [
                                            "Dinge"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0622ac58-997b-4847-b9d0-1fbcbd330776",
                                                "sense_id": "8102cd39-18dd-3a03-82cf-2d7b23198245",
                                                "text": "Könnten Sie bitte die Zierleiste wieder festmachen? Die ist vorhin abgegangen."
                                            },
                                            {
                                                "example_id": "f9d061e3-cdbc-4694-b7c1-0258500677d2",
                                                "sense_id": "8102cd39-18dd-3a03-82cf-2d7b23198245",
                                                "text": "Er muss noch provisorisch die Plane am Schuppendach festmachen, dann kommt er."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21ab9bd3-0426-3300-a225-f70387829077",
                                        "entry_id": "19a71054-928a-302e-9453-b0e0a4e7fe06",
                                        "glosses": [
                                            "ernsthaft vereinbaren"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "945f2eb0-5322-46d8-808c-4453160b4e63",
                                                "sense_id": "21ab9bd3-0426-3300-a225-f70387829077",
                                                "text": "Wenn Sie wollen, können wir das Geschäft schon heute festmachen."
                                            },
                                            {
                                                "example_id": "8d2d2904-87d6-46ca-9295-9c55e94ff8e4",
                                                "sense_id": "21ab9bd3-0426-3300-a225-f70387829077",
                                                "text": "Gut, machen wir also Montag als Abgabedatum fest."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "651c4bcf-84ab-30e5-a3dc-88d26ba9f37e",
                                        "entry_id": "19a71054-928a-302e-9453-b0e0a4e7fe06",
                                        "glosses": [
                                            "gedanklich in einen (ursächlichen) Zusammenhang bringen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc12a0b4-315c-4b6a-a595-e19f25a36e1d",
                                                "sense_id": "651c4bcf-84ab-30e5-a3dc-88d26ba9f37e",
                                                "text": "Und woran bitte willst du diese Einschätzung festmachen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "51fba65f-e57c-3ede-9b05-c1851a5785f7",
                                        "entry_id": "19a71054-928a-302e-9453-b0e0a4e7fe06",
                                        "glosses": [
                                            "mit Tauen vor dem Abtreiben sichern"
                                        ],
                                        "tags": [
                                            "Boote, Schiffe, ohne Objekt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6a316e-0643-4b84-8c69-1deef4e8da28",
                                                "sense_id": "51fba65f-e57c-3ede-9b05-c1851a5785f7",
                                                "text": "Wenn das Schiff festgemacht hat, wird die Ladung gelöscht."
                                            },
                                            {
                                                "example_id": "26962388-883d-447d-96e5-3db424dc6fd4",
                                                "sense_id": "51fba65f-e57c-3ede-9b05-c1851a5785f7",
                                                "text": "[Samsø/Dänemark:] „Alle Segler, die hier festmachen, werden jetzt von der Sonne mit Strom versorgt.“"
                                            },
                                            {
                                                "example_id": "a94c8b0d-aebf-46fe-bfc1-3211d0af95a8",
                                                "sense_id": "51fba65f-e57c-3ede-9b05-c1851a5785f7",
                                                "text": "„Ich […] sprang in das Motorboot und fuhr es auf die andere Seite des Stegs, um es dort festzumachen.“"
                                            },
                                            {
                                                "example_id": "021d2c5d-6a8c-42f1-b2aa-2e8c51fc9a6a",
                                                "sense_id": "51fba65f-e57c-3ede-9b05-c1851a5785f7",
                                                "text": "„Das Schiff wurde in der Nacht zu Samstag in den Rostocker Hafen geschleppt, wo es um 1.00 Uhr festmachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
