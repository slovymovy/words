                        "cross_references": [
                            {
                                "target_word": "sponsor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization with some sort of responsibility for another person or organization, especially where the responsibility has a religious, legal, or financial aspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c815eb36-dd01-45f0-91a3-4aa3c09afc39",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "He was my sponsor when I applied to join the club."
                                            },
                                            {
                                                "example_id": "476a6f1e-692c-451b-91d8-db7a8111553a",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "They were my sponsors for immigration."
                                            },
                                            {
                                                "example_id": "c2d5736e-2f55-480d-9f6a-1f0c780e5005",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "The colonel and his sponsor made a queer contrast: Greystone [the sponsor] long and stringy, with a face that seemed as if a cold wind was eternally playing on it. […] But there was not a more lascivious reprobate and gourmand in all London than this same Greystone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization with some sort of responsibility for another person or organization, especially where the responsibility has a religious, legal, or financial aspect.",
                                            "A senior member of a twelve step or similar program chosen to guide an initiate and form a partnership with them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435b75e4-2d8a-4b93-bd86-3d8729b10948",
                                                "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                                "text": "My narcotics anonymous sponsor became my best friend when I finally was able to do something about my meth problem."
                                            },
                                            {
                                                "example_id": "03db4f57-ee93-47e6-bb1e-b34b759c2a00",
                                                "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                                "text": "Members also choose a sponsor, with whom they are supposed to remain in regular, even daily, contact—and that, too, is a powerful boost for monitoring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ed18dd-e79f-3b61-97d1-e45102712bcd",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization that pays all or part of the cost of an event, publication, media program, etc., usually in exchange for advertising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92efaac5-e314-41e4-b145-0f040a6a99a5",
                                                "sense_id": "b8ed18dd-e79f-3b61-97d1-e45102712bcd",
                                                "text": "And now a word from our sponsor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sponsor",
