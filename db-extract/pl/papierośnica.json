                    },
                    {
                        "translation_id": "064b861d-05f6-45fa-a79b-522eb329afad",
                        "source_entry_id": "d16ad365-6e6a-34e3-855a-0e6ebe946cab",
                        "source_sense_id": "e02623aa-1292-3423-8adc-2322499e61d7",
                        "target_lang_word": "Zigarettenetui",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zigarettenetui",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6fa90f-7228-3c58-b607-da17fe73f51d",
                                        "entry_id": "4eb66e63-b600-3546-b202-8ac5a3af24f6",
                                        "glosses": [
                                            "kleines, festes Behältnis für Zigaretten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a4e72f-6c63-4bba-a1a8-37abf8a1cd2a",
                                                "sense_id": "8f6fa90f-7228-3c58-b607-da17fe73f51d",
                                                "text": "„Sie hatte kein Zigarettenetui und rauchte nicht.“"
                                            },
                                            {
                                                "example_id": "5a7ff752-61d7-41f7-b7eb-9d8bc62675a3",
                                                "sense_id": "8f6fa90f-7228-3c58-b607-da17fe73f51d",
                                                "text": "„Ich bemerke, daß sein Zigarettenetui von Gold ist und Wappen und Krone trägt.“"
                                            },
                                            {
                                                "example_id": "d38fdbd8-ac51-4d7f-84ef-d413b82480ac",
                                                "sense_id": "8f6fa90f-7228-3c58-b607-da17fe73f51d",
                                                "text": "„Auf dem Hof holte sie ein Zigarettenetui hervor und durchsuchte ihren Mantel nach einem Feuerzeug.“"
                                            },
                                            {
                                                "example_id": "dfd9c6fa-2c1d-4a5d-b382-ca428e328f9d",
                                                "sense_id": "8f6fa90f-7228-3c58-b607-da17fe73f51d",
                                                "text": "„Er goß mir Sprudel ein, hielt mir sein Zigarettenetui hin, ich nahm eine, er gab mir Feuer, wir rauchten.“"
                                            },
                                            {
                                                "example_id": "03fb4e35-b1a2-48fa-8399-b2f72710168c",
                                                "sense_id": "8f6fa90f-7228-3c58-b607-da17fe73f51d",
                                                "text": "„Dann holte er das große stählerne Zigarettenetui sowie sein schwarzes Feuerzeug heraus und legte beides auf den grünen Flanell neben seinen rechten Unterarm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f2f704a-9152-45ad-b92f-f7f25e0f3dba",
