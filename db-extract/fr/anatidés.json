                "senses": [
                    {
                        "sense_id": "287fa14f-4693-360f-bfbf-65cd7a83183a",
                        "entry_id": "5ea0d9fd-c6d6-3165-ba5c-62e3ef878b0c",
                        "glosses": [
                            "Famille d’oiseaux appartenant à l'ordre des ansériformes, constituée d’oiseaux aquatiques au corps massif, aux pattes courtes et palmées, au plumage dense et au bec généralement aplati et dont l’intérieur est couvert de lamelles filtrantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3585aecc-b2da-43cf-a3ce-475ed912b2e3",
                                "sense_id": "287fa14f-4693-360f-bfbf-65cd7a83183a",
                                "text": "Tous les anatidés nagent avec agilité et sans fatigue, beaucoup plongent avec aisance; ces oiseaux marchent avec plus ou moins de facilité; quelques espèces perchent volontiers et paraissent se plaire au milieu des branches."
                            }
                        ]
                    }
