                        "examples": [
                            {
                                "example_id": "d66a3cb5-1a51-45ea-a634-cb4a0f7f0b3b",
                                "sense_id": "e7b433d3-ad6a-34f2-8b92-82da0097779d",
                                "text": "Milena kam an einem Oktobertag."
                            },
                            {
                                "example_id": "f61add34-a549-4f82-97d2-1dc1b857698f",
                                "sense_id": "e7b433d3-ad6a-34f2-8b92-82da0097779d",
                                "text": "„Es war ein wolkenloser Oktobertag, an dem ich mich über ihren kleinen Empire-Schreibtisch beugte und sanft mit meinem Mund über ihr Gesicht mit den grünen Augen wanderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
