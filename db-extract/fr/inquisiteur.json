                    {
                        "form_id": "acde18c7-a85b-495f-ba52-905efb63dc94",
                        "entry_id": "f2919d2f-d525-3c15-9c1a-1a264eb25db8",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "inquisitrice"
                    },
                    {
                        "form_id": "f8d79a4f-995d-43d1-a388-be496f9f5f0a",
                        "entry_id": "f2919d2f-d525-3c15-9c1a-1a264eb25db8",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "inquisitrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df9424c4-2ea1-30ab-8710-1b543853a1f3",
                        "entry_id": "f2919d2f-d525-3c15-9c1a-1a264eb25db8",
                        "glosses": [
                            "Qui cherche à s’enquérir avec une curiosité souvent indiscrète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01f146c-7abb-4199-890c-7d8064e5522c",
                                "sense_id": "df9424c4-2ea1-30ab-8710-1b543853a1f3",
                                "text": "Marx franchit le seuil sans prononcer un seul mot, se contentant d’observer l’habitation d’un œil inquisiteur."
                            },
                            {
                                "example_id": "c89faea6-8fe8-456c-a246-acb81f77c716",
                                "sense_id": "df9424c4-2ea1-30ab-8710-1b543853a1f3",
                                "text": "Jusqu'au jour où elle a décidé de ne plus toucher une goutte d'alcool, quitte à braver les regards inquisiteurs de ses proches."
                            },
                            {
                                "example_id": "ffe47f7e-b15e-416d-8bed-db07853be9b7",
                                "sense_id": "df9424c4-2ea1-30ab-8710-1b543853a1f3",
                                "text": "Évitez donc de provoquer des rivalités par votre comportement inquisiteur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                "word": "inquisiteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d56d5d68-b599-48da-ac79-dd54fd455f05",
                        "entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "inquisiteurs"
                    },
                    {
                        "form_id": "8eeb4ac3-6f42-4e2d-8114-553d5cef7821",
                        "entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                        "tags": [
                            "feminine"
                        ],
                        "form": "inquisitrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3912dc5b-fb4a-31fd-8167-42881a2f023c",
                        "entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                        "glosses": [
                            "Juge de l’inquisition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe92971-3973-4b37-a1b7-05cdf91e3383",
                                "sense_id": "3912dc5b-fb4a-31fd-8167-42881a2f023c",
                                "text": "D’ici furent dirigés ces inquisiteurs qui allèrent brûler Vaudois, cathares, fraticelles, béguins, sorciers, envoûteurs, magiciens, flagellants, ou juifs convertis, mais soupçonnés de sortilèges."
                            },
                            {
                                "example_id": "bf02444c-825b-4002-82a1-6f4ed2916149",
                                "sense_id": "3912dc5b-fb4a-31fd-8167-42881a2f023c",
                                "text": "Le roi vit dans cette mort un châtiment divin et l’inquisiteur Henri de Cologne en profita pour obtenir de lui l’application immédiate de la sanction."
                            }
                        ]
                    },
                    {
                        "sense_id": "f92ac395-943b-3521-9eee-301218009784",
                        "entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                        "glosses": [
                            "Personne qui s'immisce indûment dans la vie des gens, qui leur cherche des défauts, des tares, ou tout autre état pouvant servir de prétexte à dénonciation, à punition."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3431e0e8-dedc-4841-ba96-229b9f140276",
                                "sense_id": "f92ac395-943b-3521-9eee-301218009784",
                                "text": "Et quand la jeune femme lui demanda, le soir: « Comment le trouves-tu? » il répondit: « Cet homme-là, c'est un inquisiteur! Il doit être dangereux. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "32826eb6-0e38-381f-a990-a11c0f2b2cac",
                        "entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                        "glosses": [
                            "Magistrat de la république de Venise qui était chargé de découvrir et de prévenir les complots formés contre le gouvernement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb25d91-d2f3-435c-be14-93cb0ddd12da",
                                "sense_id": "32826eb6-0e38-381f-a990-a11c0f2b2cac",
                                "text": "C'est un merveilleux organisateur de mouvements de masses, de guerres, de lynchages, de persécutions, habile dialecticien, père de toutes les formations idéologiques, grand inquisiteur et amateur de guerres saintes..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84b0795c-e409-4e70-8317-9bacba51ec53",
                        "source_entry_id": "859d8de8-88f0-3dc3-93ee-64172572d6e0",
                        "target_lang_word": "inquisitor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquisitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe569cc5-f75d-3b33-a4a1-b9cbc53e4eaf",
                                        "entry_id": "c1c4ec52-2697-3c6f-a0da-0626f89f3566",
                                        "glosses": [
                                            "A person who inquires, especially searchingly or ruthlessly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b79de3-0e68-4820-9d8f-f4aa96a0edcd",
                                                "sense_id": "fe569cc5-f75d-3b33-a4a1-b9cbc53e4eaf",
                                                "text": "During the meeting, Jake turned into an inquisitor, firing questions at the presenter non-stop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b708151-c75c-3bbb-91a7-181ceb55efb5",
