                        "target_lang_word": "picket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "047eceea-951f-33e5-8af1-a28195c50c17",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "A stake driven into the ground."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f54652-aabc-4074-93d4-9417c568ebd6",
                                                "sense_id": "047eceea-951f-33e5-8af1-a28195c50c17",
                                                "text": "a picket fence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808929b2-6f57-3c7b-98d0-75266218d768",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "A type of punishment by which an offender had to rest his or her entire body weight on the top of a small stake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20e2b03d-1f46-316e-b87a-d093ff24cdc9",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "A tool in mountaineering that is driven into the snow and used as an anchor or to arrest falls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db272431-6190-3cb6-bf70-f8dbecf3b83b",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "One of the soldiers or troops placed on a line forward of a position to warn against an enemy advance; or any unit (for example, an aircraft or ship) performing a similar function."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a4685f-edad-4ad9-a158-5c238c619f8a",
                                                "sense_id": "db272431-6190-3cb6-bf70-f8dbecf3b83b",
                                                "text": "So confident was he that he ignored the warning of his two British advisers to post pickets to watch the river, and even withdrew those they had placed there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe1536d-2ac9-3619-a18a-e2edf3c5b640",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "A sentry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "652c28f2-8c1d-483a-9cd5-70ef9853d5f0",
                                                "sense_id": "dfe1536d-2ac9-3619-a18a-e2edf3c5b640",
                                                "text": "Maccario, it was evident, did not care to take the risk of blundering upon a picket, and a man led them by twisting paths until at last the hacienda rose blackly before them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8304aa22-7782-3362-bc6b-9787c696bb92",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "A protester positioned outside an office, workplace etc. during a strike (usually in plural); also the protest itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc09bede-ff93-468b-a325-2bb116321a16",
                                                "sense_id": "8304aa22-7782-3362-bc6b-9787c696bb92",
                                                "text": "Pickets normally endeavor to be non-violent."
                                            },
                                            {
                                                "example_id": "017a3904-c60a-4d09-9ccc-9a4c5831b2df",
                                                "sense_id": "8304aa22-7782-3362-bc6b-9787c696bb92",
                                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fee78ae-b04d-3209-af23-06251159081e",
                                        "entry_id": "b4e8cc90-fa48-3274-a088-9f4d04f5cbd4",
                                        "glosses": [
                                            "The card game piquet."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "picket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "208a3449-3a4a-3e5b-90eb-33be5852369b",
                                        "entry_id": "fc6c2e93-2ef9-39ed-91cd-385406c31afd",
                                        "glosses": [
                                            "To protest, organized by a labour union, typically in front of the location of employment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ee38c66-9b15-3846-8d92-c1ae3037d8c8",
                                        "entry_id": "fc6c2e93-2ef9-39ed-91cd-385406c31afd",
                                        "glosses": [
                                            "To enclose or fortify with pickets or pointed stakes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6b962e6-ae73-4207-9d6d-6f90e98bfd65",
                                                "sense_id": "2ee38c66-9b15-3846-8d92-c1ae3037d8c8",
                                                "text": "One of the most striking was the silver pin presented to all members of the National Women’s Party who served time for picketting the White House for women’s suffrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "195f8a3c-b7d3-3fe0-b90c-58f06ebba218",
                                        "entry_id": "fc6c2e93-2ef9-39ed-91cd-385406c31afd",
                                        "glosses": [
                                            "To tether to, or as if to, a picket."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e43d7f-fdb7-4971-a76c-aeb353169a02",
                                                "sense_id": "195f8a3c-b7d3-3fe0-b90c-58f06ebba218",
                                                "text": "to picket a horse"
                                            },
                                            {
                                                "example_id": "093dd58a-4176-4374-993f-f53a07a2eb2a",
                                                "sense_id": "195f8a3c-b7d3-3fe0-b90c-58f06ebba218",
                                                "text": "[T]he Moors kept a good Guard all Night, and did not unſaddle their Horſes, but picketted them before the Tent-Doors; […]"
                                            },
                                            {
                                                "example_id": "b8f7e0cc-3184-4735-adca-5bb44c6bee06",
                                                "sense_id": "195f8a3c-b7d3-3fe0-b90c-58f06ebba218",
                                                "text": "[F]rom the outskirts of the fair, where are picketted the horses and the herds for sale, comes the tinkle of bells, a mule’s shrill scream, mingled with the music of a guitar or the rattle of castanets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155687ca-5421-3257-8c39-adef911cd13a",
                                        "entry_id": "fc6c2e93-2ef9-39ed-91cd-385406c31afd",
                                        "glosses": [
                                            "To guard, as a camp or road, by an outlying picket."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28e0ae4a-c9f9-3f69-8436-36ea240912e0",
                                        "entry_id": "fc6c2e93-2ef9-39ed-91cd-385406c31afd",
                                        "glosses": [
                                            "To torture by forcing to stand with one foot on a pointed stake."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
