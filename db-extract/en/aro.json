                        "sense_id": "a79cb73f-5bd5-3362-8307-9adf3f40c8d1",
                        "entry_id": "5e1459b3-49b3-3be6-a025-5b8ae0bac805",
                        "glosses": [
                            "Aromantic (not experiencing romantic attraction)."
                        ],
                        "tags": [
                            "neologism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8e886eda-b644-463d-ab11-446ce598f925",
                                "sense_id": "a79cb73f-5bd5-3362-8307-9adf3f40c8d1",
                                "text": "For ace and aro people, the possibilities for diverse relationships are endless, despite how pop culture often brands our identity as restrictive and confined."
                            },
                            {
                                "example_id": "edb252ab-050b-4f83-aea2-f6bab1e4e32d",
                                "sense_id": "a79cb73f-5bd5-3362-8307-9adf3f40c8d1",
                                "text": "For the show to completely and utterly ignore this is huge since there are very few representations of aro and ace-spec people in media of any kind."
                            },
                            {
                                "example_id": "32f411a9-ddd7-42c8-9457-eb017b0604d0",
                                "sense_id": "a79cb73f-5bd5-3362-8307-9adf3f40c8d1",
                                "text": "This provides a home base for people looking to learn more about ace and aro identities."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "68d71881-02e3-3d7d-984c-2e8dfa62f888",
