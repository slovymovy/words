                "translations": [
                    {
                        "translation_id": "e420dfb1-4d7e-4070-9048-36b79bcd97d9",
                        "source_entry_id": "a31fa225-cf5e-32fa-a036-7ba1087919f8",
                        "source_sense_id": "b236e2e4-186f-3ef7-8c1b-8e41151803c1",
                        "source_sense_description": "iemand die toezicht houdt",
                        "target_lang_word": "Aufseher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufseher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc136bba-0965-3caa-a9ee-c38df04fe18a",
                                        "entry_id": "e7394201-48f3-3f24-a047-c7e54e690f69",
                                        "glosses": [
                                            "jemand, der Dinge bewacht oder Vorgänge überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5805d0-c546-44bd-94cb-92ac7f8fa069",
                                                "sense_id": "bc136bba-0965-3caa-a9ee-c38df04fe18a",
                                                "text": "„Der Aufseher des Sammelpunkts empfing uns mit Freude, und wir heuerten sofort an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                        "entry_id": "e7394201-48f3-3f24-a047-c7e54e690f69",
                                        "glosses": [
                                            "jemand, der Personen (meist: unter Zwang gehaltene Personen) beaufsichtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a3decd-04b1-49c4-98bc-7f3d20c23eea",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Der Aufseher des Sammelpunkts empfing uns mit Freude, und wir heuerten sofort an.“"
                                            },
                                            {
                                                "example_id": "6945fd09-d457-4a74-b6e8-b8288b428ed3",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "Im Gefängnis als Aufseher zu arbeiten, ist keine leichte Aufgabe."
                                            },
                                            {
                                                "example_id": "67cb0b89-3d67-4fa1-bf77-abbe83d51740",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Die Aufseher haben uns auch gesagt, wir sollen schreiben, dass wir zum Arbeiten noch weiter fahren würden.“"
                                            },
                                            {
                                                "example_id": "49a4d8d6-a14e-4599-9ab9-44b20b4f18b0",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Ich folgte dem Aufseher über zwei kahle Steintreppen und einen langen, weiß gekalkten Gang, vorbei an langen Reihen schwerer Türen mit kleinen, vergitterten Fenstern.“"
                                            },
                                            {
                                                "example_id": "a1d1f9de-8d17-4479-8941-bb3e33402bfe",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Sie strickte ihm auch einen weißwollenen Schwanzwärmer mit roter Spitze, aber er versteckte ihn vor den andern Burschen der Kolonne, weil er Angst hatte, die Aufseher könnten es entdecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcad74e5-b92d-4b05-b71c-6b20141a24cf",
                        "source_entry_id": "a31fa225-cf5e-32fa-a036-7ba1087919f8",
                        "source_sense_id": "b236e2e4-186f-3ef7-8c1b-8e41151803c1",
                        "source_sense_description": "iemand die toezicht houdt",
                        "target_lang_word": "supervisor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supervisor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A person with the official task of overseeing the work of a person or group, or of other operations and activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cfc99c-1615-4e69-b012-f297fabebf3f",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "Thus, today, even if the objective does seem \"goalish,\" the supervisor assumes the problem inherent in trying to \"accomplish\" that goal will become clear to the librarian as the action plan evolves […]"
                                            },
                                            {
                                                "example_id": "e09c0214-e7de-429a-8958-4db00952d45e",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "The 1999 merger between Citibank (banking) and Travelers (insurance) created the model for megafinance and confirmed new challenges for supervisors."
                                            },
                                            {
                                                "example_id": "f1e84074-d228-4cad-91dc-decaff7678fd",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "I had learned a lot about supervising by observing other supervisors—the good things and the not-so-good things they did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2dd5407-daf6-3bfc-8d26-3aaae9a21963",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A person who monitors someone to make sure they comply with rules or other requirements set for them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e31c2-abd6-45e9-86dc-e01aa45040ce",
                                                "sense_id": "d2dd5407-daf6-3bfc-8d26-3aaae9a21963",
                                                "text": "Kashruth fraud in Brooklyn. Seems a goon squad of fake mashgichim or kosher supervisors have been making their way around the neighborhoods pulling surprise ‘inspections’ on different shops and restaurants, selling them fancy-looking certificates to put in the window […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d33c2c-7d5e-3497-aa27-882948a3f75e",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "In certain states, an elected member of the governing body for a county which is called the board of supervisors."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c4900b0-304f-3725-a0c9-9e17c86b77f1",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A process responsible for managing other processes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0229415-a935-4b10-9190-e9aad4f70c65",
                                                "sense_id": "2c4900b0-304f-3725-a0c9-9e17c86b77f1",
                                                "text": "The clock burst which enables the supervisor to housekeep the console input and output and to change program status is currently set to 200 ms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fca36947-e86e-40ea-9fec-659b1b83b0e8",
                        "source_entry_id": "a31fa225-cf5e-32fa-a036-7ba1087919f8",
                        "source_sense_id": "b236e2e4-186f-3ef7-8c1b-8e41151803c1",
                        "source_sense_description": "iemand die toezicht houdt",
                        "target_lang_word": "surveillant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surveillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6eef5b3b-51f6-30cf-a09a-d10161bed389",
                                        "entry_id": "48b67910-58be-3111-aa2e-4c437f25ac33",
                                        "glosses": [
                                            "Personne qui surveille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5977bcd6-de69-45d5-945b-4fb87c970095",
                                                "sense_id": "6eef5b3b-51f6-30cf-a09a-d10161bed389",
                                                "text": "C’est un surveillant soigneux, attentif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31da80ec-5722-372a-9045-25a40699fc74",
                                        "entry_id": "48b67910-58be-3111-aa2e-4c437f25ac33",
                                        "glosses": [
                                            "Personne chargée de la surveillance des détenus dans une prison."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d127e1b-10c6-4e4a-aa31-ea68a57f07f8",
                                                "sense_id": "31da80ec-5722-372a-9045-25a40699fc74",
                                                "text": "La morale des surveillants se bornait à menacer de leurs cannes, tantôt tirant le revolver pour donner plus de force aux locutions d’arsouille dont ils avaient l'habitude de se servir. Voilà la vie du bagne."
                                            },
                                            {
                                                "example_id": "84f2e8c6-e4e1-410c-9158-36726fcfa282",
                                                "sense_id": "31da80ec-5722-372a-9045-25a40699fc74",
                                                "text": "Les postes sont ainsi distribués : nᵒ 1 à la grille du quai un surveillant-concierge ; nᵒ 2 au guichet d’entrée de la cour un surveillant ; nᵒ 3 grande salle d’entrée, le brigadier, le sous-brigadier, deux surveillants ; nᵒ 4 dans l’enceinte cellulaire, six surveillants, savoir : deux au rez-de-chaussée, deux pour le premier étage, un pour le guichet conduisant à la Cour d’assises, un pour le parloir et la fouille des détenus."
                                            },
                                            {
                                                "example_id": "9b3481c9-031e-445f-b325-e0778e6c8ea6",
                                                "sense_id": "31da80ec-5722-372a-9045-25a40699fc74",
                                                "text": "À la prison de Forest, j'ai été plusieurs fois frappé violemment par des agents pénitentiaires, notamment parce que j'avais pris la défense de mon co-détenu avec lequel un surveillant avait été grossier et méprisant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0cd363-b5cf-39c6-a39d-1596b2a8d122",
                                        "entry_id": "48b67910-58be-3111-aa2e-4c437f25ac33",
                                        "glosses": [
                                            "Personne chargée de la surveillance des élèves pendant les études, les récréations et les promenades. En général, ce sont eux qui assurent les fameuses \\\"heures de colles\\\", qui gèrent les absences, les retards en cours."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef71acad-46e1-4dbf-8b74-ab902ad6de01",
                                                "sense_id": "4b0cd363-b5cf-39c6-a39d-1596b2a8d122",
                                                "text": "Il travaille comme surveillant d’une étude dans un collège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118e44c2-423a-3f6a-9ce2-2030301e3825",
                                        "entry_id": "48b67910-58be-3111-aa2e-4c437f25ac33",
                                        "glosses": [
                                            "Officier qui dans une loge assiste le vénérable, prend en charge les apprentis ou les compagnons dans leur évolution et donne la parole durant les tenues."
                                        ],
                                        "tags": [
                                            "Franc-maçonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1dfe2c-3000-4af7-a124-cad62c83cbac",
                                                "sense_id": "118e44c2-423a-3f6a-9ce2-2030301e3825",
                                                "text": "Le premier surveillant commande aux compagnons, le second commande aux apprentis"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surveillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2359673b-67e2-3960-9b33-f6b1f83cae93",
                                        "entry_id": "15f4d837-7a98-339d-9e56-38d7688a2b28",
                                        "glosses": [
                                            "Participe présent de surveiller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35157b61-aa49-4f29-b3dd-4acd96ede31b",
                                                "sense_id": "2359673b-67e2-3960-9b33-f6b1f83cae93",
                                                "text": "Les parents n’étaient pas en reste, surveillant leurs rejetons du coin de l’œil, amusés par cette curiosité remarquable, égarée parmi le catalogue des véhicules proprets et conforme au monde sanglé, airbagué, standardisé, condomisé, dans des carrosseries sans rayures, sans gloire, et sans nicotine, dont l’ultime conquête aura été l’extinction et la mise à mort des cendriers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
