                                "target_senses": [
                                    {
                                        "sense_id": "ab9dd57c-8c33-3166-863b-cb9d87054de5",
                                        "entry_id": "9434994b-12fe-341c-b588-e2e8931ac25d",
                                        "glosses": [
                                            "van ijzer gemaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c0efdbe-0f29-4389-87b0-fa71a052af8b",
                                                "sense_id": "ab9dd57c-8c33-3166-863b-cb9d87054de5",
                                                "text": "Daarin zit een ijzeren pin."
                                            },
                                            {
                                                "example_id": "a427307c-0dae-4807-a270-5d1eef133ab6",
                                                "sense_id": "ab9dd57c-8c33-3166-863b-cb9d87054de5",
                                                "text": "Ik ging voorzichtig op de rand van het ijzeren bed zitten en vroeg me af of een ander gezin dit huis ooit weer met leven zou vullen, met nieuwe kansen, hoop en mislukkingen."
                                            },
                                            {
                                                "example_id": "895600d7-1d0b-4e56-a443-871ec84a2680",
                                                "sense_id": "ab9dd57c-8c33-3166-863b-cb9d87054de5",
                                                "text": "Voor Genie had ik een ouderwetse, kanten blouse gekocht, recht uit Little house on the prairie. En voor Goldie een ijzeren hoefijzer, omdat hij een glans van geluk over zich had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c048775c-b05f-3934-b3a7-77a9525b709e",
                                        "entry_id": "9434994b-12fe-341c-b588-e2e8931ac25d",
                                        "glosses": [
                                            "hard en onverwoestbaar"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a61d26-7bbd-4309-9ba0-83174441e57f",
                        "source_entry_id": "b33271c3-72ad-3673-88c0-ec95b81271f5",
                        "source_sense_description": "of or containing iron",
                        "target_lang_word": "ferreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38d249fe-222a-3179-a5b8-ed82850ea127",
                                        "entry_id": "f6f98144-102a-3e86-84e3-dfb77a34bb82",
                                        "glosses": [
                                            "Qui contient du fer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf462534-9b9a-4853-8be0-7f2456816a2b",
                                                "sense_id": "38d249fe-222a-3179-a5b8-ed82850ea127",
                                                "text": "La mine calcareuse a, en outre, l’inconvénient de rendre le premier laitier ferreux, apte à mazer la fonte et à rendre son expulsion du creuset difficile."
                                            },
                                            {
                                                "example_id": "be934fa5-261c-4b0d-9381-d647f626739a",
                                                "sense_id": "38d249fe-222a-3179-a5b8-ed82850ea127",
                                                "text": "Il existe deux grandes familles de métaux: les métaux ferreux et les métaux non ferreux. Les premiers sont principalement constitués d’acier et de fonte. Les seconds sont plus diversifiés: aluminium, plomb, zinc, cuivre, nickel, etc. Comment les reconnaître? Avec un aimant qui se fixe aux métaux ferreux, comme l’acier de votre réfrigérateur, mais qui ne réagit pas aux métaux non ferreux, comme la canette de boisson gazeuse en aluminium."
                                            },
                                            {
                                                "example_id": "5c421b86-1724-49c0-bcc1-65fe5bccffbf",
                                                "sense_id": "38d249fe-222a-3179-a5b8-ed82850ea127",
                                                "text": "Il se confirme donc que le métal de la dague est fait essentiellement de fer avec entre 10 et 12 % de nickel, ce qui ne se retrouve pas dans le minerai de fer terrestre dans ces proportions mais bien dans les octaédrites, de célèbres météorites ferreuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfad21ef-40b4-313f-9723-bd57eb3453f9",
                                        "entry_id": "f6f98144-102a-3e86-84e3-dfb77a34bb82",
                                        "glosses": [
                                            "Se dit des composés de fer où le fer est bivalent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee64a4d-9560-4a5f-9191-7f2d10d5c1ec",
                                                "sense_id": "cfad21ef-40b4-313f-9723-bd57eb3453f9",
                                                "text": "L’oxyde ferreux, ou wüstite, a pour formule FeO."
                                            },
                                            {
                                                "example_id": "9ab1fc51-15db-43f9-815a-2fe3fa0cf805",
                                                "sense_id": "cfad21ef-40b4-313f-9723-bd57eb3453f9",
                                                "text": "L'intense activité volcanique allongée sur les dizaines de milliers de kilomètres des dorsales océaniques fournit ce fer dit ferreux (Fe²⁺) soluble dans l'eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cb94c12-6c76-4482-a52c-f71325f7ac83",
                        "source_entry_id": "b33271c3-72ad-3673-88c0-ec95b81271f5",
                        "source_sense_description": "of or containing iron",
                        "target_lang_word": "eisern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eisern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64b09335-dc69-33f7-837d-aa509c5f9c57",
                                        "entry_id": "f69733ff-7320-3f81-b2e8-06f343348249",
                                        "glosses": [
                                            "aus dem Metall Eisen bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5635cae-58b0-488b-bc53-77836747096e",
                                                "sense_id": "64b09335-dc69-33f7-837d-aa509c5f9c57",
                                                "text": "Die Treppe hatte ein eisernes Geländer."
                                            },
                                            {
                                                "example_id": "5a384758-91bb-4168-96a6-89c506875b01",
                                                "sense_id": "64b09335-dc69-33f7-837d-aa509c5f9c57",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen – steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "048fcb9d-3c27-4d3a-9248-c2798f87d9c1",
                                                "sense_id": "64b09335-dc69-33f7-837d-aa509c5f9c57",
                                                "text": "„An Waffen besitzen sie sechs Fuß lange Bogen aus Zedernholz, die an einem Ende mit einer kurzen eisernen Spitze versehen sind und auch als Speere verwendet werden können; die Pfeile haben eiserne, steinerne oder knöcherne Widerhaken.“"
                                            },
                                            {
                                                "example_id": "aee06de5-1bdd-4ea2-8cdd-03140bd76148",
                                                "sense_id": "64b09335-dc69-33f7-837d-aa509c5f9c57",
                                                "text": "„Seit die Kultur vom Kultus abgefallen ist und aus sich selber einen gemacht hat, ist sie denn auch nichts anderes mehr als ein Abfall, und alle Welt ist ihrer nach bloßen fünfhundert Jahren so müd und satt, als wenn sie's, salva venia, mit eisernen Kochlöffeln gefressen hätt...“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2c0b424-cfdf-3d0c-a545-0feb806465ef",
                                        "entry_id": "f69733ff-7320-3f81-b2e8-06f343348249",
                                        "glosses": [
                                            "mit unbeugbarem Willen, fest"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a52957a-d7f0-4103-ac15-8adc3fd1d2f5",
                                                "sense_id": "f2c0b424-cfdf-3d0c-a545-0feb806465ef",
                                                "text": "Er hält eisern an seinem Glauben fest."
                                            },
                                            {
                                                "example_id": "0934b7e3-a94e-4e15-b3b4-9d52359d3303",
                                                "sense_id": "f2c0b424-cfdf-3d0c-a545-0feb806465ef",
                                                "text": "„Den Bediensteten könne man die Pflege nicht übertragen, daran hielt die Mama eisern fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
