                "senses": [
                    {
                        "sense_id": "7840ad3b-4647-3fcb-82f5-0ffc325e5aca",
                        "entry_id": "c68a04f9-b24e-33ca-9878-3202649e36a4",
                        "glosses": [
                            "lekki szynowy pojazd o napędzie spalinowym obsługujący trasy o niewielkiej liczbie podróżnych"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "15707549-b608-4ee0-9fff-cab60fe9f867",
                                "sense_id": "7840ad3b-4647-3fcb-82f5-0ffc325e5aca",
                                "text": "Szynobus jest zwykle pojazdem dwuosiowym o masie ok. 20 ton, z ok. 40-50 miejscami do siedzenia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17bda3e7-980b-4b35-94d3-e1b498b3571a",
                        "source_entry_id": "c68a04f9-b24e-33ca-9878-3202649e36a4",
                        "source_sense_id": "7840ad3b-4647-3fcb-82f5-0ffc325e5aca",
                        "target_lang_word": "railcar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "railcar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9999b3a-1a51-3973-8dcb-580b61b9735f",
                                        "entry_id": "eddf7acb-922e-3744-83af-82076694b263",
                                        "glosses": [
                                            "A self-propelled railway vehicle for passengers, similar to a bus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997f1ae3-5df9-49fc-8f07-ba625ebd9e40",
                                                "sense_id": "b9999b3a-1a51-3973-8dcb-580b61b9735f",
                                                "text": "The semi-streamlined contour of the earlier G.W.R. railcars has been given up in favour of a more utilitarian blunt-nose end, and effective floor space gained thereby."
                                            },
                                            {
                                                "example_id": "0103ee83-4ba9-4b9f-be00-2f1dbee65c82",
                                                "sense_id": "b9999b3a-1a51-3973-8dcb-580b61b9735f",
                                                "text": "Profitable operation is being made possible by the widespread introduction of capacious diesel railcars, which for their comfort and speed are very popular with the travelling public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e358c973-6407-3ee3-9fb6-bc9590ea7559",
                                        "entry_id": "eddf7acb-922e-3744-83af-82076694b263",
                                        "glosses": [
                                            "A powered single railway vehicle designed for passenger transport, with a driver's cab in both ends; Not to be confused with motor coach/motorcar, which is a powered railway vehicle capable to haul a train."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "987cbfb0-91ca-3f89-8d6a-0ea9cc6c7f93",
                                        "entry_id": "eddf7acb-922e-3744-83af-82076694b263",
                                        "glosses": [
                                            "Any unpowered railway vehicle"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "badbef06-481f-4a88-9786-dbcae29fcb48",
                        "source_entry_id": "c68a04f9-b24e-33ca-9878-3202649e36a4",
                        "source_sense_id": "7840ad3b-4647-3fcb-82f5-0ffc325e5aca",
                        "target_lang_word": "diesel multiple unit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diesel multiple unit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4482cea-c5c4-3910-9a21-5ed1cd578045",
                                        "entry_id": "c2344e7a-9cee-33f0-a4c2-485387b6e7c7",
                                        "glosses": [
                                            "A multiple-unit train of two or more coaches powered by diesel engines, usually installed underfloor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a27be2-8f05-4935-8e77-ac705958c8f0",
                                                "sense_id": "b4482cea-c5c4-3910-9a21-5ed1cd578045",
                                                "text": "On January 23, diesel multiple-units began working some of the Marylebone suburban services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27d827f8-c289-4c29-94fd-8db1750dc674",
                        "source_entry_id": "c68a04f9-b24e-33ca-9878-3202649e36a4",
                        "source_sense_id": "7840ad3b-4647-3fcb-82f5-0ffc325e5aca",
                        "target_lang_word": "railbus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "railbus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "188dca1d-a21d-30a6-9531-df40dea3539c",
                                        "entry_id": "63bdfc0a-ba9f-3a9f-a19d-14d74be1d9ff",
                                        "glosses": [
                                            "A lightweight passenger railway vehicle, similar in appearance to a bus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b2a4a5-52fe-45c5-8f30-71dfd3ce4a30",
                                                "sense_id": "188dca1d-a21d-30a6-9531-df40dea3539c",
                                                "text": "They were ruled out as over-engineered and too expensive for mass production, and lost out to Class 141 and '142' railbuses, and then Class 150s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
