    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66d25555-bf8c-3ac8-b1fe-9011baa3fa58",
                    "sense_definition": "Action d'accorder, de distribuer ou d'octroyer un bien, un titre ou un avantage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "octroi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>attribution</w> des logements sociaux se fait selon des critères stricts définis par la commission."
                        },
                        {
                            "text": "Les étudiants attendent avec impatience l'<w>attribution</w> de leurs bourses pour cette année universitaire."
                        }
                    ],
                    "synonyms": [
                        "allocation",
                        "distribution",
                        "octroi"
                    ],
                    "antonyms": [
                        "privation",
                        "retrait"
                    ],
                    "common_phrases": [
                        "attribution d'une bourse",
                        "attribution des logements",
                        "critères d'attribution"
                    ]
                },
                {
                    "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                    "sense_definition": "Ensemble des compétences, des fonctions ou des prérogatives reconnues à une personne ou à une autorité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision ne relève pas de mes <w>attributions</w>, vous devriez plutôt contacter le directeur juridique."
                        },
                        {
                            "text": "Le préfet a exercé ses <w>attributions</w> afin de rétablir l'ordre dans la commune."
                        }
                    ],
                    "synonyms": [
                        "compétence",
                        "fonction",
                        "prérogative"
                    ],
                    "common_phrases": [
                        "attributions légales",
                        "dans mes attributions",
                        "relever des attributions"
                    ]
                },
                {
                    "sense_id": "89b5b9df-812d-36fd-a643-017a410bd536",
                    "sense_definition": "Désignation de l'entreprise ou du candidat retenu lors de la passation d'un marché public ou d'un contrat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "octroi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>attribution</w> du contrat de construction a été contestée devant le tribunal administratif."
                        },
                        {
                            "text": "La commission d'appel d'offres a validé l'<w>attribution</w> du marché à une entreprise locale."
                        }
                    ],
                    "synonyms": [
                        "adjudication"
                    ],
                    "common_phrases": [
                        "attribution du marché",
                        "décision d'attribution"
                    ]
                },
                {
                    "sense_id": "bdadd09a-8a2b-31fb-aa15-f3ddf5302069",
                    "sense_definition": "Action de désigner la personne considérée comme l'auteur d'une œuvre littéraire ou artistique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>attribution</w> de ce tableau ancien à Rembrandt suscite encore de vifs débats parmi les historiens de l'art."
                        },
                        {
                            "text": "De nouveaux documents historiques permettent de confirmer l'<w>attribution</w> de ce poème à un moine du douzième siècle."
                        }
                    ],
                    "synonyms": [
                        "assignation",
                        "paternité"
                    ],
                    "common_phrases": [
                        "attribution d'une œuvre",
                        "contester l'attribution"
                    ]
                },
                {
                    "sense_id": "2a9180d5-0146-3da6-b8db-e7a46e78fdb4",
                    "sense_definition": "Processus par lequel un individu explique des comportements ou des événements en leur assignant des causes internes ou externes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La théorie de l'<w>attribution</w> montre comment les individus justifient leurs échecs par des facteurs extérieurs."
                        },
                        {
                            "text": "Ce chercheur étudie les erreurs d'<w>attribution</w> causale dans les relations interpersonnelles au travail."
                        }
                    ],
                    "common_phrases": [
                        "erreur d'attribution",
                        "théorie de l'attribution"
                    ]
                }
            ]
        }
    ]
