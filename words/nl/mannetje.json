                    "semantic_group_id": "diminutive_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stond een klein <w>mannetje</w> bij de bushalte te wachten.",
                            "target_lang_translations": {
                                "en": "A <w>little man</w> was waiting at the bus stop.",
                                "ru": "На автобусной остановке ждал маленький <w>мужичок</w>.",
                                "pl": "Na przystanku autobusowym czekał mały <w>facet</w>.",
                                "de": "Ein <w>kleiner Mann</w> wartete an der Bushaltestelle.",
                                "fr": "Un <w>petit bonhomme</w> attendait à l'arrêt de bus.",
                                "it": "C'era un piccolo <w>ometto</w> ad aspettare alla fermata dell'autobus.",
                                "cs": "Na autobusové zastávce čekal malý <w>mužíček</w>.",
                                "tr": "Otobüs durağında <w>ufak tefek bir adam</w> bekliyordu.",
                                "es": "Había un <w>hombrecillo</w> esperando en la parada del autobús.",
                                "zh": "有个<w>小个子</w>男人正在公交车站等车。"
                            }
                        },
                        {
                            "text": "Dat kleine <w>mannetje</w> kan al heel hard rennen.",
                            "target_lang_translations": {
                                "en": "That <w>little guy</w> can run very fast already.",
                                "ru": "Этот <w>мальчуган</w> уже умеет очень быстро бегать.",
                                "pl": "Ten mały <w>chłopczyk</w> potrafi już bardzo szybko biegać.",
                                "de": "Das <w>Kerlchen</w> kann schon sehr schnell rennen.",
                                "fr": "Ce <w>petit bonhomme</w> sait déjà courir très vite.",
                                "it": "Quel piccolo <w>ometto</w> sa già correre molto veloce.",
                                "cs": "Ten malý <w>kluk</w> už umí běžet velmi rychle.",
                                "tr": "O <w>küçük adam</w> şimdiden çok hızlı koşabiliyor.",
                                "es": "Ese <w>chaval</w> ya puede correr muy rápido.",
                                "zh": "那个<w>小男孩</w>已经跑得很快了。"
                            }
                        }
