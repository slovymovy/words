                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staysail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2222109d-7a50-3596-aeac-298e9ecda78d",
                                        "entry_id": "c97a5acc-3464-3130-bfcc-ccaa74e0f768",
                                        "glosses": [
                                            "A fore-and-aft rigged sail whose luff can be affixed to a stay running forward from a mast to the deck, the bowsprit or to another mast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73fcf194-51a6-4090-ad8c-7ff8bfc8d499",
                        "source_entry_id": "a82bc908-f5fc-37e4-b0e3-0b2ec5703c1d",
                        "source_sense_id": "2703dfcb-e943-3877-9d9b-f4f8511ffc77",
                        "target_lang_word": "voile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                        "entry_id": "2fdc03d1-16b0-3196-853b-659f83b6618c",
                                        "glosses": [
                                            "Large pièce de tissu assurant la propulsion des navires ou des moulins, par la force du vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46fe1b45-0cb9-467a-969e-ee6e706e97da",
                                                "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                                "text": "Le matelot siffla ses hommes, sur un ordre qu’il leur donna, ils sautèrent tous sur le Saint-Ferdinand, grimpèrent dans les cordages, et se mirent à le dépouiller de ses vergues, de ses voiles, de ses agrès."
                                            },
                                            {
                                                "example_id": "dbffac92-e7ee-401c-b1ed-183d5b89a312",
                                                "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                                "text": "Des barques avec des voiles latines posées en ciseaux descendaient et remontaient le cours du fleuve sous le même vent, phénomène que je n’ai jamais bien compris, quoiqu’on me l’ait expliqué plusieurs fois. Quelques-uns de ces bateaux portaient une troisième petite voile en forme de triangle isocèle, posée dans l’écartement produit par les pointes divergentes des deux grandes voiles : ce gréement est très-pittoresque."
                                            },
                                            {
                                                "example_id": "398b95c0-54c9-478d-bc13-1f3ae68d386c",
                                                "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                                "text": "Pour remettre la machine en mouvement, on dirige d'abord l'arbre moteur dans le sens du vent, puis on écarte les voiles afin de garnir de nouveau les ailes."
                                            },
                                            {
                                                "example_id": "dce9e5c9-9b39-4211-aa92-e20ab7053c0c",
                                                "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                                "text": "Par la fenêtre entr’ouverte, l’air entrait, gonflant comme une voile les rideaux de mousseline, et j’apercevais un pan de ciel bleu."
                                            },
                                            {
                                                "example_id": "9572e89d-7ee1-4ae9-81ed-c60f7a2808cf",
                                                "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                                "text": "Sans cesse sur le pont, ajustant les écoutes de mes voiles pour en obtenir le meilleur rendement, utilisant chaque souffle de vent, j’avais réussi à conserver la vitesse d’à peu près un nœud."
                                            },
                                            {
                                                "example_id": "27fb8652-405b-4200-810d-61a43deed8cb",
                                                "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                                                "text": "Ses voiles délavées par le soleil et la pluie mais qui paraissaient blanches sur le gris du ciel, essayaient. de récupérer les rares frissons de brise pour améliorer la lente progression du bateau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df235d0-0c99-3f9a-bcdb-8bc23995b049",
                                        "entry_id": "2fdc03d1-16b0-3196-853b-659f83b6618c",
                                        "glosses": [
                                            "Bateau à voile."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0cb3d47-a120-4eeb-89b0-fb7bcf3df7ce",
                                                "sense_id": "8df235d0-0c99-3f9a-bcdb-8bc23995b049",
                                                "text": "Cette obscure clarté qui tombe des étoiles,\nEnfin, avec le flux nous fit voir trente voiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5219d121-22a5-3984-a44c-3e1f1db29a5d",
                                        "entry_id": "2fdc03d1-16b0-3196-853b-659f83b6618c",
                                        "glosses": [
                                            "Pratique de la navigation en bateau à voile, nautisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11159210-0241-419a-9b50-a38c680f2dd2",
                                                "sense_id": "5219d121-22a5-3984-a44c-3e1f1db29a5d",
                                                "text": "La voile, il n’y a rien de mieux pour se détendre ! J’en ai fait toute la fin de semaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2684e1-3350-3899-8c45-a876df8074cb",
                                        "entry_id": "2fdc03d1-16b0-3196-853b-659f83b6618c",
                                        "glosses": [
                                            "Train de bois flotté sur les rivières de l'est de la France."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "voile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38c26b4a-0861-374b-8122-daf1b4d54091",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Pièce de toile ou d’étoffe destinée à couvrir, à protéger, à cacher quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1ef55c-37f6-4e41-8b7b-454b5a96fdc6",
                                                "sense_id": "38c26b4a-0861-374b-8122-daf1b4d54091",
                                                "text": "L’homme, historiquement parlant, a accumulé contre sa compagne tout ce qu’il a pu imaginer de duretés et d’incapacités. Il en a fait une captive, il l’a couverte d’un voile et cachée à l’endroit le plus secret de sa maison, comme une divinité malfaisante ou une esclave suspecte."
                                            },
                                            {
                                                "example_id": "7712b743-f17f-4a00-9661-e71e3b8e5534",
                                                "sense_id": "38c26b4a-0861-374b-8122-daf1b4d54091",
                                                "text": "Ce pays qu’il aimait lui sembla tout nouveau, comme si un voile, qui l’eût recouvert jusqu’ici, eût été brusquement retiré."
                                            },
                                            {
                                                "example_id": "f5a12da8-6e34-48b8-80fe-a4e452dae52d",
                                                "sense_id": "38c26b4a-0861-374b-8122-daf1b4d54091",
                                                "text": "Mais depuis deux ans, l’Égypte s’est transformée. La plupart des femmes, les jeunes surtout, ne se croient plus obligées de porter le voile."
                                            },
                                            {
                                                "example_id": "e938a637-88cb-49ae-8fde-b6ef660a5b1d",
                                                "sense_id": "38c26b4a-0861-374b-8122-daf1b4d54091",
                                                "text": "Les vierges arabes nous sont inconnues comme les femmes antiques, et le voile qui les recouvre vaut la pierre du tombeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b75b88a-2d79-3e6c-931a-c3f812c29459",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Partie du costume des religieuses qui couvre la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f5de06-6dc1-454a-8d68-74e2afde099f",
                                                "sense_id": "2b75b88a-2d79-3e6c-931a-c3f812c29459",
                                                "text": "Et le silence revint brusquement tandis que les filles chuchotaient que le diable avait pris une novice pour l'emporter avant qu'elle ait pu mettre ses voiles blancs."
                                            },
                                            {
                                                "example_id": "75694000-f9dc-4660-93ad-920867661bd7",
                                                "sense_id": "2b75b88a-2d79-3e6c-931a-c3f812c29459",
                                                "text": "Il se trouva ainsi, d’après les lois de l’église, coupable d’un double sacrilège, comme bigame, et comme mari d’une femme qui avait reçu le voile de religieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4130284-829b-3a89-a473-b51f479a5d63",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Tissu léger et croisé, analogue à celui dont on fait le voile des religieuses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab1faddd-8da3-4d97-8a25-9ffdf2c2d7cb",
                                                "sense_id": "d4130284-829b-3a89-a473-b51f479a5d63",
                                                "text": "Une robe en voile de soie, de laine ou de coton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da364aab-c7c7-3bdf-9739-b26e7199677a",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Obstacle qui altère la vue ou la vision."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a5ca1f-2dfa-48a2-8d52-8eb69c508eb6",
                                                "sense_id": "da364aab-c7c7-3bdf-9739-b26e7199677a",
                                                "text": "Vers le soir, nous commençons à distinguer des formes vagues qui se dessinent derrière le voile de brume."
                                            },
                                            {
                                                "example_id": "564f813b-41a7-43fc-92b9-d6431d067c2a",
                                                "sense_id": "da364aab-c7c7-3bdf-9739-b26e7199677a",
                                                "text": "Un voile de nuages embrumait la perspective des rues et des squares, et le roulis de l’aéronef balançait le spectacle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cde4213-e409-3ce5-9bdf-bd74f2bc1752",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Apparence, prétexte, moyen dont on se sert pour cacher une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b26160d5-4358-4b4f-80f8-29094e688144",
                                                "sense_id": "7cde4213-e409-3ce5-9bdf-bd74f2bc1752",
                                                "text": "Ces catastrophes ne sont pas seulement industrielles, elles signalent aussi de profondes défaillances dans l’action des gouvernements, qui préfèrent ensuite recouvrir pudiquement ces désastres du voile de l’oubli."
                                            },
                                            {
                                                "example_id": "91eb38bc-209a-4668-9b9f-7ee10bc1d483",
                                                "sense_id": "7cde4213-e409-3ce5-9bdf-bd74f2bc1752",
                                                "text": "Un scélérat qui se couvre du voile de la piété, de la dévotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b9acb46-3aac-3b94-932a-72e3f8e0648d",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Ce qui nous dérobe la connaissance de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c906d2-15cf-4ed0-8890-70a46bd96979",
                                                "sense_id": "3b9acb46-3aac-3b94-932a-72e3f8e0648d",
                                                "text": "Lever un coin du voile qui nous cache les secrets de nature."
                                            },
                                            {
                                                "example_id": "b5f70c7c-7568-4fbf-a068-401c0727f33e",
                                                "sense_id": "3b9acb46-3aac-3b94-932a-72e3f8e0648d",
                                                "text": "Nul ne sut jamais bien l’histoire du vieux Job, et lui-même semble vouloir laisser sa vie passée sous le voile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e1c45f-bf41-3737-80e5-7baa206e7bca",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Obscurcissement d’une partie ou de la totalité du négatif, dû à l’action accidentelle d’une lumière trop grande."
                                        ],
                                        "tags": [
                                            "Argentique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021a7cea-93fa-4d28-ac21-2a8adc27418b",
                                                "sense_id": "f3e1c45f-bf41-3737-80e5-7baa206e7bca",
                                                "text": "Il y a un voile sur cette photographie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d7780d-a238-3498-8dd0-f5fd13ad6240",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Trouble, apparence matte ou laiteuse d’une matière normalement transparente et lisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ea30df-8d03-4301-a283-11d93f18d364",
                                                "sense_id": "20d7780d-a238-3498-8dd0-f5fd13ad6240",
                                                "text": "Vos verres ont l’air un peu ternes après quelques passages au lave-vaisselle. Un voile gris les recouvre. Voici comment s’en débarrasser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "800588db-28a4-3cd4-8204-9a9ce43486b9",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Cloison membraneuse située en arrière de la voûte du palais et qui contribue à séparer la bouche des fosses nasales ou du pharynx."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec100d1-df83-462b-bc0f-05b43dcda8f9",
                                                "sense_id": "800588db-28a4-3cd4-8204-9a9ce43486b9",
                                                "text": "Puis je presserai la groseille contre le voile du palais, et je ne serai défigurée ni par des convulsions, ni par une posture ridicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02515e79-5cf5-3b6e-acd1-d912066d68ae",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Type de voûte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2d81b9-478a-4016-b620-fbfec7d26b95",
                                                "sense_id": "02515e79-5cf5-3b6e-acd1-d912066d68ae",
                                                "text": "Le remarquable voile mince du berceau segmentaire de la nef (de moins de cinq centimètres d’épaisseur) et les voûtes transversales des bas-côtés reposent sur 32 colonnes (de 11 mètres de hauteur pour 43 cm de diamètre) dont la gracilité, le profil galbé et cannelé et la nudité contribuent amplement à l’harmonie aérienne de l’espace intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c8446e-61f4-312c-a6de-56dc51d4e7f3",
                                        "entry_id": "d9c99e5b-d52d-3bf4-8acd-50eca6600b4c",
                                        "glosses": [
                                            "Partie centrale de la jante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faaf848e-a8a4-401c-abfd-cc347012474e",
                                                "sense_id": "41c8446e-61f4-312c-a6de-56dc51d4e7f3",
                                                "text": "Jante à voile plein, à voile ajouré."
                                            }
                                        ]
                                    }
                                ]
