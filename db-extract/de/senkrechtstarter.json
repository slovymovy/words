                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef47d1d-5840-450b-ade0-7acbe77e84b8",
                                "sense_id": "fa9a0790-ec28-353e-82c8-7942983732cf",
                                "text": "„Minister Strauß wie der Inspekteur Kammhuber hatten zu Beginn der 60er Jahre offenbar etwas voreilig geglaubt, dass sich ein Senkrechtsarter recht rasch entwickeln und bauen lasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "631663ff-c539-34e3-912a-c91233981c6b",
                        "entry_id": "d3d24d99-cae2-31ea-bd94-ba875fd5b01d",
                        "glosses": [
                            "Person, die mit etwas beginnt und sofort großen Erfolg hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c158cad4-e7ad-4a42-9504-7dbb6bf1adac",
                                "sense_id": "631663ff-c539-34e3-912a-c91233981c6b",
                                "text": "„Schon am zweiten Spieltag konnte Benjamin Henrichs von Bayer Leverkusen unter Beweis stellen, warum er das Potenzial zum Senkrechtstarter der Saison hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
