                "senses": [
                    {
                        "sense_id": "ced04797-f93a-31fa-a886-d15c29f0d798",
                        "entry_id": "82de537f-5a4a-368d-b948-fdf367bc2640",
                        "glosses": [
                            "Exercice d’agilité ou d’acrobatie, exécuté soit au trapèze, soit sur une corde lâche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0dc74cd7-61df-34e1-9fea-80b1f84df2bd",
                        "entry_id": "82de537f-5a4a-368d-b948-fdf367bc2640",
                        "glosses": [
                            "Exercice exécuté sur un cheval nu ou portant une selle spéciale."
                        ],
                        "tags": [
                            "Manège"
                        ],
                        "examples": [
                            {
                                "example_id": "235f47e3-fcec-43c6-a13a-09ff14baa9f7",
                                "sense_id": "0dc74cd7-61df-34e1-9fea-80b1f84df2bd",
                                "text": "– Et la voltige ! T’as pas encore fait d’voltige, toi ? Ni au galop ni d’pied ferme ?"
                            },
                            {
                                "example_id": "1549d7ad-6889-403e-a3e7-7f1c19731dc3",
                                "sense_id": "0dc74cd7-61df-34e1-9fea-80b1f84df2bd",
                                "text": "Cette démonstration unique dans les annales sera complétée par des exhibitions acrobatiques des deux as de la Djiquitovka, Serge et Michel Pakhomoff, rois de la haute voltige à cheval."
                            }
                        ]
                    }
                ],
