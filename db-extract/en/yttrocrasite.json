                        "entry_id": "d159630a-3260-32ca-97f2-1901a38fb9f1",
                        "glosses": [
                            "An oxide of (primarily) titanium and yttrium, with small to moderate amounts of thorium, uranium, cerium, and calcium substituting for some of the yttrium and traces of iron, tungsten, columbium, and tantalum substituting for some of the titanium."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e527eabc-466e-4ae6-92bd-33f6125ad0c1",
                                "sense_id": "011d63a3-410f-3bf4-95f9-94349bd4dc70",
                                "text": "Yttrocrasite, associated with allanite, gadolinite, and fergusonite, occurs as a minor rare earth constituent of the inner intermediate zone."
                            },
                            {
                                "example_id": "3c03b84c-e946-478f-a8e4-185f6e0384fe",
                                "sense_id": "011d63a3-410f-3bf4-95f9-94349bd4dc70",
                                "text": "REE-bearing minerals in these occurrences are allanite, betafite, brannerite, davidite, euxenite, fergusonite, florencite, monazite, polycrase, samarskite, synchysite, thorite, xenotime and yttrocrasite."
                            }
                        ]
                    }
