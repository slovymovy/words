{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52a843d9-d356-3a4a-91f5-9bcc2c7ddc38",
                    "sense_definition": "A claim or piece of evidence that one was elsewhere when an alleged act, typically a crime, took place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect had a solid <w>alibi</w> because he was at work during the robbery.",
                            "target_lang_translations": {
                                "ru": "У подозреваемого было твердое <w>алиби</w>, так как во время ограбления он был на работе."
                            }
                        },
                        {
                            "text": "The police are currently working to <w>prove</w> <w>an</w> <w>alibi</w> provided by the witness.",
                            "target_lang_translations": {
                                "ru": "Полиция в настоящее время работает над тем, чтобы <w>подтвердить</w> <w>алиби</w>, предоставленное свидетелем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prove an alibi",
                        "solid alibi",
                        "watertight alibi",
                        "fake alibi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доказательство того, что обвиняемый или подозреваемый в момент совершения преступления находился в другом месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алиби",
                                "target_lang_sense_clarification": "юридическое доказательство непричастности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a9edc19-95e5-3fb6-a700-e5fb380bb7c3",
                    "sense_definition": "An excuse, especially one used to avoid responsibility or blame for a mistake or failure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always has a <w>convenient</w> <w>alibi</w> for why he is late to every meeting.",
                            "target_lang_translations": {
                                "ru": "У него всегда есть удобное <w>оправдание</w> тому, почему он опаздывает на каждую встречу."
                            }
                        },
                        {
                            "text": "Stop making <w>alibis</w> and just admit that you forgot to finish the report.",
                            "target_lang_translations": {
                                "ru": "Хватит искать <w>отговорки</w> и просто признай, что забыл закончить отчет."
                            }
                        }
                    ],
                    "synonyms": [
                        "excuse",
                        "pretext"
                    ],
                    "common_phrases": [
                        "convenient alibi",
                        "lame alibi"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to mean any excuse"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оправдание или предлог, используемые для того, чтобы избежать ответственности или вины за ошибку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "причина, объясняющая проступок"
                            },
                            {
                                "target_lang_word": "отговорка",
                                "target_lang_sense_clarification": "неубедительное оправдание"
                            },
                            {
                                "target_lang_word": "предлог",
                                "target_lang_sense_clarification": "вымышленная причина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e794dca7-b658-3cb6-bc47-046ea69971af",
                    "sense_definition": "To provide a legal defense or evidence that someone was elsewhere during a crime.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His brother agreed to <w>alibi</w> him by claiming they were together all night.",
                            "target_lang_translations": {
                                "ru": "Его брат согласился <w>обеспечить</w> <w>ему</w> <w>алиби</w>, заявив, что они были вместе всю ночь."
                            }
                        },
                        {
                            "text": "The defense lawyer tried to <w>alibi</w> the defendant using security camera footage.",
                            "target_lang_translations": {
                                "ru": "Адвокат пытался <w>подтвердить</w> <w>алиби</w> подсудимого, используя записи с камер видеонаблюдения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать юридическое доказательство того, что кто-то находился в другом месте во время преступления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеспечивать алиби",
                                "target_lang_sense_clarification": "подтверждать непричастность"
                            },
                            {
                                "target_lang_word": "подтверждать алиби",
                                "target_lang_sense_clarification": "свидетельствовать в пользу защиты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47665c27-4ee6-38d2-b7cf-e802593d1b93",
                    "sense_definition": "To provide an excuse or justification for someone's actions or failures.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "excuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>alibi</w> her friend's poor behavior by mentioning his recent stress.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>оправдать</w> плохое поведение своего друга, упомянув его недавний стресс."
                            }
                        },
                        {
                            "text": "You cannot <w>alibi</w> your way out of this situation any longer.",
                            "target_lang_translations": {
                                "ru": "Вы больше не сможете <w>выкрутиться</w> из этой ситуации с помощью оправданий."
                            }
                        }
                    ],
                    "synonyms": [
                        "excuse",
                        "justify"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage of the verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять оправдание или обоснование чьих-либо действий или неудач."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "находить объяснение поведению"
                            },
                            {
                                "target_lang_word": "выгораживать",
                                "target_lang_sense_clarification": "защищать от обвинений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}