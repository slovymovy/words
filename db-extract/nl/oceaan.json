                                "example_id": "c8558edf-4fe0-4f1d-9de0-8d5ea84f47db",
                                "sense_id": "e8d45fe4-6272-3cd8-8ebf-93716d4ba264",
                                "text": "Europa en Amerika zijn van elkaar gescheiden door een grote oceaan.",
                                "translation": "Europe and America are separated from each other by a large ocean.",
                                "english": "Europe and America are separated from each other by a large ocean."
                            },
                            {
