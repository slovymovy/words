                                "target_senses": [
                                    {
                                        "sense_id": "d2c468d3-c334-3217-9745-c02b51d206ea",
                                        "entry_id": "e384c96c-fa27-37ba-ac27-d72428359eb8",
                                        "glosses": [
                                            "Having excellence through inspiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf60cc8-2bf8-41e4-b192-c62ffad521d4",
                                                "sense_id": "d2c468d3-c334-3217-9745-c02b51d206ea",
                                                "text": "The actor's inspired performance of Hamlet's soliloquy left the audience dumbfounded."
                                            },
                                            {
                                                "example_id": "95e0add4-3759-43ea-bb96-8e2e169218b7",
                                                "sense_id": "d2c468d3-c334-3217-9745-c02b51d206ea",
                                                "text": "New Zealand were crowned world champions for the first time in 24 years after squeezing past an inspired France team by a single point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04a9a226-ab51-3ee1-a19f-9e06c7c0b1c9",
                                        "entry_id": "e384c96c-fa27-37ba-ac27-d72428359eb8",
                                        "glosses": [
                                            "Filled with inspiration or motivated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a98555-95f2-4678-b993-16e1699898d3",
                                                "sense_id": "04a9a226-ab51-3ee1-a19f-9e06c7c0b1c9",
                                                "text": "The artist was inspired to paint a true masterpiece."
                                            },
                                            {
                                                "example_id": "818b1d5f-a155-4a51-8b5a-e9c60fa1ae91",
                                                "sense_id": "04a9a226-ab51-3ee1-a19f-9e06c7c0b1c9",
                                                "text": "He was inspired to learn to fly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df1f748-4ab3-3327-b8b7-7fdb3e13afd3",
                                        "entry_id": "e384c96c-fa27-37ba-ac27-d72428359eb8",
                                        "glosses": [
                                            "Infused with power or knowledge granted from a supernatural entity; possessing inspiration from the divine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bf9e8e-e0c0-4bb6-908b-745b8fbd7a7d",
                                                "sense_id": "7df1f748-4ab3-3327-b8b7-7fdb3e13afd3",
                                                "text": "Korean shamans are thought to be capable of inspired speech, in which they convey the words of the gods."
                                            },
                                            {
                                                "example_id": "0235b41e-385f-4111-a70f-b720f513f96d",
                                                "sense_id": "7df1f748-4ab3-3327-b8b7-7fdb3e13afd3",
                                                "text": "The point which I wish to establish is this, that the whole prediction of the future establishment of the religion of the Gospel was an inspired prediction, a prediction answerable to the highest test of a supernatural prescience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "285b64cc-db2c-36d2-a20f-054c06a69e8c",
                                        "entry_id": "e384c96c-fa27-37ba-ac27-d72428359eb8",
                                        "glosses": [
                                            "Drawn into the lungs; inhaled."
                                        ],
                                        "tags": [
                                            "of air"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc2581eb-00ca-3885-92d4-84daf926ba63",
                                        "entry_id": "e384c96c-fa27-37ba-ac27-d72428359eb8",
                                        "glosses": [
                                            "Inflated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "inspired",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a222d89-b821-34d6-8c6c-51d7399757aa",
                                        "entry_id": "5b5dfa76-954c-3035-aeaa-be82e9c24798",
                                        "glosses": [
                                            "simple past and past participle of inspire."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0737296-88d4-4498-8e5c-15564fa26df3",
                                                "sense_id": "2a222d89-b821-34d6-8c6c-51d7399757aa",
                                                "text": "Government-inspired rumors"
                                            },
                                            {
                                                "example_id": "cd0b68da-4b38-4188-8016-4f547edefad2",
                                                "sense_id": "2a222d89-b821-34d6-8c6c-51d7399757aa",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
