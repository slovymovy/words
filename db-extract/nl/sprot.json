                                    {
                                        "sense_id": "2343c254-b2e5-35ff-9737-844aa067cf86",
                                        "entry_id": "af24bf86-151a-394e-ba34-26df4a3e64ca",
                                        "glosses": [
                                            "A sixpence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24221c30-f5ca-4377-a57e-1bdc09948321",
                                                "sense_id": "2343c254-b2e5-35ff-9737-844aa067cf86",
                                                "text": "The price of a case (five shillings piece bad) from the smasher is about one shilling; an alderman (two and sixpence) about sixpence; a peg (shilling) about threepence; a downer or sprat (sixpence) about twopence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sprat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c20e4d69-1d44-3fdc-a7d5-c3c3d47d5d01",
                                        "entry_id": "048af37a-0afc-3019-9cec-d0a73dd986fb",
                                        "glosses": [
                                            "To manure (land) with sprats (the fish)."
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6230763d-4edc-4eb6-bcc0-2f49caddf7a5",
                                                "sense_id": "c20e4d69-1d44-3fdc-a7d5-c3c3d47d5d01",
                                                "text": "[…] spratting the land. This treatment is supplemented by about half a ton of artificial manure, largely made up of a mixture of superphosphate and some nitrogenous manure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16c59fef-f966-4089-80df-60df986180ec",
                        "source_entry_id": "483de050-c57c-3657-bf5d-7dd643abe09e",
                        "source_sense_id": "6ba8c645-40c9-3f6b-9f7e-48f6e63d64c8",
                        "source_sense_description": "Sprattus sprattus",
                        "target_lang_word": "sprat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0d4674-8a35-3a9d-86f4-e3fd716cf2f2",
                                        "entry_id": "b4cd46de-4453-344f-b7c5-6590fa8a4d2a",
                                        "glosses": [
                                            "Espèce de petit poisson osseux au dos bleuté et au ventre argenté de dix à quinze centimètres de long et qui ressemble à un jeune hareng."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c51ca9-91f8-496a-bfdd-36a8b4c3e86c",
                                                "sense_id": "ac0d4674-8a35-3a9d-86f4-e3fd716cf2f2",
                                                "text": "Elle leur servirait du thé, du véritable thé de Chine, du Su-Song, dont un marin ami la pourvoyait régulièrement, des muffins, du cake chaud et des sprats en daube, une spécialité de la maison."
                                            },
                                            {
                                                "example_id": "0f92325b-e481-4c78-81db-06a20cc5c45c",
                                                "sense_id": "ac0d4674-8a35-3a9d-86f4-e3fd716cf2f2",
                                                "text": "Au temps où on trouvait du poisson à foison, on pêchait dans la Tamise la blanchaille – terme générique pour les jeunes et petits poissons –, le sprat – appelé aussi menuise ou blanquette – et même le hareng."
                                            },
                                            {
                                                "example_id": "5feeac55-58b1-4074-b66b-e10a65cd8879",
                                                "sense_id": "ac0d4674-8a35-3a9d-86f4-e3fd716cf2f2",
                                                "text": "Au cours du 20ᵉ siècle, alors que la Baltique s’eutrophisait, la biomasse et les débarquements de trois espèces de poissons (la morue (Gadus morhua), le hareng et le sprat (Sprattus sprattus)) ont augmenté et la biomasse des mammifères marins (phoques (Halichoerus grypus, Phoca hispida), marsouins communs (Phocoena phocoena)) a diminué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
