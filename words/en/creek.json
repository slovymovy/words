                {
                    "sense_id": "e972bdc2-9350-34fe-aee9-935845a939d2",
                    "sense_definition": "A stream of water, typically smaller than a river.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children jumped across the shallow <w>creek</w> in the woods.",
                            "target_lang_translations": {
                                "ru": "Дети перепрыгнули через мелкий <w>ручей</w> в лесу.",
                                "zh": "孩子们跳过了树林里那条浅浅的<w>小溪</w>。",
                                "es": "Los niños saltaron sobre el <w>arroyo</w> poco profundo en el bosque.",
                                "tr": "Çocuklar ormandaki sığ <w>dereyi</w> atlayarak geçtiler.",
                                "de": "Die Kinder sprangen über den flachen <w>Bach</w> im Wald."
                            }
                        },
                        {
                            "text": "We walked along the <w>creek</w> bed looking for interesting stones.",
                            "target_lang_translations": {
                                "ru": "Мы шли по руслу <w>ручья</w> в поисках интересных камней.",
                                "zh": "我们沿着<w>小溪</w>的河床走，寻找有趣的石头。",
                                "es": "Caminamos a lo largo del lecho del <w>arroyo</w> buscando piedras interesantes.",
                                "tr": "İlginç taşlar arayarak <w>dere</w> yatağı boyunca yürüdük.",
                                "de": "Wir gingen das <w>Bachbett</w> entlang und suchten nach interessanten Steinen."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream",
                        "brook"
                    ],
                    "common_phrases": [
                        "up the creek",
                        "creek bed",
                        "cross the creek"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America, Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток воды, обычно меньше реки.",
                        "zh": "一种水流，通常比河流小。",
                        "es": "Un curso de agua, generalmente más pequeño que un río.",
                        "tr": "Nehir veya çaydan daha küçük, doğal bir su akıntısı.",
                        "de": "Ein kleiner, natürlicher Wasserlauf, der meist kleiner als ein Fluss ist."
                    },
