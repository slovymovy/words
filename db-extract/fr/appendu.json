                ],
                "senses": [
                    {
                        "sense_id": "f366fa59-5b37-3e0b-bcdf-3d2a539d9152",
                        "entry_id": "b89ed2ce-cb2d-3d7b-86ba-8debf3ac2650",
                        "glosses": [
                            "Qui est attaché, suspendu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1bad7cd-d718-40d3-b236-b53a3574d125",
                                "sense_id": "f366fa59-5b37-3e0b-bcdf-3d2a539d9152",
                                "text": "Des morceaux de ces mêmes poissons, desséchés à la fumée, étaient appendus aux parois, dans une telle profusion, qu’il était impossible qu’il consommât seul toutes ces provisions pendant l’hiver."
                            },
                            {
                                "example_id": "6a6ef447-e3a0-48a1-9aca-0ef37f325047",
                                "sense_id": "f366fa59-5b37-3e0b-bcdf-3d2a539d9152",
                                "text": "M. du Tilleux s’avisa de reconnaître pour son bien un chapeau appendu à la paroi, et, par déduction, les lunettes dont était muni ledit chapeau."
                            }
                        ]
                    },
                    {
                        "sense_id": "b58a9d77-bde0-3978-93be-2530593ea88d",
                        "entry_id": "b89ed2ce-cb2d-3d7b-86ba-8debf3ac2650",
                        "glosses": [
                            "Attaché à la paroi abdominale par un mésentère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e03ec1b-b201-487c-bc1f-43dc5d76060d",
                                "sense_id": "b58a9d77-bde0-3978-93be-2530593ea88d",
                                "text": "… les structures intrapéritonéales, telles que les éléments du tractus gastro-intestinal, sont appendues à la paroi abdominale par les mésentères."
                            }
                        ]
                    }
                ],
