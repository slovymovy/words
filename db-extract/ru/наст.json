                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad29f250-84bb-483a-8d87-7f3bd8492015",
                                                "sense_id": "fdc31fd3-47bf-3fdd-a3da-334e92786334",
                                                "text": "to earn one's crust"
                                            },
                                            {
                                                "example_id": "9b0be0bf-7e9d-42c7-a8fc-a72ff3cbce5a",
                                                "sense_id": "fdc31fd3-47bf-3fdd-a3da-334e92786334",
                                                "text": "Like most of us, I am frequently asked by friends and people I meet in business situations or round the dinner table what I do to earn my crust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec9fc9f-dff1-3871-8031-a5be360709b2",
                                        "entry_id": "3c3303be-c477-3b1e-99bd-e00622ebb820",
                                        "glosses": [
                                            "Nerve, gall."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db52c601-d781-4b3a-8f78-261915f39d6f",
                                                "sense_id": "6ec9fc9f-dff1-3871-8031-a5be360709b2",
                                                "text": "You've got a lot of crust standing there saying that."
                                            },
                                            {
                                                "example_id": "555e2912-7d45-4792-8736-227643aaac71",
                                                "sense_id": "6ec9fc9f-dff1-3871-8031-a5be360709b2",
                                                "text": "“Oh?” she said. “So you have decided to revise my guest list for me? You have the nerve, the – the –” I saw she needed helping out. “Audacity,” I said, throwing her the line. “The audacity to dictate to me who I shall have in my house.” It should have been “whom”, but I let it go. “You have the –” “Crust.” “– the immortal rind,” she amended, and I had to admit it was stronger, “to tell me whom” – she got it right that time – “I may entertain at Brinkley Court and who” – wrong again – “I may not.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99edde60-5293-30ce-81d5-0e4ff7b39080",
                                        "entry_id": "3c3303be-c477-3b1e-99bd-e00622ebb820",
                                        "glosses": [
                                            "The head."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1075d8a0-4536-4b6b-ba21-423b605f95e1",
                                                "sense_id": "99edde60-5293-30ce-81d5-0e4ff7b39080",
                                                "text": "“Well, all I can say is that if yer don't take yer dial outer the road I'll bloomin' well take an' bounce a gibber off yer crust.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1734fbf1-2c41-3b50-ad3e-7b87626c7eb1",
                                        "entry_id": "3c3303be-c477-3b1e-99bd-e00622ebb820",
