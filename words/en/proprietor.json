{
    "word_family": [
        "proprietary",
        "propriety",
        "proprietal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff30efb9-61ef-32a9-ac91-5651aa48a38f",
                    "sense_definition": "A person who owns something, especially a business or property.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proprietor</w> of the small bookstore greets every customer with a warm smile.",
                            "target_lang_translations": {
                                "zh": "这家小书店的<w>店主</w>总是用热情的微笑迎接每一位顾客。"
                            }
                        },
                        {
                            "text": "The new <w>proprietor</w> decided to renovate the entire building to attract more visitors.",
                            "target_lang_translations": {
                                "zh": "新<w>业主</w>决定翻新整栋建筑以吸引更多游客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "owner",
                        "landlord"
                    ],
                    "common_phrases": [
                        "business proprietor",
                        "shop proprietor"
                    ],
                    "target_lang_definitions": {
                        "zh": "拥有某物的人，尤指拥有企业或房产的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "业主",
                                "target_lang_sense_clarification": "指拥有房产或企业的人，常用于商业语境。"
                            },
                            {
                                "target_lang_word": "店主",
                                "target_lang_sense_clarification": "指店铺的拥有者。"
                            },
                            {
                                "target_lang_word": "所有者",
                                "target_lang_sense_clarification": "指对某物拥有所有权的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d95036-63c3-346b-b058-d99397e5ff24",
                    "sense_definition": "A person who is the sole owner of an unincorporated business.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a sole <w>proprietor</w>, she is personally responsible for all the debts of her company.",
                            "target_lang_translations": {
                                "zh": "作为一名<w>独资经营者</w>，她个人需要承担公司所有的债务。"
                            }
                        },
                        {
                            "text": "The tax forms for a sole <w>proprietor</w> are often simpler than those for a large corporation.",
                            "target_lang_translations": {
                                "zh": "<w>独资经营者</w>的税务表格通常比大型企业要简单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "owner"
                    ],
                    "common_phrases": [
                        "sole proprietor"
                    ],
                    "target_lang_definitions": {
                        "zh": "非法人企业的唯一所有者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "独资经营者",
                                "target_lang_sense_clarification": "指个人出资并经营的企业主。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8a9138f-ea26-3e57-84aa-72ffce853675",
                    "sense_definition": "A partner or one of the owners of an unincorporated business.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>proprietor</w> must agree to the new terms before the contract is signed.",
                            "target_lang_translations": {
                                "zh": "在签署合同前，每一位<w>合伙人</w>都必须同意新的条款。"
                            }
                        },
                        {
                            "text": "The business is managed by three <w>proprietors</w> who share the profits equally.",
                            "target_lang_translations": {
                                "zh": "这家企业由三位<w>合伙人</w>共同管理，他们平分利润。"
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "co-owner"
                    ],
                    "target_lang_definitions": {
                        "zh": "非法人企业的合伙人或所有者之一。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合伙人",
                                "target_lang_sense_clarification": "指共同经营企业并分享利润的人。"
                            },
                            {
                                "target_lang_word": "共同所有人",
                                "target_lang_sense_clarification": "指共同拥有某项资产或企业的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "389c601f-66d6-3586-8576-64a044fdadb3",
                    "sense_definition": "A person granted control over a colonial territory, including its administration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king appointed a <w>proprietor</w> to oversee the development of the new overseas colony.",
                            "target_lang_translations": {
                                "zh": "国王任命了一位<w>领主</w>来监督这块新海外殖民地的开发。"
                            }
                        },
                        {
                            "text": "Historical records show that the <w>proprietor</w> held significant power over the early settlement.",
                            "target_lang_translations": {
                                "zh": "历史记录显示，这位<w>领主</w>在早期定居点拥有巨大的权力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical colonial administration."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "被授予殖民地控制权及行政管理权的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "领主",
                                "target_lang_sense_clarification": "指历史上被授予殖民地管辖权的统治者。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}