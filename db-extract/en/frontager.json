                            {
                                "example_id": "49034b53-66bc-4cd3-b8e9-9fd8ae9e468c",
                                "sense_id": "48bc771a-38eb-3dc0-a84c-1f33e5e849b9",
                                "text": "[…] these frontagers were obliged to leave a washway of half-a-mile wide on the west side of the river, so as not to impede the drainage of the country; […]"
