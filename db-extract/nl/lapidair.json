                "translations": [
                    {
                        "translation_id": "5208d15d-08f3-472a-a5ad-18202fe8fed9",
                        "source_entry_id": "a3a81f13-3a41-3065-b205-a7955aa5691d",
                        "target_lang_word": "lapidary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapidary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4706bdec-01b0-36fb-938d-18a6ebd2fd88",
                                        "entry_id": "0230ef3a-6e95-3884-b917-bf5c184c69a8",
                                        "glosses": [
                                            "A person who cuts and polishes, engraves, or deals in gems and precious stones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3331a06-9701-47ad-84c3-845f51b44ed4",
                                                "sense_id": "4706bdec-01b0-36fb-938d-18a6ebd2fd88",
                                                "text": "An excellent lapidary ſet theſe ſtones ſure, / Doe you mark their vvaters?"
                                            },
                                            {
                                                "example_id": "1c83c7a8-d527-4d8f-851f-89971e6162f3",
                                                "sense_id": "4706bdec-01b0-36fb-938d-18a6ebd2fd88",
                                                "text": "[T]he method of eſtimating diamonds is altogether arbitrary; and Ratchkali, vvho vvas an exquiſite lapidary, had ſet it in ſuch a manner as vvould have impoſed upon any ordinary jevveller."
                                            },
                                            {
                                                "example_id": "c0de70c0-f68e-46ea-9f6a-fdf1289eecd5",
                                                "sense_id": "4706bdec-01b0-36fb-938d-18a6ebd2fd88",
                                                "text": "In the very early days of gemstone fashioning, a polisher or lapidary would cut and polish both diamonds and other gemstones. […] Diamonds are now almost exclusively polished by diamond cutting specialists, and all the other gemstones are cut and polished by lapidaries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f33da79-09b5-3ee1-81cb-fba72658b6a3",
                                        "entry_id": "0230ef3a-6e95-3884-b917-bf5c184c69a8",
                                        "glosses": [
                                            "The field in which such a person works, a subfield of gemology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11b3d17e-9b8d-3e51-b5ee-cfa375462b6f",
                                        "entry_id": "0230ef3a-6e95-3884-b917-bf5c184c69a8",
                                        "glosses": [
                                            "An expert in gems and precious stones; a connoisseur of lapidary work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c678dba0-c125-4b9b-bd79-afe22532851c",
                                                "sense_id": "11b3d17e-9b8d-3e51-b5ee-cfa375462b6f",
                                                "text": "Yet as naked as at the firſt bluſh it [the work] ſeemeth, if it ſhall ſtande wyth your Honour his pleaſure (whome I take to be an experte Lapidarie) at vacant houres to inſearche it, you ſhall finde therein ſtones of ſuch eſtimatiõ, as are woorthy to be coucht in riche and precious collets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a57f518-1215-3ee8-8ce3-8c6f87aadb90",
                                        "entry_id": "0230ef3a-6e95-3884-b917-bf5c184c69a8",
                                        "glosses": [
                                            "Gems and precious stones collectively; jewellery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e8183d5-d875-3dc5-9900-f700b2a3b258",
                                        "entry_id": "0230ef3a-6e95-3884-b917-bf5c184c69a8",
                                        "glosses": [
                                            "A treatise on (precious) stones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lapidary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617db1b5-a903-313c-bbce-64f53fdc9d88",
                                        "entry_id": "745d7b3e-9cb4-3966-9666-c659350cff39",
                                        "glosses": [
                                            "Of or pertaining to gems and precious stones, or the art of working them."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d03b5327-d33c-3142-9024-b4a656adb740",
                                        "entry_id": "745d7b3e-9cb4-3966-9666-c659350cff39",
                                        "glosses": [
                                            "Senses relating to inscriptions.",
                                            "Of an inscription: engraved on stone."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b073bd8-2deb-46f3-ac8d-878525a46e0d",
                                                "sense_id": "d03b5327-d33c-3142-9024-b4a656adb740",
                                                "text": "The vvriter of an epitaph ſhould not be conſidered as ſaying nothing but vvhat is ſtrictly true. Allovvance muſt be made for ſome degree of exaggerated praiſe. In lapidary inſcriptions a man is not upon oath."
                                            },
                                            {
                                                "example_id": "3ddeed0d-9804-4614-b8e3-74e5433d8c9f",
                                                "sense_id": "d03b5327-d33c-3142-9024-b4a656adb740",
                                                "text": "He's dead—and upper earth with him has done: / He's buried; save the undertaker's bill, / Or lapidary scrawl, the world is gone / For him, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6dc3d12-1f94-31fd-8585-c59ed2fdd24c",
                                        "entry_id": "745d7b3e-9cb4-3966-9666-c659350cff39",
                                        "glosses": [
                                            "Senses relating to inscriptions.",
                                            "Of a piece of writing or a writing style: characteristic of or suitable for an inscription; embodying the precision and refinement of inscriptions on monuments; concise and stately."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4564b015-94a3-45a1-ba67-8e1d13d6b301",
                                                "sense_id": "a6dc3d12-1f94-31fd-8585-c59ed2fdd24c",
                                                "text": "His grand principle is, that lapidary inscriptions, of what sort soever, should be Historical rather than Lyrical."
                                            },
                                            {
                                                "example_id": "f0b44f5b-97f3-40b9-9650-456e354cd46d",
                                                "sense_id": "a6dc3d12-1f94-31fd-8585-c59ed2fdd24c",
                                                "text": "They were the encouragers of a numismatic and lapidary erudition, elegant in itself, and throwing for ever its little sparks of light on the still ocean of the past, but not very favourable to comprehensive observation, and tending to bestow on an unprofitable pedantry the honours of real learning."
                                            },
                                            {
                                                "example_id": "1c889325-2a29-4852-8231-fb205141b2ee",
                                                "sense_id": "a6dc3d12-1f94-31fd-8585-c59ed2fdd24c",
                                                "text": "A man of the new age, he [René Descartes] would not accept received ideas; the scientist must make his mind a tabula rasa. The sole truth was that supplied by mathematics or by such lapidary propositions as \"What's done cannot be undone,\" which was irrefutably correct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7cefd6e-2e16-3b60-8f57-32a18fcb4f61",
                                        "entry_id": "745d7b3e-9cb4-3966-9666-c659350cff39",
                                        "glosses": [
                                            "Of or pertaining to stones in general."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4c9b92-cd26-42a7-bfc2-a89d01028187",
                                                "sense_id": "f7cefd6e-2e16-3b60-8f57-32a18fcb4f61",
                                                "text": "Yet such is the temper of this world, that, if a grave philosopher, by shaking his fist, and other acts of bravado, should happen to provoke a company of mischievous boys to reply with a shower of stones, people in general suffer their resentment to settle upon the philosopher for his wanton provocation, rather than on the boys for that lapidary style of retort in which their wrath has been trained to express itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad3245ba-42b9-4516-8972-1d2bc77f8387",
                        "source_entry_id": "a3a81f13-3a41-3065-b205-a7955aa5691d",
                        "target_lang_word": "lapidaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapidaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8a85818-621d-3194-a5a1-57d2eea64954",
                                        "entry_id": "bdd7f4c1-9f7c-397f-a9e4-4969f79b634b",
                                        "glosses": [
                                            "Qui a rapport aux pierres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5d7d77-234d-4cbc-98a6-8f01be277393",
                                                "sense_id": "f8a85818-621d-3194-a5a1-57d2eea64954",
                                                "text": "A huit ou neuf cents pieds en arrière du col de Vulkan, une enceinte, couleur de grès, lambrissée d’un fouillis de plantes lapidaires, et qui s’arrondit sur une périphérie de quatre à cinq cents toises, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9987a3b-a81f-3bf7-9c4c-15f61f2ed65e",
                                        "entry_id": "bdd7f4c1-9f7c-397f-a9e4-4969f79b634b",
                                        "glosses": [
                                            "Qui a rapport aux pierres taillées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da24eef1-78a6-4145-82c0-02885b4f2d0c",
                                                "sense_id": "e9987a3b-a81f-3bf7-9c4c-15f61f2ed65e",
                                                "text": "Un ouvrier, un musée lapidaire."
                                            },
                                            {
                                                "example_id": "8428d505-e3c2-4d15-929b-5403d1e2f55f",
                                                "sense_id": "e9987a3b-a81f-3bf7-9c4c-15f61f2ed65e",
                                                "text": "Dans une salle, le visiteur découvre, exposées à flan de muraille ou sous vitrines, de remarquables pièces lapidaires ou d’orfévrerie […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1c8f92-cbc4-3745-9906-a2c804fcfc39",
                                        "entry_id": "bdd7f4c1-9f7c-397f-a9e4-4969f79b634b",
                                        "glosses": [
                                            "Plus particulièrement qui concerne les pierres fines ou précieuses ou leur travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42f9702-e670-4bda-9f2e-56a04074b4b3",
                                                "sense_id": "fa1c8f92-cbc4-3745-9906-a2c804fcfc39",
                                                "text": "Ne me faites pas perdre de temps, j'achève un important mémoire pour la section lapidaire du British Muséum ; je m'étonne que Sir Brassing ne vous l'ait pas dit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0fa69a-1298-37b0-ab2c-7837e36cd89e",
                                        "entry_id": "bdd7f4c1-9f7c-397f-a9e4-4969f79b634b",
                                        "glosses": [
                                            "Inscription lapidaire, inscription gravée sur la pierre, le marbre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "616f1abb-e71f-4902-8f38-c95d22276046",
                                                "sense_id": "3c0fa69a-1298-37b0-ab2c-7837e36cd89e",
                                                "text": "Ces affiches étaient disposées en style lapidaire, à la façon romaine, et les délicats n’eussent rien trouvé à y reprendre."
                                            },
                                            {
                                                "example_id": "658e6389-b647-4ccc-9659-87e43d7ac8e1",
                                                "sense_id": "3c0fa69a-1298-37b0-ab2c-7837e36cd89e",
                                                "text": "Tracez au fronton en lettres lapidaires cette légende, talisman mystérieux qui semble avoir préservé la maison de l’incendie, des boulets et de la ruine : Si Jehova non ædificet domum, frustra laborant qui ædificant eam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4983b5b5-d384-3754-bb11-5c583b096b08",
                                        "entry_id": "bdd7f4c1-9f7c-397f-a9e4-4969f79b634b",
                                        "glosses": [
                                            "Concis, expressif, ciselé ; auquel il n’y a rien à ajouter."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "967dcf17-9ebc-46b7-a949-d0e0d97484ec",
                                                "sense_id": "4983b5b5-d384-3754-bb11-5c583b096b08",
                                                "text": "« C’est encore une occasion gâchée pour sortir de l’impasse des relations russo-américaines qui existe par la faute de Washington », a estimé le ministère russe des Affaires étrangères, dans un communiqué lapidaire."
                                            },
                                            {
                                                "example_id": "6c092674-b90a-4c54-9715-12989278def1",
                                                "sense_id": "4983b5b5-d384-3754-bb11-5c583b096b08",
                                                "text": "Style, formule lapidaire."
                                            },
                                            {
                                                "example_id": "52272e6e-8120-41a8-b375-f8fed96718ae",
                                                "sense_id": "4983b5b5-d384-3754-bb11-5c583b096b08",
                                                "text": "Sur la scène, un bureau a été installé avec le sceau présidentiel. C’est là qu’il signe, sous les applaudissements, une série de décrets présidentiels dont le contenu est résumé de façon lapidaire par un conseiller."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lapidaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c390efb-8335-3a7f-b8dd-84fa266163cd",
                                        "entry_id": "94da7eb3-1896-386f-851f-799010a29c88",
                                        "glosses": [
                                            "Tailleur et polisseur de pierres précieuses et fines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699852b0-855b-4dd5-9f9a-d156707ceed6",
                                                "sense_id": "7c390efb-8335-3a7f-b8dd-84fa266163cd",
                                                "text": "Voilà dix-huit mois que cette pauvre Louise, la fille du lapidaire, est servante chez lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f28ce83e-e81f-39f0-97c3-598737e52043",
                                        "entry_id": "94da7eb3-1896-386f-851f-799010a29c88",
                                        "glosses": [
                                            "Commerçant de ces pierres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fee2465-fb3a-4bfb-9453-31af921779e6",
                                                "sense_id": "f28ce83e-e81f-39f0-97c3-598737e52043",
                                                "text": "Il appréciait les choses avec le sang-froid d’un lapidaire essayant des bijoux de qualité douteuse, et se trompait rarement sur le choix de celles qui méritaient de lui de la peine et du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9431081-8b50-3bd0-928b-d5662a12d7ec",
                                        "entry_id": "94da7eb3-1896-386f-851f-799010a29c88",
                                        "glosses": [
                                            "Traité décrivant les vertus médicinales voire magiques de ces pierres (XIIᵉ et XIIIᵉ siècles)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc6669e0-6318-3744-ba1f-1395f8f2bd0d",
                                        "entry_id": "94da7eb3-1896-386f-851f-799010a29c88",
                                        "glosses": [
                                            "Meule servant à dresser une surface plane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
