                    {
                        "sense_id": "bec98d1b-28bd-36c1-b9fc-5fcff54560d5",
                        "entry_id": "aa6c8165-d16a-3943-a297-2ac083204afa",
                        "glosses": [
                            "Personne qui participe à un panel de population censé être représentatif d’une population globale, en matière d’habitudes de consommation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070bf526-3d6b-4b9b-87f7-a0c28737c929",
                                "sense_id": "bec98d1b-28bd-36c1-b9fc-5fcff54560d5",
                                "text": "De plus, certains hypers se détournent du livre: nous devrons songer à élargir encore plus notre réseau ou à changer de panelliste si cela ne correspond plus à notre force de vente."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff8ebb22-a73b-3be0-bf71-fb7b31a2c9e0",
                        "entry_id": "aa6c8165-d16a-3943-a297-2ac083204afa",
                        "glosses": [
                            "Éléments d’un groupe de spécialistes rassemblés pour exposer leurs points de vue respectifs, sur un sujet donné, devant un auditoire avec lequel des échanges sont prévus."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "13afbff9-c69e-4aa8-87bd-0a00be5817ba",
                                "sense_id": "ff8ebb22-a73b-3be0-bf71-fb7b31a2c9e0",
                                "text": "Certaine agitation panelliste risquait de mettre aux prises les partisans de la « Land League » et ceux du landlordisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8b9d93f-6f38-4476-be55-79f2d98d5cc6",
                        "source_entry_id": "aa6c8165-d16a-3943-a297-2ac083204afa",
                        "target_lang_word": "Diskussionsteilnehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diskussionsteilnehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                        "entry_id": "86ff02d1-1bbe-3637-ac67-45ef991b493e",
                                        "glosses": [
                                            "Person, die sich an einer Diskussion beteiligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b7007d-9a00-47b4-8de3-6e42ff279bd2",
                                                "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                                "text": "„Hauptsächlich forderten die Diskussionsteilnehmer einander aber energisch auf, einander jetzt bitte ausreden zu lassen.“"
                                            },
                                            {
                                                "example_id": "274894f0-f227-45e4-9884-d03a99f179a2",
                                                "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                                "text": "„Die Streitfragen sind meist dieselben. Die Argumente der Diskussionsteilnehmer allerdings auch.“"
                                            },
                                            {
                                                "example_id": "e17c48a5-dd29-418a-800d-6759d448143a",
                                                "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                                "text": "„Die Anregung beflügelte auch andere Diskussionsteilnehmer, die sich an dieser Stelle einen von den Wolfratshauser Apotheken unterhaltenen Heilkräutergarten ausmalten.“"
                                            }
                                        ],
