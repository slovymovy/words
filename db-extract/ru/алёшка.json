                "senses": [
                    {
                        "sense_id": "467e44db-ed6d-3c9a-ad27-3e679ea8ab89",
                        "entry_id": "2137345f-8998-3171-aac6-2b19172dd9c9",
                        "glosses": [
                            "фам. уменьш. к Алёша"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f54370-0db8-4830-854a-7c56a505ecba",
                                "sense_id": "467e44db-ed6d-3c9a-ad27-3e679ea8ab89",
                                "text": "Алёшка много смеялся, рассказывал о своей дочке."
                            },
                            {
                                "example_id": "6afda43e-6cce-492a-8118-93f1c8f80189",
                                "sense_id": "467e44db-ed6d-3c9a-ad27-3e679ea8ab89",
                                "text": "Настя, стоя у двери, качает головой, глядя на Алёшку."
                            },
                            {
                                "example_id": "62a1002e-87d8-4cbd-8364-830f1e5a5005",
                                "sense_id": "467e44db-ed6d-3c9a-ad27-3e679ea8ab89",
                                "text": "Не проехали мы четверти часа, как ямщик, остановив лошадей, передал вожжи Алёшке, неловко выпростал ноги из сиденья и, хрустя большими сапогами по снегу, пошёл искать дорогу."
                            }
                        ]
                    }
                ],
