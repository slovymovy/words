                    {
                        "sense_id": "f38b8359-e8bb-3e5e-8379-4010363803db",
                        "entry_id": "7abb368e-a7c5-312e-906f-1707a94325a5",
                        "glosses": [
                            "To retract a confession."
                        ],
                        "tags": [
                            "ambitransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1c9b7383-1b1d-474d-a721-470ba8b0bc35",
                                "sense_id": "f38b8359-e8bb-3e5e-8379-4010363803db",
                                "text": "'It's no good trying to unconfess what three sessions of Auditing have uncovered. That boy is a devil.'"
                            },
                            {
                                "example_id": "20158bc8-5461-458e-8413-ff2a5a411c55",
                                "sense_id": "f38b8359-e8bb-3e5e-8379-4010363803db",
                                "text": "In the third couplet he confesses his destitution, says straightforwardly what he had said in the first couplet through the negations of irony; he confesses his utter destitution only to unconfess it in the final couplet."
                            },
                            {
                                "example_id": "ccea39e6-7a61-47b3-9be3-489cfe2396c3",
                                "sense_id": "f38b8359-e8bb-3e5e-8379-4010363803db",
                                "text": "Like there's no established ensemble for driving your son's widow home after she's confessed and then unconfessed to his murder."
                            }
                        ]
                    }
                ],
