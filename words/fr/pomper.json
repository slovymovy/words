                {
                    "sense_id": "3b501835-f8fd-3282-baef-373b07faf20d",
                    "sense_definition": "Déplacer, aspirer ou puiser un fluide à l'aide d'une pompe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers doivent <w>pomper</w> l'eau accumulée dans le sous-sol inondé.",
                            "target_lang_translations": {
                                "en": "The firefighters will have to <w>pump out</w> the water that has collected in the flooded basement.",
                                "ru": "Пожарным придётся <w>откачать</w> воду, скопившуюся в затопленном подвале.",
                                "de": "Die Feuerwehrleute müssen das im überfluteten Keller angesammelte Wasser <w>abpumpen</w>.",
                                "es": "Los bomberos deben <w>bombear</w> el agua acumulada en el sótano inundado.",
                                "zh": "消防员必须把被淹地下室里积存的水<w>抽</w>走。"
                            }
                        },
                        {
                            "text": "Il faut <w>pomper</w> plusieurs minutes avant que le carburant n'arrive au moteur.",
                            "target_lang_translations": {
                                "en": "You have to <w>pump</w> for several minutes before the fuel reaches the engine.",
                                "ru": "Нужно <w>качать</w> несколько минут, прежде чем топливо поступит в двигатель.",
                                "de": "Man muss mehrere Minuten <w>pumpen</w>, bevor der Kraftstoff den Motor erreicht.",
                                "es": "Hay que <w>bombear</w> durante varios minutos antes de que el combustible llegue al motor.",
                                "zh": "在燃油到达发动机之前，需要先<w>抽</w>几分钟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aspirer"
                    ],
                    "common_phrases": [
                        "pomper l'eau"
                    ],
                    "target_lang_definitions": {
                        "en": "To move, draw or suck up a fluid using a pump.",
                        "ru": "Перемещать, засасывать или откачивать жидкость с помощью насоса.",
                        "de": "Eine Flüssigkeit mithilfe einer Pumpe bewegen, ansaugen oder abpumpen.",
                        "es": "Mover, aspirar o extraer un fluido con una bomba.",
                        "zh": "用泵移动、吸取或抽出液体。"
                    },
