                                        "entry_id": "1254e122-5a59-38a1-a29d-a641fd1d7c32",
                                        "glosses": [
                                            "Beutelratte, die in Süd- und Mittelamerika vorkommt und Schwimmhäute an den Hinterfüßen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e427bb6-a23f-432d-a8b0-2596f25fabe7",
                                                "sense_id": "a5b7664a-65ec-3af1-93f3-91e3fee42cf7",
                                                "text": "Der Schwimmbeutler oder Yapok (Chironectes minimus) hat sich dem Wasserleben noch besser angepaßt als die Dickschwanzbeutelratte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
