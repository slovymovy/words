    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "424c2b49-5203-3662-93df-e1e4f1452520",
                    "sense_definition": "Present participle and gerund of <w>talk</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>talking</w> to her friend on the phone right now.",
                            "target_lang_translations": {
                                "ru": "Она сейчас <w>разговаривает</w> с подругой по телефону.",
                                "zh": "她现在正在电话里和朋友<w>聊天</w>。"
                            }
                        },
                        {
                            "text": "We were <w>talking</w> about the movie we saw last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>говорили</w> о фильме, который смотрели вчера вечером.",
                                "zh": "我们当时正在<w>谈论</w>昨晚看的那部电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speaking",
                        "chatting",
                        "discussing"
                    ],
                    "antonyms": [
                        "listening"
                    ],
                    "common_phrases": [
                        "talking about",
                        "talking to",
                        "talking with",
                        "stop talking",
                        "start talking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>talk</w>.",
                        "zh": "动词 talk 的现在分词和动名词形式；正在说话、交谈或讨论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговаривать",
                                "target_lang_sense_clarification": "вести беседу, общаться"
                            },
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "произносить слова, сообщать информацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说话",
                                "target_lang_sense_clarification": "用语言表达、开口讲"
                            },
                            {
                                "target_lang_word": "聊天",
                                "target_lang_sense_clarification": "非正式地闲聊、交谈"
                            },
                            {
                                "target_lang_word": "谈论",
                                "target_lang_sense_clarification": "讨论、提及某事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "664d4bde-3fa5-3b63-81d1-049983008204",
                    "sense_definition": "The action of using speech to communicate or engage in conversation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher said that no <w>talking</w> is allowed during the exam.",
                            "target_lang_translations": {
                                "ru": "Учитель сказал, что во время экзамена <w>разговоры</w> запрещены.",
                                "zh": "老师说考试期间不准<w>说话</w>。"
                            }
                        },
                        {
                            "text": "He was too shy to do the <w>talking</w>, so I spoke for him.",
                            "target_lang_translations": {
                                "ru": "Он слишком стеснялся <w>вести разговор</w>, поэтому я говорил за него.",
                                "zh": "他太害羞了不敢<w>发言</w>，所以我替他说了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speech",
                        "conversation",
                        "discussion",
                        "chatting",
                        "speaking"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "no talking",
                        "do the talking",
                        "talking point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие использования речи для общения или участия в разговоре.",
                        "zh": "说话的行为；交谈、发言或言谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговоры",
                                "target_lang_sense_clarification": "процесс общения, часто во множественном числе"
                            },
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "беседа, обсуждение"
                            },
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "неформальное или пустое общение"
                            }
                        ],
                        "zh": [
