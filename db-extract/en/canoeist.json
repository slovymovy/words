                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanoër",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "414d62da-3e0f-3210-b3d0-7d665ee185bf",
                                        "entry_id": "f7fe6fe1-6664-3e1a-87ac-f9beb822816f",
                                        "glosses": [
                                            "iemand die vaart in een kano"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3e3cde-596a-4e3a-886f-83c51c9493b0",
                                                "sense_id": "414d62da-3e0f-3210-b3d0-7d665ee185bf",
                                                "text": "Een speedboot die zaterdag op het Eemskanaal bij Groningen twee kanoërs heeft aangevaren, is er na de aanvaring vandoor gegaan. De bestuurder van de boot kon na een klopjacht worden gepakt. Dat meldt de politie."
                                            },
                                            {
                                                "example_id": "40ba21f4-28de-448a-abf8-a28ab963709a",
                                                "sense_id": "414d62da-3e0f-3210-b3d0-7d665ee185bf",
                                                "text": "„Ik ben opgegroeid langs het water, omdat mijn acht jaar oudere broer Job (nu assistent-bondscoach red.) een goede kanoër was en ik veel ging kijken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88588a99-5b0e-4e55-b174-0ee902b203c3",
