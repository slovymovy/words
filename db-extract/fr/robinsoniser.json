                "senses": [
                    {
                        "sense_id": "c463a80d-d5f0-33ad-bd7f-2767abdd5c2b",
                        "entry_id": "df7861c4-0349-3510-bdb5-40b3bf318d2a",
                        "glosses": [
                            "Vivre en Robinson, à la manière de Robinson Crusoé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71aa038c-9947-4abf-8a11-61c8754aaa20",
                                "sense_id": "c463a80d-d5f0-33ad-bd7f-2767abdd5c2b",
                                "text": "Les quatre premiers types pourraient à leur gré robinsoniser, les deux derniers sont spécifiquement sociaux."
                            },
                            {
                                "example_id": "806f1452-0f8d-4f73-976c-c63e533cbf66",
                                "sense_id": "c463a80d-d5f0-33ad-bd7f-2767abdd5c2b",
                                "text": "Ainsi, nous pérégrinerons d’îlot en îlot sur l’archipel schopenhauerien, sans coloniser les lieux ni robinsoniser."
                            }
                        ]
                    }
