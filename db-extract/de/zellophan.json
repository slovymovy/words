                ],
                "senses": [
                    {
                        "sense_id": "6adfbf45-760f-34f9-bb88-cf09dae9f14d",
                        "entry_id": "7aadf80f-ee17-3b2e-96a9-3be528102b3e",
                        "glosses": [
                            "dünne Kunststofffolie, die glasklar durchsichtig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f2c5cf-771f-42fd-80dd-e3441087d48f",
                                "sense_id": "6adfbf45-760f-34f9-bb88-cf09dae9f14d",
                                "text": "„Er griff in meine Zigarrenkiste, nahm sich eine raus, pellte das Zellophan ab, biß das hintere Ende ab, zückte ein Feuerzeug und rauchte sie an.“"
                            },
                            {
                                "example_id": "f2730dfe-05b4-41e4-9af4-eb4eab57effd",
                                "sense_id": "6adfbf45-760f-34f9-bb88-cf09dae9f14d",
                                "text": "„Er war bis Ulm mein Gast und wurde von einer Dame abgelöst, die mich zunächst mit Schilderungen haarsträubender Verkehrsunfälle unterhielt und mir dann einige Traubenzuckertäfelchen in den Mund schob, von denen sie das Zellophan nur unvollkommen entfernte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83a2bac5-5739-428d-9238-24adcba45651",
                        "source_entry_id": "7aadf80f-ee17-3b2e-96a9-3be528102b3e",
                        "source_sense_id": "6adfbf45-760f-34f9-bb88-cf09dae9f14d",
                        "source_sense_description": "dünne Kunststofffolie, die glasklar durchsichtig ist",
