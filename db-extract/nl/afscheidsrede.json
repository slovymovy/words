                                "sense_id": "aa8e6424-e4cf-3ba3-bd9c-a2eb56a069a0",
                                "text": "Afscheidsrede Arib over Thieme: Soms wat verbeten"
                            },
                            {
                                "example_id": "0c243ee3-02d6-4709-9bb3-ba74cd5de6bd",
