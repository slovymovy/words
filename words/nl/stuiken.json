{
    "word_family": [
        "stuik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5292515d-27c5-3448-aa91-189b3cc5a063",
                    "sense_definition": "plotseling neervallen of in elkaar zakken door een stoot of verlies van evenwicht",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De renners <w>stuiken</w> door de valpartij massaal op het asfalt.",
                            "target_lang_translations": {
                                "fr": "À cause de la chute, les coureurs <w>s'effondrent</w> en masse sur l'asphalte."
                            }
                        },
                        {
                            "text": "Hij kon zijn evenwicht niet bewaren en zag zichzelf voorover <w>stuiken</w>.",
                            "target_lang_translations": {
                                "fr": "Il n'a pas pu garder son équilibre et s'est vu <w>s'écrouler</w> en avant."
                            }
                        }
                    ],
                    "synonyms": [
                        "struikelen",
                        "voorovervallen"
                    ],
                    "common_phrases": [
                        "voorover stuiken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tomber soudainement ou s'effondrer à cause d'un choc ou d'une perte d'équilibre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "s'effondrer",
                                "target_lang_sense_clarification": "tomber brutalement sous l'effet d'un choc ou de la fatigue"
                            },
                            {
                                "target_lang_word": "s'écrouler",
                                "target_lang_sense_clarification": "tomber lourdement, souvent en avant"
                            },
                            {
                                "target_lang_word": "trébucher",
                                "target_lang_sense_clarification": "perdre l'équilibre et tomber"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3739335-67c2-38b2-851e-86462974efef",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>stuik</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>stuiken</w> in het veld waren door de boer netjes opgestapeld.",
                            "target_lang_translations": {
                                "fr": "Les <w>meules</w> dans le champ avaient été soigneusement empilées par le fermier."
                            }
                        },
                        {
                            "text": "Na de oogst bleven er slechts enkele <w>stuiken</w> op het land achter.",
                            "target_lang_translations": {
                                "fr": "Après la récolte, il ne restait que quelques <w>meules</w> sur le terrain."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Pluriel du nom 'stuik', désignant des tas ou des meules (généralement de foin ou de céréales)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "meules",
                                "target_lang_sense_clarification": "tas de foin ou de gerbes de céréales empilés"
                            },
                            {
                                "target_lang_word": "tas",
                                "target_lang_sense_clarification": "amas de choses empilées"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}