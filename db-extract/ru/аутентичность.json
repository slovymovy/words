                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6a7a2c5-2c3a-4f91-aca7-a78a81deaaec",
                        "source_entry_id": "1b32cc54-066a-3701-812d-c56b55afeee6",
                        "source_sense_id": "de7bef7b-69c2-34e0-88ca-792705510766",
                        "target_lang_word": "Authentizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Authentizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                        "entry_id": "e248566f-6147-3347-afa4-7c91016901e9",
                                        "glosses": [
                                            "Eigenschaft einer Sache, Person oder Organisation, authentisch (auf Echtheit geprüft, zuverlässig) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68b8b3f-1432-472c-8cf5-eb114ce516d0",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "Authentizität, so definiert es das Lexikon, bedeutet, dass das Handeln einer Person nicht durch äußere Einflüsse bestimmt wird, sondern in der Person selbst begründet liegt."
                                            },
                                            {
                                                "example_id": "ea00c160-9198-422f-9f88-9a78eb06a312",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "Die Authentizität des Dokuments ist überprüft worden und nicht zu bestreiten."
                                            },
                                            {
                                                "example_id": "cef3e311-eb3c-4b1d-ac38-ce5d11cebc0a",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "„Mitunter stoßen die Fahnder bei dem Procedere auch auf Steuersünder, die sich selbst angezeigt haben - ein Beleg für die Authentizität des Materials.“"
                                            },
                                            {
                                                "example_id": "cbfa7a27-31a2-40c5-a345-6b6edc8a1286",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "In fast allen Lehrplänen und Richtlinien für den Fremdsprachenunterricht können wir den Begriff der Authentizität finden."
                                            },
                                            {
                                                "example_id": "4a5ef6f0-d854-4158-a194-f4f8117d59ca",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "„Die Authentizität der fremden Gäste wird noch durch die Bauart ihrer Wohnung bekräftigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f15409c1-8f19-43ba-89bb-7f34c548a50b",
                        "source_entry_id": "1b32cc54-066a-3701-812d-c56b55afeee6",
                        "source_sense_id": "de7bef7b-69c2-34e0-88ca-792705510766",
                        "target_lang_word": "authenticité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authenticité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b72196e9-229a-3d12-8d8b-45f28902055e",
                                        "entry_id": "37e9b8a8-caa0-331b-bbf2-c06580d7f881",
                                        "glosses": [
                                            "Qualité de ce qui est authentique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea89532b-992e-4c01-9ce1-d57d76eb8ba7",
                                                "sense_id": "b72196e9-229a-3d12-8d8b-45f28902055e",
                                                "text": "Une conclusion est certaine : les universités protègent mal leurs archives. […]. Voila en tout cas un bon motif de réforme de l’université : garantir l’authenticité des diplômes."
                                            },
                                            {
                                                "example_id": "5a26dfcf-ae97-4bf0-872f-80230e127138",
                                                "sense_id": "b72196e9-229a-3d12-8d8b-45f28902055e",
                                                "text": "Bientôt, il entreprit de vastes recherches visant à établir l’authenticité du manuscrit, l’identité de son ou ses auteurs, ainsi que le destin ultérieur de ces lignes manifestement écrites pour être lues à la barre du tribunal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f78b08-4e2d-3595-9c5a-2af2a6a120c9",
                                        "entry_id": "37e9b8a8-caa0-331b-bbf2-c06580d7f881",
                                        "glosses": [
                                            "Pureté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b0d734-3b01-4763-89f1-c08034e4deaf",
                                                "sense_id": "75f78b08-4e2d-3595-9c5a-2af2a6a120c9",
                                                "text": "Les historiens d'aujourd’hui ont entrepris de faire croire que l’authenticité de la philosophie est marquée par un éloignement aussi grand que possible des souillures de l’homme vulgaire […]."
                                            },
                                            {
                                                "example_id": "57b5c1cc-982c-4428-a1cb-2b90fff13f34",
                                                "sense_id": "75f78b08-4e2d-3595-9c5a-2af2a6a120c9",
                                                "text": "L’amour que le poète se plaît à chanter, revêt alors une particulière authenticité à laquelle l’auditeur ne saurait rester indifférent : le jeu grâce auquel cet amour s’exprime, le fait valoir en tant que sentiment et vie, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb658c3-a1ec-3310-a5d1-f8f79080ebba",
                                        "entry_id": "37e9b8a8-caa0-331b-bbf2-c06580d7f881",
                                        "glosses": [
                                            "Vérité absolue et indiscutable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17021341-63c8-40c5-bd23-9df73b0be9ef",
                                                "sense_id": "2eb658c3-a1ec-3310-a5d1-f8f79080ebba",
                                                "text": "Une étape des plus importantes dans cette direction est l’appel des radicaux à l’authenticité, le refus de la modernité, de l’islam apologétique moderniste et le retour de l’islam lui-même à la politique active."
                                            },
                                            {
                                                "example_id": "4afa1fc3-853d-4435-8b05-a1234117ef3e",
                                                "sense_id": "2eb658c3-a1ec-3310-a5d1-f8f79080ebba",
                                                "text": "Le culte de l’ancêtre doit beaucoup à l’intérêt commercial. En se proclamant descendants de l’inventrice du camembert, les petits-enfants de Marie Harel s’attribuaient un label d’authenticité et de tradition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9edcb612-3941-399d-a331-ccd1bdb9a4d6",
                                        "entry_id": "37e9b8a8-caa0-331b-bbf2-c06580d7f881",
                                        "glosses": [
                                            "Caractère de ce qui est identique à soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffb0bce-088b-4eea-8202-9b625dd88188",
                                                "sense_id": "9edcb612-3941-399d-a331-ccd1bdb9a4d6",
                                                "text": "Le line up d'origine est constitué, entre autres, par le guitariste Anthony Stelmaszack et par Fabio Izquierdo qui apporte une touche d’authenticité supplémentaire en jouant de l'harmonica, du washboard et du mélodéon ([…])."
                                            },
                                            {
                                                "example_id": "be840e7a-b4f0-434c-a35a-84f80b95a126",
                                                "sense_id": "9edcb612-3941-399d-a331-ccd1bdb9a4d6",
                                                "text": "Alors que midi approche doucement, les deux autres assesseurs vont bientôt prendre le relais. « On va certainement faire des jeux de société cet après-midi, assure encore Catherine Collot, le temps passera plus vite comme ça. » Il en est ainsi à chaque scrutin électoral à Rivroy-Ripont. Car malgré sa spécificité, la commune tient à préserver son authenticité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
