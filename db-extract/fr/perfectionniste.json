                        "entry_id": "8d5d1402-3274-301a-9b51-bb193660e987",
                        "glosses": [
                            "Qui a tendance à rechercher la perfection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66939af4-c8f3-4c97-bc1e-cf051ae463ce",
                                "sense_id": "c297ca2c-4a83-35d7-a9de-1ebd6345e414",
                                "text": "Les chanceux sont du groupe A, car ils sont considérés comme ordonnés, perfectionnistes, ou du groupe O (donneur universel), dotés de qualités de leaders."
                            },
                            {
                                "example_id": "a2196a24-f26f-4440-b2aa-02bd69dc2993",
                                "sense_id": "c297ca2c-4a83-35d7-a9de-1ebd6345e414",
                                "text": "Perfectionniste dans ses rôles et adepte de son professeur d’art dramatique Stella Adler, qui demandait à ses élèves de « défictionner » la fiction, il apprit à jouer du saxophone pour le film New York, New York, un film musical de Martin Scorsese sorti en 1977."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c24362e-7986-4f62-9521-978f10816d27",
                        "source_entry_id": "8d5d1402-3274-301a-9b51-bb193660e987",
                        "source_sense_id": "c297ca2c-4a83-35d7-a9de-1ebd6345e414",
