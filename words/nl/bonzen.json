{
    "word_family": [
        "bons",
        "gebonk",
        "bonken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6210d2d9-644d-3f7b-bb31-3e3f9078a882",
                    "sense_definition": "het krachtig en snel kloppen van het hart, vaak door spanning of inspanning",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hartslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn hart <w>bonst</w> in zijn keel van de zenuwen voor het examen.",
                            "target_lang_translations": {
                                "en": "His heart is <w>pounding</w> in his throat from nerves before the exam."
                            }
                        },
                        {
                            "text": "Na het rennen voelde ik mijn hart in mijn borstkas <w>bonzen</w>.",
                            "target_lang_translations": {
                                "en": "After running, I felt my heart <w>pounding</w> in my chest."
                            }
                        }
                    ],
                    "synonyms": [
                        "kloppen",
                        "hameren",
                        "jagen"
                    ],
                    "common_phrases": [
                        "hart bonst in keel"
                    ],
                    "target_lang_definitions": {
                        "en": "the powerful and rapid beating of the heart, often due to tension or exertion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pound",
                                "target_lang_sense_clarification": "of the heart beating strongly"
                            },
                            {
                                "target_lang_word": "throb",
                                "target_lang_sense_clarification": "pulsating strongly"
                            },
                            {
                                "target_lang_word": "race",
                                "target_lang_sense_clarification": "beating very fast"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fadfbe56-8135-3565-838b-02e1415a43f0",
                    "sense_definition": "met kracht tegen iets aan slaan, wat een dof en luid geluid veroorzaakt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>bonsden</w> vergeefs met hun vuisten op de zware houten poort.",
                            "target_lang_translations": {
                                "en": "They <w>pounded</w> in vain with their fists on the heavy wooden gate."
                            }
                        },
                        {
                            "text": "Je moet niet zo hard op de deur <w>bonzen</w> als iedereen al slaapt.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>bang</w> so hard on the door when everyone is already asleep."
                            }
                        }
                    ],
                    "synonyms": [
                        "bonken",
                        "beuken",
                        "kloppen",
                        "rammen"
                    ],
                    "common_phrases": [
                        "op de deur bonzen"
                    ],
                    "target_lang_definitions": {
                        "en": "to strike something with force, causing a dull and loud sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pound",
                                "target_lang_sense_clarification": "striking hard and repeatedly"
                            },
                            {
                                "target_lang_word": "bang",
                                "target_lang_sense_clarification": "making a loud noise by hitting"
                            },
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "hitting with a dull sound"
                            },
                            {
                                "target_lang_word": "hammer",
                                "target_lang_sense_clarification": "hitting forcefully as if with a tool"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e316c5b2-5f1f-315c-a6af-9eebbef245dd",
                    "sense_definition": "meervoud van <w>bons</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hoorden luide <w>bonzen</w> op de bovenverdieping die ons wakker maakten.",
                            "target_lang_translations": {
                                "en": "We heard loud <w>thuds</w> on the upper floor that woke us up."
                            }
                        },
                        {
                            "text": "De zware <w>bonzen</w> tegen de muur hielden de buren de hele nacht uit hun slaap.",
                            "target_lang_translations": {
                                "en": "The heavy <w>bangs</w> against the wall kept the neighbors awake all night."
                            }
                        }
                    ],
                    "synonyms": [
                        "klappen",
                        "slagen"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'thud' or 'bang'; loud, heavy sounds of striking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thuds",
                                "target_lang_sense_clarification": "plural of a dull, heavy sound"
                            },
                            {
                                "target_lang_word": "bangs",
                                "target_lang_sense_clarification": "plural of a loud, sharp noise"
                            },
                            {
                                "target_lang_word": "pounds",
                                "target_lang_sense_clarification": "plural of heavy striking sounds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8b346d7-60f4-3d3d-bd94-ddda9207a400",
                    "sense_definition": "meervoud van <w>bonze</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de tempel zagen we verschillende <w>bonzen</w> die in diepe meditatie verzonken waren.",
                            "target_lang_translations": {
                                "en": "In the temple, we saw several <w>bonzes</w> who were lost in deep meditation."
                            }
                        },
                        {
                            "text": "De <w>bonzen</w> dragen traditionele gewaden tijdens de religieuze ceremonie.",
                            "target_lang_translations": {
                                "en": "The <w>monks</w> wear traditional robes during the religious ceremony."
                            }
                        }
                    ],
                    "synonyms": [
                        "monniken"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'bonze'; a term for a Buddhist monk"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bonzes",
                                "target_lang_sense_clarification": "Buddhist monks"
                            },
                            {
                                "target_lang_word": "monks",
                                "target_lang_sense_clarification": "religious practitioners"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}