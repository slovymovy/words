{
    "word_family": [
        "kleefstof",
        "kleverig",
        "klever",
        "vastkleven",
        "plakken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6dec696-9176-3c71-9ce1-130ebe2cd2a1",
                    "sense_definition": "vastzitten aan iets door een plakkerige substantie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adhesie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ineens merkte ze dat er kauwgom aan haar sandaal <w>kleefde</w>.",
                            "target_lang_translations": {
                                "en": "Suddenly she noticed that gum was <w>sticking</w> to her sandal."
                            }
                        },
                        {
                            "text": "De natte bladeren <w>kleven</w> aan de koude ruiten van de auto.",
                            "target_lang_translations": {
                                "en": "The wet leaves <w>cling</w> to the cold windows of the car."
                            }
                        }
                    ],
                    "synonyms": [
                        "plakken"
                    ],
                    "common_phrases": [
                        "aan de vingers kleven"
                    ],
                    "target_lang_definitions": {
                        "en": "to be attached to something by a sticky substance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "to adhere or remain attached"
                            },
                            {
                                "target_lang_word": "cling",
                                "target_lang_sense_clarification": "to hold on tightly or stick to a surface"
                            },
                            {
                                "target_lang_word": "adhere",
                                "target_lang_sense_clarification": "to stick fast to a surface or substance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae61e97-2fda-3eac-a832-e3db0b52d225",
                    "sense_definition": "plakkerig aanvoelen of een klevende eigenschap hebben",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "adhesie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze grondstof <w>kleeft</w> heel erg als je het met je handen aanraakt.",
                            "target_lang_translations": {
                                "en": "This raw material <w>is very sticky</w> when you touch it with your hands."
                            }
                        },
                        {
                            "text": "Mijn handen <w>kleven</w> nog steeds van de zoete limonade die ik heb gemorst.",
                            "target_lang_translations": {
                                "en": "My hands <w>are still sticky</w> from the sweet lemonade I spilled."
                            }
                        }
                    ],
                    "synonyms": [
                        "plakken"
                    ],
                    "target_lang_definitions": {
                        "en": "to feel sticky or have an adhesive quality"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be sticky",
                                "target_lang_sense_clarification": "to have the property of sticking to things"
                            },
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "to cause adhesion when touched"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f460942e-ff3c-3492-929d-c5164a4d20a6",
                    "sense_definition": "iets met een plakmiddel op een oppervlak bevestigen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij plaagt haar vader door kauwgum aan zijn snor te <w>kleven</w>.",
                            "target_lang_translations": {
                                "en": "She teases her father by <w>sticking</w> chewing gum to his mustache."
                            }
                        },
                        {
                            "text": "Ik heb dat etiket opnieuw op de fles <w>gekleefd</w> omdat het losgekomen was.",
                            "target_lang_translations": {
                                "en": "I <w>stuck</w> that label back onto the bottle because it had come loose."
                            }
                        }
                    ],
                    "synonyms": [
                        "plakken",
                        "lijmen"
                    ],
                    "antonyms": [
                        "lossen",
                        "losmaken",
                        "afweken"
                    ],
                    "common_phrases": [
                        "een etiket kleven"
                    ],
                    "target_lang_definitions": {
                        "en": "to attach something to a surface using an adhesive"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "to attach with glue or as if by gluing"
                            },
                            {
                                "target_lang_word": "paste",
                                "target_lang_sense_clarification": "to fasten or stick with paste or glue"
                            },
                            {
                                "target_lang_word": "glue",
                                "target_lang_sense_clarification": "to fasten or join with glue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3188045b-3233-367a-9998-3833e57a44fa",
                    "sense_definition": "gevaarlijk dicht achter een ander voertuig rijden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie gaf de bestuurder een boete omdat hij te lang bleef <w>kleven</w> op de snelweg.",
                            "target_lang_translations": {
                                "en": "The police fined the driver because he kept <w>tailgating</w> for too long on the highway."
                            }
                        },
                        {
                            "text": "Het is erg irritant als mensen op de linkerbaan constant tegen je bumper <w>kleven</w>.",
                            "target_lang_translations": {
                                "en": "It is very annoying when people in the left lane are constantly <w>tailgating</w> you."
                            }
                        }
                    ],
                    "synonyms": [
                        "bumperkleven"
                    ],
                    "common_phrases": [
                        "op de bumper kleven"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de context van bumperkleven"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to drive dangerously close behind another vehicle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tailgate",
                                "target_lang_sense_clarification": "to drive too closely behind another vehicle"
                            },
                            {
                                "target_lang_word": "stick to",
                                "target_lang_sense_clarification": "to stay very close to the vehicle in front"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
