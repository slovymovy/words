                                "target_senses": [
                                    {
                                        "sense_id": "ad70eda4-a188-3637-8a27-32e8ae5dae24",
                                        "entry_id": "bf60231e-5409-3a9d-a3d1-2845390358be",
                                        "glosses": [
                                            "Cannabis, Marihuana"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
