                "senses": [
                    {
                        "sense_id": "4cbf5859-7b25-34c7-8ad4-9fb70d48aa79",
                        "entry_id": "70972039-f7c3-37a5-b081-b654e7623922",
                        "glosses": [
                            "Behandlung, mit der schädliche Stoffe aus dem Körper entfernt werden sollen (Entgiftung)"
                        ],
                        "tags": [
                            "Alternativmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "b1514897-5dcb-41b7-a2d9-d25c4e50ffbe",
                                "sense_id": "4cbf5859-7b25-34c7-8ad4-9fb70d48aa79",
                                "text": "„Getreide ist grundsätzlich nicht basisch. Für eine Entschlackungskur sollten Sie also auf alle Produkte mit Getreide verzichten, zum Beispiel auf Brot und Nudeln.“"
                            },
                            {
                                "example_id": "2c95a39b-3841-472d-8d45-84049933e2cd",
                                "sense_id": "4cbf5859-7b25-34c7-8ad4-9fb70d48aa79",
                                "text": "„Ein weit verbreiteter Irrtum ist laut Restemeyer auch die Annahme, im Körper sammelten sich Schlacken oder Ablagerungen von Stoffwechselprodukten, die von Zeit zu Zeit durch eine ‚Entschlackungskur‘ entfernt werden müssten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
