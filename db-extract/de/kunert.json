                ],
                "senses": [
                    {
                        "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                        "entry_id": "13429efe-ee61-3e37-855e-e16cb99cda0b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f8769a-5e55-4d21-b76b-3c2f60ac796f",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Frau Kunert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "44ffb232-1d11-4107-9efa-c2e4e3b91e84",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Herr Kunert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4d76d6d2-215a-44fb-a101-f8336c45ed32",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Die Kunerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "12afd450-a4c3-48e4-b655-077f16265854",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Der Kunert trägt nie die Schals, die die Kunert ihm strickt."
                            },
                            {
                                "example_id": "1896f9c0-2283-4091-909b-99597d69fe0f",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kunert kommt, geht der Herr Kunert.“"
                            },
                            {
                                "example_id": "7bf77376-5d13-4f26-b5ee-5a6a18dfcb06",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Kunert kommt und geht."
                            },
                            {
                                "example_id": "83f163f8-f270-418b-938e-08b93c2088bd",
                                "sense_id": "2261ad70-aa22-3804-8067-ecc7220af2ff",
                                "text": "Kunerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
