                                        "glosses": [
                                            "A separable verb prefix or a particle that precedes a verb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "473414f3-fa81-357e-b5d6-35221eec2394",
                                        "entry_id": "4ed473bd-8756-3a51-82cb-aee7d32a029c",
                                        "glosses": [
                                            "Any of a class of words in the Chinese language whose function is analogous to the cases, prepositions, and postpositions of other languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f77727de-317d-3dbc-b5e9-5276ebd3a11b",
                                        "entry_id": "4ed473bd-8756-3a51-82cb-aee7d32a029c",
                                        "glosses": [
                                            "A verbal prefix in the Algonquin languages whose function is analogous to the adjective of other languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50d557a6-1df8-4949-9e92-bc23b786772a",
                        "source_entry_id": "fb330586-c596-33af-9738-b382ca1753a3",
                        "source_sense_id": "943c932e-6878-39f0-ac8e-0376ca2fb7bb",
                        "target_lang_word": "préverbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préverbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48d39626-4261-3975-a584-87aef2162de6",
                                        "entry_id": "1139a4e0-a85c-386b-8f23-ba6b22cdeb7a",
                                        "glosses": [
                                            "Préfixe verbal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afdcaae4-dc03-41fd-8fb8-4f429a6cb772",
                                                "sense_id": "48d39626-4261-3975-a584-87aef2162de6",
                                                "text": "L’augment précède la racine du verbe grec et fonctionne comme un préverbe inséparable. Ainsi, dans un verbe composé, l’augment se place après d’éventuels préfixes."
                                            },
                                            {
                                                "example_id": "a9b11246-ca01-4258-903b-3926c6fcc478",
                                                "sense_id": "48d39626-4261-3975-a584-87aef2162de6",
                                                "text": "Par le biais des préverbes, le russe a d’autre part la possibilité de perfectiver un imperfectif, mais cela ne va pas sans modifier le sens du verbe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
