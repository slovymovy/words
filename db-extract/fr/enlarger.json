                        "sense_id": "d7cb0e58-83f6-3301-9291-8fb414885193",
                        "entry_id": "75f534a7-9b95-3f09-bb41-2a7a9eb52d00",
                        "glosses": [
                            "Agrandir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1831d1d-1f6d-429f-a56c-cccb6d6e3407",
                                "sense_id": "d7cb0e58-83f6-3301-9291-8fb414885193",
                                "text": "La route devant le mas sera enlargée et on aura une piste cyclable et pietone pendant cet hiver."
                            },
                            {
                                "example_id": "7abcf45c-ea34-4534-a57e-769a3512ebb2",
                                "sense_id": "d7cb0e58-83f6-3301-9291-8fb414885193",
                                "text": "Il y a de la place pour enlarger et développer selon vos propres idées."
                            },
                            {
                                "example_id": "091e649f-061a-4b60-aece-f39f7899907b",
                                "sense_id": "d7cb0e58-83f6-3301-9291-8fb414885193",
                                "text": "J'ai donc décidé que ma prochaine lubie serait de construire mon aura olfactive; c'est moins cher que de se faire enlarger le pénis, se découperoser le nez, et moins fatigant que d'aller à la salle."
                            },
                            {
                                "example_id": "920a4158-f0bd-4638-8b71-6de3f352426e",
                                "sense_id": "d7cb0e58-83f6-3301-9291-8fb414885193",
                                "text": "Et depuis le début de l'année, le Grand Paris se fait une place au soleil sur Instagram. Découvrez les comptes à suivre pour enlarger votre Paris."
                            },
                            {
                                "example_id": "733236f5-64c5-4210-a39a-577155971659",
                                "sense_id": "d7cb0e58-83f6-3301-9291-8fb414885193",
                                "text": "D'ailleurs, depuis que je l'utilise, ma productivité s'est \"enlargée\" de 142%, et mon lama nain de Papouasie a le poil plus soyeux."
                            }
                        ]
                    }
