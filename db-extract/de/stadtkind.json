                ],
                "senses": [
                    {
                        "sense_id": "8219e0fa-fd12-30bd-8e6c-c01943e22e77",
                        "entry_id": "a0b7ad30-14bf-387a-81eb-3241678e2c72",
                        "glosses": [
                            "ein Kind, das in einer Stadt lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3469ca92-ebaa-4568-b4a6-33bb4b63926c",
                                "sense_id": "8219e0fa-fd12-30bd-8e6c-c01943e22e77",
                                "text": "„In der Manier von Stadtkindern konnten sie stundenlang mit unverbrauchter Neugierde vor dem Borstenvieh hocken, mit dem Stiel einer Schaufel nach ihm stoßen und das grunzende, unlustige Schwein in Bedrängnis bringen.“"
                            },
                            {
                                "example_id": "1f4f7fba-845d-4a37-bbe6-bed4f35fa482",
                                "sense_id": "8219e0fa-fd12-30bd-8e6c-c01943e22e77",
                                "text": "„Man sprach bereits damals davon, wie gesund es für die Stadtkinder sei, wenn sie den Hochsommer auf dem Lande statt auf dem Straßenpflaster verbringen könnten.“"
                            },
                            {
                                "example_id": "246a89fa-0545-448d-bba3-aa309623c351",
                                "sense_id": "8219e0fa-fd12-30bd-8e6c-c01943e22e77",
                                "text": "„Als Stadtkind kannte ich solche Leibchen nicht.“"
                            },
                            {
                                "example_id": "4a41000b-ca86-4b04-97c1-f6d24fe3589f",
                                "sense_id": "8219e0fa-fd12-30bd-8e6c-c01943e22e77",
                                "text": "„Stadtkinder erlernen in ihrem Umfeld eigenartige Fähigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a2828ec-25e6-34eb-85e2-c251bfca6741",
                        "entry_id": "a0b7ad30-14bf-387a-81eb-3241678e2c72",
                        "glosses": [
                            "Person, die in einer Stadt aufgewachsen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e92208f6-1208-4e04-bfba-f60992ca8861",
                                "sense_id": "6a2828ec-25e6-34eb-85e2-c251bfca6741",
                                "text": "Sie war ein Stadtkind und wollte nie auf dem Land leben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
