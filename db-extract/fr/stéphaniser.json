                "senses": [
                    {
                        "sense_id": "e0381b31-ff91-3b50-bcb0-f874f68ef76a",
                        "entry_id": "67da014b-8398-3dcc-8fe1-92fc217ca35c",
                        "glosses": [
                            "Donner un caractère stéphanois ou rappelant Saint-Étienne à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e17f7cb-8d37-4df6-a93f-5913f15cb5d4",
                                "sense_id": "e0381b31-ff91-3b50-bcb0-f874f68ef76a",
                                "text": "Le journal grenoblois modernise l’ancienne imprimerie de La Loire républicaine, trouvée dans la dot de La Dépêche, et s’efforce de stéphaniser son image de marque en se rebaptisant : Loire-Matin."
                            },
                            {
                                "example_id": "b2cb10ee-f912-4ddc-ad6e-edd5929b5015",
                                "sense_id": "e0381b31-ff91-3b50-bcb0-f874f68ef76a",
                                "text": "Visiblement, le marché immobilier \"stéphanise\", globalement."
                            },
                            {
                                "example_id": "a51c371d-f3ce-4f8e-bbb8-5bb05ce7c112",
                                "sense_id": "e0381b31-ff91-3b50-bcb0-f874f68ef76a",
                                "text": "Il faut se rendre à l'évidence, même en région parisienne, le logement, objectivement, ne vaut plus rien, et a été \"stéphanisé\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "57866602-cf26-3169-8380-1f5404adf7a9",
                        "entry_id": "67da014b-8398-3dcc-8fe1-92fc217ca35c",
                        "glosses": [
                            "Muter à Saint-Étienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df8954c-4ea5-40c6-95b6-085a3fae137f",
                                "sense_id": "57866602-cf26-3169-8380-1f5404adf7a9",
                                "text": "La conclusion est : le procureur général est limogé et le procureur de la République est déplacé ! M. SIMONET : Il a été stéphanisé !"
                            }
                        ]
                    }
                ],
