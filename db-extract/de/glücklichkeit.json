                ],
                "senses": [
                    {
                        "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                        "entry_id": "269784ef-9f2d-3e59-93b4-bb405e9786f8",
                        "glosses": [
                            "Eigenschaft, glücklich zu sein; das glückliche Dasein"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d2bdb87b-d8f6-4f76-a5f1-fa28a0c5b399",
                                "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                                "text": "„Wenn ich von dieser Glücklichkeit etwas nach außen geben kann, bekomme ich wieder etwas zurück und dadurch neue Impulse.“"
                            },
                            {
                                "example_id": "f4a8df53-41fd-4556-ae7d-28b89c35b8dd",
                                "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                                "text": "„Wir teilen so viele ähnliche Interessen und Werte, die uns durch die Jahre, die kommen, tragen werden, voller Liebe und Glücklichkeit.““"
                            },
                            {
                                "example_id": "2924b11f-978f-43b8-b408-8098bdbd311e",
                                "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                                "text": "„Meine Woche ist überzogen von Glücklichkeit, das hat damit zu tun, dass ich Becky so nah sein kann.“"
                            },
                            {
                                "example_id": "0ab4d58e-5597-43d2-a1d0-44079be9fd39",
                                "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                                "text": "„Jedes analysierte Land wurde anhand der Glücklichkeit, Lebenserwartung, Verfügbarkeit und Qualität des Gesundheitswesens, der körperlichen Aktivität der Menschen, der Häufigkeit von Sehschwächen und der Werte des Welt-Gesundheits-Index gemessen.“"
                            },
                            {
                                "example_id": "064136ba-1ae1-4827-becc-31cbf0102c14",
                                "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                                "text": "„Ich habe viele Glücklichkeiten durch dich: langsam durch die Strassen gehen und an dich denken.“"
                            },
                            {
                                "example_id": "fd882f01-e61e-4903-989e-98a7a30c55bc",
                                "sense_id": "c2f1ece1-e0fb-311f-9563-c187a9ac247b",
                                "text": "„Das große Unglücklichsein des Augenblicks steht immer in der Nähe der zahllosen Glücklichkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
