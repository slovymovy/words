    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23d52d72-83e5-3073-96ae-4ba388fd3a86",
                    "sense_definition": "Comparative form of <w>sharp</w>: more sharp",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This knife is <w>sharper</w> than the one we used yesterday.",
                            "target_lang_translations": {
                                "fr": "Ce couteau est <w>plus tranchant</w> que celui que nous avons utilisé hier."
                            }
                        },
                        {
                            "text": "The image on the new screen is much <w>sharper</w> than on the old one.",
                            "target_lang_translations": {
                                "fr": "L'image sur le nouvel écran est beaucoup <w>plus nette</w> que sur l'ancien."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative form"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme comparative de « sharp » : plus tranchant, plus aigu ou plus net."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "plus tranchant",
                                "target_lang_sense_clarification": "pour un objet coupant comme un couteau"
                            },
                            {
                                "target_lang_word": "plus net",
                                "target_lang_sense_clarification": "pour une image ou une vision"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d2edb23-5334-3894-8711-2e8d078d0673",
                    "sense_definition": "A person who swindles or cheats others, often as a professional gambler.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criminal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourist was quickly identified as an easy target by the <w>sharpers</w> in the casino.",
                            "target_lang_translations": {
                                "fr": "Le touriste a été rapidement identifié comme une cible facile par les <w>escrocs</w> du casino."
                            }
                        },
                        {
                            "text": "He lost all his money to a group of <w>sharpers</w> who were running a rigged card game.",
                            "target_lang_translations": {
                                "fr": "Il a perdu tout son argent face à un groupe de <w>tricheurs</w> qui organisaient une partie de cartes truquée."
                            }
                        }
                    ],
                    "synonyms": [
                        "chiseler",
                        "spiv"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui escroque ou trompe les autres, souvent un joueur professionnel malhonnête."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "escroc",
                                "target_lang_sense_clarification": "terme général pour un fraudeur"
                            },
                            {
                                "target_lang_word": "tricheur",
                                "target_lang_sense_clarification": "spécifiquement dans le contexte du jeu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cfff8766-aed9-33c8-8aef-e834c2ddd2c9",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a family of <w>Sharpers</w> living in the village.",
                            "target_lang_translations": {
                                "fr": "Les archives historiques mentionnent une famille <w>Sharper</w> vivant dans le village."
                            }
                        },
                        {
                            "text": "Mr. <w>Sharper</w> is the author of the new research paper.",
                            "target_lang_translations": {
