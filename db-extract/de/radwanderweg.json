                "senses": [
                    {
                        "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                        "entry_id": "ba9a14b1-697a-3bd2-9e23-676ea67a11c2",
                        "glosses": [
                            "Weg für Fahrräder, auf dem längere Touren unternommen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc84ae9-fcfe-4130-9157-3ffa2d054cfc",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Durchs Tal der Rezat führt ein Radwanderweg mit zahlreichen Sehenswürdigkeiten und Einkehrmöglichkeiten.“"
                            },
                            {
                                "example_id": "dade100e-acac-40a5-9af2-f8c0d295278b",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "[Günther Knerr] „hat sie entworfen, die Fahrradtour zur Schlacht von Hohenlinden, zusammen mit seinem Sohn Fabian – ein fast 50 Kilometer langer Radwanderweg rund um das ehemalige Schlachtfeld.“"
                            },
                            {
                                "example_id": "a061bb63-6145-4366-afd6-647f3b70eabf",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Startpunkt für den kompletten Radwanderweg ist bei Anreise mit der Bahn Münchberg, flussabwärts, oder Barby, flussaufwärts.“"
                            },
                            {
                                "example_id": "88737e99-3608-4a73-91fe-ce943873c7df",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Höchste Zeit für mich, den Ort [Worpswede] einmal in Augenschein zu nehmen. Praktischerweise liegt er auf dem Radwanderweg ‚Weites Land‘. Von Bremen nach Worpswede ist die Strecke 25 Kilometer lang.“"
                            },
                            {
                                "example_id": "12b3cbcf-42a8-4bd7-aa75-b03b38e61a8e",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Der Elberadweg war jahrelang Deutschlands beliebtester Radwanderweg. 2019 landete er jedoch auf Platz 2. Der Fahrrad-Club ADFC fordert Investitionen.“"
                            },
                            {
                                "example_id": "ecacf544-ba1a-4921-9fee-348a097bf615",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Sogleich geht es links auf den Luther-Tetzel-Weg. Ab hier folgt unsere Tour dem ausgeschilderten Radwanderweg, ein Teil der Strecke verläuft auch über den Radweg Berlin-Leipzig und den Flaeming-Skate.“"
                            },
                            {
                                "example_id": "80a7eac6-b718-4a81-92d1-14efa4c15273",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Warnitz liegt am Radwanderweg Berlin-Usedom. Hier hat sich der Tourismusverein bereits früh auf den Verleih von E-Bikes eingestellt.“"
                            },
                            {
                                "example_id": "013bebe7-204d-4f78-b5e3-c3a34fc35706",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Vom Radwanderweg aus kann man sehr schöne Abstecher nach Penzlin zur Alten Burg mit Hexenkeller bzw. nach Burg Stargard zur sehr sehenswerten Burganlage oder auch einer Sommer-Rodelbahn machen.“"
                            },
                            {
                                "example_id": "a5a0dbc1-5242-4d4a-afdc-9daa4eb25f92",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„Von der Mündung der Unstrut in die Saale, am Naumburger Blütengrund, sind es nur fünf Kilometer bis Bad Kösen, einem netten kleinen Ort mit wieder belebtem Kurbetrieb. Ein gut ausgebauter Radwanderweg, oft direkt am Fluss entlang, führt zu einer der ‚ersten Adresse‘ der deutschen Winzerzunft.“"
                            },
                            {
                                "example_id": "db4b046b-e5f2-4586-ba36-45c525421935",
                                "sense_id": "1aea5714-38d2-37b8-883c-4eee0030a039",
                                "text": "„In der Normandie wurden auf rund 500 km Radwanderwege im Grünen angelegt, sogenannte ‚voies vertes‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
