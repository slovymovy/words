                "senses": [
                    {
                        "sense_id": "dc324f35-f676-38d7-a43a-146c9e79a06d",
                        "entry_id": "8303a254-a236-37af-b819-b1b5ba0e7487",
                        "glosses": [
                            "stiekem, stom, geniepig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7255794c-5d8a-4a29-a422-08282763d901",
                                "sense_id": "dc324f35-f676-38d7-a43a-146c9e79a06d",
                                "text": "Pieter de geniale strafpleiter is een achterbakse hufter die op kantoorsletjes valt."
                            },
                            {
                                "example_id": "c0fbe19d-2468-4287-afd5-ed3456b8e7fe",
                                "sense_id": "dc324f35-f676-38d7-a43a-146c9e79a06d",
                                "text": "Wat een achterbakse streek!"
                            },
                            {
                                "example_id": "a28bc99e-a7e0-4f93-8bfe-dc02fbba5937",
                                "sense_id": "dc324f35-f676-38d7-a43a-146c9e79a06d",
                                "text": "Deel 3 de herrijzenis van Salomé abergel 6 Dode sporen Vandaag heeft Hannah Melger geen geduld. Ze verdringt resoluut haar gedachten aan de naderende ondergang: dertig jaar geleden vertrouwde Johannes Bras haar toe dat een kans als Salomé zich maar zelden voordoet, sindsdien bestond er geen verschil meer tussen het belang van haar eigen werk en Salomé. En nu ze zo plotseling verdwenen was, riskeerde Salomé, die haar zo klakkeloos en achterbaks had laten vallen, niet alleen haar eigen nalatenschap maar ook die van Hannah."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b1f1dfa-e340-4304-b98f-5c25cf6c45d2",
                        "source_entry_id": "8303a254-a236-37af-b819-b1b5ba0e7487",
                        "source_sense_id": "dc324f35-f676-38d7-a43a-146c9e79a06d",
                        "source_sense_description": "stiekem, stom",
                        "target_lang_word": "hinterlistig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinterlistig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e85715f-c1af-37e1-b043-9413591a25d4",
                                        "entry_id": "c4162f5a-7909-320e-a1a9-140313932a16",
                                        "glosses": [
                                            "in der Art und Weise einer Hinterlist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd428bfa-f9cb-4d39-9ffc-0b9a167f6568",
                                                "sense_id": "0e85715f-c1af-37e1-b043-9413591a25d4",
                                                "text": "Die hinterlistigen Streiche von Max und Moritz begeistern immer noch die Kinder."
                                            },
                                            {
                                                "example_id": "d4e0b3b8-5858-4c48-af1c-3659c1200fcf",
                                                "sense_id": "0e85715f-c1af-37e1-b043-9413591a25d4",
                                                "text": "Das ist aber hinterlistig von Eugenio."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77719ea2-8832-46d3-85eb-9a6ae5b73e80",
                        "source_entry_id": "8303a254-a236-37af-b819-b1b5ba0e7487",
