                "senses": [
                    {
                        "sense_id": "9fd269cf-508b-32b6-86d9-d7f88b4e5926",
                        "entry_id": "c1d1bb91-c1c1-39e4-8a41-f1beb105dc0f",
                        "glosses": [
                            "cecha tego, co jest małomówne; cecha tych, którzy są małomówni"
                        ],
                        "tags": [
                            "deadjectival"
                        ],
                        "examples": [
                            {
                                "example_id": "067cdac5-d4f4-4b1b-90dd-764c99e7dc34",
                                "sense_id": "9fd269cf-508b-32b6-86d9-d7f88b4e5926",
                                "text": "A znów Danka Filipiak, która od początku zwróciła jej uwagę swoją poetyczną, tajemniczą małomównością, jak i wysoce uduchowionym wyrazem twarzy po prostu wciąż jeszcze nie dostrzegała, że Cesia istnieje"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dd01c7e-fc13-4fb3-a706-92f02ed29051",
                        "source_entry_id": "c1d1bb91-c1c1-39e4-8a41-f1beb105dc0f",
                        "source_sense_id": "9fd269cf-508b-32b6-86d9-d7f88b4e5926",
                        "target_lang_word": "taciturnity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taciturnity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                        "entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                                        "glosses": [
                                            "The trait of being taciturn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d49795b9-7b66-4fba-bf90-2322cdff9bff",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "Humphries broke out more freely into speech than he had done before, for his usual characteristic was that of taciturnity."
                                            },
                                            {
                                                "example_id": "62eae02b-1cb7-4f6d-a6b8-ff26b138324c",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "Gernois’ cordiality was short-lived. No sooner had they ridden out of sight of Captain Gerard and his men than he lapsed once more into his accustomed taciturnity."
                                            },
                                            {
                                                "example_id": "8479b40c-3207-470c-87a6-40823abb4ba6",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "\"[…]and as Mr. H., with his long purse and his willingness to receive hints, is no bad card in the game, he has been brought up to Abbotsford for a week; his taciturnity has long ago fled, and he is one of the most loquacious Borderers going. […]\""
                                            },
                                            {
                                                "example_id": "cd12764a-3f55-429b-b110-33c179f185b5",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "Once he is back on the bench, will Justice Thomas revert to his usual taciturnity?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90393d21-25b6-3a0e-a4d1-ff5b8b7232ad",
                                        "entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                                        "glosses": [
                                            "Failure to assert a legal right in a way that implies that it is being given up."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e53c784b-5c6f-4b1a-b1cb-17e119aec13e",
                        "source_entry_id": "c1d1bb91-c1c1-39e4-8a41-f1beb105dc0f",
                        "source_sense_id": "9fd269cf-508b-32b6-86d9-d7f88b4e5926",
                        "target_lang_word": "reticence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reticence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                        "entry_id": "ab34c499-0515-3723-b07e-9dc89ec87a06",
                                        "glosses": [
                                            "Avoidance of saying or reluctance to say too much; discretion, tight-lippedness; (countable) an instance of acting in this manner."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895d5e8b-ece1-4535-8fa9-ec55936f2116",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "Even if we do not converse with others, our mutual reticence is experienced as reticence if our attention is not otherwise bound up, but is rather free to alight upon one another and linger or not, because we ourselves are free to pay out our attention in deliberate measures."
                                            },
                                            {
                                                "example_id": "5a79eb05-31e1-49bb-aee5-c4c9f3094675",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "[Y]ou paſſe ouer their teſtimonies, & his whole diſcourſe out of them, with a fraudulent reticence of the particulars, and thinke to be euen with them, making vp by ſcoffing, what you cannot by arguing, [...]"
                                            },
                                            {
                                                "example_id": "125d1225-b68a-48eb-9fc1-fe2b65c8c3b8",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "It must not be numbered among the obliviscences and reticenses of the candid reader, that this man, who had been [...] declared by the head of the Church of Christ, in a public instrument for the instruction and direction of all the faithful, that he was a man of very unsound doctrine, and guilty of many outrages against the holy see, should have been selected and appointed the sole plenipotentiary, delegate, and commissioner, on the part of the Church of Rome, to effect the desirable object of her reunion with the Church of England."
                                            },
                                            {
                                                "example_id": "55f62b32-ec9f-45d9-8a98-615bb7a6410c",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "The painter's absurd fits of jealousy, his wild devotion, his extravagant panegyrics, his curious reticences—he understood them all now, and he felt sorry."
                                            },
                                            {
                                                "example_id": "cc6d9617-8a65-4ee9-a571-d49142bfe05a",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "The greatest egotist has his reticenses. It is only during the sessions of sweet silent thought that a man can summon his soul to judgment."
                                            },
                                            {
                                                "example_id": "ff46fd20-b282-4ca6-bc64-15e15d2b2978",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "He would not give me any further clue. You must not be angry with him, Art, because his very reticence means that all his brains are working for her good. He will speak plainly enough when the time comes, be sure."
                                            },
                                            {
                                                "example_id": "051be96d-8245-47a6-abb0-3b282bd9f255",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "We find the same evasions and reticences and the same trick of producing opinion by reiterated assertion that is successful precisely to the extent to which it avoids rational argument and the danger of awakening the critical faculties of the people."
                                            },
                                            {
                                                "example_id": "ce9ef2d4-c72c-45dc-9a64-bdc991618284",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "That is why I regret that my arguments have not convinced many scholars, as shown by the reticenses of some here present."
                                            },
                                            {
                                                "example_id": "72b29c53-7bad-4465-b598-e60afd888903",
                                                "sense_id": "72831bcc-b7ed-3e4d-a7b0-0f623ef8e4bc",
                                                "text": "But in my own experience, autobiographies have had little lure; repeatedly they assume too much or too little: too much in dreaming that one's own life has greatly influenced the world; too little in the reticences, repressions and distortions which come because men do not dare to be absolutely frank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89304b02-a1d3-3f5d-8559-378e4a5a7c76",
                                        "entry_id": "ab34c499-0515-3723-b07e-9dc89ec87a06",
                                        "glosses": [
                                            "A silent and reserved nature."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87eb587-6c3d-470a-8aa3-004a9a2cef50",
                                                "sense_id": "89304b02-a1d3-3f5d-8559-378e4a5a7c76",
                                                "text": "The determined reticence of Jasper, however, was not to be so approached. Impassive, moody, solitary, resolute, so concentrated on one idea, and on its attendant fixed purpose, that he would share it with no fellow-creature, he lived apart from human life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "048b3aed-0c5d-3652-b486-ac14ea466677",
                                        "entry_id": "ab34c499-0515-3723-b07e-9dc89ec87a06",
                                        "glosses": [
                                            "Followed by of: discretion or restraint in the use of something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8493a3c-9dcb-4a43-9868-1e61e567a4b6",
                                                "sense_id": "048b3aed-0c5d-3652-b486-ac14ea466677",
                                                "text": "This is the reticence of temperament, and we see it in children from quite an early age—those children who are trusted by the servants, and are their favourites in consequence, because they tell no tales; but it is a disposition that may become dangerous unless watched, and that is always liable to degenerate into falsehood."
                                            },
                                            {
                                                "example_id": "0f9d58dc-c327-469e-8900-20b997348d2d",
                                                "sense_id": "048b3aed-0c5d-3652-b486-ac14ea466677",
                                                "text": "We learn from the Tribune that \"the reticence of self-respect\" is the proper and polite name for Major [William] McKinley's refusal to answer any question touching his position on the money question. [...] [I]t now appears that the term is also available for the use of candidates for high office, who do not wish to let people know what they think until they are nominated, while it is still not available for small private places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36beee59-3b8f-36d8-b5c1-d1db490d2cf1",
                                        "entry_id": "ab34c499-0515-3723-b07e-9dc89ec87a06",
                                        "glosses": [
                                            "Often followed by to: hesitancy or reluctance (to do something)."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8009d3-8d11-4467-be53-ddaa47a80dd3",
                                                "sense_id": "36beee59-3b8f-36d8-b5c1-d1db490d2cf1",
                                                "text": "According to Anthony & Astorga (1997), the CATIE collection suffers the loss of some 250 individuals every year, which amounts to a general genetic erosion rate of 3% (4.8% for the wild genotypes). The expense of maintaining these collections, as well as the reticence of sponsors to finance such activities, are perhaps the most important factors affecting this erosion."
                                            },
                                            {
                                                "example_id": "bef7be4c-6e1c-4a88-9e26-afe97817307b",
                                                "sense_id": "36beee59-3b8f-36d8-b5c1-d1db490d2cf1",
                                                "text": "The honour of a household is inextricably linked to the reputation of the women who live there [...]. This reputation is sealed by their public display of shame, as manifest in a reticense towards appearing in public places."
                                            },
                                            {
                                                "example_id": "0085afed-8885-4771-ad3f-acc8b15ac72e",
                                                "sense_id": "36beee59-3b8f-36d8-b5c1-d1db490d2cf1",
                                                "text": "Any reticence or wariness I felt for the Professor vanished the moment I saw him with my son, and from that point on I trusted him completely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0b3ac2-b8c8-37dd-9450-44b1a157ba41",
                                        "entry_id": "ab34c499-0515-3723-b07e-9dc89ec87a06",
                                        "glosses": [
                                            "Synonym of aposiopesis (“an abrupt breaking-off in speech”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41764e1f-e65d-4c2f-bf3a-da84da0d89dc",
                                                "sense_id": "da0b3ac2-b8c8-37dd-9450-44b1a157ba41",
                                                "text": "If the Comteſſe de la Motte, contented to load me with opprobrious language, and to make uſe of inſidious reticences, does not accept of this formal challenge, I muſt declare to her, once for all, that I ſhall give to all her reticences, to all her obloquy, paſt, preſent, and to come, an anſwer very laconic, perfectly clear, moſt energetic, [...] —Mentiris impudentissime [you lie shamelessly]."
                                            },
                                            {
                                                "example_id": "c35509fe-4c69-4f6e-85db-d24fd9eeb825",
                                                "sense_id": "da0b3ac2-b8c8-37dd-9450-44b1a157ba41",
                                                "text": "Oh! M. de Vieux, this elixir, and the gallows, will suit you … that you may know what it is to enjoy … / He was going to continue, or to be silent, after these reticenses, but Kant interrupted one or both of these things, [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reticence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faec8565-9bb2-3e5c-8be6-2d17d689344c",
                                        "entry_id": "419157b6-e3ce-3981-b94b-dcf1a276a92c",
                                        "glosses": [
                                            "To deliberately not listen or pay attention to; to disregard, to ignore."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d05fcfd-268e-4ad8-8686-8f79d680b7a1",
                                                "sense_id": "faec8565-9bb2-3e5c-8be6-2d17d689344c",
                                                "text": "[Percy Bysshe] Shelley, a true vates, was called upon by their divine influence to render some choice passages from this very Faust, which, from confessed inability, [Francis Leveson-]Gower had left unattempted in his precious version, and some which from other motives he had purposely reticensed."
                                            },
                                            {
                                                "example_id": "8c20e5e5-1f56-4b24-925e-8e200a76d1be",
                                                "sense_id": "faec8565-9bb2-3e5c-8be6-2d17d689344c",
                                                "text": "It was because he didn't think he'd be recognized that he so ostentatiously lay in ambush—lost and shrouded, a burrowed lay-low, a smoke screen, anonymous, covert, sequestered, disguised and reticenced and secluded, an inference, a stowaway."
                                            },
                                            {
                                                "example_id": "5a64083b-df36-44dc-b0e4-f8a9791fb3f9",
                                                "sense_id": "faec8565-9bb2-3e5c-8be6-2d17d689344c",
                                                "text": "[I]n the future, as we give these programs more and more direct control as we lose some of the general, reticenced fear of relying on computational technology, more and more of these errors—and more and more serious errors are going to occur"
                                            },
                                            {
                                                "example_id": "4de008ab-d7fd-4194-9bd7-d392a9613f46",
                                                "sense_id": "faec8565-9bb2-3e5c-8be6-2d17d689344c",
                                                "text": "Aslant mocha—steam swirling, / Daylight searing the blinds / You reticenced that spiky truth: / A rival gorilla in the mists / And I gulped as a giddy spring magic / Turned to something aping madness; [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "706ace88-197f-45fd-832f-b789a47d601f",
                        "source_entry_id": "c1d1bb91-c1c1-39e4-8a41-f1beb105dc0f",
