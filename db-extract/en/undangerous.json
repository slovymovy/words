                            {
                                "example_id": "787248fd-21f3-4903-80f0-3384c4cb6fd5",
                                "sense_id": "b774e5f8-73e0-3651-8e1a-6cc5213c2036",
                                "text": "But, say they, we, while they fight with the spear,\nLead in our homes a life undangerous:"
                            },
                            {
                                "example_id": "8ef3e569-6f47-4d56-a130-a8b08f03cc2e",
                                "sense_id": "b774e5f8-73e0-3651-8e1a-6cc5213c2036",
                                "text": "One of the basic requirements of a joke is that it come as close as possible to being 'unfunny.' The closer, the funnier. \"Where did the jellyroll?\" is not very funny. We may crack a smile at the little pun, but clean, undangerous puns have to be very virtuosic to get a strong reaction."
                            }
                        ]
                    }
