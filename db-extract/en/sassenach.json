    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "411aa69f-4018-3140-889c-8e88fab01e71",
                "word": "sassenach",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e9c5165c-2e50-4d9f-bf71-0987cd19e33a",
                        "entry_id": "411aa69f-4018-3140-889c-8e88fab01e71",
                        "tags": [
                            "plural"
                        ],
                        "form": "sassenachs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53536b2e-e354-3c1d-b5d5-aa76154649cd",
                        "entry_id": "411aa69f-4018-3140-889c-8e88fab01e71",
                        "glosses": [
                            "An English person."
                        ],
                        "tags": [
                            "Scotland",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "1649d2bd-3354-4b5e-968e-4e7a801f538d",
                                "sense_id": "53536b2e-e354-3c1d-b5d5-aa76154649cd",
                                "text": "'I distinctly heard the barman at that pub last night refer to us as Sassenachs.' 'Well, why not?' said Frank equably. 'It only means \"Englishman\", after all, or at worst, outsider and we're all of that.' 'I know what it means. It was the tone I objected to.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "35de108d-2785-32ac-82bf-ec0db8045d9e",
                        "entry_id": "411aa69f-4018-3140-889c-8e88fab01e71",
                        "glosses": [
                            "A Lowland Scot."
                        ],
                        "tags": [
                            "Scotland",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "ef2ec706-9eed-4a1d-9d9c-0effc80a711d",
                                "sense_id": "35de108d-2785-32ac-82bf-ec0db8045d9e",
                                "text": "But the Sassenach tried to starve the nation at home while the land was full of crops that the British hyenas bought and sold in Rio de Janeiro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9bdd15d-1038-4227-9a02-a04970d7e6be",
                        "source_entry_id": "411aa69f-4018-3140-889c-8e88fab01e71",
                        "source_sense_description": "English person",
                        "target_lang_word": "Engländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Engländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1856a726-46b9-32e6-b8cf-b35569a3eb68",
                                        "entry_id": "dc09d6db-b133-3fe4-84d2-24dedf9dfbfc",
                                        "glosses": [
                                            "Einwohner von England"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa12fadf-a012-4f19-b983-5e21cd6b1790",
                                                "sense_id": "1856a726-46b9-32e6-b8cf-b35569a3eb68",
                                                "text": "Die Schotten haben gegen die Engländer gewonnen."
                                            },
                                            {
                                                "example_id": "a58caab0-772e-45fb-80a2-5d676cc58449",
                                                "sense_id": "1856a726-46b9-32e6-b8cf-b35569a3eb68",
                                                "text": "Trotz unzähliger Qualen und Quallen ist der Abenteurer Ross Edgley [, wohnhaft in Cheshire, England,] einmal um die britische Insel herumgeschwommen - insgesamt fast 2900 Kilometer. Für den Engländer ist dieser Rekord aber nur einer von mehreren."
                                            },
                                            {
                                                "example_id": "1c8b4a35-1841-41ea-bbf1-f9ae961a8b28",
                                                "sense_id": "1856a726-46b9-32e6-b8cf-b35569a3eb68",
                                                "text": "„[Formel 1-Pilot Sebastian] Vettel gratulierte dem Engländer [Lewis Hamilton zum WM-Sieg] herzlich.“"
                                            },
                                            {
                                                "example_id": "0fdc02aa-2d6f-4bbd-b1ee-da7b3113803f",
                                                "sense_id": "1856a726-46b9-32e6-b8cf-b35569a3eb68",
                                                "text": "„Rund um die Insel [Guernsey] stehen Beobachtungstürme aus der Zeit, als die Engländer Angst vor den Franzosen hatten.“"
                                            },
                                            {
                                                "example_id": "aa78d6df-3b81-423f-afa7-91f70aa6346f",
                                                "sense_id": "1856a726-46b9-32e6-b8cf-b35569a3eb68",
                                                "text": "„Mit den Engländern ist das nicht möglich, ebenso wenig mit dem generell durch urlaubende Engländer entstehenden Problem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67d8f576-dfe6-3411-8521-852d0c3ed3a8",
                                        "entry_id": "dc09d6db-b133-3fe4-84d2-24dedf9dfbfc",
                                        "glosses": [
                                            "Staatsbürger, Einwohner Großbritanniens"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2875c002-51b2-4b90-bfd6-0330466c9771",
                                                "sense_id": "67d8f576-dfe6-3411-8521-852d0c3ed3a8",
                                                "text": "Unsere Nachbarn haben einen Engländer aus Glasgow zu Besuch."
                                            },
                                            {
                                                "example_id": "ba8687b4-f0dd-4b5e-936c-7a7722afdedf",
                                                "sense_id": "67d8f576-dfe6-3411-8521-852d0c3ed3a8",
                                                "text": "„Die Engländer bekommen eine neue 50-Pfund-Note. 2020 gibt es 50 Pfund nur noch aus Polymer und nicht mehr aus Papier.“ [Anmerkung: Nicht nur die Engländer, sondern auch die Waliser, Schotten und Nordiren bekommen die 50-Pfund-Note]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "385ed82b-19ea-39b2-9280-67e5c1afe67e",
                                        "entry_id": "dc09d6db-b133-3fe4-84d2-24dedf9dfbfc",
                                        "glosses": [
                                            "österreichische Süßspeise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca29d31b-2d47-4635-9dba-0602d6db7cde",
                                                "sense_id": "385ed82b-19ea-39b2-9280-67e5c1afe67e",
                                                "text": "Zur Nachspeise gibt es Engländer, Eischneemandelmasse auf Oblaten gebacken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ceab27f3-cadd-3079-8209-49c460af873f",
                                        "entry_id": "dc09d6db-b133-3fe4-84d2-24dedf9dfbfc",
                                        "glosses": [
                                            "allgemein: verstellbarer Schraubenschlüssel, speziell: verstellbarer Schraubenschlüssel, dessen Schaft mit den Spannbacken einen rechten Winkel bildet, im Gegensatz zum Rollgabelschlüssel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d99e5d-bff2-458b-ad12-4bbc5e01f1ab",
                                                "sense_id": "ceab27f3-cadd-3079-8209-49c460af873f",
                                                "text": "Gib mir bitte mal den Engländer rüber!"
                                            },
                                            {
                                                "example_id": "185941d3-7918-4758-b186-ccee160c4b4d",
                                                "sense_id": "ceab27f3-cadd-3079-8209-49c460af873f",
                                                "text": "Hast du in deiner Werkstatt einen Franzosen oder einen Engländer?"
                                            },
                                            {
                                                "example_id": "348ea304-e60c-4ca5-94ec-3e8eea57f852",
                                                "sense_id": "ceab27f3-cadd-3079-8209-49c460af873f",
                                                "text": "„Der Engländer bietet […] bei beengten Räumlichkeiten Vorteile [gegenüber dem Franzosen].“"
                                            },
                                            {
                                                "example_id": "a4ce5552-cfba-41e9-a07b-3802fa0d83a1",
                                                "sense_id": "ceab27f3-cadd-3079-8209-49c460af873f",
                                                "text": "„Im selben Moment schlug ihm Ravic den schweren Engländer, den er aus der rechten Seitentasche gegriffen hatte, in den Nacken, gerade unterhalb des Schädels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
