                ],
                "senses": [
                    {
                        "sense_id": "782eca08-1632-3653-bd65-84fd8f9055c0",
                        "entry_id": "4845ba34-f914-336b-87c5-5e52d071113f",
                        "glosses": [
                            "One who affects singularity."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "35a7fdce-afa1-4a21-8ffa-78b00672edad",
                                "sense_id": "782eca08-1632-3653-bd65-84fd8f9055c0",
                                "text": "a clownish singularist, or nonconformist to ordinary usage"
                            }
                        ]
                    },
                    {
                        "sense_id": "6062db88-3ea1-3e12-8bf8-f6f4ea82acdd",
                        "entry_id": "4845ba34-f914-336b-87c5-5e52d071113f",
                        "glosses": [
                            "A proponent of singularism.",
                            "One who believes there is a single valid interpretion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e225d19-f878-4bb9-a9bf-fafa261f2831",
                                "sense_id": "6062db88-3ea1-3e12-8bf8-f6f4ea82acdd",
                                "text": "To that end, the singularist understands an inquiry to proceed."
                            },
                            {
                                "example_id": "f136ef04-b524-4708-935d-7aa0a6449995",
                                "sense_id": "6062db88-3ea1-3e12-8bf8-f6f4ea82acdd",
                                "text": "What divides the singularist from the multiplist is not just an epistemic difference."
                            }
                        ]
                    },
                    {
                        "sense_id": "8340ea46-6527-3a06-a51a-ea57c2e57992",
                        "entry_id": "4845ba34-f914-336b-87c5-5e52d071113f",
                        "glosses": [
                            "A proponent of singularism.",
                            "One who believes that the causal relationship is a directly perceivable and reducible relation between two events."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981229e3-4731-4c57-b212-facda27a88bf",
                                "sense_id": "8340ea46-6527-3a06-a51a-ea57c2e57992",
                                "text": "Like all singularists, Ducasse holds that causation is a relation between particular events with no generalist comonent."
                            },
                            {
                                "example_id": "c73c9f52-f097-426f-8707-13a833d11b46",
                                "sense_id": "8340ea46-6527-3a06-a51a-ea57c2e57992",
                                "text": "My own sympathies are with the generalizing singularist,"
                            }
                        ]
                    }
                ],
