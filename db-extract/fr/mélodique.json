                    {
                        "translation_id": "950bb963-6b31-403f-9ef8-4732fcd8dfec",
                        "source_entry_id": "b7dc12b6-1c1f-36da-9b3a-9e293131eea7",
                        "source_sense_id": "13445164-6f75-3a58-9ae1-fda5855e253a",
                        "target_lang_word": "melodisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
