                },
                {
                    "sense_id": "db4189e8-9051-3b2b-b0e9-afc323f2a723",
                    "sense_definition": "Used to address one's father directly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Happy Father's Day, <w>dad</w>!",
                            "target_lang_translations": {
                                "ru": "С Днём отца, <w>папа</w>!",
                                "zh": "父亲节快乐，<w>爸爸</w>！"
                            }
                        },
                        {
                            "text": "Can you help me with this puzzle, <w>dad</w>?",
                            "target_lang_translations": {
                                "ru": "<w>Папа</w>, ты можешь помочь мне с этой головоломкой?",
                                "zh": "<w>爸爸</w>，你能帮我拼这个拼图吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "daddy",
                        "papa",
                        "pop",
                        "father"
                    ],
                    "antonyms": [
                        "mom",
                        "mum"
