                    "sense_definition": "op nette, feestelijke wijze gekleed zoals passend voor een zondag",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "feestelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nadia was bij de feestelijke ceremonie opvallend <w>zondags</w> gekleed.",
                            "target_lang_translations": {
                                "fr": "Nadia était particulièrement <w>sur son trente-et-un</w> lors de la cérémonie festive."
                            }
                        },
                        {
                            "text": "Voor de bruiloft had iedereen zich keurig en <w>zondags</w> uitgedost.",
                            "target_lang_translations": {
                                "fr": "Pour le mariage, tout le monde s'était mis sur son trente-et-un et habillé <w>comme un dimanche</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zondags gekleed"
                    ],
                    "target_lang_definitions": {
                        "fr": "habillé de façon soignée et élégante, comme pour le dimanche"
