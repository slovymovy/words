{
    "word_family": [
        "rijm",
        "rijmer",
        "rijmelarij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee54993c-bdeb-340d-90ea-aa84bf7ee312",
                    "sense_definition": "Het hebben van een gelijke klank aan het einde van woorden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rijmen_klank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nee, \"yurt\" <w>rijmt</w> niet op \"yoghurt\".",
                            "target_lang_translations": {
                                "fr": "Non, « yurt » ne <w>rime</w> pas avec « yaourt »."
                            }
                        },
                        {
                            "text": "Het is soms lastig om woorden te vinden die op elkaar <w>rijmen</w>.",
                            "target_lang_translations": {
                                "fr": "Il est parfois difficile de trouver des mots qui <w>riment</w> entre eux."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op elkaar rijmen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Avoir une sonorité identique à la fin des mots."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rimer",
                                "target_lang_sense_clarification": "Se dit de mots qui ont une terminaison sonore identique."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1bccad6-2281-3b82-a4ec-6dd60a5baa9f",
                    "sense_definition": "Het schrijven of maken van gedichten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rijmen_dichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doordat ze veel leest, kan ze goed <w>rijmen</w>.",
                            "target_lang_translations": {
                                "fr": "Comme elle lit beaucoup, elle sait bien <w>faire des rimes</w>."
                            }
                        },
                        {
                            "text": "De hulpsinterklaas <w>rijmde</w> er tijdens het feest vrolijk op los.",
                            "target_lang_translations": {
                                "fr": "L'assistant du Père Fouettard <w>versifiait</w> joyeusement pendant la fête."
                            }
                        }
                    ],
                    "synonyms": [
                        "dichten"
                    ],
                    "common_phrases": [
                        "rijmen op los"
                    ],
                    "target_lang_definitions": {
                        "fr": "Écrire ou composer des poèmes."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire des rimes",
                                "target_lang_sense_clarification": "L'acte de composer des vers rimés."
                            },
                            {
                                "target_lang_word": "versifier",
                                "target_lang_sense_clarification": "Écrire des vers, souvent avec une connotation littéraire."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87ce878e-93eb-3a8c-8960-d937d84452c1",
                    "sense_definition": "Iets in overeenstemming brengen met iets anders.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rijmen_overeenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan dat niet <w>rijmen</w> met zijn anders zo vriendelijk gedrag.",
                            "target_lang_translations": {
                                "fr": "Je ne peux pas <w>concilier</w> cela avec son comportement d'habitude si amical."
                            }
                        },
                        {
                            "text": "Zijn dure auto is niet te <w>rijmen</w> met zijn lage inkomen.",
                            "target_lang_translations": {
                                "fr": "Sa voiture coûteuse n'est pas <w>conciliable</w> avec son faible revenu."
                            }
                        }
                    ],
                    "synonyms": [
                        "verenigen",
                        "combineren"
                    ],
                    "common_phrases": [
                        "niet te rijmen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Mettre quelque chose en accord ou en cohérence avec autre chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "concilier",
                                "target_lang_sense_clarification": "Rendre deux choses compatibles ou cohérentes entre elles."
                            },
                            {
                                "target_lang_word": "accorder",
                                "target_lang_sense_clarification": "Mettre en harmonie ou en accord deux éléments."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}