                    {
                        "sense_id": "a5dcd8ba-0d60-3913-bef6-2c56a9aef7e4",
                        "entry_id": "52401730-7035-3577-891a-178221cf299f",
                        "glosses": [
                            "muur die twee vertrekken van elkaar scheidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7685a3e-4095-4bb4-822d-aa1454b8b044",
                                "sense_id": "a5dcd8ba-0d60-3913-bef6-2c56a9aef7e4",
                                "text": "Ze liepen naar een klein voorraadkamertje achter een tussenwand om zich daar te verkleden, maar het was helemaal vol: er zaten drie officieren bij het licht van een kaars op een lege kist te kaarten en ze wilden voor geen prijs hun plaats afstaan."
                            },
                            {
                                "example_id": "38e641c3-2c11-466c-9191-11e01c12ae02",
                                "sense_id": "a5dcd8ba-0d60-3913-bef6-2c56a9aef7e4",
                                "text": "Het absolute pronkstuk van het huis werd ontdekt door zijn vader toen die voorzichtig de muren ontdeed van betimmering. Om ruimte te maken in de woonkamer verwijderde hij een tussenwand."
                            }
                        ]
                    }
                ],
