                    },
                    {
                        "translation_id": "31a5e9ce-c3f7-469f-813a-2955582b479b",
                        "source_entry_id": "a80ec31f-c69e-3747-b9c6-231c3c309f7b",
                        "source_sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                        "target_lang_word": "wohlüberlegt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wohlüberlegt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                        "entry_id": "cd035b40-59a9-37ef-b3ba-e44dfcdc02b6",
                                        "glosses": [
                                            "sehr genau/gründlich/lange durchdacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484dda36-f951-4676-a4f4-43e7c69abf95",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "Er wählte seine Worte mit Bedacht, leicht zögernd und dann wohlüberlegt."
                                            },
                                            {
                                                "example_id": "88706875-1a64-49c8-9bd2-56b874769dab",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Seine Bewegungen waren langsam und wohlüberlegt.“"
                                            },
                                            {
                                                "example_id": "3ac841dd-16e6-4a6e-ac66-c8667fb5e981",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Sich ein Haustier anzuschaffen ist eine Entscheidung, die wohlüberlegt sein will.“"
                                            },
                                            {
                                                "example_id": "d7d6abbb-84b7-474a-ad87-e8ede243cbe4",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Das war ein meisterhafter Angriff, der wohlüberlegt im günstigsten Augenblick geführt wurde.“"
                                            },
                                            {
                                                "example_id": "82799ed3-9470-4f6e-be37-3fe4c23f1ce5",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Die Anschläge waren professionell koordiniert, die Ziele wohlüberlegt. Als zwei Angreifergruppen am Mittwochvormittag in und um Teheran zuschlugen, zielten sie mitten ins Herz der Islamischen Republik.“"
                                            },
                                            {
                                                "example_id": "39dab369-745c-4cad-bf6a-1af43a34a0e9",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Selbst wenn Ötzi auf der Flucht war, allzu überstürzt dürfte er nicht aufgebrochen sein. Seine Ausrüstung stellte er wohlüberlegt zusammen.“"
                                            },
                                            {
                                                "example_id": "b757031f-abd3-4a68-94d1-6c68d433983e",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Die Entscheidung an der Türkischen Riviera zu leben und zu arbeiten, traf der heute 64-jährige Mathias als Endvierziger.“ […] „Die Entscheidung war wohlüberlegt.“"
                                            },
                                            {
                                                "example_id": "9e1f6508-5fcf-43bb-a8a3-3c5044fe5cfd",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "[Coronapandemie 2021:] „In Sachsen wird in diesen Tagen die Impfreihenfolge wohlüberlegt verändert. Die Landkreise, die an das von Corona besonders gebeutelte Nachbarland Tschechien grenzen, werden vorübergehend üppiger mit Impfstoff beliefert als die anderen.“"
                                            },
                                            {
                                                "example_id": "652a8ad6-45da-4a92-a89b-89a0e776c686",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„»Schweigen ist meine Verteidigung. Das macht mich weder zum Schuldigen, noch zum Kriminellen.« Es ist genau 11 Uhr als Salah Abdeslam, 28, seine Worte wohlüberlegt vorbringt.“"
                                            },
                                            {
                                                "example_id": "e2479397-85cb-43a2-ba93-049f05aee215",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„»Wie schade, jammerschade! Ich habe geglaubt, daß bei Euch alles so klug, so weise, so wohlüberlegt gehandhabt wird, und nun erfahre ich von Dir grad das Gegenteil!«“"
                                            },
                                            {
                                                "example_id": "3c5e26be-c457-4670-b36e-fa74f98eaaa0",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "[…] „so gingen Wissenschaftler lange Zeit von Konsumenten aus, die rational die Vor- und Nachteile der verschiedenen Produkte abwägen und so zu einer wohlüberlegten Kaufentscheidung gelangen. Werbefachleute wissen längst, dass es anders ist.“"
                                            },
                                            {
                                                "example_id": "ce8d664c-c1d2-41ac-9931-c8afff881322",
                                                "sense_id": "ea1b2c7a-59f4-32bd-8eee-0662e4b7e6dc",
                                                "text": "„Die grammatischen Bezüge sind nicht immer sofort klar, es entstehen strukturelle Mehrdeutigkeiten und eine Art rhythmisch-syntaktisches Flackern, das Unrast vermittelt. Hölderlin setzt diese Mittel bewusst und wohlüberlegt ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8365dc6a-648f-429d-b397-b3c0993bd5f8",
                        "source_entry_id": "a80ec31f-c69e-3747-b9c6-231c3c309f7b",
                        "source_sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
