                                        "entry_id": "d70e8b74-efae-30f3-ab56-65c289f543ed",
                                        "glosses": [
                                            "den Kopf/Körper in Richtung auf etwas/jemanden hinwenden"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f94ee45-6955-46d7-9e0f-30b3f44e69c6",
                                                "sense_id": "d6b9bb97-581a-3458-b5da-4eb484e751df",
                                                "text": "„Er versuchte schnell, nicht daran zu denken und wendete sich den zwei Neuankömmlingen zu, um herauszufinden, was sie waren, wer sie waren und woher sie kamen.“"
                                            },
                                            {
                                                "example_id": "a6dbbce7-a39c-4d5d-a96d-b0b45d1a9538",
                                                "sense_id": "d6b9bb97-581a-3458-b5da-4eb484e751df",
                                                "text": "„Er wandte sein Gesicht der Sonne zu, atmete mehrmals tief durch und fasste sich an die Brust.“"
                                            },
                                            {
                                                "example_id": "4bfa0548-de0c-49eb-9f82-1a85061612b8",
                                                "sense_id": "d6b9bb97-581a-3458-b5da-4eb484e751df",
                                                "text": "„Er stellte sein Glas nieder auf den Cocktailtisch und wandte sich ihr zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "170a1f6b-213f-3884-bb5a-1fbcfbf27328",
                                        "entry_id": "d70e8b74-efae-30f3-ab56-65c289f543ed",
                                        "glosses": [
                                            "sich einer Sache oder auch Person widmen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e40f01-fcf1-4f32-bea8-b5afa753ed97",
                                                "sense_id": "170a1f6b-213f-3884-bb5a-1fbcfbf27328",
                                                "text": "„Er stellte sein Glas nieder auf den Cocktailtisch und wandte sich ihr zu.“"
                                            },
                                            {
                                                "example_id": "e14282d0-88b4-4fb8-a057-f0b4fa8d4a4f",
                                                "sense_id": "170a1f6b-213f-3884-bb5a-1fbcfbf27328",
                                                "text": "„Nun ruhte die Arbeit; man wendete sich den geistigen Dingen zu.“"
                                            },
                                            {
                                                "example_id": "d44cf31d-7af8-477b-afc0-f7d52ec38312",
                                                "sense_id": "170a1f6b-213f-3884-bb5a-1fbcfbf27328",
                                                "text": "„Dem Hügel Hisarcık wandte sich Schliemann nach Hinweisen des englischen Amateurarchäologen Frank Calvert zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
