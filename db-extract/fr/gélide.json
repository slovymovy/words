                                "target_senses": [
                                    {
                                        "sense_id": "1a6d2327-5571-314f-8312-47a7f7193b05",
                                        "entry_id": "a64dd10c-1cae-3280-afde-37530b4f5860",
                                        "glosses": [
                                            "Very cold; icy or frosty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b5a0e3-aa43-4084-a1bc-3c00a583098e",
                                                "sense_id": "1a6d2327-5571-314f-8312-47a7f7193b05",
                                                "text": "Of Cassandra-Marat we have spoken often; yet the most surprising truth remains to be spoken: that he actually does not want sense; but, with croaking gelid throat, croaks out masses of the truth, on several things."
                                            },
                                            {
                                                "example_id": "571fe4ea-5680-4b7c-9acf-62e8add5b5ce",
                                                "sense_id": "1a6d2327-5571-314f-8312-47a7f7193b05",
                                                "text": "Above the gelid source of mountain springs,\n⁠A solitary eagle, circling, flies."
                                            },
                                            {
                                                "example_id": "fc15f5a9-6a3d-4083-b994-34c6d89a0c0e",
                                                "sense_id": "1a6d2327-5571-314f-8312-47a7f7193b05",
                                                "text": "In the worst of summer the tower remained cool, yet the air seemed feverish and gelid when sisters of different Ajahs came too close."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
