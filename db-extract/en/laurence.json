                                "target_senses": [
                                    {
                                        "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                        "entry_id": "9d032053-e863-3fe0-b35a-92f520e4c8ec",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66f63fb-1790-4f20-ae97-b59540a94e5a",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Wann gibt uns Herr Lorenz die Matheklausur wieder?"
                                            },
                                            {
                                                "example_id": "a7fcc1b1-39b0-42f3-94c7-fe16bedb2ba0",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Frau Lorenz ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6f915f43-6a3e-4c55-9ccc-03937a99220b",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Herr Lorenz wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "11d631e1-753d-4659-b9fa-740aeff33616",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Die Lorenzs fahren heute nach Basel."
                                            },
                                            {
                                                "example_id": "66ef00b5-25f6-410b-b4bc-9572b9ffc39c",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Der Lorenz trägt nie die Schals, die die Lorenz ihm strickt."
                                            },
                                            {
                                                "example_id": "d270e7dc-2430-4e2d-bbce-57ca8110069a",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lorenz kommt, geht der Herr Lorenz.“"
                                            },
                                            {
                                                "example_id": "85aa841e-f0ca-48eb-8113-cb95f363410b",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Lorenz kommt und geht."
                                            },
                                            {
                                                "example_id": "320e860a-9439-4f48-9aba-387185075d68",
                                                "sense_id": "4be1dcc9-4e85-35a9-ab42-ebdade91c2f8",
                                                "text": "Lorenzs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
