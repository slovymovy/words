                        "glosses": [
                            "het aantal gemaakte doelpunten min het aantal doelpunten tegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46a625e-8694-4de8-a3b0-c99ed85315c4",
                                "sense_id": "d9bb7032-833f-314f-81bb-18605f597a3c",
                                "text": "NEC had daardoor weinig aan de 2-0 overwinning bij sc Heerenveen. De club uit Nijmegen eindigde weliswaar met evenveel punten als Sparta, maar moet op basis van een slechter doelsaldo de nacompetitie in."
                            },
                            {
                                "example_id": "a801c282-7a94-40ee-ac83-d70f8e606fdf",
                                "sense_id": "d9bb7032-833f-314f-81bb-18605f597a3c",
                                "text": "In de 34ste en laatste wedstrijd van het seizoen moet Feyenoord het thuis opnemen tegen Heracles. Ajax speelt uit tegen Willem II. Door de ruime nederlaag van Feyenoord en de grote overwinning van Ajax zijn de Amsterdammers qua doelsaldo een stuk dichterbij Feyenoord gekomen. Feyenoord heeft nu een doelsaldo van +59, Ajax van +54."
                            }
                        ]
                    }
