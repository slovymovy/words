                                                "example_id": "ea8df966-9872-4cb0-bef5-9a40fb4e2996",
                                                "sense_id": "572c5e44-9040-368f-9227-daf8e367795a",
                                                "text": "suspension from a hook"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d03cf9f-2430-3e4f-950b-8d14a866d016",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "A temporary or conditional delay, interruption or discontinuation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa9722c4-4ef8-40a1-874f-28ca0ae1d361",
                                                "sense_id": "2d03cf9f-2430-3e4f-950b-8d14a866d016",
                                                "text": "Fear of dioxin emissions led to suspension of efforts to establish a waste-to-energy plant at the Brooklyn Navy yard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdda594-177d-3669-936c-91cb5ce515e0",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "The state of a solid or substance produced when its particles are mixed with, but not dissolved in, a fluid, and are capable of separation by straining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73847478-67ed-457c-80a5-e13b866f2c28",
                                                "sense_id": "ccdda594-177d-3669-936c-91cb5ce515e0",
                                                "text": "As the solids clump together, they get heavier causing them to fall out of suspension in the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb877dd-736d-31d8-bbee-109f904d548d",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "Thus a kind of silt or sludge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b928d85-fc86-332f-8772-7ef36b4527ff",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "The act of keeping a person who is listening in doubt and expectation of what is to follow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cac9b7a4-02c8-30f8-bde8-4482c5363841",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "The temporary barring of a person from a workplace, society, etc. pending investigation into alleged misconduct."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2221087-0d9c-3b8a-9b57-0149cf522ad3",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "The process of barring a student from school grounds as a form of punishment (particularly out-of-school suspension)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb219eb-a9a7-4a97-8e7c-c34d8e543e14",
                                                "sense_id": "d2221087-0d9c-3b8a-9b57-0149cf522ad3",
                                                "text": "suspension from school as a disciplinary measure"
                                            },
                                            {
                                                "example_id": "cfbe7715-491c-4173-b2b4-13ff3b277c3d",
                                                "sense_id": "d2221087-0d9c-3b8a-9b57-0149cf522ad3",
                                                "text": "[…] Donna Thomas, John Tiedeman, David Jones, and Richard Williams, all students in the Granville Junior-Senior High School, conceived a plan in November 1978 to produce a satirical publication addressed to the school community. […] [Assistant Principal Frederick] Reed summoned Tiedeman and discussed with him the “dangers” of publishing material that might offend or hurt others. Specifically, he told Tiedeman that a similar publication several years before had culminated in the suspension of the students involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59a4578-5907-332a-ad9a-d293afd5da57",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "The act of or discord produced by prolonging one or more tones of a chord into the chord which follows, thus producing a momentary discord, suspending the concord which the ear expects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09bad802-91f5-4a09-b876-839b70eda9dd",
                                                "sense_id": "e59a4578-5907-332a-ad9a-d293afd5da57",
                                                "text": "As in Sequenza IV, the suspension of the chord creates several different layers of activity, which can be understood by looking at the right hand’s chord in bar two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d925d624-bd97-3da6-a39d-28d565293fc1",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "A stay or postponement of the execution of a sentence, usually by letters of suspension granted on application to the Lord Ordinary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "030d5f74-f363-3703-b886-6fd2e62e14c4",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "A topological space derived from another by taking the product of the original space with an interval and collapsing each end of the product to a point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf5038ea-1144-4a79-a4ad-3c166e12f12b",
                                                "sense_id": "030d5f74-f363-3703-b886-6fd2e62e14c4",
                                                "text": "To get an intuitive feeling for the characteristics of H'-spaces, it is instructive to consider an important class of such spaces, the suspensions. The suspension of an arbitrary topological space Y is defined to be the quotient space of Y#92;timesI where Y#92;times 0 is identified to one point and Y#92;times 1 is identified to another point. For example, the suspension of a circle is a cylinder with the two ends collapsed into one point each; in other words, a space homeomorphic to a sphere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a266e1f7-18f4-3ed2-bd4b-a7a38a127239",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "A function derived, in a standard way, from another, such that the instant function’s domain and codomain are suspensions of the original function’s."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9432482-196f-48a7-b568-428c154ddaf8",
                                                "sense_id": "a266e1f7-18f4-3ed2-bd4b-a7a38a127239",
                                                "text": "A model category is called pointed if the initial object and terminal object are the same. The homotopy category of any pointed model category acquires a suspension functor denoted by #92;Sigma. It turns out that #92;text#123;Ho#125;(M) is a pre-triangulated category in a natural way[…]. When the suspension is an equivalence, M is called a stable model category, and in this case #92;text#123;Ho#125;(M) becomes a triangulated category[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dfea7a1-de5b-35ec-a494-08f7f445817e",
                                        "entry_id": "219a314e-a368-399a-a608-ae9498ed5da2",
                                        "glosses": [
                                            "The system of springs and shock absorbers connected to the wheels in an automobile, which allows the vehicle to move smoothly with reduced shock to its occupants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bd15256-a944-437a-9069-a0b1d00b389d",
                                                "sense_id": "7dfea7a1-de5b-35ec-a494-08f7f445817e",
                                                "text": "If you drive over a speed bump, the left and right tires push the suspension upward at the same time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c38c303-8027-4d3e-9a14-cb4c63040198",
                        "source_entry_id": "dcf91a3f-7615-39c2-82b1-ac53ea8751cf",
                        "target_lang_word": "suspension",
