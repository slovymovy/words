                    {
                        "sense_id": "38068a98-2d5d-3de1-9b67-697abf1c4047",
                        "entry_id": "6f2dc165-dbc0-3c7e-8b8f-3fb8dd39a22a",
                        "glosses": [
                            "Relatif à de l’aversion pour l’homosexualité féminine ou une attitude hostile à l’encontre des lesbiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2642325-5121-43c9-9702-36e150d8e8d7",
                                "sense_id": "38068a98-2d5d-3de1-9b67-697abf1c4047",
                                "text": "Résultat, sur les sites d’information relayant la nouvelle, certains internautes se sont livrés à « un concours lesbophobe de jeux de mots » du plus mauvais goût."
                            },
                            {
                                "example_id": "714256a5-ae90-4ff9-a42a-6532f86fb81d",
                                "sense_id": "38068a98-2d5d-3de1-9b67-697abf1c4047",
                                "text": "« C’est une agression lesbophobe et misogyne », dénonce auprès de Charlie Orane Guéneau, la gérante du bar, qui a porté plainte."
                            }
                        ]
                    }
