                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e49ab4-16e7-4d9f-8088-3173638126f4",
                                "sense_id": "bf29691b-5c0c-3d37-9ed2-f1cc75e618b5",
                                "text": "„Seit Jahrhunderten gilt Mariazell als eine der wichtigsten Wallfahrtsstätten in Mitteleuropa.“"
                            },
                            {
                                "example_id": "e0988f7f-1c51-4860-80c6-3724605438ec",
                                "sense_id": "bf29691b-5c0c-3d37-9ed2-f1cc75e618b5",
                                "text": "„Die Landesregierung in Graz hat die Gemeinde Gußwerk und die Nachbarorte St. Sebastian, Mariazell und Halltal angehalten, sich zu einer Großgemeinde zusammenzuschließen.“"
                            }
                        ],
