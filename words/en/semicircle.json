                        "arrange in a semicircle",
                        "in a semicircle"
                    ]
                },
                {
                    "sense_id": "f07729bd-0587-3d18-a29a-b92ecac4dddf",
                    "sense_definition": "In soccer, an arc marked outside the penalty box with the penalty spot as its center.",
