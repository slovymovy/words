    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7df7683a-8847-3d7d-9ee2-c8333a76ab88",
                    "sense_definition": "een druppel zout vocht die uit het oog vloeit bij verdriet of irritatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsvocht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen zij het droevige nieuws hoorde, rolde er een dikke <w>traan</w> over haar wang.",
                            "target_lang_translations": {
                                "en": "When she heard the sad news, a thick <w>tear</w> rolled down her cheek."
                            }
                        },
                        {
                            "text": "De kleine jongen moest hard huilen en hij kon zijn <w>tranen</w> bedwingen na de val.",
                            "target_lang_translations": {
                                "en": "The little boy had to cry hard and he could not restrain his <w>tears</w> after the fall."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "tranen bedwingen",
                        "in tranen uitbarsten",
                        "met tranen in de ogen"
                    ],
                    "target_lang_definitions": {
                        "en": "a drop of salty liquid that flows from the eye during sadness or irritation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tear",
                                "target_lang_sense_clarification": "a drop of liquid from the eye"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2c527d6-f01b-3820-aea5-6ae72ab65dd6",
                    "sense_definition": "olie die wordt gewonnen uit het vet van walvissen of andere zeedieren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "olie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger werd <w>traan</w> op grote schaal gebruikt als brandstof voor lampen in de stad.",
                            "target_lang_translations": {
                                "en": "In the past, <w>train oil</w> was used on a large scale as fuel for lamps in the city."
                            }
                        },
                        {
                            "text": "De jacht op walvissen was vroeger erg winstgevend vanwege de productie van <w>traanolie</w>.",
                            "target_lang_translations": {
                                "en": "Whaling used to be very profitable because of the production of <w>whale oil</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "traanolie"
                    ],
                    "target_lang_definitions": {
                        "en": "oil extracted from the blubber of whales or other marine animals"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "train oil",
                                "target_lang_sense_clarification": "whale oil used for fuel"
                            },
                            {
                                "target_lang_word": "whale oil",
                                "target_lang_sense_clarification": "oil from whales"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "763769a6-bb2c-3e90-b804-a2c2e3c775d8",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>tranen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>traan</w> altijd heel erg als ik een ui aan het snijden ben.",
                            "target_lang_translations": {
                                "en": "My eyes always <w>water</w> a lot when I am cutting an onion."
                            }
                        },
                        {
                            "text": "Door de koude wind <w>traan</w> ik vaak zodra ik naar buiten stap.",
                            "target_lang_translations": {
                                "en": "Because of the cold wind, my eyes often <w>water</w> as soon as I step outside."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'to water' or 'to tear up'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water",
                                "target_lang_sense_clarification": "eyes producing liquid"
                            },
                            {
                                "target_lang_word": "tear up",
                                "target_lang_sense_clarification": "to start producing tears"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ea877ca-07b2-3a5d-b1f4-f0832c017ba9",
                    "sense_definition": "de gebiedende wijs van <w>tranen</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Traan</w> nu niet zo over die kleine beschadiging aan je nieuwe fiets.",
                            "target_lang_translations": {
                                "en": "Don't <w>tear up</w> so much over that small damage to your new bike."
                            }
                        },
                        {
                            "text": "Kijk in de felle zon en <w>traan</w> als je je ogen wilt reinigen.",
                            "target_lang_translations": {
                                "en": "Look into the bright sun and <w>water</w> if you want to clean your eyes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
