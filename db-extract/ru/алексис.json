        "ru-extract.jsonl": [
            {
                "entry_id": "dfda14e4-1ec3-3787-854c-08ffbf559575",
                "word": "Алексис",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "085eed57-83e7-376a-b7e8-15cb6d46743d",
                        "entry_id": "dfda14e4-1ec3-3787-854c-08ffbf559575",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ac095b-c764-4cce-b224-867c4ea6ecce",
                                "sense_id": "085eed57-83e7-376a-b7e8-15cb6d46743d",
                                "text": "В своё время замечательный медик, нобелевский лауреат по медицине и физиологии за 1912 год Алексис Каррель сказал: «Всякий человек есть история, не похожая ни на какую другую»…"
                            },
                            {
                                "example_id": "55631f1d-db37-499c-866f-ab301689e751",
                                "sense_id": "085eed57-83e7-376a-b7e8-15cb6d46743d",
                                "text": "Такие люди, как ваш любезный Алексис, прекрасные люди, но для борьбы они совершенно не годны."
                            }
                        ]
                    },
                    {
                        "sense_id": "82f6b565-b1ca-3bad-b8c4-a1740ada3fa3",
                        "entry_id": "dfda14e4-1ec3-3787-854c-08ffbf559575",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf5bf4b2-fcea-37c4-9175-e35a341c6669",
                        "entry_id": "dfda14e4-1ec3-3787-854c-08ffbf559575",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f86837f-111a-4585-9da5-fc015e5a5099",
                                "sense_id": "cf5bf4b2-fcea-37c4-9175-e35a341c6669",
                                "text": "Один из его поклонников, небезызвестный писатель Поль Алексис, задумал написать биографию автора «Ругонов» и получил от него для использования первые опыты, в том числе «Любовную комедию» в отрывках."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47a32b8d-58cb-4a93-857d-ebecc2ed0061",
                        "source_entry_id": "dfda14e4-1ec3-3787-854c-08ffbf559575",
                        "source_sense_description": "мужское имя",
                        "target_lang_word": "Alexis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alexis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc7cf37-a1fa-3c64-96a0-eb2922af9c05",
                                        "entry_id": "d052c8db-45b2-3cfa-97d1-e37127406134",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af61f29-90b4-4996-a331-fea1278becb1",
                                                "sense_id": "7bc7cf37-a1fa-3c64-96a0-eb2922af9c05",
                                                "text": "To the maid of his choice, / With a heart palpitating, / Comes Alexis the brave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                        "entry_id": "d052c8db-45b2-3cfa-97d1-e37127406134",
                                        "glosses": [
                                            "A female given name from Ancient Greek, transferred from the male name and used since the 1940s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4abe471-ebcb-4941-b6bc-a8361b3df7e9",
                                                "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                                "text": "He wondered how parents who had named their daughter Alexis could possibly have known she'd turn out to be such a beauty."
                                            },
                                            {
                                                "example_id": "e425cef0-c90b-4f1d-9dfd-bec93f42cb24",
                                                "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                                "text": "\"It's almost too realistic, too digital and computery,\" complains Alexis Vogel, a veteran celebrity makeup artist who recently worked on \"Stacked,\" a high-def show starring Pamela Anderson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fadce7ac-be55-4d98-a2ee-62c313d1ed00",
