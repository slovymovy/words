                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ebc2805-0f9e-421a-bbd1-3130d1a43ad5",
                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "hygrophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                        "glosses": [
                            "Qualifie les végétaux qui croissent dans les lieux humides, et plus particulièrement dans les milieux soumis à une inondation se comptant en semaines (mais non en mois, dans ce cas voir : hydrophile)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98253da8-9270-4bf1-ac1f-ffb475e8f732",
                                "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                "text": "Bien souvent d’ailleurs et très obligeamment, BONATI fils […] me procura d’intéressants renseignements sur la flore hygrophile de la vallée moyenne."
                            },
                            {
                                "example_id": "f79e0032-c3c6-464e-aba1-2c8b630fa59c",
                                "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                "text": "Groupement hygrophile à Pinus patula, sous climat tropical humide dans les Sierras hidalgenses, de Queretaro et de Puebla."
                            },
                            {
                                "example_id": "9ef83c43-0411-4fa3-af13-444a901ba88a",
                                "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                "text": "Cette espèce hygrophile se naturalise de préférence dans les moliniaies et les pelouses humides (Euffigneix, Poinson) et dans les endroits frais au bord des chemins (Bourbonne, Chambroncourt)."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a7c8bb0-efbf-30ae-9879-4234f7968ff7",
                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                        "glosses": [
                            "Qualifie les animaux qui vivent dans les lieux humides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85cf746e-d4a6-4063-a7ed-d5339048daa7",
                                "sense_id": "9a7c8bb0-efbf-30ae-9879-4234f7968ff7",
                                "text": "Ce n’est point la clarté qu’il redoute, mais la sécheresse : il est hygrophile plutôt que lucifuge."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d991a31-14bc-3bfb-9422-88f8752bccdc",
                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                        "glosses": [
                            "Qualifie les substances qui absorbent l’humidité de l’air."
                        ],
