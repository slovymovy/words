                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "9e5a009e-6875-4c23-bbdc-17cf9b38ceda",
                                "sense_id": "2fcdaef4-c111-325d-9e5a-2a4088a6da28",
                                "text": "Un endormissement difficile s'accompagne souvent de mentisme (défilé rapide d'idées et d'images) en soi non pathologique mais qui peut inquiéter parce qu'incontrôlable et fatigant.",
                                "translation": "Difficulty falling asleep is often accompanied by mentism (a rapid parade of ideas and images), which is not pathological in itself, but can be worrying because it is uncontrollable and tiring.",
                                "english": "Difficulty falling asleep is often accompanied by mentism (a rapid parade of ideas and images), which is not pathological in itself, but can be worrying because it is uncontrollable and tiring."
                            }
                        ]
                    }
