                                        "sense_id": "1f302faa-b11f-302e-b205-e1efda035c03",
                                        "entry_id": "77e31dd5-b9d6-3c88-a63c-16c4eece07b7",
                                        "glosses": [
                                            "Haltung, die darin besteht, dass jemand sich selbst im Mittelpunkt sieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea5eb5c-9b5f-41d7-9e81-a46c6b9f2aff",
                                                "sense_id": "1f302faa-b11f-302e-b205-e1efda035c03",
                                                "text": "„Zu Beginn der Neuzeit war der Egozentrismus des Menschen zum Witz geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
