        "fr-extract.jsonl": [
            {
                "entry_id": "43b16ad2-0427-32b8-bb5f-71a07a32d39f",
                "word": "fédéraliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d54eed0b-71fe-4e03-bea4-b49bbc0a1f8a",
                        "entry_id": "43b16ad2-0427-32b8-bb5f-71a07a32d39f",
                        "tags": [
                            "plural"
                        ],
