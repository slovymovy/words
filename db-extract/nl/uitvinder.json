                "translations": [
                    {
                        "translation_id": "9265fbb1-f54e-4b45-991f-a45e75f81b2e",
                        "source_entry_id": "153295c7-d425-3bb9-ac22-95c777d60702",
                        "source_sense_id": "2d4ea4b3-3d3d-3d4d-acbc-ac2a16625f21",
                        "source_sense_description": "persoon die uitvindingen doet",
                        "target_lang_word": "Erfinder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erfinder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8522b5b2-e724-3d0f-a263-2cf3ff7d39c3",
                                        "entry_id": "03abddf7-fe18-303c-a75c-a59ace8200da",
                                        "glosses": [
                                            "jemand, der etwas erfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f04b9da-1197-4874-9d43-b127134380ae",
                                                "sense_id": "8522b5b2-e724-3d0f-a263-2cf3ff7d39c3",
                                                "text": "Um die Leistungen der Erfinder für die Gesellschaft zu würdigen, werden in manchen Ländern nationale Erfindertage gefeiert, wie beispielsweise in Europa am 9. November."
                                            },
                                            {
                                                "example_id": "dc3d31f6-63fa-449b-80d3-0bfe853436eb",
                                                "sense_id": "8522b5b2-e724-3d0f-a263-2cf3ff7d39c3",
                                                "text": "„Als er am nächsten Morgen den Erfinder wecken wollte, war der schon aufgestanden, gewaschen und angezogen, saß am Tisch und rechnete.“"
                                            },
                                            {
                                                "example_id": "6b7811f7-251d-4dbe-9e63-31179d6e199b",
                                                "sense_id": "8522b5b2-e724-3d0f-a263-2cf3ff7d39c3",
                                                "text": "„Fast gleichzeitig wurde Newton, die konstruirende Methode der alten Mathematiker vorziehend und dabei die Einführung des empirischen Begriffes der Bewegung nicht achtend, Erfinder der Fluxions-Rechnung [Differenzialrechnung].“"
                                            },
                                            {
                                                "example_id": "557757cd-10ea-4a11-b520-4343a3c02ad8",
                                                "sense_id": "8522b5b2-e724-3d0f-a263-2cf3ff7d39c3",
                                                "text": "„Mit Flair 30, einem superleichten Gleiter (36 Kilogramm), schlug der Erfinder schließlich eine Brücke zwischen Segelflug und Drachenflug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8a6d00d-5985-473c-b91d-bc6f622b5b73",
                        "source_entry_id": "153295c7-d425-3bb9-ac22-95c777d60702",
                        "source_sense_id": "2d4ea4b3-3d3d-3d4d-acbc-ac2a16625f21",
                        "source_sense_description": "persoon die uitvindingen doet",
                        "target_lang_word": "inventor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67fd564d-5f54-3125-8396-586e2563b50b",
                                        "entry_id": "d520ddb7-5c7c-3233-a052-cce5cdb08f0e",
                                        "glosses": [
                                            "One who invents, either as a hobby or as an occupation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff344fed-dab9-47b8-aec7-56aa32168d5d",
                                                "sense_id": "67fd564d-5f54-3125-8396-586e2563b50b",
                                                "text": "Thomas Edison was the inventor of the phonograph."
                                            },
                                            {
                                                "example_id": "75bd8177-3acb-4190-97f1-546baca27a5f",
                                                "sense_id": "67fd564d-5f54-3125-8396-586e2563b50b",
                                                "text": "The young inventor received a patent for her design."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e951a649-6b76-444c-ac5e-189c8092bb51",
                        "source_entry_id": "153295c7-d425-3bb9-ac22-95c777d60702",
                        "source_sense_id": "2d4ea4b3-3d3d-3d4d-acbc-ac2a16625f21",
                        "source_sense_description": "persoon die uitvindingen doet",
                        "target_lang_word": "inventeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8cffdab-23b6-31ee-be5d-b722b847869f",
                                        "entry_id": "9b408502-00e5-3922-8e75-56fa13d66b0e",
                                        "glosses": [
                                            "Personne qui a fait une ou plusieurs inventions, entérinées ou non par un brevet d’invention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5380b9df-c04f-43de-a035-2e7daf836aef",
                                                "sense_id": "c8cffdab-23b6-31ee-be5d-b722b847869f",
                                                "text": "Le fondateur de General Electric peut être considéré comme l’inventeur de l’innovation. Cet inventeur de génie, qui n’avait fait aucune grande école, avait mis au point un processus bien rodé de développement pour \"créer des objets utiles que tout homme, femme ou enfant désire, à un prix acceptable\"."
                                            },
                                            {
                                                "example_id": "a58de56c-b1f1-4a91-ae62-8fcc976cf6b1",
                                                "sense_id": "c8cffdab-23b6-31ee-be5d-b722b847869f",
                                                "text": "Surnommé « le roi de l’invention » en Allemagne, Artur Fischer a reçu le prix « Œuvre d’une vie » pour les 1100 brevets qu’il a demandés et déposés tout au long de sa très longue carrière. Cet ingénieur allemand est l’un des inventeurs les plus prolifiques au monde, contestant même ce titre à Thomas Edison et son record de 1093 brevets ! À 94 ans, Artur Fischer est surtout connu pour la cheville en plastique portant son nom. En inventant en 1958 cette cheville à expansion, il a révolutionné la fixation des vis dans les murs et facilité le travail de millions de bricoleurs comme d’ouvriers du bâtiment."
                                            },
                                            {
                                                "example_id": "6174b079-6896-4b83-93a1-be04ebe6f4b0",
                                                "sense_id": "c8cffdab-23b6-31ee-be5d-b722b847869f",
                                                "text": "Que deviendrait l’industrie moderne s’il ne se trouvait d’inventeurs que pour des choses qui doivent leur procurer une rémunération à peu près certaine ? Le métier d’inventeur est bien le plus misérable de tous, et cependant il n’est jamais abandonné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ac4ef5-45a7-3fcd-8a89-25b1fa364516",
                                        "entry_id": "9b408502-00e5-3922-8e75-56fa13d66b0e",
                                        "glosses": [
                                            "Créateur, qui renouvelle, augmente ou modifie la science ou l’art."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3e6cc5-cbe5-4f49-b224-5800697a7d37",
                                                "sense_id": "78ac4ef5-45a7-3fcd-8a89-25b1fa364516",
                                                "text": "Si l’on a trouvé le moyen d’arrêter les machines à vapeur, celui de stoper la langue d’une portière épuisera le génie des inventeurs."
                                            },
                                            {
                                                "example_id": "ca349ff5-708b-4e83-99a5-3012c9ae87b1",
                                                "sense_id": "78ac4ef5-45a7-3fcd-8a89-25b1fa364516",
                                                "text": "Il faudrait […] définir l’homme de génie, et l’une de ses conditions est l’invention : invention d’une forme forme, d’un système ou d’une force. Ainsi Napoléon fut inventeur, à part ses autres conditions de génie. Il a inventé sa méthode de faire la guerre. Walter Scott est un inventeur, Linné est un inventeur, Geoffroy Saint-Hilaire et Cuvier sont des inventeurs. De tels hommes sont hommes de génie au premier chef. Ils renouvellent, augmentent ou modifient la science ou l’art."
                                            },
                                            {
                                                "example_id": "e3ebea2f-48f2-4786-8c99-4b622232e18e",
                                                "sense_id": "78ac4ef5-45a7-3fcd-8a89-25b1fa364516",
                                                "text": "Avec lui aussi disparaît l’inventeur de cette politique desséchante et funeste de l’opportunisme, qu'il appelait la politique de la sagesse et de la raison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e891f7c-bd3b-3b74-a6aa-828fc92c8b52",
                                        "entry_id": "9b408502-00e5-3922-8e75-56fa13d66b0e",
                                        "glosses": [
                                            "Auteur qui affabule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4cb0bb-f76c-41c8-958a-5dd7d1ea629b",
                                                "sense_id": "1e891f7c-bd3b-3b74-a6aa-828fc92c8b52",
                                                "text": "De même que l’inventeur du grand remplacement désire être grand-remplacé – qu'on n'en parle plus –, les ombrageux qui alertent jour et nuit contre un projet secret de gouvernement mondial espèrent son aboutissement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6696f266-5f50-3d96-8da5-43a45eda9fd5",
                                        "entry_id": "9b408502-00e5-3922-8e75-56fa13d66b0e",
                                        "glosses": [
                                            "Celui qui a trouvé une chose enfouie dans le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b09f77-080e-4c61-b0d9-84b17d6d4931",
                                                "sense_id": "6696f266-5f50-3d96-8da5-43a45eda9fd5",
                                                "text": "Lorsqu’un inventeur n’obtient pas le permis d’exploitation d’une mine, la décision d’octroi de ce permis fixe l’indemnité qui lui est due par le détenteur."
                                            },
                                            {
                                                "example_id": "7468391b-f25f-4ea1-9426-fd86e1e4d767",
                                                "sense_id": "6696f266-5f50-3d96-8da5-43a45eda9fd5",
                                                "text": "—C'est aussi le cas du superbe fer de bêche à trois dents découvert à Cézy près de Thèmes (dépt. 89), outil publié sous la responsabilité d'une caution scientifique, et daté de la fin du IXᵉ - début du Xᵉ siècle, période qui nous a été confirmée par l’archéologue inventeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d31f2e3-a485-3647-a6d6-8d8a4aeee28a",
                                        "entry_id": "9b408502-00e5-3922-8e75-56fa13d66b0e",
                                        "glosses": [
                                            "Celui qui a découvert un trésor, et notamment une grotte préhistorique ornée [voir Invention (archéologie) sur l’encyclopédie Wikipédia ]."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb0fbd6-b22b-4d06-a6ca-1f01d6fe8716",
                                                "sense_id": "8d31f2e3-a485-3647-a6d6-8d8a4aeee28a",
                                                "text": "Attendu que, pour confirmer cette ordonnance, la chambre d’accusation, après avoir relevé que les travaux \" étaient étrangers à la recherche d’un trésor \", énonce que la partie civile, personne morale, ne pouvait avoir, en l’espèce, la qualité d’inventeur."
                                            },
                                            {
                                                "example_id": "62f63179-9192-4402-b059-0ba31eb8c87e",
                                                "sense_id": "8d31f2e3-a485-3647-a6d6-8d8a4aeee28a",
                                                "text": "– Donc la découverte du trésor a dû mal tourner. Plutôt que de partager le butin, les autres découvreurs…\n– « Inventeurs »\n– Pardon ?\n– On dit « inventeurs »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
