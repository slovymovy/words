                "entry_id": "42659183-ace0-3f29-9cb2-18df3d9bb9e5",
                "word": "Ethereum",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c80d568-a19b-384e-946a-0856a2e377a9",
                        "entry_id": "42659183-ace0-3f29-9cb2-18df3d9bb9e5",
                        "glosses": [
                            "Protocole d'échanges décentralisés permettant la création par les utilisateurs de contrats intelligents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905b9458-2e92-4abd-af20-736f6cfa4e4e",
                                "sense_id": "4c80d568-a19b-384e-946a-0856a2e377a9",
                                "text": "Bien qu'on recense plus de 700 cybermonnaies, les quelques-unes qui sont citées dans ce chapitre représentent 95 % de leur valeur totale, dont 85 % pour Bitcoin, 5 % pour Ethereum et moins de 2 % pour Ripple, qui sont les trois plus importantes en volume."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ec67e80-6f69-49fd-87b4-9ed6f5e2245f",
                        "source_entry_id": "42659183-ace0-3f29-9cb2-18df3d9bb9e5",
                        "source_sense_id": "4c80d568-a19b-384e-946a-0856a2e377a9",
                        "target_lang_word": "Ethereum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ethereum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0972196f-e38b-3b5a-bd38-95ef41228396",
                                        "entry_id": "64feffc8-0184-3963-a1cf-a1d6886a624e",
                                        "glosses": [
                                            "An open source, blockchain-based cryptocurrency network, that features smart contracts."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2531c046-887b-4508-8b02-76213b746112",
                                                "sense_id": "0972196f-e38b-3b5a-bd38-95ef41228396",
                                                "text": "All Ethereum clients provide a set of JSON-RPC methods for external DApps to interact with the Ethereum blockchain network."
                                            },
                                            {
                                                "example_id": "33e74b7d-039e-4040-9592-164be0a4cb60",
                                                "sense_id": "0972196f-e38b-3b5a-bd38-95ef41228396",
                                                "text": "The sale documents said that once the Ethereum blockchain launched and the premined ether was issued, miners would generate new ether initially at an annual rate of 26% of the amount of ether issued in the crowdsale – the issuance rate isn’t fixed and is capped at 18 million ETH minted per year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d07ffa-f3e1-3920-b944-103f4d61f13c",
                                        "entry_id": "64feffc8-0184-3963-a1cf-a1d6886a624e",
                                        "glosses": [
                                            "Ether, the cryptocurrency used in that network."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b23de8-cf33-45c5-9d42-19a9d402f12c",
                                                "sense_id": "93d07ffa-f3e1-3920-b944-103f4d61f13c",
                                                "text": "“Everydays” was the first purely digital NFT sold by Christie’s, and it offered to accept payment in Ethereum, another first for the 255-year-old auction house."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
