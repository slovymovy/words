            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                    "sense_definition": "Qui n'est d'aucune utilité, qui ne sert à rien.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>inutile</w> de crier car tout le monde vous entend très bien."
                        },
                        {
                            "text": "Elle a jeté tous ces vieux papiers devenus totalement <w>inutiles</w>."
                        }
                    ],
                    "synonyms": [
                        "superflu",
                        "vain"
                    ],
                    "antonyms": [
                        "utile",
                        "nécessaire",
                        "indispensable"
                    ],
                    "common_phrases": [
                        "effort inutile",
                        "dépenses inutiles",
                        "inutile de préciser"
                    ]
                },
                {
                    "sense_id": "f28273b7-2be4-34d3-8d63-83c87281f3df",
                    "sense_definition": "Qui ne rend aucun service ou se sent impuissant à aider, en parlant d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne pouvant rien faire pour soulager leur peine, il se sentait profondément <w>inutile</w>."
                        },
                        {
                            "text": "Le médecin refuse de se sentir <w>inutile</w> face à l'avancée de la maladie."
                        }
                    ],
                    "antonyms": [
                        "utile"
                    ],
                    "common_phrases": [
                        "se sentir inutile"
                    ]
                },
                {
                    "sense_id": "19f50037-3d62-330a-8a5e-74d48f611c56",
                    "sense_definition": "Dont on n'emploie pas les compétences, les talents ou les services.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle direction a laissé plusieurs cadres compétents <w>inutiles</w> pendant des mois."
                        },
                        {
                            "text": "Il refusait de rester les bras croisés, <w>inutile</w> au milieu de tant d'agitation."
                        }
                    ],
                    "antonyms": [
                        "utile"
                    ],
                    "common_phrases": [
                        "rester inutile"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c7d6f34-e152-3c3c-b298-5d7f2dacc890",
                    "sense_definition": "Ce qui n'a aucun usage ou aucune utilité pratique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour vivre plus sereinement, elle a décidé de se débarrasser de l'<w>inutile</w>."
                        },
                        {
                            "text": "Dans son œuvre philosophique, l'écrivain sépare soigneusement l'essentiel de l'<w>inutile</w>."
                        }
                    ]
                },
                {
                    "sense_id": "856eeec7-2c4f-3083-bef3-e937a0b12522",
                    "sense_definition": "Personne qui ne rend aucun service ou dont l'activité ne produit rien de bénéfique pour la société.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur dépeint une cour remplie d'oisifs et d'<w>inutiles</w> vivant aux dépens du peuple."
                        },
                        {
                            "text": "Le vieux soldat méprisait ouvertement tous les <w>inutiles</w> qui fuyaient le devoir."
                        }
                    ]
                }
            ]
        }
    ]
