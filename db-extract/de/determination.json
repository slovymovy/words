                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The act of determining, or the state of being determined.",
                                            "The act, process, or result of any accurate measurement, as of length, volume, weight, intensity, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15cf3a3f-ece6-4fbd-a147-8e05f90cc41f",
                                                "sense_id": "527546be-c6b1-3d21-be3c-eaf70f6a0375",
                                                "text": "the determination of the oxygen in the air"
                                            },
                                            {
                                                "example_id": "acaa7795-8f92-4265-b4b2-92a6cdf6b337",
                                                "sense_id": "527546be-c6b1-3d21-be3c-eaf70f6a0375",
                                                "text": "the determination of the wavelength of light"
                                            },
                                            {
                                                "example_id": "b4c7fc72-72e4-48d9-ae5a-e4b02c410640",
                                                "sense_id": "527546be-c6b1-3d21-be3c-eaf70f6a0375",
                                                "text": "the determination of the level of salt in sea water"
                                            },
                                            {
                                                "example_id": "ee071293-1221-4ca4-9f05-d737019ab116",
                                                "sense_id": "527546be-c6b1-3d21-be3c-eaf70f6a0375",
                                                "text": "Intracardiac blood pressures can be recorded by a simple water manometer or by electronic devices. These determinations are of value in identifying the different cardiac cavities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2680d5e1-a6c8-3130-acc5-2643edf19ced",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The act of determining, or the state of being determined.",
                                            "The act of defining a concept or notion by giving its essential constituents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cfa3579-c25b-36e7-8fd7-3bf2671c7672",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The act of determining, or the state of being determined.",
                                            "The addition of a distinguishing feature to a concept or notion, thus limiting its extent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "092765ac-bec4-32a1-a923-69407407cf10",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The act of determining, or the state of being determined.",
                                            "The act of determining the relations of an object, such as genus and species; the referring of minerals, plants, or animals, to the species to which they belong; classification"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d2d4c9-7975-475f-97bd-57ce323a536e",
                                                "sense_id": "092765ac-bec4-32a1-a923-69407407cf10",
                                                "text": "I am indebted to a friend for the determination of most of these shells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8b969e5-1150-3b3f-a82d-55f0eb13b06d",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "Direction or tendency to a certain end; impulsion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3312b23b-f880-356e-add0-0822f16f34d1",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The quality of mind which reaches definite conclusions; decisive character; resoluteness; fortitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ead2db-f2d7-46e8-af24-e0122f218f6e",
                                                "sense_id": "3312b23b-f880-356e-add0-0822f16f34d1",
                                                "text": "Through sheer determination, we managed to escape from the tornado."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4886c1b-3f54-3da2-a0e5-5b771dc4ea22",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The state of decision; a judicial decision, or ending of controversy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8961ec1-0a41-31e4-8cfa-1eb33a1a4228",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "That which is determined upon; result of deliberation; purpose; conclusion formed; fixed resolution."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c972131a-a722-49a4-886e-3a295570e55b",
                                                "sense_id": "c8961ec1-0a41-31e4-8cfa-1eb33a1a4228",
                                                "text": "The tribunal has reached a determination in respect of this matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f51c472-b082-30dd-a4f7-331f58f6ad4d",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "A flow, rush, or tendency to a particular part"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "238d8be4-bfe3-4184-9779-e12d7c7764c8",
                                                "sense_id": "1f51c472-b082-30dd-a4f7-331f58f6ad4d",
                                                "text": "a determination of blood to the head"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e01986-00bd-379c-abe5-1d6ffa2de7eb",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "Bringing to an end; termination; limit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c15dbf-a378-44a2-b2ed-c45203a0e71a",
                                                "sense_id": "85e01986-00bd-379c-abe5-1d6ffa2de7eb",
                                                "text": "If a lease is determined by notice, forfeiture or frustration, all incumbrances will normally end automatically with the determination of the lease and can therefore be ignored."
                                            },
                                            {
                                                "example_id": "e38deb31-852e-47ae-9633-88a757ef35c7",
                                                "sense_id": "85e01986-00bd-379c-abe5-1d6ffa2de7eb",
                                                "text": "So should that beauty which you hold in lease\nFind no determination: then you were\nYourself again after yourself's decease […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf4e0292-3331-44a1-b2c8-39483fc5bf92",
                        "source_entry_id": "9bdd76f3-efb7-3dfa-8d3f-3bb64c1464d3",
                        "source_sense_id": "a7af991e-cb45-394c-ad73-36515928b0a6",
                        "source_sense_description": "Bestimmtheit, Bestimmung",
                        "target_lang_word": "détermination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détermination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deb44278-dd97-3fd3-8df5-0651e38cb072",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Action de déterminer, de délimiter avec précision, de caractériser sans ambiguïté, clairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552e441a-e670-4691-a9e7-3c7a9557aeff",
                                                "sense_id": "deb44278-dd97-3fd3-8df5-0651e38cb072",
                                                "text": "La présente partie de la présente norme européenne a pour objet de définir un procédé faisant appel à des tamis, pour la détermination de la distribution dimensionnelle des grains."
                                            },
                                            {
                                                "example_id": "a2792e87-07e5-4f00-b185-c09aea19c448",
                                                "sense_id": "deb44278-dd97-3fd3-8df5-0651e38cb072",
                                                "text": "On nous a, en effet, envoyé pour la détermination une liane caoutchoutifère congolaise pouvant atteindre une quinzaine de mètres de hauteur et dont les tiges, privées de vrilles, sont volubiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Résolution qu’on prend après avoir balancé entre plusieurs partis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb62c123-e9c7-447f-8b86-743647ed3dad",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "Nous marchâmes longtemps ainsi, avant que j’eusse pu recueillir l’ombre d’une idée lucide parmi les déterminations urgentes qui m’avaient amené chez Augustin."
                                            },
                                            {
                                                "example_id": "f4f4fc97-0993-4465-97b8-ff7f42ebcf8d",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "A peine en a-t-il prévenu Barth que, gadouilleux et crotté, il cingle vers le Normandy avec la détermination d'un coureur olympique en espoir de médaille d'or."
                                            },
                                            {
                                                "example_id": "b1814b0b-1a23-4dbe-85b2-83d0194ee333",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "Détermination volontaire. — On lui demande une prompte détermination. — Prendre une détermination."
                                            },
                                            {
                                                "example_id": "13a923fc-e04a-453e-9369-9f0ce9143d75",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "La détermination du mouvement peut changer, quoique la force du mouvement demeure la même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6831b598-aee3-3050-bb54-dd24229156e1",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Action par laquelle une chose, également susceptible de plusieurs qualités, de plusieurs manières d’être, est déterminée à recevoir l’une plutôt que l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e90bb5d-7220-439d-8c87-9980c49fd300",
                                                "sense_id": "6831b598-aee3-3050-bb54-dd24229156e1",
                                                "text": "La métaphysique tout entière est attachée à la détermination de l'idée d'infini ; il n'est point de difficulté métaphysique qui ne naisse de l'opposition entre le fini et l'infini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ada5bf0-85e0-381d-8faf-bd06028fd0bd",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Engagement d’une cellule ou d’un groupe de cellules dans un programme particulier de différenciation ou de développement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
