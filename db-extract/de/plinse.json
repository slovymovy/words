                "translations": [
                    {
                        "translation_id": "4d93c4d2-18d7-4b2d-9268-b536225374b0",
                        "source_entry_id": "14ebf248-1c4a-3629-bf99-0416b36a9263",
                        "source_sense_id": "57ad1fef-d828-3dd9-b982-7233a99309f4",
                        "source_sense_description": "Ostmitteldeutsch, Ostniederdeutsch: Speise aus Eiern, Mehl und Milch, die",
                        "target_lang_word": "блин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc63addb-9024-37f5-aee1-575c9d4090bf",
                                        "entry_id": "a87cfec7-e6ec-30cc-9ad8-073046ebe054",
                                        "glosses": [
                                            "кулин., гастрон. плоская тонкая лепёшка, испечённая из жидкого теста на сковороде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab81cc4-f061-4651-b3f7-8f4a8185aca3",
                                                "sense_id": "dc63addb-9024-37f5-aee1-575c9d4090bf",
                                                "text": "Что делать, если уже далеко не первый, а десятый блин продолжает прилипать к сковородке и выходит натуральным комом?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78f7125-e916-3a58-a687-553a0db82ee5",
                                        "entry_id": "a87cfec7-e6ec-30cc-9ad8-073046ebe054",
                                        "glosses": [
                                            "перен. плоский круглый предмет; диск"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dfa9ab7-b720-47c5-a251-d78c46e61623",
                                                "sense_id": "b78f7125-e916-3a58-a687-553a0db82ee5",
                                                "text": "Штангист установил на штангу дополнительные блины."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "блин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "137bd8ea-fb5d-3d2d-9ddf-9ab7013ebec7",
                                        "entry_id": "b6e218fc-7e75-30a7-9be8-a846ae0ca35f",
                                        "glosses": [
                                            "эвф. то же, что блядь;"
                                        ],
                                        "tags": [
                                            "выражает любую сильную эмоцию"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a31834-81db-48cd-861b-cb332fc6bfe0",
                                                "sense_id": "137bd8ea-fb5d-3d2d-9ddf-9ab7013ebec7",
                                                "text": "Где-где, в автосалоне. Шутник, блин. Тарапунька и Штепсель."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec2255c0-a2f6-48f6-a972-c35b4f425727",
                        "source_entry_id": "14ebf248-1c4a-3629-bf99-0416b36a9263",
                        "source_sense_id": "57ad1fef-d828-3dd9-b982-7233a99309f4",
                        "source_sense_description": "Ostmitteldeutsch, Ostniederdeutsch: Speise aus Eiern, Mehl und Milch, die",
                        "target_lang_word": "оладья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оладья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "263f5102-71fa-3210-bae5-eca1abb0871b",
                                        "entry_id": "699bf464-15f4-3964-9124-b3efa2882594",
                                        "glosses": [
                                            "кулин. небольшая толстая лепёшка из пшеничной муки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab0a45b-b836-489f-89cc-2a764d0b9afb",
                                                "sense_id": "263f5102-71fa-3210-bae5-eca1abb0871b",
                                                "text": "Субочевы обедали ровно в двенадцать часов и ели все старинные кушанья: сырники, пигусы, солянки, рассольники, саламаты, кокурки, кисели, взвары, верченую курятину с шафраном, оладьи с мёдом…"
                                            },
                                            {
                                                "example_id": "1427dd7b-c796-4045-9baf-b6605e666ea0",
                                                "sense_id": "263f5102-71fa-3210-bae5-eca1abb0871b",
                                                "text": "За павлинами следовали кулебяки, курники, пироги с мясом и с сыром, блины всех возможных родов, кривые пирожки и оладьи."
                                            },
                                            {
                                                "example_id": "6e9358db-e15a-4288-a44c-39fa658ff674",
                                                "sense_id": "263f5102-71fa-3210-bae5-eca1abb0871b",
                                                "text": "В воскресенье первой недели поста старуха пекла оладьи, а они всё подгорали у неё; красная от огня, она гневно кричала: — А, черти бы вас взяли… И вдруг, понюхав сковороду, потемнела, швырнула сковородник на пол и завыла: — Ба-атюшки, сковорода-то скоромная, поганая, не выжгла ведь я её в чистый-то понедельник, го-осподи!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
