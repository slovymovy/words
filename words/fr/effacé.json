        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dbaad423-897c-3808-8ff5-ebce0159adb8",
                    "sense_definition": "Qui est discret, réservé et évite d'attirer l'attention sur soi.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un collègue très <w>effacé</w> qui ne prend jamais la parole en réunion.",
                            "target_lang_translations": {
                                "en": "He's a very <w>self-effacing</w> colleague who never speaks up in meetings.",
                                "ru": "Это очень <w>скромный</w> коллега, который никогда не берёт слово на совещаниях.",
                                "de": "Er ist ein sehr <w>zurückhaltender</w> Kollege, der in Besprechungen nie das Wort ergreift.",
                                "es": "Es un compañero muy <w>reservado</w> que nunca toma la palabra en las reuniones.",
                                "zh": "他是一位非常<w>低调</w>的同事，在会议上从不发言。"
                            }
                        },
                        {
                            "text": "Malgré son talent remarquable, elle garde toujours une attitude modeste et un air <w>effacé</w>.",
                            "target_lang_translations": {
                                "en": "Despite her remarkable talent, she always keeps a modest attitude and an <w>unassuming</w> air.",
                                "ru": "Несмотря на свой выдающийся талант, она всегда сохраняет скромное поведение и <w>незаметный</w> вид.",
                                "de": "Trotz ihres bemerkenswerten Talents bewahrt sie stets eine bescheidene Haltung und ein <w>zurückhaltendes</w> Auftreten.",
                                "es": "A pesar de su notable talento, siempre mantiene una actitud modesta y un aire <w>discreto</w>.",
                                "zh": "尽管她才华十分出众，却始终保持谦逊的态度，总是一副<w>低调</w>的样子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discret",
                        "réservé",
                        "timide"
                    ],
                    "antonyms": [
                        "exubérant",
                        "voyant"
                    ],
                    "common_phrases": [
                        "air effacé",
                        "personnalité effacée"
                    ],
                    "target_lang_definitions": {
                        "en": "Discreet and reserved, avoiding drawing attention to oneself.",
                        "ru": "Скромный и сдержанный человек, старающийся не привлекать к себе внимания.",
                        "de": "Eine Person, die zurückhaltend und bescheiden ist und ungern im Mittelpunkt steht.",
                        "es": "Persona discreta y reservada que evita llamar la atención sobre sí misma.",
                        "zh": "形容人含蓄低调、不爱引人注目。"
                    },
                    "translations": {
