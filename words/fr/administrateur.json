            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                    "sense_definition": "Personne chargée de gérer les biens ou les affaires d'une entreprise, d'une institution ou d'une collectivité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>administrateur</w> participe activement aux réunions annuelles pour définir la stratégie de l'entreprise."
                        },
                        {
                            "text": "Le tribunal a nommé un <w>administrateur</w> provisoire pour préserver le patrimoine de cette société."
                        }
                    ],
                    "synonyms": [
                        "gestionnaire",
                        "dirigeant",
                        "gérant"
                    ],
                    "common_phrases": [
                        "administrateur de biens",
                        "administrateur provisoire",
                        "administrateur délégué",
                        "administrateur judiciaire"
                    ]
                },
                {
                    "sense_id": "4e48805a-219e-3c01-842a-edb6a84e16f9",
                    "sense_definition": "Spécialiste responsable de la maintenance, de la configuration et de la sécurité d'un système informatique ou d'un réseau.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>administrateur</w> système a configuré les serveurs pour garantir un accès sécurisé aux employés."
                        },
                        {
                            "text": "Il faut demander l'autorisation de l'<w>administrateur</w> pour installer ce programme sur votre poste de travail."
                        }
                    ],
                    "synonyms": [
                        "administrateur système"
                    ],
                    "common_phrases": [
                        "administrateur système",
                        "administrateur réseau",
                        "droits d'administrateur",
                        "compte administrateur"
                    ]
                },
                {
                    "sense_id": "0aef1ba6-1f45-3c88-9df5-a0993c4a3c17",
                    "sense_definition": "Haut fonctionnaire chargé de diriger ou de coordonner les services de la fonction publique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fonction_publique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa formation, il a rejoint le corps des <w>administrateurs</w> civils au ministère de l'Économie."
                        },
                        {
                            "text": "Les <w>administrateurs</w> de l'État élaborent et évaluent les nouvelles politiques publiques avec rigueur."
