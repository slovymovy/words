{
    "word_family": [
        "peripheral",
        "peripherally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "566812c4-a5ad-3c2f-9117-8d79af9c3025",
                    "sense_definition": "The outer boundary, edge, or surrounding area of something, as opposed to its center.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many new housing developments are being built on the <w>periphery</w> of the city.",
                            "target_lang_translations": {
                                "ru": "Множество новых жилых комплексов строится на <w>окраине</w> города."
                            }
                        },
                        {
                            "text": "She preferred to remain on the <w>periphery</w> of the crowd rather than join the main group.",
                            "target_lang_translations": {
                                "ru": "Она предпочитала оставаться на <w>периферии</w> толпы, а не присоединяться к основной группе."
                            }
                        }
                    ],
                    "synonyms": [
                        "edge",
                        "fringe",
                        "margin",
                        "boundary",
                        "outskirts"
                    ],
                    "antonyms": [
                        "center"
                    ],
                    "common_phrases": [
                        "on the periphery",
                        "periphery of the city"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешняя граница, край или окружающая область чего-либо, в отличие от его центра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "периферия",
                                "target_lang_sense_clarification": "часть чего-либо, удалённая от центра"
                            },
                            {
                                "target_lang_word": "окраина",
                                "target_lang_sense_clarification": "крайняя часть местности или города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29e5a955-51e9-3f6e-986e-539b3f21a71b",
                    "sense_definition": "The less common, irregular, or marginal aspects of a language, contrasted with the core grammar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Idiomatic expressions often belong to the grammatical <w>periphery</w> of a language.",
                            "target_lang_translations": {
                                "ru": "Идиоматические выражения часто относятся к грамматической <w>периферии</w> языка."
                            }
                        },
                        {
                            "text": "Linguists study both the core rules and the linguistic <w>periphery</w> to understand language evolution.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучают как основные правила, так и языковую <w>периферию</w>, чтобы понять эволюцию языка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "linguistic periphery"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Менее распространенные, нерегулярные или маргинальные аспекты языка, противопоставляемые его грамматическому ядру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "периферия",
                                "target_lang_sense_clarification": "в лингвистике, периферийные языковые явления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77c218e7-bedc-30b2-ac2a-472cb3386e65",
                    "sense_definition": "A primary administrative region of Greece.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administrative_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>periphery</w> of Attica is the most populous administrative region in Greece.",
                            "target_lang_translations": {
                                "ru": "<w>Периферия</w> Аттика — самый густонаселенный административный регион Греции."
                            }
                        },
                        {
                            "text": "Each regional <w>periphery</w> in Greece is headed by an elected governor.",
                            "target_lang_translations": {
                                "ru": "Каждую региональную <w>периферию</w> в Греции возглавляет выборный губернатор."
                            }
                        }
                    ],
                    "synonyms": [
                        "region",
                        "province"
                    ],
                    "common_phrases": [
                        "administrative periphery"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used specifically in the context of Greek administration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная административная единица (регион) Греции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "периферия",
                                "target_lang_sense_clarification": "административный округ в Греции"
                            },
                            {
                                "target_lang_word": "область",
                                "target_lang_sense_clarification": "административно-территориальная единица"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}