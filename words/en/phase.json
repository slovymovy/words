    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82e5d8ea-ebf5-3c82-8761-606a9b81e452",
                    "sense_definition": "A distinguishable part of a sequence, cycle, or process occurring over time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "process_stage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is currently in its final <w>phase</w> of development.",
                            "target_lang_translations": {
                                "ru": "В настоящее время проект находится на завершающем <w>этапе</w> разработки.",
                                "zh": "该项目目前处于开发的最后<w>阶段</w>。"
                            }
                        },
                        {
                            "text": "We are entering a new <w>phase</w> of the negotiations.",
                            "target_lang_translations": {
                                "ru": "Мы вступаем в новую <w>фазу</w> переговоров.",
                                "zh": "我们正在进入谈判的新<w>阶段</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "initial phase",
                        "final phase",
                        "transition phase",
                        "critical phase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличимая часть последовательности, цикла или процесса, происходящая в течение определенного времени.",
                        "zh": "在一段时间内发生的序列、周期或过程中的一个可区分的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этап",
                                "target_lang_sense_clarification": "стадия развития или процесса"
                            },
                            {
                                "target_lang_word": "фаза",
                                "target_lang_sense_clarification": "период цикла"
                            },
                            {
                                "target_lang_word": "стадия",
                                "target_lang_sense_clarification": "ступень развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阶段",
                                "target_lang_sense_clarification": "发展或过程中的一个时期"
                            },
                            {
                                "target_lang_word": "时期",
                                "target_lang_sense_clarification": "具有某种特征的一段时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "981f6d2d-36ef-3b74-b422-6bb9fd7aca23",
                    "sense_definition": "A particular appearance or state in a regularly recurring cycle of changes, especially regarding the illumination of the moon or a planet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moon goes through a different <w>phase</w> every night.",
                            "target_lang_translations": {
                                "ru": "Каждую ночь Луна проходит через другую <w>фазу</w>.",
                                "zh": "月亮每晚呈现出不同的<w>相</w>。"
                            }
                        },
                        {
                            "text": "We studied the <w>phases</w> of the moon in our science class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали <w>фазы</w> Луны на уроке естествознания.",
                                "zh": "我们在科学课上学习了月<w>相</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "phases of the moon",
                        "lunar phase",
                        "full phase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный вид или состояние в регулярно повторяющемся цикле изменений, особенно касающееся освещенности Луны или планеты.",
                        "zh": "在周期性变化中表现出的特定外观或状态，尤指月球或行星的盈亏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фаза",
                                "target_lang_sense_clarification": "астрономическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相",
                                "target_lang_sense_clarification": "天文学中指天体外观的变化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7da411ee-4730-3023-8c15-fca8fa13c51d",
                    "sense_definition": "A distinct state of matter in a system (solid, liquid, or gas) characterized by uniform chemical composition and physical properties.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics_chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water changes from a liquid <w>phase</w> to a gas <w>phase</w> when it boils.",
                            "target_lang_translations": {
                                "ru": "При кипении вода переходит из жидкой <w>фазы</w> в газообразную <w>фазу</w>.",
                                "zh": "水在沸腾时从液<w>相</w>转变为气<w>相</w>。"
                            }
                        },
                        {
                            "text": "The alloy contains a distinct crystalline <w>phase</w> that strengthens the metal.",
                            "target_lang_translations": {
                                "ru": "Сплав содержит особую кристаллическую <w>фазу</w>, которая упрочняет металл.",
                                "zh": "该合金含有一种能强化金属的独特晶体<w>相</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "liquid phase",
                        "gas phase",
                        "solid phase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное состояние вещества в системе (твердое, жидкое или газообразное), характеризующееся однородным химическим составом и физическими свойствами.",
                        "zh": "系统中具有均匀化学成分和物理性质的物质状态（固态、液态或气态）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фаза",
                                "target_lang_sense_clarification": "термодинамическая"
                            },
                            {
                                "target_lang_word": "агрегатное состояние",
                                "target_lang_sense_clarification": "физическое состояние вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相",
                                "target_lang_sense_clarification": "热力学中的物质状态"
                            },
                            {
                                "target_lang_word": "物态",
                                "target_lang_sense_clarification": "物质的物理状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99865dae-0827-324e-9f0a-e83fdbf8b33c",
                    "sense_definition": "A specific point in the cycle of a wave form or periodic phenomenon, often measured relative to a standard position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics_waves",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sound waves are out of <w>phase</w>, which causes the volume to drop.",
                            "target_lang_translations": {
                                "ru": "Две звуковые волны не совпадают по <w>фазе</w>, из-за чего громкость падает.",
                                "zh": "这两列声波<w>相位</w>不一致，导致音量下降。"
                            }
                        },
                        {
                            "text": "For the signal to be clear, the transmission must be in <w>phase</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы сигнал был четким, передача должна быть в <w>фазе</w>.",
                                "zh": "为了使信号清晰，传输必须保持<w>相位</w>同步。"
                            }
                        }
