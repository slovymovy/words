                "senses": [
                    {
                        "sense_id": "23263f6f-616c-36af-b82e-d3d494d2ccb5",
                        "entry_id": "57730bac-4d3e-364d-a741-e2e5e75a260b",
                        "glosses": [
                            "Ansprache, die gehalten wird, um jemanden zu begrüßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386c4122-6cad-413e-9786-37aead2877ce",
                                "sense_id": "23263f6f-616c-36af-b82e-d3d494d2ccb5",
                                "text": "„Er galt als glänzender Redner, deshalb hatten die Gujarati-Kaufleute ihn eingeladen, die Willkommensansprache für Gandhi zu halten.“"
                            },
                            {
                                "example_id": "786b9bfa-90a9-4780-a308-1522e025c8c6",
                                "sense_id": "23263f6f-616c-36af-b82e-d3d494d2ccb5",
                                "text": "„In seiner Londoner Willkommensansprache machte der ehemalige Außenminister Lord Hurd im November 1999 die spitze Bemerkung, er hoffe, Deutschlands neuer Mann in Großbritannien möge diesmal seinen Dienst über die volle Dauer von drei bis vier Jahren leisten und nicht dem Vorbild seiner beiden Amtsvorgänger folgen, die beide nach zwei Jahren abberufen worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
