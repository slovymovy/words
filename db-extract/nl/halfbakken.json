                ],
                "senses": [
                    {
                        "sense_id": "ed1fc51d-ebe9-3a9f-8861-3a4762239380",
                        "entry_id": "b761ca6c-3857-3752-8d57-a6c3184aeff1",
                        "glosses": [
                            "van brood dat het nog niet volkomen gaar is"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8fb03312-d807-3799-8c10-3d3fb5d1371a",
                        "entry_id": "b761ca6c-3857-3752-8d57-a6c3184aeff1",
                        "glosses": [
                            "gebrekkig en ondoordacht"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e283397b-8425-411d-82c4-8a288b967dcb",
                                "sense_id": "8fb03312-d807-3799-8c10-3d3fb5d1371a",
                                "text": "Dat kon de genadeslag betekenen voor Tilda. Dat wat tussen haar oren nog een vlucht naar voren was, werd buiten haar gezichtsveld een duwtje in de richting van de afgrond. Politiek vereiste soms radicale beslissingen. Regels waren er niet. Adema had hem weer eens onderschat met haar halfbakken nonsens. Het idee dat ze Morten Mathijsen te snel af kon zijn, was haar laatste misrekening."
                            },
                            {
                                "example_id": "211a8a12-6fe1-4abc-aa52-880347543ba6",
                                "sense_id": "8fb03312-d807-3799-8c10-3d3fb5d1371a",
                                "text": "Volgens historicus Geert Mak is de lange band van de Nederlandse bevolking met het koningshuis vooral toe te schrijven aan een ongelukkige combinatie van laksheid en ingewikkelde procedures. 'Eigenlijk is Nederland al sinds 1816 klaar met het koningshuis, maar het lukt elk jaar maar niet om het op tijd stop te zetten. In 1917 is een halfbakken poging gedaan om koningin Wilhelmina te annuleren, maar dat ging op het laatste moment mis omdat Troelstra zijn DigiD-wachtwoord was vergeten en hij niet genoeg tijd meer had om een nieuwe aan te vragen.' Volgens Willem-Alexander ligt de verantwoordelijkheid om hem op tijd stop te zetten bij Nederland. 'Je mag van de burger tegenwoordig best wel een beetje zelfredzaamheid verwachten. Dit is een koninkrijk, geen hotel.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "368a98d2-56e7-42c7-a7ba-e0ef8040e102",
                        "source_entry_id": "b761ca6c-3857-3752-8d57-a6c3184aeff1",
                        "source_sense_id": "ed1fc51d-ebe9-3a9f-8861-3a4762239380",
                        "source_sense_description": "van brood dat het nog niet volkomen gaar is",
                        "target_lang_word": "half-baked",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half-baked",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd926fb5-bf93-3bc1-9e46-dc01d2123382",
                                        "entry_id": "ad3f2d25-75dd-3a69-9025-3afac9bddbac",
                                        "glosses": [
                                            "Incomplete; (of an idea or scheme) not fully planned or carefully considered, ill-conceived, unsound or badly thought-out; (of a person) foolish or having no common sense."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7620d5-c8f2-4ab5-80b8-c7e646668c2d",
                                                "sense_id": "bd926fb5-bf93-3bc1-9e46-dc01d2123382",
                                                "text": "The guy had some half-baked idea for getting rich in the stock market."
                                            },
                                            {
                                                "example_id": "0d20dc03-41e4-46b7-a89e-08e25979f14f",
                                                "sense_id": "bd926fb5-bf93-3bc1-9e46-dc01d2123382",
                                                "text": "\"You're cheap. Cheap education, cheap ideas, a half-baked bloody nobody.\""
                                            },
                                            {
                                                "example_id": "9f089479-7620-4477-bffb-63282228bc78",
                                                "sense_id": "bd926fb5-bf93-3bc1-9e46-dc01d2123382",
                                                "text": "She came skipping to me just now, clapping her little hands and bleating about how very, very happy she was, dear Mrs Travers. The silly young geezer. I nearly conked her one with my trowel. I'd always thought her half-baked, but now I think they didn't even put her in the oven."
                                            },
                                            {
                                                "example_id": "7bd9db75-d747-421b-9f67-b21947b348e9",
                                                "sense_id": "bd926fb5-bf93-3bc1-9e46-dc01d2123382",
                                                "text": "Though Jevons's theory was more than half-baked, it needed more time in the oven, since he forgot to calculate that poor harvests in Asia would hit England only after a time lag."
                                            },
                                            {
                                                "example_id": "f6baf7f8-98a5-4161-b26a-7b9ed90bc9eb",
                                                "sense_id": "bd926fb5-bf93-3bc1-9e46-dc01d2123382",
                                                "text": "A Cambridgeshire man recently gave notice with a message piped on top of a passion cake. A half-baked idea, or a generous parting gift for the office?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f78a227f-ac38-300b-aade-583018ba7e77",
                                        "entry_id": "ad3f2d25-75dd-3a69-9025-3afac9bddbac",
                                        "glosses": [
                                            "Under the influence (of alcohol) but not totally baked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c4b2d6-e929-4f5d-a127-e7e310517f2e",
                                                "sense_id": "f78a227f-ac38-300b-aade-583018ba7e77",
                                                "text": "If you need to talk to John tonight, try to catch him early in the evening, while he's still only half-baked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac2b041-ca75-3ade-83b5-48e4043cd961",
                                        "entry_id": "ad3f2d25-75dd-3a69-9025-3afac9bddbac",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: Partially cooked by heating in an oven, either as an accidental outcome or as a work in process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f77ef42-4b63-484f-bd6f-591f7f9e4d73",
                                                "sense_id": "9ac2b041-ca75-3ade-83b5-48e4043cd961",
                                                "text": "Near-synonyms: underbaked, dough-baked (dated)"
                                            },
                                            {
                                                "example_id": "7a94a88d-b5d5-48c2-b90b-f9a5a006cbd5",
                                                "sense_id": "9ac2b041-ca75-3ade-83b5-48e4043cd961",
                                                "text": "The casserole was half-baked, but I choked it down anyway to be polite."
                                            },
                                            {
                                                "example_id": "1551784a-aedb-4d69-9fe9-c4a120c2b3be",
                                                "sense_id": "9ac2b041-ca75-3ade-83b5-48e4043cd961",
                                                "text": "When the casserole is half-baked, get started on preparing the side dishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
