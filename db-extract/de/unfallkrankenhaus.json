                    {
                        "sense_id": "7afd5ed8-6030-37c8-b3eb-59ec6430f9c8",
                        "entry_id": "bdcdfabd-1c90-3ac3-ba68-8d80588fb217",
                        "glosses": [
                            "ein auf die Behandlung von Unfallfolgen spezialisiertes Krankenhaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b601bb8-32af-4898-b907-8914894779fd",
                                "sense_id": "7afd5ed8-6030-37c8-b3eb-59ec6430f9c8",
                                "text": "„»Im Prinzip erinnere ich im Großen und Ganzen gar nix«, erwidert Mulugeta. Als er allerdings im Unfallkrankenhaus aus dem Koma erwacht sei, habe er das Gefühl gehabt, in jener Nacht von »Leuten überrascht worden zu sein«.“"
                            },
                            {
                                "example_id": "874bf0a7-29bd-41de-a86f-4aa01f3779df",
                                "sense_id": "7afd5ed8-6030-37c8-b3eb-59ec6430f9c8",
                                "text": "„Auch das Unfallkrankenhaus Berlin (UKB) in Marzahn signalisierte am Montag, dass es bereit ist, Patienten aus dem Krisengebiet aufzunehmen.“"
                            }
                        ],
