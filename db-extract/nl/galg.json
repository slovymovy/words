                    {
                        "translation_id": "c64e7779-b772-4c13-88f1-5f970a463b2f",
                        "source_entry_id": "3320607a-2ee1-3b98-b867-210775048ea8",
                        "source_sense_id": "686d9056-1f60-3c27-8800-a802d6603a64",
                        "source_sense_description": "houten constructie bestaande uit één of meer staande balken met een horizontale balk haaks daarop en één of meer diagonale balken ter ondersteuning, in het verleden veel gebruikt om mensen door ophanging ter dood te brengen",
                        "target_lang_word": "potence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "775a2b50-805c-33a4-840e-ba04b094cb9c",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Assemblage de trois pièces de bois ou de fer, dont une est dressée verticalement, une autre est posée horizontalement sur la première, et la troisième soutient l’extrémité de celle-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bee4daa-88dc-42be-af7d-b41fa2f61983",
                                                "sense_id": "775a2b50-805c-33a4-840e-ba04b094cb9c",
                                                "text": "Zarzavadjian avait appris à aimer l'univers enchevêtré des arrière-gares et des voies de triage. Tous les poteaux, les potences et les portiques et leurs signalisations suspendues. […]. Et bien entendu l'infinie arborescence des rails."
                                            },
                                            {
                                                "example_id": "fa81170a-f0a0-4f21-9ea5-eb89e194954b",
                                                "sense_id": "775a2b50-805c-33a4-840e-ba04b094cb9c",
                                                "text": "Les potences de fer servent principalement à porter des balcons, des poulies, des lanternes, etc."
                                            },
                                            {
                                                "example_id": "80fe4b06-778c-4871-8753-4ffb5203e1e9",
                                                "sense_id": "775a2b50-805c-33a4-840e-ba04b094cb9c",
                                                "text": "Les enseignes des aubergistes sont ordinairement soutenues par des potences de fer ou de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f0c49d-0e2a-3f44-bbd5-eb2a377a0ad7",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Assemblage de trois pièces de bois ou de fer, dont une est dressée verticalement, une autre est posée horizontalement sur la première, et la troisième soutient l’extrémité de celle-ci.",
                                            "Gibet ; instrument servant au supplice de ceux que l’on pend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce9a286-de07-4c80-8348-1910a5762a38",
                                                "sense_id": "42f0c49d-0e2a-3f44-bbd5-eb2a377a0ad7",
                                                "text": "Au nord ouest, près de la route de Sommerance, se dressaient les bois de la potence, instrument de la haute justice seigneuriale. Parfois y oscillait un squelette blanchi, et le vent, secouant lamentablement les os desséchés, chassait la sombre nuée de corbeaux venue pour les festins lugubres."
                                            },
                                            {
                                                "example_id": "9a015c2a-1141-4c3e-9e42-5bf4362fb681",
                                                "sense_id": "42f0c49d-0e2a-3f44-bbd5-eb2a377a0ad7",
                                                "text": "Dans la logique mentale de leur temps, les magistrats l'accusent et la condamnent de « sorcellerie », crime pour lequel le bourreau l’énuque avec la « hart » de la potence (corde d'infamie)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2286f8ba-664d-36dd-bc96-aa20c77c7439",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Assemblage de trois pièces de bois ou de fer, dont une est dressée verticalement, une autre est posée horizontalement sur la première, et la troisième soutient l’extrémité de celle-ci.",
                                            "Pendaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e773f7-0fe6-4cb9-81b2-500379470adf",
                                                "sense_id": "2286f8ba-664d-36dd-bc96-aa20c77c7439",
                                                "text": "On l’a condamné à la potence."
                                            },
                                            {
                                                "example_id": "478f18b2-5907-46e3-b803-41db481844fc",
                                                "sense_id": "2286f8ba-664d-36dd-bc96-aa20c77c7439",
                                                "text": "Il mérite la potence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833d450c-99a5-3bee-bced-63208ee73a2c",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Élément d’une bicyclette fixé sur le cadre et sur lequel est monté le cintre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e62dc7-b97d-4b3c-99d6-412b5320d6f9",
                                                "sense_id": "833d450c-99a5-3bee-bced-63208ee73a2c",
                                                "text": "Pas une fois, on ne voit de ces kilomètres parcourus les mains en haut du guidon et les hommes rouler plutôt en flâneurs qu’en coureurs. Dès le départ, ils touchent avec leur bout de nez la potence de leur guidon et ne le relèvent qu’une fois la ligne d’arrivée franchie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6810802c-4873-318f-a74d-ae256938876f",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Support à deux branches utilisé pour les perfusions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f290f0-10ac-4ea4-9f3c-b37b5a8fe625",
                                                "sense_id": "6810802c-4873-318f-a74d-ae256938876f",
                                                "text": "L’infirmière suspendit le ballon de sérum glucosé à une potence de métal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4eb93c6-6488-3887-92f2-12445abe62f2",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Poignée fixée au-dessus d’un lit d’hôpital permettant au patient de se soulever."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0999fe47-785f-3c85-836a-0c3f82562b36",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Morceau de bois où pend la bague."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c2257d0-a0aa-4c4a-98db-9910c83fdbfb",
                                                "sense_id": "0999fe47-785f-3c85-836a-0c3f82562b36",
                                                "text": "Brider la potence, donner contre ce morceau de bois, au lieu d’emporter la bague, ou de la toucher."
                                            },
                                            {
                                                "example_id": "80b9db83-5050-427d-b4a4-1e8618f8b20f",
                                                "sense_id": "0999fe47-785f-3c85-836a-0c3f82562b36",
                                                "text": "Table en potence, table longue, vers l’un des bouts de laquelle il y en a une autre qui est en travers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd66fe1-e04b-329c-a4b1-ebbe214c3800",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Croix en forme de T."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da873342-2a5a-38cf-a912-e1d57f8dea6a",
                                        "entry_id": "b8155721-b665-3f45-9723-f9d31b7ae1af",
                                        "glosses": [
                                            "Mots horizontal et vertical qui commencent sur la première case (à gauche) de la première ligne, aux mots croisés."
                                        ],
                                        "tags": [],
