                                        "sense_id": "cf9e8880-9d3e-312e-a1ac-46f4882ce0e8",
                                        "entry_id": "b9f9cb8a-fb06-38b5-b461-ab51c1c5b769",
                                        "glosses": [
                                            "A preparatory activity analogous to a rehearsal (sense 1)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df14c893-1781-4317-9bbd-fb10af7f97e7",
                                                "sense_id": "cf9e8880-9d3e-312e-a1ac-46f4882ce0e8",
                                                "text": "The forest fires are just a rehearsal for the devastation that will be caused if climate change continues to worsen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca233adb-58fc-34e6-99cd-b9e8523038de",
                                        "entry_id": "b9f9cb8a-fb06-38b5-b461-ab51c1c5b769",
                                        "glosses": [
                                            "The act of rehearsing or contriving something; the fact of something's being rehearsed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5805c85a-23e3-4823-aa86-e70ef6dc36e3",
                                                "sense_id": "ca233adb-58fc-34e6-99cd-b9e8523038de",
                                                "text": "The prosecution argued that the defendant's exact repetition of his account of the events several times demonstrated the rehearsal of his story."
                                            }
                                        ]
                                    }
                                ]
