        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "f96e4f97-f0f2-3ef5-b428-c3cacec27919",
                "word": "uitkafferen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                        "entry_id": "f96e4f97-f0f2-3ef5-b428-c3cacec27919",
                        "glosses": [
                            "op heel luide toon zeggen dat iemand het helemaal fout gedaan heeft"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "17d150ba-da71-498e-a912-f632c57bf3fb",
                                "sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                                "text": "Was gooien met katten dan geen oud Vlaams gebruik, dat het zelfs tot de Ieperse stadsfolklore heeft geschopt? En dan zou uitgerekend dit volk Jan Fabre lopen uitkafferen, weghonen en in elkaar meppen omdat op zijn vraag enkele poezen in de lucht zijn gegooid?"
                            },
                            {
                                "example_id": "13c2529a-5912-4aeb-ac0e-4913d53246d2",
                                "sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                                "text": "Zoals gezegd is Ghost Recon Wildlands een game die je toch vooral met vier gelijkgezinde geesten moet spelen, online, die elkaar aanmoedigen en uitkafferen via koptelefoon en microfoon. Solo spelen is mogelijk, maar de overige drie commando's moeten dan worden aangestuurd via een keuzemenu met een beperkt aantal opties. Het is een suboptimale ervaring."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33f2f477-8996-4ab1-a210-85ba829f4fcd",
                        "source_entry_id": "f96e4f97-f0f2-3ef5-b428-c3cacec27919",
                        "source_sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                        "source_sense_description": "uitschelden",
                        "target_lang_word": "scold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f104cbe-e2a0-3cf7-ba9b-e287aade147e",
                                        "entry_id": "88f118a0-52c2-3ba6-803a-8cc0106ebd7c",
                                        "glosses": [
                                            "A person who habitually scolds, in particular a troublesome and angry woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65a2926-0410-473b-a448-83b712674f2f",
                                                "sense_id": "1f104cbe-e2a0-3cf7-ba9b-e287aade147e",
                                                "text": "A ſclaunderous tunge, a tunge of a ſkolde,\nWorketh more miſchiefe than can be tolde;\nThat, if I wiſt not to be controlde,\nYet ſomwhat to ſay I dare well be bolde,"
                                            },
                                            {
                                                "example_id": "fcda2ef3-7329-4149-b62f-ff219fcba383",
                                                "sense_id": "1f104cbe-e2a0-3cf7-ba9b-e287aade147e",
                                                "text": "“Well, I won’t have it, and that’s enough.” She laughed, for her voice had a little been that of the professional scold."
                                            },
                                            {
                                                "example_id": "eb83d861-7e79-4642-a8d6-eadc236f2763",
                                                "sense_id": "1f104cbe-e2a0-3cf7-ba9b-e287aade147e",
                                                "text": "Near the pond was the ducking-stool where many a village scold had her tongue temporarily stilled."
                                            },
                                            {
                                                "example_id": "44e5bf5e-7b19-4376-bbf5-3e5be6f4a285",
                                                "sense_id": "1f104cbe-e2a0-3cf7-ba9b-e287aade147e",
                                                "text": "Consider the contrast with the United States, where deficit scolds dominated Beltway discourse in 2010–2011 but never managed to dictate the terms of political debate […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14a4dbe1-d966-3e57-9b03-a941dfb77ae3",
                                        "entry_id": "b566e1d6-514d-3395-ad17-4aec9a0559d9",
                                        "glosses": [
                                            "To rebuke angrily."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2ede40-6d68-4da3-91c0-cc0f9d1b24e2",
                                                "sense_id": "14a4dbe1-d966-3e57-9b03-a941dfb77ae3",
                                                "text": "I advise that you refrain from using that kind of language at home, lest your mother scold you."
                                            },
                                            {
                                                "example_id": "5716dac8-0767-49e1-bd6c-19f0fc9ed814",
                                                "sense_id": "14a4dbe1-d966-3e57-9b03-a941dfb77ae3",
                                                "text": "A week elapsed before she could see Elizabeth without scolding her —"
                                            },
                                            {
                                                "example_id": "c28d74d1-c433-483c-b226-f804ed8fc713",
                                                "sense_id": "14a4dbe1-d966-3e57-9b03-a941dfb77ae3",
                                                "text": "Molly the dairymaid came a little way from the rickyard, and said she would pluck the pigeon that very night after work. She was always ready to do anything for us boys; and we could never quite make out why they scolded her so for an idle hussy indoors. It seemed so unjust. Looking back, I recollect she had very beautiful brown eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d9a3f21-2cb7-3bf0-81b3-1b2c80f8df31",
                                        "entry_id": "b566e1d6-514d-3395-ad17-4aec9a0559d9",
                                        "glosses": [
                                            "Of birds, to make harsh vocalisations in aggression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82f22c71-175d-3a19-b097-1564122345a7",
                                        "entry_id": "b566e1d6-514d-3395-ad17-4aec9a0559d9",
                                        "glosses": [
                                            "Of birds, to make vocalisations that resemble human scolding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ccb0102-00ee-4d22-a8ef-34b644074285",
                                                "sense_id": "82f22c71-175d-3a19-b097-1564122345a7",
                                                "text": "[T]he merry songsters of the wood now filled the air with their jubilee; the nutcracker began his monotonous clattering, the chaffinches and the wrens sang high in the sky, the blackcock scolded and blustered loudly, the thrush sang his mocking songs and libellous ditties about everybody, but became occasionally a little sentimental and warbled gently and bashfully some tender stanzas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521b8410-0ba0-35aa-be63-f069a835ba7c",
                                        "entry_id": "b566e1d6-514d-3395-ad17-4aec9a0559d9",
                                        "glosses": [
                                            "Misconstruction of scald."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misconstruction"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e08aa32-9a0e-4c69-8af2-20892b9068cf",
                        "source_entry_id": "f96e4f97-f0f2-3ef5-b428-c3cacec27919",
                        "source_sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                        "source_sense_description": "uitschelden",
                        "target_lang_word": "reproach",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reproach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2c8435-bd83-3f0c-815f-5e4ed0acd496",
                                        "entry_id": "111e88e5-a3c7-3546-b0fa-b815a33ef7dc",
                                        "glosses": [
                                            "A mild rebuke, or an implied criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf37316-501a-4357-8051-089aa010771a",
                                                "sense_id": "fe2c8435-bd83-3f0c-815f-5e4ed0acd496",
                                                "text": "My father made no reproach in his letters and only took notice of my science by inquiring into my occupations more particularly than before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb88de3f-3cc3-33b8-acbf-7f7a62829bcc",
                                        "entry_id": "111e88e5-a3c7-3546-b0fa-b815a33ef7dc",
                                        "glosses": [
                                            "Disgrace or shame."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee32f079-10b9-3011-9d4d-37b93bbe3c46",
                                        "entry_id": "111e88e5-a3c7-3546-b0fa-b815a33ef7dc",
                                        "glosses": [
                                            "An object of scorn."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "reproach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d086b13c-e4a0-3c1b-aa1d-9236ca881959",
                                        "entry_id": "375e2717-e4bb-3906-9b2c-6013ba1f56a8",
                                        "glosses": [
                                            "To criticize or rebuke (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc691f54-b662-4866-9220-d35553f4d64e",
                                                "sense_id": "d086b13c-e4a0-3c1b-aa1d-9236ca881959",
                                                "text": "if ye be reproached for the name of Christ"
                                            },
                                            {
                                                "example_id": "1baf2986-e9fd-4361-921d-253551d57939",
                                                "sense_id": "d086b13c-e4a0-3c1b-aa1d-9236ca881959",
                                                "text": "this new commer, Shame,\nThere sit not, and reproach us as unclean."
                                            },
                                            {
                                                "example_id": "b875e530-51d2-48ae-a5c6-c633969f8387",
                                                "sense_id": "d086b13c-e4a0-3c1b-aa1d-9236ca881959",
                                                "text": "Mezentius […] with his ardour warmed / His fainting friends, reproached their shameful flight, / Repelled the victors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45baaccd-8f96-3b73-b633-a6229eb16ad8",
                                        "entry_id": "375e2717-e4bb-3906-9b2c-6013ba1f56a8",
                                        "glosses": [
                                            "To disgrace, or bring shame upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cddcf5b7-e251-44f4-8abb-7a20a6436c57",
                                                "sense_id": "45baaccd-8f96-3b73-b633-a6229eb16ad8",
                                                "text": "I thought your marriage fit; else imputation, / For that he knew you, might reproach your life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1dcb5c7-df22-40ea-9acc-93f8f242e5ac",
                        "source_entry_id": "f96e4f97-f0f2-3ef5-b428-c3cacec27919",
                        "source_sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                        "source_sense_description": "uitschelden",
                        "target_lang_word": "reprove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reprove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a63f687f-6e6c-3b80-a7ec-eabacaffd230",
                                        "entry_id": "6bd70850-ac55-364b-877f-5efba8425e51",
                                        "glosses": [
                                            "To express disapproval."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40c196db-31e2-3eeb-9fed-5ccec5d323ff",
                                        "entry_id": "6bd70850-ac55-364b-877f-5efba8425e51",
                                        "glosses": [
                                            "To criticise, rebuke, or reprimand (someone), usually in a gentle and kind tone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2261e1aa-d30c-411f-8bc0-cdc845d5f4dc",
                                                "sense_id": "40c196db-31e2-3eeb-9fed-5ccec5d323ff",
                                                "text": "Reprove not a scorner, lest he hate thee: rebuke a wise man, and he will love thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ad5a8c-b6d9-3ade-b2ee-b8ef97f6ddfa",
                                        "entry_id": "6bd70850-ac55-364b-877f-5efba8425e51",
                                        "glosses": [
                                            "To deny or reject (as a feeling, behaviour, action, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4cb6d2d-82c5-4d12-8d93-a2013bf98cb5",
                                                "sense_id": "a6ad5a8c-b6d9-3ade-b2ee-b8ef97f6ddfa",
                                                "text": "She ached to be with Affad again – and to reprove the feeling she frowned and bit her lip."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reprove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                                        "entry_id": "02e862df-4abd-39d3-adf8-991a840d70f0",
                                        "glosses": [
                                            "To prove again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c2e70d-e4c6-4fff-a9fb-1e897aa5fde6",
                                                "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                                                "text": "As we've just learned, as long as we live in the manifest realm, a hero's journey is never over. We are constantly having to reprove ourselves."
                                            },
                                            {
                                                "example_id": "90272e3a-252d-4300-b1b9-1a4fd0f56080",
                                                "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                                                "text": "Often, previously-known results will be streamlined, reworded, or reproven to make them directly relevant to the results of this paper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ab12511-bfde-44f0-a04d-f4ee1125e631",
                        "source_entry_id": "f96e4f97-f0f2-3ef5-b428-c3cacec27919",
                        "source_sense_id": "5bf0d161-d649-34bc-b044-78047d091203",
                        "source_sense_description": "uitschelden",
                        "target_lang_word": "bawl out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bawl out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89a5ec38-7ad0-30d2-bfca-4e9abc354b93",
                                        "entry_id": "03732db2-a512-363a-a490-fc15e3442739",
                                        "glosses": [
                                            "To shout very loudly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d650d9-2914-4af6-9485-3f44e94b36dc",
                                                "sense_id": "89a5ec38-7ad0-30d2-bfca-4e9abc354b93",
                                                "text": "The teacher angrily bawled out my name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47763172-8929-38da-8867-dc88f410fe6b",
                                        "entry_id": "03732db2-a512-363a-a490-fc15e3442739",
                                        "glosses": [
                                            "To deliver a loud, hard scolding or lecture to; to reprimand in order to kill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b30e5af-dbb5-4ca8-bc37-cf2b5ce86a23",
                                                "sense_id": "47763172-8929-38da-8867-dc88f410fe6b",
                                                "text": "After a mistake like that, there wasn't much to do besides bawl out the offender and clean up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47152f9a-f2e2-36d5-823d-494d41da5620",
                                        "entry_id": "03732db2-a512-363a-a490-fc15e3442739",
                                        "glosses": [
                                            "To have a serious argument accompanied by shouting."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
