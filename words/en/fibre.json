{
    "word_family": [
        "fibrous",
        "fibril",
        "fibreglass",
        "microfibre",
        "fibroid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1505704e-bac8-30f6-a022-063d5acfd913",
                    "sense_definition": "A single thin piece of a natural or artificial material, resembling a thread.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_thread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The microscope showed several different <w>fibres</w> stuck to the sole of the shoe.",
                            "target_lang_translations": {
                                "ru": "В микроскоп было видно несколько различных <w>волокон</w>, прилипших к подошве ботинка.",
                                "zh": "显微镜显示鞋底粘着几根不同的<w>纤维</w>。"
                            }
                        },
                        {
                            "text": "Wool is a natural <w>fibre</w> that is spun into yarn to make warm clothing.",
                            "target_lang_translations": {
                                "ru": "Шерсть — это натуральное <w>волокно</w>, из которого прядут нити для изготовления теплой одежды.",
                                "zh": "羊毛是一种天然<w>纤维</w>，可以纺成纱线来制作保暖衣物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strand",
                        "thread",
                        "filament"
                    ],
                    "common_phrases": [
                        "natural fibre",
                        "synthetic fibre",
                        "textile fibre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная тонкая нить из натурального или искусственного материала.",
                        "zh": "一种天然或人造材料的细长丝状物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "нить материала"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "тонкая структура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "细长的丝状物质"
                            },
                            {
                                "target_lang_word": "丝",
                                "target_lang_sense_clarification": "极细的线状物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf375cc7-06e9-3093-92e0-fcf0f515de45",
                    "sense_definition": "Plant material in food that cannot be fully digested but helps the body move food through the digestive system.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dietary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fresh vegetables are a good source of <w>fibre</w>.",
                            "target_lang_translations": {
                                "ru": "Свежие овощи — хороший источник <w>клетчатки</w>.",
                                "zh": "新鲜蔬菜是<w>膳食纤维</w>的良好来源。"
                            }
                        },
                        {
                            "text": "Eating a diet high in <w>fibre</w> can help lower cholesterol levels.",
                            "target_lang_translations": {
                                "ru": "Питание с высоким содержанием <w>клетчатки</w> может помочь снизить уровень холестерина.",
                                "zh": "饮食中摄入高<w>膳食纤维</w>有助于降低胆固醇水平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roughage"
                    ],
                    "common_phrases": [
                        "dietary fibre",
                        "high in fibre",
                        "source of fibre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растительный компонент пищи, который не переваривается полностью, но способствует пищеварению.",
                        "zh": "食物中不能被完全消化，但有助于肠道蠕动和消化的植物成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клетчатка",
                                "target_lang_sense_clarification": "пищевая"
                            },
                            {
                                "target_lang_word": "пищевые волокна",
                                "target_lang_sense_clarification": "компонент питания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膳食纤维",
                                "target_lang_sense_clarification": "营养学中的纤维"
                            },
                            {
                                "target_lang_word": "粗纤维",
                                "target_lang_sense_clarification": "植物性食物成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fb09902-6620-33ea-811d-89d7e6ea6232",
                    "sense_definition": "A material composed of thin filaments, often used in manufacturing for its strength or optical properties.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_thread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cloth was made from a strange, somewhat rough <w>fibre</w>.",
                            "target_lang_translations": {
                                "ru": "Ткань была сделана из странного, довольно грубого <w>волокна</w>.",
                                "zh": "这种布料是由一种奇怪且略显粗糙的<w>纤维</w>制成的。"
                            }
                        },
                        {
                            "text": "Modern bicycles often use carbon <w>fibre</w> to reduce weight while maintaining strength.",
                            "target_lang_translations": {
                                "ru": "В современных велосипедах часто используется углеродное <w>волокно</w> для снижения веса при сохранении прочности.",
                                "zh": "现代自行车常使用碳<w>纤维</w>来减轻重量并保持强度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon fibre",
                        "glass fibre",
                        "optical fibre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, состоящий из тонких нитей, используемый в производстве благодаря своей прочности.",
                        "zh": "由细丝组成的材料，常因其强度或光学特性被用于制造业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "материал (напр. стекловолокно)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "工业材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23934cc6-5d52-36af-8abd-b32e35f13dd6",
                    "sense_definition": "A long, thin structure found in animal or plant tissue, such as muscle or nerve cells.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_thread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise helps to strengthen and enlarge muscle <w>fibres</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения помогают укрепить и увеличить мышечные <w>волокна</w>.",
                                "zh": "经常锻炼有助于增强和增大肌肉<w>纤维</w>。"
                            }
                        },
                        {
                            "text": "Damage to the nerve <w>fibres</w> can result in a loss of sensation in the limbs.",
                            "target_lang_translations": {
                                "ru": "Повреждение нервных <w>волокон</w> может привести к потере чувствительности в конечностях.",
                                "zh": "神经<w>纤维</w>受损可能导致肢体失去知觉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle fibre",
                        "nerve fibre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная тонкая структура в тканях животных или растений, например, мышечная или нервная.",
                        "zh": "动植物组织中长而细的结构，如肌肉或神经细胞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "анатомическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "生物组织结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf95ee7-0476-3884-bbdc-007267da04c4",
                    "sense_definition": "Strength of character and determination.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ordeal was a test of everyone’s <w>fibre</w>.",
                            "target_lang_translations": {
                                "ru": "Это испытание стало проверкой <w>характера</w> каждого.",
                                "zh": "这次磨难是对每个人<w>意志</w>的考验。"
                            }
                        },
                        {
                            "text": "He lacked the moral <w>fibre</w> to admit his mistake to the committee.",
                            "target_lang_translations": {
                                "ru": "Ему не хватило <w>духу</w> (моральной стойкости), чтобы признать свою ошибку перед комитетом.",
                                "zh": "他缺乏向委员会承认错误的道德<w>气节</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "character",
                        "resolve",
                        "backbone",
                        "grit"
                    ],
                    "common_phrases": [
                        "moral fibre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила характера и решимость.",
                        "zh": "性格的力量和决心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила духа",
                                "target_lang_sense_clarification": "стойкость"
                            },
                            {
                                "target_lang_word": "характер",
                                "target_lang_sense_clarification": "внутренняя сущность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意志",
                                "target_lang_sense_clarification": "精神力量"
                            },
                            {
                                "target_lang_word": "气节",
                                "target_lang_sense_clarification": "道德操守"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e7de9ed-644a-3890-8a31-6d8dbe859026",
                    "sense_definition": "The set of all elements in a domain that map to a specific value in the range.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under this map, any two values in the <w>fibre</w> of a given point differ by a constant.",
                            "target_lang_translations": {
                                "ru": "При таком отображении любые два значения в <w>слое</w> данной точки отличаются на константу.",
                                "zh": "在此映射下，给定点<w>纤维</w>中的任意两个值相差一个常数。"
                            }
                        },
                        {
                            "text": "The student calculated the <w>fibre</w> of the function at zero.",
                            "target_lang_translations": {
                                "ru": "Студент вычислил <w>слой</w> функции в нуле.",
                                "zh": "学生计算了该函数在零点的<w>纤维</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество всех элементов области определения, которые отображаются в определенное значение области значений.",
                        "zh": "数学中，映射到值域中特定值的所有定义域元素的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "数学映射概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6094d9f-c2df-3f03-bb5f-7673f9b292bf",
                    "sense_definition": "A particularly lightweight thread of execution used in computer programming.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application uses a <w>fibre</w> to manage background tasks efficiently.",
                            "target_lang_translations": {
                                "ru": "Приложение использует <w>волокно</w> для эффективного управления фоновыми задачами.",
                                "zh": "该应用程序使用<w>纤程</w>来高效管理后台任务。"
                            }
                        },
                        {
                            "text": "Switching between <w>fibres</w> is generally faster than switching between system threads.",
                            "target_lang_translations": {
                                "ru": "Переключение между <w>волокнами</w> обычно происходит быстрее, чем между системными потоками.",
                                "zh": "在<w>纤程</w>之间切换通常比在系统线程之间切换更快。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особо легковесный поток выполнения, используемый в компьютерном программировании.",
                        "zh": "计算机编程中一种特别轻量级的执行流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "файбер",
                                "target_lang_sense_clarification": "профессиональный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤程",
                                "target_lang_sense_clarification": "编程中的轻量级线程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}