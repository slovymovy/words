                ],
                "senses": [
                    {
                        "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                        "entry_id": "07a65c82-dd26-3a3e-b942-dfc6353d71eb",
                        "glosses": [
                            "japanischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb09a216-42b0-4c2d-addf-e821f31e28aa",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Frau Matsuda ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "96c5cd30-04ec-4f86-859c-0855bab455d7",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Herr Matsuda wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d8216d8e-b16c-4537-b6b0-84e254c1ff29",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Die Matsudas fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9be7268a-bd9a-421e-8a47-816c55f05393",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Der Matsuda trägt nie die Schals, die die Matsuda ihm strickt."
                            },
                            {
                                "example_id": "24b5e1aa-aa12-4bf9-a520-6a171d55f953",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Matsuda kommt, geht der Herr Matsuda.“"
                            },
                            {
                                "example_id": "eca61728-9de9-4674-a9f5-d18dece9be07",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Matsuda kommt und geht."
                            },
                            {
                                "example_id": "02de5de7-c942-47ff-aa27-a002e8f98e7a",
                                "sense_id": "5727dbcb-7cee-3b31-b4f6-c06e87cf95dc",
                                "text": "Matsudas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
