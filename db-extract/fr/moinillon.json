        "fr-extract.jsonl": [
            {
                "entry_id": "0251cad5-9bd4-3640-b1b0-c6fcf01c69cb",
                "word": "moinillon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1c4185bf-e014-492c-8477-6fb5a5cc9c65",
                        "entry_id": "0251cad5-9bd4-3640-b1b0-c6fcf01c69cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "moinillons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b1ab219-d056-31fe-b6f6-e0277080caa5",
                        "entry_id": "0251cad5-9bd4-3640-b1b0-c6fcf01c69cb",
                        "glosses": [
                            "Jeune moine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39ba819-9a73-42f3-b6c6-0a2ffe6541af",
                                "sense_id": "6b1ab219-d056-31fe-b6f6-e0277080caa5",
                                "text": "Dans leurs couvents moinillons et nonnettes ,\nDans leur collège écoliers et régents ,\nFaisant entr’eux ballets et chansonnettes ,\nS'évaltonnaient en joyeux passe—temps."
                            },
                            {
                                "example_id": "af1cc249-6acb-4dc1-b4a8-31a4261340f5",
                                "sense_id": "6b1ab219-d056-31fe-b6f6-e0277080caa5",
                                "text": "Foin des duchesses et des courtisanes, des bourgeoises et des bergères ! qui dit femme dit tracasseries, mécomptes ou aventures maussades. Je les hais de la coiffe au patin, et je vais me confire en chasteté comme un moinillon en sa capuce."
                            },
                            {
                                "example_id": "8a4c8de6-1a97-43e2-8272-8cb7a2899d16",
                                "sense_id": "6b1ab219-d056-31fe-b6f6-e0277080caa5",
                                "text": "Au surplus, il envoyait au diable moines, moinillons et moineries."
                            },
                            {
                                "example_id": "dca4776a-ffa1-4861-88d8-2aa17d37f2d5",
                                "sense_id": "6b1ab219-d056-31fe-b6f6-e0277080caa5",
                                "text": "L'excellent président du Conseil de 1902-1905 était tout entier à ses congrégations, à ses moines, à ses moinillons."
                            },
                            {
                                "example_id": "425f5bc3-5e28-448f-9c29-b38bac5170bc",
                                "sense_id": "6b1ab219-d056-31fe-b6f6-e0277080caa5",
                                "text": "Voyez-vous que dans mon histoire de l’abbaye de Saint-Germain-des-Près, j’invente quelque moinillon. Que diraient les jeunes érudits ? Quel scandale à l’école ! Quant à l’Institut, il ne dirait rien et n’en penserait pas davantage."
                            }
                        ]
                    }
                ],
