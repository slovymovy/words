                    {
                        "sense_id": "efb6eb4a-f408-385f-8fda-20821eeafe73",
                        "entry_id": "f0abda87-86f5-3076-ad24-f9ff7a71e8cc",
                        "glosses": [
                            "iemand die geschreven tekst overzet van de ene taal naar een andere"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "98004137-4b4c-4e2b-839d-8a71752356a5",
                                "sense_id": "efb6eb4a-f408-385f-8fda-20821eeafe73",
                                "text": "De andere genomineerden zijn Henry Corver voor het poëtische essay Pelgrim langs Tinker Creek van Annie Dillard, Hans Kloos voor de roman-in-dichtvorm Hier maak ik mijn stad van Robin Robertson en Irma Pieper, de vaste vertaler van Karel Capek, voor zijn roman Hordubal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a86bfba-4443-4322-8160-63fdaffc60ec",
                        "source_entry_id": "f0abda87-86f5-3076-ad24-f9ff7a71e8cc",
                        "source_sense_id": "efb6eb4a-f408-385f-8fda-20821eeafe73",
                        "target_lang_word": "Übersetzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übersetzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "515c63ce-687d-3021-b76b-546c40a2b3ad",
                                        "entry_id": "18a1b5ee-b4a5-3dfa-9799-3a70f498a8e7",
                                        "glosses": [
                                            "jemand, der Texte schriftlich von der einen in die andere Sprache überträgt"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecdaef49-2616-4b69-83de-f1b22c9334ab",
                                                "sense_id": "515c63ce-687d-3021-b76b-546c40a2b3ad",
                                                "text": "Der Übersetzer von Untertiteln muss öfters die Textmenge geschickt und feinfühlig reduzieren."
                                            },
                                            {
                                                "example_id": "b9b350d1-c41e-4560-8335-6d8e22792e67",
                                                "sense_id": "515c63ce-687d-3021-b76b-546c40a2b3ad",
                                                "text": "„Von einigen dieser Übersetzer weiß man inzwischen, daß sie zu den Avantgardisten des kulturellen Lebens jener Generation gehören.“"
                                            },
                                            {
                                                "example_id": "6f2a4b0e-831c-4a78-8763-749315f6abd5",
                                                "sense_id": "515c63ce-687d-3021-b76b-546c40a2b3ad",
                                                "text": "„Um nicht auf die Hilfe von Übersetzern angewiesen zu sein, lernt er, soweit möglich, die Sprachen der Völker, die er besucht, und legt dazu eigene Wörter- und Grammatikverzeichnisse an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a79e2009-8a5d-33b6-a5fe-f83e65be732d",
                                        "entry_id": "18a1b5ee-b4a5-3dfa-9799-3a70f498a8e7",
                                        "glosses": [
                                            "ein Programm, dass meist Kode einer Hochsprache in eine niedrigere Sprache wie zum Beispiel Maschinensprache übersetzt"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c246f06c-08c8-40b7-afb0-67e06f7d966f",
                                                "sense_id": "a79e2009-8a5d-33b6-a5fe-f83e65be732d",
                                                "text": "Wenn man bei diesem Übersetzer nicht für Debugging den Kode erzeugt, wird er recht gut optimiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
