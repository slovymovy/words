                                        "entry_id": "cdec3978-8ee0-36a4-9f2a-5d08e6ec59d7",
                                        "glosses": [
                                            "Indicates thinking or pondering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a516de7-a2d7-4203-9a5e-63f8baaa7c09",
                                                "sense_id": "6acf3c0d-acd3-3404-963a-0456f74b285a",
                                                "text": "Hmm... that's an interesting idea."
                                            },
                                            {
                                                "example_id": "d9751c14-a6bd-4b6a-8874-b8710f020732",
                                                "sense_id": "6acf3c0d-acd3-3404-963a-0456f74b285a",
                                                "text": "Hmm... I just can't decide between the two."
                                            },
                                            {
                                                "example_id": "ef5d0821-153b-4350-9c20-8f6844778a29",
                                                "sense_id": "6acf3c0d-acd3-3404-963a-0456f74b285a",
                                                "text": "Hmm... creation or evolution? That’s the big question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d9d07d-3a06-34a4-a24b-956e4b45cbb9",
                                        "entry_id": "cdec3978-8ee0-36a4-9f2a-5d08e6ec59d7",
                                        "glosses": [
                                            "Indicates surprise or cluelessness; especially a response by a person who is questioned or addressed when not expecting it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3bbc7a6-51d5-45c9-bb5e-9096985e6d0e",
                                                "sense_id": "f6d9d07d-3a06-34a4-a24b-956e4b45cbb9",
                                                "text": "\"You there! Where are you going?\" \"Hmm? Oh, I just need to get a drink.\""
                                            },
                                            {
                                                "example_id": "63e95e80-bed8-4bad-89d5-a6de2fc9ae42",
                                                "sense_id": "f6d9d07d-3a06-34a4-a24b-956e4b45cbb9",
                                                "text": "\"Could you pass me the paring knife?\" \"Hmm? What's a paring knife?\""
                                            },
                                            {
                                                "example_id": "bef5ce2c-b5b6-411f-ae86-e43ebf0b295a",
                                                "sense_id": "f6d9d07d-3a06-34a4-a24b-956e4b45cbb9",
                                                "text": "Jeeves: Foreign travel often liberates emotions best kept in check, sir. The air of North America is notoriously stimulating in this regard, as witness the regrettable behavior of its inhabitants in 1776.\nB. Wooster: Hmm? What happened in 1776, Jeeves?\nJeeves: I prefer not to dwell on it, if it's convenient to you, sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a97037-7202-31fd-9033-a967de336b5d",
                                        "entry_id": "cdec3978-8ee0-36a4-9f2a-5d08e6ec59d7",
                                        "glosses": [
                                            "A demand for an answer to a question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67eeae4d-08ce-4c86-98ec-349070f94255",
                                                "sense_id": "16a97037-7202-31fd-9033-a967de336b5d",
                                                "text": "Just where were you until 2 a.m.? Hmm?"
                                            }
                                        ]
                                    }
