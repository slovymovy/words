                        "examples": [
                            {
                                "example_id": "acaeec3f-8fa8-4113-a57b-17db24ff9dc4",
                                "sense_id": "c01022b4-5382-3079-82f6-b854d4f8597a",
                                "text": "Insooth, good friend, your father might have kept\nThis Calfe, bred from his Cow from all the world"
                            },
                            {
                                "example_id": "a56e914d-1d0f-4f28-b3e2-6ec9ff7d75b4",
                                "sense_id": "c01022b4-5382-3079-82f6-b854d4f8597a",
                                "text": "Said a smile to a tear.\n⁠On the cheek of my dear,\nThat becam'd like the sun in spring weather\n⁠Insooth, love Tear,\n⁠It strange must appear,\nThat we should be both here together."
                            },
                            {
                                "example_id": "7a937d25-067d-4747-ac81-c318e3713c8a",
                                "sense_id": "c01022b4-5382-3079-82f6-b854d4f8597a",
                                "text": "I could render an account, but the tale would be over long,—having insooth surprised them there together, had the twain of them slain by men appointed thereto."
                            }
                        ]
                    }
                ],
