                                    }
                                ]
                            },
                            {
                                "target_word": "poissonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40b12ee0-80f5-3c12-97f3-2de78d68799f",
                                        "entry_id": "7a9f29d3-e0e4-32a4-b1d1-13ed7390e111",
                                        "glosses": [
                                            "Celui qui fait le commerce du poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b83876-4c75-41ec-9c49-5c12544f4a8b",
                                                "sense_id": "40b12ee0-80f5-3c12-97f3-2de78d68799f",
                                                "text": "J'allai de ce pas voir Émile l’aubergiste, ma darne de requin à la main. L’événement que m'avait rapporté le poissonnier ne pouvait attendre. La darne non plus."
                                            },
                                            {
                                                "example_id": "a93df2b1-d07c-422c-869b-0f8e60e54806",
                                                "sense_id": "40b12ee0-80f5-3c12-97f3-2de78d68799f",
                                                "text": "Si votre poissonnier ne l’a pas déjà fait, incisez la tête de l’araignée à l’aide d’un couteau."
                                            },
                                            {
                                                "example_id": "712cee2d-a469-4fe8-b4fe-1ce5e8cfcac6",
                                                "sense_id": "40b12ee0-80f5-3c12-97f3-2de78d68799f",
                                                "text": "Écaillez et videz le brochet, ou demandez à votre poissonnier de le faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25f22d2-2af7-33e7-9269-4e41424f6a84",
                                        "entry_id": "7a9f29d3-e0e4-32a4-b1d1-13ed7390e111",
                                        "glosses": [
                                            "L'un des noms vulgaires du grèbe, et plus spécialement du grèbe castagneux (Tachybaptus ruficollis)."
                                        ],
