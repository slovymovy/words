            "senses": [
                {
                    "sense_id": "3133dbfe-d3fc-3eaa-9d35-092a75effd80",
                    "sense_definition": "Faire des efforts ou entreprendre une démarche pour accomplir quelque chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>essaie</w> de comprendre cette leçon difficile depuis ce matin."
                        },
                        {
                            "text": "Nous devons tout <w>essayer</w> pour trouver rapidement une solution convenable."
                        }
                    ],
                    "synonyms": [
