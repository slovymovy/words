                        "entry_id": "7c615a9f-65d3-3f47-a04d-4ebcfa580a89",
                        "glosses": [
                            "Juron, sacre manifestant la colère, le mécontentement ou la surprise."
                        ],
                        "tags": [
                            "familiar",
