                },
                {
                    "sense_id": "0a96a40b-45db-3722-b96b-50199b286faf",
                    "sense_definition": "Manifester son mécontentement en marmonnant à mi-voix ; grommeler.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protester",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme quitta la pièce en <w>grondant</w> quelques paroles incompréhensibles.",
                            "target_lang_translations": {
                                "en": "The old man left the room <w>muttering</w> a few unintelligible words.",
                                "de": "Der alte Mann verließ das Zimmer und <w>brummte</w> einige unverständliche Worte vor sich hin.",
                                "es": "El anciano salió de la habitación <w>refunfuñando</w> unas palabras ininteligibles.",
                                "zh": "老人<w>嘟囔</w>着几句听不清的话，离开了房间。",
                                "ru": "Старик вышел из комнаты, <w>ворча</w> себе под нос несколько невнятных фраз."
                            }
                        },
                        {
                            "text": "Il continue de <w>gronder</w> tout seul quand les choses ne se passent pas comme prévu.",
                            "target_lang_translations": {
                                "en": "He keeps <w>grumbling</w> to himself when things don't go as planned.",
                                "de": "Er <w>murrt</w> weiter vor sich hin, wenn die Dinge nicht so laufen wie geplant.",
                                "es": "Sigue <w>refunfuñando</w> solo cuando las cosas no salen como estaba previsto.",
                                "zh": "计划落空的时候，他总是一个人<w>咕哝</w>个没完。",
                                "ru": "Когда всё идёт не по плану, он продолжает <w>ворчать</w> себе под нос."
                            }
                        }
                    ],
                    "synonyms": [
                        "parler dans sa barbe"
                    ],
                    "target_lang_definitions": {
                        "en": "To express discontent by muttering quietly; to grumble.",
                        "de": "Seinen Unmut leise und undeutlich vor sich hin äußern.",
                        "es": "Expresar disgusto murmurando en voz baja, casi sin articular.",
                        "zh": "低声含糊地抱怨，表达心中的不满。",
                        "ru": "Выражать недовольство, тихо и невнятно бормоча себе под нос."
                    },
