                    },
                    {
                        "translation_id": "f2ee99a6-c493-4d18-9585-f5d001d0c20f",
                        "source_entry_id": "d59eafea-4c91-3082-8449-7b417aaeddfa",
                        "target_lang_word": "gekakel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
