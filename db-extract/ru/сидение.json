                                        "entry_id": "888c46ab-54a2-3f52-84dd-c2d2893718c8",
                                        "glosses": [
                                            "A period during which one is seated for a specific purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bb4ccb-2839-4a6c-8bc0-925294231a0d",
                                                "sense_id": "ee10669a-df2f-3bbd-a139-f6a191fd6490",
                                                "text": "Due to the sheer volume of guests, we had to have two sittings for the meal."
                                            },
                                            {
                                                "example_id": "1774b3d5-cbb6-4d29-a0dc-989973eacbce",
                                                "sense_id": "ee10669a-df2f-3bbd-a139-f6a191fd6490",
                                                "text": "The Queen had three sittings for her portrait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc019e2-0f9c-3570-9908-5b21e63990d3",
