                "forms": [],
                "senses": [
                    {
                        "sense_id": "75324878-b896-35fd-a7cf-667f3891be3e",
                        "entry_id": "6bf09ffc-af96-3531-bcf6-23b3ffa97f84",
                        "glosses": [
                            "prawie całkowita albo zupełna ciemność"
                        ],
                        "tags": [
                            "elevatedly"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5fa18707-cea5-3b75-9601-b5dad402dfe2",
                        "entry_id": "6bf09ffc-af96-3531-bcf6-23b3ffa97f84",
                        "glosses": [
                            "przeszkoda w dotarciu, poznaniu, zrozumieniu czegoś"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b59f1496-c7ff-4da2-9441-d06e2201f9b0",
                        "source_entry_id": "6bf09ffc-af96-3531-bcf6-23b3ffa97f84",
                        "source_sense_id": "75324878-b896-35fd-a7cf-667f3891be3e",
                        "target_lang_word": "darkness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darkness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The state of being dark; lack of light; the absolute or comparative absence of light."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc5dd6d-0168-480b-a692-441bc0818d9f",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "The darkness of the room made it difficult to see."
                                            },
                                            {
                                                "example_id": "478bcd1c-8307-4a19-8bbe-6b8e190ba5bd",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Over everything was darkness and thick silence, and the smell of dust and sunflowers."
                                            },
                                            {
                                                "example_id": "df021b4d-0341-418b-bef7-70fd35b6eedd",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "b45c5c6d-9691-4d28-94f5-72e95b6861db",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Darkness imprisoning me\n All that I see\n Absolute horror\n I cannot live\n I cannot die\n Trapped in myself\n Body my holding cell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The state or quality of reflecting little light, of tending to a blackish or brownish color."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abdc95b-70e7-4e2f-b100-498424147bd7",
                                                "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                                                "text": "The darkness of her skin betrayed her Mediterranean heritage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6832ef4-ce1b-3c5f-aeff-d93397add0e4",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Any space that such colour pervades."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18de698d-1764-4bf2-b6d4-4b9f478ed08a",
                                                "sense_id": "c6832ef4-ce1b-3c5f-aeff-d93397add0e4",
                                                "text": "Out of the darkness came some flickers of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf2789d-7895-3a51-ac46-ff5be5a46ab7",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Gloom; gloominess; depression."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd9f8091-afe3-35e2-bb40-64f86dce0658",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The product of being dark."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fe64d93-e6ea-3479-b33e-67a96ac5f23b",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Lack of understanding or compassion; spiritual or mental blindness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f3857d-6d43-47c4-923b-56651316e284",
                                                "sense_id": "3fe64d93-e6ea-3479-b33e-67a96ac5f23b",
                                                "text": "And now, the prophecy. One will come, the voice from the outer world, bringing the holy war, the jihad, which will cleanse the universe and bring us out of darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cedf43a2-b62c-3ffc-9687-e7161d07a83a",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Secrecy; concealment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Lack of knowledge; obscurity or meaning or intelligibility; the unknown."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313628f3-a4a4-401f-babd-169003d81dda",
                                                "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                                                "text": "It was just robbery with violence, aggravated murder on a great scale, and men going at it blind - as is very proper for those who tackle a darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e410a3-c7b7-3e4b-9abe-44384fd69c04",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Nothingness, vanity, emptiness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "771b2ff7-163c-4c9b-bef4-55b8a96d5bab",
                                                "sense_id": "f1e410a3-c7b7-3e4b-9abe-44384fd69c04",
                                                "text": "My own dim life should teach me this,\n⁠That life shall live for evermore,\n⁠Else earth is darkness at the core,\nAnd dust and ashes all that is; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Hell."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bec5df3-5a1c-448d-90c1-88099f242fef",
                                                "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                                                "text": "Shepard: Can you tell me anything about the beacon?\nDr. Warren: It's some type of data module from a galaxy-wide communications network. Remarkably well-preserved. It could be the greatest scientific discovery of our lifetime!\nDr. Warren: Miraculous new technologies. Groundbreaking medical advances. Who knows what secrets are locked inside?\nDr. Manuel: We have unearthed the heart of evil. Awakened the beast. Unleashed the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8379a444-97d3-476c-8248-5fb85ac83e12",
                        "source_entry_id": "6bf09ffc-af96-3531-bcf6-23b3ffa97f84",
                        "source_sense_id": "75324878-b896-35fd-a7cf-667f3891be3e",
                        "target_lang_word": "Dämmerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dämmerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                        "entry_id": "72d46aaf-fa49-3def-b210-bec63b91552d",
                                        "glosses": [
                                            "ein Lichtphänomen aufgrund des Sonnenlichts; der Übergang zwischen Tag und Nacht (unmittelbar nach Sonnenuntergang) oder umgekehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2279a9-19aa-49f6-9a53-53e00ad51936",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "Als sie aus dem Haus ging, war die Dämmerung bereits hereingebrochen."
                                            },
                                            {
                                                "example_id": "1d5fcf22-7207-43b0-9ecd-3a21ae1911d9",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung kroch langsam über den Berg.“"
                                            },
                                            {
                                                "example_id": "31455010-9fd1-4c8a-ac4b-c05c12d4900f",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung schlich in die Grabenwinkel.“"
                                            },
                                            {
                                                "example_id": "69d9e3f1-dc91-43fb-a0d8-21eaa20e2c54",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung setzt ein, der Abendhimmel wird milchig.“"
                                            },
                                            {
                                                "example_id": "2e0595c4-063c-47ed-a453-4fd6768f0fa6",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Frieda, durch ihre Märsche nach Glowitz ermutigt, hat in der Dämmerung die Schwester heimlich besucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63fa38ec-32c1-4039-a96a-75f39804993c",
                        "source_entry_id": "6bf09ffc-af96-3531-bcf6-23b3ffa97f84",
                        "source_sense_id": "75324878-b896-35fd-a7cf-667f3891be3e",
                        "target_lang_word": "мрак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мрак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b60d8c-4ac0-37cb-ac71-674eecef17b6",
                                        "entry_id": "40a5cdfa-a7a0-37c5-b0ad-51d50fb1b838",
                                        "glosses": [
                                            "отсутствие света, освещения; темнота"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f5ee72-a379-4702-8a33-286a4e579692",
                                                "sense_id": "d7b60d8c-4ac0-37cb-ac71-674eecef17b6",
                                                "text": "Арктика раскрывалась перед нами в своем истинном свете — страны мрака, холода, голого камня и льда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdfe6da0-b363-3353-9668-420feeff76a2",
                                        "entry_id": "40a5cdfa-a7a0-37c5-b0ad-51d50fb1b838",
                                        "glosses": [
                                            "перен. безотрадность, безнадежность"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da50af21-8aa8-402a-be38-c4a56b78b62d",
                        "source_entry_id": "6bf09ffc-af96-3531-bcf6-23b3ffa97f84",
                        "source_sense_id": "5fa18707-cea5-3b75-9601-b5dad402dfe2",
                        "target_lang_word": "Dunkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dunkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd90049b-ef18-36dd-813a-72243703c61b",
                                        "entry_id": "0fb6eb07-20b0-3d4e-a824-0b7a6c0701fa",
                                        "glosses": [
                                            "lichtarmer oder völlig lichtloser Zustand, in dem sich etwas befindet oder der etwas auszeichnet"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0998bc22-6e74-49ac-9f16-822344dc63af",
                                                "sense_id": "cd90049b-ef18-36dd-813a-72243703c61b",
                                                "text": "Im Dunkel dieses Zimmers kann man das Fürchten kriegen."
                                            },
                                            {
                                                "example_id": "838b34d8-1717-4b98-bcaf-b8867eb94c8d",
                                                "sense_id": "cd90049b-ef18-36dd-813a-72243703c61b",
                                                "text": "Das Dunkel der Nacht war so undurchdringlich, dass wir unzählige Male vom Weg abkamen."
                                            },
                                            {
                                                "example_id": "727240fb-5f65-4f9c-9c88-78e0c15c3f00",
                                                "sense_id": "cd90049b-ef18-36dd-813a-72243703c61b",
                                                "text": "Schon bald hüllte uns das Dunkel des Waldes ein."
                                            },
                                            {
                                                "example_id": "1bbbd30e-e641-46fd-810a-defb572d2171",
                                                "sense_id": "cd90049b-ef18-36dd-813a-72243703c61b",
                                                "text": "Ganz unerwartet brach das Dunkel der Nacht über uns herein."
                                            },
                                            {
                                                "example_id": "1ba4f656-3903-4b0c-a380-8649ae64676b",
                                                "sense_id": "cd90049b-ef18-36dd-813a-72243703c61b",
