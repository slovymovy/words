                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alimonious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "413a986c-70de-36aa-a5eb-1882ffc7dc64",
                                        "entry_id": "b2ca01ab-036c-3c79-bdf0-bf70ed2f8b89",
                                        "glosses": [
                                            "Affording food; nourishing."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620a7343-70cf-450b-85c8-069b7cff7f9f",
                                                "sense_id": "413a986c-70de-36aa-a5eb-1882ffc7dc64",
                                                "text": "The vital fluid is soon separated into its constituent elements, and the serous, saline, and albuminous portions of it are profusely poured from the system, through the toneless myriads of the patulous extreme vessels of the alimonious region; […]"
                                            },
                                            {
                                                "example_id": "088f262f-784e-47d2-9e47-e5d718e3449a",
                                                "sense_id": "413a986c-70de-36aa-a5eb-1882ffc7dc64",
                                                "text": "The plethora renders us lean, by suppressing our spirits, whereby they are incapacitated of digesting the alimonious humours into flesh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ab037d-edd1-3b12-a10a-75755ce3f47c",
                                        "entry_id": "b2ca01ab-036c-3c79-bdf0-bf70ed2f8b89",
                                        "glosses": [
                                            "Of or related to alimony or divorce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1baa3ec-8230-45d5-89fe-39c9b8a2e388",
                                                "sense_id": "c7ab037d-edd1-3b12-a10a-75755ce3f47c",
                                                "text": "She forgets that of the thirty-eight judges of the districts courts, who alone have jurisdiction in alimonious matters, there is not one but would like to do her a personal kindness; and if any one of them ever gets into a divorce suit, on either side of the controversy, she will then know that the judge takes such a grip on her faithless and miserable husband's throat that he cannot breathe unless he stands up straight and gets all the kinks out of his windpipe, and even then with a forced draft he must give it his closest attention."
                                            },
                                            {
                                                "example_id": "8f4ff7bf-ca2f-4004-b4ce-d11128b1d5fc",
                                                "sense_id": "c7ab037d-edd1-3b12-a10a-75755ce3f47c",
                                                "text": "They counseled one another on all matters alimonious, their nannies competed over their charges, and they passed as friends in a world where to copy the same dinner table arrangement was to be frozen out of the set."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
