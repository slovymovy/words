                                    {
                                        "sense_id": "6a76e201-6ffa-3b27-b6d4-3589b1fa989e",
                                        "entry_id": "ae1b2ec3-dc6b-3225-8c4f-864096110881",
                                        "glosses": [
                                            "liquore molto prezioso, spesso zuccherino"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
