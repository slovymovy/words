                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dcacda-7279-4857-93c9-cf6bc776ca85",
                                "sense_id": "3757f016-f056-3424-848a-5623feae46d5",
                                "text": "Viens me voir ma belle pouliche !"
                            },
                            {
                                "example_id": "41646234-8a3c-43fb-af74-19d27691ad74",
                                "sense_id": "3757f016-f056-3424-848a-5623feae46d5",
                                "text": "Je n’ai pas réussi à obtenir le numéro de portable de cette jolie pouliche."
                            },
                            {
                                "example_id": "baa5564d-d4aa-4762-90bb-aa4d2a2bb8e8",
                                "sense_id": "3757f016-f056-3424-848a-5623feae46d5",
                                "text": "Salut les pouliches."
                            }
                        ]
