                "senses": [
                    {
                        "sense_id": "3bfa0bbb-b6e4-3e25-8936-124070df975a",
                        "entry_id": "8dfa40c8-d28e-3162-8ebd-b8acf177608a",
                        "glosses": [
                            "mit Batik gefärbtes T-Shirt"
