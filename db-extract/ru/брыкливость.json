                "senses": [
                    {
                        "sense_id": "9904c844-853b-3159-8315-5e7b4f0f5ddd",
                        "entry_id": "562e81c5-3df1-3772-81f8-fe248cb5700d",
                        "glosses": [
                            "привычка брыкаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf67c15-dd22-477a-8e57-306c20b7ae39",
                                "sense_id": "9904c844-853b-3159-8315-5e7b4f0f5ddd",
                                "text": "В обращении со скотом Дымка смыслил теперь немногим меньше, чем старые ковбойские лошади того же табуна. Одно не вязалось с рекордом - брыкливость."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dbab0aa-28a6-34be-813f-d0bf5a65cf85",
                        "entry_id": "562e81c5-3df1-3772-81f8-fe248cb5700d",
                        "glosses": [
                            "перен. строптивость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b66ee3e-d5db-45ba-8cfb-d415ad7bbaf7",
                                "sense_id": "8dbab0aa-28a6-34be-813f-d0bf5a65cf85",
                                "text": "Господа, ― как бы спохватился он вдруг, ― вы на меня не ропщите за мою брыкливость, опять прошу: поверьте еще раз, что я чувствую полную почтительность и понимаю настоящее положение дела."
                            }
                        ]
                    }
