                        "sense_id": "51805871-8bbd-3f86-bee2-8c0d7c4bb3c1",
                        "entry_id": "cffd2659-bb73-3d2b-b0b7-99150f3a2eb0",
                        "glosses": [
                            "Carrière d’où l’on tire le marbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e742c72-33c6-4e58-942b-c2cd890fda62",
                                "sense_id": "51805871-8bbd-3f86-bee2-8c0d7c4bb3c1",
                                "text": "Dans la principauté de Blankenbourg, on trouve une marbrière , une fabrique de cobalt, quatre hauts-fourneaux et plusieurs forges, martinets et fours à chaux et à plâtre."
                            },
                            {
                                "example_id": "4c244647-e2cd-4958-b591-c3972cd98056",
                                "sense_id": "51805871-8bbd-3f86-bee2-8c0d7c4bb3c1",
                                "text": "Ces fonts baptismaux étaient faits d'une espèce de marbre rouge, marqueté de plusieurs veines de diverses couleurs; ce marbre avait été tiré d'une marbrière située au-dessus de Maxainville, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d7bbfd4-6875-3c73-b5de-456b778c0258",
                        "entry_id": "cffd2659-bb73-3d2b-b0b7-99150f3a2eb0",
                        "glosses": [
                            "Celle qui travaille le marbre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
