                "senses": [
                    {
                        "sense_id": "b8fa7d7d-ff29-30c6-84ca-ef3481f628f1",
                        "entry_id": "5a1b0f0a-1728-31f9-9ea0-08b785c7a300",
                        "glosses": [
                            "eine seitlich im Kirchenschiff errichtete Kapelle oder einzelnes Objekt einer stiftenden Familie"
                        ],
                        "tags": [
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "83a9a3fa-4212-4e50-99be-9fbbb352fd03",
                                "sense_id": "b8fa7d7d-ff29-30c6-84ca-ef3481f628f1",
                                "text": "„Der Auftrag stammt von Kardinal Marcus Sitticus Altemps in seiner Familienkapelle in der Basilika Santa Maria in Trastevere, die er zwischen 1584 und 1589 durch Martino Longhi (der auch den Emser Palast erbaute) links der Apsis errichten ließ.“"
                            },
                            {
                                "example_id": "466da4c9-e58d-453b-906d-26d883e23fe6",
                                "sense_id": "b8fa7d7d-ff29-30c6-84ca-ef3481f628f1",
                                "text": "„Die Familienkapelle Weiss in Bruckmühl wurde im klassizistischen Stil Ende des 19. Jahrhunderts erbaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c39b3737-8428-372c-800b-a8d0ed2b4a20",
                        "entry_id": "5a1b0f0a-1728-31f9-9ea0-08b785c7a300",
                        "glosses": [
                            "Musik: kleines, privates Musiker-Ensemble einer Familie, die Hausmusik spielt, macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6accbdd3-aac0-445c-b644-d45c91b81712",
                                "sense_id": "c39b3737-8428-372c-800b-a8d0ed2b4a20",
                                "text": "„ So vereinten sich 1988 zwei unterschiedliche musikalische Wege, womit beste Bedingungen für das Entstehen einer Familienkapelle gegeben waren“"
                            },
                            {
                                "example_id": "fb4e63eb-d6a8-41c7-a8ee-cc4010c2baae",
                                "sense_id": "c39b3737-8428-372c-800b-a8d0ed2b4a20",
                                "text": "„Die Familienkapelle will mit beliebten Melodien und Schlagern der 40er und 50er Jahre auf eine Zeitreise in die Vergangenheit entführen und die Besucher zum Tanzen bringen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
