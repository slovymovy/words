                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4233172-dbd5-37e9-9e3a-e5560da31a79",
                                        "entry_id": "2d99d2ed-c141-31cf-9049-9f62114305d0",
                                        "glosses": [
                                            "auf geschickte und verdeckte Art und Weise eigennützig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5071482-5365-41a2-9030-1edb95c942fd",
                                                "sense_id": "c4233172-dbd5-37e9-9e3a-e5560da31a79",
                                                "text": "Er war schon immer ein verschlagener Bursche."
                                            },
                                            {
                                                "example_id": "abb53676-3b01-4003-ad99-ea011a467f53",
                                                "sense_id": "c4233172-dbd5-37e9-9e3a-e5560da31a79",
                                                "text": "„Nicht anonyme Mächte – Menschen machen Geschichte. Es hängt entscheidend viel davon ab, ob die politisch Verantwortlichen aufrichtig oder verschlagen miteinander umgehen, ob sie es darauf anlegen, ihr Gegenüber zu vernichten, oder ob sie auf nachhaltige Partnerschaft aus sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "faf46ef0-269f-370b-8f78-4b413d2b6e50",
                                        "entry_id": "2d99d2ed-c141-31cf-9049-9f62114305d0",
                                        "glosses": [
                                            "geringfügig angewärmt, bei Wasser zum Beispiel weniger als handwarm, sogar weniger als lauwarm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a44bf7-aefe-45c8-a0f8-9c866a7a9844",
                                                "sense_id": "faf46ef0-269f-370b-8f78-4b413d2b6e50",
                                                "text": "„Auch in einigen Ställen Deutschlands ist es gebräuchlich geworden, die Pferde nach jedem Dienste mit verschlagenem Wasser zu waschen, sie danach gut abzutrocknen und einzudecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "verschlagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "151efeb7-88a9-3c43-bcdb-fe0e24e1df93",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
                                            "versehentlich die aktuell beachtete Seite eines Buches zuschlagen und eine andere aufschlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afabd7b-be24-4a95-99ef-fb56f0da9dac",
                                                "sense_id": "151efeb7-88a9-3c43-bcdb-fe0e24e1df93",
                                                "text": "Au, jetzt habe ich die Seite verschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6c0e045-4ee1-3bcf-82bb-a35c878b9835",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
                                            "an eine Stelle geraten, an die man ursprünglich nicht hinkommen wollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb9bd427-70f5-4cc9-b841-5bcb19bde244",
                                                "sense_id": "c6c0e045-4ee1-3bcf-82bb-a35c878b9835",
                                                "text": "Viele Deutsche hat es im letzten Weltkrieg nach Übersee verschlagen."
                                            },
                                            {
                                                "example_id": "e14ca40e-f84c-48e7-9aaa-c09176f10a4c",
                                                "sense_id": "c6c0e045-4ee1-3bcf-82bb-a35c878b9835",
                                                "text": "Wie hat es denn dich hierhin verschlagen?"
                                            },
                                            {
                                                "example_id": "1a39ce62-fb1a-4acf-a2d3-c891eccb79e4",
                                                "sense_id": "c6c0e045-4ee1-3bcf-82bb-a35c878b9835",
                                                "text": "„Zum Radio hat es mich verschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "606bcfaa-fd6d-3dcf-8cd3-e3be584c4b26",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
                                            "jemandem mit Schlägen körperliche Schmerzen zufügen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6a52bb-197e-49f1-b14f-61b24dd61886",
                                                "sense_id": "606bcfaa-fd6d-3dcf-8cd3-e3be584c4b26",
                                                "text": "Lass uns ihn verschlagen gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b0fcb80d-8a64-3b28-bf2d-82a87ae235aa",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
                                            "abrupt dafür sorgen, dass etwas nicht mehr ist"
                                        ],
                                        "tags": [
                                            "jemandem etwas verschlagen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b413c17-368b-4245-8220-63e721d5c366",
                                                "sense_id": "b0fcb80d-8a64-3b28-bf2d-82a87ae235aa",
                                                "text": "Es verschlägt mir die Sprache!"
                                            },
                                            {
                                                "example_id": "3a991d8d-e986-498d-b343-600a1b6c36ca",
                                                "sense_id": "b0fcb80d-8a64-3b28-bf2d-82a87ae235aa",
                                                "text": "Der Geruch verschlug ihnen den Appetit."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "bdfec9d3-e125-3e30-8d38-4f06a029e8b2",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
                                            "einen Ball so treffen, dass er nicht dort landet, wo geplant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5c7ace-b3ee-4687-b8a7-83059733f0d5",
                                                "sense_id": "bdfec9d3-e125-3e30-8d38-4f06a029e8b2",
                                                "text": "Sie verschlägt den Ball, der knapp im Aus landet."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "5c21142f-f887-3fcd-a7f2-005344a8cdb4",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
                                            "eine flüssige Masse mit einer Gabel oder einem Schneebesen mit etwas anderem vermischen"
                                        ],
                                        "tags": [
                                            "Kochen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00769f6-daca-41c1-8d49-afba049265e5",
                                                "sense_id": "5c21142f-f887-3fcd-a7f2-005344a8cdb4",
                                                "text": "Verschlagen Sie die Eier mit dem Zucker."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "edc9080e-b18e-3ee3-9167-fea7b6e00df2",
                                        "entry_id": "467bb7dd-0f5a-3f55-a45e-8d862aa040f7",
                                        "glosses": [
