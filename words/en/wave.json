        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "288f7896-5181-300e-8d13-ac390fc65eb0",
                    "sense_definition": "To move one's hand back and forth to say hello, goodbye, or to attract attention.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hand_gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>waved</w> goodbye from across the room.",
                            "target_lang_translations": {
                                "ru": "Я <w>помахал</w> на прощание с другого конца комнаты.",
                                "zh": "我在房间对面<w>挥手</w>告别。"
                            }
                        },
                        {
                            "text": "She <w>waved</w> at the taxi driver to stop.",
                            "target_lang_translations": {
                                "ru": "Она <w>махнула</w> таксисту, чтобы он остановился.",
                                "zh": "她向出租车司机<w>挥手</w>示意停车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wave goodbye",
                        "wave hello",
                        "wave at someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать рукой из стороны в сторону в знак приветствия, прощания или для привлечения внимания.",
                        "zh": "来回摆动手部以打招呼、告别或引起注意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "рукой"
                            },
                            {
                                "target_lang_word": "помахать",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥手",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56e2a411-92bb-3d79-803a-ce7e35191f0f",
                    "sense_definition": "To move gently back and forth in the air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flag <w>waved</w> in the gentle breeze.",
                            "target_lang_translations": {
                                "ru": "Флаг <w>развевался</w> на легком ветру.",
                                "zh": "旗帜在微风中<w>飘动</w>。"
                            }
                        },
                        {
                            "text": "Tall grass <w>waved</w> in the field as the wind blew.",
                            "target_lang_translations": {
                                "ru": "Высокая трава <w>колыхалась</w> в поле, когда дул ветер.",
                                "zh": "风吹过时，田野里的高草随风<w>摇曳</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wave in the wind",
                        "wave in the breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавно двигаться из стороны в сторону в воздухе.",
                        "zh": "在空气中平缓地来回摆动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развеваться",
                                "target_lang_sense_clarification": "о флаге, волосах"
