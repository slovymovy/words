                        "entry_id": "a75e0a99-94d9-37ec-a562-d5a97c3c22ce",
                        "glosses": [
                            "incentive, motivation, mainspring (something, usually physical, that motivates)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "cc14071c-c214-47db-801b-381b5fd7ca66",
                                "sense_id": "12d1705b-2f37-34e2-ad5c-9796ec0663c5",
                                "text": "Indien de deugd de voornaamſte drijfveer is, die alle de raderen eener Gemeenebest-Regeering, — volgends MONTESQUIEU — in werking moet brengen, — dan is zeker Hij, die de meeste waare deugd bezit, de beste Patriot, de ſterkſte ſteun van het Vaderland en het algemeen geluk.",
                                "translation": "If virtue is indeed the mainspring driving the whole mechanism of a Commonwealth Government - as MONTESQUIEU has it - then He who truly possesses most virtue is the best Patriot, the strongest support of the Fatherland and the common good.",
                                "english": "If virtue is indeed the mainspring driving the whole mechanism of a Commonwealth Government - as MONTESQUIEU has it - then He who truly possesses most virtue is the best Patriot, the strongest support of the Fatherland and the common good."
                            }
                        ]
                    }
