                        "entry_id": "b02e2abb-012b-305d-8595-7fd1f7bcfd09",
                        "glosses": [
                            "A storm in which there are strong, violent winds but no precipitation."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "204479ed-7cbc-476b-8dfd-0fc28384c5eb",
                        "source_entry_id": "b02e2abb-012b-305d-8595-7fd1f7bcfd09",
                        "source_sense_id": "22847d24-c095-37b2-9d9b-f736f0afe245",
                        "source_sense_description": "storm with strong violent winds",
                        "target_lang_word": "Orkan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orkan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                        "entry_id": "e8c67bc8-189f-396b-9c74-341f9ec5974a",
                                        "glosses": [
                                            "(durch ein außertropisches Tiefdruckgebiet entstandener) Sturm der zwölften Stufe der Beaufort-Skala; äußerst heftiger Sturm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e153cb-08d2-43d4-965c-c0dd94860c97",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "Das gesamte Dorf musste wegen eines Orkanes evakuiert werden."
                                            },
                                            {
                                                "example_id": "d6b20ff7-f09f-47fc-a5e1-5c497d50abb7",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Der Orkan war vorübergezogen, der Himmel grau, und es regnete schwach.“"
                                            },
                                            {
                                                "example_id": "4a4597f8-ff73-492f-9576-9a0244ca0016",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Hier also gingen wir wegen eines gewaltigen Orkans oder Wirbelsturms, der uns in große Gefahr brachte, vor Anker.“"
                                            },
                                            {
                                                "example_id": "0f5007a4-af91-4f19-8864-c2a58289dc35",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Am Tag flaute der Orkan nach und nach ab.“"
                                            },
                                            {
                                                "example_id": "32a29e0c-e708-49af-8547-e8e7b7452f2f",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Ein gelles, ungeheures Pfeifen wird im nächsten Augenblick anheben und durch ganz Rom gehen, ein Orkan von Hohn und Gelächter.“"
                                            },
                                            {
                                                "example_id": "dbb96663-74b3-47ed-982f-13d4f3fbe6b2",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Und dann war ein Orkan wilder Wut über ihm zusammengeschlagen.“"
                                            },
                                            {
                                                "example_id": "79ffc901-751f-4d29-a4e0-bf54960ffdd5",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Sicherlich, es wäre nur ein kleiner Sieg gewesen, eine rasch verwehende Tat, morgen ausgelöscht im Orkan der Niederlage - aber er hätte genügt, hätte den Staatsstreich in ein für alle sichtbares Blutbad verwandelt und den Schein der ‚Ordnung‘ zerstört.“"
                                            },
                                            {
                                                "example_id": "b080d377-37c1-44d1-aca6-7aab6299cd30",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Wie Hagel auf ein Kornfeld drosch er auf sie ein, wie ein Orkan zerstäubte er das Geluder und ersäufte es in einer riesigen reinigenden Sintflut destillierten Wassers.“"
                                            },
                                            {
                                                "example_id": "0e63d60d-e166-438a-98d7-44c261818207",
                                                "sense_id": "d42413d2-23fa-354b-9a6b-3f7177a6bc6a",
                                                "text": "„Wenn also die Männer der Französischen Revolution sagen, daß alle Macht beim Volk liegt, so verstehen sie unter Macht eine Art Naturkraft außerhalb des politischen Bereichs, deren ungeheure Gewalt erst durch die Revolution entbunden wird, um dann wie ein Orkan alle Institutionen des Ancien Régime wegzufegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
