{
    "word_family": [
        "scrounger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f0a011c-c49c-3267-89b1-2e3c6a6ec85d",
                    "sense_definition": "To obtain something, especially food, money, or small items, from someone else without paying or working for it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obtain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>scrounge</w> a cigarette from one of his coworkers outside.",
                            "target_lang_translations": {
                                "nl": "Het lukte hem om buiten een sigaret te <w>bietsen</w> van een van zijn collega's."
                            }
                        },
                        {
                            "text": "As long as he has friends to <w>scrounge</w> off, he will never find a job.",
                            "target_lang_translations": {
                                "nl": "Zolang hij vrienden heeft om op te <w>klaplopen</w>, zal hij nooit een baan vinden."
                            }
                        }
                    ],
                    "synonyms": [
                        "cadge",
                        "sponge",
                        "freeload",
                        "mooch",
                        "bum"
                    ],
                    "common_phrases": [
                        "scrounge off"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe obtaining items or favors from others"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets (zoals eten, geld of kleine spullen) van iemand anders verkrijgen zonder ervoor te betalen of te werken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bietsen",
                                "target_lang_sense_clarification": "informeel om kleine dingen zoals sigaretten vragen"
                            },
                            {
                                "target_lang_word": "schooien",
                                "target_lang_sense_clarification": "bedelen of meeprofiteren van anderen"
                            },
                            {
                                "target_lang_word": "klaplopen",
                                "target_lang_sense_clarification": "op andermans zak teren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f1624f-59d5-3b1d-bfac-3e71c4ff28e2",
                    "sense_definition": "To search around in various places to find or collect something that is needed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "forage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>scrounge</w> for food in the nearly empty kitchen cabinets.",
                            "target_lang_translations": {
                                "nl": "We moesten in de bijna lege keukenkastjes naar eten <w>scharrelen</w>."
                            }
                        },
                        {
                            "text": "She managed to <w>scrounge</w> up enough spare change to buy a bus ticket.",
                            "target_lang_translations": {
                                "nl": "Ze slaagde erin genoeg kleingeld <w>bij elkaar te scharrelen</w> om een buskaartje te kopen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scrounge for",
                        "scrounge up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used informally for rummaging or foraging"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Overal rondzoeken om iets wat je nodig hebt te vinden of bijeen te sprokkelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bij elkaar scharrelen",
                                "target_lang_sense_clarification": "met moeite of zoekend bijeenbrengen"
                            },
                            {
                                "target_lang_word": "bijeensprokkelen",
                                "target_lang_sense_clarification": "kleine beetjes verzamelen"
                            },
                            {
                                "target_lang_word": "scharrelen",
                                "target_lang_sense_clarification": "zoekend rondsnuffelen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "662603f9-8c31-3e55-8a2e-4e84613af204",
                    "sense_definition": "A person who habitually borrows or obtains things from others without intending to return or pay for them.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to invite that <w>scrounge</w> to dinner because he never paid his share.",
                            "target_lang_translations": {
                                "nl": "Niemand wilde die <w>klaploper</w> uitnodigen voor het eten, omdat hij nooit zijn deel betaalde."
                            }
                        },
                        {
                            "text": "Stop being such a <w>scrounge</w> and buy your own cup of coffee.",
                            "target_lang_translations": {
                                "nl": "Houd op zo'n <w>bietser</w> te zijn en koop je eigen kop koffie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an informal term of disapproval"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die gewoonlijk spullen of geld van anderen leent of aftroggelt zonder de intentie te betalen of terug te geven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "klaploper",
                                "target_lang_sense_clarification": "profiteur die op kosten van anderen leeft"
                            },
                            {
                                "target_lang_word": "profiteur",
                                "target_lang_sense_clarification": "iemand die misbruik maakt van andermans vrijgevigheid"
                            },
                            {
                                "target_lang_word": "bietser",
                                "target_lang_sense_clarification": "iemand die steeds om kleine dingen vraagt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}