                "entry_id": "e239616f-345a-3bf3-8c4b-fbe493eae8fb",
                "word": "birdwatching",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c7f160a-e9d7-3539-b76a-64c59e989363",
                        "entry_id": "e239616f-345a-3bf3-8c4b-fbe493eae8fb",
                        "glosses": [
                            "Observing or identifying wild birds in their natural environment."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4c13f261-f0ff-3cac-8ee3-c3cb36bfb5f5",
                        "entry_id": "e239616f-345a-3bf3-8c4b-fbe493eae8fb",
                        "glosses": [
                            "The hobby of watching rocket launches."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9188a27a-a048-4e9f-84e1-826a683cb1f2",
                                "sense_id": "4c13f261-f0ff-3cac-8ee3-c3cb36bfb5f5",
                                "text": "In fact, on this night, the birdwatching is over for everyone, for the firing is cancelled. Nobody notifies birdwatchers officially, of course, so the exodus is scattered and gradual."
                            }
                        ]
                    },
                    {
                        "sense_id": "0faf724a-2ad4-38e9-b466-5561b767dace",
                        "entry_id": "e239616f-345a-3bf3-8c4b-fbe493eae8fb",
                        "glosses": [
                            "Girlwatching"
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "597407ff-d46c-49f9-a21b-db407fa46731",
                                "sense_id": "0faf724a-2ad4-38e9-b466-5561b767dace",
                                "text": "By the spring of 1968, they were the secular-singing O'Kaysion, and they had recorded a leering lyric about ogling babes for the peewee Northstate label. Local DJs, appreciating that bird-watching was a popular pastime for their listeners, rode the number as if it had a satin saddle."
                            }
                        ]
                    }
                ],
