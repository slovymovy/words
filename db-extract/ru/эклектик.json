                        "source_sense_id": "b4f3ef4c-65d1-3a66-8318-17b54c378fee",
                        "target_lang_word": "éclectique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclectique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                                        "entry_id": "144d4f2c-7da8-3f7b-bd74-b010900db021",
                                        "glosses": [
                                            "Qui n’adopte pas une doctrine particulière mais choisit, dans les divers systèmes, les opinions qui lui paraissent les plus justes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1cafcae-63f7-49a9-a441-ad1d510f7fc2",
                                                "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                                                "text": "Un philosophe éclectique."
                                            },
                                            {
                                                "example_id": "82b2fbf1-cd08-4ef4-82fd-f14586f9908d",
                                                "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                                                "text": "La philosophie éclectique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                                        "entry_id": "144d4f2c-7da8-3f7b-bd74-b010900db021",
                                        "glosses": [
                                            "Qui est d’une disposition d’esprit non systématique, accueillante et qui adopte ce qui lui parait bon dans un ensemble d’idées, d’opinions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b0ccb75-d247-4ba9-b890-6cc5ad2e3915",
                                                "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                                                "text": "Éclectique en littérature, en peinture."
                                            },
                                            {
                                                "example_id": "2b1245ad-d309-42c1-9f46-10f0d7b65903",
                                                "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                                                "text": "Toby-Chien, devant nous, chasse, éclectique et inoffensif, le lapin, la mésange, la taupe et le grillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2f9cf6-e486-3bd0-a966-ebe1bdd370ce",
                                        "entry_id": "144d4f2c-7da8-3f7b-bd74-b010900db021",
                                        "glosses": [
                                            "Qui est fait d'éléments très divers."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d44006-ddbf-4328-b830-5f204a4e15f8",
                                                "sense_id": "ca2f9cf6-e486-3bd0-a966-ebe1bdd370ce",
                                                "text": "Paris est le seul lieu du monde où il existe de ces maisons éclectiques où tous les goûts, tous les vices, toutes les opinions sont reçus avec une mise décente"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éclectique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                        "entry_id": "c62cf9ef-f291-3316-a5df-de3b1792d115",
                                        "glosses": [
                                            "Personne qui n’adopte pas une doctrine particulière mais choisit, dans les divers systèmes, les opinions qui lui paraissent les plus justes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f898af-6322-4c4b-88e2-c58970014110",
                                                "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                                "text": "L’éclectique est un philosophe qui foulant aux piés le préjugé, la tradition, l’ancienneté, le consentement universel, l’autorité (...)"
                                            },
                                            {
                                                "example_id": "0e776b11-0f65-4dfc-8f1f-8f9276cd0b57",
                                                "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                                "text": "Or, vous avez entrepris cette tâche : donc vous êtes vous-même un éclectique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
