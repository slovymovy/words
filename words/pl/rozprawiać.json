                {
                    "sense_id": "b8a20002-ab66-3842-84d2-9969bbdad9ec",
                    "sense_definition": "długo i szczegółowo opowiadać o czymś, prowadzić dyskusję",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rozmowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przy kolacji dziadkowie godzinami <w>rozprawiali</w> o dawnych czasach.",
                            "target_lang_translations": {
                                "ru": "За ужином бабушка с дедушкой часами <w>рассуждали</w> о былых временах."
                            }
                        },
                        {
                            "text": "Eksperci lubią <w>rozprawiać</w> o przyszłości gospodarki, choć rzadko zgadzają się co do szczegółów.",
                            "target_lang_translations": {
                                "ru": "Эксперты любят <w>рассуждать</w> о будущем экономики, хотя редко приходят к согласию в деталях."
                            }
                        }
                    ],
                    "synonyms": [
                        "gawędzić",
                        "dyskutować"
                    ],
                    "common_phrases": [
                        "rozprawiać o czymś"
                    ],
                    "target_lang_definitions": {
                        "ru": "долго и подробно рассказывать о чем-либо, вести дискуссию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассуждать",
                                "target_lang_sense_clarification": "вести пространные разговоры о чем-то"
                            },
                            {
                                "target_lang_word": "беседовать",
                                "target_lang_sense_clarification": "вести разговор на определенную тему"
                            },
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "говорить много и часто утомительно для слушателя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18d6bc21-56ce-3d46-8add-8787d48c99b0",
                    "sense_definition": "rozstrzygać konflikt lub załatwiać porachunki, często przy użyciu siły",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "konflikt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mafia zawsze bezwzględnie <w>rozprawiała</w> się z tymi, którzy próbowali ją zdradzić.",
                            "target_lang_translations": {
                                "ru": "Мафия всегда безжалостно <w>расправлялась</w> с теми, кто пытался её предать."
                            }
                        },
                        {
                            "text": "Reżim brutalnie <w>rozprawia</w> się z każdym, kto odważy się protestować.",
                            "target_lang_translations": {
                                "ru": "Режим жестоко <w>расправляется</w> с каждым, кто осмелится протестовать."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozwodzić się"
                    ],
                    "common_phrases": [
                        "rozprawić się z kimś"
                    ],
                    "target_lang_definitions": {
                        "ru": "разрешать конфликт или сводить счеты, часто с применением силы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расправиться",
                                "target_lang_sense_clarification": "решительно устранить кого-то или что-то, часто силой"
                            },
                            {
                                "target_lang_word": "разобраться",
                                "target_lang_sense_clarification": "решить проблему или конфликт, часто жесткими методами"
                            }
                        ]
                    }
                }
            ]
