                    "frequency": "Low",
                    "semantic_group_id": "textiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleermaker liet een brede <w>inleg</w> over zodat de broek later langer gemaakt kon worden.",
                            "target_lang_translations": {
                                "en": "The tailor left a wide <w>hem allowance</w> so that the trousers could be lengthened later."
                            }
                        },
                        {
                            "text": "Dankzij de extra <w>inleg</w> in de rok kon deze eenvoudig worden vermaakt.",
                            "target_lang_translations": {
                                "en": "Thanks to the extra <w>inlay</w> in the skirt, it could be easily altered."
                            }
