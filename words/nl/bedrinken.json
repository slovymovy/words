                    "sense_definition": "iemand anders dronken maken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herbergiers probeerden de rijke koopman te <w>bedrinken</w> om hem te kunnen bestelen.",
                            "target_lang_translations": {
                                "ru": "Трактирщики пытались <w>споить</w> богатого купца, чтобы обокрасть его."
                            }
                        },
                        {
                            "text": "Het was zijn plan om zijn gasten snel te <w>bedrinken</w> met sterke wijn.",
                            "target_lang_translations": {
                                "ru": "В его планы входило быстро <w>напоить</w> гостей крепким вином."
                            }
