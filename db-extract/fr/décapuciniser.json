                "senses": [
                    {
                        "sense_id": "357170d0-8c5a-3dc9-afe7-c90203df253e",
                        "entry_id": "a87837a8-b189-3c1c-b3fc-690f9098ea9c",
                        "glosses": [
                            "Faire sortir de l’ordre des capucins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9460a67f-a239-42a9-8cce-24e46d670f06",
                                "sense_id": "357170d0-8c5a-3dc9-afe7-c90203df253e",
                                "text": "On ne vit bientôt plus qu’une solution à cet état de choses : faire passer le religieux d’un ordre dans un autre, le « décapuciniser »."
                            },
                            {
                                "example_id": "29ec686a-2896-4850-9b5d-ad5022ebb2ce",
                                "sense_id": "357170d0-8c5a-3dc9-afe7-c90203df253e",
                                "text": "Quelques années plus tard, le Baron intervient à nouveau et le fait “décapuciniser” pour éviter les “tracasseries monacales” dont le frère est l’objet (lettre du ler novembre 1767)."
                            }
                        ]
                    }
                ],
