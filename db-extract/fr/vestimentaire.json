                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab3a3d4-1b86-344d-8501-c2aaba3e0fdf",
                                        "entry_id": "058ce072-0f34-3015-96db-26ae062a7bd6",
                                        "glosses": [
                                            "Of or pertaining to clothing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "490125f5-23c7-4893-8d91-a83cbb412fca",
                                                "sense_id": "aab3a3d4-1b86-344d-8501-c2aaba3e0fdf",
                                                "text": "The consumerist age would, however, have the last laugh: his taste for vestimentary simplicity initiated a fashion trend which ended up with Marie-Antoinette and her milkmaid dresses."
                                            }
                                        ]
