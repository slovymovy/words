                "senses": [
                    {
                        "sense_id": "b4bf3303-5747-3bf7-bc16-6739ab9e4916",
                        "entry_id": "88bfce85-d448-3531-84e7-9bb9bd921c2a",
                        "glosses": [
                            "Abfolge/Einheit aus zwei Versen, meistens aus Hexameter plus Pentameter bestehend"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "6e228070-594b-4cf0-92f5-c3eb51c3ef91",
                                "sense_id": "b4bf3303-5747-3bf7-bc16-6739ab9e4916",
                                "text": "„Er sagte mir, es sei jammerschade, daß er in Padua weder das Distichon noch meine Antwort bekanntgeben könne.“"
                            },
                            {
                                "example_id": "af480bfe-7b05-42f5-9e77-c84f36b9a5f8",
                                "sense_id": "b4bf3303-5747-3bf7-bc16-6739ab9e4916",
                                "text": "„Das Distichon ist umlaufend, auf jeder Seite eingelassen ein goldenes Medaillon, für Sophie Brentano mit einem Schmetterling, für Anna Dorothea Wieland zwei verschränkte Hände, für Christoph Martin Wieland eine geflügelte Lyra mit einem Stern darüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5637fed4-4de8-4559-bc84-38d98ef9e770",
                        "source_entry_id": "88bfce85-d448-3531-84e7-9bb9bd921c2a",
                        "source_sense_id": "b4bf3303-5747-3bf7-bc16-6739ab9e4916",
                        "source_sense_description": "Literaturwissenschaft: Abfolge/Einheit aus zwei Versen (meistens Hexameter plus Pentameter)",
                        "target_lang_word": "distich",
