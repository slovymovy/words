                ],
                "senses": [
                    {
                        "sense_id": "3b2922cd-bd20-3b30-91db-979382ae5d3f",
                        "entry_id": "8d8678d0-1162-323e-8246-c1d17e12ceb2",
                        "glosses": [
                            "A face."
                        ],
                        "tags": [
                            "Polari",
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "512a624b-6152-483e-a897-baedec30ed8c",
                                "sense_id": "3b2922cd-bd20-3b30-91db-979382ae5d3f",
                                "text": "How bona to vada your eek!",
                                "translation": "How good to see your face!",
                                "english": "How good to see your face!"
                            },
                            {
                                "example_id": "c2ad28ed-b26e-4e2a-b558-0c486688043c",
                                "sense_id": "3b2922cd-bd20-3b30-91db-979382ae5d3f",
                                "text": "You have your Elizabeth Taylor done in half-tones, reclining on this chaise longue – that’s your actual French – decollete down to her ankles, with a wanton look all over her eek."
                            },
                            {
                                "example_id": "24d5e88d-e877-4199-86ac-ead700ed3c89",
                                "sense_id": "3b2922cd-bd20-3b30-91db-979382ae5d3f",
                                "text": "Though she's a bimbo bit of hard, / she’s royal and tart. And girl, you know / vadaing her eek is always bona."
                            },
                            {
                                "example_id": "f95f9428-3e87-4a99-bf5f-15ad91cd3975",
                                "sense_id": "3b2922cd-bd20-3b30-91db-979382ae5d3f",
                                "text": "[H]e plonked his corybungus down and turned his eek to the driver."
                            }
                        ]
                    }
                ],
