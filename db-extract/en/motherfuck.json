                "translations": [
                    {
                        "translation_id": "671a6eff-7217-4226-a72d-4f6d81d7e78a",
                        "source_entry_id": "c8f90d8e-de99-3704-86e0-4ebcfc9e01aa",
                        "source_sense_id": "748341b4-1110-38cd-b788-a8a6d1c16073",
                        "source_sense_description": "expression of surprise or the like",
                        "target_lang_word": "ёб твою мать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ёб твою мать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                        "entry_id": "047e8135-1a53-3aac-8083-3e757734547d",
                                        "glosses": [
                                            "обсц. восклицание удивления, раздражения, недовольства, злости и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac024297-985f-4a83-ab9f-553bb4e9acbb",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "По реке, по речке // Плыли две дощечки! // Эх, ёб твою мать, // Плыли две дощечки!"
                                            },
                                            {
                                                "example_id": "46879a76-83ef-40c1-8420-3234a89c025d",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— Говорят же тебе — не надо, ёб твою мать!"
                                            },
                                            {
                                                "example_id": "072bdbe4-c633-4ab2-a1bd-fe0083192fe4",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "И зовёт уже, очевидно, некоторое время, потому что голос злой. — Эд, ёб твою мать, где ты!"
                                            },
                                            {
                                                "example_id": "b8acab6c-1d13-42b9-a472-794f636bb274",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— Какая тебе к хую, ёб твою мать, автобаза?"
                                            },
                                            {
                                                "example_id": "2d3d663a-3722-4f38-9c0a-ed1702922df9",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— Ёб твою мать — он задаёт мне вопросы какие!"
                                            },
                                            {
                                                "example_id": "4c73db57-2b4d-4066-b2d3-37cf73469f07",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— А как с вами прикажете разговаривать, деятель вы от искусства, ёб твою мать!"
                                            },
                                            {
                                                "example_id": "df69db73-ab9b-465e-9fdc-06978a2a5f9c",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— Ёб твою мать, я тебя сколько раз просил шефом меня не называть?"
                                            },
                                            {
                                                "example_id": "6a7096d6-f097-43cb-9a44-5d59e123be2e",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "Ну, очень выёживающе-побудительное слово. — Ёб твою мать, мама! — говорит он."
                                            },
                                            {
                                                "example_id": "d2f41182-2cd8-4983-bb2b-0cbbfcdab80b",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— Блядь, сука, хуесос поганый, мы ещё встретимся, ёб твою мать…"
                                            },
                                            {
                                                "example_id": "d06125db-c1b7-4aea-b517-8df066bd5f0d",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "— С Новым годом, блядь, на хуй, ёб твою мать, с Новым годом, суки ёбаные, пиздюки недоделанные, гондоны незаштопанные!"
                                            },
                                            {
                                                "example_id": "55562003-9510-4551-8dce-0bcc41d88c9b",
                                                "sense_id": "0af8183c-2685-3387-ab0b-b2bab4d393a6",
                                                "text": "И пошло-поехало. За «ёб твою мать» — по ебалу. За «пидораса» — по ебалу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
