                                        "entry_id": "a1558907-b4f4-3e49-81e9-e07ccf8bee4b",
                                        "glosses": [
                                            "Strecke, die ein Flugzeug fliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019b75d8-7c81-4c54-a6a3-504a08b65d71",
                                                "sense_id": "be0ab72c-a281-32e8-965d-a9ac9897b5bf",
                                                "text": "Die Bürger demonstrieren gegen die geplanten Flugrouten."
                                            },
                                            {
                                                "example_id": "f393d222-dd37-4460-a95b-f49b1b6399f6",
                                                "sense_id": "be0ab72c-a281-32e8-965d-a9ac9897b5bf",
                                                "text": "„Die Retter waren gekommen und hatten nach ihm gesucht, weitab von der ursprünglichen Flugroute.“"
                                            },
                                            {
                                                "example_id": "5d1aee2f-25d3-41f4-ab36-22b74fa0a109",
                                                "sense_id": "be0ab72c-a281-32e8-965d-a9ac9897b5bf",
                                                "text": "„Das Ausmaß der zusätzlichen Strahlenbelastung beim Fliegen hängt vor allem von der Flugdauer, der Flughöhe, der Flugroute und der Sonnenaktivität ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
