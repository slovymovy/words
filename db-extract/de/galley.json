                        "examples": [
                            {
                                "example_id": "d1c095a7-10a7-4865-b195-e088af22278c",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Frau Galley ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7fbd3f60-ea60-4d9a-86d8-f7653c217702",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Herr Galley wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c7aeb3f9-56da-40ca-af47-81ef88caae57",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Die Galleys fahren heute nach Köln."
                            },
                            {
                                "example_id": "076ebaa0-833d-4c53-a099-c1e4c478d715",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Der Galley trägt nie die Schals, die die Galley ihm strickt."
                            },
                            {
                                "example_id": "f7585841-dbfe-446e-ad6f-e7fe800716b1",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Galley kommt, geht der Herr Galley.“"
                            },
                            {
                                "example_id": "d101d4fb-40c1-4af9-b895-01f07ba2de1d",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Galley kommt und geht."
                            },
                            {
                                "example_id": "8c6a695e-04c5-4b9d-b17e-f89e47652732",
                                "sense_id": "c6df4775-493e-3a7b-b60d-1c08f2a51164",
                                "text": "Galleys kamen, sahen und siegten."
                            }
                        ],
