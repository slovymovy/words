                    }
                ],
                "senses": [
                    {
                        "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                        "entry_id": "218fe74d-af66-3660-a09f-e540cf09ddcc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2898b5e-27bf-4510-85c5-58f8d7e9eb85",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Frau Stengel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eb6f1044-8420-4fc9-89b8-a3ea35437c2a",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Herr Stengel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1c53bdb2-0cd1-488e-a1ef-cb3665a296b0",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Die Stengels fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "57b40b81-89ab-4913-8ae5-a3584441d54e",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Der Stengel trägt nie die Pullover, die die Stengel ihm strickt."
                            },
                            {
                                "example_id": "1b5dfa93-273b-4596-a406-325d1876d713",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stengel kommt, geht der Herr Stengel.“"
                            },
                            {
                                "example_id": "050e392c-eab2-4b4c-9832-2eb687f5c42f",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Stengel kommt und geht."
                            },
                            {
                                "example_id": "610103cb-b733-40dc-adad-7db684e25ef2",
                                "sense_id": "0196ea9d-6433-3920-b7f9-9a391bc628a0",
                                "text": "Stengels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
