{
    "word_family": [
        "define",
        "definition",
        "definitive",
        "indefinite",
        "indefinitely",
        "definable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "591f3799-8ee4-3147-89bc-8ff733586559",
                    "sense_definition": "Free from any doubt; certain, clear, and unlikely to change.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a <w>definite</w> answer by the end of the day.",
                            "target_lang_translations": {
                                "ru": "Мне нужен <w>точный</w> ответ к концу дня.",
                                "tr": "Günün sonuna kadar <w>kesin</w> bir cevaba ihtiyacım var."
                            }
                        },
                        {
                            "text": "There has been a <w>definite</w> improvement in your work recently.",
                            "target_lang_translations": {
                                "ru": "В последнее время в вашей работе наблюдается <w>несомненное</w> улучшение.",
                                "tr": "Son zamanlarda işinde <w>belirgin</w> bir gelişme var."
                            }
                        }
                    ],
                    "synonyms": [
                        "unquestionable",
                        "certain",
                        "sure"
                    ],
                    "antonyms": [
                        "vague",
                        "nebulous",
                        "indefinite"
                    ],
                    "common_phrases": [
                        "definite answer",
                        "definite plan",
                        "definite proof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не вызывающий сомнений; точный, ясный и окончательный.",
                        "tr": "Her türlü şüpheden uzak; kesin, net ve değişmesi muhtemel olmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определённый",
                                "target_lang_sense_clarification": "твёрдо установленный, решённый"
                            },
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "не допускающий сомнений"
                            },
                            {
                                "target_lang_word": "несомненный",
                                "target_lang_sense_clarification": "очевидный, явный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kesin",
                                "target_lang_sense_clarification": "şüphe götürmeyen, net"
                            },
                            {
                                "target_lang_word": "net",
                                "target_lang_sense_clarification": "açık ve belirgin"
                            },
                            {
                                "target_lang_word": "belirgin",
                                "target_lang_sense_clarification": "gözle görülür, bariz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e5d4a28-a337-3416-9250-70e51b340983",
                    "sense_definition": "Having distinct limits, boundaries, or fixed dimensions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract is valid for a <w>definite</w> period of one year.",
                            "target_lang_translations": {
                                "ru": "Контракт действителен в течение <w>определённого</w> периода сроком в один год.",
                                "tr": "Sözleşme bir yıllık <w>belirli</w> bir süre için geçerlidir."
                            }
                        },
                        {
                            "text": "Liquids have a fixed volume but no <w>definite</w> shape.",
                            "target_lang_translations": {
                                "ru": "Жидкости имеют фиксированный объём, но не имеют <w>определённой</w> формы.",
                                "tr": "Sıvıların sabit bir hacmi vardır ancak <w>belirli</w> bir şekli yoktur."
                            }
                        }
                    ],
                    "synonyms": [
                        "finite",
                        "limited"
                    ],
                    "antonyms": [
                        "indefinite"
                    ],
                    "common_phrases": [
                        "definite period",
                        "definite time",
                        "definite shape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий чёткие пределы, границы или фиксированные размеры.",
                        "tr": "Belirli sınırları, limitleri veya sabit boyutları olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определённый",
                                "target_lang_sense_clarification": "имеющий чёткие границы или форму"
                            },
                            {
                                "target_lang_word": "чёткий",
                                "target_lang_sense_clarification": "ясно очерченный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "belirli",
                                "target_lang_sense_clarification": "sınırları çizilmiş, belli"
                            },
                            {
                                "target_lang_word": "belli",
                                "target_lang_sense_clarification": "sabit ve bilinen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4d07264-4c7e-3da0-ad89-69774f1adff9",
                    "sense_definition": "Designating an identified or specific person or thing (used in grammar).",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the word 'the' is known as the <w>definite</w> article.",
                            "target_lang_translations": {
                                "ru": "В английском языке слово 'the' известно как <w>определённый</w> артикль.",
                                "tr": "İngilizcede 'the' kelimesi <w>belirli</w> tanımlık olarak bilinir."
                            }
                        },
                        {
                            "text": "You should use the <w>definite</w> form when referring to a specific object.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать <w>определённую</w> форму при упоминании конкретного объекта.",
                                "tr": "Belirli bir nesneye atıfta bulunurken <w>belirli</w> biçimi kullanmalısınız."
                            }
                        }
                    ],
                    "antonyms": [
                        "indefinite"
                    ],
                    "common_phrases": [
                        "definite article"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначающий конкретное лицо или предмет (грамматический термин).",
                        "tr": "Tanımlanmış veya belirli bir kişiyi veya nesneyi niteleyen (dil bilgisinde)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определённый",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "belirli",
                                "target_lang_sense_clarification": "dil bilgisinde tanımlılık bildiren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc67021e-a175-3266-95d2-d6243c50f886",
                    "sense_definition": "Anything that is certain, defined, or clearly determined.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to turn these possibilities into <w>definites</w> before proceeding.",
                            "target_lang_translations": {
                                "ru": "Нам нужно превратить эти возможности в <w>нечто определённое</w>, прежде чем продолжать.",
                                "tr": "Devam etmeden önce bu olasılıkları <w>kesinleşmiş şeylere</w> dönüştürmemiz gerekiyor."
                            }
                        },
                        {
                            "text": "The manager deals in <w>definites</w> and does not like guessing games.",
                            "target_lang_translations": {
                                "ru": "Менеджер имеет дело с <w>фактами</w> и не любит игры в угадайку.",
                                "tr": "Yönetici <w>kesin olan durumlarla</w> ilgilenir ve tahmin oyunlarını sevmez."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо точное, определённое или ясно установленное.",
                        "tr": "Kesin, tanımlanmış veya net olarak belirlenmiş herhangi bir şey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечто определённое",
                                "target_lang_sense_clarification": "конкретная вещь или событие"
                            },
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "то, что установлено точно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kesin şey",
                                "target_lang_sense_clarification": "netleşmiş durum veya konu"
                            },
                            {
                                "target_lang_word": "kesinleşmiş husus",
                                "target_lang_sense_clarification": "şüphe barındırmayan gerçek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}