                                                "sense_id": "cd9067e4-a1af-36db-9aff-6abff3eb310b",
                                                "text": "Der Einwand ist von geringer Erheblichkeit."
                                            },
                                            {
                                                "example_id": "b30777fb-ba76-47dd-8ed6-58675f7d9199",
                                                "sense_id": "cd9067e4-a1af-36db-9aff-6abff3eb310b",
