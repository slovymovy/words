                            {
                                "target_word": "mashed potatoes",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acab5125-dc04-32f4-b987-0b39507060cd",
                                        "entry_id": "6febbbc2-39af-3863-b1de-094cfd727407",
                                        "glosses": [
                                            "A dish consisting of potatoes that have been boiled, mashed to a pulpy consistency, and mixed with such ingredients as butter or milk."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "819b39b0-c91c-4c9a-9c75-d606b2437c1e",
                                                "sense_id": "acab5125-dc04-32f4-b987-0b39507060cd",
                                                "text": "Mashed potatoes is (or are) my favorite starch dish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8821d862-10cd-358d-b55d-cb9cdf481095",
                                        "entry_id": "6febbbc2-39af-3863-b1de-094cfd727407",
                                        "glosses": [
                                            "Partially melted snow with a pulpy texture, making for slow skiing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95380892-4ec1-4a9a-a430-759cb65e2ada",
                                                "sense_id": "8821d862-10cd-358d-b55d-cb9cdf481095",
                                                "text": "During late-season skiing, I have encountered ice in the morning and mashed potatoes in the afternoon."
                                            },
                                            {
                                                "example_id": "41de978f-67bb-4dd3-8bda-14cc4b74f6b1",
                                                "sense_id": "8821d862-10cd-358d-b55d-cb9cdf481095",
                                                "text": "The Eastern ski tribe could confidently expect much ice underfoot while the Western contingent could expect much mashed potatoes around the ankles."
                                            },
                                            {
                                                "example_id": "86a0399f-3aa1-464f-bee1-b627f05597ce",
                                                "sense_id": "8821d862-10cd-358d-b55d-cb9cdf481095",
                                                "text": "I climbed back through the bottomless mashed potatoes as quickly as I could, relieved to see that his ski was off, with his foot pointing in a normal direction— not the skis’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c04ef9-ae35-3a9e-8f7a-c01a9e969651",
                                        "entry_id": "6febbbc2-39af-3863-b1de-094cfd727407",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see mash, potato."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
