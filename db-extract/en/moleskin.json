                "translations": [
                    {
                        "translation_id": "103d8fcf-3869-4d1a-9bfe-e2d84edf4e36",
                        "source_entry_id": "afb16cc6-eeef-32ea-adc4-081599d0a28c",
                        "source_sense_id": "ec1e6be1-b175-3191-bd44-5e005a77491b",
                        "source_sense_description": "Fell eines Maulwurfes, Maulwurffell",
                        "target_lang_word": "Maulwurffell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maulwurffell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8bf3175-26a4-3e7f-b02c-9445ea15d092",
                                        "entry_id": "3f118ba5-fb13-393e-a95d-aaad9ffa8270",
                                        "glosses": [
                                            "(abgezogenes) Fell eines Maulwurfs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8259d58-0b95-410e-9674-9c396e7f6648",
                                                "sense_id": "a8bf3175-26a4-3e7f-b02c-9445ea15d092",
                                                "text": "„Zu den ungewöhnlichsten [Equipagen] gehörte die Linejka, eine Art gepolsterter und mit Maulwurffell überzogener Diwan, ohne Rückenlehne, auf vier Rädern, von Pferden gezogen, auf dem bei unseren Fahrten zu Picknicks oder zum Pilzesuchen acht Erwachsene Platz nahmen.“"
                                            },
                                            {
                                                "example_id": "635cb947-672d-4952-ab63-2c442f0aa5df",
                                                "sense_id": "a8bf3175-26a4-3e7f-b02c-9445ea15d092",
                                                "text": "„Maulwurffelle aus Europa haben keinen besonderen Werth; besser sind die etwas größeren russischen, welche in China beliebt sind.“"
                                            },
                                            {
                                                "example_id": "8bda9aa5-b3b0-4878-9290-c3f33382cbee",
                                                "sense_id": "a8bf3175-26a4-3e7f-b02c-9445ea15d092",
                                                "text": "„Niemand hätte für möglich gehalten, was aus Truhen und Schränken, was aus Kartons und dämmrigen Abseiten zum Vorschein kam: es waren ja nicht nur gefütterte Hosen und Pelzstiefel und Mäntel, durch die kein Wind drang, sondern auch uralte Pelzmützen, mehrfarbige, gehäkelte Ohrenschützer, Muffs aus Maulwurffellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a66a85a5-b6fb-45de-b8e3-a9c3b3d7fff9",
                        "source_entry_id": "afb16cc6-eeef-32ea-adc4-081599d0a28c",
                        "source_sense_id": "528248ca-3147-3544-9e35-a2aa897b5052",
                        "source_sense_description": "Moleskin, ein Baumwollgewebe in Atlasbindung, einseitig aufgerauht",
                        "target_lang_word": "Moleskin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moleskin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                                        "entry_id": "e56f0732-2639-3dd0-9d51-f717db1100a0",
                                        "glosses": [
                                            "„kräftiger (Futter)stoff aus Baumwolle“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a870b7-6912-4f00-b740-b15f16f18913",
                                                "sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                                                "text": "„Moleskin, sehr selten gewordener, schwerer Baumwollstoff der Manchester-Tradition, der mit ungewöhnlich starken Kettengarnen und hoher Dichtigkeit von Schußgarnen – bis zu 400 Fäden pro Zoll – gewebt wird, was nur auf besonderen Webstühlen möglich ist, die ihrerseits selten geworden sind.“"
                                            },
                                            {
                                                "example_id": "93374c14-223f-49ef-b14d-b56fbba07e46",
                                                "sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                                                "text": "„Insbesondere in England ist Moleskin auch noch als wärmerer und robuster Arbeitsanzugstoff für das Landleben beliebt. Der heute selten gewordene Moleskin wird überwiegend zu strapazierfähiger warmer Berufskleidung verarbeitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af2714c6-4ae7-4661-84d7-4541a2111a3d",
                        "source_entry_id": "afb16cc6-eeef-32ea-adc4-081599d0a28c",
                        "source_sense_id": "972fdaa4-e9a0-392f-8285-884004e4526e",
                        "source_sense_description": "Notizbuch",
                        "target_lang_word": "Notizbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notizbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                        "entry_id": "d7307eec-d441-3e03-9ac4-6af3c2afef50",
                                        "glosses": [
                                            "ein (manchmal kleines) Heft oder Buch mit leeren Seiten, in das Notizen eingetragen werden und Ideen, Ausschnitte und Skizzen gesammelt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea99ed6b-234c-4e0b-84a3-51f3ad3cac72",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "Der Kommissar holte sein Notizbuch hervor und schrieb sich Stichworte zu dem, was er eben gehört hatte, auf."
                                            },
                                            {
                                                "example_id": "82b21372-5867-4406-8e80-5510866514c5",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Im Eingangsamte wird die Waare zur Revision gestellt, nach der Quittung revidirt, diese, vor der Rückstellung an den Waarenführer, dann mit der Bescheinigung des Eingangs der Waare versehen, wenn sie ausdrücklich auf die Passage noch ein Mal durch das Inland gerichtet ist, und die Waare in das Notizbuch eingetragen.“"
                                            },
                                            {
                                                "example_id": "8e5e9200-57e5-4362-a737-276a383077d3",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Die Banditen durchsuchen seinen Tornister und finden nichts als Bücher, trockenes Brot, harten Käse, zwei Hemden und ein Notizbuch.“"
                                            },
                                            {
                                                "example_id": "3db8f30f-3809-40e9-9f16-4e1db652558f",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Ich steckte das kleine Notizbuch wieder in sein Versteck.“"
                                            },
                                            {
                                                "example_id": "fa62a7d0-783a-48db-aecb-865531130e05",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Ab und zu zog er ein Notizbuch aus der Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
