                ],
                "senses": [
                    {
                        "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                        "entry_id": "e6205004-0bac-3aa8-a294-05c521a06e42",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da02ee7-a3e0-4234-9769-26ff2e3f73da",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Frau Herwegh ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4153541a-a1a4-4d3f-b015-5f9237aeff0a",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Herr Herwegh wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7cd06eb1-f670-4e57-88a2-774b6007c321",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Die Herweghs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "41c52140-3477-4215-92ef-4884d6296fa1",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Der Herwegh trägt nie die Schals, die die Herwegh ihm strickt."
                            },
                            {
                                "example_id": "cb6b2240-d10a-4d1a-a666-dd0c411790a6",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herwegh kommt, geht der Herr Herwegh.“"
                            },
                            {
                                "example_id": "bc5ab709-e627-4eec-a892-62e528462a7a",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Herwegh kommt und geht."
                            },
                            {
                                "example_id": "1c7e5e90-0610-4200-addc-31fc78d6579a",
                                "sense_id": "6f986227-2101-3649-9724-dcfb724f1f93",
                                "text": "Herweghs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
