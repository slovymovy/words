                                "example_id": "2a5c6875-bbdc-4028-873f-49ceea05bbf6",
                                "sense_id": "1be39ecc-57a6-3453-9a32-87185f581661",
                                "text": "„Viele Bürger haben jedoch ein anständiges Stück Land zu bewältigen, und vielleicht gar eine Menge Land mit Gartenabfall.“"
                            }
                        ],
