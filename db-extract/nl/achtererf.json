                                                "sense_id": "298043c2-b849-32de-ada5-c9e6b5fd0a5d",
                                                "text": "I had no shallots so I substituted onion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163f1c81-fd6e-3b5c-bdd9-412a541da3c9",
