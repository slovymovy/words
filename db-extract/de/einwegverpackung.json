                ],
                "senses": [
                    {
                        "sense_id": "b6fb350f-c80b-3112-b3dd-5b8ac33b84ff",
                        "entry_id": "48ea2357-d6af-37d6-89f6-ea83f374956e",
                        "glosses": [
                            "nur zur einmaligen Verwendung bestimmte Verpackung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c329a9c3-ab5a-4e4e-9e04-bc3d3203a70a",
                                "sense_id": "b6fb350f-c80b-3112-b3dd-5b8ac33b84ff",
                                "text": "„Da Hersteller sich heute an den Entsorgungskosten ihrer Produkte beteiligen müssen, macht dies kompostierbaren Kunststoff attraktiv und soll ihm schon in den kommenden Jahren einen Marktanteil von fünf Prozent bei Einwegverpackungen erschließen – hiervon gehen zumindest die Betreiber von Europas erster Großproduktion für PLA aus, die derzeit im brandenburgischen Guben entsteht.“"
                            },
                            {
                                "example_id": "a8238296-93f7-4e63-b1ab-9078fbc1ddff",
                                "sense_id": "b6fb350f-c80b-3112-b3dd-5b8ac33b84ff",
                                "text": "„Bei der Mehrwegquote nach der Verpackungsverordnung ist die pauschale Vermutung der ökologischen Vorteilhaftigkeit von Mehrwegverpackungen für Getränke gegenüber Einwegverpackungen, die der Vorgabe einer Mindestquote für Mehrwegverpackungen von 72 % in der Verpackungsverordnung zugrunde liegt, nicht in jedem Fall zutreffend.“"
                            },
                            {
                                "example_id": "d22bb213-4e71-4735-b19a-603608089446",
                                "sense_id": "b6fb350f-c80b-3112-b3dd-5b8ac33b84ff",
                                "text": "„Doch seit der Gesetzesänderung erkennen Leergutautomaten auch Einwegverpackungen konkurrierender Hersteller an; die Automaten scannen dabei ein Sicherheitslogo auf der Rückseite der Verpackung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
