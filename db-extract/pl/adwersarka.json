                ],
                "senses": [
                    {
                        "sense_id": "61766271-3bd6-34c4-b60d-251f4ba4259b",
                        "entry_id": "6a34d1a0-f164-3f18-aa08-c8a3434eda6d",
                        "glosses": [
                            "weibliche Person, die eine entgegengesetzte Meinung vertritt; Gegnerin, Gegenspielerin, Widersacherin"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33d8bc0a-d56f-4da0-8eb8-d79e57b02376",
                        "source_entry_id": "6a34d1a0-f164-3f18-aa08-c8a3434eda6d",
                        "source_sense_id": "61766271-3bd6-34c4-b60d-251f4ba4259b",
                        "source_sense_description": "weibliche Person, die eine entgegengesetzte Meinung vertritt",
                        "target_lang_word": "Gegnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3767b2f1-0a3e-3119-b49f-344fb1ca230b",
                                        "entry_id": "5d1dd208-b95a-3022-b170-7d9f3f793cda",
                                        "glosses": [
                                            "weibliche Person, die gegenteilige Interessen verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d22dbe99-64b2-4d84-9b0a-41a24e0bc864",
                                                "sense_id": "3767b2f1-0a3e-3119-b49f-344fb1ca230b",
                                                "text": "„Shiffrin mag gar nicht aufhören zu schwärmen von ihren Gegnerinnen.“"
                                            },
                                            {
                                                "example_id": "f73a1241-b4cf-430a-b54f-e60389739845",
                                                "sense_id": "3767b2f1-0a3e-3119-b49f-344fb1ca230b",
                                                "text": "„Allerdings hat er später die heftige Gegnerin der deutschen Wiedervereinigung genial ausgetrickst – darüber gibt es keine Witze.“"
                                            },
                                            {
                                                "example_id": "b53e7885-3ecf-4506-afb9-2528c63e3b3f",
                                                "sense_id": "3767b2f1-0a3e-3119-b49f-344fb1ca230b",
                                                "text": "„Das war eine Gegnerin, die mir gegenüberstand; und daß ich hinter Sophies Entsagung immer Haß gewittert hatte, zeigte mir wenigstens, wie hellsichtig ich war.“"
                                            },
                                            {
                                                "example_id": "fa9e8e63-10bf-421e-b5d9-0f662fc08e14",
                                                "sense_id": "3767b2f1-0a3e-3119-b49f-344fb1ca230b",
                                                "text": "„Sie erzählt von einer Mutter, die den Verstand verliert und sich als schreckliche Gegnerin eines schneidigen jungen Kriegers entpuppt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
