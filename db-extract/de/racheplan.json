                "senses": [
                    {
                        "sense_id": "f1abc7c9-afbe-3780-a917-c5fb3c6edcc3",
                        "entry_id": "fbfaf4e8-67c4-3259-95e9-851a4f0410f3",
                        "glosses": [
                            "Plan, um Rache zu üben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "383cfd36-49fe-494c-a58f-456df962746e",
                                "sense_id": "f1abc7c9-afbe-3780-a917-c5fb3c6edcc3",
                                "text": "„Betrogen, gedemütigt, mißhandelt, in den Augen des glücklichen und triumphierenden Candiani zum Gespött geworden, brütete ich drei Stunden lang über den finstersten Racheplänen.“"
                            },
                            {
                                "example_id": "0b19f37e-7ab2-432f-983b-dd796785df29",
                                "sense_id": "f1abc7c9-afbe-3780-a917-c5fb3c6edcc3",
                                "text": "„Wir wollen bemüht sein, so zu berichten, daß jedermann begreifen kann, wie raffiniert sein Racheplan war.“"
                            },
                            {
                                "example_id": "9581ec7b-4121-4b15-b982-e87fa33de031",
                                "sense_id": "f1abc7c9-afbe-3780-a917-c5fb3c6edcc3",
                                "text": "„Er trug verschiedene Rachepläne im Herzen, als er eine Begegnung hatte, die sein Leben verändern sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
