                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28d06968-5a78-3bb5-b776-5d5bf43a9e86",
                                        "entry_id": "b2d77a98-c28e-31bf-8cf9-39040a606422",
                                        "glosses": [
                                            "Faithfulness to its own rules; internal cohesion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a8e173-7d5b-4609-af76-1c2a67eb5e43",
                                                "sense_id": "28d06968-5a78-3bb5-b776-5d5bf43a9e86",
                                                "text": "On July 12, Madame filed suit for divorce, naming one Jane McManus as his principal mistress. Other adulteries were noted in the interest of verisimilitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "037699b9-1d2e-4f39-8bac-c98bdd9bdde9",
                        "source_entry_id": "1609da8f-22f8-3ccc-91b7-5c88c404f49a",
                        "source_sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                        "target_lang_word": "likelihood",
                        "target_lang_code": "en",
