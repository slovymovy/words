                ],
                "senses": [
                    {
                        "sense_id": "6f4ecfc6-1238-3c81-aba3-3de133350a7f",
                        "entry_id": "06c15cf7-2cab-37c6-a922-ce37cc5b674a",
                        "glosses": [
                            "Donner un caractère ecclésial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65cdbab3-83b8-41c3-ab3c-81c998482554",
                                "sense_id": "6f4ecfc6-1238-3c81-aba3-3de133350a7f",
                                "text": "Ecclésialiser, c’est la démarche par laquelle on baptise « église » une situation ou une expérience que des hommes ou des femmes vivent au nom de Jésus-Christ."
                            },
                            {
                                "example_id": "c803c248-1e9c-4b98-9d5d-c447b6c2ce5d",
                                "sense_id": "6f4ecfc6-1238-3c81-aba3-3de133350a7f",
                                "text": "La conclusion de la liturgie dominicale - « et maintenant, sortons en paix » - peut être vécue comme une invitation à porter la paix au « monde » pour que celui-ci se laisse ecclésialiser, intégrer au Corps du Christ."
                            }
                        ]
                    }
