                    {
                        "translation_id": "38fc5d71-6b43-4344-bea2-24b1ab62b93e",
                        "source_entry_id": "cd11aa4f-de3f-3638-8c79-4f086714e419",
                        "source_sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                        "source_sense_description": "Christentum: herausragende Glaubensverkünderin der Urkirche",
                        "target_lang_word": "apôtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apôtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46be4137-ea87-3a6e-abd6-421b2a33595e",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Une des douze personnes que Jésus-Christ choisit particulièrement, entre ses disciples, pour prêcher l’évangile."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c95f919-bc19-4755-a319-ddc10a7b9cc4",
                                                "sense_id": "46be4137-ea87-3a6e-abd6-421b2a33595e",
                                                "text": "Le sanctuaire, dont les piliers sont décorés des statues des Apôtres, était entièrement peint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "483697ff-2ee2-3fdc-81ef-105e4e42b84c",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Autre personne particulièrement chargée pour diffuser l’évangile au temps des premiers chrétiens."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6740e1a1-7b85-4e29-96e8-17fd2d16f0a2",
                                                "sense_id": "483697ff-2ee2-3fdc-81ef-105e4e42b84c",
                                                "text": "Car moi, je suis le plus petit des Apôtres, je ne suis pas digne d’être appelé Apôtre, puisque j’ai persécuté l’Église de Dieu."
                                            },
                                            {
                                                "example_id": "1dc87f54-71c4-4e2f-a82c-68e1ffd520cf",
                                                "sense_id": "483697ff-2ee2-3fdc-81ef-105e4e42b84c",
                                                "text": "Paul fait référence à Junias qui aurait été une apôtre éminente et il parle des femmes prophètes et des diaconesses."
                                            },
                                            {
                                                "example_id": "c13bab7a-a455-4873-9b99-51bf34db291d",
                                                "sense_id": "483697ff-2ee2-3fdc-81ef-105e4e42b84c",
                                                "text": "Marie de Magdala, première apôtre, entraîne à sa suite tout un peuple de pécheurs, de boiteux, dans cette aventure où chacun de nous peut risquer un pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf87c88-a9d7-3e14-b6b4-2d8875b518e4",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Chacun des enfants dont on lave les pieds le Jeudi-Saint, lors de la cérémonie de la Cène."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46f62b5b-f116-3980-be34-40adbc5a99be",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Celui qui, le premier, a prêché la foi dans quelque pays."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c544375-4ffb-42f3-9a15-4f231021fcac",
                                                "sense_id": "46f62b5b-f116-3980-be34-40adbc5a99be",
                                                "text": "Saint Denis est l’apôtre de Paris."
                                            },
                                            {
                                                "example_id": "bbed2074-d0cd-437c-98df-dffb6232a3a3",
                                                "sense_id": "46f62b5b-f116-3980-be34-40adbc5a99be",
                                                "text": "Saint François-Xavier est l’apôtre des Indes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781f04ac-efdf-364c-b342-72f0672c3163",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Celui qui se voue à la propagation et à la défense d’une doctrine, d’une opinion, d’un système."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085278f6-bb45-45b0-b5e5-ee445c5d89df",
                                                "sense_id": "781f04ac-efdf-364c-b342-72f0672c3163",
                                                "text": "En apparence, ce turbulent apôtre des lumières fait contraste avec ses ancêtres confits en dévotion et abondants en patenôtres."
                                            },
                                            {
                                                "example_id": "0883cca2-9d0c-41e7-b2d1-208333d419a3",
                                                "sense_id": "781f04ac-efdf-364c-b342-72f0672c3163",
                                                "text": "Ce conflit dynastique dégénérerait en guerre européenne. C'est pourquoi Dubois se pose en apôtre de la paix."
                                            },
                                            {
                                                "example_id": "e77af3c1-a970-4ad5-8e87-44e45ec35cda",
                                                "sense_id": "781f04ac-efdf-364c-b342-72f0672c3163",
                                                "text": "Je pense qu’il faut qu’on normalise le fait, et j’en suis une apôtre, que ça se peut qu’on soit avec notre famille."
                                            },
                                            {
                                                "example_id": "a760b183-87ae-489b-be86-394e1867beb2",
                                                "sense_id": "781f04ac-efdf-364c-b342-72f0672c3163",
                                                "text": "Un autre point concerne l’amazone Théroigne que vous nous avez renvoyée : nous avons déjà ici trop de personnes infectées de cette malheureuse démocratie Française, et cette apôtre ne fera que du mal dans ce pays ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a7c7949-fd0c-3109-854a-cda268734597",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Les doigts des mains."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural",
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ec115bb-4d59-339c-8837-caa026d4cbf5",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Allonge qui consolide le beaupré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294f6d73-bffe-4d61-bee6-8c917cc327e7",
                                                "sense_id": "5ec115bb-4d59-339c-8837-caa026d4cbf5",
                                                "text": "[…] ; l’autre portion forme le gaillard d'avant, compris depuis les apôtres jusque vers le bout de l’arrière des porte-haubans de misaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b421601-64be-3923-a908-cd437c6731b8",
                                        "entry_id": "a45239d8-1aa0-32c5-9653-dbf419db664a",
                                        "glosses": [
                                            "Lettre par laquelle un condamné dénonçait appel au juge qui avait prononcé la sentence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
