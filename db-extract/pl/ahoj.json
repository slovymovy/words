        "pl-extract.jsonl": [
            {
                "entry_id": "b40874a0-c155-37c3-ba4e-4a134de16bc9",
                "word": "ahoj",
                "pos": "intj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0bf467d-5403-37e6-a37e-c1bf1f034c62",
                        "entry_id": "b40874a0-c155-37c3-ba4e-4a134de16bc9",
                        "glosses": [
                            "pozdrowienie, zawołanie, okrzyk mający zwrócić uwagę; słowo używane zwykle wśród marynarzy i żeglarzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626907d7-3d77-4993-821c-749f468478f4",
                                "sense_id": "d0bf467d-5403-37e6-a37e-c1bf1f034c62",
                                "text": "Szczurek, narkoman młody wiekiem i stary stażem, z ramionami rozłożonymi jak żagle dryfował od jednego końca tarasu do drugiego, a inni wołali do niego: „ahoj, marynarzu, nie wyjeb się na skały”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "45190a4d-b9d6-3bda-bd4a-0b67d47b9aea",
                        "entry_id": "b40874a0-c155-37c3-ba4e-4a134de16bc9",
                        "glosses": [
                            "cześć (pozdrowienie na pożegnanie)"
                        ],
                        "tags": [
                            "uczn."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8c21c0c-d59d-4f46-b69b-383da725ab68",
                        "source_entry_id": "b40874a0-c155-37c3-ba4e-4a134de16bc9",
                        "source_sense_id": "d0bf467d-5403-37e6-a37e-c1bf1f034c62",
                        "target_lang_word": "ahoy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ahoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                        "entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                                        "glosses": [
                                            "Used to hail a ship, a boat or a person, or to attract attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3552fa69-7e7b-4db3-b62a-4b4e5712bc48",
                                                "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                                "text": "While he was thus occupied, a voice, still more uncouth than the former, bawled aloud, ‘Ho! the house, a-hoy!’"
                                            },
                                            {
                                                "example_id": "fe884912-4d03-49fd-accd-7fae4fac34da",
                                                "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                                            },
                                            {
                                                "example_id": "f6be47d9-f6e8-430b-86a8-207098389f1c",
                                                "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                                "text": "“(grunts) Frankie put glass in the piccata and the restaurant comped us, so we got all these chips. Let's hit the casino.” “All right.” “Come on, Nadia. Let's go watch this Rat Pack show with the girls.” “Did you say \"the Rat Pack\"?” “Yeah, they're good.” “They're here?” “Yeah, yeah, it's the Rat Pack.” “Chips ahoy!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e234a8-344c-3d6c-b6b3-36defcbc5632",
                                        "entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                                        "glosses": [
                                            "Warning of something approaching or impending."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b7adbcf-3d9e-4afe-84b6-3c49662988bf",
                                                "sense_id": "42e234a8-344c-3d6c-b6b3-36defcbc5632",
                                                "text": "Lawsuits, ahoy! […] Towns can regulate use of their beaches. But what about the waters offshore?"
                                            },
                                            {
                                                "example_id": "ccbbecd5-62ec-48e2-900e-7a88c6c65738",
                                                "sense_id": "42e234a8-344c-3d6c-b6b3-36defcbc5632",
                                                "text": "Catalytic converters ahoy – Zeppelin's latest is one of those high-rev 3D driving games that simulates racing tracks from all over the world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ahoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dfd1fc8-0f73-3ac8-b5b2-bc356806ce21",
                                        "entry_id": "299de5a1-9507-39b7-a2a4-110a2f4bad34",
                                        "glosses": [
                                            "To hail with a cry of \\\"ahoy\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ahoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "712d8b6f-2546-3299-884c-342d8d4441da",
                                        "entry_id": "9ecfda75-2ff8-3961-ab1c-6d3780ce38bb",
                                        "glosses": [
                                            "An utterance of this interjection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09333f8f-1819-49ad-8ca5-c56640bf0433",
                                                "sense_id": "712d8b6f-2546-3299-884c-342d8d4441da",
                                                "text": "There were many ahoys heard from the approaching ship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "962d814b-8da7-4b7a-b9a0-804c7b051da4",
                        "source_entry_id": "b40874a0-c155-37c3-ba4e-4a134de16bc9",
                        "source_sense_id": "d0bf467d-5403-37e6-a37e-c1bf1f034c62",
                        "target_lang_word": "ohé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ohé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                        "entry_id": "6757f39f-87eb-37ae-8ff7-fb370a2bdcf4",
                                        "glosses": [
                                            "Interjection servant à appeler quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a596dece-d656-49e1-b631-f4c180480e53",
                                                "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                                "text": "Ohé, là-bas, venez !"
                                            },
                                            {
                                                "example_id": "bb3370f0-68ba-4ce4-b5dc-927b66bf0c79",
                                                "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                                "text": "Mais à peine abordés, voilà des voix étouffées qui nous appellent de l’autre rive :\n« Ohé ! du bateau !… »"
                                            },
                                            {
                                                "example_id": "d9cadefd-a678-415e-a7d1-d0f993179ab9",
                                                "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                                "text": "Il fut tiré de ces pensées déplaisantes par les clameurs des postillons.\n « Ohé ! ohé ! ohé ! ohé ! ohé ! cria le premier postillon.\n — Ohé ! ohé ! ohé ! ohé ! ohé ! hurla le second postillon.\n — Ohé ! ohé ! ohé ! ohé ! ohé ! vociféra le vieux Wardle lui-même en mettant la moitié de son corps hors de la portière.\n — Ohé ! ohé ! ohé ! ohé ! ohé ! » répéta M. Pickwick, en s’unissant au refrain, sans avoir la plus légère idée de ce qu’il signifiait."
                                            },
                                            {
                                                "example_id": "b946782b-b06c-42e8-96fe-ab4d0d7fc195",
                                                "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                                "text": "— Ohé !… Ohé !…\n — Ohé, murmure l’écho affaibli.\n — Où êtes-vous ? reprend une voix qui se fait grondeuse.\n Du fond du taillis, deux jeunes filles répondent aussitôt :\n — Ohé, maman, nous sommes là !"
                                            },
                                            {
                                                "example_id": "08736133-0dcc-48dc-8848-7a7aae1743e0",
                                                "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                                "text": "Dansons la ronde\n Des marmites de Paris,\n Ohé ! les souris !\n Les rongeuses de monde !\n Faisons sauter avec nous\n Nos michets et nos marlous"
                                            },
                                            {
                                                "example_id": "12567cfc-6468-472a-afaf-4b04ecb8ef26",
                                                "sense_id": "ebd14b6a-0064-37d2-8a54-0cb825a36c6e",
                                                "text": "Ainsi chevauchent ambedui\nParmi la grant forest oscure,\nTant qu’à un gué, par aventure,\nOnt un chevalier encontré,\nQui va criant : « Ohé, ohé !\n« Voire, si vous dirai por quoi ;\n« Ici au gué joustez à moi. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8a9d17c-e89c-4896-a2c1-bdfb0cff363b",
                        "source_entry_id": "b40874a0-c155-37c3-ba4e-4a134de16bc9",
                        "source_sense_id": "d0bf467d-5403-37e6-a37e-c1bf1f034c62",
