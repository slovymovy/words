                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974628b7-fd22-4936-9c1b-26ef8f519dd4",
                                "sense_id": "757d56d1-6114-3960-a141-50eb7a4da39e",
                                "text": "Aussitôt qu’elles nous eurent aperçus, la vieille et moi, traversant les pelouses et piquant vers le lazaret, trois poules survinrent, clopin-clopant, se ranger devant leurs augettes remplies de millet, et, avec des mines ostentatoires et sournoises, avec des mouvements extraordinairement précipités, elles firent semblant de manger, avidement…"
                            },
                            {
                                "example_id": "eece56bb-6f18-48e5-adfe-ca12dd063933",
                                "sense_id": "757d56d1-6114-3960-a141-50eb7a4da39e",
                                "text": "Il ne restait plus des temps heureux qu’une augette de pierre pleine d’une eau morte."
                            }
                        ]
                    },
