                                        "sense_id": "14268068-ba77-3952-ab29-a8e3bc8e2568",
                                        "entry_id": "0895a7a7-31ea-37d3-936c-bf8e1bb1011d",
                                        "glosses": [
                                            "To dupe or deceive."
                                        ],
                                        "tags": [
