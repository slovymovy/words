                        "examples": [
                            {
                                "example_id": "44c949b2-f6f1-4f91-b688-c7d848b3407b",
                                "sense_id": "2dbe91bd-efa1-3a10-b8e9-b93cb37c9ff9",
                                "text": "Le canard mandarin est un anatidé très commun en captivité alors qu’il est en déclin en Asie, son habitat d’origine."
                            },
                            {
                                "example_id": "1bc3dcd8-bf9a-44b0-8834-0f23dacce8be",
                                "sense_id": "2dbe91bd-efa1-3a10-b8e9-b93cb37c9ff9",
                                "text": "Quelques-unes sont exceptionnelles, n’apparaissant par exemple qu’une année sur trois ou quatre : c’est le cas du Tadorne nyroca, un anatidé."
                            },
                            {
                                "example_id": "a8421e86-677f-4baa-898f-1b93b7b4083c",
                                "sense_id": "2dbe91bd-efa1-3a10-b8e9-b93cb37c9ff9",
                                "text": "Cette manière de procéder porte fruit avec les petits attroupements d’anatidés très habitués à leur site d’alimentation."
                            }
                        ]
                    }
