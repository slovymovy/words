                    {
                        "translation_id": "fcb01eed-e74b-4b40-b9f4-f08cfc102b8c",
                        "source_entry_id": "8933a5dd-40c2-3c5c-83b6-0cf5b8e6f804",
                        "source_sense_id": "2bf6cf72-f5de-3737-8359-0ab7cedb09d1",
                        "target_lang_word": "masochisme",
