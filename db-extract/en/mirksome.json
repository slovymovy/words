                            {
                                "example_id": "a1d7729f-efdd-4a0e-b58c-363279171a48",
                                "sense_id": "0e16ca98-bb8e-3b1c-a1e6-e95e66f89ec5",
                                "text": "Then to her yron wagon she betakes, / And with her beares the fowle welfavourd witch: / Through mirksome aire her ready way she makes."
                            },
                            {
                                "example_id": "6bc21cd2-9ea5-467b-abb7-07d09937707c",
                                "sense_id": "0e16ca98-bb8e-3b1c-a1e6-e95e66f89ec5",
                                "text": "And there, in silence deaf and mirksome shade, / His characters and circles vain he made."
                            }
                        ]
                    }
