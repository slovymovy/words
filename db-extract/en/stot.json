                    {
                        "sense_id": "9d7663e0-2394-35b7-8a37-ebc086e68d7f",
                        "entry_id": "0c14f52c-c498-3fa3-a561-bd7e8de44dc7",
                        "glosses": [
                            "eine auffällige Gangart einiger Antilopenarten, wenn sie einen Räuber sichten, ausführen"
                        ],
                        "tags": [],
