{
    "word_family": [
        "affirm",
        "affirmation",
        "affirmative",
        "affirmatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1f1df60-cb2d-3a97-8b13-e218d79b0488",
                    "sense_definition": "To state or declare something again with confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>reaffirmed</w> its commitment to the new environmental policy during the meeting.",
                            "target_lang_translations": {
                                "zh": "政府在会议期间<w>重申</w>了对新环境政策的承诺。"
                            }
                        },
                        {
                            "text": "Both leaders met to <w>reaffirm</w> their support for the existing peace treaty.",
                            "target_lang_translations": {
                                "zh": "两位领导人会面，旨在<w>重申</w>他们对现有和平条约的支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reiterate",
                        "restate",
                        "confirm"
                    ],
                    "common_phrases": [
                        "reaffirm commitment",
                        "reaffirm support"
                    ],
                    "target_lang_definitions": {
                        "zh": "再次肯定或声明某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重申",
                                "target_lang_sense_clarification": "正式地再次陈述观点或立场。"
                            },
                            {
                                "target_lang_word": "再次确认",
                                "target_lang_sense_clarification": "再次核实或肯定某事的真实性或有效性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ce940da-fce9-30c8-98e3-60a338b4f02c",
                    "sense_definition": "To strengthen or reinforce a belief, feeling, or position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult experience only served to <w>reaffirm</w> her belief in the importance of hard work.",
                            "target_lang_translations": {
                                "zh": "这段艰难的经历反而<w>巩固</w>了她对努力工作重要性的信念。"
                            }
                        },
                        {
                            "text": "These findings <w>reaffirm</w> the need for more research into the causes of the disease.",
                            "target_lang_translations": {
                                "zh": "这些发现<w>加强</w>了对该疾病病因进行更多研究的必要性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reinforce",
                        "strengthen",
                        "bolster"
                    ],
                    "antonyms": [
                        "weaken",
                        "undermine"
                    ],
                    "common_phrases": [
                        "reaffirm belief",
                        "reaffirm position"
                    ],
                    "target_lang_definitions": {
                        "zh": "加强或巩固某种信念、情感或立场。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "巩固",
                                "target_lang_sense_clarification": "使信念或立场更加稳固。"
                            },
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "使某种感觉或必要性变得更强。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}