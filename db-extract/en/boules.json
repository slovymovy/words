                                    {
                                        "sense_id": "e5dc6155-4de8-3bb4-9244-eeb5a283c7ef",
                                        "entry_id": "a8acf5a7-b261-338d-b830-98948327b618",
                                        "glosses": [
                                            "Pluriel de boule."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706faf43-ec72-42d6-9105-9e302a1d5e01",
                                                "sense_id": "e5dc6155-4de8-3bb4-9244-eeb5a283c7ef",
                                                "text": "Avant de remonter au front : « Les vieux cons de fachos comme vous, ils tisent de l’alcool et jouent aux boules ! Leurs enfants, ils font pareil! […] »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f081168d-a355-3254-8832-3e15d911209d",
                                        "entry_id": "a8acf5a7-b261-338d-b830-98948327b618",
                                        "glosses": [
                                            "Toujours au pluriel : l'argent, les finances."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d22d99-9a89-4c94-b14a-47fa216c1eeb",
                                                "sense_id": "f081168d-a355-3254-8832-3e15d911209d",
                                                "text": "Je pensais pas trop à l'avenir, le moment où je devrais […] me remettre en piste, trouver le nerf de la guerre, remonter mes boules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boules",
