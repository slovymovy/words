                    },
                    {
                        "sense_id": "2869ec9c-134d-3b92-a11b-da3dbc3a7f97",
                        "entry_id": "9bffdbde-a412-354a-a296-6b40c55a1253",
                        "glosses": [
                            "Que l’on ne peut pas supporter, admettre."
                        ],
                        "tags": [
