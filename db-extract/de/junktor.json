                "senses": [
                    {
                        "sense_id": "294654c9-685d-3b2a-b8c1-192c223350ec",
                        "entry_id": "31d9d4de-161f-3f63-881a-abf390f38a3b",
                        "glosses": [
                            "logische Partikel, durch die manche Aussagen zu einer neuen verbunden werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22249880-71a3-48b6-9323-ee98e7910d0b",
                                "sense_id": "294654c9-685d-3b2a-b8c1-192c223350ec",
                                "text": "„Denn „nicht“ ist ein abstrakter Junktor, wohingegen die Wörter „positiv“ oder „negativ“ entsprechende Gefühlsketten auslösen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3271ed5f-f3cc-340f-bf59-a2740e8bc58e",
                        "entry_id": "31d9d4de-161f-3f63-881a-abf390f38a3b",
                        "glosses": [
                            "ein mathematisches Objekt, das Operanden verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33c94a6-2b1f-446e-9573-790e09d419b1",
                                "sense_id": "3271ed5f-f3cc-340f-bf59-a2740e8bc58e",
                                "text": "„Ein Junktor (von lat. iungere „verknüpfen, verbinden“) ist eine logische Verknüpfung zwischen Aussagen innerhalb der Aussagenlogik, also ein logischer Operator.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
