                        "target_lang_word": "brûlure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brûlure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "050a6fc9-0d24-3d7d-8b08-3dd37ea13753",
                                        "entry_id": "1c7a0a18-7919-320c-8df0-816759b3c144",
                                        "glosses": [
                                            "Impression qu'un corps très chaud ou très froid, une substance corrosive ou caustique, un frottement, un rayonnement ou encore un courant électrique font sur la peau ou sur quelque autre matière et qui va jusqu’à les altérer ou même jusqu’à les détruire partiellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e5df6e-436c-4a84-9b24-2c1aaef8e3a6",
                                                "sense_id": "050a6fc9-0d24-3d7d-8b08-3dd37ea13753",
                                                "text": "Se faire une brûlure au visage, à la main. Panser une brûlure. C’est un trou de brûlure."
                                            },
                                            {
                                                "example_id": "712648a9-1c8f-4400-b6bb-46d57a323388",
                                                "sense_id": "050a6fc9-0d24-3d7d-8b08-3dd37ea13753",
                                                "text": "Une brûlure de robe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcf9fa6a-9787-3069-94d8-445fef1f7c94",
                                        "entry_id": "1c7a0a18-7919-320c-8df0-816759b3c144",
                                        "glosses": [
                                            "Sensation de chaleur excessive qu’on éprouve."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90500ee5-7a63-4918-af64-34fed67cb92e",
                                                "sense_id": "dcf9fa6a-9787-3069-94d8-445fef1f7c94",
                                                "text": "Elle en avait contracté l'eczéma de la face, une éruption suintante qui la dévorait de sa brûlure atroce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ba5b32-98a4-3153-9cca-abc4bc25f985",
                                        "entry_id": "1c7a0a18-7919-320c-8df0-816759b3c144",
                                        "glosses": [
                                            "Altérations produites sur les végétaux au printemps, soit par l’action du soleil, soit par l’effet de la gelée ou du vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6a06cb-66bc-429c-a2fb-550b73be0009",
                                                "sense_id": "78ba5b32-98a4-3153-9cca-abc4bc25f985",
                                                "text": "Les pêchers sont très sujets à la brûlure."
                                            }
                                        ]
                                    },
