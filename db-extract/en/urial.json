                "senses": [
                    {
                        "sense_id": "f11b8f22-bb29-3d48-a810-46bd110ce3cd",
                        "entry_id": "c425e4db-9b9d-38dc-b550-4590c58bf358",
                        "glosses": [
                            "A bearded reddish sheep, subspecies of Ovis orientalis (including Ovis orientalis vignei), previously classified as Ovis vignei, being endemic to southern Asia and believed to be a wild ancestor of domestic sheep."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73c774b3-d1e2-4626-9330-6e89555f4a58",
                                "sense_id": "f11b8f22-bb29-3d48-a810-46bd110ce3cd",
                                "text": "All domesticated sheep are descended from the moufflon, urial or argali. They are closely related to each other and connected by intermediate breeds. Most wool sheep are believed to have been derived from urial stock, while hair sheep are traced back to the moufflon."
                            },
                            {
                                "example_id": "3a1dc369-ec37-4170-ba67-ae3f78769ccc",
                                "sense_id": "f11b8f22-bb29-3d48-a810-46bd110ce3cd",
                                "text": "O. severtzovi has been shuffled back and forth between the urial and the argali groups."
                            },
                            {
                                "example_id": "ea751d12-56d0-4528-b609-db4e792f1567",
                                "sense_id": "f11b8f22-bb29-3d48-a810-46bd110ce3cd",
                                "text": "Most urials live in open habitats, with few or no trees, but there are indications that this may be a recent adaptation to changing environmental conditions and that the urial was originally more of a woodland animal than at present."
                            }
                        ]
                    }
                ],
