                    {
                        "form_id": "6fa28a67-c0a2-47fb-bcfc-f6318153d9f2",
                        "entry_id": "21af7088-34db-3c77-b164-e6f31c230dfe",
                        "tags": [
                            "feminine"
                        ],
                        "form": "graveure"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d03f3da1-a65f-36cd-88d6-d03744473c20",
                        "entry_id": "21af7088-34db-3c77-b164-e6f31c230dfe",
                        "glosses": [
                            "Artisan dont la profession est de graver, marquer une matière à l’aide d’outils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440f8982-dfa4-49de-8ff6-6e4655dd89fb",
                                "sense_id": "d03f3da1-a65f-36cd-88d6-d03744473c20",
                                "text": "Les « maisons-ateliers » du quartier Mu seraient celles d’un fondeur, d’un graveur de sceaux et d’un potier."
                            },
                            {
                                "example_id": "d557ad2e-9a0f-493d-aaa8-393a9c1a3f46",
                                "sense_id": "d03f3da1-a65f-36cd-88d6-d03744473c20",
                                "text": "Un art gardait le privilège de la sincérité dans le détail des figures nues : la gravure. On peut affirmer que depuis l’invention de l’estampe jusqu’au xixᵉ siècle la majorité des graveurs fut hostile à toute suppression."
                            },
                            {
                                "example_id": "6d314f21-516d-40a1-80d7-6c558266800a",
                                "sense_id": "d03f3da1-a65f-36cd-88d6-d03744473c20",
                                "text": "Au cours des premières semaines qui suivent un avènement au trône, toujours et en tout pays, graveurs, sculpteurs, peintres et médaillistes ont extrêmement à faire. Il en est ainsi en France où l'on écarte rapidement le portrait de Louis XV."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c98a4c7c-5763-4a77-8aa0-974257a88dc0",
                        "source_entry_id": "21af7088-34db-3c77-b164-e6f31c230dfe",
                        "source_sense_id": "d03f3da1-a65f-36cd-88d6-d03744473c20",
                        "source_sense_description": "Celui dont la profession est de graver",
                        "target_lang_word": "Grafiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grafiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aeaf935-4582-3549-9e38-1f75e94bc7a9",
                                        "entry_id": "7d4843ef-aff0-3fd1-a6e8-07981e5da845",
                                        "glosses": [
                                            "Gestalter künstlerischer oder kommerzieller bildlicher Darstellungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e3b475-243d-4db0-beb5-549fa4a2cc87",
                                                "sense_id": "8aeaf935-4582-3549-9e38-1f75e94bc7a9",
                                                "text": "„Der ‚Vater‘ der Mainzelmännchen, der Grafiker Wolf Gerlach, ist tot.“"
                                            },
                                            {
                                                "example_id": "fa3ac256-7839-4439-8678-e6698677f51c",
                                                "sense_id": "8aeaf935-4582-3549-9e38-1f75e94bc7a9",
                                                "text": "„Das Lamento zieht sich durch die gesamte Korrespondenz des Künstlers: Dürer, der Unternehmer, kann sich Dürer, den Maler, nicht leisten, weil Dürer, der Grafiker, darunter leidet.“"
                                            },
                                            {
                                                "example_id": "626bdaab-6f98-4169-b8c3-a29748524946",
                                                "sense_id": "8aeaf935-4582-3549-9e38-1f75e94bc7a9",
                                                "text": "„Der Marketingchef, der einen Grafiker mit einer Firmenjubiläumsbroschüre beauftragt, erwartet dann etwa nicht nur gestalterische Arbeit, sondern überlässt es dem armen Grafiker auch, sich zu überlegen, welche Fotos für die Broschüre wichtig sind und welche Gesamtdarstellung man erreichen möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4591cd14-1a90-42d8-8db4-5ff92cb22066",
                        "source_entry_id": "21af7088-34db-3c77-b164-e6f31c230dfe",
                        "source_sense_id": "d03f3da1-a65f-36cd-88d6-d03744473c20",
