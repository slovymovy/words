                "senses": [
                    {
                        "sense_id": "25626e3f-9ba6-3654-b4db-9201809afb41",
                        "entry_id": "f9813ba2-efb7-35f0-966f-9f9e4699f56e",
                        "glosses": [
                            "weibliche Person, die bei einer Wahl für die Österreichische Volkspartei (ÖVP) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f9ec3b-7e95-4a0b-83ea-665a7fe87297",
                                "sense_id": "25626e3f-9ba6-3654-b4db-9201809afb41",
                                "text": "„Vor vier Jahrzehnten konnten noch mehr als zwei Drittel der damaligen ÖVP-Wählerinnen und Wähler zum Kreis der regelmäßigen katholischen Kirchgänger gezählt werden.“"
                            },
                            {
                                "example_id": "89496a2d-3a16-4315-83d7-7ba4ed20bd57",
                                "sense_id": "25626e3f-9ba6-3654-b4db-9201809afb41",
                                "text": "„Diese Sichtweise wird zweifellos durch die Selbstpräsentation der Mutter und deren politische Unauffälligkeit nach 1945 – sie war ÖVP-Wählerin – erleichtert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
