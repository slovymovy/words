                "senses": [
                    {
                        "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                        "entry_id": "f9b0e9c1-728f-34c5-8f60-471d67674958",
                        "glosses": [
                            "Möbelstück, dessen Maße individuell (vom Käufer) bestimmt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f6ccde-0f0e-4b33-b5c8-dbdb9f163d5a",
                                "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                                "text": "„Die 40 individuell gestalteten Zimmer und Suiten (manche im Maisonettestil) sind mit Maßmöbeln wie Barschränken mit Blattsilber und Perlmutt ausgestattet.“"
                            },
                            {
                                "example_id": "2fe7eb60-6ea2-4c3f-bfdc-7175258a403d",
                                "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                                "text": "„Die Ausbauten, Maßmöbel und Böden bestehen aus Eiche natur geölt.“"
                            },
                            {
                                "example_id": "e6b42c88-63ce-4d5f-be47-2ad709148ede",
                                "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                                "text": "„Der Petershausener Meisterbetrieb stellt Maßmöbel aus unterschiedlichsten Qualitätshölzern her, entwirft und realisiert ganze Küchen oder komplette Schlafzimmer.“"
                            },
                            {
                                "example_id": "abe8d10b-b22b-48d9-a408-b36f52441631",
                                "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                                "text": "„Als Berufseinsteiger waren Maßmöbel ein Ding der Unfinanzierbarkeit.“"
                            },
                            {
                                "example_id": "695520b8-505f-4aa3-b825-323d53f28bc1",
                                "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                                "text": "„Die Teile mussten erst sortiert werden, damit beim Aufbau der Maßmöbel keine Komplikationen entstehen sollten.“"
                            },
                            {
                                "example_id": "29d877d4-973c-4a87-b320-fa130e876327",
                                "sense_id": "ff5a31ac-0b87-3f01-bcb9-a02988fcd160",
                                "text": "„Ländliche Tischlereien begannen nicht nur Maßmöbel, sondern auch Einrichtungsgegenstände ohne Vorbestellung zu produzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
