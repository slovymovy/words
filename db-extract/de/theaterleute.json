                    {
                        "sense_id": "7d07f833-3e59-3a53-8410-941317f2bcdb",
                        "entry_id": "ec6bd156-ef96-318e-8ba8-d1ec17ee0695",
                        "glosses": [
                            "Gesamtheit der Menschen, die in einem Theater arbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35bd12e-f547-4e5b-937a-52e8e3086943",
                                "sense_id": "7d07f833-3e59-3a53-8410-941317f2bcdb",
                                "text": "„Die Theaterleute begannen, von ihren erfolgreichsten Produktionen zu erzählen.“"
                            },
                            {
                                "example_id": "99475914-2f46-4d6e-a8b8-2075a302695e",
                                "sense_id": "7d07f833-3e59-3a53-8410-941317f2bcdb",
                                "text": "„Ein Großteil der so genannten Politisierung der Theaterleute hatte mit Brecht zu tun, und zwar mit der Lektüre und dem Studium von Brechts Theatertheorie.“"
                            },
                            {
                                "example_id": "5e480a4b-22cc-4cb7-8b5f-7fb69831116a",
                                "sense_id": "7d07f833-3e59-3a53-8410-941317f2bcdb",
                                "text": "„Walter Süß berichtet, daß die eigentliche Initiative vom Neuen Forum ausgegangen sei, das die Schauspielerin Jutta Wachowiak dazu animiert habe, die Idee einer Demonstration auf einer Versammlung von 800 Berliner Theaterleuten am 15.10. in die Diskussion zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
