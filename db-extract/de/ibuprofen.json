                "senses": [
                    {
                        "sense_id": "72d307ef-4528-37b3-9b2d-1f613852dff4",
                        "entry_id": "4fa41a6b-6ee3-3893-81f3-ae7020c539ba",
                        "glosses": [
                            "Ibuprofène."
