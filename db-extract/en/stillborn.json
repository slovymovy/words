    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                "word": "stillborn",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6fa47fe7-11d0-3c36-9bec-2fe880e4bf36",
                        "entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                        "glosses": [
                            "Dead at birth."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "906a7daa-8a7e-4e58-a1a6-d64727c42b63",
                                "sense_id": "6fa47fe7-11d0-3c36-9bec-2fe880e4bf36",
                                "text": "Queen Anne, before Elizabeth, bore a still-born son."
                            },
                            {
                                "example_id": "2a2fdd26-7a80-4e7b-86ad-1f3516f3cdca",
                                "sense_id": "6fa47fe7-11d0-3c36-9bec-2fe880e4bf36",
                                "text": "1978, Holy Bible (New International Version), Job 3:16,\nOr why was I not hidden in the ground like a stillborn child, like an infant who never saw the light of day?"
                            }
                        ]
                    },
                    {
                        "sense_id": "73ce461e-de2d-3b69-b9ac-5d7d4143a5c1",
                        "entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                        "glosses": [
                            "Ignored, without influence, or unsuccessful from the outset; abortive."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cfdf7129-f863-455b-b4ea-98aa478097b7",
                                "sense_id": "73ce461e-de2d-3b69-b9ac-5d7d4143a5c1",
                                "text": "This, gentlemen, is a list of the joint-stock companies created last year. . . . Of these some were stillborn, but the majority hold the market."
                            },
                            {
                                "example_id": "f57558da-ac16-40f5-857b-04845ac33bb4",
                                "sense_id": "73ce461e-de2d-3b69-b9ac-5d7d4143a5c1",
                                "text": "His lips framed themselves to whistle the first bars of a popular song, but the sound died stillborn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f2a8525-0c95-4278-b89f-165a78e541ff",
                        "source_entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                        "source_sense_description": "dead at birth",
                        "target_lang_word": "mrtvorozený",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ae7a7f2e-14f5-4442-99bc-4ec19afb7ada",
                        "source_entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                        "source_sense_description": "dead at birth",
                        "target_lang_word": "doodgeboren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doodgeboren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "60a04a9a-7590-3ae1-a64a-5c46bb2b126c",
                                        "entry_id": "59e46e76-eca7-3cef-90ed-d8176e6da0cd",
                                        "glosses": [
                                            "bij de geboorte al overleden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183224e6-6fb7-4239-be11-546a2d76bb5c",
                                                "sense_id": "60a04a9a-7590-3ae1-a64a-5c46bb2b126c",
                                                "text": "Als moeder van een doodgeboren én een te vroeg geboren dochter weet ik wat het is om kinderen te verliezen. Ik vel dan ook geen oordeel over de keuze die ouders maken om hun veel te vroeggeboren kindje te laten behandelen. Maar hoe ‘maakbaar’ moet onze samenleving zijn?"
                                            },
                                            {
                                                "example_id": "07c79f9e-73b5-496a-890b-63bb3f8fd22b",
                                                "sense_id": "60a04a9a-7590-3ae1-a64a-5c46bb2b126c",
                                                "text": "In Nederland doet Justitie onderzoek naar de Dordtse lycrafabriek van DuPont, waarvan zeker 33 vrouwelijke werknemers doodgeboren baby's, miskramen, baarmoederhalskanker of kinderen met afwijkingen kregen na blootstelling aan DMAc, zoals bleek uit onderzoek van Een Vandaag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6724912-2f9a-47ab-9961-253b0c8e8924",
                        "source_entry_id": "ec3af394-9ea8-3529-9b3f-6e27c554aee6",
                        "source_sense_description": "dead at birth",
                        "target_lang_word": "mort-né",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mort-né",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98c059b9-bff1-3f13-b54f-5c6d0223cdf1",
                                        "entry_id": "fa2c643b-7387-3ebb-8d26-c3f6ee53057a",
                                        "glosses": [
                                            "Mort en venant au monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e835dbc6-ef5a-4fa6-a17b-7f86ba0980fa",
                                                "sense_id": "98c059b9-bff1-3f13-b54f-5c6d0223cdf1",
                                                "text": "À ma sœur, on avait donné le prénom d’une aînée mort-née, qui portait déjà celui d’une tante défunte."
                                            },
                                            {
                                                "example_id": "ba1dd1f0-229d-48f6-825c-74fad90a21aa",
                                                "sense_id": "98c059b9-bff1-3f13-b54f-5c6d0223cdf1",
                                                "text": "On connaît ses fringues extravagantes, la veste en lézard et le costume de 2 000 dollars en poulain mort-né, qu’il jeta un jour dans la poubelle d’un aéroport, son chapeau orné d’une superbe tête de mort, tibias croisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f22dc6-44ad-393a-865b-260c528a8b9e",
                                        "entry_id": "fa2c643b-7387-3ebb-8d26-c3f6ee53057a",
                                        "glosses": [
                                            "Qui échoue dès le début."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10463d76-75b3-42fe-b87a-128c7b5e52c6",
                                                "sense_id": "a3f22dc6-44ad-393a-865b-260c528a8b9e",
                                                "text": "Un ouvrage, poème, une tragédie mort-née."
                                            },
                                            {
                                                "example_id": "6dfcde70-e4ae-4a09-a3dc-3547f3b2524e",
                                                "sense_id": "a3f22dc6-44ad-393a-865b-260c528a8b9e",
                                                "text": "La lutte antijuive, esquissée vers 1881 avec la création de deux journaux morts-nés l’Antijuif et l’Antisémite de Montdidier, ne devint vraiment sérieuse qu’en 1883, avec la fondation, par les Assomptionnistes, du journal La Croix."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mort-né",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6482ab-737a-3867-bd54-712fc1c1f82e",
                                        "entry_id": "68e5cac2-799b-3106-af6c-1919f3728417",
                                        "glosses": [
                                            "Mort en venant au monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a6bc51-8e59-4d4a-8b7a-b736aef148cd",
                                                "sense_id": "fa6482ab-737a-3867-bd54-712fc1c1f82e",
                                                "text": "Un mort-né."
                                            },
                                            {
                                                "example_id": "bec532a7-dbca-49cc-baba-ad3e34706b9a",
                                                "sense_id": "fa6482ab-737a-3867-bd54-712fc1c1f82e",
                                                "text": "Les maladies qui ont des répercussions sur le fœtus en fin de gestation peuvent occasionner la naissance de mort-nés ou de nouveau-nés vivants mais faibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
