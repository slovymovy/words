                    },
                    {
                        "sense_id": "fd088f0d-441f-3513-bf18-3940eea48ea9",
                        "entry_id": "32202d8a-e940-353c-9951-c1699e7f59bc",
                        "glosses": [
                            "Spooked; afraid; frightened."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ee0ff914-9438-49dc-a5cf-19ed82ef6d3e",
                                "sense_id": "fd088f0d-441f-3513-bf18-3940eea48ea9",
                                "text": "I thought it was nice, though I found it very quiet, and whenever I was alone in it, I felt spooky."
                            }
                        ]
                    },
