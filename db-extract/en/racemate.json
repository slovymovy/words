                        "glosses": [
                            "A mixture which is racemic (“containing equal amounts of dextrorotatory and levorotatory stereoisomers and therefore not optically active”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7930e385-7698-434c-9d6b-33be77516805",
                                "sense_id": "a687ae92-bc1f-3603-9113-5d668a1a0919",
                                "text": "Тhe greatest racemate contents were found in the products prepared in dimethylformamide and dimethylsulphoxide."
                            },
                            {
                                "example_id": "7337ae5c-11a2-4ddf-b562-754ff6cc4d9f",
                                "sense_id": "a687ae92-bc1f-3603-9113-5d668a1a0919",
                                "text": "Let us discuss different scenarios that may arise from a racemate consisting of two enantiomers."
                            }
                        ]
                    }
