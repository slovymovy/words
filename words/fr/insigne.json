    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6614250c-67c7-3176-aec1-055e204214aa",
                    "sense_definition": "Marque, écusson ou petit objet distinctif qui indique l'appartenance à un groupe, à un ordre ou à une organisation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marque_distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque membre de l'association porte un <w>insigne</w> en métal sur sa veste lors des réunions."
                        },
                        {
                            "text": "Il a soigneusement épinglé l'<w>insigne</w> de son régiment sur sa tenue d'apparat."
                        }
                    ],
                    "synonyms": [
                        "badge",
                        "écusson"
                    ],
                    "common_phrases": [
                        "porter un insigne",
                        "insigne du club"
                    ]
                },
                {
                    "sense_id": "b6f0c1ed-641c-3a3b-bcd8-f8c3401ce7fa",
                    "sense_definition": "Symbole, attribut ou marque matérielle officielle d'une dignité, d'un pouvoir ou d'un grade.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marque_distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général lui a remis solennellement les <w>insignes</w> de son nouveau grade devant ses pairs."
                        },
                        {
                            "text": "Lors de la cérémonie d'investiture, le maire a revêtu les <w>insignes</w> de sa charge municipale."
                        }
                    ],
                    "synonyms": [
                        "attribut",
                        "emblème"
                    ],
                    "common_phrases": [
                        "insignes du pouvoir",
                        "recevoir les insignes"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2e1e175f-8532-3307-b77e-814c06b754eb",
                    "sense_definition": "Qui est remarquable au plus haut point, exceptionnel ou éminent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "remarquable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un <w>insigne</w> honneur pour notre institution que d'accueillir un invité si prestigieux."
                        },
                        {
                            "text": "Le conseil municipal a accordé une faveur <w>insigne</w> à ces bénévoles dévoués."
                        }
                    ],
                    "synonyms": [
                        "remarquable",
                        "éminent"
                    ],
                    "antonyms": [
                        "insignifiant"
                    ],
                    "common_phrases": [
                        "insigne honneur",
                        "faveur insigne"
                    ]
                },
                {
                    "sense_id": "6bc8422a-640a-36e0-b91e-1e35c706be16",
                    "sense_definition": "Qui est éclatant et considérable en mauvaise part ; flagrant ou notoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remarquable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Commettre une telle faute stratégique en pleine négociation relève d'une <w>insigne</w> maladresse."
                        },
                        {
                            "text": "Le tribunal a fermement sanctionné cette cruauté <w>insigne</w> commise à l'égard d'animaux sans défense."
                        }
                    ],
                    "synonyms": [
                        "notoire",
                        "flagrant",
                        "manifeste"
                    ],
                    "common_phrases": [
                        "insigne maladresse",
                        "cruauté insigne"
                    ]
                }
            ]
        }
    ]
