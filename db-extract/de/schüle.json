                ],
                "senses": [
                    {
                        "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                        "entry_id": "8fe45e91-77b7-3276-946c-17d806e77087",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c917ceb5-07e1-497b-a3e0-03f75bda4577",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Frau Schüle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6e82a6d1-923c-41f2-a233-c03752b74e26",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Herr Schüle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6da65bcf-3eda-4958-aa6c-2516ec90c2f4",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Die Schüles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "762f627a-cd3f-4a7c-8716-5ef2532c0779",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Der Schüle trägt nie die Schals, die die Schüle ihm strickt."
                            },
                            {
                                "example_id": "9423633e-aeb1-4ddf-ad69-6716184d9519",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schüle kommt, geht der Herr Schüle.“"
                            },
                            {
                                "example_id": "dd25e568-dbbf-4b81-82ab-c3ca298131ea",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Schüle kommt und geht."
                            },
                            {
                                "example_id": "e5900c40-20c4-4abf-ad9e-82e3caf48ed7",
                                "sense_id": "9cbdb91e-4b65-3ac9-9c65-bfa4c2e1cdba",
                                "text": "Schüles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
