                "senses": [
                    {
                        "sense_id": "d21b7f05-635a-3a28-bbbb-957ba0236500",
                        "entry_id": "b8ee1984-ba67-37be-adf4-198ecd6c186b",
                        "glosses": [
                            "Apocope de cyclorama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70c27fb-7c3e-4802-8f87-9313715a16d6",
                                "sense_id": "d21b7f05-635a-3a28-bbbb-957ba0236500",
                                "text": "Connaîtriez-vous des plateaux de tournage avec cyclo vert ou bleu chroma dans le sud de la France ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4e1d6e63-f71e-3a5b-8214-ff9508f445f0",
                        "entry_id": "b8ee1984-ba67-37be-adf4-198ecd6c186b",
                        "glosses": [
                            "Apocope de cyclomoteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9082e4d9-90f0-4561-bd0e-00cf71457fb4",
                                "sense_id": "4e1d6e63-f71e-3a5b-8214-ff9508f445f0",
                                "text": "À Hanoi, la capitale de six millions d’habitants, la congestion routière due au nombre croissant de voitures est telle que les cyclos poussifs sont maintenant relégués au secteur touristique du lac Hoan Kiem."
                            },
                            {
                                "example_id": "03a8a6e9-5f27-4e28-8daf-d241b5b7458e",
                                "sense_id": "4e1d6e63-f71e-3a5b-8214-ff9508f445f0",
                                "text": "Il a couru d’un trottoir à l’autre, un clodard en cyclo a fait une embardée pour ne pas l’embugner et s’est ramassé en hurlant des douceurs en arabe."
                            }
                        ]
                    }
                ],
