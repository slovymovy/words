{
    "word_family": [
        "erase",
        "erasable",
        "erasure"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbe233fa-ad02-3261-bfdf-99ac3ab785d3",
                    "sense_definition": "An object used to erase or remove something written or drawn by a pen or a pencil.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "stationery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have worn out the <w>eraser</w> on this pencil.",
                            "target_lang_translations": {
                                "ru": "Я совсем стёр <w>ластик</w> на этом карандаше."
                            }
                        },
                        {
                            "text": "Please use a pencil <w>eraser</w> to rub out the mistake.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, используй карандашный <w>ластик</w>, чтобы стереть ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "rubber",
                        "india rubber"
                    ],
                    "common_phrases": [
                        "pencil eraser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, используемый для стирания или удаления написанного или нарисованного ручкой или карандашом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ластик",
                                "target_lang_sense_clarification": "канцелярская принадлежность для удаления карандашных надписей"
                            },
                            {
                                "target_lang_word": "стирательная резинка",
                                "target_lang_sense_clarification": "официальное название канцелярской принадлежности"
                            },
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "разговорное название ластика"
                            },
                            {
                                "target_lang_word": "стёрка",
                                "target_lang_sense_clarification": "разговорное, региональное название ластика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fd237e5-3689-3a8d-8c0c-3ae68c2eca0b",
                    "sense_definition": "An object used to erase something written either by chalk on a chalkboard, by a marker on a whiteboard, or by some other erasable implement.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "stationery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked a student to clean the board with a chalkboard <w>eraser</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика стереть с доски школьной <w>губкой</w>."
                            }
                        },
                        {
                            "text": "We need a new whiteboard <w>eraser</w> because this one is too dirty.",
                            "target_lang_translations": {
                                "ru": "Нам нужен новый <w>стиратель</w> для маркерной доски, потому что этот слишком грязный."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chalkboard eraser",
                        "whiteboard eraser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, используемый для стирания мела со школьной доски, маркера с магнитно-маркерной доски или других стираемых надписей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губка",
                                "target_lang_sense_clarification": "для стирания с доски"
                            },
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "для вытирания школьной доски"
                            },
                            {
                                "target_lang_word": "стиратель",
                                "target_lang_sense_clarification": "для магнитно-маркерных досок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81c08fad-82c7-3047-b451-562ddc8ce443",
                    "sense_definition": "One who erases.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>eraser</w> of historical records, his job was to censor sensitive documents.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>стирателем</w> исторических хроник, его работа заключалась в цензурировании секретных документов."
                            }
                        },
                        {
                            "text": "The editor acted as an <w>eraser</w> of unnecessary words in the manuscript.",
                            "target_lang_translations": {
                                "ru": "Редактор выступил в роли <w>истребителя</w> лишних слов в рукописи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто стирает, удаляет или уничтожает информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиратель",
                                "target_lang_sense_clarification": "тот, кто стирает или уничтожает что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e7c870-37e9-3ea5-8ed0-051a19a36816",
                    "sense_definition": "An overwriter program used to prevent data recovery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ran a digital <w>eraser</w> to permanently delete the confidential files from the hard drive.",
                            "target_lang_translations": {
                                "ru": "Он запустил цифровой <w>шредер</w>, чтобы навсегда удалить конфиденциальные файлы с жесткого диска."
                            }
                        },
                        {
                            "text": "Using a secure file <w>eraser</w> ensures that deleted data cannot be recovered by hackers.",
                            "target_lang_translations": {
                                "ru": "Использование надежной программы для <w>удаления</w> файлов гарантирует, что удаленные данные не смогут восстановить хакеры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "file eraser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Программа для перезаписи данных с целью предотвращения их восстановления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шредер файлов",
                                "target_lang_sense_clarification": "программа для безвозвратного удаления данных"
                            },
                            {
                                "target_lang_word": "программа-стиратель",
                                "target_lang_sense_clarification": "утилита для очистки дисков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}