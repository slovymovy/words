                    },
                    {
                        "translation_id": "8684125c-d7e8-4f67-804d-ba824baf0d26",
                        "source_entry_id": "a2b71ae1-8f7d-3a14-b1dd-e2069ee93ecf",
                        "source_sense_id": "df032e70-4304-3339-940a-0e2f08771641",
                        "source_sense_description": "het hoogste diploma dat aan een universiteit behaald kan worden",
