                    {
                        "sense_id": "9c29ecfe-2576-3245-92c4-fe2d70e105c9",
                        "entry_id": "b0252ae1-fd97-37fa-9378-703169e435ef",
                        "glosses": [
                            "A stronger version of an argument that one is about to critically analyze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d65f41-abbc-45ee-831c-d46e4ffba43b",
                                "sense_id": "9c29ecfe-2576-3245-92c4-fe2d70e105c9",
                                "text": "a \"steel man\" is an improvement of someone's position or argument that is harder to defeat than their originally stated position or argument."
                            },
                            {
                                "example_id": "78b12556-4e19-4aa5-96a8-94c0a826688b",
                                "sense_id": "9c29ecfe-2576-3245-92c4-fe2d70e105c9",
                                "text": "I want to make that strawman into a steelman, but I eliminated \"the pursuit of happiness\" from my to-do list so many years ago that I don't even know where I'd begin."
                            }
                        ]
                    }
                ],
