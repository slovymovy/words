                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                        "entry_id": "f290aa02-b11e-3c11-b144-53cf5b5985f3",
                        "glosses": [
                            "regnerisches, schlechtes Wetter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0accf3ec-4fb6-4ac8-ac1d-1a1582c980ca",
                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                "text": "Laut der Wettervorhersage steht uns in den nächsten Tagen Regenwetter bevor."
                            },
                            {
                                "example_id": "ece3541e-ec4e-4a74-9dec-0b412cd7d55f",
                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                "text": "„Und keiner soll glauben, daß es mir bei Regenwetter übler erging.“"
                            },
                            {
                                "example_id": "2a24e951-9fb1-4e59-a7b7-0824b26d0010",
                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                "text": "„Der Kutscher sprach die Hoffnung aus, es möge bis Wilna kein schweres Regenwetter geben, sonst müssten die Kranken ersaufen.“"
                            },
                            {
                                "example_id": "e5790917-e44a-45a0-b867-be2d8d285fde",
                                "sense_id": "bd67cfbd-7a88-39c4-a321-fcf1bd55ec4b",
                                "text": "„Ihre Giebelstube war, wie sie von ihr verlassen, ausgenommen, daß man das Dach neu gedeckt, und die Giebelwände, durch die es im Herbst bei Regenwetter geleckt, waren ausgebessert; ein neues Fenster hatte man eingesetzt, und es duftete nach gehobeltem Holz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
