                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c1a89a-1188-4c84-83ea-b97a8515c6e2",
                                "sense_id": "9ae93a94-00aa-3717-875a-f8cb1370d625",
                                "text": "Turkije kwam echter weer wat beter in de wedstrijd en het bleef tot aan het einde ongekend spannend. Oranje kreeg in de laatste vijftien seconden, en bij een 26-26 stand, een vrije worp, die werd benut door Kay Smits, waarna keeper Bart Ravensbergen in de slotseconde de gelijkmaker van de Turken voorkwam."
                            },
                            {
                                "example_id": "576958f1-efb0-4091-b78b-6d0f0453fe39",
                                "sense_id": "9ae93a94-00aa-3717-875a-f8cb1370d625",
                                "text": "De 27-jarige basketballer schoot in de slotseconde een driepunter raak en bracht daarmee de eindstand in het duel met de Nuggets op 105-103. Davis - in totaal goed voor 31 punten - werd na afloop overladen met complimenten."
                            }
                        ]
                    }
