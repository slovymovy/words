                                                "example_id": "09b1e379-6a61-4e08-a3a8-5788d5729bc0",
                                                "sense_id": "a8beef74-136b-3d2a-a78b-bb31eafb3c97",
                                                "text": "y no te olvides de atar el pañito de hilo en el gollete para que no se derrame el vino."
                                            }
