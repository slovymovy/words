                "senses": [
                    {
                        "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                        "entry_id": "03e0a84f-407e-3b29-a372-5f22ab0e8a02",
                        "glosses": [
                            "Geschoss aus Stahl, das mit Gummi ummantelt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b9b668-4843-4501-bc6e-1e62b75dc3c3",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Eine junge Italienerin verlor ein Auge, als sie von einem Gummimantelgeschoß getroffen wurde.“"
                            },
                            {
                                "example_id": "c69e13a3-64cd-4f4a-b5c4-3089a47b9780",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Die Polizei habe ein Gummimantelgeschoß abgefeuert, berichtete die Polizei.“"
                            },
                            {
                                "example_id": "bd056911-2bf3-4794-abde-924fc8e5f658",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Mit dem Tod eines 15-jährigen Palästinensers, der von einem israelischen Gummimantelgeschoss am Kopf getroffen worden war, ist die Zahl der Toten auf sieben gestiegen.“"
                            },
                            {
                                "example_id": "54179d12-9e7f-40d0-af55-cd4337e2aaae",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Eine zweijährige Palästinenserin, die bei Bethlehem von einem Gummimantelgeschoss getroffen wurde, schwebte in Lebensgefahr.“"
                            },
                            {
                                "example_id": "949046fc-5086-4a96-8811-edbe176e658a",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Bei einer Demonstration in Ramallah gegen die israelische Blockade der Stadt wurden acht Palästinenser durch Gummimantelgeschosse und Tränengasgranaten verletzt.“"
                            },
                            {
                                "example_id": "8cab57df-ad97-43f2-83f7-30071193010d",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Die Ärzte registrierten weiter vereinzelte Verletzungen durch Gummimantelgeschosse sowie Knochenbrüche.“"
                            },
                            {
                                "example_id": "b98e1bc4-294b-41fb-8477-034baf643968",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Die Polizisten setzten Gummimantelgeschosse und Tränengas ein, die Demonstranten antworteten mit Steinen und Molotowcocktails.“"
                            },
                            {
                                "example_id": "98b4492d-ad5b-4368-965f-276f0b3def21",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Anders als in der Nacht zuvor mussten die Sicherheitskräfte diesmal aber keine Wasserwerfer und Gummimantelgeschosse gegen die Randalierer einsetzen.“"
                            },
                            {
                                "example_id": "26315b2f-e671-49d2-81d1-8924a39ddfd4",
                                "sense_id": "8ae6abf2-a80c-3de6-bd28-d080c2aa0c8e",
                                "text": "„Die Sicherheitskräfte feuerten am Freitag Tränengas und Gummimantelgeschosse auf rund 10.000 Menschen, die den Rücktritt der Regierung forderten, wie ein AFP-Reporter berichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
