                                "target_senses": [
                                    {
                                        "sense_id": "d0ef9bb7-2015-3e08-86d7-bfcf1c77e834",
                                        "entry_id": "47207f85-e441-3eac-bf61-b56374a130e2",
                                        "glosses": [
                                            "Race de chiens à poil long, fin et frisé, issu de croisement de barbet et de grand épagneul. ^([2])"
                                        ],
                                        "tags": [
