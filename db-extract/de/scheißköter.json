                                "sense_id": "765a162d-d100-3824-b870-45e3435f10e6",
                                "text": "„Wieder diese Scheißköter!“"
                            },
                            {
                                "example_id": "5966add6-f39d-417f-80aa-4963b9e5d5f6",
                                "sense_id": "765a162d-d100-3824-b870-45e3435f10e6",
                                "text": "„Ich glaub, dein Scheißköter hat Hunger!“"
                            },
                            {
                                "example_id": "90a265aa-c0df-4a0a-9a59-7f2466512afc",
                                "sense_id": "765a162d-d100-3824-b870-45e3435f10e6",
                                "text": "„Frisst mir die ganze Schlempe. Mach das Zeug ja nich für so’n blöden Scheißköter da.“"
                            }
                        ],
