                ],
                "senses": [
                    {
                        "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                        "entry_id": "a08fdbfc-c68f-3786-8e6b-6a744d9dd641",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32f6dcae-94ca-4449-8850-066edb7cd6e2",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schaumann kommt, geht der Herr Schaumann.“"
                            },
                            {
                                "example_id": "90975fbc-13e1-4644-81c0-d359f21046f5",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Schaumann kommt und geht."
                            },
                            {
                                "example_id": "c238dbd9-c499-4d09-80d3-18fd91c9fbc0",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Schaumanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "27016520-3a50-4fd4-8f15-a2e6aa0a651a",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Der Schaumann trägt nie die Schals, die die Schaumann ihm strickt."
                            },
                            {
                                "example_id": "792c7fd1-22ed-47fc-9d8f-af265a70b965",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Frau Schaumann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c20acc5f-c39f-4d57-9aba-f9952133c60d",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Herr Schaumann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a8b0424a-e6d4-4236-bac0-cad68b447532",
                                "sense_id": "f2e02119-d4aa-30c4-ab1a-8e5175029db6",
                                "text": "Die Schaumanns fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
