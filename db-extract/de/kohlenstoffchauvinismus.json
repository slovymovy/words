                "senses": [
                    {
                        "sense_id": "5d5db01e-45d0-365f-b51f-8ddde19ac979",
                        "entry_id": "17a6b7c3-5067-39d1-bf67-18e7340a9064",
                        "glosses": [
                            "die ausschließliche Betrachtung von Kohlenstoff als Grundlage außerirdischen Lebens"
                        ],
                        "tags": [
                            "Exobiologie",
                            "spöttisch"
                        ],
                        "examples": [
                            {
                                "example_id": "d71b2b14-0cc4-4d7a-ab96-580f74bd6808",
                                "sense_id": "5d5db01e-45d0-365f-b51f-8ddde19ac979",
                                "text": "„Astrobiologen suchen auf fernen Himmelskörpern meist nach chemischen Verbindungen, deren Grundgerüst aus dem Element Kohlenstoff aufgebaut ist. Diese mitunter als Kohlenstoffchauvinismus bezeichnete Fokussierung hat im Wesentlichen zwei Gründe:“"
                            },
                            {
                                "example_id": "6c6dc008-fada-408c-bb1a-bda4952f5e59",
                                "sense_id": "5d5db01e-45d0-365f-b51f-8ddde19ac979",
                                "text": "„Oft wird der Biologie ein so genannter Kohlenstoffchauvinismus vorgeworfen: Andere stoffliche Grundlagen wie z.B. auf Silizium basiertes Leben müsse man zumindest theoretisch in Erwägung ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
