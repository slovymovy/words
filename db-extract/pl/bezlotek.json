                "senses": [
                    {
                        "sense_id": "3ae712e3-8db6-32e2-85b7-b6db7c3dd8fe",
                        "entry_id": "bf0513ee-1479-33dc-b0a5-4c6ec9f9d3f1",
                        "glosses": [
                            "penguin, sphenisciform (flightless sea bird)"
                        ],
                        "tags": [
                            "animal-not-person",
                            "dated",
                            "formal",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8e71d301-bac3-450e-891a-4f7e102d2fee",
                                "sense_id": "3ae712e3-8db6-32e2-85b7-b6db7c3dd8fe",
                                "text": "Ze wszystkich ptaków podbiegunowych bezwarunkowo najciekawsze są bezlotki południa, inaczej pingwiny.",
                                "translation": "Of all the Arctic birds, the most interesting are the southern flightless birds, also called penguins.",
                                "english": "Of all the Arctic birds, the most interesting are the southern flightless birds, also called penguins."
                            }
                        ]
                    }
