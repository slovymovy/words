                        "examples": [
                            {
                                "example_id": "bd597b8e-4c16-45c5-b556-704af01a867c",
                                "sense_id": "908427f5-bad0-3bc5-826d-331f4921c704",
                                "text": "Maar: ieder ogenblik dat hij voor het voetlicht stond was hij de valsaard, de meinedige stadhouder, de door zondige begeerte verscheurde tartuffe; hij was, zonder één moment verpozing, een schurk, in zijn starre blik, in zijn vertrokken mond, in zijn vingeren, in zijn gang."
                            },
                            {
                                "example_id": "08b393c8-5a13-43f2-8072-57cc132f37ad",
                                "sense_id": "908427f5-bad0-3bc5-826d-331f4921c704",
                                "text": "(…) want ziet gij, als men een geboren ‘mousquetaire’ tot een heilige wil maken, dan moet men hem vergeven, dat hij te eerlijk is om een ‘tartuffe’ te willen zijn."
                            }
                        ]
