                                        "entry_id": "d7080171-bb25-3bca-a193-188641b1a1fc",
                                        "glosses": [
                                            "A portion.",
                                            "A discrete unit of speech: a consonant or a vowel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6442140c-926b-328d-81be-283507689391",
                                        "entry_id": "d7080171-bb25-3bca-a193-188641b1a1fc",
                                        "glosses": [
                                            "A portion.",
                                            "A portion of an organ whose cells are derived from a single cell within the primordium from which the organ developed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e43624-03b0-4f0a-8834-f2554e230863",
                                                "sense_id": "6442140c-926b-328d-81be-283507689391",
                                                "text": "In Lejeuneaceae vegetative branches normally originate from the basiscopic basal portion of a lateral segment half, as in the Radulaceae, and the associated leaves, therefore, are quite unmodified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6acaf369-05c0-3991-bef2-b6657064fd82",
                                        "entry_id": "d7080171-bb25-3bca-a193-188641b1a1fc",
                                        "glosses": [
                                            "A portion.",
                                            "One of several parts of an organism, with similar structure, arranged in a chain; such as a vertebra, or a third of an insect's thorax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae36a20f-dd58-33a1-af87-8e7f3463b56c",
                                        "entry_id": "d7080171-bb25-3bca-a193-188641b1a1fc",
                                        "glosses": [
                                            "A part of a broadcast program, devoted to a topic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbaa71be-45dc-45f6-ab44-02051a9c1766",
                                                "sense_id": "ae36a20f-dd58-33a1-af87-8e7f3463b56c",
                                                "text": "The news showed a segment on global warming."
                                            },
                                            {
                                                "example_id": "dc1a490b-1a42-432d-9c71-7f46dec7f9bf",
                                                "sense_id": "ae36a20f-dd58-33a1-af87-8e7f3463b56c",
                                                "text": "In “Treehouse Of Horror” episodes, the rules aren’t just different—they don’t even exist. If writers want Homer to kill Flanders or for a segment to end with a marriage between a woman and a giant ape, they can do so without worrying about continuity or consistency or fans griping that the gang is behaving out of character."
                                            }
                                        ]
