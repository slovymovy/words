                "senses": [
                    {
                        "sense_id": "783b6130-d3c2-3de1-ba92-37ffe94adbca",
                        "entry_id": "ac508d11-ca63-3010-b758-66ce5b73ed16",
                        "glosses": [
                            "Gasse, die von einem Hauptweg/einer Hauptstraße abgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b74a4a-424c-4c52-9e27-14e91f292f21",
                                "sense_id": "783b6130-d3c2-3de1-ba92-37ffe94adbca",
                                "text": "„Unter den kleinen Hotels in den Seitengassen wählte ich lange, ehe ich eins fand, das verwahrlost genug aussah, um für einen Unterschlupf passend zu sein.“"
                            },
                            {
                                "example_id": "f78da536-d209-490b-992a-0f742d56666b",
                                "sense_id": "783b6130-d3c2-3de1-ba92-37ffe94adbca",
                                "text": "„Ich wich in die nächstbeste stille Seitengasse aus und verlor mich im arabischen Viertel.“"
                            },
                            {
                                "example_id": "01d77c69-1b61-4ae6-aefb-1ec66c7240b5",
                                "sense_id": "783b6130-d3c2-3de1-ba92-37ffe94adbca",
                                "text": "„Grenfeld zerrte Kanther in eine Seitengasse in den Schatten einer Litfaßsäule.“"
                            },
                            {
                                "example_id": "db907ad8-d853-4c92-a98d-8d142f10bf06",
                                "sense_id": "783b6130-d3c2-3de1-ba92-37ffe94adbca",
                                "text": "„In einer Seitengasse war Charlotte verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
