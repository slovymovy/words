                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fce7b2-c397-485f-97ed-f65478802d04",
                                                "sense_id": "d1fa6897-ab16-3947-8291-c24edac70fca",
