                "senses": [
                    {
                        "sense_id": "d32e8d21-dce2-3d09-aad9-ce66838c4c91",
                        "entry_id": "be47cd40-f6f7-33ad-986a-12d744504825",
                        "glosses": [
                            "Flusslandschaft im westlichen Bayern und einem kleinen Gebiet an der südöstlichen Grenze von Baden-Württemberg, Deutschland"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "3305dab5-adf7-4dc9-8bac-089ceecdb0cf",
                                "sense_id": "d32e8d21-dce2-3d09-aad9-ce66838c4c91",
                                "text": "„Die Zahl von Brachvogel, Kiebitz und Co. im östlichen Donauried steigt – trotz des Hochwassers.“"
                            },
                            {
                                "example_id": "4174a6df-e5fd-4850-a5b0-99ba968b7e34",
                                "sense_id": "d32e8d21-dce2-3d09-aad9-ce66838c4c91",
                                "text": "„Oft wochenlang versinken die Orte im Donauried im einförmigen grauen Dunst und die Sonne schafft es einfach nicht, sich durchzukämpfen.“"
                            },
                            {
                                "example_id": "145fbd54-3e0a-4be4-9c4d-ca4e98fc2dc1",
                                "sense_id": "d32e8d21-dce2-3d09-aad9-ce66838c4c91",
                                "text": "„Das Wasserwerk Langnau ist das größte Wasserwerk der Landeswasserversorgung und liegt am Rand des württembergischen Donaurieds.“"
                            },
                            {
                                "example_id": "e9a519ba-b2c7-4b8d-a6f3-a8812f3a3eec",
                                "sense_id": "d32e8d21-dce2-3d09-aad9-ce66838c4c91",
                                "text": "„Die zweite Bezugsquelle, die im Bewusstsein der Menschen weniger präsent ist, sind das Donauried nordöstlich von Ulm mit dem Wasserwerk Langenau und die Ostalb nahe Dischingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d8deb75c-34ae-3f97-94c9-7d160bea341a",
                        "entry_id": "be47cd40-f6f7-33ad-986a-12d744504825",
                        "glosses": [
                            "Vogelschutzgebiet im südöstlichen Baden-Württemberg, Deutschland"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "e8caac45-ce76-4690-88ff-8de4b44ad73a",
                                "sense_id": "d8deb75c-34ae-3f97-94c9-7d160bea341a",
                                "text": "„Das Naturschutzgebiet „Langenauer Ried“ zählt in Verbindung mit dem Vogelschutzgebiet „Donauried“ zu den landesweit herausragenden Lebensräumen für Wiesenbrüter, wie die vom Aussterben bedrohte Bekassine, Kiebitz, Großer Brachvogel, Braunkehlchen und Grauammer.“"
                            },
                            {
                                "example_id": "e4cd4521-15da-41f9-818d-7d06850dfa4c",
                                "sense_id": "d8deb75c-34ae-3f97-94c9-7d160bea341a",
                                "text": "„Dort, ganz im Südosten unseres Landkreises, befindet sich das bedeutende, großflächige Vogelschutzgebiet „Donauried“.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
