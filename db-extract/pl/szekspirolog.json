                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8b46273-e757-4fd4-93d5-38f33416b76a",
                        "source_entry_id": "113ce504-afa4-354b-8272-cc86d2a62ef6",
                        "source_sense_id": "b36190d5-5bb1-3582-9b57-db6310b42116",
                        "target_lang_word": "Shakespearean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shakespearean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b84060d-ca16-3806-bb3d-0247fb91a04e",
                                        "entry_id": "2450b817-92e8-346c-a407-949f2e2ccf62",
                                        "glosses": [
                                            "Of or pertaining to, characteristic of, associated with, or suggestive of William Shakespeare (an English playwright), his works, or his authorship, or the time in which he lived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd44b4b-4c11-4a15-964f-6fde78e47935",
                                                "sense_id": "0b84060d-ca16-3806-bb3d-0247fb91a04e",
                                                "text": "[…]there were those who had them set far over back—wide-awake men, who wanted a clear prospect; while careless men, who did not know, or care, how their hats sat, had them shaking about in all directions. The various hats, in fact, were quite a Shakespearean study."
                                            },
                                            {
                                                "example_id": "d2c5abc5-ac69-4a0d-b230-c1cde274e4ae",
                                                "sense_id": "0b84060d-ca16-3806-bb3d-0247fb91a04e",
                                                "text": "The boisterous Bulmer playfully made a pass at him with his drawn sword, going forward with the lunge in the proper fencing fashion, and making a somewhat too familiar Shakespearean quotation about a rodent and a Venetian coin."
                                            },
                                            {
                                                "example_id": "d9759745-7612-478b-8aec-02274ad51fc2",
                                                "sense_id": "0b84060d-ca16-3806-bb3d-0247fb91a04e",
                                                "text": "Meanwhile, I presided over the Senate. I also dined quite frequently with the President who continued to delight and fascinate me with his conversation, not to mention his wonderful malice which was positively Shakespearean in its variety."
                                            },
                                            {
                                                "example_id": "a504b650-c4a3-4589-9822-0a54bebdc543",
                                                "sense_id": "0b84060d-ca16-3806-bb3d-0247fb91a04e",
                                                "text": "There was indeed something Shakespearean about both the service in the abbey and the marches that surrounded it. By Shakespearean I mean there was a blend of pageantry, procession, music and mystery."
                                            },
                                            {
                                                "example_id": "a4796c1f-845a-487e-b96a-6cb3a1065218",
                                                "sense_id": "0b84060d-ca16-3806-bb3d-0247fb91a04e",
                                                "text": "This is the distinctive milieu of Succession, the HBO juggernaut which turned the pitiful exploits of a bunch of media mogul failsons into Shakespearean drama for four critically acclaimed seasons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9976d3da-db1f-32fe-994d-ebee7f31cb72",
                                        "entry_id": "2450b817-92e8-346c-a407-949f2e2ccf62",
                                        "glosses": [
                                            "Derivative of Shakespeare's works or authorship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7d3a3fe-1ce9-3967-a4e6-276963c6ee08",
                                        "entry_id": "2450b817-92e8-346c-a407-949f2e2ccf62",
                                        "glosses": [
                                            "Composed of Shakespearean sonnets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Shakespearean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da9c8c98-fa8f-3a2b-9b1c-5ae38c642186",
                                        "entry_id": "354eab36-967f-327d-96b4-53a94beb2357",
                                        "glosses": [
                                            "A scholar of the works of Shakespeare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "506dfe78-29a9-4338-80f5-5d86214340d5",
                                                "sense_id": "da9c8c98-fa8f-3a2b-9b1c-5ae38c642186",
                                                "text": "Another lawyer and well-known Shakespearian, Richard Grant White, says: \"No dramatist of the time, not even [Francis] Beaumont, who was the younger son of a judge of the Common Pleas, and who after studying in the Inns of Court abandoned law for the drama, used legal phrases with Shakespeare's readiness and exactness.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f7578c-c2f2-3bcd-acfb-5dd185f1567e",
                                        "entry_id": "354eab36-967f-327d-96b4-53a94beb2357",
                                        "glosses": [
                                            "A person trained to act in Shakespeare's plays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Shakespearean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1476423-5616-38b9-8182-b41553458f58",
                                        "entry_id": "64035f50-318c-37aa-9358-f15fa6721dad",
                                        "glosses": [
                                            "Shakespearean English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d0c613-da85-4d23-b1b9-25fb1ccc4626",
                                                "sense_id": "a1476423-5616-38b9-8182-b41553458f58",
                                                "text": "I have had no one to talk to for ages. There’s Ma, who only talks in Shakespearean. And it took me ages to learn that and I still don’t understand the whole thing."
                                            },
                                            {
                                                "example_id": "49c61538-7cbf-4844-9f9f-244fc1bfd500",
                                                "sense_id": "a1476423-5616-38b9-8182-b41553458f58",
                                                "text": "Honorable Corps Commander, I am one of your seven personal robots at your residence, and I assure you I am the best. […] I can speak Shakespearean, Hoch Deutch, Urdu, and three other dead languages."
                                            },
                                            {
                                                "example_id": "6a12b3cd-4a84-4e80-aab9-0b17cd6e52a1",
                                                "sense_id": "a1476423-5616-38b9-8182-b41553458f58",
                                                "text": "No more playing with me like I’m your ball of yarn, Angel of Dipshit. I’m going to fry you so good you’ll start talking in Shakespearean."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
