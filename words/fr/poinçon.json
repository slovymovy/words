                    "frequency": "Middle",
                    "semantic_group_id": "marque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bijoutier examine le <w>poinçon</w> de la bague pour vérifier qu'elle est bien en or."
