                "senses": [
                    {
                        "sense_id": "1592907c-3903-3c97-8055-41f41da1fd16",
                        "entry_id": "0c10b766-dd19-3a84-8eb4-531cb369d17e",
                        "glosses": [
                            "Nachhilfeunterricht, Lernunterstützung, meist ergänzender Einzelunterricht"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "928c115f-ed93-4512-93dd-68e7353094c5",
                                "sense_id": "1592907c-3903-3c97-8055-41f41da1fd16",
                                "text": "Viele Eltern geben Unsummen für Nachhilfe aus."
                            },
                            {
                                "example_id": "79b6ad65-7e9b-4bf2-8acc-e8406decf87e",
                                "sense_id": "1592907c-3903-3c97-8055-41f41da1fd16",
                                "text": "Ohne Nachhilfe schafft sie das Abi bestimmt nicht."
                            },
                            {
                                "example_id": "26a752a1-7c7f-4429-af76-681d525e385a",
                                "sense_id": "1592907c-3903-3c97-8055-41f41da1fd16",
                                "text": "Er bessert sein Taschengeld mit Nachhilfe auf."
                            },
                            {
                                "example_id": "0ba13b58-6326-42ce-ab76-0eefa0daf2ae",
                                "sense_id": "1592907c-3903-3c97-8055-41f41da1fd16",
                                "text": "„Er mußte das eintragen, weil die durch Nachhilfe erreichten Leistungen niedriger bewertet wurden.“"
                            },
                            {
                                "example_id": "0af3641e-af3e-42ab-87ba-8d0a988a142b",
                                "sense_id": "1592907c-3903-3c97-8055-41f41da1fd16",
                                "text": "„Zwei Schülerinnen der Mittelstufe suchten Nachhilfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "408ffaba-37c8-306d-b676-3a9f766f9140",
                        "entry_id": "0c10b766-dd19-3a84-8eb4-531cb369d17e",
                        "glosses": [
                            "das Nachhelfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7288ecb-bff3-4bbd-9238-e9384e60064f",
                                "sense_id": "408ffaba-37c8-306d-b676-3a9f766f9140",
                                "text": "Eine Nachhilfe von Seiten des Meisters war nicht mehr notwendig."
                            },
                            {
                                "example_id": "fadce8d3-5906-48d2-b146-b1afc21ba3ce",
                                "sense_id": "408ffaba-37c8-306d-b676-3a9f766f9140",
                                "text": "Ohne die Nachhilfe seines Onkels hätte er kaum einen Ausbildungsplatz bekommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
