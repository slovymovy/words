                {
                    "sense_id": "a79b657c-830e-371a-8860-2ea248332a99",
                    "sense_definition": "Mettre des choses en désordre ou rendre une situation obscure et compliquée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desordre_materiel_ou_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat a joué avec la pelote de laine et a réussi à <w>embrouiller</w> tous les fils.",
                            "target_lang_translations": {
                                "en": "The cat played with the ball of wool and managed to <w>tangle</w> all the threads.",
                                "ru": "Кот играл с клубком шерсти и ухитрился <w>спутать</w> все нитки.",
                                "de": "Die Katze spielte mit dem Wollknäuel und schaffte es, alle Fäden zu <w>verwirren</w>.",
                                "es": "El gato jugó con el ovillo de lana y consiguió <w>enredar</w> todos los hilos.",
                                "zh": "猫玩毛线球时，居然把线都<w>搞乱</w>了。"
                            }
                        },
                        {
                            "text": "Ce nouveau témoignage imprévu risque d'<w>embrouiller</w> la situation au tribunal.",
                            "target_lang_translations": {
                                "en": "This unexpected new testimony risks <w>muddling</w> the situation in court.",
                                "ru": "Это неожиданное новое свидетельство может <w>запутать</w> ситуацию в суде.",
                                "de": "Diese neue, unerwartete Zeugenaussage könnte die Lage vor Gericht <w>komplizieren</w>.",
                                "es": "Este testimonio nuevo e imprevisto corre el riesgo de <w>embrollar</w> la situación en el tribunal.",
                                "zh": "这份意外出现的新证词，可能会使法庭上的局面<w>复杂化</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brouiller les cartes",
                        "brouiller les pistes"
                    ],
                    "antonyms": [
                        "débrouiller"
                    ],
                    "common_phrases": [
                        "embrouiller la situation",
                        "embrouiller les fils"
