                        "sense_id": "ddc77783-5168-3719-8a48-35cfc5f4151d",
                        "entry_id": "52140727-5fe4-3260-87ca-992fb0bd9a4b",
                        "glosses": [
                            "typ nadwozia samochodu osobowego do przewozu większej ilości osób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7fddd8-9e19-4c41-a7e0-5ef2176ea43e",
                                "sense_id": "ddc77783-5168-3719-8a48-35cfc5f4151d",
