        "nl-extract.jsonl": [
            {
                "entry_id": "9f56d67e-c66c-301a-be4a-c6cbccc62a0d",
                "word": "lastgever",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "0589b617-016c-4d40-a6ad-038838529dce",
                        "entry_id": "9f56d67e-c66c-301a-be4a-c6cbccc62a0d",
                        "tags": [
                            "plural"
                        ],
                        "form": "lastgevers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5731213b-aac5-341e-a5f8-e7690a4f5a8a",
                        "entry_id": "9f56d67e-c66c-301a-be4a-c6cbccc62a0d",
                        "glosses": [
                            "iemand die iemand anders een (politieke) opdracht geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30d1d652-af2c-4579-8277-70103c5d2dc2",
                                "sense_id": "5731213b-aac5-341e-a5f8-e7690a4f5a8a",
                                "text": "Maar wie was nou de ‘forensische’ instantie die zo nodig met een duimstok in dat graf wilde snuffelen? Zat er een serieuze lastgever achter? Waarom noemde de directeur zich dan Willem van Spanje? En waarom werd het nieuws van de afwijzing op 14 juni zelfs in een kwaliteitskrant als NRC Handelsblad gepubliceerd?"
                            },
                            {
                                "example_id": "6a831b24-fc6f-4a49-8352-2d18f28d8488",
                                "sense_id": "5731213b-aac5-341e-a5f8-e7690a4f5a8a",
                                "text": "Voor Hernandez en Kortenoeven was de grondwettelijke bepaling dat Kamerleden worden geacht ‘zonder last’ te stemmen al die tijd een betekenisloos voorschrift. Wilders was hun lastgever en zij hadden maar te gehoorzamen, evenals hun fractiegenoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "815466bc-421b-38dd-a4eb-9ffc73f0a407",
                        "entry_id": "9f56d67e-c66c-301a-be4a-c6cbccc62a0d",
                        "glosses": [
                            "iemand die iemand anders een lastgeving geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e4c83f-ada8-4334-9d80-65edcd8d84ec",
                                "sense_id": "815466bc-421b-38dd-a4eb-9ffc73f0a407",
                                "text": "Dat zo’n lastgeving of volmacht als een buitengerechtelijke bescherming wordt aangezien, is vreemd. Het beschermt niets of niemand. De lastgever kan nog altijd zelf handelen. Iemand die dement wordt en gekke dingen doet met zijn geld, heeft niets aan die volmacht. Daarvoor is een bewind noodzakelijk. Want alleen dat kan beletten dat die persoon zelf handelt. Pas dan wordt hij echt beschermd."
                            },
                            {
                                "example_id": "cceb4763-0294-493e-8ba4-7b93c91e0953",
                                "sense_id": "815466bc-421b-38dd-a4eb-9ffc73f0a407",
                                "text": "Door de registratie kan de volmacht doorlopen als er een bewindvoerder wordt aangesteld of als de lastgever de uitvoering ervan niet meer kan controleren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0a559bb-4253-4216-8e06-18b4e6820a30",
                        "source_entry_id": "9f56d67e-c66c-301a-be4a-c6cbccc62a0d",
                        "source_sense_id": "5731213b-aac5-341e-a5f8-e7690a4f5a8a",
                        "source_sense_description": "opdrachtgever",
                        "target_lang_word": "bidder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "Someone who bids (all senses), but most commonly, one offers to pay a specified price at an auction"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4396afa5-567e-48db-bf07-1885b0edeb5f",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "The highest bidder shall get the house."
                                            },
                                            {
                                                "example_id": "17e0f737-7436-461c-817f-ed51122de8a1",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "But that is changing; in the coming months, Mr. Gollinger said, his company will hold an auction in a suburban New York community where lenders will help preapprove bidders for mortgages."
                                            },
                                            {
                                                "example_id": "6f6de968-8d7f-45d4-b040-918515176819",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "In 2004, the authority declared Abec a nonresponsible bidder after the company failed to submit accurate information."
                                            },
                                            {
                                                "example_id": "fdee07e7-72a5-4fb0-9aba-a0879976de09",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "In other words, the transaction is preferred because it is the best of bad choices. And at least one study has found that when management preannounces a deal it results in lower premiums presumably because it scares off other bidders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9db15d-fa47-3b9e-b9db-a95909097368",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who commands or orders"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34b50926-e018-31fc-92ad-6f1eda7aaf58",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who asks or invites"
                                        ],
