                        "examples": [
                            {
                                "example_id": "cfa5113b-0f94-4808-9691-9bdd8d486e6e",
                                "sense_id": "4bd2a9eb-e2b9-3513-a0bc-64787e882ae9",
                                "text": "Depuis des années, le papivore est un téléspectateur assidu et passionné."
                            },
                            {
                                "example_id": "d5e317e3-3ee6-409c-b806-4536a3add135",
                                "sense_id": "4bd2a9eb-e2b9-3513-a0bc-64787e882ae9",
                                "text": "Apparemment vous n’êtes pas papivore, je ne suis pas carnivore, tout va bien, aucun risque de s’entre-dévorer."
                            },
                            {
                                "example_id": "4ef18922-6dfa-4fec-9e77-0217f5fb0a39",
                                "sense_id": "4bd2a9eb-e2b9-3513-a0bc-64787e882ae9",
                                "text": "J’étais curieux de connaître ce papivore rugueux et c’était, je crois, réciproque : il ne pouvait pas me prendre pour un concurrent, mais sans doute pour un provocateur sortant de l’ordinaire."
                            },
                            {
                                "example_id": "36dc959e-e559-4d9f-8353-fc26bcf0e66d",
                                "sense_id": "4bd2a9eb-e2b9-3513-a0bc-64787e882ae9",
                                "text": "Bibliographie qui donne aux petits l’envie de devenir papivores !"
                            }
                        ]
                    }
                ],
