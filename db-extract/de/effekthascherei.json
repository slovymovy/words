                    {
                        "translation_id": "90b94d9e-d65d-404c-ab42-b206c46989ec",
                        "source_entry_id": "3feabff0-4f7a-3925-800e-69af1f484365",
                        "source_sense_id": "12486d2c-7b44-39da-9852-44ce99ea3830",
                        "source_sense_description": "übertriebene Bemühung, Aufmerksamkeit zu erregen",
                        "target_lang_word": "grandstand play",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandstand play",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b0298a7-db66-324a-b662-cea6a869f4fd",
                                        "entry_id": "bc5d3920-442e-3323-be22-06a328eb25a0",
                                        "glosses": [
                                            "A successful play or other manoeuvre during a sporting competition in which one or more players shows off unnecessarily in order to entertain or impress the spectators."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec69d521-9240-4e9d-9caa-208dd929c149",
                                                "sense_id": "2b0298a7-db66-324a-b662-cea6a869f4fd",
                                                "text": "Instead of throwing it to center, however, she tried to make a grandstand play and threw it the entire length of the gymnasium to the waiting forward."
                                            },
                                            {
                                                "example_id": "fcc152db-88f0-4504-9a88-69d50c443a0c",
                                                "sense_id": "2b0298a7-db66-324a-b662-cea6a869f4fd",
                                                "text": "Every baseball fan is acquainted with the sarcastic reminder, \"two hands are the fashion nowadays,\" often hurled at the infielder who foozles an attempt at a grandstand play in the form of a one-handed catch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f38f790-15b4-363e-a896-e849a45eca07",
                                        "entry_id": "bc5d3920-442e-3323-be22-06a328eb25a0",
                                        "glosses": [
                                            "An action or stratagem that is excessively dramatic or sensational and that is intended to appeal to members of the public or to a particular audience."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cddc3a6-86a1-40e8-9360-dbf4bda560c1",
                                                "sense_id": "4f38f790-15b4-363e-a896-e849a45eca07",
                                                "text": "\"He goes strike-breakin'. Grandstand play, that's what I call it. Gets his name in the papers an makes all the skirts he runs with fluster up an' say: ‘My! Some bear, that Roy Blanchard, some bear.’\""
                                            },
                                            {
                                                "example_id": "a14e44ec-f8e4-4376-b752-a3dfbbc8737d",
                                                "sense_id": "4f38f790-15b4-363e-a896-e849a45eca07",
                                                "text": "Dag Hammarskjold and Russia's fellow Security Council members, bent on quieting the Congo turmoil, had watched the Soviets stir the fires of chaos, make a grandstand play to Africans by labeling the U.N. a partner to a colonial conspiracy."
                                            },
                                            {
                                                "example_id": "68dc9126-1a9f-40b6-bc4a-3150b9e59bee",
                                                "sense_id": "4f38f790-15b4-363e-a896-e849a45eca07",
                                                "text": "“Congratulations to Governor Cuomo for another grandstand play for the attention of his millionaire friends at the expense of the real working people of New York,” Danny Donohue, president of the largest union of state workers, the Civil Service Employees Association, said in a statement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab2a2eab-503e-4dde-8c83-7cc9890fadf6",
                        "source_entry_id": "3feabff0-4f7a-3925-800e-69af1f484365",
                        "source_sense_id": "83ea5294-50a6-3830-8411-42d237f01c94",
                        "source_sense_description": "Mittel, eingesetzt zur Erregung von Aufmerksamkeit",
                        "target_lang_word": "gimmick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gimmick",
