                "senses": [
                    {
                        "sense_id": "adc09799-8c38-321c-9f96-a6a1a2762dc3",
                        "entry_id": "bde00e26-e2d9-367b-a78e-7543c74b4659",
                        "glosses": [
                            "die Bewegung von Schienenfahrzeugen im Schienennetz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8f9502-7de6-4c84-8195-567b7885b353",
                                "sense_id": "adc09799-8c38-321c-9f96-a6a1a2762dc3",
                                "text": "„Nach achtjähriger Bauzeit wird in der Schweiz der Lötschberg-Tunnel zwischen Berner Oberland und Wallis offiziell eingeweiht. Vom 9. Dezember an soll die fast 35 km lange Röhre für den Bahnverkehr freigegeben werden.“"
                            },
                            {
                                "example_id": "5926c63f-837d-4474-93b0-d7c3ae2390aa",
                                "sense_id": "adc09799-8c38-321c-9f96-a6a1a2762dc3",
                                "text": "„Die Diffenébrücke ist eine Klappbrücke mit Straßen- und Bahnverkehr, die den Industriehafen und die Friesenheimer Insel erschließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
