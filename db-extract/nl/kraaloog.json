                "senses": [
                    {
                        "sense_id": "73390c55-b894-3e07-ba6b-26b7a4d51b68",
                        "entry_id": "846477c2-3bec-3ae6-bda4-bea16d0521ea",
                        "glosses": [
                            "een klein schitterend oog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0638e7-3b50-4499-a424-26e391217f35",
                                "sense_id": "73390c55-b894-3e07-ba6b-26b7a4d51b68",
                                "text": "Vooral dat laatste is eigenlijk moeilijk te verteren als je het wipneusje en de kraaloogjes van de egels ziet. „Zo’n kuiken lusten ze wel. Daar vind je dan de volgende dag niets meer van terug.”"
                            },
                            {
                                "example_id": "cbad298e-8e4c-47bd-919b-da209706df5f",
                                "sense_id": "73390c55-b894-3e07-ba6b-26b7a4d51b68",
                                "text": "“Briljante smoes. Gaat u zitten. U krijgt al vast 1 punt extra op uw eerstvolgende proefwerk”, knarste de professor me toe, met zijn quasi-vriendelijke smile rond de mond. De bijbehorende warme blik had zich verstopt achterin de priemende kraaloogjes van zijn kale eierhoofd-met-één-rechtopstaande-krul op het bovenste punt, als van een biggenstaart."
                            }
                        ]
                    }
                ],
