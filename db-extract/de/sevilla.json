                                        "entry_id": "910419d2-b790-37f6-976d-6203940d91b1",
                                        "glosses": [
                                            "Commune et ville d’Espagne, chef-lieu de la province du même nom et capitale de l’Andalousie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a596360-3cf6-417e-8b28-ff0a0c321825",
                                                "sense_id": "580151c3-9757-305b-806b-c9e0e2709b0e",
                                                "text": "Dès aujourd’hui, Bordeaux et Mont-de-Marsan cesseront de singer Séville et Cadix."
                                            },
