                                            {
                                                "example_id": "94a192b1-ef71-4619-acf4-d4500d8280fb",
                                                "sense_id": "ddf07184-6fb7-3652-a8b6-cd948109bc4a",
                                                "text": "Le but de cette disposition est d'abaisser le plus possible l'arbre coudé, qui est celui de la vis ou organe propulseur."
