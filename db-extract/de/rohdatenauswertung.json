                "senses": [
                    {
                        "sense_id": "9866eb83-7e1c-3d84-9f05-63b5b2fde200",
                        "entry_id": "91bffdd9-bb0c-3502-b550-04891775db78",
                        "glosses": [
                            "Auswerten von noch nicht weiterverarbeiteten Informationen, Daten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b07ffb4-781d-49ca-945e-6db64d22c99d",
                                "sense_id": "9866eb83-7e1c-3d84-9f05-63b5b2fde200",
                                "text": "„Cloud-Lösungen, die auf großer Rechnerkapazität aufbauen, können solche Rohdatenauswertungen auch in Sekundenfrist bereitstellen.“"
                            },
                            {
                                "example_id": "bea495e0-4035-4d6e-9af6-7b9f31a26078",
                                "sense_id": "9866eb83-7e1c-3d84-9f05-63b5b2fde200",
                                "text": "„Neue Technologien ermöglichen einen Wandel von festen Reportingstrukturen auf definierten Data Marts zu flexiblen Rohdatenauswertungen in Echtzeit.“"
                            },
                            {
                                "example_id": "7c4bbe30-ed7f-43b5-906e-5e851330f9c8",
                                "sense_id": "9866eb83-7e1c-3d84-9f05-63b5b2fde200",
                                "text": "„Wenn man auf eine sorgfältige Dokumentation der Rohdatenauswertung achtet, erleichtert diese Vorarbeit die Untersuchung der wichtigen Fragen enorm.“"
                            },
                            {
                                "example_id": "6c8a7253-47b0-411d-ab4b-4727b5fd412d",
                                "sense_id": "9866eb83-7e1c-3d84-9f05-63b5b2fde200",
                                "text": "„In diesen Fällen liefern die gängigsten drei Softwarepakete zur Rohdatenauswertung bis zu 70 Prozent falsch-positive Signale - sie zeigen Aktivität im Gehirn an, wo in Wirklichkeit keine ist.“"
                            },
                            {
                                "example_id": "31f4ed16-91e7-4f6a-82c5-56eb77d4c918",
                                "sense_id": "9866eb83-7e1c-3d84-9f05-63b5b2fde200",
                                "text": "„Den Psychologie-Studenten, die mir sowohl bei der Datenerhebung als auch bei der Rohdatenauswertung halfen, bin ich ebenso zu Dank verpflichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
