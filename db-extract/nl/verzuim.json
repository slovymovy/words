                "translations": [
                    {
                        "translation_id": "b78bd7aa-9f62-4894-97a5-43b6e2657a6c",
                        "source_entry_id": "302a9886-efc7-38fc-8796-cbf023a16459",
                        "target_lang_word": "absence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78b93bd8-9566-3848-9f4e-ed6f44966c22",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "A state of being away or withdrawn from a place or from companionship"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2467b2-542c-4c1b-bbca-ffb3fec71da4",
                                                "sense_id": "78b93bd8-9566-3848-9f4e-ed6f44966c22",
                                                "text": "Absence makes the heart grow fonder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "The period of someone being away."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0709a9bd-4c46-4be1-9310-dbae3400515b",
                                                "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                                                "text": "During Jane's absence, Mark will be taking charge."
                                            },
                                            {
                                                "example_id": "72b19c7b-3712-4ec2-9d6c-122bab2dc5b2",
                                                "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                                                "text": "Not as in my presence only, but now much more in my absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a78f6bf-b278-3407-9d7f-4f3a2fb3bb32",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Failure to be present where one is expected, wanted, or needed; nonattendance; deficiency."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c51d066-6d46-4c52-8f9b-8c2a6d716846",
                                                "sense_id": "2a78f6bf-b278-3407-9d7f-4f3a2fb3bb32",
                                                "text": "Harry Kane was an absence in that first half. He touched the ball 11 times despite Spurs taking 62% of possession."
                                            },
                                            {
                                                "example_id": "e6aa2d57-9345-4d54-a48d-9fab24a1c7d4",
                                                "sense_id": "2a78f6bf-b278-3407-9d7f-4f3a2fb3bb32",
                                                "text": "Then, in January, a creeping tsunami of train cancellations, triggered by major staff absences as a result of the aggressive transmissibility of Omicron, heaped further misery on rail users."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Lack; deficiency; non-existence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1bcd978-420b-414c-a9c5-1328cb41e1d8",
                                                "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                                "text": "He had an absence of enthusiasm."
                                            },
                                            {
                                                "example_id": "a70e4eec-ad8e-4940-82f7-9c4ed6b58161",
                                                "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                                "text": "in the absence of higher and more authoritative sanctions the ordinances of foreign states, the opinions of eminent statesmen, and the writings of distinguished jurists, are regarded as of great consideration on questions not settled by conventional law"
                                            },
                                            {
                                                "example_id": "5972a64b-8ae4-4ccd-a4fd-ea57473a09e3",
                                                "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                                                "text": "The narrow streets that twist and turn through the compact heart of Dent are surfaced with cobbles which, in the absence of pavements, spread right across from doorstep to doorstep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Inattention to things present; abstraction (of mind)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f39e0f-aa27-4bf3-9776-1ec8259f39e1",
                                                "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                                "text": "absence of mind"
                                            },
                                            {
                                                "example_id": "1129cd9c-46a4-4067-96cc-c1a59f0a1552",
                                                "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                                "text": "Reflecting on the little absences and distractions of mankind."
                                            },
                                            {
                                                "example_id": "110b615b-d775-497f-907c-0888c04e175d",
                                                "sense_id": "02236293-ac4e-3362-8939-7ca3e4f7e31c",
                                                "text": "To conquer that abstraction which is called absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590b3b3b-f2d6-3583-b69f-da40495fb8b2",
                                        "entry_id": "f52f0155-acfa-318c-b968-6400bf3fad90",
                                        "glosses": [
                                            "Temporary loss or disruption of consciousness, with sudden onset and recovery, and common in epilepsy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
