                        "form": "лунохо́де"
                    },
                    {
                        "form_id": "306ccbee-732f-4ac5-8484-110c685dcc66",
                        "entry_id": "17a45cea-e930-3145-8a65-3d4d921a1864",
                        "tags": [
                            "plural",
