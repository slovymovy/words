                "senses": [
                    {
                        "sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                        "entry_id": "622b82a8-77ea-3757-bc12-7ffed05594fa",
                        "glosses": [
                            "Mitglied eines Senats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d087a89-bd1a-4a4e-916d-830ebdd3b75a",
                                "sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                                "text": "Der Senator für Stadtentwicklung traf sich gestern mit dem Bürgermeister."
                            },
                            {
                                "example_id": "44dc5fec-313e-4a38-8746-e7a33efc764b",
                                "sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                                "text": "„Er kochte vor Wut angesichts dieses Senators, der die stumpfsinnige Korrektheit und Beschränktheit seiner Denkweise ganz einfach auf diese ganz neu aufgetauchten Aufgaben des Adels übertragen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d3154ee-d338-4b63-992e-7c745962238a",
                        "source_entry_id": "622b82a8-77ea-3757-bc12-7ffed05594fa",
                        "source_sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                        "source_sense_description": "Mitglied eines Senats",
                        "target_lang_word": "senator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd3295d-7dc1-3840-9162-212a6262f399",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member, normally elected, in the house or chamber of a legislature called a senate, as, for instance, the legislatures of the United States and Canada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec596097-98ac-4fec-8b34-50f5bc955225",
                                                "sense_id": "0dd3295d-7dc1-3840-9162-212a6262f399",
                                                "text": "It was disbanded when Derrick was only six, after that grouchy old ultra-Libertarian Senator Timothy de Illy made “welfare hotel for Third-World nations” a household catchphrase."
                                            },
                                            {
                                                "example_id": "629b88c2-1fcd-494c-99fc-08afeed7f656",
                                                "sense_id": "0dd3295d-7dc1-3840-9162-212a6262f399",
                                                "text": "I was a United States senator-elect at age thirty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b848a165-35f7-3f25-a859-c064fbd3596a",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of any legislative body or parliament, particularly the British Parliament."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b72e594b-8cf9-3e24-ba04-ee9ce276e3a5",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of the ancient Roman Senate."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34aaca4e-2d7b-3dd0-83da-7a9d08cc98d2",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of a governing council in other states in the ancient world."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ed33a7-a235-3ee1-b8b6-ff15196666e5",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "A member of the ruler’s council or governing council in general, a leading statesman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de7b1e3-e351-481f-9136-ec81a695ca13",
                                                "sense_id": "10ed33a7-a235-3ee1-b8b6-ff15196666e5",
                                                "text": "Both we will raigne as Conſuls of the earth,\nAnd mightie kings ſhall be our Senators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9120f3-ee16-3816-9c3c-800c95d2f06f",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "An important church official."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a818395-b7df-354b-9f2a-7012a89df0b8",
                                        "entry_id": "992c9b83-7d0e-3035-ae84-cbd83df6efd5",
                                        "glosses": [
                                            "In Germany, a minister of the executive branch of government in the city states of Berlin, Bremen, and Hamburg; and a government official of cities that were part of the Hanseatic League."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "482cbe59-061d-4a98-b91f-5b0c2950cd3f",
                        "source_entry_id": "622b82a8-77ea-3757-bc12-7ffed05594fa",
                        "source_sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                        "source_sense_description": "Mitglied eines Senats",
                        "target_lang_word": "sénateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sénateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                        "entry_id": "2331db95-524c-3efc-b2a1-2812f0809633",
                                        "glosses": [
                                            "Homme membre d’un sénat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f696491-7f69-4bdc-88fa-5dbfc55937d0",
                                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                                "text": "La démocrate américaine Catherine Cortez Masto a remporté, samedi, l’État du Nevada, octroyant à son parti 50 sénateurs sur 100."
                                            },
                                            {
                                                "example_id": "97d9cb80-0bc7-485b-8df9-374f8b21d362",
                                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                                "text": "Si parfois j’ai pu désirer d’être sénateur, c’est que j’imagine que, sans tarder peut-être, ce mandat fournira de belles occasions de se faire assommer, fusiller, des formes de trépas, enfin, bien préférables à une longue maladie qui vous tue lentement et par démolitions successives."
                                            },
                                            {
                                                "example_id": "1d25c2c2-da92-48be-b92b-734d99e3d04b",
                                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                                "text": "Les députés ne sont que ce qu’on les a fait, et les sénateurs aussi, comme de juste."
                                            },
                                            {
                                                "example_id": "7bab7a3e-0abb-450d-9c83-b4c5401ac7be",
                                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                                "text": "Rome a eu l’équivalent des purges et procès à grand spectacle, et de la maladie du soupçon ; tout sénateur était soupçonnable, et il en fut ainsi jusqu’à la fin de l’Empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
