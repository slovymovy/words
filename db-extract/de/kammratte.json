                "senses": [
                    {
                        "sense_id": "fca8934c-e307-3d2a-8e99-539b9aa09805",
                        "entry_id": "93d8eb88-939d-3c2d-ba6c-4194954b7e88",
                        "glosses": [
                            "ein zu der Gattung Ctenomys zählendes Nagetier in Südamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1629089d-730e-4a92-92f8-5a8a5ac85ee9",
                                "sense_id": "fca8934c-e307-3d2a-8e99-539b9aa09805",
                                "text": "Der Bau der Kammratte besteht aus einem langen Haupttunnel, von dem Nebengänge abzweigen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c97d675-cfe5-4886-a9d0-bd60e5de3891",
                        "source_entry_id": "93d8eb88-939d-3c2d-ba6c-4194954b7e88",
                        "source_sense_id": "fca8934c-e307-3d2a-8e99-539b9aa09805",
                        "source_sense_description": "ein zu der Gattung Ctenomys zählendes Nagetier in Südamerika",
                        "target_lang_word": "tuco-tuco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuco-tuco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17378f2e-bf17-38bc-af2c-cb4343b19d50",
                                        "entry_id": "3821a8e0-35db-350d-8331-22bcfce77732",
                                        "glosses": [
                                            "Any of the caviomorph South American rodents of the genus Ctenomys, which have a large head, small ears, and hairy tail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58dd9ea3-133a-4ee3-a90f-cc9e2f0ef7a6",
                                                "sense_id": "17378f2e-bf17-38bc-af2c-cb4343b19d50",
                                                "text": "Tuco-tucos groom themselves to remove loose sand from their fur by combing with the stiff bristles that grow near the bases of the hind claws."
                                            },
                                            {
                                                "example_id": "e9940c48-10fd-47f6-831e-10a7c4cabe1c",
                                                "sense_id": "17378f2e-bf17-38bc-af2c-cb4343b19d50",
                                                "text": "The eyes of tuco-tucos are almost level with the top of the head, which is adaptive for surveying the horizon from their shelter without exposing themselves to predators."
                                            },
                                            {
                                                "example_id": "c8dcd1c1-7cda-4d47-88bb-1dc049551593",
                                                "sense_id": "17378f2e-bf17-38bc-af2c-cb4343b19d50",
                                                "text": "The tuco-tuco is a vegetarian rodent very similar in appearance and behaviour to the ground squirrel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "befb5f00-d940-4cce-ab98-f1d4bf20baba",
                        "source_entry_id": "93d8eb88-939d-3c2d-ba6c-4194954b7e88",
                        "source_sense_id": "fca8934c-e307-3d2a-8e99-539b9aa09805",
                        "source_sense_description": "ein zu der Gattung Ctenomys zählendes Nagetier in Südamerika",
                        "target_lang_word": "ctenomyid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ctenomyid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb01538f-e12e-374f-9a1a-ce7c0a9c469f",
                                        "entry_id": "1d459e4f-fc6f-37bb-bb5a-48be023c3b53",
                                        "glosses": [
                                            "Any rodent of the family Ctenomyidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71c9044-13c1-4f40-95ea-08c5b81ef610",
                                                "sense_id": "bb01538f-e12e-374f-9a1a-ce7c0a9c469f",
                                                "text": "New adaptive radiations of small fossorial rodents followed, including crice- tids in the Pliocene and spalacids and ctenomyids primarily in the Pleistocene."
                                            },
                                            {
                                                "example_id": "a6e4c4f3-302c-4ae2-98c8-aedf9a141036",
                                                "sense_id": "bb01538f-e12e-374f-9a1a-ce7c0a9c469f",
                                                "text": "Foraging by geomyids and ctenomyids is more generalized in that all portions of plants may be consumed."
                                            },
                                            {
                                                "example_id": "bf1bd962-fa90-4dea-9851-c6b932f1d301",
                                                "sense_id": "bb01538f-e12e-374f-9a1a-ce7c0a9c469f",
                                                "text": "Ctenomyids first appear in the late Miocene of South America."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
