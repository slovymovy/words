                "senses": [
                    {
                        "sense_id": "b147ddb1-ecaa-3af8-85a1-a68fb0f465b1",
                        "entry_id": "fe1de8dc-20b3-36dc-9069-b3fcde7aaa70",
                        "glosses": [
                            "deutschstämmiger Staatsbürger von Namibia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fd5dccf-a709-40b9-876f-0af1d7ea2cc2",
                                "sense_id": "b147ddb1-ecaa-3af8-85a1-a68fb0f465b1",
                                "text": "„Die aktuelle Staffel der Musik-Castingshow „X Factor“ auf Sky gewann der Deutschnamibier Ees alias Eric Sell.“"
                            },
                            {
                                "example_id": "b9bffa80-fe64-48ec-b8de-17d4055dcd6f",
                                "sense_id": "b147ddb1-ecaa-3af8-85a1-a68fb0f465b1",
                                "text": "„Dort lägen die Nachkommen der Deutschen, die sogenannten Deutschnamibier, oder immer noch Soldaten, die im Krieg gegen die Herero gefallen sind und mit imposanten Grabsteinen für ihre heldenhaften Taten geehrt würden.“>"
                            },
                            {
                                "example_id": "5f8aa90c-456e-472e-b222-11c84140631c",
                                "sense_id": "b147ddb1-ecaa-3af8-85a1-a68fb0f465b1",
                                "text": "„In seiner südwestafrikanischen Heimat ist der Deutschnamibier Eric \"EES\" Sell ein Superstar.“"
                            },
                            {
                                "example_id": "d1dd8e98-41d8-4e76-bd14-d26b90ec9c32",
                                "sense_id": "b147ddb1-ecaa-3af8-85a1-a68fb0f465b1",
                                "text": "„Er weist - durchaus berechtigt - einige Gefahren auf, die einem „Sprachrohr“ für Deutschnamibier drohen könnten, aber er unterschätzt dabei die Chancen, die sich uns böten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
