                        "entry_id": "22d49324-a00d-3279-b072-16846199e141",
                        "glosses": [
                            "Without end or limit; boundless, infinite, interminable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c363725-f8f7-453b-a431-4e7ac5059fff",
                                "sense_id": "b596ebfd-7377-3922-ad06-dcc9a1068b4e",
                                "text": "Within a thicket I reposed; when round / I ruffled up fall'n leaves in heap; and found, / Let fall from heaven, a sleep interminate."
                            }
                        ]
                    }
