                "senses": [
                    {
                        "sense_id": "15150eb3-f657-3864-b652-520178b24534",
                        "entry_id": "e67779bb-ee99-31d5-870b-5405ee7e67fd",
                        "glosses": [
                            "afloop (van een wedstrijd), resultaat (van een onderzoek, een examen of een raadpleging)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa75c5b6-28e7-47fa-aa64-9981729ae4a1",
                                "sense_id": "15150eb3-f657-3864-b652-520178b24534",
                                "text": "De uitslag van de wedstrijd was zeer teleurstellend voor de thuisploeg."
                            },
                            {
                                "example_id": "8adcc293-0c0a-442f-8970-0d961480c4b4",
                                "sense_id": "15150eb3-f657-3864-b652-520178b24534",
                                "text": ",,In een derby zo ruim verliezen is niet prettig, ook niet als het nergens meer om gaat. Toch zijn we niet van de mat gespeeld, ondanks de uitslag”, aldus de verliezende trainer Hilbert van Gils."
                            }
                        ]
                    },
                    {
                        "sense_id": "240f3735-c6e3-3de7-a2b3-9c8c5da7788a",
                        "entry_id": "e67779bb-ee99-31d5-870b-5405ee7e67fd",
                        "glosses": [
                            "aanslag (ten gevolge van vocht op of in een muur) die van binnenuit komt."
