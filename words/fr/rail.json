    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2420b08-d8b2-3326-8689-ee4a258bcb09",
                    "sense_definition": "Chacune des barres d'acier profilées formant la voie ferrée sur laquelle circulent les trains, métros ou tramways.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chemin_de_fer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers travaillent la nuit pour remplacer un <w>rail</w> abîmé sur la ligne principale."
                        },
                        {
                            "text": "Le tramway glisse en silence sur ses <w>rails</w> au milieu des rues de la ville."
                        }
                    ],
                    "common_phrases": [
                        "rail de chemin de fer",
                        "sur les rails"
                    ]
                },
                {
                    "sense_id": "9ce6ae53-d91e-33c3-ae9f-09d170f2e2cd",
                    "sense_definition": "Secteur ou mode de transport de personnes et de marchandises par voie ferrée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chemin_de_fer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement encourage le transport de marchandises par le <w>rail</w> plutôt que par la route."
                        },
                        {
                            "text": "Les syndicats du <w>rail</w> ont annoncé une journée d'action pour défendre leurs conditions de travail."
                        }
                    ],
                    "common_phrases": [
                        "transport par le rail",
                        "professionnels du rail"
                    ]
                },
                {
                    "sense_id": "2987d813-11c0-3b01-83c0-1280ef7b4ee8",
                    "sense_definition": "Tringle ou profilé métallique servant de guide au déplacement d'un élément mobile comme une porte ou un rideau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La porte coulissante du salon ne se ferme plus car elle est sortie de son <w>rail</w>."
                        },
                        {
                            "text": "Il faut visser solidement ce <w>rail</w> au plafond avant d'y suspendre les rideaux."
                        }
                    ],
                    "synonyms": [
                        "glissière",
                        "coulisse"
                    ],
                    "common_phrases": [
                        "rail de guidage",
                        "rail de rideau"
                    ]
                },
                {
                    "sense_id": "5304e4e8-5739-349c-9d55-1de6e968ff73",
                    "sense_definition": "Ligne de drogue en poudre, en particulier de cocaïne, étalée sur une surface pour être inhalée par le nez.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le policier a surpris le suspect en train de préparer un <w>rail</w> sur une petite table."
                        },
                        {
                            "text": "Il a ruiné sa carrière après avoir consommé un <w>rail</w> de cocaïne lors de cette soirée festive."
                        }
                    ],
                    "synonyms": [
                        "ligne",
                        "trace"
                    ],
                    "common_phrases": [
                        "rail de coke",
                        "sniffer un rail"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "milieu des stupéfiants"
                        }
                    ]
                },
                {
                    "sense_id": "bc158e11-390e-3f9d-8c5b-b1b6834db626",
                    "sense_definition": "Couloir maritime obligatoire délimité dans une zone à fort trafic afin d'éviter les abordages entre bateaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pétroliers doivent obligatoirement naviguer dans ce <w>rail</w> surveillé au large des côtes."
                        },
                        {
                            "text": "Le centre régional de surveillance veille à ce qu'aucun cargo ne dévie de son <w>rail</w> assigné."
                        }
                    ],
                    "synonyms": [
                        "couloir de navigation"
                    ],
                    "common_phrases": [
                        "rail de navigation",
                        "rail d'Ouessant"
                    ]
                },
                {
                    "sense_id": "98ee73c3-8ef2-3a17-aadd-a79c7169f6d8",
                    "sense_definition": "La Manche, désignée ainsi dans le langage des marins en référence à ses couloirs de circulation maritime très fréquentés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les navigateurs chevronnés savent que traverser le <w>rail</w> dans le brouillard demande une concentration constante."
                        },
                        {
                            "text": "Ce vieux marin redoutait toujours les tempêtes d'automne qui frappaient violemment le <w>rail</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "jargon maritime"
                        }
                    ]
                }
            ]
        }
    ]
}