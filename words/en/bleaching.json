        "bleacher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "521c2c57-f3c9-3c0b-a283-424e392cb381",
                    "sense_definition": "The process of removing stains or whitening fabrics using chemical agents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "whitening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bleaching</w> of the white shirts made them look brand new again.",
                            "target_lang_translations": {
                                "cs": "<w>Bělení</w> bílých košil způsobilo, že vypadaly zase jako nové."
                            }
                        },
                        {
                            "text": "Industrial <w>bleaching</w> is a common step in textile manufacturing.",
                            "target_lang_translations": {
                                "cs": "Průmyslové <w>bělení</w> je běžným krokem při výrobě textilu."
                            }
                        }
                    ],
                    "synonyms": [
                        "whitening"
                    ],
                    "common_phrases": [
                        "chemical bleaching"
                    ],
                    "target_lang_definitions": {
                        "cs": "Proces odstraňování skvrn nebo bělení tkanin pomocí chemických látek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bělení",
                                "target_lang_sense_clarification": "obecný proces bělení látek nebo materiálů"
                            },
                            {
                                "target_lang_word": "vybělování",
                                "target_lang_sense_clarification": "opakovaný nebo probíhající proces bělení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2be3898-04fe-3a1e-bba1-fde18f6ec231",
                    "sense_definition": "The loss or removal of semantic or grammatical content from a word or morpheme.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Semantic <w>bleaching</w> occurs when a word loses its specific meaning over time.",
                            "target_lang_translations": {
                                "cs": "Sémantické <w>vyprázdnění</w> nastává, když slovo v průběhu času ztrácí svůj specifický význam."
                            }
                        },
                        {
                            "text": "The <w>bleaching</w> of the verb's original sense allowed it to function as a grammatical marker.",
                            "target_lang_translations": {
                                "cs": "<w>Oslabení</w> původního významu slovesa mu umožnilo fungovat jako gramatický ukazatel."
                            }
                        }
                    ],
                    "synonyms": [
                        "semantic loss"
                    ],
                    "common_phrases": [
                        "semantic bleaching"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ztráta nebo odstranění sémantického či gramatického obsahu slova nebo morfému."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sémantické vyprázdnění",
                                "target_lang_sense_clarification": "lingvistický termín pro ztrátu významu slova"
                            },
                            {
                                "target_lang_word": "oslabení významu",
                                "target_lang_sense_clarification": "proces, při kterém slovo ztrácí svou původní specifičnost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d1e152e-35fc-343d-a614-582dc03e426c",
                    "sense_definition": "Present participle and gerund of <w>bleach</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "whitening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>bleaching</w> her hair to get a lighter color.",
                            "target_lang_translations": {
                                "cs": "Právě si <w>odbarvuje</w> vlasy, aby získala světlejší odstín."
                            }
                        },
                        {
                            "text": "The sun is <w>bleaching</w> the color out of the old curtains.",
                            "target_lang_translations": {
                                "cs": "Slunce <w>vytahuje</w> barvu ze starých závěsů."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomný příčestí a gerundium slovesa bělit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bělení",
                                "target_lang_sense_clarification": "činnost bělení vlasů nebo jiných předmětů"
                            },
                            {
                                "target_lang_word": "odbarvování",
                                "target_lang_sense_clarification": "proces odstraňování barvy z vlasů nebo látek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}