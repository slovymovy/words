{
    "word_family": [
        "neutre",
        "neutralité",
        "neutralisation",
        "neutralisant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59a63ec7-66a6-3d7a-b1fc-0b4746439045",
                    "sense_definition": "Diminuer sensiblement ou annuler l'effet, l'action ou l'influence de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rendre_inoperant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau traitement permet de <w>neutraliser</w> les effets indésirables du médicament principal."
                        },
                        {
                            "text": "Ses arguments solides ont suffi pour <w>neutraliser</w> les critiques formulées par l'opposition."
                        }
                    ],
                    "synonyms": [
                        "annuler",
                        "contrebalancer",
                        "paralyser"
                    ],
                    "antonyms": [
                        "renforcer",
                        "stimuler"
                    ],
                    "common_phrases": [
                        "neutraliser la menace",
                        "neutraliser les effets"
                    ]
                },
                {
                    "sense_id": "5116459c-a405-3f58-9b1e-3622f0b83fc3",
                    "sense_definition": "Mettre hors d'état de nuire un individu dangereux, par la force ou l'arrestation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hors_de_combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces spéciales sont intervenues rapidement pour <w>neutraliser</w> le suspect armé sans faire de victimes."
                        },
                        {
                            "text": "L'agresseur a été <w>neutralisé</w> par les policiers avant qu'il ne puisse s'en prendre aux passants."
                        }
                    ],
                    "synonyms": [
                        "désarmer",
                        "maîtriser"
                    ],
                    "common_phrases": [
                        "neutraliser un suspect",
                        "neutraliser un individu"
                    ]
                },
                {
                    "sense_id": "34b1e2dc-9db0-3fe8-8806-579d268a666d",
                    "sense_definition": "Fermer temporairement une voie ou un espace à la circulation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fermer_voie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agents ont dû <w>neutraliser</w> une voie de l'autoroute à cause d'un accident grave."
                        },
                        {
                            "text": "Pour réaliser les travaux nocturnes, l'entreprise va <w>neutraliser</w> le couloir de droite pendant quelques heures."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "fermer"
                    ],
                    "antonyms": [
                        "rouvrir"
                    ],
                    "common_phrases": [
                        "neutraliser la circulation",
                        "neutraliser une voie"
                    ]
                },
                {
                    "sense_id": "4ff2e00b-348c-3970-bc8a-3cd55825a280",
                    "sense_definition": "Désactiver un engin explosif ou modifier une arme pour la rendre définitivement inoffensive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rendre_inoperant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une équipe de démineurs a été appelée pour <w>neutraliser</w> une vieille bombe découverte sur le chantier."
                        },
                        {
                            "text": "Il est strictement obligatoire de faire <w>neutraliser</w> une arme à feu ancienne avant de pouvoir la vendre."
                        }
                    ],
                    "synonyms": [
                        "désactiver",
                        "désamorcer"
                    ],
                    "common_phrases": [
                        "neutraliser une bombe",
                        "neutraliser un engin"
                    ]
                },
                {
                    "sense_id": "3dc62825-908a-321a-9562-3837e3107889",
                    "sense_definition": "Rendre neutre une substance chimique acide ou basique par réaction avec son opposé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chimiste utilise du bicarbonate pour <w>neutraliser</w> l'acide renversé sur la paillasse."
                        },
                        {
                            "text": "Il faut ajouter une base faible pour <w>neutraliser</w> ce liquide avant de le jeter."
                        }
                    ],
                    "antonyms": [
                        "acidifier"
                    ],
                    "common_phrases": [
                        "neutraliser un acide",
                        "neutraliser une solution"
                    ]
                },
                {
                    "sense_id": "db9ea20a-bc45-384f-a174-09581db9ecdb",
                    "sense_definition": "Conférer ou garantir un statut de neutralité politique ou militaire à un territoire, un État ou un navire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le traité de paix avait pour objectif principal de <w>neutraliser</w> cette région frontalière disputée."
                        },
                        {
                            "text": "Les puissances belligérantes ont accepté de <w>neutraliser</w> le port maritime afin de protéger le commerce civil."
                        }
                    ],
                    "common_phrases": [
                        "neutraliser un territoire",
                        "neutraliser une zone"
                    ]
                }
            ]
        }
    ]
}