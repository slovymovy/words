                    "sense_definition": "Тотчас, немедленно, в тот же момент.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_immediate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>сразу</w> ответил на его письмо.",
                            "target_lang_translations": {
                                "en": "I answered his letter <w>immediately</w>.",
                                "zh": "我<w>马上</w>回复了他的信。",
                                "cs": "Na jeho dopis jsem <w>ihned</w> odpověděl.",
                                "nl": "Ik heb <w>meteen</w> op zijn brief geantwoord.",
                                "pl": "Odpowiedziałem na jego list <w>od razu</w>.",
                                "de": "Ich habe <w>sofort</w> auf seinen Brief geantwortet.",
                                "fr": "J'ai <w>immédiatement</w> répondu à son courrier.",
                                "it": "Ho risposto <w>subito</w> alla sua lettera.",
                                "tr": "Mektubuna <w>hemen</w> cevap verdim.",
                                "es": "Respondí <w>inmediatamente</w> a su carta."
                            }
                        },
                        {
                            "text": "Мы решили <w>сразу</w> пойти домой.",
                            "target_lang_translations": {
                                "en": "We decided to go home <w>right away</w>.",
                                "zh": "我们决定<w>立刻</w>回家。",
                                "cs": "Rozhodli jsme se jít <w>hned</w> domů.",
                                "nl": "We besloten om <w>meteen</w> naar huis te gaan.",
                                "pl": "Postanowiliśmy <w>od razu</w> iść do domu.",
                                "de": "Wir haben beschlossen, <w>gleich</w> nach Hause zu gehen.",
                                "fr": "Nous avons décidé de rentrer <w>tout de suite</w> à la maison.",
                                "it": "Abbiamo deciso di andare a casa <w>subito</w>.",
                                "tr": "<w>Hemen</w> eve gitmeye karar verdik.",
                                "es": "Decidimos irnos a casa <w>enseguida</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "тотчас",
                        "сейчас же",
                        "тут же",
                        "моментально",
                        "немедленно"
                    ],
                    "common_phrases": [
