                        "entry_id": "5d3dc157-e673-3249-bf64-bf0cc3ccdf0b",
                        "glosses": [
                            "To replace a (usually more front) consonant with a velar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b3b9bbf-2f0b-47db-b6a3-57d8996188a8",
                                "sense_id": "dde51f49-c610-3fa4-becb-929b4a138ace",
                                "text": "In several dialects of Central German, the cluster -nd- has been velarized to -ng-."
                            }
                        ]
                    }
                ],
