    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49bf1103-df8a-334c-8dad-7b1bb3500f8d",
                    "sense_definition": "Passend bij de huidige tijd; modern en niet ouderwets.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moderniteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben gekozen voor een <w>eigentijds</w> interieur met strakke meubels.",
                            "target_lang_translations": {
                                "en": "They have opted for a <w>modern</w> interior with sleek furniture."
                            }
                        },
                        {
                            "text": "Dit museum toont een prachtige collectie van <w>eigentijdse</w> kunst.",
                            "target_lang_translations": {
                                "en": "This museum shows a beautiful collection of <w>contemporary</w> art."
                            }
                        }
                    ],
                    "synonyms": [
                        "modern",
                        "actueel"
                    ],
                    "antonyms": [
                        "ouderwets",
                        "klassiek"
                    ],
                    "common_phrases": [
                        "eigentijdse kunst",
                        "eigentijds interieur"
                    ],
                    "target_lang_definitions": {
                        "en": "Fitting for the current time; modern and not old-fashioned."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "modern",
                                "target_lang_sense_clarification": "up-to-date and not old-fashioned"
                            },
                            {
                                "target_lang_word": "contemporary",
                                "target_lang_sense_clarification": "of the present age"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54614c55-4836-3deb-b5ec-0ac1fbb26fae",
                    "sense_definition": "Behorend tot de huidige tijd of het heden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moderniteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de <w>eigentijdse</w> geschiedenis zien we snelle technologische ontwikkelingen.",
                            "target_lang_translations": {
                                "en": "In <w>contemporary</w> history, we see rapid technological developments."
                            }
                        },
                        {
                            "text": "De auteur schrijft over <w>eigentijdse</w> problemen waar jongeren nu mee worstelen.",
                            "target_lang_translations": {
                                "en": "The author writes about <w>current</w> problems that young people are struggling with now."
                            }
                        }
                    ],
                    "synonyms": [
                        "hedendaags",
                        "actueel"
                    ],
                    "antonyms": [
                        "historisch",
                        "verleden"
                    ],
                    "common_phrases": [
                        "eigentijdse geschiedenis",
                        "eigentijdse problemen"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to the current time or the present."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contemporary",
                                "target_lang_sense_clarification": "belonging to the present time"
                            },
                            {
                                "target_lang_word": "current",
                                "target_lang_sense_clarification": "existing or occurring at the moment"
                            },
                            {
                                "target_lang_word": "present-day",
                                "target_lang_sense_clarification": "relating to the present time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55c5fadc-96b7-3fd7-a557-c02c8d4ffc80",
                    "sense_definition": "Behorend tot dezelfde periode als waarin de besproken gebeurtenissen plaatsvinden; contemporain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten deze gebeurtenissen begrijpen via <w>eigentijdse</w> bronnen uit die eeuw.",
                            "target_lang_translations": {
                                "en": "We must understand these events through <w>contemporary</w> sources from that century."
                            }
                        },
                        {
                            "text": "De biograaf maakte veelvuldig gebruik van <w>eigentijdse</w> verslagen van ooggetuigen.",
                            "target_lang_translations": {
                                "en": "The biographer made frequent use of <w>contemporaneous</w> eyewitness accounts."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eigentijdse bronnen",
                        "eigentijdse verslagen"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to the same period as the events being discussed; contemporaneous."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contemporary",
                                "target_lang_sense_clarification": "from the same time period"
                            },
                            {
                                "target_lang_word": "contemporaneous",
                                "target_lang_sense_clarification": "existing or occurring in the same period of time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}