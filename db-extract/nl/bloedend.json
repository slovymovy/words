        "nl-extract.jsonl": [
            {
                "entry_id": "2f4a1f83-4323-36de-88bb-ece22ecc540b",
                "word": "bloedend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "44d7d0db-9130-3cde-9423-fa6756d53269",
                        "entry_id": "2f4a1f83-4323-36de-88bb-ece22ecc540b",
                        "glosses": [
                            "bloed verliezend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e101872a-9dfb-4f28-bc74-adc78ca21e1c",
                                "sense_id": "44d7d0db-9130-3cde-9423-fa6756d53269",
                                "text": "Ook Yumi Ishikawa, actrice en parttime werkzaam bij een uitvaartbedrijf, werd door haar baas verplicht tot het dragen van hoge hakken: zwarte, dichte exemplaren zonder enkelbandje en met een hak tussen de vijf en zeven centimeter hoog, om precies te zijn. Steevast kwam ze thuis van haar werk met zere voeten en een bloedende kleine teen."
                            },
                            {
                                "example_id": "d9a66208-7739-477a-b9c8-a7a0b364f1f2",
                                "sense_id": "44d7d0db-9130-3cde-9423-fa6756d53269",
                                "text": "Het roofdier probeerde het hevig bloedende jongetje over het hek te slepen, om hem in het donker te verslinden."
                            },
                            {
                                "example_id": "bfd7682d-0a3c-47e8-8d62-7d05a36560ff",
                                "sense_id": "44d7d0db-9130-3cde-9423-fa6756d53269",
                                "text": "Bij de ingang van het ziekenhuis voor een luid schreeuwende vader met op zijn arm een bloedend kind, en vlak voor de lift toen er een door verpleegkundigen voortgeduwd bed met daarop iemand in narcose haar pad kruiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab82f2be-8359-34f1-a84a-752e30e1d5a7",
                        "entry_id": "2f4a1f83-4323-36de-88bb-ece22ecc540b",
                        "glosses": [
                            "van iets pijnlijks dat het nog niet over of vergeten is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4db7544e-2305-405d-a04d-0431ba697050",
                                "sense_id": "ab82f2be-8359-34f1-a84a-752e30e1d5a7",
                                "text": "Een mes dat haar al bloedende wonden verder openreet."
                            }
                        ]
                    }
