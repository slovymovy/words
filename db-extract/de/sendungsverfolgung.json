                "senses": [
                    {
                        "sense_id": "7b74980e-e804-33a5-a652-05eeaff879cb",
                        "entry_id": "4d8e6751-1eb2-32cb-a707-fc99f688eff0",
                        "glosses": [
                            "System, das den jeweiligen Aufenthaltsort einer postalischen Sendung auf dem Transportweg angeben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e399723-62cf-49f7-9de7-cf2e0c4ed552",
                                "sense_id": "7b74980e-e804-33a5-a652-05eeaff879cb",
                                "text": "Fast alle KEP-Dienste bieten mittlerweile die Sendungsverfolgung an."
                            },
                            {
                                "example_id": "7ad11c58-025c-40e3-9d01-74e8498433f9",
                                "sense_id": "7b74980e-e804-33a5-a652-05eeaff879cb",
                                "text": "„Mit den Namen bekannter Paketdienste wie DHL und UPS versuchen derzeit Internet-Kriminelle, per E-Mail schädliche Software auf Computern zu verbreiten. In den E-Mails sei ein Link zur angeblichen Sendungsverfolgung angegeben, erklärte die deutsche Verbraucherzentrale Brandenburg am Freitag.“"
                            },
                            {
                                "example_id": "c37648de-05d3-43c1-8f74-870584118cce",
                                "sense_id": "7b74980e-e804-33a5-a652-05eeaff879cb",
                                "text": "Durch die Nutzung eines Internetportals ist die Abbildung des gesamten Logistikprozesses von der Bestellung bis zur Sendungsverfolgung möglich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
