                "senses": [
                    {
                        "sense_id": "2cfe2de9-6aea-30c9-b2ba-8659c7461dc5",
                        "entry_id": "48d3a8dd-21e1-3bb1-bcfb-dffc18f51e91",
                        "glosses": [
