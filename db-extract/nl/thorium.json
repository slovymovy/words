                                                "sense_id": "04147c33-9cd0-379e-9a93-6e22ac498a3b",
                                                "text": "Reines Thorium ist ein silberweißes Metall."
                                            },
                                            {
                                                "example_id": "f82593d6-45c5-4e7a-9b9d-d9a4d2128566",
                                                "sense_id": "04147c33-9cd0-379e-9a93-6e22ac498a3b",
                                                "text": "In der Natur kommt nur ein einziges Isotop von Thorium vor, es ist also ein Reinelement."
                                            }
