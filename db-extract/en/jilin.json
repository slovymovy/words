                "entry_id": "62fe1da3-f3a6-315f-aa45-78119f00faee",
                "word": "Jilin",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d5e4871-f4de-3d16-a5e8-f83dbc9ceeaa",
                        "entry_id": "62fe1da3-f3a6-315f-aa45-78119f00faee",
                        "glosses": [
                            "A province of China. Capital: Changchun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec262653-b668-40eb-b21c-695d498a0750",
                                "sense_id": "8d5e4871-f4de-3d16-a5e8-f83dbc9ceeaa",
                                "text": "His homeland was in Chilin province, and his village was located more than four thousand li (about thirteen hundred miles) from Mount Wutai."
                            },
                            {
                                "example_id": "d17d736c-e1bc-46d3-9747-cf195a0a00ea",
                                "sense_id": "8d5e4871-f4de-3d16-a5e8-f83dbc9ceeaa",
                                "text": "The National Health Commission reported 1,337 locally transmitted cases in the latest 24-hour period, including 895 in the industrial province of Jilin. A government notice said that police permission would be required for people to leave the area or travel from one city to another.[…]\nOfficials on Sunday locked down the southern city of Shenzhen, which has 17.5 million people and is a major tech and finance hub that borders Hong Kong. That followed the lockdown of Changchun, home to 9 million people in Jilin province, starting last Friday."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4b4f32b-ebbd-354a-bb98-a91b2f66a50b",
                        "entry_id": "62fe1da3-f3a6-315f-aa45-78119f00faee",
                        "glosses": [
                            "A prefecture-level city of Jilin, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d23349-4107-4d86-8377-7705fadba786",
                                "sense_id": "b4b4f32b-ebbd-354a-bb98-a91b2f66a50b",
                                "text": "The northeast Chinese city of Jilin is imposing fresh restrictions on travel in order to contain a new coronavirus outbreak, with six new cases reported on Tuesday.[…]\nJilin is the second largest city of Jilin province, which borders North Korea and Russia. It will now temporarily suspend departing or transiting train services for passengers."
                            }
                        ]
                    }
                ],
