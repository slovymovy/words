                "senses": [
                    {
                        "sense_id": "97eef398-51d1-3e2e-87b1-96a8cf1afc87",
                        "entry_id": "114922ed-c6fa-392d-8ac6-4340ee74abdd",
                        "glosses": [
                            "Donner un caractère publicitaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e57262c6-0380-4fff-b758-a64e8c31de6b",
                                "sense_id": "97eef398-51d1-3e2e-87b1-96a8cf1afc87",
                                "text": "Il est dorénavant aussi important pour l'individu de vivre l'événement que de le publicitariser."
                            },
                            {
                                "example_id": "6179032b-969d-4dad-94d3-0d5aedf54e98",
                                "sense_id": "97eef398-51d1-3e2e-87b1-96a8cf1afc87",
                                "text": "Dépublicitariser la publicité, cela consiste en effet, très souvent, à publicitariser le média, c'est-à-dire à ne plus le traiter seulement comme espace partiellement susceptible d'être occupé par la publicité, mais comme un support intégralement exploitable."
                            },
                            {
                                "example_id": "46fb1d6b-d3e2-4282-9698-b589afdaf24c",
                                "sense_id": "97eef398-51d1-3e2e-87b1-96a8cf1afc87",
                                "text": "Editorialiser la publicité plutôt que publicitariser l'éditorial"
                            }
                        ]
                    }
