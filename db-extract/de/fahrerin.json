                        "sense_id": "dee1920b-d6a9-395f-884e-cc7d421e1e77",
                        "entry_id": "04826000-c122-3933-9524-58b481542552",
                        "glosses": [
                            "Conductrice"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "22554bda-2389-34b8-abb1-807f7c9eeb90",
                        "entry_id": "04826000-c122-3933-9524-58b481542552",
                        "glosses": [
                            "Automobiliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cffbaa-b6eb-42cd-9dce-8d499987ea5d",
                                "sense_id": "22554bda-2389-34b8-abb1-807f7c9eeb90",
                                "text": "Im Stau neben der gesperrten Fahrspur hupt eine Fahrerin wütend, weil es nicht vorangeht.",
                                "translation": "Dans un embouteillage à côté de la voie fermée, une automobiliste klaxonne avec colère parce que rien n’avance."
                            },
                            {
                                "example_id": "30e99a0e-f244-4173-8785-d9d2b06f3be6",
                                "sense_id": "22554bda-2389-34b8-abb1-807f7c9eeb90",
                                "text": "Die Polizei zog schließlich weitere Streifen hinzu – so konnte die Fahrerin endgültig gestoppt und kontrolliert werden.",
                                "translation": "La police a finalement fait appel à d'autres patrouilles, ce qui a permis d'arrêter définitivement la conductrice et de la contrôler."
                            }
                        ]
                    }
                ],
