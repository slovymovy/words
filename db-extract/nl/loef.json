                                "target_senses": [
                                    {
                                        "sense_id": "9e87421d-2a2c-3fbd-864c-437744d34954",
                                        "entry_id": "76199c99-6e15-3abb-93f9-c88fabac33d3",
                                        "glosses": [
                                            "die dem Wind zugewandte Seite des Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cec347c-6b7c-45b2-8d66-aa9b3771312f",
                                                "sense_id": "9e87421d-2a2c-3fbd-864c-437744d34954",
                                                "text": "Tosende See an Luv und Lee"
                                            },
                                            {
                                                "example_id": "b8c92339-a5d0-4133-ac7f-8af1d0609c65",
                                                "sense_id": "9e87421d-2a2c-3fbd-864c-437744d34954",
                                                "text": "Nicht nach Luv spucken!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4859ff43-599c-4697-a81f-d2649955ebe2",
                        "source_entry_id": "3daf303a-9430-3911-9452-dfe110eb1627",
                        "source_sense_id": "c60550f5-14ca-3e6b-8690-413ac6b7b3f8",
                        "source_sense_description": "de kant waar de wind vandaan komt",
                        "target_lang_word": "luff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef44499e-3a06-3f9c-b273-49dd1f154f49",
                                        "entry_id": "c0f61e4d-a5cf-3012-a9a4-a7588236a570",
                                        "glosses": [
                                            "The vertical edge of a sail that is closest to the direction of the wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488e7652-8aea-4875-aeaf-8d61a1d945bc",
                                                "sense_id": "ef44499e-3a06-3f9c-b273-49dd1f154f49",
                                                "text": "By easing the halyard, the luff of the sail was made to sag to leeward."
                                            },
                                            {
                                                "example_id": "c057d08c-6399-44d5-86ed-9877e6e21768",
                                                "sense_id": "ef44499e-3a06-3f9c-b273-49dd1f154f49",
                                                "text": "\"The man at the helm was watching the luff of the sail and whistling away gently to himself.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e0faed-85e5-3acd-8840-f0a48246312b",
                                        "entry_id": "c0f61e4d-a5cf-3012-a9a4-a7588236a570",
                                        "glosses": [
                                            "The act of sailing a ship close to the wind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afd5b1e2-f2b0-30d8-82e4-845eb8d2320f",
                                        "entry_id": "c0f61e4d-a5cf-3012-a9a4-a7588236a570",
                                        "glosses": [
                                            "The roundest part of a ship's bow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d32d7c70-d533-367f-b86a-62094ca0cbee",
                                        "entry_id": "c0f61e4d-a5cf-3012-a9a4-a7588236a570",
                                        "glosses": [
                                            "The forward or weather leech of a sail, especially of the jib, spanker, and other fore-and-aft sails."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "luff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08500a3c-5981-3174-b91c-b4a3c7214fd9",
                                        "entry_id": "cdbcc147-478b-3cd7-bc3e-65f6e790d26e",
                                        "glosses": [
                                            "To shake due to being trimmed improperly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b72d5619-4b19-407c-a612-82e620a42412",
                                                "sense_id": "08500a3c-5981-3174-b91c-b4a3c7214fd9",
                                                "text": "I thought how my life is like a little boat and I must hold the tiller steady against the buffeting of wind and waves, and how sometimes, like this morning, I lose my hold somehow and the sail luffs helplessly and the little vessel wallows, turning this way and that in the swell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8005bb0-1d4c-3954-b5c5-481af0fb4d78",
                                        "entry_id": "cdbcc147-478b-3cd7-bc3e-65f6e790d26e",
                                        "glosses": [
                                            "To bring the ship's head up closer to the wind. (Alternatively luff up)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d33114b-c9fd-4724-87c7-b0e228f838f9",
                                                "sense_id": "b8005bb0-1d4c-3954-b5c5-481af0fb4d78",
                                                "text": "\"Helm there! Luff, luff a point! So; steady, man, steady!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b1705ed-6def-3271-a366-2ecd2d304682",
                                        "entry_id": "cdbcc147-478b-3cd7-bc3e-65f6e790d26e",
                                        "glosses": [
                                            "to let out (a sail) so that it luffs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e68b3f0-7685-3872-9502-c43f91b3e1aa",
                                        "entry_id": "cdbcc147-478b-3cd7-bc3e-65f6e790d26e",
                                        "glosses": [
                                            "To alter the vertical angle of the jib of a crane so as to bring it level with the load."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5354d32-49a7-4772-bbc5-d3d14c8c66c4",
                                                "sense_id": "7e68b3f0-7685-3872-9502-c43f91b3e1aa",
                                                "text": "The tower is mounted on a slewing platform, which also carries the power plant and the counterweights, while the jib is supported and luffed by fixed pendant ropes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb2cbd86-d80e-408a-91e0-1899755dffa0",
                        "source_entry_id": "3daf303a-9430-3911-9452-dfe110eb1627",
                        "source_sense_id": "c60550f5-14ca-3e6b-8690-413ac6b7b3f8",
