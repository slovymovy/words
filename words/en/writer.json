            "pos": "noun",
            "senses": [
                {
                    "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                    "sense_definition": "A person who writes, especially one who produces literary work or books.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "author",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>writer</w> spent three years finishing her latest novel.",
                            "target_lang_translations": {
                                "ru": "Знаменитая <w>писательница</w> потратила три года на завершение своего последнего романа."
                            }
                        },
                        {
                            "text": "I met some of my favorite authors at the <w>writers</w> convention last weekend.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные я встретил нескольких своих любимых авторов на съезде <w>писателей</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "author",
                        "penman"
                    ],
                    "common_phrases": [
                        "prolific writer",
                        "freelance writer",
                        "writers convention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который пишет, особенно тот, кто создает литературные произведения или книги."
                    },
                    "translations": {
                        "ru": [
