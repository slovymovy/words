{
    "word_family": [
        "jutty",
        "juttingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "745b64c4-dafd-3c53-9a96-09c728be68fe",
                    "sense_definition": "To extend outward beyond a main line or surface; to protrude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protrude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp rocks <w>jut</w> out from the side of the cliff, making the climb dangerous.",
                            "target_lang_translations": {
                                "ru": "Острые скалы <w>выступают</w> из склона утеса, делая подъем опасным."
                            }
                        },
                        {
                            "text": "We could see a small peninsula <w>jutting</w> into the lake from our hotel window.",
                            "target_lang_translations": {
                                "ru": "Из окна нашего отеля мы видели небольшой полуостров, <w>выдающийся</w> в озеро."
                            }
                        }
                    ],
                    "synonyms": [
                        "protrude"
                    ],
                    "common_phrases": [
                        "jut out",
                        "jut into the sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдаваться вперед или наружу за пределы основной линии или поверхности; выступать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "выдаваться вперед"
                            },
                            {
                                "target_lang_word": "выдаваться",
                                "target_lang_sense_clarification": "выступать за пределы поверхности"
                            },
                            {
                                "target_lang_word": "торчать",
                                "target_lang_sense_clarification": "резко возвышаться или выделяться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89bf35b9-f5b6-3d27-b516-43bc9e9d6d6f",
                    "sense_definition": "To push, butt, or strike against something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aggressive animal began to <w>jut</w> its head against the wooden fence.",
                            "target_lang_translations": {
                                "ru": "Агрессивное животное начало <w>бодать</w> головой деревянный забор."
                            }
                        },
                        {
                            "text": "He watched the goats <w>jut</w> each other in the field.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как козы <w>бодают</w> друг друга в поле."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of butting or pushing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Толкать, бодать или ударять обо что-либо (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодать",
                                "target_lang_sense_clarification": "ударять рогами или головой"
                            },
                            {
                                "target_lang_word": "тыкаться",
                                "target_lang_sense_clarification": "ударяться обо что-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78e98ab6-3b83-3f8c-8c93-d2732524db4b",
                    "sense_definition": "A part that projects or sticks out from the main body or line.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castle was built on a high <w>jut</w> of granite overlooking the valley.",
                            "target_lang_translations": {
                                "ru": "Замок был построен на высоком гранитном <w>выступе</w> с видом на долину."
                            }
                        },
                        {
                            "text": "He stood on a rocky <w>jut</w> to get a better view of the canyon below.",
                            "target_lang_translations": {
                                "ru": "Он стоял на скалистом <w>выступе</w>, чтобы лучше рассмотреть каньон внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "outcrop",
                        "protrusion"
                    ],
                    "common_phrases": [
                        "rocky jut",
                        "jut of land"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть, которая выступает или выдается вперед из основного корпуса или линии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступ",
                                "target_lang_sense_clarification": "выступающая часть поверхности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "74053611-aa04-3b46-90ef-0dbb76563a5c",
                    "sense_definition": "A dated spelling of <w>Jat</w>, referring to a member of a traditionally agricultural people of northern India and Pakistan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "In older colonial texts, a member of this community was often referred to as a <w>Jut</w>.",
                            "target_lang_translations": {
                                "ru": "В более старых колониальных текстах представителя этой общины часто называли <w>джатом</w>."
                            }
                        },
                        {
                            "text": "The historical document describes the customs of the <w>Jut</w> families in the region.",
                            "target_lang_translations": {
                                "ru": "В историческом документе описываются обычаи семей <w>джатов</w> в этом регионе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "spelling variant of Jat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова Джат, обозначающего представителя традиционно земледельческого народа в северной Индии и Пакистане."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джат",
                                "target_lang_sense_clarification": "представитель этнической группы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}