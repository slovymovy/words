                "senses": [
                    {
                        "sense_id": "97be1dca-a34c-32c2-a2cb-8432b6448888",
                        "entry_id": "83f32b1b-c72e-364d-a0c8-6d6b9661257e",
                        "glosses": [
                            "действие по значению гл. совершенствовать, совершенствоваться"
                        ],
                        "tags": [],
