                        ],
                        "form": "den Grenzübergang"
                    },
                    {
                        "form_id": "536fecec-d234-4c72-9277-12e3cea8d41e",
                        "entry_id": "f57ef2da-03b9-3417-91ef-e52a6f0558da",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Grenzübergänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                        "entry_id": "f57ef2da-03b9-3417-91ef-e52a6f0558da",
                        "glosses": [
                            "Stelle, an der man eine Grenze zwischen Staaten passieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59573bb2-c2dc-4b30-958d-3cfd8353ed74",
                                "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                                "text": "Alle Grenzübergänge wurden geschlossen."
                            },
                            {
                                "example_id": "21a02d01-499f-44d8-8feb-584499da4d91",
                                "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                                "text": "„Er war gerade mit seinem Trabbi über einen provisorischen Grenzübergang in den Westen gekommen.“"
                            },
                            {
                                "example_id": "d1de83ff-9654-4477-82b2-8584dd95fdf1",
                                "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                                "text": "„Wir saßen dann wieder im Bus und fuhren zurück zum Grenzübergang.“"
                            },
                            {
                                "example_id": "0dc14cbf-68b6-45e4-90b1-d781be15a5db",
                                "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                                "text": "„Nun stand ich vor dem bulgarischen Grenzübergang und überlegte angestrengt, was mir zu Bulgarien alles in den Sinn kam.“"
                            },
                            {
                                "example_id": "14f889d3-24f2-46d0-872e-b0d5f1d2002b",
                                "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                                "text": "„Einen Steinwurf vom unbewachten Grenzübergang steht ein VW Sharan der Grenzwache und blockiert die rechte Strassenseite.“"
                            },
                            {
                                "example_id": "7005f3b2-3e6b-4301-80c7-ec1bd9f27c99",
                                "sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
                                "text": "„Wer aktuell nach Dänemark ein- oder ausreisen möchte, muss gelegentlich mit Wartezeiten an den Grenzübergängen rechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                        "entry_id": "f57ef2da-03b9-3417-91ef-e52a6f0558da",
                        "glosses": [
                            "stetiges Fortsetzen, auch zu einer Definitionslücke; scheinbares Erreichen des Ziels durch unendlich kleine Annäherung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef896437-cced-426e-b55b-0afc73ed94e3",
                                "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                                "text": "„Das Symbol lim _(x→p)f(x), gelesen ‚Limes f von x für x gegen p‘, bezeichnet den Limes der reellen Funktion f für den Grenzübergang der Variablen x gegen p.“"
                            },
                            {
                                "example_id": "6aee365f-004f-4a1c-be62-a62cbec1824c",
                                "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                                "text": "„Harmonische Funktionen haben sehr gute Stabilitätseigenschaften bei Grenzübergang.“"
                            },
                            {
                                "example_id": "988ecab7-e140-45fe-9ba5-49c7807ade73",
                                "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                                "text": "„Im Grenzübergang für kleiner werdende Differenzen Δb werden aus den Differenzen wieder Differenziale, und der Differenzenquotient wird zum Differenzialquotienten.“"
                            },
                            {
                                "example_id": "dddeba6a-4976-4521-92ae-0c76be09b8b6",
                                "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                                "text": "„Dann hätte man den Grenzübergang zu vollführen, womit man den Ansatz in den Differentialen bekommen könnte, aus dem allein dann die weitere Rechnung zu folgen hat.“"
                            },
                            {
                                "example_id": "cdd59388-a5ac-4d4b-ba2e-38ae7f470ef8",
                                "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                                "text": "„Um den Grenzübergang anzudeuten, lässt man das Zeichen lim fort und schreibt dafür statt des Buchstaben Δ, ein d vor x und f(x).“"
                            },
                            {
                                "example_id": "d38174ef-2a64-4afd-96c6-26af99676363",
                                "sense_id": "7de2ae80-98ec-3ba1-b2a7-3b9affc6571f",
                                "text": "„Durch Grenzübergang zu unendlich kleinen Stücken erhält man die genaue Masse.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c84463ec-2829-4929-8d0a-3126dbda3102",
                        "source_entry_id": "f57ef2da-03b9-3417-91ef-e52a6f0558da",
                        "source_sense_id": "8668ff6c-8e56-3dd9-974b-9cfd7251189e",
