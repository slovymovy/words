                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ef02dc-2ccf-485d-a576-72b0a4adfd37",
                                "sense_id": "89e44254-7367-3a31-ae72-b523aa9acfe0",
                                "text": "I made a pact with her that she would teach me more Marathi and I could teach her the English alphabet."
                            }
                        ]
                    }
                ],
