                "senses": [
                    {
                        "sense_id": "a49387a9-de4b-36e1-8f08-0d006c4ade07",
                        "entry_id": "9d863606-cad7-3eb8-939d-9c40c57e12a6",
                        "glosses": [
                            "Réchauffement climatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e007af-3cec-450d-ab25-0e8f5375486d",
                                "sense_id": "a49387a9-de4b-36e1-8f08-0d006c4ade07",
                                "text": "Die Klimaerwärmung dauert seit mehr als 100 Jahren an.",
                                "translation": "Le réchauffement climatique se poursuit depuis plus de 100 ans."
                            },
                            {
                                "example_id": "75e4f18d-5cca-4ebd-9404-a72bbece9b52",
                                "sense_id": "a49387a9-de4b-36e1-8f08-0d006c4ade07",
                                "text": "Das Artensterben wird durch die Zerstörung von Lebensräumen verursacht und durch die Klimaerwärmung noch zusätzlich befördert.",
                                "translation": "L’extinction des espèces est causée par la destruction des habitats et est encore favorisée par le réchauffement climatique."
                            },
                            {
                                "example_id": "c9177f99-505b-43c4-ab00-2812c010e244",
                                "sense_id": "a49387a9-de4b-36e1-8f08-0d006c4ade07",
                                "text": "Quallenplagen und Plastikmüll sind nur die augenfälligsten Symptome dafür, wie es um das Mittelmeer bestellt ist. Mit der Klimaerwärmung drohen dem kleinen Ozean zwischen Europa und Afrika langfristige Gefahren.",
                                "translation": "Les invasions de méduses et les déchets plastiques ne sont que les symptômes les plus visibles de l'état de la Méditerranée. Avec le réchauffement climatique, le petit océan entre l'Europe et l'Afrique est menacé par des dangers à long terme."
                            },
                            {
                                "example_id": "f1f23256-250c-4623-aae5-5bca556a49e0",
                                "sense_id": "a49387a9-de4b-36e1-8f08-0d006c4ade07",
                                "text": "Derartige Temperaturen wären ohne die Klimaerwärmung von bislang 1,2 Grad im Vergleich zur vorindustriellen Zeit „nahezu unmöglich“ gewesen.",
                                "translation": "De telles températures auraient été \"quasiment impossibles\" sans le réchauffement climatique de 1,2 degré à ce jour par rapport à l'ère préindustrielle."
                            }
                        ]
                    }
                ],
