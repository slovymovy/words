                        "glosses": [
                            "A bat, of the genus Nyctalus, that lives in tree hollows."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d88f2181-7e31-487e-b469-e1d25af7386f",
                                "sense_id": "e493b09a-6490-3677-b342-dc2cf3cd36e3",
                                "text": "We were all still growing used to the night-time, the blue-veined hours of morning that lay only lightly, the white spiders and noctule bats."
                            }
                        ]
                    }
                ],
