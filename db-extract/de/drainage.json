                "senses": [
                    {
                        "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                        "entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                        "glosses": [
                            "eine Art von Entwässerungskanal im Boden, der beispielsweise um Gebäude verlegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5720b232-fa97-4bf5-8be5-b9a92fa77f2b",
                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                "text": "Wir müssen vor dem Haus noch eine Drainage verlegen."
                            },
                            {
                                "example_id": "db4f6ea3-30ac-44be-987a-66f9ad7e7d7a",
                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                "text": "„Bei uns in Russland geht man auf eine Tiefe bis 60 Zentimeter, aber in Ostpreußen liegt die Drainage bei 40 Zentimeter Tiefe.“"
                            },
                            {
                                "example_id": "0089fee1-821e-4b81-b31c-cd8b887a900a",
                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                "text": "„Das Frankfurter Waldstadion hatte keine gute Drainage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db350789-e36b-3c70-bb04-5f93ef400db6",
                        "entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                        "glosses": [
                            "Ableitung von Flüssigkeiten aus Körperhöhlen mittels eingelegter Röhrchen oder Laschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9159a7e8-1369-4eb9-96d3-d0d051c333f2",
                                "sense_id": "db350789-e36b-3c70-bb04-5f93ef400db6",
                                "text": "„Unter Drainage versteht man Ableitungssysteme, die der Ableitung von Wundflüssigkeit, Blut oder Eiter aus Körper-, Wund- oder Eiterhöhlen dienen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d54c9c2-bf3b-4cf7-945e-19d669a16e24",
                        "source_entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                        "source_sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                        "source_sense_description": "Bauwesen: eine Art von Entwässerungskanal im Boden, der beispielsweise um Gebäude verlegt wird",
                        "target_lang_word": "drainage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drainage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A natural or artificial means for the removal of fluids from a given area by its draining away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f677bd-6796-4fcf-b1d6-3d7843e0accb",
                                                "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                                "text": "It should move NR away from previous examples of repairs that have treated the symptoms (fixing the landslip) but not fixed the underlying cause (poor drainage), with the result that a second slip followed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89583c24-9dab-30d1-8d1d-7ff36c3d5ef4",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A system of drains."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A downward wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ebc4d8-22f6-404d-81a0-a624ab2dda2e",
                                                "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                                "text": "In the forward part of the cyclone, drainage katabasis is checked; but its highest intensity is observed in the rear part of the cyclone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "733b6040-d897-4165-8c8e-0befcbbf073e",
                        "source_entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                        "source_sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                        "source_sense_description": "Bauwesen: eine Art von Entwässerungskanal im Boden, der beispielsweise um Gebäude verlegt wird",
                        "target_lang_word": "drainage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drainage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                        "entry_id": "a281eadf-f493-3db8-8c9a-0fd76b71f70b",
                                        "glosses": [
                                            "Action de drainer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86ccf91-baef-4cce-97d1-b022cfdce7d9",
                                                "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                                "text": "Tous les bons effets du drainage sont si bien appréciés que la plus grande partie des terrains argileux, à sous-sol compacte et humide, du département ont été drainés, et partout les cultivateurs ont eu à se louer de opération."
                                            },
                                            {
                                                "example_id": "0949a2e4-dcbb-4273-be47-d5dccb592863",
                                                "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                                "text": "Habituellement les terrains mouilleux qu’on veut planter sont assainis au préalable et le creusement des fossés de drainage sert à faire des buttes ou des remblais."
                                            },
                                            {
                                                "example_id": "cd3aec10-6818-42e9-b605-7b02906222ff",
                                                "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                                "text": "Le seul exutoire des eaux du marais étant le Petit-Morin au pont de Saint-Prix, il apparaît évident que l'entretien de cette rivière (faucardage et curage) doit être régulier, sinon le drainage serait insuffisant et l'eau stagnerait sur les terres voisines, rendant ainsi toute culture impossible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb435e36-2f2e-35c3-a574-efaa5108efdb",
                                        "entry_id": "a281eadf-f493-3db8-8c9a-0fd76b71f70b",
                                        "glosses": [
                                            "Le drainage du rein."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
