        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "37e668d3-b26b-33b9-bfaa-814e4e7a18db",
                "word": "picobello",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "c042f285-37df-4fbf-90c2-c77cf31815da",
                        "entry_id": "37e668d3-b26b-33b9-bfaa-814e4e7a18db",
                        "tags": [
                            "positive"
                        ],
                        "form": "picobello"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                        "entry_id": "37e668d3-b26b-33b9-bfaa-814e4e7a18db",
                        "glosses": [
                            "einwandfrei (in Ordnung), vorzüglich"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e570b407-a7e0-44d8-904a-396a24f8e04d",
                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                "text": "„Schließlich will man das Rentnerdasein ja genießen, mit picobello geschorenem Rasen und frisch gestrichenem Lattenzaun ums üppige Anwesen.“"
                            },
                            {
                                "example_id": "a618636e-f0f7-4a1a-875e-a62185bf6710",
                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                "text": "„Polen, mit denen ich durch diese Dörfer fuhr, haben mich immer wieder, halb ehrfürchtig, halb spöttisch, auf die picobello geharkten Vorgärten hingewiesen.“"
                            },
                            {
                                "example_id": "14cad05d-efed-4b0e-96e1-1e5085129890",
                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                "text": "„Die mußten picobello aussehen und glänzen wie Speckschwarten.“"
                            },
                            {
                                "example_id": "959a2049-48e3-49e1-8fd5-fcbc21ba00e6",
                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                "text": "„Sie sollen alle das Haus putzen, es muss picobello sauber sein.“"
                            },
                            {
                                "example_id": "c16264d9-a779-4056-98cd-88f24edc65ec",
                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                "text": "„Es ist nicht immer alles picobello, aber am schönsten ist es, wenn alles picobello ist. Und manchmal, wenn alles geschafft ist, dann ist alles picobello und dann ist Irmi richtig zufrieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01ead85e-dda5-411f-9b0e-eed429ea4c20",
                        "source_entry_id": "37e668d3-b26b-33b9-bfaa-814e4e7a18db",
                        "source_sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                        "source_sense_description": "umgangssprachlich: einwandfrei (in Ordnung), vorzüglich",
                        "target_lang_word": "spick-and-span",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spick-and-span",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                        "entry_id": "9f845469-2cd8-3788-a51d-f29eb7486dc0",
                                        "glosses": [
                                            "Clean, spotless."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d20854-8666-45b5-9610-cbae4296ef02",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "I mopped up the kitchen floor so it was spick-and-span."
                                            },
                                            {
                                                "example_id": "34a54dfc-3d73-4c78-aa87-7f8d2301eca4",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "Sir, this is a ſpell againſt 'hem, ſpicke and ſpan new, and 'tis made as 'twere in mine owne perſon, and I ſing it in mine owne defence."
                                            },
                                            {
                                                "example_id": "85cdf8df-6c7f-4381-8385-0e0dfb777d06",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "My Lady Batten walking through the dirty lane with new spicke and span white shoes."
                                            },
                                            {
                                                "example_id": "2e476bfd-6c64-46dd-b13e-40a1c7051ddc",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "The Warders strutted up and down, / And kept their herd of brutes, / Their uniforms were spick and span, / And they wore their Sunday suits, / But we knew the work they had been at, / By the quicklime on their boots."
                                            },
                                            {
                                                "example_id": "a54e87fe-7069-4200-8097-543807ac0930",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "“But the traders ruined his digestion with too much champagne, and after several years he fell for the Gospel according to the Methodists, sent his people to church, and cleaned up the beach and the trading crowd so spick and span that he would not permit them to smoke a pipe out of doors on Sunday, […]"
                                            },
                                            {
                                                "example_id": "e3746cce-c322-4600-a304-6fd323995134",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "Mr. and Mrs. Chow, for instance, drew up one afternoon in their spick-and-span coupe with their intolerably spotless only child sitting self-consciously beside them."
                                            },
                                            {
                                                "example_id": "54b49da9-70c9-4b3c-a568-541eb9a6239d",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "The \"V4\" 2-6-2 Bantam Cock is now stationed at Norwich, and its spick-and-span condition does credit to the cleaners at that shed."
                                            },
                                            {
                                                "example_id": "35ab1f45-63f2-4a09-ba34-ba64948c7d89",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "Wipe down the upholstery – now when it comes to upholstery, it don't need to be spic and span, you don't need to eat off in. Give it a good once over."
                                            },
                                            {
                                                "example_id": "6f4fba16-ad26-44ec-8def-7a7a264009a2",
                                                "sense_id": "cc7c6d36-0adb-33a2-8ff0-d0a0434dabf8",
                                                "text": "From a spick and span penthouse in New York, to a ranch in Colorado, from a posh boarding school to public school, and from having virtually no boys in her life to having 12!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b42e10c-2c0f-433d-9bc9-eeb9554edf75",
                        "source_entry_id": "37e668d3-b26b-33b9-bfaa-814e4e7a18db",
                        "source_sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                        "source_sense_description": "umgangssprachlich: einwandfrei (in Ordnung), vorzüglich",
                        "target_lang_word": "spotlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spotlessly",
