                    "frequency": "High",
                    "semantic_group_id": "argent_garantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a promis de restituer la <w>caution</w> à la fin du bail."
                        },
                        {
                            "text": "Avant d'emménager dans l'appartement, nous avons dû payer un mois de <w>caution</w>."
                        }
                    ],
                    "synonyms": [
                        "gage",
                        "garantie"
                    ],
                    "common_phrases": [
