                                "example_id": "ae343c56-ed98-4cc8-b08f-2db6e841d48f",
                                "sense_id": "09bcb3ba-4e75-3c7d-9e7d-cd998601f40c",
                                "text": "Compounds containing primary alkylamino groups are amongst these."
