                                        "sense_id": "536a12c1-a027-36d5-abdd-f5dd3f96e2c9",
                                        "entry_id": "287fcfe7-7de4-38bf-9a9d-4e7243869c0b",
                                        "glosses": [
                                            "A former transcontinental country in Europe and Asia (1922–1991), now split into Russia and 14 other countries. Official name: Union of Soviet Socialist Republics."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac6d948b-b85b-4e13-8202-bef84328a42c",
                                                "sense_id": "536a12c1-a027-36d5-abdd-f5dd3f96e2c9",
                                                "text": "Hence the famous February 9th 1946 speech at the Bolshoi Theatre, where Stalin announced that the Soviet Union was returning to its pre-war emphasis on industrialization, war-preparedness, and the inevitability of conflict between capitalism and Communism, and made explicit what was already obvious, that henceforth the Soviet Union would cooperate with the West only when it suited her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26bd302a-4c04-37ca-8038-5fca8092d025",
                                        "entry_id": "287fcfe7-7de4-38bf-9a9d-4e7243869c0b",
                                        "glosses": [
                                            "The Russian Soviet Federative Socialist Republic."
                                        ],
