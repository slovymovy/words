                        "examples": [
                            {
                                "example_id": "c8074f91-56b2-4d72-91f8-98091f7871ef",
                                "sense_id": "8e46691b-7039-3aed-a5d6-f0d799278b2b",
                                "text": "His design for a perpetual motion machine is flawed because water does not flow uphill."
                            },
                            {
                                "example_id": "e7cc44e5-179b-4069-82a7-1de7ecbf61b6",
                                "sense_id": "8e46691b-7039-3aed-a5d6-f0d799278b2b",
                                "text": "Flawed diamonds are generally not used in jewellery."
                            },
                            {
                                "example_id": "ac9f93a9-1706-46e0-ac49-8316d82942c3",
                                "sense_id": "8e46691b-7039-3aed-a5d6-f0d799278b2b",
                                "text": "He presents Hitler’s rise as an element of the collapse of a republic confronting dilemmas of globalization with imperfect instruments and flawed leaders."
                            },
                            {
                                "example_id": "4063d545-e282-4b8c-ae66-30b938f31979",
                                "sense_id": "8e46691b-7039-3aed-a5d6-f0d799278b2b",
                                "text": "Yet he was correct on every point, meaning that the Plan was deeply flawed from the start."
                            }
                        ]
                    }
