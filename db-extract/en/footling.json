                "senses": [
                    {
                        "sense_id": "7f4974d5-f8ea-32e4-9c10-93c1ed528580",
                        "entry_id": "b3fe9fd9-d1db-3591-9ea7-16bf04d8e4f1",
                        "glosses": [
                            "trivial, silly and irritating."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4f01ca-b81f-4693-87fd-d5a1739853cc",
                                "sense_id": "7f4974d5-f8ea-32e4-9c10-93c1ed528580",
                                "text": "He was explaining to her things about the air service. . . . \"Isn't it rather dangerous work?\" she asked. She felt it was a footling question even as she asked it."
                            },
                            {
                                "example_id": "8804cfed-9e86-4b7e-bc62-34d5858c64d4",
                                "sense_id": "7f4974d5-f8ea-32e4-9c10-93c1ed528580",
                                "text": "Only a couple of days ago I was compelled to take him off a case because his handling of it was so footling."
                            },
                            {
                                "example_id": "15cf6b9e-a27a-4b52-9609-3e717815ab3a",
                                "sense_id": "7f4974d5-f8ea-32e4-9c10-93c1ed528580",
                                "text": "For 28 footling days the 58-nation General Assembly had been debating the now-famous U.S. afterthought: to postpone partition and substitute a U.N. trusteeship for Palestine."
                            },
                            {
                                "example_id": "8cabb25a-ecd0-459d-9d7e-b0cb1c181fac",
                                "sense_id": "7f4974d5-f8ea-32e4-9c10-93c1ed528580",
                                "text": "They are electrically hauled, and travel at over 70 m.p.h. between stops, but they make five stops at footling little country towns and take two hours for the 98-mile run."
                            },
                            {
                                "example_id": "6b9ad46d-1b25-460f-965b-fa4ae8174177",
                                "sense_id": "7f4974d5-f8ea-32e4-9c10-93c1ed528580",
                                "text": "“Why did you persist in writing hurlothrumbo romances of the footling sort favored by mooncalfs?”"
                            }
                        ]
                    }
                ],
