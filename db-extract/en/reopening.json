                        "examples": [
                            {
                                "example_id": "a27ebbaa-a2b9-47b5-be75-2d36c4794967",
                                "sense_id": "715a20ba-b86e-3e47-aabb-75441d3f6419",
                                "text": "Grove: After many years of unproductive discussion, the reopening of the London-Bristol line station to serve the nearby town of Wantage is back on the agenda."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96e26324-07f9-47a7-b19c-cbcd38c84676",
                        "source_entry_id": "a44f3891-2fce-377b-af96-7950aad31cc9",
