                        "sense_id": "6c6b9296-7805-3eda-8eba-447bb0f79666",
                        "entry_id": "a7d5ddd6-d33b-341a-b859-320639384585",
                        "glosses": [
                            "Produire un effet électro-magnétique sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a75dfbf6-6e20-44b3-b6ae-021ce6697e9e",
                                "sense_id": "6c6b9296-7805-3eda-8eba-447bb0f79666",
                                "text": "Pour vous \"électromagnétiser\", voici Code-E 08."
                            },
                            {
                                "example_id": "b19a5eb0-540d-466e-b424-2a0f2d85fd34",
                                "sense_id": "6c6b9296-7805-3eda-8eba-447bb0f79666",
                                "text": "Ainsi, le temps a été créé et les peuples se sont vus électromagnétiser par un temps linéaire fondé sur l’illusion du système solaire;"
                            },
                            {
                                "example_id": "de3e49c4-f1f0-4c04-9102-e52808c9a984",
                                "sense_id": "6c6b9296-7805-3eda-8eba-447bb0f79666",
                                "text": "Quand il se fait « électromagnétiser » par Widmore, il n’est pas encore mort, comment peut-il voir un « endroit » irréel, inventé par des morts ?"
                            }
                        ]
                    }
