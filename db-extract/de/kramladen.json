                    {
                        "translation_id": "0519fbdc-9b9c-44c0-ba97-80189fdd0082",
                        "source_entry_id": "8d8f821e-82b1-3f9b-a52f-a07f6e9caeba",
                        "source_sense_id": "89627ba5-c07e-3164-af1a-ca572630ed5c",
