                                        "entry_id": "03efed7d-7827-3732-89d1-d02d58db0f95",
                                        "glosses": [
                                            "Celui qui adore un seul Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236875ee-eedd-4d03-8599-03a17d8a18a1",
                                                "sense_id": "51adb6de-b2c6-39b7-9f03-ff2f4b9ffa71",
                                                "text": "Les apôtres n'avaient pas besoin de prêcher l'unité de Dieu aux Juifs, qui étaient de fervents monothéistes."
