    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "083d16fc-653d-3491-8f5f-cca4a67e24fb",
                    "sense_definition": "Чувство успокоения, освобождения от тревоги, страха, боли или беспокойства.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "чувство_успокоения",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда врач сказал, что операция прошла успешно, мы все вздохнули с <w>облегчением</w>.",
                            "target_lang_translations": {
                                "en": "When the doctor said that the operation was successful, we all breathed a sigh of <w>relief</w>."
                            }
                        },
                        {
                            "text": "Новость о благополучном возвращении экспедиции принесла огромное <w>облегчение</w> её близким.",
                            "target_lang_translations": {
                                "en": "The news of the expedition's safe return brought immense <w>relief</w> to their loved ones."
                            }
                        }
                    ],
                    "synonyms": [
                        "успокоение",
                        "отдушина"
                    ],
                    "antonyms": [
                        "напряжение",
                        "тревога"
                    ],
                    "common_phrases": [
                        "вздохнуть с облегчением",
                        "принести облегчение",
                        "чувство облегчения"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of reassurance and relaxation following release from anxiety, fear, pain, or distress."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relief",
                                "target_lang_sense_clarification": "feeling of reassurance or relaxation"
                            },
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "freedom from pain, worry, or trouble"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e3c947-81a1-3315-99b7-91b2c03a0491",
                    "sense_definition": "Действие по значению глаголов <w>облегчать</w>, <w>облегчить</w>; уменьшение веса, трудности, тяжести чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "процесс_уменьшения_нагрузки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новые технологии направлены на <w>облегчение</w> труда рабочих на заводах.",
                            "target_lang_translations": {
                                "en": "New technologies are aimed at <w>easing</w> the labor of factory workers."
                            }
                        },
                        {
                            "text": "Для <w>облегчения</w> веса конструкции инженеры решили использовать современные композитные материалы.",
                            "target_lang_translations": {
                                "en": "For <w>lightening</w> the weight of the structure, the engineers decided to use modern composite materials."
                            }
                        }
                    ],
                    "synonyms": [
                        "упрощение",
                        "уменьшение"
                    ],
                    "antonyms": [
                        "утяжеление",
                        "усложнение"
                    ],
                    "common_phrases": [
                        "облегчение труда",
                        "облегчение веса"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of making something lighter, easier, or less severe."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easing",
                                "target_lang_sense_clarification": "making less difficult or intense"
                            },
                            {
                                "target_lang_word": "lightening",
                                "target_lang_sense_clarification": "making lighter in weight or load"
                            },
                            {
                                "target_lang_word": "facilitation",
                                "target_lang_sense_clarification": "making an action or process easier"
                            },
                            {
                                "target_lang_word": "alleviation",
                                "target_lang_sense_clarification": "making pain or a problem more bearable"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}