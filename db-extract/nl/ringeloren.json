        "nl-extract.jsonl": [
            {
                "entry_id": "3d540176-0d67-38a9-b6e3-9e15e166ba19",
                "word": "ringeloren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7b4d786-adf1-33df-aafe-de189669d403",
                        "entry_id": "3d540176-0d67-38a9-b6e3-9e15e166ba19",
                        "glosses": [
                            "kort houden, in bedwang houden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3f7a8f0f-4491-4b18-ba0d-512e8c056123",
                                "sense_id": "c7b4d786-adf1-33df-aafe-de189669d403",
                                "text": "Daarmee komt de aandacht eindelijk te liggen op de twee grote Visegradlanden die géén aansluiting bij de Europese kerngroep zoeken, Polen en Hongarije. Zij doen juist het omgekeerde. Actie tegen de manier waarop zij de democratie ringeloren, zou weleens onvermijdelijk kunnen worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdee5fd4-cd46-3591-add5-38085dc1b0bd",
                        "entry_id": "3d540176-0d67-38a9-b6e3-9e15e166ba19",
                        "glosses": [
                            "voor de mal houden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "09072bc1-ae94-46bb-893f-a69579c1ccf7",
                                "sense_id": "fdee5fd4-cd46-3591-add5-38085dc1b0bd",
                                "text": "De flamboyante wereldkampioen was in Milaan-San Remo veruit de beste man in koers, maar liet zich mede door zijn tomeloze inzet op kop daarna in de eindsprint wel ringeloren door Michal Kwiatkowski. Zal daarom in Harelbeke misschien wel extra gebrand zijn om wel te winnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "13d48704-9914-3e23-a441-ab178f7fdd1e",
                        "entry_id": "3d540176-0d67-38a9-b6e3-9e15e166ba19",
                        "glosses": [
                            "rondom versieren met motieven of opschriften met een trechtervormig spuitstuk"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b2abf4ef-ca27-45c3-8321-20ee77458f98",
                                "sense_id": "13d48704-9914-3e23-a441-ab178f7fdd1e",
                                "text": "Ringeloren is een traditionele versieringstechniek in de pottenbakkerij. Dunne klei wordt in een dunne straal, met behulp van een koehoorn waarin een gat zit, op een nog ongebakken kleiproduct gegoten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08a8e548-ca39-4762-90d1-f600344932cb",
                        "source_entry_id": "3d540176-0d67-38a9-b6e3-9e15e166ba19",
                        "source_sense_id": "c7b4d786-adf1-33df-aafe-de189669d403",
                        "source_sense_description": "kort houden, in bedwang houden",
                        "target_lang_word": "bully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A person who is intentionally physically or emotionally cruel to others, especially to those whom they perceive as being vulnerable or of less power or privilege."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9197c8d-1941-440f-a7f2-b9bb240fd75e",
                                                "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                                                "text": "A playground bully pushed a girl off the swing."
                                            },
                                            {
                                                "example_id": "d1f2a8f0-0284-4f4e-9af2-3b66c857209f",
                                                "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                                                "text": "I noticed you being a bully towards people with disabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac986e8-d672-3ae4-9fa1-5b8c1ee85568",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A noisy, blustering, tyrannical person, more insolent than courageous; one who is threatening and quarrelsome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfc2568-9e01-41cf-8fea-f31fe4501be7",
                                                "sense_id": "0ac986e8-d672-3ae4-9fa1-5b8c1ee85568",
                                                "text": "Besides, bullies seldom execute the threats they deal in; and men of trick and cunning are not always men of desperate resolves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90363443-daa2-3b96-8323-111cdbe4b9bc",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A hired thug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43157e57-f9f3-4fc4-bf97-5cb54559ab1e",
                                                "sense_id": "90363443-daa2-3b96-8323-111cdbe4b9bc",
                                                "text": "Mr. Fisher returned from town... he had learnt that our opponents intended to shift the scene of operations to the Chats... We understood that they had hired two bullies for the purpose of deciding the matter par voie de fait. Mr Fisher hired two of the same description, who were supposed to be more than a match for the opposition party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194c55e9-92fd-334e-9688-39b01cc7cc60",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A sex worker's minder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a8d9cc-ce5e-4e9f-bd88-5cd8f741348e",
                                                "sense_id": "194c55e9-92fd-334e-9688-39b01cc7cc60",
                                                "text": "The Proclamation Society and the Society for the Suppression of Vice were more concerned with obscene literature […] than with hands-on street battles with prostitutes and their bullies […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb7e8ae-0c7e-39b7-aead-b336198fee26",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "Bully beef."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d25bdff4-abde-334e-96cd-850b245ac8dc",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A brisk, dashing fellow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f349e1e-6c61-4208-9250-b6dc9d8eed8d",
                                                "sense_id": "d25bdff4-abde-334e-96cd-850b245ac8dc",
                                                "text": "What sayest thou, Bully Bottom?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a019d780-6d7d-3657-83c7-aebb8b3075a2",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "The small scrum in the Eton College field game."
                                        ],
                                        "tags": [
