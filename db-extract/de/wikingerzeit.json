                        "sense_id": "7bdc1b1a-a1ce-3167-a59e-f149a1e1dd97",
                        "entry_id": "aac48ff8-1518-36c2-a070-10aee7337e6c",
                        "glosses": [
                            "von den Wikingern geprägte Epoche (grob auf die Zeit 800–1050 nach Christus datiert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5178ccb6-6490-4061-84b3-572d224c7afc",
                                "sense_id": "7bdc1b1a-a1ce-3167-a59e-f149a1e1dd97",
                                "text": "Der Begriff der Wikingerzeit wurde von dem dänischen Archäologen Jens Jacob Asmussen Worsaae (1821–1885) geprägt."
                            },
                            {
                                "example_id": "ef9990d7-e04b-4e83-8f49-202ad75b5841",
                                "sense_id": "7bdc1b1a-a1ce-3167-a59e-f149a1e1dd97",
                                "text": "„Das Ende der Blütezeit der irischen Klosterkultur kam mit der Wikingerzeit, die mit dem Überfall auf das Kloster Lindisfarne im Jahre 793 begann.“"
                            },
                            {
                                "example_id": "d9fefb02-3bc1-4c2c-8c1c-cd20478078c8",
                                "sense_id": "7bdc1b1a-a1ce-3167-a59e-f149a1e1dd97",
                                "text": "„Das sehenswerte Museum erzählt mit Audioguides die Geschichte der Färöer von der Wikingerzeit bis ins ausgehende 16. Jahrhundert auf ungewöhnliche Weise in historisch begründeten, mitunter gruseligen und abenteuerlichen Geschichten.“"
                            }
                        ],
