                        "sense_id": "5fb7f739-6aca-341d-b726-db527a419dc9",
                        "entry_id": "ccd72054-311f-33a3-8a1e-855c1f4f75d3",
                        "glosses": [
                            "große Anbaufläche, auf der Obstpflanzen, -sträucher und/oder -bäume angepflanzt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423a4c81-0e55-48ab-86cf-1d544032c9e5",
                                "sense_id": "5fb7f739-6aca-341d-b726-db527a419dc9",
                                "text": "„Im Frühling zum Beispiel verweile ich gern auf einer der zahlreichen Obstplantagen der Fahnerschen Höhen und lasse mich vom Duft der Blüten betören.“"
                            },
                            {
                                "example_id": "d3cbd775-4c65-4305-a022-124333dd3baa",
                                "sense_id": "5fb7f739-6aca-341d-b726-db527a419dc9",
                                "text": "„Die Tiere fallen über Obstplantagen, Weinberge, Wälder, Grünanlagen und Gärten her und fressen bei mehr als 300 Pflanzenarten alles kahl.“"
                            }
                        ],
