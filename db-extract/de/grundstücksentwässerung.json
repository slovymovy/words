                "senses": [
                    {
                        "sense_id": "75a4f381-608a-392d-8260-c368c528480b",
                        "entry_id": "11111e59-31b0-3070-83d8-250e8f4370a3",
                        "glosses": [
                            "Abwasserkanalsysteme, die Abwässer eines Grundstückes der öffentlichen Kanalisation zuführen; oder auf dem Grundstück speichern bzw. versickern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a7adda4-dd34-4f4d-8ec2-edcfa775d4df",
                                "sense_id": "75a4f381-608a-392d-8260-c368c528480b",
                                "text": "„Die Gütegemeinschaft hat den Zweck, die Umweltverträglichkeit von Abwasseranlagen der Grundstücksentwässerung zu verbessern und damit den Verunreinigungen von Grundwasser, Gewässer und Boden durch undichte Abwasseranlagen entgegenzuwirken.“"
                            },
                            {
                                "example_id": "f0819501-c24a-4455-902f-f6f912ffa09d",
                                "sense_id": "75a4f381-608a-392d-8260-c368c528480b",
                                "text": "„Durch gestiegene Umweltanforderungen in der Grundstücksentwässerung und höhere Sicherheitsansprüche an Infrastrukturleistungen entsteht erheblicher Beratungsbedarf bei privaten Grundstückeigentümern, Kommunen und Industrie und Gewerbe.“"
                            },
                            {
                                "example_id": "2277c442-6849-4319-8f00-64151ffe487a",
                                "sense_id": "75a4f381-608a-392d-8260-c368c528480b",
                                "text": "„Als Grundstücksentwässerung wird die Beseitigung von Abwasser (Schmutz- und Regenwasser) bezeichnet.“"
                            },
                            {
                                "example_id": "ed7578c8-5e26-453a-abfe-4ee4ffd493a4",
                                "sense_id": "75a4f381-608a-392d-8260-c368c528480b",
                                "text": "„Zur Grundstücksentwässerung zählen zusätzlich alle technischen Einrichtungen mit dem Zweck der Schmutz- und Niederschlagswasserableitung in einen öffentlichen Kanal oder eine Kläranlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
