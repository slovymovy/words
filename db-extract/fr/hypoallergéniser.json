                ],
                "senses": [
                    {
                        "sense_id": "e61a23e6-782a-3d5c-98a3-f9f1502973de",
                        "entry_id": "f491bf29-18f8-3f53-9f67-65924ffe51cd",
                        "glosses": [
                            "Rendre hypoallergénique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa223bf-04ca-4207-9b01-a908084f3392",
                                "sense_id": "e61a23e6-782a-3d5c-98a3-f9f1502973de",
                                "text": "Avant d'hypoallergéniser la Tour Eiffel, l'artiste, qui ne créa pas la femme mais presque, s’est amusé à dessiner un peu partout sur le sol de la capitale de grands foetus, comme autant d’enfants nés du plaisir de la ville."
                            },
                            {
                                "example_id": "cc833b8a-8e4a-4670-8680-3bec3ae97a45",
                                "sense_id": "e61a23e6-782a-3d5c-98a3-f9f1502973de",
                                "text": "Je pense aussi que notre hyperhygiénisme connait ses limites : à force de vouloir tout stériliser, javeliser, hypoallergéniser on finit par ne plus permettre à nos enfants de se construire leurs défenses immunitaires pour lutter contre les agressions extérieures."
                            }
                        ]
                    }
                ],
