                "senses": [
                    {
                        "sense_id": "26025f07-ac99-3c28-9504-4b41de737577",
                        "entry_id": "7ac00e91-0190-3326-bf67-313a42eeecd3",
                        "glosses": [
                            "Double, duel, ambigu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ca6562-d3fc-47e5-9a1f-033920689faf",
                                "sense_id": "26025f07-ac99-3c28-9504-4b41de737577",
                                "text": "Эта встреча произвела на меня двойственное впечатление.",
                                "translation": "Cette rencontre m’a laissé une double impression."
                            },
                            {
                                "example_id": "a1826d93-8f30-48d8-b655-fa60acbb3bd6",
                                "sense_id": "26025f07-ac99-3c28-9504-4b41de737577",
                                "text": "Природа человека также двойственна ― он рассматривает мир извне, в том числе с позиций Бога, и изнутри с помощью органов чувств, дополненных приборами.",
                                "translation": "La nature humaine est double : il voit le monde de l’extérieur, y compris du point de vue de Dieu, et de l’intérieur, en utilisant ses sens, complétés par des instruments."
                            }
                        ]
                    }
                ],
