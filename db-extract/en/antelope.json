                                    {
                                        "sense_id": "b3625ce8-7242-306f-ae50-fdc2a84695a3",
                                        "entry_id": "de2a4481-3d73-3457-9368-1394845c5e54",
                                        "glosses": [
                                            "een verzamelnaam voor slanke holhoornige hoefdieren die voornamelijk in Afrika leven"
                                        ],
                                        "tags": [
                                            "evenhoevigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018aa18f-d8f2-4fe0-b8de-21ec740a6e7f",
                                                "sense_id": "b3625ce8-7242-306f-ae50-fdc2a84695a3",
                                                "text": "De antilopen zetten het op een lopen toen zij de luipaard in de gaten kregen."
                                            },
                                            {
                                                "example_id": "aad873c1-6a0b-4f04-8ac2-15c40a96b99b",
                                                "sense_id": "b3625ce8-7242-306f-ae50-fdc2a84695a3",
                                                "text": "En hij genoot van de bevrediging wanneer hij raak schoot, om de vijand spastisch spartelend te zien sterven, op de grond te zien vallen met wild trappende benen, wat alleen zenuwreflexen waren van iemand die al dood was, ongeveer zoals met een schot door de kop van een antilope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "034d2e16-193b-4427-9a11-2fc5c4d6c476",
