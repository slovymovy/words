                        "cross_references": []
                    },
                    {
                        "translation_id": "39b39b9a-2dcb-4113-87db-a84ed90bf40e",
                        "source_entry_id": "7b40bfec-88a3-3e92-bce9-58709eaa09aa",
                        "source_sense_id": "7f7ece80-24f2-3ec5-b977-2acf7f051532",
                        "target_lang_word": "accourir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accourir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cae6fd5-576f-35a5-9e6d-a5e817037d81",
                                        "entry_id": "11cf4400-d8bb-3469-aafc-f7c94ff449ca",
                                        "glosses": [
                                            "Courir, venir promptement en un lieu où quelque chose ou quelqu’un nous attire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97ceb461-1749-4f52-973e-97aca32f8f91",
                                                "sense_id": "3cae6fd5-576f-35a5-9e6d-a5e817037d81",
                                                "text": "Mais quand tout fut fini, les magnats accoururent des quatre coins de la Pologne, en qualité de sauveurs de la patrie. Les sauveurs sont la plaie des révolutions populaires."
                                            },
                                            {
                                                "example_id": "99c861ec-4f79-464e-8408-ea6763d47841",
                                                "sense_id": "3cae6fd5-576f-35a5-9e6d-a5e817037d81",
                                                "text": "De tous les pays circonvoisins, des campagnes et des villes, malades et infirmes, paralytiques, culs-de-jatte et pieds-bots accouraient dans des carrioles, dans des calèches, sur des ânes, sur leurs moignons calleux."
                                            },
                                            {
                                                "example_id": "3a8e4a8a-5f40-469d-81ba-1c0c5ec6fe6c",
                                                "sense_id": "3cae6fd5-576f-35a5-9e6d-a5e817037d81",
                                                "text": "Mais un grand escogriffe en smoking et coiffé d’une casquette à carreaux sortait de la limousine et accourait vers les trois femmes qui l’accueillirent fraîchement."
                                            },
                                            {
                                                "example_id": "49ebaf1d-0843-400b-ba91-a1dfbc8607fc",
                                                "sense_id": "3cae6fd5-576f-35a5-9e6d-a5e817037d81",
                                                "text": "Le bruit, les allées et venues des gens m’alertèrent. J’accourus avec un funèbre pressentiment, sans toutefois penser à un malheur aussi terrible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
