                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spielen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kinder <w>toben</w> jeden Nachmittag fröhlich im Garten."
                        },
                        {
                            "text": "Nach der langen Autofahrt durften die Hunde ausgelassen über die Wiese <w>toben</w>."
                        }
                    ],
                    "synonyms": [
                        "herumtollen",
                        "tollen"
                    ],
                    "antonyms": [
                        "ruhen"
                    ],
                    "common_phrases": [
