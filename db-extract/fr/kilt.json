                        "sense_id": "e16c08e6-7da1-3ccb-a180-1e6d75203c46",
                        "entry_id": "c3caf9da-68ee-32ef-bfbb-8afef9b61462",
                        "glosses": [
                            "Jupe courte fait traditionnellement de pure laine aux motifs colorés d’un tartan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c4d2ce-d266-43e3-9ff9-f78082978fcd",
                                "sense_id": "e16c08e6-7da1-3ccb-a180-1e6d75203c46",
                                "text": "À une certaine époque, les Écossais n’avaient pas le droit de porter le kilt, seulement les pantalons."
                            }
                        ]
                    },
                    {
                        "sense_id": "720b5e97-94c2-305d-bc32-a5eb7afd95fe",
                        "entry_id": "c3caf9da-68ee-32ef-bfbb-8afef9b61462",
                        "glosses": [
                            "Jupe féminine de cette forme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d286036-123c-4cc5-8a6b-d5ce860fd69f",
                                "sense_id": "720b5e97-94c2-305d-bc32-a5eb7afd95fe",
                                "text": "Dans la rue des Grands-Godeaux, nous nous sommes retournées pour faire face à l’objectif, je porte un mini kilt invraisemblable, au retour des vacances nos cheveux sont presque blancs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5412cba4-effd-47fd-933a-369479526ece",
                        "source_entry_id": "c3caf9da-68ee-32ef-bfbb-8afef9b61462",
