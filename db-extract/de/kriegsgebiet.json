                ],
                "senses": [
                    {
                        "sense_id": "fdb715d3-9cf8-33f0-8170-1b432d029b77",
                        "entry_id": "a0613c4c-749a-37a0-9c90-c13e2b1da51b",
                        "glosses": [
                            "Region, in welcher militärische Auseinandersetzungen stattfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a37feed-e7ef-4322-a096-877d890f8157",
                                "sense_id": "fdb715d3-9cf8-33f0-8170-1b432d029b77",
                                "text": "So wie Einige Neubaugebiete eröffnen, so errichten Andere jeden Tag aufs neue Kriegsgebiete, um die eigene Politik, nur eben mit anderen Mitteln, durchzusetzen."
                            },
                            {
                                "example_id": "17810ec7-69e1-4fef-8127-e8dfb9782302",
                                "sense_id": "fdb715d3-9cf8-33f0-8170-1b432d029b77",
                                "text": "„Mit der Errichtung der britischen Fernblockade (auf einer Linie von Shetland bis Norwegen) am 2. November 1914 wurde die Nordsee zum Kriegsgebiet.“"
                            },
                            {
                                "example_id": "0300a5cb-de5c-47b7-bf0d-b78b40c9ddbb",
                                "sense_id": "fdb715d3-9cf8-33f0-8170-1b432d029b77",
                                "text": "„Seitdem lag das von unseren Truppen zurückeroberte Schloß mitten im Kriegsgebiet und war ständig plötzlichen Überfällen mit Maschinengewehrfeuer ausgesetzt.“"
                            },
                            {
                                "example_id": "62cd3f17-6c9f-4186-a909-b1ce9cf864b7",
                                "sense_id": "fdb715d3-9cf8-33f0-8170-1b432d029b77",
                                "text": "„Ich war etwas benommen; die Nachricht, daß Paris ins Kriegsgebiet einbezogen würde, hatte mich sehr erregt.“"
                            },
                            {
                                "example_id": "6f80a1dd-d58f-4000-b94f-6ce1c56ad8d0",
                                "sense_id": "fdb715d3-9cf8-33f0-8170-1b432d029b77",
                                "text": "„Zieht ein Haufen durch ein Kriegsgebiet, kriecht als Tross eine viele Kilometer lange Wagenschlange hinterher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
