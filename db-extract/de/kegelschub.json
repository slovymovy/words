                "senses": [
                    {
                        "sense_id": "be5b3c6d-ee5b-334e-9286-ef529e92cef6",
                        "entry_id": "3451ee48-f0bb-332d-a78f-06a25c15a485",
                        "glosses": [
                            "das Schieben der Kugel beim Kegeln"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0e56834c-4177-4a92-bccd-58d3e50eb6ce",
                                "sense_id": "be5b3c6d-ee5b-334e-9286-ef529e92cef6",
                                "text": "„Dem Bierausschank, so hieß es „war starker Zulauf und dabey Musik und Kegelschub“ beschieden.“"
                            },
                            {
                                "example_id": "bfc25ed8-aa38-43f3-9fcf-3042c8017576",
                                "sense_id": "be5b3c6d-ee5b-334e-9286-ef529e92cef6",
                                "text": "„Die Kinder tummelten sich an der beliebten Kinderkegelbahn und konnten bei einem erfolgreichen Kegelschub ein kleines Geschenk des Vereins entgegennehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c91e3f28-b680-36a6-8376-1765203b74d8",
                        "entry_id": "3451ee48-f0bb-332d-a78f-06a25c15a485",
                        "glosses": [
                            "Raum, in dem gekegelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c046df02-fad6-4d4a-b191-6b1982aa92f8",
                                "sense_id": "c91e3f28-b680-36a6-8376-1765203b74d8",
                                "text": "„Im Kegelschub zogen sie ihre Mäntel aus und die Uniform und die Schuhe an.“"
                            },
                            {
                                "example_id": "fc9f53a3-4c3b-4ab0-a546-77563e973566",
                                "sense_id": "c91e3f28-b680-36a6-8376-1765203b74d8",
                                "text": "„Am 2. Juli 1869 schlich er sich in den Kegelschub, um zu nächtigen, wurde aufgefunden und von der Gendarmerie festgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
