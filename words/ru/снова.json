    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "364dc8f9-f9a7-3407-8b75-9fdcc7fb9056",
                    "sense_definition": "Ещё раз, повторно; возвращаясь к прежнему действию или состоянию.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <снова> встретились в том же парке.",
                            "target_lang_translations": {
                                "en": "We met <again> in the same park.",
                                "zh": "我们<w>又</w>在同一个公园见面了。"
                            }
                        },
                        {
                            "text": "Попробуй прочитать этот текст <снова>.",
                            "target_lang_translations": {
                                "en": "Try reading this text <again>.",
                                "zh": "试着把这篇文章<w>再</w>读一遍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "опять",
                        "вновь",
                        "ещё раз"
                    ],
                    "common_phrases": [
                        "снова и снова",
                        "никогда снова",
                        "начать снова"
                    ],
                    "target_lang_definitions": {
                        "en": "One more time, repeatedly; returning to a previous action or state.",
                        "zh": "再一次，重复地；回到之前的动作或状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "indicating repetition or a return to a previous state"
                            },
                            {
                                "target_lang_word": "once more",
                                "target_lang_sense_clarification": "one additional time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "又",
                                "target_lang_sense_clarification": "表示动作的重复"
                            },
                            {
                                "target_lang_word": "再",
                                "target_lang_sense_clarification": "表示动作的再次发生"
                            },
                            {
                                "target_lang_word": "再一次",
                                "target_lang_sense_clarification": "强调重复一次"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64a343fd-ba07-35c5-a308-fa33c42022ca",
                    "sense_definition": "С самого начала; переделывая сделанное ранее.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "restart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему пришлось переписывать сочинение <снова>.",
                            "target_lang_translations": {
                                "en": "He had to rewrite the essay <all over again>.",
                                "zh": "他不得不<w>重新</w>写那篇作文。"
                            }
                        },
                        {
                            "text": "После переезда жизнь началась <снова>.",
                            "target_lang_translations": {
                                "en": "After the move, life began <anew>.",
                                "zh": "搬家后，生活<w>重新</w>开始了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "заново"
                    ],
                    "common_phrases": [
                        "начать жизнь снова"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "From the very beginning; redoing what was done before.",
                        "zh": "从头开始；重做之前做过的事情。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "over again",
                                "target_lang_sense_clarification": "doing something again from the start"
                            },
                            {
                                "target_lang_word": "anew",
                                "target_lang_sense_clarification": "in a new or different way; from the start (often literary)"
                            },
                            {
                                "target_lang_word": "afresh",
                                "target_lang_sense_clarification": "from a new beginning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重新",
                                "target_lang_sense_clarification": "从头开始做某事"
                            },
                            {
                                "target_lang_word": "从头",
                                "target_lang_sense_clarification": "从最初的起点开始"
                            }
                        ]
                    }
                }
            ]
        },
