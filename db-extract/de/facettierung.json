                "senses": [
                    {
                        "sense_id": "28cf01e3-84f2-3e4e-bd74-48f5e5a44b18",
                        "entry_id": "e0181c5a-e20c-32c1-b2e9-a0782cd9e66b",
                        "glosses": [
                            "Schliff bei dem viele kleine glatte Flächen (Facetten) entstehen"
                        ],
                        "tags": [
                            "Gemmologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7d7930bc-333a-45f2-b71b-6f8fceaaac7b",
                                "sense_id": "28cf01e3-84f2-3e4e-bd74-48f5e5a44b18",
                                "text": "„Die feuerpolierten Glasschliffperlen faszinieren durch ihren herrlichen Glanz und ihre besondere Facettierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39a4a891-3f47-3d85-90f3-4e452d3b5716",
                        "entry_id": "e0181c5a-e20c-32c1-b2e9-a0782cd9e66b",
                        "glosses": [
                            "Anreicherung mit vielen Aspekten (Facetten) einer Sache"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "fd1b28ce-3f4b-464f-9a24-0919976e5d0a",
                                "sense_id": "39a4a891-3f47-3d85-90f3-4e452d3b5716",
                                "text": "„Was die emotionale Wertigkeit der Zeit betrifft, so kennzeichnet sie die Augenblicklichkeit der anthropologischen Erfahrung in Richtung der tausend Facettierungen von Sehnsucht, von Erinnerung an Vergangenes, von Hoffnung auf Zukünftiges, wobei diese Facettierungen in der Gegenwart durch Ängstlichkeit, Langeweile, Scham und Lust hindurchgehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b938a696-c846-335c-8a8a-916f0397d7f4",
                        "entry_id": "e0181c5a-e20c-32c1-b2e9-a0782cd9e66b",
                        "glosses": [
                            "Einsatz von Filtern bei der Suche; Definition von Einschränkungen für Kriterien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285c09ce-dc54-488d-8e18-297ce653d4b7",
                                "sense_id": "b938a696-c846-335c-8a8a-916f0397d7f4",
                                "text": "„Mittels Aspektauswahl (Facettierung) kann weiter eingeschränkt werden.“"
                            },
                            {
                                "example_id": "e6e6e309-2d4d-454d-bec2-76e8df3c898a",
                                "sense_id": "b938a696-c846-335c-8a8a-916f0397d7f4",
                                "text": "„Zu den Basisfunktionen, die jede moderne Onsite-Suche bieten sollte, zählen Type Ahead, eine Rechtschreibkorrektur sowie Filter und Facettierungen.“"
                            }
                        ],
