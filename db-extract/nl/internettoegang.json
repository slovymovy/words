                        "glosses": [
                            "de technische mogelijkheid om het internet te kunnen gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36438d1a-ea7b-47c8-b436-5bde57f02217",
                                "sense_id": "5b25c6a7-6536-358a-b1e6-2bbcf98b97af",
                                "text": "Een klant zou bijvoorbeeld kunnen kiezen voor bellen, sms'en en Spotify, zonder verdere internettoegang. Voor zo'n constructie is in de telecomwet een uitzondering gemaakt."
                            },
                            {
                                "example_id": "1842a582-32eb-4735-a575-b3adcf340e85",
                                "sense_id": "5b25c6a7-6536-358a-b1e6-2bbcf98b97af",
                                "text": "Bill Gates sprak al eerder over projecten die internet beschikbaar moeten maken in ontwikkelingslanden. Hij benadrukt dat internettoegang wel een goed hulpmiddel is, maar niet de eerste manier om zulke landen te helpen: \"Als een kind diarree heeft, zal een website hem niet genezen\"."
                            }
                        ]
