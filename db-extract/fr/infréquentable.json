                "forms": [
                    {
                        "form_id": "f3af43c2-3a11-46cc-a0f4-155f4b28831d",
                        "entry_id": "9ca882e4-2251-3aa0-8ea4-272f98c96207",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
