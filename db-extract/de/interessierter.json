                    },
                    {
                        "form_id": "49f33659-89f4-4fd6-9584-f8e63ae0ca72",
                        "entry_id": "fe94619c-250b-3ba7-bd8b-b27594f8284d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "keine Interessierten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                        "entry_id": "fe94619c-250b-3ba7-bd8b-b27594f8284d",
                        "glosses": [
                            "Person, die sich für etwas Bestimmtes interessiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6f1234-f813-4b65-8060-777d100bd39d",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Das Archiv steht Forschern und Interessierten als Arbeitsort zur Verfügung.“"
                            },
                            {
                                "example_id": "8a5a0074-57a4-4a16-99c7-e648afe7df7f",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Die \"Medienbank\" steht Lehrern, Ausbildern und den sonst an der Berufsbildung Interessierten kostenlos zur Verfügung.“"
                            },
                            {
                                "example_id": "09c14aad-a92b-4079-aabd-922f9f5d5811",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Die Lernsoftware eignet sich für Interessierte, die Deutsch als Fremdsprache erlernen möchten, für logopädisches Arbeiten, für Sprech-Fein-Training sowie für Sprechübungen.“"
                            },
                            {
                                "example_id": "eec6d900-9946-402a-80e7-ad2194db0f04",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Fast 8000 Interessierte – knapp 27 Prozent mehr als im Vorjahr – besuchten die Ausstellung.“"
                            },
                            {
                                "example_id": "f9aadb34-be1b-498b-9944-ee8a6d18cf43",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Unterstützt wird die Initiative durch das Industrie- und Handelsministerium, das Interessierten seine 80 Beratungsstellen zur Verfügung stellt.“"
                            },
                            {
                                "example_id": "d6e22e40-63ef-4f7a-bf31-51b27389a6da",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Diese traurige Erfahrung referierte der Banker vor den zirka 40 Interessierten, die Mitte Juni nach Frankfurt zu dem Seminar ‚Finanzierung von Unternehmen der Informationstechnik und Telekommunikation‘ gefahren waren.“"
                            },
                            {
                                "example_id": "456836c9-3093-42b5-915e-399a6857efcc",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Durch Kontakt mit Kollegen und Konkurrenten könnte der Interessierte wohl zu einem Überblick über die Angebotssituation kommen.“"
                            },
                            {
                                "example_id": "8f79445f-124e-4955-975e-0667a3f91ef8",
                                "sense_id": "cf6d1f5a-9e4d-3e90-ac43-6b8d954039e4",
                                "text": "„Der größte Teil der Leserschaft sind Laien und Interessierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
