{
    "word_family": [
        "due",
        "duty",
        "dutiful",
        "dutifully"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ab10da15-ffd0-3cab-8ba2-5923a9de80dd",
                    "sense_definition": "In a proper, suitable, or correct manner; as is appropriate for the situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriateness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizen's concern was <w>duly</w> noted in the official meeting minutes. ",
                            "target_lang_translations": {
                                "ru": "Опасения гражданина были <w>должным образом</w> отмечены в официальном протоколе собрания."
                            }
                        },
                        {
                            "text": "After the long application process, she was <w>duly</w> appointed to the position.",
                            "target_lang_translations": {
                                "ru": "После долгого процесса подачи заявления она была <w>соответствующим образом</w> назначена на должность."
                            }
                        }
                    ],
                    "synonyms": [
                        "properly",
                        "suitably",
                        "appropriately",
                        "correctly"
                    ],
                    "antonyms": [
                        "improperly",
                        "unsuitably"
                    ],
                    "common_phrases": [
                        "duly noted",
                        "duly signed",
                        "duly authorized"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надлежащим, подходящим или правильным образом; так, как того требует ситуация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "должным образом",
                                "target_lang_sense_clarification": "в соответствии с требованиями или правилами"
                            },
                            {
                                "target_lang_word": "соответствующим образом",
                                "target_lang_sense_clarification": "подходящим для данной ситуации способом"
                            },
                            {
                                "target_lang_word": "правильно",
                                "target_lang_sense_clarification": "верно и так, как следует"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55b9d7fe-1a8d-30c9-a910-da5f4c6b0574",
                    "sense_definition": "At the expected or required time; punctually or according to a schedule.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The annual meeting was <w>duly</w> held on the first Monday of January.",
                            "target_lang_translations": {
                                "ru": "Ежегодное собрание было <w>своевременно</w> проведено в первый понедельник января."
                            }
                        },
                        {
                            "text": "The package <w>duly</w> arrived three days after it was ordered.",
                            "target_lang_translations": {
                                "ru": "Посылка <w>вовремя</w> прибыла через три дня после заказа."
                            }
                        }
                    ],
                    "synonyms": [
                        "punctually",
                        "regularly",
                        "timely"
                    ],
                    "antonyms": [
                        "belatedly",
                        "tardily"
                    ],
                    "common_phrases": [
                        "duly arrived",
                        "duly held"
                    ],
                    "target_lang_definitions": {
                        "ru": "В ожидаемое или требуемое время; пунктуально или в соответствии с графиком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вовремя",
                                "target_lang_sense_clarification": "в установленный срок или в подходящий момент"
                            },
                            {
                                "target_lang_word": "своевременно",
                                "target_lang_sense_clarification": "без опоздания, когда это необходимо"
                            },
                            {
                                "target_lang_word": "в установленном порядке",
                                "target_lang_sense_clarification": "согласно расписанию или процедуре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}