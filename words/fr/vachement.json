                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a réagi <w>vachement</w> en refusant d'aider son collègue en difficulté.",
                            "target_lang_translations": {
                                "en": "She reacted <w>nastily</w> by refusing to help her colleague, who was in trouble.",
