                "senses": [
                    {
                        "sense_id": "4ddc0928-0d81-3aca-b3d6-69a7f8fbce3a",
                        "entry_id": "3ed9874d-3dcb-397b-adc9-66289e8c1674",
                        "glosses": [
                            "Zweigstelle einer Bank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a546110-0ac0-45a5-80f7-880fe99dc953",
                                "sense_id": "4ddc0928-0d81-3aca-b3d6-69a7f8fbce3a",
                                "text": "Die Bank hat im letzten Jahr zwanzig neue Bankfilialen eröffnen."
                            },
                            {
                                "example_id": "cec3e309-fc31-4288-b46b-2605629db4ae",
                                "sense_id": "4ddc0928-0d81-3aca-b3d6-69a7f8fbce3a",
                                "text": "„'Die Schwelle zur Gewalt sinkt' Wirtschaftskrise 'Die Schwelle zur Gewalt sinkt' Jobverlust und Abstiegsangst: Die Wirtschaftskrise wird neue Verteilungskämpfe hervorbringen, sagt der Soziologe Klaus Dörre - und warnt vor gewaltsamen Protesten ZEIT ONLINE: Herr Dörre, in Frankreich nehmen aufgebrachte Arbeitnehmer ihre Manager in Geiselhaft, in Großbritannien fliegen Steine in Bankfilialen. In Deutschland ist es so ruhig, dass der Berliner Korrespondent der New York Times, Roger Cohen, unlängst gar von der\" German Lässigkeit sprach.“"
                            },
                            {
                                "example_id": "f369db45-e8c9-4189-b3fe-03ce70dabd1c",
                                "sense_id": "4ddc0928-0d81-3aca-b3d6-69a7f8fbce3a",
                                "text": "„Ein 34 Jahre alter Fondsmanager namens Stefan, der für eine Bankfiliale in Charlottenburg arbeitet, hat 40 Prozent an dem Promi-Tanztempel privat erworben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
