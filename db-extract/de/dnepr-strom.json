                ],
                "senses": [
                    {
                        "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                        "entry_id": "e5de5574-7d53-391f-826b-616529d5ba19",
                        "glosses": [
                            "großer Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25df360d-c54a-44b7-bb28-9dfe5c28a5e3",
                                "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                                "text": "„Vor dem Präsidentensitz in Kiew, dort, wo die Straße vom Maidan hinaufsteigt zum Steilufer über dem Dnepr-Strom, demonstrieren Dutzende Menschen.“"
                            },
                            {
                                "example_id": "b0c9920a-8ca3-497f-8aa0-3deea71cb9a4",
                                "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                                "text": "„Man fährt auf Straßen durch die Wälder östlich der Stadt, und plötzlich erreicht man den Dnepr-Strom.“"
                            },
                            {
                                "example_id": "97aa1fae-eec3-4691-a7ee-74f272ed1750",
                                "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                                "text": "„Reisende des 18. und 19. Jahrhunderts, die die Gebiete um den Dnepr-Strom besuchten, geben ihrer Begeisterung über den ungewöhnlichen Reiz der Landschaft und die dem Menschen günstige Ressourcensituation deutlichen Ausdruck.“"
                            },
                            {
                                "example_id": "08c54c56-d4e9-4038-8888-1479577e9799",
                                "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                                "text": "„Drei von ihnen (Neman-, Minsk- und Dnepr-Strom), die in Litauen und Beloruhland lagen, wurden aus der baltisch-nordschwedischen bzw. finnischen Nährprovinz gespeist.“"
                            },
                            {
                                "example_id": "9f8f331a-c2ce-4133-9160-6a2d4d2fb94d",
                                "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                                "text": "„Der von Norden nach Süden fließende Dnepr-Strom trennt diese Region von den flachen Ebenen im Osten.“"
                            },
                            {
                                "example_id": "ad2f9f95-9b15-4f97-a4eb-1eafbe5e5296",
                                "sense_id": "87937a98-8788-39db-8800-27b097fabb0f",
                                "text": "„Ganz besonders bedeutend ist aber der Vorstoß von der Krim im Süden, der doch schon große Geländegewinne gebracht hat und zum Teil über den Dnepr-Strom gegangen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
