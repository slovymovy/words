                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "490a6834-6bc4-45d6-abb4-b29f4ec9f112",
                        "entry_id": "71b4787c-39f9-35d0-83bc-abcc69af55c4",
                        "tags": [
