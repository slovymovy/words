    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "de292aad-6060-32c1-93de-2317ec7d56ef",
                "word": "scintillating",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3d377128-ef32-4c73-b794-071cd5490473",
                        "entry_id": "de292aad-6060-32c1-93de-2317ec7d56ef",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more scintillating"
                    },
                    {
                        "form_id": "455b521e-1df7-4f94-b1b9-09cac35ce53e",
                        "entry_id": "de292aad-6060-32c1-93de-2317ec7d56ef",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most scintillating"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a50b7197-51dd-34d2-8e60-d6c18c82edff",
                        "entry_id": "de292aad-6060-32c1-93de-2317ec7d56ef",
                        "glosses": [
                            "That scintillates with brief flashes of light; sparkling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77445d3c-06f0-4492-b769-48bb6c2f2915",
                                "sense_id": "a50b7197-51dd-34d2-8e60-d6c18c82edff",
                                "text": "On the scintillating water yellow and blue boats bobbed up and down."
                            },
                            {
                                "example_id": "b7537134-ef80-4522-926b-931bdda31b83",
                                "sense_id": "a50b7197-51dd-34d2-8e60-d6c18c82edff",
                                "text": "They sank me into the ocean / Wishing me to remain in the depths. / I became a deep sea diver / And came up covered with scintillating pearls."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                        "entry_id": "de292aad-6060-32c1-93de-2317ec7d56ef",
                        "glosses": [
                            "Brilliantly or impressively clever, exciting, amusing or witty."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d3a00dba-146c-4bec-9d83-a29b920947f5",
                                "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                                "text": "Her sketches and tales may be said to be cleverly written. They are lively, easy, conventional, scintillating with a species of sarcastic wit, which might be termed good were it in any respect original."
                            },
                            {
                                "example_id": "749053c4-fd13-4561-901c-1d2ca0aa1ea4",
                                "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                            },
                            {
                                "example_id": "8b752c16-ca11-4b3f-a6a5-3a3c5937d077",
                                "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                                "text": "For the last thirteen months, Beatles cofounder John Lennon has been Liverpool's darling. He can do no wrong. His group's music is scintillating. His public demeanor has been exemplary. He is a credit to our city, to rock 'n' roll musicians, and to the undead."
                            },
                            {
                                "example_id": "57d187fe-286c-4d7f-a230-ff22a4f70346",
                                "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                                "text": "The hosts maintained their discipline and shape, even threatening to grab a second goal on the break – left-back Dan Harding made a scintillating run, skipping past a few challenges before prodding a right-footed shot that did not match his build-up."
                            },
                            {
                                "example_id": "2aca8327-81e4-4ede-a9cd-55c68c344f31",
                                "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                                "text": "A scintillating example of where the cultural politics of iconoclasm and of representation coincide, in the Hellenistic world, is offered by an inscription of the fourth century BCE from Delphi."
                            },
                            {
                                "example_id": "650da540-1c3a-4a64-b402-ad2f532b076a",
                                "sense_id": "ebfdc8c8-2937-3b41-ba7e-0b3ea1dbc36a",
                                "text": "Lots of people are looking for something scintillating and new and not finding it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c1ac323-59d9-42da-b48b-23bfb2aaa369",
                        "source_entry_id": "de292aad-6060-32c1-93de-2317ec7d56ef",
                        "source_sense_description": "sparkling",
                        "target_lang_word": "искря́щийся",
