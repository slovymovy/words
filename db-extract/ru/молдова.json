                                                "example_id": "82a2c396-9841-4a59-92c6-55d532c0e859",
                                                "sense_id": "c0047f0e-a8c3-3dac-8089-fab96cb162ba",
                                                "text": "Jassenmarkt lag in der Moldau."
                                            },
                                            {
                                                "example_id": "6e57953f-413a-43a2-8087-16e3917e7c4e",
                                                "sense_id": "c0047f0e-a8c3-3dac-8089-fab96cb162ba",
                                                "text": "Wir überquerten die Moldau."
                                            },
                                            {
                                                "example_id": "02eb59aa-f625-44f1-9e0e-8fca351d4d5b",
                                                "sense_id": "c0047f0e-a8c3-3dac-8089-fab96cb162ba",
                                                "text": "Die rumänische Stadt Roman liegt an der Moldau."
