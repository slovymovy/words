                    "sense_definition": "zichzelf of iets anders bevrijden van morele schuld, zonde of spirituele onzuiverheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spirituele zuivering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde zijn ziel te <w>reinigen</w> door een lange pelgrimstocht naar het zuiden te maken.",
                            "target_lang_translations": {
                                "en": "He tried to <w>purify</w> his soul by making a long pilgrimage to the south."
                            }
                        },
                        {
                            "text": "In veel religies gebruikt men water om de geest symbolisch te <w>reinigen</w> van alle zonden.",
                            "target_lang_translations": {
                                "en": "In many religions, water is used to symbolically <w>cleanse</w> the spirit of all sins."
                            }
                        }
                    ],
                    "synonyms": [
                        "opschonen",
                        "schonen",
                        "schoonmaken"
                    ],
                    "common_phrases": [
                        "de ziel reinigen",
                        "van zonden reinigen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in religieuze of literaire context"
                        }
                    ],
                    "target_lang_definitions": {
