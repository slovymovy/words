                        ],
                        "examples": [
                            {
                                "example_id": "446b97d3-8854-4fb0-8a7b-b6c5896435ce",
                                "sense_id": "03ddc3bb-ca8d-31ad-a2c3-05140c8e24ea",
                                "text": "De zinnen zijn nooit lang of ingewikkeld, vaak ongeleed."
