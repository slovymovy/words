                                "target_senses": [
                                    {
                                        "sense_id": "f43b614a-1c51-30d4-baaa-e4460759748d",
                                        "entry_id": "de8d1676-7965-32a1-b9f0-7438da87c5d7",
                                        "glosses": [
                                            "den Feudalismus, das Lehenswesen des Mittelalters betreffend, bei dem ein Lehnsherr Land als Lehen an Vasallen vergab im Austausch gegen Dienste, vor allem Kriegsdienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e6a4868-75b1-4063-aee2-0f93279077ff",
                                                "sense_id": "f43b614a-1c51-30d4-baaa-e4460759748d",
                                                "text": "Die feudale Gesellschaft war eine Ständegesellschaft und streng hierarchisch aufgebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24f2fa3a-b61d-398b-914e-a9fd0f39753e",
                                        "entry_id": "de8d1676-7965-32a1-b9f0-7438da87c5d7",
                                        "glosses": [
                                            "unter sehr guten (finanziellen) Bedingungen existierend; reich, luxuriös seiend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4630e54a-f9c0-4001-9418-30066ff8669b",
                                                "sense_id": "24f2fa3a-b61d-398b-914e-a9fd0f39753e",
                                                "text": "Er ist einer der reichsten Männer der Stadt und besitzt das feudalste Haus, das man sich nur vorstellen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "04695e9e-dc41-3e4c-8326-559a6fb39970",
                                        "entry_id": "de8d1676-7965-32a1-b9f0-7438da87c5d7",
                                        "glosses": [
                                            "von aristokratischen Kreisen beeinflusst und/oder darin lebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0232b4b1-20c0-427e-a19a-e7320a6c1557",
                                                "sense_id": "04695e9e-dc41-3e4c-8326-559a6fb39970",
                                                "text": "Unser König pflegt eine sehr feudale Ausdrucksweise."
                                            },
                                            {
                                                "example_id": "babfc957-ad2a-4920-886c-a8f3208f14f6",
                                                "sense_id": "04695e9e-dc41-3e4c-8326-559a6fb39970",
                                                "text": "„Nichts an ihm [dem Kanzleramt] erinnert an die traditionelle feudale und bürgerliche Architektur des 18. und 19. Jahrhunderts oder an die rühmlichen Architekturleistungen der Weimarer Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3f323905-86c0-3d34-942a-0389a1720f13",
                                        "entry_id": "de8d1676-7965-32a1-b9f0-7438da87c5d7",
                                        "glosses": [
                                            "veralteten politischen Ansichten verhaftet, reaktionär"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b449c4-a277-4975-9e57-29f158aac127",
                                                "sense_id": "3f323905-86c0-3d34-942a-0389a1720f13",
                                                "text": "„Der Fehler war: Peking setzte seine Einkind-Politik in einer Gesellschaft mit tief verankerten feudalen Ansichten durch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
