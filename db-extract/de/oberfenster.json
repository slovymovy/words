                ],
                "senses": [
                    {
                        "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                        "entry_id": "e3d925aa-be2e-3ff8-a3e1-4ebba333b479",
                        "glosses": [
                            "Fenster im oberen Bereich eines Raumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0362ee1-5355-4df9-96b2-59ae0cec5249",
                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                "text": "„Durch das gekippte Oberfenster drang der Verkehrslärm der Leipziger Straße herein.“"
                            },
                            {
                                "example_id": "9c948d1e-e5d2-4310-b8b3-f4fb3f19d6d2",
                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                "text": "„Phasenweise waren die Diskussionen über das Oberfenster und den Notausgang das alles beherrschende Thema in der Kita.“"
                            },
                            {
                                "example_id": "52faf7c2-94f3-4102-9333-d957a18aa083",
                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                "text": "„Eine dort angestellte Schwester erlitt beim Schließen eines Unterfensters dadurch einen Körperschaden, daß dabei das nur von 4 Riegeln festgehaltene Oberfenster auf ihren Kopf stürzte.“"
                            },
                            {
                                "example_id": "4468aed9-7598-47d0-999f-9479d2c4d7e8",
                                "sense_id": "a49a15ab-cacf-3a07-9774-b932535a74e0",
                                "text": "„Der Raum zwischen den Oberfenstern und den Scheidbögen der Schiffarkaden wird durch ein Triforium mit geschlossener Rückwand ausgefüllt; das Stabwerk des Triforiums ist Fortsetzung des Fensterstabwerkes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
