                                        "sense_id": "7f6fe72a-887b-3990-a89f-9058384ae53c",
                                        "entry_id": "085fa4f9-87cc-308d-9a78-01f558040771",
                                        "glosses": [
                                            "Voie publique sur laquelle la circulation des bicyclettes est prioritaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910e1fd3-3161-48c0-ba6b-eafe38a9a897",
                                                "sense_id": "7f6fe72a-887b-3990-a89f-9058384ae53c",
                                                "text": "« vélorue » : tout ou partie d’un chemin public sur lequel la circulation des cyclistes est favorisée."
                                            },
                                            {
                                                "example_id": "0769bdac-b78d-47f6-bfd2-248a5426eba3",
                                                "sense_id": "7f6fe72a-887b-3990-a89f-9058384ae53c",
                                                "text": "Attention, une \"vélorue\" ne signifie pas que la rue est exclusivement réservée aux cyclistes. Cela signifie que lorsqu’un véhicule se trouve derrière un cycliste, il doit rester patient et ne pas le dépasser."
                                            }
                                        ]
                                    }
