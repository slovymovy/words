                        ],
                        "examples": [
                            {
                                "example_id": "62676593-0501-4187-b5e3-2b2dfbf7c287",
                                "sense_id": "a0992410-13a5-3bca-b54a-ac44f6ff1d2f",
                                "text": "Laisser reposer. En refroidissant, le liquide va se gélatiner."
                            }
                        ]
