                "senses": [
                    {
                        "sense_id": "9d786bca-01a6-3902-97ab-ba461bdfe514",
                        "entry_id": "855c9b4a-e0c8-3cca-9031-eca5111c178b",
                        "glosses": [
                            "прич. от наносить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "15bb97a4-c6dc-4564-8c65-90e63f096a20",
                                "sense_id": "9d786bca-01a6-3902-97ab-ba461bdfe514",
                                "text": "Курган наношенный весь, ни то что природный, а весь наношенный, будто бы казны много."
                            },
                            {
                                "example_id": "b0697ba9-65c2-4993-8f2d-5fbd4a48d553",
                                "sense_id": "9d786bca-01a6-3902-97ab-ba461bdfe514",
                                "text": "Осенній же запасъ остальныхъ продуктовъ, съ осени наношенный отъ «радѣльцевъ» и изъ ближнихъ скитовъ, приходилъ къ концу, и вскорѣ предстояла необходимость кому нибудь идти «по милостыню»."
                            }
                        ]
                    }
                ],
