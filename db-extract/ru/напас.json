                "senses": [
                    {
                        "sense_id": "830073a5-b9f1-3527-af52-75fc8b3973bd",
                        "entry_id": "12938c3d-d16e-3c11-b586-6a2260987d96",
                        "glosses": [
                            "dose, pull, shot (of a psychoactive substance)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "118d8844-698f-43a0-bcbe-b92c799c2d8a",
                                "sense_id": "830073a5-b9f1-3527-af52-75fc8b3973bd",
                                "text": "На обра́тной доро́ге кури́ли, молча́ли\nИ де́лая очередно́й напа́с ка́ждый из нас\nВруба́лся, что жизнь и по вку́су и на вид\nНапомина́ет shit и сла́ще не бу́дет",
                                "translation": "On the way we smoked and kept still\nAnd with everyone pulling a shot\nI grasped that life is according to taste and species\nIt reminds shit and sweeter it won’t be",
                                "english": "On the way we smoked and kept still\nAnd with everyone pulling a shot\nI grasped that life is according to taste and species\nIt reminds shit and sweeter it won’t be"
                            }
                        ]
                    }
