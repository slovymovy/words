                "senses": [
                    {
                        "sense_id": "c06f0226-9c41-34f6-a271-c56b7769cd83",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "несколько лошадей, собак, оленей и т. п., запряжённых вместе одной упряжью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85359835-bcfa-46d3-ab3f-b163418eafea",
                                "sense_id": "c06f0226-9c41-34f6-a271-c56b7769cd83",
                                "text": "Упряжка вороных."
                            },
                            {
                                "example_id": "502b5252-7661-4b3f-bb2c-4d24658d651b",
                                "sense_id": "c06f0226-9c41-34f6-a271-c56b7769cd83",
                                "text": "Шестерик в упряжке."
                            }
                        ]
                    },
                    {
                        "sense_id": "29fe33d5-143f-3a44-a832-2f36abe5da9c",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "разг. действие по значению гл. упрягать, упрячь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f2f54da-f1b7-477f-a7f5-5ab8a28633ba",
                                "sense_id": "29fe33d5-143f-3a44-a832-2f36abe5da9c",
                                "text": "Закончить упряжку лошадей."
                            },
                            {
                                "example_id": "9368f53a-6a6c-4058-badf-144900ba8055",
                                "sense_id": "29fe33d5-143f-3a44-a832-2f36abe5da9c",
                                "text": "Заниматься упряжкой собак."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f2a2cb5-7522-3655-90b4-e800efb66b4d",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "то же, что упряжь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e923d35-ad5e-4ebc-b746-4836ef668685",
                                "sense_id": "2f2a2cb5-7522-3655-90b4-e800efb66b4d",
                                "text": "Богатая упряжка."
                            },
                            {
                                "example_id": "20c96caf-d5da-4c1d-8192-155444e33c43",
                                "sense_id": "2f2a2cb5-7522-3655-90b4-e800efb66b4d",
                                "text": "Годиться в упряжку."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b4c973d-9bd5-370c-9b8f-7141ab816163",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "рег. запряжённая повозка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb2c0fe-32b7-41d7-8e0a-b417cc0e4ba4",
                                "sense_id": "4b4c973d-9bd5-370c-9b8f-7141ab816163",
                                "text": "Обоз в десять упряжек."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea81a630-3204-3db4-8239-56f21fd292bd",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "рег. расстояние, которое проезжают, не кормя и не меняя лошадей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f46c26-a908-40ed-8270-e126c568ef74",
                                "sense_id": "ea81a630-3204-3db4-8239-56f21fd292bd",
                                "text": "Мы в город ездили в одну, в две упряжки."
                            }
                        ]
                    },
                    {
                        "sense_id": "d85c0ef7-518c-34ff-9fd5-fa34f6ceec32",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "рег., с.-х. пространство, вспахиваемое на одной и той же лошади без дачи ей корму; время, в течение которого лошадь без корма может работать на пахоте"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6b2e9243-879b-300b-9f09-ca135154aa5f",
                        "entry_id": "0803ac5a-eadb-3062-b9bb-757886765813",
                        "glosses": [
                            "горн. группа горнорабочих, работающих на одном объекте в данной смене"
                        ],
                        "tags": [],
                        "examples": []
                    }
