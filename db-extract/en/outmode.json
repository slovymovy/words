                "senses": [
                    {
                        "sense_id": "6a57d074-e33b-34ac-8080-35ac0065e3c9",
                        "entry_id": "8d00f9bc-74eb-3cf6-90e8-5f879a1edde6",
                        "glosses": [
                            "To render (something) no longer fashionable."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1215e07a-47ce-4a62-a05e-a24975a98795",
                                "sense_id": "6a57d074-e33b-34ac-8080-35ac0065e3c9",
                                "text": "Thus, in this age of ideological convergence and the outmoding of rigid doctrine, a new pragmatic [relationship] of immense importance seems to be developing here."
                            },
                            {
                                "example_id": "fa72b826-57b7-4604-bc16-8fbd11d42371",
                                "sense_id": "6a57d074-e33b-34ac-8080-35ac0065e3c9",
                                "text": "Every aspect of Renaissance realism seemed calculated to outmode the medieval illuminators' pictorial vocabulary with its miniature dimensions - two-dimensional patterning and conventionalizations of natural forms."
                            },
                            {
                                "example_id": "ed46a849-689c-4d38-bd6a-838f3ef0fc9c",
                                "sense_id": "6a57d074-e33b-34ac-8080-35ac0065e3c9",
                                "text": "This implies a difference in living in the country versus the city in the Robots universe. At the hardware store, upon receiving the news that Fender is outmoded and destined for the Chop Shop, after initially agreeing with Piper, Casey immediately asks what they can get for him."
                            }
                        ]
                    }
