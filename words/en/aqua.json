                            }
                        },
                        {
                            "text": "The tropical ocean was a bright <w>aqua</w> color under the sun.",
                            "target_lang_translations": {
                                "ru": "Тропический океан на солнце был ярко-<w>бирюзового</w> цвета."
                            }
                        }
                    ],
                    "synonyms": [
                        "aquamarine"
                    ],
                    "common_phrases": [
