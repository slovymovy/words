                "senses": [
                    {
                        "sense_id": "1553688d-0114-3e49-b725-f8c40574451a",
                        "entry_id": "ffddb859-9b70-3a24-8026-a06f47eec0c2",
                        "glosses": [
                            "Manteau de laine qui se porte dans les pays du Maghreb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a83517-b5e1-471f-bd6e-67f0febe758b",
                                "sense_id": "1553688d-0114-3e49-b725-f8c40574451a",
                                "text": "[…] un fin haïk blanc, majestueusement drapé sur la personne de quelque fonctionnaire maure, détonne presque autant que les fraîches toilettes des dames de la colonie européenne ou l’équipement des touristes cockneys qui envahissent la ville à l’arrivée du steamer de Londres : […]."
                            },
                            {
                                "example_id": "07ce00dc-8a8d-4318-a8f1-7996853daba1",
                                "sense_id": "1553688d-0114-3e49-b725-f8c40574451a",
                                "text": "Dans l’enfance coloniale en Algérie, je voyais les femmes en voile blanc, le haïk, léger, gracieux et leurs gestes pour le maintenir contre le vent ou la main d’un enfant qui tirait le coin de l’étoffe, et ça glissait. Je n’ai jamais pensé, les voyant, à des fantômes et que leur voile ressemblait à un linceul, comme le racontait la littérature coloniale."
                            },
                            {
                                "example_id": "70c8a1fe-2ce8-435c-a42a-4beb36a8889c",
                                "sense_id": "1553688d-0114-3e49-b725-f8c40574451a",
                                "text": "J’ai tiré M’ma par son haïk, elle ne l’a pas vue."
                            }
                        ]
                    }
                ],
