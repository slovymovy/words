    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                "word": "imprudence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "84d007c3-d5ed-490f-965e-cd9533d73b6a",
                        "entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                        "tags": [
                            "plural"
                        ],
                        "form": "imprudences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "319fad84-5a6a-3653-a166-9869afb49a27",
                        "entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                        "glosses": [
                            "The quality or state of being imprudent; lack of prudence, caution, discretion or circumspection."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e07e4510-85a9-4a6b-ac38-d8da7a56ef78",
                                "sense_id": "319fad84-5a6a-3653-a166-9869afb49a27",
                                "text": "[Hamilton were to have said:] nothing but a permanent body can check the imprudence of democracy."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                        "entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                        "glosses": [
                            "An imprudent act."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1ec62516-4bd2-4e86-8f74-f7a2da31b43d",
                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                "text": "Ah: my dear—Madam there is the great mistake—'tis this very conscious Innocence that is of the greatest Prejudice to you—what is it makes you negligent of Forms and careless of the world's opinion—why the consciousness of your Innocence—what makes you thoughtless in your Conduct and apt to run into a thousand little imprudences—"
                            },
                            {
                                "example_id": "737aff09-ec76-4142-b0f0-763d969caebe",
                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                "text": "At about the age of twenty-three, to crown his other imprudences, he married, without improving his reduced circumstances thereby."
                            },
                            {
                                "example_id": "5f86fecc-c27a-47d1-a860-0e39e226aeef",
                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                "text": "Yes, for six months he threw all his medicines in the fire, and designedly committed all sorts of imprudences."
                            },
                            {
                                "example_id": "31956025-e103-4ef4-9686-45211afa3155",
                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                "text": "This man finally fell a victim to his diplomacies, perhaps also to his imprudences."
                            },
                            {
                                "example_id": "9369938f-25a2-4396-abcb-e9119e76a255",
                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                "text": "He [Timothy Forsyte] had never committed the imprudence of marrying or encumbering himself in any way with children."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f3e3945-6e08-499e-add8-3d5159ab52a4",
                        "source_entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                        "source_sense_description": "quality or state of being imprudent",
                        "target_lang_word": "Leichtsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichtsinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                        "entry_id": "8e4a3488-b732-384a-af21-c6ccec03346d",
                                        "glosses": [
                                            "Mangel an Vorsicht und Überlegung beim Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f6d732-d8a4-41dc-8a85-3eddf4d357c7",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "Wahrscheinlich war es tödlicher Leichtsinn beim Überholen, der am Sonntagabend einen 31-jährigen Heidelberger das Leben kostete."
                                            },
                                            {
                                                "example_id": "ea07347b-1659-43e5-bb70-b26b7a74cb37",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "Der Leichtsinn ist ein Schwimmgürtel für den Strom des Lebens. (Ludwig Börne)"
                                            },
                                            {
                                                "example_id": "e9b0731e-088c-4926-ab54-ecca946a64eb",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Bei mir war es Leichtsinn und das wohlige Gefühl, meinem Körper etwas Gutes getan und somit etwas Nützliches geleistet zu haben.“"
                                            },
                                            {
                                                "example_id": "ce027ee3-2ad3-421c-97fe-b122506baa94",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Es ist weniger Galgenhumor als Leichtsinn und vielleicht Unkenntnis der Sachlage.“"
                                            },
                                            {
                                                "example_id": "8715f2b0-f4ec-4397-8ae2-27b93dee9d72",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Man möge mich nicht des Leichtsinns im Studium meines Tagebuches beschuldigen, mit Gewissenhaftigkeit entziffere ich die dunklen Stellen und freue mich wie jeder andere Gelehrte, wenn ich das Richtige herausfinde.“"
                                            },
                                            {
                                                "example_id": "eab4ad4e-7158-4fd0-ae27-2068f96a02d7",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56147722-bf85-46d0-86ae-e1a920458525",
                        "source_entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                        "source_sense_description": "quality or state of being imprudent",
                        "target_lang_word": "Nachlässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachlässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                        "entry_id": "2e38d0bf-628c-3271-a3b9-39eeedf6ca37",
                                        "glosses": [
                                            "kritisierbares Handeln, das darin besteht, dass etwas nicht in der an sich erforderlichen Weise getan wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a2f0a0-58d5-4c91-bdbf-90afe75fcb6f",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Es wäre eine Nachlässigkeit von mir, den Hügel nicht zu erwähnen, der sich auf der Grenze zwischen dem Moorgelände und der Hauswiese befindet.“"
                                            },
                                            {
                                                "example_id": "3e20e9f0-c18e-4bf6-bb4d-350307f8b930",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Evolutionsbiologen erläutern diese Nachlässigkeit der Natur gerne mit dem Beispiel unserer Autos.“"
                                            },
                                            {
                                                "example_id": "589906a1-7b40-4b2a-8277-bf2e08dfd7d7",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Elaine fragt sich, ob eine derartige Nachlässigkeit in der Zeichensetzung ein Hinweis auf ein fehlendes emotionales Interesse an ihrem Leben sein könnte (obwohl sie ihrem Freund davon nichts erzählt.“"
                                            },
                                            {
                                                "example_id": "b5bfa3b5-53bb-4d26-a476-82b2de56b806",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Germaine war nicht fortgegangen, und Gorju kam ab und zu, um den Garten umzugraben; denn aus Nachlässigkeit, aus Gleichgültigkeit gegen die materiellen Dinge hatten sie nachgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
