{
    "word_family": [
        "astutely",
        "astuteness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9dbddd9f-0442-32dd-a891-6809906a04ae",
                    "sense_definition": "Having or showing an ability to accurately assess situations or people and turn this to one's advantage; shrewd, clever, or crafty.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shrewdness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>astute</w> observation during the meeting helped the team avoid a major financial mistake.",
                            "target_lang_translations": {
                                "ru": "Ее <w>проницательное</w> замечание во время встречи помогло команде избежать серьезной финансовой ошибки."
                            }
                        },
                        {
                            "text": "The best headteachers are cool-headed, <w>astute</w> decision-makers who trust their colleagues.",
                            "target_lang_translations": {
                                "ru": "Лучшие директора школ — это хладнокровные, <w>проницательные</w> руководители, которые доверяют своим коллегам."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrewd",
                        "crafty",
                        "wily",
                        "knowing"
                    ],
                    "antonyms": [
                        "foolish",
                        "naive"
                    ],
                    "common_phrases": [
                        "astute observation",
                        "astute decision-makers",
                        "astute analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью точно оценивать ситуацию или людей и использовать это в своих интересах; проницательный, хитрый или сообразительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проницательный",
                                "target_lang_sense_clarification": "способный понимать суть вещей и людей"
                            },
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "умеющий извлекать выгоду, расчетливый"
                            },
                            {
                                "target_lang_word": "сообразительный",
                                "target_lang_sense_clarification": "быстро находящий решение в ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "511f9877-433b-3627-9477-662df07dc976",
                    "sense_definition": "Quickly and critically discerning; mentally sharp and penetrating.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shrewdness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made an <w>astute</w> remark about the political climate that left everyone in the room thinking.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>проницательное</w> замечание о политическом климате, которое заставило задуматься всех присутствующих в комнате."
                            }
                        },
                        {
                            "text": "With an <w>astute</w> mind, she quickly identified the logical flaws in his argument.",
                            "target_lang_translations": {
                                "ru": "Благодаря своему <w>острому</w> уму она быстро выявила логические ошибки в его аргументации."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrewd",
                        "knowing"
                    ],
                    "antonyms": [
                        "obtuse"
                    ],
                    "common_phrases": [
                        "astute remark",
                        "astute mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и критически воспринимающий; обладающий острым и проницательным умом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проницательный",
                                "target_lang_sense_clarification": "острый, глубокий (о замечании, уме)"
                            },
                            {
                                "target_lang_word": "сообразительный",
                                "target_lang_sense_clarification": "быстро схватывающий суть"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о разуме, уме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}