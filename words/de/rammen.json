                    "semantic_group_id": "hineintreiben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bauarbeiter <w>rammten</w> schwere Holzpfähle tief in den feuchten Boden."
                        },
                        {
                            "text": "Um das Zelt gegen den Sturm zu sichern, <w>rammte</w> er die Heringe fest in die Erde."
