                        "glosses": [
                            "Celui qui échenille les arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475aa377-7214-43f8-b791-5a5ba4eb3ad0",
                                "sense_id": "7505bf7b-99dd-3b31-b8d0-26532f739805",
                                "text": "Il s’adjoignit donc un sarcleur, un bineur, un arroseur, un émondeur, un astiqueur, un épileur, un échenilleur et quelques garçons fruitiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d1d2841-806e-37f1-afbe-987a67a8e83c",
                        "entry_id": "931e1fbb-9df3-35fa-a7f2-182d4e091a2f",
                        "glosses": [
                            "Genre d’oiseaux de la famille des campéphagidés qui détruisent les chenilles, quelques-unes des 48 espèces:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3791b9-333e-4202-aebf-b17f2d19fd25",
                                "sense_id": "7d1d2841-806e-37f1-afbe-987a67a8e83c",
                                "text": "L’échenilleur à masque noir (Coracina novæhollandiae)"
                            },
                            {
                                "example_id": "c0110a15-6a84-4966-8f4b-6010379fe52b",
                                "sense_id": "7d1d2841-806e-37f1-afbe-987a67a8e83c",
                                "text": "L’échenilleur d'Abbott (Coracina abbotti)"
                            },
                            {
                                "example_id": "c03c94e6-5e89-4732-b48b-ec04b197b560",
                                "sense_id": "7d1d2841-806e-37f1-afbe-987a67a8e83c",
                                "text": "L’échenilleur de Maurice (Coracina typica) ou campéphage de Maurice, est localement appelé merle cuisinier."
                            },
                            {
                                "example_id": "c6e6f89f-de6c-4e6d-b2ee-e20bb1a95098",
                                "sense_id": "7d1d2841-806e-37f1-afbe-987a67a8e83c",
                                "text": "L’échenilleur de Sumba (Coracina dohertyi) se rencontre dans les îles de la Sonde."
                            },
                            {
                                "example_id": "add34915-f23a-4e71-b30d-958fbd8aaeda",
                                "sense_id": "7d1d2841-806e-37f1-afbe-987a67a8e83c",
                                "text": "L’échenilleur de la Réunion, autre espèce endémique, n’est guère mieux loti."
                            }
                        ]
