                                                "sense_id": "9e5ec135-fd83-3f9f-a0a2-c4edafc34128",
                                                "text": "The wood was sparkling in the bonfire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3be891e-9775-3740-9545-c43359d219f3",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To shine as if throwing off sparks; to emit flashes of light; to scintillate; to twinkle"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19f782f-ebf1-4f2a-8191-f48e46425ca3",
                                                "sense_id": "c3be891e-9775-3740-9545-c43359d219f3",
                                                "text": "The stars sparkle in the sky."
                                            },
                                            {
                                                "example_id": "3c635fa1-0bb0-4900-be7a-8d109ea180f3",
                                                "sense_id": "c3be891e-9775-3740-9545-c43359d219f3",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3ac934-5cab-3f4a-81bc-13d1120390a7",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To manifest itself by, or as if by, emitting sparks; to glisten; to flash."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68e46024-2196-46a1-abab-7a5737cf4e22",
                                                "sense_id": "db3ac934-5cab-3f4a-81bc-13d1120390a7",
                                                "text": "I see bright honour sparkle through your eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cde975-132d-39b8-b483-23e5da1d3512",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To emit little bubbles, as certain kinds of liquors; to effervesce"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7fb1e-2eee-4a56-8dc7-1074cdcc5617",
                                                "sense_id": "14cde975-132d-39b8-b483-23e5da1d3512",
                                                "text": "sparkling wine"
                                            },
                                            {
                                                "example_id": "88a3b494-d4dd-4ded-aa0e-a614730f963e",
                                                "sense_id": "14cde975-132d-39b8-b483-23e5da1d3512",
                                                "text": "sparkling water"
                                            }
                                        ]
