                                    {
                                        "sense_id": "ec290181-9795-38a7-bfe9-892097e7eeb6",
                                        "entry_id": "49341bb7-d593-31b7-a603-deebf5d69c61",
                                        "glosses": [
                                            "A group or set of three people or things; three things combined into one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0fa1f7-bf5f-4161-bd8d-584d4607adb5",
                                                "sense_id": "ec290181-9795-38a7-bfe9-892097e7eeb6",
                                                "text": "But when the moon rose and the breeze awakened, and the sedges stirred, and the cat's-paws raced across the moonlit ponds, and the far surf off Wonder Head intoned the hymn of the four winds, the trinity, earth and sky and water, became one thunderous symphony—a harmony of sound and colour silvered to a monochrome by the moon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73d8cf6-a015-37e3-9cd2-06fac7b59dbc",
                                        "entry_id": "49341bb7-d593-31b7-a603-deebf5d69c61",
                                        "glosses": [
                                            "The state of being three; independence of three things; things divided into three."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
