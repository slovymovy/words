                    "semantic_group_id": "plegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De beruchte crimineel <w>bedreef</w> misdaad na misdaad.",
                            "target_lang_translations": {
                                "en": "The notorious criminal <w>committed</w> crime after crime.",
                                "ru": "Печально известный преступник <w>совершал</w> преступление за преступлением.",
                                "it": "Il famigerato criminale <w>commetteva</w> un crimine dopo l'altro.",
