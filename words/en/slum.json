{
    "word_family": [
        "slumming",
        "slummer",
        "slumlord",
        "slummy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57d3ce5d-48b5-3e66-84f4-1c3250c565a6",
                    "sense_definition": "A dilapidated neighborhood where many people live in a state of poverty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "poverty_housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council is working on a plan to improve living conditions in the local <w>slum</w>.",
                            "target_lang_translations": {
                                "ru": "Городской совет работает над планом по улучшению условий жизни в местной <w>трущобе</w>."
                            }
                        },
                        {
                            "text": "Many families are forced to live in an urban <w>slum</w> because they cannot afford housing elsewhere.",
                            "target_lang_translations": {
                                "ru": "Многие семьи вынуждены жить в городских <w>трущобах</w>, потому что не могут позволить себе жилье в другом месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "ghetto",
                        "shantytown",
                        "favela",
                        "barrio"
                    ],
                    "common_phrases": [
                        "urban slum",
                        "slum clearance",
                        "slum dwelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ветхий район, где много людей живут в состоянии нищеты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трущоба",
                                "target_lang_sense_clarification": "бедный, грязный район города"
                            },
                            {
                                "target_lang_word": "гетто",
                                "target_lang_sense_clarification": "район проживания дискриминируемых групп"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fee451fd-aadf-3bd9-b2fa-2a067604ddcc",
                    "sense_definition": "Inexpensive trinkets or cheap merchandise awarded as prizes in a carnival game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carnival_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carnival operator handed out a piece of <w>slum</w> to every child who played the dart game.",
                            "target_lang_translations": {
                                "ru": "Оператор карнавала раздавал по <w>безделушке</w> каждому ребенку, сыгравшему в дартс."
                            }
                        },
                        {
                            "text": "He spent ten dollars on the game only to win a plastic ring worth a few cents of <w>slum</w>.",
                            "target_lang_translations": {
                                "ru": "Он потратил десять долларов на игру только ради того, чтобы выиграть пластиковое кольцо — копеечную <w>дешевку</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "carnival worker slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Недорогие безделушки или дешевые товары, выдаваемые в качестве призов в карнавальных играх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дешевка",
                                "target_lang_sense_clarification": "недорогой предмет низкого качества"
                            },
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "мелкая дешевая вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14055808-3d10-39d2-9e31-3f1b223690f0",
                    "sense_definition": "A shortened form of <w>slumgullion</w>; a cheap meat-based stew.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry travelers sat around the campfire eating a bowl of hot <w>slum</w>.",
                            "target_lang_translations": {
                                "ru": "Голодные путешественники сидели у костра, поедая миску горячей <w>похлебки</w>."
                            }
                        },
                        {
                            "text": "They made a thick <w>slum</w> using whatever leftover meat and vegetables they could find.",
                            "target_lang_translations": {
                                "ru": "Они приготовили густую <w>бурду</w> из остатков мяса и овощей, которые смогли найти."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма от «slumgullion»; дешевое мясное рагу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурда",
                                "target_lang_sense_clarification": "невкусная, жидкая еда"
                            },
                            {
                                "target_lang_word": "похлебка",
                                "target_lang_sense_clarification": "простое жидкое кушанье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7177e5e-98b3-3fd0-a817-71797a97a52f",
                    "sense_definition": "Nonsense or humbug; deceptive talk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to his stories; it is all just a load of <w>slum</w> to confuse you.",
                            "target_lang_translations": {
                                "ru": "Не слушай его россказни; это всё сплошная <w>чушь</w>, чтобы запутать тебя."
                            }
                        },
                        {
                            "text": "The politician's speech was filled with <w>slum</w> and empty promises.",
                            "target_lang_translations": {
                                "ru": "Речь политика была полна <w>вздора</w> и пустых обещаний."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чепуха или вздор; обманчивые разговоры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "бессмыслица"
                            },
                            {
                                "target_lang_word": "вздор",
                                "target_lang_sense_clarification": "нелепость, чепуха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b0b1410-7bbd-3aef-9020-ec522451efb3",
                    "sense_definition": "To visit a neighborhood or place of a lower social status than one's own, often for entertainment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy socialites were <w>slumming</w> it by visiting a dive bar in the industrial district.",
                            "target_lang_translations": {
                                "ru": "Богатые светские львы <w>опустились</w> до посещения злачного бара в промышленном районе."
                            }
                        },
                        {
                            "text": "He felt like he was <w>slumming</w> when he stayed at the cheap motel instead of his usual luxury hotel.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что <w>опускается</w>, когда остановился в дешевом мотеле вместо своего обычного роскошного отеля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slumming it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'it'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посещать район или место с более низким социальным статусом, чем собственный, часто ради развлечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "посещать места ниже своего уровня"
                            },
                            {
                                "target_lang_word": "ходить по трущобам",
                                "target_lang_sense_clarification": "посещать бедные районы из любопытства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fdde1d6-acee-38ce-af50-81dd9e7badc4",
                    "sense_definition": "To saunter or wander about in a disreputable or idle manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his afternoons <w>slumming</w> around the docks with the local troublemakers.",
                            "target_lang_translations": {
                                "ru": "Он проводил дни, <w>слоняясь</w> у доков с местными хулиганами."
                            }
                        },
                        {
                            "text": "The group was seen <w>slumming</w> through the alleyways late at night.",
                            "target_lang_translations": {
                                "ru": "Группу видели <w>шатающейся</w> по переулкам поздно ночью."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогуливаться или бродить в неподобающем или праздном виде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "ходить без дела"
                            },
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "бродить в сомнительных местах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}