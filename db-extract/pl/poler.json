                                        "glosses": [
                                            "A strong vertical post of timber or iron, fixed to the ground and/or on the deck of a ship, to which the ship's mooring lines etc are secured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97b66cba-775f-45d0-82b7-bbd7429eac77",
                                                "sense_id": "88560287-ec5a-3af0-8b14-e62d70730194",
                                                "text": "Today he had for bollard the unfinished monument half-erected to some all but forgotten anarchist."
                                            },
                                            {
                                                "example_id": "d184a2b1-a326-4090-a952-04a537b38597",
                                                "sense_id": "88560287-ec5a-3af0-8b14-e62d70730194",
                                                "text": "He sat on a bollard, looking out across the water, a man more small and shabby than expected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edafca2-de6a-3372-9993-572517b4a826",
