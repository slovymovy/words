                    },
                    {
                        "translation_id": "a40258d7-7467-4829-adb1-f30348ab1a27",
                        "source_entry_id": "a3f48af2-277e-3776-8bcc-0566b55a771c",
                        "source_sense_id": "3fd70e5b-b871-3dba-b411-247b08e01fe6",
                        "source_sense_description": "Katholizismus: Kind, das zur ersten heiligen Kommunion geht",
                        "target_lang_word": "premier communiant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premier communiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c98b9ecf-c38d-3e2a-af0d-b1fe2ae2e874",
                                        "entry_id": "172c42c2-626b-3946-bb4f-cd99d91f41b5",
                                        "glosses": [
                                            "Personne (généralement un enfant d’environ 10 à 12 ans) qui fait sa première communion, dans l’Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653db8de-a745-4963-b10e-1796c4887f9b",
                                                "sense_id": "c98b9ecf-c38d-3e2a-af0d-b1fe2ae2e874",
                                                "text": "Son lorgnon tremblait sur son nez comme une médaille sur un cœur de première communiante."
                                            },
                                            {
                                                "example_id": "fbdd15cc-07a1-486a-825a-1a47a73d682f",
                                                "sense_id": "c98b9ecf-c38d-3e2a-af0d-b1fe2ae2e874",
                                                "text": "Quant à Émile, à son banc, entre ses gendarmes, il avait vraiment l’air, en bleu, avec sa cravate à pois blancs, d’un premier communiant, en tout cas d’un tout jeune homme et parfois, quand il avait fait provision de courage en regardant par terre, il jetait un coup d’œil anxieux vers la foule où il repérait des visages connus."
                                            },
                                            {
                                                "example_id": "b9832f19-8c2b-47c3-99de-ddd49e8f5d5d",
                                                "sense_id": "c98b9ecf-c38d-3e2a-af0d-b1fe2ae2e874",
                                                "text": "Je devais avoir dix ou onze ans. J’avais une allure de premier communiant en complet de flanelle anglaise gris foncé, de coupe croisée, un nœud papillon bleu marine étirant sous mon menton ses ailes de phalène géant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
