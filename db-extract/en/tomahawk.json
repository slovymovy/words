                    {
                        "sense_id": "5de98f3d-9472-3206-a431-3498abe3af60",
                        "entry_id": "a053c9a5-c147-3e11-8a89-4708cb0e84d8",
                        "glosses": [
                            "The BGM-109 Tomahawk Land Attack Missile (TLAM), a long-range, all-weather, subsonic cruise missile with stubby wings, which can be launched from a ship or submarine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b293e3-58bc-4ac8-9674-1609b34c0d21",
                                "sense_id": "5de98f3d-9472-3206-a431-3498abe3af60",
                                "text": "U.S. Navy surface ships launching Tomahawks against Chinese targets would thus have to approach within China's antiship-missile perimeter to bring their missiles in range (more on this in chapter 4)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a27e8e5c-4e36-31d0-8319-f936244f1f47",
                "word": "tomahawk",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9fe6f496-b7da-456b-8682-dc287673af15",
                        "entry_id": "a27e8e5c-4e36-31d0-8319-f936244f1f47",
