                "senses": [
                    {
                        "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                        "entry_id": "c196de57-aba9-301e-99c8-ce413a9fd931",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec49597c-61ef-4089-b095-3d7566d1bb7d",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Frau Fröschle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c7688846-48cd-4cfd-b645-965238c5f729",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Herr Fröschle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4a9dd199-fc6e-4039-a3ef-50af36314e3e",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Die Fröschles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "032ab132-1c06-4817-9446-0c41ad223d7b",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Der Fröschle trägt nie die Pullover, die die Fröschle ihm strickt."
                            },
                            {
                                "example_id": "dcae87bd-7b9c-4b05-8e5b-27353f38fb11",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fröschle kommt, geht der Herr Fröschle.“"
                            },
                            {
                                "example_id": "9b019c68-d7fd-481d-ac62-62079568df9e",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Fröschle kommt und geht."
                            },
                            {
                                "example_id": "8566f5ea-d41a-490e-9220-ebcb07827f89",
                                "sense_id": "2e521a53-8c93-3c15-9d54-a1a86dcd5e25",
                                "text": "Fröschles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
