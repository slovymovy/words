                    {
                        "sense_id": "4aa720ef-34a2-3608-8349-a8210c89235f",
                        "entry_id": "f0efc62a-401c-38e8-b72c-271452e2d6f4",
                        "glosses": [
                            "Gebäude, in dem Konzerte veranstaltet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0887bde6-0fe6-4c44-a579-860f3bec99ac",
                                "sense_id": "4aa720ef-34a2-3608-8349-a8210c89235f",
                                "text": "Im Konzerthaus findet am Freitag eine Vorführung des städtischen Chors statt."
                            },
                            {
                                "example_id": "57603a4d-481d-4a42-a1a4-de3d0dab71c1",
                                "sense_id": "4aa720ef-34a2-3608-8349-a8210c89235f",
                                "text": "„Das Konzerthaus dient Musik- und Gesellschaftsveranstaltungen, nimmt aber auch Großkongresse und andere Veranstaltungen (Bälle, Bankette, Ausstattungen) auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
