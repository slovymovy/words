                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "tags": [
                            "singular",
                            "feminine",
                            "prepositional"
                        ],
                        "form": "ходя́чей"
                    },
                    {
                        "form_id": "d282ab50-bb43-4e97-ba9b-9d9d313c328a",
                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ходя́чих"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbba7819-290d-3134-b730-a2d7c32a2c4a",
                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "glosses": [
                            "такой, который ходит пешком или способен ходить пешком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8499fe47-173d-4185-adc3-b13c08277596",
                                "sense_id": "bbba7819-290d-3134-b730-a2d7c32a2c4a",
                                "text": "В дверях палаты теперь стояли нянечки и сёстры, пришло несколько ходячих раненых."
                            }
                        ]
                    },
                    {
                        "sense_id": "9459e32b-a36a-3f56-a6c4-b3b331be64e6",
                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "glosses": [
                            "перен., разг. движущийся, подвижный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2fd56b-a773-454b-b58d-8032c1dd4ad1",
                                "sense_id": "9459e32b-a36a-3f56-a6c4-b3b331be64e6",
                                "text": "Бегать бы да беззаботно резвиться, а если бы крылья — лететь бы, лететь в синее небо, подняться б выше облака ходячего, выше тучи гремучей, к солнышку красному, к месяцу ясному, к частым звёздочкам рассыпчатым…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7af5c80a-ac98-35de-9d7d-8f8cb2e3ee9c",
                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "glosses": [
                            "перен. обычный, широко распространённый, широко употребительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b415a71c-d200-4c5e-a954-f18e62d7101f",
                                "sense_id": "7af5c80a-ac98-35de-9d7d-8f8cb2e3ee9c",
                                "text": "Коренной одессит, он был мрачен и молчалив, живое опровержение ходячего мнения об одесситах."
                            }
                        ]
                    },
                    {
                        "sense_id": "168b1040-f6e7-37ca-983a-1fd7ebd4bee9",
                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "glosses": [
                            "перен., ирон. являющийся воплощением каких-либо свойств, качеств, явлений (обычно о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f465b7-9afd-404f-b2ae-57cff2be880b",
                                "sense_id": "168b1040-f6e7-37ca-983a-1fd7ebd4bee9",
                                "text": "Тренер — чрезвычайно колоритный дядька. Эдакий ходячий кусок канадской истории."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e073793-427a-3cc2-b7ff-addd4858a22d",
                        "entry_id": "2addd259-e4ee-357e-8f52-48bffdf08475",
                        "glosses": [
                            "устар., разг. имеющий хождение, находящийся в обращении (о деньгах и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2a14ab-e971-4c71-b525-f1c87744579c",
                                "sense_id": "2e073793-427a-3cc2-b7ff-addd4858a22d",
                                "text": "Часы — это касса сбережения ходячей монеты, до первого востребования…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
