                        "examples": [
                            {
                                "example_id": "fb7b72ca-a312-472a-aae1-264cabb105ee",
                                "sense_id": "87b13dcb-b55b-31fc-aab0-e9bd61b49947",
                                "text": "Ma seconde vie de superhéroïne toujours assoiffée s’achèverait dans une explosion de flammes."
                            },
                            {
                                "example_id": "fc977513-bdaf-4808-b95f-13b4848a967c",
                                "sense_id": "87b13dcb-b55b-31fc-aab0-e9bd61b49947",
                                "text": "« On s’est rajouté des seins et des hanches pour mieux se créer des carcasses de superhéroïnes », commente Oulaya Amamra."
                            },
                            {
                                "example_id": "e6e0e08c-763d-4998-a680-20a53bb69941",
                                "sense_id": "87b13dcb-b55b-31fc-aab0-e9bd61b49947",
                                "text": "Nouvelle série OCS, Aspergirl, de Lola Roqueplo, met en scène Nicole Ferroni dans le costume de superhéroïne de Louison, 38 ans, mère célibataire."
                            }
                        ]
                    }
