                                    {
                                        "sense_id": "ec1f16db-c150-30e5-bc2e-229fdc89797d",
                                        "entry_id": "47e5cc5b-b5c2-3069-a6a2-8d9443b4b307",
                                        "glosses": [
                                            "Initialism of GUID partition table."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
