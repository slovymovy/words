                "senses": [
                    {
                        "sense_id": "c6c78e5f-e59c-388e-91c4-060d8812d5ca",
                        "entry_id": "c5ee4136-ea17-3e1f-95fe-7ea1a9fdac6f",
                        "glosses": [
                            "North Atlantic Treaty Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f6657b-5053-4d77-9374-a0b157414355",
                                "sense_id": "c6c78e5f-e59c-388e-91c4-060d8812d5ca",
                                "text": "„ ‚Das [Eingreifen in den libyschen Bürgerkrieg 2011] war wohl eine der erfolgreichsten Missionen in der Geschichte der Nato‘, sagte deren Generalsekretär Anders Fogh Rasmussen nach einem Treffen mit Bundeskanzlerin Angela Merkel (CDU) in Berlin.“"
                            },
                            {
                                "example_id": "b630ef1d-9b4d-4a6f-8493-c95fd8e2dfcd",
                                "sense_id": "c6c78e5f-e59c-388e-91c4-060d8812d5ca",
                                "text": "„Die Staaten des Verteidigungsbündnisses Nato haben sich in Friedenszeiten das Ziel gesetzt, ihre Verteidigungsausgaben auf etwa zwei Prozent der Wirtschaftsleistung zu steigern.“"
                            },
                            {
                                "example_id": "ac7bd632-023c-465c-bac6-75ef87068ed3",
                                "sense_id": "c6c78e5f-e59c-388e-91c4-060d8812d5ca",
                                "text": "„Die Nato, die den Europäern jahrzehntelang Sicherheit geschenkt hat, befindet sich in einer Phase der Neuausrichtung, deren Ausgang noch nicht absehbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
