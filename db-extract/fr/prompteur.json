                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teleprompter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "954d4ef6-fdcf-3591-bcf0-8183c5cc8791",
                                        "entry_id": "ce052fc9-096d-3649-8dcd-99d0635c901f",
                                        "glosses": [
                                            "Gerät bei Fernsehaufnahmen, das den zu sprechenden Text vor der Kamera abbildet, sodass der Sprecher ihn vorlesen kann, ohne den Blick von der Kamera abwenden zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91091cb9-a982-4e84-870f-d869e362e6e6",
                                                "sense_id": "954d4ef6-fdcf-3591-bcf0-8183c5cc8791",
                                                "text": "Im Fernsehen wird der Teleprompter genutzt, um den Eindruck der freien Rede zu erzeugen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df170004-94f1-4f30-861b-ffed1849f2fb",
                        "source_entry_id": "72484a62-9b2e-3772-86fa-8ad6b12c1bdc",
                        "source_sense_id": "e8736e0a-99cb-3ecb-8645-a4b31a48b3cd",
