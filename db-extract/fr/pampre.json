        "fr-extract.jsonl": [
            {
                "entry_id": "a28f9138-97dd-3390-b358-1488646568b8",
                "word": "pampre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "68fc203d-c02b-40ac-bdd5-910b64ff63d7",
                        "entry_id": "a28f9138-97dd-3390-b358-1488646568b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "pampres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "641c8189-24fb-3195-a8a5-5e821829b1de",
                        "entry_id": "a28f9138-97dd-3390-b358-1488646568b8",
                        "glosses": [
                            "Branche de vigne avec ses feuilles et ses grappes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95dfcc48-a2f7-47ed-b662-3c510695b2a1",
                                "sense_id": "641c8189-24fb-3195-a8a5-5e821829b1de",
                                "text": "La fumée d’une cheminée s’élève entre les sarments et le pampre naissant d’une vigne."
                            },
                            {
                                "example_id": "17cc2d3f-005f-432c-a0ab-8d905e5e9cb2",
                                "sense_id": "641c8189-24fb-3195-a8a5-5e821829b1de",
                                "text": "Quand Miette riait, renversant la tête en arrière et la penchant mollement sur son épaule droite, elle ressemblait à la Bacchante antique, avec sa gorge gonflée de gaieté sonore, ses joues arrondies comme celles d’un enfant, ses larges dents blanches, ses torsades de cheveux crépus que les éclats de sa joie agitaient sur sa nuque, ainsi qu’une couronne de pampres."
                            },
                            {
                                "example_id": "e9347f50-3342-4544-a440-77ac19d4d967",
                                "sense_id": "641c8189-24fb-3195-a8a5-5e821829b1de",
                                "text": "Des coteaux d’Arbois, de Poligny et de Salins, descendait, chaque automne, avec les cuves pleines, le beau vin couleur peau d’oignon, jailli des grappes de poulsard, et les vignerons à rouge trogne bénissaient le Seigneur dont le bon soleil gorgeait de vie les pampres vigoureux et emplissait leurs futailles."
                            },
                            {
                                "example_id": "7ec599c9-735f-46cd-8201-de362c5adc84",
                                "sense_id": "641c8189-24fb-3195-a8a5-5e821829b1de",
                                "text": "[…] on ne voit point, à travers une enfilade d’arcs sombres où s’entrelacent le pampre, le lierre et l’églantine, resplendir au loin les lignes immuables des montagnes, qui se découpent sur le ciel argenté."
                            },
                            {
                                "example_id": "b6859d43-7e26-4531-9176-d090e70049d0",
                                "sense_id": "641c8189-24fb-3195-a8a5-5e821829b1de",
                                "text": "Avec le pampre de la vigne\nUn bout de cotillon lui fis\nMais la belle était si petite\nQu’une seule feuille a suffi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d54c8b28-3c00-379f-b390-61a971b0c250",
                        "entry_id": "a28f9138-97dd-3390-b358-1488646568b8",
                        "glosses": [
                            "Ornement d’architecture imitant une branche de vigne avec ses feuilles et ses grappes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d9d7db-73f1-46f2-b916-3448ade7f854",
                                "sense_id": "d54c8b28-3c00-379f-b390-61a971b0c250",
                                "text": "Une fort belle grille, agrémentée d’une décoration dix-huitième de pampre et de raisin, protégeait les carreaux."
                            },
                            {
                                "example_id": "7be431f6-ed65-4de4-83f9-f923bff08060",
                                "sense_id": "d54c8b28-3c00-379f-b390-61a971b0c250",
                                "text": "Bien acagnardé contre le zinc à pampres de son estaminet de prédilection, Antonin lantiponait à foison parmi des norias de pieds nickelés en mouillage. Il retrouvait en ces lieux surchauffés des gens de toutes conditions, de toutes extractions […]."
                            }
                        ]
                    }
                ],
