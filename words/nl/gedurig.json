                                "target_lang_sense_clarification": "again and again"
                            },
                            {
                                "target_lang_word": "frequently",
                                "target_lang_sense_clarification": "often"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "constantemente",
