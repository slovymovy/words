                                "target_senses": [
                                    {
                                        "sense_id": "69aa4f83-6024-3f5a-a4c9-4d84bddadcc4",
                                        "entry_id": "daf935c5-b015-3ca8-9cfa-2ffd20e2534e",
                                        "glosses": [
                                            "To exhibit affection or attempt to please."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d16f95d-083a-3eac-bdec-041a8fa81d11",
                                        "entry_id": "daf935c5-b015-3ca8-9cfa-2ffd20e2534e",
                                        "glosses": [
                                            "To seek favour by flattery and obsequious behaviour."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "622e4bfa-c46e-48e4-9dab-9e68ecb8fc88",
                                                "sense_id": "5d16f95d-083a-3eac-bdec-041a8fa81d11",
                                                "text": "You showed your teeth like apes, and fawned like hounds."
                                            },
                                            {
                                                "example_id": "094124f2-5513-4c81-b3c9-862c4759adc1",
                                                "sense_id": "5d16f95d-083a-3eac-bdec-041a8fa81d11",
                                                "text": "Thou with trembling fear, / Or like a fawning parasite, obeyest."
                                            },
                                            {
                                                "example_id": "dfffd44d-1d9d-4043-b8b4-6f7d49b83cbc",
                                                "sense_id": "5d16f95d-083a-3eac-bdec-041a8fa81d11",
                                                "text": "courtiers who fawn on a master while they betray him"
                                            },
                                            {
                                                "example_id": "2cdab400-9ed1-43ae-a499-5fb82b808a5b",
                                                "sense_id": "5d16f95d-083a-3eac-bdec-041a8fa81d11",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a111d0-3647-3d53-bfeb-ed6506bbef69",
                                        "entry_id": "daf935c5-b015-3ca8-9cfa-2ffd20e2534e",
                                        "glosses": [
                                            "To show devotion or submissiveness by wagging its tail, nuzzling, licking, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
