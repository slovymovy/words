{
    "word_family": [
        "indent",
        "indented",
        "indenting",
        "indenture"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12197e1a-21d3-3565-9522-45db3ca2e02a",
                    "sense_definition": "The empty space or blank distance left at the beginning of a line of text or paragraph.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "text_layout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you include an <w>indentation</w> at the start of each new paragraph.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что делаете <w>отступ</w> в начале каждого нового абзаца."
                            }
                        },
                        {
                            "text": "The computer code requires proper <w>indentation</w> to be readable and valid.",
                            "target_lang_translations": {
                                "ru": "В компьютерном коде необходима правильная <w>индентация</w>, чтобы он был читаемым и корректным."
                            }
                        }
                    ],
                    "synonyms": [
                        "indent"
                    ],
                    "common_phrases": [
                        "paragraph indentation",
                        "proper indentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропуск или свободное пространство в начале строки текста или абзаца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступ",
                                "target_lang_sense_clarification": "в тексте или коде"
                            },
                            {
                                "target_lang_word": "красная строка",
                                "target_lang_sense_clarification": "в начале абзаца"
                            },
                            {
                                "target_lang_word": "индентация",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "абзац",
                                "target_lang_sense_clarification": "абзацный отступ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f3bccf7-a93c-371b-a855-a20824da7e62",
                    "sense_definition": "A deep mark, hollow, or depression pressed or carved into a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_depression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy safe left a deep <w>indentation</w> in the soft carpet.",
                            "target_lang_translations": {
                                "ru": "Тяжёлый сейф оставил глубокую <w>вмятину</w> на мягком ковре."
                            }
                        },
                        {
                            "text": "He noticed a slight <w>indentation</w> on the car door where a ball had hit it.",
                            "target_lang_translations": {
                                "ru": "Он заметил небольшую <w>вмятину</w> на двери машины там, куда попал мяч."
                            }
                        }
                    ],
                    "antonyms": [
                        "protrusion"
                    ],
                    "common_phrases": [
                        "deep indentation",
                        "slight indentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "След, углубление или впадина, продавленная или выбитая на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмятина",
                                "target_lang_sense_clarification": "от удара или давления"
                            },
                            {
                                "target_lang_word": "углубление",
                                "target_lang_sense_clarification": "впадина на поверхности"
                            },
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "отпечаток или вмятина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "220740af-c347-3cef-b782-aac492d2dd44",
                    "sense_definition": "A notch, curve, or cut inward along an edge, border, or coastline.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_depression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The irregular coast is characterized by many deep <w>indentations</w> and natural harbors.",
                            "target_lang_translations": {
                                "ru": "Неровная береговая линия отличается сильной <w>изрезанностью</w> и множеством естественных гаваней."
                            }
                        },
                        {
                            "text": "Notice the small <w>indentations</w> along the outer margin of the leaf.",
                            "target_lang_translations": {
                                "ru": "Обратите внимание на мелкие <w>вырезки</w> по внешнему краю листа."
                            }
                        }
                    ],
                    "antonyms": [
                        "protrusion"
                    ],
                    "common_phrases": [
                        "indentations of the coast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выемка, изгиб или вырез по краю, границе или береговой линии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырез",
                                "target_lang_sense_clarification": "по краю или кромке"
                            },
                            {
                                "target_lang_word": "изрезанность",
                                "target_lang_sense_clarification": "береговой линии"
                            },
                            {
                                "target_lang_word": "выемка",
                                "target_lang_sense_clarification": "углубление по краю"
                            },
                            {
                                "target_lang_word": "зазубрина",
                                "target_lang_sense_clarification": "на краю листа или предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f08076-440e-3615-8c85-8c53c3075d15",
                    "sense_definition": "The act of making a recess or hollow, or the condition of being indented.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine performs precise surface <w>indentation</w> to test material hardness.",
                            "target_lang_translations": {
                                "ru": "Станок выполняет точное поверхностное <w>вдавливание</w> для проверки твёрдости материала."
                            }
                        },
                        {
                            "text": "Excessive <w>indentation</w> can weaken the outer metal layer of the container.",
                            "target_lang_translations": {
                                "ru": "Чрезмерное <w>вдавливание</w> может ослабить внешний металлический слой контейнера."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс вдавливания, образование углубления или состояние поверхности со вмятиной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдавливание",
                                "target_lang_sense_clarification": "процесс нажатия или деформации"
                            },
                            {
                                "target_lang_word": "индентирование",
                                "target_lang_sense_clarification": "в материаловедении, измерение твёрдости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d468214e-d320-3ade-a053-b565b1dce710",
                    "sense_definition": "The measured distance that a line of text is set in from the margin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "text_layout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The typist adjusted the margin to allow an <w>indentation</w> of half an inch.",
                            "target_lang_translations": {
                                "ru": "Машинистка настроила поля так, чтобы <w>отступ</w> составлял полдюйма."
                            }
                        },
                        {
                            "text": "The style manual recommends an <w>indentation</w> of one em for all block quotes.",
                            "target_lang_translations": {
                                "ru": "Руководство по стилю рекомендует делать для всех длинных цитат <w>отступ</w> размером в одну круглую шпацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "indent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измеренная величина или расстояние смещения строки текста относительно поля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступ",
                                "target_lang_sense_clarification": "величина смещения строки от края"
                            },
                            {
                                "target_lang_word": "размер отступа",
                                "target_lang_sense_clarification": "измеряемое расстояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "770931cd-2750-38c6-b202-54fe61dd7be5",
                    "sense_definition": "A formal subsection or division in a legislative document, typically marked by an indent or dash.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer referenced the second <w>indentation</w> of Article 4 during the hearing.",
                            "target_lang_translations": {
                                "ru": "Во время слушания юрист сослался на второй <w>абзац</w> статьи 4."
                            }
                        },
                        {
                            "text": "According to the final <w>indentation</w> of the directive, Member States must comply within a year.",
                            "target_lang_translations": {
                                "ru": "Согласно последнему <w>подпункту</w> директивы, государства-члены обязаны выполнить требования в течение года."
                            }
                        }
                    ],
                    "common_phrases": [
                        "second indentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный подпункт или структурное подразделение статьи в правовом документе, обычно выделяемое отступом или тире."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абзац",
                                "target_lang_sense_clarification": "пункт или часть статьи закона"
                            },
                            {
                                "target_lang_word": "подпункт",
                                "target_lang_sense_clarification": "деление статьи документа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}