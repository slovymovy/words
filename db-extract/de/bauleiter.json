                "senses": [
                    {
                        "sense_id": "babda3a4-2f13-3bb0-92d0-3d15e913748b",
                        "entry_id": "5e6427d0-1148-3f4a-9b9c-65c579fa6369",
                        "glosses": [
                            "Person, der vom Bauherrn die Verantwortung für den Bau (zum Beispiel eines Gebäudes) übertragen worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23b919eb-6e54-4fba-979c-f862e884b935",
                                "sense_id": "babda3a4-2f13-3bb0-92d0-3d15e913748b",
                                "text": "Der Bauleiter sprach mit dem Architekten über die Umsetzung des Liftschachts."
                            },
                            {
                                "example_id": "928996ec-139b-424d-b131-e40424aabaf1",
                                "sense_id": "babda3a4-2f13-3bb0-92d0-3d15e913748b",
                                "text": "„Ein Sprecher des Baukonzerns Bilfinger Berger bestätigte am Dienstag auf Anfrage der Süddeutschen Zeitung, das Unternehmen habe bereits Anfang Februar einen Oberbauleiter, einen Bauleiter und einen Polier suspendiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
