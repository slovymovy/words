                "senses": [
                    {
                        "sense_id": "fc46d024-7afc-386f-9d82-7c01b9e05feb",
                        "entry_id": "15090584-4b21-3193-97a1-cd1cdfd4ae30",
                        "glosses": [
                            "in Amerika heimische Fledermausart aus der Unterfamilie der Fruchtvampire"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01fe68f0-61ec-4b77-93f2-cb37dc86106f",
                                "sense_id": "fc46d024-7afc-386f-9d82-7c01b9e05feb",
                                "text": "„Er ist schwanzlos, durchschnittlich 60 mm lang und wiegt nur 17 g: der Schokoladen-Fruchtzwerg (Enchisthenes hartii).“"
                            },
                            {
                                "example_id": "96e62f91-85b2-4469-a634-31436c78d17f",
                                "sense_id": "fc46d024-7afc-386f-9d82-7c01b9e05feb",
                                "text": "„Der Schokoladen-Fruchtzwerg ist die einzige Art der Gattung Enchisthenes aus der Unterfamilie der Fruchtvampire der Fledermäuse.“"
                            },
                            {
                                "example_id": "e32abe65-a10e-45b5-a04e-8244ffa32eb8",
                                "sense_id": "fc46d024-7afc-386f-9d82-7c01b9e05feb",
                                "text": "„Verbreitet sind die flugfähigen Schokoladen-Fruchtzwerge hauptsächlich in Teilen Mexikos und Südamerikas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
