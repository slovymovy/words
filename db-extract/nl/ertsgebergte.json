                        "source_sense_id": "908b23fe-24e3-35d4-9a0d-5c6118c42cd5",
                        "target_lang_word": "Erzgebirge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzgebirge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                        "entry_id": "8ae23dc7-4304-3731-929c-ad138dbe6082",
                                        "glosses": [
                                            "Gebirge in Mitteleuropa im Südosten Deutschlands und im Nordwesten Tschechiens; Sächsisches Erzgebirge (dieses ist aber sehr selten in Gebrauch, nur in Zusammenhang mit dem Slowakischen Erzgebirge Slovenské rudohorie)"
                                        ],
                                        "tags": [
                                            "slowakisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73304c60-aa26-4d8f-88b9-b84a59281ca7",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Man kann sich eine der vielen und schönen Ferienwohnungen im Erzgebirge nehmen."
                                            },
                                            {
                                                "example_id": "46bb558d-ef17-43dd-9659-002dbac24a2d",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Das Erzgebirge ist ein Grenzgebirge."
                                            },
                                            {
                                                "example_id": "2d819e8b-b3c9-4e35-9127-de9e4d805caf",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Ich bin im Erzgebirge geboren."
                                            },
                                            {
                                                "example_id": "e3d22e6d-3c82-48c2-8c7a-6144bc63ee4e",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Wir haben im Erzgebirge unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "ed37dbe6-fd40-4b14-ada6-a0ea50ef293a",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Zum Erzgebirge hin führen viele Wege."
                                            },
                                            {
                                                "example_id": "33d9f97c-c5c2-4dfa-bd36-d00e3673abd8",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Das Erzgebirge liegt auf der Nordhalbkugel."
                                            },
                                            {
                                                "example_id": "12240b74-43c0-4ad9-bd31-83acba4d0047",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "Das Erzgebirge des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                                            },
                                            {
                                                "example_id": "72f737d5-2c24-4424-a0ca-4c8d777c1ad0",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "„Die höheren Aufragungen, z.B. der Fichtelberg (1216 m) und der auf tschechoslowakischem Gebiet liegende Klinovec (Keilberg; 1244 m), sind vor allem an Glimmerschiefer, im Osterzgebirge außerdem an Quarzporphyr – Kahleberg 904 m – oder an einzelne Basaltreste – Geisingberg 823 m – gebunden, die insbesondere auch im Gebiet des mittleren Erzgebirges – Pöhlberg, Scheibenberg, Bärenstein – deutlich über die Hochfläche aufragen“."
                                            },
                                            {
                                                "example_id": "e90906c9-7cda-43ba-ab81-0e2675c35f1a",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "„Das Erzgebirge betrieb im 19. Jahrhundert eine regelrechte vorindustrielle Massenproduktion und exportierte zentnerweise.“"
                                            },
                                            {
                                                "example_id": "93c11e30-852f-4576-807f-9d6ddd487c36",
                                                "sense_id": "d7cd8b04-27d7-3d45-b2ca-d78750edd38d",
                                                "text": "„Die Einnahmen der sächsischen Fürsten aus dem Silberbergbau des Erzgebirges wurden allein für die Zeitspanne von 1535 bis 1545 auf eine Million Gulden geschätzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
