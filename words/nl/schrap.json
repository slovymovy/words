    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a2b7acb5-8f28-3f05-be4c-6daf9b030990",
                    "sense_definition": "gebruikt in de uitdrukking zich schrap zetten om zich voor te bereiden op een fysieke of mentale klap",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voorbereiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de auto begon te slippen, kon hij zich nog net <w>schrap</w> zetten.",
                            "target_lang_translations": {
                                "en": "When the car started to skid, he was just able to <w>brace</w> himself."
                            }
                        },
                        {
                            "text": "Je moet je <w>schrap</w> zetten voor het slechte nieuws dat komen gaat.",
                            "target_lang_translations": {
                                "en": "You need to <w>brace</w> yourself for the bad news that is coming."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich schrap zetten"
                    ],
                    "target_lang_definitions": {
                        "en": "used in the expression 'zich schrap zetten' to prepare oneself for a physical or mental blow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "braced",
                                "target_lang_sense_clarification": "prepared for impact"
                            },
                            {
                                "target_lang_word": "ready",
                                "target_lang_sense_clarification": "prepared for something difficult"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45b1c0e9-6092-37bf-b4f3-cd19198736d2",
                    "sense_definition": "een lichte beschadiging of kras op een oppervlak door een scherp voorwerp",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zat een diepe <w>schrap</w> op de lak van de nieuwe auto.",
                            "target_lang_translations": {
                                "en": "There was a deep <w>scratch</w> on the paint of the new car."
                            }
                        },
                        {
                            "text": "Na de val had het kind slechts een kleine <w>schrap</w> op zijn knie.",
                            "target_lang_translations": {
                                "en": "After the fall, the child only had a small <w>scrape</w> on his knee."
                            }
                        }
                    ],
                    "synonyms": [
                        "schram"
                    ],
                    "target_lang_definitions": {
                        "en": "a slight damage or scratch on a surface caused by a sharp object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "mark on a surface"
                            },
                            {
                                "target_lang_word": "scrape",
                                "target_lang_sense_clarification": "minor surface damage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e82a63d1-1070-31a7-8b4a-4b0f8a08c4c1",
                    "sense_definition": "een getrokken lijn door een tekst om iets te verwijderen of te markeren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "markering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar zette een grote <w>schrap</w> door de foute zin.",
                            "target_lang_translations": {
                                "en": "The teacher put a large <w>stroke</w> through the incorrect sentence."
                            }
                        },
                        {
                            "text": "Met een snelle <w>schrap</w> verwijderde hij de naam van de lijst.",
                            "target_lang_translations": {
                                "en": "With a quick <w>cross-out</w>, he removed the name from the list."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schrap zetten"
                    ],
                    "target_lang_definitions": {
                        "en": "a line drawn through text to remove or mark something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "a line through text"
                            },
                            {
                                "target_lang_word": "cross-out",
                                "target_lang_sense_clarification": "mark indicating deletion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42314527-6f1a-3e40-bd28-b9567df60716",
                    "sense_definition": "een schuine streep die als leesteken of scheidingsteken wordt gebruikt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leesteken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze context fungeert de <w>schrap</w> als een keuzemogelijkheid tussen twee woorden.",
                            "target_lang_translations": {
                                "en": "In this context, the <w>slash</w> functions as a choice between two words."
                            }
                        },
                        {
                            "text": "Vergeet niet een <w>schrap</w> te plaatsen tussen de verschillende opties.",
                            "target_lang_translations": {
                                "en": "Don't forget to place a <w>slash</w> between the different options."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schuine schrap"
                    ],
                    "target_lang_definitions": {
                        "en": "a forward slash used as a punctuation mark or separator"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slash",
                                "target_lang_sense_clarification": "punctuation mark /"
                            },
                            {
                                "target_lang_word": "solidus",
                                "target_lang_sense_clarification": "formal term for a slash"
                            }
                        ]
                    }
                }
            ]
        },
        {
