                "senses": [
                    {
                        "sense_id": "adb4d87d-9b3a-31d6-869a-05f46faaa4fd",
                        "entry_id": "591fede6-d21b-30ff-bc2c-12864fe393ed",
                        "glosses": [
                            "Raw or poor-quality alcoholic liquor."
                        ],
                        "tags": [
                            "slang",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d137605e-9d83-4b4e-8b49-14ff96c8c6e2",
                                "sense_id": "adb4d87d-9b3a-31d6-869a-05f46faaa4fd",
                                "text": "Near-synonym: red-eye"
                            },
                            {
                                "example_id": "26a5128c-ce93-4ea7-a023-65f726b94668",
                                "sense_id": "adb4d87d-9b3a-31d6-869a-05f46faaa4fd",
                                "text": "Then the harpooner carried away a pink flask to be filled in some blind pig, for there were no licensed saloons in that locality. We drank the cheap rotgut out of tumblers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca439955-9175-4d92-a94c-0878a77befc8",
                        "source_entry_id": "591fede6-d21b-30ff-bc2c-12864fe393ed",
                        "source_sense_id": "adb4d87d-9b3a-31d6-869a-05f46faaa4fd",
                        "source_sense_description": "raw or poor-quality alcoholic liquor",
                        "target_lang_word": "tord-boyaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tord-boyaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                        "entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
                                        "glosses": [
                                            "Eau-de-vie très forte."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04c344d-ea3a-4102-a749-c9284d47fe80",
                                                "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                                "text": "On apporta bientôt de l’eau-de-vie de sorbe qui, d’après Nozdirov, rappelait la prune à s’y méprendre, mais qui, au profond étonnement des invités, se révéla un atroce tord-boyaux."
                                            },
                                            {
                                                "example_id": "3adeb40a-abdb-4917-a335-3833709586f9",
                                                "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                                "text": "Curieusement, cet alcool presque pur inspirait à Kornilov une étrange lucidité. « Je l’aime bien, se disait-il, ce brave pope. Son tord-boyaux aussi."
                                            },
                                            {
                                                "example_id": "764cb0e0-3805-4bd2-94aa-4ef3b95e543e",
                                                "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                                "text": "Il alla quérir une bouteille de cette merveilleuse vodka des paysans polonais, tord-boyaux sauveur et sacré, et j’osai lui dire, après le premier cul sec, que nous mourions de faim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9030f5ca-1c65-36e4-9e0d-1d7414335c23",
                                        "entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
                                        "glosses": [
                                            "Mal de ventre."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f13f046e-e052-420c-93ef-0ef0c7ba0460",
                                                "sense_id": "9030f5ca-1c65-36e4-9e0d-1d7414335c23",
                                                "text": "C’était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu’un des deux se viandât méchamment cinq mètres plus bas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tord-boyaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eca1ab97-ad85-361c-bbb5-e182cec93995",
                                        "entry_id": "ada6c8db-09e0-3efb-a8c1-4afbc87f5663",
