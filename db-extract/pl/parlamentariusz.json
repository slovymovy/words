                    },
                    {
                        "translation_id": "43dad4a0-0181-4b1a-8820-2b899fbce6a1",
                        "source_entry_id": "60bebd68-c2f0-3c95-bfc4-2942bec840bf",
                        "source_sense_id": "419c205b-2e5a-346d-a2a1-a0ebb52e6bee",
                        "target_lang_word": "parlementaire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "76d89123-3aee-4cf9-bd5a-3ac8213a02bc",
                        "source_entry_id": "60bebd68-c2f0-3c95-bfc4-2942bec840bf",
                        "source_sense_id": "419c205b-2e5a-346d-a2a1-a0ebb52e6bee",
                        "target_lang_word": "parlementaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parlementaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6eb2e9d-87f7-30eb-8b07-9de606a7f678",
                                        "entry_id": "220b259c-dfb0-3fd5-b407-1fa9443ad7c6",
                                        "glosses": [
                                            "Qui appartient au parlement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70f4738-02ac-4c74-9142-79d417ddb211",
                                                "sense_id": "a6eb2e9d-87f7-30eb-8b07-9de606a7f678",
                                                "text": "Il s'agissait de conférences et de parlottes défaitistes, au cours desquelles il était donné lecture de fragments de séances parlementaires en comité secret, considérés comme aptes à démoraliser les auditeurs, et aussi de tracts et de brochures progermaniques."
                                            },
                                            {
                                                "example_id": "309694d5-ed92-4def-8cd2-5a91ed81eee7",
                                                "sense_id": "a6eb2e9d-87f7-30eb-8b07-9de606a7f678",
                                                "text": "L’adoption du nouveau traité européen par voie parlementaire et non référendaire est le signe d’une défiance profonde dans le peuple et d’un mépris démocratique par rapport au vote passé."
                                            },
                                            {
                                                "example_id": "c3cb3bea-9ff9-4728-a67e-8b227c73019d",
                                                "sense_id": "a6eb2e9d-87f7-30eb-8b07-9de606a7f678",
                                                "text": "M. Merz a répété à plusieurs reprises exclure tout scénario de coalition avec l’AfD après les élections, au nom de la doctrine du cordon sanitaire qui prévaut en Allemagne depuis l’après-guerre, selon laquelle aucun des partis respectant la démocratie parlementaire ne forme d’alliance avec l’extrême droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "862a97be-fcea-38e3-805a-d23623ffef4b",
                                        "entry_id": "220b259c-dfb0-3fd5-b407-1fa9443ad7c6",
                                        "glosses": [
                                            "Relatif au parlement et à ses membres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9dd269f-3fd1-406b-9f2e-8d8c03e791bd",
                                                "sense_id": "862a97be-fcea-38e3-805a-d23623ffef4b",
                                                "text": "— Calvâsse! vraiment? Je croyais que les correspondants parlementaires étaient détendus comme des coqs en pâte."
                                            },
                                            {
                                                "example_id": "373017dd-b683-418b-b392-80faa72cfc4a",
                                                "sense_id": "862a97be-fcea-38e3-805a-d23623ffef4b",
                                                "text": "Ton silence et ta retraite à la campagne, quand tu pourrais jouir ici des triomphes parlementaires du comte de l’Estorade, dont la parlotterie et le dévouement lui ont acquis une influence, et qui sera sans doute placé très haut après la session, me donnent de graves inquiétudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f066fc-b86a-33de-96eb-053e6b808ca2",
                                        "entry_id": "220b259c-dfb0-3fd5-b407-1fa9443ad7c6",
                                        "glosses": [
                                            "Relatif aux partisans du Parlement en France ou en Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b14c592-55bf-4ff1-8f49-7a8abc7b26da",
                                                "sense_id": "29f066fc-b86a-33de-96eb-053e6b808ca2",
                                                "text": "Les électeurs de la montagne venaient à cheval, […]; ceux de la plaine, et surtout les gens de familles parlementaires, avaient des équipages plus élégans et des laquais en grande livrée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parlementaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3d1c74-854e-36a4-8c8b-d3fdc9b35144",
                                        "entry_id": "bf9710c9-02cc-318f-bdbb-d44fa4bec524",
                                        "glosses": [
                                            "Relatif à l’action de parlementer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c46adf60-3acc-49cd-90bb-be15548465b5",
                                                "sense_id": "7e3d1c74-854e-36a4-8c8b-d3fdc9b35144",
                                                "text": "Le drapeau, le pavillon parlementaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parlementaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea82650-e888-3237-a0dd-8bcfb3f60ebe",
                                        "entry_id": "d8cc8192-3563-3183-b2eb-d755ad364758",
                                        "glosses": [
                                            "Membre du parlement, ou d'une de ses chambres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3204d4f1-9988-41ec-bd10-b035f2acbaf0",
                                                "sense_id": "6ea82650-e888-3237-a0dd-8bcfb3f60ebe",
                                                "text": "Il est excessivement remarquable que le fait d’être déjà vendu n’empêche jamais le parlementaire vivant d’être encore à vendre. C’est un des rares cas commerciaux de cessibilité permanente."
                                            },
                                            {
                                                "example_id": "407bde00-3067-486e-85ca-e84b82092a2b",
                                                "sense_id": "6ea82650-e888-3237-a0dd-8bcfb3f60ebe",
                                                "text": "Ce parlementaire a bien rempli son mandat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a364680b-4437-3abe-b2cd-360f21230c06",
                                        "entry_id": "d8cc8192-3563-3183-b2eb-d755ad364758",
                                        "glosses": [
                                            "Celui, celle qui, pendant les divisions de l’Angleterre, ou, en France, pendant les troubles de la Fronde, tenaient le parti du parlement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e856b08f-bf6d-4f49-bbed-6d98f07474ce",
                                                "sense_id": "a364680b-4437-3abe-b2cd-360f21230c06",
                                                "text": "Le parti des parlementaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parlementaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8944102a-50af-39c3-89c9-a3823f4f6190",
                                        "entry_id": "085d1b51-b466-3181-a131-4a7d46cf9256",
                                        "glosses": [
                                            "Personne que des belligérants envoient les uns aux autres pour porter des propositions, ou pour y répondre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46373289-4b59-4e07-b298-4ccc3be3371e",
                                                "sense_id": "8944102a-50af-39c3-89c9-a3823f4f6190",
                                                "text": "Le 5 février, les deux parlementaires apportent une copie authentique du traité conclu entre la France et l’Allemagne pour fixer les conditions de l’armistice."
                                            },
                                            {
                                                "example_id": "888b0b5b-9eb1-4864-90d4-dab0d529b816",
                                                "sense_id": "8944102a-50af-39c3-89c9-a3823f4f6190",
                                                "text": "Le gardien lui avait ouvert, quand il s'était présenté en brandissant la bouteille d’eau-de-vie, comme un parlementaire arbore un drapeau blanc aux avant-postes."
                                            },
                                            {
                                                "example_id": "702eaa98-8aef-4da1-b76c-630b6b505084",
                                                "sense_id": "8944102a-50af-39c3-89c9-a3823f4f6190",
                                                "text": "Il y avait, je m’en souviens, une situation superbe dans ce siège de Gênes. On n’avait plus de vivres, on mourait de faim, lorsqu’un parlementaire était introduit. Ce devait être le traître de la chose, rôle qui était invariablement confié au fameux Jenneval.\n« Capitulez, disait l’Autrichien. Nous savons que vous êtes à bout de ressources. »\nMais Masséna protestait :\n« Vous vous trompez. Nous ne manquons de rien. Qui est-ce qui a faim, ici ? »\nEt, s’adressant à une vieille moustache :\n« Parle franchement, toi. As-tu faim ?\n— Non, mon général, » répondait d’une voix faible le vétéran.\nEt il s’évanouissait, tombant d’inanition."
                                            },
                                            {
                                                "example_id": "3d0ade96-572a-401b-9985-9e61bb1a0306",
                                                "sense_id": "8944102a-50af-39c3-89c9-a3823f4f6190",
                                                "text": "Et ce fut par cette invariable réponse qu’il accueillit toutes les parlementaires juponnées que, patiente et persévérante, sa femme persistait à lui dépêcher d’heure en heure sous des prétextes, semblait-il, de plus en plus urgents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c69726f-cd9a-3b04-a393-07721e8dca04",
                                        "entry_id": "085d1b51-b466-3181-a131-4a7d46cf9256",
                                        "glosses": [
                                            "Navire envoyé porter un message à une flotte ou dans un port de la nation avec laquelle on est en guerre."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d90a6285-4d11-4653-aad0-8b0f48d02d67",
                        "source_entry_id": "60bebd68-c2f0-3c95-bfc4-2942bec840bf",
                        "source_sense_id": "419c205b-2e5a-346d-a2a1-a0ebb52e6bee",
                        "target_lang_word": "Parlamentär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parlamentär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3d2140-4ca2-35df-9cc9-1459ee33903b",
                                        "entry_id": "d99a19b7-0bff-31a6-9e7e-13bafbe64273",
                                        "glosses": [
                                            "Unterhändler, insbesondere zwischen Krieg führenden Parteien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5313f93e-a6c0-430a-8f2f-1c1cf05d70ec",
                                                "sense_id": "9d3d2140-4ca2-35df-9cc9-1459ee33903b",
                                                "text": "„Am 15. März kam ein französischer Parlamentär nach Kolberg und verhandelte unter vier Augen mit Loucadou.“"
                                            },
                                            {
                                                "example_id": "6f1e87e3-7de7-49d5-b318-381b0e00056c",
                                                "sense_id": "9d3d2140-4ca2-35df-9cc9-1459ee33903b",
                                                "text": "„In der Nacht vom 30. April zum 1. Mai war General Hans Krebs, seit kurzem Chef des deutschen Generalstabs, als Parlamentär auf dem Gefechtsstand von Generaloberst Tschuikow erschienen.“"
                                            },
                                            {
                                                "example_id": "e75c8874-8ba9-48ff-8fa4-f6f660365c92",
                                                "sense_id": "9d3d2140-4ca2-35df-9cc9-1459ee33903b",
                                                "text": "„Ein Parlamentär mit weißer Flagge müsste erscheinen, um die Übergabe auszuhandeln.“"
                                            },
                                            {
                                                "example_id": "503d9780-0018-44ee-8fc0-e38c532f6e0d",
                                                "sense_id": "9d3d2140-4ca2-35df-9cc9-1459ee33903b",
                                                "text": "„Ein anderer Parlamentär war bei der russischen Vorpostenkette erschienen, hatte ebenfalls die Nachricht von den Friedensverhandlungen verkündet und den russischen Truppen ebenfalls einen dreitägigen Waffenstillstand vorgeschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
