                                                "sense_id": "0b16665e-e36d-3ff1-a423-b3cc8797d5a2",
                                                "text": "There's nothing but raw fish in the freezer."
                                            },
                                            {
                                                "example_id": "f215b0b8-228e-4d2d-b04f-07690c9a74c0",
