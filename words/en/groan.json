{
    "word_family": [
        "groaner",
        "groaning"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                    "sense_definition": "To make a low, deep sound in response to pain, grief, or frustration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal-expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player began to <w>groan</w> as the medics moved his leg.",
                            "target_lang_translations": {
                                "ru": "Травмированный игрок начал <w>стонать</w>, когда медики пошевелили его ногу.",
                                "cs": "Zraněný hráč začal <w>sténat</w>, když s ním zdravotníci pohnuli."
                            }
                        },
                        {
                            "text": "We all <w>groaned</w> aloud when the teacher announced the surprise test.",
                            "target_lang_translations": {
                                "ru": "Мы все вслух <w>застонали</w> от досады, когда учитель объявил о внезапной контрольной.",
                                "cs": "Všichni jsme nahlas <w>zasténali</w>, když učitel oznámil nečekaný test."
                            }
                        }
                    ],
                    "synonyms": [
                        "moan",
                        "sigh"
                    ],
                    "antonyms": [
                        "cheer",
                        "laugh"
                    ],
                    "common_phrases": [
                        "groan aloud",
                        "groan in pain",
                        "groan with frustration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать низкий, глубокий звук в ответ на боль, горе или разочарование.",
                        "cs": "Vydávat hluboký, táhlý zvuk v reakci na bolest, smutek nebo frustraci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стонать",
                                "target_lang_sense_clarification": "от физической или душевной боли"
                            },
                            {
                                "target_lang_word": "охать",
                                "target_lang_sense_clarification": "от досады или разочарования"
                            },
                            {
                                "target_lang_word": "простонать",
                                "target_lang_sense_clarification": "издать стон"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "sténat",
                                "target_lang_sense_clarification": "vydávat zvuk bolesti nebo utrpení"
                            },
                            {
                                "target_lang_word": "zasténat",
                                "target_lang_sense_clarification": "vydat krátký zvuk bolesti nebo nespokojenosti"
                            },
                            {
                                "target_lang_word": "naříkat",
                                "target_lang_sense_clarification": "projevovat nespokojenost nebo bolest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                    "sense_definition": "To make a low creaking sound or to seem strained under a heavy load.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical-strain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden floorboards <w>groan</w> every time someone walks across the hallway.",
                            "target_lang_translations": {
                                "ru": "Старые деревянные половицы <w>скрипят</w> каждый раз, когда кто-то проходит по коридору.",
                                "cs": "Staré dřevěné podlahy <w>skřípou</w> pokaždé, když někdo přejde přes chodbu."
                            }
                        },
                        {
                            "text": "The dining table was <w>groaning</w> under the weight of the massive holiday feast.",
                            "target_lang_translations": {
                                "ru": "Обеденный стол <w>ломился</w> под тяжестью обильного праздничного угощения.",
                                "cs": "Jídelní stůl se <w>prohýbal</w> pod tíhou bohaté sváteční hostiny."
                            }
                        }
                    ],
                    "synonyms": [
                        "creak",
                        "strain"
                    ],
                    "common_phrases": [
                        "groan under the weight",
                        "groaning with food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать низкий скрипучий звук или казаться перегруженным под тяжелым весом.",
                        "cs": "Vydávat hluboký vrzavý zvuk nebo se zdát přetížený pod velkou vahou."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрипеть",
                                "target_lang_sense_clarification": "о половицах или мебели"
                            },
                            {
                                "target_lang_word": "трещать",
                                "target_lang_sense_clarification": "под тяжестью или нагрузкой"
                            },
                            {
                                "target_lang_word": "ломиться",
                                "target_lang_sense_clarification": "о столе, заставленном едой"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "skřípat",
                                "target_lang_sense_clarification": "o dřevěných podlahách nebo konstrukcích"
                            },
                            {
                                "target_lang_word": "praskat",
                                "target_lang_sense_clarification": "pod velkou zátěží nebo tlakem"
                            },
                            {
                                "target_lang_word": "prohýbat se",
                                "target_lang_sense_clarification": "o stole plném jídla pod velkou vahou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54adb875-dc77-3306-be80-de529d42dbbf",
                    "sense_definition": "To strive after something earnestly or to suffer deeply while longing for change.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "earnest-striving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oppressed population continued to <w>groan</w> for freedom and justice.",
                            "target_lang_translations": {
                                "ru": "Угнетенное население продолжало <w>стонать</w> под гнетом, жаждя свободы и справедливости.",
                                "cs": "Ujařmené obyvatelstvo nadále <w>strádalo</w> v touze po svobodě a spravedlnosti."
                            }
                        },
                        {
                            "text": "In the poem, the soul is described as one that <w>groaneth</w> to be pure.",
                            "target_lang_translations": {
                                "ru": "В стихотворении душа описывается как та, что <w>томится</w> в стремлении к чистоте.",
                                "cs": "V básni je duše popsána jako ta, která <w>touží</w> po čistotě."
                            }
                        }
                    ],
                    "synonyms": [
                        "yearn",
                        "long"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренне стремиться к чему-либо или глубоко страдать, жаждя перемен.",
                        "cs": "Upřímně po něčem toužit nebo hluboce trpět v očekávání změny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стонать",
                                "target_lang_sense_clarification": "находиться под гнётом или игом"
                            },
                            {
                                "target_lang_word": "томиться",
                                "target_lang_sense_clarification": "в ожидании или стремлении"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "strádat",
                                "target_lang_sense_clarification": "trpět pod útlakem nebo nedostatkem"
                            },
                            {
                                "target_lang_word": "toužit",
                                "target_lang_sense_clarification": "v hlubokém, až bolestném smyslu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07417e6e-b67f-3b2e-978a-bf7dde9a72b7",
                    "sense_definition": "A low, mournful sound uttered in pain, grief, or disapproval.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal-expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A low <w>groan</w> escaped his lips as he tried to sit up in bed.",
                            "target_lang_translations": {
                                "ru": "Тихий <w>стон</w> сорвался с его губ, когда он попытался сесть в постели.",
                                "cs": "Z jeho rtů unikl tichý <w>sten</w>, když se pokusil v posteli posadit."
                            }
                        },
                        {
                            "text": "The comedian's bad joke was met with a collective <w>groan</w> from the audience.",
                            "target_lang_translations": {
                                "ru": "Плохая шутка комика была встречена коллективным <w>вздохом</w> разочарования в зале.",
                                "cs": "Komikův špatný vtip byl publikem přijat kolektivním <w>vzdechem</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moan",
                        "sigh"
                    ],
                    "antonyms": [
                        "cheer"
                    ],
                    "common_phrases": [
                        "collective groan",
                        "low groan",
                        "muffled groan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий, печальный звук, издаваемый при боли, горе или неодобрении.",
                        "cs": "Hluboký, smutný zvuk vydávaný při bolesti, zármutku nebo nesouhlasu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стон",
                                "target_lang_sense_clarification": "от боли или страдания"
                            },
                            {
                                "target_lang_word": "вздох",
                                "target_lang_sense_clarification": "разочарования или неодобрения"
                            },
                            {
                                "target_lang_word": "ропот",
                                "target_lang_sense_clarification": "коллективное недовольство"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "sten",
                                "target_lang_sense_clarification": "zvuk bolesti nebo utrpení"
                            },
                            {
                                "target_lang_word": "vzdech",
                                "target_lang_sense_clarification": "projev nespokojenosti nebo zklamání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64f96621-459a-3a42-9652-b74b552df313",
                    "sense_definition": "A low creaking sound caused by pressure or weight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical-strain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship gave a terrifying <w>groan</w> as it hit the rocky shore.",
                            "target_lang_translations": {
                                "ru": "Корабль издал ужасающий <w>скрип</w>, когда ударился о скалистый берег.",
                                "cs": "Loď vydala děsivé <w>skřípění</w>, když narazila na skalnatý břeh."
                            }
                        },
                        {
                            "text": "We heard the <w>groan</w> of the old timber as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Мы услышали <w>треск</w> старой древесины, когда усилился ветер.",
                                "cs": "Slyšeli jsme <w>praskání</w> starých trámů, jak vítr sílil."
                            }
                        }
                    ],
                    "synonyms": [
                        "creak"
                    ],
                    "common_phrases": [
                        "groan of the floorboards",
                        "metallic groan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий скрипучий звук, вызванный давлением или весом.",
                        "cs": "Hluboký vrzavý zvuk způsobený tlakem nebo vahou."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрип",
                                "target_lang_sense_clarification": "дерева или конструкций"
                            },
                            {
                                "target_lang_word": "треск",
                                "target_lang_sense_clarification": "под нагрузкой"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "skřípění",
                                "target_lang_sense_clarification": "zvuk tření nebo namáhání materiálu"
                            },
                            {
                                "target_lang_word": "praskání",
                                "target_lang_sense_clarification": "zvuk namáhaného dřeva nebo konstrukce"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}