                        "glosses": [
                            "Tout petit monstre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a48708b-83be-4b60-971d-ae761a8852a2",
                                "sense_id": "b6f709d2-e01c-3c12-87c8-4217b56846a8",
                                "text": "C’est peu de dire qu’elles sont farouches : à peine laissent-elles, pour respirer, dépasser un quart de seconde en surface leur museau de mini-monstres du Secondaire."
                            },
                            {
                                "example_id": "00ab7716-4868-40e4-824c-5999aa74f5c4",
                                "sense_id": "b6f709d2-e01c-3c12-87c8-4217b56846a8",
                                "text": "Derrière nous, un aquarium où des poissons bizarres, de mini-monstres marins, évoluent, soulignant par leurs volte-face tantôt gracieuses, tantôt violentes le sens et le style du texte."
                            },
                            {
                                "example_id": "a9eb85ec-bb9b-4aad-a9d4-6df7cb2bc27a",
                                "sense_id": "b6f709d2-e01c-3c12-87c8-4217b56846a8",
                                "text": "Ainsi, sous nos latitudes tempérées, lorsque les ruches sont populeuses, ces mini-monstres pullulent de concert – jusqu’à 5 000 par colonie !"
                            }
                        ]
                    }
