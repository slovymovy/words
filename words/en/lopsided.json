{
    "word_family": [
        "lop"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa3e6c88-8fb4-30b2-964d-8ea5022b099f",
                    "sense_definition": "Having one side lower, smaller, or less heavy than the other; not symmetrical or balanced.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imbalance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house had a <w>lopsided</w> roof that looked like it might collapse.",
                            "target_lang_translations": {
                                "cs": "Starý dům měl <w>nesouměrnou</w> střechu, která vypadala, že se může zřítit."
                            }
                        },
                        {
                            "text": "She walked with a <w>lopsided</w> grin after the dental procedure.",
                            "target_lang_translations": {
                                "cs": "Po stomatologickém zákroku se usmívala <w>křivým</w> úsměvem."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneven",
                        "asymmetrical",
                        "unbalanced"
                    ],
                    "antonyms": [
                        "symmetrical",
                        "balanced"
                    ],
                    "common_phrases": [
                        "lopsided grin",
                        "lopsided smile"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající jednu stranu nižší, menší nebo méně těžkou než druhou; nesymetrický nebo nevyvážený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nesouměrný",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek symetrie ve tvaru nebo vzhledu"
                            },
                            {
                                "target_lang_word": "nevyvážený",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek rovnováhy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bac36a3-567a-3703-9195-9d2050a3f11f",
                    "sense_definition": "Favoring one side or point of view over another; lacking fairness or equality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imbalance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game ended in a <w>lopsided</w> victory for the home team.",
                            "target_lang_translations": {
                                "cs": "Zápas skončil <w>jednoznačným</w> vítězstvím domácího týmu."
                            }
                        },
                        {
                            "text": "The committee reached a <w>lopsided</w> decision that ignored the minority opinion.",
                            "target_lang_translations": {
                                "cs": "Výbor dospěl k <w>neobjektivnímu</w> rozhodnutí, které ignorovalo názor menšiny."
                            }
                        }
                    ],
                    "synonyms": [
                        "biased",
                        "unequal",
                        "unfair"
                    ],
                    "antonyms": [
                        "fair",
                        "impartial"
                    ],
                    "common_phrases": [
                        "lopsided victory",
                        "lopsided score"
                    ],
                    "target_lang_definitions": {
                        "cs": "Upřednostňující jednu stranu nebo úhel pohledu před druhým; postrádající spravedlnost nebo rovnost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neobjektivní",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek nestrannosti v rozhodování"
                            },
                            {
                                "target_lang_word": "zaujatý",
                                "target_lang_sense_clarification": "vyjadřuje nespravedlivé stranění jedné straně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}