                                    },
                                    {
                                        "sense_id": "181dfa34-6140-3990-b557-3d4323bca98e",
                                        "entry_id": "d3c919fc-1c2d-3cdc-a051-f71c326499c4",
                                        "glosses": [
                                            "Serving a useful purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13b45e86-feaf-3ec5-9c3f-e52bdf90bf30",
                                        "entry_id": "d3c919fc-1c2d-3cdc-a051-f71c326499c4",
                                        "glosses": [
                                            "Deemed after the fact to exist or to have occurred, despite the formal process not having been followed; often when there was no intention to do so at the time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f6d200-dd64-4b5a-a7de-07cd356dbb70",
                                                "sense_id": "13b45e86-feaf-3ec5-9c3f-e52bdf90bf30",
                                                "text": "constructive dismissal"
                                            },
                                            {
                                                "example_id": "fcd9250f-e745-455a-9dd4-87bc96e8b0ed",
                                                "sense_id": "13b45e86-feaf-3ec5-9c3f-e52bdf90bf30",
                                                "text": "constructive notice"
                                            },
                                            {
                                                "example_id": "4241b901-df8e-4643-860b-a419054043ad",
                                                "sense_id": "13b45e86-feaf-3ec5-9c3f-e52bdf90bf30",
                                                "text": "constructive trust"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a48d902-2b56-33ec-bf67-9131b1e1ddf6",
                                        "entry_id": "d3c919fc-1c2d-3cdc-a051-f71c326499c4",
                                        "glosses": [
                                            "Not direct or expressed, but inferred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca8643a-68cf-42b4-ba76-750bede61f6b",
                                                "sense_id": "7a48d902-2b56-33ec-bf67-9131b1e1ddf6",
                                                "text": "A President's power begins slipping away the moment it is known that he is going to leave: I had seen that in 1952, in 1960, in 1968. On the eve of my resignation I knew that my role was already a symbolic one, and that Gerald Ford's was now the constructive one. My telephone calls and meetings and decisions were now parts of a prescribed ritual aimed at making peace with the past; his calls, his meetings, and his decisions were already the ones that would shape America's future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf09ef1f-85b9-4d1e-8a5d-3196e2350a5f",
                        "source_entry_id": "a85b13ee-1fcb-35b2-9668-9d155c5cb773",
                        "source_sense_id": "4090b07b-0819-3e7d-abb8-bcfe9d3956d2",
                        "source_sense_description": "opbouwend",
                        "target_lang_word": "constructif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constructif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47de357a-7e17-3557-a402-83d3cc04161a",
                                        "entry_id": "ac78088c-b511-3d0b-9059-7342f588d237",
                                        "glosses": [
                                            "Qui tend vers un résultat positif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d9ce5c-32d9-4cd6-821a-04909326f82f",
                                                "sense_id": "47de357a-7e17-3557-a402-83d3cc04161a",
                                                "text": "Nous accepterons de bonne grâce toute critique raisonnée et suggestion constructive de ceux qui auront bien voulu utiliser ce volume."
                                            },
                                            {
                                                "example_id": "a19143f7-f914-4494-b083-b57c7c089b2a",
                                                "sense_id": "47de357a-7e17-3557-a402-83d3cc04161a",
                                                "text": "S’ils détestent les organisations pyramidales, les silos, les chefs control freak, ils veulent des manageurs qui fédèrent le collectif, en étant constructifs et attentifs à chacun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ab0929-3d0c-3e75-88dd-a2845ff53ae7",
                                        "entry_id": "ac78088c-b511-3d0b-9059-7342f588d237",
                                        "glosses": [
                                            "Relatif au constructivisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b406957-a135-4e28-84b3-4f17ecf17b13",
                                                "sense_id": "b9ab0929-3d0c-3e75-88dd-a2845ff53ae7",
                                                "text": "La conception constructive ne multiplie pas la mathématique classique mais au contraire l’enrichit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4671b87b-64ec-37ae-a38e-5b3d14c5baf7",
                                        "entry_id": "ac78088c-b511-3d0b-9059-7342f588d237",
                                        "glosses": [
                                            "Relatif à la construction (génie civil, architecture, technique, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de621488-b6c1-4b0d-b727-5a1275218ba0",
                                                "sense_id": "4671b87b-64ec-37ae-a38e-5b3d14c5baf7",
                                                "text": "Les pompes ainsi que le volume de la chambre ont été dimensionnés de manière à ce qu’un futur raccordement du hameau de Fillistorf soit possible sans modification constructive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constructif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd1d19e4-2b7d-3196-aa3e-f464a5dc4cd4",
                                        "entry_id": "5bbe8a7c-c587-3c30-b022-156140ab9caa",
                                        "glosses": [
                                            "Ce qui devrait être susceptible de procurer peut-être un résultat plutôt positif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676724e9-29eb-4744-a80f-299f4dc74a57",
                                                "sense_id": "cd1d19e4-2b7d-3196-aa3e-f464a5dc4cd4",
                                                "text": "On sait que ces hautes spéculations philosophiques sont les passe-temps habituels des humanistes diplômés. Vous rencontrez aujourd'hui dans Paris des outres gonflées de vent qui vous disent sur tous les tons : du constructif. Je veux du constructif. Le constructif, il n'y a que cela de vrai. Et ils ne construisent rien, sinon dans le ciel des idées et encore dans un ciel bien inférieur. Ils ne construisent rien, ils ne construiront jamais rien. Ils ont l'appétit du constructif, comme d'autres cherchent partout l'originalité, ce qui est le signe certain qu'ils n'en ont aucune. Curieuse maladie."
                                            },
                                            {
                                                "example_id": "fd555d4f-a48c-4379-a2bc-d95f2b34f1ca",
                                                "sense_id": "cd1d19e4-2b7d-3196-aa3e-f464a5dc4cd4",
                                                "text": "Sophie, la trésorière, fille de Mai 68 et du MLF, s'indigna :\n— De toute façon, ça n'a rien à voir avec qui couche Maryse ! Elle a raison, il faut passer à du constructif !\n— Du constructif ! Qu'est-ce que ça veut dire ? s'emporta Stéphane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29e4e459-2c67-4897-94b3-eb17a7ace4b6",
                        "source_entry_id": "a85b13ee-1fcb-35b2-9668-9d155c5cb773",
                        "source_sense_id": "4090b07b-0819-3e7d-abb8-bcfe9d3956d2",
                        "source_sense_description": "opbouwend",
                        "target_lang_word": "constructivo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constructivo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c23615-a67a-3d9e-847e-2755b371685a",
                                        "entry_id": "45471587-3a64-3871-ac21-513c56508d05",
                                        "glosses": [
                                            "Que pertenece o concierne a la construcción, o que es útil para construir, edificar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676e4e76-db6d-4072-95e2-d0769c534d4d",
                                                "sense_id": "a3c23615-a67a-3d9e-847e-2755b371685a",
                                                "text": "Todo esto es lo que todavía hoy en día se puede comprobar cuando se derriba una vivienda antigua, algunas de las cuales parecen auténticos palimsestos por la variedad de materiales constructivos superpuestos"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5ad6767-a143-3c3b-9cce-d1430f72413b",
                                        "entry_id": "45471587-3a64-3871-ac21-513c56508d05",
                                        "glosses": [
                                            "Que promueve o ayuda a construir; que no destruye."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072ef255-a63b-495f-a8bd-b7f3f67d9288",
                                                "sense_id": "f5ad6767-a143-3c3b-9cce-d1430f72413b",
                                                "text": "Se puede tener una actitud constructiva incluso en momentos de crisis o épocas difíciles"
