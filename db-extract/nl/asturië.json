                                            {
                                                "example_id": "e21d5030-930c-4632-bd88-fcd58454533d",
                                                "sense_id": "9e41472e-94e1-35a1-be21-b507e289953f",
                                                "text": "To this day the Asturians say to each other \"Have a care. Asturias is Spain. The rest is Araby.\""
                                            }
                                        ]
