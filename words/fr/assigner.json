{
    "word_family": [
        "assignation",
        "assignat",
        "réassigner",
        "réassignation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25873563-ff03-328a-af9c-8397321a32f6",
                    "sense_definition": "Attribuer une tâche, une fonction, une place ou un rôle spécifique à quelqu'un ou à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le responsable du projet a préféré <w>assigner</w> les tâches les plus complexes aux ingénieurs expérimentés."
                        },
                        {
                            "text": "Le ministre a décidé d'<w>assigner</w> cette nouvelle équipe de recherche à la protection de l'environnement."
                        }
                    ],
                    "synonyms": [
                        "attribuer",
                        "affecter"
                    ],
                    "common_phrases": [
                        "assigner une tâche",
                        "assigner un rôle",
                        "assigner à résidence"
                    ]
                },
                {
                    "sense_id": "3d9802ed-f915-32a1-844a-681755d5bda5",
                    "sense_definition": "Donner l'ordre à quelqu'un de comparaître devant un tribunal par un acte officiel délivré par un huissier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire menace d'<w>assigner</w> son locataire en justice s'il ne règle pas immédiatement ses loyers impayés."
                        },
                        {
                            "text": "Plusieurs consommateurs en colère ont décidé d'<w>assigner</w> le fabricant devant le tribunal civil pour escroquerie."
                        }
                    ],
                    "synonyms": [
                        "citer",
                        "attaquer",
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "assigner en justice",
                        "assigner à comparaître",
                        "assigner en référé"
                    ]
                },
                {
                    "sense_id": "5e2dd69b-77c9-36e4-8bf2-bb4b7738a851",
                    "sense_definition": "Affecter une valeur précise à une variable dans un programme informatique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développeur doit <w>assigner</w> une valeur entière à la variable avant d'exécuter la boucle principale."
                        },
                        {
                            "text": "Une erreur survient dès qu'on tente d'<w>assigner</w> un texte à une variable numérique dans ce programme."
                        }
                    ],
                    "synonyms": [
                        "affecter"
                    ],
                    "common_phrases": [
                        "assigner une valeur",
                        "assigner une variable"
                    ]
                },
                {
                    "sense_id": "34423ad6-fba8-3aa5-b2da-623060e6ee96",
                    "sense_definition": "Fixer ou déterminer de manière nette et précise, comme une cause, un terme ou une limite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les historiens peinent encore à <w>assigner</w> une cause unique à la chute soudaine de cet empire antique."
                        },
                        {
                            "text": "Le philosophe cherche à <w>assigner</w> des limites claires au pouvoir moral de la raison humaine."
                        }
                    ],
                    "synonyms": [
                        "déterminer",
                        "fixer"
                    ],
                    "common_phrases": [
                        "assigner une cause",
                        "assigner des limites"
                    ]
                },
                {
                    "sense_id": "9770ebe1-ca38-3ee0-a4ca-c6eca7b6124e",
                    "sense_definition": "Attribuer une mention de sexe ou de genre à une personne à sa naissance dans les registres de l'état civil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines personnes ne s'identifient pas au genre qui leur a été <w>assigné</w> lors de leur déclaration de naissance."
                        },
                        {
                            "text": "Lors de la déclaration, l'officier d'état civil a <w>assigné</w> le sexe féminin au nouveau-né."
                        }
                    ],
                    "synonyms": [
                        "attribuer"
                    ],
                    "common_phrases": [
                        "assigner à la naissance"
                    ]
                },
                {
                    "sense_id": "19c94773-284e-3e1a-8941-58c63b00e335",
                    "sense_definition": "Affecter des fonds ou des revenus particuliers au paiement d'une créance, d'une pension ou d'une dette.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le débiteur a promis d'<w>assigner</w> une part de ses revenus fonciers au remboursement intégral de sa dette."
                        },
                        {
                            "text": "L'administration a décidé d'<w>assigner</w> le paiement de cette rente viagère sur les réserves du trésor."
                        }
                    ],
                    "synonyms": [
                        "affecter"
                    ],
                    "common_phrases": [
                        "assigner un fonds",
                        "assigner une rente"
                    ]
                }
            ]
        }
    ]
}