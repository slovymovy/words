                "senses": [
                    {
                        "sense_id": "577ac50c-8e79-34af-b8a2-96a899e0aee3",
                        "entry_id": "6fda9c5b-051d-30fa-9c4f-7d285de80e33",
                        "glosses": [
                            "A female benefactor."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bdd0f3bf-9c1a-4700-bb00-26bc77e2cce5",
                                "sense_id": "577ac50c-8e79-34af-b8a2-96a899e0aee3",
                                "text": "Oh, youthful benefactress! how often in succeeding years, standing in solitary places, and thinking of thee with grief of heart and perfect love—how often have I wished that, as in ancient times, the curse of a father was believed to have a supernatural power, and to pursue its object with a fatal necessity of self-fulfilment; even so the benediction of a heart oppressed with gratitude might have a like prerogative, might have power given to it from above to chase, to haunt, to waylay, to overtake, to pursue thee into the central darkness of a London brothel, or (if it were possible) into the darkness of the grave, there to awaken thee with an authentic message of peace and forgiveness, and of final reconciliation!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61b5503e-72e5-40d2-b8d6-669cf7d66b75",
                        "source_entry_id": "6fda9c5b-051d-30fa-9c4f-7d285de80e33",
                        "source_sense_id": "577ac50c-8e79-34af-b8a2-96a899e0aee3",
                        "source_sense_description": "female benefactor",
                        "target_lang_word": "weldoenster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weldoenster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d0881a4e-bc5b-3a1d-a6d7-7d6faaa86a22",
                                        "entry_id": "d9cd9f0b-bfd1-3f5f-9278-fb7176eb5052",
                                        "glosses": [
                                            "vrouw die andere mensen helpt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65175a1d-17cb-4fd0-b2c3-e803192ac099",
                                                "sense_id": "d0881a4e-bc5b-3a1d-a6d7-7d6faaa86a22",
                                                "text": "En als die brief en het testament niet zijn vernietigd, dan blijft er voor jou, behalve de troost dat je een weldoenster bent geweest et tout ce qui sénBuit, helemaal niets over."
                                            },
                                            {
                                                "example_id": "6096b522-a418-47c2-8073-452fb5cb7cc6",
                                                "sense_id": "d0881a4e-bc5b-3a1d-a6d7-7d6faaa86a22",
                                                "text": "Basel had tot 2012 de financiële ondersteuning van Gisela Oeri, die wordt beschouwd als de rijkste vrouw van Zwitserland. Coach Christian Gross maakte destijds dankbaar gebruik van de weldoenster. Maar mevrouw Oeri vond het na 2012 welletjes en ondersteunt nu alleen de jeugdopleiding nog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b8158a5-c9fd-4506-aafc-02852d8a69f8",
                        "source_entry_id": "6fda9c5b-051d-30fa-9c4f-7d285de80e33",
                        "source_sense_id": "577ac50c-8e79-34af-b8a2-96a899e0aee3",
                        "source_sense_description": "female benefactor",
                        "target_lang_word": "Wohltäterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohltäterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5d2602-e865-33f0-b757-8620306e5a5f",
                                        "entry_id": "be4f4625-0581-3356-8980-99ee3f5b6969",
                                        "glosses": [
                                            "jemand, der gutes tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b443e4-aa6f-49f4-92f1-1f74e4b27d07",
                                                "sense_id": "bd5d2602-e865-33f0-b757-8620306e5a5f",
                                                "text": "Sissi, die österreichische Kaiserin, ist auch als Wohltäterin im Volk bekannt."
                                            },
                                            {
                                                "example_id": "cd036abb-4333-4738-bdce-ef7cb25b487e",
                                                "sense_id": "bd5d2602-e865-33f0-b757-8620306e5a5f",
                                                "text": "„Der kalte Manager ist nur halb so kalt, wird er von Veronica Ferres umarmt. Die Frauen, diese warmherzigen Wohltäterinnen des Landes, suchen sich gezielt jene Männer aus, deren Ruf am heftigsten beschädigt ist. Sie irritieren den unbarmherzigen Blick auf das Gewinnstreben ihrer Partner.“"
                                            },
                                            {
                                                "example_id": "3fe74460-51c4-40c0-94da-a425d5a80d11",
                                                "sense_id": "bd5d2602-e865-33f0-b757-8620306e5a5f",
                                                "text": "„Die Urkunde verpflichtet die Beschenkten, die Glocke regelmäßig zu läuten und der frommen Wohltäterin im Gebete zu gedenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7606cd13-451c-4fc7-81e4-8003e6b9ed1a",
