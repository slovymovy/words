                        "translation_id": "21411c54-ab52-41e0-8f11-51ee6341fccb",
                        "source_entry_id": "3937abdd-62ea-37b2-b85f-a117cf37fc54",
                        "source_sense_description": "of, relating to, or contemplating the past",
                        "target_lang_word": "rétrospectif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétrospectif",
