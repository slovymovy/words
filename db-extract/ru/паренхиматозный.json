                ],
                "senses": [
                    {
                        "sense_id": "4cb5b4a8-13c4-302d-944c-98a3ddff7390",
                        "entry_id": "d38207e1-416f-3b67-a0cb-a60ca0c71252",
                        "glosses": [
                            "биол., мед. связанный с паренхимой, состоящий из паренхимы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3414e56d-6f67-469f-99f6-f0990e69bab1",
                                "sense_id": "4cb5b4a8-13c4-302d-944c-98a3ddff7390",
                                "text": "К осложнениям паренхиматозного кератита относятся иридоциклит, иногда с гипертензией, и передний хориоретинит."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cf56498-747d-3a1b-9924-2655369accce",
                        "entry_id": "d38207e1-416f-3b67-a0cb-a60ca0c71252",
                        "glosses": [
                            "биол., мед. то же, что паренхиматический"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "98c20cb3-d246-3fde-af60-6a012f82722f",
                        "entry_id": "d38207e1-416f-3b67-a0cb-a60ca0c71252",
                        "glosses": [
                            "мед. относящийся к пищеварению, осуществляющемуся плазмой клеток"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2c63de8-b631-4a38-b82f-2c5314af0fed",
                        "source_entry_id": "d38207e1-416f-3b67-a0cb-a60ca0c71252",
                        "target_lang_word": "parenchymatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parenchymatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "573dda2b-a7fc-3d37-b9cb-bb8a6962b290",
                                        "entry_id": "cfbb7488-8dc9-37b9-8000-82f6b25339ec",
                                        "glosses": [
                                            "Parenchym- oder Grundgewebe betreffend"
                                        ],
                                        "tags": [
                                            "Histologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a60af27-cef5-4dff-a244-01e92683eab7",
                                                "sense_id": "573dda2b-a7fc-3d37-b9cb-bb8a6962b290",
                                                "text": "„Als parenchymatisch wird man im allgemeinen solche Zellen bezeichnen, die nicht prosenchymatisch, d. h., nicht in einer Richtung des Raumes besonders stark gestreckt sind.“"
                                            },
                                            {
                                                "example_id": "b8b897d2-1cba-484c-b7e3-641b73853ff1",
                                                "sense_id": "573dda2b-a7fc-3d37-b9cb-bb8a6962b290",
                                                "text": "„Die Rindenzellen sind parenchymatisch, normalerweise chlorophyllfrei (nur bei den Luftwurzeln können sie Chloroplasten enthalten) und dienen, vor allem in den älteren Teilen der Wurzel, als Speichergewebe.“"
                                            },
                                            {
                                                "example_id": "02ee1b80-d4af-44be-bf08-9dbe1273d08a",
                                                "sense_id": "573dda2b-a7fc-3d37-b9cb-bb8a6962b290",
                                                "text": "„Nach Schober's Untersuchungen ist der Vorgang der Entstehung des Xanthorrhöaharzes complicirter, als die früheren Beobachter (Wigand, Wiesner) meinten, indem im Inhalte parenchymatisch aussehender, später zu Sklerenchymzellen werdender Elemente sich gelbe Harztropfen bilden, welche in rothe Harzmassen übergehen; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
