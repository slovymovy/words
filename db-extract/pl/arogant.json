                                        "glosses": [
                                            "chi, senza la competenza esatta, vuole guidare più persone che infatti non ne accolgono la presenza e che, in modo ostinato, approfitta di una presunta posizione di rilievo"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
