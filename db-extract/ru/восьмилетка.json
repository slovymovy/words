                        "glosses": [
                            "одуш., разг. ребёнок в возрасте восьми лет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4742cce3-d6fb-49be-89e9-60ffe81577ef",
                                "sense_id": "16ab3e84-258e-3412-8d27-48511d3da087",
                                "text": "Особенно огорчали меня стихи восьмилеток ― грамотных, благонравных детей〈…〉"
                            }
                        ]
