                                        "examples": [
                                            {
                                                "example_id": "2ff9ea1f-8570-42e7-828f-dc180967de18",
                                                "sense_id": "4466884f-42e2-3caa-a960-63a0ee4139ea",
                                                "text": "Die Villa liegt ein wenig abseits."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8833cfdb-ad0d-3dd7-b0bc-507b0f7307ac",
                                        "entry_id": "3a01445f-198e-318d-99cb-d518b95e70d2",
                                        "glosses": [
                                            "lokales Adverb, Fußball: eine spezielle Situation beim Fußballspiel, die zu einer Unterbrechung des Angriffes und zu einem Freistoß für die verteidigende Mannschaft führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd03662-05b0-434d-946d-a0677ec0ec75",
                                                "sense_id": "8833cfdb-ad0d-3dd7-b0bc-507b0f7307ac",
                                                "text": "Der rechte Außenstürmer stand abseits."
                                            }
