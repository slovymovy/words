                        "examples": [
                            {
                                "example_id": "db13aa65-170e-4d98-b577-70fd6e182660",
                                "sense_id": "0472382e-55d0-3950-b42c-2a6dc8f1c134",
                                "text": "Un bon trotteur."
                            },
                            {
                                "example_id": "9087e6a3-bbd8-42f6-8aa6-8c305785d03b",
                                "sense_id": "0472382e-55d0-3950-b42c-2a6dc8f1c134",
                                "text": "Ce cheval est bon trotteur, mauvais trotteur, Il trotte bien ou mal."
                            }
                        ]
                    },
                    {
                        "sense_id": "b23cbc9f-1bb9-37f5-a7ee-d9aeaab280c9",
                        "entry_id": "26562cb7-7f75-3b4c-a8ea-9603aa529581",
                        "glosses": [
                            "Trotteur français."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b3fe974c-653c-4ee6-9200-31f38ef6fcc0",
                                "sense_id": "b23cbc9f-1bb9-37f5-a7ee-d9aeaab280c9",
                                "text": "Le trotteur français Hooker Berry, drivé par le jockey Jean-Michel Bazire, a remporté avec brio le Prix d’Amérique, dimanche, à l’hippodrome de Vincennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c87893b0-9da7-34fe-b1a4-75029a021825",
                        "entry_id": "26562cb7-7f75-3b4c-a8ea-9603aa529581",
                        "glosses": [
                            "Matériel de puériculture roulant, à hauteur d’appui pour les jeunes enfants."
                        ],
                        "tags": [
                            "Puériculture"
                        ],
                        "examples": [
                            {
                                "example_id": "050e2896-184e-41ab-b0b2-1e0a50fbbf98",
                                "sense_id": "c87893b0-9da7-34fe-b1a4-75029a021825",
                                "text": "Constitué d’un cadre et d'une nacelle, le trotteur permet à l’enfant de 8 à 18 mois de se déplacer en position debout."
                            }
                        ]
                    }
