                "senses": [
                    {
                        "sense_id": "1d91f9a2-7069-38d0-9273-e930a1c31c7c",
                        "entry_id": "4971ae18-7de4-30d3-abfa-5370d24698fa",
                        "glosses": [
                            "Association naturelle ou provoquée par l'homme entre champignons mycorhiziens et racines d'une plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d711fcd-9801-454a-8c66-a1e53e95dde7",
                                "sense_id": "1d91f9a2-7069-38d0-9273-e930a1c31c7c",
                                "text": "La truffe ne peut accomplir son cycle complet qu'avec une plante-hôte, comme un chêne ou un noisetier, la mycorhization permet aujourd'hui de produire des plants truffiers à grande échelle."
                            },
                            {
                                "example_id": "b15abd25-6a4f-4bb4-9f27-e5b5e84c2bf4",
                                "sense_id": "1d91f9a2-7069-38d0-9273-e930a1c31c7c",
                                "text": "La mycorhization n'est pas exclusivement symbiotique et les transferts de substances du champignon à la plante n'augmentent pas toujours sa valeur sélective, parfois l’un des partenaires semble même « exploiter » l'autre en obtenant un bénéfice sans réciprocité."
                            }
                        ]
                    }
                ],
