                        "glosses": [
                            "(Nord) (Pas-De-Calais) Tomber en roulant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a44a2c3-1906-4af9-b7c2-73e6be740f7c",
                                "sense_id": "9e4f4eaa-4e50-3798-8e00-aec69ff4e6e8",
                                "text": "Livide, il atteignit les tribunes et s’écroula dans les bras de Fanette :\n— On avait le souffle, Fanette ! … On avait le souffle, murmura-t-il. Et j’ai bourlé à cause de ce gros con ! … Maintenant, on est foutu !"
                            },
                            {
                                "example_id": "f27604b0-2662-4ce7-af36-74a4814067ec",
                                "sense_id": "9e4f4eaa-4e50-3798-8e00-aec69ff4e6e8",
                                "text": "Saint Paul est considéré comme le patron des bourleux car, disait-on, il a bourlé de son cheval sur le chemin de Damas (Actes des Apôtres 9, 3-9) …"
                            }
                        ]
                    }
