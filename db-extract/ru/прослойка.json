                    {
                        "translation_id": "7a55a015-d4b9-46b7-9c91-57cf44d4755b",
                        "source_entry_id": "a3463c55-40cf-3163-a670-278dc9dd7980",
                        "target_lang_word": "stratum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "One of several parallel horizontal layers of material arranged one on top of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7ca724-2743-45a2-a2e4-de8c78237809",
                                                "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                                                "text": "It is built of alternate strata of brick and clay, and the sides correspond to the direction of the meridians and parallels."
                                            },
                                            {
                                                "example_id": "d01e2362-de87-400f-bc3f-01fc32206676",
                                                "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d8e5342-2812-31df-b56c-024140fac72d",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "A layer of sedimentary rock having approximately the same composition throughout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825a6295-4017-4d43-b0be-a5f68bc560d0",
                                                "sense_id": "4d8e5342-2812-31df-b56c-024140fac72d",
                                                "text": "An illuminating article in a recent issue of the Eastern Region's Civil Engineering News points out that where coal is worked over a reasonably large area, it is not only the whole of the strata above the workings, but also an area beyond which is liable to subside at varying rates after the coal has been removed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065582c9-4255-3f9c-870c-84da1c8d1b48",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "Any of the regions of the atmosphere, such as the stratosphere, that occur as layers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03e6aea4-930e-3acb-be26-d8bd5a7f3260",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
