                "senses": [
                    {
                        "sense_id": "bf913da2-eb64-3339-9676-d95fd2e3b33a",
                        "entry_id": "fb702319-a1ba-32b6-9b47-ddde658c7cd3",
                        "glosses": [
                            "grafisches Druckverfahren, bei dem Zeichnungen in Kupferplatten eingeritzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4055ba-207a-41ed-b79a-f3d012cf920f",
                                "sense_id": "bf913da2-eb64-3339-9676-d95fd2e3b33a",
                                "text": "„Die älteste Technik der Druckgrafik ist der Holzschnitt. Seiner Erfindung folgte noch vor der Mitte des 15. Jahrhunderts als erstes Metallschnittverfahren der Kupferstich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "925a29dd-a3f8-3cdc-bd25-d23cc5350438",
                        "entry_id": "fb702319-a1ba-32b6-9b47-ddde658c7cd3",
                        "glosses": [
                            "durch [1] hergestelltes Kunstwerk, per Kupferstich bearbeitetes Blatt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6de7184a-6a2f-420e-b480-e4a6fc288135",
                                "sense_id": "925a29dd-a3f8-3cdc-bd25-d23cc5350438",
                                "text": "„Ein um die Mitte des 16. Jahrhunderts publizierter Kupferstich, der nach einer der überlieferten Versionen des Bildes angefertigt wurde, erläutert die Handlung und warnt vor all den Gaunern, die es auf der Welt gibt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
