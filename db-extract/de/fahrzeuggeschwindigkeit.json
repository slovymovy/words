                "senses": [
                    {
                        "sense_id": "a77c2f26-5592-3c9d-944d-1fbd476b91fb",
                        "entry_id": "faf37299-bf10-3a2c-b3f8-8d5ea9449970",
                        "glosses": [
                            "Geschwindigkeit, mit sich ein Fortbewegungsmittel/Fahrzeug bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106a9539-ee34-4a41-bb8f-2294361e3994",
                                "sense_id": "a77c2f26-5592-3c9d-944d-1fbd476b91fb",
                                "text": "„Die Fahrzeuggeschwindigkeit gilt als der größte Einflussfaktor auf das Unfallrisiko.“"
                            },
                            {
                                "example_id": "ec5c7888-87cf-46c6-a6f7-7e91200182ee",
                                "sense_id": "a77c2f26-5592-3c9d-944d-1fbd476b91fb",
                                "text": "„Für die weiteren Rechnungen muss als nächster Schritt der Zusammenhang zwischen Motordrehzahl und Fahrzeuggeschwindigkeit hergestellt werden.“"
                            },
                            {
                                "example_id": "37e590d8-8f21-46a4-a62b-31118d29baa7",
                                "sense_id": "a77c2f26-5592-3c9d-944d-1fbd476b91fb",
                                "text": "„Die Fahrzeuggeschwindigkeit wird automatisch geregelt und dabei vorausschauend an gesetzliche Höchstgeschwindigkeiten und den Streckenverlauf angepasst.“"
                            },
                            {
                                "example_id": "e50eb692-dcd2-466a-bd2b-c6fe8342e7bb",
                                "sense_id": "a77c2f26-5592-3c9d-944d-1fbd476b91fb",
                                "text": "„Um Fahrzeuggeschwindigkeiten flächendeckend zu erfassen, ist eine Vielzahl von Straßensensoren nötig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
