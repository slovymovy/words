                    }
                ],
                "translations": [
                    {
                        "translation_id": "63bc3ffa-e5b4-4f4f-b28a-c62d64718686",
                        "source_entry_id": "84e46217-7400-3cd1-ab27-e045fc60677d",
                        "source_sense_id": "0cbf7cb8-83dd-39ac-814d-e5bff3dedaba",
                        "source_sense_description": "ein regelwidriger, idiotisch gesetzter Apostroph",
                        "target_lang_word": "greengrocer's apostrophe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greengrocer's apostrophe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "646637de-8672-3984-ac4c-3a063b9acdce",
                                        "entry_id": "071a935b-24c1-32e1-bb4e-7ec12881def8",
                                        "glosses": [
                                            "An incorrectly used apostrophe; (especially) one mistakenly used to form the plural of a noun, for example: writing the plural of banana as banana's (a possessive) instead of bananas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca00ace8-da50-47e4-938b-ef703112f5c5",
                                                "sense_id": "646637de-8672-3984-ac4c-3a063b9acdce",
                                                "text": "[A] flashing neon sign advertising the Pari's Hotel is less an early case of greengrocer's apostrophe than a sardonic Pascalian allusion (pari in French meaning 'bet')."
                                            },
                                            {
                                                "example_id": "b7db28f6-2b8c-4e70-a985-593f8d44aa67",
                                                "sense_id": "646637de-8672-3984-ac4c-3a063b9acdce",
                                                "text": "It is hardly surprising that these conventions seem to be in rapid collapse, with what has been called \"the greengrocer's apostrophe\" (apple's 60p, Antique's, linguistic's, and perhaps even mean't, all personally attested) […]"
                                            },
                                            {
                                                "example_id": "c3713ffc-a795-4937-abe3-f6d74f2ac96f",
                                                "sense_id": "646637de-8672-3984-ac4c-3a063b9acdce",
                                                "text": "When applied in English it produces greengrocer's apostrophes."
                                            },
                                            {
                                                "example_id": "5558a560-a72e-4199-82ea-f31cc826684a",
                                                "sense_id": "646637de-8672-3984-ac4c-3a063b9acdce",
                                                "text": "The Deppenapostroph is not to be confused with the English greengrocer’s apostrophe, when an apostrophe before an ‘s’ is mistakenly used to form the plural of a noun (“a kilo of potato’s”)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4158d62-0824-4ec9-9e08-6c5647ff71b7",
