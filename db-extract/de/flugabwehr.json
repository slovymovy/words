                "senses": [
                    {
                        "sense_id": "cd706e06-081a-3c1c-abea-fa0d20bdcc53",
                        "entry_id": "2de624e2-50d4-3e41-af56-599ac3660e9d",
                        "glosses": [
                            "Maßnahmen zur Abwehr feindlicher Luftfahrzeuge und Flugkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea045a2f-0feb-4dd8-877e-fddc18e99f63",
                                "sense_id": "cd706e06-081a-3c1c-abea-fa0d20bdcc53",
                                "text": "„Die syrische Flugabwehr habe israelische Raketen abgefangen.“"
                            },
                            {
                                "example_id": "0cdd5418-7568-4837-906a-1065334a08a9",
                                "sense_id": "cd706e06-081a-3c1c-abea-fa0d20bdcc53",
                                "text": "„Noch heute rätseln sowjetische Generäle, wie es dem Hobbyflieger gelingen konnte, völlig ungehindert mehrere Stunden im sowjetischen Luftraum zu verbringen, ohne dass ihn die Flugabwehr zur Landung zwang - mitten im Kalten Krieg.“"
                            },
                            {
                                "example_id": "5980e515-f342-432e-88cf-ae2d4ad923cb",
                                "sense_id": "cd706e06-081a-3c1c-abea-fa0d20bdcc53",
                                "text": "„Die Schiffe, die Putin zum G-20-Gipfel vor Australien kreuzen ließ, gehören eher zum alten Eisen; die Bomber, die Verteidigungsminister Sergej Schojgu künftig im Golf von Mexiko und in der Karibik fliegen lassen will, wären im Ernstfall ein leichtes Opfer der amerikanischen Flugabwehr, wenn sie nicht von Kampffliegern begleitet würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
