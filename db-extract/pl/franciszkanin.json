                                        "entry_id": "b147e6a0-7a63-3c28-9580-d1f3f9928165",
                                        "glosses": [
                                            "Relatif à l’ordre religieux des frères mineurs fondé par François d'Assise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fdf6a72-b764-4eaf-8082-17dae19a778a",
                                                "sense_id": "2e850bf4-d4f7-37b0-a06f-4575a6c2ec4a",
                                                "text": "Il est très pieux, est devenu tertiaire franciscain […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d570f6-4d36-3215-9f9d-b7d3fc3ac5f8",
