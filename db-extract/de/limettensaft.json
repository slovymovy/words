                "senses": [
                    {
                        "sense_id": "9927e5dd-75b8-3d1d-b3f9-dc4b13907eb7",
                        "entry_id": "ab3f2c76-2710-32e1-b55a-133d841a0120",
                        "glosses": [
                            "Saft, der durch das Pressen von Limetten gewonnen wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb228944-8cbe-43ea-8971-889d2ceb75bc",
                                "sense_id": "9927e5dd-75b8-3d1d-b3f9-dc4b13907eb7",
                                "text": "Er trinkt jeden Morgen einen Limettensaft zum Frühstück."
                            },
                            {
                                "example_id": "0b99bee0-6a3a-43c2-9952-cd1299ebe7ea",
                                "sense_id": "9927e5dd-75b8-3d1d-b3f9-dc4b13907eb7",
                                "text": "„Die scharfe Säure der Limette eignet sich oft besser als die der milderen Zitrone dazu, Aromen zu kontrastieren und so erst herauszuarbeiten. Im Obstsalat kann das Wunder wirken. Und wer eine sahnige Mango mit wenigen Spritzern Limettensaft beträufelt, merkt erst, was sich aus der Tropenfrucht geschmacklich herausholen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
