                                        "sense_id": "a536cbc8-273b-3b70-8896-1262a851cf47",
                                        "entry_id": "9e75c733-4e78-3bbc-ab92-091c5bb8af2b",
                                        "glosses": [
                                            "la particella più piccola di un elemento presente in natura che può entrare in combinazione chimica. I composti chimici differiscono tra loro per la natura, il numero ed la disposizione dei loro atomi costituenti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1049d8f0-b469-4699-9bed-79d45af2e6f6",
                                                "sense_id": "a536cbc8-273b-3b70-8896-1262a851cf47",
                                                "text": "l'atomo è formato da tre particelle: protoni, neutroni, elettroni"
                                            },
                                            {
                                                "example_id": "418bf878-5c62-481f-aba4-dc8b01bab34e",
                                                "sense_id": "a536cbc8-273b-3b70-8896-1262a851cf47",
                                                "text": "il nucleo dell'atomo ha sempre carica positiva"
                                            },
                                            {
                                                "example_id": "2a911f1b-8568-46b1-b408-02f39ab362d1",
                                                "sense_id": "a536cbc8-273b-3b70-8896-1262a851cf47",
                                                "text": "l'atomismo concepiva gli atomi come parti puntiformi"
                                            },
                                            {
                                                "example_id": "e03cf801-56bc-4030-ade9-fb0315e3987e",
                                                "sense_id": "a536cbc8-273b-3b70-8896-1262a851cf47",
                                                "text": "Joseph John Thompson ha scoperto che nell'atomo si trovano gli elettroni"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
