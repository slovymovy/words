                                        "sense_id": "d361d069-2ef6-34b7-90ea-dc8eb7ac3f37",
                                        "entry_id": "ad1abc1b-2451-3819-96ad-1a88fe06a1ec",
                                        "glosses": [
                                            "A wind that blows directly against the course of a vehicle, like an aircraft, train, or ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c68fc909-6bca-3dcc-bcf7-ceaa13fd601f",
                                        "entry_id": "ad1abc1b-2451-3819-96ad-1a88fe06a1ec",
                                        "glosses": [
                                            "A strong force that impedes or reverses progress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c05742-3c68-4125-ba39-56ea3e77629b",
                                                "sense_id": "c68fc909-6bca-3dcc-bcf7-ceaa13fd601f",
                                                "text": "\"Domestic economic activity has been gaining traction in spite of formidable headwinds from external developments,\" the Reserve Bank of India (RBI) said in its monthly bulletin."
                                            },
                                            {
                                                "example_id": "51aebe89-942d-4b59-9289-d97d65d05554",
                                                "sense_id": "c68fc909-6bca-3dcc-bcf7-ceaa13fd601f",
                                                "text": "At the same time, Faludi, who is working on a new book about the headwinds feminism is facing, suggested that the movement itself has grown sectarian and insular."
                                            },
                                            {
                                                "example_id": "1980ca57-7719-4251-a4e7-2eda186d09b0",
                                                "sense_id": "c68fc909-6bca-3dcc-bcf7-ceaa13fd601f",
                                                "text": "“The increasing appetite for obesity drugs will have myriad implications, boosting sectors such as biotech and creating headwinds for industries such as food and beverage,” the bank’s report said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "headwind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32df3d14-c85b-3e1c-b8e0-cb9606be1fe4",
                                        "entry_id": "e068252a-279f-3086-bd17-9d957d7b17e5",
                                        "glosses": [
                                            "To blow directly against the course of a vehicle, like an aircraft, train, or ship."
                                        ],
                                        "tags": [
                                            "transitive",
