                                        "entry_id": "c45c3f8e-c2fc-3a17-8a5f-1d3a1d0bbdd9",
                                        "glosses": [
                                            "bezinteresowna chęć służenia innym ludziom, poświęcenia się ich sprawom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc86fc8-f72a-448d-9226-7224a8474c6c",
                                                "sense_id": "4813e6ea-f1f9-3ac7-b9ca-5ebd83bb52c7",
                                                "text": "Doktor Judym z „Ludzi bezdomnych” charakteryzuje się altruizmem."
                                            }
