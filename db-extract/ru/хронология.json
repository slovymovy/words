                        "source_entry_id": "10846709-e665-3fe0-8514-505e24d63bda",
                        "source_sense_description": "историческая дисциплина",
                        "target_lang_word": "Chronologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chronologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cd51801-183f-3615-822b-0e28daf4951f",
                                        "entry_id": "ad78a518-d878-3413-8f1a-4a2063711903",
                                        "glosses": [
                                            "Zeitmessung, Zeitrechnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc639c2-471e-466a-8d3e-e7dd86fc6d80",
                                                "sense_id": "8cd51801-183f-3615-822b-0e28daf4951f",
                                                "text": "Die frühere Chronologie unterscheidet sich von der heutigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                        "entry_id": "ad78a518-d878-3413-8f1a-4a2063711903",
                                        "glosses": [
                                            "zeitliche Abfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ff7d19-07f3-4a2d-b132-5cf2cc0c22c2",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "„Die Chronologie der Lexikografie im deutschsprachigen Raum setzt im frühen Mittelalter ein.“"
                                            },
                                            {
                                                "example_id": "d3527004-bc87-4d41-b84f-524a582f377e",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "Die genaue Chronologie der Ereignisse war nicht aufzuklären."
                                            },
                                            {
                                                "example_id": "03531746-ce91-439f-a642-6d7d611a3095",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "„Die beste Möglichkeit einer Geschichtsschreibung nach mathematischem Vorbild sah Leibniz in der Chronologie und in der Genealogie.“"
                                            },
                                            {
                                                "example_id": "0899ddde-5ec4-4eb2-8398-f4a56ae7e0bc",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "„Ich wurde müder und müder, mühte mich um die Chronologie der Ereignisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a026e8d-0ce5-302f-a63c-fba8460ca1e1",
                                        "entry_id": "ad78a518-d878-3413-8f1a-4a2063711903",
                                        "glosses": [
                                            "Wissenschaft der Zeitmessung, -rechnung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde4b369-a8c4-46e3-bc86-644c08a7f140",
                                                "sense_id": "3a026e8d-0ce5-302f-a63c-fba8460ca1e1",
                                                "text": "Die Chronologie bemüht sich um eine möglichst präzise Bestimmung der Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
