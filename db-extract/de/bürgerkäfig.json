                        "examples": [
                            {
                                "example_id": "a309b2e9-6d19-4d5c-af7b-d0032ca1ca6a",
                                "sense_id": "261b8504-ba92-3573-8caf-20f4694a72d3",
                                "text": "Er setzte sich stolz in seinen neuen Bürgerkäfig und fuhr just weg, ohne sich zu verabschieden."
                            },
                            {
                                "example_id": "f3868153-fec6-40bb-bb70-1c26849ef015",
                                "sense_id": "261b8504-ba92-3573-8caf-20f4694a72d3",
                                "text": "Sein Auto sieht recht neu aus — im Vergleich zu dem alten Bürgerkäfig seines Großvaters."
                            },
                            {
                                "example_id": "bacf95aa-0a88-4057-8161-03ebd32a81de",
                                "sense_id": "261b8504-ba92-3573-8caf-20f4694a72d3",
                                "text": "Im Gegensatz zu den modernen Autos sahen die Fahrzeuge vor einem Jahrhundert tatsächlich aus wie Käfige — ob man sie wohl deshalb als \"Bürgerkäfige\" bezeichnete?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
