                        "glosses": [
                            "Qui peut être dépecé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ae9f1c-58d0-4dd9-b6fc-9149427f1be5",
                                "sense_id": "58519a1e-0841-373d-aa2d-8b2cf5b5ff4e",
                                "text": "Semblable était le roi des animaux : … tyran sans bornes, égoïste sans limites, rapportant tout à lui, prétendant droit sur tous et prise sur tout ; enfin, traitant son peuple, en sire féodal, de gent corvéable, mortable, taillable, dépeçable et mangeable à merci."
                            },
                            {
                                "example_id": "ca34adf6-56d5-418e-97a7-898b51540ed0",
                                "sense_id": "58519a1e-0841-373d-aa2d-8b2cf5b5ff4e",
                                "text": "Un livre, sitôt publié, devient dépeçable, calomniable, diffamable à merci : son écriture et sa structure, son sens évident et ses motivations cachées, tout est livré aux morsures, griffures, coups de bistouri, aux venimeuses piqûres de tout critique qui - parfois d’avance - n’aime pas ou l’auteur ou le genre ou le thème ou le style."
                            },
                            {
                                "example_id": "a69f15cc-d1d1-43be-9118-b51f3305a72e",
                                "sense_id": "58519a1e-0841-373d-aa2d-8b2cf5b5ff4e",
                                "text": "L’idée centrale est celle de l’effraction tantôt du corps conçu comme un territoire clos, tantôt du territoire physique ou moral conçu comme un corps dépeçable."
                            }
                        ]
                    }
