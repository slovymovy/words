                    {
                        "translation_id": "fbb4ad06-5e6c-41a7-a803-61a15dd5a2d4",
                        "source_entry_id": "107226ef-e46f-38a1-bbae-19a371ed4afe",
                        "source_sense_id": "39b4c485-71e1-3d9a-af96-29211bafd553",
