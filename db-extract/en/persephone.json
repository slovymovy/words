                "word": "Persephone",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b643e077-7cc8-3dd1-8dde-b3c3824eefcd",
                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                        "glosses": [
                            "A minor deity, the queen of the Underworld/Hades, and goddess of the seasons and vegetation. Originally named Kore/Core, she is the daughter of Zeus and Demeter; and the wife of Hades. Her Roman counterpart is Proserpina."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "feeaff1e-251f-30bd-8c09-46a7962f475d",
                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                        "glosses": [
                            "399 Persephone, a main belt asteroid."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c9809b03-304a-345f-a614-72daa1718d83",
                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "01fd3768-281b-49e8-add0-32fb97777f45",
                                "sense_id": "c9809b03-304a-345f-a614-72daa1718d83",
                                "text": "‘My name is Persephone’ she says, ‘but in England everyone calls me Seph.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee804d38-570d-326f-a918-71daf947d2b7",
                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                        "glosses": [
                            "The ninth or tenth planet, orbiting beyond Pluto."
                        ],
                        "tags": [],
                        "examples": []
                    }
