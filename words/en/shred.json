{
    "word_family": [
        "shredder",
        "shredding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28abcacd-b570-3cfc-a163-f4f56d8981f1",
                    "sense_definition": "A very small amount or fragment of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is not a <w>shred</w> of evidence to support his claims.",
                            "target_lang_translations": {
                                "cs": "Neexistuje ani <w>náznak</w> důkazu, který by podporoval jeho tvrzení."
                            }
                        },
                        {
                            "text": "The explosion blew the old building to <w>shreds</w>.",
                            "target_lang_translations": {
                                "cs": "Výbuch starou budovu rozmetal na <w>kusy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "scrap",
                        "particle",
                        "trace"
                    ],
                    "common_phrases": [
                        "shred of evidence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi malé množství nebo úlomek něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náznak",
                                "target_lang_sense_clarification": "používá se v přeneseném významu, např. u důkazů"
                            },
                            {
                                "target_lang_word": "kousek",
                                "target_lang_sense_clarification": "malý fragment nebo část něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ebca310-4bc5-36f3-9be7-6bbc9bd1b714",
                    "sense_definition": "A long, narrow strip of material, especially cloth or paper.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old flag was hanging in <w>shreds</w> from the pole.",
                            "target_lang_translations": {
                                "cs": "Stará vlajka visela na stožáru jen v <w>cárech</w>."
                            }
                        },
                        {
                            "text": "She used <w>shreds</w> of fabric to make a colorful quilt.",
                            "target_lang_translations": {
                                "cs": "Použila <w>útržky</w> látky, aby vyrobila barevnou prošívanou deku."
                            }
                        }
                    ],
                    "synonyms": [
                        "strip",
                        "sliver"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dlouhý, úzký pruh materiálu, zejména látky nebo papíru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cár",
                                "target_lang_sense_clarification": "utržený kus textilu nebo papíru"
                            },
                            {
                                "target_lang_word": "útržek",
                                "target_lang_sense_clarification": "malý odtržený kus papíru nebo látky"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "042d6c91-0522-3c00-a626-45a0744fc2e4",
                    "sense_definition": "To cut or tear something into long, thin pieces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>shred</w> the lettuce for the salad.",
                            "target_lang_translations": {
                                "cs": "Prosím, <w>nakrájej</w> salát na proužky."
                            }
                        },
                        {
                            "text": "It is important to <w>shred</w> sensitive documents before throwing them away.",
                            "target_lang_translations": {
                                "cs": "Je důležité citlivé dokumenty před vyhozením <w>skartovat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grate",
                        "tear"
                    ],
                    "common_phrases": [
                        "shred cheese",
                        "shred paper"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozřezat nebo roztrhat něco na dlouhé, tenké kusy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strouhat",
                                "target_lang_sense_clarification": "při přípravě jídla, např. sýra"
                            },
                            {
                                "target_lang_word": "skartovat",
                                "target_lang_sense_clarification": "při ničení dokumentů"
                            },
                            {
                                "target_lang_word": "trhat",
                                "target_lang_sense_clarification": "obecný význam rozdělování na kusy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52569818-1209-3bae-935b-9715acfa1f18",
                    "sense_definition": "To play a musical instrument, especially a guitar, very fast and with high technical skill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist began to <w>shred</w> during the final solo.",
                            "target_lang_translations": {
                                "cs": "Kytarista začal během závěrečného sóla <w>divoce hrát</w>."
                            }
                        },
                        {
                            "text": "He spent years practicing just so he could <w>shred</w> like his idols.",
                            "target_lang_translations": {
                                "cs": "Strávil roky cvičením jen proto, aby mohl <w>hrát</w> jako jeho idoly."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in rock and heavy metal music contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hrát na hudební nástroj, zejména na kytaru, velmi rychle a s vysokou technickou zručností."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "divoce hrát",
                                "target_lang_sense_clarification": "popisuje rychlou a technicky náročnou hru"
                            },
                            {
                                "target_lang_word": "sólovat",
                                "target_lang_sense_clarification": "v kontextu kytarového sóla"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}