{
    "word_family": [
        "nomenclatural",
        "nomenclator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "083ac45b-75ac-3c94-87c5-97c2d9364ba1",
                    "sense_definition": "A system of rules for naming things in a specific field of study or science.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "naming_systems",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientific <w>nomenclature</w> for plants is based on Latin and Greek roots.",
                            "target_lang_translations": {
                                "zh": "植物的科学<w>命名法</w>基于拉丁语和希腊语词根。"
                            }
                        },
                        {
                            "text": "Students must learn the standard <w>nomenclature</w> used in chemistry to identify different compounds.",
                            "target_lang_translations": {
                                "zh": "学生必须学习化学中用于识别不同化合物的标准<w>命名法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminology"
                    ],
                    "common_phrases": [
                        "scientific nomenclature",
                        "standard nomenclature"
                    ],
                    "target_lang_definitions": {
                        "zh": "在特定学科或科学领域中，用于命名事物的规则体系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "命名法",
                                "target_lang_sense_clarification": "指科学或学术领域中系统性的命名规则。"
                            },
                            {
                                "target_lang_word": "术语体系",
                                "target_lang_sense_clarification": "指某一学科内一套规范化的术语系统。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b661293f-96e6-3c33-8fbc-9f8ef4e2f504",
                    "sense_definition": "A collection or list of names or terms used in a particular context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naming_systems",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report provides a detailed <w>nomenclature</w> of all the parts used in the engine.",
                            "target_lang_translations": {
                                "zh": "该报告提供了发动机所用所有零件的详细<w>术语表</w>。"
                            }
                        },
                        {
                            "text": "He studied the complex <w>nomenclature</w> of legal terms before starting his internship.",
                            "target_lang_translations": {
                                "zh": "他在开始实习前研究了复杂的法律<w>专门用语</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminology"
                    ],
                    "target_lang_definitions": {
                        "zh": "在特定语境下使用的一系列名称或术语的集合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "术语表",
                                "target_lang_sense_clarification": "指特定领域内所用术语的清单或集合。"
                            },
                            {
                                "target_lang_word": "专门用语",
                                "target_lang_sense_clarification": "指在特定专业领域内使用的词汇集合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b5f56e-6f70-3811-a8f0-598bb36f1ee6",
                    "sense_definition": "A name or designation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official <w>nomenclature</w> for the new building was decided by the committee.",
                            "target_lang_translations": {
                                "zh": "新大楼的正式<w>名称</w>由委员会决定。"
                            }
                        },
                        {
                            "text": "They debated the proper <w>nomenclature</w> for the newly discovered species.",
                            "target_lang_translations": {
                                "zh": "他们讨论了新发现物种的恰当<w>称谓</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "名称或称呼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "名称",
                                "target_lang_sense_clarification": "指正式的称呼或命名。"
                            },
                            {
                                "target_lang_word": "称谓",
                                "target_lang_sense_clarification": "指对某事物或某人的正式称呼。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}