                "translations": [
                    {
                        "translation_id": "d09d40e7-73ee-4751-a9db-ba2d72a7afd0",
                        "source_entry_id": "a58092fc-52c3-3e40-9d69-004720ed6bf7",
                        "source_sense_id": "59c5377a-63ec-3027-86ab-b8175137d350",
                        "source_sense_description": "Luftfahrt: Start- und Landeplatz für Flugzeuge",
                        "target_lang_word": "aérodrome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aérodrome",
