                        "target_lang_word": "publican",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c00dc6b-bf22-3b21-aed1-b4e550f42cbe",
                                        "entry_id": "226c1765-cc31-32ac-8ed5-d574439592af",
                                        "glosses": [
                                            "The landlord (manager or owner) of a public house (“a bar or tavern, often also selling food and sometimes lodging; a pub”)."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85646a55-3425-4813-bada-57c159234e9c",
                                                "sense_id": "0c00dc6b-bf22-3b21-aed1-b4e550f42cbe",
                                                "text": "I went into a public-'ouse to get a pint o' beer, / The publican 'e up an 'sez, 'We serve no red-coats here.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5539eec1-1a58-391d-924e-40f5c8c6257e",
                                        "entry_id": "226c1765-cc31-32ac-8ed5-d574439592af",
                                        "glosses": [
                                            "The manager or owner of a hotel."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "publican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                        "entry_id": "ddba7d11-8fd3-3f22-8e55-75745a74388d",
                                        "glosses": [
                                            "A tax collector, especially one working in Judea and Galilee during New Testament times (1st century C.E.) who was generally regarded as sinful for extorting more tax than was due, and as a traitor for serving the Roman Empire."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031baa2d-aad3-40a4-9335-15f0c21061aa",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "Matthevv vvhiche vvas other vvyſe alſo called Leui, beyng of a Puplican made an Apoſtle, firſt of all others compoſed and vvrote in Jevvrye, the ghoſpell of Chriſte in the Hebrue tounge, […]"
                                            },
                                            {
                                                "example_id": "dcdd8e3a-2578-4505-b3b1-7c33023dcb8a",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "[T]he Publicans, that is to ſaye, the cuſtomers and takers vp of tolles, […]"
                                            },
                                            {
                                                "example_id": "bccfb008-b03d-4448-9771-361329ceda03",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "Hovv like a favvning Publican he lookes."
                                            },
                                            {
                                                "example_id": "52cc8b51-dbc8-42ec-9e9a-e6c334581fde",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "[I]f he [a brother who trespasses against one] neglect to heare the Church, let him be vnto thee as an heathen man, and a Publicane."
                                            },
                                            {
                                                "example_id": "24264c03-52c2-48fc-86d5-25742a14b9c1",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "[T]here was a man named Zacheus, which was the cheefe among the Publicanes, and he was rich."
                                            },
                                            {
                                                "example_id": "7d2593aa-6d16-4a3f-b800-84e22c1ccb5c",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "The provinces groaned at once under all the severity of publick imposition, and the rapaciousness of private usury. They were overrun by publicans, farmers of the taxes, agents, confiscators, usurers, bankers, those numerous and insatiable bodies, which always flourish in a burthened and complicated revenue."
                                            },
                                            {
                                                "example_id": "68c6de78-307c-4492-89d0-2bbbc600a695",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "Now, Mrs. Varden, […] believing, moreover, that the publicans coupled with sinners in Holy Writ were veritable licensed victuallers; was far from being favourably disposed towards her visitor."
                                            },
                                            {
                                                "example_id": "cb5afa01-c4e7-4b78-9a95-ea2208849279",
                                                "sense_id": "5d636f5a-2553-3c5d-ab9f-a4e225fadf1f",
                                                "text": "He brings twelve men with him, fishermen, tillers of the soil, one a publican, all of the humbler class; and he and they make their journeys on foot, careless of wind, cold, rain, or sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c400a5-02ee-3364-8e7f-e63dc6ba86c1",
                                        "entry_id": "ddba7d11-8fd3-3f22-8e55-75745a74388d",
                                        "glosses": [
                                            "Any person who collects customs duties, taxes, tolls, or other forms of public revenue."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245c4a32-a9fd-41ac-967e-b4dec2761abd",
                                                "sense_id": "11c400a5-02ee-3364-8e7f-e63dc6ba86c1",
                                                "text": "Another ſort there be vvho vvhen they hear that all things ſhall be order'd, all things regulated and ſetl'd; nothing vvritt'n but vvhat paſſes through the cuſtom-houſe of certain Publicans that have the tunaging and the poundaging of all free ſpok'n truth, vvill ſtrait give themſelvs up into your hands, mak 'em, & cut 'em out vvhat religion ye pleaſe; […]"
                                            },
                                            {
                                                "example_id": "f8a1c9d2-7e8e-4122-8f6d-67fbdfd140c7",
                                                "sense_id": "11c400a5-02ee-3364-8e7f-e63dc6ba86c1",
                                                "text": "[…] I am fallen into the hands of Publicans and Sequeſtrators, and they have taken all from me, vvhat novv? let me look about me. They have left me the Sun and the Moon, Fire and vvater, a loving vvife, and many friends to pity me, and ſome to relieve me, […]"
                                            },
                                            {
                                                "example_id": "70d5748d-727f-4c49-b7d0-68cdf3af4957",
                                                "sense_id": "11c400a5-02ee-3364-8e7f-e63dc6ba86c1",
                                                "text": "Nor could the Treasury effectually restrain the chimneyman from using his powers with harshness: for the tax was farmed; and the government was consequently forced to connive at outrages and exactions such as have, in every age, made the name of publican a proverb for all that is most hateful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f09d17cf-39e6-308e-8a50-4ce3d7f2bba9",
                                        "entry_id": "ddba7d11-8fd3-3f22-8e55-75745a74388d",
                                        "glosses": [
                                            "One regarded as extorting money from others by charging high prices."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89271d77-f609-3c8b-af0d-b1b8b0d02dd5",
                                        "entry_id": "ddba7d11-8fd3-3f22-8e55-75745a74388d",
                                        "glosses": [
                                            "A person excommunicated from the church; an excommunicant or excommunicate; also, a person who does not follow a Christian religion; a heathen, a pagan."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
