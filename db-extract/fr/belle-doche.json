                "senses": [
                    {
                        "sense_id": "54854dcf-26ba-3f6d-8c1c-3852369c0dfa",
                        "entry_id": "3e325396-eab0-3056-99ec-c1b9fca799d7",
                        "glosses": [
                            "Mère de l’épouse ou de l’époux."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8258b852-0f40-4e89-89da-4f2d1f7c53e6",
                                "sense_id": "54854dcf-26ba-3f6d-8c1c-3852369c0dfa",
                                "text": "16 juillet 43 – Heureusement que notre gendre a plus d’égards pour ses belles-doches, il nous a écrit."
                            },
                            {
                                "example_id": "1342a218-3059-4aad-87fb-35a135f54bbf",
                                "sense_id": "54854dcf-26ba-3f6d-8c1c-3852369c0dfa",
                                "text": "En même temps, t’as raison. Laura, c’est pas le mauvais cheval. Le problème, c’est sa mère. Josiane... Cent dix kilos de belle-doche et c’est tombé sur moi !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d1f949aa-6fbf-3523-9d1d-ea5ed5c42df4",
                        "entry_id": "3e325396-eab0-3056-99ec-c1b9fca799d7",
                        "glosses": [
                            "Par influence du second sens de belle-mère : nouvelle épouse ou compagne du père ou de la mère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3ad2310-2431-4a3c-886a-efe11c9eee27",
                                "sense_id": "d1f949aa-6fbf-3523-9d1d-ea5ed5c42df4",
                                "text": "Le père à Dom il était brave, sa belle-doche, bien que tout sourire à mon égard, je te la sentais déjà plus dure."
                            }
                        ]
                    }
                ],
