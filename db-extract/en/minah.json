                "entry_id": "18bb035b-ca94-3c93-977d-2d64982b69c5",
                "word": "minah",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dbf6c3e3-8143-4f3f-ab57-e18faa37bfb8",
                        "entry_id": "18bb035b-ca94-3c93-977d-2d64982b69c5",
                        "tags": [
