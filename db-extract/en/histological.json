                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "histologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a8a742-ac01-394e-85ac-114429075634",
                                        "entry_id": "e61a9f42-06a7-3012-a833-807ba230fec0",
                                        "glosses": [
                                            "Relatif à l’histologie, aux tissus organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d966095-0d8f-4db6-8b4c-98b803af5922",
                                                "sense_id": "a2a8a742-ac01-394e-85ac-114429075634",
                                                "text": "Au C.H.U. de Paris-Est, le malade était véritablement bilanisé, sorte d’atomisation biochimique, histologique, électromagnétique."
                                            },
                                            {
                                                "example_id": "5eacc887-fe96-435d-b5e8-d808eb5b3182",
                                                "sense_id": "a2a8a742-ac01-394e-85ac-114429075634",
                                                "text": "Freud écrit ainsi en 1913 que « la psychanalyse refuse d’établir pour le moment une relation de cette topique psychique avec une localisation anatomique ou avec une structure histologique ». — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 422)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "706d832f-c9e4-491f-bbf6-17f2f52e003c",
                        "source_entry_id": "f7776ef6-c31d-3f0a-9f55-11aa0e72be95",
                        "source_sense_id": "66f17424-9be9-3a53-b308-eda721b05d7c",
                        "source_sense_description": "pertaining to histology",
                        "target_lang_word": "histologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "histologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                        "entry_id": "715f5f19-f5fa-3486-b19c-fcc1c9ee8f59",
                                        "glosses": [
                                            "zur Histologie gehörend; die Histologie betreffend; die Gewebe betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bb1ecf-0ce2-4d05-a58b-6a2ff330a36f",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Diese Gewebsprobe wird dann histologisch untersucht."
                                            },
                                            {
                                                "example_id": "a4412e37-f157-4506-9c77-2e04c521c298",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Selbst Ärzte haben oft ein unbegrenztes Vertrauen zur histologisch \"gesicherten\" Diagnose."
                                            },
                                            {
                                                "example_id": "c6a7ef34-5a4f-44e7-a51c-abaea109452c",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Und doch gibt es kein eindeutiges Kriterium der histologischen Krebsdiagnose, das nicht auch bei gutartigen Krankheiten vorkommen kann."
                                            },
                                            {
                                                "example_id": "1fde2d71-7c38-421d-ba26-7612c64943ae",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Hinter dem gängigen Ausdruck, ein Befund sei \"histologisch gesichert\", also durch Begutachtung unter dem Mikroskop, komme die persönliche Leistung dieses Facharztes \"meist gar nicht zum Ausdruck\"."
                                            },
                                            {
                                                "example_id": "0cafde0a-4589-45d8-befd-07ad17b4ff20",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Die Röhren gibt es ohne Zweifel nicht, und die angegebenen Verbindungslinien stimmen auch nicht mit den histologisch bekannten Nervenbahnen überein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
