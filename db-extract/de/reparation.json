                    },
                    {
                        "translation_id": "184e0454-78bf-4686-ab30-025b68e71778",
                        "source_entry_id": "018e6f7d-0152-3853-bff1-89b0ef9b1f40",
                        "source_sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
