                        "entry_id": "d254289b-1b84-3d20-8012-f1fc0521cca1",
                        "glosses": [
                            "kurzer, scheinbar spontaner Menschenauflauf auf öffentlichen oder halböffentlichen Plätzen, bei dem sich die Teilnehmer persönlich nicht kennen, ungewöhnliche Dinge tun und sich über soziale Netzwerke verabredet haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f7e60e-db02-4a02-a5c2-775badf1d321",
                                "sense_id": "7771b44d-06b7-3832-bc69-399b35b4cc66",
                                "text": "Gestern habe ich einen Flashmob gesehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "520e7df6-7dcf-3db6-b92b-a46e3b211f1c",
                        "entry_id": "d254289b-1b84-3d20-8012-f1fc0521cca1",
                        "glosses": [
                            "Gesamtheit der Personen, die an der scheinbar spontanen Zusammenkunft teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00b85b8-60b9-4b08-b0b2-d9e3f296aafe",
                                "sense_id": "520e7df6-7dcf-3db6-b92b-a46e3b211f1c",
                                "text": "Der Flashmob traf sich am Bahnhof."
                            }
                        ],
                        "sense_index_json": "\"2\""
