                "senses": [
                    {
                        "sense_id": "36a6956e-49dd-3870-9efa-897533c7168b",
                        "entry_id": "6033a3e6-73ae-3687-a168-164c6b4fba49",
                        "glosses": [
                            "Nagel, mit dem ein Sarg verschlossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb119ec-b0e5-4855-b7c8-9f25f062f743",
                                "sense_id": "36a6956e-49dd-3870-9efa-897533c7168b",
                                "text": "Mit kleinen, verzinnten Sargnägeln machte er sich daran, den Sarg zuzunageln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c92852a-2b4e-33f4-9024-2ebba27de42d",
                        "entry_id": "6033a3e6-73ae-3687-a168-164c6b4fba49",
                        "glosses": [
                            "Person oder Sache, die für den Tod oder Unglück einer anderen Person oder Sache verantwortlich gemacht wird"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "aaeefef3-943a-455b-aea8-e0ea7ef26ab5",
                                "sense_id": "8c92852a-2b4e-33f4-9024-2ebba27de42d",
                                "text": "Das war der Sargnagel für Rot-Grün."
                            },
                            {
                                "example_id": "4e9f88ed-c750-4cbc-a546-6305f9b9928c",
                                "sense_id": "8c92852a-2b4e-33f4-9024-2ebba27de42d",
                                "text": "„Diese Unaufrichtigkeit kann gerade am Anfang einer Beziehung direkt den Sargnagel bedeuten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c0b57767-f897-3bc7-8810-944aed105af0",
                        "entry_id": "6033a3e6-73ae-3687-a168-164c6b4fba49",
                        "glosses": [
                            "Zigarette"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d6db3309-9f74-4edc-8bdc-5dba5c496fe5",
                                "sense_id": "c0b57767-f897-3bc7-8810-944aed105af0",
                                "text": "Dreimal war er entschlossen, den Sargnagel anzustecken, kam aber immer wieder von seinem Entschluß ab und verstaute die Zigarette zuletzt am gewohnten Platz."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
