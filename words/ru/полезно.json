    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d59a0e9d-9e55-347a-9a14-d9a15ea72a43",
                    "sense_definition": "Оценка ситуации как благоприятной, нужной или способствующей здоровью и благополучию; часто используется в значении «стоит» или «следует» что-то сделать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "benefit_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро <полезно> делать зарядку.",
                            "target_lang_translations": {
                                "en": "It is <good> to do exercises every morning.",
                                "de": "Es ist jeden Morgen <nützlich>, Gymnastik zu machen."
                            }
                        },
                        {
                            "text": "Детям <полезно> гулять на свежем воздухе.",
                            "target_lang_translations": {
                                "en": "It is <healthy> for children to walk in the fresh air.",
                                "de": "Es ist für Kinder <gesund>, an der frischen Luft spazieren zu gehen."
                            }
                        },
                        {
                            "text": "Тебе будет <полезно> узнать эту информацию.",
                            "target_lang_translations": {
                                "en": "It will be <useful> for you to know this information.",
                                "de": "Es wird für dich <nützlich> sein, diese Information zu erfahren."
                            }
                        }
                    ],
                    "antonyms": [
                        "вредно"
                    ],
                    "common_phrases": [
                        "полезно знать",
                        "полезно для здоровья",
                        "очень полезно"
                    ],
                    "target_lang_definitions": {
                        "en": "It is beneficial, healthy, or worthwhile to do something.",
                        "de": "Es ist vorteilhaft, gesund oder lohnenswert, etwas zu tun."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "useful",
                                "target_lang_sense_clarification": "general utility or advantage"
                            },
                            {
                                "target_lang_word": "good",
                                "target_lang_sense_clarification": "beneficial for well-being or morally right"
                            },
                            {
                                "target_lang_word": "healthy",
                                "target_lang_sense_clarification": "conducive to physical health"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nützlich",
                                "target_lang_sense_clarification": "allgemeiner Nutzen oder Vorteil"
                            },
                            {
                                "target_lang_word": "gut",
                                "target_lang_sense_clarification": "förderlich für das Wohlbefinden"
                            },
                            {
                                "target_lang_word": "gesund",
                                "target_lang_sense_clarification": "förderlich für die körperliche Gesundheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fffbda4-b688-38c8-a680-648fe5890ade",
                    "sense_definition": "Действуя таким образом, который приносит результат, выгоду или пользу; продуктивно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "benefit_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы провели выходные очень <полезно> и интересно.",
                            "target_lang_translations": {
                                "en": "We spent the weekend very <productively> and interestingly.",
                                "de": "Wir haben das Wochenende sehr <produktiv> und interessant verbracht."
                            }
                        },
                        {
                            "text": "Студенты <полезно> использовали свободное время в библиотеке.",
                            "target_lang_translations": {
                                "en": "Students used their free time <usefully> in the library.",
                                "de": "Die Studenten haben ihre Freizeit in der Bibliothek <sinnvoll> genutzt."
                            }
                        }
                    ],
                    "synonyms": [
                        "продуктивно"
                    ],
                    "common_phrases": [
                        "провести время полезно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that brings results or benefit; productively.",
                        "de": "Auf eine Weise, die Ergebnisse oder Vorteile bringt; produktiv."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "productively",
                                "target_lang_sense_clarification": "yielding good results"
                            },
                            {
                                "target_lang_word": "usefully",
                                "target_lang_sense_clarification": "in a beneficial manner"
                            },
                            {
                                "target_lang_word": "profitably",
                                "target_lang_sense_clarification": "spending time in a valuable way"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "produktiv",
                                "target_lang_sense_clarification": "gute Ergebnisse liefernd"
                            },
                            {
                                "target_lang_word": "sinnvoll",
                                "target_lang_sense_clarification": "auf eine nützliche oder wertvolle Weise"
                            }
                        ]
                    }
                }
            ]
        },
        {
