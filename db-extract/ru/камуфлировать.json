                "senses": [
                    {
                        "sense_id": "9ad6df69-5a80-3783-9e12-9e21c6bb32dc",
                        "entry_id": "431631a4-0cce-37dc-98f1-1f7494378395",
                        "glosses": [
                            "маскировать, делать незаметным с помощью камуфляжа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a59f48-d8ff-4f47-b934-c1a4eaca06cb",
                                "sense_id": "9ad6df69-5a80-3783-9e12-9e21c6bb32dc",
                                "text": "Между прочим, я военный художник, в войну корабли камуфлировал, чтобы их самолеты не заметили."
                            }
                        ]
                    },
                    {
                        "sense_id": "904c4b7f-de03-3acd-b07d-d12d45e806f0",
                        "entry_id": "431631a4-0cce-37dc-98f1-1f7494378395",
                        "glosses": [
                            "перен. делать менее заметным, придавая иной вид"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3638439-c5b1-48e6-a3ac-538f6a8dfec5",
                                "sense_id": "904c4b7f-de03-3acd-b07d-d12d45e806f0",
                                "text": "Потом мы придумали камуфлировать «антисоветчину» под газету «Правда»."
                            }
                        ]
                    }
                ],
