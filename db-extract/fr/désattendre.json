                "senses": [
                    {
                        "sense_id": "3ee6eef8-8f1e-3028-851c-50596835330d",
                        "entry_id": "4930f24e-fac1-3e0a-867a-9c4bc80324e5",
                        "glosses": [
                            "Ne plus attendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd3150b9-2645-4140-ad35-65fafbc607bb",
                                "sense_id": "3ee6eef8-8f1e-3028-851c-50596835330d",
                                "text": "Ni espérer ni désespérer, trouver l’écart, cesser d’attendre (j’écris d’apprendre), désattendre comme on dit désapprendre."
                            },
                            {
                                "example_id": "2dbb227f-2d8b-4324-b9e3-b75d24657095",
                                "sense_id": "3ee6eef8-8f1e-3028-851c-50596835330d",
                                "text": "Apprendre à désattendre."
                            },
                            {
                                "example_id": "6613718f-e7fe-4d0d-94fe-b5b1eebc4fc2",
                                "sense_id": "3ee6eef8-8f1e-3028-851c-50596835330d",
                                "text": "Il désattend, il dédésire."
                            }
                        ]
                    }
