                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c51bba-322c-43ce-acbe-63a267586932",
                                "sense_id": "8b9e328e-8290-35c9-a5eb-dbe85487cfa1",
                                "text": "Есть в них что-то столь нежное, женственное, что я один раз даже не вытерпел."
                            },
