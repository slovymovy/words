        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "75fbbe99-c6ee-354e-9b34-0230e07317ff",
                    "sense_definition": "A female given name from French, the standard feminine form of John since the 17th century.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "name_given",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My sister <w>Jane</w> lives in a small house near the park.",
                            "target_lang_translations": {
                                "ru": "Моя сестра <w>Джейн</w> живет в маленьком доме у парка.",
                                "zh": "我的姐姐<w>简</w>住在公园附近的一所小房子里。"
                            }
                        },
                        {
                            "text": "I am going to meet <w>Jane</w> for lunch tomorrow.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь встретиться с <w>Джейн</w> завтра за обедом.",
                                "zh": "我明天要和<w>简</w>见面吃午饭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Jane Doe",
                        "Plain Jane",
                        "Calamity Jane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя французского происхождения, стандартная женская форма имени Джон (Иван), используемая с XVII века.",
                        "zh": "源自法语的女性名字，是17世纪以来约翰（John）这一名字的标准女性形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джейн",
                                "target_lang_sense_clarification": "имя"
                            },
                            {
                                "target_lang_word": "Иванна",
                                "target_lang_sense_clarification": "этимологический аналог"
                            },
                            {
                                "target_lang_word": "Яна",
                                "target_lang_sense_clarification": "этимологический аналог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简",
                                "target_lang_sense_clarification": "女性名字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e01f2366-7d50-31d4-96cc-a1a2d47d5d10",
