        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "83e359f8-aae7-362e-84a8-aa3fdb5094e5",
                    "sense_definition": "To an extreme degree; very.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>fierce</w> cold last night, so we stayed indoors.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью было <w>ужасно</w> холодно, поэтому мы остались дома.",
                                "zh": "昨晚天气<w>极其</w>寒冷，所以我们待在室内。"
                            }
                        },
                        {
                            "text": "The wind was blowing <w>fierce</w> hard against the windows.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>чертовски</w> сильно бил в окна.",
                                "zh": "风<w>非常</w>猛烈地吹打着窗户。"
                            }
                        }
