                        "source_sense_id": "7d9081ee-ecc7-3245-b55f-73b194e3da38",
                        "source_sense_description": "im Zentrum Südfrankreichs gelegenes Gebirge",
                        "target_lang_word": "Massif central",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massif central",
