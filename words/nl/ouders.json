                    "sense_id": "c7b07b6e-e6f5-3892-9ebc-f869a8a3982e",
                    "sense_definition": "Meervoud van <w>ouder</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga dit weekend gezellig bij mijn <w>ouders</w> eten.",
                            "target_lang_translations": {
                                "en": "I'm going to have a nice meal at my <w>parents'</w> place this weekend.",
                                "ru": "В эти выходные я с удовольствием поем у своих <w>родителей</w>.",
                                "pl": "W ten weekend idę na miły obiad do moich <w>rodziców</w>.",
                                "de": "Ich gehe dieses Wochenende gemütlich bei meinen <w>Eltern</w> essen.",
                                "fr": "Ce week-end, je vais manger chez mes <w>parents</w>.",
                                "it": "Questo fine settimana vado a mangiare con piacere dai miei <w>genitori</w>.",
                                "cs": "Tento víkend půjdu na příjemný oběd ke svým <w>rodičům</w>.",
                                "tr": "Bu hafta sonu <w>annemlerin</w> (anne babamın) evinde keyifli bir yemek yiyeceğim.",
                                "es": "Este fin de semana voy a comer con mis <w>padres</w>."
                            }
                        },
                        {
                            "text": "Zijn <w>ouders</w> waren erg trots toen hij zijn diploma haalde.",
                            "target_lang_translations": {
                                "en": "His <w>parents</w> were very proud when he got his diploma.",
                                "ru": "Его <w>родители</w> были очень горды, когда он получил диплом.",
                                "pl": "Jego <w>rodzice</w> byli bardzo dumni, kiedy odebrał swój dyplom.",
                                "de": "Seine <w>Eltern</w> waren sehr stolz, als er sein Diplom machte.",
                                "fr": "Ses <w>parents</w> étaient très fiers lorsqu'il a obtenu son diplôme.",
                                "it": "I suoi <w>genitori</w> erano molto orgogliosi quando ha preso il diploma.",
                                "cs": "Jeho <w>rodiče</w> byli velmi hrdí, když získal diplom.",
                                "tr": "Diplomasını aldığında <w>anne babası</w> onunla çok gurur duydu.",
                                "es": "Sus <w>padres</w> estaban muy orgullosos cuando obtuvo su diploma."
                            }
                        }
                    ],
