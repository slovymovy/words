                                "target_lang_word": "irritar",
                                "target_lang_sense_clarification": "poner de mal humor"
                            },
                            {
                                "target_lang_word": "molestar",
                                "target_lang_sense_clarification": "fastidio leve, cotidiano"
                            },
                            {
                                "target_lang_word": "exasperar",
                                "target_lang_sense_clarification": "paciencia agotada, frustración extrema"
                            }
                        ],
                        "zh": [
