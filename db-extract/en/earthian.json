                ],
                "senses": [
                    {
                        "sense_id": "e266793a-ecff-3c65-896a-9f966e33df6d",
                        "entry_id": "82d8c74b-9285-34a0-84b3-2862103f6ebe",
                        "glosses": [
                            "Of or from the planet Earth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6639620f-66fb-46c5-ba7b-db7bea8e8e10",
                                "sense_id": "e266793a-ecff-3c65-896a-9f966e33df6d",
                                "text": "Septimus Spink, sole survivor of the Earthian space ship..."
                            },
                            {
                                "example_id": "75d76a02-297b-42af-bca3-deaf32f41d91",
                                "sense_id": "e266793a-ecff-3c65-896a-9f966e33df6d",
                                "text": "An Earthian metallurgist could tell very easily that 'aluminum' was molybdenum..."
                            },
                            {
                                "example_id": "646f2f25-4eea-4d06-b6cf-ee5a12624a34",
                                "sense_id": "e266793a-ecff-3c65-896a-9f966e33df6d",
                                "text": "Nowadays speakers on Twin Earth are well aware (thanks to chemistry) that their word 'water' does not refer to the Earthian stuff."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
