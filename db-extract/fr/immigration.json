                        ]
                    },
                    {
                        "translation_id": "9698186f-53eb-4c39-bf6e-ceac44007b8f",
                        "source_entry_id": "3b756909-ef44-3a0b-ac0d-58302585a333",
                        "target_lang_word": "immigration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immigration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b0660e-3ae2-34f5-bfdb-4d07b8c71c71",
                                        "entry_id": "234cb241-0ece-3a8a-b076-c6ddb494afc0",
                                        "glosses": [
                                            "The act of immigrating; the passing or coming into a country of which one is not native born for the purpose of permanent residence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57278c56-51af-45c9-8483-ab253a3e47a0",
                                                "sense_id": "e4b0660e-3ae2-34f5-bfdb-4d07b8c71c71",
                                                "text": "The Bohemians had come then, and after them the Poles. People said that old man Durham himself was responsible for these immigrations; he had sworn that he would fix the people of Packingtown so that they would never again call a strike on him, and so he had sent his agents into every city and village in Europe to spread the tale of the chances of work and high wages at the stockyards."
                                            },
                                            {
                                                "example_id": "c84ef86e-1d1c-42f3-a699-35fab8dde700",
                                                "sense_id": "e4b0660e-3ae2-34f5-bfdb-4d07b8c71c71",
                                                "text": "Another measure of the inadequacy of the Immigration and Nationality Act has been the huge volume of private immigration bills introduced in Congress. These are bills to deal with individual hardship cases for which the general law fails to provide. In the Eighty-seventh Congress over 3,500 such bills were introduced. Private immigration bills make up about half of our legislation today."
                                            },
                                            {
                                                "example_id": "4ec0e28a-36bb-4e3f-bd63-984584a5f271",
                                                "sense_id": "e4b0660e-3ae2-34f5-bfdb-4d07b8c71c71",
                                                "text": "[Stephen] Miller’s uncle, a neuroscientist, has been welcomed onto the public stage for his denunciations of his nephew’s immigration policies, which the elder Miller has characterized as hypocritical: the Millers’ not-so-distant Jewish ancestors were, of course, immigrants themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b63686eb-cc65-374f-8884-2bfb4632405b",
                                        "entry_id": "234cb241-0ece-3a8a-b076-c6ddb494afc0",
                                        "glosses": [
                                            "The process of going through immigration checks at a border checkpoint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673f079f-b799-4411-8847-ff3ffcb0bd87",
                                                "sense_id": "b63686eb-cc65-374f-8884-2bfb4632405b",
                                                "text": "It took ages to get through immigration last time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
