                        "sense_id": "646320ad-04a7-3a11-9b52-efbba70277c0",
                        "entry_id": "a3c944a6-14c0-3d7b-93ac-3f2ad147b328",
                        "glosses": [
                            "Choisir de recruter alors que la personne choisie n’est pas encore disponible (en cours d’études, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4038b0-cdb0-4c67-976e-35a4ad5f37a2",
                                "sense_id": "646320ad-04a7-3a11-9b52-efbba70277c0",
                                "text": "Leur rôle était de pré-recruter des programmeurs en PHP/MYSQL pour mon agence web."
                            },
                            {
                                "example_id": "451473ad-9ffd-47b6-9ff3-d390dfe16f3f",
                                "sense_id": "646320ad-04a7-3a11-9b52-efbba70277c0",
                                "text": "Pour l’entreprise, c'est l’avantage d’une formation externalisée, donc moins coûteuse, et l’assurance de pouvoir pré-recruter des collaborateurs titulaires d’un diplôme universitaire national ou tester ces individus en cours de formation."
                            }
                        ]
                    }
