        "nl-extract.jsonl": [
            {
                "entry_id": "5101cba8-5f97-3509-a0fb-340253341e8c",
                "word": "geliefde",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c9d094a-61d0-3c1b-a0b1-4105f8f4c3b8",
                        "entry_id": "5101cba8-5f97-3509-a0fb-340253341e8c",
                        "glosses": [
                            "verbogen vorm van de stellende trap van geliefd"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5b1600a8-1556-47a5-9185-8fe3616241a5",
                                "sense_id": "1c9d094a-61d0-3c1b-a0b1-4105f8f4c3b8",
                                "text": "Kabels van koper zijn een geliefde buit voor dieven."
                            },
                            {
                                "example_id": "f5869f16-fc12-4224-9ed5-efbc2cbc8270",
                                "sense_id": "1c9d094a-61d0-3c1b-a0b1-4105f8f4c3b8",
                                "text": "Ik had al 12 dagen niet gedoucht en kwam moe maar voldaan aan in de stad South Lake Tahoe om eindelijk weer eens uit te rusten. Een geliefde vakantiestad voor skiërs in de winter en watersportliefhebbers in de zomer."
                            },
                            {
                                "example_id": "180accc8-0071-4429-8408-4af8df0d0d21",
                                "sense_id": "1c9d094a-61d0-3c1b-a0b1-4105f8f4c3b8",
                                "text": "Nee, Harald was zestien jaar, zijn neef, Lauritz'en Ingeborgs geliefde oudste zoon, een jongen die ze aan zijn zorg en bescherming hadden toevertrouwd."
                            },
                            {
                                "example_id": "b1a4db09-09ee-4ded-a613-b8a7e0077201",
                                "sense_id": "1c9d094a-61d0-3c1b-a0b1-4105f8f4c3b8",
                                "text": "Ze doet de voordeur open en hoort hen naar elkaar roepen: 'Christoffell' 'Daniëll' 'Pieter!' Ze loopt naar buiten en zoekt aan de hemel intuïtief naar een geliefde flits groen, maar die is er niet."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a3360161-c2a3-3e0e-8ff5-4ca99dd6973e",
                "word": "geliefde",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "67988406-ea7d-4f4f-9a48-202338ffbc36",
                        "entry_id": "a3360161-c2a3-3e0e-8ff5-4ca99dd6973e",
                        "tags": [
                            "plural"
                        ],
                        "form": "geliefden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb4933d6-fcc7-39ee-bb73-2d20cf173457",
                        "entry_id": "a3360161-c2a3-3e0e-8ff5-4ca99dd6973e",
                        "glosses": [
                            "een persoon waarmee men een liefdesrelatie onderhoudt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad377e6d-972c-41a7-af79-1c816ba413b1",
                                "sense_id": "bb4933d6-fcc7-39ee-bb73-2d20cf173457",
                                "text": "Ik lig in bed met mijn geliefde."
                            },
                            {
                                "example_id": "549aaa78-7189-4922-ae6b-44d7eb8432ea",
                                "sense_id": "bb4933d6-fcc7-39ee-bb73-2d20cf173457",
                                "text": "Het verhaal is losjes gebaseerd op een slecht gedocumenteerd historisch mengsel van feit en achterklap: de driehoeksverhouding tussen de Britse koningin Anne, haar jeugdvriendin, belangrijkste adviseur en misschien wel geliefde Sarah Churchill (Rachel Weisz) en het ambitieuze kamermeisje Abigail Masham."
                            },
                            {
                                "example_id": "6e31b5e2-d396-4275-b952-6412497d879a",
                                "sense_id": "bb4933d6-fcc7-39ee-bb73-2d20cf173457",
                                "text": "In de conformistische dagen van nu is de tentoonstelling meer dan een overzicht van leven en werk van een geliefde Drentse blueszanger. Het is ook de expositie van een voorbij tijdperk. De posters en de platenhoezen verhalen over meer dan over muziek alleen. Ze vertellen over jong en wild zijn, langharig, in spijkerbroek. Over bier, liefde en verdriet. Het maakt nostalgisch. Om de blues van te krijgen."
                            },
                            {
                                "example_id": "33fced6e-93d1-4e77-aa2c-df0e2a580df8",
                                "sense_id": "bb4933d6-fcc7-39ee-bb73-2d20cf173457",
                                "text": "' Voordat Harold de kamer van zijn vrouw verliet, schonk hij een glas water in voor zijn geliefde en zette het naast haar bed, net buiten haar bereik."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
