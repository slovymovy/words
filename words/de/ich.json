                    "frequency": "Middle",
                    "semantic_group_id": "psychologie_philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der langen Reise hatte sie endlich das Gefühl, ihr wahres <w>Ich</w> gefunden zu haben."
                        },
                        {
                            "text": "In seinem Tagebuch reflektiert der Autor über das eigene <w>Ich</w> und seine Zweifel."
                        }
                    ],
                    "synonyms": [
                        "Ego"
                    ],
                    "antonyms": [
                        "Nicht-Ich"
                    ],
                    "common_phrases": [
