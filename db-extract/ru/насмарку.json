        "ru-extract.jsonl": [
            {
                "entry_id": "f076eefb-aa33-344e-be6b-9b9f7a27cdb7",
                "word": "насмарку",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d28963d-34ab-38cf-ba40-69374a265242",
                        "entry_id": "f076eefb-aa33-344e-be6b-9b9f7a27cdb7",
                        "glosses": [
                            "разг. впустую, без положительного результата ()"
                        ],
                        "tags": [
                            "часто со словами пойти, идти, пустить"
                        ],
                        "examples": [
                            {
                                "example_id": "0acdc203-2705-4a66-ad1c-26f8dde7d85b",
                                "sense_id": "9d28963d-34ab-38cf-ba40-69374a265242",
                                "text": "Это потому, что после бега, паршивый дурак, надо дышать легко и радостно — иначе весь бег насмарку!"
                            },
                            {
                                "example_id": "ff623fa0-7111-4af6-8330-fb0a5287bdde",
                                "sense_id": "9d28963d-34ab-38cf-ba40-69374a265242",
                                "text": "Постоянного ухода за тобой не будет, а без него лечение пойдёт насмарку."
                            },
                            {
                                "example_id": "2249753a-873b-43f3-ba1d-ab126e19dc12",
                                "sense_id": "9d28963d-34ab-38cf-ba40-69374a265242",
                                "text": "Так бывает иногда в жизни: все хотят как лучше, все полны самых благих, даже лирических намерений, а жизнь пускает всё насмарку."
                            }
                        ]
                    },
                    {
                        "sense_id": "e27f9836-d90e-3bfa-acd5-78853d99deb8",
                        "entry_id": "f076eefb-aa33-344e-be6b-9b9f7a27cdb7",
                        "glosses": [
                            "предик., разг. оценочная характеристика какой-либо работы как проделанной напрасно, зря"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "164467ae-6e21-4976-baec-c9a1dd45e2c1",
                        "source_entry_id": "f076eefb-aa33-344e-be6b-9b9f7a27cdb7",
                        "target_lang_word": "en vain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en vain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                        "entry_id": "385bb150-5402-3813-8cbf-8fd35a346bc4",
                                        "glosses": [
                                            "Vainement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf8d990-0fb9-461a-9d27-f0ba9c4d60fd",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "En vain, j’avais cherché un ru, dont l’eau fraîche chante sous les feuilles, ou bien une source, comme il s’en trouve pourtant beaucoup dans le pays."
                                            },
                                            {
                                                "example_id": "e28266a1-dcbd-4aa4-9bbe-2afac93a26dd",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "Il cracha une injure, s’élança et réempoigna la jeune femme qui, cette fois, se débattit en vain."
                                            },
                                            {
                                                "example_id": "ec7ad62e-5590-4342-93e9-26990fc2a505",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "En vain l’ambassadeur de France tenta de fléchir les négociateurs américains. Ils se montrèrent implacables. Il fallait se soumettre ou faire banqueroute."
                                            },
                                            {
                                                "example_id": "91fe6495-77f8-49c6-969e-46f31de995bc",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "On appelle maintenant Derbo, le grand ministre de Mamma. Celui-là fait quelques difficultés pour accepter son incarnation. C’est en vain que le chœur profère son pressant appel, en vain que les mains agitent les tambourins."
                                            },
                                            {
                                                "example_id": "99522718-6803-493c-9d65-34165b94da2c",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "Le navire imperturbable cingle vers l’immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "811f2dd6-e189-463b-993d-f0a832bdfa40",
                        "source_entry_id": "f076eefb-aa33-344e-be6b-9b9f7a27cdb7",
                        "target_lang_word": "sans résultat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "31687883-f8f4-463e-a9c4-332077546ba2",
