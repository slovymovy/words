                "senses": [
                    {
                        "sense_id": "f63d054e-4e2e-3ae9-a9af-d87c382d75ba",
                        "entry_id": "32ed369c-b44c-3b7c-9e4f-69b890e1bf29",
                        "glosses": [
                            "Eine natürliche weibliche Person, die nach ihrem Tod ein Vermögen hinterlässt, das den gesetzlichen und testamentarisch bestimmten Erben zusteht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6936601d-a826-4e53-9f1f-984583992058",
                                "sense_id": "f63d054e-4e2e-3ae9-a9af-d87c382d75ba",
                                "text": "In dem verhandelten Fall hatte die Erblasserin mit ihrem Mann ein Adoptivkind angenommen. Sie setzte ein Testament auf, wonach ihre Schwestern Alleinerbin sein sollte. Diese starb jedoch vor der Erblasserin."
                            },
                            {
                                "example_id": "6dd1c498-b10c-46cf-ae73-dc9f33597e54",
                                "sense_id": "f63d054e-4e2e-3ae9-a9af-d87c382d75ba",
                                "text": "Nach dem Tod der Erblasserin beantragte nun das Adoptivkind einen Alleinerbschein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
