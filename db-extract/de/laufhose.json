                "senses": [
                    {
                        "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                        "entry_id": "e1bbe2c1-c534-372b-b28d-d46864a7f182",
                        "glosses": [
                            "speziell für das Laufen oder Joggen entwickelte Hose"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "07882a69-e256-4318-83e8-7fbfb4c0ca4f",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Diese Laufhose wird aus einem extrem leichten, angenehm zu tragenden Webstoff hergestellt.“"
                            },
                            {
                                "example_id": "7c2fbc75-5c26-4dfe-bdeb-df6848be9250",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„PRODUCT STORY Tausche deine Trainingshose gegen eine straßentaugliche, dehnbare, kurze Laufhose, die du tragen kannst, wenn du in die Stadt gehst.“"
                            },
                            {
                                "example_id": "b13ea055-ee97-4827-8955-f18f48155ca0",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Diese schicke Laufhose* eignet sich für eine Vielzahl an Workouts.“"
                            },
                            {
                                "example_id": "2e010603-50c7-4f83-ab36-14691b195b10",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Sie trug schulterlange, überwiegend helle, zu einem Zopf gebundene Haare und war mit einer pinkfarbenen Laufhose und einem pink-blauen Oberteil bekleidet.“"
                            },
                            {
                                "example_id": "f6955e80-de0f-4a1d-83f8-c5b77eb9208a",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Unser Entwicklungsteam hat diese warme Laufhose für Kinder entworfen.“"
                            },
                            {
                                "example_id": "2550d29b-d9fa-4063-a753-a4054d76aa77",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Hinten ist die Laufhose mit einer kleinen Tasche für MP3-Player, Riegel oder Schlüssel ausgestattet – sicher verschließbar per Reißverschluss.“"
                            },
                            {
                                "example_id": "8b679db7-0c5e-4819-906a-eb12c9f757c4",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Wenn du gerne in der Dämmerung unterwegs bist, helfen dir die Reflektoren an der engen Laufhose dabei, einfacher im Dunkeln ausgemacht zu werden.“"
                            },
                            {
                                "example_id": "7c469eb7-6724-4c93-ac8a-07c22aa1ef3e",
                                "sense_id": "b18711a8-350c-3c32-8517-23f533eb7917",
                                "text": "„Die Laufhose mit ihrer durchdachten 2in1 Konstruktion sorgt auf mittleren und langen Distanzen für höchsten Komfort und garantiert ein schmerzfreies Finish.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
