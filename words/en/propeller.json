{
    "word_family": [
        "propel",
        "propulsion",
        "propulsive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1409ad68-b5e9-3b9f-a4f9-9ab5304cb5fd",
                    "sense_definition": "A mechanical device with rotating blades used to push an aircraft or boat through air or water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane’s <w>propeller</w> spun rapidly before takeoff.",
                            "target_lang_translations": {
                                "zh": "飞机起飞前，<w>螺旋桨</w>飞速旋转。"
                            }
                        },
                        {
                            "text": "The boat is powered by a single <w>propeller</w>.",
                            "target_lang_translations": {
                                "zh": "这艘船由一个<w>螺旋桨</w>驱动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "airscrew",
                        "screw"
                    ],
                    "common_phrases": [
                        "damaged propeller",
                        "spinning propeller"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种带有旋转叶片的机械装置，用于推动飞机或船只前进。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "螺旋桨",
                                "target_lang_sense_clarification": "指飞机或船只上用于推进的旋转叶片装置。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b42ed53-c7c6-307b-a10b-71a5f0f7e6e1",
                    "sense_definition": "A person or thing that causes something to move forward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agent_of_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy acted as a <w>propeller</w> for economic growth in the region.",
                            "target_lang_translations": {
                                "zh": "这项新政策成为了该地区经济增长的<w>动力</w>。"
                            }
                        },
                        {
                            "text": "He was the main <w>propeller</w> behind the success of the entire project.",
                            "target_lang_translations": {
                                "zh": "他是整个项目成功的核心<w>推动者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "driver",
                        "impetus",
                        "motivator"
                    ],
                    "target_lang_definitions": {
                        "zh": "推动某事物向前发展的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推动者",
                                "target_lang_sense_clarification": "指在某项事业或进程中起促进作用的人。"
                            },
                            {
                                "target_lang_word": "动力",
                                "target_lang_sense_clarification": "指促使事物发展的力量或因素。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69fc446c-55bb-33e8-9906-1814f88527e0",
                    "sense_definition": "A steamship that is driven by a screw propeller.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>propeller</w> docked at the harbor after a long journey.",
                            "target_lang_translations": {
                                "zh": "那艘老式<w>螺旋桨蒸汽船</w>在长途航行后停靠在港口。"
                            }
                        },
                        {
                            "text": "Travelers preferred the speed of the new <w>propeller</w> over traditional sailing ships.",
                            "target_lang_translations": {
                                "zh": "比起传统的帆船，旅客们更青睐这种新型<w>螺旋桨蒸汽船</w>的速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steamer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to 19th-century steamship technology."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由螺旋桨驱动的蒸汽船。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "螺旋桨蒸汽船",
                                "target_lang_sense_clarification": "指19世纪使用螺旋桨推进技术的蒸汽动力船只。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a180ce2e-04ec-30ba-b6ac-3ddefe9cff6a",
                    "sense_definition": "A type of fishing lure that features a rotating blade to attract fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached a shiny <w>propeller</w> to his fishing line to catch bass.",
                            "target_lang_translations": {
                                "zh": "他在鱼线上挂了一个闪亮的<w>旋转亮片</w>来钓鲈鱼。"
                            }
                        },
                        {
                            "text": "The movement of the <w>propeller</w> in the water mimics a small injured fish.",
                            "target_lang_translations": {
                                "zh": "<w>旋转亮片</w>在水中的动作模仿了一条受伤的小鱼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spinnerbait"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种带有旋转叶片以吸引鱼类的钓鱼假饵。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "旋转亮片",
                                "target_lang_sense_clarification": "钓鱼时使用的带有旋转叶片的假饵。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}