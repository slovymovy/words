                        "glosses": [
                            "Faire perdre son caractère caporalisé, autoritaire, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec5b1f8a-6c2a-48ae-8652-a78927740a8d",
                                "sense_id": "f5f5cc77-3245-37d4-b882-5246dabc58a3",
                                "text": "Bernard Bacou, 1981-1985, était au contraire membre « en sommeil » du syndicat, nommé par Robert Badinter pour « décaporaliser l’école »."
                            },
                            {
                                "example_id": "8ccb9c87-15f2-419b-888f-df2d4b8a79cb",
                                "sense_id": "f5f5cc77-3245-37d4-b882-5246dabc58a3",
                                "text": "Maintenant et de plus en plus cette situation se modifiera, puisqu’il a été décidé de « décaporaliser » la culture du coton."
                            }
                        ]
                    }
