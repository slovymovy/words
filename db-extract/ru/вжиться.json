                    {
                        "translation_id": "3925b8cb-64a0-406e-b5ca-a40386208869",
                        "source_entry_id": "b81934d3-1544-36c8-aeed-f733757e1b1a",
                        "source_sense_id": "f597019c-cc06-3bfb-b0eb-4ce51cb6ff6b",
                        "target_lang_word": "einleben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einleben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec3b502-1208-3ac8-9511-891b8560eebb",
                                        "entry_id": "448524a3-e6d2-38ea-ac7f-e3ae64b0d77d",
                                        "glosses": [
                                            "sich an eine neue Umgebung, einen neuen Ort oder an neue Lebensverhältnisse gewöhnen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73241b65-b246-4bf8-a767-0df0d37f84d8",
                                                "sense_id": "8ec3b502-1208-3ac8-9511-891b8560eebb",
                                                "text": "»Diese Kinder waren im Krieg. Wir tun alles, damit sie sich wieder einleben«, hatte die norwegische Bildungsministerin Kristin Halvorsen kurz nach dem Attentat gesagt."
                                            },
                                            {
                                                "example_id": "9475cca5-6392-4d32-820c-2c0ef81b9d32",
                                                "sense_id": "8ec3b502-1208-3ac8-9511-891b8560eebb",
                                                "text": "Bonner, die nach Berlin kommen, fühlen sich gelegentlich in die Nähe des äußersten Ostens versetzt - aus dem Umkreis von Paris, Brüssel und London in die Nähe von Prag, Warschau oder sogar Moskau. Sie müssen sich in einer Stadt einleben, in der manchem manches fremd erscheinen mag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b40d3dcd-3702-3203-b8ac-9160d4ec5f5a",
                                        "entry_id": "448524a3-e6d2-38ea-ac7f-e3ae64b0d77d",
                                        "glosses": [
                                            "sich in eine Person oder Sache hineinversetzen, ein tieferes Verständnis erwerben"
                                        ],
                                        "tags": [
                                            "formal",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6439b4b-7ef1-4668-9e64-d3a46e22dcc7",
                                                "sense_id": "b40d3dcd-3702-3203-b8ac-9160d4ec5f5a",
                                                "text": "Man wird sich in das Ineinanderfließen der Räume erst einleben müssen, in die ungewohnte Offenheit des Ganzen, das indessen wohl unserem modernen Lebensgefühl entspricht."
                                            },
                                            {
                                                "example_id": "e371f6a8-1eed-49a1-b072-b013f130f57b",
                                                "sense_id": "b40d3dcd-3702-3203-b8ac-9160d4ec5f5a",
                                                "text": "Frei und unbekümmert wie kaum ein anderer konnte Tübke auf die Kunst und ihre Geschichte zugehen, konnte sich in sie einsehen und einleben und sie durch sich hindurchfließen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
