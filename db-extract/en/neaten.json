                    {
                        "sense_id": "08ed3aa7-62da-39e8-900b-bd1d57bbdd06",
                        "entry_id": "2f690340-d00a-3b2d-a06f-7ca6f6c1a158",
                        "glosses": [
                            "To make (someone or something) neat; to arrange (people or things) in an orderly, tidy way; to tidy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "183c6c80-22e5-4e16-aa0b-1df7ed9bea46",
                                "sense_id": "08ed3aa7-62da-39e8-900b-bd1d57bbdd06",
                                "text": "She made a frantic attempt to neaten her hair."
                            },
                            {
                                "example_id": "676a5f5a-f937-48c5-b589-284833c1aa9c",
                                "sense_id": "08ed3aa7-62da-39e8-900b-bd1d57bbdd06",
                                "text": "He is doubtful that images made by artificial intelligence will replace the art exhibited in galleries, he worries that commercial projects previously requiring a team of artists may in the future need only one to work with AI and neaten up the final product."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8a87a41-b2a3-38bb-936e-8aab3f4a7546",
                        "entry_id": "2f690340-d00a-3b2d-a06f-7ca6f6c1a158",
                        "glosses": [
                            "To engage in activity that arranges someone or something in an orderly, tidy way."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b07dbd5b-ce64-42f9-b46b-c36cc6789914",
                                "sense_id": "f8a87a41-b2a3-38bb-936e-8aab3f4a7546",
                                "text": "Don't mind me if I neaten while you talk."
                            }
                        ]
                    }
