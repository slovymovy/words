                        "examples": [
                            {
                                "example_id": "5f5e282c-08ff-4b1b-99b0-5752e9dcc7ee",
                                "sense_id": "a638875c-bcaf-321f-a6ef-947bb745ea30",
                                "text": "L’usage eucharistique du monde, qui est à l’œuvre dans le corps humain, unifie les sexes dans la célébration commune — la « hiérurgie » — de la vie."
                            },
                            {
                                "example_id": "f2fe0f72-5b43-476e-b758-1e78ce179d80",
                                "sense_id": "a638875c-bcaf-321f-a6ef-947bb745ea30",
                                "text": "On nomme culte ou hiérurgie (ouvrage sacré) l'ensemble des pratiques qui servent à nous mettre en relation avec le monde invisible."
                            }
                        ]
                    }
