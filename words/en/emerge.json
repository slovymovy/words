                                "nl": "Hij <w>kwam</w> ongeschonden uit het ongeluk.",
                                "pl": "Wyszedł z wypadku bez szwanku, <w>wychodząc</w> z niego obronną ręką.",
                                "fr": "Il est <w>sorti</w> indemne de l'accident.",
                                "it": "È <w>emerso</w> illeso dall'incidente.",
                                "cs": "Z nehody <w>vyšel</w> bez úhony.",
                                "tr": "Kazadan yara almadan <w>kurtuldu</w>.",
                                "es": "Él <w>salió</w> ileso del accidente.",
                                "zh": "他从事故中平安<w>脱身</w>，毫发无损。"
                            }
                        }
                    ],
