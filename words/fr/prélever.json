                {
                    "sense_id": "5911ffed-da95-3c7f-bbc2-55ecc5e21935",
                    "sense_definition": "Prendre ou détacher une partie d'un ensemble avant d'utiliser le reste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier va <w>prélever</w> un morceau de pâte avant d'enfourner le reste.",
                            "target_lang_translations": {
                                "en": "The cook will <w>set aside</w> a piece of dough before putting the rest in the oven.",
                                "ru": "Повар <w>отложит</w> кусок теста, прежде чем поставить остальное в духовку.",
                                "de": "Der Koch wird ein Stück Teig <w>abtrennen</w>, bevor er den Rest in den Ofen schiebt.",
                                "es": "El cocinero va a <w>apartar</w> un trozo de masa antes de meter el resto en el horno.",
                                "zh": "厨师会先<w>分出</w>一块面团，再把剩下的放进烤箱。"
                            }
                        },
                        {
                            "text": "Il faut <w>prélever</w> un peu de terre du jardin pour vérifier sa qualité.",
                            "target_lang_translations": {
                                "en": "You need to <w>take</w> a little soil from the garden to check its quality.",
                                "ru": "Нужно <w>отобрать</w> немного земли из сада, чтобы проверить её качество.",
                                "de": "Man muss ein wenig Erde aus dem Garten <w>entnehmen</w>, um ihre Qualität zu prüfen.",
                                "es": "Hay que <w>tomar</w> un poco de tierra del jardín para comprobar su calidad.",
                                "zh": "需要从花园里<w>取出</w>一点土，检查它的质量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retirer",
                        "prendre"
                    ],
                    "antonyms": [
                        "ajouter"
                    ],
                    "common_phrases": [
                        "prélever une partie",
                        "prélever un morceau"
                    ],
                    "target_lang_definitions": {
                        "en": "To take or separate a portion from a whole before using the rest.",
                        "ru": "Отделить часть от целого, прежде чем использовать остальное.",
                        "de": "Einen Teil von einem Ganzen abtrennen, bevor der Rest verwendet wird.",
                        "es": "Separar una parte de un conjunto antes de utilizar el resto.",
                        "zh": "在使用其余部分之前，从整体中分出一部分。"
                    },
