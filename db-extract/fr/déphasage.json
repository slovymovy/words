                                        ]
                                    },
                                    {
                                        "sense_id": "b3146119-adec-3f18-adf0-d69a7d77ce3a",
                                        "entry_id": "09d3dd37-75d9-3d8a-bf7f-caa503ec74cb",
                                        "glosses": [
                                            "To transport as a punishment for crime."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c73836-7f9c-4ac4-a5d0-6cc2d613b84d",
                                                "sense_id": "b3146119-adec-3f18-adf0-d69a7d77ce3a",
                                                "text": "She lags us if we poach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e58c29-b9b2-3992-bc8b-074ecce59d7a",
                                        "entry_id": "09d3dd37-75d9-3d8a-bf7f-caa503ec74cb",
                                        "glosses": [
                                            "To arrest or apprehend."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a059399-0d05-4980-82ca-64f75ae8718b",
                                                "sense_id": "f5e58c29-b9b2-3992-bc8b-074ecce59d7a",
                                                "text": "\"We must get the old dear out,\" said Lord Roxton to Malone. \"He'll be had for manslaughter if we don't. What I mean, he's not responsible - he'll sock someone and be lagged for it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e482c6ee-23aa-3145-a3cb-e5945d879e12",
                                        "entry_id": "09d3dd37-75d9-3d8a-bf7f-caa503ec74cb",
                                        "glosses": [
                                            "To slacken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddae87b4-6c68-460b-a6db-787d683faa3c",
                                                "sense_id": "e482c6ee-23aa-3145-a3cb-e5945d879e12",
                                                "text": "Interest in the scandal will never lag."
                                            },
                                            {
                                                "example_id": "e7ea22ac-2fa3-40e7-9793-6cc92b3d3222",
                                                "sense_id": "e482c6ee-23aa-3145-a3cb-e5945d879e12",
                                                "text": "The weight would lagge thee that art wont to flye."
                                            }
                                        ]
                                    }
                                ]
                            }
