                "senses": [
                    {
                        "sense_id": "d0290ef9-1a19-33c2-8336-a98d427b2981",
                        "entry_id": "0de809d6-51d8-3519-aef1-d65814e75dbe",
                        "glosses": [
                            "Chien."
                        ],
                        "tags": [
                            "verlan"
                        ],
                        "examples": [
                            {
                                "example_id": "ca40123d-60bd-4bf8-bd7d-ac3b080b6764",
                                "sense_id": "d0290ef9-1a19-33c2-8336-a98d427b2981",
                                "text": "Ils bombent à la peinture rose les visons des baronnes qui snobent la torture animale. Ils portent les colliers de leurs ienchs pour se sentir aussi bêtes qu'eux."
                            }
                        ]
                    },
                    {
                        "sense_id": "158f6661-b904-3686-b8a7-68e436bfcd05",
                        "entry_id": "0de809d6-51d8-3519-aef1-d65814e75dbe",
                        "glosses": [
                            "Utilisé dans des expressions négatives ou péjoratives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23f643dc-3958-430c-afaa-7b9273a26e8f",
                                "sense_id": "158f6661-b904-3686-b8a7-68e436bfcd05",
                                "text": "Mon employeur me traite comme un iench."
                            },
                            {
                                "example_id": "2822d4b4-8481-43ec-a421-b373c5173edb",
                                "sense_id": "158f6661-b904-3686-b8a7-68e436bfcd05",
                                "text": "Ziva, ne me laisse pas en iench !"
                            },
                            {
                                "example_id": "ce3ab5cc-d18b-41b0-94f7-3b5a3795bb45",
                                "sense_id": "158f6661-b904-3686-b8a7-68e436bfcd05",
                                "text": "On dirait que pour uil, son iench, c’est mieux que sa femme !"
                            }
                        ]
                    }
                ],
