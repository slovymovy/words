                                "target_senses": [
                                    {
                                        "sense_id": "f3c246ee-5298-3958-81c0-37aac78fe55b",
                                        "entry_id": "83aeffbf-9bad-317e-8f12-f3805b8d0bfb",
                                        "glosses": [
                                            "To treat with bacteria."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a62668d-c30b-490a-86f1-8785ac35b569",
                                                "sense_id": "f3c246ee-5298-3958-81c0-37aac78fe55b",
                                                "text": "An analysis was made of the mixture of active bacterized peat and soil at the commencement of incubation as well as at the end."
                                            },
                                            {
                                                "example_id": "3cf9c616-a046-44df-83ac-21f2e761d4e4",
                                                "sense_id": "f3c246ee-5298-3958-81c0-37aac78fe55b",
                                                "text": "We are going to bacterize about a ton of press cake and try it out on cane in the field, and see if we can notice differences."
                                            },
                                            {
                                                "example_id": "ce51bfbb-8eda-4565-9bbc-d6c681845bb1",
                                                "sense_id": "f3c246ee-5298-3958-81c0-37aac78fe55b",
                                                "text": "This suspension may also be used to bacterize plants as foliar sprays. Biocontrol agents thus applied have been effective in bringing about significant suppression of several serious foliar rice diseases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
