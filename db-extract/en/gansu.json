                "word": "Gansu",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ca15b48-d1cc-3e46-88ac-d2b58f8cded2",
                        "entry_id": "c6ad21a4-c151-3182-9574-4bc9d1bf2909",
                        "glosses": [
                            "A province in northwestern China. Capital: Lanzhou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4fc5e8-cec9-4de4-8190-0f4aa483d48b",
                                "sense_id": "4ca15b48-d1cc-3e46-88ac-d2b58f8cded2",
                                "text": "This is Lanzhou, the old Silk Road outpost that has matured into a metropolis of almost 4 million as the capital of Gansu province in China’s still-poor northwest. And as your lungs can attest, it is one of the most polluted cities in the country."
                            },
                            {
                                "example_id": "4a292b11-eddc-469f-a7d1-1ebf8cc1e373",
                                "sense_id": "4ca15b48-d1cc-3e46-88ac-d2b58f8cded2",
                                "text": "A towering wall of sand rushed over factories and apartment blocks in northwestern China's Gansu province as seasonal sandstorms barrelled across the country, causing air pollution and traffic accidents.\nAerial images as it struck showed an apocalyptic scene as a billowing cloud of yellow dust smothered Gansu's Linze county on Sunday."
                            }
                        ]
                    }
                ],
