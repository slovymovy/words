                            {
                                "example_id": "2d26fabd-a808-4aa1-82b4-04dbf1068783",
                                "sense_id": "a85b5a43-1e07-3557-81fb-5d2e02418d81",
                                "text": "Door tezelfdertijd Hammondorgel, Fender Rhodes en een andere elektrische piano te bedienen, onderwijl met zijn kin subtiel een sampler aanstippend, droeg de schijnbaar driearmige toetsenist zorg voor een enorme verrijking van het geluid."
                            },
                            {
                                "example_id": "f9d29dd7-3dfe-4a99-ba42-5f74a9a7bdc4",
                                "sense_id": "a85b5a43-1e07-3557-81fb-5d2e02418d81",
                                "text": "„Vindt u dat een mooie kandelaar?” Hij wijst naar het opzichtigste driearmige gedrocht dat ik ooit gezien heb: een met nep-Swarovskisteentjes beplakt geval met blikkerende hangpegels."
                            }
                        ]
