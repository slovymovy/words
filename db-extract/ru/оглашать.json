                "senses": [
                    {
                        "sense_id": "e53c8e40-e611-37fa-b8e5-e9f75cf6a968",
                        "entry_id": "ef892b71-cfaf-36ce-b0a9-94715c46c062",
                        "glosses": [
                            "официально публично произносить вслух какой-либо текст"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd834de-70c3-4f5d-85ec-5e64beff64e8",
                                "sense_id": "e53c8e40-e611-37fa-b8e5-e9f75cf6a968",
                                "text": "Оглашать результаты выборов."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff94b776-d5af-3a7f-8388-970de47dc774",
                        "entry_id": "ef892b71-cfaf-36ce-b0a9-94715c46c062",
                        "glosses": [
                            "предавать гласности информацию; доводить до сведения других людей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b220d983-b20d-425d-9591-3705c059fe5f",
                                "sense_id": "ff94b776-d5af-3a7f-8388-970de47dc774",
                                "text": "Он всегда следовал правилу: \"Не оглашай чужих проступков\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd201bc3-a4a2-35a9-9aef-2a2889fd8a8c",
                        "entry_id": "ef892b71-cfaf-36ce-b0a9-94715c46c062",
                        "glosses": [
                            "наполнять какое-то пространство громким звуком, криками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2718bb15-2076-41bb-9f31-60ed2e24ea0e",
                                "sense_id": "dd201bc3-a4a2-35a9-9aef-2a2889fd8a8c",
                                "text": "Все показывало, что хозяин дома любил повеселиться и двор часто оглашали пиршественные клики."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc257b48-8c0a-4abe-ae1b-9961699ba3a2",
                        "source_entry_id": "ef892b71-cfaf-36ce-b0a9-94715c46c062",
                        "source_sense_description": "провозглашать",
                        "target_lang_word": "announce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                        "entry_id": "31811f87-61a2-3101-8a62-e5e6adbe7493",
                                        "glosses": [
                                            "To give public notice of, especially for the first time; to make known."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb5d1f6-0cde-49f4-9dc5-9ac6e9eca757",
                                                "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                                "text": "Her [Queen Elizabeth’s] arrival was announced through the country by a peal of cannon from the ramparts."
                                            },
                                            {
                                                "example_id": "375c1a33-ff98-4530-96a7-1f594f961b91",
                                                "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                                "text": "Soon after the arrival of Mrs. Campbell, dinner was announced by Abboye. He came into the drawing room resplendent in his gold-and-white turban. […] His cummerbund matched the turban in gold lines."
                                            },
                                            {
                                                "example_id": "6e601948-3dc7-4117-9618-db0323ef2016",
                                                "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56178c69-1d15-3d48-aeca-ead8b37d7347",
                                        "entry_id": "31811f87-61a2-3101-8a62-e5e6adbe7493",
                                        "glosses": [
                                            "To pronounce; to declare by judicial sentence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae7af77-aff3-4c8e-965e-4791bba56c33",
                                                "sense_id": "56178c69-1d15-3d48-aeca-ead8b37d7347",
                                                "text": "Publish laws, announce / Or life or death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "046f0b12-b175-36fe-913c-e272499794e5",
                                        "entry_id": "31811f87-61a2-3101-8a62-e5e6adbe7493",
                                        "glosses": [
                                            "To act as announcer for (an event, usually sports)."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a85cca3b-9890-4658-b687-c154ab0696d7",
                                                "sense_id": "046f0b12-b175-36fe-913c-e272499794e5",
                                                "text": "Our coach has retired, but occasionally he still announces the games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad5f381d-0c5a-34bc-9a5a-ada7793bc6ae",
                                        "entry_id": "31811f87-61a2-3101-8a62-e5e6adbe7493",
                                        "glosses": [
                                            "To act or work as an announcer."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c7fe70-d3d3-4b4b-9360-57495cff7a21",
                                                "sense_id": "ad5f381d-0c5a-34bc-9a5a-ada7793bc6ae",
                                                "text": "Our coach has retired, but occasionally he still announces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56587934-e6ca-467b-8f41-7685cdcebd7b",
                        "source_entry_id": "ef892b71-cfaf-36ce-b0a9-94715c46c062",
                        "source_sense_description": "провозглашать",
                        "target_lang_word": "proclaim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proclaim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57bafd4b-4272-30ee-88b8-3cb3ff75f084",
                                        "entry_id": "b95dd0a1-f9a6-36a5-a64f-36d9df2b6ce0",
                                        "glosses": [
                                            "To announce or declare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3afb387-0a03-4496-b651-d3cd8bb4e827",
                                                "sense_id": "57bafd4b-4272-30ee-88b8-3cb3ff75f084",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            },
                                            {
                                                "example_id": "595ef749-5302-4732-ab64-b6919847cd13",
                                                "sense_id": "57bafd4b-4272-30ee-88b8-3cb3ff75f084",
                                                "text": "You have seen it for yourselves in the play by Aristophanes, where Socrates goes whirling round, proclaiming that he is walking on air, and uttering a great deal of other nonsense about things of which I know nothing whatsoever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d7ed93-274e-3ea2-ad07-a93761df6343",
                                        "entry_id": "b95dd0a1-f9a6-36a5-a64f-36d9df2b6ce0",
                                        "glosses": [
                                            "To make (something) the subject of an official proclamation bringing it within the scope of emergency powers."
                                        ],
                                        "tags": [
                                            "dated",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f549b902-21e0-4fb1-b46c-bb31003a7ee3",
                                                "sense_id": "54d7ed93-274e-3ea2-ad07-a93761df6343",
                                                "text": "Were those baronies proclaimed at the time you were in them? –Some of them are; the barony of Duhallow is proclaimed."
                                            },
                                            {
                                                "example_id": "48b9eaaa-6a9b-439e-b260-de118def50a7",
                                                "sense_id": "54d7ed93-274e-3ea2-ad07-a93761df6343",
                                                "text": "… the Magistrates present, naturally excited by the occurrence, applied to Government to proclaim the baronies in which the outrage had occurred …"
                                            },
                                            {
                                                "example_id": "1c1e5569-6210-4768-808b-d53a3fbba979",
                                                "sense_id": "54d7ed93-274e-3ea2-ad07-a93761df6343",
                                                "text": "In due course the Dáil was proclaimed, fruitless efforts were made to suppress it and all its institutions, including, of course, the IRA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a18c410-21e0-4581-a919-6eae0a40cc0a",
                        "source_entry_id": "ef892b71-cfaf-36ce-b0a9-94715c46c062",
                        "source_sense_description": "разглашать",
                        "target_lang_word": "divulge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divulge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a84569c-90ef-345d-bb0b-6627d81adc27",
                                        "entry_id": "5e2bdc4b-3427-31a6-9472-08495f5df182",
                                        "glosses": [
                                            "To make public or known; to communicate to the public; to tell (information, especially a secret) so that it may become generally known."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c59e3a78-1a1d-4221-b206-ef2fd0b7b8c4",
                                                "sense_id": "1a84569c-90ef-345d-bb0b-6627d81adc27",
                                                "text": "I will never divulge that secret to anyone."
                                            },
                                            {
                                                "example_id": "11fa9181-c31f-4cba-b43d-08bb6c76cdd6",
                                                "sense_id": "1a84569c-90ef-345d-bb0b-6627d81adc27",
                                                "text": "In an interview with The Economist last year, he insisted his attack on the CPP had nothing to do with his views on global warming, which he would not divulge."
                                            },
                                            {
                                                "example_id": "a8246e79-8c4e-4882-929c-32e75ddd3d43",
                                                "sense_id": "1a84569c-90ef-345d-bb0b-6627d81adc27",
                                                "text": "Here then is a letter from a young man whose name I must not reveal, but whom I will designate as D. F., and whose address I must not divulge, but will simply indicate as Q. Street, West."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9fe51f-3010-3ed8-932a-925f55c5e5d9",
                                        "entry_id": "5e2bdc4b-3427-31a6-9472-08495f5df182",
                                        "glosses": [
                                            "To indicate publicly; to proclaim."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c536dbe6-24ef-42bc-b9a2-b8631e844c9a",
                                                "sense_id": "4a9fe51f-3010-3ed8-932a-925f55c5e5d9",
                                                "text": "God... marks The just man, and divulges him through heaven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
