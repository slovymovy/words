{
    "word_family": [
        "варежный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87095c21-23fb-37d6-a624-29413f8d6d8e",
                    "sense_definition": "Тёплая, обычно вязаная рукавица для защиты рук от холода.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В суровых условиях Севера без толстых <w>варежек</w> не обойдёшься.",
                            "target_lang_translations": {
                                "en": "In the harsh conditions of the North, you can't do without thick <w>mittens</w>."
                            }
                        },
                        {
                            "text": "Саша шла к ним, <w>варежка</w> о <w>варежку</w> отрясая опилки.",
                            "target_lang_translations": {
                                "en": "Sasha walked toward them, shaking the sawdust off by clapping <w>mitten</w> against <w>mitten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "рукавица",
                        "рукавичка"
                    ],
                    "common_phrases": [
                        "вязаные варежки",
                        "тёплые варежки"
                    ],
                    "target_lang_definitions": {
                        "en": "A warm, usually knitted glove that covers the hand with a separate section for the thumb and a single section for the other fingers, used to protect hands from the cold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mitten",
                                "target_lang_sense_clarification": "A garment covering the hand with a separate sheath for the thumb."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b5668af-5ccf-3af5-ab86-48d7388d881d",
                    "sense_definition": "Грубое обозначение рта.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хватит болтать, закрой свою <w>варежку</w>!",
                            "target_lang_translations": {
                                "en": "Stop talking, shut your <w>trap</w>!"
                            }
                        },
                        {
                            "text": "У него от удивления <w>варежка</w> открылась.",
                            "target_lang_translations": {
                                "en": "His <w>trap</w> dropped open in surprise."
                            }
                        }
                    ],
                    "common_phrases": [
                        "закрой варежку"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "грубое просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A rude, colloquial term for the mouth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trap",
                                "target_lang_sense_clarification": "Slang term for the mouth, often used in the phrase 'shut your trap'."
                            },
                            {
                                "target_lang_word": "yap",
                                "target_lang_sense_clarification": "Slang term for the mouth, often used in the phrase 'shut your yap'."
                            }
                        ]
                    }
                }
            ]
        },
