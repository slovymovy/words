                ],
                "senses": [
                    {
                        "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                        "entry_id": "4252f7e4-81ad-311c-8d74-7d6e22edffef",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e42f1047-ee52-48e6-99ab-945d5c8e0626",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Frau Frieling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d99b7abe-5899-44a0-affd-39e911b800df",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Herr Frieling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "babecc72-da12-47cc-94de-d5d2f5f0ca55",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Die Frielings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0b0f8269-0988-459d-be10-a6d5d4a87b50",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Der Frieling trägt nie die Schals, die die Frieling ihm strickt."
                            },
                            {
                                "example_id": "52fd0f2f-e30b-48cb-b986-9fc094889062",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frieling kommt, geht der Herr Frieling.“"
                            },
                            {
                                "example_id": "3c03462f-6618-4d2e-8254-36dba2373732",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Frieling kommt und geht."
                            },
                            {
                                "example_id": "28809b4b-9e57-4612-8762-edba2aa652bd",
                                "sense_id": "9a8c6c58-2b28-3962-81dc-2235da552058",
                                "text": "Frielings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
