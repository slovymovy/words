                                                "sense_id": "7f8a1714-ba35-3957-8a6d-4be0a02ea17a",
                                                "text": "Po stawie pływały kaczki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "8314d39b-16bb-3ca0-a085-8f9b51a2decd",
                                        "entry_id": "165c73e4-aae2-38d2-8029-cca276c4d372",
                                        "glosses": [
                                            "samica kaczki (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf252641-e1e4-45c4-af2b-0a743abf35d4",
                                                "sense_id": "8314d39b-16bb-3ca0-a085-8f9b51a2decd",
                                                "text": "Gdy kaczka siedzi na jajkach, kaczor szuka pożywienia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "7b5657ef-df9e-3ed1-929b-de7bf8f5d93f",
                                        "entry_id": "165c73e4-aae2-38d2-8029-cca276c4d372",
                                        "glosses": [
