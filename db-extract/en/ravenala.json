                                        "glosses": [
                                            "Arbre du voyageur (Ravenala madagascariensis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c47d81-be04-4d40-a463-843458e4f55b",
                                                "sense_id": "7e0eb276-85dd-34ac-a6da-0c041b3f3a75",
                                                "text": "Un ravenala, l’arbre du voyageur, dressait son bouquet d’immenses écrans chinois."
                                            },
                                            {
                                                "example_id": "391a6fa7-1b2f-4624-aa62-c4d2e20e7b98",
                                                "sense_id": "7e0eb276-85dd-34ac-a6da-0c041b3f3a75",
                                                "text": "Dans les engainements des feuilles s'accumule de l'eau, d'où le nom d'arbre à eau donné au ravenala qui croît surtout à Madagascar."
                                            }
                                        ]
                                    }
