                "senses": [
                    {
                        "sense_id": "f5c22467-4c83-3dcc-b2ca-eba67a914737",
                        "entry_id": "1f1326de-d23e-3eea-a235-d99a7edf9a35",
                        "glosses": [
                            "Acheta domesticus, ein Vertreter der echten Grillen"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "826fa7d4-05b2-49c9-91ba-a3a3aea57a44",
                                "sense_id": "f5c22467-4c83-3dcc-b2ca-eba67a914737",
                                "text": "Nachts hört man die Heimchen zirpen."
                            },
                            {
                                "example_id": "a8f18494-fe01-4864-b713-39eb266dad12",
                                "sense_id": "f5c22467-4c83-3dcc-b2ca-eba67a914737",
                                "text": "„In einer Ritze begann ein Heimchen zu zirpen, als frohlocke es über den Sieg, den es über alle die in Schlaf gesunkenen Menschen davongetragen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c045316-1d67-3085-815d-0ebe7ab076b9",
                        "entry_id": "1f1326de-d23e-3eea-a235-d99a7edf9a35",
                        "glosses": [
                            "Frau, die wenig bewundert/geschätzt wird"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6774b265-5543-48b2-9042-711790e3e6db",
                                "sense_id": "8c045316-1d67-3085-815d-0ebe7ab076b9",
                                "text": "„Und von diesem Heimchen verlangte man nun, die Kinder fortzuschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
