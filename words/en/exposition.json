{
    "word_family": [
        "expose",
        "expository",
        "exposure"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e1e60e5e-a0e7-3785-baf7-5966aeb7ccc3",
                    "sense_definition": "A large public exhibition or trade show displaying art, manufactured goods, or cultural achievements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest technological innovations were displayed at the international <w>exposition</w>.",
                            "target_lang_translations": {
                                "zh": "最新的技术创新在国际<w>博览会</w>上展出。"
                            }
                        },
                        {
                            "text": "Thousands of visitors attended the trade <w>exposition</w> to discover new green energy products.",
                            "target_lang_translations": {
                                "zh": "成千上万的参观者参加了这场贸易<w>展览会</w>，以了解新的绿色能源产品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exhibition",
                        "expo"
                    ],
                    "common_phrases": [
                        "international exposition",
                        "trade exposition"
                    ],
                    "target_lang_definitions": {
                        "zh": "大型博览会、展览会，用于展示艺术、工业产品或文化成就"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "博览会",
                                "target_lang_sense_clarification": "大型综合性展会"
                            },
                            {
                                "target_lang_word": "展览会",
                                "target_lang_sense_clarification": "展示物品或成果的集会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d39c60ee-6bf4-32bf-b19f-0305bf28f37d",
                    "sense_definition": "A comprehensive explanation or description of an idea, theory, or background details in writing or speech.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opening chapter contains a lot of <w>exposition</w> about the main character's past.",
                            "target_lang_translations": {
                                "zh": "开篇章节包含了大量关于主角过去的<w>交代</w>。"
                            }
                        },
                        {
                            "text": "The professor gave a clear <w>exposition</w> of the economic theory during his lecture.",
                            "target_lang_translations": {
                                "zh": "教授在讲座中对这一经济理论作了清晰的<w>阐述</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explanation",
                        "elucidation"
                    ],
                    "common_phrases": [
                        "clear exposition"
                    ],
                    "target_lang_definitions": {
                        "zh": "对思想、理论或背景情况的系统阐述、详细说明或解释"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阐述",
                                "target_lang_sense_clarification": "系统说明观点或理论"
                            },
                            {
                                "target_lang_word": "解释",
                                "target_lang_sense_clarification": "说明含义或背景"
                            },
                            {
                                "target_lang_word": "说明",
                                "target_lang_sense_clarification": "交代情况或事理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "063c06da-e302-3958-9d67-b19fa0f0c977",
                    "sense_definition": "The introductory part of a play, novel, or film that establishes the setting, characters, and background circumstances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie relies heavily on clunky dialogue to deliver its dramatic <w>exposition</w>.",
                            "target_lang_translations": {
                                "zh": "这部电影严重依赖拙劣的对白来进行戏剧性的<w>背景交代</w>。"
                            }
                        },
                        {
                            "text": "In the play's <w>exposition</w>, the audience learns about the family's troubled history.",
                            "target_lang_translations": {
                                "zh": "在戏剧的<w>开端</w>，观众了解到了这个家族的不幸历史。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "戏剧、小说或电影中交代背景、人物及情境的序篇或交代部分"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "交代",
                                "target_lang_sense_clarification": "交代背景或前情"
                            },
                            {
                                "target_lang_word": "背景交代",
                                "target_lang_sense_clarification": "作品开端提供背景信息的部分"
                            },
                            {
                                "target_lang_word": "开端",
                                "target_lang_sense_clarification": "叙事作品交代情境的起始部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9241cfb4-a4c2-3cf0-a583-236f5da92dfa",
                    "sense_definition": "A written or spoken discourse that discusses a particular subject in thorough detail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She published a detailed <w>exposition</w> on the historical origins of the language.",
                            "target_lang_translations": {
                                "zh": "她发表了一篇关于该语言历史渊源的详细<w>论述</w>。"
                            }
                        },
                        {
                            "text": "His <w>exposition</w> of the political crisis was widely praised by journalists.",
                            "target_lang_translations": {
                                "zh": "他对这场政治危机的<w>阐述</w>受到了记者的广泛赞誉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "treatise",
                        "dissertation"
                    ],
                    "common_phrases": [
                        "detailed exposition"
                    ],
                    "target_lang_definitions": {
                        "zh": "详尽论述某一课题的论著、专论或论述"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "论述",
                                "target_lang_sense_clarification": "深入系统的分析探讨"
                            },
                            {
                                "target_lang_word": "专论",
                                "target_lang_sense_clarification": "针对特定主题的详细论著"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5867510c-c7a5-3820-b954-8ec4229e71f7",
                    "sense_definition": "The initial section of a musical movement, such as in sonata form or a fugue, where the main themes are first stated.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist repeated the <w>exposition</w> to emphasize the contrasting melodic themes.",
                            "target_lang_translations": {
                                "zh": "钢琴家重复弹奏了<w>呈示部</w>，以强化形成对比的旋律主题。"
                            }
                        },
                        {
                            "text": "In the symphony's opening movement, the first theme appears clearly in the <w>exposition</w>.",
                            "target_lang_translations": {
                                "zh": "在这部交响曲的第一乐章中，第一主题在<w>呈示部</w>清晰地呈现出来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "乐章（如奏鸣曲式或赋格）中首次陈述主要主题的呈示部"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呈示部",
                                "target_lang_sense_clarification": "曲式学专有名词，乐曲最初呈现主题的段落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed9aca23-1b8c-315d-bff6-145475caac23",
                    "sense_definition": "The act of exposing something to an external influence or element, such as skin to the sun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exposure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prolonged <w>exposition</w> to direct sunlight can cause serious damage to delicate fabrics.",
                            "target_lang_translations": {
                                "zh": "长时间<w>暴露</w>在阳光直射下可能会对娇嫩的面料造成严重损伤。"
                            }
                        },
                        {
                            "text": "The patient suffered from severe burns due to prolonged <w>exposition</w> to radiation.",
                            "target_lang_translations": {
                                "zh": "由于长时间<w>暴露</w>在辐射中，该患者遭受了严重灼伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exposure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "More commonly expressed as exposure in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "暴露于外部影响或环境元素之下（现多用 exposure）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暴露",
                                "target_lang_sense_clarification": "显露在阳光、辐射等之下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cc0051f-38dd-3d92-87e8-94721fd34e7e",
                    "sense_definition": "The act of expelling someone or being expelled from a place or community.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical records document the forced <w>exposition</w> of the dissidents from their homeland.",
                            "target_lang_translations": {
                                "zh": "历史文献记载了持不同政见者被强制<w>驱逐</w>出家园的经过。"
                            }
                        },
                        {
                            "text": "The decree ordered the sudden <w>exposition</w> of all foreigners living within the city walls.",
                            "target_lang_translations": {
                                "zh": "该法令下令立即<w>驱逐</w>居住在城墙内的所有外国人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expulsion"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used historically in the sense of expulsion"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "驱逐出境，逐出某地或社群（古旧用法，同 expulsion）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驱逐",
                                "target_lang_sense_clarification": "强行赶出某地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc44cf88-7ce6-3b22-b554-dbb36ecc1f11",
                    "sense_definition": "The historical practice of abandoning an unwanted infant in a public or deserted place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient Roman laws permitted the <w>exposition</w> of infants who could not be cared for.",
                            "target_lang_translations": {
                                "zh": "古罗马法律允许将无力抚养的婴儿<w>遗弃</w>。"
                            }
                        },
                        {
                            "text": "Scholars debated whether the widespread <w>exposition</w> of children was common across all social classes.",
                            "target_lang_translations": {
                                "zh": "学者们探讨了广泛的<w>弃婴</w>现象在所有社会阶层中是否都很普遍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exposure",
                        "abandonment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical practice"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "历史上将不想要的婴儿遗弃在公共场所或荒野的做法"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弃婴",
                                "target_lang_sense_clarification": "指遗弃婴儿的行为或习俗"
                            },
                            {
                                "target_lang_word": "遗弃",
                                "target_lang_sense_clarification": "抛弃婴儿的行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}