{
    "word_family": [
        "cogwheel",
        "cogged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd9379f2-3cc9-33b6-a562-3adf80487a00",
                    "sense_definition": "A tooth on the rim of a gear or wheel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine stopped working because a single <w>cog</w> had broken off the main gear.",
                            "target_lang_translations": {
                                "ru": "Машина перестала работать, потому что один <w>зубец</w> отломился от главной шестерни."
                            }
                        },
                        {
                            "text": "He carefully cleaned every <w>cog</w> to ensure the clockwork mechanism ran smoothly.",
                            "target_lang_translations": {
                                "ru": "Он тщательно очистил каждый <w>зубец</w>, чтобы часовой механизм работал плавно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broken cog",
                        "metal cog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зубец на ободе шестерни или колеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубец",
                                "target_lang_sense_clarification": "выступ на шестерне"
                            },
                            {
                                "target_lang_word": "зуб",
                                "target_lang_sense_clarification": "деталь механизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b90675f3-eed8-32d1-a41e-c70057fbede0",
                    "sense_definition": "A gear or a wheel with teeth that mesh with another to transmit motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large <w>cog</w> turns the smaller one at a much higher speed.",
                            "target_lang_translations": {
                                "ru": "Большая <w>шестерня</w> вращает меньшую с гораздо более высокой скоростью."
                            }
                        },
                        {
                            "text": "You can see the <w>cog</w> spinning behind the glass of the old watch.",
                            "target_lang_translations": {
                                "ru": "Вы можете видеть, как за стеклом старых часов вращается <w>шестерёнка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spinning cog",
                        "interlocking cog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шестерня или колесо с зубьями, которое входит в зацепление с другим для передачи движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестерня",
                                "target_lang_sense_clarification": "зубчатое колесо"
                            },
                            {
                                "target_lang_word": "зубчатое колесо",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcaf4b2c-4996-37c5-a9d7-e734c4b061fa",
                    "sense_definition": "A person who plays a minor but necessary part in a large organization or system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like just a <w>cog</w> in the machine at the massive corporation.",
                            "target_lang_translations": {
                                "ru": "В этой огромной корпорации он чувствовал себя всего лишь <w>винтиком</w> в системе."
                            }
                        },
                        {
                            "text": "Even though she was a small <w>cog</w>, her contribution was vital to the project's success.",
                            "target_lang_translations": {
                                "ru": "Хотя она была лишь маленьким <w>винтиком</w>, её вклад был жизненно важен для успеха проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cog in the machine",
                        "small cog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, играющий незначительную, но необходимую роль в большой организации или системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винтик",
                                "target_lang_sense_clarification": "в системе или механизме"
                            },
                            {
                                "target_lang_word": "мелкая сошка",
                                "target_lang_sense_clarification": "незначительный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "582c8a6f-3a8e-38b4-8814-d74b0a82a0f1",
                    "sense_definition": "A type of medieval merchant ship with a single mast and a rounded hull.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "maritime_history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval <w>cog</w> was the primary vessel used for trade across the North Sea.",
                            "target_lang_translations": {
                                "ru": "Средневековый <w>когг</w> был основным судном, использовавшимся для торговли в Северном море."
                            }
                        },
                        {
                            "text": "Archaeologists discovered the remains of a 14th-century <w>cog</w> buried in the silt.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили останки <w>когга</w> XIV века, погребенные в иле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "medieval cog",
                        "merchant cog"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "historical maritime context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип средневекового торгового судна с одной мачтой и закругленным корпусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когг",
                                "target_lang_sense_clarification": "историческое судно"
                            },
                            {
                                "target_lang_word": "ког",
                                "target_lang_sense_clarification": "вариант названия судна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b58f94ba-a0b2-363c-be6a-381fc3b88049",
                    "sense_definition": "A projection on a beam designed to fit into a matching hole to form a joint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carpentry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter carved a precise <w>cog</w> at the end of the timber beam.",
                            "target_lang_translations": {
                                "ru": "Плотник вырезал точный <w>шип</w> на конце деревянной балки."
                            }
                        },
                        {
                            "text": "The joint was secured by fitting the <w>cog</w> into the corresponding notch.",
                            "target_lang_translations": {
                                "ru": "Соединение было закреплено путем установки <w>шипа</w> в соответствующий паз."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступ на балке, предназначенный для вставки в соответствующее отверстие для образования соединения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "в плотницком деле"
                            },
                            {
                                "target_lang_word": "выступ",
                                "target_lang_sense_clarification": "для соединения деталей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65908d44-8e09-3523-a36d-87ded1dde0e2",
                    "sense_definition": "A trick, deception, or a dishonest act.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text warned against the many <w>cogs</w> and forgeries of dishonest men.",
                            "target_lang_translations": {
                                "ru": "Старинный текст предостерегал от многочисленных <w>уловок</w> и подделок бесчестных людей."
                            }
                        },
                        {
                            "text": "He was known for his clever <w>cogs</w> and deceptive behavior in business.",
                            "target_lang_translations": {
                                "ru": "Он был известен своими хитрыми <w>обманами</w> и лживым поведением в бизнесе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уловка, обман или нечестный поступок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрость"
                            },
                            {
                                "target_lang_word": "обман",
                                "target_lang_sense_clarification": "мошенничество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b22e56c-e633-3826-880e-1f2aab2079fe",
                    "sense_definition": "To cheat or act fraudulently, especially during a game of dice or cards.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gambler was caught trying to <w>cog</w> the dice to ensure a winning roll.",
                            "target_lang_translations": {
                                "ru": "Игрок был пойман при попытке <w>подстроить</w> кости, чтобы обеспечить выигрышный бросок."
                            }
                        },
                        {
                            "text": "He would often <w>cog</w> at cards when he thought no one was watching.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>жульничал</w> в картах, когда думал, что никто не смотрит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cog the dice"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жульничать или действовать мошенническим путем, особенно во время игры в кости или карты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жульничать",
                                "target_lang_sense_clarification": "в азартных играх"
                            },
                            {
                                "target_lang_word": "передёргивать",
                                "target_lang_sense_clarification": "в картах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "081772d2-e9a3-31e9-8252-6936c905a5d7",
                    "sense_definition": "To copy someone else's work dishonestly; to plagiarize.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were warned not to <w>cog</w> their essays from online sources.",
                            "target_lang_translations": {
                                "ru": "Студентов предупредили, чтобы они не <w>списывали</w> свои эссе из онлайн-источников."
                            }
                        },
                        {
                            "text": "He managed to <w>cog</w> the answers from his neighbor during the final exam.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>списать</w> ответы у соседа во время выпускного экзамена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cog from"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "specifically used in some dialects like Irish English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестно копировать чужую работу; заниматься плагиатом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "списывать",
                                "target_lang_sense_clarification": "у другого ученика"
                            },
                            {
                                "target_lang_word": "плагиатить",
                                "target_lang_sense_clarification": "копировать работу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9759eee-1488-3794-9884-dad90c76de61",
                    "sense_definition": "An abbreviation for the Church of God, referring to various Christian denominations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_org",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He is an active member of the local <w>COG</w> congregation in his hometown.",
                            "target_lang_translations": {
                                "ru": "Он является активным членом местной общины <w>Церкви Бога</w> в своем родном городе."
                            }
                        },
                        {
                            "text": "The <w>COG</w> has several different branches across the United States.",
                            "target_lang_translations": {
                                "ru": "<w>Церковь Бога</w> имеет несколько различных ветвей по всем Соединенным Штатам."
                            }
                        }
                    ],
                    "synonyms": [
                        "C.G."
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для Церкви Бога, относящаяся к различным христианским деноминациям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Церковь Бога",
                                "target_lang_sense_clarification": "религиозная организация"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}