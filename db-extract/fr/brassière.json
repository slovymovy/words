        "fr-extract.jsonl": [
            {
                "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                "word": "brassière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9212f13e-8ed4-4715-93e1-2afd31e3ad1e",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "tags": [
                            "plural"
                        ],
                        "form": "brassières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f95b65a-a028-362d-adb0-a534143c3672",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "glosses": [
                            "Espèce de petite camisole qui sert à maintenir le corps et qui est particulièrement en usage pour les enfants. Petite chemise de bébé, courte, à manches longues, en toile fine ou en laine, qui se ferme dans le dos."
                        ],
                        "tags": [
                            "Puériculture"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ac7259-78c4-4a39-8f1d-5e114c31fe53",
                                "sense_id": "5f95b65a-a028-362d-adb0-a534143c3672",
                                "text": "Sur les planches nues et vastes, il n’y avait plus que les langes délicats, les petites brassières, les petits bonnets, les petits chaussons, les tas de couches, toute cette lingerie fine, cette plume légère d’oiseau encore au nid."
                            },
                            {
                                "example_id": "79c2ed2f-6ef3-41f2-b356-7848467e24e7",
                                "sense_id": "5f95b65a-a028-362d-adb0-a534143c3672",
                                "text": "Je me dis que […] chez les malheureux Pluvier un enfant va encore venir au monde sans langes, ni brassières, si je ne m’en mêle pas…"
                            },
                            {
                                "example_id": "3e37e5b8-a291-401a-a447-efc39549a8da",
                                "sense_id": "5f95b65a-a028-362d-adb0-a534143c3672",
                                "text": "Avec quelques points de textile, Odette m’avait offert une chemisette à carreaux. Au bout de quelques lavages, elle était devenue une brassière !"
                            }
                        ]
                    },
                    {
                        "sense_id": "16f870a0-d3e8-3b2a-9bff-cd6197012c16",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "glosses": [
                            "Lanière de cuir, d’étoffe ou corde qui sert à porter sur le dos un sac ou une hotte, et que l’on se passe sous les bras."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "073af9ff-155a-3b68-9527-cc74097db9e1",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "glosses": [
                            "Bouée de sauvetage que l’on passe autour du bras, utilisée principalement par les enfants."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5992da3-2fe2-3474-8443-7731095e1bd3",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "glosses": [
                            "Chemise de femme, très ajustée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4855a0ea-fefd-324e-babc-4cead0c5b8c7",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "glosses": [
                            "Soutien-gorge."
                        ],
                        "tags": [
                            "Vieilli sauf au Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd503d9-0fc1-409a-83a0-e526d30b7f5f",
                                "sense_id": "4855a0ea-fefd-324e-babc-4cead0c5b8c7",
                                "text": "[…] une tenue de natation, composée d’une brassière, d’une culotte haute et d’un bonnet de bain en plastique épais qu’elle jugea ridicule."
                            }
                        ]
                    },
                    {
                        "sense_id": "03aab9ad-400e-3cd5-b88f-4068af4968af",
                        "entry_id": "a9bd05ff-163c-3e59-a837-a6c4a619d12e",
                        "glosses": [
                            "Canal, bras de fleuve."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "84f56724-953c-4de9-827a-8d88231e135a",
                                "sense_id": "03aab9ad-400e-3cd5-b88f-4068af4968af",
                                "text": "La brassière de Fourques, les brassières du Rhône."
                            }
                        ]
                    }
                ],
