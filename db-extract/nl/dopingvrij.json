                    {
                        "sense_id": "7c72ea61-a898-3501-a4a9-82973a8c990f",
                        "entry_id": "92792c5c-0a59-343c-8931-f4bfcc6322fb",
                        "glosses": [
                            "zonder het gebruik van verbonden stimulerende middelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e2088df-e71f-42c3-b7be-ffee613266d2",
                                "sense_id": "7c72ea61-a898-3501-a4a9-82973a8c990f",
                                "text": "\"Erg teleurstellend\", vindt Marcel Kittel van de positieve dopingtest van de Zuid-Afrikaan Daryl Impey. \"Topsport zal nooit helemaal dopingvrij zijn. Dat is nu eenmaal zo.\""
                            },
                            {
                                "example_id": "a7718cc8-baa3-482f-a291-7a60bab3c4ae",
                                "sense_id": "7c72ea61-a898-3501-a4a9-82973a8c990f",
                                "text": "De Boer: \"Dopingcontroleurs hebben altijd achter in het peloton gezeten, op een gegeven moment zaten ze midden in het peloton, en nu hebben ze misschien zicht op de kopgroep. Maar je moet niet de illusie hebben dat je de kopgroep echt kunt inhalen. Het is een illusie dat je de sport dopingvrij kunt maken.\""
                            }
                        ]
                    }
