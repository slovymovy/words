                        "entry_id": "7fb4fff9-05b2-3703-8007-09dfe75753ef",
                        "glosses": [
                            "Réprimande faite le plus souvent sur un ton de reproche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb88de7-cf66-49d3-8811-03eb62bc0419",
                                "sense_id": "f2d78cb9-32d7-3da3-8e6d-f20cc1d6e87e",
                                "text": "Elles sont réservées pour calmer les pleurs, même si ces pleurs viennent d’une gronderie justifiée."
                            },
                            {
                                "example_id": "800d3e10-8c1a-4e07-928f-fe2d0980f6d4",
                                "sense_id": "f2d78cb9-32d7-3da3-8e6d-f20cc1d6e87e",
                                "text": "Le maître essaya d’expliquer la chose, mais il était réellement à moitié mort de fatigue, et tout ce que je pus distinguer, parmi les gronderies de sa femme, fut le récit de la façon dont il avait trouvé cet enfant, mourant de faim, et sans asile, et quasi-muet, dans les rues de Liverpool."
                            }
                        ]
                    }
