                "senses": [
                    {
                        "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                        "entry_id": "b6da88a2-b5c5-3c34-a0dd-b91652814799",
                        "glosses": [
                            "ein standsicheres, punktförmiges Fundament, das meist aus einem einzigen Fundamentstein besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4e7ca2-0ff7-4671-8e92-51b50cd7d1cd",
                                "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                                "text": "„Für Steinhauer und Marmoristen: Mit Zustimmung der Herren Kreisgerichtsschreiber Pfister und Stationsverwalter Wolkensperger dahier wird im gerichtlichen Auftrage das auf hiesigem Scheidegger'schen Steinhauerplatze befindliche Material als",
                                "translation": "nächsten Dienstag, den 5. Weinmonat, Morgens 9 Uhr gegen sofortige Baarzahlung öffentlich versteigert. […] Dübendorf, den 18. Herbstmonat 1869“"
                            },
                            {
                                "example_id": "0dfc656d-bd27-4cdc-8b63-6b8ae132faa6",
                                "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                                "text": "„Während der Baumeister Gartenmauern und Pfostamente erstellte, versetzte der Strassenbauer auf der gegenüberliegenden Seite die Abschlusssteine.“"
                            },
                            {
                                "example_id": "f80e1390-0ef1-494e-9918-1c37cda2754a",
                                "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                                "text": "„Pfostamente sind eine standsichere, solide Basis für Absperrungen, Zäune, Carports, Pergolen, Sitzbänke, Leuchten und vieles mehr.“"
                            },
                            {
                                "example_id": "ba2f9dbf-d9d5-4fdb-a4e2-53f9454d44d5",
                                "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                                "text": "„Da die Pfostamente Pyramidenstümpfe sind, sollten sie gegen Kippen oder Herausziehen […] gut durch die verdichtete Schotterschicht geschüzt sein.“"
                            },
                            {
                                "example_id": "be532ac8-f209-45e1-bb72-f84b3bdd7d60",
                                "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                                "text": "Unsere Carport ist auf vier Pfostamenten gegründet."
                            },
                            {
                                "example_id": "76a61840-b036-4b4a-89c0-d3a1d61de2a1",
                                "sense_id": "7e6709bb-c50a-39f6-a778-9d467d10cc32",
                                "text": "Pfostamente werden heutzutage häufig als Betonteile vorgefertigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
