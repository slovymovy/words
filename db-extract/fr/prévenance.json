                    {
                        "translation_id": "682a108a-3cb8-4972-a160-9003819d0309",
                        "source_entry_id": "a111cdf2-d201-3362-bd4e-b1ae9b3d46d9",
                        "source_sense_id": "99e3afeb-aaf3-3b11-aa11-bc20a4cb43ec",
