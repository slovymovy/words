                                        "glosses": [
                                            "Sportler, der die Sportart Sumo ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac439ffb-ee65-45f2-a684-1a452be43c57",
                                                "sense_id": "22c979cd-f53a-3a8a-8916-1fc91b1588a6",
                                                "text": "„Wie ein Sumoringer sieht Deimos nicht aus. Im Gegensatz zu den kämpfenden Kolossen aus Japan ist er ziemlich schmächtig.“"
                                            },
                                            {
                                                "example_id": "5110c65b-ddb1-401f-9a6b-4a755b1ce211",
                                                "sense_id": "22c979cd-f53a-3a8a-8916-1fc91b1588a6",
                                                "text": "„Dorthin begleitet er widerwillig den Nachbarsbuben Hiro (Loïc Sho Güntensperger), der Sumoringer werden und eine passende Schule besuchen will.“"
                                            },
                                            {
                                                "example_id": "e77b495a-a418-4bc6-99de-8330d0c5fa8c",
                                                "sense_id": "22c979cd-f53a-3a8a-8916-1fc91b1588a6",
                                                "text": "„Als Gastaussteller präsentiert der Bildhauer Christian Richter aus Kissing im Innenhof eine Reihe von Holzskulpturen, die Sumoringer darstellen, sowie mehr oder minder lebensechte Figuren von spielenden Kindern, die er aus Beton über einem Stahlgerüst modelliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
