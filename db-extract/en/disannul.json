                "senses": [
                    {
                        "sense_id": "293be9f8-d3dc-3e27-8bc5-80c37d797030",
                        "entry_id": "a992611f-907d-349b-8cc8-a0367d484847",
                        "glosses": [
                            "To annul, do away with; to cancel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee1f5d3-fd19-4468-96e0-34bf85115907",
                                "sense_id": "293be9f8-d3dc-3e27-8bc5-80c37d797030",
                                "text": "Ye shall not thynke that I am come to disanull the lawe, or the prophets."
                            },
                            {
                                "example_id": "8aa2d119-be0b-4b5c-b7ad-a01d9b70e4b3",
                                "sense_id": "293be9f8-d3dc-3e27-8bc5-80c37d797030",
                                "text": "But it is in our power, if not to dissanull, at least to diminish the same, through patience[…]."
                            },
                            {
                                "example_id": "0e1c49b2-50ad-4ff9-acae-5612702aab69",
                                "sense_id": "293be9f8-d3dc-3e27-8bc5-80c37d797030",
                                "text": "it is possible […] out of mature judgment to avoid the effect, or disannul the cause, as they do that are troubled with toothache, pull them quite out."
                            }
                        ]
                    }
