                                        "examples": [
                                            {
                                                "example_id": "700c5bb2-7352-47d6-9b8b-1b3815fbaea9",
                                                "sense_id": "e2cc52a0-6108-36f9-8635-1501de349039",
                                                "text": "Beinwelle sind mehrjährige krautige Pflanzen."
                                            }
