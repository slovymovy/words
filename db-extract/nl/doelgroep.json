                                "target_senses": [
                                    {
                                        "sense_id": "627d0d52-ffe8-377b-b6e2-8ec2a762b826",
                                        "entry_id": "a1c588d8-63f3-351f-bc78-9973e0ffeabb",
                                        "glosses": [
                                            "Sorte de planche servant de but pour le tir à l’arc ou avec des armes à feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148922ce-5b88-4c70-a079-a8e306591a1d",
                                                "sense_id": "627d0d52-ffe8-377b-b6e2-8ec2a762b826",
                                                "text": "– La comtesse ne vous a pas dit que son mari tirait à la cible ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e84bb7-d98a-3262-a1b3-dfa66204e3c8",
                                        "entry_id": "a1c588d8-63f3-351f-bc78-9973e0ffeabb",
                                        "glosses": [
                                            "Objet soumis intentionnellement à un bombardement de particules."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c6f2f1-3db0-413a-963e-4d4fb83e813d",
                                                "sense_id": "68e84bb7-d98a-3262-a1b3-dfa66204e3c8",
                                                "text": "cible de fusion inertielle, cible de spallation, cible de pulvérisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf82170e-68a7-3285-88aa-d784c0203899",
                                        "entry_id": "a1c588d8-63f3-351f-bc78-9973e0ffeabb",
                                        "glosses": [
                                            "But d’un tir sans arme, d’une malveillance, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f085bcef-6659-465f-b28e-3856ccb657d5",
                                                "sense_id": "cf82170e-68a7-3285-88aa-d784c0203899",
                                                "text": "Au bord du grand chemin, ta vie est une cible offerte à tout venant."
                                            },
                                            {
                                                "example_id": "abcd3774-c593-43ec-a1a0-5eb28394c68c",
                                                "sense_id": "cf82170e-68a7-3285-88aa-d784c0203899",
                                                "text": "Cette aide, d’un montant de 400 millions de dollars, comprend quatre systèmes de lance-roquettes multiple Himars et des munitions, qui ont déjà permis aux forces ukrainiennes d’attaquer des cibles avec des missiles tirés hors de portée de l’artillerie russe, a précisé un haut responsable du Pentagone."
                                            },
                                            {
                                                "example_id": "75b454db-a453-474e-88c6-0b6eb62876fc",
                                                "sense_id": "cf82170e-68a7-3285-88aa-d784c0203899",
                                                "text": "Particuliers, entreprises, administrations publiques sont les cibles des cyberprédateurs. Souvent d'ailleurs les cyberattaques les impliquent ensemble, car toute machine connectée peut en servir de vecteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7edf91-cf9e-3a9a-97b9-521b5462ad1c",
                                        "entry_id": "a1c588d8-63f3-351f-bc78-9973e0ffeabb",
                                        "glosses": [
                                            "But, objectif, public visé, particulièrement par une campagne publicitaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9fcbcbf-a31b-4c53-b8eb-5ff392155645",
                                                "sense_id": "cf7edf91-cf9e-3a9a-97b9-521b5462ad1c",
                                                "text": "Notre cible de l’année sera le consommateur de 14-16 ans."
                                            },
                                            {
                                                "example_id": "b8e370c2-3148-45cc-941f-06220e7c765c",
                                                "sense_id": "cf7edf91-cf9e-3a9a-97b9-521b5462ad1c",
                                                "text": "Il avait toujours vu en eux des clients atypiques, pas du même âge ni du même milieu que le reste de sa pratique, en somme ils ne faisaient pas partie de son cœur de cible."
                                            },
                                            {
                                                "example_id": "6d86f340-1df3-4841-8f5a-8661c91baa54",
                                                "sense_id": "cf7edf91-cf9e-3a9a-97b9-521b5462ad1c",
                                                "text": "Le plaisir des autres, c’est un peu comme les coins à champignons. On vous désigne approximativement l’endroit, mais il manque la précision qui vous permettrait de gagner d’emblée le cœur de la cible, et c’est très bien ainsi."
                                            },
                                            {
                                                "example_id": "ba1c4a94-ea9d-4c3e-bc55-6ed39fe963e0",
                                                "sense_id": "cf7edf91-cf9e-3a9a-97b9-521b5462ad1c",
                                                "text": "Il est question d’identifier l’humain uniquement et continuellement comme une cible marchande, en collectant tous les flux du réel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68ca59e-3b26-3929-8d3b-d106dcc1dbaf",
                                        "entry_id": "a1c588d8-63f3-351f-bc78-9973e0ffeabb",
                                        "glosses": [
                                            "Point de mire, personne ou objet concentrant l’attention, les moqueries, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2693799d-157b-404e-b579-d8215fae8890",
                                                "sense_id": "c68ca59e-3b26-3929-8d3b-d106dcc1dbaf",
                                                "text": "J’ai été la cible de toutes les attaques !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
