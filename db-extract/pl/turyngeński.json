                        "source_sense_id": "10ac6d14-987f-39ac-bdd9-448e16200f8b",
                        "target_lang_word": "Thüringer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thüringer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ea88dbf-5e5c-3c68-89d6-5098170c8156",
                                        "entry_id": "4fb4900c-56ff-3571-b8dd-caf1a5d3c08b",
                                        "glosses": [
                                            "ein im Freistaat Thüringen (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c6a26e-dc5c-4c38-b547-cf9d6f5108cb",
                                                "sense_id": "5ea88dbf-5e5c-3c68-89d6-5098170c8156",
                                                "text": "Wer in Thüringen das Wahlrecht hat, gilt als Thüringer."
                                            },
                                            {
                                                "example_id": "4dff69e2-2a02-4253-a07f-781095e4c250",
                                                "sense_id": "5ea88dbf-5e5c-3c68-89d6-5098170c8156",
                                                "text": "Die alten Thüringer lebten südlich des Harzes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ff9ed91-5770-3b53-b0a4-a46fe1f7ecd5",
                                        "entry_id": "4fb4900c-56ff-3571-b8dd-caf1a5d3c08b",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen westgermanischen Volksstammes"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Thüringer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99b5d3f1-e0da-319b-838f-269aa9b0f1ac",
                                        "entry_id": "077f2a6a-37d6-302f-bb2f-38f3cbedc960",
                                        "glosses": [
                                            "Thüringer Rostbratwurst"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "322fee2f-de3c-479b-9ed4-e1aed25c6c4b",
                                                "sense_id": "99b5d3f1-e0da-319b-838f-269aa9b0f1ac",
                                                "text": "Möchtest du lieber eine Thüringer oder eine Schinkenwurst?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Thüringer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f40a5c8-47fa-3029-9acb-f8bb8385ee77",
                                        "entry_id": "1f10cb2e-d390-3f25-abcc-9a4051af0509",
                                        "glosses": [
                                            "zu Thüringen, sich auf dieses Land beziehend, in der Art und Weise dieses Landes, aus Thüringen kommend, stammend, Thüringen betreffend, zu Thüringen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea22f6e-43b8-48a2-a1de-a21f53ced3b4",
                                                "sense_id": "3f40a5c8-47fa-3029-9acb-f8bb8385ee77",
                                                "text": "In dieser Zeit war er Thüringer Außenminister."
                                            },
                                            {
                                                "example_id": "3da7255c-414c-42be-82fc-188d5ef6f9a2",
                                                "sense_id": "3f40a5c8-47fa-3029-9acb-f8bb8385ee77",
                                                "text": "„Der Thüringer Rechnungshof hatte 2010 angesichts der hohen Verschuldung des Freistaats dringend eine Haushaltskonsolidierung angemahnt.“"
                                            },
                                            {
                                                "example_id": "a772fa2b-c628-46d0-9e78-8e75c3dc7b89",
                                                "sense_id": "3f40a5c8-47fa-3029-9acb-f8bb8385ee77",
                                                "text": "[Schlagzeile:] „Kampf ums Wohnen: Wie verschärfen Airbnb und Co. den Wohnungsmangel in Thüringer Städten?“"
                                            },
                                            {
                                                "example_id": "3067ed01-ba5a-4c6a-b86b-db10839a7780",
                                                "sense_id": "3f40a5c8-47fa-3029-9acb-f8bb8385ee77",
                                                "text": "„Bei den Landtagswahlen 1929 erhielt die Thüringer NSDAP schließlich über 11 Prozent – genug, um eine Koalition mit rechtsnationalen Parteien einzugehen und erstmals in ihrer Geschichte einen Minister zu stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Thüringer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                        "entry_id": "1a02b6ee-356c-38c7-8c82-46a8912eaae4",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11719788-2975-4dd6-9049-41ca248a8314",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Frau Thüringer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "640ae348-4909-408c-88d4-c06d58b38a48",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Herr Thüringer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1982c7c7-1667-4804-ada9-841837af7229",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Die Thüringers fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "4c26e50e-22d0-434e-864a-2084ecae0699",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Der Thüringer trägt nie die Pullover, die die Thüringer ihm strickt."
                                            },
                                            {
                                                "example_id": "6fb64274-1a29-4a14-8f73-2b9012e8c1a4",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thüringer kommt, geht der Herr Thüringer.“"
                                            },
                                            {
                                                "example_id": "5269dea6-4983-4f04-9235-126cf6636bd9",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Thüringer kommt und geht."
                                            },
                                            {
                                                "example_id": "3f29548d-c3c7-493f-b866-48d7cb7aab12",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Thüringers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
