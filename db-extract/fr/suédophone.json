                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Swedophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62cce09b-01db-3a17-b596-02febe1e649a",
                                        "entry_id": "6f17dff2-9846-357f-a2ef-cc69b84731ea",
                                        "glosses": [
                                            "Swedish-speaking."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48fe820f-aa3e-446f-bb22-e7d64382fddd",
                                                "sense_id": "62cce09b-01db-3a17-b596-02febe1e649a",
                                                "text": "The Swedophone part of the population (approximately 13 percent in 1900)"
                                            },
                                            {
                                                "example_id": "79660378-c827-4a1c-8f15-c192032e5112",
                                                "sense_id": "62cce09b-01db-3a17-b596-02febe1e649a",
                                                "text": "Over half the population are Swedophone in Jakobstad (Finnish: Pietarsaari), one of the most distinctive and enchanting spots on this part of the Finnish west coast known as parallelsverige (parallel Sweden)."
                                            },
                                            {
                                                "example_id": "0212c917-f6e7-4fdc-89d1-215513341cd8",
                                                "sense_id": "62cce09b-01db-3a17-b596-02febe1e649a",
                                                "text": "Studies in Swedophone Literature and Culture"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Swedophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6723c8f3-835c-3c17-9f6f-0abaf8fe011a",
                                        "entry_id": "eca69b3d-a2b2-3a65-870f-be550f58e13e",
                                        "glosses": [
                                            "A speaker of Swedish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dfa5ea9-b84a-48e8-9a7e-d4aba8e0bb25",
                                                "sense_id": "6723c8f3-835c-3c17-9f6f-0abaf8fe011a",
                                                "text": "Swedophones may turn to the works of Christian Palme and Bo Pellnäs."
                                            },
                                            {
                                                "example_id": "39afb8ec-c482-4ae7-90e7-ab204f3e4bc9",
                                                "sense_id": "6723c8f3-835c-3c17-9f6f-0abaf8fe011a",
                                                "text": "These people would then have been forced to abandon their language and become Swedophones."
                                            },
                                            {
                                                "example_id": "013007cc-adf0-4a34-9643-74b61faf27c6",
                                                "sense_id": "6723c8f3-835c-3c17-9f6f-0abaf8fe011a",
                                                "text": "To ensure the survival of their language, the Swedophones now had to assert their right to be part of that country"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91edcfa6-e133-4bd7-a961-85f507d6cf47",
