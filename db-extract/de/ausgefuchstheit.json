                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eba0213d-1c3c-483e-8ef5-ac54e6785d2f",
                                "sense_id": "52de0bd7-cc97-3a7c-89c0-69e8400be0e4",
                                "text": "„Kein Wunder, wenn man wegen seiner Ausgefuchstheit gar zum kaiserlichen Hofkammerrat bestellt wird.“"
                            },
                            {
                                "example_id": "f5ce2adc-d294-40f4-9eb8-7c8fbed0802f",
                                "sense_id": "52de0bd7-cc97-3a7c-89c0-69e8400be0e4",
                                "text": "„Eine gewisse Ausgefuchstheit mag wohl auch unabdingbare Voraussetzung sein, um im Job Erfolg zu haben.“"
                            },
                            {
                                "example_id": "d00701fa-e405-4cb1-9d05-df20d355cea5",
                                "sense_id": "52de0bd7-cc97-3a7c-89c0-69e8400be0e4",
                                "text": "„Ein bisschen mehr Ausgefuchstheit und Versiertheit hätte man sich trotzdem gewünscht.“"
                            },
                            {
                                "example_id": "a41e0c7d-787d-4af4-9b0d-4d669c73ffb8",
                                "sense_id": "52de0bd7-cc97-3a7c-89c0-69e8400be0e4",
                                "text": "„Man merkt erst nach und nach, dass die Ausgefuchstheit gerade in der Einfachheit liegt, mit der hier ein hochkomplexes Feld zum Schwingen gebracht wird.“"
                            }
                        ],
