                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d351d296-184c-4110-8b93-c8a1fd1cc58f",
                                                "sense_id": "d0b898fc-e804-3d09-b27f-37bde4b8ed6f",
                                                "text": "Speech decomposition into a periodic and a non-periodic part is a subject of considerable importance with applications in speech synthesis, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8f4bd1-3327-3d48-a36a-371832faa44b",
                                        "entry_id": "14eddbb7-6636-371a-830e-98c506122576",
