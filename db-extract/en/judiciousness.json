        "de-extract.jsonl": [
            {
                "entry_id": "5cad3b0d-3323-37ef-b04a-ac57d56ccb0a",
                "word": "judiciousness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "feef6571-f048-3a6b-9cc9-48d65d3147f5",
                        "entry_id": "5cad3b0d-3323-37ef-b04a-ac57d56ccb0a",
                        "glosses": [
                            "Klugheit, Einsicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b8055a-24b8-4000-9c15-ee9cbf429fb5",
                                "sense_id": "feef6571-f048-3a6b-9cc9-48d65d3147f5",
                                "text": "\"I think Mr. Hogarth is only speaking with his usual judiciousness, when he observes, that \"whatever pleasure they must have given to the audiences of that age, they would fail to do so now....\"",
                                "translation": "Ich denke Mr. Hogarth spricht bloß mit seiner gewöhnlichen Einsicht, wenn er feststellt, dass „welches Vergnügen auch immer sie den Zuhörern dieses Zeitalters bereitet haben, würden sie jetzt damit scheitern … “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecaa7c9c-d988-44ca-ac04-50d27f588b58",
                        "source_entry_id": "5cad3b0d-3323-37ef-b04a-ac57d56ccb0a",
                        "source_sense_id": "feef6571-f048-3a6b-9cc9-48d65d3147f5",
                        "source_sense_description": "Klugheit, Einsicht",
                        "target_lang_word": "Klugheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klugheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb7cba0-b718-379f-a845-53c45ec1931c",
                                        "entry_id": "5a84d1ea-8144-34b6-83e3-e56b985dfe58",
                                        "glosses": [
                                            "Begabung/Weisheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d2fb96-9473-4208-9bb4-899a2f2b60a9",
                                                "sense_id": "ceb7cba0-b718-379f-a845-53c45ec1931c",
                                                "text": "„[…] Menschen mit viel Berufserfahrung behalten zudem in schwierigen Situationen den Überblick, weil sie wissen, worauf es ankommt, und sich nicht durch irrelevante Informationen ablenken lassen. Immerhin ist ein wichtiger Aspekt von Klugheit, zu wissen, worauf man nicht zu achten braucht. […]“"
                                            },
                                            {
                                                "example_id": "158e5951-f71d-4641-a4ba-b35ea99ce963",
                                                "sense_id": "ceb7cba0-b718-379f-a845-53c45ec1931c",
                                                "text": "„CHORFÜHRERIN. Wie häßlich neben Schönheit zeigt sich Häßlichkeit.",
                                                "translation": "PHORKYAS. Wie unverständig neben Klugheit Unverstand.“"
                                            },
                                            {
                                                "example_id": "51d93a39-0cf9-48ac-af90-f3d540e4405b",
                                                "sense_id": "ceb7cba0-b718-379f-a845-53c45ec1931c",
                                                "text": "Mit Klugheit und Vernunft lässt sich hier mehr erreichen als mit roher Gewalt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67b5efdc-a4d7-35c7-a7b5-4fb0800bdb21",
                                        "entry_id": "5a84d1ea-8144-34b6-83e3-e56b985dfe58",
                                        "glosses": [
                                            "(vernünftiges/kluges) Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db34e676-9776-4a61-8532-0283cc9664f0",
                                                "sense_id": "67b5efdc-a4d7-35c7-a7b5-4fb0800bdb21",
                                                "text": "Mit Klugheit und Vernunft lässt sich hier mehr erreichen als mit roher Gewalt."
                                            },
                                            {
                                                "example_id": "031a30f9-e5c9-4ee9-b303-e1e57bf1e666",
                                                "sense_id": "67b5efdc-a4d7-35c7-a7b5-4fb0800bdb21",
                                                "text": "Sein diplomatisches Geschick, bei diesen schwierigen Vertragsverhandlungen zwischen den verschiedenen sich widerstrebenden Interessensgruppen, kann man nur loben und mit ausgewiesener Klugheit bezeichnen."
                                            },
                                            {
                                                "example_id": "b0e89b7b-fa6e-492a-9580-22981e8b3d42",
                                                "sense_id": "67b5efdc-a4d7-35c7-a7b5-4fb0800bdb21",
                                                "text": "Es war offensichtlich, durch „seine Klugheit wurde sie vor Schlimmerem bewahrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e919da79-93ce-3624-888a-00d2815168e4",
                                        "entry_id": "5a84d1ea-8144-34b6-83e3-e56b985dfe58",
                                        "glosses": [
                                            "(kluger) Spruch"
                                        ],
                                        "tags": [
                                            "meist abwertend",
                                            "ironisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d332808-5253-4125-bea0-1bc4a4821167",
                                                "sense_id": "e919da79-93ce-3624-888a-00d2815168e4",
                                                "text": "Wütend sagte er im Streit zu ihr: „Du und deine verdammte Klugheit, lass mich bloß in Ruhe!“"
                                            },
                                            {
                                                "example_id": "e0e3027f-85b5-461a-a187-16521d4f3439",
                                                "sense_id": "e919da79-93ce-3624-888a-00d2815168e4",
                                                "text": "„Deine Klugheiten kannst du die sparen.“"
                                            },
                                            {
                                                "example_id": "84ae074d-524a-425f-b2bf-312fbe383fb9",
                                                "sense_id": "e919da79-93ce-3624-888a-00d2815168e4",
                                                "text": "Du kannst gerne aufhören, hier deine Klugheiten zu verbreiten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ee5570-c1ce-4344-86c7-c8befd1e77fd",
                        "source_entry_id": "5cad3b0d-3323-37ef-b04a-ac57d56ccb0a",
                        "source_sense_id": "feef6571-f048-3a6b-9cc9-48d65d3147f5",
                        "source_sense_description": "Klugheit, Einsicht",
                        "target_lang_word": "Einsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                        "entry_id": "97a9ed98-cef2-35b9-aa28-5fb85d3195c0",
                                        "glosses": [
                                            "das Erkennen und Verstehen eines Sachverhaltes, das zielgerichtetes Verhalten ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc0f2a3-9b86-44c4-ae69-03afb68f4c33",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "Durch Einsicht können Menschen lernen, vieles besser zu verstehen."
                                            },
                                            {
                                                "example_id": "bbf3b809-a17b-40d4-ae49-ca0b03633680",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                                            },
                                            {
                                                "example_id": "a361b07a-a780-4518-832d-56914e6700e6",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "„Aus Einsicht kann Wissenschaft Heilung schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                        "entry_id": "97a9ed98-cef2-35b9-aa28-5fb85d3195c0",
                                        "glosses": [
                                            "Möglichkeit, etwas Konkretes mit den Augen zu sehen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb17377f-712a-42ab-bef0-b9bd8b4d950d",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "Auf Anfrage erhielten Sie Einsicht in die Akten."
                                            },
                                            {
                                                "example_id": "a0701a4b-c7e4-42fc-9d95-a4656b38c4c8",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "Der Kapitän hatte bereits Einsicht in die Hafeneinfahrt, als er den Lotsen an Bord nahm."
                                            },
                                            {
                                                "example_id": "e1f11fea-e414-42b2-aa61-704867e28a1d",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f78e30ad-324b-437b-a6bc-44f1cb4079d0",
                        "source_entry_id": "5cad3b0d-3323-37ef-b04a-ac57d56ccb0a",
                        "source_sense_id": "feef6571-f048-3a6b-9cc9-48d65d3147f5",
                        "source_sense_description": "Klugheit, Einsicht",
                        "target_lang_word": "sagesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sagesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c52cb49-861c-30b7-9f83-424071f15db1",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Prudence, circonspection, sentiment juste des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3fcdfce-7067-42bc-84cf-ace8788e378c",
                                                "sense_id": "8c52cb49-861c-30b7-9f83-424071f15db1",
                                                "text": "De W. était jeune ; il était attiré par les cadavres, comme l’homme de Platon. J’avais et j’eus toujours la sagesse de ne pas regarder ces choses de près."
                                            },
                                            {
                                                "example_id": "c854e565-ad58-46b4-a568-e2ff4d67040b",
                                                "sense_id": "8c52cb49-861c-30b7-9f83-424071f15db1",
                                                "text": "Il agit avec sa sagesse ordinaire."
                                            },
                                            {
                                                "example_id": "2774bc19-9869-4edc-a87d-7bdf9d7db929",
                                                "sense_id": "8c52cb49-861c-30b7-9f83-424071f15db1",
                                                "text": "Il a trop de sagesse pour s’embarquer dans cette affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811ea2ed-4fd7-3ff5-b2d1-264065819017",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Modération, retenue, maîtrise de soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0792a3f6-859a-4803-bdaa-0d8d9159f485",
                                                "sense_id": "811ea2ed-4fd7-3ff5-b2d1-264065819017",
                                                "text": "Dans ses plus grandes prospérités, il a toujours conservé beaucoup de sagesse."
                                            },
                                            {
                                                "example_id": "88cb002f-8dd7-444c-9cdf-68f46de23a00",
                                                "sense_id": "811ea2ed-4fd7-3ff5-b2d1-264065819017",
                                                "text": "Le prix de sagesse, Le prix qu’on donne, dans les écoles, à l’élève le plus sage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b4d5db-d736-3f1f-80fb-0c835e3705d7",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Modestie, pudeur, chasteté, surtout en parlant des jeunes filles et des femmes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a53543f-36c2-47f2-a7f1-3a4f9c003f36",
                                                "sense_id": "b3b4d5db-d736-3f1f-80fb-0c835e3705d7",
                                                "text": "Elle a un air de sagesse dans tout ce qu’elle dit, dans tout ce qu’elle fait."
                                            },
                                            {
                                                "example_id": "98c8bd51-518e-4005-ae49-204f28052902",
                                                "sense_id": "b3b4d5db-d736-3f1f-80fb-0c835e3705d7",
                                                "text": "Elle a toujours eu beaucoup de sagesse."
                                            },
                                            {
                                                "example_id": "a3d2a3d8-57ce-414f-87db-9b5a075c8479",
                                                "sense_id": "b3b4d5db-d736-3f1f-80fb-0c835e3705d7",
                                                "text": "Elle est d’une sagesse exemplaire."
                                            },
                                            {
                                                "example_id": "cf6ff34b-d143-45ee-b8fe-60508a3abf51",
                                                "sense_id": "b3b4d5db-d736-3f1f-80fb-0c835e3705d7",
                                                "text": "Quels changements en moi, depuis nos amours, quelles autres amours d’un mois, d’une semaine, d’une nuit, et maintenant c’est la grande sagesse !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46d9afe3-468a-3327-8db8-97dd66a9dc73",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Caractère prudent, circonspect, d’actions, de paroles, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e110b4a8-7a80-4cec-8451-0f3d514f6b36",
                                                "sense_id": "46d9afe3-468a-3327-8db8-97dd66a9dc73",
                                                "text": "La sagesse de sa conduite, de sa politique."
                                            },
                                            {
                                                "example_id": "e18e1e49-4eab-4a07-b98a-184d4ca08bc3",
                                                "sense_id": "46d9afe3-468a-3327-8db8-97dd66a9dc73",
                                                "text": "Il a fait une réponse pleine de sagesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d370fee-a7d3-3ac0-a6fc-43beb1714f08",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "En parlant des ouvrages de l’esprit ou des œuvres d’art, soin que l’on met à éviter ce qui est outré, extravagant, à se renfermer, non sans quelque timidité, dans les bornes prescrites par la raison et par le goût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "333c50a7-00bc-4387-9f12-73c89c2ad314",
                                                "sense_id": "5d370fee-a7d3-3ac0-a6fc-43beb1714f08",
                                                "text": "Son ouvrage manque d’imagination, de chaleur, mais il est composé, ordonné avec sagesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43324ec9-b73f-3bb7-8de6-71c74065969b",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Connaissance naturelle ou acquise des choses, les lumières de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4666d7-6bd4-4a9e-92e0-713c6935713d",
                                                "sense_id": "43324ec9-b73f-3bb7-8de6-71c74065969b",
                                                "text": "Le texte exact de Platon est : « Dans l’ordre des vertus, la sagesse est la première; la tempérance vient ensuite; le courage occupe la dernière place. »"
                                            },
                                            {
                                                "example_id": "57e5d07f-df66-4245-94e2-8aab18b9bbab",
                                                "sense_id": "43324ec9-b73f-3bb7-8de6-71c74065969b",
                                                "text": "La clé de la sagesse épicurienne consiste à comprendre que nous pouvons être heureux si nos désirs, au lieu d’être illimités, se ramènent à la dimension restreinte des besoins de notre corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1694516a-f6dd-3943-a65a-89cf9232aeb8",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Connaissance inspirée des choses divines et humaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b17139f-8a5d-4bd1-8bdb-3a135cedb09b",
                                                "sense_id": "1694516a-f6dd-3943-a65a-89cf9232aeb8",
                                                "text": "Le don de sagesse est un des sept dons du Saint-Esprit."
                                            },
                                            {
                                                "example_id": "95991d07-a1ab-43b9-98fd-d8c89622d156",
                                                "sense_id": "1694516a-f6dd-3943-a65a-89cf9232aeb8",
                                                "text": "La sagesse de Salomon."
                                            },
                                            {
                                                "example_id": "5ee678f6-b32f-461e-8e1a-01e2dc1b4487",
                                                "sense_id": "1694516a-f6dd-3943-a65a-89cf9232aeb8",
                                                "text": "Le livre de la sagesse, ou simplement « la sagesse », est un des livres deutérocanoniques des Bibles chrétiennes antérieures à la Réforme, apocryphe pour le judaïsme et le protestantisme."
                                            },
                                            {
                                                "example_id": "2a16cd43-2cfa-461b-889d-ab7e093766c4",
                                                "sense_id": "1694516a-f6dd-3943-a65a-89cf9232aeb8",
                                                "text": "[…] jamais la solution ne peut avoir pour nom la « sagesse ». Celle-ci, en effet, est perçue comme un état stable, serein, où l’homme est en pleine domination de lui-même. Aussi bien dire que cette sagesse n’est qu'un idéal, ou une idée régulatrice pour parler comme Kant, ou encore un fantasme, ou pis encore, un masque que certains portent pour impressionner et exploiter de plus naïfs."
                                            },
                                            {
                                                "example_id": "8b4dd0d4-5dda-40f3-bbfd-81d5fa904f19",
                                                "sense_id": "1694516a-f6dd-3943-a65a-89cf9232aeb8",
                                                "text": "La sagesse est « la philosophie descendue dans les entrailles ». Un bouddhiste peut faire sienne cette forte parole de Sénèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2457fbec-7856-363c-8811-8fe2e54f7f4b",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "Aptitude d’un cheval de trot à rester sage, c’est-à-dire à ne pas se montrer fautif en se mettant au galop."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b645c1c5-52ff-3398-ad02-da314ce441d4",
                                        "entry_id": "fd7178cc-8c55-339e-ac57-a0376184b138",
                                        "glosses": [
                                            "À Donjons & Dragons, et d’autres jeux de rôle, caractéristique (valeur chiffrée) représentant la vigilance d’un personnage, sa capacité à percevoir son environnement et son intuition."
                                        ],
                                        "tags": [
                                            "Jeux de rôle"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41632c84-59d1-4950-8b31-f9abf3a8bf7c",
                        "source_entry_id": "5cad3b0d-3323-37ef-b04a-ac57d56ccb0a",
                        "source_sense_id": "feef6571-f048-3a6b-9cc9-48d65d3147f5",
                        "source_sense_description": "Klugheit, Einsicht",
                        "target_lang_word": "jugement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jugement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Décision rendue par un tribunal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afef674-9ce5-4c1b-ad32-34fe454a9767",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "Écoutez la voix de la justice et de la raison ; elle vous crie que les jugements humains ne sont jamais assez certains pour que la société puisse donner la mort à un homme condamné par d'autres hommes sujets à l'erreur."
                                            },
                                            {
                                                "example_id": "1cba08eb-cd99-4066-9d3e-e04ef8edb8cf",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "Quelques maisons furent livrées au pillage, et trois des principaux habitants fusillés par jugement du conseil de guerre, exécution qui ne violait pas la capitulation, dont les clauses avaient mis les Véronais à la discrétion des vainqueurs."
                                            },
                                            {
                                                "example_id": "351bf25c-37d8-48e7-8e38-1671829d9a76",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "Des créanciers récalcitrants ont obtenu un jugement contre moi et mon compte est bloqué chez Hachette."
                                            },
                                            {
                                                "example_id": "59f53ca3-1249-4b2c-b4aa-51f0c16eb5f8",
                                                "sense_id": "99a0aacf-00f6-3849-969d-6ae662077fe9",
                                                "text": "[…], la comtesse fit incarcérer le meurtrier et, après jugement, celui-ci fut pendu. L'exécution eut lieu le jour de Pourim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b67a563-4581-36de-807d-dca2e910b609",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Évaluation par Dieu de l’âme du défunt pour l'orienter vers l'enfer ou vers le paradis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c276600-07c7-49d9-a133-c1573a24fa93",
                                                "sense_id": "9b67a563-4581-36de-807d-dca2e910b609",
                                                "text": "Il avait quatre-vingt-trois ans , quand Mahmoud, approchant de la mort et du Jugement, voulu expier, réparer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f488a69-4ac9-382c-8321-843539af6512",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Approbation ou condamnation d'ordre moral."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ae7335-fe45-4536-86af-18d12c14bd44",
                                                "sense_id": "6f488a69-4ac9-382c-8321-843539af6512",
                                                "text": "Un jugement favorable, charitable."
                                            },
                                            {
                                                "example_id": "524e5c7d-9398-49c1-bca8-9e8d8fb56996",
                                                "sense_id": "6f488a69-4ac9-382c-8321-843539af6512",
                                                "text": "Vous pensez mal de votre prochain, vous en faites de mauvais jugements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59259d44-c58e-30cf-a80f-a062b3337fa2",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Acte par lequel on affirme ou nie une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "477d992f-c8b7-4377-afb3-9c64ce9cb0ba",
                                                "sense_id": "59259d44-c58e-30cf-a80f-a062b3337fa2",
                                                "text": "Tout jugement qu’on exprime est une proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Faculté de l’entendement qui compare et qui juge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b589682-5e8f-4cef-ae8d-314e5100f567",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Le plus souvent, il ne trouvait pas grand’chose à lui répondre, toujours plus étonné de rencontrer autant de jugement dans une si petite tête."
                                            },
                                            {
                                                "example_id": "a8ffc4e9-d7d5-4932-b599-011f84654e15",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "[…]; nous travaillâmes désormais ensemble, avec un accord et une communauté de jugement qu'il est rare de trouver entre deux hommes."
                                            },
                                            {
                                                "example_id": "06a2b0a3-028a-4213-97cc-bf6c9a68450a",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Il a le jugement bon, le jugement solide, le jugement sain."
                                            },
                                            {
                                                "example_id": "351fcf0d-7c28-42f5-b6d8-e16ba3913b54",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "C’est un homme de bon jugement, de grand jugement."
                                            },
                                            {
                                                "example_id": "bd048b1e-d43b-4cc9-bc9e-77c0c1b68b00",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Il est dénué de jugement."
                                            },
                                            {
                                                "example_id": "58e93e81-2714-46cc-8461-0ce9a4e21a60",
                                                "sense_id": "21e32c10-c744-31c7-8668-ddc00673e448",
                                                "text": "Il a de l’esprit, mais il n’a point de jugement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Avis, sentiment, opinion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3abf992-379b-4eec-a208-7c07f7ab3f43",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "… les jugements sont les actions de notre esprit, lorsqu'après avoir assemblé plusieurs idées, il assure que l'une convient à l'autre, ou que l'une ne convient pas à l'autre."
                                            },
                                            {
                                                "example_id": "fc424da9-91a2-464c-be93-37d3be1641e8",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Le vrai, indépendant de mes caprices, doit être la règle de mes jugements ; et je ne ferai point un crime à celui-ci de ce que j’admirerai dans celui-là comme une vertu."
                                            },
                                            {
                                                "example_id": "16b7b037-c10a-41ed-8952-0d406d1ea91c",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Les sociologues savent bien que les jugements en disent souvent plus sur leurs auteurs que sur les choses dont ils parlent."
                                            },
                                            {
                                                "example_id": "366d00d2-9eac-4aae-8a95-ce1957946aa3",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Porter, donner son jugement sur quelque chose, sur un écrit, sur un ouvrage, sur un auteur."
                                            },
                                            {
                                                "example_id": "6a813bbd-4c91-41a4-ba8a-88e0241b30c0",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Asseoir, fonder son jugement sur un fait précis."
                                            },
                                            {
                                                "example_id": "641da6f0-0a58-4705-b047-5fa218bc9e44",
                                                "sense_id": "4e5abc9a-b042-32df-a0ab-bd9d10b4d71c",
                                                "text": "Le jugement de l’histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98e52cb-7a71-32c8-a05f-2433af2d8c82",
                                        "entry_id": "6c661c3d-cc3e-331e-a8e6-e14a89556c37",
                                        "glosses": [
                                            "Vingtième atout du tarot de Marseille."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
