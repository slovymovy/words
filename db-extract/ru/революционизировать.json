                "translations": [
                    {
                        "translation_id": "41c5211d-3e89-4495-9abc-4a7f2c379ea3",
                        "source_entry_id": "946cd207-617b-364b-8d24-0830d0620010",
                        "target_lang_word": "revolutionize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolutionize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e79d79-87a6-3825-9815-a4947e33751f",
                                        "entry_id": "ebf3f90c-d6a6-3892-822c-00fa43dca560",
                                        "glosses": [
                                            "To radically or significantly change, as in a revolution."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871e9f0b-fdde-4385-9a77-f594cf0c45db",
                                                "sense_id": "f5e79d79-87a6-3825-9815-a4947e33751f",
                                                "text": "Teachers are not simply wage earners who teach students, but revolutionaries bringing up the future builders of socialism. For this reason, we are working hard to help teachers acquire advanced science and technology and to revolutionize and working-classize them."
                                            },
                                            {
                                                "example_id": "36ec9624-6066-4f88-bce2-2302aae45c41",
                                                "sense_id": "f5e79d79-87a6-3825-9815-a4947e33751f",
                                                "text": "For Joseph Schumpeter, the Austrian-born economist whose writings have acquired a special relevance in the past year or two, this most modern of economic systems “incessantly revolutionizes the economic structure from within, incessantly destroying the old one, incessantly creating a new one.”"
                                            },
                                            {
                                                "example_id": "ec4ff192-6ccf-43f5-ac37-5be7b722dda1",
                                                "sense_id": "f5e79d79-87a6-3825-9815-a4947e33751f",
                                                "text": "Another kind of machine learning, called neural networks, is also “revolutionizing” AI, the report said."
                                            },
                                            {
                                                "example_id": "7eeeb92b-b24a-49ff-bd24-763d8dc41aad",
                                                "sense_id": "f5e79d79-87a6-3825-9815-a4947e33751f",
                                                "text": "ChatGPT and reinforcement learning with human feedback (RLHF) have revolutionized the AI landscape, providing an accessible and reliable platform for AI-enabled applications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00321d23-0cae-4729-b938-6c35fec38385",
                        "source_entry_id": "946cd207-617b-364b-8d24-0830d0620010",
                        "target_lang_word": "revolutionieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolutionieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3d9c2a-9793-3e55-8892-d448bc88d89e",
                                        "entry_id": "389fc470-8807-368f-a015-222830b84e75",
                                        "glosses": [
                                            "radikal, grundlegend verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4c802a-c2c3-4113-a824-41a333f90caf",
                                                "sense_id": "1c3d9c2a-9793-3e55-8892-d448bc88d89e",
                                                "text": "Mit dem neuen Automodell wird der Markt revolutioniert."
                                            },
                                            {
                                                "example_id": "96c81b79-ed34-4705-b201-030ed8ec1ebf",
                                                "sense_id": "1c3d9c2a-9793-3e55-8892-d448bc88d89e",
                                                "text": "„Wikipedia hat den Zugang zum Weltwissen revolutioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ad43f8f-13b4-35ff-adc4-edcee1c7a847",
                                        "entry_id": "389fc470-8807-368f-a015-222830b84e75",
                                        "glosses": [
                                            "Menschen auf einen Umsturz vorbereiten, sie dafür begeistern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2aed632-7f65-42ac-9c8b-b6f1e98456f0",
                                                "sense_id": "6ad43f8f-13b4-35ff-adc4-edcee1c7a847",
                                                "text": "„War sie trunken vom Glauben, die kleine Gruppe der Spartakisten könne die Massen revolutionieren, die Regierung ablösen und den Krieg, der ein verlorener war, beenden?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "10522a3f-586e-3aad-a873-81f196759b6c",
                                        "entry_id": "389fc470-8807-368f-a015-222830b84e75",
                                        "glosses": [
                                            "an einer Bewegung zum Umsturz in den politischen Gefügen (Revolution) teilnehmen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9999dfb0-9a11-4187-bace-b005d16901b2",
                                                "sense_id": "10522a3f-586e-3aad-a873-81f196759b6c",
                                                "text": "„Doch die wertvollsten Verfassungsreformen waren nur ein Rückgreifen auf alte, nunmehr besser verstandene Grundsätze; selbst wenn das Volk revolutionierte, tat es dies nie aus dem Verlangen nach einer neuen Ordnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
