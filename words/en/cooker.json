    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc82f8e6-33b8-39cf-92e3-4a29bbbc6fd0",
                    "sense_definition": "A large piece of kitchen equipment, such as a stove or a specialized appliance, used for heating and preparing food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooking_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to buy a new electric <w>cooker</w> for our kitchen renovation.",
                            "target_lang_translations": {
                                "ru": "Мы решили купить новую электрическую <w>плиту</w> для ремонта нашей кухни."
                            }
                        },
                        {
                            "text": "Please be careful because the <w>gas</w> <w>cooker</w> is still very hot.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, будьте осторожны, так как газовая <w>плита</w> всё ещё очень горячая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gas cooker",
                        "electric cooker",
                        "slow cooker",
                        "pressure cooker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное кухонное оборудование, такое как плита или специализированный прибор, используемый для нагрева и приготовления пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плита",
                                "target_lang_sense_clarification": "кухонная"
                            },
                            {
                                "target_lang_word": "печка",
                                "target_lang_sense_clarification": "разговорное обозначение плиты"
                            },
                            {
                                "target_lang_word": "варка",
                                "target_lang_sense_clarification": "в составе названий приборов, например, мультиварка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7a6f474-3520-3d46-a0db-75bb3c9164a4",
                    "sense_definition": "An apple that is suitable for cooking rather than eating raw.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These apples are <w>cookers</w>, so they will be perfect for the pie.",
                            "target_lang_translations": {
                                "ru": "Эти яблоки — <w>кулинарного сорта</w>, так что они идеально подойдут для пирога."
                            }
                        },
                        {
                            "text": "The shop sells both sweet eating apples and large green <w>cookers</w>.",
                            "target_lang_translations": {
                                "ru": "В магазине продаются как сладкие десертные яблоки, так и крупные зеленые <w>яблоки для готовки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bramley cooker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт яблок, подходящий для кулинарной обработки, а не для употребления в сыром виде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулинарный сорт",
                                "target_lang_sense_clarification": "о яблоках для готовки"
                            },
                            {
                                "target_lang_word": "яблоко для готовки",
                                "target_lang_sense_clarification": "не десертный сорт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97aaf469-d964-3231-ab36-590f669cdfb2",
                    "sense_definition": "A person who prepares food; a <w>cook</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known among his friends as a most excellent <w>cooker</w> of fish.",
                            "target_lang_translations": {
                                "ru": "Среди друзей он был известен как превосходный <w>мастер по приготовлению</w> рыбы."
                            }
                        },
                        {
                            "text": "She is a <w>good</w> <w>cooker</w> who enjoys experimenting with new spices.",
                            "target_lang_translations": {
                                "ru": "Она хороший <w>кулинар</w>, которой нравится экспериментировать с новыми специями."
                            }
                        }
                    ],
                    "synonyms": [
                        "cook#Noun"
                    ],
                    "common_phrases": [
                        "good cooker",
                        "excellent cooker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который готовит еду; повар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повар",
                                "target_lang_sense_clarification": "человек, готовящий еду"
                            },
                            {
                                "target_lang_word": "кулинар",
                                "target_lang_sense_clarification": "человек, умеющий хорошо готовить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20445058-a261-3959-9c4d-cce1c648cb29",
                    "sense_definition": "A person who believes in or promotes fringe conspiracy theories, especially regarding politics or health.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protest was mostly attended by local <w>cookers</w> shouting about government tracking.",
                            "target_lang_translations": {
                                "ru": "На протесте в основном присутствовали местные <w>конспирологи</w>, кричащие о правительственной слежке."
                            }
                        },
                        {
                            "text": "He fell down a rabbit hole online and became a total <w>cooker</w>.",
                            "target_lang_translations": {
                                "ru": "Он зачитался всяким в интернете и стал полным <w>конспирологом</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often derogatory"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Primarily Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который верит в маргинальные теории заговора или продвигает их, особенно в вопросах политики или здоровья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конспиролог",
                                "target_lang_sense_clarification": "сторонник теорий заговора"
                            },
                            {
                                "target_lang_word": "антиваксер",
                                "target_lang_sense_clarification": "частое значение в контексте пандемии"
                            },
                            {
                                "target_lang_word": "поехавший",
                                "target_lang_sense_clarification": "грубый сленг для фанатиков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
