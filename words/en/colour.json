    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f709f67-390e-35ef-8624-010de1ff0b21",
                    "sense_definition": "The property possessed by an object of producing different sensations on the eye as a result of the way it reflects or emits light; Commonwealth spelling of <w>color</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a bright <w>colour</w> to make the painting stand out.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркий <w>цвет</w>, чтобы выделить картину."
                            }
                        },
                        {
                            "text": "What is your <w>favourite</w> <w>colour</w> for a new car?",
                            "target_lang_translations": {
                                "ru": "Какой ваш любимый <w>цвет</w> для нового автомобиля?"
                            }
                        }
                    ],
                    "synonyms": [
                        "hue",
                        "shade",
                        "tint"
                    ],
                    "common_phrases": [
                        "favourite colour",
                        "bright colour",
                        "primary colour",
                        "change colour"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonwealth and Ireland standard spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство объекта вызывать различные зрительные ощущения в зависимости от того, как он отражает или излучает свет; британский вариант написания слова color."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "нюанс цвета"
                            },
                            {
                                "target_lang_word": "краска",
                                "target_lang_sense_clarification": "вещество или тон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "640b2f57-b9b8-3e6b-86a7-1407cffd3d53",
                    "sense_definition": "To apply pigment or dye to something; Commonwealth spelling of <w>color</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "artistic_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children like to <w>colour</w> in their books with crayons.",
                            "target_lang_translations": {
                                "ru": "Детям нравится <w>раскрашивать</w> в своих книжках восковыми мелками."
                            }
                        },
                        {
                            "text": "She decided to <w>colour</w> <w>in</w> the drawing using only blue and green.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>раскрасить</w> рисунок, используя только синий и зеленый."
                            }
                        }
                    ],
                    "synonyms": [
                        "dye",
                        "paint",
                        "tint",
                        "shade"
                    ],
                    "common_phrases": [
                        "colour in",
                        "colour the hair",
                        "colour a picture"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonwealth and Ireland standard spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить пигмент или краситель на что-либо; раскрашивать; британский вариант написания слова color."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрашивать",
                                "target_lang_sense_clarification": "заполнять цветом рисунок"
                            },
                            {
                                "target_lang_word": "красить",
                                "target_lang_sense_clarification": "наносить краску"
                            },
                            {
                                "target_lang_word": "окрашивать",
                                "target_lang_sense_clarification": "придавать цвет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7fa1ff3a-84c7-38e3-911e-6c714ab8e896",
                    "sense_definition": "Relating to or possessing hue rather than being black and white; Commonwealth spelling of <w>color</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>colour</w> <w>photography</w> from the sixties looks very nostalgic now.",
                            "target_lang_translations": {
                                "ru": "Старая <w>цветная</w> фотография шестидесятых годов сейчас выглядит очень ностальгически."
                            }
                        },
                        {
                            "text": "We prefer watching <w>colour</w> television instead of the old black and white sets.",
                            "target_lang_translations": {
                                "ru": "Мы предпочитаем смотреть <w>цветное</w> телевидение вместо старых черно-белых аппаратов."
                            }
                        }
                    ],
                    "synonyms": [
                        "chromatic",
                        "coloured"
                    ],
                    "antonyms": [
                        "monochrome",
                        "black-and-white"
                    ],
                    "common_phrases": [
                        "colour photography",
                        "colour television",
                        "colour film"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonwealth and Ireland standard spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к наличию цвета, а не черно-белый; цветной; британский вариант написания слова color."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветной",
                                "target_lang_sense_clarification": "не черно-белый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}