                        "examples": [
                            {
                                "example_id": "36de4010-134f-4271-ab73-5862edef1ae4",
                                "sense_id": "d18adc2f-35eb-3863-bb31-eccf61d555e1",
                                "text": "Plötzlich erhob im Nebenzimmer Goldhänschen ein Mordsgebrüll. Es war über eine Fußbank gefallen und schrie nun ohne Aufhören, als ob es am Spieß stecke […]."
                            },
                            {
                                "example_id": "94b99cca-1395-4b7e-be5b-0cc9eb8b6e7d",
                                "sense_id": "d18adc2f-35eb-3863-bb31-eccf61d555e1",
                                "text": "„Wikinger sollen es gewesen sein, die in brachialer Fahrt und mit Mordsgebrüll als Erste auf Kufengefährten zu Tal rasten und ihren Feinden direkt in die Scheune krachten, so sie denn ankamen.“"
                            }
                        ],
