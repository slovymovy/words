                "forms": [],
                "senses": [
                    {
                        "sense_id": "16f99b62-ead2-3915-adc6-1a8680071063",
                        "entry_id": "d18637b5-b333-366f-8693-5e938dc59a51",
                        "glosses": [
                            "Unexpectedly or by surprise."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3a00fb6-b477-4727-9b23-3185c1d70d7d",
                                "sense_id": "16f99b62-ead2-3915-adc6-1a8680071063",
                                "text": "Your question catches/takes me unawares, I don't know the answer right now..."
                            },
                            {
                                "example_id": "ae21252e-55dc-47de-b47c-714cee305219",
                                "sense_id": "16f99b62-ead2-3915-adc6-1a8680071063",
                                "text": "And I with these untoward thoughts had striven, / I saw a Man before me unawares: / The oldest Man he seemed that ever wore grey hairs."
                            }
                        ]
                    },
                    {
                        "sense_id": "be91acfd-9286-3294-ac71-88197017e508",
                        "entry_id": "d18637b5-b333-366f-8693-5e938dc59a51",
                        "glosses": [
                            "Inadvertently."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f1b5951-117e-41c5-b28f-5761fe5938ef",
                                "sense_id": "be91acfd-9286-3294-ac71-88197017e508",
                                "text": "I'm afraid I've taken the wrong coat, unawares."
                            }
                        ]
                    },
                    {
                        "sense_id": "f24580c8-422b-3fdc-8fac-49e4c8782bb3",
                        "entry_id": "d18637b5-b333-366f-8693-5e938dc59a51",
                        "glosses": [
                            "Without plan or forethought."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
