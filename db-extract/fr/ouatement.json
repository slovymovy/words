                        "entry_id": "064db8e4-3388-368e-959e-a02b4a56eab2",
                        "glosses": [
                            "Action d’ouater ; résultat de cette action."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f0192f79-4c57-4e47-84ff-f8d2bd67b641",
                                "sense_id": "b13a04bd-aab3-31a6-9061-ef23130c94b2",
                                "text": "L’altération du sens auditif demeure, une espèce de sonorité, accompagnée d'une sorte d’engourdissement ou ouatement léger de la région de l'oreille droite."
                            },
                            {
                                "example_id": "1f351bb3-72c2-4067-b5b3-72c15a715316",
                                "sense_id": "b13a04bd-aab3-31a6-9061-ef23130c94b2",
                                "text": "Des flocons, par moments, s’échappant des gros nuages jaunes dont les masses lourdes barraient l’horizon, venaient frapper la vitre de leur ouatement léger, pareil à un duvet d’oiseau."
                            },
                            {
                                "example_id": "58aa1552-2622-48bb-9836-4200b6cb6f1f",
                                "sense_id": "b13a04bd-aab3-31a6-9061-ef23130c94b2",
                                "text": "Le paresseux disait la volupté des rêves, l’ouatement bienheureux de la musique et du sommeil."
                            }
                        ]
                    }
                ],
