        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6393c622-cf0d-36b5-9ea9-473ce8e05d4f",
                    "sense_definition": "Qui fait preuve d'une exactitude méthodique et d'une stricte précision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exactitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chercheur applique une méthode particulièrement <w>rigoureuse</w> pour valider ses résultats.",
                            "target_lang_translations": {
                                "en": "The researcher uses a particularly <w>rigorous</w> method to validate his results.",
                                "ru": "Исследователь применяет особенно <w>строгий</w> метод для проверки своих результатов.",
                                "de": "Der Forscher wendet eine besonders <w>gründliche</w> Methode an, um seine Ergebnisse zu überprüfen.",
                                "es": "El investigador aplica un método especialmente <w>riguroso</w> para validar sus resultados.",
                                "zh": "研究人员采用特别<w>严谨</w>的方法来验证他的研究结果。"
                            }
                        },
                        {
                            "text": "Ce protocole exige un suivi <w>rigoureux</w> de chaque étape de fabrication.",
                            "target_lang_translations": {
                                "en": "This protocol requires <w>rigorous</w> monitoring of every stage of manufacturing.",
                                "ru": "Этот протокол требует <w>тщательного</w> контроля каждого этапа производства.",
                                "de": "Dieses Protokoll verlangt eine <w>akribische</w> Überwachung jedes Fertigungsschritts.",
                                "es": "Este protocolo exige un seguimiento <w>riguroso</w> de cada etapa de fabricación.",
                                "zh": "该规程要求对每个生产环节进行<w>严密</w>的跟踪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "méticuleux",
                        "précis",
                        "strict"
                    ],
                    "antonyms": [
                        "approximatif",
                        "laxiste",
                        "négligent"
                    ],
                    "common_phrases": [
                        "contrôle rigoureux",
                        "méthode rigoureuse",
                        "analyse rigoureuse"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing methodical exactness and strict precision in work or thinking.",
                        "ru": "Отличающийся методичной точностью и строгой аккуратностью в работе или мышлении.",
                        "de": "Mit methodischer Genauigkeit und strikter Präzision arbeitend oder denkend.",
                        "es": "Que actúa con exactitud metódica y precisión estricta.",
                        "zh": "做事或思考时态度认真，方法周密，力求精确严格。"
                    },
                    "translations": {
