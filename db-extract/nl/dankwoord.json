                        "glosses": [
                            "korte tekst of toespraak om mensen te bedanken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7c071e-5ea7-4d9f-bb0f-d83341cc68e9",
                                "sense_id": "8b94e92e-ea5c-3205-8b3d-b74cd52367ab",
                                "text": "Sanne Wevers, gekleed in een creatie van modeontwerper Addy van den Krommenacker, herinnerde in haar dankwoord aan de weg naar goud, die lang heeft geduurd en bezaaid was met hindernissen. Dat ze erin geslaagd was haar ambitie, haar plan, haar uitgestippelde route tot een goed eind te brengen, emotioneerde haar het meest, zei ze. Met goud als tastbare herinnering; op het Sportgala kwam daar nog eens de Jaap Eden Trofee bij."
                            },
                            {
                                "example_id": "98ea3232-0d23-44b5-8783-fe2994d7053c",
                                "sense_id": "8b94e92e-ea5c-3205-8b3d-b74cd52367ab",
                                "text": "Dankwoord: Allereerst wil ik alle hikers en Trail Angels bedanken die ik heb ontmoet."
                            }
                        ]
                    }
