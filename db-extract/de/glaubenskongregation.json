                        "entry_id": "0b292b1a-05f8-3552-a735-ea019938fc80",
                        "glosses": [
                            "Institution der katholischen Kirche, die sich mit lehramtlichen Fragen zur Glaubenslehre beschäftigt"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "4b154070-030c-4088-9eae-00eea77f0193",
                                "sense_id": "5776471d-1e4f-30d6-bb2e-776c3a1d1687",
                                "text": "Die Glaubenskongregation wurde von Papst Paul III. am 21. Juli 1542 gegründet und ist damit die älteste der neun Kongregationen der römischen Kurie."
                            },
                            {
                                "example_id": "22498149-602b-42cb-9c2a-087b1e8da6fb",
                                "sense_id": "5776471d-1e4f-30d6-bb2e-776c3a1d1687",
                                "text": "Erzbischof Gerhard Ludwig Müller wurde 2012 zum Präfekt der Glaubenskongregation ernannt."
                            }
                        ],
