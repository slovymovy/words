{
    "word_family": [
        "brassiere",
        "bralette"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebb054ab-d343-3a8c-aed8-f41505965ea0",
                    "sense_definition": "An item of clothing, usually underwear worn to support the breasts.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_underwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a comfortable <w>bra</w> to wear under her t-shirt.",
                            "target_lang_translations": {
                                "ru": "Она купила удобный <w>бюстгальтер</w>, чтобы носить под футболкой.",
                                "zh": "她买了一件舒适的<w>胸罩</w>穿在T恤里面。"
                            }
                        },
                        {
                            "text": "A sports <w>bra</w> provides the necessary support during intense physical exercise.",
                            "target_lang_translations": {
                                "ru": "Спортивный <w>бюстгальтер</w> обеспечивает необходимую поддержку во время интенсивных физических упражнений.",
                                "zh": "运动时穿运动<w>胸罩</w>能提供必要的支撑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brassiere"
                    ],
                    "common_phrases": [
                        "sports bra",
                        "push-up bra",
                        "padded bra",
                        "wear a bra"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет женской одежды, обычно нижнее белье, которое носят для поддержки груди.",
                        "zh": "一种女性内衣，用于支撑乳房。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюстгальтер",
                                "target_lang_sense_clarification": "основной термин"
                            },
                            {
                                "target_lang_word": "лифчик",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胸罩",
                                "target_lang_sense_clarification": "标准用语"
                            },
                            {
                                "target_lang_word": "文胸",
                                "target_lang_sense_clarification": "常用书面语"
                            },
                            {
                                "target_lang_word": "内衣",
                                "target_lang_sense_clarification": "泛指，有时指代胸罩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17d12c7f-666f-3770-989e-5651cb9ff4e3",
                    "sense_definition": "An informal term of address for a male friend; a variant of <w>bro</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "address_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>bra</w>, are we still going to the beach this afternoon?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>братан</w>, мы всё ещё идём на пляж сегодня днём?",
                                "zh": "嘿<w>兄弟</w>，我们今天下午还去海滩吗？"
                            }
                        },
                        {
                            "text": "Don't worry about it, <w>bra</w>, everything is going to be fine.",
                            "target_lang_translations": {
                                "ru": "Не парься, <w>брат</w>, всё будет нормально.",
                                "zh": "别担心，<w>哥们儿</w>，一切都会好起来的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bro",
                        "buddy",
                        "mate"
                    ],
                    "common_phrases": [
                        "what's up bra",
                        "cool bra"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to address a male friend"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное обращение к другу мужского пола; вариант слова «bro».",
                        "zh": "对男性朋友的非正式称呼，源自英语“bro”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "братан",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "брат",
                                "target_lang_sense_clarification": "дружеское обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兄弟",
                                "target_lang_sense_clarification": "常用称呼"
                            },
                            {
                                "target_lang_word": "哥们儿",
                                "target_lang_sense_clarification": "口语，非正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9407a07a-1b4b-3ecd-8a2c-4f7b34beb0b4",
                    "sense_definition": "One of the two vectors in the standard notation for describing quantum states in quantum mechanics, the row vector.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics_quantum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Dirac notation, the <w>bra</w> represents the dual vector in the Hilbert space.",
                            "target_lang_translations": {
                                "ru": "В нотации Дирака <w>бра</w> представляет собой дуальный вектор в гильбертовом пространстве.",
                                "zh": "在狄拉克符号中，<w>左矢</w>表示希尔伯特空间中的对偶向量。"
                            }
                        },
                        {
                            "text": "The inner product is calculated by multiplying a <w>bra</w> by a ket.",
                            "target_lang_translations": {
                                "ru": "Скалярное произведение вычисляется умножением <w>бра</w> на кет.",
                                "zh": "内积是通过将<w>左矢</w>与右矢相乘来计算的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ket"
                    ],
                    "common_phrases": [
                        "bra vector",
                        "bra-ket notation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из двух векторов в стандартном обозначении квантовых состояний в квантовой механике; вектор-строка.",
                        "zh": "量子力学中狄拉克符号的一种，指代共轭转置的行向量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бра-вектор",
                                "target_lang_sense_clarification": "физический термин"
                            },
                            {
                                "target_lang_word": "бра",
                                "target_lang_sense_clarification": "краткая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "左矢",
                                "target_lang_sense_clarification": "物理学专业术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "72991253-aaf7-3033-b242-eccbbfb97879",
                    "sense_definition": "A city in Cuneo, Piedmont, Italy; known for being the birthplace of the Bra sausage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many tourists visit <w>Bra</w> to attend the famous international cheese festival.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Бра</w>, чтобы попасть на знаменитый международный фестиваль сыра.",
                                "zh": "许多游客前往<w>布拉</w>参加著名的国际奶酪节。"
                            }
                        },
                        {
                            "text": "The town of <w>Bra</w> is located in the Piedmont region of northern Italy.",
                            "target_lang_translations": {
                                "ru": "Город <w>Бра</w> расположен в регионе Пьемонт на севере Италии.",
                                "zh": "<w>布拉</w>镇位于意大利北部的皮埃蒙特大区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в провинции Кунео, Пьемонт, Италия; известен как родина колбасы Бра.",
                        "zh": "意大利皮埃蒙特大区库内奥省的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бра",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布拉",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}