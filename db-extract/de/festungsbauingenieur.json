                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2668747d-f760-4299-b60b-324f0d324ef4",
                                "sense_id": "4388a223-11c6-3006-8681-bbe0d3665c48",
                                "text": "„Die Bauleitung hatte der Festungsbauingenieur Axel Urop.“"
                            },
                            {
                                "example_id": "431c2d6c-4f97-42b0-b462-6c36dc6fc477",
                                "sense_id": "4388a223-11c6-3006-8681-bbe0d3665c48",
                                "text": "„Im 16. Jahrhundert kam zusammen mit der neuen Bauform ‚Festung‘ auch der Beruf des Festungsbauingenieurs auf.“"
                            },
                            {
                                "example_id": "dd4b9834-2dbe-4a97-91d6-146932e69bba",
                                "sense_id": "4388a223-11c6-3006-8681-bbe0d3665c48",
                                "text": "„Der Name der auffälligen und imposanten Sandsteinmauer ist auf den französischen Festungsbauingenieur, Revolutionär und Staatsmann Lazare Carnot (1753 - 1823) zurückzuführen.“"
                            },
                            {
                                "example_id": "842e3eaa-2513-478a-9680-5fadf7344506",
                                "sense_id": "4388a223-11c6-3006-8681-bbe0d3665c48",
                                "text": "„Guericke zog nach Erfurt und wurde dort Festungsbauingenieur.“"
                            }
                        ],
