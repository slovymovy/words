    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                "word": "lethality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "69509362-91bb-4aa1-8237-703dddbcf06d",
                        "entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "lethalities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cabed32f-5fb2-3ad4-88ca-8da16a46e02c",
                        "entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                        "glosses": [
                            "The fact of something being lethal; the ability of something to kill."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b76ba53-a33a-4a14-9641-5608792f6ae7",
                                "sense_id": "cabed32f-5fb2-3ad4-88ca-8da16a46e02c",
                                "text": "Title 10 section 129a of the US code governing civilian personnel management in the armed forces says that the secretary of defense “may not reduce the civilian workforce programmed full-time equivalent levels unless the Secretary conducts an appropriate analysis” of how those firings could impact the US military’s lethality and readiness."
                            },
                            {
                                "example_id": "f226b4a6-2f0f-4954-a52e-3f104e839dcc",
                                "sense_id": "cabed32f-5fb2-3ad4-88ca-8da16a46e02c",
                                "text": "In announcing the review, Robert F. Kennedy Jr., the new health secretary, said in a statement that “antisemitism — like racism — is a spiritual and moral malady that sickens societies and kills people with lethalities comparable to history’s most deadly plagues.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "56099017-98ec-3482-9b82-ab9f9823ede7",
                        "entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                        "glosses": [
                            "The degree of lethal (mortal) danger that something (usually a disease or a weapon) presents; the magnitude of its power to kill organisms exposed to it; this property is indirectly measured by any of various proxy rates, including mortality rate, case fatality rate, or infection fatality rate (for diseases) or kill rate (for weapons, pesticides, or parasites)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6e22a14d-1cce-4fe1-9945-71c4e055b906",
                                "sense_id": "56099017-98ec-3482-9b82-ab9f9823ede7",
                                "text": "According to the US Environmental Protection Agency [ 6 ], long-chain substituted propanediamines, the chemical group these compounds belongs to, are considered to be toxic to aquatic organisms, with observed lethality for plankton and fish at concentrations ranging from 0.75 to 170 µg L −1 ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c0d8204-8388-4573-b7b9-820e12a8f1f7",
                        "source_entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                        "source_sense_description": "ability of something to kill",
                        "target_lang_word": "dodelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dodelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bacc6740-7571-366a-be34-0900388daa69",
                                        "entry_id": "c34a048e-4452-3d8a-9ba1-a914b555381f",
                                        "glosses": [
                                            "het vermogen om te kunnen doden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a771c57b-0702-4ba6-b63f-9868cee7753e",
                                                "sense_id": "bacc6740-7571-366a-be34-0900388daa69",
                                                "text": "Die dodelijkheid voor het doel is duidelijk terug te zien in zijn cijfers. Darwin is dit seizoen met meer dan een derde van zijn schoten trefzeker, geen enkele spits in de Europese topcompetities is effectiever. De Uruguayaan maakt dit seizoen een doelpunt per 76 minuten, alleen wereldspitsen Erling Haaland en Robert Lewandowski noteren een beter moyenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e515a5b4-749f-3290-b960-f2cff0f62ccc",
                                        "entry_id": "c34a048e-4452-3d8a-9ba1-a914b555381f",
                                        "glosses": [
                                            "het vermogen om ernstige schade te kunnen veroorzaken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0483d400-346c-4150-a336-38cfe3d79082",
                                                "sense_id": "e515a5b4-749f-3290-b960-f2cff0f62ccc",
                                                "text": "Ook actieplannen, zoals al bestaan in enkele steden, waar bijvoorbeeld de bouw in de middag wordt stilgelegd, drinkwater en ORS worden uitgedeeld en publieke koelruimtes zijn, moeten op basis van betere voorspellingen worden uitgebreid. \"We hebben nog niet het punt bereikt waarop we mensen duidelijk maken dat ze tijdens bepaalde hittegolven echt binnen moeten blijven. Dat speelt een grote rol in de toenemende dodelijkheid ervan.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "874412b0-2b63-488e-af2d-6ae36752084e",
                        "source_entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
                        "source_sense_description": "rate of death",
                        "target_lang_word": "Sterblichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sterblichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                        "entry_id": "a9aa09c9-3e62-3f7c-992f-ddbfb37621ad",
                                        "glosses": [
                                            "die Eigenschaft, (irgendwann) zu sterben bzw. sterben zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a8ffc5-e3c3-4160-aa8a-ae5d9e1cf98c",
                                                "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                                "text": "Die Sterblichkeit gehört zum Menschsein dazu."
                                            },
                                            {
                                                "example_id": "15bbbfee-080d-4b62-bf56-8badcf4f9c8c",
                                                "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                                "text": "„Er hatte aus den Tiefen der sonnengetränkten Antike eine Lebenshaltung erneuern wollen, die sich auf heroische Weise der eigenen Sterblichkeit entgegenzustemmen sucht.“"
                                            },
                                            {
                                                "example_id": "7312643b-3569-46e9-ad53-6a272cda4f59",
                                                "sense_id": "6ee7f8c5-5f21-3fd0-a25a-811b2d86a70a",
                                                "text": "„Sisis Tod erinnert sie an die eigene Sterblichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                        "entry_id": "a9aa09c9-3e62-3f7c-992f-ddbfb37621ad",
                                        "glosses": [
                                            "Sterberate"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fc210ee-f05a-42f6-8f53-fba91f42c891",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "Die Sterblichkeit bei dieser Krankheit ist sehr hoch."
                                            },
                                            {
                                                "example_id": "864e462a-31a3-4eb6-8ff4-54d27953ba35",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "„Hunger, Kälte, mangelnde Hygiene und die damit verbundenen Epidemien führten zu einer hohen Sterblichkeit unter den Deutschen.“"
                                            },
                                            {
                                                "example_id": "77d75b28-3eb0-4db8-afa8-710a43be3647",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "„Um 1880 liegt die Sterblichkeit unter den Frauen und Kindern der in Indien stationierten britischen Soldaten dreimal so hoch wie im Heimatland.“"
                                            },
                                            {
                                                "example_id": "c62384f3-3de5-4008-85da-f37ba4d9d7f4",
                                                "sense_id": "70ff5350-5d49-30fd-87a2-78fa12317e30",
                                                "text": "„Seit die Ärzte dort Blut sparen, sanken in vier großen Kliniken die Sterblichkeit sowie die Häufigkeit von Schlaganfällen und Herzinfarkten ebenfalls um je ein Drittel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e0d3dfa-ec81-44ef-b9ea-e53a00f0b3d6",
                        "source_entry_id": "a805a24f-f34e-3e9f-ae11-a98e9ffe4b6c",
