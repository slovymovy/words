                            {
                                "target_word": "Chihuahua",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c50a0784-a61c-39ba-a6ee-227d1bb6b32f",
                                        "entry_id": "954cc97a-8c25-305d-b50b-86277732cbba",
                                        "glosses": [
                                            "The smallest breed of dog in the world, originating in Mexico and having large erect ears."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac46281c-73c5-43c8-a7ce-5c93cbfe45e9",
                                                "sense_id": "c50a0784-a61c-39ba-a6ee-227d1bb6b32f",
                                                "text": "The first time I saw a Chihuahua, I thought it was a battery-powered toy. Eyes too big for the face, ears of a large dog, took tens of steps to keep up, squeaked like a two-month-old pup."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f73f915b-4541-40b7-acc0-3aa8c22df4c8",
                        "source_entry_id": "5c5ed190-1815-36f1-a4a3-e4e4ab328287",
