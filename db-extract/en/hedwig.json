                                "target_senses": [
                                    {
                                        "sense_id": "b0c95fe4-ded2-35e7-8a26-380cf4bf726a",
                                        "entry_id": "afe08dec-ed3e-3b99-ae0a-28af9cfb1365",
                                        "glosses": [
