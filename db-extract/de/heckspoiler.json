                "senses": [
                    {
                        "sense_id": "c22f1325-0d2c-3ae2-89c1-aa1b5806fbec",
                        "entry_id": "344f81c8-7a60-3e1b-9650-d188fcb2099f",
                        "glosses": [
                            "Spoiler, der sich am hinteren Teil eines Fahrzeugs befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79564d45-fb20-4a80-87f8-28bacc2553a7",
                                "sense_id": "c22f1325-0d2c-3ae2-89c1-aa1b5806fbec",
                                "text": "„Eine Anwohnerin beobachtet, wie die Täter mit einem silbernen PKW, der einen Heckspoiler hat, davonfahren.“"
                            },
                            {
                                "example_id": "bbd9fb93-32a8-4795-8acd-c9a1c9cbc6f3",
                                "sense_id": "c22f1325-0d2c-3ae2-89c1-aa1b5806fbec",
                                "text": "„Aber der wilde Heckspoiler und die tiefe Schürzen ziehen halt eine bestimmte Klientel an.“"
                            },
                            {
                                "example_id": "17207a85-e6d9-4986-b09e-aed1d048db55",
                                "sense_id": "c22f1325-0d2c-3ae2-89c1-aa1b5806fbec",
                                "text": "„Die weiteren Fahrten fallen noch schneller aus, denn bei diesem ersten Probe-Run waren die Reifen nicht auf die optimale Temperatur von 60 Grad aufgeheizt, und auch gewichtige Teile wie der Heckspoiler und die Seitenkästen waren noch nicht abmontiert.“"
                            },
                            {
                                "example_id": "104129d6-5179-4764-a967-4119dba6b39c",
                                "sense_id": "c22f1325-0d2c-3ae2-89c1-aa1b5806fbec",
                                "text": "„Damals gehörte der Spoiler, ob als Front- oder Heckspoiler (die sogenannte Frittentheke) zum tiefergelegten Zeitgeist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
