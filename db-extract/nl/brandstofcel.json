                "senses": [
                    {
                        "sense_id": "e0a87400-c8f7-3f15-b27e-080ce83062e8",
                        "entry_id": "57503f1f-03ce-363d-bbfe-7d71c75b469b",
                        "glosses": [
                            "een elektrochemisch toestel dat chemische energie van een doorgaande reactie direct omzet in elektrische energie, waarbij anders dan bij een batterij of accu voortdurend nieuwe reagentia van buiten kunnen worden aangevoerd"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3bfdfa2-ec6c-4723-b4ba-5e2714dfc653",
                        "source_entry_id": "57503f1f-03ce-363d-bbfe-7d71c75b469b",
                        "source_sense_id": "e0a87400-c8f7-3f15-b27e-080ce83062e8",
                        "source_sense_description": "een elektrochemisch toestel",
                        "target_lang_word": "Brennstoffzelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brennstoffzelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a012d81-ac80-3f30-9d40-e4dfa5d53737",
                                        "entry_id": "038b9a1e-c758-3a3f-998b-85ae591abec0",
                                        "glosses": [
                                            "galvanische Zelle, bei der durch Oxidation chemische in elektrische Energie umgewandelt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711e9bb7-e22d-49d9-a536-ddc66c429cf8",
                                                "sense_id": "8a012d81-ac80-3f30-9d40-e4dfa5d53737",
                                                "text": "„Die Zukunft wird dem Elektrobus gehören. Fragt sich nur: welchem? Dem Batteriebus, dem Oberleitungsbus oder dem Wasserstoffbus, der seinen Strom aus einer Brennstoffzelle bezieht?“"
                                            },
                                            {
                                                "example_id": "f3bcab55-8f9a-4c8e-98e6-eee50aab8798",
                                                "sense_id": "8a012d81-ac80-3f30-9d40-e4dfa5d53737",
                                                "text": "„Ob in Brennstoffzellen, zur medizinischen Diagnostik oder Produktion neuer Materialien und Energieträger — Katalysatoren haben ein enormes Einsatzpotenzial.“"
                                            },
                                            {
                                                "example_id": "6b390d03-36c6-4963-bd72-cf311ce0acf0",
                                                "sense_id": "8a012d81-ac80-3f30-9d40-e4dfa5d53737",
                                                "text": "„Die Uboote der Klasse 212 A führen reinen Sauerstoff und Wasserstoff für die Brennstoffzellen in Tanks mit, mit denen sie von der Außenluftzufuhr unabhängig sind.“"
                                            },
                                            {
                                                "example_id": "3e51152b-e25b-4c47-aa27-f7f67e20f26f",
                                                "sense_id": "8a012d81-ac80-3f30-9d40-e4dfa5d53737",
                                                "text": "„Sie haben auf dem Dach einen Wasserstofftank und die Brennstoffzelle sowie Batterien im Boden des Zugs.“"
                                            },
                                            {
                                                "example_id": "42d76730-9ce1-47cc-b6da-a5434ea13311",
                                                "sense_id": "8a012d81-ac80-3f30-9d40-e4dfa5d53737",
                                                "text": "„Platin beschleunigt Prozesse in Brennstoffzellen, Iridium in Elektrolyseuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7818ed9-ec46-4247-938c-df90f8bdccec",
                        "source_entry_id": "57503f1f-03ce-363d-bbfe-7d71c75b469b",
                        "source_sense_id": "e0a87400-c8f7-3f15-b27e-080ce83062e8",
                        "source_sense_description": "een elektrochemisch toestel",
                        "target_lang_word": "fuel cell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuel cell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c77a4f41-d5bd-3a18-a256-8d95e6640894",
                                        "entry_id": "b15df8fb-3860-35ab-90b5-ae93a722a905",
                                        "glosses": [
                                            "An electrochemical device in which the intrinsic chemical free energy of fuel and oxidant is catalytically converted to direct current energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa311df-ad37-4269-932a-2158d6608547",
                                                "sense_id": "c77a4f41-d5bd-3a18-a256-8d95e6640894",
                                                "text": "A new energy source claimed by Mr. Coultas to be potentially applicable to locomotives is the fuel cell, now becoming more commonly known as the fuel battery. [...] The fuel cells which are furthest advanced in engineering development today use hydrogen as the fuel."
                                            },
                                            {
                                                "example_id": "d5582ee2-fa19-44d9-a887-a1252b4f14e9",
                                                "sense_id": "c77a4f41-d5bd-3a18-a256-8d95e6640894",
                                                "text": "The Mako is powered by a sealed hydrogen-oxygen fuel cell, and includes a small element zero core. While not large enough to nullify the vehicle’s mass, the core can reduce it enough to be safely air-dropped."
                                            },
                                            {
                                                "example_id": "d1243a40-842c-4813-994a-cd37afbfb53d",
                                                "sense_id": "c77a4f41-d5bd-3a18-a256-8d95e6640894",
                                                "text": "Fuel cells have a shorter lifetime than batteries and their overall efficiency of a hydrogen train is much less - recent figures from Stadler show that just 25% of the energy reaches the wheels for a hydrogen train, compared with 80% for conventional electric tration or around 68% for a battery-electric train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80be8ac3-73df-3f7d-80e6-bea2efc26d8f",
                                        "entry_id": "b15df8fb-3860-35ab-90b5-ae93a722a905",
                                        "glosses": [
                                            "Synonym of fuel tank: A fuel storage tank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d46ec5aa-2e61-3b62-af06-9fcb1a435dde",
                                        "entry_id": "b15df8fb-3860-35ab-90b5-ae93a722a905",
                                        "glosses": [
                                            "Synonym of fuel tank: A fuel storage tank.",
                                            "A fuel tank with a flexible inner liner to reduce the risk of puncture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d020a25b-3b63-4322-8d50-76f32e9e6310",
                        "source_entry_id": "57503f1f-03ce-363d-bbfe-7d71c75b469b",
