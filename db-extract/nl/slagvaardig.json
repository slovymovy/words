                        "glosses": [
                            "gereed zijn om iets snel en krachtig aan te pakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8d1303-6a08-4122-884c-640cbf18ee40",
                                "sense_id": "009d77e8-6903-3222-949d-c69a9847a114",
                                "text": "Een stabiele euro, een krachtige en slagvaardige bankenunie en een sterke en eerlijke interne Europese markt, met een gelijk loon voor hetzelfde werk op dezelfde plek, zijn direct in het belang van ons land. )"
                            },
                            {
                                "example_id": "2c54f23d-cb5b-43f2-b473-e69edc8cdfca",
                                "sense_id": "009d77e8-6903-3222-949d-c69a9847a114",
                                "text": "De kop was zoals gewoonlijk kort en slagvaardig: Terreuradvocaat vlucht voor vrouwendemonstranten Aanklager: Advocaat Letang is EEN SCHANDE VOOR HET ADVOCATENKORPS Maar nu ging het dus om revanche."
                            }
                        ]
                    }
