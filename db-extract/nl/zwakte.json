                "senses": [
                    {
                        "sense_id": "308441a4-94cd-3f6d-9061-c06889f037f7",
                        "entry_id": "10b406cd-dbaf-30c6-9db0-5a05d8bb0817",
                        "glosses": [
                            "het zwak-zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377539e8-f5d6-4536-aba5-330cc44b554a",
                                "sense_id": "308441a4-94cd-3f6d-9061-c06889f037f7",
                                "text": "Zwakte bij dieren in het wild kan gevaarlijk zijn; het dier heeft eerder de kans te worden aangevallen door een vijand."
                            }
                        ]
                    },
                    {
                        "sense_id": "b21d0bf1-7805-39c3-923a-d9ea3ceddc89",
                        "entry_id": "10b406cd-dbaf-30c6-9db0-5a05d8bb0817",
                        "glosses": [
                            "zwakke plek, zwak punt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a1a1e8-2624-428a-9108-0b9a1561137a",
                                "sense_id": "b21d0bf1-7805-39c3-923a-d9ea3ceddc89",
                                "text": "Zélfs die stoere jongen heeft zwaktes."
                            },
                            {
                                "example_id": "8200e2b0-b9d2-4114-a956-ec4d178e381e",
                                "sense_id": "b21d0bf1-7805-39c3-923a-d9ea3ceddc89",
                                "text": "Bij sollicitatiegesprekken zouden ze vragen: wat is je grootste zwakte? en dan zou ik vertellen dat ik waarschijnlijk een groot deel van de werkdag geterroriseerd zou worden door gedachten die ik wel móét denken, bezeten door een demon zonder naam of vorm, dus als dat een probleem was konden ze mij misschien beter niet aannemen."
                            },
                            {
                                "example_id": "b8a3b9bd-dc01-48c8-a748-c3c7d2770056",
                                "sense_id": "b21d0bf1-7805-39c3-923a-d9ea3ceddc89",
                                "text": "'Heb je het gevoel dat je vooruitgaat?' Dat wilde iedereen van me horen - van duisternis naar licht, van zwakte naar kracht, van kapot naar heel."
                            }
                        ]
                    }
                ],
