                    {
                        "form_id": "dada8e3d-74a4-48c5-b993-3c7c3e2f4984",
                        "entry_id": "ea39d96a-d54a-3d49-8a12-17960abf84eb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hoheitszeichen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4dee665-9530-347b-ab82-314f56f9f1ee",
                        "entry_id": "ea39d96a-d54a-3d49-8a12-17960abf84eb",
                        "glosses": [
                            "Symbol, welches die gesetzmäßige Repräsentation einer Hoheit kennzeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7157c648-ed94-4f34-91c6-7b64365eff8d",
                                "sense_id": "a4dee665-9530-347b-ab82-314f56f9f1ee",
                                "text": "Die öffentliche Verunglimpfung von Hoheitszeichen kann in Deutschland mit einer Freiheitsstrafe geahndet werden."
                            },
                            {
                                "example_id": "96c5559e-ab66-40c0-95b6-88af68a6eb05",
                                "sense_id": "a4dee665-9530-347b-ab82-314f56f9f1ee",
                                "text": "„Komplizierter wurde die Lage durch die Besetzung des Regionalparlaments der Autonomen Republik Krim und mehrerer Flughäfen durch nicht mit Hoheitszeichen gekennzeichnete Truppen sowie durch eine gesteigerte Militärpräsenz Russlands auf der Krim.“"
                            },
                            {
                                "example_id": "e6580fa8-203e-4cac-a262-c98b4c7f1fdd",
                                "sense_id": "a4dee665-9530-347b-ab82-314f56f9f1ee",
                                "text": "„Erst nach Überwindung der Inflation erschien die erste Dauerserie mit dem neuen Reichsadler, dem wichtigsten Hoheitszeichen des Weimarer Staates.“"
                            },
                            {
                                "example_id": "725f13a5-48c9-45f5-84d2-dc6fa895adfe",
                                "sense_id": "a4dee665-9530-347b-ab82-314f56f9f1ee",
                                "text": "„Schneller und schneller jagte die zweimotorige Kuriermaschine mit den deutschen Hoheitszeichen über die Startpiste des Flughafens Marseille.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba6a2b6a-6f7b-44ab-b687-caa84bb1e007",
                        "source_entry_id": "ea39d96a-d54a-3d49-8a12-17960abf84eb",
                        "source_sense_id": "a4dee665-9530-347b-ab82-314f56f9f1ee",
                        "source_sense_description": "Symbol, welches die gesetzmäßige Repräsentation einer Hoheit kennzeichnet",
                        "target_lang_word": "emblem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emblem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2922374-4268-32bd-bce1-bc8bd093cf0b",
                                        "entry_id": "5a285e26-842e-374a-86b9-d0f09be12253",
                                        "glosses": [
                                            "A representative symbol, such as a trademark, a badge or logo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1de0b89-1889-464a-8117-9c6d16d020f2",
                                                "sense_id": "d2922374-4268-32bd-bce1-bc8bd093cf0b",
                                                "text": "The medical trucks were emblazoned with the emblem of the Red Cross."
                                            },
                                            {
                                                "example_id": "f891d0d4-a0bc-48bb-a512-1f9c299bd05a",
                                                "sense_id": "d2922374-4268-32bd-bce1-bc8bd093cf0b",
                                                "text": "His ſicatrice, with an Embleme of warre, heere on his ſiniſter cheeke;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "846a1ac2-73b5-3971-80f9-4eed6c4efc93",
                                        "entry_id": "5a285e26-842e-374a-86b9-d0f09be12253",
                                        "glosses": [
                                            "Something that represents a larger whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdf5f21-4ef3-4544-b644-3b8b2446d1c3",
                                                "sense_id": "846a1ac2-73b5-3971-80f9-4eed6c4efc93",
                                                "text": "The rampant poverty in the ethnic slums was just an emblem of the group's disenfranchisement by the society as a whole."
                                            },
                                            {
                                                "example_id": "8a6d2a43-bccd-4431-b6da-49625e6dd0a5",
                                                "sense_id": "846a1ac2-73b5-3971-80f9-4eed6c4efc93",
                                                "text": "Yes, there were instances of grandstanding and obsessive behaviour, but many were concealed at the time to help protect an aggressively peddled narrative of Pistorius the paragon, the emblem, the trailblazer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e860f494-8d1f-37fd-8984-0b09a29973c2",
                                        "entry_id": "5a285e26-842e-374a-86b9-d0f09be12253",
                                        "glosses": [
                                            "Inlay; inlaid or mosaic work; something ornamental inserted in a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4140bf49-3c36-4d3a-b2b5-53049524949d",
                                                "sense_id": "e860f494-8d1f-37fd-8984-0b09a29973c2",
                                                "text": "Broider'd the ground, more color'd than with stone\nOf costliest emblem"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7765ae57-5e9f-3ba0-ad2b-19576d823db2",
                                        "entry_id": "5a285e26-842e-374a-86b9-d0f09be12253",
                                        "glosses": [
                                            "A picture accompanied with a motto, a set of verses, etc. intended as a moral lesson or meditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb44778-ca5c-4f03-aac9-6c8c28d0596e",
                                                "sense_id": "7765ae57-5e9f-3ba0-ad2b-19576d823db2",
                                                "text": "An Emblem is but a ſilent Parable:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6755cc59-add7-3de3-bca8-72ada85400c3",
                                        "entry_id": "5a285e26-842e-374a-86b9-d0f09be12253",
                                        "glosses": [
                                            "A picture placed on the field of the escutcheon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dab2732-941a-4408-acc1-d08811f03d4a",
                                                "sense_id": "6755cc59-add7-3de3-bca8-72ada85400c3",
                                                "text": "Near-synonym: charge"
                                            }
                                        ]
                                    }
                                ]
