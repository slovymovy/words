            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c21f9f82-6f36-3acf-9632-a18aac1464a7",
                    "sense_definition": "Eine Flüssigkeit oder ein Gas gezielt aus einem Behälter austreten lassen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entleeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem Winter muss man das Wasser aus den Rohren im Garten <w>ablassen</w>."
                        },
                        {
                            "text": "Er <w>ließ</w> die Luft aus den Reifen <w>ab</w>, um das Ventil zu reparieren."
                        }
                    ],
                    "synonyms": [
                        "ausfließen lassen",
                        "leeren"
                    ],
                    "antonyms": [
                        "auffüllen"
                    ],
                    "common_phrases": [
                        "Wasser ablassen",
                        "Luft ablassen",
                        "Druck ablassen"
                    ]
                },
                {
                    "sense_id": "af6ec729-737d-38e9-b51c-baf07d75466b",
                    "sense_definition": "Aufhören, eine Person zu bedrängen, anzugreifen oder zu belästigen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstand_nehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Wachhund knurrte laut, aber schließlich <w>ließ</w> er von dem Besucher <w>ab</w>."
                        },
                        {
                            "text": "Die Angreifer sahen die Polizei kommen und <w>ließen</w> sofort von ihrem Opfer <w>ab</w>."
                        }
                    ],
                    "synonyms": [
                        "in Ruhe lassen",
                        "unbehelligt lassen"
                    ],
                    "antonyms": [
                        "bedrängen",
                        "belästigen"
                    ],
                    "common_phrases": [
                        "von jemandem ablassen"
                    ]
                },
                {
                    "sense_id": "dbce97af-1ef6-3982-be41-6565f35fd0f5",
                    "sense_definition": "Seinen aufgestauten Gefühlen, besonders Ärger oder Wut, freien Lauf lassen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem anstrengenden Tag im Büro musste er beim Sport erst einmal Dampf <w>ablassen</w>."
                        },
                        {
                            "text": "Bitte <w>lass</w> deinen Ärger über die Verspätung nicht an den Kindern <w>ab</w>!"
                        }
                    ],
                    "antonyms": [
                        "Ärger hinunterschlucken"
                    ],
                    "common_phrases": [
                        "Dampf ablassen",
                        "Frust ablassen",
                        "seine Wut ablassen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig in festen Redewendungen verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "a11f6930-6347-38a1-b738-0a476f838daf",
                    "sense_definition": "Eine Absicht oder ein Vorhaben nicht weiter verfolgen und aufgeben.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abstand_nehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen der schlechten Wettervorhersage <w>ließen</w> die Bergsteiger von ihrem Plan <w>ab</w>."
                        },
                        {
                            "text": "Sie wollte nicht von der Idee <w>ablassen</w>, obwohl alle Bekannten ihr abrieten."
                        }
                    ],
                    "synonyms": [
                        "abkommen",
                        "aufgeben",
                        "aufhören"
                    ],
                    "antonyms": [
                        "beharren"
                    ],
                    "common_phrases": [
                        "von einem Plan ablassen",
                        "von einem Vorhaben ablassen"
                    ]
                }
            ]
        },
        {
