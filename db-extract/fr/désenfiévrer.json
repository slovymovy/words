                ],
                "senses": [
                    {
                        "sense_id": "3577516f-6811-34c4-b671-7b3eaeb2f495",
                        "entry_id": "c0d5b9c3-2c40-3a88-8e77-57676d575412",
                        "glosses": [
                            "Débarrasser de la fièvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d020854d-0031-456a-88ca-0dfc32f6ed63",
                                "sense_id": "3577516f-6811-34c4-b671-7b3eaeb2f495",
                                "text": "Donc, prière de me désenfiévrer tout de suite en me donnant toute nouvelle nouvelle, même sans m'envoyer l'argent (les 200 francs)."
                            },
                            {
                                "example_id": "c4395d0e-fedb-4764-bbf9-8744bc601c90",
                                "sense_id": "3577516f-6811-34c4-b671-7b3eaeb2f495",
                                "text": "Pour voir, en effet, il faut se désenfiévrer, se purifier."
                            },
                            {
                                "example_id": "ae156ecf-f495-454b-8536-10b461dcaa87",
                                "sense_id": "3577516f-6811-34c4-b671-7b3eaeb2f495",
                                "text": "Et, le soir, pour me désenfiévrer de mon labeur, j'allais faire les cent pas sous les platanes géants de la promenade, ou m'asseoir sur une terrasse de café devant les ogives hispano-moresques de la Loge de Mer."
                            }
                        ]
                    }
                ],
