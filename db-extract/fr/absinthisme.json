                        "sense_id": "242ef73d-7247-3a1c-aecd-d2c44fb7357a",
                        "entry_id": "14475a02-caa5-35b2-abae-91dfdd7424a7",
                        "glosses": [
                            "Dépendance à la consommation d’absinthe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6edc9a9-1ae5-4929-8aa2-74aece627a8f",
                                "sense_id": "242ef73d-7247-3a1c-aecd-d2c44fb7357a",
                                "text": "Quelle est donc, au point de vue du diagnostic différentiel, la valeur de symptômes que l'on peut, à la fois, observer dans l'alcoolisme et dans l'absinthisme?"
                            },
                            {
                                "example_id": "ccc3b7f3-cb60-4504-b115-c0c3b5fd190b",
                                "sense_id": "242ef73d-7247-3a1c-aecd-d2c44fb7357a",
                                "text": "Si jeune et déjà perdu… absinthisme et grisette…"
                            }
                        ]
                    }
                ],
