                "senses": [
                    {
                        "sense_id": "03f2df10-a729-3f37-9ff5-d8a894f06081",
                        "entry_id": "8c0f3515-097d-3b1b-a343-36e079931369",
                        "glosses": [
                            "Fehlbetrag im Haushalt des Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc33d2c-19e2-4f07-8ef9-9dc9928616f3",
                                "sense_id": "03f2df10-a729-3f37-9ff5-d8a894f06081",
                                "text": "„Inzwischen schmelzen die Polkappen, im Weltraum fliegt nur noch Schrott herum und bei dem Staatsdefizit will wohl auch keiner mehr Amerika entdecken.“"
                            },
                            {
                                "example_id": "5c1ce4dc-5120-4154-989a-7464f70a63a9",
                                "sense_id": "03f2df10-a729-3f37-9ff5-d8a894f06081",
                                "text": "„Das Staatsdefizit ist coronabedingt gewaltig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2095a990-f4f3-4284-b955-4a9ef85658be",
                        "source_entry_id": "8c0f3515-097d-3b1b-a343-36e079931369",
                        "source_sense_id": "03f2df10-a729-3f37-9ff5-d8a894f06081",
                        "source_sense_description": "Fehlbetrag im Haushalt des Staates",
                        "target_lang_word": "déficit public",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déficit public",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f635ae7-b1a9-37b8-b7f5-009103dd6239",
                                        "entry_id": "4f8856a8-d390-3e69-8345-f2b7c0306e44",
                                        "glosses": [
                                            "Besoin de financement pour un déficit positif, ou capacité de financement pour un déficit négatif (c'est-à-dire un excédent) du secteur des administrations publiques."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfb1e9b-7fd2-4629-a955-d5f02475c394",
                                                "sense_id": "7f635ae7-b1a9-37b8-b7f5-009103dd6239",
                                                "text": "Depuis quinze ans, il n’y a que deux années où notre déficit public a été sous le seuil des 3 %, en 2018 et 2019, lors du premier quinquennat d’Emmanuel Macron."
                                            },
                                            {
                                                "example_id": "c8aee8dd-29a9-48cd-b5d5-8443ba03db88",
                                                "sense_id": "7f635ae7-b1a9-37b8-b7f5-009103dd6239",
                                                "text": "Le déficit (excédent) public est le besoin de financement (capacité de financement) (N5) du secteur «administrations publiques» (S60), tel que défini dans le SEC (système européen de comptes économiques intégrés)"
                                            },
                                            {
                                                "example_id": "7c47159f-4daf-439a-af6c-6c0521e322ce",
                                                "sense_id": "7f635ae7-b1a9-37b8-b7f5-009103dd6239",
                                                "text": "Pourtant, derrière ce concept complexe se cache une réalité implacable le déficit public agit comme un triple impôt, dont les effets, bien qu'insidieux, marquent durablement le présent et hypothèquent l'avenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
