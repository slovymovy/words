                        "entry_id": "87cb7b1d-5812-3d20-aca0-c89e88a11508",
                        "glosses": [
                            "Adrénaline, épinéphrine."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "441d6139-ea7b-45e2-86f2-868f4befec63",
                                "sense_id": "e95ad367-18de-30fa-8a56-5469b991e993",
                                "text": "Broken my bones, puked out my guts\nI pushed it to the limit\nBut I wouldn't change a thing, I’d do it all again\n'Cause I’m an adrenaline addict!",
                                "translation": "J’ai cassé mes os, gerbé mes tripes / J’ai poussé jusqu’à la limite / Mais je ne changerai rien, je le referai / Parce que je suis accro à l’adrénaline"
                            }
                        ]
                    }
