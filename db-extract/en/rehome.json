                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6fed0402-f2d8-4c09-ba5e-31b920b60548",
                                "sense_id": "2c259f23-a971-349b-a9ad-4bcb81e9e72c",
                                "text": "The cat recovered after treatment by a vet and has now been rehomed."
                            },
                            {
                                "example_id": "f3017668-7d60-4316-b278-df76a34ececa",
                                "sense_id": "2c259f23-a971-349b-a9ad-4bcb81e9e72c",
                                "text": "Lucy added: \"Working in a busy station means that acquiring animals on shift isn't particularly unusual. At the start of lockdown last year, we had to rehome a baby dove."
                            },
                            {
                                "example_id": "d2d9c4fc-56cb-4899-81dc-ea4b8ec99580",
                                "sense_id": "2c259f23-a971-349b-a9ad-4bcb81e9e72c",
                                "text": "The old footbridge will now be rehomed to Brechin station, on the Caledonian Railway heritage operation in Angus."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbadaa41-6a7a-3f07-8069-0a538985222f",
                        "entry_id": "6fbcf0ea-3e4e-3a8b-ab9a-746b0aa121db",
