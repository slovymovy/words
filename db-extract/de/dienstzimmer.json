                ],
                "senses": [
                    {
                        "sense_id": "eb3fce70-442c-3e3a-9cc7-dbe82b77eb7a",
                        "entry_id": "b68ac661-156a-3a94-a7c5-70c00d5bacdc",
                        "glosses": [
                            "Arbeitszimmer einer Person, die ein Amt ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf62240d-6396-48eb-abf4-53fae38ad4c5",
                                "sense_id": "eb3fce70-442c-3e3a-9cc7-dbe82b77eb7a",
                                "text": "„Halbherzig wurden die Spuren in die gehobenen Dienstzimmer des Bezirksamtes hinein verfolgt, wo sie sich dann irgendwie verloren.“"
                            },
                            {
                                "example_id": "b198c48b-e468-4a5b-ad11-3daef919e938",
                                "sense_id": "eb3fce70-442c-3e3a-9cc7-dbe82b77eb7a",
                                "text": "„Dann trug sie ihr Bettzeug im Arm ins Dienstzimmer, um da auf der heizbaren Lagerstatt schlafen zu gehen.“"
                            },
                            {
                                "example_id": "6641a229-cff4-47f3-b4cf-66eccd18cfce",
                                "sense_id": "eb3fce70-442c-3e3a-9cc7-dbe82b77eb7a",
                                "text": "„Um 5 Uhr 15 trank Thomas Lieven im Dienstzimmer des Tiroler Hauptmanns Öllinger heißen Kaffee.“"
                            },
                            {
                                "example_id": "af751533-6209-4478-a090-e4aafe739621",
                                "sense_id": "eb3fce70-442c-3e3a-9cc7-dbe82b77eb7a",
                                "text": "„SS und Sicherheitsdienst töten ihn durch Kopfschuss in seinem Dienstzimmer, als Todesursache wird Suizid angegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
