                ],
                "senses": [
                    {
                        "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                        "entry_id": "39daecb1-f6bc-326e-9de1-5fc2fa6b92fb",
                        "glosses": [
                            "(junges) männliches oder weibliches (domestiziertes oder wild lebendes) Schaf (Ovis)"
                        ],
                        "tags": [
                            "Namibia"
                        ],
                        "examples": [
                            {
                                "example_id": "134f8914-74e3-42f1-b6b2-ba637b046759",
                                "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                                "text": "„Ihr könntet gemeinsam Bokkies hüten oder zwischen Hakiebusch und Kanniedood arkadische Schäferspiele betreiben.“"
                            },
                            {
                                "example_id": "e11306b7-d919-4792-8804-1d4f35010ed1",
                                "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                                "text": "„Beester[,] Bokkies und Donkeys haben auch die Gärten der abgezogenen Bleichgesichter ordentlich zurechtgestutzt.“"
                            },
                            {
                                "example_id": "4556d702-052a-4ff4-820e-d54930c33c88",
                                "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                                "text": "„Jedenfalls sagt der Bure, der Affe kenne jedes einzelne Tier und nie gehe eines verloren. Ich habe es mit eigenen Augen gesehen: Morgens geht er mit den Bokkies auf die Weide, säubert den Platz von Schlangen und Skorpionen, die er an Ort und Stelle sofort auffrisst, und während die Bokkies weiden, entlaust er sie und nimmt ihnen die Zecken ab.“"
                            },
                            {
                                "example_id": "13a18044-b43d-4e73-90e8-2a4b5524c6a4",
                                "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                                "text": "„Die mussten in der folgenden Friedenszeit nach 1990 ebenso kostspielig und risikoreich wieder geräumt werden, denn manch armer Bokkie und manch elendes Beest hat die Tretminen ausgelöst.“"
                            },
                            {
                                "example_id": "a7422bad-5980-4f87-b154-137bc0560a9f",
                                "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                                "text": "„Zu allem, was Hörner hat oder irgendwie noch Hörner bekommen soll, sagen die Mädchen Bokkie. Egal ob Schaf, Ziege oder Lämmchen oder Zicklein. Die Ovambo kennen sich mit den Bokkies aus, das wissen sie.“"
                            },
                            {
                                "example_id": "bdee135a-dddc-44b5-bfad-1a90b8ceaa47",
                                "sense_id": "c8f80233-3173-3664-8b75-0d2409d20d0c",
                                "text": "„Während der Farmrundfahrt weist er auf eine kleine Schafherde hin: ‚Zur Zeit laufen hier 70 herum, die kleinen Bokkies mitgezählt.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                        "entry_id": "39daecb1-f6bc-326e-9de1-5fc2fa6b92fb",
                        "glosses": [
                            "(junge) männliche oder weibliche (domestizierte oder wild lebende) Ziege (Capra); (junge) männliche oder weibliche Angoraziege (Capra aegagrus hircus)"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "5c0d6daa-4b85-4fc2-ab9e-07d70a59e43a",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Ihr könntet gemeinsam Bokkies hüten oder zwischen Hakiebusch und Kanniedood arkadische Schäferspiele betreiben.“"
                            },
                            {
                                "example_id": "d2517931-8ed4-4bc3-890f-50b79286fff3",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Beester[,] Bokkies und Donkeys haben auch die Gärten der abgezogenen Bleichgesichter ordentlich zurechtgestutzt.“"
                            },
                            {
                                "example_id": "6baa085a-0733-45e6-a230-229e796f691e",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Jedenfalls sagt der Bure, der Affe kenne jedes einzelne Tier und nie gehe eines verloren. Ich habe es mit eigenen Augen gesehen: Morgens geht er mit den Bokkies auf die Weide, säubert den Platz von Schlangen und Skorpionen, die er an Ort und Stelle sofort auffrisst, und während die Bokkies weiden, entlaust er sie und nimmt ihnen die Zecken ab.“"
                            },
                            {
                                "example_id": "8050bcc1-4725-45fb-b0ef-65c905ee7e7c",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Die mussten in der folgenden Friedenszeit nach 1990 ebenso kostspielig und risikoreich wieder geräumt werden, denn manch armer Bokkie und manch elendes Beest hat die Tretminen ausgelöst.“"
                            },
                            {
                                "example_id": "008b85b8-cbfa-42bc-b373-a84cb890c510",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Zu allem, was Hörner hat oder irgendwie noch Hörner bekommen soll, sagen die Mädchen Bokkie. Egal ob Schaf, Ziege oder Lämmchen oder Zicklein. Die Ovambo kennen sich mit den Bokkies aus, das wissen sie.“"
                            },
                            {
                                "example_id": "7872e478-bb2d-4e32-831b-a5e7b1099f0a",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Fast jeden Tag fehlte ein Bocki oder ein Schaf.“"
                            },
                            {
                                "example_id": "ae39b8bc-e505-4199-b72c-d13a02b87bf3",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„‚Es war nicht einfach, im Norden des Landes auf den kommerziellen Farmen etwas zu finden, weil Farmer nicht nur weniger Bokkies (Ziegen) halten, sondern weil in den vergangenen drei Jahren über 9000 Ziegen aus diesem Teil des Landes nach Angola verkauft wurden‘, sagte Herzberg.“"
                            },
                            {
                                "example_id": "96b8c01a-ce7c-44d6-900d-3bce2829fad3",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Hewatt Beukes hatte schon bei voriger Gelegenheit über deutsch-namibische Beziehungen gesagt, dass ‚ein paar alte Bokkies (Ziegen) für die Leute‘ in keiner Weise als Wiedergutmachung eingestuft werden könnten.“"
                            },
                            {
                                "example_id": "704677b0-9fce-41b7-ab4e-47a96e1e45b7",
                                "sense_id": "6094994a-95fd-3c19-840d-31ce56dead8f",
                                "text": "„Im Jahr 2009 nähern wir uns der Wasserscheide, wo sich die Bokkies von den Zicken trennen, sich Beester von Rindviechern abheben und wo Hornochsen zumeist hinter der Hammelherde hertrampeln.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
