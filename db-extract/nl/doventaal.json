                        "source_entry_id": "a9d93fc9-784b-3d21-a3e1-ea5da9f65df4",
                        "source_sense_id": "d338bfbf-ec4e-3501-907e-9b78cbf4b01f",
                        "source_sense_description": "taal die mensen die niet of slecht kunnen horen gebruiken om te kunnen communiceren (officiële term is gebarentaal)",
                        "target_lang_word": "sign language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
