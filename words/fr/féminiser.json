            "senses": [
                {
                    "sense_id": "8baf7e6f-586b-3b02-949a-21439ee78d58",
                    "sense_definition": "Augmenter la proportion de femmes au sein d'un groupe, d'une profession ou d'une institution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "societe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche à <w>féminiser</w> ses équipes de direction pour assurer une meilleure parité."
                        },
                        {
                            "text": "Plusieurs mesures ont été adoptées afin de <w>féminiser</w> les effectifs de la police nationale."
                        }
                    ],
                    "antonyms": [
                        "masculiniser"
                    ],
                    "common_phrases": [
                        "féminiser les effectifs",
                        "féminiser la profession"
                    ]
                },
                {
                    "sense_id": "3c4165f6-1162-3c48-8765-e2460ceb1407",
                    "sense_definition": "Donner la forme du genre féminin à un mot, en particulier à un nom de métier ou de fonction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est désormais courant de <w>féminiser</w> les noms de métiers dans les documents officiels."
                        },
                        {
                            "text": "L'Académie française a fini par accepter de <w>féminiser</w> certains titres traditionnellement masculins."
                        }
                    ],
                    "antonyms": [
                        "masculiniser"
                    ],
                    "common_phrases": [
                        "féminiser les titres",
                        "féminiser les noms de métiers"
                    ]
                },
                {
                    "sense_id": "08db67fc-a51b-3dee-8950-fbc4d1d1d98d",
                    "sense_definition": "Donner des traits physiques ou une apparence traditionnellement considérés comme féminins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le traitement hormonal contribue à <w>féminiser</w> la voix et la silhouette de la patiente."
                        },
                        {
                            "text": "Le maquilleur a su habilement <w>féminiser</w> les traits de l'acteur pour ce rôle particulier."
