                                "target_senses": [
                                    {
                                        "sense_id": "86f60f1d-8414-37bc-94ab-e135b82ba809",
                                        "entry_id": "fd1396be-cf5c-3e74-b97f-1b6b0fa68d0c",
                                        "glosses": [
                                            "Qualifie le format réduit de page de journal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7584ca50-67f7-4c00-9eea-a66ed408c65e",
                                                "sense_id": "86f60f1d-8414-37bc-94ab-e135b82ba809",
                                                "text": "Le format tabloïd correspond à la moitié des dimensions d’un journal traditionnel. Son format plié est de 41 cm x 29 cm environ."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tabloïd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6957de7e-9fc8-3c7c-bcfa-33f7e524c9c9",
                                        "entry_id": "e2ce6873-15a3-344b-bffa-41f1ff907b5f",
                                        "glosses": [
                                            "Journal dont la feuille est d'un format plus petit (d'environ 50 %) que celui d'un journal standard, généralement caractérisé par une politique éditoriale populiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6b8768-d911-4ab9-8d32-b9e3644668bb",
                                                "sense_id": "6957de7e-9fc8-3c7c-bcfa-33f7e524c9c9",
                                                "text": "Un tabloïd accuse Tsahal de trafic d'organes sur des Palestiniens."
                                            },
                                            {
                                                "example_id": "261b743f-505f-4cb8-a8af-b0c1fdbd88ed",
                                                "sense_id": "6957de7e-9fc8-3c7c-bcfa-33f7e524c9c9",
                                                "text": "Interviewé dans le tabloïd allemand Bild, M. Varoufakis a jugé que la chancelière Angela Merkel détenait « la clé » pour dénouer la crise."
                                            },
                                            {
                                                "example_id": "3852bb49-1a75-4c5a-9e5e-4ce5d2be4bb6",
                                                "sense_id": "6957de7e-9fc8-3c7c-bcfa-33f7e524c9c9",
                                                "text": "Ou quand la Première ministre nomme un de ses proches, Michael Laugsen, ancien rédacteur en chef d’un tabloïd et ennemi de Birgitte…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tabloïd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1369c715-b80d-37d3-bbf0-e95dfd12654a",
                                        "entry_id": "cd68a2a9-b8a2-3d16-b398-f7b6124f6798",
                                        "glosses": [
                                            "Présentation galénique de certains médicaments sous forme de petites tablettes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588d7230-5c6d-4cda-a549-ac0177042974",
                                                "sense_id": "1369c715-b80d-37d3-bbf0-e95dfd12654a",
                                                "text": "Des doses de 2 ou 1 tabloïd ( Burroughs and Wellcome ) donnés pour un eczéma des membres, du tronc et des paupières produisirent les symptômes suivants : …."
                                            },
                                            {
                                                "example_id": "d0d0d601-8d10-4544-bb85-a08fd667ffcf",
                                                "sense_id": "1369c715-b80d-37d3-bbf0-e95dfd12654a",
                                                "text": "Le Dr Aufrecht a constaté, comme beaucoup d'autres auteurs, que les tabloïds de quinine passent souvent à travers le tube digestif sans être absorbés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
