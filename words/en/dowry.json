                },
                {
                    "sense_id": "97e4f50e-392f-3c3e-a7de-8e23411e2084",
                    "sense_definition": "A large amount or collection of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "figurative_gift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden displayed a whole <w>dowry</w> of colorful blossoms in the spring.",
                            "target_lang_translations": {
                                "ru": "Весной сад демонстрировал целое <w>богатство</w> красочных цветов.",
                                "fr": "Le jardin offrait toute une <w>richesse</w> de fleurs éclatantes au printemps.",
                                "zh": "春天里，花园里绽放出一片<w>丰富</w>而绚丽的花朵。"
                            }
                        },
                        {
                            "text": "He brought a <w>dowry</w> of stories from his travels around the world.",
                            "target_lang_translations": {
                                "ru": "Он привез <w>коллекцию</w> историй из своих путешествий по всему миру.",
