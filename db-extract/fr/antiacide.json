                        "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                        "entry_id": "611ef286-7962-3309-851b-207ac1af8b27",
                        "glosses": [
                            "Produit qui s’oppose à l’acidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2642c2-58b9-4dfc-8644-be1322987500",
                                "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                "text": "Récemment, plusieurs équipes on rapporté l’absence de sur-incidence de P.N.A.V.M. lors de l’utilisation d’anti-H² (49, 51, 62, 71) ou d’antiacides (8)."
                            },
                            {
                                "example_id": "ae1b38d5-dcca-467d-b96d-39de96e87fe5",
                                "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                "text": "Qu’est-ce qu’un antiacide?"
                            },
                            {
                                "example_id": "82d62721-6369-4801-b2cb-7b42f1a2dbba",
                                "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                "text": "L’hydroxyde de magnésium, est un antiacide d’action rapide et brève ; il peut provoquer une diarrhée."
                            }
                        ]
                    }
