                                "target_senses": [
                                    {
                                        "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Vertu qui porte à garder une sage mesure en toutes choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b83c1690-c1ab-41ae-9505-0906ae2f9ae2",
                                                "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                                "text": "Convenons-en, les exemples de bombance qui lui sont ici donnés ne sont pas faits pour lui inspirer des idées de modération."
                                            },
                                            {
                                                "example_id": "b6b2d813-4b77-438d-8315-530111306cb2",
                                                "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                                "text": "Ce café, le dimanche, accompagnait parfois la traditionnelle tarte au riz belge que découvre sans modération le commissaire Maigret à Givet…"
                                            },
                                            {
                                                "example_id": "2d4800b0-4042-4966-bb45-6ae350c51199",
                                                "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                                "text": "Même si les énoncés sont frelatés sur le plan scientifique, leur public associe la modération avec une posture savante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Retranchement, diminution d’un prix ou d’une taxe."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49bc316e-2dfb-433a-b7f7-41f2771c3572",
                                                "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                                "text": "La modération d’une contribution."
                                            },
                                            {
                                                "example_id": "6df5f204-4186-475b-94e4-9fdfd2bbf669",
                                                "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                                "text": "On ne lui a fait aucune modération."
                                            },
                                            {
                                                "example_id": "955ca41d-4c78-4f11-80e2-e4c2bec9ea13",
                                                "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                                "text": "On ne lui accorde aucune modération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69aa9755-ff2c-3147-9a1c-a340d82181e0",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Adoucissement, mitigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84271ce5-65df-4103-be53-3bb5779b5101",
                                                "sense_id": "69aa9755-ff2c-3147-9a1c-a340d82181e0",
                                                "text": "La modération d’une peine, d’une amende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10efb278-4bd9-307d-ba4a-8bda63a96b83",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Présentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bea70a3-7152-4126-8358-838d4d479ba1",
                                                "sense_id": "10efb278-4bd9-307d-ba4a-8bda63a96b83",
                                                "text": "La modération du Journal 8h (Europe 1) par Eva Roque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c967a5-8e74-3ed9-9f3f-512603fb39b2",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Conduite, direction, guidage, pilotage d'une discussion, d'une réunion, d'une séance, d'un congrès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502b8528-9756-4417-8a0d-d1d83224bc85",
                                                "sense_id": "b8c967a5-8e74-3ed9-9f3f-512603fb39b2",
                                                "text": "Modération par les utilisateurs. Autre différence majeure : la modération n'est pas verticale mais horizontale. Comme sur Wikipédia, les utilisateurs ont la possibilité d'intervenir directement pour modifier un contenu, un moyen selon lui (Jimmy Wales) d'encourager les comportements vertueux."
                                            },
                                            {
                                                "example_id": "e3422e70-f910-45a4-baaf-a45c7f21ec8c",
                                                "sense_id": "b8c967a5-8e74-3ed9-9f3f-512603fb39b2",
                                                "text": "Ils devraient en particulier inclure des renseignements ayant trait aux politiques, procédures, mesures et outils utilisés à des fins de modération des contenus, y compris la prise de décision fondée sur des algorithmes et le réexamen par un être humain ainsi que le règlement intérieur de leur système interne de traitement des réclamations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "420db7d0-3ea7-4351-8918-30b6e5d40f15",
                        "source_entry_id": "558984ee-08f3-3652-bd5a-b3e9aa931771",
                        "source_sense_id": "b70af4a0-18ae-3b87-8988-38ffc184afbf",
                        "source_sense_description": "die Art, mit wenig zufrieden zu sein",
                        "target_lang_word": "sobriété",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sobriété",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcf2dd2f-a084-3619-b1a4-86e276b984cb",
                                        "entry_id": "fd594b65-ce8a-34ef-94a8-88fbeb49795e",
                                        "glosses": [
                                            "Caractère de celui qui est sobre, modéré dans le boire et le manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0736b2-218f-4625-ba35-a953451c7d5f",
                                                "sense_id": "dcf2dd2f-a084-3619-b1a4-86e276b984cb",
                                                "text": "La sobriété est une condition de bonne santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f069ccb4-bb35-3c22-bd46-d1683f792dc2",
                                        "entry_id": "fd594b65-ce8a-34ef-94a8-88fbeb49795e",
                                        "glosses": [
                                            "Caractère de celui qui ne consomme pas de psychotrope, en particulier l’alcool."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e61ff23-475a-415a-b51c-c43a3256da19",
                                                "sense_id": "f069ccb4-bb35-3c22-bd46-d1683f792dc2",
                                                "text": "Clémence Bodoc vous amène à travers son voyage vers la sobriété, après avoir été un tantinet trop penchée sur la pinte de bière à son goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98e5e933-eb5d-3198-b81e-01db5ed9a3a9",
                                        "entry_id": "fd594b65-ce8a-34ef-94a8-88fbeb49795e",
                                        "glosses": [
                                            "Caractère des animaux qui sont peu exigeants pour leur nourriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edfba0a-6718-43b8-a55d-0600946044f0",
                                                "sense_id": "98e5e933-eb5d-3198-b81e-01db5ed9a3a9",
                                                "text": "Le chameau remplace, au Maroc, le chemin de fer et les voitures. […]. Il est inutile de rappeler la sobriété de cet animal ; il se nourrit des herbes qu’il parvient à happer le long de la route; à l’étape, on lui donne de la paille ou du fourrage vert et une ration d’orge tous les trois jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d13fbcb7-6722-3ef8-a41c-6cab06d56d3d",
                                        "entry_id": "fd594b65-ce8a-34ef-94a8-88fbeb49795e",
                                        "glosses": [
                                            "Fait de vivre modestement, sans consommer plus que nécessaire, pour limiter sa consommation d’énergie et agir contre le réchauffement climatique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7ddaa21-4606-4e73-834c-43e8e9b370be",
                                                "sense_id": "d13fbcb7-6722-3ef8-a41c-6cab06d56d3d",
                                                "text": "Dans un modèle de société fondé sur la croissance, la sobriété dérange. Elle est, à tort, souvent assimilée à la recherche d’efficacité faire plus avec moins qui mise sur le progrès technologique pour préserver la planète."
                                            },
                                            {
                                                "example_id": "dd576816-bec7-4aca-9952-f6e164db5921",
                                                "sense_id": "d13fbcb7-6722-3ef8-a41c-6cab06d56d3d",
                                                "text": "Nous ne parviendrons pas à respecter notre planète sans réduire notre consommation d’énergie et de biens. Peu importe le terme employé, prôner l’indispensable décroissance, sobriété ou baisse du produit intérieur brut tel qu’on le mesure encore aujourd’hui est encore tabou en politique."
                                            },
                                            {
                                                "example_id": "7fbf517e-415b-494e-9f31-9f3f171a6e94",
                                                "sense_id": "d13fbcb7-6722-3ef8-a41c-6cab06d56d3d",
                                                "text": "Il s’agit notamment de modifier nos productions et notre consommation dans le sens d’une plus grande sobriété, grâce à des changements de pratiques individuelles, mais surtout grâce à des transformations structurelles obtenues par des investissements massifs dans les énergies renouvelables, la rénovation thermique des bâtiments, les alternatives aux transports thermiques et l’agriculture, notamment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e90c854-e036-3c1a-bb8f-cc8875aaa393",
                                        "entry_id": "fd594b65-ce8a-34ef-94a8-88fbeb49795e",
                                        "glosses": [
                                            "Réserve ; retenue ; modération."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7c7f26-e7d6-4fc7-9b1f-040c22641eac",
                                                "sense_id": "2e90c854-e036-3c1a-bb8f-cc8875aaa393",
                                                "text": "Mais pour le garder auprès de lui, il déploie sa maîtrise romanesque ultraconvaincante : par sa sobriété remarquable, par son sens souvent hilarant du micro-détail, il offre une belle densité à ses personnages."
                                            },
                                            {
                                                "example_id": "fea09d2b-ceb8-42d1-9d1e-1f60920e84f9",
                                                "sense_id": "2e90c854-e036-3c1a-bb8f-cc8875aaa393",
                                                "text": "Son vocabulaire hésitait perpétuellement entre la sobriété et l’emphase."
                                            },
                                            {
                                                "example_id": "d9a85ed7-8b45-4004-91c7-e89fcbd18dca",
                                                "sense_id": "2e90c854-e036-3c1a-bb8f-cc8875aaa393",
                                                "text": "La parfaite raison fuit toute extrémité,\nEt veut que l’on soit sage avec sobriété."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
