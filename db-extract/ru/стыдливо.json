                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shyly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8540332-a8ca-391c-9430-199a2d8658ac",
                                        "entry_id": "8dbf6a34-f8d9-3005-9eb7-1f678fa4a5f8",
                                        "glosses": [
                                            "In a shy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c28ac15e-e150-4c2c-b5c2-5eb7ede2a714",
                                                "sense_id": "d8540332-a8ca-391c-9430-199a2d8658ac",
                                                "text": "The moon went slowly down in chastened loveliness; she departed like some sweet bride into her chamber, and long veil-like shadows crept up the sky through which the stars peeped shyly out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
