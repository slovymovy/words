                "senses": [
                    {
                        "sense_id": "b90bccee-8f4f-374e-b77f-fa9754ed1bd4",
                        "entry_id": "e79800a2-fd0d-387c-8bbe-8a8959abcecb",
                        "glosses": [
                            "Rauch, der beim Rauchen von Zigarren entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b60ddf7-9571-407e-97f8-d31edd123ce5",
                                "sense_id": "b90bccee-8f4f-374e-b77f-fa9754ed1bd4",
                                "text": "„Der Raum war voller Zigarrenrauch und lärmender Amerikaner.“"
                            },
                            {
                                "example_id": "dc06b75a-270b-487a-8a84-8cfa723e9fca",
                                "sense_id": "b90bccee-8f4f-374e-b77f-fa9754ed1bd4",
                                "text": "„Mit verschränkten Armen, die Augen zur Fensterfront gerichtet, blies der bärtige Hüne Ringe aus Zigarrenrauch in die Luft, die sich wie Ringe auf einer Wasseroberfläche ausdehnten.“"
                            }
                        ],
