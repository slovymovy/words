                "senses": [
                    {
                        "sense_id": "46fe878a-49f1-32ac-96aa-c289719cb642",
                        "entry_id": "8da60f4d-5fe2-39e5-b04f-4e19edfac324",
                        "glosses": [
                            "Brandir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ed5077-b8e5-4c9e-bf66-53f910244dab",
                                "sense_id": "46fe878a-49f1-32ac-96aa-c289719cb642",
                                "text": "Nombre d'essais divers, qui se réclament dans leurs titres d'une seule des notions que se permet de rebrandir le nôtre, ont avant tout pour objet de reprendre, plus ou moins longuement, le débat de la technique et de la foi."
                            },
                            {
                                "example_id": "dcac176d-5390-4dbb-a8e4-6786280559ac",
                                "sense_id": "46fe878a-49f1-32ac-96aa-c289719cb642",
                                "text": "Si par malheur il devait advenir que qui que ce soit s'avise de rebrandir la menace stalinienne contre les fabuleux dessins de Eisenstein, nous nous souviendrions de son message radio du 3 juillet 1941 : « À mes frères juifs du monde entier »."
                            }
                        ]
                    }
                ],
