                        "glosses": [
                            "A herbarium specialising in specimens of wood."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c1862d-b1f3-45d8-8cd0-6bf37214ca47",
                                "sense_id": "e9d4d26f-eca3-3920-88a7-a4f2eda3f566",
                                "text": "A plant anatomist receiving such samples can remove pickled wood and bark for anatomical study, then dry the remaining portions for inclusion in a xylarium."
                            },
                            {
                                "example_id": "1743dffb-848c-45ee-8016-db0c5238a7de",
                                "sense_id": "e9d4d26f-eca3-3920-88a7-a4f2eda3f566",
                                "text": "The genus [Dalechampia] is poorly represented in xylaria and its wood is little known."
                            },
                            {
                                "example_id": "53900cfb-69fc-4f52-861b-036343bade0c",
                                "sense_id": "e9d4d26f-eca3-3920-88a7-a4f2eda3f566",
                                "text": "Samples were identified according to the standards of the International Association of Wood Anatomists (AWA) by consulting xylariums, glass plate archives, bibliographies and databases."
                            }
                        ]
                    }
