                "senses": [
                    {
                        "sense_id": "92952b76-6f70-3ad5-830c-8c59e0efcc2b",
                        "entry_id": "87c1a5c7-8002-3874-b2f2-2457b5722b84",
                        "glosses": [
                            "jemand, der die lebensnotwendige Flüssigkeit Wasser stiehlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea9a698-1636-4bed-80f8-b980ab3a9d8a",
                                "sense_id": "92952b76-6f70-3ad5-830c-8c59e0efcc2b",
                                "text": "„»Wasch dich, und dann geh zu Großma und bitte sie um Verzeihung, denn du bist ein Dieb, und zwar einer von der schlimmsten Sorte: ein Wasserdieb.«“"
                            },
                            {
                                "example_id": "7e135cb4-1860-4355-8e78-f8e4d633ecca",
                                "sense_id": "92952b76-6f70-3ad5-830c-8c59e0efcc2b",
                                "text": "„Es gibt Landratten und Wasserratten, Wasserdiebe und Landdiebe.“"
                            },
                            {
                                "example_id": "cb3c99ed-9e07-48ef-aedf-7c252ee587b5",
                                "sense_id": "92952b76-6f70-3ad5-830c-8c59e0efcc2b",
                                "text": "„Israel hat sich an die Vorgaben gehalten, die Wasserlieferungen erhöht und ist aktiv gegen Wasserdiebe und andere auftauchende Probleme vorgegangen. “"
                            },
                            {
                                "example_id": "2fde43e9-f4fe-4bbf-b7f0-0f58f16eeca0",
                                "sense_id": "92952b76-6f70-3ad5-830c-8c59e0efcc2b",
                                "text": "„So wurden die Bauern zu Wasserdieben gemacht: Eine Pipeline, die an der Südküste der Insel von Gela nach Agrigent führt, wird jetzt von Soldaten bewacht, weil sie an vielen Stellen angebohrt worden ist.“"
                            },
                            {
                                "example_id": "d6e834df-db38-4934-a481-7d5e43d5cef6",
                                "sense_id": "92952b76-6f70-3ad5-830c-8c59e0efcc2b",
                                "text": "„Vergebens sind harte Strafen, vergebens gut bezahlte Wächter; Noth und Bedürfniß schärfen des armen Wasserdiebes List und Erfindungsgeist.“ (1818)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
