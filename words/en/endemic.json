{
    "word_family": [
        "endemicity",
        "endemism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eeb3ef71-efac-344d-8770-bcb9b507a8e5",
                    "sense_definition": "Naturally occurring only in a specific geographic area or region.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geographic_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many unique plants are <w>endemic</w> to this small island.",
                            "target_lang_translations": {
                                "ru": "Многие уникальные растения <w>эндемичны для</w> этого небольшого острова."
                            }
                        },
                        {
                            "text": "These rare birds are <w>endemic</w> to the mountain forests.",
                            "target_lang_translations": {
                                "ru": "Эти редкие птицы являются <w>эндемиками</w> горных лесов."
                            }
                        }
                    ],
                    "synonyms": [
                        "indigenous",
                        "precinctive"
                    ],
                    "antonyms": [
                        "alien",
                        "introduced"
                    ],
                    "common_phrases": [
                        "endemic to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встречающийся в естественных условиях только в определённой географической местности или регионе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эндемичный",
                                "target_lang_sense_clarification": "свойственный определённой географической зоне"
                            },
                            {
                                "target_lang_word": "эндемический",
                                "target_lang_sense_clarification": "характерный только для данной местности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d24beb9-5f86-3685-ab9e-fe4d2b618208",
                    "sense_definition": "Regularly found or constantly present in a particular place or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prevalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poverty remains <w>endemic</w> in many rural communities.",
                            "target_lang_translations": {
                                "ru": "Бедность остаётся <w>хронической проблемой</w> во многих сельских общинах."
                            }
                        },
                        {
                            "text": "Corruption is <w>endemic</w> within the local government system.",
                            "target_lang_translations": {
                                "ru": "Коррупция носит <w>повальный характер</w> в системе местного самоуправления."
                            }
                        }
                    ],
                    "antonyms": [
                        "systemic"
                    ],
                    "common_phrases": [
                        "endemic in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно присутствующий, укоренившийся или повсеместно распространённый в определённом месте или среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повальный",
                                "target_lang_sense_clarification": "массово распространённый"
                            },
                            {
                                "target_lang_word": "хронический",
                                "target_lang_sense_clarification": "постоянно присутствующий, застарелый"
                            },
                            {
                                "target_lang_word": "эндемичный",
                                "target_lang_sense_clarification": "укоренившийся в конкретной среде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9526418-f729-340f-b46a-f310125053dd",
                    "sense_definition": "Originating from or belonging to a specific culture or area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geographic_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>endemic</w> traditions of the tribe are still practiced today.",
                            "target_lang_translations": {
                                "ru": "<w>Исконные</w> традиции этого племени соблюдаются и сегодня."
                            }
                        },
                        {
                            "text": "Scholars studied the <w>endemic</w> art forms of the region.",
                            "target_lang_translations": {
                                "ru": "Учёные исследовали <w>самобытные</w> формы искусства этого региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "native"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий из определённой культуры или местности; коренной, исконный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исконный",
                                "target_lang_sense_clarification": "коренной, изначально присущий"
                            },
                            {
                                "target_lang_word": "самобытный",
                                "target_lang_sense_clarification": "свойственный данной культуре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "625e31bd-031b-3be6-b759-79c49a573ae4",
                    "sense_definition": "A plant or animal species found only in a particular location.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geographic_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park protects several rare <w>endemics</w> found nowhere else.",
                            "target_lang_translations": {
                                "ru": "Парк защищает несколько редких видов-<w>эндемиков</w>, которые больше нигде не встречаются."
                            }
                        },
                        {
                            "text": "Conservationists focus on protecting local <w>endemics</w> from extinction.",
                            "target_lang_translations": {
                                "ru": "Специалисты по охране природы сосредоточены на защите местных <w>эндемиков</w> от вымирания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид растения или животного, обитающий исключительно в определённой географической области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эндемик",
                                "target_lang_sense_clarification": "вид с ограниченным ареалом обитания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "156b8b47-e881-34a9-949c-b83fa45e8433",
                    "sense_definition": "A disease that is constantly present in a specific population or region.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "prevalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The health organization works to control the <w>endemic</w> in the valley.",
                            "target_lang_translations": {
                                "ru": "Организация здравоохранения работает над сдерживанием <w>эндемического заболевания</w> в долине."
                            }
                        },
                        {
                            "text": "Malaria is a common <w>endemic</w> in this tropical climate.",
                            "target_lang_translations": {
                                "ru": "Малярия — распространённая <w>эндемическая болезнь</w> в этом тропическом климате."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезнь, постоянно присутствующая среди определённой группы населения или в конкретном регионе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эндемическое заболевание",
                                "target_lang_sense_clarification": "болезнь, привязанная к региону"
                            },
                            {
                                "target_lang_word": "эндемия",
                                "target_lang_sense_clarification": "постоянное распространение болезни в местности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}