                ],
                "senses": [
                    {
                        "sense_id": "0db16afe-b375-3d94-90ec-49f5d0fd0ddc",
                        "entry_id": "956b5d11-eab0-356a-ad69-4787c5bbb7c3",
                        "glosses": [
                            "bei Luftangriffen ausgelöster Alarm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f03826c-391d-4cbb-9fed-60de6e18b09d",
                                "sense_id": "0db16afe-b375-3d94-90ec-49f5d0fd0ddc",
                                "text": "„In den israelischen Städten im Umkreis des Gaza-Streifens blieb es in der Nacht zu Montag überwiegend ruhig. Am Morgen gab es jedoch in nahe gelegenen Ortschaften wieder Luftalarm.“"
                            },
                            {
                                "example_id": "fe6bff0b-3e96-4419-b7b4-c0d472eb0593",
                                "sense_id": "0db16afe-b375-3d94-90ec-49f5d0fd0ddc",
                                "text": "„Die Arbeit wurde nun immer häufiger durch Luftalarm unterbrochen.“"
                            },
                            {
                                "example_id": "17f0b2d3-19b0-4cba-b1c1-b0d22cbe755c",
                                "sense_id": "0db16afe-b375-3d94-90ec-49f5d0fd0ddc",
                                "text": "„Tatsächlich gab es auch zunehmend Freiburger, die während der Luftalarme nicht in Kellern verschwanden, sondern im Gegenteil auf die Dächer ihrer Häuser kletterten oder zu anderen Aussichtspunkten, um möglichst viel von den Angriffen mitzubekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
