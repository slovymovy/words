                "senses": [
                    {
                        "sense_id": "8aa10212-3dd9-3609-a8d5-541138956595",
                        "entry_id": "dbfa4f9a-d57d-3e59-a6dc-fadc29d08cc5",
                        "glosses": [
                            "der Prozess der allmählichen Reduktion einer therapeutischen Maßnahme, insbesondere der Medikamentendosis, zum Ende der Therapie hin, um Entzugserscheinungen gering zu halten"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "c032ee85-ee3a-4b27-ade6-10dd3c30e2d3",
                                "sense_id": "8aa10212-3dd9-3609-a8d5-541138956595",
                                "text": "Die Ausschleichung des Morphins ging über etliche Monate."
                            },
                            {
                                "example_id": "6aa3664d-6d49-406b-bacc-0307c1a25d19",
                                "sense_id": "8aa10212-3dd9-3609-a8d5-541138956595",
                                "text": "„Häufig ist dann mit einer überdauernden Besserung, auch nach Ausschleichung des Medikamentes, zu rechnen.“"
                            },
                            {
                                "example_id": "3e7aa9b1-eee7-491a-9023-03f8977703ff",
                                "sense_id": "8aa10212-3dd9-3609-a8d5-541138956595",
                                "text": "Ausschleichungen müssen immer unter ärztlicher Kontrolle erfolgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
