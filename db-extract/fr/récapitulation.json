                        "entry_id": "797cda6c-f3b0-3d17-8f4d-63d076e10ab3",
                        "glosses": [
                            "Action de récapituler ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a27261-f719-4dd8-b870-4bed5107e753",
                                "sense_id": "0dfd8696-a63f-3c16-a939-159b5059e373",
                                "text": "Il fit une courte récapitulation de tout ce qu’il avait dit."
                            },
                            {
                                "example_id": "995ca237-9104-47fd-bf67-71bdb8680cde",
                                "sense_id": "0dfd8696-a63f-3c16-a939-159b5059e373",
                                "text": "La récapitulation d’un compte."
                            },
                            {
                                "example_id": "29bae842-e4b9-45c4-ba48-fba34ea86b51",
                                "sense_id": "0dfd8696-a63f-3c16-a939-159b5059e373",
                                "text": "La récapitulation ne fait pourtant pas partie de la plupart des modèles présentés dans l’état de la littérature."
                            }
                        ]
                    }
                ],
