                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e9c27bc-f05c-3c38-aaeb-7c23fa513a93",
                        "entry_id": "5b0585b2-3e76-3d2c-9544-773a80ed7afd",
                        "glosses": [
                            "преисполненный сарказма, склонный к язвительным насмешкам, к едкой иронии; саркастический"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "364e2306-7b09-472b-a0a7-1db56331d7da",
                                "sense_id": "1e9c27bc-f05c-3c38-aaeb-7c23fa513a93",
                                "text": "Он мог быть и очень категоричным, порой суровым, саркастичным и даже грубым в своих суждениях о людях."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea443178-85b0-48c4-9910-a1ba9509a7a7",
                        "source_entry_id": "5b0585b2-3e76-3d2c-9544-773a80ed7afd",
                        "source_sense_id": "1e9c27bc-f05c-3c38-aaeb-7c23fa513a93",
                        "target_lang_word": "sarcastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                        "entry_id": "f58c542d-c25c-3a25-b634-4a854c049558",
                                        "glosses": [
                                            "Containing sarcasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c981ff-473d-47b0-8d2c-5bd62bb79b70",
                                                "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                                "text": "a sarcastic quip"
                                            },
                                            {
                                                "example_id": "a57b2844-4171-4508-a7ed-d1c676b141f7",
                                                "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                                "text": "the teacher's sarcastic tone"
                                            },
                                            {
                                                "example_id": "4eac1a89-0f85-4e08-9264-e53630a6bc2b",
                                                "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                                "text": "The unhappy Jew eyed their countenances and that of Front-de-Bœuf, in hope of discovering some symptoms of relenting; but that of the Baron exhibited the same cold, half-sullen, half-sarcastic smile which had been the prelude to his cruelty; […]"
                                            },
                                            {
                                                "example_id": "42677a9f-9ddf-416c-8f48-4d1100aa9896",
                                                "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                                "text": "The sarcastic bitterness of his conversation disgusted those who were more inclined to accuse his licentiousness than their own degeneracy, and who were unable to conceive the strength of those emotions which are concealed by the jests of the wretched, and by the follies of the wise."
                                            },
                                            {
                                                "example_id": "35cf6455-471d-44fd-9147-b3fe768620b9",
                                                "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                                "text": "He smiled to himself, and threw a glance of fine sarcastic meaning towards Hepzibah."
                                            },
                                            {
                                                "example_id": "8f763adc-399b-4318-9a0a-acf0d46a5966",
                                                "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                                                "text": "In men’s clubs such celebrations were, though expiring, less uncommon; but either the natural shyness of the softer sex, or a sarcastic attitude on the part of male relatives, had denuded such women’s clubs as remained (if any other did) or this their glory and consummation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07ce718d-d7a8-378f-b8b6-dbb7a675dc72",
                                        "entry_id": "f58c542d-c25c-3a25-b634-4a854c049558",
                                        "glosses": [
                                            "Having the personality trait of expressing sarcasm."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a0fa77-e840-4ce4-99a3-0ade59fb77ba",
                                                "sense_id": "07ce718d-d7a8-378f-b8b6-dbb7a675dc72",
                                                "text": "Her eyes slanted a little... and were sometimes full of fiery determination and sometimes dull and opaque. Her expression was never altogether amiable; was often, indeed, distinctly sullen, or, when she was animated, sarcastic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67d4bca6-c81e-44b8-9be6-61a250566ace",
                        "source_entry_id": "5b0585b2-3e76-3d2c-9544-773a80ed7afd",
                        "source_sense_id": "1e9c27bc-f05c-3c38-aaeb-7c23fa513a93",
