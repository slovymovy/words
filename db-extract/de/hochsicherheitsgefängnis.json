                "senses": [
                    {
                        "sense_id": "8f5dc2df-9842-3707-8f08-9931c5b3527e",
                        "entry_id": "c2d66f28-e0bd-3716-9b86-03ccd9397308",
                        "glosses": [
                            "Haftanstalt mit besonders hohen Sicherheitsvorkehrungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94572332-2121-42ae-bd24-e01271db35d6",
                                "sense_id": "8f5dc2df-9842-3707-8f08-9931c5b3527e",
                                "text": "„Ab 1933 lebte Stroud in ständiger Furcht, in ein geplantes neues Hochsicherheitsgefängnis verlegt zu werden.“"
                            },
                            {
                                "example_id": "bec7a63d-9902-47c8-bdc0-866f2b1224c0",
                                "sense_id": "8f5dc2df-9842-3707-8f08-9931c5b3527e",
                                "text": "„Am 8. November 1965, als die Vorbereitungen für die drei Tage später tatsächlich erfolgende einseitige Unabhängigkeitserklärung auf Hochtouren liefen, ließ das Regime diejenigen Gefangenen, die es für die gefährlichsten hielt, unter ihnen Robert Mugabe, ins Hochsicherheitsgefängnis in Salisbury verlegen.“"
                            }
                        ],
