                    }
                ],
                "senses": [
                    {
                        "sense_id": "087c3742-2209-3c0c-b4d0-9eb8795a7a01",
                        "entry_id": "dd725705-9229-3a3f-adbf-9e0fb6f0d6f0",
                        "glosses": [
                            "потерять имеющееся (всё или многое)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5e7e795-3a53-3baf-bdf7-3e88e15c7225",
                        "entry_id": "dd725705-9229-3a3f-adbf-9e0fb6f0d6f0",
                        "glosses": [
                            "постепенно лишиться кого-либо или чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8115efd9-1a9e-46f5-8b3b-388e120ec36f",
                        "source_entry_id": "dd725705-9229-3a3f-adbf-9e0fb6f0d6f0",
                        "target_lang_word": "lose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease to have (something) in one's possession or capability."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711a2261-e18d-4af2-828d-75ed2e468ea2",
                                                "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                                "text": "If you lose that ten-pound note, you'll be sorry."
                                            },
                                            {
                                                "example_id": "7e6aa2c2-22d1-4a0e-8656-ed9fba250013",
                                                "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                                "text": "He lost his hearing in the explosion."
                                            },
                                            {
                                                "example_id": "37b99b3c-ec14-48e2-ad42-e73635f68f02",
                                                "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                                "text": "She lost her position when the company was taken over."
                                            },
                                            {
                                                "example_id": "47a1ee0a-b2e3-42d8-8a00-9bebf7ef319f",
                                                "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "eb5a4b39-b153-4504-86db-407ffa0bae4f",
                                                "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                                "text": "Douglas: I took some of the pension money out of the bank and I lost it on a horse.\nNolan: Gambling with our employees' pensions?\nDouglas: Gambling? No. I was riding the horse. It fell out of my pocket."
                                            },
                                            {
                                                "example_id": "3dac04a1-b9d0-4875-b9e8-07a03c804efc",
                                                "sense_id": "dc6b1e46-eb04-3cb4-a745-18c0c70eaf91",
                                                "text": "Forest, who lost striker Kris Boyd to injury seconds before half-time, produced little after the break, with a Tyson sliced shot from 12 yards their only opportunity of note."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fd64e6-8c3e-3212-8be4-5afdc032b2d9",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease to have (something) in one's possession or capability.",
                                            "To have (an organ) removed from one's body, especially by accident."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf74b6bb-97ef-469b-a9be-c8f8ec632ec1",
                                                "sense_id": "61fd64e6-8c3e-3212-8be4-5afdc032b2d9",
                                                "text": "Johnny lost a tooth, but kept it for the tooth fairy."
                                            },
                                            {
                                                "example_id": "9a3c98f9-7a0d-4387-8605-f3ae7c8bfb4d",
                                                "sense_id": "61fd64e6-8c3e-3212-8be4-5afdc032b2d9",
                                                "text": "He lost his spleen in a car wreck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e5b3253-8740-3195-93ae-e3b9fe80a205",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease to have (something) in one's possession or capability.",
                                            "To shed (weight)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9442c549-fb09-4d71-9267-446f20c2d8ec",
                                                "sense_id": "8e5b3253-8740-3195-93ae-e3b9fe80a205",
                                                "text": "I’ve lost five pounds this week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9160af3a-60d8-3f90-a064-8f6ec4bfb9de",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease to have (something) in one's possession or capability.",
                                            "To experience the death of (someone to whom one has an attachment, such as a relative or friend)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c295544a-1dfb-4ac0-83ee-cfcf4b30adf6",
                                                "sense_id": "9160af3a-60d8-3f90-a064-8f6ec4bfb9de",
                                                "text": "She lost all her sons in the war."
                                            },
                                            {
                                                "example_id": "b3facd97-29cd-4d1e-b839-701db595be62",
                                                "sense_id": "9160af3a-60d8-3f90-a064-8f6ec4bfb9de",
                                                "text": "I hold it true, whate’er befall;\n⁠I feel it, when I sorrow most;\n⁠’Tis better to have loved and lost\nThan never to have loved at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae74ad4-0342-3759-ba44-895ae47d5cd4",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease to have (something) in one's possession or capability.",
                                            "To pay or owe (some wager) due from an unsuccessful bet or gamble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e3b5ca9-04df-422d-aef4-23be12b2c1e4",
                                                "sense_id": "0ae74ad4-0342-3759-ba44-895ae47d5cd4",
                                                "text": "Frank had lost $500 staying in Vegas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8a3cd9-03d2-38c8-a239-a09139ac59e9",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease to have (something) in one's possession or capability.",
                                            "To be deprived of (some right or privileged access to something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d3c691b-521a-48e4-a949-f7c07f949eec",
                                                "sense_id": "fa8a3cd9-03d2-38c8-a239-a09139ac59e9",
                                                "text": "Users who engage in disruptive behavior may lose their accounts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2722919a-e70e-3392-838b-52a5229c2f17",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To wander from; to miss, so as not to be able to find; to go astray from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c4ab8b-577e-4601-9ff3-bc7b9b1f270a",
                                                "sense_id": "2722919a-e70e-3392-838b-52a5229c2f17",
                                                "text": "He hath lost his fellows."
                                            },
                                            {
                                                "example_id": "4451210b-2471-41d5-943e-6ac0cb5095e5",
                                                "sense_id": "2722919a-e70e-3392-838b-52a5229c2f17",
                                                "text": "I lost my way in the forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81883022-9073-38cf-b09c-f8c18a8f9720",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To become a defeated competitor in (a game, competition, trial, etc)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c918d99-2def-47d9-9496-abf52599e939",
                                                "sense_id": "81883022-9073-38cf-b09c-f8c18a8f9720",
                                                "text": "I fought the battle bravely which I lost, / And lost it but to Macedonians."
                                            },
                                            {
                                                "example_id": "0f9b3138-522f-479b-9363-330b16915352",
                                                "sense_id": "81883022-9073-38cf-b09c-f8c18a8f9720",
                                                "text": "We lost the football match."
                                            },
                                            {
                                                "example_id": "8f1e451c-588c-4342-ad02-29d56df8205e",
                                                "sense_id": "81883022-9073-38cf-b09c-f8c18a8f9720",
                                                "text": "You just lost The Game."
                                            },
                                            {
                                                "example_id": "6f0a60a2-fa97-4c65-a514-4a6ebc429290",
                                                "sense_id": "81883022-9073-38cf-b09c-f8c18a8f9720",
                                                "text": "Well, some news from overseas: according to a new report, Russia is now buying military supplies from North Korea. Yep, Russia's asking North Korea for help. Uh, tell us you're losing the war without telling us you're losing the war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2622a9c-b756-3304-b796-5331a9be9c33",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To be defeated (in a game, competition, contest, etc.)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaeec10a-fdd7-4ff7-97ab-e38af15270e8",
                                                "sense_id": "d2622a9c-b756-3304-b796-5331a9be9c33",
                                                "text": "The team scored four goals but still managed to lose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b63910f4-ecfe-3a6b-a04e-1b0cba248dc5",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To be unable to follow or trace (somebody or something) any longer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bbeb41e-6e83-44d9-8d70-d652ac10f502",
                                                "sense_id": "b63910f4-ecfe-3a6b-a04e-1b0cba248dc5",
                                                "text": "The policeman lost the robber he was chasing."
                                            },
                                            {
                                                "example_id": "56218fe9-ce8c-4f7c-aef0-3858a60d5fff",
                                                "sense_id": "b63910f4-ecfe-3a6b-a04e-1b0cba248dc5",
                                                "text": "Mission control lost the satellite as its signal died down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f60918-fa56-339b-99ba-50f5c7c310ba",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cause (somebody) to be unable to follow or trace one any longer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799def5f-f777-497f-908f-cc3e3edb4b30",
                                                "sense_id": "18f60918-fa56-339b-99ba-50f5c7c310ba",
                                                "text": "lose the cops"
                                            },
                                            {
                                                "example_id": "8b6aae3b-c39f-4557-b4c0-89a4af0c6daf",
                                                "sense_id": "18f60918-fa56-339b-99ba-50f5c7c310ba",
                                                "text": "We managed to lose our pursuers in the forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813db94f-4e95-32c4-b229-8f99f531e929",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cease exhibiting; to overcome (a behavior or emotion)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd603796-37a2-49c6-8102-6f29c6a12562",
                                                "sense_id": "813db94f-4e95-32c4-b229-8f99f531e929",
                                                "text": "I can see Mickie getting hot, I'm about to grab his arm, hold him back, say, Whoa, whoa, Mick, not here, it ain't worth it what happened inside just now. But I don't need to because Mickie loses his anger, starts smiling at ponytail, then melodramatically starts looking around at the men and women on the street going in and out of the courthouse."
                                            },
                                            {
                                                "example_id": "072e57c2-9f90-45ee-9ef3-7c1c289454e8",
                                                "sense_id": "813db94f-4e95-32c4-b229-8f99f531e929",
                                                "text": "Her attitude was so bad my mother wound up telling her, “You know we really don't have to be standing here talking to you, so you can lose the attitude or you can leave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155fafa7-874d-3f5e-a863-05d12c8142dc",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To shed, remove, discard, or eliminate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8541f953-316b-47ae-89ff-d90adbb3cc4d",
                                                "sense_id": "155fafa7-874d-3f5e-a863-05d12c8142dc",
                                                "text": "When we get into the building, please lose the hat."
                                            },
                                            {
                                                "example_id": "cc00342a-2440-4b23-8e37-dac1590494a2",
                                                "sense_id": "155fafa7-874d-3f5e-a863-05d12c8142dc",
                                                "text": "You can bet that the next woman who \"loses\" the top half of her bikini at the beach was born under the sign of Libra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "389b650b-5675-3101-8ded-91de2c8c82cd",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "Of a clock, to run slower than expected."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6de99652-1232-4b7d-b608-49aa85fd3f48",
                                                "sense_id": "389b650b-5675-3101-8ded-91de2c8c82cd",
                                                "text": "My watch loses five minutes a week."
                                            },
                                            {
                                                "example_id": "745ec654-5d71-4ed3-8349-1c6a80c37908",
                                                "sense_id": "389b650b-5675-3101-8ded-91de2c8c82cd",
                                                "text": "It's already 5:30? My watch must have lost a few minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68fd90b9-3dc3-3dda-b1cb-b2ae1a37bd22",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To cause (someone) the loss of something; to deprive of."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d12175e-25b2-4a3a-8c3c-a05089515c2c",
                                                "sense_id": "68fd90b9-3dc3-3dda-b1cb-b2ae1a37bd22",
                                                "text": "O false heart! thou hadst almost betrayed me to eternal flames, and lost me this glory."
                                            },
                                            {
                                                "example_id": "4b0fd63b-5aeb-4d53-9d9b-15c87ee16682",
                                                "sense_id": "68fd90b9-3dc3-3dda-b1cb-b2ae1a37bd22",
                                                "text": "a. 1699, Sir William Temple, 1st Baronet, On the Excesses of Grief\nHow should you go about to lose him a wife he loves with so much passion?"
                                            },
                                            {
                                                "example_id": "5354af18-21a9-4e06-b3c0-1dba7dd36bec",
                                                "sense_id": "68fd90b9-3dc3-3dda-b1cb-b2ae1a37bd22",
                                                "text": "This lost Catholicism […] any semblance of a claim to special status, and also highlighted the gains which other religious formations had derived from the Revolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e772e0-809b-39a6-9ed1-6a30020fb6d7",
                                        "entry_id": "ddd3e93d-e43b-3d28-a6ba-1eee9ee1c4b4",
                                        "glosses": [
                                            "To fail to catch with the mind or senses; to miss."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab0882f-4640-4f29-a748-1da65ad7f7aa",
                                                "sense_id": "76e772e0-809b-39a6-9ed1-6a30020fb6d7",
                                                "text": "I lost a part of what he said."
                                            }
                                        ]
                                    }
                                ]
