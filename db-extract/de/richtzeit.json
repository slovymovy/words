                "senses": [
                    {
                        "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                        "entry_id": "e31dd5f0-ef94-3807-bcba-846ecceee3ce",
                        "glosses": [
                            "zeitliche Vorgabe, an der sich jemand oder etwas orientieren kann; deren Einhaltung angestrebt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f85ab9-8b86-4a6d-9da2-fad1e8612fbf",
                                "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                                "text": "„Das ist die erste Richtzeit im Otodrom im asiatischen Teil Istanbuls, nämlich die Beste der zwei freien Trainings am Freitag.“"
                            },
                            {
                                "example_id": "067da3a9-9220-41b3-831e-3d0c665f5804",
                                "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                                "text": "„Bei bedecktem Himmel setzte Mayer trotz seiner beherzten Fahrt eine Richtzeit, die schon Kriechmayr klar unterbot.“"
                            },
                            {
                                "example_id": "3c0847b2-f721-4306-bdc4-caba6b8bead6",
                                "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                                "text": "„Dieser hatte nur die Schultern hochgezogen, als einer nach dem anderen an seiner Richtzeit gescheitert war.“"
                            },
                            {
                                "example_id": "8bb63959-0bf6-43f9-b9d4-c65a1dfe1783",
                                "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                                "text": "„Anschliessend gehts in den auf 100 Grad vorgeheizten Backofen. Die Richtzeit für die Garstufe medium beträgt auf diese Weise acht Minuten.“"
                            },
                            {
                                "example_id": "d640e0de-dfee-4a44-b10e-da868780217a",
                                "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                                "text": "„Dabei wird sich die Bank-Hälfte in der Filiale dem Postbereich in puncto Öffnungszeiten anpassen, 18 Uhr gilt als Richtzeit.“"
                            },
                            {
                                "example_id": "50d50096-7323-4aeb-846a-238084549042",
                                "sense_id": "62681a13-b9e4-3295-933d-a718ec439092",
                                "text": "„Die Richtzeit für den Motorumbau wird mit circa acht Stunden veranschlagt, für die Arbeiten am Antriebsstrang sind etwa 1,6 Stunden zu kalkulieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
