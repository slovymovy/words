                                                "sense_id": "484b79d8-bdbd-3824-b7d5-62796ec64d45",
                                                "text": "Donner du talus à un terrain."
                                            },
                                            {
                                                "example_id": "6380db76-fccd-403d-a56e-32fa20f624a5",
                                                "sense_id": "484b79d8-bdbd-3824-b7d5-62796ec64d45",
                                                "text": "Les colonnes maya aux angles taillés en talus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb02c4f-f3ca-3790-afc8-1c5754bcb08e",
                                        "entry_id": "36dd5995-cc73-3535-9f9c-12ff6bb32ba4",
                                        "glosses": [
                                            "Façon de couper, de tailler ou de scier obliquement, en biseau ou en sifflet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c773d402-b254-45d9-9690-0f256b2e1782",
                                                "sense_id": "3fb02c4f-f3ca-3790-afc8-1c5754bcb08e",
                                                "text": "Tailler une pierre en talus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87b3c16c-1d4a-3aa8-8fd8-2bd3d78861ac",
                                        "entry_id": "36dd5995-cc73-3535-9f9c-12ff6bb32ba4",
                                        "glosses": [
                                            "Portion de terrain formant une pente inclinée, aménagé par des travaux de terrassement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb228da0-d3da-4c41-962c-f10024b9ee45",
                                                "sense_id": "87b3c16c-1d4a-3aa8-8fd8-2bd3d78861ac",
                                                "text": "Aussi les paysagistes sont-ils présents pour apporter la touche finale à la route par la végétalisation des talus et des belvédères, assurant ainsi la cicatrisation des emprises routières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f008ed8-9803-3221-b12a-2bbe8220d8d8",
                                        "entry_id": "36dd5995-cc73-3535-9f9c-12ff6bb32ba4",
                                        "glosses": [
                                            "Portion de terrain localement surélevée et souvent végétalisée pour en stabiliser la terre, utilisée comme séparation entre les parcelles dans les bocages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3aa703-b000-42f5-9b73-3dbf227f7c4c",
                                                "sense_id": "9f008ed8-9803-3221-b12a-2bbe8220d8d8",
                                                "text": "Une vache qui paissait l’herbe abroutie du talus, leva son mufle vers lui…"
                                            },
                                            {
                                                "example_id": "1d2f078c-a35f-4ffe-9b3a-e198389398ff",
                                                "sense_id": "9f008ed8-9803-3221-b12a-2bbe8220d8d8",
                                                "text": "Le remembrement a provoqué l’arasement des talus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecde2024-5efc-324e-810d-a353dde1087a",
                                        "entry_id": "36dd5995-cc73-3535-9f9c-12ff6bb32ba4",
                                        "glosses": [
                                            "Terme utilisé pour décrire un mouvement de terrain en pente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab65d9d9-0186-4953-93ae-3e2fc811a8b5",
                                                "sense_id": "ecde2024-5efc-324e-810d-a353dde1087a",
                                                "text": "Talus d’éboulis."
                                            },
                                            {
                                                "example_id": "64c8f28e-5c79-499e-a11b-645927565461",
                                                "sense_id": "ecde2024-5efc-324e-810d-a353dde1087a",
                                                "text": "Talus continental."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe779181-cbc6-3770-937b-09be3d613e32",
                                        "entry_id": "36dd5995-cc73-3535-9f9c-12ff6bb32ba4",
                                        "glosses": [
                                            "Espace, sur la surface d’œil d’un caractère, entre la partie supérieure de l’œil et le bord supérieur du caractère (talus de tête) ; entre la partie inférieure de l’œil et le bord inférieur du caractère (talus de pied)."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    }
                                ]
