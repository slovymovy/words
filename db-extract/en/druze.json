                                "target_senses": [
                                    {
                                        "sense_id": "fb95d330-a3a6-30bc-bbbc-ba660e0e2192",
                                        "entry_id": "60baa01f-0e01-39d4-80a2-2ebf82e02441",
                                        "glosses": [
                                            "Angehöriger einer im Nahen Osten ansässigen Religionsgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070c0111-a710-447d-8b10-408576a8132a",
                                                "sense_id": "fb95d330-a3a6-30bc-bbbc-ba660e0e2192",
                                                "text": "Als ein Druse der Gemeinschaft durfte er keine dementsprechenden Angelegenheiten versäumen."
                                            },
                                            {
                                                "example_id": "159f3956-5688-4cb8-ac4c-585da0916a4a",
                                                "sense_id": "fb95d330-a3a6-30bc-bbbc-ba660e0e2192",
                                                "text": "„Das einzige Land, in dem die Drusen eine größere politische Rolle spielen, ist der Libanon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Druse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a92aeb9a-dca9-3a90-90a2-82a8608201e0",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "kristallgefüllte Gesteinshohlkugel"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3dfe603-5ae3-4b56-8a79-de9c4b6e7567",
                                                "sense_id": "a92aeb9a-dca9-3a90-90a2-82a8608201e0",
                                                "text": "Die Druse wurde aufgemeißelt, und offenbarte dem Geologen seine einst verborgene, glimmernde Kristalle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34a88a29-0411-3e1c-bf84-aa13cde2961e",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "infektiöse Pferdekrankheit"
                                        ],
                                        "tags": [
                                            "Tierheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769b0f56-fba6-4f59-91c3-50206223c082",
                                                "sense_id": "34a88a29-0411-3e1c-bf84-aa13cde2961e",
                                                "text": "Druse ist eine durch das Bakterium Streptococcus equi hervorgerufene Infektionskrankheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ed525fe-40c8-3474-ae2c-28bc4fef8f03",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "sich in einem Behältnis nach der Gärung von Wein oder Bier als Bodensatz abgesetzte Trubstoffe"
                                        ],
                                        "tags": [
