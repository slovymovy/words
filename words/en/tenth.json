                                "ru": "Крестьяне были обязаны платить церкви <w>десятину</w> от своего урожая.",
                                "zh": "农民们被要求向教会缴纳收获物的<w>什一税</w>。"
                            }
                        },
                        {
                            "text": "Parliament granted a <w>tenth</w> to the king to support the war.",
                            "target_lang_translations": {
                                "ru": "Парламент предоставил королю <w>десятину</w> для поддержки войны.",
                                "zh": "议会批准向国王征收<w>什一税</w>以支持战争。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tithe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Налог или взнос, составляющий одну десятую часть личного имущества или продукции.",
                        "zh": "一种古代税收或捐献，指个人财产或产出的十分之一。"
                    },
                    "translations": {
