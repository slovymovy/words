                                                "example_id": "ca868bbe-eaa5-402f-8288-852a0c865463",
                                                "sense_id": "1ab6429f-fc17-312d-82bb-73d9c6dd1579",
                                                "text": "„In Deutschland ist der Baptismus seit 1834 vertreten.“"
                                            },
