                        "entry_id": "1569b3bd-ba84-357f-8c1a-239e4d6e8566",
                        "glosses": [
                            "Either of two species of bird of the genus Pyrrhocorax in the crow family Corvidae that breed mainly in high mountains and on coastal sea cliffs of Eurasia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5176856a-e9cb-4717-8350-c1f6a74109c0",
                                "sense_id": "93adff9e-93f9-3d64-af1b-7a5f69ce3246",
                                "text": "For parot is no churlish Chowgh / nor no f[l]ekyd pye"
                            }
                        ]
