            {
                "entry_id": "dfc20501-7a10-3d74-b94b-cf555e8500dd",
                "word": "racli",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7fb70e4-039d-4a7f-ba78-b4f2c4a24789",
                        "entry_id": "dfc20501-7a10-3d74-b94b-cf555e8500dd",
                        "tags": [
