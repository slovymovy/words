                ],
                "senses": [
                    {
                        "sense_id": "d97ed1f8-b412-35ea-93e8-7950ae7349ac",
                        "entry_id": "78001f52-7cf5-399c-9fff-0843bf724bbc",
                        "glosses": [
                            "laatste deel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e72cba6-15c0-4305-91e1-8e1261b0da6e",
                                "sense_id": "d97ed1f8-b412-35ea-93e8-7950ae7349ac",
                                "text": "Déroche’s grote bijdrage is dat hij het voorstuk, middenstuk en eindstuk heeft gevonden van een vroege Koran: de Codex Parisino-petropolitanus, zo genoemd omdat de delen worden bewaard in Parijs en Petersburg."
                            },
                            {
                                "example_id": "c3f83480-7cf7-4b4b-a91a-d37ce10038c2",
                                "sense_id": "d97ed1f8-b412-35ea-93e8-7950ae7349ac",
                                "text": "Pas wanneer we een groter eindstuk van twee woorden gelijk maken (vanaf, en inclusief, de klinker(-klank) in de laatste beklemtoonde lettergreep) horen we het. We spreken dan van eindrijm, of kortweg rijm."
                            }
                        ]
                    },
                    {
                        "sense_id": "307dd20f-337a-3e3f-99de-bcb1e8eabf23",
                        "entry_id": "78001f52-7cf5-399c-9fff-0843bf724bbc",
                        "glosses": [
                            "uiterste deel van een groter geheel, onderdeel dat aan een uiteinde wordt bevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c23a67a-aa09-4460-95f8-8c0e153f21ae",
                                "sense_id": "307dd20f-337a-3e3f-99de-bcb1e8eabf23",
                                "text": "Het aangezicht van de bumpers is ook veranderd: eindstukken van kunststof beschermen thans ook de zijkanten van de; wagen."
                            },
                            {
                                "example_id": "b44784a8-0ce9-4221-a1f4-9d89dd557548",
                                "sense_id": "307dd20f-337a-3e3f-99de-bcb1e8eabf23",
                                "text": "Zij prikkelen echter niet slechts dit eindstuk van de urineorganen, maar ook de blaas en, wat nog bedenkelijker is, de nieren, en dat wel dermate, dat gevaarlijke [n]ierontstekingen kunnen ontstaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "8943da7d-1ee5-3f37-b5d5-9c6f5229beb0",
                        "entry_id": "78001f52-7cf5-399c-9fff-0843bf724bbc",
                        "glosses": [
                            "document gemaakt als afsluiting van werkzaamheden"
                        ],
                        "tags": [
                            "vaak in meervoudsvorm"
                        ],
                        "examples": [
                            {
                                "example_id": "8c9fad42-9b58-4f96-bcce-7243d975b74e",
                                "sense_id": "8943da7d-1ee5-3f37-b5d5-9c6f5229beb0",
                                "text": "Het is echter wel zeer onwaarschijnlijk dat De Koning in zijn eindstukken een precieze verdeling van de kabinetsposten zal opnemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "005c1f20-4596-313c-a8c6-1a42bf7fc946",
                        "entry_id": "78001f52-7cf5-399c-9fff-0843bf724bbc",
                        "glosses": [
                            "toneelstuk of musical dat als feestelijke afsluiting van (een deel van) een opleiding wordt opgevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9079c10f-9f7a-43d6-9b6d-c99b93942b35",
                                "sense_id": "005c1f20-4596-313c-a8c6-1a42bf7fc946",
                                "text": "Zoals jullie weten, gaan we dit jaar een eindstuk opvoeren. Jullie zitten op een musicalopleiding."
                            }
                        ]
                    }
                ],
