                        "товар лицом"
                    ],
                    "target_lang_definitions": {
                        "en": "The front, upper, or outer side of an object, building, or fabric.",
                        "zh": "物体、建筑物或织物的正面、上表面或外侧。"
                    },
                    "translations": {
                        "en": [
