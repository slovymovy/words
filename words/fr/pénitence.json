    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a41b6185-074b-3412-b4a4-0834698986c5",
                    "sense_definition": "Punition ou peine imposée à quelqu'un en réparation d'une faute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "punition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'instituteur a infligé une lourde <w>pénitence</w> à l'élève qui n'avait pas fait ses devoirs."
                        },
                        {
                            "text": "Le jeune garçon a dû rester dans sa chambre en guise de <w>pénitence</w>."
                        }
                    ],
                    "synonyms": [
                        "punition",
                        "châtiment",
                        "sanction"
                    ],
                    "antonyms": [
                        "récompense"
                    ],
                    "common_phrases": [
                        "infliger une pénitence",
                        "subir une pénitence"
                    ]
                },
                {
                    "sense_id": "5ffe43ab-4554-3b7e-a746-130faf66a02c",
                    "sense_definition": "Prière ou acte d'expiation prescrit par un confesseur pour effacer les péchés avoués.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la confession, le prêtre lui a prescrit une courte <w>pénitence</w> à réciter à l'église."
                        },
                        {
                            "text": "Elle a promis d'accomplir sa <w>pénitence</w> dès la fin de l'office religieux."
                        }
                    ],
                    "common_phrases": [
                        "faire sa pénitence",
                        "accomplir sa pénitence",
                        "donner une pénitence"
                    ]
                },
                {
                    "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                    "sense_definition": "Regret sincère d'avoir commis une faute, particulièrement envers Dieu, accompagné de la volonté d'expier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fidèle a exprimé une sincère <w>pénitence</w> pour ses manquements passés."
                        },
                        {
                            "text": "La période du carême invite chacun à la prière et à la <w>pénitence</w>."
                        }
                    ],
                    "synonyms": [
                        "repentir",
                        "contrition",
                        "expiation"
                    ],
                    "antonyms": [
                        "impénitence"
                    ],
                    "common_phrases": [
                        "sacrement de pénitence",
                        "temps de pénitence"
                    ]
                },
                {
                    "sense_id": "c2441616-8efc-3bb3-b755-80fa510200a7",
                    "sense_definition": "Gage ou petite épreuve imposée à un joueur ayant commis une faute ou perdu une manche.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour sa <w>pénitence</w>, le joueur a dû chanter une chanson devant tous ses amis."
                        },
                        {
                            "text": "Les enfants ont inventé une drôle de <w>pénitence</w> pour celui qui ferait tomber la balle."
                        }
                    ],
                    "synonyms": [
                        "gage"
                    ]
                },
                {
                    "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                    "sense_definition": "Austérités ou privations que l'on s'impose volontairement pour racheter ses fautes ou erreurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moine a choisi de vivre dans la <w>pénitence</w> et la solitude jusqu'à la fin de ses jours."
                        },
                        {
                            "text": "Il a commis de graves erreurs professionnelles et en fait désormais <w>pénitence</w>."
                        }
                    ],
                    "synonyms": [
                        "mortification"
                    ],
                    "common_phrases": [
                        "faire pénitence",
                        "vivre dans la pénitence"
                    ]
                },
                {
                    "sense_id": "3609a0b2-d431-36b4-9d1a-d387e12ae2bd",
                    "sense_definition": "Repas particulièrement frugal ou maigre, souvent imposé par les circonstances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le réfrigérateur étant vide, nous avons dû faire <w>pénitence</w> avec un simple morceau de pain."
                        },
                        {
                            "text": "Si vous restez dîner ce soir sans prévenir, vous ferez <w>pénitence</w> avec nous."
                        }
                    ],
                    "common_phrases": [
                        "faire pénitence"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé principalement dans l'expression familière faire pénitence"
                        }
                    ]
                }
            ]
        }
