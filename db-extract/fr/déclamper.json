                "senses": [
                    {
                        "sense_id": "1985ce8b-fba6-38a2-8bf6-2bbba3b413ef",
                        "entry_id": "89343a41-c25d-3477-8ac3-d926d89faa14",
                        "glosses": [
                            "Desserrer des clamps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4618193d-20ae-4301-b901-74aeee1b041b",
                                "sense_id": "1985ce8b-fba6-38a2-8bf6-2bbba3b413ef",
                                "text": "Les sutures sont terminées et il s’apprête à déclamper l’aorte."
                            },
                            {
                                "example_id": "0a073f51-cb8d-4364-a93d-6b21676643f3",
                                "sense_id": "1985ce8b-fba6-38a2-8bf6-2bbba3b413ef",
                                "text": "La seule précaution que nous ayons encore prise a été de ne pas nouer les fils de suture avant de déclamper l’aorte pour permettre de contrôler s’il y avait un bloc ou non."
                            },
                            {
                                "example_id": "7796fdde-d0aa-4510-9c08-c18cdb93b987",
                                "sense_id": "1985ce8b-fba6-38a2-8bf6-2bbba3b413ef",
                                "text": "Déclamper le flacon stérile puis desserrer doucement la pince afin d’éviter une aspiration brutale au niveau des plaies."
                            }
                        ]
                    }
