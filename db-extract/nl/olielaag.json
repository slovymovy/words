                        "entry_id": "28533a8c-0d4e-35e9-a179-e9fcf1564f08",
                        "glosses": [
                            "aardolie houdende aardlaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0498fb6-8f13-4db2-9317-4e7a71caf2ca",
                                "sense_id": "0b41efec-8c3e-3bf0-9c2b-1a4c9900b863",
                                "text": "Bij de eerste proefboring werd een olielaag van zo'n 162 meter ontdekt. Bij een verdere boring tot een diepte van bijna 8 kilometer werd een olielaag van circa 116 meter gevonden. Voor de rest van het jaar staan nog een paar boringen op het programma."
                            }
                        ]
