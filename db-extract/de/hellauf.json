        "de-extract.jsonl": [
            {
                "entry_id": "69189184-32fc-328e-b8b5-11ecf28d53e2",
                "word": "hellauf",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                        "entry_id": "69189184-32fc-328e-b8b5-11ecf28d53e2",
                        "glosses": [
                            "frei heraus und spontan, sehr, überaus"
                        ],
                        "tags": [
                            "oftmals mit einem positiven",
                            "verstärkenden Beiklang"
                        ],
                        "examples": [
                            {
                                "example_id": "9c633c79-5a46-4fd4-8296-648d857c5c59",
                                "sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                                "text": "Ich bin hellauf begeistert."
                            },
                            {
                                "example_id": "28b1a7f2-d32f-4d66-8c22-30f8a249357e",
                                "sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                                "text": "Er lachte hellauf."
                            },
                            {
                                "example_id": "d0810d8f-d32b-47ae-b687-4936df302339",
                                "sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                                "text": "„Die Apothekersgattin lacht hellauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fc6a050-29ac-440d-be56-76fe7c537e33",
                        "source_entry_id": "69189184-32fc-328e-b8b5-11ecf28d53e2",
                        "source_sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                        "source_sense_description": "frei heraus und spontan, oftmals mit einem positiven, verstärkenden Beiklang: sehr, überaus",
                        "target_lang_word": "very",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "very",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                        "entry_id": "cf004d53-c914-3827-b7ea-8c4a0158448b",
                                        "glosses": [
                                            "True, real, actual."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b3c3f2-c47b-4bb5-82d7-7d13f01354f5",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "The fierce hatred of a very woman."
                                            },
                                            {
                                                "example_id": "5eb879c3-80ae-4112-b3b7-f137e44918cc",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "The very blood and bone of our grammar."
                                            },
                                            {
                                                "example_id": "2dc0ef78-206d-4629-baf8-bb15a5dbc157",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "He tried his very best."
                                            },
                                            {
                                                "example_id": "f5011e0b-fced-48af-813d-ac1d90f9d732",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "We're approaching the very end of the trip."
                                            },
                                            {
                                                "example_id": "31ff662b-e427-41b0-a819-b909d8f1fd56",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "The very man I wanted to see!"
                                            },
                                            {
                                                "example_id": "70686257-c371-4f01-a566-87b38212c194",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "Look, these tablets are the very thing for your cold."
                                            },
                                            {
                                                "example_id": "8b177854-55e2-482b-8108-b58545cbdb74",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "[…] I am the veriest varlet that ever chewed with a tooth."
                                            },
                                            {
                                                "example_id": "78ffc89a-3fc1-4cba-8cae-c806e0034463",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "And Isaac said unto Jacob, Come near, I pray thee, that I may feel thee, my son, whether thou be my very son Esau or not."
                                            },
                                            {
                                                "example_id": "06f6a0ac-7f62-420f-8b12-5aa4cd909c67",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "The very essence of truth is plainnesse, and brightnes; the darknes and crookednesse is our own."
                                            },
                                            {
                                                "example_id": "bafbe144-219e-4683-a6d4-6fb1235932fa",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "1659, Henry Hammond, A Paraphrase and Annotations upon All the Books of the New Testament, London: Richard Davis, 2nd edition, The First Epistle of Paul the Apostle to the Corinthians, Chapter 3, verse 19, p. 517,\n[…] they that think to be wiser then other men, are by so much verier fools then others, and so are discerned to be."
                                            },
                                            {
                                                "example_id": "9ecd935d-5b93-498f-ab9a-465b41b079a3",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "I looked on the consideration of publick service, or publick ornament, to be real and very justice: and I ever held, a scanty and penurious justice to partake of the nature of a wrong."
                                            },
                                            {
                                                "example_id": "9317f346-d832-4884-aa7d-315833bf1056",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "[…] : he has become a very democrat. He disdains not to be seen in the back-parlour of the petty tradesman, or the cleanly cottage of the intelligent mechanic. He raises his voice in the cause of progress; […]"
                                            },
                                            {
                                                "example_id": "4feb4e2b-a906-4d82-a289-4562ef64655b",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "‘Thou seest after all I am a very woman.’"
                                            },
                                            {
                                                "example_id": "6170cbe2-91ec-4ecb-af3a-e7b355342e83",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "d4995ee5-4eb9-4e93-8461-99e8b14791db",
                                                "sense_id": "80f6bf67-cb99-36ed-b4e1-0c6fea1e6e50",
                                                "text": "The country’s first black president, and its first president to reach adulthood after the Vietnam War and Watergate, Mr. Obama seemed like a digital-age leader who could at last dislodge the stalemate between those who clung to the government of the Great Society, on the one hand, and those who disdained the very idea of government, on the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7fc1b9-ace4-3bf5-94ee-09cd30bbe223",
                                        "entry_id": "cf004d53-c914-3827-b7ea-8c4a0158448b",
                                        "glosses": [
                                            "The same; identical."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fc12e73-8cca-45be-b98e-227585d9adc3",
                                                "sense_id": "1f7fc1b9-ace4-3bf5-94ee-09cd30bbe223",
                                                "text": "He proposed marriage in the same restaurant, at the very table where they first met."
                                            },
                                            {
                                                "example_id": "63833283-e8a8-4c14-b02b-0fd278abeae7",
                                                "sense_id": "1f7fc1b9-ace4-3bf5-94ee-09cd30bbe223",
                                                "text": "That's the very tool that I need."
                                            },
                                            {
                                                "example_id": "3bf26611-da03-4b40-bf2d-fb95cd930113",
                                                "sense_id": "1f7fc1b9-ace4-3bf5-94ee-09cd30bbe223",
                                                "text": "Molly the dairymaid came a little way from the rickyard, and said she would pluck the pigeon that very night after work. She was always ready to do anything for us boys; and we could never quite make out why they scolded her so for an idle hussy indoors. It seemed so unjust. Looking back, I recollect she had very beautiful brown eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c356237-12db-3d2e-9bf8-41e1de1aaca3",
                                        "entry_id": "cf004d53-c914-3827-b7ea-8c4a0158448b",
                                        "glosses": [
                                            "With limiting effect: mere."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc59450-b787-4894-8727-83382fa35c59",
                                                "sense_id": "9c356237-12db-3d2e-9bf8-41e1de1aaca3",
                                                "text": "The very idea of climbing the ladder brings me out in a sweat. The very idea/thought!"
                                            },
                                            {
                                                "example_id": "8a08cb55-a0c9-4010-b037-9f72b65e3ac8",
                                                "sense_id": "9c356237-12db-3d2e-9bf8-41e1de1aaca3",
                                                "text": "We have many examples in our daies, yea in very children, of such as for feare of some slight incommoditie have yeelded unto death."
                                            },
                                            {
                                                "example_id": "a481b89e-e2fb-4f61-af9f-48779049a910",
                                                "sense_id": "9c356237-12db-3d2e-9bf8-41e1de1aaca3",
                                                "text": "Given the degree of fear and loathing inspired by the very thought of a fat body in America today, it is important to emphasize that all of the medical information in the counterfactual world I have just sketched is itself quite factual."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "very",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                        "entry_id": "ee74607e-3a6b-3019-a61e-06df7e5a7648",
                                        "glosses": [
                                            "To a great extent or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d1aa53e-23a5-42f7-a964-8568f56ddabb",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "That dress is very you."
                                            },
                                            {
                                                "example_id": "85037a9a-828f-4077-87c4-0b7259cb68b1",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "Not very many (of them) had been damaged."
                                            },
                                            {
                                                "example_id": "5052d267-130c-4ff0-b531-33398264e7f5",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "She's so very similar to her mother."
                                            },
                                            {
                                                "example_id": "dcb94711-b789-481e-921a-dd78baf1366d",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "‘Is she busy?’ ― ‘Not very.’"
                                            },
                                            {
                                                "example_id": "f39a3684-a53e-4a21-b733-e3ddec554d51",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "In the end, the tickets didn't turn out so very expensive."
                                            },
                                            {
                                                "example_id": "b7589e5c-5255-4c23-adc3-548f69468c70",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean.\n There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            },
                                            {
                                                "example_id": "82c089e2-45ff-4e8d-a7a2-967bc54d4668",
                                                "sense_id": "900fd3b2-ff01-3e2d-987a-466899c3ccf7",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8ae40e-15cf-3b44-aa01-8592a86f9d66",
                                        "entry_id": "ee74607e-3a6b-3019-a61e-06df7e5a7648",
                                        "glosses": [
                                            "Conforming to fact, reality or rule; true."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8499bea6-5414-3ebf-9fe1-59329369e983",
                                        "entry_id": "ee74607e-3a6b-3019-a61e-06df7e5a7648",
                                        "glosses": [
                                            "Used to firmly establish that nothing else surpasses in some respect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f926807-c4a6-4ab2-bcbd-8f4e18c0b92a",
                                                "sense_id": "8499bea6-5414-3ebf-9fe1-59329369e983",
                                                "text": "He was the very best runner there."
                                            },
                                            {
                                                "example_id": "4a3e3983-0b5b-46c5-a523-c631303a395c",
                                                "sense_id": "8499bea6-5414-3ebf-9fe1-59329369e983",
                                                "text": "This is my very own treehouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bbf61c0-63bc-45d0-af03-08f4af48fbbb",
                        "source_entry_id": "69189184-32fc-328e-b8b5-11ecf28d53e2",
                        "source_sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                        "source_sense_description": "frei heraus und spontan, oftmals mit einem positiven, verstärkenden Beiklang: sehr, überaus",
                        "target_lang_word": "très",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "très",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c7d76b-26dd-3526-b424-7d7e98f83622",
                                        "entry_id": "c8191840-b78e-3975-a3c6-6fec2b9ac29e",
                                        "glosses": [
                                            "Beaucoup, au plus haut point (devant un adjectif ou un adverbe)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebda548-13c3-46c0-84ea-d8827120438e",
                                                "sense_id": "e0c7d76b-26dd-3526-b424-7d7e98f83622",
                                                "text": "Lorsque dans une armée le besoin de récompenses se fait très vivement sentir, on peut affirmer que sa valeur est en baisse."
                                            },
                                            {
                                                "example_id": "02c83ca5-f0a0-48e3-9056-a1c4f76476a1",
                                                "sense_id": "e0c7d76b-26dd-3526-b424-7d7e98f83622",
                                                "text": "Il avait été entendu entre maman et moi que si j’étais heureuse je lui écrirais : « Ici je suis très heureuse », en soulignant « très ». Et seulement « Je suis heureuse » si je ne l’étais pas."
                                            },
                                            {
                                                "example_id": "4541ac22-c5e3-4ca3-aa2d-f5d0d64b6c24",
                                                "sense_id": "e0c7d76b-26dd-3526-b424-7d7e98f83622",
                                                "text": "Les aliments détaillés en menus morceaux sont sautés très rapidement avec très peu de matière grasse dans un récipient hémisphérique placé sur un brûleur très puissant."
                                            },
                                            {
                                                "example_id": "ad8fc644-c625-4daf-b808-a0a5c8ac56d1",
                                                "sense_id": "e0c7d76b-26dd-3526-b424-7d7e98f83622",
                                                "text": "À quoi servent les faits divers ? […] En règle générale, à faire du très mauvais journalisme, caressant le lecteur dans ses pulsions malsaines quitte à pulvériser les lignes jaunes du métier […]."
                                            },
                                            {
                                                "example_id": "2d3da614-9b5c-483a-af7a-fae3b1e600c7",
                                                "sense_id": "e0c7d76b-26dd-3526-b424-7d7e98f83622",
                                                "text": "L’affaire sera jugée sur le fond le 31 mai, mais, en attendant, ces déboires juridiques vont augmenter la facture de la grève pour les agents dès la fin de ce mois et, sans doute, faire basculer une part des très-grévistes vers le camp des non-grévistes ou des peu-grévistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ab2ea90-afda-4982-b603-9650a6863d53",
                        "source_entry_id": "69189184-32fc-328e-b8b5-11ecf28d53e2",
                        "source_sense_id": "e48491a4-1216-3e16-b7c5-77a36fd07349",
                        "source_sense_description": "frei heraus und spontan, oftmals mit einem positiven, verstärkenden Beiklang: sehr, überaus",
                        "target_lang_word": "extrêmement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrêmement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "D’une manière extrême, au dernier degré, au dernier point, à la dernière limite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48543cca-7f7d-4e41-af03-76f3d2b9fee7",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Marseille, quand elle est belle, est extrêmement belle, mais, dans ses hideurs, elle va au paroxysme."
                                            },
                                            {
                                                "example_id": "d5dbd535-3a57-4288-91ab-e952c939f786",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Il vous aime extrêmement."
                                            },
                                            {
                                                "example_id": "d226ccdd-1a39-4ca7-8865-3610276101cc",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Il compose extrêmement vite."
                                            },
                                            {
                                                "example_id": "ddd51335-80c6-4a8f-b0d6-24022290337f",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Peut-être dans la classe des gens supérieurs, est-il plus facile de trouver des gens extrêmement vertueux que des hommes extrêmement sages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "Très ; beaucoup ; fort."
                                        ],
                                        "tags": [
                                            "Souvent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94ae2b5-e267-407a-a710-6f7fc247cfbf",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique et surtout pour tout accusé qui bravait sa majesté."
                                            },
                                            {
                                                "example_id": "82722a3d-3753-464d-809f-7910d639958a",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Enfin les îles sorties des eaux (atolls) portent une flore extrêmement pauvre, venue par des apports lointains."
                                            },
                                            {
                                                "example_id": "45c49830-4b6b-4a4b-abe1-ed45c85e3b8d",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Il y a en ce lieu de certains animaux qui ont la forme du corps fort agréable et la peau extrêmement douce, souples, éveillées et plaisantes, fort aisées à apprivoiser et naturellement amies des hommes."
                                            },
                                            {
                                                "example_id": "2ef7a782-9ba6-4162-bc2a-ebfc2b23ac40",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Je ne sais pas bien certainement qui vous êtes ; mais je suis assuré que la lettre que j’ai reçue ne peut être que d’un extrêmement honnête homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b823ce84-afba-34da-af9d-dc6a3a314578",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "Un nombre extrême de. Une quantité extrême de. Extrêmement beaucoup de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd58365-fd17-41a8-bb93-ed43c04fe997",
                                                "sense_id": "b823ce84-afba-34da-af9d-dc6a3a314578",
                                                "text": "Je vais à Vannes, Monsieur ; j’y deviens amoureux d’une femme de condition, jolie veuve, assez jeune, ayant extrêmement d’esprit et beaucoup de goût pour les lettres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
