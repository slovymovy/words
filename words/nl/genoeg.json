                        },
                        {
                            "text": "Hij liep niet snel <w>genoeg</w> om de bus te halen.",
                            "target_lang_translations": {
                                "ru": "Он шел не <w>достаточно</w> быстро, чтобы успеть на автобус.",
                                "en": "He didn't walk fast <w>enough</w> to catch the bus.",
                                "pl": "Nie szedł <w>dość</w> szybko, żeby zdążyć na autobus.",
                                "de": "Er ging nicht schnell <w>genug</w>, um den Bus zu erwischen.",
                                "fr": "Il ne marchait pas <w>assez</w> vite pour attraper le bus.",
                                "it": "Non camminava <w>abbastanza</w> velocemente per prendere l'autobus.",
                                "cs": "Nešel <w>dost</w> rychle na to, aby stihl autobus.",
                                "tr": "Otobüse yetişmek için <w>yeterince</w> hızlı yürümedi.",
                                "es": "No caminó lo <w>suficientemente</w> rápido como para alcanzar el autobús."
