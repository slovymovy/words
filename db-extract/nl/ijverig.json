                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "957c6470-47d0-49c5-b795-b045bfa2cc14",
                                "sense_id": "32c8d3ba-b00c-3a8c-9342-347692335e6a",
                                "text": "Het ijverige meisje had haar woordjes goed geleerd."
                            },
                            {
                                "example_id": "35a3e79a-6370-466d-865e-2e51cb6d8a15",
                                "sense_id": "32c8d3ba-b00c-3a8c-9342-347692335e6a",
                                "text": "Ze was dus een charmante vrouw. Altijd vrolijk en levendig, altijd met een brede vriendelijke glimlach, nooit een chagrijnig gezicht, altijd uiterst hulpvaardig en ijverig."
                            }
                        ]
                    }
