                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "469f18df-43e4-4149-bf21-deafe8e8b388",
                        "source_entry_id": "51d9b4f2-fbcd-3980-8e91-040206ef9c12",
                        "target_lang_word": "ascetismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascetismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8f892ee7-21b0-3def-89ab-4db2b34b724a",
                                        "entry_id": "ad309529-555c-34c6-a31b-3b7b00f4848b",
                                        "glosses": [
                                            "Hábito o doctrina de la abstinencia del placer sensual o corporal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae6bd5-f99d-417e-96cc-d1266cbcf2b9",
                                                "sense_id": "8f892ee7-21b0-3def-89ab-4db2b34b724a",
                                                "text": "Cuando Miguel de Santiago volvió a aspirar el aire libre de la ciudad natal, su espíritu era ya presa del ascetismo de su siglo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ba6fab2-e6d6-446c-a736-4627fc0e3f9a",
                        "source_entry_id": "51d9b4f2-fbcd-3980-8e91-040206ef9c12",
                        "target_lang_word": "ascetismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascetismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "f7fa231b-d72c-3d2b-b5af-1b9753a06530",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "meditazione e preghiera come “esercizio religioso” quale metodo per l’estasi mistico-religiosa"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0495552-adea-3b53-b3e8-2210030172dd",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "l'etica religiosa in tutte le sue corrette forme applicate, esercitata anche in merito ai comportamenti abituali comunemente intesi come appunto quotidiani o addirittura \\\"ripetitivi\\"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9c5ebb-b1b6-4e18-8268-285d9d75b173",
                                                "sense_id": "f0495552-adea-3b53-b3e8-2210030172dd",
                                                "text": "con i fondamenti veridici dell'ascetismo, le tre principali religioni cosiddette monoteiste possono interpretare quasi tutto il canone precettistico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f48a180-aa1e-34bf-bb31-1aa7aa953786",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "modo di vivere che, persino \\\"in raccolta\\\" di più persone più o meno comunque col benestare delle istituzioni, per esempio nel caso di congregazioni semi-religiose non illegali, stabilisce dell'esistenza appunto un equilibrio proprio dell'ascesi e raggiunto attraverso le stesse forme ascetiche"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2a6e8d-40e7-4c91-878b-1e8fce999b38",
                                                "sense_id": "7f48a180-aa1e-34bf-bb31-1aa7aa953786",
                                                "text": "di fatto l’ascetismo è l’abbandono delle passioni"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faafe9d2-6fda-3502-8371-ca51857d2025",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "ritiro in solitudine con digiuni, talvolta “castità”, “rigore estremo” ed “esistenza in una consapevole rinuncia”, questo per favorire l’attaccamento a Dio e maggiore coscienza di sé e della realtà spirituale religiosa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9a5a02-5ee3-4076-b33c-b8c50d3d8f7d",
                                                "sense_id": "faafe9d2-6fda-3502-8371-ca51857d2025",
                                                "text": "senza principi come la verità, la pace, la gioia e la misericordia invero l’ascetismo si riduce a vana mortificazione dell’essere"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
