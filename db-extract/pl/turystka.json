                                    {
                                        "sense_id": "a8580a22-184e-351f-83bb-7fc56ddfa9da",
                                        "entry_id": "3e725be9-1785-3835-b470-6287c894230a",
                                        "glosses": [
                                            "weibliche Person, die zu ihrem Vergnügen reist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d0ad7b-8137-46cc-91ed-07e9a3026da9",
                                                "sense_id": "a8580a22-184e-351f-83bb-7fc56ddfa9da",
                                                "text": "Bisher war ich nur als Touristin in England."
                                            },
                                            {
                                                "example_id": "2e06e955-3c23-4753-8cee-b4f80da65ac3",
                                                "sense_id": "a8580a22-184e-351f-83bb-7fc56ddfa9da",
                                                "text": "„Touristinnen aus aller Herren Länder kamen mir in allen Farben und Größen zu Hunderten entgegen, und es war fast so wie damals.“"
                                            },
                                            {
                                                "example_id": "b2854f88-6b64-4462-9e08-b49f26d40958",
                                                "sense_id": "a8580a22-184e-351f-83bb-7fc56ddfa9da",
                                                "text": "„So überquerte ich die Grenze als Touristin zu Fuß am Checkpoint Charlie und musste wie Aschenputtel vor Mitternacht zurück sein.“"
                                            },
                                            {
                                                "example_id": "50629497-6a6b-4329-add9-ee824f77d186",
                                                "sense_id": "a8580a22-184e-351f-83bb-7fc56ddfa9da",
                                                "text": "„Für Touristinnen in High Heels ist das, als würden sie einen Berg damit besteigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
