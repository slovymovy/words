                            "trait_type": "form",
                            "comment": "technical term in electronics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронная схема для хранения информации, управляемая уровнем сигнала.",
                        "zh": "一种由电平信号触发、用于存储信息状态的电子电路。",
                        "cs": "Elektronický obvod pro ukládání informace, řízený úrovní signálu."
                    },
                    "translations": {
