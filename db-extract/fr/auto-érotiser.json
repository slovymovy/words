                        "glosses": [
                            "Donner un caractère auto-érotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c906c6-8a56-498c-b05c-2e8729ba69c2",
                                "sense_id": "d3f39f1b-506b-3edf-b85e-02647e505cb6",
                                "text": "Je ne suis pas forcément dans le trip travail des tétons, mais je trouve ça amusant d'auto-érotiser les mouvements dans la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "3089ba50-12db-372f-869d-3aca378b2451",
                        "entry_id": "bcab767a-c90a-3bd5-b3a6-2548ab1055e6",
                        "glosses": [
                            "Se procurer soi-même un plaisir érotique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b9ca2244-464b-4cfe-a10a-6d5d649442a2",
                                "sense_id": "3089ba50-12db-372f-869d-3aca378b2451",
                                "text": "L’être humain est capable de s’auto-érotiser par la pensée en créant des fantasmes."
                            },
                            {
                                "example_id": "380137b6-b576-4885-99d4-84624a296aba",
                                "sense_id": "3089ba50-12db-372f-869d-3aca378b2451",
                                "text": "Imaginaire érotique : Faculté qu’a l’humain de s’auto-érotiser mentalement par la création de fantasmes."
                            }
                        ]
                    }
