                                "target_lang_word": "peor",
                                "target_lang_sense_clarification": "el más grave o terrible"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最严重的",
                                "target_lang_sense_clarification": "程度最深"
