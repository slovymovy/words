                    "frequency": "Middle",
                    "semantic_group_id": "nettoyage_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coureur s'arrête un instant au bord de la piste pour <w>éponger</w> son front en sueur."
                        },
                        {
                            "text": "Il <w>épongeait</w> son visage avec un mouchoir propre sous cette chaleur étouffante."
                        }
                    ],
                    "synonyms": [
                        "essuyer",
                        "sécher"
                    ],
                    "common_phrases": [
