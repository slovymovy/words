                "senses": [
                    {
                        "sense_id": "a24fb7d3-ba8b-39bd-83ed-68d949369e35",
                        "entry_id": "5ccf27ea-794b-32e9-a66f-2cfc5f98ddff",
                        "glosses": [
                            "Fenster eines Eisenbahnabteils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2827167c-9efe-4006-ba10-cd913584eb4f",
                                "sense_id": "a24fb7d3-ba8b-39bd-83ed-68d949369e35",
                                "text": "„Im Waggon öffnete er das Abteilfenster, und sie winkten sich zu, während der Zug kleiner und kleiner wurde und schließlich in einer lang gezogenen Kurve verschwand.“"
                            },
                            {
                                "example_id": "dab36622-7a68-4fde-b635-52626762bba1",
                                "sense_id": "a24fb7d3-ba8b-39bd-83ed-68d949369e35",
                                "text": "„Wie ein Schlag traf ihn der Gedanke, dass er die Tasche zum letzten Mal gesehen hatte, als sie durch ein Abteilfenster flog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
