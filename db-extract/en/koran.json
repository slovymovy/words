                "senses": [
                    {
                        "sense_id": "9c505a37-bde9-3a0d-81ea-ea6a7cdd10ce",
                        "entry_id": "12bd8613-2352-3d71-bd91-c17ef2b4e8e6",
                        "glosses": [
                            "Alternative spelling of Qur'an."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "761551b3-a334-45ba-8c1f-53363ad849bc",
                                "sense_id": "9c505a37-bde9-3a0d-81ea-ea6a7cdd10ce",
                                "text": "The state bed of Sobieski, King of Poland, was made of Smyrna gold brocade embroidered in turquoises with verses from the Koran."
                            },
                            {
                                "example_id": "63e77875-06c6-49af-bb01-63bb20254dc6",
                                "sense_id": "9c505a37-bde9-3a0d-81ea-ea6a7cdd10ce",
                                "text": "He reads largely religious books, chiefly the Gita and Upanishads. He has read the Koran and he is now re-reading the Bible."
                            },
                            {
                                "example_id": "0dc4f823-5bb7-4ede-adda-c5313fab46e6",
                                "sense_id": "9c505a37-bde9-3a0d-81ea-ea6a7cdd10ce",
                                "text": "The beer festival happened in a village in Niya County in the deep south of Xinjiang, which is overwhelmingly populated by the Muslim Uighur people who call Xinjiang home. Muslims are not meant to consume alcohol, according to the Koran."
                            }
                        ]
                    }
                ],
