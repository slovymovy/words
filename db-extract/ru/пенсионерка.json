                    },
                    {
                        "translation_id": "a93b3fa1-47ad-4947-b09a-22b447f6d18c",
                        "source_entry_id": "489f9d9c-13fb-3a9d-82fa-bc8fa7613bc6",
                        "source_sense_id": "a81fc437-a97c-39a8-9256-6d62d9b3c294",
                        "target_lang_word": "pensionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pensionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25c2d21b-93be-3b51-8646-530306ed12d3",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Celui ou celle qui paie pension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb1cfca-e3a9-4eda-a276-841a482fe00e",
                                                "sense_id": "25c2d21b-93be-3b51-8646-530306ed12d3",
                                                "text": "Elle presse sa main sur sa bouche pour étouffer un rire aigu, et part dans un nuage de parfum de supermarché qui masque furtivement l’odeur formolée du couloir où traînent les pantoufles fatiguées des pensionnaires encore valides."
                                            },
                                            {
                                                "example_id": "a5a631b7-ed2d-42fd-981b-a4036a14c0db",
                                                "sense_id": "25c2d21b-93be-3b51-8646-530306ed12d3",
                                                "text": "Quoique tous les habitants de la « petite Corse » fussent présents, cela composait un bien maigre cortège et les étrangers au quartier, regardant passer ce défilé de vieillards, pensaient à la disparition de pensionnaires d’une maison de retraite, mais il s’étonnaient qu’en en enterrât trois à la fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca4c47d9-4d98-3a86-ade8-48405a2fc34e",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Animal mis par son propriétaire en élevage chez un éleveur, moyennant le paiement d'une pension."
                                        ],
                                        "tags": [
                                            "especially",
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdffb159-cd68-33f5-9b2a-a24ee3fc5896",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Celui ou celle qui, moyennant un prix convenu, loge dans une école, un collège, un lycée pour y être instruit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f135f3-2b2b-4f2c-a3ef-90df76a0e6d6",
                                                "sense_id": "bdffb159-cd68-33f5-9b2a-a24ee3fc5896",
                                                "text": "Ce lycée n’a que des externes : il ne prend pas de pensionnaires."
                                            },
                                            {
                                                "example_id": "6ec15a30-e1f4-4ba4-b1d9-63dfe0f65bb9",
                                                "sense_id": "bdffb159-cd68-33f5-9b2a-a24ee3fc5896",
                                                "text": "Elle était pensionnaire dans un couvent."
                                            },
                                            {
                                                "example_id": "6e911d7d-3731-438e-94b2-760cf4d9cb27",
                                                "sense_id": "bdffb159-cd68-33f5-9b2a-a24ee3fc5896",
                                                "text": "« Les pensionnaires de sixième et de cinquième, dans l’étude à côté, la huitième étude. J’ai dit « les pensionnaires ».\nIl y eut un grand mouvement dans la colonne, qui se disloqua, pour le départ de ces prisonniers.\nLe monsieur attendit que nos rangs se fussent reformés, puis, d’une voix grave, il dit :\n« Les demi-pensionnaires de sixième et cinquième A et B ! Entrez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "729a0c5a-d38f-3d5f-91ec-8d952e073931",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Prostituée exerçant dans une maison close."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bcf0954-4394-4019-afc9-fd04ae1891ae",
                                                "sense_id": "729a0c5a-d38f-3d5f-91ec-8d952e073931",
                                                "text": "Les pensionnaires n'ont pas le droit de se promener en ville sans être accompagnées par le maître qui doit signaler au préalable ces sorties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf0dfba-7c0a-3d74-aaad-36008632f288",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Celui ou celle qui reçoit une pension d’un État, d’une société, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ad6774-d280-476d-b7d4-f4812778f6f9",
                                                "sense_id": "9cf0dfba-7c0a-3d74-aaad-36008632f288",
                                                "text": "Il est pensionnaire de l’état, du gouvernement."
                                            },
                                            {
                                                "example_id": "499bb1e3-16c0-4acd-9f79-ff72cf865dd0",
                                                "sense_id": "9cf0dfba-7c0a-3d74-aaad-36008632f288",
                                                "text": "Pensionnaire de l’Académie de France à Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c895b5c-4377-3736-ace8-fb887ad92a6b",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Comédien de la Comédie française qui ne participe pas aux bénéfices de la société et qui reçoit un traitement fixe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fea4b1c5-5579-35c5-8fbb-e53abdbf0679",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Titre qu’on donnait, en Hollande, au premier ministre des États, ainsi qu’au ministre de la régence de chaque ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb1882f2-8a3b-4e40-87c7-1fc11559d925",
                                                "sense_id": "fea4b1c5-5579-35c5-8fbb-e53abdbf0679",
                                                "text": "Le grand pensionnaire de Hollande ou, par abréviation, Le grand pensionnaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95daf82-24b0-3fce-ab33-b54743d7f51e",
                                        "entry_id": "f3e7701d-48e7-3f08-9d8b-fd7103d2df67",
                                        "glosses": [
                                            "Cheval de course considéré relativement à son écurie ou son entraîneur."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c99469a-e3c8-4214-80d4-043853e3e085",
                                                "sense_id": "d95daf82-24b0-3fce-ab33-b54743d7f51e",
                                                "text": "Sébastien Guarato présentait trois pensionnaires dans le Prix de Séléction, Bold Eagle, Billie de Montfort et Bocage d’Ortige."
                                            },
                                            {
                                                "example_id": "9e1c2383-dbf5-4fb6-ac1e-08a91335913b",
                                                "sense_id": "d95daf82-24b0-3fce-ab33-b54743d7f51e",
                                                "text": "Nouveau pensionnaire de Jean-Michel Bazire, Super Fez s’est aisément imposé dans le quinté de jeudi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
