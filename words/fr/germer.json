            "senses": [
                {
                    "sense_id": "e437b2e1-cf8f-37c8-825a-f3b73b98a365",
                    "sense_definition": "Commencer à se développer en produisant un germe, en parlant d'une graine, d'un tubercule ou d'une plante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "developpement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après quelques jours passés dans une terre humide et tiède, les graines ont commencé à <w>germer</w>."
                        },
                        {
                            "text": "Il faut arroser régulièrement ces semences pour qu'elles <w>germent</w> plus rapidement."
                        }
                    ],
                    "synonyms": [
                        "pousser",
                        "lever"
                    ],
                    "common_phrases": [
                        "faire germer des graines"
                    ]
                },
                {
                    "sense_id": "699dfd7c-990a-3b86-b7ee-24d4831502bf",
                    "sense_definition": "Prendre naissance, commencer à se former et à croître, en parlant d'une idée, d'un sentiment ou d'un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "developpement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une nouvelle idée de roman a commencé à <w>germer</w> dans son esprit pendant les vacances."
                        },
                        {
                            "text": "Ce projet ambitieux a lentement <w>germé</w> au fil de nombreuses discussions entre collègues."
                        }
                    ],
                    "synonyms": [
                        "naître",
                        "éclore"
                    ],
                    "common_phrases": [
