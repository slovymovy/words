                    },
                    {
                        "translation_id": "6a9400c4-fa84-4967-89a4-e90ae5da9f7c",
                        "source_entry_id": "a1652ab0-cb5e-3eab-a7d7-04a2a84e2cec",
                        "source_sense_description": "тот, кто живёт с кем-либо вместе, в одном жилом помещении",
                        "target_lang_word": "Mitbewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitbewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88288791-f23d-3f88-8f1d-8757326a017f",
                                        "entry_id": "b2770539-3be0-3358-8cdd-278659be462b",
                                        "glosses": [
                                            "jemand, mit dem man sich ein Haus, eine Wohnung oder ein Zimmer teilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a1aadf-b529-45fe-970f-9bd4c9f09c92",
                                                "sense_id": "88288791-f23d-3f88-8f1d-8757326a017f",
                                                "text": "Ich wohne in einer Wohngemeinschaft mit zwei weiteren Mitbewohnern."
                                            },
                                            {
                                                "example_id": "3c0d8c61-e3ad-4994-9bc4-8a92d644e442",
                                                "sense_id": "88288791-f23d-3f88-8f1d-8757326a017f",
                                                "text": "„Den Kindern des Hauses, darunter Clara, bereitete der neue Mitbewohner viel Freude.“"
                                            },
                                            {
                                                "example_id": "64e2df0c-41d5-4b5e-8e05-3c654ca20c4a",
                                                "sense_id": "88288791-f23d-3f88-8f1d-8757326a017f",
                                                "text": "„Schau dir das Fotoalbum deines Mitbewohners an und frag, wer wer ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b53f2d94-9b10-4c16-b5fb-ef219fa986e6",
                        "source_entry_id": "a1652ab0-cb5e-3eab-a7d7-04a2a84e2cec",
                        "source_sense_description": "человек, живущий вместе и состоящий в половой связи с другим человеком вне брака",
                        "target_lang_word": "Lebensgefährte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensgefährte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4061596e-d9d6-3cee-b8ef-79d8e510a53f",
                                        "entry_id": "6b65ffb5-b168-3bed-95e1-8a1fcf32ce34",
                                        "glosses": [
                                            "Person in einer festen Lebensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c572c1-921a-43e8-8830-abd67bb91ca5",
                                                "sense_id": "4061596e-d9d6-3cee-b8ef-79d8e510a53f",
                                                "text": "Während für das Kind jede Hilfe zu spät kam, konnten sich der vierjährige Bruder, die Mutter und ihr 47-jähriger Lebensgefährte ins Freie retten."
                                            },
                                            {
                                                "example_id": "32a3a12c-33a2-4e0a-9043-f89af5c83050",
                                                "sense_id": "4061596e-d9d6-3cee-b8ef-79d8e510a53f",
                                                "text": "„Sie verlässt auch zunächst nicht ihren in sich gekehrten, melancholischen Lebensgefährten (was schlauer wäre), weil sie die Hoffnung nicht aufgibt, auch ihn eines Tages zu verbessern.“"
                                            },
                                            {
                                                "example_id": "b1556f98-6c27-4642-9535-a5a329cc0ad2",
                                                "sense_id": "4061596e-d9d6-3cee-b8ef-79d8e510a53f",
                                                "text": "„Mit verhängten Zügeln sind unsere possierlichen Lebensgefährten durch das Ziel gestürmt und haben uns um Nasenlänge geschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05a2806-8dda-449f-b02d-5ff2e9228a1c",
                        "source_entry_id": "a1652ab0-cb5e-3eab-a7d7-04a2a84e2cec",
