                ],
                "senses": [
                    {
                        "sense_id": "a2efde50-0e26-37e3-80d3-72187218f208",
                        "entry_id": "f94db1cb-36a0-314e-b946-547ef99b0970",
                        "glosses": [
                            "Gesamtheit der Anhänger von jemandem/etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4fcab7f-3ead-4a12-a031-50ebe7fc3ed2",
                                "sense_id": "a2efde50-0e26-37e3-80d3-72187218f208",
                                "text": "Seine Gefolgschaft wird immer kleiner."
                            },
                            {
                                "example_id": "4b5ef18d-e927-4691-aa59-cfcd29865b73",
                                "sense_id": "a2efde50-0e26-37e3-80d3-72187218f208",
                                "text": "„Er verfügte bereits unter Nader Schah über eine große loyale Gefolgschaft, die sich überwiegend aus Abdali zusammensetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6457fc72-7321-38f9-9e8d-86fe1c967dea",
                        "entry_id": "f94db1cb-36a0-314e-b946-547ef99b0970",
                        "glosses": [
                            "Verhalten, sich für jemanden/etwas einzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64eaea1-783b-49e9-b5f6-91db935390e2",
                                "sense_id": "6457fc72-7321-38f9-9e8d-86fe1c967dea",
                                "text": "„Für das Treffen haben sich die beiden Widersacher jeweils die Gefolgschaft angesehener Bauern gesichert.“"
                            },
                            {
                                "example_id": "1ec8ff06-c0e8-4010-8429-80c194822322",
                                "sense_id": "6457fc72-7321-38f9-9e8d-86fe1c967dea",
                                "text": "„Wichtiger als die Zustimmung im Volk aber ist ihm die Gefolgschaft der Elite.“"
                            },
                            {
                                "example_id": "89f4b861-6e8e-41e4-8c0e-f3fe1193b59c",
                                "sense_id": "6457fc72-7321-38f9-9e8d-86fe1c967dea",
                                "text": "„Die Widerstandsorganisationen im Land und die Exilarmee sagten klipp und klar, dass sie der Exilregierung die Gefolgschaft aufkündigen würden, wenn dort Deutsche säßen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "659e0cc0-ee0b-46df-8a9c-490e97366cf6",
                        "source_entry_id": "f94db1cb-36a0-314e-b946-547ef99b0970",
                        "source_sense_id": "a2efde50-0e26-37e3-80d3-72187218f208",
                        "source_sense_description": "Gesamtheit der Anhänger von jemandem/etwas",
                        "target_lang_word": "allegiance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allegiance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09cfee9e-3a8a-324b-a14d-aaae33d9d514",
                                        "entry_id": "0f4e4914-7322-31cb-b6b1-d171d0cead2b",
                                        "glosses": [
                                            "Loyalty to some cause, nation or ruler."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c5adc1-1fbe-44ea-aa43-7a509f2cac78",
                                                "sense_id": "09cfee9e-3a8a-324b-a14d-aaae33d9d514",
                                                "text": "With what a feeling of joyful security did her heart go back to its old allegiance! Till now she had scarcely been aware of its strength, for she had known it but by its disappointment—now she fully admitted that early and passionate emotion with which Robert Evelyn had inspired her was indeed her destiny;..."
                                            },
                                            {
                                                "example_id": "40a84611-bc08-40ea-a677-e6b6d73e2502",
                                                "sense_id": "09cfee9e-3a8a-324b-a14d-aaae33d9d514",
                                                "text": "It was always going to be a hot occasion for Declan Rice and Jack Grealish, the one-time Ireland internationals who subsequently switched their allegiances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f232129-b64a-45c6-aba3-fb481f973e7e",
                        "source_entry_id": "f94db1cb-36a0-314e-b946-547ef99b0970",
                        "source_sense_id": "a2efde50-0e26-37e3-80d3-72187218f208",
                        "source_sense_description": "Gesamtheit der Anhänger von jemandem/etwas",
                        "target_lang_word": "allégeance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allégeance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                                        "glosses": [
                                            "Obligation de fidélité et d'obéissance envers une nation, une entité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf6bf02-5b0a-4457-b2d4-603cf81d9e88",
                                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                                "text": "Enfin mon père est mort, j'en demande vengeance,\nPlus pour votre intérêt que pour mon allégeance."
                                            },
                                            {
                                                "example_id": "9385fb2d-a9e5-4126-a5d6-c25e411b9208",
                                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                                "text": "Personne ne passe sur le chemin qui mène aux vignes et aux chênaies sans lui adresser un petit signe d’allégeance."
                                            },
                                            {
                                                "example_id": "7ef8c12b-3496-4bd4-9c7c-e0d73a08abf4",
                                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                                "text": "Lʼallégeance a longtemps été lʼéconomie de la citoyenneté politique dans lʼÉtat-nation moderne."
                                            },
                                            {
                                                "example_id": "c7497d91-2a98-45b3-9d81-6c3a05661016",
                                                "sense_id": "eb67d8f9-7333-3a68-ab0a-6264b0ed7080",
                                                "text": "Puisque l’école m’avait fait naître, je lui devais allégeance et je me conformai donc aux intentions de mes éducateurs en devenant avec docilité un être civilisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23911a71-9c67-31cf-b2aa-75fc2d5dd292",
                                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                                        "glosses": [
                                            "Fait d’être un homme lige d’un suzerain."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ebfeb69-1884-32a3-9950-612e31452a5e",
                                        "entry_id": "8d92cad8-df22-3e6d-ab7d-d3dea3bd0971",
                                        "glosses": [
                                            "Soulagement, adoucissement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9becfb-29df-40e5-bdfd-eefce1561ab0",
                                                "sense_id": "9ebfeb69-1884-32a3-9950-612e31452a5e",
                                                "text": "Elle goûte, ce soir, la même allégeance qu’à ses réveils d’alors : à peine un peu de trouble parce que le non-lieu n’était pas encore officiel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
