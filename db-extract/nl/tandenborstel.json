                    {
                        "translation_id": "548f83af-3194-43c0-9778-ba6c262343e2",
                        "source_entry_id": "a193d1d1-2d84-38f9-8912-9a1b14263de8",
                        "source_sense_id": "2b74d985-d749-3ad8-a7b9-ebf8e1b8517b",
                        "source_sense_description": "borsteltje om de tanden mee te reinigen",
                        "target_lang_word": "Zahnbürste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnbürste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56f76b2a-caac-34e1-b9b0-5d6fa70c597f",
                                        "entry_id": "577ba720-5752-33cc-adc9-6cd62ab6515a",
                                        "glosses": [
                                            "Bürste zum Putzen der Zähne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3124283-5da3-498b-9ff6-4af9d5ab2333",
                                                "sense_id": "56f76b2a-caac-34e1-b9b0-5d6fa70c597f",
                                                "text": "Nach drei Monaten Benutzung sollte man seine Zahnbürste austauschen."
                                            },
                                            {
                                                "example_id": "2f20b966-90bd-49b4-9977-54edc42486e4",
                                                "sense_id": "56f76b2a-caac-34e1-b9b0-5d6fa70c597f",
                                                "text": "„Sie sagte niemandem, wohin sie ging, und nahm nur ein Nachthemd und ihre Zahnbürste mit.“"
                                            },
                                            {
                                                "example_id": "82c72929-f149-4ded-99bd-46ccce868ed0",
                                                "sense_id": "56f76b2a-caac-34e1-b9b0-5d6fa70c597f",
                                                "text": "„Sie legt die Zahnbürste nieder.“"
                                            },
                                            {
                                                "example_id": "1823be11-8d1d-4217-891a-cb69f860ceb3",
                                                "sense_id": "56f76b2a-caac-34e1-b9b0-5d6fa70c597f",
                                                "text": "„Ich drehte mich um, nahm meine Zahnbürste, hielt die Tube drüber und quetschte.“"
                                            },
                                            {
                                                "example_id": "93f8887c-98d8-4e4d-ae7d-0e7d290c1937",
                                                "sense_id": "56f76b2a-caac-34e1-b9b0-5d6fa70c597f",
                                                "text": "„Wir brauchten nur unsere Zahnbürsten, und selbst die vergaßen wir in der Hetze des Aufbruchs, um den Zug nicht zu verpassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f45a4b8-8aba-4ae2-82a5-4962230fe8da",
                        "source_entry_id": "a193d1d1-2d84-38f9-8912-9a1b14263de8",
