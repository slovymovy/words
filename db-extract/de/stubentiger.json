                    {
                        "sense_id": "90dd85c5-e335-3960-b5ca-ae9e58a15f1d",
                        "entry_id": "87b208de-e13c-3992-87e9-ff072faf46bd",
                        "glosses": [
                            "scherzhafte, umgangssprachliche Bezeichnung für eine Hauskatze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528dbe9d-b8e7-4dba-b368-6e9c7ebdeefa",
                                "sense_id": "90dd85c5-e335-3960-b5ca-ae9e58a15f1d",
                                "text": "Mein Stubentiger heißt „Missy“ und hält sich wirklich am liebsten in der Stube auf."
                            },
                            {
                                "example_id": "60286249-4a5c-4096-9db1-8c1f77e0eff6",
                                "sense_id": "90dd85c5-e335-3960-b5ca-ae9e58a15f1d",
                                "text": "\"Bei der Auswahl der passenden Zweitkatze sollte man darauf achten, dass die Chemie zwischen den beiden Stubentigern stimmt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
