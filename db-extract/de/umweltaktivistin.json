                "senses": [
                    {
                        "sense_id": "223e749e-0e95-3359-8a66-b174a217cd2f",
                        "entry_id": "3ce2cbb9-f092-3eca-bc07-7a4b08e27b54",
                        "glosses": [
                            "weibliche Person, die sich für den Umweltschutz einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335a60ef-4bf0-47da-99c8-7f20e484d18b",
                                "sense_id": "223e749e-0e95-3359-8a66-b174a217cd2f",
                                "text": "„Die Umweltaktivistin Erin Brockovich – im Jahr 2000 von der Schauspielerin Julia Roberts in einem Hollywood-Film verkörpert – fordert Bayer auf, ein umstrittenes Sterilisationsprodukt für Frauen vom Markt zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
