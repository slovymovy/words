                                "target_senses": [
                                    {
                                        "sense_id": "8ffbaca1-e866-3bff-b42e-b7284acc86cd",
                                        "entry_id": "a22fa999-b762-3bb1-a710-552c401c7945",
                                        "glosses": [
                                            "1980s and early 1990s policy of the Soviet Union under Gorbachev to allow more government transparency; often paired with perestroika"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1974ff4-c734-4ab4-a173-1d9713c63996",
                                                "sense_id": "8ffbaca1-e866-3bff-b42e-b7284acc86cd",
                                                "text": "Gorbachev would introduce glasnost (openness and freedom) and perestroika (economic restructuring) to Russia under his tenure, ultimately freeing thousands of political prisoners and dissidents and trying to address the shortages in food and goods that had become the hallmarks of the failing Soviet economy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7324dc3-da70-4cf9-937d-6ebd40888cda",
                        "source_entry_id": "93d09cae-8abb-3745-abd2-8534ea0a46c8",
                        "source_sense_id": "fd2cdb24-0983-3f10-8a3a-26f4812c13cd",
                        "target_lang_word": "glasnost",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glasnost",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76d5ef14-14e0-37b8-afab-9c79165e6450",
                                        "entry_id": "aa9b7192-9f80-34bf-9e2d-416411f97c94",
                                        "glosses": [
                                            "Politique de liberté d’expression et de la publication d’informations, introduite par Mikhaïl Gorbatchev en Union soviétique en 1985."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "452152fe-cc7d-4714-baf7-61b18c1b13f3",
                                                "sense_id": "76d5ef14-14e0-37b8-afab-9c79165e6450",
                                                "text": "L’heure est à la perestroïka et à la glasnost, pas à un conflit majeur et lointain."
                                            },
                                            {
                                                "example_id": "314cc311-7a94-43fd-9b7a-6f124c2196a3",
                                                "sense_id": "76d5ef14-14e0-37b8-afab-9c79165e6450",
                                                "text": "Un ami libraire, Alfonso, m’avait confié cette documentation rassemblée depuis la Glasnost, grâce au rapport d’un commissaire politique appelé Vassili Velichko."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
