                        "examples": [
                            {
                                "example_id": "d4bee27b-826f-4b90-a639-28e6a9a442fb",
                                "sense_id": "8143031c-79b4-3162-ab6d-2b963e4419f6",
                                "text": "Ja, und Hähnchen wollte der verscheuern: Gummiadler mit Pommes."
                            },
                            {
                                "example_id": "1a04db67-2153-494c-9e4e-5ce95b1c183b",
                                "sense_id": "8143031c-79b4-3162-ab6d-2b963e4419f6",
                                "text": "»Du sagtest doch, dass du gerne Gummiadler isst«, sagte sie lächelnd. »Das sind hoffentlich keine Gummiadler mit einer Million Flugstunden«, antwortete Frithjof und nahm den Teller entgegen."
                            }
                        ]
                    }
