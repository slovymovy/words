                                        "glosses": [
                                            "groep politieagenten bij een bepaalde gebeurtenis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8026d85f-3e8d-4396-9a4b-2f4eb9a10b22",
                                                "sense_id": "ab5b1392-6ed9-33b8-89dc-e9493c08eb17",
                                                "text": "Ter voorkoming van rellen was er bij de voetbalwedstrijd een grote politiemacht aanwezig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95cf2a8b-96b7-3c2a-bd54-628f02ae0c90",
                                        "entry_id": "02175d0d-785f-3484-b42d-d0aa77651346",
                                        "glosses": [
                                            "korps van politie ambtenaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7a25c9-4d92-4d71-b5ff-f2b0cb4c51dd",
                                                "sense_id": "95cf2a8b-96b7-3c2a-bd54-628f02ae0c90",
                                                "text": "Het plan bracht ze al aan tafel bij presidentskandidaat Hillary Clinton, minister van Justitie Loretta Lynch en, deze zomer, in het Witte Huis bij president Obama. Clintons programma voor politiehervorming - landelijke regels voor het gebruik van dodelijk geweld, burgers betrekken bij de plaatselijke politiemacht, 1 miljard dollar voor trainingen die vooroordelen bij politieagenten moeten tegengaan - is een gematigder afspiegeling van dat van Campaign Zero."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2118368a-b7c5-4f8b-ad45-a4a6bd437b96",
                        "source_entry_id": "aef227e6-9563-333e-913a-ed86173a6a89",
                        "source_sense_description": "police force",
                        "target_lang_word": "gendarmerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
