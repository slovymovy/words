                    {
                        "translation_id": "66e2fd4e-8e9d-4c8c-b0d8-921983d2ece2",
                        "source_entry_id": "99237491-7e0a-3c9b-aaf2-e054344b47ce",
                        "source_sense_id": "939009ee-0836-3e71-b1c7-c340292c214e",
                        "target_lang_word": "take away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "take away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0de6d6a0-6e01-341d-900f-eb6f36f59f33",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To remove something and put it in a different place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cc5c88-3c2a-4022-b848-e3e22536360c",
                                                "sense_id": "0de6d6a0-6e01-341d-900f-eb6f36f59f33",
                                                "text": "Mother took our plates away and came back with some fruit for us to eat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "033c608c-a6dc-3d1c-bedb-b54e668d5595",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To remove something, either material or abstract, so that a person no longer has it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdbe08b-ed96-4ea2-af12-b0177ed65c83",
                                                "sense_id": "033c608c-a6dc-3d1c-bedb-b54e668d5595",
                                                "text": "The teacher took my mobile phone away until the end of the lesson."
                                            },
                                            {
                                                "example_id": "e493727b-8091-478b-90c6-3c35568234d2",
                                                "sense_id": "033c608c-a6dc-3d1c-bedb-b54e668d5595",
                                                "text": "The new law will take away some important rights from immigrant residents."
                                            },
                                            {
                                                "example_id": "a70d5ef3-2a96-4ca8-9293-77b02b99b176",
                                                "sense_id": "033c608c-a6dc-3d1c-bedb-b54e668d5595",
                                                "text": "The doctor gave me pills to take away the pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3121b5f-9548-3a28-856d-4e2f3ad41c80",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To remove something, either material or abstract, so that a person no longer has it.",
                                            "To remove a person, usually a family member or other close friend or acquaintance, by kidnapping or killing the person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2080bdf2-4744-44fa-ba94-cd91abb6cd4d",
                                                "sense_id": "f3121b5f-9548-3a28-856d-4e2f3ad41c80",
                                                "text": "The mother of the murdered man spoke directly to the man who took away her son, then addressed the judge, whom she trusted would impose the maximum sentence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f3559b-0f7c-31a0-beb4-0408a153cb57",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To subtract or diminish something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552a2473-b59b-4eb2-94fa-d75dc1e87d4a",
                                                "sense_id": "54f3559b-0f7c-31a0-beb4-0408a153cb57",
                                                "text": "If I have five apples and you take away two, how many do I have left?"
                                            },
                                            {
                                                "example_id": "66370467-9a80-4532-805b-51e3fb21f415",
                                                "sense_id": "54f3559b-0f7c-31a0-beb4-0408a153cb57",
                                                "text": "But take nothing away from Arsenal, who were driven on by the brilliance of Van Persie and Fabregas and only prevented from being out of sight at half-time by the feats of Al Habsi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676e61e5-6a8a-3271-a56e-2557d41c4677",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To leave a memory or impression in one's mind that you think about later."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dcd3c96-9e08-47e9-8a03-ddd9ef2bcf12",
                                                "sense_id": "676e61e5-6a8a-3271-a56e-2557d41c4677",
                                                "text": "I took away the impression that the play was under rehearsed."
                                            },
                                            {
                                                "example_id": "b1d2d33d-c40c-4c54-9f49-5d1310d642fa",
                                                "sense_id": "676e61e5-6a8a-3271-a56e-2557d41c4677",
                                                "text": "Which brings us to what I took away as the main point of the lecture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "514214ea-cf21-3155-be9e-64148a49d661",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To make someone leave a place and go somewhere else. Usually not with the person's consent."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e00a954-c392-4fed-b646-7d0531b33272",
                                                "sense_id": "514214ea-cf21-3155-be9e-64148a49d661",
                                                "text": "The police took him away for questioning."
                                            },
                                            {
                                                "example_id": "f66280fc-4f2e-4448-88a9-a8fdf6ceadad",
                                                "sense_id": "514214ea-cf21-3155-be9e-64148a49d661",
                                                "text": "I'm taking you away to the country for a rest. It's for your own good!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7581e2b6-0cf7-385c-913a-389247d2f337",
                                        "entry_id": "06729e2c-4bfb-323e-a57e-12fcd79f794d",
                                        "glosses": [
                                            "To prevent, or limit, someone from being somewhere, or from doing something."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca684a18-696b-43e2-be71-5c7db463097c",
                                                "sense_id": "7581e2b6-0cf7-385c-913a-389247d2f337",
                                                "text": "My job takes me away from home most weekends."
                                            },
                                            {
                                                "example_id": "ed0c320b-7bd3-477c-94fc-8cd44d9b84ee",
                                                "sense_id": "7581e2b6-0cf7-385c-913a-389247d2f337",
                                                "text": "Using the internet so much can take you away from your studies."
                                            }
                                        ]
                                    }
                                ]
                            },
