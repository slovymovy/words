                    {
                        "translation_id": "160fe184-2a99-4b2b-b938-1dadda31b597",
                        "source_entry_id": "33b5293b-0bfe-3b6b-9a07-f20b3cd42192",
                        "source_sense_id": "fc5aad0e-3b57-3078-99aa-e6597d768b47",
