                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette tisane chaude aide à <w>adoucir</w> la douleur de gorge."
                        },
                        {
                            "text": "Ses paroles réconfortantes ont permis d'<w>adoucir</w> le chagrin de son ami."
