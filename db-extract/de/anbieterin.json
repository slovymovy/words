                                "target_senses": [
                                    {
                                        "sense_id": "4db9664e-6e0e-3b58-a801-4ace31964aea",
                                        "entry_id": "e49bbfca-8b88-3a63-9ab9-21c0a67a94b8",
                                        "glosses": [
                                            "Celle, entreprise ou particulier, qui entreprend de faire la fourniture de marchandises, de denrées ou celui chez qui on se les procure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d38a744-7fc5-4b8e-ab8c-e2aa8065e99e",
                                                "sense_id": "4db9664e-6e0e-3b58-a801-4ace31964aea",
                                                "text": "Il trouva un de ses neveux en prise de bec avec sa fournisseuse de sachets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0dd097c-d5aa-3d7b-92a4-dde701baee05",
                                        "entry_id": "e49bbfca-8b88-3a63-9ab9-21c0a67a94b8",
                                        "glosses": [
                                            "Épouse d’un fournisseur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdb0c4da-e57b-4a77-bf54-bb182a454c66",
                                                "sense_id": "f0dd097c-d5aa-3d7b-92a4-dde701baee05",
                                                "text": "Pareille avanie n’arriverait pas aujourd’hui à la femme d’un fournisseur, eût-elle en tête une femme issue en ligne directe de la reine Blanche : si la fournisseuse reculait, ce serait devant un plus grand train, devant un attelage plus magnifique ; ce serait aux signes d’une opulence et d’une puissance supérieure, mais non pas à la noblesse déguenillée qu’elle rendrait cet hommage."
                                            }
                                        ]
                                    }
                                ]
                            }
