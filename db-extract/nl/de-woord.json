                        "glosses": [
                            "zelfstandige naamwoord waarvoor \\\"de\\\" als bepaald lidwoord wordt gebruikt en dat dus een mannelijk en/of vrouwelijk woordgeslacht heeft"
                        ],
                        "tags": [],
                        "examples": [
