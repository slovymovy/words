                        "examples": [
                            {
                                "example_id": "6c1690f1-40f5-457f-b2c4-a74c387d8ae4",
                                "sense_id": "9d14a519-0a5c-3993-bafe-c248b8eed015",
                                "text": "Les trognons de pommes volèrent, les imitations du bubulement des hiboux dominèrent le bruit que faisaient à l’orchestre deux tristes vieillards sans cheveux, qui chatouillaient la panse des violoncelles."
                            },
