                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e76f5fe9-5f7e-4ed2-be84-fcdced974727",
                                                "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                                "text": "„Hier war es besonders schwierig, weil die Brigantine unaufhörlich in der bewegten See hin und her gierte und das kleine Boot von jeder heranlaufenden Welle hochgehoben wurde, bevor es wieder in ein Wellental sackte.“"
                                            },
                                            {
                                                "example_id": "845c43fb-4f2b-4a58-8ac1-c2a88e5e769a",
                                                "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                                "text": "„Eine neue Waffe schwamm jetzt im trüben Wasser des Sees: 13 kleine Kriegsschiffe, Brigantinen, bemannt mit Armbrustschützen und Musketieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
