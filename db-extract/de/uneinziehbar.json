                        "form": "es ist uneinziehbar"
                    },
                    {
                        "form_id": "460fbc1a-98ee-4918-b855-33be5a6875e4",
                        "entry_id": "a39155c8-08fc-3fdc-b809-66793a8f0a66",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind uneinziehbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "feba0620-5941-3764-98fc-e9e9894b8717",
                        "entry_id": "a39155c8-08fc-3fdc-b809-66793a8f0a66",
                        "glosses": [
                            "so, dass es nicht eingezogen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af4854c4-0b34-4799-b077-728cc44a7eef",
                                "sense_id": "feba0620-5941-3764-98fc-e9e9894b8717",
                                "text": "„… für Liquidationen, die uneinziehbar geblieben sind, eine Schreibgebühr von 25 Pf. und die dem Bureau entstandenen unvermeidlichen Nebenkosten.“"
                            },
                            {
                                "example_id": "d9f0dd11-d813-4f27-a079-7360232baf48",
                                "sense_id": "feba0620-5941-3764-98fc-e9e9894b8717",
                                "text": "„Das Ordnungsgeld ist uneinziehbar, und alle Mühe und Arbeit war vergebens.“"
                            },
                            {
                                "example_id": "f369f64a-1c99-4bf4-8ccd-edc21380e05d",
                                "sense_id": "feba0620-5941-3764-98fc-e9e9894b8717",
                                "text": "„Eine Garantie übernehmen die Kassen deshalb auch nicht für die Honorarforderungen der Berliner Kassenärzte, und nach den bei den Berliner Hülfskassen gesammelten Erfahrungen seien etwa 40% dieser Honorare uneinziehbar.“"
                            },
                            {
                                "example_id": "f91a5c0a-a3cf-4b02-a1e0-a3963df40348",
                                "sense_id": "feba0620-5941-3764-98fc-e9e9894b8717",
                                "text": "„Durch die Vinkulierung entstehe daher eine unveräußerliche, unbelastbare und uneinziehbare Forderung.“"
                            },
                            {
                                "example_id": "cbeaa367-5106-44df-a96e-af1159408cfc",
