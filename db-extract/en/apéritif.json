                        "entry_id": "15d5a826-2de9-346e-94a7-fbddaf13498b",
                        "glosses": [
                            "An alcoholic drink served before a meal as an appetiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91bd81fc-d2cd-44e7-bd03-838c9fc17e59",
                                "sense_id": "a09fc20a-f7dd-3862-b839-deddff72ae76",
                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed.\n ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […] ‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80a91eed-8e72-4965-99d5-85eb82bc9774",
