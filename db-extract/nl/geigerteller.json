                                        "glosses": [
                                            "ein Detektor für ionisierende Strahlung, also Alpha-, Beta-, Gamma- und Protonenstrahlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054b7a59-d5e3-4a1f-abe8-6e9ff19a57da",
                                                "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                                                "text": "Mit einem Geigerzähler kann man messen, wie stark die Strahlung ist."
                                            },
                                            {
                                                "example_id": "75a72faf-d052-48ea-8dff-6c53eea4bdab",
                                                "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                                                "text": "„Der Mann bemerkte dies, legte den Geigerzähler zurück auf den Holzblock und folgte dem Blick des Hundes.“"
                                            },
                                            {
                                                "example_id": "e63bbbb0-c3d2-4eac-bd3b-97d75d086699",
                                                "sense_id": "c17c9141-87fa-36b9-94bd-979f1dceb1e0",
                                                "text": "„Der Verkauf von Geigerzählern stieg rasant an.“"
