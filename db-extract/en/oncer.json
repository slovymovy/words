                        "examples": [
                            {
                                "example_id": "e188ae4b-2384-42a1-a28d-3cbd78d0f731",
                                "sense_id": "212e879a-2d75-3192-9b12-d42721b1c43d",
                                "text": "And fun because, well, he gets to interact with “Oncers” at fan events like PaleyFest and Comic Con […]"
                            },
                            {
                                "example_id": "de5560e6-f09b-430d-86e9-7f3b500a750f",
                                "sense_id": "212e879a-2d75-3192-9b12-d42721b1c43d",
                                "text": "Katy Lewis, a resident of Whitehorse, Yukon, is a 'Oncer'—a super fan of the popular TV show Once Upon a Time."
                            },
                            {
                                "example_id": "6be6830f-fc14-43ca-9516-f4ee295cef3f",
                                "sense_id": "212e879a-2d75-3192-9b12-d42721b1c43d",
                                "text": "A horde of 'Oncers' from all over the continent are descending on little Steveston/Storybrooke this weekend."
                            }
                        ]
                    }
