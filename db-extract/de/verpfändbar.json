                ],
                "senses": [
                    {
                        "sense_id": "5841c892-0385-3584-b7d9-7b03a043f782",
                        "entry_id": "d1263b9e-cf10-3f34-834c-6bffa650146f",
                        "glosses": [
                            "geeignet, als Pfand für ein Darlehen gegeben zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3832144-1507-483a-bb0c-5a38620e0e4a",
                                "sense_id": "5841c892-0385-3584-b7d9-7b03a043f782",
                                "text": "„Dem Verweis darauf, dass nach Art. 7 I RegPfG alle veräußerlichen Rechte verpfändbar seien, kann man entgegengehalten, dass gerade das der Konstruktion des Rechts am Vermögen als Vorbild dienende Eigentumsrecht nicht als solches Recht in Frage kommt, da statt seiner die Sachen selbst als Pfandgegenstände angesehen werden. “"
                            },
                            {
                                "example_id": "e2123fde-13e4-4426-9d07-6b0787006587",
                                "sense_id": "5841c892-0385-3584-b7d9-7b03a043f782",
                                "text": "„Auch ein Miteigentumsanteil ist verpfändbar (§ 1258 I BGB) ebenso wie Scheinbestandteile eines Grundstücks (§ 95 BGB).“"
                            },
                            {
                                "example_id": "5451b8ae-9871-4b45-95bc-b98fd558140e",
                                "sense_id": "5841c892-0385-3584-b7d9-7b03a043f782",
                                "text": "„Ansprüche auf Abgeltung der Mitwirkung eines Ehegatten im Erwerb des anderen (§ 98) sind vererblich, unter Lebenden oder von Todes wegen übertragbar und verpfändbar, soweit sie durch Vertrag oder Vergleich anerkannt oder gerichtlich geltend gemacht worden sind.“"
                            },
                            {
                                "example_id": "3283bb49-4545-4b5f-8750-14a0c44da3cf",
                                "sense_id": "5841c892-0385-3584-b7d9-7b03a043f782",
                                "text": "„Die Häuser sind nicht verpfändbar und nur beschränkt, das heisst unter den Bewohnern desselben Dorfes, übertragbar.“"
                            },
                            {
                                "example_id": "46b1dc13-9a4f-40a8-b534-27d03ce14615",
                                "sense_id": "5841c892-0385-3584-b7d9-7b03a043f782",
                                "text": "„[Der Pflichtteilsanspruch] ist vererblich und übertragbar, § 2317 Abs. 2, und folglich gem. §§ 1 273 ff. auch verpfändbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
