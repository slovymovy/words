        "nl-extract.jsonl": [
            {
                "entry_id": "9f8bc177-a7fb-377b-a27b-f63e1898c737",
                "word": "heilwens",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c37a1cb2-04aa-4ac7-9985-9e4bd4baf411",
                        "entry_id": "9f8bc177-a7fb-377b-a27b-f63e1898c737",
                        "tags": [
                            "plural"
                        ],
                        "form": "heilwensen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5b4db72-cdc5-3a3e-8dd6-c0c8394898bd",
                        "entry_id": "9f8bc177-a7fb-377b-a27b-f63e1898c737",
                        "glosses": [
                            "iemand het beste toewensen voor de toekomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11d6bdf-447e-443e-9f38-9d1fd9a96a26",
                                "sense_id": "e5b4db72-cdc5-3a3e-8dd6-c0c8394898bd",
                                "text": "Aan de avonddis van zaterdag drinkt het marinepersoneel voor het eerst op 'onze families'. Die avond sneuvelt niet alleen de formele heilwens op de 'echtgenotes en schatjes', maar onvermijdelijk ook de boertige kwinkslag die daar van oudsher op volgt: 'Dat zij elkaar maar nooit zullen ontmoeten!'."
                            },
                            {
                                "example_id": "757d4a86-a335-4b98-90b3-77ec814621cb",
                                "sense_id": "e5b4db72-cdc5-3a3e-8dd6-c0c8394898bd",
                                "text": "De officiële opening was bijzonder. Mr. Pieter van Vollenhoven had speciaal voor deze gelegenheid een heilwens in het dialect van de Ayacucho Indianen ingestudeerd. Bovendien doopte hij de bootjes met bronwater dat door KLM uit Peru was ingevlogen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9f9ec2a-8e5e-4079-99bc-38628359c2f4",
                        "source_entry_id": "9f8bc177-a7fb-377b-a27b-f63e1898c737",
                        "source_sense_id": "e5b4db72-cdc5-3a3e-8dd6-c0c8394898bd",
                        "source_sense_description": "iemand het beste toewensen voor de toekomst",
                        "target_lang_word": "benediction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benediction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                        "entry_id": "cad71a24-0472-3927-a135-317e6877915a",
                                        "glosses": [
                                            "A short invocation for help, blessing and guidance from God, said on behalf of another person or persons (sometimes at the end of a church worship service)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb95427-f9ce-4d63-82c0-f7e2d11bcbfb",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "to pronounce / give / say the benediction"
                                            },
                                            {
                                                "example_id": "d0d5dd39-ffbb-45bb-8334-6da67335531c",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "the nuptial benediction"
                                            },
                                            {
                                                "example_id": "ec37b29b-f16e-4ff7-ab66-a112de6487a6",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "a parting benediction"
                                            },
                                            {
                                                "example_id": "74958e8b-aabe-466f-9bdf-3293bc55fbde",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "O, look upon me, sir,\nAnd hold your hands in benediction o’er me."
                                            },
                                            {
                                                "example_id": "d330e16a-f5d3-4cae-8615-83f92e114664",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "So saying, he [the angel] arose; whom Adam thus\nFollow’d with benediction."
                                            },
                                            {
                                                "example_id": "057b4029-de61-49df-8a44-47c22a236c8a",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "My pen (its last scrawl a benediction on my beloved) dropt from my fingers;"
                                            },
                                            {
                                                "example_id": "80355c7b-e2e9-4fbb-b607-d547a492f7df",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "Cohen kept on his own hat, and took no notice of the visitor, but stood still while the two children went up to him and clasped his knees: then he laid his hands on each in turn and uttered his Hebrew benediction; whereupon the wife, who had lately taken baby from the cradle, brought it up to her husband and held it under his outstretched hands, to be blessed in its sleep."
                                            },
                                            {
                                                "example_id": "77ba975d-e0c1-4fb4-bd44-89a60697629e",
                                                "sense_id": "098b663a-e094-3387-8867-4050f331224c",
                                                "text": "Long brahminical hairs sprouted out of his ears, and he drew further attention to himself by closing his eyes, neatly shaking away tears, putting a hand on Owad’s head and speaking a Hindi benediction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7804532-3619-38cf-8ce0-ab399f14ca68",
                                        "entry_id": "cad71a24-0472-3927-a135-317e6877915a",
                                        "glosses": [
                                            "In the Anglican church, the ceremony used to institute an abbot, analogous to the consecration of a bishop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28641b4-648c-4099-8706-7b9841fe93a2",
                                                "sense_id": "d7804532-3619-38cf-8ce0-ab399f14ca68",
                                                "text": "What Consecration is to a Bishop, that Benediction is to an Abbot; but in a different way: For a Bishop is not properly such till Consecration; but an Abbot being elected and confirm’d, is properly such before Benediction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf3857cf-387a-3f8d-89d3-b9d3134267da",
                                        "entry_id": "cad71a24-0472-3927-a135-317e6877915a",
                                        "glosses": [
                                            "A Roman Catholic rite by which bells, banners, candles, etc., are blessed with holy water and formally dedicated to God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e28bbedf-028a-4701-a64f-413f35543ae1",
                                                "sense_id": "bf3857cf-387a-3f8d-89d3-b9d3134267da",
                                                "text": "[He] later liked to attend benediction in the chapel at Brideshead and see the ladies of the family with their necks arched in devotion under their black lace mantillas; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234faee9-4e65-3d5d-a0e2-06b5699accc8",
                                        "entry_id": "cad71a24-0472-3927-a135-317e6877915a",
                                        "glosses": [
                                            "Help, good fortune or reward from God or another supernatural source."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80293134-3657-4ce5-8b0f-3eb09c42b033",
                                                "sense_id": "234faee9-4e65-3d5d-a0e2-06b5699accc8",
                                                "text": "[…] they throng who should buy first, as if my trinkets had been hallowed and brought a benediction to the buyer:"
                                            },
                                            {
                                                "example_id": "02737c88-8bf4-453b-9189-b3435b5e7be9",
                                                "sense_id": "234faee9-4e65-3d5d-a0e2-06b5699accc8",
                                                "text": "Homeward serenely she walked with God’s benediction upon her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c3371c8-3be5-4778-a85a-437574834118",
                        "source_entry_id": "9f8bc177-a7fb-377b-a27b-f63e1898c737",
                        "source_sense_id": "e5b4db72-cdc5-3a3e-8dd6-c0c8394898bd",
                        "source_sense_description": "iemand het beste toewensen voor de toekomst",
                        "target_lang_word": "blessing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blessing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58349b47-f01f-3030-9a05-379b814aa967",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "Some kind of divine or supernatural aid, or reward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae700970-d005-4c09-ad1c-3fa976acc118",
                                                "sense_id": "58349b47-f01f-3030-9a05-379b814aa967",
                                                "text": "Henceforth, wherever thou may’st roam,\n⁠My blessing, like a line of light,\n⁠Is on the waters day and night,\nAnd like a beacon guards thee home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b66c57-606c-35eb-846e-0770787aad11",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "A pronouncement invoking divine aid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5657ccd8-a8c8-4044-964f-dffa257f7366",
                                                "sense_id": "e9b66c57-606c-35eb-846e-0770787aad11",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3812cfff-4922-313c-a500-a8c3c2809214",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "Good fortune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671d7a83-1625-4b99-8d1f-f97328dd6bf9",
                                                "sense_id": "3812cfff-4922-313c-a500-a8c3c2809214",
                                                "text": "He was given blessings hoping he would pass his final exam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50b5c9d7-e591-3ab7-b249-a0b0cb00bc76",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "A modern pagan ceremony."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f61c795-a0ff-37c6-bf70-1e512dbcb50e",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "The act of declaring or bestowing favor; approval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c61df9a-daf8-4ef1-a168-ce1a9c02a2b9",
                                                "sense_id": "8f61c795-a0ff-37c6-bf70-1e512dbcb50e",
                                                "text": "We will not proceed without the executive director's blessing."
                                            },
                                            {
                                                "example_id": "bfee0b20-1d08-418b-bb93-231d32277a88",
                                                "sense_id": "8f61c795-a0ff-37c6-bf70-1e512dbcb50e",
                                                "text": "Jocasta had my blessing when she seduced you, you stuck-up piffler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce07e53f-c2ff-38f7-8287-d5ea432f0def",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "Something someone is glad of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ffec10-171c-4ab1-92e9-e22604b5f5a2",
                                                "sense_id": "ce07e53f-c2ff-38f7-8287-d5ea432f0def",
                                                "text": "After two weeks of sun, last night's rainfall was a blessing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362e4e40-db27-32d8-bd4b-8e25671e23ee",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "A prayer before a meal; grace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbe38dbc-31eb-3a5e-b84d-ba61e6c38b9a",
                                        "entry_id": "d7b34613-a8ca-3f7e-ad88-d32d42d1f59e",
                                        "glosses": [
                                            "A group of unicorns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946b69b8-1c22-40ca-b0be-f0afa3701f53",
                                                "sense_id": "cbe38dbc-31eb-3a5e-b84d-ba61e6c38b9a",
                                                "text": "And since we’re laying out our wishes, we’d also like a blessing of unicorns and one million dollars."
                                            },
                                            {
                                                "example_id": "7d8e3bd1-f31d-43ec-a992-33b0b9050139",
                                                "sense_id": "cbe38dbc-31eb-3a5e-b84d-ba61e6c38b9a",
                                                "text": "Then a blessing of unicorns charged into the studio, and I was carried away to be re-educated."
                                            },
                                            {
                                                "example_id": "f785ee45-18e9-44c6-a7b5-6d8430aa0ce0",
                                                "sense_id": "cbe38dbc-31eb-3a5e-b84d-ba61e6c38b9a",
                                                "text": "She just wants to talk to her friends on www.unicornwillsaveus.com or write in her journal or flump on her bedroom floor with her blessing of unicorns: her posters, figurines, stickers, temporary tattoos of anatomically correct unicorns."
                                            }
                                        ]
                                    }
                                ]
                            },
