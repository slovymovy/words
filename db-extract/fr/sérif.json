                                "target_senses": [
                                    {
                                        "sense_id": "d7f33a74-5722-32d4-a57c-aa3719daadf6",
                                        "entry_id": "163a2eb7-debd-3687-a91f-d57cbaddb4f3",
                                        "glosses": [
                                            "A short line added to the end of a stroke in traditional typefaces, such as Times New Roman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e53f1d-71eb-4423-9cbb-37a1a963d806",
                                                "sense_id": "d7f33a74-5722-32d4-a57c-aa3719daadf6",
                                                "text": "It is generally believed, by those who study such things, that serif typefaces are easier to read when reading a lot of words. The hickeys (serifs) on each letter tend to push our eye toward the next letter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serif",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c0a128e-6e2e-34ab-95b2-53d2d6132545",
                                        "entry_id": "f82308c8-1ad7-3f1b-80c0-e94a9db9aeb1",
                                        "glosses": [
                                            "Of a typeface, provided with serifs."
                                        ],
