                        "examples": [
                            {
                                "example_id": "6388d537-6213-4f0f-95af-a1abaf645060",
                                "sense_id": "081e88ea-3c10-3cba-ad66-b29bec9cc575",
                                "text": "„Ich umarmte meine Mutter, aber ich erzählte ihr nichts von dem, was mir begegnet war, denn ich hatte in unseren Ghaselen gelesen, daß die Feen es lieben, wenn man ihr Geheimnis bewahrt.“"
                            },
                            {
                                "example_id": "0c28dda6-6f12-486f-a847-c5b86d54b587",
                                "sense_id": "081e88ea-3c10-3cba-ad66-b29bec9cc575",
                                "text": "„Das war's etwa, was ich schreiben würde. Recht gut ineinander verschlungen, ein Ghasel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
