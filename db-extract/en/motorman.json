                    {
                        "sense_id": "e7dec98d-d73c-30f1-9e7f-62e53549b672",
                        "entry_id": "138c7f18-ecaf-33be-9cc7-ea29562db2fd",
                        "glosses": [
                            "An electric train or tram driver."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "b0815482-7f9d-4737-b36a-488b3cc5c4ac",
                                "sense_id": "e7dec98d-d73c-30f1-9e7f-62e53549b672",
                                "text": "Near-synonym: engineer"
                            },
                            {
                                "example_id": "3a0ecdf2-dea4-4ce2-8d05-26f65146f807",
                                "sense_id": "e7dec98d-d73c-30f1-9e7f-62e53549b672",
                                "text": "Four years later, on May 27, 1898, he was promoted to fireman, and worked on all types of freight trains until November 27, 1911, when he was transferred to Heaton and became a motorman on the Tyneside electric services. After a spell of just over eight years as a motorman, he returned to Gateshead as a driver, and apart from a further short period as a motorman, he was employed at the Gateshead depot, first as a pilot driver, and then as a freight train driver."
                            },
                            {
                                "example_id": "fdb1a124-9a3d-485e-845a-ef93e692ad5f",
                                "sense_id": "e7dec98d-d73c-30f1-9e7f-62e53549b672",
                                "text": "The electric train motorman denied emphatically that he had misread this train's signals for his own and asserted that the inner home signal on the up main through line for his train was displaying a green aspect, with the indicator showing platform 14."
                            },
                            {
                                "example_id": "fff636c7-5e1b-45f1-aeee-81cec4638b62",
                                "sense_id": "e7dec98d-d73c-30f1-9e7f-62e53549b672",
                                "text": "But to no avail - the suburban (Sunday) service ground to a halt, with only 20 of the 268 motormen turning up for work on Boxing Day [1949]. Kempton Park races lost 10,000 visitors, with the cancellation of 12 extra race day trains."
                            }
                        ]
                    }
