                                            {
                                                "example_id": "d2449b92-fb32-4210-9111-8dbe95569239",
                                                "sense_id": "c4dc2044-182b-3160-9ed8-76ddfe7c4d73",
                                                "text": "El miércoles estuvimos en la bolera, Salma que es muy buena jugando quedo en la final"
