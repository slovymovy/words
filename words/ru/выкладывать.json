    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0658c7d-2812-31e5-984d-0eaee31188c5",
                    "sense_definition": "доставать, вынимать изнутри и помещать на какую-либо поверхность",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_placement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он начал аккуратно <w>выкладывать</w> покупки из пакета на кухонный стол.",
                            "target_lang_translations": {
                                "en": "He began to neatly <w>unpack</w> the groceries from the bag onto the kitchen table."
                            }
                        },
                        {
                            "text": "Покупатели медленно <w>выкладывают</w> вещи из корзины прямо перед кассиром.",
                            "target_lang_translations": {
                                "en": "Shoppers slowly <w>take</w> items <w>out</w> of their baskets right in front of the cashier."
                            }
                        }
                    ],
                    "synonyms": [
                        "вынимать"
                    ],
                    "common_phrases": [
                        "выкладывать из сумки",
                        "выкладывать на стол",
                        "выкладывать из кармана"
                    ],
                    "target_lang_definitions": {
                        "en": "to take out from within and put onto a surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay out",
                                "target_lang_sense_clarification": "placing items on a surface"
                            },
                            {
                                "target_lang_word": "take out and set down",
                                "target_lang_sense_clarification": "unloading items from a container"
                            },
                            {
                                "target_lang_word": "unpack",
                                "target_lang_sense_clarification": "removing items from a bag or box onto a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ee53633-f55c-3d92-99fc-2e6bc1629b5e",
                    "sense_definition": "открыто и прямо высказывать, рассказывать всё без утайки",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_disclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не бойся и сразу <w>выкладывай</w> всю правду, иначе будет только хуже.",
                            "target_lang_translations": {
                                "en": "Don't be afraid and just <w>spill</w> the whole truth right away, or it will only get worse."
                            }
                        },
                        {
                            "text": "Она всегда без стеснения <w>выкладывает</w> свои мысли наболевшем.",
                            "target_lang_translations": {
                                "en": "She always <w>speaks out</w> frankly about what troubles her without any hesitation."
                            }
                        }
                    ],
                    "synonyms": [
                        "сообщать"
                    ],
                    "common_phrases": [
                        "выкладывать всю правду",
                        "выкладывать начистоту"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to tell or disclose everything openly and straightforwardly without withholding"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spill",
                                "target_lang_sense_clarification": "revealing all information or the truth"
                            },
                            {
                                "target_lang_word": "lay bare",
                                "target_lang_sense_clarification": "revealing thoughts or facts completely"
                            },
                            {
                                "target_lang_word": "blurt out",
                                "target_lang_sense_clarification": "saying something directly and bluntly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78ded1d6-ae65-3dac-9e77-f2f4212ef4de",
                    "sense_definition": "покрывать поверхность материалом, плотно размещая его по плоскости; выстилать",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction_lining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастера будут <w>выкладывать</w> плиткой стены в ванной комнате всю следующую неделю.",
                            "target_lang_translations": {
                                "en": "The craftsmen will be <w>tiling</w> the bathroom walls all next week."
                            }
                        },
                        {
                            "text": "Рабочие продолжают ровно <w>выкладывать</w> плитку на центральной площади города.",
                            "target_lang_translations": {
                                "en": "Workers continue to evenly <w>pave</w> tiles in the city's central square."
                            }
                        }
                    ],
                    "synonyms": [
                        "выстилать",
                        "покрывать"
                    ],
                    "common_phrases": [
                        "выкладывать плиткой",
                        "выкладывать камнем"
                    ],
                    "target_lang_definitions": {
                        "en": "to cover or pave a surface closely with tiles, stones, or similar materials"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tile",
                                "target_lang_sense_clarification": "covering with tiles"
                            },
                            {
                                "target_lang_word": "pave",
                                "target_lang_sense_clarification": "covering a ground surface with stone or brick"
                            },
                            {
                                "target_lang_word": "line",
                                "target_lang_sense_clarification": "covering an interior surface with material"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8a6ed8d-6e90-31c3-887f-b218d50d1c28",
                    "sense_definition": "возводить, сооружать какую-либо конструкцию из кирпича или камня",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction_lining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный печник не торопясь <w>выкладывает</w> печь из красного огнеупорного кирпича.",
                            "target_lang_translations": {
                                "en": "The experienced stove-maker unhurriedly <w>builds</w> the stove out of red refractory brick."
                            }
                        },
                        {
                            "text": "Строители вручную <w>выкладывали</w> стены дома на протяжении всего теплого сезона.",
                            "target_lang_translations": {
                                "en": "The builders were manually <w>laying</w> the walls of the house throughout the entire warm season."
                            }
                        }
                    ],
                    "synonyms": [
                        "выстраивать"
                    ],
                    "common_phrases": [
                        "выкладывать печь",
                        "выкладывать стену"
                    ],
                    "target_lang_definitions": {
                        "en": "to construct or build a structure out of brick or stone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay",
                                "target_lang_sense_clarification": "laying bricks or stones to build a structure"
                            },
                            {
                                "target_lang_word": "build",
                                "target_lang_sense_clarification": "constructing out of masonry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a704add0-cfb4-394e-b070-5c7878596f5a",
                    "sense_definition": "отдавать или тратить крупную сумму денег, расплачиваться",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый месяц приходится <w>выкладывать</w> круглую сумму за аренду квартиры.",
                            "target_lang_translations": {
                                "en": "Every month you have to <w>fork out</w> a tidy sum for apartment rent."
                            }
                        },
                        {
                            "text": "За качественный ремонт машины водители нередко <w>выкладывают</w> последние деньги.",
                            "target_lang_translations": {
                                "en": "Drivers often <w>cough up</w> their last money for a quality car repair."
                            }
                        }
                    ],
                    "synonyms": [
                        "платить"
                    ],
                    "common_phrases": [
                        "выкладывать круглую сумму",
                        "выкладывать деньги"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to shell out or pay a large amount of money"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fork out",
                                "target_lang_sense_clarification": "spending or paying money, often reluctantly"
                            },
                            {
                                "target_lang_word": "shell out",
                                "target_lang_sense_clarification": "paying a significant amount"
                            },
                            {
                                "target_lang_word": "cough up",
                                "target_lang_sense_clarification": "reluctantly parting with money"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "346f5bd0-2cc0-3b0f-a2b9-f04cecd0fd0e",
                    "sense_definition": "располагать элементы на поверхности в виде узора, мозаики или надписи",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "decorating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети с удовольствием учатся <w>выкладывать</w> мозаику из разноцветных стеклянных деталей.",
                            "target_lang_translations": {
                                "en": "Children gladly learn to <w>lay out</w> mosaics made of colorful glass pieces."
                            }
                        },
                        {
                            "text": "Художник терпеливо <w>выкладывал</w> сложный узор из мелких камней на садовой дорожке.",
                            "target_lang_translations": {
                                "en": "The artist patiently <w>pieced together</w> an intricate pattern from small stones along the garden path."
                            }
                        }
                    ],
                    "common_phrases": [
                        "выкладывать узор",
                        "выкладывать мозаику"
                    ],
                    "target_lang_definitions": {
                        "en": "to arrange pieces or elements into a pattern, mosaic, or lettering on a surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay out",
                                "target_lang_sense_clarification": "arranging pieces into a design or mosaic"
                            },
                            {
                                "target_lang_word": "piece together",
                                "target_lang_sense_clarification": "forming a pattern or mosaic out of elements"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3b41eac-9b84-33aa-9cba-1c566716f0e1",
                    "sense_definition": "нашивать тесьму, шнур или полосы на ткань для украшения",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decorating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастерицы любили богато <w>выкладывать</w> золотым шнуром праздничные бархатные кафтаны.",
                            "target_lang_translations": {
                                "en": "Craftswomen loved to lavishly <w>trim</w> festive velvet caftans with gold cord."
                            }
                        },
                        {
                            "text": "Воротник старинного мундира портные тщательно <w>выкладывали</w> серебряной тесьмой.",
                            "target_lang_translations": {
                                "en": "Tailors carefully <w>bordered</w> the collar of the antique uniform with silver braid."
                            }
                        }
                    ],
                    "synonyms": [
                        "нашивать"
                    ],
                    "common_phrases": [
                        "выкладывать шнуром",
                        "выкладывать тесьмой"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to trim or embellish fabric by sewing on braid, cord, or ribbon"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trim",
                                "target_lang_sense_clarification": "decorating fabric with braid or cord"
                            },
                            {
                                "target_lang_word": "braid",
                                "target_lang_sense_clarification": "ornamenting with decorative cord or tape"
                            }
                        ]
                    }
                }
