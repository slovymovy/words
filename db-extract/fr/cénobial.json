                        ]
                    },
                    {
                        "sense_id": "d3b1f4a7-886e-3bd5-b040-51b84e2a1874",
                        "entry_id": "2c02cd56-14a2-3c06-9f54-7feabbf98a91",
                        "glosses": [
                            "Relatif aux cénobes, colonie d'organismes microscopique, unicellulaire et solitaire ou à l’un des individus de cette colonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06663c22-c23b-4898-9f03-b91987244e47",
                                "sense_id": "d3b1f4a7-886e-3bd5-b040-51b84e2a1874",
                                "text": "C’est à la fin de l’été que ce plancton atteint son maximum ; au printemps, les grandes Volvocacées cénobiales sont souvent dominantes, […]."
                            },
                            {
                                "example_id": "d27054c8-ec89-47d0-a3ad-f7ccc36b1aa6",
                                "sense_id": "d3b1f4a7-886e-3bd5-b040-51b84e2a1874",
                                "text": "L’ordre des Chlorococcales groupe un grand nombre de genres d’Algues vertes, unicellulaires ou céno­biales pourvues d'une membrane bien définie."
                            }
                        ]
                    }
