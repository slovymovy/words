            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d9399dc4-7955-33af-a827-38bca68ee9a5",
                    "sense_definition": "D'une manière sûre, incontestable et sans aucun doute.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle mesure va <w>certainement</w> améliorer les conditions de vie des habitants."
                        },
                        {
                            "text": "Il ne veut <w>certainement</w> pas rater son train pour rentrer chez lui."
                        }
                    ],
                    "synonyms": [
                        "assurément",
                        "sûrement"
                    ],
                    "antonyms": [
                        "incertainement"
                    ],
                    "common_phrases": [
                        "certainement pas",
                        "très certainement"
                    ]
                },
                {
                    "sense_id": "013b4006-8f05-3fa1-b874-069b8e15de6b",
                    "sense_definition": "Selon toute vraisemblance, avec une grande probabilité mais sans garantie absolue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "probabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme les volets sont fermés, ils sont <w>certainement</w> déjà partis en vacances."
                        },
                        {
                            "text": "Le colis a été expédié hier et arrivera <w>certainement</w> avant la fin de semaine."
                        }
                    ],
                    "synonyms": [
                        "sans doute",
                        "sûrement"
                    ]
                },
                {
                    "sense_id": "8d7d9047-a32e-33d2-9772-b56477563af6",
                    "sense_definition": "Par ironie, pour marquer l'incrédulité ou le doute face à une promesse ou affirmation invraisemblable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu prétends courir un marathon sans entraînement, mais <w>certainement</w>, on te croit tous !"
                        },
                        {
                            "text": "Il promet de ranger toute la maison avant ce soir, oui, <w>certainement</w> !"
                        }
                    ],
                    "common_phrases": [
                        "mais certainement"
                    ]
                }
            ]
        }
    ]
