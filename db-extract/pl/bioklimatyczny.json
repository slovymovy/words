                        ]
                    },
                    {
                        "translation_id": "e8d18828-3282-4f23-b47c-ebff9f6a90b7",
                        "source_entry_id": "6c17f370-19f3-33b4-8c0d-9146728bd741",
                        "source_sense_id": "4a3374f8-3ed9-3ded-b56a-c32e40cc5c7f",
