            "senses": [
                {
                    "sense_id": "edb2913e-095d-30f2-83e6-50ede731fa17",
                    "sense_definition": "Een vrij harde klank geproduceerd met stemgeluid, vaak om aandacht te trekken.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De luide <w>roep</w> van de vogel klinkt door het hele dorp.",
                            "target_lang_translations": {
                                "ru": "Громкий <w>крик</w> птицы разносится по всей деревне.",
                                "en": "The loud <w>call</w> of the bird sounds through the whole village.",
                                "fr": "Le <w>cri</w> strident de l'oiseau résonne dans tout le village."
                            }
                        },
                        {
                            "text": "Ik hoorde een <w>roep</w> om hulp vanuit het donkere bos.",
                            "target_lang_translations": {
