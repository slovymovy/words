                        "examples": [
                            {
                                "example_id": "59335ce0-bf42-4362-b578-2702ea489382",
                                "sense_id": "4789ccb6-b65c-39b7-bae6-06d23354f549",
                                "text": "Les diables et diablettes entrent de différents côtés, très-gaiement, en dansant aussi - Gigue générale et infernale."
                            }
                        ]
                    },
                    {
                        "sense_id": "afdb6c42-1410-3094-a6ec-130c078d0a6e",
                        "entry_id": "5eb28c08-f796-368d-a708-9d2145af29c3",
                        "glosses": [
                            "Femme démoniaque."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f8c8331e-36e1-496b-872e-4e82830aa605",
                                "sense_id": "afdb6c42-1410-3094-a6ec-130c078d0a6e",
                                "text": "C’est une monstre, une diablette, qui tient des riches ses atours."
                            }
                        ]
                    },
                    {
                        "sense_id": "2faaec1b-5e34-3c52-9b16-78f4736bff1f",
                        "entry_id": "5eb28c08-f796-368d-a708-9d2145af29c3",
                        "glosses": [
                            "Fille espiègle, malicieuse."
                        ],
                        "tags": [
                            "Affectueux"
                        ],
                        "examples": [
                            {
                                "example_id": "8b4b9e34-61e3-49bc-b7d7-7d12973d2200",
                                "sense_id": "2faaec1b-5e34-3c52-9b16-78f4736bff1f",
                                "text": "Pendant ce temps, le Toulouse-Lautrec est rapidement adjugé au père de ma diablette."
                            }
                        ]
                    }
