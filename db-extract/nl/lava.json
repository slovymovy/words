        "nl-extract.jsonl": [
            {
                "entry_id": "a6036cbc-db71-3f63-a5e7-3bc93839e6b5",
                "word": "lava",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "27e1d8db-209d-36c6-a957-642bc032c0f5",
                        "entry_id": "a6036cbc-db71-3f63-a5e7-3bc93839e6b5",
                        "glosses": [
                            "vloeibaar gesteente dat uit een vulkaan tevoorschijn komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3108d5-c904-4423-9348-bec7b5be9cc0",
                                "sense_id": "27e1d8db-209d-36c6-a957-642bc032c0f5",
                                "text": "Op het eiland Hawaï is lava een veelgezien verschijnsel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcad1be5-edfa-4818-96fa-e86a57ed0715",
                        "source_entry_id": "a6036cbc-db71-3f63-a5e7-3bc93839e6b5",
                        "source_sense_id": "27e1d8db-209d-36c6-a957-642bc032c0f5",
                        "source_sense_description": "vloeibaar gesteente dat uit een vulkaan tevoorschijn komt",
                        "target_lang_word": "Lava",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lava",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                        "entry_id": "8a611e78-feca-3434-9cbe-6fe7e1b2de1d",
                                        "glosses": [
                                            "eruptiertes Magma und das beim Erkalten daraus entstehende Gestein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a87c154-bfa8-4853-9d20-1d151af57c9a",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "Pompeji wurde im Jahre 79 von Lava und Asche aus dem Vesuv zerstört."
                                            },
                                            {
                                                "example_id": "a90cffb5-70cf-45e7-bd82-4f5055d5de85",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Andere, heftiger dagegen, ließen erſt glühen und ſchmelzen, auch durchaus ein Feuer obwalten, das, nachdem es auf der Oberfläche genugſam gewirkt, zuletzt ins Tiefſte zurückgezogen, ſich noch immer durch die ungeſtüm ſowohl im Meer als auf der Erde wütenden Vulkane betätigte und durch ſukzeſſiven Auswurf und gleichfalls nach und nach überſtrömende Laven die höchſten Berge bildete; wie ſie denn überhaupt den Andersdenkenden zu Gemüte führten, daß ja ohne Feuer nichts heiß werden könne, auch ein tätiges Feuer immer einen Herd vorausſetze.“"
                                            },
                                            {
                                                "example_id": "a382d258-d616-457b-9c0c-599b743a4919",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Ich nahm einen Führer, der eigentlich nicht nötig war; man unterscheidet ja leicht die erkalteten Laven von den heißen, die einem die Schuhe versengen.“"
                                            },
                                            {
                                                "example_id": "e834aa9c-bee0-43c6-a117-d498e371cd38",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Das Ganze ist nichts anders als ein riesiger, erloschener Krater, der größte auf unserer Erde – der Ngorongoro-Krater. Wo einmal Lava brodelte, da dehnt sich jetzt unten eine riesige, von steilen Kraterwänden umgebene grüne Weidefläche.“"
                                            },
                                            {
                                                "example_id": "73f0df98-a135-4fb9-8ad0-6bfd672361ef",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Du hast von Bauern gehört, denen die Glut aus einem feuerspeienden Berg die Hütten wegfraß und das Fluchthemd versengte. Sobald der Berg sein Glutmaul schloß, nisteten sie sich wieder in die noch warme Lava, bauten neue Hütten, pflanzten, schufteten, tranken, tanzten, trieben es toll und vergaßen den unbewältigten Berg.“"
                                            },
                                            {
                                                "example_id": "9bc65792-ecfc-4e4c-8898-7f76abd295db",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Das Alter dieser Basalte aber ist höchstwahrscheinlich mindelzeitlich, da vollkommen gleichartige Laven am Nordwestrand des inneren Campidano einer marinen 60-m-Terrasse auflagern, die aufgrund ihrer Höhenlage als günz/mindelzeitlich (Milazzo) angesehen werden muß.“"
                                            },
                                            {
                                                "example_id": "96051892-faf4-442d-8d1c-a16171157769",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Der Vulkan spie Lava 150 Meter und Asche bis zu 2.000 Meter hoch in die Luft.“"
                                            },
                                            {
                                                "example_id": "f191e00c-99b1-4dfb-bbe5-e4d404ff69ae",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Die Untersuchungen Foleys und seines Teams gehen auf Laven und Schmelzen der letzten 100 Jahre aus dem Vulkanfeld zurück.“"
                                            },
                                            {
                                                "example_id": "f0bea620-e2e7-4f1a-8fce-f266926a2a43",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Der Vulkantrichter war seit Jahrhunderten erkaltet, sein Boden mit versteinerter Lava bedeckt.“"
                                            },
                                            {
                                                "example_id": "0550496a-0b00-4955-a636-2e2a967057d4",
                                                "sense_id": "e29a8c47-dbcf-3d93-94c5-b2627581094f",
                                                "text": "„Schildvulkane sind buckelförmige Erhebungen von sehr verschiedenen Ausmaßen, die fast ausschließlich durch dünnflüssige Laven gebildet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
