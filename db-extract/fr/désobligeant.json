                                        "sense_id": "828ea207-3375-39b3-ba52-7639a793ca3a",
                                        "entry_id": "4d7031b0-86b9-3e80-a0a3-a40183c47c9f",
                                        "glosses": [
                                            "Snide and sarcastic; usually out of irritation."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d28f4c-3260-4e6b-81ec-3983e405e594",
                                                "sense_id": "828ea207-3375-39b3-ba52-7639a793ca3a",
                                                "text": "In spite of its inherent banality, and because my editors let me relieve my dyspepsia by writing snarky captions, it is regularly one of the more popular destinations on the Globe and Mail website."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06721a1-30ee-3366-a183-7913fbd6b4ca",
                                        "entry_id": "4d7031b0-86b9-3e80-a0a3-a40183c47c9f",
                                        "glosses": [
                                            "Irritable, irritated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df12b9a-b9a9-4afa-a8ed-8a59d59bf1e4",
                                                "sense_id": "b06721a1-30ee-3366-a183-7913fbd6b4ca",
                                                "text": "'I hate you,' she said briefly, and Philip understood. 'I couldn't help it,' he said; 'I did want to do something by myself.' And Lucy understood. 'And besides,' he said, 'I was coming back for you. Don't be snarky about it, Lu."
                                            },
                                            {
                                                "example_id": "e45fda81-ab7c-49b8-b367-e7b1fb0472be",
                                                "sense_id": "b06721a1-30ee-3366-a183-7913fbd6b4ca",
                                                "text": "'E barks. \"I'll do me work meself, yeh 'ear?\" An' then 'e gits so snarky that I clear."
                                            }
                                        ]
                                    }
                                ]
                            }
