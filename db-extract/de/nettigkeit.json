                "senses": [
                    {
                        "sense_id": "9bac02cd-4235-3a3a-9b0c-d4204bb255bf",
                        "entry_id": "2f2a2f60-dae8-3f4f-a544-26911c48e019",
                        "glosses": [
                            "Verhalten, anderen gegenüber nett zu sein"
                        ],
                        "tags": [
                            "im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "96a2161a-7626-42b7-9c18-eeaf21b8ab53",
                                "sense_id": "9bac02cd-4235-3a3a-9b0c-d4204bb255bf",
                                "text": "„Die Leute im Dorf kauften trotzdem bei ihr ein, sie taten es aus Nettigkeit, kauften Brot und Milch und Butter und versteckten die Einkaufstüten aus dem grpßen Supermarkt hinten im Auto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "49e54e61-27bf-386b-a1bd-a51f2039bfad",
                        "entry_id": "2f2a2f60-dae8-3f4f-a544-26911c48e019",
                        "glosses": [
                            "Handlung oder Äußerung, die als nett verstanden werden"
                        ],
                        "tags": [
                            "im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "eeb8f551-3130-4287-8368-031d52b90e6a",
                                "sense_id": "49e54e61-27bf-386b-a1bd-a51f2039bfad",
                                "text": "„Als er merkte, dass er damit keinen Erfolg haben würde, war Schluss mit den Nettigkeiten, er packte meinen Arm und schrie mich auf Arabisch an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
