                        "source_entry_id": "2962217a-e2b5-3fc2-9cac-8fa830c88428",
                        "source_sense_description": "расходование; действие по значению гл. «расходовать»; утрата каких-либо припасов или средств в процессе их использования",
                        "target_lang_word": "expense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                        "entry_id": "d59c5df7-2ffe-36a8-8726-ee8c15fa81b9",
                                        "glosses": [
                                            "A spending or consuming, often a disbursement of funds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a99ef0-203c-430a-98d0-0ef6ed4ccca7",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "She went to great expense to ensure her children would get the best education."
                                            },
                                            {
                                                "example_id": "2c1fbf30-2373-41b7-a5b4-188d7c443281",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "Buying the car was a big expense, but will be worth it in the long run."
                                            },
                                            {
                                                "example_id": "fbc21156-e973-401b-b4b2-f0ab3c2850bf",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "We had a training weekend in New York, at the expense of our company."
                                            },
                                            {
                                                "example_id": "5b28e97c-42fe-4b05-bd18-4a75f30be062",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "Husband nature's riches from expense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4b7d14-2340-3ad5-9c27-b3f0269febd3",
                                        "entry_id": "d59c5df7-2ffe-36a8-8726-ee8c15fa81b9",
                                        "glosses": [
                                            "The elimination or consumption of something, sometimes with the notion of loss or damage to the thing eliminated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ea0a94-5a8b-4146-bda7-6ededfa6451b",
                                                "sense_id": "dd4b7d14-2340-3ad5-9c27-b3f0269febd3",
                                                "text": "Jones reached the final at the expense of Smith, who couldn't beat him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31edf576-5731-34fa-b3df-46e3c4f2177d",
                                        "entry_id": "d59c5df7-2ffe-36a8-8726-ee8c15fa81b9",
                                        "glosses": [
                                            "Loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2841b658-680d-411f-a5e0-c7b1ce142307",
                                                "sense_id": "31edf576-5731-34fa-b3df-46e3c4f2177d",
                                                "text": "And moan the expense of many a vanished sight."
                                            }
                                        ]
                                    }
                                ]
