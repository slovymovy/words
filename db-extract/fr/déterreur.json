                "senses": [
                    {
                        "sense_id": "78ab7d06-512d-342e-b38b-e06830ab62e2",
                        "entry_id": "118fe631-27ee-3966-9538-cf716bf72b63",
                        "glosses": [
                            "Homme qui fait métier de déterrer furtivement les cadavres pour les vendre aux chirurgiens, en Angleterre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ac7c96-23de-47e8-a9e4-3a6899c8f153",
                                "sense_id": "78ab7d06-512d-342e-b38b-e06830ab62e2",
                                "text": "Ce matin, raconta-t-elle, Phillips a fait marcher le nouvel employé de la morgue en affirmant que Thorpe achetait les corps destinés aux dissections à des déterreurs de cadavres !"
                            }
                        ]
                    },
                    {
                        "sense_id": "84a7d12f-f7db-3af2-8a71-6ebc5a8bce82",
                        "entry_id": "118fe631-27ee-3966-9538-cf716bf72b63",
                        "glosses": [
                            "Animal qui déterre les cadavres pour les manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5c1fab-2e01-41f3-9ae8-4b2526126379",
                                "sense_id": "84a7d12f-f7db-3af2-8a71-6ebc5a8bce82",
                                "text": "Quel immense silence hostile ! Il n'était rompu de loin en loin que par les hurlements des chiens déterreurs de cadavres."
                            },
                            {
                                "example_id": "b8a26694-caf1-48c2-83ab-04b7855d9335",
                                "sense_id": "84a7d12f-f7db-3af2-8a71-6ebc5a8bce82",
                                "text": "Le calme se fit. Le vent partait du cimetière, et, dans le grand silence du milieu de la nuit, on entendait distinctement la note aiguë des chacals, le concert sinistre des déterreurs de morts."
                            }
                        ]
                    },
                    {
                        "sense_id": "cacea804-2397-3a20-a45e-32cd0e4796c1",
                        "entry_id": "118fe631-27ee-3966-9538-cf716bf72b63",
                        "glosses": [
                            "Celui qui est habile à découvrir les raretés, les curiosités."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a9397ff7-8891-43ae-94c2-ab66ad58b041",
                                "sense_id": "cacea804-2397-3a20-a45e-32cd0e4796c1",
                                "text": "— Mais que lisiez-vous donc là ?\n— Un roman de Walter Scott.\n— Je m’explique maintenant vos fréquentes interruptions. — Oh ! l’ennuyeux écrivain ! — Un poudreux déterreur de chroniques ! […] Quelle différence chez nos bons romanciers français, où la passion et la morale l’emportent toujours sur la description matérielle des objets !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efc6cc83-f2ad-454c-8e63-d5369ded73b0",
                        "source_entry_id": "118fe631-27ee-3966-9538-cf716bf72b63",
