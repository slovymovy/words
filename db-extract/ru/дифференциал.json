                                "target_senses": [
                                    {
                                        "sense_id": "a37f2d23-c1c4-3d1a-97ea-69382bf99a73",
                                        "entry_id": "ae273fc2-9a65-3458-8534-01fa6314cfe9",
                                        "glosses": [
                                            "Of or pertaining to a difference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1ea34b-c360-4025-825d-9d48d566e1d7",
                                                "sense_id": "a37f2d23-c1c4-3d1a-97ea-69382bf99a73",
                                                "text": "[Caspar Schetz, Baron of Grobbendonck] was regularly in the pay of Sir Thomas Gresham, to whom he produced differential favours, and by whose government he was rewarded by gold chains and presents of hard cash, bestowed as secretly as the equivalent was conveyed adroitly."
                                            },
                                            {
                                                "example_id": "0999aa31-f3f9-43b8-bd64-780772816b09",
                                                "sense_id": "a37f2d23-c1c4-3d1a-97ea-69382bf99a73",
                                                "text": "differential characteristics"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d02e80-9fc0-3c3c-b8c4-54d8507dbb8e",
                                        "entry_id": "ae273fc2-9a65-3458-8534-01fa6314cfe9",
                                        "glosses": [
                                            "Dependent on, or making a difference; distinctive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae8c2284-88c6-36fa-8c82-9407863a6d39",
