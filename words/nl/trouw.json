    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f78e55f-614c-330c-836e-ad224ea285a7",
                    "sense_definition": "Iemand of iets waar je op kunt rekenen en die je niet in de steek laat",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "loyalty_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is al jaren een <w>trouwe</w> werknemer voor zijn baas.",
                            "target_lang_translations": {
                                "ru": "Он уже много лет <w>верный</w> сотрудник своего начальника.",
                                "en": "He has been a <w>loyal</w> employee to his boss for years.",
                                "it": "È da anni un dipendente <w>fedele</w> per il suo capo."
                            }
                        },
                        {
                            "text": "De hond bleef zijn baasje altijd <w>trouw</w>, wat er ook gebeurde.",
                            "target_lang_translations": {
                                "ru": "Собака всегда оставалась <w>преданной</w> своему хозяину, что бы ни случилось.",
                                "en": "The dog always remained <w>faithful</w> to its owner, no matter what happened.",
                                "it": "Il cane rimase sempre <w>fedele</w> al suo padrone, qualunque cosa accadesse."
                            }
                        }
                    ],
                    "synonyms": [
                        "betrouwbaar",
                        "loyaal",
                        "standvastig"
                    ],
                    "antonyms": [
                        "onbetrouwbaar",
                        "ontrouw",
                        "verraderlijk"
                    ],
                    "common_phrases": [
                        "trouwe dienst",
                        "trouw blijven",
                        "trouwe vriend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, на кого можно положиться и кто не подведет",
                        "en": "Someone or something you can rely on and who will not let you down",
                        "it": "Persona o cosa su cui si può fare affidamento e che non delude o non abbandona"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "надежный, постоянный в чувствах"
                            },
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "исполненный любви и верности"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "loyal",
                                "target_lang_sense_clarification": "giving or showing firm and constant support"
                            },
                            {
                                "target_lang_word": "faithful",
                                "target_lang_sense_clarification": "steadfast in affection or allegiance"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "fedele",
                                "target_lang_sense_clarification": "costante nei sentimenti o devoto a qualcuno"
                            },
                            {
                                "target_lang_word": "leale",
                                "target_lang_sense_clarification": "che agisce con franchezza e rettitudine"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7a0991e-f599-38d4-8cc3-158412425c85",
                    "sense_definition": "De eigenschap dat men zich aan een verbintenis, belofte of persoon houdt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loyalty_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat toonde grote <w>trouw</w> aan zijn land tijdens de oorlog.",
                            "target_lang_translations": {
                                "ru": "Солдат проявил большую <w>верность</w> своей стране во время войны.",
                                "en": "The soldier showed great <w>loyalty</w> to his country during the war.",
                                "it": "Il soldato dimostrò grande <w>lealtà</w> al suo paese durante la guerra."
                            }
                        },
                        {
                            "text": "Zij beloofden elkaar eeuwige <w>trouw</w> tijdens de ceremonie.",
                            "target_lang_translations": {
                                "ru": "Они обещали друг другу вечную <w>верность</w> во время церемонии.",
                                "en": "They promised each other eternal <w>fidelity</w> during the ceremony.",
                                "it": "Si promisero eterna <w>fedeltà</w> durante la cerimonia."
                            }
                        }
                    ],
                    "synonyms": [
                        "loyaliteit"
                    ],
                    "antonyms": [
                        "ontrouw",
                        "verraad"
                    ],
                    "common_phrases": [
                        "eeuwige trouw",
                        "trouw zweren"
