                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e23c782-07f9-4d24-be10-1d010884a0da",
                                "sense_id": "caa6d9b0-36a9-3825-a0ab-e0e14a7b6dc2",
                                "text": "„Eine heiße Dusche, Zähneputzen und ein gutes Hörbuch sind eine Möglichkeit, um die Abendroutine zu gestalten.“"
                            },
                            {
                                "example_id": "5b8c41bd-18d6-4219-b98f-e1bd2ff69f9b",
                                "sense_id": "caa6d9b0-36a9-3825-a0ab-e0e14a7b6dc2",
                                "text": "„Bei Veränderungen waren die häufigsten Beobachtungen der Übergang von tagaktiven Tieren zur Abendroutine, während dämmerungs- und nachtaktive Arten „aufwachten“ […]“"
                            },
                            {
                                "example_id": "b84aab07-4201-4062-b8ed-9a04a996e494",
                                "sense_id": "caa6d9b0-36a9-3825-a0ab-e0e14a7b6dc2",
                                "text": "„Wie wäre es, mal eine Abendroutine ohne Handy, PC oder Fernseher ausprobieren?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
