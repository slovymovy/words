                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3669e63a-2b2e-4166-b0ea-a7ff9ef7ac23",
                                "sense_id": "d8ce0062-baca-3e56-830d-a807ac4a0e25",
                                "text": "Ze leerde heus veel aan de universiteit, maar het mooiste leerde ze in de jaren die volgden: vissen, werken op innovatieve boerderijen, voedselbossen starten, bodemonderzoek doen."
                            },
                            {
                                "example_id": "666ab7aa-185b-49ea-99e8-8dc35e0fa55e",
                                "sense_id": "d8ce0062-baca-3e56-830d-a807ac4a0e25",
                                "text": "Omdat het om nieuwe bebouwing gaat die niet in het huidige bestemmingsplan past, moet een bodemonderzoek worden uitgevoerd en een flora- en faunaonderzoek. De leefwereld van planten en dieren mag niet worden aangetast."
                            }
                        ]
                    }
