                ],
                "senses": [
                    {
                        "sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
                        "entry_id": "546d82f7-9631-319b-8fd0-f3b575705cd0",
                        "glosses": [
                            "die - meist nicht schriftlich überlieferte, sondern durch Rekonstruktion erschlossene - Sprache, aus der heraus sich im Lauf der Zeit Tochtersprachen entwickelt haben, die ihrerseits dann eine Sprachfamilie bilden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bee7e80-e489-4774-b15c-db0b387fbd0f",
                                "sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
                                "text": "Für die romanischen Sprachen ist Latein eine Grundsprache."
                            },
                            {
                                "example_id": "e76f8fa6-e0f9-4dc0-b831-8be6c2e0e72f",
                                "sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
                                "text": "Urgermanisch ist eine nicht belegte, sondern nur rekonstruierte Grundsprache der germanischen Sprachen."
                            },
                            {
                                "example_id": "b7ca0308-7e07-43e0-a2d7-8d68c08d4a97",
                                "sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
                                "text": "„Bestimmte Gesetze dafür (sogenannte „Auslautgesetze“) lassen sich in gewissem Umfang schon für die indogermanische Grundsprache erkennen.“"
                            },
                            {
                                "example_id": "22222289-28c1-4e33-97cc-11276ce17494",
                                "sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
                                "text": "„Die historische Betrachtungsweise galt auch den Junggrammatikern weiterhin als die einzig denkbare; ihre zentrale Aufgabe sahen sie in der Rekonstruktion der Sprachgeschichte und insbesondere der indoeuropäischen Grundsprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5234f1ee-1bd1-3b4f-959d-1c2ebff3a5e6",
                        "entry_id": "546d82f7-9631-319b-8fd0-f3b575705cd0",
                        "glosses": [
                            "der Kern von Regeln und Wörtern einer Sprache, die jemand zuerst lernen kann/soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58184209-dbdc-45c2-a858-9c9d6ceb19b1",
                                "sense_id": "5234f1ee-1bd1-3b4f-959d-1c2ebff3a5e6",
                                "text": "„Eine eigentliche, objektive, empirische Erforschung der Grundsprache setzte jedoch erst mit Kaedings bahnbrechendem Häufigkeitswörterbuch der deutschen Sprache, d.h. der deutschen Sprachformen, ein, obwohl sein Ausgangspunkt bei der Kurzschrift lag.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f62beab7-c1a3-4ae0-8c66-1dcf40ab6afd",
                        "source_entry_id": "546d82f7-9631-319b-8fd0-f3b575705cd0",
                        "source_sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
