                "senses": [
                    {
                        "sense_id": "3f1091d9-9088-3dd0-800e-fe4857eb09e9",
                        "entry_id": "b3ea9afe-f595-38f2-97cb-bb627da3d46c",
                        "glosses": [
                            "разг. то же, что времяпрепровождение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f0e8df-81dc-4862-8c54-793a12c41185",
                                "sense_id": "3f1091d9-9088-3dd0-800e-fe4857eb09e9",
                                "text": "Всё их времяпровождение, все разговоры, вся внешняя обстановка их быта уже новые, не прежние."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f16d9fe3-6249-43dc-8444-0e525bed0194",
                        "source_entry_id": "b3ea9afe-f595-38f2-97cb-bb627da3d46c",
                        "source_sense_id": "3f1091d9-9088-3dd0-800e-fe4857eb09e9",
                        "target_lang_word": "pastime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                        "entry_id": "725f17ec-ad57-3ff8-b811-2213dfcde5cf",
                                        "glosses": [
                                            "Something which amuses, and serves to make time pass agreeably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dddf03-b797-4fba-b846-66b78f1bce91",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "Chatting is a pleasant pastime."
                                            },
                                            {
                                                "example_id": "f81c6e4f-c6e5-4707-ae72-4faa81ea8eac",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "Hunting and fishing, the most important employments of mankind in the rude state of society, become in its advanced state their most agreeable amusements, and they pursue for pleasure what they once followed from necessity. In the advanced state of society, therefore, they are all very poor people who follow as a trade what other people pursue as a pastime."
                                            },
                                            {
                                                "example_id": "938ee823-306b-44de-9bbb-4a7bb9798944",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "[…]lax court morals and the absurd chivalry business were in full feather, and the joust and the tournament were the frequent pastime of titled fine gentlemen who could fight better than they could spell..."
                                            },
                                            {
                                                "example_id": "649854b3-30ff-4af7-a89c-d52380cc6f75",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "An indulgent playmate, Grannie would lay aside the long scratchy-looking letter she was writing (heavily crossed ‘to save notepaper’) and enter into the delightful pastime of ‘a chicken from Mr Whiteley's’."
                                            },
                                            {
                                                "example_id": "0fcff769-0a45-47da-b7f7-9968ea9740ef",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "And your pastimes, consisted of the strange\nAnd twisted and deranged\nAnd I hate that little game you had called\n\"Crying Lightning\""
                                            },
                                            {
                                                "example_id": "69ccfd09-7f9a-42b6-b0ec-631d6dcee994",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "Nor would there be an opportunity for the media's favorite pastime of exposing conflict among his advisors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pastime",
                                "target_lang_code": "en",
                                "target_senses": [
