                    {
                        "translation_id": "fec1b786-533f-4949-96ca-846f5282394c",
                        "source_entry_id": "a38eda7d-1dc1-346f-9b5d-4237c105c4a8",
                        "source_sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                        "target_lang_word": "wintry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
