                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37143e26-c6b9-49a6-9d34-ebe025c47d9c",
                                                "sense_id": "de9861de-e494-32a3-ab64-dfc2a4d71972",
                                                "text": "A comfortable grip is ensured by smoothing the surface of the handle and radiusing the edge."
                                            }
