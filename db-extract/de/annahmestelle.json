                "senses": [
                    {
                        "sense_id": "55e069e1-8c25-32ea-be22-c48d84d62907",
                        "entry_id": "9e89b11f-ffe2-3b5a-989d-c2f9a78b1799",
                        "glosses": [
                            "Stelle (Geschäft, Büro oder Ähnliches), an der bestimmte Dinge entgegengenommen werden oder abgegeben werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38913971-9912-42cd-8a7f-588d97c1ddee",
                                "sense_id": "55e069e1-8c25-32ea-be22-c48d84d62907",
                                "text": "Maria geht seit dreißig Jahren mit ihrem wöchentlichen Lottoschein zur gleichen Annahmestelle."
                            },
                            {
                                "example_id": "3ea5e98e-bdeb-452c-b580-496e91157faa",
                                "sense_id": "55e069e1-8c25-32ea-be22-c48d84d62907",
                                "text": "„Erstaunliches haben 356 Bürger von Norderstedt bei Hamburg geleistet: Über zweieinhalb Tonnen giftigen Hausmüll, die ein Volumen von zwölf Kubikmeter füllten, lieferten sie nach einem Aufruf der Stadt an eine speziell hierfür eingerichtete Annahmestelle.“"
                            },
                            {
                                "example_id": "c89afc1a-32f3-4694-8fd6-4d7d50769684",
                                "sense_id": "55e069e1-8c25-32ea-be22-c48d84d62907",
                                "text": "„Zur Infrastruktur, die den Mitarbeitern den Aufenthalt angenehm machen soll, gehört auch ein Kiosk für Alltagsbedarf, der vor Kurzem um eine Annahmestelle für eine Textilreinigung erweitert wurde, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
