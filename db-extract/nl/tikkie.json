                "senses": [
                    {
                        "sense_id": "b9f46cce-a6d2-3fb9-9e06-f4439b99f3d2",
                        "entry_id": "8632c4b6-952e-3c0a-8dc7-1e3c026375d6",
                        "glosses": [
                            "snelle, lichte stoot"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f7bcdf69-ceaa-438f-a03e-6c4062620288",
                                "sense_id": "b9f46cce-a6d2-3fb9-9e06-f4439b99f3d2",
                                "text": "Paarden wegen soms wel achthonderd kilo en jockeys racen nek aan nek. „Bij een tikkie van de concurrent breekt een paardenbot als een lucifershoutje”, aldus paardenchirurg Vos."
                            },
                            {
                                "example_id": "6311b10c-2390-480d-9df1-93513a3d54de",
                                "sense_id": "b9f46cce-a6d2-3fb9-9e06-f4439b99f3d2",
                                "text": "Op het laatst éven de rem los, dan laat je ’m een stukkie weglopen. En dan geef je ’m een slingertje, een tikkie naar rechts."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ef096c6-97f0-3679-b432-346d298f44a0",
                        "entry_id": "8632c4b6-952e-3c0a-8dc7-1e3c026375d6",
                        "glosses": [
                            "snelle, lichte stoot",
                            "bewust niet al te krachtig balcontact om een medespeler aan te spelen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "0a9c4880-19f3-4958-b22f-d67ba2822c3d",
                                "sense_id": "3ef096c6-97f0-3679-b432-346d298f44a0",
                                "text": "Paarden wegen soms wel achthonderd kilo en jockeys racen nek aan nek. „Bij een tikkie van de concurrent breekt een paardenbot als een lucifershoutje”, aldus paardenchirurg Vos."
                            },
                            {
                                "example_id": "c263379a-ece0-4ab7-a634-82a856805a25",
                                "sense_id": "3ef096c6-97f0-3679-b432-346d298f44a0",
                                "text": "Op het laatst éven de rem los, dan laat je ’m een stukkie weglopen. En dan geef je ’m een slingertje, een tikkie naar rechts."
                            },
                            {
                                "example_id": "6c2f2c88-1ade-418a-a837-df727483b4d9",
                                "sense_id": "3ef096c6-97f0-3679-b432-346d298f44a0",
                                "text": "PSV-coach Phillip Cocu, veel bekritiseerd op het gebrek aan vermaak, heeft ingegrepen. Tikkie breed is tikkie vooruit geworden, controle is avonturisme geworden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dae3f94-c1c4-3d76-8909-78a66b896b14",
                        "entry_id": "8632c4b6-952e-3c0a-8dc7-1e3c026375d6",
                        "glosses": [
                            "heel kleine hoeveelheid, zeer geringe mate"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a46379ab-8cab-4858-98cd-5f17a261aab5",
                                "sense_id": "6dae3f94-c1c4-3d76-8909-78a66b896b14",
                                "text": "Daarnaast kan satire de macht ridiculiseren, tegen de schenen schoppen, machthebbers een tikkie vermenselijken waardoor je kritisch blijft."
                            },
                            {
                                "example_id": "73831c08-1219-4691-88a4-1e630f06e4f2",
                                "sense_id": "6dae3f94-c1c4-3d76-8909-78a66b896b14",
                                "text": "Maar ik kan ook nog proeven hoe heerlijk zoet en romig die witte, versgepelde, nog een tikkie warme amandelen smaakten."
                            },
                            {
                                "example_id": "c6835190-1072-4640-a5cb-96ddfc457812",
                                "sense_id": "6dae3f94-c1c4-3d76-8909-78a66b896b14",
                                "text": "Had ze helemaal niets veranderd? „Misschien een tikkie eraf aan het begin en een tikkie erbij aan het eind. Ik begon wel heel enthousiast.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "0d23561f-99e9-3c53-bbc9-57c4dbac9975",
                        "entry_id": "8632c4b6-952e-3c0a-8dc7-1e3c026375d6",
                        "glosses": [
                            "online betalingsmogelijkheid waarbij rekeninghouders bij deelnemende banken elkaar beveiligd en snel een betalingsverzoek en een overmaking kunnen doen"
                        ],
                        "tags": [
                            "Nederland"
                        ],
                        "examples": [
                            {
                                "example_id": "38555f3d-872c-48a7-a8b8-30983e9d20b0",
                                "sense_id": "0d23561f-99e9-3c53-bbc9-57c4dbac9975",
                                "text": "Een onderbuurman heeft een eigen olijfoliewinkel in de Jordaan en als ik hem een appje stuur, staat nog dezelfde dag een prachtige fles voor de deur. Een tikkie volgt even later."
                            }
                        ]
                    }
