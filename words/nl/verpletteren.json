{
    "word_family": [
        "verpletterend",
        "verplettering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e86228f-da43-325e-98d4-336f8f4add13",
                    "sense_definition": "Met grote kracht volledig platslaan of vernielen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_vernietigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vallende rotsen konden de auto in één klap <w>verpletteren</w>.",
                            "target_lang_translations": {
                                "en": "The falling rocks could <w>crush</w> the car in a single blow."
                            }
                        },
                        {
                            "text": "Als het bouwwerk deze keer ook in de rivier stortte, zou de enorme boeggolf de huizen <w>verpletteren</w>.",
                            "target_lang_translations": {
                                "en": "If the structure collapsed into the river this time as well, the huge bow wave would <w>crush</w> the houses."
                            }
                        }
                    ],
                    "synonyms": [
                        "fijnknijpen",
                        "verbrijzelen",
                        "vermorzelen"
                    ],
                    "common_phrases": [
                        "volledig verpletteren"
                    ],
                    "target_lang_definitions": {
                        "en": "To completely flatten or destroy with great force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to press or squeeze with force so as to flatten or destroy"
                            },
                            {
                                "target_lang_word": "shatter",
                                "target_lang_sense_clarification": "to break violently into pieces"
                            },
                            {
                                "target_lang_word": "smash",
                                "target_lang_sense_clarification": "to break or crush violently"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22221e63-3e16-3e12-bb25-8a3472697056",
                    "sense_definition": "Geestelijk of emotioneel volledig overweldigen of verslaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotioneel_overweldigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het slechte nieuws leek haar volledig te <w>verpletteren</w>.",
                            "target_lang_translations": {
                                "en": "The bad news seemed to completely <w>shatter</w> her."
                            }
                        },
                        {
                            "text": "Met die harde woorden wist hij de tegenstander mentaal te <w>verpletteren</w>.",
                            "target_lang_translations": {
                                "en": "With those harsh words, he managed to mentally <w>crush</w> his opponent."
                            }
                        }
                    ],
                    "synonyms": [
                        "overweldigen",
                        "verslaan",
                        "ontmoedigen"
                    ],
                    "common_phrases": [
                        "de tegenstander verpletteren"
                    ],
                    "target_lang_definitions": {
                        "en": "To completely overwhelm or defeat mentally or emotionally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to overwhelm or subdue completely"
                            },
                            {
                                "target_lang_word": "overwhelm",
                                "target_lang_sense_clarification": "to overpower emotionally or mentally"
                            },
                            {
                                "target_lang_word": "shatter",
                                "target_lang_sense_clarification": "to emotionally defeat or dispirit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}