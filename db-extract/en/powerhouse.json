    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1686479a-b73c-3abc-a1f0-de1b9efa5206",
                "word": "powerhouse",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ceba4073-47bc-41cf-b8f9-a1731ba1141f",
                        "entry_id": "1686479a-b73c-3abc-a1f0-de1b9efa5206",
                        "tags": [
                            "plural"
                        ],
                        "form": "powerhouses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "161efb20-9475-32b8-9745-c0b1387f9621",
                        "entry_id": "1686479a-b73c-3abc-a1f0-de1b9efa5206",
                        "glosses": [
                            "A power station; the building housing a power station"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1778842-51ed-42a5-98fb-4987a45d411c",
                                "sense_id": "161efb20-9475-32b8-9745-c0b1387f9621",
                                "text": "The new powerhouse comprised two tube turbines with a total capacity of 4,500 kW under 18.3 feet head."
                            }
                        ]
                    },
                    {
                        "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                        "entry_id": "1686479a-b73c-3abc-a1f0-de1b9efa5206",
                        "glosses": [
                            "Any source of power, energy or strength; a source of influence or inspiration"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d1856de6-3d28-4e94-804c-75928151e2f5",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "The company has been a powerhouse in its industry for many years."
                            },
                            {
                                "example_id": "c0ff45da-162f-4d3c-bfb0-a4c488923af6",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "The mitochondrion is the powerhouse of the cell."
                            },
                            {
                                "example_id": "48cf856c-c25f-4033-908e-a5fd6e95747c",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "She's a powerhouse of ideas."
                            },
                            {
                                "example_id": "707d7163-a6fd-4a21-91fe-38577fe178df",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "The Soviet Union often led the world in the Olympics during the Cold War, and East Germany was an Olympic powerhouse — though athletes from both are now believed to have been systematically and massively doped[…]"
                            },
                            {
                                "example_id": "714db4ea-6072-482c-b63b-057bab6045cd",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "While the California economy maintains its powerhouse status, outranking even those of most countries, the state’s most-powerful sectors — including tech companies and supply chain logistics — have struggled to keep their footing, pummeled by high interest rates, investor skittishness, labor strife and other turmoil."
                            },
                            {
                                "example_id": "dc997ba9-e589-4db0-9fef-ce79c4b76d2c",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "Long Europe’s powerhouse, Germany is struggling with a potent mix of short-term and deeper structural problems that – along with a divided and seemingly ineffectual government – have prompted economists to talk of the “sick man of Europe”."
                            },
                            {
                                "example_id": "5f74afc0-16a0-462c-a8ee-2eb1915af31d",
                                "sense_id": "49859e7a-abb6-38f8-9ac6-e6c82243e328",
                                "text": "The vocal powerhouse has sold more than 250 million albums during her 40-year career and has won five Grammy awards."
                            }
                        ]
                    },
                    {
                        "sense_id": "e58f8701-fc6d-312c-8417-876bd7bcbe7b",
                        "entry_id": "1686479a-b73c-3abc-a1f0-de1b9efa5206",
                        "glosses": [
                            "A very good hand of cards, likely to win."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9defa316-7c27-4fa7-9ac2-7b1f097f4c8b",
                                "sense_id": "e58f8701-fc6d-312c-8417-876bd7bcbe7b",
                                "text": "A hand like A-2-3-4 is a powerhouse in Omaha/8, because it can easily make the best low hand and capture half the pot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "866d2e58-212c-4ffa-b8b3-7f4df0fd20ed",
                        "source_entry_id": "1686479a-b73c-3abc-a1f0-de1b9efa5206",
                        "source_sense_description": "source of power",
                        "target_lang_word": "zdroj",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zdroj",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb6c234-7639-3fd0-8e72-60f28f115a4b",
                                        "entry_id": "c4a376b4-b262-37dd-bd4b-dbca09129a4c",
                                        "glosses": [
                                            "objekt, ze kterého něco vychází nebo je odebíráno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2681c116-89c7-43d4-a118-742faba97d79",
                                                "sense_id": "cdb6c234-7639-3fd0-8e72-60f28f115a4b",
                                                "text": "Slunce je zdrojem tepla a světla."
                                            },
                                            {
                                                "example_id": "01e37ffd-86b0-42fa-8a8a-c171aee75696",
                                                "sense_id": "cdb6c234-7639-3fd0-8e72-60f28f115a4b",
                                                "text": "V této práci byla hlavním zdrojem informací kronika města."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb967068-3937-325b-89fb-ef79cf77e85b",
                                        "entry_id": "c4a376b4-b262-37dd-bd4b-dbca09129a4c",
                                        "glosses": [
                                            "něco, co způsobilo vznik něčeho jiného"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89a2b1c-7d08-4241-a2b1-82dee46deab9",
                                                "sense_id": "fb967068-3937-325b-89fb-ef79cf77e85b",
                                                "text": "Je nutné vypátrat zdroj nákazy a zabránit dalšímu šíření epidemie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bbad5c2-e928-41d4-964b-2d5b82c78835",
