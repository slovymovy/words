                    },
                    {
                        "translation_id": "a4e948bd-d9a8-4a52-bb6c-a32dcd4fc346",
                        "source_entry_id": "d382cc14-bbb1-3650-9f9d-a70f12d0247e",
                        "source_sense_id": "5544d122-d10d-315f-b0b7-398d19e48e10",
