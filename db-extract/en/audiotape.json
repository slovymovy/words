                        "sense_id": "35645ef3-a646-3f75-a25d-d0e72a165e09",
                        "entry_id": "b8d236cf-0396-372d-ad57-af833723aa49",
                        "glosses": [
                            "A magnetic tape that stores analog sound for later playback on a tape player."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4267caf8-be61-4d60-9469-fa9f7df9554e",
                                "sense_id": "35645ef3-a646-3f75-a25d-d0e72a165e09",
                                "text": "I thought of an old ad for Memorex audiotape. It showed a crystal glass being shattered by sound vibrations. By pure harmonics."
                            }
                        ]
                    },
                    {
                        "sense_id": "23ae7de0-c62a-3d6c-87fd-4bfd8af7b96e",
                        "entry_id": "b8d236cf-0396-372d-ad57-af833723aa49",
                        "glosses": [
                            "Any of a cassette tape, eight-track tape, reel-to-reel tape, DAT, etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "523de582-830c-481b-80af-93a7f4d293e6",
                        "source_entry_id": "b8d236cf-0396-372d-ad57-af833723aa49",
                        "source_sense_description": "magnetic tape that stores analog sound",
                        "target_lang_word": "Tonband",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tonband",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                        "entry_id": "fff8dbf4-4c35-3ca6-976a-6e9527c29865",
                                        "glosses": [
                                            "langes, schmales, mit magnetisierbarem Material beschichtetes Kunststoffband zur Speicherung von Geräuschen, Musik oder Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0433ae93-7bbf-4d35-9085-70fbb1db42e5",
                                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                                "text": "„Der große Stapel von Tonbändern, den Claire säuberlich aufgeschichtet hatte, brannte lichterloh, und die Flammen drohten soeben auf die Vorhänge überzugreifen.“"
                                            },
                                            {
                                                "example_id": "24b6895f-1850-44cd-a3e7-311a10b39166",
                                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                                "text": "„Das gesamte Tonband war abgelaufen.“"
                                            },
                                            {
                                                "example_id": "822f170a-a61b-4389-89c4-d6dd21b6e546",
                                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                                "text": "„Tonbänder und Kassetten gab es damals noch nicht; aber das wäre heute eine Möglichkeit und wird auch ab und zu angewandt.“"
                                            },
                                            {
                                                "example_id": "a6249558-317a-4428-9fad-7290e96914cf",
                                                "sense_id": "9a7d80b4-424c-393c-8a6e-e1c1f1e56d4b",
                                                "text": "„Die letzten Meter des letzten Tonbandes liegen auf dem Tonbandgerät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
