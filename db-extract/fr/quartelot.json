                                            {
                                                "example_id": "98ccdfdb-5286-4f3a-848d-f62fdd2ef2c6",
                                                "sense_id": "bd66f159-9133-3671-b7c1-8dfc11b7264b",
                                                "text": "The following morning before Nicholas awoke, Mulvey walked all the way to the village of Letterfrack, returning with a basket of cabbages and a flitch of bacon, two loaves of fresh bread and a plump broiling chicken."
                                            },
                                            {
                                                "example_id": "09769271-2452-411f-8816-b0ab2c5da6c1",
                                                "sense_id": "bd66f159-9133-3671-b7c1-8dfc11b7264b",
                                                "text": "The programme was loosely derived from a folk tradition, the Great Dunmow Flitch, in which the most happily married couple in the village were rewarded with a gift of a flitch of beef."
                                            }
                                        ]
                                    },
