                "senses": [
                    {
                        "sense_id": "b2dcf147-f2f1-360d-b923-d86cd975ce65",
                        "entry_id": "d326691f-0018-3984-aea2-fb74fd65c2e5",
                        "glosses": [
                            "Vertreter der Insektenordnung Mantodea mit charakteristischen Fangarmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f4648c8-b61c-4a5d-87e3-2517041ff182",
                                "sense_id": "b2dcf147-f2f1-360d-b923-d86cd975ce65",
                                "text": "Gottesanbeterinnen sind an ihrer charakteristischen körperhaltung leicht zu erkennen."
                            },
                            {
                                "example_id": "dfd1ee7d-eed3-44c2-93c0-6b5e5f1e41f9",
                                "sense_id": "b2dcf147-f2f1-360d-b923-d86cd975ce65",
                                "text": "„Er hat die Gestalt einer Gottesanbeterin, eines Insekts, das neben einem feisten Mistkäfer ausgesprochen magersüchtig aussieht.“"
                            },
                            {
                                "example_id": "d7799265-ee11-45d3-99d1-e40fabcda9e2",
                                "sense_id": "b2dcf147-f2f1-360d-b923-d86cd975ce65",
                                "text": "„Als sich eine Gottesanbeterin auf den Teller des jungen Tänzers Moses Pendleton setzte, bot Roth ihm hundert Dollar für den Fall, dass er sie verspeiste; er stellte einen Scheck aus und übergab ihn Louise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e0dee74-f779-337d-953d-40c7b19027ad",
                        "entry_id": "d326691f-0018-3984-aea2-fb74fd65c2e5",
                        "glosses": [
                            "speziell die auch in Deutschland vorkommende Europäische Gottesanbeterin Mantis religiosa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0269fee6-4fba-4f38-8d0a-fa6cc56a59e9",
                                "sense_id": "9e0dee74-f779-337d-953d-40c7b19027ad",
                                "text": "Die Gottesanbeterin kommt an warmen, trockenen Orten vor."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
