                "senses": [
                    {
                        "sense_id": "18913a79-8700-3d05-ac06-d74b6de0f601",
                        "entry_id": "d492285d-ad0d-3583-85f6-69f42f849b4a",
                        "glosses": [
                            "Qui aborde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15471f22-9a8c-4028-9e68-d2f8733817df",
                                "sense_id": "18913a79-8700-3d05-ac06-d74b6de0f601",
                                "text": "Le vaisseau abordeur."
                            },
                            {
                                "example_id": "99f96cc2-4f7b-43fa-9b84-96d86c204c67",
                                "sense_id": "18913a79-8700-3d05-ac06-d74b6de0f601",
                                "text": "C'était donc que le capitaine du cargo abordeur estimait qu'il avait sans doute fait des victimes."
                            },
                            {
                                "example_id": "600371e9-d7c3-4ef7-ac3c-ab6436ef0ef3",
                                "sense_id": "18913a79-8700-3d05-ac06-d74b6de0f601",
                                "text": "Abordeur étant un mot peu usité, on n'a pas dit abordeuse au féminin. Voir abordant."
                            },
                            {
                                "example_id": "790e3a25-08c7-4df5-be54-d39e913e7e65",
                                "sense_id": "18913a79-8700-3d05-ac06-d74b6de0f601",
                                "text": "Les indemnités se rapporteront :\n1° Aux accidents de personnes, pour lesquels nous considérerons deux éventualités.\na) Les victimes se trouvaient dans la voiture abordeuse ;\nb) Les victimes se trouvaient dans la voiture abordée."
                            }
                        ]
                    }
