                "senses": [
                    {
                        "sense_id": "832e0e5f-447a-39ac-9a90-1e9d0a64fa26",
                        "entry_id": "e356b68e-9d96-338b-b986-03e833e7a8a0",
                        "glosses": [
                            "Bestandteil eines Namens, der zwischen Vor- und Nachname platziert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc297c9-873e-4ed9-a440-d34719ad6fa3",
                                "sense_id": "832e0e5f-447a-39ac-9a90-1e9d0a64fa26",
                                "text": "„Die in Ostfriesland bestehende Sitte, einen Zwischennamen zu gebrauchen, wird vom Standesamt respektiert.“"
                            },
                            {
                                "example_id": "d8c4bac5-95b4-4cf8-bc0c-941ff7854016",
                                "sense_id": "832e0e5f-447a-39ac-9a90-1e9d0a64fa26",
                                "text": "„In den amtlich zugelassenen friesischen Zwischennamen (…) hat sich die ältere Tradition patronymischer Zunamen bis heute erhalten“"
                            },
                            {
                                "example_id": "3ffc0b3c-82c1-48c9-9a71-b02d0f634615",
                                "sense_id": "832e0e5f-447a-39ac-9a90-1e9d0a64fa26",
                                "text": "„Träger der Massennamen benutzen gern Zwischennamen wie der aktuelle Regierungschef Lars Løkke Rasmussen und seine zwei direkten Vorgänger Anders Fogh Rasmussen und Paul Nyrup Rasmussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34fc6091-fe75-4f0f-a553-04c0030e9b6a",
                        "source_entry_id": "e356b68e-9d96-338b-b986-03e833e7a8a0",
                        "source_sense_id": "832e0e5f-447a-39ac-9a90-1e9d0a64fa26",
                        "source_sense_description": "Bestandteil eines Namens, der zwischen Vor- und Nachname platziert ist",
                        "target_lang_word": "middle name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "middle name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c58a7dc9-e2ee-37bc-8a68-ff7a7d6c805e",
                                        "entry_id": "53f15680-4a52-3935-ba7f-f402a00a1480",
                                        "glosses": [
                                            "A name between the first given name and the family name or surname; a second or subsequent given name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036740cb-426f-4eef-a06d-1fdd003e05f7",
                                                "sense_id": "c58a7dc9-e2ee-37bc-8a68-ff7a7d6c805e",
                                                "text": "I go by David but it's my middle name; my full name is William David Mason."
                                            },
                                            {
                                                "example_id": "be509e65-1de4-4038-bb88-5f8d76422fee",
                                                "sense_id": "c58a7dc9-e2ee-37bc-8a68-ff7a7d6c805e",
                                                "text": "María is a common middle name in Spanish, as in José María García."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37363a2-1f1a-35ae-b3fb-141dfb3089b3",
                                        "entry_id": "53f15680-4a52-3935-ba7f-f402a00a1480",
                                        "glosses": [
                                            "A trait, activity, or action closely associated with or aptly describing a person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "952411ef-7df9-49f0-bb6a-6f287d423d7a",
                                                "sense_id": "a37363a2-1f1a-35ae-b3fb-141dfb3089b3",
                                                "text": "Think twice about playing for cash because \"Poker\" is her middle name."
                                            },
                                            {
                                                "example_id": "80c40d86-cd97-4065-9c64-a716fba2a3c0",
                                                "sense_id": "a37363a2-1f1a-35ae-b3fb-141dfb3089b3",
                                                "text": "I won't tell anyone. \"Discretion\" is my middle name."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "middle name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74de3356-7032-3b8b-b57f-b2245eaa51b7",
                                        "entry_id": "72734c9d-a071-354d-b0de-74cbd18f492b",
                                        "glosses": [
                                            "one's mother's maiden name"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa4fca35-8553-430a-b011-f7b3f12ef28c",
                                                "sense_id": "74de3356-7032-3b8b-b57f-b2245eaa51b7",
                                                "text": "Juan Rico Martinez dela Cruz III is my full name, where Martinez is my middle name, but people just call me \"JR\"."
                                            },
                                            {
                                                "example_id": "e1574ded-5b61-4ed4-9103-a86b69691d60",
                                                "sense_id": "74de3356-7032-3b8b-b57f-b2245eaa51b7",
                                                "text": "Maria Clara Teresita Reyes dela Cruz is my full name, where Reyes is my middle name, but you can call me Tessie or Tess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
