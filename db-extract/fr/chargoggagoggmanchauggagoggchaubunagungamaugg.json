                        "cross_references": [
                            {
                                "target_word": "Lake Chargoggagoggmanchauggagoggchaubunagungamaugg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd324ab1-3ef6-320d-8d6d-b5a58fdb430a",
                                        "entry_id": "77e23a01-f737-3392-971e-a1538df6b20a",
                                        "glosses": [
                                            "Synonym of Lake Chaubunagungamaug in Massachusetts, USA."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed7c45b-c03b-460a-bda0-8d251b995ae4",
                                                "sense_id": "cd324ab1-3ef6-320d-8d6d-b5a58fdb430a",
                                                "text": "LAKE CHARGOGGAGOGGMANCHAUGGAGOGGCHAUBUNAGUNGAMAUGG is the name of the largest and one of the most beautiful Summer resorts in Massachusetts and is located in the industrial town of Webster close to the Connecticut and Rhode Island borders. Its name is pronounced with ease only by natives of Webster and the Nipmuck Indians."
                                            },
                                            {
                                                "example_id": "48992bd5-5e9e-4e13-bbb0-5c5889780f8b",
                                                "sense_id": "cd324ab1-3ef6-320d-8d6d-b5a58fdb430a",
                                                "text": "The French River flows generally south throughout its length from Leicester (beginning with Town Meadow Brook from Leicester to Greenville Pond) through Oxford, Dudley, and Webster to Thompson, Connecticut. Probably the best known feature along the French River is Lake Chargoggagoggmanchauggagoggchaubunagungamaugg (also known as Webster Lake) which drains into the river in Webster via Mill Brook."
                                            },
                                            {
                                                "example_id": "a66fda65-df1e-429b-abdf-f9165f03fd95",
                                                "sense_id": "cd324ab1-3ef6-320d-8d6d-b5a58fdb430a",
                                                "text": "In fact, I can remember sitting with my grandfather Rusack and his good friend, last of the Nipmuck Indians, on the shore of Lake Chargoggagoggmanchauggagoggchaubunagungamaugg in Massachusetts and listening to the ancient brave's stories."
                                            },
                                            {
                                                "example_id": "c58cf875-e781-4110-bb62-5f8a0fdedbb1",
                                                "sense_id": "cd324ab1-3ef6-320d-8d6d-b5a58fdb430a",
                                                "text": "Lake Chargoggagoggmanchauggagoggchaubunagungamaugg is located in the town of Webster, Massachusetts. The name is the longest for any lake in the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
