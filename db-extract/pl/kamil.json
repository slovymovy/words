                ],
                "senses": [
                    {
                        "sense_id": "d209a87f-f8b6-3d84-9890-bc4f09175af2",
                        "entry_id": "c812085b-0283-342d-89b0-ec2c61105545",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b1e468-c0e2-4b88-bf0d-e8a83746ced4",
                                "sense_id": "d209a87f-f8b6-3d84-9890-bc4f09175af2",
                                "text": "Ten Kamil mieszka w mieście."
                            },
                            {
                                "example_id": "fe5eaa38-c743-42ea-af13-3893d00eda9d",
                                "sense_id": "d209a87f-f8b6-3d84-9890-bc4f09175af2",
                                "text": "Kamilu, na kiedy przypadają twoje imieniny?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64161345-c586-4062-b4f8-55f0bd26df8d",
                        "source_entry_id": "c812085b-0283-342d-89b0-ec2c61105545",
                        "source_sense_id": "d209a87f-f8b6-3d84-9890-bc4f09175af2",
                        "target_lang_word": "Camille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Camille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "167571fb-6b1d-3057-b8ad-7634b3bea27d",
                                        "entry_id": "11cb0432-e644-3157-a1a0-4fe2ad55e4a3",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b59621f-abb1-4baa-9237-e652a865ca08",
                                                "sense_id": "167571fb-6b1d-3057-b8ad-7634b3bea27d",
                                                "text": "Camille et la marquise entrèrent dans Guérande avec la vicomtesse de Kergarouët et sa fille, au grand étonnement de toute la ville ébahie ; elles laissèrent leurs compagnes de voyage à l’entrée de la ruelle du Guénic, où peu s’en fallut qu’il ne se formât un attroupement."
                                            },
                                            {
                                                "example_id": "53d91b26-0faf-4f0c-a81d-0d82c812faba",
                                                "sense_id": "167571fb-6b1d-3057-b8ad-7634b3bea27d",
                                                "text": "Un soir, rentrant inopinément dans la chambre de Camille (oui, c'est bien Camille, je me souviens), je trouvai, jonchant le sol, l'orientale défroque de mon géant, et dans le lit Camille… devinez avec qui !"
                                            },
                                            {
                                                "example_id": "13fea942-0ec1-4e10-b8b5-57a093061b49",
                                                "sense_id": "167571fb-6b1d-3057-b8ad-7634b3bea27d",
                                                "text": "Camille, à vingt-trois ans, était une petite personne très brune, à demi contrefaite, l’épaule gauche plus haute que la droite."
                                            },
                                            {
                                                "example_id": "00e87651-b5e6-41c4-8e5f-26a0c5d1a123",
                                                "sense_id": "167571fb-6b1d-3057-b8ad-7634b3bea27d",
                                                "text": "Ha… Voilà Camille. Elle sort de son interrogatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af3b317-ea24-341f-a8b8-40e62afab450",
                                        "entry_id": "11cb0432-e644-3157-a1a0-4fe2ad55e4a3",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fcd2c4f-5e26-477f-a128-a20622723083",
                                                "sense_id": "1af3b317-ea24-341f-a8b8-40e62afab450",
                                                "text": "Camille Laurin, René Lévesque, Bernard Landry et Jacques Parizeau doivent se retourner dans leur tombe."
                                            },
                                            {
                                                "example_id": "35e88642-e64f-4480-bc42-1f4095439030",
                                                "sense_id": "1af3b317-ea24-341f-a8b8-40e62afab450",
                                                "text": "Lorsque Camille releva la tête, j’eus le plus grand mal à le reconnaître tant son visage était dévasté, transfiguré. Des cernes creusaient son regard, dessinant deux trous noirs autour de ses tristes yeux bleu décoloré. Sa peau blanche paraissait grise sous l’éclairage implacable du néon, on aurait dit qu’il était sur le point de se consumer."
                                            },
                                            {
                                                "example_id": "379e78ca-0176-4665-9852-32145d5cf3a9",
                                                "sense_id": "1af3b317-ea24-341f-a8b8-40e62afab450",
                                                "text": "« J’ai ensuite rejoint Michaël Bartocetti au Shangri-La (Paris 16ᵉ) », raconte Camille Saint-M’leux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
