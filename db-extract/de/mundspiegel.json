                        "entry_id": "9c549864-a72f-3af3-945f-da2712cad9d9",
                        "glosses": [
                            "Spiegel, der zur Untersuchung des Mundraums und der Zähne dient"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "31803d44-d9e6-4822-936a-66fc4dd719b9",
                                "sense_id": "6b419526-a7a0-3c23-8fd1-359dedfaf85c",
                                "text": "„Innerhalb weniger Wochen stiegen Einbrecher in fünf Zahnarztpraxen ein und klauten Bohrer, Zahnsteinentferner und Mundspiegel.“"
                            },
                            {
                                "example_id": "184ffbd4-6c7d-4f3c-b5b7-028ac57fa75b",
                                "sense_id": "6b419526-a7a0-3c23-8fd1-359dedfaf85c",
                                "text": "„Antje Krayer kommt vom Kreisgesundheitsamt Mettmann und hat eine blaue Tüte mit Zahnbürsten, Mundspiegeln und FluoridGel-Tuben mitgebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
