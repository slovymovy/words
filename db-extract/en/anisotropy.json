                    },
                    {
                        "translation_id": "6869e387-bf8e-4712-b427-dbe28df54e54",
                        "source_entry_id": "9437ae32-0d56-32c9-9317-9a5158dca21e",
                        "source_sense_description": "the property of being directionally dependent",
                        "target_lang_word": "anizotropia",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anizotropia",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "973bcb81-e49f-3127-82d3-d1c426aa60f5",
                                        "entry_id": "c21a8222-6860-3916-9417-48d7816de8bf",
                                        "glosses": [
                                            "zależność właściwości ciała od kierunku, z którego się je bada"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b6adf0-8a5e-4dc5-87a4-23e6180ca943",
                                                "sense_id": "973bcb81-e49f-3127-82d3-d1c426aa60f5",
                                                "text": "Dla próbki spolaryzowanej widać wyraźną anizotropię emisji, przejawiającą się jako różnica intensywności rejestrowanych przez liczniki A i B"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c1d0457-546c-4963-94c2-7c024505f4ac",
                        "source_entry_id": "9437ae32-0d56-32c9-9317-9a5158dca21e",
                        "source_sense_description": "the property of being directionally dependent",
                        "target_lang_word": "анизотропи́я",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анизотропи́я",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f7118978-2bef-32a4-9b13-c055de2bd94a",
                                        "entry_id": "e58f6509-a0a8-3a0c-b264-b52825b4dd1a",
                                        "glosses": [
                                            "физ., хим., геол. различие свойств среды в различных направлениях внутри этой среды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4707a1c8-363e-4c76-b78d-818d1a6c54f3",
                                                "sense_id": "f7118978-2bef-32a4-9b13-c055de2bd94a",
                                                "text": "Кристаллы анизотропны. Напротив, аморфные тела, жидкости и газы изотропны .. Анизотропия свойств и позволяет узнать, является ли прозрачный бесформенный кусочек вещества кристаллом или нет."
                                            },
                                            {
                                                "example_id": "cb124b5b-b8eb-4c42-bbb7-69a432faa3a8",
                                                "sense_id": "f7118978-2bef-32a4-9b13-c055de2bd94a",
                                                "text": "Упругая анизотропия горных пород, как и сейсмическая анизотропия верхних частей земной коры, известна и изучается достаточно давно."
                                            },
                                            {
                                                "example_id": "432f6319-07b1-455c-b344-17092224c08d",
                                                "sense_id": "f7118978-2bef-32a4-9b13-c055de2bd94a",
                                                "text": "Качественно новая эра в развитии космологии началась в 1992 году с открытием космологической анизотропии реликтового излучения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2daf39c4-af7e-4d52-8125-9cf1c25ed321",
                        "source_entry_id": "9437ae32-0d56-32c9-9317-9a5158dca21e",
                        "source_sense_description": "the property of being directionally dependent",
                        "target_lang_word": "anisotropía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anisotropía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0b43d9aa-acf0-341d-b6ee-5edf97912359",
                                        "entry_id": "f0992bc9-4cc2-30e9-8e71-4839ab0a5374",
                                        "glosses": [
                                            "Propiedad general de la materia, según la cual algunos atributos cambian de valor en función de la dirección en la que son evaluados."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abf38eb-4afe-4d5c-b2c6-e882c3162f94",
                                                "sense_id": "0b43d9aa-acf0-341d-b6ee-5edf97912359",
                                                "text": "La óptica electromagnética considera a la luz como una onda electromagnética, explicando así la reflectancia y transmitancia, y los fenómenos de polarización y anisotropía (en Óptica)."
                                            },
                                            {
                                                "example_id": "2ac600b6-bc12-4a5a-9698-0f8423674969",
                                                "sense_id": "0b43d9aa-acf0-341d-b6ee-5edf97912359",
                                                "text": "Durante la década de los 90 se investigó más extensamente la anisotropía en el CMB mediante un gran número de experimentos en tierra y, midiendo la distancia angular media (la distancia en el cielo) de las anisotropías, se vio que el universo era geométricamente plano (en Teoría del Big Bang)."
                                            },
                                            {
                                                "example_id": "88d310b8-7a5f-4f04-a064-0a0d8285de84",
                                                "sense_id": "0b43d9aa-acf0-341d-b6ee-5edf97912359",
                                                "text": "Se piensa que esto sólo es posible si las interacciones magnéticas se extienden tridimensionalmente, o, si son bidimensionales, si están acompañadas por una fuerte anisotropía magnética (por ejemplo, por un eje de fácil imantación) (en Ordenamiento magnético)."
                                            },
                                            {
                                                "example_id": "bd036b81-e257-4f01-9e6f-b34425877d88",
                                                "sense_id": "0b43d9aa-acf0-341d-b6ee-5edf97912359",
                                                "text": "También aparece en los artículos: Anisotropía en el canje magnético, Anisotropía magnética, Interacción magnética dipolar, Mn12 y Chapa cromada."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
