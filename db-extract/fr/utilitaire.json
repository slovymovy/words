        "fr-extract.jsonl": [
            {
                "entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                "word": "utilitaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "34d38ea2-4462-4b49-925c-ac03a80b5421",
                        "entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "utilitaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f6dcb02-10e0-3bb2-989a-ef06272625cb",
                        "entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                        "glosses": [
                            "Qui ne vise que des buts intéressés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7520a2a-0721-43da-a004-cffeccf3c852",
                                "sense_id": "4f6dcb02-10e0-3bb2-989a-ef06272625cb",
                                "text": "Ça fleure l’honnêteté bourgeoise. C’est, en somme, du vice utilitaire. Tout est garanti, normal."
                            },
                            {
                                "example_id": "917e36d9-90ef-4c1c-ab1c-5208d2a73c07",
                                "sense_id": "4f6dcb02-10e0-3bb2-989a-ef06272625cb",
                                "text": "[…] « À quoi cela sert-il ? » répète-t-il le plus volontiers ; et on la lui reproche assez, sa manie bassement utilitaire, et pratique, on la lui reproche un peu trop, et injustement !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f7fdf7d5-5e7f-38ae-a86e-6298a6531577",
                        "entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                        "glosses": [
                            "Relatif à l’utilitarisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54be232-1a6e-4aad-8baa-7c62783f9065",
                                "sense_id": "f7fdf7d5-5e7f-38ae-a86e-6298a6531577",
                                "text": "La morale utilitaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "83bb90b7-775b-3669-a43f-0510f58aa7e8",
                        "entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                        "glosses": [
                            "Qualifie un véhicule capable d’assurer des fonctions très différentes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "073ad562-b32b-4126-8f9c-704c0f416590",
                        "source_entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                        "target_lang_word": "utilitarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utilitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b20b7461-6470-380d-9e70-0656a2baef3d",
                                        "entry_id": "8e87caca-1862-31d4-b243-00fbe03f4c0a",
                                        "glosses": [
                                            "Of or relating to utility."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac20798-1b84-3527-b9ac-302be06937ea",
                                        "entry_id": "8e87caca-1862-31d4-b243-00fbe03f4c0a",
                                        "glosses": [
                                            "Pertaining to utilitarianism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                                        "entry_id": "8e87caca-1862-31d4-b243-00fbe03f4c0a",
                                        "glosses": [
                                            "Practical and functional, present for use, not just for show."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919128ae-244e-413e-9248-fe31e570484f",
                                                "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                                                "text": "The semi-streamlined contour of the earlier G.W.R. railcars has been given up in favour of a more utilitarian blunt-nose end, and effective floor space gained thereby."
                                            },
                                            {
                                                "example_id": "f918bc5e-367c-40af-b188-842ad2791e3c",
                                                "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                                                "text": "These have helped develop a recognition in the industry that bland utilitarian stations do not provide an attractive welcome to the railway, that passengers value stations of character as well as convenience, and that these qualities encourage greater use of trains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "utilitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b10ad2d-eb6d-36c0-aa39-7bd705a6d54d",
                                        "entry_id": "aa655e49-b474-333d-9387-6c3529eae558",
                                        "glosses": [
                                            "Someone who practices or advocates utilitarianism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44678c0d-6d19-46af-a09b-6a0773653f63",
                                                "sense_id": "4b10ad2d-eb6d-36c0-aa39-7bd705a6d54d",
                                                "text": "Before his companies collapsed, Mr. Bankman-Fried often described himself as a utilitarian — meaning that he made decisions designed to advance the greater good."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b2780cc-2930-4fb4-ab24-4747e74529c7",
                        "source_entry_id": "fafd84aa-d34d-3275-9fec-836fb34287e2",
                        "target_lang_word": "утилитарный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "утилитарный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "85fc9e6a-0291-3523-a0f8-b0e212246496",
                                        "entry_id": "8702409b-9cd0-3a5f-9ecc-0381b639884a",
                                        "glosses": [
                                            "филос. относящийся к утилитаризму, свойственный утилитаризму"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d1c7ec-bd02-4240-8994-2e9192f569f0",
                                                "sense_id": "85fc9e6a-0291-3523-a0f8-b0e212246496",
                                                "text": "Мы не станем теперь говорить о том, до какой степени эта утилитарная теория противоречит сущности искусства, разрушая единство, полноту и самостоятельность его деятельности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a2ba2a1-e77a-3f89-916d-ad7f5afc8d29",
                                        "entry_id": "8702409b-9cd0-3a5f-9ecc-0381b639884a",
                                        "glosses": [
                                            "имеющий практическое назначение или направленный на достижение практических целей, извлечение материальной пользы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c017b6-0642-43b5-b93f-af8a3df87d6f",
                                                "sense_id": "4a2ba2a1-e77a-3f89-916d-ad7f5afc8d29",
                                                "text": "Вот такое утилитарное отношение к красоте у капитана второго ранга."
                                            },
                                            {
                                                "example_id": "afbdd76b-0ee7-435e-832c-66575f06b13d",
                                                "sense_id": "4a2ba2a1-e77a-3f89-916d-ad7f5afc8d29",
                                                "text": "Раньше шамот использовался для изготовления чисто утилитарных предметов типа печей, но художники его полюбили, потому что шамот при лепке терпит любое «издевательство»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "9ac01857-280c-3b5d-9d4b-6acb10d41732",
