                        "glosses": [
                            "ICT gebruiker; iemand die een computer, een computer of een informatiesysteem gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a86526-3888-4558-b7a1-18d79346f8c1",
                                "sense_id": "234a3f02-d935-31e3-becc-c91d58c19598",
                                "text": "Bij ransomeware zet malafide software (afgekort malware) het systeem van een computergebruiker op slot en krijgt de gebruiker een melding dat het systeem pas weer werkt als er geld is betaald. Windows-gebruikers hebben al veel langer last van dit soort malware."
                            },
                            {
                                "example_id": "7fe3b34b-55d9-4b82-98be-1d10ab368ccd",
                                "sense_id": "234a3f02-d935-31e3-becc-c91d58c19598",
                                "text": "In sommige gevallen krijgt de computergebruiker, zoals ook de bedoeling is, een slot-icoon te zien als teken dat het goed zit. Maar dat slotje verschijnt niet bij alle browsers."
                            }
                        ]
                    }
