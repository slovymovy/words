                    {
                        "translation_id": "0f97695a-cf47-47c7-a96c-b56cf071bed9",
                        "source_entry_id": "84501759-04c3-30a1-8ab4-3bf284669ec1",
                        "target_lang_word": "Irene",
                        "target_lang_code": "en",
