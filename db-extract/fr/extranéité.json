                                        "sense_id": "de735861-5395-3081-a076-28cd7683ec18",
                                        "entry_id": "9fff3832-850b-3eb0-84bc-df938746a200",
                                        "glosses": [
                                            "The quality of being, appearing, or being perceived as foreign; exoticness, otherness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e553dfe-34d5-473d-88a7-ae644bfb3afe",
                                                "sense_id": "de735861-5395-3081-a076-28cd7683ec18",
                                                "text": "The same courteous, automatic greeting […] which by now I understood as a nod to my foreignness, which was obvious to everyone everywhere."
                                            },
                                            {
                                                "example_id": "85269653-a9eb-4458-bd97-6806ea96dc3b",
                                                "sense_id": "de735861-5395-3081-a076-28cd7683ec18",
                                                "text": "The word “saudade” is being quite misused for what looks like to be a need for adding romantic foreignness to a story or an article."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8e8b50-70c7-310e-8a0e-6a59fca4282b",
                                        "entry_id": "9fff3832-850b-3eb0-84bc-df938746a200",
                                        "glosses": [
                                            "A characteristic that indicates foreignness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
