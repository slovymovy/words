    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68a81cf7-165d-3c42-aeb5-41466928e4d1",
                    "sense_definition": "having a smooth, elegant, and streamlined shape; not bulky or thick",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new sports car has a <w>sleek</w> design that helps it move faster through the air.",
                            "target_lang_translations": {
                                "ru": "У нового спортивного автомобиля <w>обтекаемый</w> дизайн, который помогает ему быстрее двигаться сквозь поток воздуха.",
                                "zh": "这款新跑车采用了<w>流线型</w>设计，有助于它在空气中行驶得更快。"
                            }
                        },
                        {
                            "text": "She looked very professional in her <w>sleek</w> black dress at the business meeting.",
                            "target_lang_translations": {
                                "ru": "На деловой встрече она выглядела очень профессионально в своем <w>элегантном</w> черном платье.",
                                "zh": "她在商务会议上穿着一件<w>优雅</w>的黑色连衣裙，看起来非常专业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "streamlined",
                        "svelte",
                        "slender",
                        "slim",
                        "elegant"
                    ],
                    "antonyms": [
                        "bulky",
                        "clunky"
                    ],
                    "common_phrases": [
