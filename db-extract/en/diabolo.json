                    {
                        "translation_id": "9e18af2f-3a95-465b-99a3-990677fc0795",
                        "source_entry_id": "20bfcd02-5f78-3dd4-bb31-e49ef8d7c15e",
                        "source_sense_id": "d84a3ebd-1e54-3ffc-9390-25df33ba8e27",
