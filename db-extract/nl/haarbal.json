                    {
                        "sense_id": "19f4e5e0-41b6-301a-a270-55b79179d148",
                        "entry_id": "9a6d4cb6-0707-378e-b6f8-511670557716",
                        "glosses": [
                            "bolvormig lichaam in de maag ontstaan uit opgegeten haren aegagropilus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2aab2bc-b445-4a0c-8b2d-6ba5f3c902a9",
                                "sense_id": "19f4e5e0-41b6-301a-a270-55b79179d148",
                                "text": "Na een snel rondje Ajax, Wilders en Griekenland verlegde de klant het gesprek voorzichtig naar de kwaliteit van zijn haar. Kappers beginnen daar zelden uit zichzelf over, wat begrijpelijk is. Ze ademen al de hele dag haar, ze ruiken niet veel anders en ze moeten er ook nog van eten. Ik stel me voor dat ze, net als katten, thuis af en toe zo’n bevrijdende haarbal uitbraken."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f09dba6-6474-3ea8-9697-da85a62b555b",
                        "entry_id": "9a6d4cb6-0707-378e-b6f8-511670557716",
                        "glosses": [
                            "bal gevuld met haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a6b928-8db9-4d14-b56f-6ed6a34b63aa",
                                "sense_id": "3f09dba6-6474-3ea8-9697-da85a62b555b",
                                "text": "China badmintont massaal. Voor maoqiu (letterlijk haarbal) heb je tenslotte slechts twee rackets en een shuttle nodig en geen tafel of net. In Peking kan dat altijd en overal want de straten zijn breed en nog veel belangrijker: het waait bijna nooit."
                            }
                        ]
                    }
