                "senses": [
                    {
                        "sense_id": "b953bd4a-6fa9-332b-bb39-f945520cec5e",
                        "entry_id": "4214576d-0ed8-3111-9c1f-0e075b30fd10",
                        "glosses": [
                            "пролить слёзы, заплакать, растрогавшись, расстроившись"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a6002a-4ae5-4c59-9596-8d5717e90124",
                                "sense_id": "b953bd4a-6fa9-332b-bb39-f945520cec5e",
                                "text": "Татьяна, с великим равнодушием переносившая до того мгновения все превратности своей жизни, тут, однако, не вытерпела, прослезилась и, садясь в телегу, по-христиански три раза поцеловалась с Герасимом."
                            }
                        ]
                    }
