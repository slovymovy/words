                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "dd5eee79-4fff-4f13-b6fd-f0092bcdaafc",
                                "sense_id": "1f9480cd-52b8-3041-9603-fbaeb95c9d5f",
                                "text": "22 Amts- und vier Landgerichte gibt es zurzeit im Flächenland mit seinen rund drei Millionen Einwohner:innen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f0baff4-d1fb-37e4-901a-3bfbc926f500",
                        "entry_id": "373d7c12-d727-32e8-8c25-87a9e0fd2ae0",
                        "glosses": [
                            "a state with a very low population density."
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "3d48117f-f367-4d15-8bab-6b5d64d4bdc2",
                                "sense_id": "0f0baff4-d1fb-37e4-901a-3bfbc926f500",
                                "text": "Der scheidende kanadische Premierminister Justin Trudeau hat in seiner fast zehnjährigen Amtszeit für viele Veränderungen im zweitgrößten Flächenland der Welt gesorgt."
                            }
                        ]
                    }
