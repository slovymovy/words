                "senses": [
                    {
                        "sense_id": "cffec9fa-7045-3207-8573-519031af6818",
                        "entry_id": "79c67bf2-00c5-3d35-87fc-1c27b8b6d958",
                        "glosses": [
                            "die innere Auskleidung der Mundhöhle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6857c82-db30-4f24-812f-a6d7944bb32e",
                                "sense_id": "cffec9fa-7045-3207-8573-519031af6818",
                                "text": "„Es wird nicht, wie meistens angenommen, Speichel, sondern vor allem Zellmaterial aus der Mundschleimhaut gesichert.“"
                            },
                            {
                                "example_id": "b628dc56-160d-4d5d-80e0-5ca085cc4bd3",
                                "sense_id": "cffec9fa-7045-3207-8573-519031af6818",
                                "text": "„An den Mundschleimhäuten bilden sich Geschwüre, so daß die Patientin allenfalls trinken, aber nichts essen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
