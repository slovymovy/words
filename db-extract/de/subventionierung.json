                "senses": [
                    {
                        "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                        "entry_id": "35cb14c0-ff11-32f1-a808-9f3f818769f8",
                        "glosses": [
                            "finanzielle Unterstützung durch den Staat (meist in Form von direkten Zahlungen, Steuervergünstigungen oder zinsgünstigen Krediten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb68314b-662a-492a-98a4-3376e6bd14bd",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "[Elektroauto:] „In vielen Ländern erfolgt eine Subventionierung der Anschaffungskosten.“"
                            },
                            {
                                "example_id": "b39b66b5-be54-4886-adcd-c9a2f413913a",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Die Subventionierung dieser Fahrzeuge ist Ende 2022 ausgelaufen.“"
                            },
                            {
                                "example_id": "9218c4b9-6468-4dc0-8ff2-82a377734413",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "[1990:] „In der gleichen Zeit passte MZ wegen des Wegfalls staatlicher Subventionierung die Verkaufspreise für den bundesdeutschen Markt an:“ […]."
                            },
                            {
                                "example_id": "dbc28ca0-9153-4590-b00b-24c0e100a949",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Viele Milliarden werden jedes Jahr für die Subventionierung von Dienstwagen mit Verbrennermotoren ausgegeben. Das bremst die Wende zur Elektromobilität […] aus.“"
                            },
                            {
                                "example_id": "475ffc45-fdf3-4c01-b759-4e59d696371f",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Die Subventionierung von fossilen Energieträgern wird scharf kritisiert.“"
                            },
                            {
                                "example_id": "5af38ad0-65c0-46d8-be75-e5eb8efee763",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Doch: »Fliegen ist nicht billig, es wird billig gemacht«, erläutert Mira Kapfinger vom \"Stay Grounded Network\". Das hat mit der indirekten Subventionierung zu tun, denn der Flugtreibstoff Kerosin wird nicht besteuert.“"
                            },
                            {
                                "example_id": "37843bc0-ec42-482b-b2b9-781324529967",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "[Wirtschaft in der DDR:] „Und nach wie vor wurde an der starken Subventionierung von Mieten, sozialen Einrichtungen und Grundnahrungsmitteln festgehalten.“"
                            },
                            {
                                "example_id": "9ad56e20-19bb-402a-bf63-2939eaaf995d",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Großbritannien, Frankreich, Polen und Tschechien haben in einer gemeinsamen Forderung an die EU-Kommission die Subventionierung der Atomenergie als emissionsarme Technologie gefordert, um finanzielle Unterstützung für den Bau von Atomkraftwerken zu erhalten.“"
                            },
                            {
                                "example_id": "272ec601-801d-47a2-aee8-bfab4c1e4a2c",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Von einer dauerhaften Subventionierung des Strompreises hält der CDU-Politiker nichts.“"
                            },
                            {
                                "example_id": "1adfa1c0-d2fe-40d8-9f67-d0dd740b4f23",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Bei der Subventionierung von Agrardiesel befindet sich Deutschland im EU-Vergleich derzeit im Mittelfeld.“"
                            },
                            {
                                "example_id": "24005fbf-80c3-42bb-9c20-6e209b395bac",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Die Subventionierung kann dabei durch die Zuweisung von Planstellen sowie durch die Bereitstellung von Mitteln für Leistungen Dritter […] erfolgen.“"
                            },
                            {
                                "example_id": "ed0657fa-4b08-4803-bcc3-ee7f6857c38b",
                                "sense_id": "271e58f9-43eb-3fcf-b1ef-cc6b5571af77",
                                "text": "„Den Staat kostet die Subventionierung im Jahr 2014 7,8 Mrd. Euro,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
