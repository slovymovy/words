                                        "examples": [
                                            {
                                                "example_id": "1a46438a-5127-484a-9bfc-f144ec453c18",
                                                "sense_id": "0520a7ff-81e7-38b2-9470-9a2f87322fb0",
                                                "text": "Een opmerking van president ds. I. Fritz blijft Dekker bij: „Wat mij betreft, gaan alle lutherse gemeenten mee in de fusie, of geen van allen.” Dekker bedacht daarop een aangepaste versie van het aftelversje ”witte zwanen, zwarte zwanen”."
                                            },
                                            {
                                                "example_id": "02df8f9f-c5c3-4226-bd97-c8ec0ec7b264",
                                                "sense_id": "0520a7ff-81e7-38b2-9470-9a2f87322fb0",
                                                "text": "Onder de brug van Janke-Panke lag een hond\n Als hij schijt, dan schijt hij stront\nAls hij pist, dan pist hij wijn\n Hoeveel liter zou dat zijn?\n aftelversje uit de jaren '20."
                                            }
                                        ]
                                    }
                                ]
                            }
