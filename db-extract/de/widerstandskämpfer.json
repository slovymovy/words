                                "target_senses": [
                                    {
                                        "sense_id": "55a4663a-1ba5-343d-bca9-e30c5b1802cf",
                                        "entry_id": "9c78a631-e2fe-3803-9e9a-bec4775358f7",
                                        "glosses": [
                                            "One who resists, especially a person who fights against an occupying army."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4620c82a-f978-3a9f-a018-e7b3d420a05e",
                                        "entry_id": "9c78a631-e2fe-3803-9e9a-bec4775358f7",
                                        "glosses": [
                                            "An electric component that transmits current in direct proportion to the voltage across it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c5707f-9b81-43be-bd8c-88ffbae54f58",
                                                "sense_id": "4620c82a-f978-3a9f-a018-e7b3d420a05e",
                                                "text": "The resistor limits the current and prevents damage to the LED. […] It is possible to pick resistors and capacitors that will make the pitch higher than humans can hear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6dfe00d-5e61-4061-ba6e-9bf40c407a08",
                        "source_entry_id": "fe1b4fed-f150-37ae-96c7-560ac4e99eca",
                        "source_sense_id": "5f447844-56e7-3f57-acf5-6d2a7a9d6fd1",
                        "target_lang_word": "résistant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résistant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "035dc708-88b0-332e-8960-b6c7f280c375",
                                        "entry_id": "df868bd0-0674-3cb0-a8ff-542e76ae9d5a",
                                        "glosses": [
                                            "Qui oppose de la résistance ; qui est solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec31f86-2107-4076-ba8b-10877071a37a",
                                                "sense_id": "035dc708-88b0-332e-8960-b6c7f280c375",
                                                "text": "Une végétation arbustive, résistante à la sécheresse occupe les faces exposées au sud."
                                            },
                                            {
                                                "example_id": "072dc90a-381b-4a45-8683-12e2bd99d76f",
                                                "sense_id": "035dc708-88b0-332e-8960-b6c7f280c375",
                                                "text": "La peau de cet animal est ferme et résistante."
                                            },
                                            {
                                                "example_id": "4d9c10ee-8939-4c23-80b6-8e16d0a245f6",
                                                "sense_id": "035dc708-88b0-332e-8960-b6c7f280c375",
                                                "text": "Ils enfermèrent cette substance dans une enveloppe à la fois légère et résistante."
                                            },
                                            {
                                                "example_id": "af1493c2-737a-4ef8-a802-8574001b401c",
                                                "sense_id": "035dc708-88b0-332e-8960-b6c7f280c375",
                                                "text": "Ce plastique n'a pas l'air très résistant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8223cd7-c711-3c1f-b421-4c32260da182",
                                        "entry_id": "df868bd0-0674-3cb0-a8ff-542e76ae9d5a",
                                        "glosses": [
                                            "D'une santé solide, qui résiste aux maladies, aux infections."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6846002-f860-46bb-a3ee-3ca3c7f9f3c2",
                                                "sense_id": "f8223cd7-c711-3c1f-b421-4c32260da182",
                                                "text": "Le Bacchus, qui provient d'un semis de Clinton, est un cépage d'avenir pour la culture en treillages dans les sols profonds. […]. Il est très vigoureux, très fertile, très résistant au phylloxéra, à l’oïdium et au mildew."
                                            },
                                            {
                                                "example_id": "c9ce134f-3bcc-4382-a7d0-6b234b504983",
                                                "sense_id": "f8223cd7-c711-3c1f-b421-4c32260da182",
                                                "text": "Francis Hallé : (...) Une épidémie, par exemple une attaque bactérienne, ça ne tue jamais 100 % des arbres. Ça s’est passé avec les ormes il y a quelques années. Presque tous les ormes ont disparu, mais pas tous ! Il reste des ormes résistants."
                                            },
                                            {
                                                "example_id": "9f15b691-c20e-48be-ab8a-5c96d9b4a798",
                                                "sense_id": "f8223cd7-c711-3c1f-b421-4c32260da182",
                                                "text": "Une santé résistante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fca7e05-4717-31e3-a896-42bd21b2d911",
                                        "entry_id": "df868bd0-0674-3cb0-a8ff-542e76ae9d5a",
                                        "glosses": [
                                            "Qui est doté d'une résistance électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab4ea4c-fdae-40c1-b0e5-c480c02110ea",
                                                "sense_id": "2fca7e05-4717-31e3-a896-42bd21b2d911",
                                                "text": "Un léger choc suffit toutefois à faire disparaître cette conductibilité d'emprunt, à « décohérer » la limaille qui redevient électriquement résistante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "résistant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9318d2b7-7e30-377a-a798-e015a1ef931c",
                                        "entry_id": "ff026ec7-e281-36f0-805f-528ce257728e",
                                        "glosses": [
                                            "Personne appartenant à un mouvement de résistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ad9a63-3324-4355-816a-23b6ac27b4bd",
                                                "sense_id": "9318d2b7-7e30-377a-a798-e015a1ef931c",
                                                "text": "L’ultime secret de la Résistance est le secret du résistant, de sa conscience."
                                            }
                                        ]
                                    }
                                ]
                            },
