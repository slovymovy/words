                                    {
                                        "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "In a gradual manner; making slow progress; slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3386cf-1314-417c-98e4-c47b4e80980f",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The most likely conclusion, the researchers say, is that the Levallois method was not taken to Eurasia by African migrants, but evolved there gradually and independently."
                                            },
                                            {
                                                "example_id": "8e59594e-b4da-44f4-879f-a59203f643f4",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The instrument of this dumbing down in Nineteen Eighty-Four was Newspeak, the official language of the English Socialist Party (Ingsoc). Newspeak was a sort of Totalitarian Esperanto that sought gradually to diminish the range of what was thinkable by eliminating, contracting and manufacturing words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "by degrees"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291a7cab-11fc-4167-afc0-f69d0bf0d090",
                                                "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                                "text": "Horns, upon the due accession of Moisture, doth gradually become Soft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "618b7376-c463-4869-ae7a-7a4e0a57ad12",
                        "source_entry_id": "2fa8baaf-b8c8-3df0-a3cc-520c9480171b",
                        "source_sense_id": "e61a5a31-3de3-34c7-a997-f81ab40177dd",
                        "source_sense_description": "übertragen: nach und nach",
                        "target_lang_word": "step by step",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "step by step",
