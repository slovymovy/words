                        "form": "rencounters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d3fb339-da08-327d-9900-d5b96fb30b88",
                        "entry_id": "6d98b06a-2769-34fb-9df5-7429d87899b6",
                        "glosses": [
                            "An encounter between opposing forces; a conflict."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e8e9855b-4314-40a8-8507-1d81d5a665f6",
                                "sense_id": "4d3fb339-da08-327d-9900-d5b96fb30b88",
                                "text": "Mr Nightingale promised to enquire into the state of Mr Fitzpatrick's wound, and likewise to find out some of the persons who were present at the rencounter."
                            },
                            {
                                "example_id": "7e7266ab-b4fc-465d-afb6-bb369d1f3b5b",
                                "sense_id": "4d3fb339-da08-327d-9900-d5b96fb30b88",
                                "text": "He had some advantage in the difference of our weapons; for his sword, as I recollect, was longer than mine, […] His obvious malignity of purpose never for a moment threw him off his guard, and he exhausted every feint and strategem proper to the science of defence; while, at the same time, he mediated the most desperate catastrophe to our rencounter."
                            }
                        ]
                    },
                    {
                        "sense_id": "7409bdc1-2789-354b-8abc-d453d68e06dc",
                        "entry_id": "6d98b06a-2769-34fb-9df5-7429d87899b6",
                        "glosses": [
                            "An encounter or chance meeting."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4db40211-8d4d-4039-ac00-5cc1c3a9f6b2",
                                "sense_id": "7409bdc1-2789-354b-8abc-d453d68e06dc",
                                "text": "The Prior at length […] rode off with considerably less pomp, and in a much more apostolical condition, so far as worldly matters were concerned, than he had exhibited before this rencounter."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
