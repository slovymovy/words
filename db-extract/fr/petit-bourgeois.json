                                            {
                                                "example_id": "7be7a8e1-b252-48e3-8b72-8d9629fa42dd",
                                                "sense_id": "09530e4c-57e7-31a8-8e09-417cfe29c52d",
                                                "text": "„In Rückblenden erfahren wir vom Schicksal des Helden, der es zu Hause, beim spießbürgerlichen Vater vor allem, nicht mehr aushielt und hinauszog in die Welt.“"
                                            },
                                            {
                                                "example_id": "4e310123-3a31-4b9e-a02c-58779dc0c6f2",
                                                "sense_id": "09530e4c-57e7-31a8-8e09-417cfe29c52d",
                                                "text": "„Dies war meine zugegebenermaßen spießbürgerliche Vorstellung davon, wie mein Leben nach meinem Studium aussehen sollte.“"
                                            }
                                        ],
