                ],
                "senses": [
                    {
                        "sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
                        "entry_id": "87c4d31d-9f18-391a-a15d-0de9d9b8bf80",
                        "glosses": [
                            "Schalter zum Ein/Ausschalten der Beleuchtungsvorrichtung"
                        ],
                        "tags": [
                            "Bauteil"
                        ],
                        "examples": [
                            {
                                "example_id": "d441e7d3-0c8a-412b-b69c-456a15d9f92e",
                                "sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
                                "text": "Lichtschalter waren früher aus Porzellan, heute bestehen sie aus Kunststoff."
                            },
                            {
                                "example_id": "bba675d1-558f-47d2-9637-1d5ada86dd07",
                                "sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
                                "text": "„Der alte Zdulko schaltete an einem lebensgefährlichen Lichtschalter das Licht ein, die Lampe war aus geschwungenem Glas.“"
                            },
                            {
                                "example_id": "7839dac7-6491-415f-9a7e-d3b6c9854ed7",
                                "sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
                                "text": "„Marga schob den Brief in das blaue Buch zurück und drückte den Lichtschalter.“"
                            },
                            {
                                "example_id": "fe24842b-9850-47d9-bcc2-6cf4a9aa8e64",
                                "sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
                                "text": "„Fasziniert vom elektrisierten Leben mit Steckdosen und Lichtschaltern auf einer glatten Wand, inspizierte Chrissi die kleine Drei-Zimmer-Wohnung jeden Tag aufs Neue, ohne dass ihr Staunen darüber, wie sauber und einfach hier alles war, je kleiner wurde.“"
                            },
                            {
                                "example_id": "53ebef97-e355-4f9e-b0f9-58554b52708a",
                                "sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
                                "text": "„Veber hatte den Lichtchalter angedreht, als die Polizei und die Ambulanz kamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfce8937-afb7-4942-a67f-55fe8bbee61e",
                        "source_entry_id": "87c4d31d-9f18-391a-a15d-0de9d9b8bf80",
                        "source_sense_id": "0de9f6c1-4f54-3a81-a881-0743148e7d26",
