                "senses": [
                    {
                        "sense_id": "b5a72f3b-1933-3b31-8564-59e83b68227c",
                        "entry_id": "6c34bdc4-48a7-34ed-bbf5-39e0ee3ce04b",
                        "glosses": [
                            "Jouer de la crécelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb65b0e9-0339-4bdf-b7b1-f5cc334f2b82",
                                "sense_id": "b5a72f3b-1933-3b31-8564-59e83b68227c",
                                "text": "Il n'y a sans doute plus que dans les villages où les gamins se lèvent tôt le matin pour aller créceller."
                            },
                            {
                                "example_id": "95d4bc22-6cb1-4b7f-9475-466aead046df",
                                "sense_id": "b5a72f3b-1933-3b31-8564-59e83b68227c",
                                "text": "Pierre Gette allait créceller à Urcourt à vélo."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3cb5bf6-0202-33c1-a893-14ccd1cfcf61",
                        "entry_id": "6c34bdc4-48a7-34ed-bbf5-39e0ee3ce04b",
                        "glosses": [
                            "Faire un bruit de crécelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d73e05dc-cf88-44b2-8258-b2835c5bfb1a",
                                "sense_id": "b3cb5bf6-0202-33c1-a893-14ccd1cfcf61",
                                "text": "La voix grêle du prince crécella tout à coup, tandis que sa jumelle tremblotait entre ses doigts décharnés."
                            }
                        ]
                    }
