                            {
                                "example_id": "0a90cf64-5ca1-49fa-a6b4-cf05f9ff2a84",
                                "sense_id": "fd0a1a02-7d06-3a77-83a2-0424f513530c",
                                "text": "Il s’était arrêté près d’un des buffets et s’amusait à compter le nombre de petits-fours qu’arrivait à ingurgiter le chef de l’administration communale quand son talkie grésilla."
                            }
