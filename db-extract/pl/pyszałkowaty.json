                    {
                        "translation_id": "e0ddf0a2-9698-4d88-99c5-1397aba80edb",
                        "source_entry_id": "42b4d4e9-9667-30ec-b594-6fc1875cd862",
                        "source_sense_id": "0ca50d1a-ee14-3fae-bf14-a22773e23b5f",
                        "target_lang_word": "prahlerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prahlerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "458a742a-8604-3de1-aa23-ec37e4ae06ba",
                                        "entry_id": "393e06ec-1969-3d6f-be30-439b474c9c2d",
                                        "glosses": [
                                            "die eigenen Verdienste und Fähigkeiten verherrlichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e624c80d-1354-49f1-a399-b14989a34e51",
                                                "sense_id": "458a742a-8604-3de1-aa23-ec37e4ae06ba",
                                                "text": "Prahlerische Krypto-Derivate-Händler könnten die Dinge für sie und die Handelsplattformen noch schlimmer gemacht haben, da Politiker und Regulierungsbehörden gerade einen weiteren Anreiz erhalten haben, noch härter gegen diesen Markt vorzugehen."
                                            },
                                            {
                                                "example_id": "73745e7b-708b-4531-b1a9-a82bfe38af59",
                                                "sense_id": "458a742a-8604-3de1-aa23-ec37e4ae06ba",
                                                "text": "Er zeigt uns in seiner Struktur, an den Änderungen der Festungsmauer, die wundervolle, prahlerische Funktion vor seinem Bau, für die Erfordernisse der späteren Verteidigung der Stadt."
                                            },
                                            {
                                                "example_id": "dee1242f-f19d-4af0-b39d-420823c8f6ee",
                                                "sense_id": "458a742a-8604-3de1-aa23-ec37e4ae06ba",
                                                "text": "Durch seine prahlerisch verkündeten und nie ausgeführten Pläne besonders in Hinsicht auf Verheiratung machte er sich lächerlich; er ging bis zu seinem Tode auf Freiersfüßen, teils um seine Erben zu schrecken, teils weil das Spielen mit dem Gedanken ihn reizte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a48954d1-ff38-47e4-9d33-19283dd4cca5",
                        "source_entry_id": "42b4d4e9-9667-30ec-b594-6fc1875cd862",
                        "source_sense_id": "0ca50d1a-ee14-3fae-bf14-a22773e23b5f",
                        "target_lang_word": "protzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                        "entry_id": "f43e7310-7cd8-375d-a59e-7c200da4184f",
                                        "glosses": [
                                            "Reichtum / Besitz zum Zweck des Angebens oder als Statussymbol zeigend"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d29502-2c04-4954-a5ba-8a298e4375a3",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "Sein neues Auto wirkt auf mich noch protziger als das alte."
                                            },
                                            {
                                                "example_id": "08def781-00c8-4973-b45c-4a97881d1f29",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„In Angolas Hauptstadt Luanda könnten die Gegensätze zwischen Arm und Reich nicht größer sein: Bettler hocken an den Straßenkreuzungen vor den protzigen Glitzerpalästen der internationalen Konzerne.“"
                                            },
                                            {
                                                "example_id": "f5b69738-5c69-459a-b0e9-716f5c15b68f",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„[…] wer [in Russland] die richtigen Verbindungen hat, bekommt ein Grundstück in Toplage und baut sich statt einem Holzhaus eine protzig-prunkvolle Villa.“"
                                            },
                                            {
                                                "example_id": "8f35455d-8b40-410a-a62c-530e15d0240b",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„[…] 'ritzy' [nach den Hotels der Ritz-Carlton-Kette] ist zu einem englischsprachigen Begriff geworden, mit dem bis heute Dinge von nobel bis protzig bezeichnet werden können.“"
                                            },
                                            {
                                                "example_id": "521fdc61-7d74-4f35-b7db-d09ebdcd03da",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„Die Kirche hat [im 15. Jahrhundert] mit dem schlechten Gewissen der Menschen Kasse gemacht und mit dem eingetriebenen Geld […] protzige Kirchenbauten finanziert. Erst […] Martin Luther hat diesem skandalösen Treiben ein Ende gesetzt.“"
                                            },
                                            {
                                                "example_id": "c71c89d6-bc55-4cca-b825-ff4e11550e25",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„»Hitler residiert hier wirklich als König«, schilderte ein Zeitgenosse seinen Besuch im 'Braunen Haus', das so protzig ausstaffiert war, dass man es als 'braunes Operettenhaus' und 'Haus Größenwahn' verspottete.“"
                                            },
                                            {
                                                "example_id": "2180026a-6a40-4082-b60c-d33f00e25096",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„Im Interview spricht [der afrikanische Superstar Yemi Alade] über Feminismus im nigerianischen Musikbiz und erklärt, warum es wichtig ist, sich als Afrikanerin auch flashy und protzig zu zeigen.“"
                                            },
                                            {
                                                "example_id": "23d35bba-7b53-498c-8389-06f160a71169",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„[…] ein festliches Essen [ist] immer noch ein Muss für jedes Familien- oder Schulklassentreffen, aber es wird nicht mehr so protzig bestellt. Die Zeit des ungezügelten Fleischkonsums ist vorbei.“"
                                            },
                                            {
                                                "example_id": "23dcc75b-0268-4876-bcf8-40053fd3d69c",
                                                "sense_id": "f8e1dab8-0f3c-3b40-a864-979b30a00c2f",
                                                "text": "„Die [CD-]Aufnahme begrüßt den Hörer mit einer Trompetenfanfare. Aber sie ist nicht besonders laut oder protzig, sondern zart und elegant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
