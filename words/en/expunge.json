{
    "word_family": [
        "expunction"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a377f0be-8758-3032-b58e-7efd12c40760",
                    "sense_definition": "To remove or erase completely, especially from a written record or legal document.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer petitioned the court to <w>expunge</w> the juvenile offense from her permanent record."
                        },
                        {
                            "text": "The clerk was ordered to <w>expunge</w> the controversial remark from the official meeting minutes."
                        }
                    ],
                    "synonyms": [
                        "erase",
                        "strike out",
                        "delete"
                    ],
                    "antonyms": [
                        "record",
                        "insert"
                    ],
                    "common_phrases": [
                        "expunge a record",
                        "expunge from memory"
                    ]
                },
                {
                    "sense_id": "4a443e57-ebec-3aab-86e5-9bc34011fddc",
                    "sense_definition": "To eliminate, wipe out, or destroy completely so that no trace remains.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destroy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried desperately to <w>expunge</w> all painful memories of the accident from his mind."
                        },
                        {
                            "text": "The invading army sought to <w>expunge</w> any trace of the local culture and language."
                        }
                    ],
                    "synonyms": [
                        "annihilate",
                        "obliterate",
                        "eradicate"
                    ],
                    "antonyms": [
                        "preserve",
                        "create"
                    ],
                    "common_phrases": [
                        "expunge all trace"
                    ]
                },
                {
                    "sense_id": "83716e0a-ef3a-3fe9-bd16-b944e76df833",
                    "sense_definition": "To permanently purge or delete data, such as emails, that were previously marked for deletion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The email client will automatically <w>expunge</w> all deleted messages at the end of each session."
                        },
                        {
                            "text": "After backing up the database, the administrator decided to <w>expunge</w> the archived logs permanently."
                        }
                    ],
                    "synonyms": [
                        "purge"
                    ],
                    "antonyms": [
                        "restore"
                    ],
                    "common_phrases": [
                        "expunge deleted messages"
                    ]
                }
            ]
        }
    ]
}