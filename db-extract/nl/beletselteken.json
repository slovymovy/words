                        "target_lang_word": "ellipsis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ellipsis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "A mark consisting of multiple full stops (with or without spaces), used to indicate omitted, missing, or illegible words; or (in mathematics) that a pattern continues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf88038-6e9d-492a-aeda-4158de5046c7",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "The ellipsis in 1, 2, 3, ..., 8, 9 means that the numbers 4, 5, 6, and 7 are not explicitly included, but are considered to be part of the pattern."
                                            },
                                            {
                                                "example_id": "24622cfa-058e-46aa-8f76-333fcec80359",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "The ellipsis in 0.333... means that the number is a repeating decimal, having threes that go on forever."
                                            },
                                            {
                                                "example_id": "cecd226d-42d0-411a-a1f9-6c6eee952733",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "CARD: Hey Baby. Thanks for the … last night. Love you!\nHAZEL: Wow. I've never despised an ellipsis so much in my life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d55e460-36e9-3e95-b838-e68742767733",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "The omission of a word or phrase that can be inferred from the context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "The omission of scenes in a film that do not advance the plot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751686c1-4bac-411c-92d7-ea793c111853",
                                                "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                                                "text": "It was now possible for writers and directors to cut scenes that did not further the plot; called \"ellipses\" by filmmakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ab923c-841e-3ec5-83f9-fa8f981c656f",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "An ellipse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "864222d3-bde2-4b14-8f02-cae1c36c00b7",
                        "source_entry_id": "280c9a89-f22b-3046-89ed-edd16fc5f198",
