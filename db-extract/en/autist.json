                                "target_senses": [
                                    {
                                        "sense_id": "8cc75e74-2d01-3aee-8c2f-70a54429bdfc",
                                        "entry_id": "b7916546-1a93-3938-886a-2315fb766c79",
                                        "glosses": [
                                            "weibliche Person mit Autismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a39239c-f9e6-4ecf-87c3-3bd39d0a15f0",
                                                "sense_id": "8cc75e74-2d01-3aee-8c2f-70a54429bdfc",
                                                "text": "„Dass Sie jedoch gerade mit einer Autistin gesprochen haben – das würden Sie niemals auch nur vermuten.“"
                                            },
                                            {
                                                "example_id": "ee012b12-a35f-44fc-bf67-9fbc47b9ceb3",
                                                "sense_id": "8cc75e74-2d01-3aee-8c2f-70a54429bdfc",
                                                "text": "„Wenn Babette von diesen Statistiken anfängt, könnte man sie glatt für eine Autistin halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
