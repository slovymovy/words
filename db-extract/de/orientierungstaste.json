                "senses": [
                    {
                        "sense_id": "6d542b67-e9e0-306e-aa21-101d5dea99bd",
                        "entry_id": "2ddfd2ce-7ec8-314b-acfb-d9d3e5faafbc",
                        "glosses": [
                            "Taste auf Tastaturen von Geräten (Computer, Telefon …), auf der eine kleine Erhebung ist, um Personen mit Sehbehinderungen die Bedienung zu erleichtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d299257-3a6a-47e6-915b-f44d96e3bce1",
                                "sense_id": "6d542b67-e9e0-306e-aa21-101d5dea99bd",
                                "text": "„Und statt sich auf Orientierungstasten, Fühlpunkte und die Grundposition seiner Zeigefinger zu konzentrieren, träumte sich Yehya in eine der Zellen des Gefängnisses.“"
                            },
                            {
                                "example_id": "285cc365-210c-4180-8618-bc8d4d5ef6d1",
                                "sense_id": "6d542b67-e9e0-306e-aa21-101d5dea99bd",
                                "text": "„Zur weiteren Ausstattung zählen drei taktile Orientierungstasten, eine Notruffunktion sowie eine Braille-Beschriftung der Tasten.“"
                            },
                            {
                                "example_id": "6980406d-6a69-4484-9790-880d07d5dc7b",
                                "sense_id": "6d542b67-e9e0-306e-aa21-101d5dea99bd",
                                "text": "„Als Orientierungstasten gelten auf der QWERTZ-Tastatur das ‚F‘ und das ‚J‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
