                                        "examples": [
                                            {
                                                "example_id": "a363cbd7-02a4-4eb7-8850-73684735d214",
                                                "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                                                "text": "\"Secretaris-generaal FIFA maakte 10 miljoen dollar aan smeergeld over\""
                                            },
                                            {
                                                "example_id": "92daa3c9-2476-4073-8df1-7431c78c91ec",
                                                "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                                                "text": "Corruptie, smeergeld, ontbossing: Nederland krijgt er met vleesgigant JBS een omstreden multinational bij."
                                            },
                                            {
                                                "example_id": "74143d71-51dc-4cf9-99d2-ecb462b7a8ae",
                                                "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                                                "text": "Daar betoogde hij vol vuur dat het Brits-Nederlandse Shell in 2011 samen met het Italiaanse Eni een miljard dollar aan smeergeld had betaald om een groot olieveld voor de kust van Nigeria in handen te krijgen."
                                            }
                                        ]
