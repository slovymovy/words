                    "sense_id": "a8f7fbec-fb6e-3a3a-9063-7b3443616fed",
                    "sense_definition": "simple past and past participle of <w>misunderstand</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "misunderstood_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry if I <w>misunderstood</w> your original instructions yesterday.",
                            "target_lang_translations": {
                                "es": "Siento si ayer <w>entendí mal</w> tus instrucciones originales."
                            }
                        },
                        {
                            "text": "The tourists <w>misunderstood</w> the map and took the wrong exit on the highway.",
                            "target_lang_translations": {
                                "es": "Los turistas <w>malinterpretaron</w> el mapa y tomaron la salida equivocada en la autopista."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio pasado de malinterpretar o entender mal."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "malinterpretó",
                                "target_lang_sense_clarification": "forma en pasado de malinterpretar"
                            },
                            {
                                "target_lang_word": "malentendido",
                                "target_lang_sense_clarification": "participio de malentender"
                            },
                            {
                                "target_lang_word": "entendió mal",
                                "target_lang_sense_clarification": "forma en pasado de entender erróneamente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e561b53-6c24-34a5-9b45-c80a27321d4c",
                    "sense_definition": "Not comprehended correctly or interpreted properly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misunderstood_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The message was widely <w>misunderstood</w> due to vague phrasing.",
                            "target_lang_translations": {
                                "es": "El mensaje fue ampliamente <w>malinterpretado</w> debido a una redacción ambigua."
                            }
                        },
                        {
                            "text": "Quantum physics remains a deeply <w>misunderstood</w> concept among the general public.",
                            "target_lang_translations": {
                                "es": "La física cuántica sigue siendo un concepto profundamente <w>malentendido</w> entre el público general."
                            }
                        }
                    ],
                    "synonyms": [
                        "misinterpreted",
                        "misconstrued"
                    ],
                    "antonyms": [
                        "comprehended",
                        "understood"
                    ],
                    "common_phrases": [
                        "widely misunderstood",
                        "frequently misunderstood"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no ha sido comprendido correctamente o que ha sido interpretado de forma errónea."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "malinterpretado",
                                "target_lang_sense_clarification": "interpretado de manera errónea"
                            },
                            {
                                "target_lang_word": "malentendido",
                                "target_lang_sense_clarification": "no comprendido adecuadamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9713b67b-ff84-3e77-971f-098c6590b436",
                    "sense_definition": "Not viewed with sympathy, appreciation, or understanding despite deserving it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misunderstood_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always portrayed himself as a <w>misunderstood</w> artist whose work was ahead of its time.",
                            "target_lang_translations": {
                                "es": "Siempre se presentaba a sí mismo como un artista <w>incomprendido</w> cuya obra se adelantaba a su tiempo."
                            }
                        },
                        {
                            "text": "Many teenagers feel entirely <w>misunderstood</w> by their parents and teachers.",
                            "target_lang_translations": {
                                "es": "Muchos adolescentes se sienten completamente <w>incomprendidos</w> por sus padres y profesores."
                            }
                        }
                    ],
                    "synonyms": [
                        "underappreciated",
                        "unappreciated"
                    ],
                    "antonyms": [
                        "appreciated"
                    ],
                    "common_phrases": [
                        "feel misunderstood",
                        "misunderstood genius",
                        "misunderstood artist"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no es apreciado o valorado justamente por los demás; incomprendido."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "incomprendido",
                                "target_lang_sense_clarification": "que no recibe empatía o reconocimiento"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}