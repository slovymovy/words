                                "example_id": "196df33a-a041-4f4e-832f-45564aac44d8",
                                "sense_id": "a96b2159-d515-3c0c-82ce-ac8830070725",
                                "text": "There has been a satisfactory coördination of the events occurring in widely separated sections, and there has been a competent delineation of differing characters and a vivid presentation of conflicting interests."
                            },
                            {
                                "example_id": "03763039-1634-4867-a211-3fe9bc5b438d",
                                "sense_id": "a96b2159-d515-3c0c-82ce-ac8830070725",
                                "text": "His was a better, far better, nervous, mental, and muscular coördination."
                            },
