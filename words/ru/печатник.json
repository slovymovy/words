    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a37d7bb-16a7-3e49-a86c-bbd6af5d4649",
                    "sense_definition": "Работник типографии, специалист по печатному делу.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "профессия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный <w>печатник</w> внимательно проверял качество каждого свежего оттиска.",
                            "target_lang_translations": {
                                "pl": "Doświadczony <w>drukarz</w> uważnie sprawdzał jakość każdej świeżej odbitki."
                            }
                        },
                        {
                            "text": "В этой типографии <w>печатники</w> работают посменно на современном оборудовании.",
                            "target_lang_translations": {
                                "pl": "W tej drukarni <w>drukarze</w> pracują na zmiany na nowoczesnym sprzęcie."
                            }
                        }
                    ],
                    "synonyms": [
                        "типограф",
                        "типографщик"
                    ],
                    "common_phrases": [
                        "опытный печатник",
                        "профессия печатника"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pracownik drukarni, specjalista w zakresie druku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drukarz",
                                "target_lang_sense_clarification": "zawód związany z drukiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46ce2cc6-11b1-3adf-b747-570160836380",
                    "sense_definition": "В Московском государстве: должностное лицо, хранившее государственную печать и скреплявшее ею грамоты и документы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "историческая_должность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Царский <w>печатник</w> приложил золотую печать к новому международному договору.",
                            "target_lang_translations": {
                                "pl": "Carska pieczęć została przyłożona do nowego traktatu międzynarodowego przez carskiego <w>pieczętarza</w>."
                            }
                        },
                        {
                            "text": "В старинных грамотах нередко упоминается подпись великого государева <w>печатника</w>.",
                            "target_lang_translations": {
                                "pl": "W dawnych dokumentach nierzadko wspomina się o podpisie wielkiego hospodarskiego <w>pieczętarza</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "государев печатник"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "исторический термин Московского государства"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W dawnym państwie moskiewskim: urzędnik sprawujący pieczę nad pieczęcią państwową, pieczętarz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pieczętarz",
                                "target_lang_sense_clarification": "urzędnik królewski lub państwowy trzymający pieczęć"
                            },
                            {
                                "target_lang_word": "pieczętarnik",
                                "target_lang_sense_clarification": "urzędnik pilnujący pieczęci"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}