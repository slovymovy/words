                        "glosses": [
                            "Personne qui porte un veau sur ses épaule. Il s’agit d’une représentation artistique antique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e43ae4-6856-4768-a3f3-ad6e88b76cd4",
                                "sense_id": "4e01cf7b-8117-3713-8c29-55ac9f203aae",
                                "text": "Boussac tranche en faveur de la seconde hypothèse : certains sceaux permettent d'identifier le moschophore repéré sur le relief de Fourni avec Hermès, …."
                            },
                            {
                                "example_id": "de5f3b94-48ba-40c8-9e90-66c9a6761cfd",
                                "sense_id": "4e01cf7b-8117-3713-8c29-55ac9f203aae",
                                "text": "parce qu'il s'agit d'un sujet qui engage profondément la foi et le cœur des chrétiens, est celui du Bon Pasteur de l'Évangile, traité à la manière des « moschophores » ou bergers porteurs d'agneaux, des ateliers antiques."
                            }
                        ]
