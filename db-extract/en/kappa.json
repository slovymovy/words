                                            {
                                                "example_id": "a135bfcf-8f66-4fd6-8b52-9c8c309dc0f5",
                                                "sense_id": "2f4a258d-479c-3f54-851b-b56beec5b901",
                                                "text": "Ajouter la poudre de kappa et porter à ébullition."
                                            },
                                            {
                                                "example_id": "5fce1bc9-de3d-4bae-9ab3-ba782f9cc70b",
                                                "sense_id": "2f4a258d-479c-3f54-851b-b56beec5b901",
                                                "text": "Ainsi, pour gélifier un lait allégé (pauvre en lipides), il vaut mieux utiliser un kappa carraghénane extrait de Kappaphycus alvarezii moins réactif que celui obtenu à partir de Chondrus crispus, trop hydrophobe."
                                            }
