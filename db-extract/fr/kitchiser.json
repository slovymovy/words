                "senses": [
                    {
                        "sense_id": "50ec93f6-38d9-3020-baf2-7c5110660b80",
                        "entry_id": "6743e762-631c-3b17-9c54-f107d2f2b3d9",
                        "glosses": [
                            "Donner un caractère kitch à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce3ab02-f623-4fb7-a737-8de1f296f7ba",
                                "sense_id": "50ec93f6-38d9-3020-baf2-7c5110660b80",
                                "text": "Je vais kitchiser l’image pieuse, j’ai envie de plein de couleurs de filles et de paillettes qui brille ^([sic : brillent])…"
                            },
                            {
                                "example_id": "c596736c-918e-42a6-b081-9077960c29b3",
                                "sense_id": "50ec93f6-38d9-3020-baf2-7c5110660b80",
                                "text": "Tu as à présent le pouvoir de pouvoir tout kitchiser !"
                            },
                            {
                                "example_id": "3b04a1e8-cf1e-4c1b-a553-d237b33e4393",
                                "sense_id": "50ec93f6-38d9-3020-baf2-7c5110660b80",
                                "text": "Hautement Graphique, ce calendrier dépoussière un produit qui commençait à se kitchiser."
                            }
                        ]
                    }
