                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7ea236ef-9d90-46dd-886b-b2cb8798522b",
                        "entry_id": "fbe9d84d-c317-3f9e-8085-0a34530dd7ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "bashfulnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7fce621-a7e5-3b3f-a789-20cfe46ae767",
                        "entry_id": "fbe9d84d-c317-3f9e-8085-0a34530dd7ba",
                        "glosses": [
                            "The quality or property of being bashful"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fa29d347-1a16-48d3-bc59-2d1296aef3db",
                                "sense_id": "b7fce621-a7e5-3b3f-a789-20cfe46ae767",
                                "text": "I, smiling in his face, took the letter, and immediately catching gently hold of his shirt sleeve, drew him towards me, blushing, and almost trembling; for surely his extreme bashfulness, and utter inexperience, call'd for, at least, all the advances to encourage him",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a3c182-196a-45ab-b334-254621b2a2f4",
                        "source_entry_id": "fbe9d84d-c317-3f9e-8085-0a34530dd7ba",
                        "source_sense_id": "b7fce621-a7e5-3b3f-a789-20cfe46ae767",
                        "source_sense_description": "the quality or property of being bashful",
                        "target_lang_word": "Scham",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scham",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                        "entry_id": "4b995af6-5003-310d-9a76-c6d54de76428",
                                        "glosses": [
                                            "angstbesetztes Empfinden, das meist durch eigenes und von anderen beobachtbares Fehlverhalten ausgelöst wird, durch das man deren Achtung zu verlieren droht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478f1335-66f6-4982-a142-9ac8cec7d969",
                                                "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                                "text": "Als alle mich nackt sehen konnten, war meine Scham groß."
                                            },
                                            {
                                                "example_id": "047ff2f5-3610-41a7-8922-2bb4fd61a621",
                                                "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                                "text": "Vor Scham errötete er tief."
                                            },
                                            {
                                                "example_id": "c7530548-f2ea-432e-8828-1b3267aaa020",
                                                "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                                "text": "„Die Folterknechte dürfen sich über alle Gebote der Scham und alle Bestimmungen des weltlichen und kirchlichen Rechts hinwegsetzen.“"
                                            },
                                            {
                                                "example_id": "08349c51-2ed2-4a85-b3eb-66073402c628",
                                                "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                                "text": "„Diese Scham überfiel sie plötzlich, durchdrang ihre Gesten, verschattete ihre Schönheit und machte ihre Augen stumpf.“"
                                            },
                                            {
                                                "example_id": "4ec6345b-7ccf-44f5-b71d-83c0a89113ef",
                                                "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                                "text": "„Das Gefühl übermannte mich; doch ich empfand eher Scham als Rührung.“"
                                            },
                                            {
                                                "example_id": "634c61ba-b63c-4301-b3d7-8501e21ef4ea",
                                                "sense_id": "e4d30b27-141d-3b57-afb1-6e1ab1d597a7",
                                                "text": "„Die Scham überrollte mich in großen Wellen und ich spürte, dass ich rot wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7df9c3a1-8813-3789-b90c-9b7a255bc769",
                                        "entry_id": "4b995af6-5003-310d-9a76-c6d54de76428",
                                        "glosses": [
                                            "die Gegend der Geschlechtsteile beim Menschen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e99c0b0-e524-48fc-8313-ca45b5fecfbf",
                                                "sense_id": "7df9c3a1-8813-3789-b90c-9b7a255bc769",
                                                "text": "Bedecke deine Scham!"
                                            },
                                            {
                                                "example_id": "6ee61d46-d68e-4bc0-bf53-1a2bd7f13704",
                                                "sense_id": "7df9c3a1-8813-3789-b90c-9b7a255bc769",
                                                "text": "„Ein eiserner Handlauf hatte sich in die Hüfte gebohrt und war bei ihrer Scham wieder aus dem Körper herausgetreten.“"
                                            },
                                            {
                                                "example_id": "d12eb0e3-fbc8-41c6-973d-0305c37183fd",
                                                "sense_id": "7df9c3a1-8813-3789-b90c-9b7a255bc769",
                                                "text": "„Bis auf die türkis geäderten Brüste, die leicht gebräunten Schultern und Schenkel war ihr Körper vom Wasser umspült, und träge seifte sie ihre Scham ein.“"
                                            },
                                            {
                                                "example_id": "073e0a37-8e8d-4f60-bd2a-c8962e3f4f03",
                                                "sense_id": "7df9c3a1-8813-3789-b90c-9b7a255bc769",
                                                "text": "„Sie öffnete ihre Scham, als ziehe sie einen Vorhang beiseite; der arme Betrachter geriet in stärkste Bedrängnis.“"
                                            },
                                            {
                                                "example_id": "af54223f-d7cd-4cb5-986b-a27b5bb8d7a5",
                                                "sense_id": "7df9c3a1-8813-3789-b90c-9b7a255bc769",
                                                "text": "„Simen Tjing betrachtete und betastete seine Partnerin: weich und zart war ihre Haut, dicht und fest standen die Haare um ihre Scham.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
