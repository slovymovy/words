                "senses": [
                    {
                        "sense_id": "ec405bd5-965e-3e2b-ac00-013b59bb34ef",
                        "entry_id": "62d2fb2a-4656-3f01-bc0d-7100a98657b2",
                        "glosses": [
                            "Faire perdre à quelque chose ou quelqu’un son caractère haïtien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f8a063-5c8f-4645-bf9d-0ac3fc93f316",
                                "sense_id": "ec405bd5-965e-3e2b-ac00-013b59bb34ef",
                                "text": "Le maire de Dajabón appelle ses collègues à « déshaïtianiser » la Rép. Dominicaine en « pourchassant les Haïtiens des 158 municipalités » du pays"
                            },
                            {
                                "example_id": "978006b4-00c1-4e62-bfd6-c32fc67a11b0",
                                "sense_id": "ec405bd5-965e-3e2b-ac00-013b59bb34ef",
                                "text": "Il faut « déshaïtianiser » Roumain et le placer dans un contexte mondial et latino-américain."
                            },
                            {
                                "example_id": "ef06065e-afa1-4b86-93d6-8fc558f6982b",
                                "sense_id": "ec405bd5-965e-3e2b-ac00-013b59bb34ef",
                                "text": "La bourgeoisie haïtienne fait tout pour se « déshaïtianiser »."
                            },
                            {
                                "example_id": "ec2b556a-9533-4cec-a317-1b097324c1a3",
                                "sense_id": "ec405bd5-965e-3e2b-ac00-013b59bb34ef",
                                "text": "Mon pays se déshumanise et se déshaïtianise"
                            }
                        ]
                    }
                ],
