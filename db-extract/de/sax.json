                        "examples": [
                            {
                                "example_id": "7afb2b87-03f1-4d7c-a19a-a888bbef5fbd",
                                "sense_id": "942b6f39-7d2b-32e6-8e70-814233f9f8cf",
                                "text": "„Ein Sax ist zumeist eine einschneidige Hiebwaffe mit einer Klingenlänge zwischen 40 und 70cm.“"
                            },
                            {
                                "example_id": "d822f525-b084-46fb-acd5-c3fd1dca9e7f",
                                "sense_id": "942b6f39-7d2b-32e6-8e70-814233f9f8cf",
                                "text": "„Sie enthielten alle eine Spatha; hinzu kamen an Waffen in Ramsen Sax und Schild, in Haldenegg Lanze und Schild und in Irslingen lediglich ein Sax.“"
                            }
                        ],
