{
    "word_family": [
        "complacency",
        "complacently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43dcd5d6-3b1e-3154-9605-265e076ec66e",
                    "sense_definition": "Uncritically satisfied with oneself or one's achievements; smug.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "self-satisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew <w>complacent</w> as the years rolled on and the money rolled in.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>самодовольным</w> по мере того, как шли годы и текли деньги."
                            }
                        },
                        {
                            "text": "We cannot afford to become <w>complacent</w> about our success in the market.",
                            "target_lang_translations": {
                                "ru": "Мы не можем позволить себе проявить <w>беспечность</w> из-за нашего успеха на рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "smug",
                        "self-satisfied"
                    ],
                    "antonyms": [
                        "humble",
                        "modest"
                    ],
                    "common_phrases": [
                        "become complacent",
                        "grow complacent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Критически не оценивающий себя, чрезмерно удовлетворенный собой или своими достижениями; самодовольный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самодовольный",
                                "target_lang_sense_clarification": "удовлетворенный собой или своими успехами"
                            },
                            {
                                "target_lang_word": "благодушный",
                                "target_lang_sense_clarification": "излишне спокойный и довольный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b77cdd06-5706-32ec-b9c4-979c83eecc28",
                    "sense_definition": "Unduly unworried or apathetic with regard to a need or problem.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "apathetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government was accused of being <w>complacent</w> about the rising threat of climate change.",
                            "target_lang_translations": {
                                "ru": "Правительство обвинили в <w>беспечном</w> отношении к растущей угрозе изменения климата."
                            }
                        },
                        {
                            "text": "He tried to paint his audience as <w>complacent</w>, yelling that if they weren't mad as hell then they weren't paying enough attention.",
                            "target_lang_translations": {
                                "ru": "Он пытался выставить своих слушателей <w>равнодушными</w>, крича, что если они не в ярости, то просто не обращают должного внимания."
                            }
                        }
                    ],
                    "synonyms": [
                        "placid"
                    ],
                    "antonyms": [
                        "concerned",
                        "vigilant"
                    ],
                    "common_phrases": [
                        "complacent attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Излишне беззаботный, равнодушный или апатичный по отношению к какой-либо проблеме или потребности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "не проявляющий должной тревоги или бдительности"
                            },
                            {
                                "target_lang_word": "равнодушный",
                                "target_lang_sense_clarification": "безучастный к существующей проблеме"
                            },
                            {
                                "target_lang_word": "апатичный",
                                "target_lang_sense_clarification": "не проявляющий интереса или беспокойства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}