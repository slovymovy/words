                            {
                                "example_id": "828096ad-a177-4b7b-ba1d-9b5917f6cda3",
                                "sense_id": "290d4112-a0f1-32dd-93d2-ea0f2dd15927",
                                "text": "„Der Mann hatte ein Fläschchen gefunden, das er nach eigenen Angaben irrtümlich für einen Parfümflakon hielt und seiner Freundin schenkte. Sie soll sich mit der Flüssigkeit eingerieben haben – die dreifache Mutter starb acht Tage nachdem sie ins Krankenhaus eingeliefert worden war.“"
                            }
                        ],
