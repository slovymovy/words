                                "example_id": "a19fd46c-cd71-4128-86c7-c248eb5902cd",
                                "sense_id": "78ef53f5-cc47-36e8-a561-83b48f96d9b3",
                                "text": "Bei der Buchung hatten wir schweinemäßiges Glück und kriegten die letzten freien Plätze."
                            },
                            {
                                "example_id": "69f8e800-a6d8-4fdb-bc21-4fc3646bfb6c",
                                "sense_id": "78ef53f5-cc47-36e8-a561-83b48f96d9b3",
                                "text": "Das Restaurant hat aber schweinemäßige Preise, das weißt du?"
                            },
                            {
                                "example_id": "d29120eb-7f4e-45f8-8494-b7c9768628f6",
                                "sense_id": "78ef53f5-cc47-36e8-a561-83b48f96d9b3",
                                "text": "So ein Flug ist schweinemäßig teuer."
                            },
                            {
                                "example_id": "f1a4f4fc-56bc-485e-aa56-800034c51b1c",
                                "sense_id": "78ef53f5-cc47-36e8-a561-83b48f96d9b3",
                                "text": "Im Urlaub hatten wir mal wieder schweinemäßiges Wetter."
                            }
