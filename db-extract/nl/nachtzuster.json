                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f00ebe-e0e4-4f6e-bae7-7c225f145d20",
                                "sense_id": "a8510664-10e2-3492-9545-1e08ba3c7b13",
                                "text": "In ‘Nachtzuster’ kreeg de eersteklas blazerssectie vrij spel en mocht Vrien­ten zijn hoogste stemmetje opzetten om ‘Doe iets aan de pij-ijn’ te smeken."
                            },
                            {
                                "example_id": "8980631a-be11-44a9-81b7-f70af4a43985",
                                "sense_id": "a8510664-10e2-3492-9545-1e08ba3c7b13",
                                "text": "De directie van Reggeland Zorgvoorzieners in Almelo heeft met een nieuwe brief geprobeerd om de ongerustheid onder bewoners van woonzorgcentrum Buurstede weg te nemen. Die ongerustheid is ontstaan doordat in een eerdere brief werd aangekondigd dat de 'eigen' nachtzuster uit Buurstede gaat verdwijnen."
                            }
                        ]
                    }
