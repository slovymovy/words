                                        "glosses": [
                                            "stoj na rukou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89709dea-d4c6-41ea-b86d-eddabd1ea086",
                                                "sense_id": "8974e318-37a2-3970-aa24-105bd86b051d",
                                                "text": "Sestavy obsahují jak švihové prvky (např. veletoče, výmyky, stojka), tak silové."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd03a31e-9895-3b6c-9377-635b0eb24da4",
                                        "entry_id": "a544225c-4500-3f24-9ae4-a7a006af7309",
                                        "glosses": [
                                            "střelecká položka vestoje, např. v biatlonu"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236f9a7e-6c55-426c-b659-c5030b3d6fa9",
                                                "sense_id": "fd03a31e-9895-3b6c-9377-635b0eb24da4",
                                                "text": "Ležku jsem proto odstřílel hodně pomalu a opatrně, stojka už byla v pořádku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf014c07-ab64-30f1-a483-18f2144fa436",
                                        "entry_id": "a544225c-4500-3f24-9ae4-a7a006af7309",
                                        "glosses": [
                                            "svislá důlní podpěra"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e335d91-5c72-40dc-a2b7-7bd8ebe9c3c8",
                                                "sense_id": "bf014c07-ab64-30f1-a483-18f2144fa436",
                                                "text": "Norma platí pro projekci a konstrukci nových typů důlních stojek hydraulických s vnějším plněním (dále jen stojek) které jsou prvkem individuální porubní výztuže, vyvíjených po dni účinnosti této normy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21dcf7c9-760c-32ea-a498-583789e2c70d",
                                        "entry_id": "a544225c-4500-3f24-9ae4-a7a006af7309",
                                        "glosses": [
                                            "stráž, hlídka"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02727e3a-a4d9-401c-88ee-ed125083fd50",
                                                "sense_id": "21dcf7c9-760c-32ea-a498-583789e2c70d",
                                                "text": "Každý voják stává v šest hodin ráno. Ve čtyřiadvacetihodinové službě se střídá tzv. hodinová stojka, poté hotovost na strážnici, odpočinek, který následně může vystřídat spánek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b60b1b-847a-36f1-bd52-889f38cadca6",
                                        "entry_id": "a544225c-4500-3f24-9ae4-a7a006af7309",
                                        "glosses": [
                                            "druh stojaté divadelní kulisy"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b44209b7-c505-4913-95eb-f1fef6d7d0b7",
                                                "sense_id": "e3b60b1b-847a-36f1-bd52-889f38cadca6",
                                                "text": "Opona ještě nesjela, když čtyřicet rukou popadne stojky a praktikáble a začne „bourat“."
                                            }
                                        ]
