                                                "sense_id": "b0f8f6be-566a-30a7-9357-079d2d6ded7d",
                                                "text": "Vos supérieurs aiment votre créativité et vous pourriez obtenir une prime. Youhou !"
                                            },
                                            {
                                                "example_id": "763c0153-92ae-4fda-ab2c-7c6e5c0a19e4",
                                                "sense_id": "b0f8f6be-566a-30a7-9357-079d2d6ded7d",
                                                "text": "Youhou ! On va se baigner à la rivière, génial ! Youhou !"
                                            },
                                            {
                                                "example_id": "8c6b6b3b-8527-40d3-894e-9f1801bf3144",
                                                "sense_id": "b0f8f6be-566a-30a7-9357-079d2d6ded7d",
                                                "text": "Youhou, c’est enfin le Black Friday !"
                                            }
                                        ]
                                    }
                                ]
