                },
                {
                    "sense_id": "e71deb02-94e6-3e1a-aa84-28072087fe35",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>horen</w> (bij inversie)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hoor</w> je dat vreemde geluid in de gang ook?",
                            "target_lang_translations": {
