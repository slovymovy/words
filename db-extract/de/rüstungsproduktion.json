                "senses": [
                    {
                        "sense_id": "27634fcf-d6e4-3b33-bc99-f07c5c47224e",
                        "entry_id": "05f5768d-094a-3b56-9826-2ebe3fd4be18",
                        "glosses": [
                            "Produktion von Rüstungsgütern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f41442-3353-4d28-9a2e-f11d36965e90",
                                "sense_id": "27634fcf-d6e4-3b33-bc99-f07c5c47224e",
                                "text": "„Also forderten Hindenburg und Ludendorff eine Ausdehnung der Wehrpflicht auf alle Männer von 16 Jahren bis zum Rentenalter, sie sollten notfalls zwangsweise in der Rüstungsproduktion eingesetzt werden.“"
                            },
                            {
                                "example_id": "db7814e0-3ed0-435c-85db-324bc665ac02",
                                "sense_id": "27634fcf-d6e4-3b33-bc99-f07c5c47224e",
                                "text": "„Die Rüstungsproduktion stockte, der Schienen- und Straßenverkehr kam im Bombenhagel von Monat zu Monat mehr zum Erliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
