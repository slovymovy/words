                "senses": [
                    {
                        "sense_id": "88361e5e-ec95-369e-8ad1-bd5bfb681d3c",
                        "entry_id": "85e19bbe-f966-3518-bd66-bd402856cd4b",
                        "glosses": [
                            "een tent die ontworpen is voor gebruik tijdens een feest of een evenement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3a3999-9d7e-4696-a0dc-56ffc91efb96",
                                "sense_id": "88361e5e-ec95-369e-8ad1-bd5bfb681d3c",
                                "text": "‘Wij zijn heel lang, veel te lang, beschouwd als eendagsvliegen, met de legendarische hysterie zoals die in de feesttent van Kessel-Lo. Maar in 1995, ten tijde van Oker, is er iets veranderd."
                            },
                            {
                                "example_id": "a9a2244e-7fba-4b6a-852c-a1817f0613b9",
                                "sense_id": "88361e5e-ec95-369e-8ad1-bd5bfb681d3c",
                                "text": "De organisatie speelt in op de sfeer van de derde helft. Vorig jaar werd het concept voor het eerst georganiseerd. Met artiesten als Django Wagner, Dirk Meeldijk, Frans Duijts en Koos Alberts was de feesttent uitverkocht."
                            }
                        ]
                    }
                ],
