{
    "word_family": [
        "hisser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02a6e407-d3f3-33d7-b064-75c6ce85af5d",
                    "sense_definition": "A sharp, sibilant sound like that made by a snake or escaping steam.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake made a loud <w>hiss</w> before it slithered away into the tall grass.",
                            "target_lang_translations": {
                                "zh": "蛇在溜进高草丛之前发出了一声响亮的<w>嘶嘶声</w>。"
                            }
                        },
                        {
                            "text": "The steam escaped from the pipe with a constant <w>hiss</w> that filled the room.",
                            "target_lang_translations": {
                                "zh": "蒸汽从管道中不断喷出，发出充满整个房间的<w>嘶嘶声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fizz"
                    ],
                    "common_phrases": [
                        "loud hiss"
                    ],
                    "target_lang_definitions": {
                        "zh": "像蛇或蒸汽喷出时发出的尖锐嘶嘶声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘶嘶声",
                                "target_lang_sense_clarification": "指物体或动物发出的尖锐摩擦声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6aad997f-4e39-3661-9755-fe51263951b9",
                    "sense_definition": "A sound made by a crowd to show disapproval or contempt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unpopular politician was greeted with a chorus of <w>hisses</w> from the angry crowd.",
                            "target_lang_translations": {
                                "zh": "那位不受欢迎的政客遭到了愤怒人群的一片<w>嘘声</w>。"
                            }
                        },
                        {
                            "text": "The actor ignored the <w>hisses</w> and finished his performance with great confidence.",
                            "target_lang_translations": {
                                "zh": "演员无视了台下的<w>嘘声</w>，自信地完成了表演。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "人群为表示不满或蔑视而发出的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘘声",
                                "target_lang_sense_clarification": "指观众对表演者或演讲者表示不满的喝倒彩声。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "870f36d0-11e5-3ec2-8c34-d7b37c10c430",
                    "sense_definition": "To make a sharp, sibilant sound like air escaping.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry cat began to <w>hiss</w> when the dog came too close.",
                            "target_lang_translations": {
                                "zh": "当狗靠得太近时，那只愤怒的猫开始<w>嘶嘶作响</w>。"
                            }
                        },
                        {
                            "text": "The frying pan started to <w>hiss</w> as soon as the butter hit the hot surface.",
                            "target_lang_translations": {
                                "zh": "黄油一碰到滚烫的表面，平底锅就开始<w>嘶嘶作响</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fizz"
                    ],
                    "common_phrases": [
                        "pan hissed"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出像空气喷出时那样的尖锐嘶嘶声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘶嘶作响",
                                "target_lang_sense_clarification": "描述物体发出持续的嘶嘶声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "724fceef-5d5c-3a81-b3aa-65648e365710",
                    "sense_definition": "To show strong disapproval or contempt for someone by making a hissing sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disapproval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience began to <w>hiss</w> when the villain appeared on the screen.",
                            "target_lang_translations": {
                                "zh": "当反派出现在屏幕上时，观众开始<w>喝倒彩</w>。"
                            }
                        },
                        {
                            "text": "They tried to <w>hiss</w> the speaker off the stage because they disagreed with his views.",
                            "target_lang_translations": {
                                "zh": "他们试图通过<w>喝倒彩</w>将演讲者赶下台，因为他们不同意他的观点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hiss off"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过发出嘶嘶声来表示对某人的强烈不满或蔑视。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喝倒彩",
                                "target_lang_sense_clarification": "指通过发出嘘声来表达反对意见。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "362a0331-6564-33b3-b770-84e37802e89e",
                    "sense_definition": "To whisper something in an angry or urgent manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be quiet, she <w>hissed</w> as they crept past the sleeping guard.",
                            "target_lang_translations": {
                                "zh": "“安静，”当他们悄悄溜过熟睡的守卫时，她<w>低声怒斥</w>道。"
                            }
                        },
                        {
                            "text": "Don't tell him the truth, he <w>hissed</w> urgently into her ear.",
                            "target_lang_translations": {
                                "zh": "“别告诉他真相，”他急促地在她耳边<w>低声怒斥</w>道。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以愤怒或急促的方式低声说话。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "低声怒斥",
                                "target_lang_sense_clarification": "指压低声音但带有愤怒或紧迫感的说话方式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2515767c-0a59-3a7b-a91c-4c8dbd6cabb6",
                    "sense_definition": "To move quickly while making a hissing sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrow <w>hissed</w> through the air and hit the center of the target.",
                            "target_lang_translations": {
                                "zh": "箭<w>呼啸而过</w>，正中靶心。"
                            }
                        },
                        {
                            "text": "The car <w>hissed</w> along the wet road during the heavy rainstorm.",
                            "target_lang_translations": {
                                "zh": "暴雨中，汽车在湿滑的路上<w>呼啸而过</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "快速移动并伴有嘶嘶声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呼啸而过",
                                "target_lang_sense_clarification": "形容物体快速移动时发出的声音。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e536c84-a616-3a20-8024-f93b53aa4446",
                    "sense_definition": "To say something in a sharp, sibilant tone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hissed</w> a warning to her brother before the teacher walked in.",
                            "target_lang_translations": {
                                "zh": "在老师走进来之前，她<w>嘶声说</w>出警告提醒她的弟弟。"
                            }
                        },
                        {
                            "text": "The angry man <w>hissed</w> insults at the crowd as he was led away.",
                            "target_lang_translations": {
                                "zh": "当那个愤怒的男人被带走时，他向人群<w>嘶声说</w>出侮辱的话语。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用尖锐、嘶哑的语调说话。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘶声说",
                                "target_lang_sense_clarification": "指说话时带有明显的嘶嘶声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65576de4-4fb8-3bef-aced-325c24602f28",
                    "sense_definition": "To release a substance with a hissing sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine <w>hissed</w> steam into the air to clean the floor.",
                            "target_lang_translations": {
                                "zh": "机器向空中<w>喷出</w>蒸汽以清洁地板。"
                            }
                        },
                        {
                            "text": "He <w>hissed</w> air through his teeth to show his frustration.",
                            "target_lang_translations": {
                                "zh": "他从牙缝中<w>喷出</w>气流以表达他的沮丧。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "伴随着嘶嘶声释放出某种物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喷出",
                                "target_lang_sense_clarification": "指气体或液体伴随声音喷射出来。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f0e82fa-cc90-303d-9b3e-211f0cb04c2d",
                    "sense_definition": "To attract someone's attention by making a hissing sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stranger <w>hissed</w> at me from the shadows to get me to come closer.",
                            "target_lang_translations": {
                                "zh": "那个陌生人从阴影中向我<w>发出嘶声示意</w>，让我靠近。"
                            }
                        },
                        {
                            "text": "She <w>hissed</w> at her friend to signal that it was time to leave.",
                            "target_lang_translations": {
                                "zh": "她向朋友<w>发出嘶声示意</w>，暗示该离开了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过发出嘶嘶声来引起某人的注意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发出嘶声示意",
                                "target_lang_sense_clarification": "指通过声音信号吸引他人注意。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}