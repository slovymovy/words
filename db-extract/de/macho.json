                    {
                        "sense_id": "6a4f53ec-77ec-3793-bcea-e892c5dbe306",
                        "entry_id": "e60b7775-beb0-34ef-837f-3150e9c5460c",
                        "glosses": [
                            "abwertend: ein sich übertrieben männlich gebender Mann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbecfeda-f55f-413a-ac94-770e635a3437",
                                "sense_id": "6a4f53ec-77ec-3793-bcea-e892c5dbe306",
                                "text": "Er gibt wieder mal den Macho."
                            },
                            {
                                "example_id": "50314ae9-739d-433c-8d5b-b704e0477b14",
                                "sense_id": "6a4f53ec-77ec-3793-bcea-e892c5dbe306",
                                "text": "„Daraus spricht eine gewisse Sehnsucht nach dem Macho, die sich seit einiger Zeit immer verzweifelter äußert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9acdd5b-748f-4172-9209-7a3d8472039b",
                        "source_entry_id": "e60b7775-beb0-34ef-837f-3150e9c5460c",
                        "source_sense_id": "6a4f53ec-77ec-3793-bcea-e892c5dbe306",
                        "source_sense_description": "abwertend: ein sich übertrieben männlich gebender Mann",
                        "target_lang_word": "macho",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3775444-d5a8-321b-818b-a419aa2473ab",
                                        "entry_id": "ac0a4a2a-1b32-3f54-a691-550be4475e1e",
                                        "glosses": [
                                            "Masculine in an overly assertive or aggressive way."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae8822de-a310-4d0d-a6ad-6db7f8fe2bb1",
                                                "sense_id": "a3775444-d5a8-321b-818b-a419aa2473ab",
                                                "text": "macho culture"
                                            },
                                            {
                                                "example_id": "eb5224f2-6d47-4baf-84d3-8de8586149f5",
                                                "sense_id": "a3775444-d5a8-321b-818b-a419aa2473ab",
                                                "text": "I like sports because I enjoy knowing that many of these macho athletes have to vomit before a big game. Any guy who would take a job where you gotta puke first is my kinda guy."
                                            },
                                            {
                                                "example_id": "c410e2aa-c49f-498c-b10b-503a5c9587e0",
                                                "sense_id": "a3775444-d5a8-321b-818b-a419aa2473ab",
                                                "text": "The government’s “bullish” and “macho” approach to Brexit should not stop Conservative backbenchers from tabling amendments to the crucial repeal bill, a leading Tory remainer has said."
                                            },
                                            {
                                                "example_id": "19b5b163-2f15-493d-a9e0-e070e389a5d9",
                                                "sense_id": "a3775444-d5a8-321b-818b-a419aa2473ab",
                                                "text": "Joseph Biden has described Donald Trump’s refusal to wear a mask as “macho”, an insult unlikely to wound a president, who, before his illness, began rallies with speakers blasting the Village People’s 1979 song Macho Man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "macho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0377a3b-36fc-3b4c-86ac-3dac8f343521",
                                        "entry_id": "1b9a68c3-baa6-34de-920c-8e52ad2fff9f",
                                        "glosses": [
                                            "A macho person; a man who is masculine in an overly assertive or aggressive way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186c8cc0-38b4-4adb-af99-06dedbb39f61",
                                                "sense_id": "e0377a3b-36fc-3b4c-86ac-3dac8f343521",
                                                "text": "You can tell a macho, he has a funky walk / His western shirts and leather, always look so boss"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f69f664-44ca-37ff-8476-c0ae83c57e65",
                                        "entry_id": "1b9a68c3-baa6-34de-920c-8e52ad2fff9f",
                                        "glosses": [
                                            "Machismo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111955d9-d423-49fe-a6e9-aabb9de12d33",
                                                "sense_id": "9f69f664-44ca-37ff-8476-c0ae83c57e65",
                                                "text": "[…] about how the military is anti-gay and uses intimidation and peer pressure. How it promotes a sense of false macho and patriotism."
                                            },
                                            {
                                                "example_id": "05b4a81b-9f5c-4d12-9ca4-37cbb3032a6d",
                                                "sense_id": "9f69f664-44ca-37ff-8476-c0ae83c57e65",
                                                "text": "Though there was plentiful evidence to the contrary that should have made plain to him the hairy masculine macho of German gays, Hitler's stereotyped image perceived them as woman-like, surrendering, and therefore essentially weak."
                                            },
                                            {
                                                "example_id": "0012efe1-f968-42cb-bed0-26fdf998d857",
                                                "sense_id": "9f69f664-44ca-37ff-8476-c0ae83c57e65",
                                                "text": "On this day, when tens of millions of men, and women, are watching this yearly celebration of American macho, we'd like them to stop and think about the prevalence of male violence against women and what they can do to end it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c93132c-5b1e-336f-a6a0-306acc632d1e",
                                        "entry_id": "1b9a68c3-baa6-34de-920c-8e52ad2fff9f",
                                        "glosses": [
                                            "The striped mullet of California (Mugil cephalus, syn. Mugil mexicanus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdbfe9ea-86fb-3b34-8f00-a482ba39105a",
                                        "entry_id": "1b9a68c3-baa6-34de-920c-8e52ad2fff9f",
                                        "glosses": [
                                            "A male llama."
