                "senses": [
                    {
                        "sense_id": "4736a548-b03e-3763-bee6-0fc7e77e856c",
                        "entry_id": "1c5fd44a-69dd-355e-917b-1e56acadb394",
                        "glosses": [
                            "Cacher."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2578246f-7fed-422f-b6d8-61af223bc282",
                                "sense_id": "4736a548-b03e-3763-bee6-0fc7e77e856c",
                                "text": "Youenn était déjà planquousé dans la caravane et il m’avait affranchi."
                            },
                            {
                                "example_id": "53625389-558b-4f20-beca-66c6c397f8e3",
                                "sense_id": "4736a548-b03e-3763-bee6-0fc7e77e856c",
                                "text": "Planquousé dans le cabinet de débarras, face au débouché de l’escalier, le Grand tient les pantes dans la ligne de mire de son 38, la porte du réduit bâillant juste le nécessaire pour laisser passer le canon de l’arme, bien calée sur l’avant-bras gauche."
                            },
                            {
                                "example_id": "942ad462-8c60-4d31-aa73-a27e759b9343",
                                "sense_id": "4736a548-b03e-3763-bee6-0fc7e77e856c",
                                "text": "Je préfère qu’on les planquouse dans la grange, ce coup-ci. Elle ferme mieux."
                            }
                        ]
                    }
