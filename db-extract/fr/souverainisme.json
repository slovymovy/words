        "fr-extract.jsonl": [
            {
                "entry_id": "831e7a5e-a542-340c-99cc-ef7867025be5",
                "word": "souverainisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ce71ca78-78bc-40fe-9b67-908307d2da3b",
                        "entry_id": "831e7a5e-a542-340c-99cc-ef7867025be5",
                        "tags": [
                            "plural"
                        ],
                        "form": "souverainismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4c4bb6f-cc62-33ae-aad3-559b682b3093",
                        "entry_id": "831e7a5e-a542-340c-99cc-ef7867025be5",
                        "glosses": [
                            "Option politique selon laquelle le Québec devrait devenir un pays souverain, donc quitter la fédération canadienne."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "49833d81-721b-41c5-ae25-6827e67662a9",
                                "sense_id": "d4c4bb6f-cc62-33ae-aad3-559b682b3093",
                                "text": "Les fédéralistes, eux, abhorrent son souverainisme et les indépendantistes, en retour, l’accusent d'être trop mou."
                            },
                            {
                                "example_id": "bed6d620-727a-4f6c-963c-9390076b80bc",
                                "sense_id": "d4c4bb6f-cc62-33ae-aad3-559b682b3093",
                                "text": "Nationaliste, le journaliste reconnaît avoir voté OUI en 1980 et en 1995. Le discours de Jacques Parizeau, lors de cette seconde défaite, a transformé son souverainisme mou en fédéralisme pragmatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1ad22d7-2e27-3a6d-937c-d385e4c78571",
                        "entry_id": "831e7a5e-a542-340c-99cc-ef7867025be5",
                        "glosses": [
                            "Option politique basée sur la défense de la souveraineté de chaque pays, par opposition aux doctrines prônant une plus grande intégration européenne."
                        ],
                        "tags": [
                            "Europe"
                        ],
                        "examples": [
                            {
                                "example_id": "81758b4b-edc1-47c8-9bf2-c3173c0cacad",
                                "sense_id": "e1ad22d7-2e27-3a6d-937c-d385e4c78571",
                                "text": "La campagne du parti animé par l’industriel zurichois Christoph Blocher, axée sur la dénonciation de l’insécurité liée à l’immigration, la nécessité de réformes libérales pour sortir du marasme économique, la défense d’un souverainisme farouche hostile à une éventuelle adhésion à l’Union européenne, séduit une Suisse gagnée par le doute."
                            },
                            {
                                "example_id": "9659b18b-63c1-4f89-8519-6e53c3c838a6",
                                "sense_id": "e1ad22d7-2e27-3a6d-937c-d385e4c78571",
                                "text": "À l’opposition souverainisme/européisme, trame de l’affrontement autour du traité de Maastricht, se substitue une mosaïque de oui-non aux motivations variées."
                            }
                        ]
                    }
                ],
