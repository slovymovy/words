                    {
                        "sense_id": "7489000d-d2ad-3b7b-8be2-b208e5b3266d",
                        "entry_id": "097e506c-87db-3119-870d-2b6683bca28c",
                        "glosses": [
                            "eine Sammelbezeichnung für mehrere Arten hochgiftiger Doldengewächse (Umbelliferae, Apiaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "813a1775-98c2-48f0-ae82-ed08f1e487f8",
                                "sense_id": "7489000d-d2ad-3b7b-8be2-b208e5b3266d",
                                "text": "Der Schierling ist eine einheimische Giftpflanze."
                            },
                            {
                                "example_id": "4ec8376a-6255-4643-bafb-c8069104088a",
                                "sense_id": "7489000d-d2ad-3b7b-8be2-b208e5b3266d",
                                "text": "Der gefleckte Schierling wächst an Wegrändern und riecht unangenehm, er kann aber von Laien mit eßbaren Kräutern verwechselt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a56e339-0fc2-4f78-9d72-ba4321b21ef8",
                        "source_entry_id": "097e506c-87db-3119-870d-2b6683bca28c",
                        "source_sense_id": "7489000d-d2ad-3b7b-8be2-b208e5b3266d",
                        "source_sense_description": "Umbelliferae, Apiaceae",
                        "target_lang_word": "ciguë",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciguë",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf9ef42-5f75-3322-9a99-66bf9c69999c",
                                        "entry_id": "ad9afc4e-81ba-30f4-bd0e-bfe99cfbdf1b",
                                        "glosses": [
                                            "Orthographe traditionnelle de cigüe : plante ombellifère dont certaines espèces sont très vénéneuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4015053-0856-463d-96be-326f20ae297f",
                                                "sense_id": "eaf9ef42-5f75-3322-9a99-66bf9c69999c",
                                                "text": "Cependant, au point du jour, l'apothicaire de Sa Majesté entra dans ma chambre avec une potion mêlée de jusquiame, d'opium, de ciguë, d'ellébore noir et d'aconit."
                                            },
                                            {
                                                "example_id": "2a5afd16-225b-4e14-85d2-90965f037ab9",
                                                "sense_id": "eaf9ef42-5f75-3322-9a99-66bf9c69999c",
                                                "text": "Ainsi, ce garçon pieux et vertueux errait en dilettante sur les bords du crime, et tout en moissonnant les bons points et les tableaux d’honneur, il eût mérité vingt fois la ciguë de l’antique Socrate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
