                        "translation_id": "62bd6cab-ca85-4ace-ab84-6f4843e5fb86",
                        "source_entry_id": "725db4a4-355e-358e-9bd0-854fbbf3984a",
                        "source_sense_id": "0485f172-5a9f-3810-86cd-0c2699d7adfd",
                        "target_lang_word": "apophthegmatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
