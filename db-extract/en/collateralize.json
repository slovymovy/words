                        "examples": [
                            {
                                "example_id": "a8e56bee-1a62-4fdf-8233-b816c4629ac1",
                                "sense_id": "555054b6-1d77-396c-9db5-a42cb2df02c7",
                                "text": "A debt instrument is collateralized when the creditor has rights over an asset or revenue stream that would allow it, if the borrower defaults on its payment obligations, to rely on the asset or revenue stream to secure repayment of the debt."
                            }
                        ]
                    }
