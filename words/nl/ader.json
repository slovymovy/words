    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e8aef21-25c6-3c8b-aac2-c5da9a61736e",
                    "sense_definition": "Een bloedvat dat zuurstofarm bloed vanuit de weefsels terug naar het hart voert.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter kon de <w>ader</w> in mijn arm goed zien voor het bloedprikken.",
                            "target_lang_translations": {
                                "en": "The doctor could clearly see the <w>vein</w> in my arm before drawing blood."
                            }
                        },
                        {
                            "text": "Het bloed stroomt door een blauwe <w>ader</w> terug naar het hart.",
                            "target_lang_translations": {
                                "en": "The blood flows back to the heart through a blue <w>vein</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vene"
                    ],
                    "antonyms": [
                        "slagader"
                    ],
                    "common_phrases": [
                        "blauwe ader",
                        "opgezwollen ader"
                    ],
                    "target_lang_definitions": {
                        "en": "A blood vessel that carries oxygen-poor blood from the tissues back to the heart."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vein",
                                "target_lang_sense_clarification": "blood vessel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2057eb6e-99c1-34c5-abad-b8751a7294ce",
                    "sense_definition": "Een kronkelige streep of tekening in materialen zoals hout of marmer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "patroon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De witte tafel heeft een prachtige grijze <w>ader</w> in het marmer.",
                            "target_lang_translations": {
                                "en": "The white table has a beautiful grey <w>vein</w> in the marble."
                            }
                        },
                        {
                            "text": "Je kunt de natuurlijke <w>ader</w> in het hout nog duidelijk zien.",
                            "target_lang_translations": {
                                "en": "You can still clearly see the natural <w>grain</w> in the wood."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ader in marmer"
                    ],
                    "target_lang_definitions": {
                        "en": "A wavy line or pattern in materials such as wood or marble."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vein",
                                "target_lang_sense_clarification": "pattern in marble or wood"
                            },
                            {
                                "target_lang_word": "grain",
                                "target_lang_sense_clarification": "pattern in wood"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10696b69-bc3f-3e10-8fd3-8edfd988b927",
                    "sense_definition": "Een langgerekte laag van een bepaald mineraal of metaal in de grond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mijnwerkers ontdekten een rijke <w>ader</w> van puur goud diep in de berg.",
                            "target_lang_translations": {
                                "en": "The miners discovered a rich <w>vein</w> of pure gold deep in the mountain."
                            }
                        },
                        {
                            "text": "Ze volgden de zilveren <w>ader</w> door de harde rotsen.",
                            "target_lang_translations": {
                                "en": "They followed the silver <w>lode</w> through the hard rocks."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gouden ader"
                    ],
                    "target_lang_definitions": {
                        "en": "An elongated layer of a specific mineral or metal in the ground."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vein",
                                "target_lang_sense_clarification": "mineral or ore deposit"
                            },
                            {
                                "target_lang_word": "lode",
                                "target_lang_sense_clarification": "metal ore deposit"
                            },
                            {
                                "target_lang_word": "seam",
                                "target_lang_sense_clarification": "layer of mineral"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa384700-136e-3a13-8f8c-428209d6d386",
                    "sense_definition": "Een belangrijke verbindingsweg of doorgang binnen een groter netwerk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "netwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze snelweg is een belangrijke <w>ader</w> voor het transport in Europa.",
                            "target_lang_translations": {
                                "en": "This highway is an important <w>artery</w> for transport in Europe."
                            }
                        },
                        {
                            "text": "De rivier vormt de belangrijkste <w>ader</w> voor de handel in deze regio.",
                            "target_lang_translations": {
                                "en": "The river forms the main <w>artery</w> for trade in this region."
                            }
                        }
                    ],
                    "common_phrases": [
                        "belangrijke ader"
                    ],
                    "target_lang_definitions": {
