{
    "word_family": [
        "wreaker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "670e8534-e0f2-3165-a7fc-70872cce5fe9",
                    "sense_definition": "To cause or inflict something harmful or destructive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inflict_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The powerful storm <w>wreaked</w> havoc on the small coastal town.",
                            "target_lang_translations": {
                                "nl": "De krachtige storm <w>richtte</w> een enorme ravage <w>aan</w> in het kleine kustplaatsje."
                            }
                        },
                        {
                            "text": "The angry protesters <w>wreaked</w> destruction on the city center.",
                            "target_lang_translations": {
                                "nl": "De boze demonstranten <w>richtten</w> verwoesting <w>aan</w> in het stadscentrum."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflict",
                        "cause",
                        "unleash"
                    ],
                    "common_phrases": [
                        "wreak havoc",
                        "wreak damage"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets schadelijks of vernietigends veroorzaken of toebrengen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aanrichten",
                                "target_lang_sense_clarification": "schade of verwoesting veroorzaken"
                            },
                            {
                                "target_lang_word": "zaaien",
                                "target_lang_sense_clarification": "zoals in 'verwoesting of paniek zaaien'"
                            },
                            {
                                "target_lang_word": "teweegbrengen",
                                "target_lang_sense_clarification": "veroorzaken of ontketenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4e582f1-566a-3249-b20f-d919c8ceea63",
                    "sense_definition": "To take vengeance or express anger on someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "inflict_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>wreak</w> his frustration on his innocent colleagues.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn frustratie op zijn onschuldige collega's te <w>botvieren</w>."
                            }
                        },
                        {
                            "text": "The defeated army sought to <w>wreak</w> vengeance upon their captors.",
                            "target_lang_translations": {
                                "nl": "Het verslagen leger probeerde wraak te <w>nemen</w> op hun gijzelnemers."
                            }
                        }
                    ],
                    "synonyms": [
                        "avenge",
                        "retaliate"
                    ],
                    "common_phrases": [
                        "wreak vengeance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Wraak nemen of boosheid en frustratie botvieren op iemand of iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "botvieren",
                                "target_lang_sense_clarification": "woede of frustratie uiten op iets of iemand"
                            },
                            {
                                "target_lang_word": "wreken",
                                "target_lang_sense_clarification": "wraak nemen"
                            },
                            {
                                "target_lang_word": "koelen",
                                "target_lang_sense_clarification": "zoals in 'zijn woede/wraak koelen op'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f82fbc1b-e6d0-345c-abb3-1225fa1ef062",
                    "sense_definition": "A feeling of intense resentment or a desire for revenge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "revenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text spoke of a dark <w>wreak</w> against the kingdom.",
                            "target_lang_translations": {
                                "nl": "De oude tekst sprak over een duistere <w>wraak</w> tegen het koninkrijk."
                            }
                        },
                        {
                            "text": "His heart was filled with a bitter <w>wreak</w> after the betrayal.",
                            "target_lang_translations": {
                                "nl": "Zijn hart was vervuld van een bittere <w>wrok</w> na het verraad."
                            }
                        }
                    ],
                    "synonyms": [
                        "vengeance",
                        "revenge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun sense is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een intens gevoel van wrok of een verlangen naar wraak (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wraak",
                                "target_lang_sense_clarification": "vergelding of genoegdoening"
                            },
                            {
                                "target_lang_word": "wrok",
                                "target_lang_sense_clarification": "bittere haat of haatdragendheid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}