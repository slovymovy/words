                    {
                        "sense_id": "91e91735-d519-3434-a165-fc90de515780",
                        "entry_id": "f12b989c-bf20-3e56-ab16-f32a5d8d1e0e",
                        "glosses": [
                            "Loose trousers."
                        ],
                        "tags": [
                            "obsolete",
