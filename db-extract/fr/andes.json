                                "target_senses": [
                                    {
                                        "sense_id": "9fe07056-d11f-391e-9c53-c54b6d0a50c5",
                                        "entry_id": "6b2c3123-9141-3711-830b-bef165eb1688",
                                        "glosses": [
                                            "das Hochgebirge in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "893374cc-6fef-4898-941c-24013c324913",
                                                "sense_id": "9fe07056-d11f-391e-9c53-c54b6d0a50c5",
                                                "text": "„In den Hochebenen der Anden sind vier kamelartige Tiere beheimatet.“"
                                            },
                                            {
                                                "example_id": "6c6d7cf6-f4fa-4ef9-ae05-3c8ac12c1139",
                                                "sense_id": "9fe07056-d11f-391e-9c53-c54b6d0a50c5",
                                                "text": "In Peru, in Peru, in den Anden / Fliegt 'ne Kuh, fliegt 'ne Kuh, kann nicht landen - (Kinderlied)"
                                            },
                                            {
                                                "example_id": "a1ccc9f3-363b-44ae-a275-6d60f7002a65",
                                                "sense_id": "9fe07056-d11f-391e-9c53-c54b6d0a50c5",
                                                "text": "„Bei mehreren Flügen in den Höhenwinden (Lee-Wellen) über den argentinischen Anden gelang es einer Gruppe von Segelfliegern, mit der Stemme S10VT mehrfach die magische 1 000-Kilometer-Marke zu überwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
