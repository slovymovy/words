                "entry_id": "20cd2a0f-525e-3550-8f72-2de2f0c13de4",
                "word": "traboule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e1a691a0-8165-4646-811f-c3743aad9f8c",
                        "entry_id": "20cd2a0f-525e-3550-8f72-2de2f0c13de4",
                        "tags": [
                            "plural"
