                                        "entry_id": "b899d65b-42f5-3ba7-a9ae-20ee5f523da0",
                                        "glosses": [
                                            "A projectile.",
                                            "A blunt lance head used in jousting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30701f67-d1f1-345c-862d-3dae410ef3ef",
                                        "entry_id": "b899d65b-42f5-3ba7-a9ae-20ee5f523da0",
                                        "glosses": [
                                            "A projectile.",
                                            "A long vehicle or craft propelled by a rocket engine; a missile or rocket-propelled spacecraft."
