                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ed80ad6-81c1-4228-94cd-a4c46a28ecce",
                                "sense_id": "d166d75d-1545-3655-89e6-3d5b9a80ee85",
                                "text": "On veut même accuser les seuls nomades arabes d’avoir contribué à bédouiniser les Berbères."
                            },
                            {
                                "example_id": "1fa622e2-d462-4746-a261-79a7dde04432",
                                "sense_id": "d166d75d-1545-3655-89e6-3d5b9a80ee85",
                                "text": "Les troupeaux de l’armée française, obligée de se “bédouiniser” tant pour se déplacer que pour se ravitailler, constituaient bien entendu une cible privilégiée pour les résistants."
                            }
                        ]
