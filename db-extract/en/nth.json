                "senses": [
                    {
                        "sense_id": "5d6a534a-3227-3d74-a238-1af948324565",
                        "entry_id": "239182a1-0c53-3e19-bc91-9162f4427a8b",
                        "glosses": [
                            "Occurring at position n in a sequence."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ed199812-874e-3b29-8d4f-d98871e8b960",
                        "entry_id": "239182a1-0c53-3e19-bc91-9162f4427a8b",
                        "glosses": [
                            "Occurring at a relatively large but unspecified position in a series."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "84809219-1e86-49e4-956f-120d97a0dcdc",
                                "sense_id": "ed199812-874e-3b29-8d4f-d98871e8b960",
                                "text": "Shea had just beaten me at chess, as usual, and, also as usual, I had gleaned what questionable satisfaction I might by twitting him with this indication of failing mentality by calling his attention to the nth time to that theory, propounded by certain scientists, which is based upon the assertion that phenomenal chess players are always found to be from the ranks of children under twelve, adults over seventy-two or the mentally defective."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e38a1cec-73f9-4a18-bcde-18ea0d7f5d7c",
                        "source_entry_id": "239182a1-0c53-3e19-bc91-9162f4427a8b",
                        "source_sense_description": "occurring at position n",
                        "target_lang_word": "n-tý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "317e6165-d19c-409a-b4c9-e3b43356f53c",
                        "source_entry_id": "239182a1-0c53-3e19-bc91-9162f4427a8b",
                        "source_sense_description": "occurring at position n",
                        "target_lang_word": "énième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "énième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                        "entry_id": "3ec5e3b7-b90a-3098-905e-56feccb67bec",
                                        "glosses": [
                                            "Sérié, mais de position indéterminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c2c8b3e-3f94-4daf-8384-50f5eab19d0a",
                                                "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                                "text": "Une énième AG déterminera une fois encore la suite à donner aux actions."
                                            },
                                            {
                                                "example_id": "d56b1b91-5144-42e2-8b5c-f1ed8842bc48",
                                                "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                                "text": "L’allocution se termine, le candidat se jette dans un énième bain de foule et signe des autographes sur les bons de retard des élèves – cheveux en pétard, sweat-shirts à capuche – qui l’approchent."
                                            },
                                            {
                                                "example_id": "d69f55d3-7b2e-4eba-8a29-af1c2c193fdc",
                                                "sense_id": "43dfac9a-3aec-3e28-931f-2eb1b3a71431",
                                                "text": "Les canons qui avaient réussi à gravir la pente furent acheminés vers l’arrière-garde. De là, leur précision se révéla diabolique. Un énième tir de barrage frôla les képis des colonnes d’assaillants allongés sur le sol, des boulets allaient herter les barricades avec violence et affleuraient le sommet des monticules, empêchant les embusqués de pouvoir se relever pour répliquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                        "entry_id": "3ec5e3b7-b90a-3098-905e-56feccb67bec",
                                        "glosses": [
                                            "Qui arrive après un grand nombre d'autres éléments de même nature, dans une répétition jugée excessive ou ennuyeuse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fcc316-d77a-4cee-9e98-8809e26b97f3",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Je commençais à m'amuser quand mon supérieur m'interrompit. Il déchira la énième lettre sans même la lire et me dit que mdemoiselle Mori était arrivée."
                                            },
                                            {
                                                "example_id": "68037abb-9908-409a-950b-f3e13d5522e1",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Tell s’apprêtait à se servir le énième café de la journée, lorsqu’il découvrit qu’on avait retiré de la cuisinette la cafetière électrique."
                                            },
                                            {
                                                "example_id": "f2c9bc2c-27b9-4254-be88-4e21e9c399e2",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Je ne vais pas raconter ici pour la énième fois le voyage de Chine comme c’était la mode à l’époque pour les très rares qui le faisaient."
                                            },
                                            {
                                                "example_id": "a7151f2c-faa0-49f6-b9b9-76995e063b9c",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Pour la énième fois, je me fis la réflexion que, depuis un certain temps, je brûlais la chandelle par les deux bouts. En fait, j'étais au bord du surmenage professionnel."
                                            },
                                            {
                                                "example_id": "362d8b6e-13b9-4f6c-a365-4e2c8261fd77",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "A l'hôpital, soigné à la morphine, il en était devenu dépendant, ne pouvait plus s'en passer, l'appelait sa fée grise. « En voulez-vous ? proposa-t-il à Verlaine qui commandait une énième absinthe. Ça vous changera de la fée verte. »"
                                            },
                                            {
                                                "example_id": "1d5c46cd-f556-45bb-adf3-9665918f1d76",
                                                "sense_id": "e94d90a8-c7da-3f46-9a7a-cb19a4fde1b5",
                                                "text": "Les dirigeants européens ont eu une semaine chargée. En plus de leur énième sommet de la dernière chance dans le cadre de la crise grecque, ils devaient convenir d’une solution commune aux dizaines de milliers de réfugiés venus s’échouer sur les côtes italiennes et grecques depuis le début de l’année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c351b0d-fdff-38d2-bb9c-d3b548ddc042",
                                        "entry_id": "3ec5e3b7-b90a-3098-905e-56feccb67bec",
                                        "glosses": [
                                            "Correspondant à un ordre indéterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da77aa97-a551-4f9a-9110-53a911a8b14c",
                                                "sense_id": "6c351b0d-fdff-38d2-bb9c-d3b548ddc042",
                                                "text": "Dans des mains expertes, il est cependant possible de réaliser d’autres opérations de type calculs de racines énièmes ou conversion en différentes bases."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "énième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4549b4f5-32fa-3710-b54d-d1bfda82215c",
                                        "entry_id": "be0a1d93-cb40-3d21-9981-09335bee248e",
                                        "glosses": [
                                            "Élément ordinal correspondant à un nombre indéterminé dans une série."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17ddc77-0ceb-4572-b177-40cc890f8842",
                                                "sense_id": "4549b4f5-32fa-3710-b54d-d1bfda82215c",
                                                "text": "Tu es la énième à me le dire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50cada4d-665e-4cad-a23a-06bd4fc0d98c",
                        "source_entry_id": "239182a1-0c53-3e19-bc91-9162f4427a8b",
