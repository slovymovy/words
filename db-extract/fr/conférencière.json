                                    },
                                    {
                                        "sense_id": "de315ae1-20e3-3dfa-8efe-7e5faa289cf3",
                                        "entry_id": "4ea2201c-0d50-3cbf-a88a-cfe552b2650d",
                                        "glosses": [
                                            "weibliche Person, die in einer Organisation für einen Sachbereich zuständig ist"
