                        ],
                        "form": "die Leitfähigkeit"
                    },
                    {
                        "form_id": "f2a7b38d-617b-4b37-ab3c-8d3db5f8bc05",
                        "entry_id": "f2262f0a-cfcb-348c-9b5e-a41ec871d129",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Leitfähigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                        "entry_id": "f2262f0a-cfcb-348c-9b5e-a41ec871d129",
                        "glosses": [
                            "Fähigkeit eines Stoffes, Energie weiterzuleiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30428b5a-78b5-4c21-aafe-513f119f5dbb",
                                "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                                "text": "„Halbleiter sind im Normalzustand nicht leitend, denn die die elektrische Leitfähigkeit verursachenden Hüllelektronen sind an die einzelnen Bausteine des Kristalls gebunden.“"
                            },
                            {
                                "example_id": "5bc91fd7-f5a8-4838-bef0-29de14ab469e",
                                "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                                "text": "„Messungen von Leitfähigkeiten oberhalb 100 mS/m, die mit tragbaren Instrumenten durchgeführt werden müssen.“"
                            },
                            {
                                "example_id": "21622171-ec54-4230-ad60-bdb1ffb1a9e4",
                                "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                                "text": "„Das Kernmaterial des magnetischen Kreises ist dabei frei von Sättigungseffekten und mit konstanten Leitfähigkeiten angenommen.“"
                            },
                            {
                                "example_id": "f9e1feec-8dfb-4b7e-bbf4-09215c12fbc3",
                                "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                                "text": "„Deshalb haben sie Wasserproben aus beiden Gläsern chemisch analysiert und die Leitfähigkeiten gemessen, unter anderem mit der extrem genauen Impedanzspektroskopie, wie sie kürzlich im Fachblatt Journal of Physics berichteten.“"
                            },
                            {
                                "example_id": "143a46cb-b865-407d-9190-b3456e33f548",
                                "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                                "text": "„Dieser Kunststoff verfügt über Leitfähigkeiten, die zwar viel geringer sind als jene von Silizium, für die Funktion eines RFID- Chips aber ausreichen.“"
                            },
                            {
                                "example_id": "b884f4eb-7d7d-44bb-a082-2c095a8e4a13",
                                "sense_id": "6e295af7-b167-3017-a320-a4f7d528e033",
                                "text": "„Der Leitwert ist der Kehrwert des Widerstands […] er wird in der Elektrophysiologie häufig verwendet, da die verschiedenen Leitfähigkeiten in der Membran parallel geschaltet vorliegen, wodurch sich die Gesamtleitfähigkeit einer Membran bei dieser Darstellung durch einfache Addition der Einzelleitfähigkeiten ergibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
