                "senses": [
                    {
                        "sense_id": "0b139313-3186-3d81-bae6-12bc97624e9d",
                        "entry_id": "faf06eda-6286-3851-9388-cd649b46cf62",
                        "glosses": [
                            "speziell für ältere Menschen geeignete beziehungsweise von ihnen praktizierte Spielform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5433b342-918d-4657-a7f5-7cd002147b25",
                                "sense_id": "0b139313-3186-3d81-bae6-12bc97624e9d",
                                "text": "„In einem Seniorenspiel sind sie vor Jahrzehnten mal gegen die Weltmeistermannschaft von 1954 angetreten.“"
                            },
                            {
                                "example_id": "d8098a39-883d-4897-994a-6ed5039ad0fe",
                                "sense_id": "0b139313-3186-3d81-bae6-12bc97624e9d",
                                "text": "„Ideen für Seniorenspiele entwickelt er auch weiter, nur Einnahmen springen noch nicht dabei heraus.“"
                            },
                            {
                                "example_id": "223e484f-c148-4eea-ac2e-0be5cf53fbc4",
                                "sense_id": "0b139313-3186-3d81-bae6-12bc97624e9d",
                                "text": "„Zu den deutschen Seniorenspielen und der deutschen Seniorenmeisterschaft, deren jährliche Ausrichtung ein Privileg des Hamburger Golfclubs auf seinem Falkensteiner Platz bildet, sind dies Jahr nicht weniger als einhundertfünfzig Mann in die Schranken getreten, womit alle früheren Rekorde in den Schatten gestellt wurden.“"
                            },
                            {
                                "example_id": "918fff9a-5675-484f-97d9-7393f922680c",
                                "sense_id": "0b139313-3186-3d81-bae6-12bc97624e9d",
                                "text": "„Der Torjäger im Seniorenspiel: Manfred Freisler (7 Treffer) kann von Ingolf Wiegert (l.) und Lothar Doering nicht gestoppt werden.“"
                            },
                            {
                                "example_id": "8af5ef2d-042a-4446-9f69-74be499c69af",
                                "sense_id": "0b139313-3186-3d81-bae6-12bc97624e9d",
                                "text": "„Man staunt über Klassiker wie Klaus Fischers Fallrückzieher aus dem Jahre 1977 - und darüber, daß er das Kunststück 15 Jahre später in einem Seniorenspiel wiederholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
