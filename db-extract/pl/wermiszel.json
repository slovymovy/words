                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermichel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e01b66-2b6f-39ca-b7cc-7f1ca6ad3758",
                                        "entry_id": "65f1dcbd-2b35-304c-bbb1-5198a25f6e46",
                                        "glosses": [
                                            "Variante de vermicelle"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e7f9cd-9c3a-4d76-909f-e5c7073b1337",
                                                "sense_id": "a6e01b66-2b6f-39ca-b7cc-7f1ca6ad3758",
                                                "text": "Laissez le dire : ils en mangent tous , on n'emploie plus que çà [sic] dans Paris , cela épargne de la peine à la ménagère : si le bouillon est manque, on ne s'en aperçoit pas; le goût de vermichel couvre tout; on n'a pas besoin de soigner le pot pendant cinq heures ; …."
                                            },
                                            {
                                                "example_id": "6809534b-7db3-45d9-aa33-ca6f77909357",
                                                "sense_id": "a6e01b66-2b6f-39ca-b7cc-7f1ca6ad3758",
                                                "text": "Le macaroni, le kagne , le lazagne [sic] et le patre, ne sont que des espèces de vermichel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5f8bdca-df08-4325-821d-cf85525e4677",
