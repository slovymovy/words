                                        "sense_id": "626313c1-0cd3-3113-a82d-0bc57757b363",
                                        "entry_id": "a070ea1a-9740-3027-9cc9-3b0c81d738a6",
                                        "glosses": [
                                            "taki, który dotyczy Olimpu, geograficznego lub mitycznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285be9ab-0844-4206-a9e2-a889a4ff034d",
                                                "sense_id": "626313c1-0cd3-3113-a82d-0bc57757b363",
                                                "text": "Miał Apollo serdecznego przyjaciela w młodym Hiakintosie, którego uczył strzelać z łuku i grać na cytrze. Tymczasem Zefir, bożek łagodnego wiatru, tak pokochał pięknego młodzieńca, że nie mógł znieść, iż ów porzuca jego towarzystwo dla olimpijskiego boga"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b8b4d51f-bfe5-3e88-9385-29931dc0dd1a",
                                        "entry_id": "a070ea1a-9740-3027-9cc9-3b0c81d738a6",
                                        "glosses": [
                                            "związany z olimpiadą (starożytną lub nowożytną), taki, który dotyczy olimpiady albo taki jak na olimpiadzie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f6901b-0226-4ec6-90de-2b80b849c65f",
                                                "sense_id": "b8b4d51f-bfe5-3e88-9385-29931dc0dd1a",
                                                "text": "Hymn olimpijski zabrzmiał po raz pierwszy już na igrzyskach olimpijskich w Atenach w 1896 roku"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "ead02def-06c1-3661-b1dd-6758b1410c05",
                                        "entry_id": "a070ea1a-9740-3027-9cc9-3b0c81d738a6",
                                        "glosses": [
                                            "taki, jak bogów z Olimpu – majestatyczny, natchniony, boski"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e0a84c-84cc-4dfa-bbf9-e938de1bf1c4",
                                                "sense_id": "ead02def-06c1-3661-b1dd-6758b1410c05",
                                                "text": "Śliczne córki nauczyciela śpiewały do wtóru ojcowskim skrzypkom. Starszej, Pelagii, przelotnej sympatii (bo czołową adresatką „tęsknot” gimnazjalistów była panna Olimpia Drwęska, o iście olimpijskiej urodzie), wpisał 19-letni Janek w imionnik dwa wiersze „Bądź silną i mężną”, „Bądź Polką”."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
