                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f839687-3195-45ca-93a6-874a37555efa",
                                                "sense_id": "9d77ec44-35ec-39d5-930f-acb3bd02723f",
                                                "text": "W muzeum w Łańcucie znajduje się kielich o wielobocznej tralce wydmuchanej w formie."
                                            }
