                                    },
                                    {
                                        "sense_id": "23b0e1b8-573d-35b6-ad79-e7247637134b",
                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "Any column or pillar, particularly the body of a column between its capital and pedestal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35c40e41-195f-4409-9979-5c6c19caff5d",
                                                "sense_id": "23b0e1b8-573d-35b6-ad79-e7247637134b",
                                                "text": "Spirit, that made those heroes dare / To die, or leave their children free / Bid Time and Nature gently spare / The shaft we raise to thee."
