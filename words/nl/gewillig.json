{
    "word_family": [
        "wil",
        "willen",
        "onwillig",
        "bereidwillig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5cf0599c-f14e-31d4-b48b-3bbdf3a4add5",
                    "sense_definition": "Bereid om iets te doen of mee te werken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bereidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student was <w>gewillig</w> om extra taken uit te voeren voor het project.",
                            "target_lang_translations": {
                                "fr": "L'étudiant était <w>disposé</w> à effectuer des tâches supplémentaires pour le projet."
                            }
                        },
                        {
                            "text": "Zij toonde zich <w>gewillig</w> om de nieuwe regels te accepteren.",
                            "target_lang_translations": {
                                "fr": "Elle s'est montrée <w>disposée</w> à accepter les nouvelles règles."
                            }
                        }
                    ],
                    "synonyms": [
                        "welwillend"
                    ],
                    "antonyms": [
                        "ongewillig"
                    ],
                    "target_lang_definitions": {
                        "fr": "Disposé à faire quelque chose ou à coopérer."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "disposé",
                                "target_lang_sense_clarification": "prêt à agir ou à accepter quelque chose"
                            },
                            {
                                "target_lang_word": "volontaire",
                                "target_lang_sense_clarification": "qui fait quelque chose de son plein gré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7011a771-e181-3bac-a6ae-2a7c1bb2d7ee",
                    "sense_definition": "Zonder verzet meegaand met de wil van een ander.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gehoorzaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het paard was <w>gewillig</w> en volgde direct de instructies van de ruiter.",
                            "target_lang_translations": {
                                "fr": "Le cheval était <w>docile</w> et suivait immédiatement les instructions du cavalier."
                            }
                        },
                        {
                            "text": "Hij was een <w>gewillig</w> slachtoffer van de manipulatie door zijn collega.",
                            "target_lang_translations": {
                                "fr": "Il était une victime <w>docile</w> de la manipulation de son collègue."
                            }
                        }
                    ],
                    "synonyms": [
                        "volgzaam",
                        "gedwee"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui se plie sans résistance à la volonté d'autrui."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "docile",
                                "target_lang_sense_clarification": "facile à diriger ou à influencer"
                            },
                            {
                                "target_lang_word": "soumis",
                                "target_lang_sense_clarification": "qui accepte l'autorité sans protester"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cef1dc6d-716c-32fe-b935-e1bab9309a88",
                    "sense_definition": "Op een bereidwillige manier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bereidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuige werkte <w>gewillig</w> mee aan het onderzoek van de politie.",
                            "target_lang_translations": {
                                "fr": "Le témoin a coopéré <w>volontiers</w> à l'enquête de police."
                            }
                        },
                        {
                            "text": "Zij gaf <w>gewillig</w> antwoord op alle vragen van de journalist.",
                            "target_lang_translations": {
                                "fr": "Elle a répondu <w>volontiers</w> à toutes les questions du journaliste."
                            }
                        }
                    ],
                    "synonyms": [
                        "welwillend"
                    ],
                    "target_lang_definitions": {
                        "fr": "De manière disposée ou coopérative."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "volontiers",
                                "target_lang_sense_clarification": "avec plaisir ou sans hésitation"
                            },
                            {
                                "target_lang_word": "de bon gré",
                                "target_lang_sense_clarification": "avec une attitude positive et coopérative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40fd128a-d37e-38ed-a218-c1f317ec4576",
                    "sense_definition": "Op een meegaande of onderdanige wijze.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gehoorzaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond liep <w>gewillig</w> achter zijn baasje aan door het park.",
                            "target_lang_translations": {
                                "fr": "Le chien suivait <w>docilement</w> son maître à travers le parc."
                            }
                        },
                        {
                            "text": "De onderdaan boog <w>gewillig</w> voor de koning.",
                            "target_lang_translations": {
                                "fr": "Le sujet s'inclina <w>soumis</w> devant le roi."
                            }
                        }
                    ],
                    "synonyms": [
                        "volgzaam",
                        "gedwee"
                    ],
                    "target_lang_definitions": {
                        "fr": "De manière docile ou soumise."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "docilement",
                                "target_lang_sense_clarification": "d'une manière obéissante"
                            },
                            {
                                "target_lang_word": "soumis",
                                "target_lang_sense_clarification": "en faisant preuve de soumission"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}