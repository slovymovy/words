                        "zh": "高质量的大麻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убойная трава",
                                "target_lang_sense_clarification": "сленг наркокультуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "优质大麻",
                                "target_lang_sense_clarification": "指高纯度或高质量的大麻"
                            }
                        ]
                    }
                }
            ]
        }
