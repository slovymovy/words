            {
                "entry_id": "178a483d-a89e-39bf-8dd4-0984fb78153e",
                "word": "Alcide",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c284bb2-8268-3e2d-8a64-14efccf636fa",
                        "entry_id": "178a483d-a89e-39bf-8dd4-0984fb78153e",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344bd2b5-df96-4936-8ee1-b33c6486bf89",
                                "sense_id": "6c284bb2-8268-3e2d-8a64-14efccf636fa",
                                "text": "Un chauffeur, le beau César, chéri des femmes, prendra bientôt place au Mont-Noir à côté d’Alcide, cocher chez Madame depuis vingt-cinq ans."
                            },
                            {
                                "example_id": "fbc13544-67ff-43da-92a0-c9fd9a991b21",
                                "sense_id": "6c284bb2-8268-3e2d-8a64-14efccf636fa",
                                "text": "Alcide, tu viendras avec nous ce soir."
                            }
                        ]
                    },
                    {
                        "sense_id": "70f57e6d-fa38-3534-830d-bd60c8e6baca",
                        "entry_id": "178a483d-a89e-39bf-8dd4-0984fb78153e",
                        "glosses": [
                            "Autre nom d'Hercule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693f997c-2474-444a-a888-1c9a4837db66",
                                "sense_id": "70f57e6d-fa38-3534-830d-bd60c8e6baca",
                                "text": "L'Alcide purgé par la flamme\nQuitta ça bas tout le mortel."
                            },
                            {
                                "example_id": "190e8d67-4e97-4a04-b752-d02436dddaeb",
                                "sense_id": "70f57e6d-fa38-3534-830d-bd60c8e6baca",
                                "text": "La représentation allait avoir lieu, et l’Alcide, le plein jour de la porte d’entrée sur sa terrible nuque, tirait avec des mouvements endoloris les poids placés sous le banc sur lequel il était assis."
                            }
                        ]
                    }
