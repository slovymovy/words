    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e7116293-116d-3574-a136-04b3e5e5ea67",
                    "sense_definition": "Qui a l'esprit vivement troublé par la frayeur, la douleur ou une forte angoisse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble_emotionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle cherchait son enfant avec un regard <w>éperdu</w> au milieu de la foule compacte."
                        },
                        {
                            "text": "Totalement <w>éperdue</w> après l'accident, la conductrice ne parvenait plus à articuler le moindre mot."
                        }
                    ],
                    "synonyms": [
                        "affolé",
                        "désemparé",
                        "paniqué"
                    ],
                    "antonyms": [
                        "calme",
                        "serein"
                    ],
                    "common_phrases": [
                        "regard éperdu",
                        "geste éperdu"
                    ]
                },
                {
                    "sense_id": "69e9288e-0723-3775-a631-502fa9d50dee",
                    "sense_definition": "Qui manifeste une passion violente et irrésistible, en particulier un sentiment amoureux très intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passion_intense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui vouait un amour <w>éperdu</w> depuis le tout premier jour de leur rencontre."
                        },
                        {
                            "text": "Complètement <w>éperdu</w> d'amour, le jeune homme passait ses nuits à composer des poèmes."
                        }
                    ],
                    "synonyms": [
                        "passionné",
                        "enflammé"
                    ],
                    "antonyms": [
                        "indifférent"
                    ],
                    "common_phrases": [
                        "amour éperdu",
                        "éperdu d'amour"
                    ]
                },
                {
                    "sense_id": "73fbac33-f56f-390b-ac03-d6397f709bc9",
                    "sense_definition": "Qui se fait dans un affolement extrême ou avec une précipitation désespérée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_effrenee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fugitifs se sont lancés dans une course <w>éperdue</w> à travers les bois pour échapper aux gardes."
                        },
                        {
                            "text": "Face à la montée rapide des eaux, les villageois ont entamé une fuite <w>éperdue</w> vers les collines."
                        }
                    ],
                    "synonyms": [
                        "désespéré",
                        "effréné"
                    ],
                    "antonyms": [
                        "mesuré",
                        "posé"
                    ],
                    "common_phrases": [
                        "course éperdue",
                        "fuite éperdue"
                    ]
                }
            ]
        }
