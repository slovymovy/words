                                            {
                                                "example_id": "5dccce8e-5a93-47ef-8541-cf91d3e35214",
                                                "sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                                                "text": "Im Mittelalter wurde auf einem Rechenbrett gerechnet."
                                            },
                                            {
                                                "example_id": "476a6e5c-0f6f-41e2-81ed-2d84eaaa10e4",
                                                "sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                                                "text": "„Neben dem Rechnen auf dem Rechenbrett (den »linihen«) beschreibt Ries in diesem Buch das schriftliche Ziffernrechnen mit den indischen-arabischen Ziffern (mit »federn«).“"
                                            }
