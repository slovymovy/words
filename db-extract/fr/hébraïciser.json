                ],
                "senses": [
                    {
                        "sense_id": "50b3e194-a346-3239-8f9b-4b148d0f8b92",
                        "entry_id": "04e962c9-8fee-3b6e-938e-d17f7ece956d",
                        "glosses": [
                            "Donner un caractère hébraïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66de86bf-4f22-42d2-887b-c2dc04bc45b4",
                                "sense_id": "50b3e194-a346-3239-8f9b-4b148d0f8b92",
                                "text": "Les lexiques du laaz occidental et du laaz méridional étaient parfois légèrement hébraïcisés."
                            },
                            {
                                "example_id": "e47827eb-111d-4ef8-b51f-760566aead9d",
                                "sense_id": "50b3e194-a346-3239-8f9b-4b148d0f8b92",
                                "text": "Ce paquet est également installé par le métapaquet user-he destiné à « hébraïciser » le système."
                            },
                            {
                                "example_id": "2e0fefae-556b-4e88-8c4a-4e105400800c",
                                "sense_id": "50b3e194-a346-3239-8f9b-4b148d0f8b92",
                                "text": "Je soutiens que ces « Israélites africains hébreux » donnent à voir une forme complexe d’Afrocentrisme, une version hébraïcisée qui se conforme à certaines formes canoniques d’Afrocentrisme tout en échappant à d’autres."
                            },
                            {
                                "example_id": "5f10cac5-eaae-4d56-8bcc-32d4c3635546",
                                "sense_id": "50b3e194-a346-3239-8f9b-4b148d0f8b92",
                                "text": "L’effort le plus symbolique concerne la célèbre traduction de la Bible, réalisée par Buber et Rosenzweig, dans le «langage prophétique élevé» d’un allemand hébraïcisé."
                            }
                        ]
                    }
