                    "sense_id": "2b368305-41c2-3a9d-993f-5d8192d14e97",
                    "sense_definition": "Очень короткий промежуток времени, миг.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Подождите, пожалуйста, один <w>момент</w>.",
                            "target_lang_translations": {
                                "en": "Please wait one <w>moment</w>.",
                                "de": "Warten Sie bitte einen <w>Moment</w>."
                            }
                        },
                        {
                            "text": "В этот <w>момент</w> в комнату вошёл учитель.",
                            "target_lang_translations": {
                                "en": "At that <w>moment</w>, the teacher entered the room.",
                                "de": "In diesem <w>Moment</w> kam der Lehrer in das Zimmer."
                            }
