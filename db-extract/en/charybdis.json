        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "446380a2-422a-3598-a8ba-f0e6999a7793",
                "word": "Charybdis",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2442724-0758-35da-a93d-9f0b4ba51cdb",
                        "entry_id": "446380a2-422a-3598-a8ba-f0e6999a7793",
                        "glosses": [
                            "A dangerous whirlpool on the coast of Sicily opposite Scylla on the Italian coast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fad267a-0c92-42c9-9ebf-12d9a3083aa4",
                                "sense_id": "d2442724-0758-35da-a93d-9f0b4ba51cdb",
                                "text": "I have never yet been able to steer my lovers through the Scylla of presence, or the Charybdis of absence."
                            }
                        ]
                    },
                    {
                        "sense_id": "02f86353-7157-32a1-a8c8-977256c78be0",
                        "entry_id": "446380a2-422a-3598-a8ba-f0e6999a7793",
                        "glosses": [
                            "A personification of the above whirlpool as a female monster."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8cf96e05-4aa3-3287-92b9-1b8bc65dcea8",
                        "entry_id": "446380a2-422a-3598-a8ba-f0e6999a7793",
                        "glosses": [
                            "Any dangerous whirlpool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a4d9042-b63a-4a36-b24f-a8c02f3e3aaa",
                                "sense_id": "8cf96e05-4aa3-3287-92b9-1b8bc65dcea8",
                                "text": "…that night, wee ſailed merrily by the Maſcarenas, a Charybdis in 21 degrees, var.13 and 17 minutes…"
                            },
                            {
                                "example_id": "fe0f6795-7510-4607-9585-d5fa84d8a0d6",
                                "sense_id": "8cf96e05-4aa3-3287-92b9-1b8bc65dcea8",
                                "text": "The tide here sets in alternately from N. to S. and from S. to N., which causes the whirlpool of Galofaro, the Charybdis of the ancients."
                            },
                            {
                                "example_id": "6a3ac429-e472-43cb-8be0-dd35e9fe578e",
                                "sense_id": "8cf96e05-4aa3-3287-92b9-1b8bc65dcea8",
                                "text": "Lo! the wave that for ever devours the wave / Casts roaringly up the charybdis again…"
                            }
                        ]
                    }
                ],
