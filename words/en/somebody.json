{
    "word_family": [
        "some"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "607678c5-538f-3fb7-93f6-922529b67bea",
                    "sense_definition": "Some unspecified person.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can <w>somebody</w> help me carry these heavy boxes?",
                            "target_lang_translations": {
                                "ru": "<w>Кто-нибудь</w> может помочь мне донести эти тяжелые коробки?",
                                "zh": "能有<w>人</w>帮我搬一下这些重箱子吗？"
                            }
                        },
                        {
                            "text": "I think <w>somebody</w> else is already sitting in that seat.",
                            "target_lang_translations": {
                                "ru": "Я думаю, <w>кто-то</w> другой уже сидит на этом месте.",
                                "zh": "我想<w>别人</w>已经坐在那个座位上了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "someone"
                    ],
                    "antonyms": [
                        "nobody",
                        "no one"
                    ],
                    "common_phrases": [
                        "somebody else",
                        "need somebody",
                        "ask somebody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неизвестное или неопределённое лицо.",
                        "zh": "指代某个不确定的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто-то",
                                "target_lang_sense_clarification": "неизвестный человек; обычно используется в утвердительных предложениях"
                            },
                            {
                                "target_lang_word": "кто-нибудь",
                                "target_lang_sense_clarification": "любой человек; обычно используется в вопросах и просьбах"
                            },
                            {
                                "target_lang_word": "некто",
                                "target_lang_sense_clarification": "неизвестная личность; более формальный или книжный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有人",
                                "target_lang_sense_clarification": "指代不确定的人，常用于肯定句"
                            },
                            {
                                "target_lang_word": "某人",
                                "target_lang_sense_clarification": "指代某一个特定但不具名的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "deb7c061-efc7-3a63-9043-1804f0908812",
                    "sense_definition": "A recognised or important person, a celebrity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked hard all his life to become a <w>somebody</w> in the industry.",
                            "target_lang_translations": {
                                "ru": "Он усердно работал всю жизнь, чтобы стать <w>важной персоной</w> в этой индустрии.",
                                "zh": "他一生努力工作，就是为了成为业内的一位<w>大人物</w>。"
                            }
                        },
                        {
                            "text": "She is tired of being ignored and wants to be a <w>somebody</w>.",
                            "target_lang_translations": {
                                "ru": "Она устала от того, что её игнорируют, и хочет быть <w>знаменитостью</w>.",
                                "zh": "她厌倦了被忽视，想要成为一个<w>名人</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "be a somebody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Известная или важная личность, знаменитость.",
                        "zh": "指有地位、有影响力或知名的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важная персона",
                                "target_lang_sense_clarification": "человек, занимающий высокое положение"
                            },
                            {
                                "target_lang_word": "знаменитость",
                                "target_lang_sense_clarification": "известный человек"
                            },
                            {
                                "target_lang_word": "кто-то",
                                "target_lang_sense_clarification": "в значении «кто-то важный» или «значимый»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大人物",
                                "target_lang_sense_clarification": "指有权势或地位显赫的人"
                            },
                            {
                                "target_lang_word": "名人",
                                "target_lang_sense_clarification": "指知名度高的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3463b38f-e5a7-3886-9fcc-1904e393e6c8",
                    "sense_definition": "Any person.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was a combination of various <w>somebodies</w> from different departments.",
                            "target_lang_translations": {
                                "ru": "Команда представляла собой сочетание различных <w>личностей</w> из разных отделов.",
                                "zh": "这个团队是由来自不同部门的各色<w>人物</w>组成的。"
                            }
                        },
                        {
                            "text": "We need a specific <w>somebody</w> who knows how to fix this machine.",
                            "target_lang_translations": {
                                "ru": "Нам нужен конкретный <w>человек</w>, который знает, как починить эту машину.",
                                "zh": "我们需要一位知道如何修理这台机器的<w>特定人选</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой человек или конкретная личность.",
                        "zh": "指具体的某个人或个体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личность",
                                "target_lang_sense_clarification": "индивидуум, человек с определенными качествами"
                            },
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "конкретная персона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人",
                                "target_lang_sense_clarification": "指代具体的个体"
                            },
                            {
                                "target_lang_word": "某位",
                                "target_lang_sense_clarification": "指代某一位特定的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}