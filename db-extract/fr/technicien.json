                    },
                    {
                        "form_id": "28054f0f-2540-4138-afa7-76f9afabaa48",
                        "entry_id": "5926ce0e-45c8-384f-a91f-a91e07e0c548",
                        "tags": [
                            "slang"
                        ],
                        "form": "tekos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3da5b0eb-bc32-39e6-aeaf-bd057880669d",
                        "entry_id": "5926ce0e-45c8-384f-a91f-a91e07e0c548",
                        "glosses": [
                            "Personne qui connaît les procédés pratiques d’un art, d’un métier et qui sait les employer, qui les enseigne ou les étudie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758efd82-2db0-429a-be7c-78fa236dc605",
                                "sense_id": "3da5b0eb-bc32-39e6-aeaf-bd057880669d",
                                "text": "Dans son domaine, c’est un technicien hors pair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b9f8a62-8893-40fc-8c76-3ee60b638ca8",
                        "source_entry_id": "5926ce0e-45c8-384f-a91f-a91e07e0c548",
                        "source_sense_id": "3da5b0eb-bc32-39e6-aeaf-bd057880669d",
                        "target_lang_word": "Techniker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Techniker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1688a1a-f222-3b13-baee-9c3339668c3a",
                                        "entry_id": "2c47dc04-d0d4-3d16-91ec-5a4d25a41024",
                                        "glosses": [
                                            "an einer Hochschule oder Fachschule ausgebildete Fachkraft auf dem Gebiet der Technik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ee2125-97ca-431a-a971-fb449d728749",
                                                "sense_id": "a1688a1a-f222-3b13-baee-9c3339668c3a",
                                                "text": "„Der Techniker ist durch seine vorausgegangene praktische Berufsausbildung und seine zweijährige Technikerausbildung schnell und ohne lange Einarbeitungszeiten in den Unternehmen einsetzbar.“"
                                            },
                                            {
                                                "example_id": "b9db5dd8-b437-43dc-b8d6-555ff9eec529",
                                                "sense_id": "a1688a1a-f222-3b13-baee-9c3339668c3a",
                                                "text": "„Um die geschützte Berufsbezeichnung Staatlich geprüfter Techniker führen zu dürfen, muss eine entsprechende Aufstiegsweiterbildung an einer Fachschule für Technik absolviert und das abschließende, staatliche Examen bestanden worden sein.“"
                                            },
                                            {
                                                "example_id": "fa698d0a-c85a-4aa2-bc73-28827937b00f",
                                                "sense_id": "a1688a1a-f222-3b13-baee-9c3339668c3a",
                                                "text": "„Alle öffentlichen und privaten Bauverwaltungen, welche von Juristen oder Unternehmern geleitet sind, stützen sich auf fachbeschränkt gebildete Techniker, […]“"
                                            },
                                            {
                                                "example_id": "db273532-5110-4a08-ac6c-e3f32ae41767",
                                                "sense_id": "a1688a1a-f222-3b13-baee-9c3339668c3a",
                                                "text": "„Sie hatten ihren Laptop bekommen, und die Techniker untersuchten ihn gerade auf weitere Anhaltspunkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60dc8f28-2723-3b9a-8568-b3880c9eb297",
                                        "entry_id": "2c47dc04-d0d4-3d16-91ec-5a4d25a41024",
                                        "glosses": [
                                            "qualifizierte Person, die in ihrem Fachgebiet als kompetent gilt und die mechanische Vorgehensweise sehr gut beherrscht"
                                        ],
                                        "tags": [
                                            "oft über Sportler und Musiker"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2401af8-fa49-4fb9-99ca-4f4fcab99623",
                                                "sense_id": "60dc8f28-2723-3b9a-8568-b3880c9eb297",
                                                "text": "Er hat schon viele Abfahrtsrennen gewonnen, weil er einfach ein brillanter Techniker ist."
                                            },
                                            {
                                                "example_id": "3ddaff68-1f57-424f-9bf0-cc31cb315432",
                                                "sense_id": "60dc8f28-2723-3b9a-8568-b3880c9eb297",
                                                "text": "Der junge Chinese begeistert bei seinem Klavierspiel als hervorragender Techniker."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
