                ],
                "senses": [
                    {
                        "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                        "entry_id": "fe5c00df-e720-3ccf-b06c-8fd8eeb03519",
                        "glosses": [
                            "Lagerstätte, um Kohlenstoff in der Form des Kohlenstoffdioxid (= CO₂) langfristig zu binden; heute oft im Zusammenhang mit der Klimakatastrophe benutzt als Möglichkeit, der Atmosphäre CO₂ zu entziehen oder den Anstieg des CO₂-Gehalts in der Atmosphäre zu bremsen"
                        ],
                        "tags": [
                            "Klima"
                        ],
                        "examples": [
                            {
                                "example_id": "faf63de1-e4ef-4daa-aa4c-0b2a551df64a",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "Meere, Böden und Wälder sind wichtige Kohlenstoffspeicher."
                            },
                            {
                                "example_id": "c39a3b63-3f70-4f37-833c-1b7733e90650",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "Moore sind bedeutende natürliche Kohlenstoffspeicher."
                            },
                            {
                                "example_id": "7bc0c3a1-73af-479e-b746-16a851b35587",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "Moore sind riesige Kohlenstoffspeicher."
                            },
                            {
                                "example_id": "0b7dfeea-bbeb-4b83-84ca-495788cb5fbc",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Carbonate (Calcit CaCO₃ und Dolomit CaMg(CO₃)₂) sind zudem die größten Kohlenstoffspeicher der Erde.“"
                            },
                            {
                                "example_id": "5535d446-b8e1-46ff-81ed-5462f37d867d",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Die Champions unter den Kohlenstoffspeichern sind jedoch Moore und Sümpfe.“"
                            },
                            {
                                "example_id": "137b9255-c4f1-4ba4-9526-203e1c872d66",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Ozeane, Wälder und Moore sind wichtige Kohlenstoffspeicher: Sie nehmen Kohlendioxid auf, speichern das Treibhausgas und wirken damit der globalen Erwärmung entgegen.“"
                            },
                            {
                                "example_id": "a3798a20-ae73-4235-8d4b-727e2d6bf711",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„In geologischen Zeiträumen ist der wichtigste Kohlenstoffspeicher die Lithosphäre, die 99,8 % des auf der Erde vorkommenden Kohlenstoffs enthält; hauptsächlich als Carbonat wie Kalk.“"
                            },
                            {
                                "example_id": "89636b51-759c-4344-b7bf-2098bf62da37",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Böden sind wichtige Kohlenstoffspeicher, aber in der industriellen Landwirtschaft wird CO₂ nicht absorbiert, sondern im Gegenteil in die Atmosphäre freigesetzt - zum Beispiel durch Pflügen, das zur Degradierung des Bodens führen kann. Verarmte Böden speichern kaum noch CO₂.“"
                            },
                            {
                                "example_id": "e2874b85-6032-4904-9339-29dbce3741af",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Torf (aus Torfmoosen) ist ein gutes Substrat für Gartenbau, sollte jedoch als Kohlenstoffspeicher im Sinn des Klimaschutzes geschont werden.“"
                            },
                            {
                                "example_id": "5cf66113-5514-44a8-a334-46da92ada9c3",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "Der Raubbau an den tropischen Regenwäldern ist die gegenwärtig größte Vernichtung von Kohlenstoffspeichern."
                            },
                            {
                                "example_id": "2c502338-481d-413b-ac4a-aa8b7f404fd2",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Als Kohlenstoffspeicher können Wälder den Klimawandel bremsen. Die Frage ist nur: Wie lange noch? Denn Bäume leiden selbst unter dem Klimastress.“"
                            },
                            {
                                "example_id": "72020f56-030c-44d2-903d-11a6f39469d7",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Die Abholzung zerstört wichtige Kohlenstoffspeicher der Erde.“"
                            },
                            {
                                "example_id": "a00cbb39-8f98-4bdf-9196-0053b8b98b21",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Doch trotz Hürden und hohen Zielen hinsichtlich der Aufforstung gibt es zahlreiche Projekte weltweit, die den Baum als Kohlenstoffspeicher fördern wollen. Auch in der Schweiz.“"
                            },
                            {
                                "example_id": "2bac8626-8071-4b55-b4b7-639a8000a7ad",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "„Insbesondere Palmöl steht in der Kritik, da häufig artenreiche und als Kohlenstoffspeicher fungierende tropische Regenwälder für Ölpalmenplantagen gerodet werden und dabei der gespeicherte Kohlenstoff beim Brandroden wieder als CO₂ freigesetzt wird.“"
                            },
                            {
                                "example_id": "fc6d49ad-4ef8-4c24-8a01-39d493b75c35",
                                "sense_id": "44d2f932-8caa-3a83-bc37-f162baa4a6aa",
                                "text": "Das Überschreiten eines Kipppunktes führt zur Freisetzung weiteren Kohlenstoffdioxids aus Kohlenstoffspeichern und damit einem weiteren schnellen Anstieg der Temperatur."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
