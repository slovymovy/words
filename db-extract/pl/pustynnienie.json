                                        "examples": [
                                            {
                                                "example_id": "f4c56d28-7355-4a1c-81c8-4f58a17ad8de",
                                                "sense_id": "1d219218-5f70-311a-a977-af6d79f3f6a4",
                                                "text": "In Kinderzimmer herrscht totale Verwüstung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "320c81cf-8140-3a4c-a822-61e54c5fc41b",
                                        "entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                                        "glosses": [
                                            "Zustand der Verstörung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9365f26c-6150-4c24-8ccc-bc10c94746c4",
                                                "sense_id": "320c81cf-8140-3a4c-a822-61e54c5fc41b",
                                                "text": "Nach dem Krieg war die Verwüstung der Wirtschaft zu spüren."
                                            },
                                            {
                                                "example_id": "b17877a7-fac7-4ced-83f7-f7fb1a146cf6",
                                                "sense_id": "320c81cf-8140-3a4c-a822-61e54c5fc41b",
                                                "text": "Er litt lange unter seiner seelischen Verwüstung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98516aa5-1b80-4a1e-9826-0c6e7ddf0c85",
                        "source_entry_id": "05391f1f-bd67-3a3d-bbe6-a28db2e38670",
                        "source_sense_id": "f5490390-65bc-31c1-b37c-3cc169829427",
                        "target_lang_word": "Wüstenbildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wüstenbildung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                        "entry_id": "412a509a-2207-3f85-ba56-87a18aff2ea2",
                                        "glosses": [
                                            "stetige Zunahme der Fläche von Wüsten (beispielsweise in der Sahelzone, in Zentralasien) und Entstehung neuer Wüsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0befe0-1a25-4c74-a1dd-6d7ff70e7b6d",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Dürren und Wüstenbildung zerstören Lebensgrundlagen.“"
                                            },
                                            {
                                                "example_id": "a9be976f-cbc9-4793-8936-fbacc66aeeac",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Die Vereinten Nationen (UN) schätzen: Mehr als eine Milliarde Menschen in über hundert Ländern sind von der Wüstenbildung betroffen.“"
                                            },
                                            {
                                                "example_id": "70c106b5-542e-44f5-a548-f3f933e1fcdf",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Die globale Wüstenbildung ist eine stille Krise der Gegenwart.“"
                                            },
                                            {
                                                "example_id": "a7266a5f-6e70-4a9c-bd48-93c81502ebfc",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Es handelt sich bei Wüstenbildung also nicht nur um das Entstehen neuer Sandwüsten, sondern vor allem um die schleichende Degradierung fruchtbarer Böden.“"
                                            },
                                            {
                                                "example_id": "38993196-7af3-4b05-a5af-fadf3ce4227b",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Etwa ein Drittel der weltweiten Landfläche ist von Wüstenbildung bedroht, vor allem die Regionen, die in Trockengebieten liegen, also Afrika und Asien. Etwa zwei Drittel der globalen Wüstenfläche liegen bereits dort: rund 670 Millionen Hektar. “"
                                            },
                                            {
                                                "example_id": "1fe9b723-25ee-4209-9755-c64552f34982",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„13 EU-Länder haben mittlerweile Wüstenbildung gemeldet.“"
                                            },
                                            {
                                                "example_id": "f5277c41-de5c-4348-afe3-c7828dd652c5",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Um die Wüstenbildung zu unterbinden, ist in der Sahara ein Baumgürtel durch elf Länder geplant.“"
                                            },
                                            {
                                                "example_id": "9d6d290f-9653-43c1-a0f8-b190658373b0",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Shyam Sunder Jyani“ […] „hat sich dem Pflanzen von Bäumen verschrieben. Um die Wüstenbildung einzudämmen und sowohl Schatten als auch Früchte zu gewinnen, hat er persönlich das Pflanzen von mehr als 2,5 Millionen Setzlingen in den vergangenen 15 Jahren finanziert.“"
                                            },
                                            {
                                                "example_id": "c574c40c-7808-4c9e-8f59-7f5b36d4b4e9",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Bereits 2007 wurde das Projekt der \"Grünen Wand\" ins Leben gerufen, um der Wüstenbildung in der afrikanischen Sahelzone Einhalt zu gebieten.“"
                                            },
                                            {
                                                "example_id": "0a14a482-7abf-416c-a8ee-7c83af2cb8be",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Die Wüste Gobi, ein weiträumiges Trockengebiet in der Mongolei und der Volksrepublik China, ist die am schnellsten wachsende Wüste der Erde.“ […] „Klimazyklen spielen bei der Wüstenbildung eine Rolle, doch eine der Hauptursachen für die Ausdehnung auch der Gobi ist der Mensch selbst.“"
                                            },
                                            {
                                                "example_id": "95a8092e-a9c6-4e64-9040-db455ef1abb4",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Es stimmt: Im Vergleich zu Ländern, die mit Wüstenbildung, Überschwemmungen oder gleich der völligen Vernichtung zu kämpfen haben, hat der Klimawandel hierzulande milde Auswirkungen. Trotzdem wird er unseren Alltag verändern.“"
                                            },
                                            {
                                                "example_id": "b95091dd-8895-4225-a5b5-4fe512e4f28f",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Anscheinend lässt die Klimaerwärmung mehr Wasser über den Ozeanen verdunsten, das dann in Wüstenregionen als Niederschlag zu Boden fällt. Trotzdem schreitet die Wüstenbildung fort.“"
                                            },
                                            {
                                                "example_id": "fae43d9b-19c2-4a49-b465-f6cdc52d0099",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "„Der Aralsee war einst das viertgrösste Binnengewässer der Welt. Doch wo früher Wasser war, ist heute eine lebensfeindliche Salzwüste – die Aralkum – entstanden. Kann man die fortschreitende Wüstenbildung noch stoppen?“"
                                            },
                                            {
                                                "example_id": "a6d5afe7-3da0-444c-8a10-81a40547f253",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "[Studie: Die Wissenschaftler entdeckten] „Belege für vier „kurze, nur jeweils wenige zehntausende Jahre“ währende Phasen der Wüstenbildung in Mesopotamien.“"
                                            },
                                            {
                                                "example_id": "176746dc-8b1b-4039-895e-e8534361482c",
                                                "sense_id": "b036d9a7-d4ab-3c93-9ebe-208726d76ac3",
                                                "text": "[China:] „Nach Angaben der englischsprachigen Zeitung \"China Daily\" entstehen durch die zunehmende Wüstenbildung jährlich wirtschaftliche Verluste in Höhe von umgerechnet 5,3 Milliarden Euro. In den vergangenen zehn Jahren hätten die Wüsten jährlich 2.460 Quadratkilometer Land verschluckt, berichtet Wissenschaftler Wang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
