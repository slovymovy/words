        "nl-extract.jsonl": [
            {
                "entry_id": "3e39d66f-8a45-3512-b45d-4d1b50ed8fb2",
                "word": "waarachtigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "14eca070-c45e-47b0-b848-d98fcec2434d",
                        "entry_id": "3e39d66f-8a45-3512-b45d-4d1b50ed8fb2",
                        "tags": [
                            "plural"
                        ],
                        "form": "waarachtigheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7199086-73ab-3c5b-aa7c-23a0452274b2",
                        "entry_id": "3e39d66f-8a45-3512-b45d-4d1b50ed8fb2",
                        "glosses": [
                            "het betrouwbaar, eerlijk en waar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09916517-f10d-46e9-a923-2b60c8fcd619",
                                "sense_id": "a7199086-73ab-3c5b-aa7c-23a0452274b2",
                                "text": "Klaus Bachler, intendant van de Bayerische Staatsoper in München, nam vrijdag afstand van Gergiev. 'Ik vind dat waarachtigheid en menselijkheid het fundament zijn van de kunst. Het spreekt daarom voor zichzelf dat je alleen al uit eigenbelang als kunstenaar niet kunt zwijgen bij onmenselijkheid en schendingen van de mensenrechten.'"
                            },
                            {
                                "example_id": "f9947f90-4a86-425d-8b5d-87f806497a46",
                                "sense_id": "a7199086-73ab-3c5b-aa7c-23a0452274b2",
                                "text": "Racer, wiens vader dominee in het Duitse Lingen en in Delden was geweest, werd gedreven door een groot gevoel voor rechtvaardigheid en waarachtigheid."
                            },
                            {
                                "example_id": "da97e0c5-0bd4-4209-a092-e265687c0313",
                                "sense_id": "a7199086-73ab-3c5b-aa7c-23a0452274b2",
                                "text": "De vrouw had al een tijdje naar haar zitten kijken. Opeens riep ze uit: „Ik zie het wel, hoor.” Ze vroeg wat mevrouw dan zag. De vrouw antwoordde, bijna beschuldigend: „Je straalt!” Kijk, dat zijn de kleine, gouden contactmomenten waarnaar Bea Lubbers altijd op zoek is. „Het gaat om waarachtigheid. Hét uitgangspunt voor contact met een ander mens.” Ook als die andere mens verloren lijkt in de tijd. Dementerend is. „Want waarachtigheid is niet alleen zijn wie je bent, maar ook zien wie die ander is.”"
                            },
                            {
                                "example_id": "fa67d0f2-ea15-493b-8464-9059610e56d0",
                                "sense_id": "a7199086-73ab-3c5b-aa7c-23a0452274b2",
                                "text": "Het idee dat er geen rem zou staan op de auteurs, lokte toch wat kritiek uit. Bij pakweg de Britannica stonden de auteur en de redactie garant voor de waarachtigheid en kwaliteit van de informatie. Hoe zou dat gaan bij een online encyclopedie waar iedereen aan kon bijdragen?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc61d823-8f44-4697-b6be-610ee767af87",
                        "source_entry_id": "3e39d66f-8a45-3512-b45d-4d1b50ed8fb2",
                        "source_sense_id": "a7199086-73ab-3c5b-aa7c-23a0452274b2",
                        "target_lang_word": "truth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e715384-f19b-3df8-98a5-f4f8ad33ac1c",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "True facts, genuine depiction or statements of reality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638f9505-235a-45c3-a8a6-527176b91bf6",
                                                "sense_id": "7e715384-f19b-3df8-98a5-f4f8ad33ac1c",
                                                "text": "The truth is that our leaders knew a lot more than they were letting on."
                                            },
                                            {
                                                "example_id": "e203e966-f6a5-4f1d-a5a1-cb410cc6d848",
                                                "sense_id": "7e715384-f19b-3df8-98a5-f4f8ad33ac1c",
                                                "text": "The truth depends on, and is only arrived at, by a legitimate deduction from all the facts which are truly material."
                                            },
                                            {
                                                "example_id": "46b926c1-ae81-4f2b-b627-07472848415b",
                                                "sense_id": "7e715384-f19b-3df8-98a5-f4f8ad33ac1c",
                                                "text": "The truth is that [Isaac] Newton was very much a product of his time. The colossus of science was not the first king of reason, Keynes wrote after reading Newton’s unpublished manuscripts. Instead “he was the last of the magicians”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "275c075d-932a-3003-acfa-b262ed5520fd",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "Conformity to fact or reality; correctness, accuracy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5725cd2e-4133-400a-82b6-489cee1e6e42",
                                                "sense_id": "275c075d-932a-3003-acfa-b262ed5520fd",
                                                "text": "There was some truth in his statement that he had no other choice."
                                            },
                                            {
                                                "example_id": "e0cf6c14-5113-4779-a89b-aa5c261aa49d",
                                                "sense_id": "275c075d-932a-3003-acfa-b262ed5520fd",
                                                "text": "As in much of biology, the most satisfying truths in ecology derive from manipulative experimentation. Tinker with nature and quantify how it responds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe410d9-eef8-3e66-8836-4914e82e8974",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "The state or quality of being true to someone or something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca5884d-c6d9-4675-8b2d-f8d4b94978ec",
                                                "sense_id": "3fe410d9-eef8-3e66-8836-4914e82e8974",
                                                "text": "Truth to one's own feelings is all-important in life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33c186bf-13f0-3c9c-9079-391cfdb5a2a7",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "Faithfulness, fidelity."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6101360-2a49-4beb-88a9-7b32a5ede030",
                                                "sense_id": "33c186bf-13f0-3c9c-9079-391cfdb5a2a7",
                                                "text": "Alas! they had been friends in youth; / But whispering tongues can poison truth; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4995b39-42db-3b11-a22a-a1ab513b07a2",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "A pledge of loyalty or faith."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d29d6c42-6f8a-3905-a44a-ec20411b2ec4",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "Conformity to rule; exactness; close correspondence with an example, mood, model, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b121d0d-eff8-4b49-af01-72794ab34ae0",
                                                "sense_id": "d29d6c42-6f8a-3905-a44a-ec20411b2ec4",
                                                "text": "Ploughs, […] to make them go true, […] depends much upon the truth of the ironwork."
                                            },
                                            {
                                                "example_id": "e92a7214-3eec-4fbe-9c4f-2f4bf854a15d",
                                                "sense_id": "d29d6c42-6f8a-3905-a44a-ec20411b2ec4",
                                                "text": "The process of grinding is, in fact, regarded as indispensable wherever truth is required, yet that of scraping is calculated to produce a higher degree of truth than has ever been attained by grinding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "895a7bf9-e291-300e-816f-bbf3eb913ac0",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "That which is real, in a deeper sense; spiritual or ‘genuine’ reality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99791e78-7a9d-4791-b822-676c21cd5666",
                                                "sense_id": "895a7bf9-e291-300e-816f-bbf3eb913ac0",
                                                "text": "The truth is what is."
                                            },
                                            {
                                                "example_id": "d0042a21-caaa-47ff-8efc-b402e9a9c28e",
                                                "sense_id": "895a7bf9-e291-300e-816f-bbf3eb913ac0",
                                                "text": "Alcoholism and redemption led me finally to truth."
                                            },
                                            {
                                                "example_id": "16123e09-2c95-4fca-a9ac-4bb7bc5765e0",
                                                "sense_id": "895a7bf9-e291-300e-816f-bbf3eb913ac0",
                                                "text": "\"Beauty is truth, truth beauty,\"—that is all / Ye know on earth, and all ye need to know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90df33d-9b02-3caf-b6b0-a5fad22bf6dc",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "Something acknowledged to be true; a true statement or axiom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0662fb58-f913-4a7c-be57-319df10cf44b",
                                                "sense_id": "d90df33d-9b02-3caf-b6b0-a5fad22bf6dc",
                                                "text": "Hunger and jealousy are just eternal truths of human existence."
                                            },
                                            {
                                                "example_id": "bd0b5688-87e1-4b25-b007-9195f64ffea0",
                                                "sense_id": "d90df33d-9b02-3caf-b6b0-a5fad22bf6dc",
                                                "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in want of a wife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16e8c11-3b81-323c-80a7-0870b316e979",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "Topness; the property of a truth quark."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f496f117-697b-3b60-9ab5-b1b658496b36",
                                        "entry_id": "9f7bdd60-1965-329a-a91e-8e3c9fa26828",
                                        "glosses": [
                                            "In the game truth or dare, the choice to truthfully answer a question put forth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf33ea1-ce31-4e55-aa5a-0d49b69deb22",
                                                "sense_id": "f496f117-697b-3b60-9ab5-b1b658496b36",
                                                "text": "When asked truth or dare, he picked truth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "truth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27932c77-2ba7-3ade-90d7-4dc25e6f5ffc",
                                        "entry_id": "109c1123-6cf3-3ed7-9557-33270778219e",
                                        "glosses": [
                                            "To assert as true; to declare; to speak truthfully."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d8c834-5a5a-45ac-86d9-9b890b4d3665",
                                                "sense_id": "27932c77-2ba7-3ade-90d7-4dc25e6f5ffc",
                                                "text": "c. 1636 John Ford, The Fancies Chaste and Noble\nHad they [the ancients] dreamt this, they would have truthed it heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acf2c7eb-fd4d-3541-8801-eec02feb5385",
                                        "entry_id": "109c1123-6cf3-3ed7-9557-33270778219e",
                                        "glosses": [
                                            "To make exact; to correct for inaccuracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce05ec9-0844-4e4b-b4e2-63bc3e544971",
                                                "sense_id": "acf2c7eb-fd4d-3541-8801-eec02feb5385",
                                                "text": "A concentrated region of the agricultural test area was intensively ground truthed, not only to identify the crop types, but equally important, also to begin to determine the parameters controlling the radar energy reflected from a crop type at a particular stage of growth."
                                            },
                                            {
                                                "example_id": "d8076341-14f5-47a6-86cf-74b66d9a1b8e",
                                                "sense_id": "acf2c7eb-fd4d-3541-8801-eec02feb5385",
                                                "text": "As is shown in this table, APG images in the validation subset were only truthed with box models, and the 29P images in this subset were never truthed at all."
                                            },
                                            {
                                                "example_id": "42edb089-7389-4bd0-86e7-d15159191804",
                                                "sense_id": "acf2c7eb-fd4d-3541-8801-eec02feb5385",
                                                "text": "This database, which consisists of nearly 180,000 characters, was manually truthed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6690d33-8687-3ec8-a338-8694abd7f0ce",
                                        "entry_id": "109c1123-6cf3-3ed7-9557-33270778219e",
                                        "glosses": [
                                            "To tell the truth."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edee8da0-f057-4c97-a4f9-812fc191bf0a",
                                                "sense_id": "d6690d33-8687-3ec8-a338-8694abd7f0ce",
                                                "text": "You keep lying, when you oughta be truthin'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
