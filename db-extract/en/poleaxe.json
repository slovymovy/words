                                "target_senses": [
                                    {
                                        "sense_id": "7cf38955-8555-3cf0-8336-32f8e49d1182",
                                        "entry_id": "5d5ab45b-bf36-35cb-a623-3659318cfa64",
                                        "glosses": [
                                            "jemanden entrüsten, jemanden unangenehm überraschen, bei jemandem Anstoß erregen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837daf8e-95d3-47e3-98c4-1c9b0f3f6864",
                                                "sense_id": "7cf38955-8555-3cf0-8336-32f8e49d1182",
                                                "text": "Die Nachricht von seinem plötzlichen Tod schockierte die ganze Nation."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
