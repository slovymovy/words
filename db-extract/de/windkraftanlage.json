                        ],
                        "form": "die Windkraftanlage"
                    },
                    {
                        "form_id": "3c29697c-1824-4a2f-9c79-593f77af867d",
                        "entry_id": "f8de2ce1-2697-3524-856c-689dbf2989d7",
                        "tags": [
                            "accusative",
