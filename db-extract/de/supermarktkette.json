                "senses": [
                    {
                        "sense_id": "d060c88b-205b-34ad-aaa4-78c6370b0d73",
                        "entry_id": "79a5526b-ef07-302f-830b-30516e186f3e",
                        "glosses": [
                            "Supermarkt mit Filialen an verschiedenen Standorten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7a8fb0-aead-4d8a-b9fb-7f83a0ce17cc",
                                "sense_id": "d060c88b-205b-34ad-aaa4-78c6370b0d73",
                                "text": "„Bald eignete er sich ein Hotel, eine Supermarktkette und Immobilien an, deren Vermehrung er sich nach seinem Ausscheiden aus dem Militärdienst im Jahr 1992 hauptsächlich widmete.“"
                            },
                            {
                                "example_id": "4ce8542e-e394-455a-98b3-6e01ab54de92",
                                "sense_id": "d060c88b-205b-34ad-aaa4-78c6370b0d73",
                                "text": "„Der Frischling gibt mir wortlos mein Handy zurück, das in einer Plastiktüte mit dem Logo einer bekannte Supermarktkette steckt.“"
                            },
                            {
                                "example_id": "24da8f12-aed7-4ac4-9e30-5048a2879dad",
                                "sense_id": "d060c88b-205b-34ad-aaa4-78c6370b0d73",
                                "text": "„Die Verhandlungen jedoch führt sie mit dem Gewährsmann von Locatellis Organisation in Rom, Roberto Severa, einem führenden Mitglied der Magliana-Bande, dem Locatelli große Summen zur Reinvestition in eine Supermarktkette und weitere Geschäfte in die Hauptstadt anvertraut hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
