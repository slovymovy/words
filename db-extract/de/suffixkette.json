                "senses": [
                    {
                        "sense_id": "ec2d773a-c4d1-365c-bde6-756834684474",
                        "entry_id": "fda2031c-8587-3d5e-af01-d28abf3d5c93",
                        "glosses": [
                            "Reihe grammatischer Anhänge hinter dem Stamm/der Wurzel des Wortes"
                        ],
                        "tags": [
                            "Morphologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4ea5e4ab-79d0-48d9-b5e4-aa47af116a39",
                                "sense_id": "ec2d773a-c4d1-365c-bde6-756834684474",
                                "text": "„Die Verknüpfung von Agglutination und Synthese führt zu einer charakteristischen Bildung von Präfix- und Suffixketten, die vor allem für die Verbformen kennzeichnend sind, […]“"
                            },
                            {
                                "example_id": "aa44f1dc-ddd3-42de-bd09-70cdbad5f4d1",
                                "sense_id": "ec2d773a-c4d1-365c-bde6-756834684474",
                                "text": "„Männernamen konnten […] feminin- und diese wiederum maskulinmoviert werden. Dies führte zu echten Suffixketten […]“"
                            },
                            {
                                "example_id": "310f6103-a45b-4866-a93c-5733cbb2a312",
                                "sense_id": "ec2d773a-c4d1-365c-bde6-756834684474",
                                "text": "„Darüber hinaus steht der sog. ‚Artikel‘ Sg./Pl. in der Suffixkette immer links des Possessiv-Pronomens, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
