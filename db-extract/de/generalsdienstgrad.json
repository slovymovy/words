                "senses": [
                    {
                        "sense_id": "f01a6d5f-e07b-34c9-948f-d582757f1d05",
                        "entry_id": "5a395f82-6e44-3855-8188-ae3dff51f4df",
                        "glosses": [
                            "Dienstgrad der Laufbahngruppe der Generale"
                        ],
                        "tags": [
                            "Heer",
                            "Luftwaffe"
                        ],
                        "examples": [
                            {
                                "example_id": "8d751598-f245-4f81-aa28-6d250d4ff33f",
                                "sense_id": "f01a6d5f-e07b-34c9-948f-d582757f1d05",
                                "text": "„Für den Bereich des MfS sollte das Politbüro den Minister und seine Stellvertreter sowie sämtliche Ernennungen in den ersten Generalsdienstgrad, also vom Oberst zum Generalmajor, und alle Beförderungen innerhalb der Generalsdienstgrade bestätigen.“"
                            },
                            {
                                "example_id": "1d62ffb0-a111-40b6-85bf-835c90a69a0e",
                                "sense_id": "f01a6d5f-e07b-34c9-948f-d582757f1d05",
                                "text": "„Moltke hatte sein Amt als Chef des Generalstabes der Armee als Generalmajor im damals untersten Generalsdienstgrad, Roon das des Kriegsministers schon als Generalleutnant angetreten.“"
                            },
                            {
                                "example_id": "f39511aa-bb95-4862-aff1-252be3357a41",
                                "sense_id": "f01a6d5f-e07b-34c9-948f-d582757f1d05",
                                "text": "„1940 wurden die Generalsdienstgrade Generalmajor bis Armeegeneral eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
