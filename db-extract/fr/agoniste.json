            {
                "entry_id": "6f1e6478-7e96-3714-9b4a-79d47cf98e99",
                "word": "agoniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b84cc9f-16ae-439a-b20e-826ef324dd00",
                        "entry_id": "6f1e6478-7e96-3714-9b4a-79d47cf98e99",
                        "tags": [
                            "plural"
                        ],
                        "form": "agonistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14ff0c4d-3b0d-3a9b-8845-eb51bdd8412c",
                        "entry_id": "6f1e6478-7e96-3714-9b4a-79d47cf98e99",
                        "glosses": [
                            "Lutteur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ee500474-8255-48a7-a5e0-7ac13496ed08",
                                "sense_id": "14ff0c4d-3b0d-3a9b-8845-eb51bdd8412c",
                                "text": "Il en est de même pour la statue du Dieu, que l’agoniste vainqueur lui consacre."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ae4eca-4455-3b15-9199-c85476c8c769",
                        "entry_id": "6f1e6478-7e96-3714-9b4a-79d47cf98e99",
                        "glosses": [
                            "Muscle à l’origine d’un mouvement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c727f6bb-5461-46ed-a4a4-f4cd9456b8d7",
                                "sense_id": "90ae4eca-4455-3b15-9199-c85476c8c769",
                                "text": "Dans la flexion du bras, l’agoniste est le muscle grand pectoral, qui recouvre la face antérieure du thorax (et qui s’insère sur l’humérus). — (Elaine Marieb, Katja Hoehn, Anatomie et physiologie humaines, Pearson Éducation France, 2014)"
                            }
                        ]
                    },
                    {
                        "sense_id": "12836f8f-b681-3d66-8077-e5b31d361d77",
                        "entry_id": "6f1e6478-7e96-3714-9b4a-79d47cf98e99",
                        "glosses": [
                            "Molécule qui se lie à un récepteur et déclenche une réponse biologique semblable à celle du ligand naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95eefb15-7f1f-43d1-bbb1-3a15b7947e1a",
                                "sense_id": "12836f8f-b681-3d66-8077-e5b31d361d77",
                                "text": "Le plus connu des agonistes purs est la morphine."
                            },
                            {
                                "example_id": "95e1a2cd-61f7-40e1-9fba-213037836b5d",
                                "sense_id": "12836f8f-b681-3d66-8077-e5b31d361d77",
                                "text": "Les études fonctionnelles permettent de savoir si une molécule étudiée par liaison spécifique et ayant une affinité intéressante est un agoniste ou un antagoniste."
                            }
                        ]
                    }
                ],
