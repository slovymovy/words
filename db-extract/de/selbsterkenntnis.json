                "senses": [
                    {
                        "sense_id": "43f5eb56-1d5c-3e42-908c-bcb1504e82e0",
                        "entry_id": "b75c702c-a3e9-3423-991d-8104e1601395",
                        "glosses": [
                            "die Erkenntnis einer Person über das eigene Selbst, insbesondere in Hinblick auf unbewusste Motive und Fehler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f841a0-55f2-4439-ab33-025db83c993e",
                                "sense_id": "43f5eb56-1d5c-3e42-908c-bcb1504e82e0",
                                "text": "Die Selbsterkenntnis ist eine Tugend, die von den Menschen am schwersten erkämpft werden muss."
                            },
                            {
                                "example_id": "e8553304-650c-406d-8859-0dd21a1fe4bb",
                                "sense_id": "43f5eb56-1d5c-3e42-908c-bcb1504e82e0",
                                "text": "Selbsterkenntnis ist der erste Schritt zur Besserung."
                            },
                            {
                                "example_id": "9f0fb378-6c23-42f8-a5f3-5cb94a0c2ce0",
                                "sense_id": "43f5eb56-1d5c-3e42-908c-bcb1504e82e0",
                                "text": "„Die Freunde nennen sich aufrichtig. Die Feinde sind es – daher man ihren Tadel zur Selbsterkenntnis benutzen sollte, als eine bittere Arznei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
