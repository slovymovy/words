    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9944de1-a7e2-3ffd-ad7a-9b1870caed52",
                    "sense_definition": "Of, or relating to the eye, or the sense of sight",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eye-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was warned that the new medication may have adverse <w>ocular</w> side effects.",
                            "target_lang_translations": {
                                "ru": "Пациента предупредили, что новое лекарство может иметь неблагоприятные <w>глазные</w> побочные эффекты."
                            }
                        },
                        {
                            "text": "After the accident, it took several months for him to receive his custom <w>ocular</w> prosthesis.",
                            "target_lang_translations": {
                                "ru": "После аварии ему потребовалось несколько месяцев, чтобы получить изготовленный на заказ <w>глазной</w> протез."
                            }
                        }
                    ],
                    "synonyms": [
                        "visual",
                        "ophthalmic",
                        "optic"
                    ],
                    "common_phrases": [
                        "ocular health",
                        "ocular muscles",
                        "ocular pressure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к глазу или зрению"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазной",
                                "target_lang_sense_clarification": "относящийся к органу зрения"
                            },
                            {
                                "target_lang_word": "окулярный",
                                "target_lang_sense_clarification": "медицинский или технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                    "sense_definition": "Seen by, or seeing with, the eye; based on direct visual observation",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual-observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective demanded <w>ocular</w> proof before he would believe the witness's wild story.",
                            "target_lang_translations": {
                                "ru": "Детектив потребовал <w>наглядных</w> доказательств, прежде чем поверить в невероятную историю свидетеля."
                            }
                        },
                        {
                            "text": "The scientist provided an <w>ocular</w> demonstration of the chemical reaction to the students.",
                            "target_lang_translations": {
                                "ru": "Ученый провел для студентов <w>наглядную</w> демонстрацию химической реакции."
                            }
                        }
                    ],
                    "synonyms": [
                        "visual",
                        "eyewitness"
                    ],
                    "common_phrases": [
                        "ocular proof",
                        "ocular demonstration",
                        "ocular witness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увиденный собственными глазами или основанный на прямом визуальном наблюдении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визуальный",
                                "target_lang_sense_clarification": "основанный на зрении"
                            },
                            {
                                "target_lang_word": "наглядный",
                                "target_lang_sense_clarification": "очевидный для глаз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ff0d86f-81c2-330d-9ab1-7e2dd8f8f120",
                    "sense_definition": "Resembling the shape or appearance of an eye",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eye-like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist noted the distinct <w>ocular</w> markings on the wings of the rare butterfly.",
                            "target_lang_translations": {
                                "ru": "Биолог заметил отчетливые <w>глазчатые</w> отметины на крыльях редкой бабочки."
                            }
                        },
                        {
                            "text": "The pattern on the stone had a strange <w>ocular</w> quality that made it look like it was watching us.",
                            "target_lang_translations": {
                                "ru": "Узор на камне обладал странным <w>глазоподобным</w> свойством, из-за чего казалось, что он наблюдает за нами."
                            }
                        }
                    ],
                    "synonyms": [
                        "eye-like"
                    ],
                    "common_phrases": [
                        "ocular markings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий форму или внешний вид глаза"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазчатый",
                                "target_lang_sense_clarification": "имеющий пятна, похожие на глаза"
                            },
                            {
                                "target_lang_word": "глазоподобный",
                                "target_lang_sense_clarification": "похожий на глаз"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6f7a877-8c8e-3090-a375-0ae006b8d172",
                    "sense_definition": "The eyepiece of a microscope or other optical instrument, being the lens closest to the eye",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "optical-parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to adjust the <w>ocular</w> to get a clearer view of the specimen.",
                            "target_lang_translations": {
                                "ru": "Вам нужно отрегулировать <w>окуляр</w>, чтобы лучше рассмотреть образец."
                            }
                        },
                        {
                            "text": "The technician replaced the scratched <w>ocular</w> on the telescope to improve visibility.",
                            "target_lang_translations": {
                                "ru": "Техник заменил поцарапанный <w>окуляр</w> на телескопе, чтобы улучшить видимость."
                            }
                        }
                    ],
                    "synonyms": [
                        "eyepiece"
                    ],
                    "antonyms": [
                        "objective"
                    ],
                    "common_phrases": [
                        "microscope ocular"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окуляр микроскопа или другого оптического прибора; линза, ближайшая к глазу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окуляр",
                                "target_lang_sense_clarification": "часть оптического прибора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe79670a-5597-33a5-8cb6-8d6bbed93d43",
                    "sense_definition": "Any of the scales forming the margin of a reptile's eye",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reptile-anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The herpetologist examined the arrangement of the <w>oculars</w> to identify the snake species.",
                            "target_lang_translations": {
                                "ru": "Герпетолог изучил расположение <w>глазничных щитков</w>, чтобы определить вид змеи."
                            }
                        },
                        {
                            "text": "In some lizards, the <w>ocular</w> scales are fused into a transparent protective disk.",
                            "target_lang_translations": {
                                "ru": "У некоторых ящериц <w>окулярные</w> чешуйки срастаются в прозрачный защитный диск."
                            }
                        }
                    ],
                    "synonyms": [
                        "ocular scale"
                    ],
                    "common_phrases": [
                        "preocular scale",
                        "postocular scale"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "zoological"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из чешуек, образующих край глаза рептилии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазничный щиток",
                                "target_lang_sense_clarification": "в зоологии"
                            },
                            {
                                "target_lang_word": "окулярная чешуя",
                                "target_lang_sense_clarification": "анатомия рептилий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}