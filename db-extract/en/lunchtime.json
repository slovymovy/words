                "forms": [
                    {
                        "form_id": "be4fa153-d1ef-4834-99c9-2807ed3ade8c",
                        "entry_id": "41e9cb81-5d36-3dc4-a60c-6f647330b206",
                        "tags": [
                            "plural"
                        ],
                        "form": "lunchtimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f8bc8b4-e7c9-356b-9901-34e555c49422",
                        "entry_id": "41e9cb81-5d36-3dc4-a60c-6f647330b206",
                        "glosses": [
                            "The time or hour at or around which lunch is normally eaten."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "77dcf9c5-fa2d-34b6-9a06-dd7022a432fd",
                        "entry_id": "41e9cb81-5d36-3dc4-a60c-6f647330b206",
                        "glosses": [
                            "A break in work or school to eat lunch."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eeba6169-7f39-4bbf-a073-782e838d8def",
                                "sense_id": "77dcf9c5-fa2d-34b6-9a06-dd7022a432fd",
                                "text": "It's almost lunchtime, so I think I'll finish up later this afternoon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b310989-9fe3-490e-a646-b5a52b028751",
                        "source_entry_id": "41e9cb81-5d36-3dc4-a60c-6f647330b206",
                        "source_sense_description": "time or hour for lunch",
                        "target_lang_word": "Mittagszeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagszeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "185e1a3d-17a7-3e88-9f8e-e216fbb788b0",
                                        "entry_id": "2caa572f-271f-3b1f-91a7-701a514cff46",
                                        "glosses": [
                                            "die Zeit um 12:00 Uhr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "677b9b72-c4d8-4348-b3bf-72b5feaab368",
                                                "sense_id": "185e1a3d-17a7-3e88-9f8e-e216fbb788b0",
                                                "text": "Wir könnten uns morgen um die Mittagszeit treffen und alles besprechen."
                                            },
                                            {
                                                "example_id": "f078d01c-3768-4ebe-901e-a27f79a4b791",
                                                "sense_id": "185e1a3d-17a7-3e88-9f8e-e216fbb788b0",
                                                "text": "„Zur Mittagszeit rief dann ein Junge durch ein offenes Fenster, dass die Soldaten anrückten.“"
                                            },
                                            {
                                                "example_id": "288386ed-85f0-4173-9b6b-1ca8cd365711",
                                                "sense_id": "185e1a3d-17a7-3e88-9f8e-e216fbb788b0",
                                                "text": "„Doch die Mittagszeit war stressig.“"
                                            },
                                            {
                                                "example_id": "eba92d57-920e-4bea-a642-1a353a4488e1",
                                                "sense_id": "185e1a3d-17a7-3e88-9f8e-e216fbb788b0",
                                                "text": "„Das Ganze glich einem Manöver, das bei schönem Wetter, etwa um die Mittagszeit beginnen sollte.“"
                                            },
                                            {
                                                "example_id": "f66f72ce-bd0d-4c7b-8ade-60b9c9434969",
                                                "sense_id": "185e1a3d-17a7-3e88-9f8e-e216fbb788b0",
                                                "text": "„Als die Sonne um die Mittagszeit wie ein Feuerrad am Himmel brannte, war kein Wolkenfetzen sichtbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb1b855a-34fa-4f39-ae79-d84f64870f6f",
                        "source_entry_id": "41e9cb81-5d36-3dc4-a60c-6f647330b206",
                        "source_sense_description": "time or hour for lunch",
                        "target_lang_word": "Mittagspause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagspause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61018438-5897-35b3-a777-e2e98b07afff",
                                        "entry_id": "e5081118-5b0e-36de-a10b-51ee6730a102",
                                        "glosses": [
                                            "Unterbrechung einer Tätigkeit zur Zeit des Mittags"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e9b756-e7da-45b8-a334-e2bd74ec5642",
                                                "sense_id": "61018438-5897-35b3-a777-e2e98b07afff",
                                                "text": "„Meine Mittagspause verbrachte ich mit Herrn Klein, Frau Landaus Bruder aus Ungarn.“"
                                            },
                                            {
                                                "example_id": "8a691431-344a-4463-80aa-f4abda47cc75",
                                                "sense_id": "61018438-5897-35b3-a777-e2e98b07afff",
                                                "text": "„‚Impulse shopping‘, der Gang zur Boutique in der Mittagspause, ist still gestorben.“"
                                            },
                                            {
                                                "example_id": "3cb896f9-55e6-49b2-af0a-86d417ccadd5",
                                                "sense_id": "61018438-5897-35b3-a777-e2e98b07afff",
                                                "text": "„Während der Mittagspause gab die frisch installierte Sirene Probealarm.“"
                                            },
                                            {
                                                "example_id": "eb021219-a3d3-4d0c-82d9-39746569cda9",
                                                "sense_id": "61018438-5897-35b3-a777-e2e98b07afff",
                                                "text": "„Das einzige Problem war, dass der Polizeichef sich gerade in einer sehr ausgedehnten Mittagspause befand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "584ecee4-ce44-4796-aedc-8cba74a3659e",
                        "source_entry_id": "41e9cb81-5d36-3dc4-a60c-6f647330b206",
                        "source_sense_description": "time or hour for lunch",
                        "target_lang_word": "обе́д",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обе́д",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "действие по значению гл. обедать; основной дневной приём пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbef858-2f22-4b57-a89c-16f4d56f7cd7",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "Обед кончился очень весело; но когда были поданы бутылки с лафитом и шамбертеном, Привалов отказался наотрез, что больше не будет пить вина."
                                            },
                                            {
                                                "example_id": "c3a0af74-8f02-459d-9649-1890c090195d",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "За обедом я сидел подле Маруси и был очень счастлив."
                                            },
                                            {
                                                "example_id": "e9301576-5777-4653-a483-a1e2416ea073",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "Было уже четыре часа, когда мы воротились домой, следовательно, до обеда оставался ещё час."
                                            },
                                            {
                                                "example_id": "3faf3287-c935-4b90-8194-4e9e4e935bef",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "Моя мамаша подала за обедом не два блюда, как всегда, а четыре."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c41915f-31b0-3bb7-979d-34d4a68a5042",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "кушанья, предназначаемые для дневного приёма пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5be452-6265-40fa-b621-20a4d26a9fd7",
                                                "sense_id": "2c41915f-31b0-3bb7-979d-34d4a68a5042",
                                                "text": "В этот день Катя сама на рынок сходила, купила говядины для супа (у них к обеду только суп; вместо второго блюда — чай) и приготовила обед."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "разг. обеденное время в середине дня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7616b97c-0c20-4251-a6ac-aa679a78e601",
                                                "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                                "text": "— Барышня забыла вам передать это письмецо от госпожи Хохлаковой, оно у них с обеда лежит."
                                            },
                                            {
                                                "example_id": "97b8b703-96b1-44d3-8481-cf08fa65709f",
                                                "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                                "text": "И обед не в обед."
                                            },
                                            {
                                                "example_id": "a483d721-a652-4d97-a5bd-1f1e652cbaed",
                                                "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                                "text": "— Скоро ли наш батюшка-то пожалует? — Завтра — в обед, — отвечал Вадим, стараясь отделаться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a258a6-5ebc-3259-9a49-ea846324af96",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "дневной приём пищи, устраиваемый как угощение, с приглашением гостей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc07235-54f3-4fb4-8cf7-bdaf069e52c9",
                                                "sense_id": "20a258a6-5ebc-3259-9a49-ea846324af96",
                                                "text": "Два-три раза в году зададут обед — и баста, а сами ни к кому ни ногой…"
                                            },
                                            {
                                                "example_id": "78f8d499-2416-4a01-9979-3d1545b9995f",
                                                "sense_id": "20a258a6-5ebc-3259-9a49-ea846324af96",
                                                "text": "От обеда он отказался, ссылаясь на головную боль, но не выразил ничего против, когда граф посоветовал ему пообедать в своей комнате, в постели."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
