                                    {
                                        "sense_id": "33999bd8-cbe2-352d-9b54-93d8f5a136b9",
                                        "entry_id": "cf4a2381-9f35-3bbf-a432-07191b290c4a",
                                        "glosses": [
                                            "der essbare Same einer ungenießbaren Steinfrucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af4103a-5192-496f-9d10-5b26d993b87b",
                                                "sense_id": "33999bd8-cbe2-352d-9b54-93d8f5a136b9",
                                                "text": "Aus Mandeln macht man Marzipan."
                                            },
                                            {
                                                "example_id": "ef7e1ec1-3291-41b8-82c3-2c7b6332394e",
                                                "sense_id": "33999bd8-cbe2-352d-9b54-93d8f5a136b9",
                                                "text": "„Die Teilnehmer des Hochzeitszuges überschütteten die Zuschauer mit kandierten Mandeln, dem traditionellen Hochzeitskonfekt, und türmten die übriggebliebenen Mandeln zu süßen weißen Bergen auf dem Brautbett auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b18e1ed7-1cd9-3477-97f8-eb9635abe525",
                                        "entry_id": "cf4a2381-9f35-3bbf-a432-07191b290c4a",
                                        "glosses": [
                                            "der Baum, an dem ^([1]) wächst"
                                        ],
                                        "tags": [
                                            "Prunus dulcis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742f4a2e-9009-40d6-95d2-1dda4b8d616c",
                                                "sense_id": "b18e1ed7-1cd9-3477-97f8-eb9635abe525",
                                                "text": "Die Mandeln blühen im März."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a22e7d83-aa05-360f-bffc-deb7076200b9",
                                        "entry_id": "cf4a2381-9f35-3bbf-a432-07191b290c4a",
                                        "glosses": [
                                            "Lymphknoten am Übergang von der Mundhöhle zum Rachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21863f0c-312c-4552-adde-239d37931f45",
                                                "sense_id": "a22e7d83-aa05-360f-bffc-deb7076200b9",
                                                "text": "Meine Mandeln mussten entfernt werden."
                                            },
                                            {
                                                "example_id": "df510d10-07f7-4a12-a7d4-0d91b1b554b7",
                                                "sense_id": "a22e7d83-aa05-360f-bffc-deb7076200b9",
                                                "text": "„Im Krankenhaus kriegte Renate die Mandeln raus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15057e4e-763e-33ef-85ff-024b76ed0f3a",
                                        "entry_id": "0685307b-6fa3-37b9-8a70-ab557da958fe",
                                        "glosses": [
                                            "altes Mengenmaß von 15 oder 16 Stück"
