                        "examples": [
                            {
                                "example_id": "07a3c595-1c0f-49f7-9ef0-6d557d047ad7",
                                "sense_id": "ee5438ea-5c4f-33e3-91e3-1a978b065959",
                                "text": "— Ти́ше! — перерва́л Дубро́вский, — где Его́ровна?\n— В ба́рском до́ме в свое́й светёлке, — отвеча́л Гри́ша.",
                                "translation": "“Quiet!” Dubrovsky interrupted. “Where’s Egorovna?”\n“In the main house, in her attic,” Grisha replied.",
                                "english": "“Quiet!” Dubrovsky interrupted. “Where’s Egorovna?”\n“In the main house, in her attic,” Grisha replied."
                            }
                        ]
                    }
