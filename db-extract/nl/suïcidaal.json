                ],
                "senses": [
                    {
                        "sense_id": "f9f33138-61d0-31cb-82d0-d13409543ccd",
                        "entry_id": "3d5df002-d79d-34e3-a49a-735ec0b736c5",
                        "glosses": [
                            "geneigd zijn om zelfmoord te plegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c46b6a-7015-4b58-aa99-6eefe083dabb",
                                "sense_id": "f9f33138-61d0-31cb-82d0-d13409543ccd",
                                "text": "Zijn beroemde boek over zelfmoordenaars in de literatuur is in een nieuwe editie meer dan verdubbeld in omvang. Brouwers las er al het werk van de suïcidale auteurs op na. ‘Psychiaters zouden mijn boek moeten lezen’, zegt hij tijdens een interview bij hem thuis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "571f7002-024b-4f39-a990-dfedbd849049",
                        "source_entry_id": "3d5df002-d79d-34e3-a49a-735ec0b736c5",
                        "source_sense_id": "f9f33138-61d0-31cb-82d0-d13409543ccd",
                        "source_sense_description": "geneigd zijn om zelfmoord te plegen",
                        "target_lang_word": "suicidal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suicidal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2b0f90-b5e9-3382-aec3-777989e9b5e2",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Pertaining to suicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e686d2b7-2c1b-4ed3-8ba5-fdfa952a64b1",
                                                "sense_id": "5a2b0f90-b5e9-3382-aec3-777989e9b5e2",
                                                "text": "He is an authority on the precursors of suicidal behavior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Likely to commit, or to attempt to commit, suicide."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4430fe27-0d8c-4622-a682-f99a563374d0",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "After losing his job, his wife, and his leg in a single week, he became suicidal."
                                            },
                                            {
                                                "example_id": "c6ecf5f7-c801-4253-9947-ce1aa9d77f4f",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "The campaign aimed to give commuters the confidence to trust their own instincts and intervene if they spot someone vulnerable who may be at risk of suicide, and to talk to them to interrupt their suicidal thoughts."
                                            },
                                            {
                                                "example_id": "935a9235-d03e-4f3a-8299-5fbb09b30b40",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "Seven people were killed and 66 injured after a High Speed Train slammed into a stationary vehicle that had been parked across the main line by a suicidal driver."
                                            },
                                            {
                                                "example_id": "6cdfdc7c-42e6-47a3-9e7f-6d2b4badc98a",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "It makes me feel better that I’m not the only one who fantasizes about being struck down by a meteor on my way to work. Mind you, I’m not actively suicidal at all. I just kinda think being dead without actually killing myself would be easier and way less exhausting.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c9a9e4c-4dee-3464-bf05-737255f86819",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Highly likely to certain to result in the deaths of the participants; dangerous or reckless to such a degree as to be tantamount to suicide for those taking part."
                                        ],
                                        "tags": [
                                            "of a voluntarily-chosen course of action"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5c7b9b2-aef2-4408-9394-0ae66715753b",
                                                "sense_id": "3c9a9e4c-4dee-3464-bf05-737255f86819",
                                                "text": "Now, that, admittedly, did do an awful lot more damage (the 5th and 6th were almost completely wiped out), but the High Seas Fleet was, in turn, almost completely wiped out (in fact, basically was wiped out, to a man) by the oncoming rest of the British Grand Fleet, and it was decided by everybody that this kind of, like, suicidal, completely suicidal, charge was probably a bit out of character for Hipper, and so we didn't take that particular one into account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e596be0-b5a8-3201-a171-df289dc3640a",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Extremely reckless."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d20b8c6-41a3-42a3-adeb-a6a2c125074b",
                                                "sense_id": "4e596be0-b5a8-3201-a171-df289dc3640a",
                                                "text": "His driving habits are utterly suicidal."
                                            },
                                            {
                                                "example_id": "a6db15b6-663b-428e-869f-4f5051c70015",
                                                "sense_id": "4e596be0-b5a8-3201-a171-df289dc3640a",
                                                "text": "“We’ve got civilizational suicidal empathy going on,” Musk said, borrowing the term from Gad Saad, a Canadian scholar who is also a frequent Rogan host."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suicidal",
