                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c2b68b44-aed9-487c-90cc-e078efa3de3d",
                                "sense_id": "0a95fbaf-2fd5-38e3-b9c6-b1d395607357",
                                "text": "I driven am to great distresse, / And forced to forgoe th'attempt remedilesse."
                            },
                            {
                                "example_id": "9ffb88f2-997e-4646-a307-48f7a34ff966",
                                "sense_id": "0a95fbaf-2fd5-38e3-b9c6-b1d395607357",
                                "text": "As for the rest, this disease is not so easily discovered, except it be altogether extreame and remedilesse; forasmuch as reason marcheth ever crooked, halting and broken-hipt; and with falshood as with truth; and therefore it is very hard to discover her mistaking and disorder."
                            },
                            {
                                "example_id": "c4c572a2-ec40-40a9-83ce-673a2cb17e22",
                                "sense_id": "0a95fbaf-2fd5-38e3-b9c6-b1d395607357",
                                "text": "[…] cannot be taken to mean that the petitioners have been left remediless."
                            }
                        ]
