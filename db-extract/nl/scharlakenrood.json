                                "target_senses": [
                                    {
                                        "sense_id": "145a2488-f4ce-3f5c-b014-942d42a52c8d",
                                        "entry_id": "e807d879-b975-3b39-a9c9-4a127be01d61",
                                        "glosses": [
                                            "in einem hellen leuchtenden Rot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc65cf1f-9792-484c-8c8b-73bf171f78c0",
                                                "sense_id": "145a2488-f4ce-3f5c-b014-942d42a52c8d",
                                                "text": "Sie trug ein auffälliges scharlachrotes Kleid."
                                            },
                                            {
                                                "example_id": "f49ddfd8-999e-4cf1-b36c-3ddd9c2ad820",
                                                "sense_id": "145a2488-f4ce-3f5c-b014-942d42a52c8d",
                                                "text": "Oben abgebildet ist Gubernatoriana thackerayi. Diese Krabbenart wurde nach ihrem Entdecker benannt und weist eine Färbung auf, die es so kein zweites Mal unter den Artgenossen gibt. Laufbeine und Panzer sind grell scharlachrot, während die Greifarme auffällig orange sind."
                                            },
                                            {
                                                "example_id": "da534b98-22da-4d91-b59f-d24403a1a63b",
                                                "sense_id": "145a2488-f4ce-3f5c-b014-942d42a52c8d",
                                                "text": "„Einmal stieg ich ab und hob ein paar scharlachrote Ahornblätter auf, die mir am Weg aufgefallen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "239f9076-27a5-4ba0-a9d0-454dc9bdfe22",
                        "source_entry_id": "7ab28a8a-c5f7-3e0b-a017-df25ce31bed8",
