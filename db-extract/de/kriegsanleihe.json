                ],
                "senses": [
                    {
                        "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                        "entry_id": "445d71c7-2890-3d97-aa97-87d83bf863ee",
                        "glosses": [
                            "Wertpapier, verausgabt vom Staat zwecks Finanzierung der Kriegsführung"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "d70b6679-2eac-40bb-bd68-040960d5a8bb",
                                "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                                "text": "„Hätte er es sich damals besser überlegt, er hätte ja nicht alle Ersparnisse in Kriegsanleihe festlegen müssen.“"
                            },
                            {
                                "example_id": "4126d476-5f63-4cd0-96f0-2490c005c5db",
                                "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                                "text": "„Die Anfang August vom Reichstag genehmigten Kriegskredite und die erste Kriegsanleihe vom September 1914 waren gegen Ende des Jahres so gut wie aufgebraucht.“"
                            },
                            {
                                "example_id": "b38e0faf-147f-42bd-a6d3-6fcaeb08a56a",
                                "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                                "text": "[Erster Weltkrieg:] „Die kaiserliche Regierung hatte den Krieg nicht durch Steuern finanziert, sondern durch Kriegsanleihen, d. h. Kredite von Banken, Firmen und Privatpersonen.“"
                            },
                            {
                                "example_id": "6831e9d3-649e-484d-87f5-ef6e5154289b",
                                "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                                "text": "„Als ein Regierungsbeamter 1916 gefragt wurde, wer denn die Kriegsanleihen zurückzahlen solle, antwortete er: »Unsere besiegten Gegner«.“"
                            },
                            {
                                "example_id": "ad8654fd-7fbe-413c-af8f-2a87992c4ffd",
                                "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                                "text": "„Seit Beginn des Ersten Weltkriegs war durch die Aufnahme von Kriegsanleihen sowie die Ankurbelung der Notenpresse die zirkulierende Geldmenge massiv aufgebläht worden.“"
                            },
                            {
                                "example_id": "864d2787-b8f6-4447-8a46-f10a6936d857",
                                "sense_id": "c35033fd-f3e4-3d47-aa1c-b2914ec6370a",
                                "text": "„Die Nordstaaten setzten zwar ebenfalls auf Kriegsanleihen, behielten aber die Kontrolle über die Geldmenge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
