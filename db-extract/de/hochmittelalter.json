                ],
                "senses": [
                    {
                        "sense_id": "0ba2b3dd-2f93-31b7-83a9-2f45f52ab050",
                        "entry_id": "a5082a3c-c3d2-33ce-b0d4-a7c88a86cae8",
                        "glosses": [
                            "Zeitabschnitt von circa 1050 bis 1250 nach Christus in Europa und dem Mittelmeerraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1448a0f-4071-4926-b08b-8066c4fcda54",
                                "sense_id": "0ba2b3dd-2f93-31b7-83a9-2f45f52ab050",
                                "text": "„Das Rom der Päpste, Sehnsucht und Ziel unzähliger Pilger, war unter den großen Päpsten des Hochmittelalters nicht mehr nur religiöser Mittelpunkt der abendländischen Christenheit, sondern auch geistlich-weltliche Metropole.“"
                            },
                            {
                                "example_id": "5527c8f0-b4ef-4b6c-9e55-301cdf27f65a",
                                "sense_id": "0ba2b3dd-2f93-31b7-83a9-2f45f52ab050",
                                "text": "„Mit der im Hochmittelalter einsetzenden wissenschaftlichen Durchdringung des römischen Rechts wurden die einzelnen Sammlungen neu aufgeteilt.“"
                            },
                            {
                                "example_id": "9e37e430-a8c5-4bfc-a195-7f524a796375",
                                "sense_id": "0ba2b3dd-2f93-31b7-83a9-2f45f52ab050",
                                "text": "„Das Buch bleibt bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn.“"
                            },
                            {
                                "example_id": "acacc752-53aa-4229-a980-f14aa54e5d5e",
                                "sense_id": "0ba2b3dd-2f93-31b7-83a9-2f45f52ab050",
                                "text": "„Seit dem Hochmittelalter trugen die Ritter vernietete metallische Ringgeflechte als Schutz auf einem gepolsterten Gewand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
