                        "sense_id": "dec9b8a2-dad5-3f5a-b2cb-05307704bf3a",
                        "entry_id": "8b040494-2a5c-35d6-88e8-62b898ac27a5",
                        "glosses": [
                            "To release from the hand; to let go."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ef6531-3892-48c9-8ae9-bd5a92724b18",
                                "sense_id": "dec9b8a2-dad5-3f5a-b2cb-05307704bf3a",
                                "text": "He holds him with his skinny hand,\n\"There was a ship,\" quoth he.\n\"Hold off! unhand me, grey-beard loon!\"\nEftsoons his hand dropt he."
                            },
                            {
                                "example_id": "f5930790-8554-4d09-9aea-0cfb12f6e1eb",
                                "sense_id": "dec9b8a2-dad5-3f5a-b2cb-05307704bf3a",
                                "text": "“Unhand' the lady!” said Vernon, in a severe tone, as, at the same time, he draw from his pocket a pistol. “Unhand her!” and he approached the lawyer"
                            },
                            {
                                "example_id": "52bec077-cfa1-493b-9812-2cce8f4b7907",
                                "sense_id": "dec9b8a2-dad5-3f5a-b2cb-05307704bf3a",
                                "text": "As he dried the last toe, she said, “Thank you. You may now unhand my feet”"
                            }
                        ]
                    }
