                    },
                    {
                        "translation_id": "f3328591-41d0-4906-8a79-9d24b0d19069",
                        "source_entry_id": "360e8bb1-a0bb-37fc-80c0-647faec6f3f7",
                        "source_sense_id": "985b7eb7-359d-308b-a155-16fe430bcbcd",
                        "target_lang_word": "adversative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adversative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14ff1a8a-5048-3872-b3c5-db1add16aad7",
                                        "entry_id": "605e23ac-fc2e-3c7d-a0b7-fcc5bf1371ab",
                                        "glosses": [
                                            "Expressing opposition or difference."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65305328-84e9-45a1-a0db-6b6aff58a9a6",
                                                "sense_id": "14ff1a8a-5048-3872-b3c5-db1add16aad7",
                                                "text": "In Matthew's Q-source, this short sentence may have been introduced by the strong adversative conjunction, \"but\" (alla)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4ca8c3-ed72-3e10-8cdf-313111ed31b9",
                                        "entry_id": "605e23ac-fc2e-3c7d-a0b7-fcc5bf1371ab",
                                        "glosses": [
                                            "Expressing adverse effect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7df62b9-b003-4d5c-abbd-c6fa1f4f6f7b",
                                                "sense_id": "bc4ca8c3-ed72-3e10-8cdf-313111ed31b9",
                                                "text": "In an adversative causative, the \"causer\" has only a nominal status and is, in actuality, a victim of the situation ..."
                                            },
                                            {
                                                "example_id": "9f2e4502-c954-412b-8082-ab4677d28f95",
                                                "sense_id": "bc4ca8c3-ed72-3e10-8cdf-313111ed31b9",
                                                "text": "This type of 'get-passive' typically bears adversative connotation, i.e. it is not used to express passives if the patient is not somewhat negatively affected by the event."
                                            },
                                            {
                                                "example_id": "414022da-68b2-4d7d-9410-cf5ac3d9a46c",
                                                "sense_id": "bc4ca8c3-ed72-3e10-8cdf-313111ed31b9",
                                                "text": "The adversative passive sentence expresses that the subject of the sentence is affected, usually adversely, by what is expressed in the rest of the sentence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adversative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57af6941-7781-3a64-a763-ed92b17da345",
                                        "entry_id": "2e5ad32a-9ef4-330e-9649-3127258c8bb3",
                                        "glosses": [
                                            "Something, particularly a clause or conjunction, which is adversative."
                                        ],
