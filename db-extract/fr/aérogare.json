                ],
                "senses": [
                    {
                        "sense_id": "70ad34f8-3b05-3295-a5f7-a6742450b252",
                        "entry_id": "094b8386-0013-37c8-884b-74e07b20dc91",
                        "glosses": [
                            "Aéroport."
                        ],
                        "tags": [],
                        "note": "semble vieilli dans cette acception",
                        "examples": [
                            {
                                "example_id": "9a96d871-a2e8-4956-b4c1-02c3db32edb2",
                                "sense_id": "70ad34f8-3b05-3295-a5f7-a6742450b252",
                                "text": "Après une présentation rapide de l’aérogare nᵒ 1 de Roissy-en-France, avec son corps central et ses sept satellites, l’auteur décrit successivement les divers équipements réalisés dans cet ensemble."
                            },
                            {
                                "example_id": "a3954998-b994-4de8-b2e8-00ee2ed8e97a",
                                "sense_id": "70ad34f8-3b05-3295-a5f7-a6742450b252",
                                "text": "Il y a d’abord la ville mal éclairée, ensuite l'autoroute sur laquelle on glisse dans une lumière irréelle et, enfin, barrant le chemin, éblouissante comme un feu d’artifice, tiède : l’aérogare."
                            }
                        ]
                    },
                    {
                        "sense_id": "928e1e93-73fc-3e20-97da-90747e9ca9ed",
                        "entry_id": "094b8386-0013-37c8-884b-74e07b20dc91",
                        "glosses": [
                            "Ensemble des bâtiments destinés aux voyageurs et aux marchandises empruntant la voie aérienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14681c16-fa23-4229-ac86-7a4b0db73fff",
                                "sense_id": "928e1e93-73fc-3e20-97da-90747e9ca9ed",
                                "text": "Une longue baraque, exhaussée par un soubassement de moellons bétonnés, s’élevait sur un aérodrome, très à l’écart de l’aérogare, à une centaine de mètres d’une piste d’envol et de la tour de contrôle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9e539cb-303f-4476-923e-f0a1b2f7b6bc",
                        "source_entry_id": "094b8386-0013-37c8-884b-74e07b20dc91",
