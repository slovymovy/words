                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89646b7a-2919-30c0-b0c6-04d9cef2517a",
                                        "entry_id": "84cb6d79-5e02-3131-a4a6-9aa6482d8542",
                                        "glosses": [
                                            "A harbour for small boats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634394e3-b54e-4238-b405-034909b543f6",
                                                "sense_id": "89646b7a-2919-30c0-b0c6-04d9cef2517a",
                                                "text": "It's a peaceful marina with not too many boats and yachts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c4f1915-337b-40c1-8091-0779c52480a4",
                        "source_entry_id": "fbdf8378-4c3a-31ba-9522-753b9887647f",
                        "source_sense_id": "07e03cd5-793f-3898-b685-0d9abafd77fa",
                        "target_lang_word": "Marine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                        "entry_id": "a25450cb-7595-3426-822d-385095f2586c",
                                        "glosses": [
                                            "die zur Seekriegsführung bestimmten Streitkräfte eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "757bca54-c1ef-4c52-8363-696eb962b738",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "Die US-amerikanische Marine (US-Navy) gehört zu den stärksten der Welt."
                                            },
                                            {
                                                "example_id": "b59ef2c8-1929-49b1-920f-c4bac2a37a8e",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„In einer Sammlung mit Augenzeugenberichten fand ich ein Dokument aus dem Jahr 1829, in dem es um ein amerikanisches Sklavenschiff ging, das von der britischen Marine im südlichen Atlantik aufgebracht worden war.“"
                                            },
                                            {
                                                "example_id": "205c8a84-5ac6-42d6-9c6b-f2ff8634e851",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„Der Deutsche und der Österreichische Flotten-Verein beklagten zu jener Zeit das Ende der beiden Kaiserlichen Marinen.“"
                                            },
                                            {
                                                "example_id": "a4c4fe51-303e-4bf5-b428-324d8178e644",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„Dort hatte sich ein Expeditionskorps der Marine eingeschifft.“"
                                            },
                                            {
                                                "example_id": "4e0c06cc-bcb0-4dbc-a459-e4ca9811bda9",
                                                "sense_id": "9935f3bd-1886-3e75-af54-e8f488fea262",
                                                "text": "„Unter dem flottenbegeisterten Kaiser Wilhelm II. (1888-1918) gewann die Marine an Bedeutung, und eine große maritime Rüstungsindustrie entstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e574625c-d65d-346d-b894-eaf45f9cccc6",
                                        "entry_id": "a25450cb-7595-3426-822d-385095f2586c",
                                        "glosses": [
                                            "Handelsmarine, das zivile Seewesen eines Staates"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5aacb5a-1faf-4afd-8128-1b6200a9eaf9",
                                                "sense_id": "e574625c-d65d-346d-b894-eaf45f9cccc6",
                                                "text": "„Angestellte der Marine, die zu / von einer Schwimmbohrinsel reisen, welche selbständig manövrierbar ist, müssen in Besitz eines Schreibens sein, der vom Arbeitgeber oder dem Schwimmplattform-Inhaber ausgestellt wurde.“"
                                            },
                                            {
                                                "example_id": "2ba078dc-aeb6-4f79-922f-411546949195",
                                                "sense_id": "e574625c-d65d-346d-b894-eaf45f9cccc6",
                                                "text": "„Der Fluß bildet da eine kleine Bucht, in welcher die Marine des Stammes, fünf Palmrinde-Kanus, an Strängen von Wattap ruhig vor Anker lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
