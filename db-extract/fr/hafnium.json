                                        "entry_id": "88479009-e90e-3119-9fc9-3615e7ede6d9",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 72, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00892031-5a82-4fae-b57c-88df4d3b5bb9",
                                                "sense_id": "77e2243b-92f5-3d70-ad9a-cfe6ac5db21f",
                                                "text": "Hafnium ist ein silbergrau glänzendes, stark dehnbares, sehr korrosionsbeständiges Schwermetall."
