                ],
                "senses": [
                    {
                        "sense_id": "e6b1ede0-4ecc-3b56-a629-324d1cae4432",
                        "entry_id": "7bb49af2-7ab9-30d6-83c0-70bfb62fcbb7",
                        "glosses": [
                            "lange andauernde Wirkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf206d6-c69a-41cb-b5d2-252836cd87dc",
                                "sense_id": "e6b1ede0-4ecc-3b56-a629-324d1cae4432",
                                "text": "„Ein zweiter innenpolitisch kluger Zug mit großer Langzeitwirkung gelang Oba Ewuare nach der Tradition durch die Schaffung des Titels des Edaiken, des potenziellen Thronfolgers, und die Ernennung seines ältesten Sohnes namens Kuoboyuwa in diese Position.“"
                            },
                            {
                                "example_id": "4cf7a9b8-6bd3-4ff1-88fc-6eb5e447ae4b",
                                "sense_id": "e6b1ede0-4ecc-3b56-a629-324d1cae4432",
                                "text": "„Bei Feststellung eines schwerwiegenden Verstoßes oder eines Verstoßes mit Langzeitwirkung untersagt die Kontrollbehörde oder Kontrollstelle dem betreffenden Unternehmer die Vermarktung von Erzeugnissen mit einem Bezug auf die ökologische/biologische Produktion in der Kennzeichnung und Werbung für eine mit der zuständigen Behörde des betreffenden Mitgliedstaats vereinbarte Dauer.“"
                            },
                            {
                                "example_id": "18331d82-371f-40bf-b04e-110867e4ac40",
                                "sense_id": "e6b1ede0-4ecc-3b56-a629-324d1cae4432",
                                "text": "„In der Langzeitwirkung ist das Volk der Uiguren durch diese ebenso brutale wie systematische Strategie in seiner Existenz gefährdet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
