                "senses": [
                    {
                        "sense_id": "a0999a1a-0cc4-3bb0-bd0a-46c3b8e886b6",
                        "entry_id": "6a399e87-6823-353f-8fac-157b6c011d16",
                        "glosses": [
                            "A wizard in the Arthurian legend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c2118c-167f-4e2d-ab0d-94f7da6b31fc",
                                "sense_id": "a0999a1a-0cc4-3bb0-bd0a-46c3b8e886b6",
                                "text": "I NEXT paſſed into the choir; a ſcene of transformation indeed! I had been accuſtomed to contemplate here a far different order of things. Our profeſſional Merlins have waved their wands to ſome purpoſe; and all view, as their familiars invited me to believe, was to be given up to the momentary glance at an Eidophuſicon ſhew of the Reſurrection filling the Eaſt window in that ſpot late our Lady’s chapel, now the termination of the choir."
                            },
                            {
                                "example_id": "11302078-d983-4fc5-9021-8b3c1f247bd8",
                                "sense_id": "a0999a1a-0cc4-3bb0-bd0a-46c3b8e886b6",
                                "text": "It is a game of chemistry and confidence, where players of gold often make teams of lead, and vice versa. Coaches are like Merlins madly mixing metals, searching for “the right combination,” even if it contradicts common sense."
                            },
                            {
                                "example_id": "46f83e7f-b9da-4100-818c-4b96da31d5fb",
                                "sense_id": "a0999a1a-0cc4-3bb0-bd0a-46c3b8e886b6",
                                "text": "Music, art, entertainment, medicine, and science are being changed before our very eyes by technological Merlins waving silicon wands."
                            }
                        ]
                    },
