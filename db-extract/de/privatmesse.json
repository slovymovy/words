                ],
                "senses": [
                    {
                        "sense_id": "0ba8062e-c547-34b1-9cea-abd0404c0dab",
                        "entry_id": "8072f867-1b8b-3e7f-a9c9-a291e404a8c4",
                        "glosses": [
                            "eine Heilige Messe, die nicht Gemeinde- oder Konventsmesse ist; dem Zelebranten dient normalerweise ein Ministrant; die Privatmesse wird ohne öffentliche Ankündigung gefeiert"
                        ],
                        "tags": [
                            "Katholizismus",
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "ee4decd6-8e46-4be8-a474-f3d93a8c6daf",
                                "sense_id": "0ba8062e-c547-34b1-9cea-abd0404c0dab",
                                "text": "„Seit der Promulgation des Motu proprios ›Summorum Pontificum‹ im September 2007 ist es jedem römisch-katholischen Priester wieder gestattet, die Privatmesse nach dem Missale Romanum des hl. Pius V. in der Ausgabe des Jahres 1962 zu feiern.“"
                            },
                            {
                                "example_id": "5a4f31ea-1889-449b-9593-cd686073cf5d",
                                "sense_id": "0ba8062e-c547-34b1-9cea-abd0404c0dab",
                                "text": "Bestimme Formen der Privatmesse wurden von Martin Luther kritisiert."
                            },
                            {
                                "example_id": "238bf3fe-10db-46c0-8274-ff9a187a9284",
                                "sense_id": "0ba8062e-c547-34b1-9cea-abd0404c0dab",
                                "text": "In den Ostkirchen sind Privatmessen nicht üblich."
                            },
                            {
                                "example_id": "3d12d44b-5858-4e25-bb7c-bbe3e1e9e9b5",
                                "sense_id": "0ba8062e-c547-34b1-9cea-abd0404c0dab",
                                "text": "„Goldt wies darauf hin, dass die Privatmesse Samstag um acht Uhr nicht durch Glockengeläut angekündigt und nicht in den Gottesdienstanzeiger aufgenommen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
