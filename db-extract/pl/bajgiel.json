                            },
                            {
                                "target_word": "bagel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                        "entry_id": "80662de8-e72c-3b1b-aa3c-e59343c4a3fa",
                                        "glosses": [
                                            "Alternative form of bagle."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cecac24-076e-4e11-a728-10ad798841b3",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "“He’s so adorable, Aaron. Part beagle, part basset hound.” “A bagel. Very appropriate.”"
                                            },
                                            {
                                                "example_id": "574c0ae7-c5f8-45a4-8abf-9668756e235c",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "In October, Allan and Rebecca began to care for Marty’s dog Phil more often and adopted the “bagel” (basset and beagle mix breed) when the time came."
                                            },
                                            {
                                                "example_id": "f4115e4a-9fe6-4328-8c3d-aed7e84b1f21",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "The Bagel isn’t necessarily a popular dog, but they seem to appear often enough to be worth mentioning."
                                            },
                                            {
                                                "example_id": "c225a867-a0f7-44b9-8c85-2c13a96c0e3e",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "The Bagel is a cross between the Beagle and the Basset Hound. Though not as popular as some of the more well-established mixes, the short-coated Bagel has the loving personality one would expect from two Hounds, plus the potential for some stubbornness."
                                            },
                                            {
                                                "example_id": "7772217c-1b2c-4454-9501-1b7b01b70ede",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "Linus was half basset and half beagle hound, thus a bagel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18c19f61-0a0c-4a2d-88a7-2965c7e68b5f",
                        "source_entry_id": "b5d78afb-e729-34e1-9f58-56e8b99057ee",
                        "source_sense_id": "4250a82a-8bdc-3e77-9088-efb0ac23eb6a",
                        "target_lang_word": "Bagel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bagel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                        "entry_id": "cf95e48d-306c-3375-822a-46f084b4a238",
                                        "glosses": [
                                            "ringförmiges brötchenähnliches Gebäck aus ungesüßtem Hefeteig, das vor dem Backen in siedendes Wasser gegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2326a25-0ddb-42fc-9160-f3015f86c738",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Und zumindest in den Städten sind ‚Bagels‘, kleine Ringbrote, deren Teig zunächst gekocht und dann gebacken wird, oder ‚Pastrami‘, ein saftiger Fleischkäse, feste Begriffe.“"
                                            },
                                            {
                                                "example_id": "118bab9a-c1ac-4981-8da2-350c8e5c4321",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Selbst die Bagel, sonst goldbraune Unterlage für ‚creamcheese und Lox‘, der jüdischen Frühstücksspezialität, waren an jenem Tage grün.“"
                                            },
                                            {
                                                "example_id": "23bc1136-6caf-49c6-871a-ec59c137fbad",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„La belle ville Montreal: Es vereint die Vorzüge französischer Lebensart mit den besten Eigenschaften Nordamerikas. Denn selbst die Bagels sind in Montreal noch etwas besser als in New York.“"
                                            },
                                            {
                                                "example_id": "c6cabdec-9724-469b-b361-e13592f25bed",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Aus Mehl, Malz, Salz, Hefe und Wasser entsteht nach wie vor der Teig, der – gerollt, geschnitten und zum Kringel geformt – den echten Bagel macht.“"
                                            },
                                            {
                                                "example_id": "f1dbd894-0a0e-4ba1-a77f-ad761e796b37",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Sharon summt, als sie einen Bagel mit Frischkäse bestreicht, sonst hört man kein Geräusch.“"
                                            },
                                            {
                                                "example_id": "4b6252d9-7061-40c8-8e43-8ac6eb9f71ab",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Während Brötchen meist spätestens eineinhalb Stunden nach dem Anrühren des Teiges in den Ofen gelangen, bleibt der Bagel bis zu 24 Stunden im sieben Grad kühlen Reiferaum. […] Weitere Besonderheit: Unmittelbar vor dem Backen wird der Bagel kurz gekocht, um die Hefe zu aktivieren. […] Um die Ursprünge des Bagels ranken sich Legenden. […] Fest steht, dass der Bagel der jüdischen Küche entstammt, der er große Vorteile bot. Am Schabbat konnte der Bagel in Ruhe reifen.“"
                                            },
                                            {
                                                "example_id": "cf2e7482-314c-43d5-b0fd-3ea92580dad0",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Jack [ein Hund] hatte Krumen von Bageln geknabbert, stellte sich später heraus und dabei die Münzen mit gefuttert.“"
                                            },
                                            {
                                                "example_id": "af3af9c5-d142-4aa8-aa39-6cd350bbca17",
                                                "sense_id": "ea2670f4-e7f4-399f-9e43-48db58c02c8b",
                                                "text": "„Und auch hier stehen die Menschen Schlange, um Waldviertler Graumohn-Flösserln, Brioche, Bageln, Pheinspitz oder Waldstauden-Roggenbrot mit Sommerapfel zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
