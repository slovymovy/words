                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf4fd8f-cd2c-4a3d-86a0-80274ae18286",
                                "sense_id": "588c1a84-3790-3950-bc7d-c3dc9b30b098",
                                "text": "Парафинировать бочонок для масла."
                            },
                            {
                                "example_id": "89a42bdf-d120-44e6-a14c-8a5d40be7be8",
                                "sense_id": "588c1a84-3790-3950-bc7d-c3dc9b30b098",
                                "text": "И сейчас дамы красят лица, покрывают их эмалью, наращивают ресницы, вшивают брови, парафинируют носы, красят глаза и волосы, носят парики, одевают гуттаперчевые бюсты."
                            }
                        ]
                    }
