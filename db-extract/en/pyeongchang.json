                    },
                    {
                        "sense_id": "a2de8178-306e-3505-88d5-2112ebc19819",
                        "entry_id": "f3b16aeb-47af-3790-9008-eb8e59bcec53",
                        "glosses": [
                            "A city, the county seat of Pyeongchang county, South Korea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a64ee2-f3a8-4cc3-9851-1c20295ae895",
                                "sense_id": "a2de8178-306e-3505-88d5-2112ebc19819",
                                "text": "The town of Pyeongchang eventually won the rights to host the Games — a $20 billion boon for the economy, according to one research institute’s forecast."
                            },
                            {
                                "example_id": "edd5306b-0909-4650-a594-789d528766a9",
                                "sense_id": "a2de8178-306e-3505-88d5-2112ebc19819",
                                "text": "Pyeongchang sits nearly half a mile above sea level in the northeastern corner of South Korea, not too far from the border with the North. It is one of the coldest parts of the country — wind chill in February is often in single digits (Fahrenheit) — and notorious for a powerful, biting wind that gathers force as it barrels down out of Siberia and the Manchurian Plain and then across the jagged granite peaks of North Korea."
                            },
                            {
                                "example_id": "50166bfd-7014-444c-a2aa-522ea307407b",
                                "sense_id": "a2de8178-306e-3505-88d5-2112ebc19819",
                                "text": "The 2018 Winter Olympic Games in Pyeongchang in South Korea have come to an end with a closing ceremony that ran for about two hours."
                            },
                            {
                                "example_id": "c3178954-e671-4cc4-96a2-0bca5dc8c346",
                                "sense_id": "a2de8178-306e-3505-88d5-2112ebc19819",
                                "text": "In the year after the Olympics, Pyeongchang did experience a 22 percent spike in visitors, according to South Korean news organizations. But foreigners accounted for less than 0.1 percent of the 6.1 million people who visited paid tourist attractions in the region in 2019, a Pyeongchang county government report stated."
                            }
                        ]
                    }
