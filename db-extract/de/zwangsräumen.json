                                        "examples": [
                                            {
                                                "example_id": "77352dfd-0212-4c53-8436-b8991e0e7f53",
                                                "sense_id": "eae25109-c8bb-328e-b3b2-d15eb173b2ef",
                                                "text": "The man started a fight and was ejected from the bar."
                                            },
                                            {
                                                "example_id": "09d474bb-4599-48f7-a92a-096b7d269283",
                                                "sense_id": "eae25109-c8bb-328e-b3b2-d15eb173b2ef",
                                                "text": "Andrew was ejected from his apartment for not paying the rent."
                                            },
                                            {
                                                "example_id": "3f7321e8-311a-429c-8c12-51dd98277e3d",
                                                "sense_id": "eae25109-c8bb-328e-b3b2-d15eb173b2ef",
                                                "text": "Four pairs of women's doubles badminton players, including the Chinese top seeds, have been ejected from the Olympic tournament for trying to throw matches in an effort to secure a more favourable quarter-final draw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab0bed1-f1f8-3caf-98b0-927ccba4c957",
                                        "entry_id": "b3dff8d7-57a4-3f41-8a66-fc42180a0bce",
                                        "glosses": [
                                            "To throw out or remove forcefully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e2f831-a5e2-4dca-8255-3304d57f2643",
                                                "sense_id": "2ab0bed1-f1f8-3caf-98b0-927ccba4c957",
                                                "text": "In other news, a Montreal man was ejected from his car when he was involved in an accident."
                                            },
                                            {
                                                "example_id": "056a8d14-df61-446b-9610-58dc97b7df64",
                                                "sense_id": "2ab0bed1-f1f8-3caf-98b0-927ccba4c957",
                                                "text": "The lights of Luluabourg disappeared, and we were in the blackness of the African night, which was continuously pierced by the showers of red sparks ejected skywards and red hot ashes deposited on the track as the fireman rocked his fire."
                                            },
                                            {
                                                "example_id": "d52e68dc-099a-4a57-8a52-a05642018494",
                                                "sense_id": "2ab0bed1-f1f8-3caf-98b0-927ccba4c957",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb86eae-ced2-359d-acc2-2a138820a3f4",
                                        "entry_id": "b3dff8d7-57a4-3f41-8a66-fc42180a0bce",
                                        "glosses": [
                                            "To compel (a sports player) to leave the field because of inappropriate behaviour."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21dd4eef-6a48-3425-8afa-db667601c754",
                                        "entry_id": "b3dff8d7-57a4-3f41-8a66-fc42180a0bce",
                                        "glosses": [
                                            "To forcefully project oneself or another occupant from an aircraft (or, rarely, another type of vehicle), typically using an ejection seat or escape capsule."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8232b130-65b3-4306-a0a9-7a39c295c6f4",
                                                "sense_id": "21dd4eef-6a48-3425-8afa-db667601c754",
                                                "text": "The pilot lost control of the plane and had to eject."
                                            },
                                            {
                                                "example_id": "0885cd23-4c4a-4841-8bcd-4582ec18571d",
                                                "sense_id": "21dd4eef-6a48-3425-8afa-db667601c754",
                                                "text": "As the crippled jet spiralled down, the pilot pulled the escape handle, ejecting first his rear-seater, then himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c1fd86-78a9-33e4-a858-283335f522c1",
                                        "entry_id": "b3dff8d7-57a4-3f41-8a66-fc42180a0bce",
