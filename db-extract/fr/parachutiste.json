                "senses": [
                    {
                        "sense_id": "38611d1f-a722-39fc-8aea-6b017b4e9942",
                        "entry_id": "2cf2325c-8661-3d07-b668-9283965a173c",
                        "glosses": [
                            "Personne qui pratique le saut en parachute."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2707b3fc-b5a5-31f4-83b7-e43cf0dc1928",
                        "entry_id": "2cf2325c-8661-3d07-b668-9283965a173c",
                        "glosses": [
                            "Soldat appartenant à une unité aéroportée entraînée à être larguée sur un théâtre d'opérations pour y mener notamment des coups de main, des actions rapides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed772ec-92d4-41b4-b162-2f71ee5f7318",
                                "sense_id": "2707b3fc-b5a5-31f4-83b7-e43cf0dc1928",
                                "text": "Chacun ici connaît le martyre d’Annick Castel, violée par un parachutiste et qui, croyant être enceinte, ne songeait plus qu’à mourir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d599a98-0f24-4211-985a-bc65db5a73c6",
                        "source_entry_id": "2cf2325c-8661-3d07-b668-9283965a173c",
                        "target_lang_word": "Fallschirmspringer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fallschirmspringer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                        "entry_id": "2da32624-d635-3a69-80ea-739b187708d9",
                                        "glosses": [
                                            "eine Person, die unter Benutzung eines Fallschirms aus einem Luftfahrzeug abspringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dabb71ee-2175-4b93-8199-8ab1ecac62fe",
                                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                                "text": "„‚Man hat einfach keine Zeit, Angst zu haben‘, sagte mir ein Fallschirmspringer.“"
                                            },
                                            {
                                                "example_id": "2c08408e-fc66-486a-b231-3c0d9eeeea0c",
                                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                                "text": "„Ende des Monats waren laut diesen Quellen 3000 französische Fallschirmspringer im Lande stationiert.“"
                                            },
                                            {
                                                "example_id": "e35e0025-a621-4a78-b398-d6c39ef21ba3",
                                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                                "text": "„Danach wollte Volker Fallschirmspringer werden.“"
                                            },
                                            {
                                                "example_id": "cd518342-b760-4550-9197-0f4748fbaab7",
                                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                                "text": "„Es gab etwa dreißig solche Partisanengruppen; mehr als die Hälfte war von sowjetischen Fallschirmspringern aufgebaut worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa74c1e7-dec8-47cc-885c-4089b0bc4c14",
                        "source_entry_id": "2cf2325c-8661-3d07-b668-9283965a173c",
                        "target_lang_word": "Fallschirmspringerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fallschirmspringerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                        "entry_id": "76ab830e-f39f-318b-8e8a-a6369a7b5f8d",
                                        "glosses": [
                                            "weibliche Person, die unter Benutzung eines Fallschirms aus einem Flugzeug abspringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77feb7b6-0ae9-4de4-a5b9-70a81cfc1b6c",
                                                "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                                "text": "Die Fallschirmspringerinnen machten sich für den Absprung bereit."
                                            },
                                            {
                                                "example_id": "84e34dfb-0fa9-4d39-8c2d-7e7905c95fa3",
                                                "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                                "text": "„In Krems-Gneixendorf ist Sonntagvormittag eine Fallschirmspringerin abgestürzt.“"
                                            },
                                            {
                                                "example_id": "a77d72da-cf13-4eb0-90ea-8fa7ef757417",
                                                "sense_id": "4f6c3ae2-f6bb-3f76-8132-1daf16f3605c",
                                                "text": "„Eine deutsche Fallschirmspringerin ist beim Versuch gestorben, den Rekord für den größten Doppel-Formationssprung der Geschichte zu brechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaed1afc-2f0c-4841-999e-9c573af1599d",
                        "source_entry_id": "2cf2325c-8661-3d07-b668-9283965a173c",
                        "target_lang_word": "parachuter",
