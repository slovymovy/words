                                        "entry_id": "8706eef5-d6ef-32be-825a-ded390fadb6f",
                                        "glosses": [
                                            "Ville de Russie située au Nord-Ouest du pays sur le delta de la Néva au fond du golfe de Finlande dans la mer Baltique."
                                        ],
                                        "tags": [
