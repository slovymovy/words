                ],
                "senses": [
                    {
                        "sense_id": "3920a105-82c3-389a-9dfc-2351b38ff290",
                        "entry_id": "9fd7662d-e767-34c0-ad80-be66ecf15deb",
                        "glosses": [
                            "eine bestimmte Apfelsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cb2489-35d5-4ce9-8acb-0a2a992b4c82",
                                "sense_id": "3920a105-82c3-389a-9dfc-2351b38ff290",
                                "text": "„Die können aus einer erfreulichen Obstvielfalt wählen und beispielsweise Apfelsorten wie den Breitarsch, die möglicherweise beste Kirschsorte von allen, die Prinzesskirsche, Birnen wie Gute Luise oder Zitronenbirne und noch zahllose andere Obstarten und -sorten in den Garten holen.“"
                            },
                            {
                                "example_id": "14e5d614-fcd9-47c6-936b-424f42522dc2",
                                "sense_id": "3920a105-82c3-389a-9dfc-2351b38ff290",
                                "text": "„Auch die Bezeichnung der einheimischen Bevölkerung ›Breitauge‹ oder gar ›Breitarsch‹, meint den gleichen Apfel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29305bef-14ea-3ba0-aa59-d0cc997af61d",
                        "entry_id": "9fd7662d-e767-34c0-ad80-be66ecf15deb",
                        "glosses": [
                            "Lebewesen mit breiten Hüften und großem Po"
                        ],
                        "tags": [
                            "casual",
                            "colloquial",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "03c30fa5-045d-4028-bc09-bd1de515e9b4",
                                "sense_id": "29305bef-14ea-3ba0-aa59-d0cc997af61d",
                                "text": "„Hey, Breitarsch! Das nächste Mal gehst du ins Gebüsch!“"
                            },
                            {
                                "example_id": "2a0bc680-7a66-40c0-b08b-2c594163e217",
                                "sense_id": "29305bef-14ea-3ba0-aa59-d0cc997af61d",
                                "text": "„Wenn Wände Ohren hätten, dann du schon erst recht, Breitarsch.“"
                            },
                            {
                                "example_id": "bd8f071e-60b5-4c25-98ea-30653aacb5fa",
                                "sense_id": "29305bef-14ea-3ba0-aa59-d0cc997af61d",
                                "text": "„Sie wollte vermeiden, dass Joe, den sie hasste, ihr wieder hinterherrief, dass er sogar einen Sattel für Ihren Breitarsch besorgen könne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
