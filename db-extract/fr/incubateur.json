                    {
                        "sense_id": "77b8561c-d99c-3711-a564-7806db76f9ae",
                        "entry_id": "505cb409-ea51-3246-a79f-102fbcd17330",
                        "glosses": [
                            "Qui opère l’incubation artificielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0011c91-b17a-4682-94c8-3d76cb8a5eba",
                                "sense_id": "77b8561c-d99c-3711-a564-7806db76f9ae",
                                "text": "Coste a imaginé un appareil incubateur pour les œufs de poissons."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ef744cd-08f0-3c13-aada-146cb87223d3",
                        "entry_id": "505cb409-ea51-3246-a79f-102fbcd17330",
                        "glosses": [
                            "Favorable à l’éclosion."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ed2a0c03-3d5a-4e5e-bd0f-abd7928a8053",
                                "sense_id": "2ef744cd-08f0-3c13-aada-146cb87223d3",
                                "text": "On ne s’épanchera pas ici à redire que cette région est incubatrice de talents."
                            },
                            {
                                "example_id": "c8c3379d-1db8-499b-9fed-2feb1ba63291",
                                "sense_id": "2ef744cd-08f0-3c13-aada-146cb87223d3",
                                "text": "Tant que Xavier Niel joue les VRP de sa Station F, l’incubateur de start-up inauguré en grande pompe, le 29 juin, par le président Emmanuel Macron, tout va bien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c496fa7f-205c-484d-aecd-f9f4e3d2a1c7",
