{
    "word_family": [
        "doorzicht",
        "doorzien",
        "doorzichtigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a0053733-de94-31cc-ad89-2e45c311041d",
                    "sense_definition": "waar licht zo ongehinderd doorheen gaat dat men er duidelijk doorheen kan kijken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visuele_eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water in het zwembad is erg <w>doorzichtig</w> en schoon.",
                            "target_lang_translations": {
                                "en": "The water in the swimming pool is very <w>transparent</w> and clean."
                            }
                        },
                        {
                            "text": "Glas is een <w>doorzichtig</w> materiaal dat we voor ramen gebruiken.",
                            "target_lang_translations": {
                                "en": "Glass is a <w>transparent</w> material that we use for windows."
                            }
                        }
                    ],
                    "synonyms": [
                        "transparant",
                        "helder"
                    ],
                    "antonyms": [
                        "ondoorzichtig",
                        "ontransparant"
                    ],
                    "common_phrases": [
                        "doorzichtig glas",
                        "volledig doorzichtig"
                    ],
                    "target_lang_definitions": {
                        "en": "allowing light to pass through so that objects behind can be distinctly seen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "transparent",
                                "target_lang_sense_clarification": "allowing light to pass through clearly"
                            },
                            {
                                "target_lang_word": "see-through",
                                "target_lang_sense_clarification": "informal term for transparent materials"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "unclouded and easy to see through"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2192d86e-7b3e-3cb4-b7e2-a2e169c97139",
                    "sense_definition": "gemakkelijk te begrijpen of te doorzien omdat het niet ingewikkeld of subtiel is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begrijpelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn leugen was zo <w>doorzichtig</w> dat niemand hem geloofde.",
                            "target_lang_translations": {
                                "en": "His lie was so <w>transparent</w> that nobody believed him."
                            }
                        },
                        {
                            "text": "Die politicus speelde een erg <w>doorzichtig</w> spel om stemmen te winnen.",
                            "target_lang_translations": {
                                "en": "That politician played a very <w>obvious</w> game to win votes."
                            }
                        }
                    ],
                    "antonyms": [
                        "ondoorzichtig"
                    ],
                    "common_phrases": [
                        "doorzichtig spel",
                        "doorzichtige smoes"
                    ],
                    "target_lang_definitions": {
                        "en": "easy to understand or see through because it is not complex or subtle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "transparent",
                                "target_lang_sense_clarification": "obvious or easy to see through, like a motive"
                            },
                            {
                                "target_lang_word": "obvious",
                                "target_lang_sense_clarification": "easily perceived or understood"
                            },
                            {
                                "target_lang_word": "thin",
                                "target_lang_sense_clarification": "lacking substance or easily seen through, like an excuse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}