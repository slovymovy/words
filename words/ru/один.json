                            {
                                "target_lang_word": "Odin",
                                "target_lang_sense_clarification": "Norse deity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奥丁",
                                "target_lang_sense_clarification": "北欧神话神祇"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}