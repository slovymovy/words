                                "target_senses": [
                                    {
                                        "sense_id": "d36fac55-db6c-3c04-83c4-baede2640ad1",
                                        "entry_id": "22f744a0-412d-3ae1-b2a3-54fcf068368e",
                                        "glosses": [
                                            "Staatsbürger von Benin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
