{
    "word_family": [
        "baczyć",
        "baczny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ebfa05d-9d12-3ede-aa62-18f8337bd058",
                    "sense_definition": "Stan skupienia uwagi lub zachowanie ostrożności w danej sytuacji.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uwaga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Należy zachować szczególną <w>baczność</w> podczas przechodzenia przez ruchliwą ulicę.",
                            "target_lang_translations": {
                                "ru": "При переходе через оживленную улицу следует проявлять особую <w>бдительность</w>."
                            }
                        },
                        {
                            "text": "Żołnierz musi wykazywać się wielką <w>bacznością</w> podczas pełnienia warty.",
                            "target_lang_translations": {
                                "ru": "Солдат должен проявлять большую <w>бдительность</w> во время несения караула."
                            }
                        }
                    ],
                    "synonyms": [
                        "uważność"
                    ],
                    "common_phrases": [
                        "zachować baczność"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние повышенного внимания или проявление осторожности в определенной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительность",
                                "target_lang_sense_clarification": "состояние готовности заметить опасность"
                            },
                            {
                                "target_lang_word": "осторожность",
                                "target_lang_sense_clarification": "внимательное и осмотрительное поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c08da12-7959-3798-9c33-afb236997455",
                    "sense_definition": "Wojskowa postawa zasadnicza polegająca na staniu prosto ze złączonymi stopami i rękami wzdłuż ciała.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na komendę dowódcy cały oddział stanął na <w>baczność</w>.",
                            "target_lang_translations": {
                                "ru": "По команде командира весь отряд встал <w>смирно</w>."
                            }
                        },
                        {
                            "text": "Wszyscy żołnierze stali na <w>baczność</w> podczas uroczystego podniesienia flagi.",
                            "target_lang_translations": {
                                "ru": "Все солдаты стояли <w>смирно</w> во время торжественного поднятия флага."
                            }
                        }
                    ],
                    "antonyms": [
                        "spocznij"
                    ],
                    "common_phrases": [
                        "stać na baczność"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военная строевая стойка: стоять прямо, ноги вместе, руки по швам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка смирно",
                                "target_lang_sense_clarification": "положение тела по команде «смирно»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "853e3115-0d46-328d-9985-66a958afc563",
                    "sense_definition": "Cecha charakteru polegająca na rozsądnym i przewidującym podejściu do spraw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uwaga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego życiowa <w>baczność</w> pozwoliła mu uniknąć wielu poważnych błędów w interesach.",
                            "target_lang_translations": {
                                "ru": "Его жизненная <w>осмотрительность</w> позволила ему избежать многих серьезных ошибок в делах."
                            }
                        },
                        {
                            "text": "Wymagana jest tutaj duża <w>baczność</w> przy podejmowaniu tak ważnych decyzji finansowych.",
                            "target_lang_translations": {
                                "ru": "Здесь требуется большая <w>осмотрительность</w> при принятии столь важных финансовых решений."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Черта характера, заключающаяся в разумном и предусмотрительном подходе к делам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмотрительность",
                                "target_lang_sense_clarification": "способность предвидеть последствия"
                            },
                            {
                                "target_lang_word": "благоразумие",
                                "target_lang_sense_clarification": "рассудительность в принятии решений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8666d064-847c-3337-ab93-bdaf0943a595",
                    "sense_definition": "Komenda wojskowa nakazująca przyjęcie wyprostowanej postawy zasadniczej.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Baczność</w>, proszę przygotować się do uroczystego apelu.",
                            "target_lang_translations": {
                                "ru": "<w>Смирно</w>, прошу приготовиться к торжественному построению."
                            }
                        },
                        {
                            "text": "Dowódca krzyknął <w>baczność</w> i wszyscy żołnierze natychmiast się wyprostowali.",
                            "target_lang_translations": {
                                "ru": "Командир крикнул <w>смирно</w>, и все солдаты немедленно вытянулись."
                            }
                        }
                    ],
                    "antonyms": [
                        "spocznij"
                    ],
                    "common_phrases": [
                        "komenda baczność"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военная команда, требующая принять строевую стойку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смирно",
                                "target_lang_sense_clarification": "военная команда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}