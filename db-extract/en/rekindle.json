                    {
                        "translation_id": "a209d7fa-ed4e-4ec0-a381-51ba7e66f527",
                        "source_entry_id": "fe8b0f49-322e-3057-9c0e-a98dbcd329c1",
                        "source_sense_description": "To kindle once again",
                        "target_lang_word": "rallumer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rallumer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89ad6b30-9d6d-3c7a-a85a-736041289563",
                                        "entry_id": "bf0761db-8571-32da-b409-f1e2b40fc7e5",
                                        "glosses": [
                                            "Allumer de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d98c3e-3e97-4231-8ec0-d01903609f50",
                                                "sense_id": "89ad6b30-9d6d-3c7a-a85a-736041289563",
                                                "text": "Je chicanais, j’allais éteindre ; elle rallumait, j’allais réteindre."
                                            },
                                            {
                                                "example_id": "98d752e5-cf0e-4222-9596-79f83431dbcc",
                                                "sense_id": "89ad6b30-9d6d-3c7a-a85a-736041289563",
                                                "text": "La messe finie, on rentrait vite à la maison sous les étoiles, on s’embarrait soigneusement, on soufflait sur la braise pour rallumer le feu et, à la lueur du calel, on mangeait les « bougnettes » arrosées de vin chaud, parfumé à la cannelle, au laurier et aux clous de girofle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                                        "entry_id": "bf0761db-8571-32da-b409-f1e2b40fc7e5",
                                        "glosses": [
                                            "Donner une nouvelle ardeur, une nouvelle force à quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "724eb128-9c34-4a35-8b78-5d65306b3b3c",
                                                "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                                                "text": "Alors nous oublions les étoiles et le chant du grillon qu’entend le solitaire ; la nuit flambe, et c’est le soleil rallumé qui pénètre avec toi dans ma maison."
                                            },
                                            {
                                                "example_id": "7eac35b3-61a9-42ed-aa26-59ccf9077df0",
                                                "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                                                "text": "Cet événement ralluma la sédition."
                                            },
                                            {
                                                "example_id": "55cd63c5-f4a7-418b-9cc0-cf949735a308",
                                                "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                                                "text": "La présence de son ennemi ralluma sa colère."
                                            },
                                            {
                                                "example_id": "f13b1b2a-7d16-4754-b061-0cf4c3edf389",
                                                "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                                                "text": "La vue de sa maîtresse ralluma sa passion."
                                            },
                                            {
                                                "example_id": "a15d2607-1b91-46a4-a17b-80272e1e5db4",
                                                "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                                                "text": "La guerre se ralluma par toute l’Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc5d70a3-6ead-36e6-8123-5f48506a494f",
                                        "entry_id": "bf0761db-8571-32da-b409-f1e2b40fc7e5",
                                        "glosses": [
                                            "Repartir après s’être éteint."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40f24d72-e465-48a3-8c03-3bf9beff5d35",
                                                "sense_id": "fc5d70a3-6ead-36e6-8123-5f48506a494f",
                                                "text": "Le feu, qu’on croyait éteint, vint tout à coup à se rallumer."
                                            },
                                            {
                                                "example_id": "87ca6348-d3fc-4568-8738-97f2f2c1e0cd",
                                                "sense_id": "fc5d70a3-6ead-36e6-8123-5f48506a494f",
                                                "text": "Ma télé doit avoir un problème, ça fait plusieurs fois qu’elle se rallume toute seule pendant la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afb0a283-d25d-47ef-b1fc-f9d48c6c685f",
