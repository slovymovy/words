                "senses": [
                    {
                        "sense_id": "1fbfe844-d5f1-337b-b82a-dd37644bb2b7",
                        "entry_id": "2d8661cb-557b-3d7f-8b24-f295212f08cc",
                        "glosses": [
                            "комплекс зданий военного министерства США, в плане имеющий форму пятиугольника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59960f83-7f93-4a7e-aec6-5a26fce1c96f",
                                "sense_id": "1fbfe844-d5f1-337b-b82a-dd37644bb2b7",
                                "text": "Организаторы планируют собрать протестующих у Мемориала ветеранам Вьетнама и отправиться к Пентагону, чтобы потребовать вывода войск из Ирака."
                            }
                        ]
                    },
                    {
                        "sense_id": "91ce9f5e-75da-37b1-8988-e500a38683f6",
                        "entry_id": "2d8661cb-557b-3d7f-8b24-f295212f08cc",
                        "glosses": [
                            "перен. министерство обороны США как организация"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acd2caf0-61d5-4d8e-9599-c7f297eee2cc",
                                "sense_id": "91ce9f5e-75da-37b1-8988-e500a38683f6",
                                "text": "В планы Пентагона входит модернизация и запуск новых оборонных программ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8c36b64-e355-44c9-a0f0-cc0987c48bf4",
                        "source_entry_id": "2d8661cb-557b-3d7f-8b24-f295212f08cc",
                        "target_lang_word": "Pentagon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pentagon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2eb12f-5157-3d72-8552-13ad6fb73d88",
                                        "entry_id": "e81bc60b-2b88-3724-9d71-a23d75f7a7fe",
                                        "glosses": [
                                            "The headquarters of the United States Department of Defense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf1e94c-a062-354b-9452-d0147f1e461d",
                                        "entry_id": "e81bc60b-2b88-3724-9d71-a23d75f7a7fe",
                                        "glosses": [
                                            "The United States Department of Defense."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84a48e8-bd76-4890-b989-08e04b91317e",
                                                "sense_id": "bcf1e94c-a062-354b-9452-d0147f1e461d",
                                                "text": "The Vietnamese people inspired youth of all nationalities […] by demonstrating that the determination of a people to fight for their sovereignty and right to self-determination was an unconquerable force, even in the face of Pentagon might."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c9be8dd-97eb-4b46-90af-673508041482",
                        "source_entry_id": "2d8661cb-557b-3d7f-8b24-f295212f08cc",
                        "target_lang_word": "Pentagono",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b804897d-fd92-4c06-936a-6f77d56dcf73",
                        "source_entry_id": "2d8661cb-557b-3d7f-8b24-f295212f08cc",
                        "target_lang_word": "Pentagon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pentagon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "515bf040-89b5-30ab-a398-4b2f9258946b",
                                        "entry_id": "3dd60a9a-3018-3221-9fda-28d1064d49f4",
                                        "glosses": [
                                            "ein Fünfeck; eine Figur mit fünf Ecken"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47762260-af29-486c-89cc-44dd111e1882",
                                                "sense_id": "515bf040-89b5-30ab-a398-4b2f9258946b",
                                                "text": "„An dem Foto des Klosterfensters wird deutlich, dass der Baumeister unter anderem vor dem Problem stand, das Pentagramm in ein rundes Fenster einzubauen. Dafür musste er zuerst ein regelmäßiges Fünfeck, ein sogenanntes Pentagon konstruieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pentagon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b5477e3-36c4-3c14-bd20-f4f1d9982ff2",
                                        "entry_id": "a4ccfd0e-5c3c-33e6-a3fc-3bd9f5a53440",
                                        "glosses": [
                                            "das Verteidigungsministerium der USA in Washington"
                                        ],
                                        "tags": [
                                            "USA"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0bf979e-59fe-4c59-90a6-7dba0fa45b16",
                                                "sense_id": "9b5477e3-36c4-3c14-bd20-f4f1d9982ff2",
                                                "text": "„Noch immer kontrollierte das Pentagon den Großteil des Budgets für Nationale Sicherheit, das jährlich fast 500 Milliarden Dollar betrug und wovon die CIA ungefähr ein Prozent erhielt.“"
                                            },
                                            {
                                                "example_id": "258a1e2d-9679-4938-a115-2341f0a0c577",
                                                "sense_id": "9b5477e3-36c4-3c14-bd20-f4f1d9982ff2",
                                                "text": "„Knapp zwei Monate später, so Ihr [Wesley Clarks] Bericht, erfuhren Sie bei einem Besuch im Pentagon von einem Offizier des Vereinigten Generalstabs, dass außer Afghanistan - was Ihre Billigung fand - in den folgenden ‘fünf Jahren noch sieben weitere Staaten von den USA angegriffen und ihre Regierungen zerstört werden sollen’: Irak, Libyen, Syrien, Iran, Libanon, Somalia und Sudan.“"
                                            },
                                            {
                                                "example_id": "d9c69326-9e30-4b78-9700-548cabb7d1ba",
                                                "sense_id": "9b5477e3-36c4-3c14-bd20-f4f1d9982ff2",
                                                "text": "„Eine weitere Bedingung von Roosevelt war, für den Bau kein Material aus kriegführenden Staaten zu verwenden, womit vor allem Marmor (aus Italien) gemeint war. So musste das Pentagon aus Beton gebaut werden.“"
                                            },
                                            {
                                                "example_id": "6609cb01-53d0-453f-bb47-dc6b50f6d4a8",
                                                "sense_id": "9b5477e3-36c4-3c14-bd20-f4f1d9982ff2",
                                                "text": "„Da nirgendwo verlässlich niedergeschrieben ist, wie oft CIA, Pentagon oder NATO in schweinebuchtähnliche Situationen geraten sind und wie sie sich dann verhalten haben, können die beiden jetzt ewig weiterstreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
