                        "entry_id": "c5107f50-0433-3f89-bcb6-5e1385bec9ab",
                        "glosses": [
                            "To serve as or perform the duties of a butler."
                        ],
                        "tags": [
                            "humorous",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "98adb102-262e-456a-8a17-fe6edaed90e2",
                                "sense_id": "dd7e8b31-69a7-3d58-8801-7744e0211fd9",
                                "text": "...even the stoic and impeccable maid of Miss Ethelwyn Arthur-Jones, who ‘buttled’ as well as the most time-honoured butler."
                            },
                            {
                                "example_id": "79127249-a385-4697-9dcc-aec451bac26a",
                                "sense_id": "dd7e8b31-69a7-3d58-8801-7744e0211fd9",
                                "text": "Houses where Negroes buttled or cooked were marked for a visit."
                            },
                            {
                                "example_id": "2e62cb8d-e21d-4b28-95ca-66e4ee1b7b49",
                                "sense_id": "dd7e8b31-69a7-3d58-8801-7744e0211fd9",
                                "text": "At times like this, he buttled when Spriggan the butler was not on duty, or if an extra hand was needed, he footed as well."
                            }
                        ]
                    }
