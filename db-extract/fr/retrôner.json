                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d79713-1623-4598-8484-086b310ee19d",
                                "sense_id": "b6de92fb-608e-3519-9249-9824b7148d76",
                                "text": "Après, je vais peut-être me détrôner pour mieux me \"retrôner\" avec le coup d'état..."
                            },
                            {
                                "example_id": "2e031a8a-8d47-48ed-bf09-02d1eca85228",
                                "sense_id": "b6de92fb-608e-3519-9249-9824b7148d76",
                                "text": "On sait de quoi il s'agissait : la Cour de France et les Chambres avaient résolu de remettre en possession de sa couronne, de retrôner comme on disait, le roi Ferdinand VII renvoyé par ses sujets."
                            },
                            {
                                "example_id": "5856ec1b-6440-497a-ab88-4fa1e085fb64",
                                "sense_id": "b6de92fb-608e-3519-9249-9824b7148d76",
                                "text": "j'ai fini l'année à trôner et débuter l'année à retrôner"
                            }
                        ]
                    }
