                                    },
                                    {
                                        "sense_id": "b6037e8d-0b94-3250-9c5e-51843e8d418f",
                                        "entry_id": "cad934f4-16c5-3319-8190-616877077799",
                                        "glosses": [
                                            "百合科植物卷丹、百合、細葉百合的乾燥肉質鱗葉，可用作藥材"
                                        ],
                                        "tags": [
