                        "nl": [
                            {
                                "target_lang_word": "ontwikkeld",
                                "target_lang_sense_clarification": "algemene betekenis"
                            },
                            {
                                "target_lang_word": "volwassen",
                                "target_lang_sense_clarification": "met betrekking tot eigenschappen of groei"
