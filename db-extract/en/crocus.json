                                        "entry_id": "5c7b2ee9-67cf-3a8f-93c2-8c87645c45c4",
                                        "glosses": [
                                            "Genre de plante à bulbe de la famille des Iridaceae qui comprend en particulier l’espèce Crocus sativus dont on extrait le safran. → voir Crocus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c11241d-1273-4443-a5d7-d10bc25a72b3",
                                                "sense_id": "738936fe-6b2d-3c38-b59e-09cc851f8d66",
                                                "text": "Le crocus fleurit au début du printemps ou à l'automne."
                                            },
                                            {
                                                "example_id": "4211611f-48fe-476e-a6ae-e054a61379ff",
                                                "sense_id": "738936fe-6b2d-3c38-b59e-09cc851f8d66",
                                                "text": "Les fins d’étés surtout étaient délicieuses là-bas, quand les plaines devenaient toutes violettes de crocus, au pied des bois déjà jaunis."
                                            },
                                            {
                                                "example_id": "c4f3c367-b8eb-46c8-97be-e5de681175a0",
                                                "sense_id": "738936fe-6b2d-3c38-b59e-09cc851f8d66",
                                                "text": "Assise sur le banc dans le parc du château de Nérac, la jeune fille semblait lire son gros livre les pieds enfoncés dans deux bouquets de crocus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f06febe-24cd-3622-91ea-dfbeff6022ac",
                                        "entry_id": "5c7b2ee9-67cf-3a8f-93c2-8c87645c45c4",
                                        "glosses": [
                                            "Fleur de cette plante."
                                        ],
