                        ],
                        "form": "die Trainingsbereiche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfb8e782-91a3-3dc5-9a60-0ddf68e8bec2",
                        "entry_id": "92988251-d410-33b3-8112-50f3c62ec6d6",
                        "glosses": [
                            "intensitätsbezogene Zone oder Stufe, Kategorie, in der trainiert wird, um bestimmte Trainingsziele zu erreichen"
                        ],
                        "tags": [
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "be41ca62-ce5e-4f9a-b7c6-97b33ec47428",
                                "sense_id": "bfb8e782-91a3-3dc5-9a60-0ddf68e8bec2",
                                "text": "„Jeder kann durch diese Messung relativ einfach erkennen, ob im richtigen Trainingsbereich trainiert wird.“"
                            },
                            {
                                "example_id": "58f20152-1131-40ca-88f2-2a97fb6b2d33",
                                "sense_id": "bfb8e782-91a3-3dc5-9a60-0ddf68e8bec2",
                                "text": "„Unsere Trainingsbereiche sind auf einander aufgebaut und ergänzen sich.“"
                            },
                            {
                                "example_id": "b6c529c7-3071-4b85-8e2f-52b7658f5d1c",
                                "sense_id": "bfb8e782-91a3-3dc5-9a60-0ddf68e8bec2",
                                "text": "„Aufgrund ihrer Arbeitsbereitschaft und Intelligenz können Belgische Schäferhunde gut in fortgeschrittenen Trainingsbereichen wie Gehorsam, Agilität, Such- und Rettungsarbeit und sogar in Diensthunde-Arbeiten trainiert werden.“"
                            },
                            {
                                "example_id": "f555c0dc-05cb-49dc-a2c5-39fa4ccc030b",
                                "sense_id": "bfb8e782-91a3-3dc5-9a60-0ddf68e8bec2",
                                "text": "„Teste die verschiedenen Trainingsbereiche - von den modernsten Geräten, über zahlreiche motivierende Kurse bis hin zum Entspannen im Wellnessbereich.“"
                            },
                            {
                                "example_id": "0b333b1a-dc0c-4902-aa0d-0dd4f62da95d",
                                "sense_id": "bfb8e782-91a3-3dc5-9a60-0ddf68e8bec2",
                                "text": "„Unabhängig der Programmwahl kannst du zusätzlich eine Pulsobergrenze definieren, um deine Zielherzfrequenz einzuhalten und stets in deinem optimalen Trainingsbereich zu bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b6539bf-118b-396c-be34-c5e05a9ee626",
                        "entry_id": "92988251-d410-33b3-8112-50f3c62ec6d6",
                        "glosses": [
                            "räumlich abgegrenzter Bereich, der speziell für Trainings/Übungen vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6997e8b0-a0a0-4434-a8d5-8682ec4693b1",
                                "sense_id": "7b6539bf-118b-396c-be34-c5e05a9ee626",
                                "text": "„Im Dojotempel befinden sich ein Trainingsbereich und 5 Räume, unter anderem Wus Teestube, Pixals Werkstatt und eine Gefechtskammer.“"
                            },
                            {
                                "example_id": "947ed621-6501-4c41-8881-e503e4a3cfae",
                                "sense_id": "7b6539bf-118b-396c-be34-c5e05a9ee626",
                                "text": "„Das Speedfit in Neu-Rum verfügt darüber hinaus über einen eigenen Trainingsbereich für Damen und mehrere Solarien.“"
                            },
                            {
                                "example_id": "6d58a2c0-aed6-4f48-839e-d3d1c4ae465e",
                                "sense_id": "7b6539bf-118b-396c-be34-c5e05a9ee626",
                                "text": "„Vor Betreten der Trainingsbereiche sind die Straßenschuhe gegen saubere Trainingsschuhe zu tauschen.“"
                            },
                            {
                                "example_id": "c98a8b63-62fa-4127-91d2-22ba73cfff97",
                                "sense_id": "7b6539bf-118b-396c-be34-c5e05a9ee626",
                                "text": "„Unser neuestes Modell ist mit einem Klettverschluss ausgestattet, dank dem Sie in der Lage sind, mehrere Matten zusammenzustellen und dadurch auch größere Trainingsbereiche in beliebiger Größe zu bauen.“"
                            },
                            {
                                "example_id": "fdff330c-1ff3-4087-8277-05d13b5247be",
                                "sense_id": "7b6539bf-118b-396c-be34-c5e05a9ee626",
                                "text": "„Bereite deinen Trainingsbereich vor, indem du genügend Platz schaffst und deine Ausrüstung griffbereit hast.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ecb06fa0-c3be-302b-980a-b37c87311938",
                        "entry_id": "92988251-d410-33b3-8112-50f3c62ec6d6",
                        "glosses": [
                            "Abteilung oder Geschäftsbereich eines Unternehmens, die/der für Trainings und Schulungen zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ebc132-17d3-4798-bb54-b99a58071e3d",
                                "sense_id": "ecb06fa0-c3be-302b-980a-b37c87311938",
                                "text": "„Der Trainingsbereich brachte drei Millionen, die Produkte 11,2 Millionen Pfund Umsatz.“"
                            },
                            {
                                "example_id": "21fc640f-65b4-4e59-95ba-d7dbcddb307a",
                                "sense_id": "ecb06fa0-c3be-302b-980a-b37c87311938",
                                "text": "„Die Siemens-Nixdorf Business Services GmbH & Co. OHG sowie Sun Service, ein Geschäftsbereich von Sun Microsystems, kooperieren im Trainingsbereich.“"
                            },
                            {
                                "example_id": "529b50de-9d1c-47c7-a952-e75dde9429f6",
                                "sense_id": "ecb06fa0-c3be-302b-980a-b37c87311938",
                                "text": "„Der Trainingsbereich von Digital, jetzt bei Ditec, kommt langsam auf die Fuesse.“"
                            },
                            {
                                "example_id": "2abe06f1-cb32-4665-94df-d653fbf4c54e",
                                "sense_id": "ecb06fa0-c3be-302b-980a-b37c87311938",
                                "text": "„Inhouse-Seminare, die sich nach Auskunft von Schulungs-Chefin Petra Gschwind bereits ab drei Personen rechnen, runden das Angebot im Trainingsbereich ab.“"
                            },
                            {
                                "example_id": "2346943a-361e-49a6-aaa5-d79f3378d17f",
                                "sense_id": "ecb06fa0-c3be-302b-980a-b37c87311938",
                                "text": "„SAP stellt seine eigenen Entwicklungs- und Produktionsmaschinen auf SQL um, der interne Trainingsbereich soll folgen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
