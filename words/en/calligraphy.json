{
    "word_family": [
        "calligrapher",
        "calligraphic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "606983a9-ffa5-36a2-aba1-2f920b048609",
                    "sense_definition": "The art or practice of writing letters and words in a decorative style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art_of_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent years studying the traditional art of <w>calligraphy</w> to improve her handwriting.",
                            "target_lang_translations": {
                                "zh": "她花了多年时间学习传统的<w>书法</w>艺术，以改善自己的笔迹。"
                            }
                        },
                        {
                            "text": "The wedding invitations were written in beautiful <w>calligraphy</w> by a professional artist.",
                            "target_lang_translations": {
                                "zh": "婚礼请柬是由一位专业艺术家用优美的<w>书法</w>书写的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chirography",
                        "penmanship"
                    ],
                    "common_phrases": [
                        "practice calligraphy",
                        "learn calligraphy"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过装饰性风格书写文字的艺术或实践。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "书法",
                                "target_lang_sense_clarification": "指书写汉字的艺术，也泛指书写艺术。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95ef0b6e-24c4-30ab-99dc-76da937ca6f7",
                    "sense_definition": "A specific style of decorative writing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art_of_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed several different styles of <w>calligraphy</w> from the ancient world.",
                            "target_lang_translations": {
                                "zh": "博物馆展出了几种来自古代世界的不同<w>书体</w>。"
                            }
                        },
                        {
                            "text": "He developed a unique <w>calligraphy</w> that combined modern and traditional elements.",
                            "target_lang_translations": {
                                "zh": "他创造了一种结合了现代与传统元素的独特<w>书法风格</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种特定的装饰性书写风格。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "书体",
                                "target_lang_sense_clarification": "指特定的书写字体或风格。"
                            },
                            {
                                "target_lang_word": "书法风格",
                                "target_lang_sense_clarification": "指某种特定的书法表现形式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "764577f9-a7ae-36bc-b6ba-04f742eff441",
                    "sense_definition": "A document or piece of art featuring decorative writing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art_of_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gallery sold a rare <w>calligraphy</w> created by a famous master.",
                            "target_lang_translations": {
                                "zh": "画廊出售了一件由著名大师创作的珍稀<w>书法作品</w>。"
                            }
                        },
                        {
                            "text": "She framed the <w>calligraphy</w> and hung it in her living room.",
                            "target_lang_translations": {
                                "zh": "她把这幅<w>书法作品</w>装裱起来，挂在了客厅里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一件以装饰性书写为特色的艺术作品或文档。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "书法作品",
                                "target_lang_sense_clarification": "指作为艺术品呈现的书法。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}