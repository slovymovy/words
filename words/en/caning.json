                    "sense_id": "cd848555-d8e4-3c77-8ebb-7377e9e9bdb9",
                    "sense_definition": "A physical punishment involving hitting someone with a cane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school board finally decided to abolish the <w>caning</w> of students for minor disciplinary infractions.",
                            "target_lang_translations": {
                                "ru": "Школьный совет наконец решил отменить <w>порку тростью</w> учеников за незначительные дисциплинарные проступки."
                            }
                        },
                        {
                            "text": "He still remembers the harsh <w>caning</w> he received for talking during the morning assembly.",
                            "target_lang_translations": {
                                "ru": "Он до сих пор помнит суровую <w>порку</w>, которую получил за разговоры во время утренней линейки."
                            }
                        }
                    ],
                    "synonyms": [
                        "flogging",
                        "whipping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Телесное наказание, заключающееся в ударах тростью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порка тростью",
                                "target_lang_sense_clarification": "официальное или школьное наказание"
                            },
                            {
                                "target_lang_word": "телесные наказания",
                                "target_lang_sense_clarification": "общий термин для физических наказаний"
                            }
                        ]
                    }
                }
            ]
        },
        {
