                "senses": [
                    {
                        "sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
                        "entry_id": "1718294e-4a16-38de-b0ab-5b73a5174a70",
                        "glosses": [
                            "ein mehrstrophiges witzig-zweideutiges, politisches oder satirisches Lied/Strophengedicht mit markantem Refrain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8a6a79-9ad8-41eb-8b3c-e05d3d2b5943",
                                "sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
                                "text": "„Allmählich unterschied er einen kräftigen Burschen mit Infanteriehosen und einer Matrosenbluse, der ein Couplet vortrug mit heiserer und besoffener Stimme, das sich nicht für zarte Ohren eignete.“"
                            },
                            {
                                "example_id": "626361e6-622a-4231-b07d-b6bfaeadab25",
                                "sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
                                "text": "„Der Vater benötigt zum Vortragen eines seiner Couplets eine überlange, bunte Weste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7d643e1-ec25-4a0d-a51f-bd7fde886452",
                        "source_entry_id": "1718294e-4a16-38de-b0ab-5b73a5174a70",
                        "source_sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
