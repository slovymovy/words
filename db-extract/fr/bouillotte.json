                                        "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                        "entry_id": "4dcd234f-b2ff-3be8-855d-f0a47dc8c429",
                                        "glosses": [
                                            "Gefäß aus Gummi zur Aufnahme von heißem Wasser, um dem Körper Wärme zuzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2bf576-19f0-433a-853c-f25f658b1aa2",
                                                "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                                "text": "In kalten Nächten ist es im Bett mit einer Wärmflasche angenehmer."
                                            },
                                            {
                                                "example_id": "3fd095f6-a69e-4acc-afed-618df78dea32",
                                                "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                                "text": "„Ich murmelte etwas von einer Wärmflasche.“"
                                            },
                                            {
                                                "example_id": "bac17b63-e7e9-4c73-8fd3-252259a01f14",
                                                "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                                "text": "„Solche und ähnliche Erlebnisse führen - für mich mittlerweile nachvollziehbar - viele Frauen zu der todernst gemeinten Aussage, dass sie ohne ihre Wärmflasche nicht leben könnten!“"
                                            },
                                            {
                                                "example_id": "168078da-a22e-4d73-b335-db4e070d3824",
                                                "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                                "text": "„Als ich wieder einmal mit einer Wärmflasche im Sessel saß, kam unerwarteter Besuch.“"
                                            },
                                            {
                                                "example_id": "b97eb980-c629-4f66-ba67-93c193e4ea5f",
                                                "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                                "text": "„Er bekam den Auftrag, zwei Wärmflaschen aus der Küche zu besorgen.“"
                                            },
                                            {
                                                "example_id": "c7e0638a-5a89-41ff-9dbe-cf1ccb15f93b",
                                                "sense_id": "885d97a4-4758-3a82-ba0c-dd061baf4d9c",
                                                "text": "„Mama steckte mich mit Wärmflasche ins Bett, aber die Wärmflasche half nicht, und ich mußte auf mein Schlafanzugoberteil brechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
