                    {
                        "sense_id": "b78b6bd8-2616-3112-95b9-04c318ef8c18",
                        "entry_id": "a64fb522-ac83-3864-85c6-1342f908f488",
                        "glosses": [
                            "Eigenschaft einer Person, äußerst sparsam, geizig zu sein"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "80dda836-a9d4-4c57-a314-b2cbc87a4545",
                                "sense_id": "b78b6bd8-2616-3112-95b9-04c318ef8c18",
                                "text": "„Aus gutem Grund befahl er es und nicht aus Geiz und Knickrigkeit.“"
                            },
                            {
                                "example_id": "6f9d1689-32f7-42a2-87c3-3800046240b2",
                                "sense_id": "b78b6bd8-2616-3112-95b9-04c318ef8c18",
                                "text": "„Und sie hatten den Großteil davon mittels Habgier, Knickrigkeit und Steuerschlupflöchern behalten.“"
                            },
                            {
                                "example_id": "573045e6-319e-4c40-ac62-148dbf554056",
                                "sense_id": "b78b6bd8-2616-3112-95b9-04c318ef8c18",
                                "text": "„Mich rührte seine unglückliche Lage sehr, und ich fühlte, daß ein Trinkgeld von weniger als neun Pence eine wahre Knickrigkeit und Herzenshärte wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
