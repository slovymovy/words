                                            {
                                                "example_id": "73e128ca-3519-4c2d-bb94-2d889dad02e3",
                                                "sense_id": "f428e052-1908-305c-8f19-fb6c05eb8846",
                                                "text": "Ojciec mi to wszystko pięknie wyłożył, analitycznie, logicznie, abstrakcyjnie i sam nie wiem jak, i już załatwione!"
                                            },
                                            {
                                                "example_id": "faf80354-0dc7-4ecf-b6cc-9ff275c92bb8",
                                                "sense_id": "f428e052-1908-305c-8f19-fb6c05eb8846",
                                                "text": "Ludzie nie myślą analitycznie, lecz za pomocą różnych zbitek, stereotypów, przyzwyczajeń"
                                            },
                                            {
                                                "example_id": "a9b58ae3-02cb-4d97-a04b-41aa9ae1c0f3",
                                                "sense_id": "f428e052-1908-305c-8f19-fb6c05eb8846",
                                                "text": "Można zatem założyć, że analitycznie wyróżnione cechy łączą się w szczególne konfiguracje stanowiąc zespół warunków określających to, jak długo i z jaką częstotliwością rodziny doświadczają biedy"
                                            }
