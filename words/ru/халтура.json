                },
                {
                    "sense_id": "e1b26475-82be-316b-83ab-7eea46e42d31",
                    "sense_definition": "Результат небрежной работы; нечто сделанное плохо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "плохая работа",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот фильм — полная <w>халтура</w>, зря потратил время на просмотр.",
                            "target_lang_translations": {
