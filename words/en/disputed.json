            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "adb9e671-8725-3ce1-8b9e-b22720cd8125",
                    "sense_definition": "Subject to disagreement or debate; not accepted by everyone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exact cause of the accident remains <w>disputed</w> by experts.",
                            "target_lang_translations": {
                                "ru": "Точная причина аварии остается <w>оспариваемой</w> экспертами.",
                                "nl": "De precieze oorzaak van het ongeluk blijft <w>omstreden</w> onder experts."
                            }
                        },
                        {
                            "text": "It is a widely <w>disputed</w> theory that lacks sufficient evidence.",
                            "target_lang_translations": {
                                "ru": "Это широко <w>оспариваемая</w> теория, которой не хватает достаточных доказательств.",
                                "nl": "Het is een breed <w>betwiste</w> theorie waarvoor voldoende bewijs ontbreekt."
                            }
                        }
                    ],
                    "synonyms": [
                        "contested",
                        "controversial",
                        "unsettled",
                        "debated"
                    ],
                    "antonyms": [
                        "undisputed",
                        "certain",
                        "settled",
                        "accepted"
                    ],
                    "common_phrases": [
                        "widely disputed",
                        "hotly disputed",
                        "disputed claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся предметом разногласий или дебатов; не принятый всеми.",
                        "nl": "Onderwerp van onenigheid of discussie; niet door iedereen aanvaard."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спо́рный",
                                "target_lang_sense_clarification": "вызывающий разногласия"
                            },
                            {
                                "target_lang_word": "оспа́риваемый",
                                "target_lang_sense_clarification": "подвергаемый сомнению"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "omstreden",
                                "target_lang_sense_clarification": "waarover van mening wordt verschild"
                            },
                            {
                                "target_lang_word": "betwist",
                                "target_lang_sense_clarification": "in twijfel getrokken of aangevochten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cddce05-b2a7-38be-bfd4-1a59df07a25a",
                    "sense_definition": "Claimed by more than one country or authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geopolitical_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Troops were sent to protect the <w>disputed</w> border region.",
                            "target_lang_translations": {
                                "ru": "Войска были отправлены для защиты <w>спорного</w> пограничного региона.",
                                "nl": "Er werden troepen gestuurd om de <w>betwiste</w> grensregio te beschermen."
                            }
                        },
                        {
                            "text": "The two nations have finally agreed to negotiate over the <w>disputed</w> territory.",
                            "target_lang_translations": {
                                "ru": "Две страны наконец согласились провести переговоры о <w>спорной</w> территории.",
                                "nl": "De twee landen zijn er eindelijk mee ingestemd te onderhandelen over het <w>betwiste</w> gebied."
                            }
                        }
                    ],
                    "synonyms": [
                        "contested"
                    ],
                    "antonyms": [
                        "undisputed"
                    ],
                    "common_phrases": [
                        "disputed territory",
                        "disputed border",
                        "disputed region",
                        "disputed land"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория или объект, на который претендуют более одной страны или власти.",
                        "nl": "Opgeëist door meer dan één land of autoriteit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спо́рный",
                                "target_lang_sense_clarification": "о территории или владении"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "betwist",
                                "target_lang_sense_clarification": "met name van gebieden of grenzen"
                            }
