                        ],
                        "examples": [
                            {
                                "example_id": "23d977c5-e25a-4251-b876-36be77ec421b",
                                "sense_id": "afd261b4-2f9b-3464-9343-25a17ddeac37",
                                "text": "„Als Halsschmuck trugen die keltischen Frauen Perlenketten und Bronzeringe, letztere manchmal zeitlebens.“"
                            },
                            {
                                "example_id": "9552dbc2-7025-4eb8-aa26-97e7353f8a9c",
                                "sense_id": "afd261b4-2f9b-3464-9343-25a17ddeac37",
                                "text": "„Der Halsschmuck des Chefs stammte aus dem Afrika-Feldzug, wie alle wußten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
