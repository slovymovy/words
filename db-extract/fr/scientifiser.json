                        "examples": [
                            {
                                "example_id": "d67f0d60-ea0c-4721-841a-b19e7891b222",
                                "sense_id": "0af5e167-42a6-3f0b-8a02-23c899939b38",
                                "text": "Nous pouvons ajouter que la conclusion sentimentale de M. de Nadaillac est beaucoup plus facile à scientifiser que celle de ses adversaires."
                            },
                            {
                                "example_id": "e25bb949-c0b4-4385-8f06-bc94fc62ef30",
                                "sense_id": "0af5e167-42a6-3f0b-8a02-23c899939b38",
                                "text": "Vu superficiellement, il peut sembler paradoxal de scientifiser l'otium, la jouissance ou les bonheurs de l'existence."
                            }
                        ]
