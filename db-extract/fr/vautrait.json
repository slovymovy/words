            {
                "entry_id": "00c61368-1487-3343-82cb-9cc819f9b77f",
                "word": "vautrait",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c37efa6-75ed-4812-8733-42de940811f7",
                        "entry_id": "00c61368-1487-3343-82cb-9cc819f9b77f",
                        "tags": [
