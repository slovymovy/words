                "senses": [
                    {
                        "sense_id": "757f1ea2-1baa-37fb-b7cf-f9a4a5ef24b8",
                        "entry_id": "2348d92f-a132-3095-a560-3b1a2addf12d",
                        "glosses": [
                            "das Abstimmen oder auch das Votieren"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "243e576b-d040-4c67-84f8-318bc34afcad",
                                "sense_id": "757f1ea2-1baa-37fb-b7cf-f9a4a5ef24b8",
                                "text": "Die Votation wurde verschoben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b581fb4-a5aa-335e-ac5e-6a16b348f757",
                        "entry_id": "2348d92f-a132-3095-a560-3b1a2addf12d",
                        "glosses": [
                            "Darbringung einer Gabe und Erfüllung eines gegebenen Gelübdes oder Versprechens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79910def-d550-4932-bba9-1f4523409a2f",
                                "sense_id": "1b581fb4-a5aa-335e-ac5e-6a16b348f757",
                                "text": "„Das Votivbild zeigt den Votanten, den angerufenen Patron in der Ikonographie eines Gnadenbildes und weißt auf den Anlass der Votation hin.“"
                            },
                            {
                                "example_id": "98a4774d-17a8-44f5-b313-d4274caabd27",
                                "sense_id": "1b581fb4-a5aa-335e-ac5e-6a16b348f757",
                                "text": "„Vom Gebet unterscheidet sich die Votation durch das Versprechen und schließlich durch die Darbringung einer Gabe.“"
                            },
                            {
                                "example_id": "bf3381c5-1994-40e5-a1e2-f9023e124e7c",
                                "sense_id": "1b581fb4-a5aa-335e-ac5e-6a16b348f757",
                                "text": "„Auf weißem Grund steht unter der Malerei die Inschrift der Votation.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16c68794-c6e5-4e71-ac3d-0e0d07b82c41",
                        "source_entry_id": "2348d92f-a132-3095-a560-3b1a2addf12d",
                        "source_sense_id": "757f1ea2-1baa-37fb-b7cf-f9a4a5ef24b8",
                        "source_sense_description": "veraltet: das Abstimmen oder auch das Votieren",
                        "target_lang_word": "scrutin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrutin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                        "entry_id": "ea76ef90-316d-38af-9e58-f69f6636cb65",
                                        "glosses": [
                                            "Vote au moyen de bulletins ou de boules que l’on dépose dans une urne, d’où on les tire ensuite pour les compter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b451d8-ec8c-4a1d-a703-825fcf854f0a",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "C'était une élection toute politique. M. d'Haussonville passa au premier tour de scrutin, au nez et à la barbe du parti impérialiste, qui n'avait trouvé personne à lui opposer."
                                            },
                                            {
                                                "example_id": "98554bcf-54a2-45bc-b71f-e59c08f6b212",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Dépouiller le scrutin."
                                            },
                                            {
                                                "example_id": "7f00a73f-8acc-4883-87ab-a7aa6c1d7c27",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Faire connaître le résultat du scrutin."
                                            },
                                            {
                                                "example_id": "58c649dd-e016-4013-867c-b91ac950963f",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Vote au scrutin secret."
                                            },
                                            {
                                                "example_id": "3b530948-1309-4071-b8bb-5c6183166428",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Scrutin de ballottage."
                                            },
                                            {
                                                "example_id": "38ee322e-7eaa-4aec-8db2-ca1077e0c496",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Ce scrutin est nul."
                                            },
                                            {
                                                "example_id": "56e2d5dc-ce3e-4b66-bbd0-59e5b80f7623",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Scrutin individuel ou uninominal, Celui où les votants ne désignent, chacun sur leur bulletin, qu’une seule personne."
                                            },
                                            {
                                                "example_id": "8998d2a5-d8b2-4cf3-98c5-fd8db94305b8",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Scrutin de liste, Celui où les votants écrivent, chacun sur leur bulletin, autant de noms qu’il y a de candidats à élire."
                                            },
                                            {
                                                "example_id": "ca9ccf43-0505-42f7-b4e1-12c1b652ba7b",
                                                "sense_id": "4c543d65-0da7-33d3-ad01-8dbcf12ffc30",
                                                "text": "Le scrutin débutera à 9h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6640b52d-b153-3aa9-baf1-75a45bd8f81c",
                                        "entry_id": "ea76ef90-316d-38af-9e58-f69f6636cb65",
                                        "glosses": [
                                            "Ensemble des opérations qui constituent une élection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5f65bb-8dca-4b66-9562-65f022c992ee",
                                                "sense_id": "6640b52d-b153-3aa9-baf1-75a45bd8f81c",
                                                "text": "Les partis politiques annoncent des candidatures, de potentiels candidats font leur entrée sur les médias sociaux et on commence à voir des publicités, mais est-ce que la fenêtre pour un scrutin printanier n’est pas en train de se refermer tranquillement ?"
                                            },
                                            {
                                                "example_id": "5646a227-f68a-44f8-bb78-ece27bffd49e",
                                                "sense_id": "6640b52d-b153-3aa9-baf1-75a45bd8f81c",
                                                "text": "Le premier tour de scrutin."
                                            },
                                            {
                                                "example_id": "5eba98f6-0518-4536-b974-2e1c3702e087",
                                                "sense_id": "6640b52d-b153-3aa9-baf1-75a45bd8f81c",
                                                "text": "Avec ce rapport, l'association souhaite interpeller les candidats aux élections européennes, puisqu'un règlement sera soumis au vote une fois le scrutin passé. Une pétition est mise en ligne mercredi 17 avril, sur le site de l'association HOP."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a8564c2-9379-336c-89d3-c35d35d12d69",
                                        "entry_id": "ea76ef90-316d-38af-9e58-f69f6636cb65",
                                        "glosses": [
                                            "Rite préparatoire au baptême, sous forme d’exorcismes, destiné à purifier du mal le catéchumène."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dccbafc7-93b0-437b-8e9c-779600392e89",
                                                "sense_id": "6a8564c2-9379-336c-89d3-c35d35d12d69",
                                                "text": "Les scrutins, que l’on célèbre solennellement le dimanche, sont accomplis au moyen des exorcismes. Ils ont ce double but : faire apparaitre dans le cœur de ceux qui sont appelés ce qu’il y a de faible, de malade et de mauvais, pour le guérir, et ce qu’il y a de bien, de bon et de saint, pour l’affermir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eca5d0f4-cfc7-4ddc-9f77-7b2791185e1a",
                        "source_entry_id": "2348d92f-a132-3095-a560-3b1a2addf12d",
                        "source_sense_id": "757f1ea2-1baa-37fb-b7cf-f9a4a5ef24b8",
