                ],
                "senses": [
                    {
                        "sense_id": "943ad0ad-ef67-3ff8-ba18-720f80068cc8",
                        "entry_id": "8f0f6fbf-319f-3ea3-8ba7-d5d0701d9f60",
                        "glosses": [
                            "A vesica piscis-shaped aureola that surrounds the figures of Christ and the Virgin Mary, or represents God the Father (who is not traditionally depicted) in traditional Eastern Christian art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1dfa15-67b5-4c75-b972-93d374af65f4",
                                "sense_id": "943ad0ad-ef67-3ff8-ba18-720f80068cc8",
                                "text": "In addition, the mandorla may be considered on a more primal level as an archetypically ritual shape that transcends conscious and intentional symbolism, thus falling under the category of the mandala."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaa43b9f-d9d9-4836-b051-9a53cb0f8b4b",
                        "source_entry_id": "8f0f6fbf-319f-3ea3-8ba7-d5d0701d9f60",
                        "source_sense_id": "943ad0ad-ef67-3ff8-ba18-720f80068cc8",
                        "source_sense_description": "A vesica piscis-shaped aureola",
                        "target_lang_word": "mandorle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandorle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d83fa3a-5745-3195-95a8-f73092a733e2",
                                        "entry_id": "ff962a3c-0b02-34a8-bfa9-6efad211c955",
                                        "glosses": [
                                            "Figure en amande, délimitée par la partie commune de deux cercles de même diamètre se chevauchant, dans laquelle sont représentés des personnages sacrés."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e282f23d-b436-45d8-8b2d-b51305720069",
                                                "sense_id": "9d83fa3a-5745-3195-95a8-f73092a733e2",
                                                "text": "Nimbé, debout sur le fond bleu de sa mandorle comme pour signifier qu'il n'est plus dans le ciel terrestre, le Christ est plus petit que les personnages de la terre, pour suggérer l'éloignement de son élévation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c27bd0a-10a9-49ab-b7ca-c346d873d304",
                        "source_entry_id": "8f0f6fbf-319f-3ea3-8ba7-d5d0701d9f60",
                        "source_sense_id": "943ad0ad-ef67-3ff8-ba18-720f80068cc8",
                        "source_sense_description": "A vesica piscis-shaped aureola",
                        "target_lang_word": "Mandorla",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandorla",
