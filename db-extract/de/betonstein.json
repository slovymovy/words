                                "target_word": "bloc de béton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e79083ba-a6e1-3205-ab37-a48fb7f1f034",
                                        "entry_id": "b2a48634-9236-3f90-a93e-4586897051c2",
                                        "glosses": [
                                            "Élément de maçonnerie en béton moulé, généralement parpaing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d1ccea7-1101-4859-b401-21ceb4ae5bf9",
                                                "sense_id": "e79083ba-a6e1-3205-ab37-a48fb7f1f034",
                                                "text": "On a pris un bloc de béton qui avait 1 mètre de longueur et 0ᵐ,50 d’arête. On a réservé une cavité au centre de la face extrême de ce bloc et on a pratiqué une petite rigole pour permettre la sortie d’un tube métallique de petit diamètre. A ce premier bloc on en a superposé un second identique et on a garni le joint de mortier de ciment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fbf408d-a41a-402e-89ac-50aabc555192",
                        "source_entry_id": "116f7c7c-541e-3b0a-95e8-212c352c8a02",
                        "source_sense_id": "8e981655-6a84-3418-aeb1-980a29461035",
                        "source_sense_description": "Stein aus Beton",
                        "target_lang_word": "parpaing",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parpaing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea059a5f-26ce-35d9-993c-2b316423dd39",
                                        "entry_id": "d5ff903c-f423-3229-9b28-ef4cfb561837",
                                        "glosses": [
                                            "Qui traverse un mur et qui apparaît sur les deux parements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c8fcc20-b836-4f80-a30c-b4f46208687f",
                                                "sense_id": "ea059a5f-26ce-35d9-993c-2b316423dd39",
                                                "text": "Une brique parpaigne. Un moellon parpaing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parpaing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd26667-f3db-3261-b0ce-22f2bd0cdeee",
                                        "entry_id": "8391cb8a-ee67-3766-a09c-41924acdc31f",
                                        "glosses": [
                                            "Pierre, moellon, brique, bloc de béton, etc. qui tient toute l’épaisseur d’un mur et qui a deux faces en parements, l’un en dehors, l’autre en dedans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef065f8-0a65-4c5c-8278-466b52abefe6",
                                                "sense_id": "ffd26667-f3db-3261-b0ce-22f2bd0cdeee",
                                                "text": "Cinq claveaux seuls font parpaing et forment ainsi un arc de décharge au-dessus des arcs linteaux."
                                            },
                                            {
                                                "example_id": "ecbc24cb-5e60-4bb9-be9e-ee5b9d8bd5a3",
                                                "sense_id": "ffd26667-f3db-3261-b0ce-22f2bd0cdeee",
                                                "text": "Des boutisses (pierres longues) ou parpaings (pierres traversant le mur) assurent la liaison parement / remplissage. … Dans les murs de plus d’un mètre de large, où la pose des parpaings devient impossible, il est bon de poser des boutisses en vis-à-vis en les bloquant par une autre boutisse posée en appuis sur les queues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663c7a6a-f652-3727-9681-b082a649d17a",
                                        "entry_id": "8391cb8a-ee67-3766-a09c-41924acdc31f",
                                        "glosses": [
                                            "Tout bloc de béton, d’aggloméré, etc., qui tient toute l’épaisseur d’un mur."
                                        ],
                                        "tags": [
                                            "especially",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90111674-8596-4f05-824a-4917b19aa621",
                                                "sense_id": "663c7a6a-f652-3727-9681-b082a649d17a",
                                                "text": "Mur de parpaing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fa1bb1d-493e-3cda-af2a-99de9a38c057",
                                        "entry_id": "8391cb8a-ee67-3766-a09c-41924acdc31f",
                                        "glosses": [
                                            "Pierres placées sous un pan de bois pour l’isoler du sol et de l’humidité."
                                        ],
