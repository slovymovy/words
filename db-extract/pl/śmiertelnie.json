                                        "entry_id": "b82b5405-dda0-3531-8415-5c1b98561312",
                                        "glosses": [
                                            "In a lethal manner, in manner which is or will be fatal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9817f891-2526-4acc-be7c-65df04777dfa",
                                                "sense_id": "7e165372-1e2c-3639-987b-90380f614f16",
                                                "text": "He was lethally poisoned by the cobra and died a day later of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64f185bb-687c-4166-9612-2d9d1916449d",
                        "source_entry_id": "72616658-7f73-33a6-8411-c90a2f3e575c",
                        "source_sense_id": "172d4097-dcf4-3d28-94cf-e43506fdecb0",
                        "target_lang_word": "deathly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deathly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5644cea-7987-367e-8d87-65cf77c778ef",
                                        "entry_id": "7517ef68-9038-37f4-8f17-c8fb403bd99d",
                                        "glosses": [
                                            "Appearing as though dead, or on the verge of death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b3a5e9-8937-43a5-8d13-4d861932164d",
                                                "sense_id": "d5644cea-7987-367e-8d87-65cf77c778ef",
                                                "text": "He has a deathly pallor."
                                            },
                                            {
                                                "example_id": "b73b36e5-05dd-42d2-a04b-40a94893fd40",
                                                "sense_id": "d5644cea-7987-367e-8d87-65cf77c778ef",
                                                "text": "I rushed towards her, and embraced her with ardour; but the deathly languor and coldness of the limbs told me, that what I now held in my arms had ceased to be the Elizabeth whom I had loved and cherished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39676e93-0474-3fe8-b502-682807326c1d",
                                        "entry_id": "7517ef68-9038-37f4-8f17-c8fb403bd99d",
                                        "glosses": [
                                            "Deadly, fatal, causing death."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25d470df-30d8-37ff-8d5a-26924ed81ba7",
                                        "entry_id": "7517ef68-9038-37f4-8f17-c8fb403bd99d",
                                        "glosses": [
                                            "Extreme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c48c6c-ba54-42f8-a0f5-7fff2d3d8fe9",
                                                "sense_id": "25d470df-30d8-37ff-8d5a-26924ed81ba7",
                                                "text": "He has a deathly fear of crocodiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deathly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72ea16e9-a6e2-3925-9d75-5e79dbedb3ff",
                                        "entry_id": "32ca79ff-3bd9-386e-af4d-a09d62ea19f5",
                                        "glosses": [
                                            "In a way that resembles death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60918023-eb88-425a-9862-22efef4f19cf",
                                                "sense_id": "72ea16e9-a6e2-3925-9d75-5e79dbedb3ff",
                                                "text": "He was deathly pale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0eb5ba4-8dd9-35fe-93e3-61c44c300bfb",
                                        "entry_id": "32ca79ff-3bd9-386e-af4d-a09d62ea19f5",
                                        "glosses": [
                                            "Extremely, dreadfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7cc3096-0123-4371-84bc-3b6ec10e7fbd",
                                                "sense_id": "e0eb5ba4-8dd9-35fe-93e3-61c44c300bfb",
                                                "text": "The water was deathly cold."
                                            },
                                            {
                                                "example_id": "bbd166e4-981a-4d94-9ca7-bcb3e987eb92",
                                                "sense_id": "e0eb5ba4-8dd9-35fe-93e3-61c44c300bfb",
                                                "text": "He was deathly afraid of crocodiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a2e1cda-cbb0-49e4-bdcd-3ae23b9dcd14",
                        "source_entry_id": "72616658-7f73-33a6-8411-c90a2f3e575c",
                        "source_sense_id": "39704f2a-e6ca-31d7-9398-927ddc2ba02c",
                        "target_lang_word": "deadly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deadly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bd43eb5-be24-3f10-a333-b60ba4adf438",
                                        "entry_id": "66c7b983-0f29-37c1-923e-40f4bf89af09",
                                        "glosses": [
                                            "Subject to death; mortal."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5f303e-ebad-407c-b587-62b820c37e34",
                                                "sense_id": "5bd43eb5-be24-3f10-a333-b60ba4adf438",
                                                "text": "[…]he ſuffred hym ſelfe to be made mortall and dedly, that innocent & gyltles in hym ſelfe: he myght be ſlayne & deye for the gylty man."
                                            },
                                            {
                                                "example_id": "31eb34b6-877a-43de-8aed-cbe3c0cf3d48",
                                                "sense_id": "5bd43eb5-be24-3f10-a333-b60ba4adf438",
                                                "text": "❧ That when the iournay / of this dedly life / My ſely ghoſte / hath finiſhed and thence[…]"
                                            },
                                            {
                                                "example_id": "9d4a361c-4107-4c32-bddf-2dde6d5bba62",
                                                "sense_id": "5bd43eb5-be24-3f10-a333-b60ba4adf438",
                                                "text": "And next we find / Ourselves in Heaven. Even man's deadly life / Can be there, by God's leave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016f5403-3ce1-3691-8b9b-1c9ee96602e0",
                                        "entry_id": "66c7b983-0f29-37c1-923e-40f4bf89af09",
                                        "glosses": [
                                            "Causing death; lethal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90be1eb6-a3ee-48ca-bb04-20a56fdaa120",
                                                "sense_id": "016f5403-3ce1-3691-8b9b-1c9ee96602e0",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            },
                                            {
                                                "example_id": "c54f0fb7-ec4f-4e88-90b5-fc22a1e14a4a",
                                                "sense_id": "016f5403-3ce1-3691-8b9b-1c9ee96602e0",
                                                "text": "[…] others search for new and deadlier gases, or for soluble poisons capable of being produced in such quantities as to destroy the vegetation of whole continents […]"
                                            },
                                            {
                                                "example_id": "a7330981-cd58-4cc2-97b7-a4d48ffa60bb",
                                                "sense_id": "016f5403-3ce1-3691-8b9b-1c9ee96602e0",
                                                "text": "The killing of more than 90 journalists in Iraq in 43 months after the invasion was to mark it out as one of the deadliest conflicts to cover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99127bdd-949d-3790-bead-50f5ee8add76",
                                        "entry_id": "66c7b983-0f29-37c1-923e-40f4bf89af09",
                                        "glosses": [
                                            "Aiming or willing to destroy; implacable; desperately hostile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab40cad-33a1-4a52-b3b2-a6c0655a849d",
                                                "sense_id": "99127bdd-949d-3790-bead-50f5ee8add76",
                                                "text": "deadly enemies"
                                            },
                                            {
                                                "example_id": "17f40b49-41c0-465a-ba69-7f7b7e187de2",
                                                "sense_id": "99127bdd-949d-3790-bead-50f5ee8add76",
                                                "text": "[…]diſmount thy tucke, be yare in thy preparation, for thy aſſaylant is quick, skilfull and deadly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                        "entry_id": "66c7b983-0f29-37c1-923e-40f4bf89af09",
                                        "glosses": [
                                            "Very accurate (of aiming with a bow, firearm, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcf2e6b-aad1-4bf0-a7c1-519dc9ec7dd3",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "Its deadly aim at vast distances, which condition of the mechanical power brought has made it the dread of the sepoys, who term it \"the gun that kills without making any sound,\" contrasts strangely with the performances of Brown Bess of old, which at any range beyond a hundred yards was so uncertain in its aim that it has been calculated that the soldier shot away the weight in lead of every man that he hit."
                                            },
                                            {
                                                "example_id": "f1ac38ad-41f7-4e9d-82a8-b603f940f545",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "For him the gibbet shall be built; For him the stake prepared: Him shall the scorn and wrath of men Pursue with deadly aim ; And malice, envy, spite and lies, Shall desecrate his name."
                                            },
                                            {
                                                "example_id": "f15b21ae-9466-4b4d-958f-6be97e4f6f10",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "Slaves have been freed, religious tests revoked, Bread tax abolished, and free trade secured, Reform twice carried, franchise much enlarged, With deadly aim to crush foul bribery, And promise given of yet better things."
                                            },
                                            {
                                                "example_id": "2b7a2b97-7ae5-4116-8aac-d3df17b02130",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "Possibly some have thought that we were going to make war on some favorite doctrine or political dogma; that we had set brethren to whetting their sword, and drawing their bow for deadly aim at precious truth; as the wicked Haman had secured a decree that all the Jews should be killed."
                                            },
                                            {
                                                "example_id": "a3a45390-c3ff-4c48-b131-1737010358c2",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "The Elf turned and with deadly accuracy shot an arrow where his nose pointed him. The shaft sliced through the air, pierced the tall grass, and struck the Dwarf's shoes one hundred yards out . . . but the Dwarf was not in them!"
                                            },
                                            {
                                                "example_id": "b5d78523-4591-4baa-b981-cd34b95bc775",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "Was that really her mom grabbing a large Nerf gun from some sort of side holster and aiming it straight at Camden's head? Yes, it was. And the woman was blessed with deadly accuracy."
                                            },
                                            {
                                                "example_id": "06e1d8ab-85a1-4972-ae08-ba8010fe904a",
                                                "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                                                "text": "There is a wealth of common sense and humanity in that, and perhaps the most unexpected element in the idea of the Seven Deadly Sins is that, although it points with deadly accuracy to our capacity for evil, it also leaves us with a vivid and strong sense of what it means to be human."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c331fe5c-39ba-3313-893a-b35d9838e671",
                                        "entry_id": "66c7b983-0f29-37c1-923e-40f4bf89af09",
                                        "glosses": [
                                            "Very boring."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f88fc66-73c3-4316-b913-2d575fb1c5ce",
                                                "sense_id": "c331fe5c-39ba-3313-893a-b35d9838e671",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men, the enervated matrons of the summer capital,[…]!”"
                                            },
                                            {
                                                "example_id": "33a8a2e0-ffbd-4ad4-9ceb-f9f89dc3690d",
                                                "sense_id": "c331fe5c-39ba-3313-893a-b35d9838e671",
                                                "text": "“Then my father died. He left me very badly off. I had to go and live with some old aunts in Yorkshire.” She shuddered. “You will understand me when I say that it was a deadly life for a girl brought up as I had been. The narrowness, the deadly monotony of it, almost drove me mad.”"
                                            },
                                            {
                                                "example_id": "b9805f3d-90a0-4d9b-b99d-74881f8e9f2d",
                                                "sense_id": "c331fe5c-39ba-3313-893a-b35d9838e671",
                                                "text": "Now, at school, I was forced to sit in classes, to take notes and exams, to use textbooks that were flat, impersonal, deadly."
                                            },
                                            {
                                                "example_id": "17e9c7eb-0002-4f1f-8ff7-29a7718ae61a",
                                                "sense_id": "c331fe5c-39ba-3313-893a-b35d9838e671",
                                                "text": "Students, of course, know the difference between a deadly lecture and a stimulating one. An excellent lecturer who maintains a high level of interaction with the audience stimulates thinking and learning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "241ca72e-728d-3ccd-ba34-3cb597a95499",
                                        "entry_id": "66c7b983-0f29-37c1-923e-40f4bf89af09",
                                        "glosses": [
                                            "Excellent, awesome, cool."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Newfoundland",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deadly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b844fd6c-629d-3ed8-9217-cef456969d6b",
                                        "entry_id": "98fdfae9-de03-31d1-8d61-de45a00a8b9c",
                                        "glosses": [
                                            "Fatally, mortally."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "775a4e8c-c627-4e3d-996e-78499d014e39",
                                                "sense_id": "b844fd6c-629d-3ed8-9217-cef456969d6b",
                                                "text": "[P]erceiving himſelfe deadly wounded by a ſhot received in his body, being by his men perſwaded to come off and retire himſelfe from out the throng, anſwered, he would not now ſo neere his end, beginne to turne his face from his enemie[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f112629-9e03-30bb-bf7d-d6f2cea8f8f4",
                                        "entry_id": "98fdfae9-de03-31d1-8d61-de45a00a8b9c",
                                        "glosses": [
                                            "In a way which suggests death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a06c84b-0e17-460f-b348-83b5f78eebb2",
                                                "sense_id": "4f112629-9e03-30bb-bf7d-d6f2cea8f8f4",
                                                "text": "Her face suddenly became deadly white."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f0f17c-692a-35a8-b5d0-6280f53b936a",
                                        "entry_id": "98fdfae9-de03-31d1-8d61-de45a00a8b9c",
                                        "glosses": [
                                            "Extremely, incredibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "648106eb-9013-45b0-bfc9-2df987ec1d15",
                                                "sense_id": "c7f0f17c-692a-35a8-b5d0-6280f53b936a",
                                                "text": "Though deadly weary, till ſpectators do / At once part and call them good boys too[…]"
                                            },
                                            {
                                                "example_id": "4fbbab8e-9549-4df3-a11d-970bbabef1a3",
                                                "sense_id": "c7f0f17c-692a-35a8-b5d0-6280f53b936a",
                                                "text": "John had got an impreſſion that Lewis was ſo deadly cunning a man, that he was afraid to venture himſelf alone with him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
