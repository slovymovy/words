                        "tags": [],
                        "examples": [
                            {
                                "example_id": "521947e4-1f7e-4ab4-9783-6f617b442800",
                                "sense_id": "8b8de782-b640-31e9-9797-7f4ea4f065ef",
                                "text": "„Sie könnten nun Unterstützung aus Österreich bekommen, wo die neue Rechtskoalition ein härtere Gangart beim Thema Flüchtlinge will.“"
                            },
                            {
                                "example_id": "a1375ca6-f684-42bf-99e7-b66873513f21",
                                "sense_id": "8b8de782-b640-31e9-9797-7f4ea4f065ef",
                                "text": "„In der armen Region im Süden steht der Sieg der von Salvini dominierten Rechtskoalition laut Umfragen bereits so gut wie fest.“"
                            },
                            {
                                "example_id": "12fa5e5a-6d3e-4ef7-b0c2-2984f3ed9074",
                                "sense_id": "8b8de782-b640-31e9-9797-7f4ea4f065ef",
                                "text": "„Der Freistaat wurde fortan von einer bürgerlichen Rechtskoalition regiert, vielfach toleriert durch die NSDAP.“"
                            },
                            {
                                "example_id": "a6880f66-6f7e-4710-8c52-9fd8d90e8b7a",
                                "sense_id": "8b8de782-b640-31e9-9797-7f4ea4f065ef",
                                "text": "„Nach der Reichstagswahl von 1884, die mit Verlusten der Linksliberalen und deutlichen Gewinnen der konservativen Parteien sowie leichten Zuwächsen der Nationalliberalen endete, schien eine Rechtskoalition möglich zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
