                ],
                "senses": [
                    {
                        "sense_id": "523ee066-9180-3a1b-8eb2-41119bf8103d",
                        "entry_id": "0aebf58c-897e-3de5-9a35-ea6fda716117",
                        "glosses": [
                            "een op waarheid beruste film"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c68484-7d12-4f24-90ff-8bc36b53a05f",
                                "sense_id": "523ee066-9180-3a1b-8eb2-41119bf8103d",
                                "text": "Op National Geographic worden veel documentaires uitgezonden."
                            },
                            {
                                "example_id": "a92d9e37-86dd-47ff-84b5-845f064a7ee0",
                                "sense_id": "523ee066-9180-3a1b-8eb2-41119bf8103d",
                                "text": "Ze houdt zelf ook veel van langdurige wandelingen, maar had totaal geen behoefte om samen met mij dit verre avontuur in de wildernis aan te gaan. We keken het jaar voorafgaand aan mijn vertrek vaak samen naar documentaires over de PCT en ze verheugde zich erop om via mij een halfjaar door Amerika mee te lopen, maar dan wel veilig thuis op de bank."
                            },
                            {
                                "example_id": "6fb816f5-96c0-41a6-94e0-5d9c9e6b2b95",
                                "sense_id": "523ee066-9180-3a1b-8eb2-41119bf8103d",
                                "text": "Vandaag verschijnt op Videoland een documentaire over TMF. Daarin komt ook de schaduwkant van het succes naar voren. Verschillende vj's van toen zeggen dat ze een burn-out kregen van de lange werkweken die ze moesten maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "029a000f-8979-4928-96a1-fa9b2adace2e",
                        "source_entry_id": "0aebf58c-897e-3de5-9a35-ea6fda716117",
                        "source_sense_id": "523ee066-9180-3a1b-8eb2-41119bf8103d",
                        "source_sense_description": "een op waarheid beruste film",
                        "target_lang_word": "Dokumentarfilm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dokumentarfilm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                        "entry_id": "02b40c27-71a1-3f24-9d9e-97fc10c44197",
                                        "glosses": [
                                            "Film, der gedreht wurde, um ein bestimmtes Thema wirklichkeitsgetreu darzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f98829a-8837-48e2-a2dc-1c032da05106",
                                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                                "text": "„Einem polnischen Regisseur, der ihn auf Teneriffa besuchen wollte, um einen weiteren Dokumentarfilm über ihn zu drehen, ließ er ausrichten, er sei nicht mehr am Leben.“"
                                            },
                                            {
                                                "example_id": "34d1424b-f01c-4961-9492-52788491eb37",
                                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                                "text": "„Ärrälä steht am Steg und berichtet von dieser untergehenden Kultur, über die er einen Dokumentarfilm plant.“"
                                            },
                                            {
                                                "example_id": "59b21f8a-755f-4b15-9946-565da1f268d6",
                                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                                "text": "„Ein Bericht über die Vorführung dieser Dokumentarfilme und die Reaktion verschiedener deutscher Kultusminister findet sich ebenfalls in der Anlage zu diesem Bericht.“"
                                            },
                                            {
                                                "example_id": "3b128052-1160-45db-9de5-f475cd69c5fe",
                                                "sense_id": "ced3475e-cde5-3d34-bc61-806ff59d7017",
                                                "text": "„In Serien, Nachrichten-Beiträgen und Dokumentarfilmen guckt immer jemand weidwund in die Kamera, die Violinen spielen, es regnet, und man weiß sofort: Irgendwem ist Unrecht widerfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eefe8fa1-f81d-4550-8aa5-62d46e9be78a",
                        "source_entry_id": "0aebf58c-897e-3de5-9a35-ea6fda716117",
                        "source_sense_id": "523ee066-9180-3a1b-8eb2-41119bf8103d",
                        "source_sense_description": "een op waarheid beruste film",
                        "target_lang_word": "documentary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "documentary",
