                        "glosses": [
                            "Grand filet ou sorte de râteau de bois qui sert à la pêche du hareng."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0dcb93-c5f4-4fe9-8e54-fc36f468d915",
                                "sense_id": "623f8163-4494-31f8-bd99-8f98e05473a8",
                                "text": "Au moyen d'un instrument en bois nommé rèdre, on les enferme dans les baies : leur capture est ensuite des plus aisées. On prend également le hareng — mais en bien moins grande quantité — avec des filets de fond."
                            },
                            {
                                "example_id": "f6c3618b-3179-4e9f-9522-2712ba2488e4",
                                "sense_id": "623f8163-4494-31f8-bd99-8f98e05473a8",
                                "text": "Le filet pour pêcher le hareng était un \"rèdre\"."
                            }
                        ]
