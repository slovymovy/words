                                "target_senses": [
                                    {
                                        "sense_id": "4d278712-ceb4-3471-a5e8-f1a8745adda3",
                                        "entry_id": "a0d095ef-8b49-30f0-9486-10c9a427864b",
                                        "glosses": [
                                            "Prénom masculin."
