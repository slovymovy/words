                        "entry_id": "3decd750-44db-343a-bfed-4473805a24b0",
                        "glosses": [
                            "Mélange de vacances et de travail, alternés dans une même journée."
                        ],
                        "tags": [
                            "Anglicism",
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a5ee452c-eb01-4fd0-8ede-21fa81c564b2",
                                "sense_id": "18fe666f-12d6-3082-91a7-f1cf1d84b1c3",
                                "text": "Les actifs privés de congés y pratiquent le « workation », télescopage de work, « travail », et de vacation, « vacances » : ses hôtes s’attaquent aux vagues après avoir bouclé leurs dossiers dans l’espace de coworking, à grand renfort de café filtre et de cookies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f73a58cf-c056-4708-af9c-b29c40be85e0",
