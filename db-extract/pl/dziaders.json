                    {
                        "sense_id": "2677e402-c33c-3aea-a1c0-eff4cb780f3e",
                        "entry_id": "0192448d-3f5d-348b-950d-43ff2566e038",
                        "glosses": [
                            "mężczyzna w sile wieku, zwykle wpływowy, który traktuje kobiety lub młode osoby lekceważąco, protekcjonalnie, przedmiotowo, z poczuciem wyższości"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "78d72ebc-7489-4a19-863b-0ac3d6d8a1b6",
                                "sense_id": "2677e402-c33c-3aea-a1c0-eff4cb780f3e",
                                "text": "Dla politycznych dziadersów kobiety to kwiatek u kożucha umilający życie: „całujemy panie w rączki”, ale do władzy się oczywiście nie nadają, bo – jak wiadomo – ich macice wędrują, wpadają w histerię"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
