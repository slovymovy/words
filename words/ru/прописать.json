{
    "word_family": [
        "письмо",
        "писатель",
        "запись",
        "опись",
        "подпись",
        "расписка",
        "переписка",
        "письменный",
        "писать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bac8c095-5663-325a-98a0-25a6aec5349d",
                    "sense_definition": "Назначить лекарство или курс лечения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач <w>прописал</w> мне витамины для укрепления иммунитета.",
                            "target_lang_translations": {
                                "en": "The doctor <w>prescribed</w> me vitamins to strengthen my immune system."
                            }
                        },
                        {
                            "text": "Доктор <w>прописал</w> сильное лекарство от кашля.",
                            "target_lang_translations": {
                                "en": "The doctor <w>prescribed</w> strong cough medicine."
                            }
                        }
                    ],
                    "synonyms": [
                        "назначить"
                    ],
                    "common_phrases": [
                        "врач прописал"
                    ],
                    "target_lang_definitions": {
                        "en": "To prescribe medication or a course of treatment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prescribe",
                                "target_lang_sense_clarification": "to authorize the use of a medicine or treatment for someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fac93927-01da-3552-967a-f753166a1dbd",
                    "sense_definition": "Официально зарегистрировать место жительства человека в квартире или доме.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "registration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу <w>прописать</w> свою жену в нашей новой квартире.",
                            "target_lang_translations": {
                                "en": "I want to <w>register</w> my wife at our new apartment."
                            }
                        },
                        {
                            "text": "Владелец отказался <w>прописать</w> арендаторов в своей недвижимости.",
                            "target_lang_translations": {
                                "en": "The owner refused to <w>register</w> the tenants at his property."
                            }
                        }
                    ],
                    "synonyms": [
                        "зарегистрировать"
                    ],
                    "antonyms": [
                        "выписать"
                    ],
                    "common_phrases": [
                        "прописать в квартире"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially register a person's place of residence in an apartment or house."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "register",
                                "target_lang_sense_clarification": "to officially record someone as a resident at an address"
                            },
                            {
                                "target_lang_word": "sign up",
                                "target_lang_sense_clarification": "to enroll or record someone in a system"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f305c8-bfae-311e-ab7c-dc1cb80a6585",
                    "sense_definition": "Внести данные или настройки в компьютерную систему или документ.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <w>прописать</w> новый путь к файлу в настройках программы.",
                            "target_lang_translations": {
                                "en": "You need to <w>configure</w> the new file path in the program settings."
                            }
                        },
                        {
                            "text": "Программист <w>прописал</w> все необходимые команды в скрипте.",
                            "target_lang_translations": {
                                "en": "The programmer <w>wrote</w> all the necessary commands in the script."
                            }
                        }
                    ],
                    "synonyms": [
                        "внести",
                        "записать"
                    ],
                    "common_phrases": [
                        "прописать настройки"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter data or settings into a computer system or document."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "configure",
                                "target_lang_sense_clarification": "to set up or arrange settings in a system"
                            },
                            {
                                "target_lang_word": "input",
                                "target_lang_sense_clarification": "to enter data into a computer"
                            },
                            {
                                "target_lang_word": "write",
                                "target_lang_sense_clarification": "to record code or commands into a file"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a0da3e-5854-3fb6-95f3-3b0e157dfb4f",
                    "sense_definition": "Писать что-либо в течение определенного времени.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент <w>прописал</w> весь вечер, готовясь к экзамену по литературе.",
                            "target_lang_translations": {
                                "en": "The student <w>spent the whole evening writing</w> while preparing for the literature exam."
                            }
                        },
                        {
                            "text": "Писатель <w>прописал</w> несколько часов подряд, создавая новую главу романа.",
                            "target_lang_translations": {
                                "en": "The writer <w>spent several hours writing</w> in a row, creating a new chapter of the novel."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To write something for a specific period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "write",
                                "target_lang_sense_clarification": "to spend time engaged in the act of writing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}