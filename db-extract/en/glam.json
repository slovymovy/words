                        "glosses": [
                            "ความน่าตื่นเต้นหรือความมีเสน่ห์ใด ๆ ที่เกี่ยวข้องกับบุคคล สถานที่ หรือสิ่งของ, สิ่งที่ทำให้สิ่งใดสิ่งหนึ่งน่าดึงดูดใจ (จาก Glamour)"
                        ],
                        "tags": [],
