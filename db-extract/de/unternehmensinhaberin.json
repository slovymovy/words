                "senses": [
                    {
                        "sense_id": "99d1ec51-6beb-39cc-8210-060263a89fa6",
                        "entry_id": "6771dca0-d750-3a85-b2ad-7edd2d98cdef",
                        "glosses": [
                            "weibliche Person, die eine Firma, einen Betrieb besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87943fcb-52af-49fb-8dd6-e782e3f14f41",
                                "sense_id": "99d1ec51-6beb-39cc-8210-060263a89fa6",
                                "text": "„Ein weiterer wichtiger Faktor ist das Alter der Selbstständigen, sprich die Altersstruktur der Unternehmensinhaberinnen und -inhaber.“"
                            },
                            {
                                "example_id": "9b59f47b-5d53-4537-80ef-b4fb0b7f8ed7",
                                "sense_id": "99d1ec51-6beb-39cc-8210-060263a89fa6",
                                "text": "„Ein kleines Unternehmen, spezialisiert auf den Bau standardisierter Computergehäuse, beschäftigt neben der Unternehmensinhaberin zwanzig Mitarbeiter und Mitarbeiterinnen für Beschaffung, Produktion, Absatz und Buchhaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
