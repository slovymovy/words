                ],
                "senses": [
                    {
                        "sense_id": "8ac0e8d0-9217-3663-8b6e-02686b75cf9f",
                        "entry_id": "07b1e2e5-3ace-363f-81ab-3e72f8687579",
                        "glosses": [
                            "Person, die verstorben ist"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "26fcb90c-0861-4a04-951f-0266b68d5f97",
                                "sense_id": "8ac0e8d0-9217-3663-8b6e-02686b75cf9f",
                                "text": "[KZ Bergen-Belsen April 1945:] „Erst wenige Tage vor dem Eintreffen der Briten hatte sie mit ihrer Schwester auf Kommando der SS Verstorbene quer durchs Lager in ein Massengrab zerren müssen.“"
                            },
                            {
                                "example_id": "cc9bea5d-17c3-4e72-9cfc-e677ce6d61f4",
                                "sense_id": "8ac0e8d0-9217-3663-8b6e-02686b75cf9f",
                                "text": "Der Verstorbene wurde auf eigenem Wunsch eingeäschert."
                            },
                            {
                                "example_id": "7184de73-845a-49a8-a8ea-7bb18459ef48",
                                "sense_id": "8ac0e8d0-9217-3663-8b6e-02686b75cf9f",
                                "text": "„Die Verstorbenen endeten in jenen gewaltigen Hochmooren, die sich vor 2000 Jahren im germanischen Hinterland an der Nordseeküste erstreckten.“"
                            },
                            {
                                "example_id": "98988a61-db5a-4a86-8e15-d922ad315a75",
                                "sense_id": "8ac0e8d0-9217-3663-8b6e-02686b75cf9f",
                                "text": "„1836 wurden zwei Leichenschänder und Mörder gefasst, die in Ermangelung von natürlich Verstorbenen das medizinische Institut von Edinburgh illegal mit frischen Leichen versorgten.“"
                            },
                            {
                                "example_id": "a5c68493-f671-4e8b-a7b1-4b4d716c2097",
                                "sense_id": "8ac0e8d0-9217-3663-8b6e-02686b75cf9f",
                                "text": "„Dort wird, vor den Augen des Osiris, das Herz des Verstorbenen gewogen und ein Urteil über ihn gefällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
