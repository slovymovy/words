                        "cross_references": [
                            {
                                "target_word": "avantage en nature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25669fc4-d4fa-38b7-ae4c-32ad0b899a5a",
                                        "entry_id": "1f8a9fda-0a52-34f5-8ced-7313764b67b7",
                                        "glosses": [
                                            "Bien ou service que reçoit un salarié, un élu ou un fonctionnaire, en plus de sa rémunération et des primes éventuelles : véhicule de fonction, logement de fonction, frais de bouche, téléphone professionnel, etc."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d1b43e-d9b2-431e-8ee5-222409e6a75f",
                                                "sense_id": "25669fc4-d4fa-38b7-ae4c-32ad0b899a5a",
                                                "text": "Les avantages en nature font partie intégrante de la rémunération du salarié et sont soumis à cotisations sociales et à l’impôt sur le revenu, ils doivent donc obligatoirement faire l’objet d’une évaluation financière."
                                            },
                                            {
                                                "example_id": "22ea5ba3-dec8-4a8e-84de-33a0b8fb0a59",
                                                "sense_id": "25669fc4-d4fa-38b7-ae4c-32ad0b899a5a",
                                                "text": "Mis en examen pour corruption pour avoir touché une commission présumée de 199 000 euros en marge d’une vente d'hélicoptères au Kazakhstan, Aymeri de Montesquiou, ancien représentant spécial du président Sarkozy en Asie centrale, a aussi reçu des avantages en nature d’Eurocopter et avait deux comptes à l’étranger."
                                            },
                                            {
                                                "example_id": "ab78d230-6068-4b98-bf88-966c351c92ac",
                                                "sense_id": "25669fc4-d4fa-38b7-ae4c-32ad0b899a5a",
                                                "text": "Selon les enquêteurs portugais, Armando Pereira avait aussi imposé une série de prestataires « amis » qui, en retour, lui reversaient de l’argent ou des avantages en nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
