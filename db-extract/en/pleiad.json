                                    {
                                        "sense_id": "f59d9b62-e2e8-3f2a-ad33-6e5f0be823e1",
                                        "entry_id": "95902b12-6980-3165-8614-4f44907a446e",
                                        "glosses": [
                                            "σύνολο ανθρώπων με συγκεκριμένη ιδιότητα, θετικού χαρακτήρα συνήθως"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc7e790-67f7-4a02-beac-7ad816e2dce8",
                                                "sense_id": "f59d9b62-e2e8-3f2a-ad33-6e5f0be823e1",
                                                "text": "μια πλειάδα καλλιτεχνών συμμετέχει στο φεστιβάλ"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e3aed4-19d6-32b1-8405-9ff8dfadb608",
                                        "entry_id": "95902b12-6980-3165-8614-4f44907a446e",
                                        "glosses": [
                                            "ομάδα ποιητών και φιλολόγων"
                                        ],
                                        "tags": [
                                            "φιλολογία"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd49b0c3-cf13-3215-b042-0bfef800b244",
                                        "entry_id": "95902b12-6980-3165-8614-4f44907a446e",
                                        "glosses": [
                                            "Αλεξανδρινή Πλειάδα: σύμφωνα με τον Αλεξανδρινό κανόνα την Πλειάδα αποτελούσαν οι επτά τραγικοί ποιητές που άκμασαν επί Πτολεμαίου Β' του Φιλάδελφου, από τους οποίους και ονομάσθηκε και τραγική πλειάδα. Την ομάδα αυτή αποτελούσαν οι: Σωσιφάνης ο Συρακόσιος, ο Σωσίθεος ο Συρακόσιος ή Αθηναίος, ο Όμηρος Βυζάντιος, ο Λυκόφρων ο Χαλκιδεύς, ο Αλέξανδρος ο Αιτωλός, ο Φιλίσκος ο Κερκυραίος και ο Διονυσιάδης ή Διονυσίδης"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40c8bc91-c3bc-3dcb-b410-3878cd37b582",
                                        "entry_id": "95902b12-6980-3165-8614-4f44907a446e",
                                        "glosses": [
                                            "πεπερασμένη διατεταγμένη ακολουθία ν στοιχείων, όπου ν είναι ένας μη αρνητικός ακέραιος. Συμβολίζεται με τα στοιχεία της να περικλείονται μέσα σε παρενθέσεις «(...)» και χωρίζονται με κόμμα."
                                        ],
                                        "tags": [
                                            "μαθηματικά"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "326a9892-e115-4188-bec3-d427754f193a",
                                                "sense_id": "40c8bc91-c3bc-3dcb-b410-3878cd37b582",
                                                "text": "Με την πλειάδα (x, y) παριστάνεται ένα σημείο στον δισδιάστατο χώρο, με την (x, y, z) στον τρισδιάστατο, (x, y, z, t) στον τετραδιάστατο, κλπ."
                                            },
                                            {
                                                "example_id": "f8403b5a-ad5e-4ed2-a53c-147fdb4599d9",
                                                "sense_id": "40c8bc91-c3bc-3dcb-b410-3878cd37b582",
                                                "text": "βλέπε Πλειάδα (μαθηματικά) στη Βικιπαίδεια"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "977ce6f1-f9d2-3c3d-911c-00e0f519872d",
                                        "entry_id": "95902b12-6980-3165-8614-4f44907a446e",
                                        "glosses": [
                                            "δομή δεδομένων, που περιέχει στοιχεία σε συγκεκριμένη αμετάβλητη σειρά και δηλώνεται με τα στοιχεία της να περιέχονται σε παρενθέσεις «(...)» και χωρίζονται με κόμμα (βλ. μαθηματικό ορισμό)"
                                        ],
                                        "tags": [
                                            "πληροφορική"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca69fee1-64c1-3e90-8e02-b30e16f128e6",
                                        "entry_id": "95902b12-6980-3165-8614-4f44907a446e",
                                        "glosses": [
                                            "η γραμμή μιάς σχέσης στο σχεσιακό μοντέλο ή ενός πίνακα στις σχεσιακές βάσεις δεδομένων. Τα στοιχεία της, λέγονται γνωρίσματα (attributes) και αποτελούν τις στήλες του πίνακα. Ο όρος πλειάδα χρησιμοποιείται κυρίως στη θεωρία της επιστήμης των υπολογιστών."
                                        ],
                                        "tags": [
                                            "βάσεις δεδομένων"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095d52f4-2888-421c-8b60-c4818819a0e3",
                                                "sense_id": "ca69fee1-64c1-3e90-8e02-b30e16f128e6",
                                                "text": "Οι πλειάδες μιας σχέσης διαφέρουν υποχρεωτικά μεταξύ τους"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
