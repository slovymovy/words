                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symmetry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e46c96f7-7f07-311a-9298-9bf41153c443",
                                        "entry_id": "86c653d8-9f74-3562-8c60-228d2f6ddc37",
                                        "glosses": [
                                            "Exact correspondence on either side of a dividing line, plane, center or axis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0041ae7-bac0-3cf1-9afe-da55d6b2e8c8",
                                        "entry_id": "86c653d8-9f74-3562-8c60-228d2f6ddc37",
                                        "glosses": [
                                            "The satisfying arrangement of a balanced distribution of the elements of a whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fad1d85-b175-46c2-89a6-62f035fecc3a",
                                                "sense_id": "f0041ae7-bac0-3cf1-9afe-da55d6b2e8c8",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b7b018f-5ef5-473f-b896-b5f9e19e6094",
                        "source_entry_id": "fb5ec4d4-cb69-3e0b-9cd5-e6ccc210c698",
                        "source_sense_id": "de0f02ad-ac91-3e28-a489-eb07a71041c7",
                        "target_lang_word": "symétrie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symétrie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3daa4851-ba8d-3a22-910c-1d87bed0ee74",
                                        "entry_id": "7211eff0-5e8d-3d2e-9e19-a766e260381e",
                                        "glosses": [
                                            "Correspondance de grandeur, de forme et de position que les parties d’un corps naturel ou artificiel ont entre elles et avec leur tout. Ces parties sont généralement réparties autour d’un axe de symétrie définissant une symétrie orthogonale. Mais il existe aussi des symétries non axiales : symétrie centrale, ou symétrie oblique par exemple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b977da6b-bbb5-4005-8ab3-06a2699eb99a",
                                                "sense_id": "3daa4851-ba8d-3a22-910c-1d87bed0ee74",
                                                "text": "Les symétries des ordres d’architecture ont été fixées par différents maîtres."
                                            },
                                            {
                                                "example_id": "61c30e86-8b2c-40d1-b7ba-9ec04970d1b4",
                                                "sense_id": "3daa4851-ba8d-3a22-910c-1d87bed0ee74",
                                                "text": "La symétrie est bien observée dans cet ouvrage d’architecture."
                                            },
                                            {
                                                "example_id": "054dcfac-7b94-48b2-bc3f-1a9fab0c15f7",
                                                "sense_id": "3daa4851-ba8d-3a22-910c-1d87bed0ee74",
                                                "text": "Cela est contre la symétrie."
                                            },
                                            {
                                                "example_id": "f3280d9d-4d1b-47b8-9950-252c14ac1ea8",
                                                "sense_id": "3daa4851-ba8d-3a22-910c-1d87bed0ee74",
                                                "text": "La symétrie du corps humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                        "entry_id": "7211eff0-5e8d-3d2e-9e19-a766e260381e",
                                        "glosses": [
                                            "Arrangement des choses suivant un certain ordre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df1ac75-af53-4621-9105-d632715a0528",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "La symétrie se retrouve au cœur du perlage. Les artisans doivent, à mesure que leur création prend forme, compter les perles. La symétrie est importante tant pour créer des médaillons que des cordons."
                                            },
                                            {
                                                "example_id": "0f90280d-c3ec-49e0-a5e5-777212c9fea7",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Des tableaux, des vases arrangés avec symétrie."
                                            },
                                            {
                                                "example_id": "77945153-7536-4d94-b83b-871c7e95f628",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "La symétrie d’une plantation."
                                            },
                                            {
                                                "example_id": "ea3fce13-446e-4f14-843b-0f3e7fa76086",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Il faut de la symétrie."
                                            },
                                            {
                                                "example_id": "c59997eb-1084-439b-80fa-7df47ad17112",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Négliger la symétrie."
                                            },
                                            {
                                                "example_id": "5b40c648-0db4-43cf-b3af-9ab685377889",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Déranger la symétrie."
                                            },
                                            {
                                                "example_id": "daf9dd72-882e-4b29-81b3-131fcb69a845",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Garder, observer la symétrie."
                                            },
                                            {
                                                "example_id": "a5dcba03-2fba-42d9-b7d5-7e2fe1850993",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Pour la symétrie, il faut mettre un tableau en pendant de celui-ci."
                                            },
                                            {
                                                "example_id": "b59dd8d8-0350-4f7c-83be-8385b771a8d8",
                                                "sense_id": "f9a7e168-a3ce-3d1a-ad7c-e071ef8a3c27",
                                                "text": "Pascal parle de ceux qui font de fausses fenêtres pour la symétrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea9587c5-9608-33b0-ae3f-cc48458859a7",
                                        "entry_id": "7211eff0-5e8d-3d2e-9e19-a766e260381e",
                                        "glosses": [
                                            "Ordre, disposition, économie d’un discours, d’un ouvrage de l’esprit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
