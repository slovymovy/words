                "senses": [
                    {
                        "sense_id": "d1965fe3-7178-3883-bfa6-6447fc2729e2",
                        "entry_id": "838c88b4-e7f5-3c9b-9881-49fa2a90e9e7",
                        "glosses": [
                            "een rijgkoord of rijgsnoer om delen van kledingstukken, schoeisel, zeilen ed. vaak tijdelijk en min of meer strak, aan elkaar te rijgen."
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "91b7384b-42ef-470b-82f1-75786adeb55d",
                                "sense_id": "d1965fe3-7178-3883-bfa6-6447fc2729e2",
                                "text": "De eindjes van een veter zijn meestal verhard, of zijn voorzien van veterstiften of maliën, zodat ze gemakkelijk door de nestelgaten zijn te steken en niet uitrafelen tot een “kwast”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df91a9bb-a412-4050-ac5e-1e9737c7d47c",
                        "source_entry_id": "838c88b4-e7f5-3c9b-9881-49fa2a90e9e7",
                        "source_sense_id": "d1965fe3-7178-3883-bfa6-6447fc2729e2",
                        "target_lang_word": "Schnürsenkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnürsenkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2fa3f0-b09b-3928-955a-34aaa104ae0e",
                                        "entry_id": "9436dd5e-d51e-31fd-83e1-4033ce49ce9b",
                                        "glosses": [
                                            "Schnüre zum Binden von Schuhen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0947913d-1805-45a7-9e72-0dad8850a172",
                                                "sense_id": "3f2fa3f0-b09b-3928-955a-34aaa104ae0e",
                                                "text": "„Wie lange man als Junge brauchte, konnte Mama sich nicht vorstellen, weil sie Röcke trug und Schuhe ohne Schnürsenkel anhatte.“"
                                            },
                                            {
                                                "example_id": "5119e337-9cf9-44d9-a842-fac9c9914735",
                                                "sense_id": "3f2fa3f0-b09b-3928-955a-34aaa104ae0e",
                                                "text": "Deine Schnürsenkel sind offen."
                                            },
                                            {
                                                "example_id": "8fc7c3f3-fdf9-404b-bef1-e8195305b78a",
                                                "sense_id": "3f2fa3f0-b09b-3928-955a-34aaa104ae0e",
                                                "text": "„Dort hielt er inne, um zu Atem zu kommen und seine Schnürsenkel fester zuzubinden.“"
                                            },
                                            {
                                                "example_id": "8fa4fa46-10e6-4290-b0a5-8e7555105bf6",
                                                "sense_id": "3f2fa3f0-b09b-3928-955a-34aaa104ae0e",
                                                "text": "„Er trug Militärstiefel ohne Schnürsenkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b48a3db1-4b5d-4967-b69c-a7447e3909cd",
                        "source_entry_id": "838c88b4-e7f5-3c9b-9881-49fa2a90e9e7",
