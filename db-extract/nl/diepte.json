                "senses": [
                    {
                        "sense_id": "cb89cf96-17f3-3506-985c-378a87fa39f6",
                        "entry_id": "b7658708-9a5c-37c3-8562-a3c5d3b39849",
                        "glosses": [
                            "de mate waarin iets diep is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fda0947-238d-4bf8-970e-2e7483d5fba0",
                                "sense_id": "cb89cf96-17f3-3506-985c-378a87fa39f6",
                                "text": "De diepte van dat zwembad is twee meter."
                            },
                            {
                                "example_id": "3956f205-9d28-4127-96e0-58bab96aa1a4",
                                "sense_id": "cb89cf96-17f3-3506-985c-378a87fa39f6",
                                "text": "De cirkel had zijn eigen perspectief, zodat het leek alsof hij diepte had, alsof de vrouw op de bodem van een waterput lag."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5fc0802-9277-3560-996d-85c7c2969b7b",
                        "entry_id": "b7658708-9a5c-37c3-8562-a3c5d3b39849",
                        "glosses": [
                            "bijzonder laag gelegen plaats, gewoonlijk onder de waterspiegel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6d4be3-3cfa-431d-aea6-5099c6ae45da",
                                "sense_id": "d5fc0802-9277-3560-996d-85c7c2969b7b",
                                "text": "De reuzenpijlinktvis is een bewoner van de diepten van de oceaan."
                            },
                            {
                                "example_id": "9aef303a-1eb6-40f1-9e08-54d580510bd1",
                                "sense_id": "d5fc0802-9277-3560-996d-85c7c2969b7b",
                                "text": "Toen we boven op de berg waren zagen we het dorpje in de diepte liggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cce4f378-e364-37f0-a59b-f81d2dbe20a1",
                        "entry_id": "b7658708-9a5c-37c3-8562-a3c5d3b39849",
                        "glosses": [
                            "geestelijke, emotionele diepgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0660f7-8dd6-4335-8ed5-30e4edbec21c",
                                "sense_id": "cce4f378-e364-37f0-a59b-f81d2dbe20a1",
                                "text": "Zo hoef je niet na te denken, laat staan af te zakken naar de diepte waar woorden niet nodig zijn."
                            }
                        ]
                    }
                ],
