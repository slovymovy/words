    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6b24a958-03b3-3aff-a41e-6af5a0a24bbc",
                    "sense_definition": "zich bevinden rondom een bepaalde plaats of een bepaald object",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>omringende</w> dorpen hebben veel last van de wateroverlast door de zware regenval.",
                            "target_lang_translations": {
                                "en": "The <w>surrounding</w> villages suffer greatly from flooding due to the heavy rainfall."
                            }
                        },
                        {
                            "text": "In de <w>omringende</w> landen is de wetgeving op dit gebied veel strenger dan hier.",
                            "target_lang_translations": {
                                "en": "In the <w>neighboring</w> countries, the legislation in this area is much stricter than here."
                            }
                        }
                    ],
                    "synonyms": [
                        "omliggend",
                        "naburig"
                    ],
                    "common_phrases": [
                        "omringende landen",
                        "omringende natuur",
                        "omringende bebouwing"
                    ],
                    "target_lang_definitions": {
                        "en": "located around a specific place or object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surrounding",
                                "target_lang_sense_clarification": "located all around something"
                            },
                            {
                                "target_lang_word": "neighboring",
                                "target_lang_sense_clarification": "situated nearby or adjacent"
                            },
                            {
                                "target_lang_word": "ambient",
                                "target_lang_sense_clarification": "relating to the immediate surroundings"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76ebbbd5-a14e-31c6-a105-97dabdafbb92",
                    "sense_definition": "onvoltooid deelwoord van <w>omringen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten hielden de stad <w>omringend</w> in de gaten terwijl ze op bevelen wachtten.",
                            "target_lang_translations": {
                                "en": "The soldiers kept watch while <w>surrounding</w> the city as they waited for orders."
                            }
                        },
                        {
                            "text": "Al <w>omringend</w> door fans probeerde de zanger zijn auto te bereiken na het concert.",
                            "target_lang_translations": {
                                "en": "While being <w>surrounded</w> by fans, the singer tried to reach his car after the concert."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordig deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'to surround', describing an ongoing action of encircling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surrounding",
                                "target_lang_sense_clarification": "the act of encircling or being around"
                            },
                            {
                                "target_lang_word": "encircling",
                                "target_lang_sense_clarification": "forming a circle around"
                            }
                        ]
                    }
                }
            ]
        }
