                        "glosses": [
                            "In a mournful manner; as if in mourning for something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187e7d9c-b6c5-4cad-bca2-bfdbbe1ff278",
                                "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                "text": "1836, Hans Christian Andersen (translated into English by Mrs. H. B. Paull in 1872), The Little Mermaid\n\"Why have not we an immortal soul?\" asked the little mermaid mournfully; \"I would give gladly all the hundreds of years that I have to live, to be a human being only for one day, and to have the hope of knowing the happiness of that glorious world above the stars.\""
                            },
                            {
                                "example_id": "13303ef9-e055-41b9-988e-d339e6006f90",
                                "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                "text": "The steamer itself had vanished, but the great scroll of smoke still hung in the air and drooped like a flag mournfully in valediction."
                            },
                            {
                                "example_id": "18bd6c3c-ed4f-4373-9a08-82ff0c52fc3e",
                                "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                "text": "So she dared not tell anyone how she felt, but went about mournfully, with a heavy heart."
                            }
                        ]
                    }
                ],
