                                        "sense_id": "5010f0bf-47b4-35c2-8616-a8ac663297f5",
                                        "entry_id": "064e3d17-0bc5-395a-9044-c1c3437e55f1",
                                        "glosses": [
                                            "A strong aromatic heterocyclic base, triaminotriazine, used in combination with formaldehyde to manufacture melamine resins; any such resin, such as Formica"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377afee7-2572-465e-bbe1-f4c2d314bef6",
                                                "sense_id": "5010f0bf-47b4-35c2-8616-a8ac663297f5",
                                                "text": "My room was everything I expected it to be—cold and cheerless, with melamine furniture, grubbily matted carpet and those mysterious ceiling stains that bring to mind a neglected corpse in the room above."
                                            },
                                            {
                                                "example_id": "c3b7af62-5251-4983-8a6f-ba9c74909c3b",
                                                "sense_id": "5010f0bf-47b4-35c2-8616-a8ac663297f5",
                                                "text": "The interior melamine panels were designed to be easily removable for repair or future refurbishment, and the linoleum floor was for easy cleaning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
