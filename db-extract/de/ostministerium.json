                ],
                "senses": [
                    {
                        "sense_id": "636057f8-3832-38a9-9323-665892d62882",
                        "entry_id": "f8a5bab0-3662-3ec1-9daa-86b5ba0f148f",
                        "glosses": [
                            "Behörde, die für die Zivilverwaltung der von der deutschen Wehrmacht besetzten Gebiete im Baltikum und der Sowjetunion zuständig war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "84b973ed-9b1a-45e0-b273-0026fc525b2b",
                                "sense_id": "636057f8-3832-38a9-9323-665892d62882",
                                "text": "„Die Kritik, die er am Ostministerium übt, ist allzu berechtigt; aber sie kommt so spät, daß sie kaum noch eine Wirkung ausüben könnte.“"
                            },
                            {
                                "example_id": "3453f3b6-7390-4538-8b19-703fba7642e6",
                                "sense_id": "636057f8-3832-38a9-9323-665892d62882",
                                "text": "„In Briefen von Rosenberg und Meyer werden unsere Vorschläge auf Zusammenarbeit mit dem Ostministerium ziemlich abgelehnt.“"
                            },
                            {
                                "example_id": "17e77c70-a168-4ae1-8e25-b8e4cad83a51",
                                "sense_id": "636057f8-3832-38a9-9323-665892d62882",
                                "text": "„Sie hatten ihr Projekt gemeinsam mit dem ‚Obmann für Russland-Vorhaben‘ und engem Mitarbeiter Ritterbuschs, John Boyens, sowie dem RSHA und dem Ostministerium geplant.“"
                            },
                            {
                                "example_id": "d623ffc6-6ae2-4c1b-8cb0-690ec9d3b588",
                                "sense_id": "636057f8-3832-38a9-9323-665892d62882",
                                "text": "„Die DZO war die wichtigste deutsche Tageszeitung im RKO und lose mit dem Ostministerium verbunden.“"
                            },
                            {
                                "example_id": "98ad7d9d-5e0e-4cf0-954e-e7cf2b978a93",
                                "sense_id": "636057f8-3832-38a9-9323-665892d62882",
                                "text": "„Aus dieser Einstellung heraus wurde eine Reihe von Männern ins Ostministerium, als Generalkommissare – abgesehen von Reichskommissar Lohse – und Gebietskommissare eingesetzt, deren SS-feindliche Haltung von vornherein festlag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
