                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b247752a-3026-4fdc-9ff4-02c18756f66f",
                                "sense_id": "4c9a22f3-e755-369d-bd34-138b1dd84743",
                                "text": "„Nichtdestotrotz hielt ich an meinem Plan fest - wenn auch etwas zwanghaft -, vor den Festtagen nach Mirocaw zu fahren, weil ich hoffte, dadurch die Wucht meines jahreszeitlich bedingten Depressionsschubs zu verringern.“"
                            },
                            {
                                "example_id": "3cc2d485-bbe0-4dcc-8565-afd62bf8fe3f",
                                "sense_id": "4c9a22f3-e755-369d-bd34-138b1dd84743",
                                "text": "„Ihm zur Seite steht der gleichaltrige, für ein robustes Amt noch weniger geeignete Erzähler Karl Benno von Mechow, der durch Depressionsschübe immer wieder ausfällt.“"
                            }
                        ],
