                    {
                        "sense_id": "5c1ede2e-f942-3551-a49a-6d29df093a0f",
                        "entry_id": "c38ea390-696d-3054-9685-24032d19029e",
                        "glosses": [
                            "schwache Person ohne eigene Meinung"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "02867796-d6f5-48a7-b25a-7447c872742c",
                                "sense_id": "5c1ede2e-f942-3551-a49a-6d29df093a0f",
                                "text": "„»Und wenn die glauben, dass du ein Laumann bist, dann bekommst du nichts.«“"
                            },
                            {
                                "example_id": "fecffc56-25a1-456c-b929-0c7ba1b11982",
                                "sense_id": "5c1ede2e-f942-3551-a49a-6d29df093a0f",
                                "text": "„»Die Punks, die's heute gibt, das sind alles Laumänner. Die kannste angucken, das sind alles Pfeifen, die ham mit früher gar nix mehr zu tun.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
