                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ccb675-5bd1-4431-8465-458fa4c162a0",
                                "sense_id": "2e832454-dde8-3b2a-99f8-ac7d1694ab34",
                                "text": "„Die Reichshauptstadt erlebte in den ersten beiden Augustwochen 1941 noch einmal das Hochgefühl der Siegesgewissheit.“"
                            },
                            {
                                "example_id": "64546bd7-bad7-4ac6-b57b-f5adc0ce2b56",
                                "sense_id": "2e832454-dde8-3b2a-99f8-ac7d1694ab34",
                                "text": "„Die im Bunker aufgekeimte Zuversicht, einen Lidschlag lang fast schon wieder zur Siegesgewissheit verdichtet, verflog so rasch, wie sie aufgeflammt war.“"
                            },
                            {
                                "example_id": "2760fe28-2711-443e-8854-8f9a991e7650",
                                "sense_id": "2e832454-dde8-3b2a-99f8-ac7d1694ab34",
                                "text": "„Die ganze Familie und die ganze Stadt taumelte in Siegesgewissheit und Kaiserstolz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
