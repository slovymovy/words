                    {
                        "form_id": "07e2bb32-d9f9-4ee7-b7f1-bacf4ca11d23",
                        "entry_id": "c14abda7-9e83-396e-9c0c-3047c97761a6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Riß"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9f6b2e3-7a10-32b9-a477-7b223f3463f3",
                        "entry_id": "c14abda7-9e83-396e-9c0c-3047c97761a6",
                        "glosses": [
                            "Steilhang am Mittelgebirgsplateau Mansfelder Platte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47efbac3-e4a2-453a-8722-fe5509979174",
                                "sense_id": "b9f6b2e3-7a10-32b9-a477-7b223f3463f3",
                                "text": "„Am Steilhang Riß zwischen Wormsleben und Seeburg liegt das nördlichste Weinanbaugebiet Deutschlands.“"
                            },
                            {
                                "example_id": "2a93978d-cfc7-4d43-9a07-0e6103bd4d1b",
                                "sense_id": "b9f6b2e3-7a10-32b9-a477-7b223f3463f3",
                                "text": "„Das Dorf liegt 800 m nördlich von Lüttchendorf am Fuß des Riß, einem Steilhang.“"
                            },
                            {
                                "example_id": "53750b26-d721-4446-81cb-9277f1597306",
                                "sense_id": "b9f6b2e3-7a10-32b9-a477-7b223f3463f3",
                                "text": "„Am Steilhang Riß zwischen Wormsleben und ►Seeburg am Süßen See liegt das nördlichste Weinanbaugebiet Deutschlands.“"
                            },
                            {
                                "example_id": "5d27a068-e633-47fa-be51-4de6547707c6",
                                "sense_id": "b9f6b2e3-7a10-32b9-a477-7b223f3463f3",
                                "text": "„Sie ist, ähnlich der größeren Querfurter Platte im Süden, ein nur ca. 200m hohes Mittelgebirgsplateau und wird begrenzt durch das Saale- und das Salzatal im Osten, den Steilhang Riß, beziehungsweise die Eislebener Niederung im Süden und den Mansfelder Grund, den Regenbeck […] und das Tal der Wipper […].“"
                            },
                            {
                                "example_id": "b771550b-d65f-412f-bb05-6c2c7ab8ecb9",
                                "sense_id": "b9f6b2e3-7a10-32b9-a477-7b223f3463f3",
                                "text": "„Das Riß bei Wormsleben. Das Riß ist ein Steilhang im Landkreis Mansfeld-Südharz in Sachsen-Anhalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
