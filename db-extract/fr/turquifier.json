                "senses": [
                    {
                        "sense_id": "843028d3-a5e4-39e5-be71-e2635c361476",
                        "entry_id": "80a2c256-7b64-3170-805f-a376371a96ff",
                        "glosses": [
                            "Donner un caractère turc à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939c89f2-377e-44ce-823b-4d907ca5c025",
                                "sense_id": "843028d3-a5e4-39e5-be71-e2635c361476",
                                "text": "Etes- vous de ceux que nous n'avons pu turquifier ?"
                            },
                            {
                                "example_id": "13169c1f-95dd-4883-899f-0a5ae9428f17",
                                "sense_id": "843028d3-a5e4-39e5-be71-e2635c361476",
                                "text": "Un représentant du gouvernement vint pour rassembler et amener avec lui tous les enfants qui voulaient bien se turquifier."
                            },
                            {
                                "example_id": "50389137-26ab-4108-a47c-3d066a23253d",
                                "sense_id": "843028d3-a5e4-39e5-be71-e2635c361476",
                                "text": "Une poignée d'Arméniens de Malatya, aux noms turquifiés, osent désormais se revendiquer chrétiens."
                            }
                        ]
                    }
