                "senses": [
                    {
                        "sense_id": "7fa07324-a198-392c-bd53-4b9ce2f36a9b",
                        "entry_id": "eae57b58-c1bd-3f3d-b1e9-6a51e39daa9c",
                        "glosses": [
                            "Gebäude oder Haus, in dem gebacken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e437a4-db61-431f-8f4a-0e6caa630c9a",
                                "sense_id": "7fa07324-a198-392c-bd53-4b9ce2f36a9b",
                                "text": "Am Mittag schloss der Bäcker das Backhaus ab."
                            },
                            {
                                "example_id": "3c589f51-0a7c-40df-9cf0-1bf4acfb2c88",
                                "sense_id": "7fa07324-a198-392c-bd53-4b9ce2f36a9b",
                                "text": "„Im urigen Backhaus gab es selbstgebackenes Brot und in einer anderen Hütte köstlichen Rentierschinken und geräucherte Forellenfilets.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
