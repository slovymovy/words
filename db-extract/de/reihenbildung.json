                "senses": [
                    {
                        "sense_id": "536c3529-30fe-3acb-9903-e1eef7c121ae",
                        "entry_id": "f6a3a967-17d6-3235-9bba-2bd292c48836",
                        "glosses": [
                            "Bildung einer Menge gleich strukturierter Wörter (Ableitungen oder Komposita) mit demselben Wortteil (Affixoid oder lexikalische Konstituente)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f10c1ee3-d963-40a1-a98f-dc8144aee72a",
                                "sense_id": "536c3529-30fe-3acb-9903-e1eef7c121ae",
                                "text": "„Reihenbildung lässt sich sowohl für den ersten als auch für den zweiten Bestandteil konstatieren.“"
                            },
                            {
                                "example_id": "b112e696-dbc6-4b2b-a077-7dd69c769766",
                                "sense_id": "536c3529-30fe-3acb-9903-e1eef7c121ae",
                                "text": "„Außer der semantischen Spezifik werden als weitere, im einzelnen unterschiedlich ausgeprägte Merkmale der Affixoide Reihenbildung, eine charakteristische Distribution, komplementäres Zusammenwirken mit Wortbildungsmorphemen und ein besonderes ‚phonologisches Verhalten‘ genannt(…)“"
                            }
                        ],
