                "senses": [
                    {
                        "sense_id": "313ea933-39f6-3cdf-a3ea-25895417f046",
                        "entry_id": "53d65978-9405-3c0c-960b-d877682b7bcf",
                        "glosses": [
                            "Verhältnis von durchschnittlicher Ausbringungsmenge zum Arbeitseinsatz pro Periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f4efa8-0305-4dc6-ad6c-60d8c2c2d4eb",
                                "sense_id": "313ea933-39f6-3cdf-a3ea-25895417f046",
                                "text": "„Die Arbeitsproduktivität (je geleisteter Erwerbstätigenstunde) stieg in der Bundesrepublik Deutschland von 1970 bis 2000 im Jahresdurchschnitt um 3,0% an, die Gesamtproduktivität erhöhte sich demgegenüber pro Jahr um durchschnittlich 2,2%.“"
                            },
                            {
                                "example_id": "147f8b45-0d07-40ed-a470-98586ba52e72",
                                "sense_id": "313ea933-39f6-3cdf-a3ea-25895417f046",
                                "text": "„Hungersnöte haben häufig lang währende wirtschaftliche und soziale Folgen: u. a. starke Preissteigerungen (insbesondere für Lebensmittel), großräumige Bevölkerungsverluste (auch durch Ab- und Auswanderung), Rückgang des Bevölkerungswachstums, sinkende Arbeitsproduktivität, soziale Unruhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
