                "senses": [
                    {
                        "sense_id": "a8ac8e8d-c01e-3395-92ef-855a37a7a5f7",
                        "entry_id": "9ec6830e-3944-38f8-9ca3-1d208fd5e07f",
                        "glosses": [
                            "Mittel und Geräte, die zum Putzen bestimmt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d3d264-6084-4573-ac56-03d071fbc0d8",
                                "sense_id": "a8ac8e8d-c01e-3395-92ef-855a37a7a5f7",
                                "text": "Das Putzzeug umfasst eigentlich alles, was man zum Putzen benötigt."
                            },
                            {
                                "example_id": "bf1dff08-c414-4f54-ad1c-60ba45eeed8a",
                                "sense_id": "a8ac8e8d-c01e-3395-92ef-855a37a7a5f7",
                                "text": "Übliche Aufbewahrungsorte für das Putzzeug sind unter der Abwasch und in der Besenkammer."
                            },
                            {
                                "example_id": "31c465ca-692b-4e54-a7c2-6773d3ca9c67",
                                "sense_id": "a8ac8e8d-c01e-3395-92ef-855a37a7a5f7",
                                "text": "[D]ie Geschichte der Prinzessin […] wäre in Vergessenheit gerathen, wenn nicht […] der treue Dienstmann […] zur Feder gegriffen und die Ereignisse […] niedergeschrieben hätte. Es war allerdings eine Hand, die besser den Pferdestriegel und das Putzzeug für Schwert und Schild, als das Schreibwerkzeug zu führen verstand."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
