                                        "examples": [
                                            {
                                                "example_id": "3f608da0-4181-448e-9374-586222ef579a",
                                                "sense_id": "56686017-4ac7-3dcc-a29d-cba0b23636f5",
                                                "text": "The slayer also lay,\nThe terrible earth-drake deprived of life,\nOppressed by bale: the ring-hoard longer\nThe twisted worm, might not control."
