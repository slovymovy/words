                                "target_senses": [
                                    {
                                        "sense_id": "6c0feebd-7ca8-3187-bb2d-27bdacc17503",
                                        "entry_id": "2903399f-f4ce-319d-9d36-baf868e78880",
                                        "glosses": [
                                            "Ouvrier qui monte des pierres fines, des pièces d’orfèvrerie, de machines, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b6ebc2-b8cf-466c-a4f2-9c2c01e542a9",
                                                "sense_id": "6c0feebd-7ca8-3187-bb2d-27bdacc17503",
                                                "text": "Fils d’un ouvrier pauvre, Martial était presque devenu, à force de travail et d’économie, un ouvrier riche. Son père était monteur en bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf8a372-80ad-30ff-a03d-f023b98d5f46",
                                        "entry_id": "2903399f-f4ce-319d-9d36-baf868e78880",
                                        "glosses": [
                                            "Celui qui est en charge d’assembler bout à bout plusieurs plans, issus du tournage, pour, lors du montage, former des séquences qui formeront à leur tour un film."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6819bf2-a919-4fc1-b0e6-0481707862ac",
                                                "sense_id": "9bf8a372-80ad-30ff-a03d-f023b98d5f46",
                                                "text": "Mis au point dans les années 1980, le montage virtuel est non linéaire et permet de placer n’importe quel plan dans n’importe quel ordre sans que le monteur soit obligé de revoir chronologiquement toutes les séquences montées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
