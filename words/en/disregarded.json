                    "frequency": "Middle",
                    "semantic_group_id": "ignored",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disregarded</w> garden was full of weeds and overgrown bushes.",
                            "target_lang_translations": {
                                "nl": "De <w>verwaarloosde</w> tuin stond vol onkruid en overwoekerde struiken."
                            }
                        },
                        {
                            "text": "Many <w>disregarded</w> historical buildings are now being restored by the city.",
                            "target_lang_translations": {
                                "nl": "Veel <w>verwaarloosde</w> historische gebouwen worden nu door de stad gerestaureerd."
                            }
                        }
                    ],
                    "synonyms": [
                        "neglected",
                        "abandoned"
                    ],
                    "antonyms": [
                        "cared-for",
                        "maintained"
                    ],
                    "target_lang_definitions": {
