                ],
                "senses": [
                    {
                        "sense_id": "4f93e0d2-dcea-3077-a93a-6c5bdea47416",
                        "entry_id": "c61d9292-6210-3296-8d62-81e03cb360fe",
                        "glosses": [
                            "Laden, der alkoholische Getränke verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09da8592-05e3-4fb1-ba5f-aedaccd3ca99",
                                "sense_id": "4f93e0d2-dcea-3077-a93a-6c5bdea47416",
                                "text": "„Plötzlich überquerte Thoss die Straße und ging in ein unbezeichnetes Backsteingebäude zwischen einem Spirituosenladen und einer Reparaturwerkstatt.“"
                            },
                            {
                                "example_id": "43e9a3ef-8db4-479b-a74d-17580757bf9c",
                                "sense_id": "4f93e0d2-dcea-3077-a93a-6c5bdea47416",
                                "text": "„Eines Abends im Fireman's Arms hatte er mal erklärt, wenn man sämtliche Polizisten und Journalisten für eine Woche auf Robbeneiland einsperren würde, könnten die Kneipen und Spirituosenläden am Kap dichtmachen.“"
                            },
                            {
                                "example_id": "68000d6d-e9cd-4d53-babd-2910edcf2581",
                                "sense_id": "4f93e0d2-dcea-3077-a93a-6c5bdea47416",
                                "text": "„Er kommt an einem Spirituosenladen vorbei, in dem er manchmal nach der Arbeit eine Flasche Wein für sich und Lara zum Abendessen gekauft hat.“"
                            },
                            {
                                "example_id": "4843bba0-1b7e-4d4d-b003-42483bdde4b7",
                                "sense_id": "4f93e0d2-dcea-3077-a93a-6c5bdea47416",
                                "text": "„Mir kam die Idee bei unserem letzten Spirituosenladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
