            {
                "entry_id": "e9cdf738-3ae4-395b-af05-3cb2ae1c40be",
                "word": "maraudeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5cf2029-152c-400d-8793-e87ddf2d3e75",
