                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                        "entry_id": "d5f9227a-e547-317e-a489-313bffc7fbcd",
                                        "glosses": [
                                            "das Verhalten einer Person bemängeln, kritisieren, etwas nicht gutheißen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0737e63f-105c-401c-9e05-0109b1b5311a",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "Der Lehrer tadelt seine Schüler, weil sie die Vokabeln nicht beherrschen."
                                            },
                                            {
                                                "example_id": "4a279a2f-6334-423e-960c-caefb0683a91",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "Wieso tadelst du mich mit erhobenem Finger? Ich habe überhaupt nichts Verwerfliches getan."
                                            },
