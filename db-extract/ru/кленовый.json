                "senses": [
                    {
                        "sense_id": "fcbe3364-fd93-3cc8-bd00-5232d4ee816e",
                        "entry_id": "327bb43b-12e1-37c7-b131-f9d34930d96b",
                        "glosses": [
                            "maple"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "09dbfea4-6782-4385-a1f0-cecbb71ec725",
                                "sense_id": "fcbe3364-fd93-3cc8-bd00-5232d4ee816e",
                                "text": "клено́вый сиро́п",
                                "translation": "maple syrup",
                                "english": "maple syrup"
                            },
                            {
                                "example_id": "3db89d01-dace-4172-88f8-0db2379433e6",
                                "sense_id": "fcbe3364-fd93-3cc8-bd00-5232d4ee816e",
                                "text": "клено́вый лист",
                                "translation": "maple leaf",
                                "english": "maple leaf"
                            },
                            {
                                "example_id": "552db4cf-4ccb-48f8-a13e-7507f1056e01",
                                "sense_id": "fcbe3364-fd93-3cc8-bd00-5232d4ee816e",
                                "text": "— Посмотри́, — сказа́л вдруг Арка́дий, — сухо́й клено́вый лист оторва́лся и па́дает на зе́млю; его́ движе́ния соверше́нно схо́дны с полётом ба́бочки. Не стра́нно ли? Са́мое печа́льное и мёртвое — схо́дно с са́мым весёлым и живы́м.",
                                "translation": "\"Look,\" said Arkady suddenly, \"a dry maple leaf has broken off and is falling to the ground; its movements are exactly like a butterfly's flight. Isn't it strange? Such a gloomy dead thing so like the most care-free and lively one.\"",
                                "english": "\"Look,\" said Arkady suddenly, \"a dry maple leaf has broken off and is falling to the ground; its movements are exactly like a butterfly's flight. Isn't it strange? Such a gloomy dead thing so like the most care-free and lively one.\""
                            }
                        ]
                    }
