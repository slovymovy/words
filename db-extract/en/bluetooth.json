                                "target_senses": [
                                    {
                                        "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                        "entry_id": "558fc950-ea38-3b6d-ad83-3c9062c95a61",
                                        "glosses": [
                                            "Ensemble de protocoles utilisant une technologie radio courte distance, destiné à simplifier les connexions entre les appareils électroniques."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e7890d7-26c7-4986-b9d1-f542931197d9",
                                                "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                                "text": "Un monde nouveau / On en rêvait tous / Eh, que savions nous faire de nos mains ? / Zéro / Attraper le bluetooth"
                                            },
                                            {
                                                "example_id": "fd5a4bb4-1cba-4c65-af62-8cc6fe96cd34",
                                                "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                                "text": "« Tout un courant s’est développé depuis quinze-vingt ans, la “technostalgie”, une manière d’innover à partir des technologies du passé », explique l’experte, citant les walkmans Bluetooth, les applications qui permettent de filmer à la manière d’une VHS et autre machine à écrire USB."
                                            },
                                            {
                                                "example_id": "64b7c570-a7b6-40d1-b5d2-cf0ded49372e",
                                                "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                                "text": "En balade, une fois son micro débranché de sa prise minijack, l’appareil redevient un casque classique Bluetooth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39175a86-a9fa-4848-9d0b-3e9b6ebb0311",
                        "source_entry_id": "25d77a6e-9857-3efd-b9b1-6ef74b9d9f75",
