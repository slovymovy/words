                ],
                "senses": [
                    {
                        "sense_id": "469cc7c5-e1c8-300d-ba44-44b834ae8c19",
                        "entry_id": "7ce20c3b-7dfa-37f1-8633-7e89a89ec387",
                        "glosses": [
                            "(ausziehbare) Stange, an deren Ende ein Smartphone oder eine Kamera befestigt werden kann, um damit ein Foto von sich selbst (ein Selfie) zu machen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5efe94bc-0fd4-4174-b8f2-5d047f3408fa",
                                "sense_id": "469cc7c5-e1c8-300d-ba44-44b834ae8c19",
                                "text": "Ein Selfiestick wirkt wie eine Armverlängerung und hilft dabei, Fotos von sich zu schießen."
                            },
                            {
                                "example_id": "a0fdcda5-8202-4e86-bcd4-db1237eeb8d7",
                                "sense_id": "469cc7c5-e1c8-300d-ba44-44b834ae8c19",
                                "text": "„Selfiesticks sind schwer in Mode, zum Leidwesen von Freizeitparks und Museen. Sie haben Angst um die Sicherheit – und ihre Gemälde. Immer mehr Einrichtungen verbieten jetzt die langen Aluminiumstäbe.“"
                            },
                            {
                                "example_id": "27419077-a4a3-4252-a7f8-187f24e4793e",
                                "sense_id": "469cc7c5-e1c8-300d-ba44-44b834ae8c19",
                                "text": "„Am Nebentisch sitzen drei Asiaten mit drei Smartphones, die sie an Selfiesticks befestigt haben und nun hintereinander ihre Bilder auf eine externe Festplatte überspielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16399d4b-4001-43be-8c5f-c768030090d5",
                        "source_entry_id": "7ce20c3b-7dfa-37f1-8633-7e89a89ec387",
                        "source_sense_id": "469cc7c5-e1c8-300d-ba44-44b834ae8c19",
                        "target_lang_word": "selfie stick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selfie stick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                        "entry_id": "54d83f53-06c4-300a-acc4-505b00cd39d0",
                                        "glosses": [
                                            "An extendable monopod arm onto which a smartphone or camera can be mounted in order to take wide-angle photographs of oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bcc26e4-313e-4acf-b22b-627882049eb7",
                                                "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                                "text": "For example, photography shop Artworkfoto in Funan DigitaLife Mall sells about five selfie sticks every day."
                                            },
                                            {
                                                "example_id": "40a38b00-f583-4fea-8217-6946ec867739",
                                                "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                                "text": "We snapped another selfie (one of the guys, Royston out of our newly acquired Singapore Zopim office, introduced the Exchange to the selfie stick, and that photo is now legendary.)"
                                            },
                                            {
                                                "example_id": "ff798c72-60a8-48d9-bed7-a5099e2fb291",
                                                "sense_id": "f15f5caa-f0ac-3c2f-9eff-47202f8ec102",
                                                "text": "The needs of selfie takers feed into new product development such as a selfie stick that allows the ul-jang angle, a mirrorless DSLR camera with a 180-degree tilting LCD window, a motion-detecting shutter, and a camera with wireless internet for transferring images."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
