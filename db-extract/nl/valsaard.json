                        "sense_id": "f0a1401d-f4c6-3458-9ee2-a0bdde57210e",
                        "entry_id": "3e482e0d-a9fe-390a-9690-8522e0cf9273",
                        "glosses": [
                            "iemand die liegt en bedriegt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e018b31d-019f-4500-88a2-a19fa9dfddbf",
                                "sense_id": "f0a1401d-f4c6-3458-9ee2-a0bdde57210e",
                                "text": "Toen waren ze nog met drie: Annelies, Eline en Davey. Eén van hen is de verrader en kruipt vanavond uit zijn molshoop. Wie is volgens u de valsaard van dit vriendenclubje?"
                            },
                            {
                                "example_id": "cb481670-f693-40c1-9503-61fd3344a7e8",
                                "sense_id": "f0a1401d-f4c6-3458-9ee2-a0bdde57210e",
                                "text": "Vraag op café, op familiefeesten, op het werk of op sociale media wie de mol is en je kan er je hoofd om verwedden: 'big Baha' is dé valsaard van dit seizoen."
                            },
                            {
                                "example_id": "e8656cc9-2edc-4682-ab86-b697babaf459",
                                "sense_id": "f0a1401d-f4c6-3458-9ee2-a0bdde57210e",
                                "text": "Bariton Wiebe-Pier Cnossen als directeur is een vileine valsaard."
                            }
                        ]
                    }
                ],
