                "senses": [
                    {
                        "sense_id": "98903c44-7144-3d84-943a-b563ec4fe87c",
                        "entry_id": "f75ddc6e-d333-3de6-a46a-2b8d246d6188",
                        "glosses": [
                            "Gebäude, worin eine Universität (oder ein Teil davon) ansässig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5fcbb0-81a7-46a1-a6a7-07d3a8857bd0",
                                "sense_id": "98903c44-7144-3d84-943a-b563ec4fe87c",
                                "text": "„Aktivisten der Aktion \"Früh aufwachender Studenten\" sowie Bürger, die sie unterstützen, forderten zugleich vor dem Universitätsgebäude die Auflösung des Parlaments und Neuwahlen.“"
                            },
                            {
                                "example_id": "14f4e464-feb3-4e4e-9f41-773cf2e684ae",
                                "sense_id": "98903c44-7144-3d84-943a-b563ec4fe87c",
                                "text": "„Beim Zürcher Universitätsgebäude benutzte Moser denn auch sakrale Bauformen.“"
                            },
                            {
                                "example_id": "f3d9e7e6-f15c-4ba0-a44b-71c016b6ba8a",
                                "sense_id": "98903c44-7144-3d84-943a-b563ec4fe87c",
                                "text": "„In einem Universitätsgebäude in Odessa hat sich ein verheerendes Feuer ausgebreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
