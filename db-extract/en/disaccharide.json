                                    {
                                        "sense_id": "866ee4d5-63e7-34ab-bc75-16d15aa6e951",
                                        "entry_id": "47cf0eb0-3965-330f-9e39-1a42f78dd01a",
                                        "glosses": [
                                            "eine Verbindung aus zwei Monosacchariden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d5dcbb-f65d-4ce0-b7ff-8020188cf0e8",
                                                "sense_id": "866ee4d5-63e7-34ab-bc75-16d15aa6e951",
                                                "text": "Das wirtschaftlich wichtigste Disaccharid ist der Rohrzucker."
                                            },
                                            {
                                                "example_id": "c697c893-4c30-4731-adf3-f9fb268010e3",
                                                "sense_id": "866ee4d5-63e7-34ab-bc75-16d15aa6e951",
                                                "text": "„Der wichtigste Vertreter der Disaccharide ist die als Haushaltszucker bekannte Saccharose.“"
                                            },
                                            {
                                                "example_id": "cf8d1723-21bd-41a1-a8cd-339fe08622f4",
                                                "sense_id": "866ee4d5-63e7-34ab-bc75-16d15aa6e951",
                                                "text": "„Disaccharidase ist ein Enzym, das Disaccharide in Monosaccharide spalten kann.“"
                                            },
                                            {
                                                "example_id": "8b64d9fc-56c2-4798-a468-41506b76cf15",
                                                "sense_id": "866ee4d5-63e7-34ab-bc75-16d15aa6e951",
                                                "text": "„Man unterscheidet einfache, nicht weiter spaltbare Monosaccharide (z. B. Traubenzucker, Fruchtzucker) und Disaccharide, die aus zwei Monosacchariden zusammengesetzt sind (z. B. Rohrzucker, Rübenzucker, Milchzucker, Malzzucker).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
