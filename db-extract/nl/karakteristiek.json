                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf36a532-b711-3c62-86e9-8a2b25cb46d1",
                        "entry_id": "c361f899-7ae3-3fd1-8372-e22a763b6fb0",
                        "glosses": [
                            "kenmerkend, tekenend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00752137-8989-43d4-916c-38ab467ca1ca",
                                "sense_id": "cf36a532-b711-3c62-86e9-8a2b25cb46d1",
                                "text": "Rijke en belastingschuwe politieke vluchtelingen hebben namelijk een voor deze groep karakteristiek probleem, dat verder niet zo gebruikelijk is onder politieke vluchtelingen."
                            },
                            {
                                "example_id": "f558ea5c-1e08-4f16-9257-87e7e317eee4",
                                "sense_id": "cf36a532-b711-3c62-86e9-8a2b25cb46d1",
                                "text": "Regenwormen, haring en de lindeboom zijn zomaar een paar typisch Nederlandse natuurverschijnselen. Vijftig van dit soort karakteristieke soorten planten en dieren staan in de eerste Canon van de Nederlandse natuur, die vandaag verschijnt."
                            }
                        ]
                    }
