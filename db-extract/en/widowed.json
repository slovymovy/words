                        "glosses": [
                            "Whose spouse has died or is gone missing; who has become a widow or widower."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "69e53f61-f185-4b31-8023-0d999edff544",
                                "sense_id": "c23a6c92-821d-3702-b166-930af7f75f8b",
                                "text": "I can't remember if I cried when I read about his widowed bride."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6872fbba-8abb-43da-8592-3a6f2c7584bb",
