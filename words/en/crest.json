                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the iliac <w>crest</w> of the patient's hip.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел подвздошный <w>гребень</w> бедра пациента.",
