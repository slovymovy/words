                                                "example_id": "ee069804-95ae-40b3-9f4d-4888e2c6efc7",
                                                "sense_id": "27ab1be7-ba7b-3734-8bd4-7c1efea1bfb6",
                                                "text": "¡Ay! Si el gavilán se comiera,\n¿verdad señor? como se come al ganao'.\nSi el gavilán se comiera,\noiga compadre, como se come al ganao',\nyo ya me hubiera comio' al gavilán colorao'."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32f00657-8d7e-48d6-a541-935d124404dc",
                        "source_entry_id": "abca4ab3-96cc-35b1-9431-41931180e42f",
                        "source_sense_id": "4b0c6b47-e85b-312a-904e-a9b9ff0ec6f8",
                        "target_lang_word": "Sperber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sperber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e55551c8-7c55-368e-b95e-3899f353b973",
                                        "entry_id": "98a1a891-f5e1-3645-9f26-faaca47780b2",
                                        "glosses": [
                                            "der kleinste deutsche Greifvogel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "074df2ee-6404-4eaf-921c-56bee2e09c8a",
                                                "sense_id": "e55551c8-7c55-368e-b95e-3899f353b973",
                                                "text": "Einmal täglich, nicht öfter, schoss der Sperber um die Hausecke und schlug einen der Spatzen in der Hecke."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adb9a65a-17c3-40b2-9447-2f7bce7e6f9a",
                        "source_entry_id": "abca4ab3-96cc-35b1-9431-41931180e42f",
                        "source_sense_id": "4b0c6b47-e85b-312a-904e-a9b9ff0ec6f8",
                        "target_lang_word": "ястреб-перепелятник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ястреб-перепелятник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "91d35cc3-0885-3085-bae4-134141db617f",
                                        "entry_id": "7bd75668-ad2c-32de-80f6-ce1ddfea3312",
                                        "glosses": [
                                            "орнитол. вид хищных птиц из семейства ястребиных; маленькая хищная птица с короткими и широкими крыльями и длинным хвостом, охотящаяся на перепелов и других небольших птиц (Accipiter nisus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940bf855-c9f8-46fa-af78-17094a69eec7",
                                                "sense_id": "91d35cc3-0885-3085-bae4-134141db617f",
                                                "text": "В высоте можно видеть вдоль высоких и низких гор орлов-беркутов, ястреба-перепелятника, а в глубине мрачных гор или утесов, как здесь выражаются, таятся филины."
                                            },
                                            {
                                                "example_id": "52bf5123-a526-40b6-849d-52b0db6fa742",
                                                "sense_id": "91d35cc3-0885-3085-bae4-134141db617f",
                                                "text": "Обилие мелких птиц привлекает на свалки и хищников: ястребов, соколов, сов. Из них наиболее частые гости: ушастая сова, ястреб-перепелятник, сокол-дербник, которых можно встретить и в больших городах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
