                        {
                            "text": "My grandmother makes a delicious peach <w>crisp</w> in the summer.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка готовит вкусный персиковый <w>крисп</w> летом.",
                                "zh": "我祖母夏天会做美味的<w>酥皮桃子派</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "apple crisp",
                        "peach crisp"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запеченный десерт из фруктов, покрытый крошкой из жира, муки и сахара.",
                        "zh": "一种烘焙甜点，由水果铺底，上面覆盖由油脂、面粉和糖混合而成的酥粒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крисп",
                                "target_lang_sense_clarification": "кулинарное блюдо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酥皮水果派",
                                "target_lang_sense_clarification": "一种甜点"
                            }
                        ]
                    }
                }
            ]
        },
        {
