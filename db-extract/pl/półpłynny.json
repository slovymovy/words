                                                "sense_id": "00ceee84-14c5-3b09-b0ed-8d116e1897ad",
                                                "text": "Coulée de laves semi-liquides."
                                            },
                                            {
                                                "example_id": "a2a2b3ae-4b74-452c-9d2f-cc99d5cebd08",
