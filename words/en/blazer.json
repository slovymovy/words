{
    "word_family": [
        "blaze",
        "blazing",
        "trailblazer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "017abbe7-abee-391d-8fc5-0dd16a7ae10d",
                    "sense_definition": "A semi-formal jacket, often worn as part of a uniform or for smart-casual occasions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a navy blue <w>blazer</w> with brass buttons to the wedding reception.",
                            "target_lang_translations": {
                                "ru": "На свадебный прием он надел темно-синий <w>блейзер</w> с латунными пуговицами."
                            }
                        },
                        {
                            "text": "The students are required to wear a school <w>blazer</w> during the winter months.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы студенты обязаны носить школьный <w>пиджак</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sport coat",
                        "sports jacket"
                    ],
                    "common_phrases": [
                        "school blazer",
                        "navy blazer",
                        "fitted blazer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полуформальный пиджак, часто носимый как часть униформы или для мероприятий в стиле смарт-кэжуал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блейзер",
                                "target_lang_sense_clarification": "спортивный или клубный пиджак"
                            },
                            {
                                "target_lang_word": "клубный пиджак",
                                "target_lang_sense_clarification": "часто с эмблемой или металлическими пуговицами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f732958-de4b-3583-830d-e4f6f3e93c72",
                    "sense_definition": "A person or thing that marks or cuts a route, such as by marking trees.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pathfinding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trail <w>blazer</w> left small notches in the bark to guide the following hikers.",
                            "target_lang_translations": {
                                "ru": "<w>Маркировщик</w> тропы оставлял небольшие зарубки на коре, чтобы направлять идущих следом туристов."
                            }
                        },
                        {
                            "text": "As a pioneer and <w>blazer</w> of new paths, she mapped out the entire valley.",
                            "target_lang_translations": {
                                "ru": "Как первопроходец и <w>создатель</w> новых путей, она нанесла на карту всю долину."
                            }
                        }
                    ],
                    "synonyms": [
                        "pioneer",
                        "pathfinder"
                    ],
                    "common_phrases": [
                        "trail blazer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который прокладывает или отмечает маршрут, например, делая зарубки на деревьях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первопроходец",
                                "target_lang_sense_clarification": "тот, кто прокладывает новый путь"
                            },
                            {
                                "target_lang_word": "маркировщик",
                                "target_lang_sense_clarification": "тот, кто ставит метки на тропе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ad8857-2953-3454-8356-a046c1d0110e",
                    "sense_definition": "Something that burns or glows intensely, such as a very bright fire or a hot object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The logs in the fireplace were a real <w>blazer</w>, heating the entire cabin in minutes.",
                            "target_lang_translations": {
                                "ru": "Поленья в камине горели <w>ярким пламенем</w>, согрев всю хижину за считанные минуты."
                            }
                        },
                        {
                            "text": "The sun was a real <w>blazer</w> today, making it impossible to stay outside for long.",
                            "target_lang_translations": {
                                "ru": "Солнце сегодня было настоящим <w>пеклом</w>, из-за чего на улице невозможно было долго находиться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "real blazer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что горит или светится очень интенсивно, например, яркий огонь или раскаленный предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яркое пламя",
                                "target_lang_sense_clarification": "сильный огонь"
                            },
                            {
                                "target_lang_word": "пекло",
                                "target_lang_sense_clarification": "об очень жарком солнце или предмете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092d8661-6d74-3600-a9ab-d78f2b7b6119",
                    "sense_definition": "A person who frequently smokes cannabis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a heavy <w>blazer</w> back in his college days.",
                            "target_lang_translations": {
                                "ru": "В студенческие годы он был известен как заядлый <w>травокур</w>."
                            }
                        },
                        {
                            "text": "The group of <w>blazers</w> gathered behind the building during the concert break.",
                            "target_lang_translations": {
                                "ru": "Группа <w>любителей покурить</w> собралась за зданием во время перерыва в концерте."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoner",
                        "pothead"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for a cannabis user"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который часто курит марихуану."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травокур",
                                "target_lang_sense_clarification": "сленг, потребитель каннабиса"
                            },
                            {
                                "target_lang_word": "любитель пыхнуть",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c43ada1a-415c-3717-b861-69e09fefce51",
                    "sense_definition": "An older, often conservative member of a sports club or committee.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The club <w>blazers</w> were resistant to changing the traditional dress code.",
                            "target_lang_translations": {
                                "ru": "<w>Старожилы</w> клуба сопротивлялись изменению традиционного дресс-кода."
                            }
                        },
                        {
                            "text": "He was a typical old <w>blazer</w>, spending his afternoons complaining about the new rules.",
                            "target_lang_translations": {
                                "ru": "Он был типичным <w>старым консерватором</w>, проводя свои дни за жалобами на новые правила."
                            }
                        }
                    ],
                    "common_phrases": [
                        "club blazer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used pejoratively in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пожилой, часто консервативный член спортивного клуба или комитета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старый консерватор",
                                "target_lang_sense_clarification": "о члене клуба, приверженном традициям"
                            },
                            {
                                "target_lang_word": "ретроград",
                                "target_lang_sense_clarification": "человек с устаревшими взглядами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc937dcc-2d69-35d4-abb7-4cd62c431ac3",
                    "sense_definition": "A deceptive trick, con, or swindle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swindler tried to run a <w>blazer</w> on the unsuspecting tourists at the station.",
                            "target_lang_translations": {
                                "ru": "Мошенник пытался провернуть <w>аферу</w> с ничего не подозревающими туристами на вокзале."
                            }
                        },
                        {
                            "text": "They realized too late that the investment opportunity was just a clever <w>blazer</w>.",
                            "target_lang_translations": {
                                "ru": "Они слишком поздно поняли, что эта инвестиционная возможность была лишь хитрым <w>надувательством</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swindle",
                        "con",
                        "hoax"
                    ],
                    "common_phrases": [
                        "run a blazer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic or regional slang for a scam"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманный трюк, афера или мошенничество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афера",
                                "target_lang_sense_clarification": "мошенническая схема"
                            },
                            {
                                "target_lang_word": "надувательство",
                                "target_lang_sense_clarification": "обман"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2f76e564-2755-3cb2-a15e-3b1ad1a27a75",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Mr. <w>Blazer</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа мистера <w>Блейзера</w>."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Blazer</w> family to discuss the property boundaries.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с семьей <w>Блейзер</w>, чтобы обсудить границы собственности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Блейзер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}