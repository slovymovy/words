                        "glosses": [
                            "Plante ornementale de la famille des labiées/lamiacées originaire des forêts tropicales de l'Afrique et de l'Asie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb647af-f4ea-4a15-b14b-c1b6308a0512",
                                "sense_id": "fd641151-db56-355d-b8bc-5b61721c95bc",
                                "text": "Me basant sur cette différence de température, je fis des boutures de chrysanthèmes et de coléus, dans les mêmes conditions et à très basse température."
                            },
                            {
                                "example_id": "191d3f97-b7f8-4828-a696-b58321daecd0",
                                "sense_id": "fd641151-db56-355d-b8bc-5b61721c95bc",
                                "text": "Je me souviens d’une au teint roux de coléus, aux yeux verts, aux deux joues rousses et dont la figure double et légère ressemblait aux graines ailées de certains arbres."
                            }
                        ]
                    }
