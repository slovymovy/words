                "senses": [
                    {
                        "sense_id": "185b7174-9b85-3bc9-8c31-014c3a894265",
                        "entry_id": "21d47d12-77d6-3a28-857e-9390ccaf2828",
                        "glosses": [
                            "Qui peut être déraciné, au propre et au figuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ac11a4-3e7c-43e3-a7ac-17f08016d268",
                                "sense_id": "185b7174-9b85-3bc9-8c31-014c3a894265",
                                "text": "Quant au Vétiver (andropogon muricatam) dont nous parlions plus haut, il abonde sur le sommet des dunes qui longent la mer et dès que le pied, facilement déracinable, a été desséché par le soleil, il répand dans l’atmosphère une odeur assez agréable."
                            },
                            {
                                "example_id": "e23a3c3a-f5c2-4787-ad81-a76c7e9c091a",
                                "sense_id": "185b7174-9b85-3bc9-8c31-014c3a894265",
                                "text": "Il fallait pour ces collets choisir un jeune arbre afin qu’il soit facilement déracinable par l’animal."
                            },
                            {
                                "example_id": "6d72330d-ddea-4d71-8d1c-46a5eb4629b9",
                                "sense_id": "185b7174-9b85-3bc9-8c31-014c3a894265",
                                "text": "On tente de réduire tout un chacun au statut de pion économique, déracinable et déporté au diable vauvert s’il le faut."
                            }
                        ]
                    }
                ],
