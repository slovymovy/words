                "senses": [
                    {
                        "sense_id": "245b6673-edab-3ea6-8e00-2d69ecacad15",
                        "entry_id": "9c7fcad1-6f7b-3f80-b0bc-39eed950c205",
                        "glosses": [
                            "Relatif à l’occidentalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f0b7fda-e7a8-4a07-b544-a037bbe2e163",
                                "sense_id": "245b6673-edab-3ea6-8e00-2d69ecacad15",
                                "text": "Bien que Nussbaum s’inscrive d’emblée dans un féminisme libéral plutôt que postcolonialiste, elle s’oppose à toute forme de paternalisme occidentaliste à l’égard des femmes et des populations qui partagent d’autres horizons culturels."
                            },
                            {
                                "example_id": "5db65091-b2b3-44f6-a146-5e6385b36748",
                                "sense_id": "245b6673-edab-3ea6-8e00-2d69ecacad15",
                                "text": "On est stupéfait de la manière dont le voyage de François Hollande aux États-Unis consacre une entente libérale, occidentaliste et militariste avec les dirigeants et le capital nord-américains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bebd8d2-5040-4615-9a78-3ca4b216f395",
                        "source_entry_id": "9c7fcad1-6f7b-3f80-b0bc-39eed950c205",
                        "source_sense_id": "245b6673-edab-3ea6-8e00-2d69ecacad15",
