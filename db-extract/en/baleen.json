                "senses": [
                    {
                        "sense_id": "e40cb91f-fa05-34ae-9682-1ff5660cf822",
                        "entry_id": "d45e2de3-9f11-368b-b4bd-61bb28e924d0",
                        "glosses": [
                            "keratinous material that makes up the plates in the mouth of the baleen whale (Mysticeti), which it uses to trap its food; formerly used in corsetry."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "97b54693-03ce-4874-8ced-ac648cab24e7",
                                "sense_id": "e40cb91f-fa05-34ae-9682-1ff5660cf822",
                                "text": "“You have probably never seen anything like this before, Mr. Toler. It is baleen, or if you prefer it, whalebone, taken from the mouth of the bowhead whale. It is used by the whale to filter its food.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf05e65-3d5b-362a-93fb-ed4d501d2c00",
                        "entry_id": "d45e2de3-9f11-368b-b4bd-61bb28e924d0",
                        "glosses": [
                            "A baleen whale (Mysticeti)."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c81cf01-e660-4515-b2bc-a44e0ee03344",
                                "sense_id": "fcf05e65-3d5b-362a-93fb-ed4d501d2c00",
                                "text": "Scammon estimates the number of baleens killed in the years 1835-72 at 131,000; once again, his figure needs to be adjusted."
                            }
                        ]
                    },
                    {
                        "sense_id": "e968c27c-e70f-329a-9333-609da3ba58bd",
                        "entry_id": "d45e2de3-9f11-368b-b4bd-61bb28e924d0",
                        "glosses": [
                            "A whale or other large fish."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "900e6993-657e-48a3-ac18-d1fbc2cad063",
                                "sense_id": "e968c27c-e70f-329a-9333-609da3ba58bd",
                                "text": "The Balene is a fishe great and huge, much like to the Whale, and is so called, because of his outcasting and shedding of water, for they throwe water higher then other great fishes of the sea."
                            }
                        ]
                    }
                ],
