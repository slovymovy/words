                "senses": [
                    {
                        "sense_id": "d7562e40-dd9b-3738-9f30-c201386904dd",
                        "entry_id": "0c373577-3ed4-30ee-a22f-b53aa8505627",
                        "glosses": [
                            "Redonner son caractère ukrainien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dea007b-30d5-4fc2-8951-079263a2c33b",
                                "sense_id": "d7562e40-dd9b-3738-9f30-c201386904dd",
                                "text": "L’aspect le plus connu de la crise est la chute, en 1972, de Pierre Chelest, puissant à Kiev et puissant à Moscou, et qui a sans aucun doute été éliminé pour avoir tenté de réukrainiser l’appareil politique de sa patrie."
                            },
                            {
                                "example_id": "76cf9af0-c6e5-4338-bf4a-2ac01fb17dca",
                                "sense_id": "d7562e40-dd9b-3738-9f30-c201386904dd",
                                "text": "Et de vouloir « réukrainiser » des territoires russifiés de force ou par le bas."
                            },
                            {
                                "example_id": "9a57216c-e93c-40d6-b920-049b67d34bef",
                                "sense_id": "d7562e40-dd9b-3738-9f30-c201386904dd",
                                "text": "En vue de réukrainiser les habitants des territoires occupés, les réinstaller dans les régions centrales ou occidentales de l’Ukraine."
                            }
                        ]
                    }
