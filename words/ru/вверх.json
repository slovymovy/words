                                "fr": "Il a lentement levé les mains <w>vers le haut</w>.",
                                "it": "Ha alzato lentamente le mani <w>in su</w>.",
                                "cs": "Pomalu zvedl ruce <w>vzhůru</w>.",
                                "tr": "Ellerini yavaşça <w>yukarı</w> kaldırdı.",
                                "es": "Él levantó lentamente las manos <w>hacia arriba</w>.",
                                "zh": "他慢慢地把手<w>向上</w>举起。"
