                        "entry_id": "16f33f3d-18e8-31f9-b8b5-66512abee7a3",
                        "glosses": [
                            "Bauernhof, bei dem alle Funktionen in einem Gebäude vereint sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2a7ca5-014b-4c9b-81fe-23984a6395f6",
                                "sense_id": "cead4685-ac7b-331a-a4a6-9d1c9b9e96b9",
                                "text": "„Der Thelenhof war, im Gegensatz zu den meisten Häusern in Winterspelt, kein Einhaus, sondern ein Winkelgehöft, das einen Hofraum bildete, der sich zwischen ihrem Fenster und dem Platz ausbreitete, in dem Dincklage stand.“"
                            },
                            {
                                "example_id": "c38c8332-de36-48f2-b68e-438386fcbcd7",
                                "sense_id": "cead4685-ac7b-331a-a4a6-9d1c9b9e96b9",
                                "text": "„In der Wiesenstraße, Haus-Nr. 9, befindet sich das einzige erhaltene Exemplar eines Odenwälder Einhauses im Dorf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
