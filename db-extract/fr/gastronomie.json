        "fr-extract.jsonl": [
            {
                "entry_id": "19a7e0fb-5c63-3172-9381-8d02da9b2c57",
                "word": "gastronomie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9268882-b14b-4536-9889-b44d0eb224b0",
                        "entry_id": "19a7e0fb-5c63-3172-9381-8d02da9b2c57",
                        "tags": [
                            "plural"
                        ],
                        "form": "gastronomies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "419a1d0f-3a23-314a-9964-4948d318b404",
                        "entry_id": "19a7e0fb-5c63-3172-9381-8d02da9b2c57",
                        "glosses": [
                            "Ensemble des règles qui constituent l’art de faire bonne chère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef21b11-1b14-4d93-86cf-b3c638ecf5dd",
                                "sense_id": "419a1d0f-3a23-314a-9964-4948d318b404",
                                "text": "Sommes-nous là dans le domaine de la gastronomie : peut-être pas tout à fait, mais au moins voilà qui réduit à néant l’image de pauvreté."
                            },
                            {
                                "example_id": "a19b575c-804f-4948-b766-f04e0860ac53",
                                "sense_id": "419a1d0f-3a23-314a-9964-4948d318b404",
                                "text": "Pour rester fidèle à la gastronomie du Sud-Ouest, les nouveaux partenaires choisissent d'élever le baeri (acipenser baeri), plutôt que d'importer des espèces plus connues."
                            },
                            {
                                "example_id": "8a358503-ab43-4be4-9d4c-decd765bc2c5",
                                "sense_id": "419a1d0f-3a23-314a-9964-4948d318b404",
                                "text": "La Nouvelle Cuisine, c'était un espoir, un dépoussiérage pour une gastronomie qui était rétrograde et cependant leader dans le monde."
                            },
                            {
                                "example_id": "998fc442-c5ce-401f-b471-6c7747f5003c",
                                "sense_id": "419a1d0f-3a23-314a-9964-4948d318b404",
                                "text": "Qui n'a jamais mangé un calendos comme ça avec un bon gros rouge ne connaît rien à la gastronomie. Allez, avant de retourner dans mon placard-palace, encore un petit gorgeon pour faire glisser le tout..."
                            }
                        ]
                    }
                ],
