                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zofia",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c968e0a-8d6b-3a36-9e1f-700d21fadd37",
                                        "entry_id": "eef6fd38-58c3-38d0-b30a-d6a01457e583",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a70e27-a9f4-46a8-a162-c7f24ba05644",
                                                "sense_id": "7c968e0a-8d6b-3a36-9e1f-700d21fadd37",
                                                "text": "Moja nauczycielka historii i wiedzy o społeczeństwie ma na imię Zofia."
                                            },
                                            {
                                                "example_id": "471037ae-316e-4070-a9a5-4ee687c98df7",
                                                "sense_id": "7c968e0a-8d6b-3a36-9e1f-700d21fadd37",
                                                "text": "Zofia Jagiellonka, królewna polska, była matką Albrechta Hohenzollerna, ostatniego wielkiego mistrza krzyżackiego."
                                            },
                                            {
                                                "example_id": "aafcf1e0-c86b-452b-a1e7-ffa857ab9b4c",
                                                "sense_id": "7c968e0a-8d6b-3a36-9e1f-700d21fadd37",
                                                "text": "W Kościele katolickim na 15 maja przypada wspomnienie św. Zofii z Rzymu, patronki chroniącej od szkód wyrządzonych w uprawach rolnych przez mróz."
                                            },
                                            {
                                                "example_id": "ea98f6b5-a4f2-43aa-b04f-a2cfc8530091",
                                                "sense_id": "7c968e0a-8d6b-3a36-9e1f-700d21fadd37",
                                                "text": "Zofie dzień swej patronki, czyli imieniny, obchodzą 15 maja, a także 30 września."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
