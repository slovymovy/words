                "senses": [
                    {
                        "sense_id": "7a3e74d5-fbd3-3a74-8122-76de9265f1b6",
                        "entry_id": "346d5fe6-8fc5-36d5-81d0-3a2695011753",
                        "glosses": [
                            "een mouwloze overal met gespen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce609f7-cd66-4f10-b044-f73d50016de1",
                                "sense_id": "7a3e74d5-fbd3-3a74-8122-76de9265f1b6",
                                "text": "Een tuinbroek werd in de jaren 1970 veel gedragen door geëmancipeerde vrouwen."
                            },
                            {
                                "example_id": "8be85f8f-a8ef-41a5-9885-f51739ceb3d0",
                                "sense_id": "7a3e74d5-fbd3-3a74-8122-76de9265f1b6",
                                "text": "Tijdens het liften naar het boerendorp Trout Lake, verscholen in de bergen van Washington, werd ik opgepikt door een vriendelijke, oude man in een versleten tuinbroek, houthakkersoverhemd en een pistool aan zijn riem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df62112b-1d0f-4ccb-ba49-a3e8de14d8c7",
                        "source_entry_id": "346d5fe6-8fc5-36d5-81d0-3a2695011753",
                        "source_sense_id": "7a3e74d5-fbd3-3a74-8122-76de9265f1b6",
                        "source_sense_description": "een mouwloze overal met gespen",
                        "target_lang_word": "Latzhose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Latzhose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "572e9d61-7f15-3ccc-8544-9eedf7b5b2e1",
                                        "entry_id": "d1c482bb-78af-3462-9677-45a41b8a5f74",
                                        "glosses": [
                                            "Hose mit einem Latz vor der Brust und Trägern; häufig als Arbeitskleidung getragen; in den 70er-Jahren Symbol der Alternativ- und Frauenbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f7a5ec-76fc-41ce-8e96-6db72a9d47c4",
                                                "sense_id": "572e9d61-7f15-3ccc-8544-9eedf7b5b2e1",
                                                "text": "„Ohne seine blaue Latzhose kann man sich Peter Lustig gar nicht vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "195f7663-94d5-484f-a86f-45ef3ee56c3d",
                        "source_entry_id": "346d5fe6-8fc5-36d5-81d0-3a2695011753",
                        "source_sense_id": "7a3e74d5-fbd3-3a74-8122-76de9265f1b6",
                        "source_sense_description": "een mouwloze overal met gespen",
                        "target_lang_word": "dungarees",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dungarees",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                        "entry_id": "b4bda94b-6c1e-3dce-bab3-64a29f99afc9",
                                        "glosses": [
                                            "Heavy denim pants or trousers, usually with bib and braces, worn especially as work clothing."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9c9c4a-c810-462b-8129-af59a109ff9c",
                                                "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                                "text": "Helen donned a pair of faded dungarees and grabbed her knapsack before rushing off to school."
                                            },
                                            {
                                                "example_id": "837f41d5-7b55-45c7-a9fc-179f26cdaec9",
                                                "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                                "text": "Next came a domeshaped sukhpal (palanquin), its silver plated pole being borne by eight sturdy troopers wearing red flowing kurtas, silk kamarbunds, and silk dungarees."
                                            },
                                            {
                                                "example_id": "c8f0268e-6efa-4b96-ab28-6296c60b797d",
                                                "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                                "text": "I’d arrived at Heaven nightclub, underneath the Charing Cross railway arches, on a hot Sunday afternoon to find my friends had already gone in – you didn’t risk hanging back and missing your chance – so I joined the queue of kids dressed in the acid house uniform of Day-Glo dungarees and smiley T-shirts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e032dcbc-b8d4-4037-a643-5da52ca3b92e",
                        "source_entry_id": "346d5fe6-8fc5-36d5-81d0-3a2695011753",
                        "source_sense_id": "7a3e74d5-fbd3-3a74-8122-76de9265f1b6",
                        "source_sense_description": "een mouwloze overal met gespen",
                        "target_lang_word": "salopette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salopette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5e26db-f87e-3029-a2d3-54e7a1c69e25",
                                        "entry_id": "7d00cca2-d928-332a-8af4-dd44093496b6",
                                        "glosses": [
                                            "Vêtement de travail, à plastron, qu’on porte par-dessus ses vêtements pour éviter de les salir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acca252f-913b-444e-8853-72ef05407729",
                                                "sense_id": "1c5e26db-f87e-3029-a2d3-54e7a1c69e25",
                                                "text": "Salopette de jardinier."
                                            },
                                            {
                                                "example_id": "e1f09b50-8d8d-4d1d-bfcb-8f1dba731015",
                                                "sense_id": "1c5e26db-f87e-3029-a2d3-54e7a1c69e25",
                                                "text": "[Il] portait des vêtements sales, une salopette en toile bleue unie et un bourgeron bleu rayé."
                                            },
                                            {
                                                "example_id": "b083e175-a968-4f42-9feb-8966a283b8c7",
                                                "sense_id": "1c5e26db-f87e-3029-a2d3-54e7a1c69e25",
                                                "text": "Dans ses moments chocs, quand elle retrouvait son accent bostonien, ne balayait pas la scène en hurlant ou en chantant une chanson pornographique, ne couvrait pas de peinture sa salopette en barbouillant un décor ou ne puait pas la colle à poisson après avoir posé des affiches sauvages, dans ses rares moments chics elle n’avait pas sa pareille pour snober un entreprenant raseur, jouer les idiotes devant un bas-bleu et dire une énormité comme ce « tu es sûr ? » avec un accent de sincérité difficile à mettre en doute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ccbee0d-fbd6-3c24-886d-c3191efcf8da",
                                        "entry_id": "7d00cca2-d928-332a-8af4-dd44093496b6",
                                        "glosses": [
                                            "Pantalon à bretelles et à plastron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d54f33ce-c7c5-4683-aa68-a4e43eec9b0d",
                                                "sense_id": "0ccbee0d-fbd6-3c24-886d-c3191efcf8da",
                                                "text": "Elle ne cherchait pas à se cacher. Mais comme elle était parfaitement immobile et portait une salopette d’un gris éteint, elle semblait faire partie du tronc auquel elle s’appuyait."
                                            },
                                            {
                                                "example_id": "cba595be-9920-4979-a317-ba8c994a61e4",
                                                "sense_id": "0ccbee0d-fbd6-3c24-886d-c3191efcf8da",
                                                "text": "Pendant quelques secondes, ils restèrent debout à m’examiner : Stefania, sorte d’apparition en salopette violette, et Leonie dans un énorme manteau de fourrure, un improbable gin tonic à la main."
                                            },
                                            {
                                                "example_id": "d5d2c1f6-a67e-437d-8d7d-5d5aab33db5d",
                                                "sense_id": "0ccbee0d-fbd6-3c24-886d-c3191efcf8da",
                                                "text": "Un tapissier… Ce n’est pas la peine de s’imaginer des scénarios tordus délirants avec des gendarmes ultra-sexys faisant une haie d’honneur, me présentant un homme torse nu en salopette sur un escabeau avec son couteau à maroufler dans la main droite et une rose entre les dents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
