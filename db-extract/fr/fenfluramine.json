                        "glosses": [
                            "Molécule synthétique (formule chimique C12H16F3N) utilisée comme anorexigène (coupe-faim)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048c47d4-9487-4e40-a530-fe60a2db339a",
                                "sense_id": "eb55dd7a-da0e-39f1-8435-2e8af72d2573",
                                "text": "Prototype des dérivés amphétaminiques anorexigènes, la fenfluramine a été retirée du marché français en 1997 car elle peut provoquer hypertension et valvulopathies."
                            },
                            {
                                "example_id": "cec0a173-8bb4-4fda-948c-ca4061c0ee72",
                                "sense_id": "eb55dd7a-da0e-39f1-8435-2e8af72d2573",
                                "text": "Commercialisé sous les deux appellations de Chaso Jianfei ou Chaso Genpi, un coupe-faim d’origine chinoise et présenté comme d’origine naturelle s’est avéré contenir en fait … de la fenfluramine, un dérivé amphétaminique interdit en France et aux Etats-Unis notamment."
                            }
                        ]
                    }
