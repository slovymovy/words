                "senses": [
                    {
                        "sense_id": "a6f29e09-8ac0-39d4-8202-a22e2642113b",
                        "entry_id": "75333ffd-cc42-3fad-9b18-8ae04d1430aa",
                        "glosses": [
                            "międzynarodowe, elitarne stowarzyszenie o specyficznych strukturach organizacyjnych, które swe pryncypia i idee wyraża za pośrednictwem rozbudowanej symboliki i rytuałów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deaee11a-fb14-4d8b-8762-abcc437ce1f7",
                                "sense_id": "a6f29e09-8ac0-39d4-8202-a22e2642113b",
                                "text": "W krajach katolickich i prawosławnych przynależność do masonerii była zakazana przez Kościoły, ponieważ uważano, że loże rozsiewają antyklerykalizm i relatywizm etyczny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
