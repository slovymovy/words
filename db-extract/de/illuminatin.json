                        "glosses": [
                            "weibliche Angehörige des Illuminatenordens, einer von 1776 bis 1785 in Bayern existierenden radikalaufklärerischen Geheimgesellschaft"
                        ],
                        "tags": [
                            "historical"
                        ],
