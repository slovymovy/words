                ],
                "senses": [
                    {
                        "sense_id": "0bc71cd0-35a1-3520-8f5c-52ad983654a9",
                        "entry_id": "fc804ed4-82f3-36af-b56c-fa39e39270f8",
                        "glosses": [
                            "Appareil ou outil pour rincer les bouteilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a5ebe2c-722d-4f06-8897-933ae099b802",
                                "sense_id": "0bc71cd0-35a1-3520-8f5c-52ad983654a9",
                                "text": "Le brevet d’invention de quinze ans, dont la demande a été déposée, le 5 mars 1859, au secrétariat de la préfecture du département de la Seine, par le sieur Herlin (Théophile), cultivateur, représenté par le sieur Beluze, à Paris, rue Baillet, nᵒ 3, pour un rince-bouteille hygiénique."
                            },
                            {
                                "example_id": "5994d91a-5a92-4664-b8f0-96fc08438988",
                                "sense_id": "0bc71cd0-35a1-3520-8f5c-52ad983654a9",
                                "text": "Te voilà bien malheureuse de n’avoir pas la tête comme un rince-bouteilles !"
                            },
                            {
                                "example_id": "2d5b4eb7-8e3e-4385-9ce0-f535ff1db739",
                                "sense_id": "0bc71cd0-35a1-3520-8f5c-52ad983654a9",
                                "text": "Le nommé Paul Le Clech, 46 ans, grillageur, a formé opposition à un jugement du tribunal de Châteaulin le condamnant à 2 mois de prison pour vol d’un rince-bouteille."
                            },
                            {
                                "example_id": "51e6f803-415e-4ca1-818d-e0ed0ae4e5ef",
                                "sense_id": "0bc71cd0-35a1-3520-8f5c-52ad983654a9",
                                "text": "Très grossièrement, ces chromosomes offrent donc un aspect morphologique rappelant un rince-bouteille ou mieux un goupillon pour verre de lampe."
                            },
                            {
                                "example_id": "71b8f07c-5df8-4139-a24f-23219bcc09ee",
                                "sense_id": "0bc71cd0-35a1-3520-8f5c-52ad983654a9",
                                "text": "Mais fouruait aussi les trucs les plus extravagants, une cure-dent, du papier hygiénique, un rince-bouteille."
                            }
                        ]
                    },
                    {
                        "sense_id": "398da212-86cb-31ad-b623-def90a636b0a",
                        "entry_id": "fc804ed4-82f3-36af-b56c-fa39e39270f8",
                        "glosses": [
                            "Personne qui rince les bouteilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f06e390-c388-42af-a169-0da1b743b664",
                                "sense_id": "398da212-86cb-31ad-b623-def90a636b0a",
                                "text": "Pour les spectateurs, il devenait apprenti chez un joaillier, garçon limonadier, le rince-bouteille d’un apothicaire."
                            },
                            {
                                "example_id": "d683d119-4b22-4215-8305-c8604afb3a51",
                                "sense_id": "398da212-86cb-31ad-b623-def90a636b0a",
                                "text": "Olive prend la place de rince-bouteille chez un aubergiste de campagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fa29206-5b69-322c-90ad-8e51fc67faae",
                        "entry_id": "fc804ed4-82f3-36af-b56c-fa39e39270f8",
                        "glosses": [
                            "Buisson du genre Callistemon de la famille des Myrtacées."
                        ],
