            {
                "entry_id": "0f32536a-39a5-347a-9bb9-297fd1061fd4",
                "word": "bâtarde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a0940e9e-923d-4ce7-80c1-c03909dc2988",
                        "entry_id": "0f32536a-39a5-347a-9bb9-297fd1061fd4",
                        "tags": [
                            "plural"
