                "senses": [
                    {
                        "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                        "entry_id": "e1b66ce1-8e72-36b1-bdb2-e1c0858036e1",
                        "glosses": [
                            "weiblicher Elternteil, der in einen bestimmten Aspekt der Elternschaft wie ein Vater und nicht wie eine Mutter ist"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8ab3055d-a3c7-4ec8-afdb-5fa09cc61ed2",
                                "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                                "text": "„›Püh! Wer sagt, dass dem nicht so ist? Ich bin eine sehr gute Mutter.‹ Dann senkte sie ihre Stimme und raunte mir zu: ›Und ein guter Vater. Meinethalben auch Väterin. […]‹“"
                            },
                            {
                                "example_id": "a0fc966c-8496-4116-b4af-cea852d29985",
                                "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                                "text": "„Rein theoretisch könnte eine Trans-Frau wie Mari Günther inzwischen nicht nur Väterin sein, sondern auch Mutter und ein Baby selbst austragen.“"
                            },
                            {
                                "example_id": "01ea707e-e005-4795-bb1e-50f21c2fd8f3",
                                "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                                "text": "„Sobald das Kind mich ›Mama« nennt, wird meiner Partnerin eine Rolle zugeschrieben, die sie nicht immer ausübt, nämlich die der Co-Mutter, manchmal auch ›Väterin‹ genannt.“"
                            },
                            {
                                "example_id": "6f2bc776-e3b9-4f4d-bfc3-6ff55c0ed658",
                                "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                                "text": "„Eine Frau, die sehr schnell spricht und sich als ‚Väterin‘ vorstellt, war tagsüber in Begleitung eines Helfers aus dem Verein beim Jugendamt.“"
                            },
                            {
                                "example_id": "12e54051-7ca2-496f-bedc-df29b01b5a93",
                                "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                                "text": "„Kannst du dir vorstellen, dass es auch Väterinnen gibt?“"
                            },
                            {
                                "example_id": "1ecbc3c0-a1b0-4b98-9abd-8a0f4d805df1",
                                "sense_id": "1af5bc99-5bea-38dd-93d3-3e0a2dd21116",
                                "text": "„Die Süddeutsche Zeitung (2013) titelte: ‚Väterinnen auf dem Vormarsch: Das ist weniger eine Frage der Medizin als der Psyche‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
