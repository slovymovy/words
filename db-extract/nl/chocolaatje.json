                                                "sense_id": "27a8c6fc-50e3-3181-8fa7-e4981a7c1b2c",
                                                "text": "Chocolate is a very popular treat."
                                            },
                                            {
                                                "example_id": "1a6a08c2-93b1-4b7a-a7a3-1dc4abcbfc48",
                                                "sense_id": "27a8c6fc-50e3-3181-8fa7-e4981a7c1b2c",
                                                "text": "In eighteenth century France, many aphrodisiac dishes and pastries were compounded with chocolate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14876591-0d0d-3264-9eed-2932be21957c",
                                        "entry_id": "dd9ccf4b-ce84-30c7-ab6f-c658c875497d",
                                        "glosses": [
                                            "A drink made by dissolving this food in boiling milk or water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2abc2c83-73cc-40cc-996d-ac2173ce1248",
                                                "sense_id": "14876591-0d0d-3264-9eed-2932be21957c",
                                                "text": "Chocolate came in those fairy cups of India china, which made the delight of our grandmothers, and whose value was such, that the poet satirist considered their loss to be the severest trial to a woman's feelings—alias her temper;..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37aadba7-2e10-3e15-b6e7-fb93223211b7",
                                        "entry_id": "dd9ccf4b-ce84-30c7-ab6f-c658c875497d",
                                        "glosses": [
                                            "A single, small piece of confectionery made from chocolate."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d494315-2b20-4970-b6cd-a2be37d43510",
                                                "sense_id": "37aadba7-2e10-3e15-b6e7-fb93223211b7",
                                                "text": "He bought her some chocolates as a gift. She ate one chocolate and threw the rest away."
                                            },
                                            {
                                                "example_id": "4d6a58ba-f6c2-407e-9216-4ae4bd861701",
                                                "sense_id": "37aadba7-2e10-3e15-b6e7-fb93223211b7",
                                                "text": "Madame de Pompadour was fond of chocolates spiced with vanilla and amber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7e343c2-ff30-3f7f-a4dd-fb1c4e599a17",
                                        "entry_id": "dd9ccf4b-ce84-30c7-ab6f-c658c875497d",
                                        "glosses": [
                                            "A dark, reddish-brown colour/color, like that of chocolate (also called chocolate brown)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab4b5d7-e9d1-42a8-a800-f928e7979a4d",
                                                "sense_id": "b7e343c2-ff30-3f7f-a4dd-fb1c4e599a17",
                                                "text": "As he cooked it the whole thing turned a rich, deep chocolate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb324ebf-8f84-3c2e-a889-fcf1ff8dbf56",
                                        "entry_id": "dd9ccf4b-ce84-30c7-ab6f-c658c875497d",
                                        "glosses": [
                                            "A cat having a chocolate-colored coat."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78313484-51af-3f0b-a83e-c1d13c4c096a",
                                        "entry_id": "dd9ccf4b-ce84-30c7-ab6f-c658c875497d",
                                        "glosses": [
                                            "A black person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6135abe-7514-4fbc-b0a2-09d19a005e0c",
                                                "sense_id": "78313484-51af-3f0b-a83e-c1d13c4c096a",
                                                "text": "\"I suppose you have some of your sweet chocolates working for you?\" Barney nodded."
                                            },
                                            {
                                                "example_id": "8248febf-aa94-4f29-8094-a11058bafd4f",
                                                "sense_id": "78313484-51af-3f0b-a83e-c1d13c4c096a",
                                                "text": "“How is my sexy chocolate?” Mark says on the other end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03e003d-4224-3dad-b4d5-8ac6934558e8",
                                        "entry_id": "dd9ccf4b-ce84-30c7-ab6f-c658c875497d",
                                        "glosses": [
                                            "A black person.",
                                            "Blackness."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a4a43a0-a277-402b-9606-447b5a8d6083",
                                                "sense_id": "a03e003d-4224-3dad-b4d5-8ac6934558e8",
                                                "text": "I can consume as much of you as I want to without gaining weight. Sexy chocolate is what you are."
                                            },
                                            {
                                                "example_id": "5efbb789-f11a-4fdc-a85b-7fae7e774fe4",
                                                "sense_id": "a03e003d-4224-3dad-b4d5-8ac6934558e8",
                                                "text": "“Yes Lucas, you're some fine sexy chocolate”, she whispered, her long dark hair covering her face and the curves bursting out of her dress."
                                            }
                                        ]
                                    }
                                ]
                            },
