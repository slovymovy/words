                {
                    "sense_id": "88277b31-60d0-3c7f-b0c4-f3f2cc604a2f",
                    "sense_definition": "Favored by luck or fortune; lucky or fortunate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>happy</w> coincidence that we both ended up at the same restaurant.",
                            "target_lang_translations": {
                                "ru": "Это было <w>удачное</w> совпадение, что мы оба оказались в одном и том же ресторане."
