                    },
                    {
                        "translation_id": "22f00b0b-bc78-4207-a2ae-c7567f9788b4",
                        "source_entry_id": "a3291d28-c881-31da-921d-3c1263dcda97",
                        "source_sense_id": "e9eb37f7-6e06-32b9-8176-fd514ec0fe42",
                        "target_lang_word": "Koffein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koffein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                        "entry_id": "1d794dbc-2d4c-322c-a873-99bd82dde2bb",
                                        "glosses": [
                                            "ein farbloser, bitter schmeckender organischer Stoff, der als Aufputschmittel verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8e1bd8-055a-4894-9ce0-ca41a8b03795",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "Morgens brauche ich meine Dosis Koffein, um gut in den Tag zu starten."
                                            },
                                            {
                                                "example_id": "024c40fd-2638-4ba2-8f0c-bd694c352c10",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Koffein ist ein schweres Gift, sicher beinahe so schwer wie Morphium.“"
                                            },
                                            {
                                                "example_id": "79a08273-29d7-4dbc-b4d7-f36be47fe49b",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Mein innerer Schweinehund beschwerte sich immer stärker, und das fehlende Koffein machte sich in Form von Missmut breit.“"
                                            },
                                            {
                                                "example_id": "41b3bfba-cf9b-40da-8144-0448dd4b73f9",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Das Koffein pumpte im ganzen Körper, die vielen Eindrücke durchfluteten das Mädchen vom Land, spülten über sie hinweg wie tagsüber die Wellen der Ägäis.“"
                                            },
                                            {
                                                "example_id": "0ad7e5ac-85c4-4387-b909-4d4d51675833",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Es war früh am Freitagmorgen, die Vögel sangen leise, und ich stand auf dem Bürgersteig vor meinem Haus in der Sonne und fragte mich, ob ich die richtige Entscheidung getroffen hatte und ob ich das ohne Koffein überhaupt beurteilen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48a97336-1d0a-4e0d-bfd1-c1e98e6f1b26",
                        "source_entry_id": "a3291d28-c881-31da-921d-3c1263dcda97",
                        "source_sense_id": "e9eb37f7-6e06-32b9-8176-fd514ec0fe42",
                        "target_lang_word": "кофеин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кофеин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ae65825e-8e98-3359-8ff7-d1f0563ea7d0",
                                        "entry_id": "02ab48c6-623c-31f6-8d3c-a3359205d686",
                                        "glosses": [
                                            "хим. органическое вещество, содержащееся в зёрнах кофе, листьях чайного куста, орехах кола и в некоторых других растениях; действует возбуждающее на центральную нервную и сердечно-сосудистую системы; применяется в медицине как стимулирующее средство, при наркотических отравлениях и др."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb92276-f1e8-48c5-b16f-47da4af6d04a",
                                                "sense_id": "ae65825e-8e98-3359-8ff7-d1f0563ea7d0",
                                                "text": "Чай — это любимый напиток многих людей. Он имеет приятный аромат; содержащееся в чае особое вещество — кофеин — возбуждает работу сердца и нервной системы."
                                            },
                                            {
                                                "example_id": "4b10558e-cbdf-444f-9726-4844658eabc7",
                                                "sense_id": "ae65825e-8e98-3359-8ff7-d1f0563ea7d0",
                                                "text": "Тонизирующими свойствами кофе обязан, главным образом, двум веществам — кофеину и хлорогеновой кислоте. Особенно чувствительна к кофеину центральная нервная система и, в первую очередь, те отделы головного мозга, которые ведают психическими функциями."
                                            },
                                            {
                                                "example_id": "032a4240-c608-4350-9f61-2969482f0bb7",
                                                "sense_id": "ae65825e-8e98-3359-8ff7-d1f0563ea7d0",
                                                "text": "Алкалоид кофеин, содержащийся в чае и кофе, впервые выделил в 1819 г. немецкий исследователь Ф. Рунге."
                                            },
                                            {
                                                "example_id": "a734a825-87b0-4248-9565-f5ac1df2ef96",
                                                "sense_id": "ae65825e-8e98-3359-8ff7-d1f0563ea7d0",
                                                "text": "Алкоголь, никотин и кофеин (причём не только содержащийся в кофе, но и в чае, и в кока-коле) до определённого предела возбуждающе действуют на нервную систему, не давая возможности полноценно заснуть. В больших дозах эти вещества нервную систему, наоборот, угнетают."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
