                        "sense_id": "6336b9da-c185-3eef-8a6e-8251ceb1f610",
                        "entry_id": "88867dfb-afb7-3ca3-b6b1-9d2d92084fbf",
                        "glosses": [
                            "staatlich vorgeschriebene theoretische und/oder praktische Prüfung zur Erlangung einer Fahrerlaubnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e1f697b-2782-412e-9735-daa13b438f0b",
                                "sense_id": "6336b9da-c185-3eef-8a6e-8251ceb1f610",
                                "text": "„Wenn der Fahrlehrer nur auf Fehler fokussiert, besteht jemand zwar am Ende vielleicht die Führerscheinprüfung, ist aber trotzdem überzeugt: Ich bin zu blöd zum Autofahren.“"
                            },
                            {
                                "example_id": "7412d203-b2ff-4fc5-a978-50403cfbcc97",
                                "sense_id": "6336b9da-c185-3eef-8a6e-8251ceb1f610",
                                "text": "„Am 14. August 1893 fand die erste Führerscheinprüfung statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
