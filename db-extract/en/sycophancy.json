                                        "sense_id": "35139f0e-5029-3900-abdc-221398606dac",
                                        "entry_id": "f1ae7384-0286-3a96-951f-47909b133324",
                                        "glosses": [
                                            "Flatteries excessives envers un supérieur ou quelqu’un d’important, dans un but purement intéressé."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea4066f-c454-410f-ba16-fa311ef63790",
                                                "sense_id": "35139f0e-5029-3900-abdc-221398606dac",
                                                "text": "Question cirage de pompes, tout dépend de l’enveloppe. Si l’enveloppe est maigre, le cirage de pompes le sera tout autant. Si l’enveloppe est juteuse, le cirage de pompes sera généreux."
                                            },
                                            {
                                                "example_id": "a3131a4c-8836-4016-afa9-c82ea342c3cd",
                                                "sense_id": "35139f0e-5029-3900-abdc-221398606dac",
                                                "text": "Il avait terminé le cirage de pompes et expliquait qu’une importante collection de pièces de la civilisation mycénienne avait été retrouvée un peu moins d’un an auparavant et était présentée au public pour la première fois ce soir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
