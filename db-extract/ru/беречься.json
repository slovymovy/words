                    },
                    {
                        "form_id": "6d641657-2d9f-446c-9ad5-686c7e87ba47",
                        "entry_id": "f6e488b6-3b99-3281-b97a-33afda3aeed8",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "берёгшись"
                    },
                    {
                        "form_id": "0a8821a9-ec2c-4651-818c-8a3263f5b5f3",
                        "entry_id": "f6e488b6-3b99-3281-b97a-33afda3aeed8",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… бере́чься"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b639c5a7-82fe-3d55-8653-92299988b38f",
                        "entry_id": "f6e488b6-3b99-3281-b97a-33afda3aeed8",
                        "glosses": [
                            "перех. остерегаться кого-либо, чего-либо, оберегать себя от кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f247eb13-533c-47a5-9fb0-74902135df5e",
                                "sense_id": "b639c5a7-82fe-3d55-8653-92299988b38f",
                                "text": "― Ну так берегитесь его: он хочет вас обыграть."
                            },
                            {
                                "example_id": "0fd5e4ee-1482-4f67-b186-250bece36673",
                                "sense_id": "b639c5a7-82fe-3d55-8653-92299988b38f",
                                "text": "Иисус сказал им: смотрите, берегитесь закваски фарисейской и саддукейской."
                            }
                        ]
                    },
                    {
                        "sense_id": "f82b5cfd-95cd-37b0-855e-51cc78a65527",
                        "entry_id": "f6e488b6-3b99-3281-b97a-33afda3aeed8",
                        "glosses": [
                            "быть осторожным, осмотрительным, внимательным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61352b6c-15ac-456e-932a-7f35205c5b7b",
                                "sense_id": "f82b5cfd-95cd-37b0-855e-51cc78a65527",
                                "text": "Да, конечно; вы не боитесь меня с тех пор, как узнали, что я вас люблю… но берегитесь ― моя любовь престранного рода… притом же и я теперь убедился, что вы не любите меня…"
                            }
                        ]
                    },
                    {
                        "sense_id": "dcee3075-1a02-3a3d-8e7b-d442f37f0ec5",
                        "entry_id": "f6e488b6-3b99-3281-b97a-33afda3aeed8",
                        "glosses": [
                            "беречь свое здоровье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11492929-a842-4f43-81ba-fce6d5694417",
                                "sense_id": "dcee3075-1a02-3a3d-8e7b-d442f37f0ec5",
                                "text": "Пишу вам в каждом письме, чтоб вы береглись, чтоб вы кутались, чтоб не выходили в дурную погоду, осторожность во всем наблюдали бы, ― а вы, ангельчик мой, меня и не слушаетесь."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7725f6f-3e98-3d71-b2bf-b0d6b3d3a258",
                        "entry_id": "f6e488b6-3b99-3281-b97a-33afda3aeed8",
                        "glosses": [
                            "страд. к беречь"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd2cd8c8-1333-450c-a4f0-356437e94573",
                                "sense_id": "e7725f6f-3e98-3d71-b2bf-b0d6b3d3a258",
                                "text": "Мы с ним отправились пешком, имея при себе котомочки и достаточную сумму, а для охраны оной и своей жизни имели при себе старую короткую саблю с широким обушком, коя у нас всегда береглась для опасного случая."
                            }
                        ]
                    }
                ],
