        "pl-extract.jsonl": [
            {
                "entry_id": "6bfe7f9b-0889-3dd1-ad4f-61759f1e1310",
                "word": "Iwan",
                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b777f5d-23c3-3640-8d0e-ebddb0af47b0",
                        "entry_id": "6bfe7f9b-0889-3dd1-ad4f-61759f1e1310",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d6886f-5226-41fa-9bbc-2d036ca81e17",
                                "sense_id": "1b777f5d-23c3-3640-8d0e-ebddb0af47b0",
                                "text": "Iwan ma ładny, czerwony samochód."
                            },
                            {
                                "example_id": "c8f8af96-6697-4fa0-b120-b02ea847ee2d",
                                "sense_id": "1b777f5d-23c3-3640-8d0e-ebddb0af47b0",
                                "text": "Po niewoli skazany na nowe miejsce pobytu Iwan o mało nie klasnął w ręce na taką poufałość i w milczeniu wskazał palcem piżamę z pąsowego barchanu."
                            },
                            {
                                "example_id": "82f9bed3-fb02-44cf-b298-47265473f15c",
                                "sense_id": "1b777f5d-23c3-3640-8d0e-ebddb0af47b0",
                                "text": "Naówczas Iwanów, aby nie stracić twarzy, wysunął tezę, że podziemne składy, piwnice i obronne kazamaty w istocie służyły jako cele oraz izby tortur."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
