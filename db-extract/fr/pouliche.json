                "senses": [
                    {
                        "sense_id": "82d311ec-52c2-358a-8532-a8b62a2c7267",
                        "entry_id": "0da52f38-1a55-331f-9fa9-5d2306d55e53",
                        "glosses": [
                            "Jeune jument, de moins de trois ans."
                        ],
                        "tags": [
                            "Hippologie",
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "868eb49a-e3fe-4f44-a531-ec335c3b373a",
                                "sense_id": "82d311ec-52c2-358a-8532-a8b62a2c7267",
                                "text": "J’eus une jolie pouliche de l’aventure des capucins ; apparemment que la jument avoit, en ce moment, regardé le révérend père Alléluïa de Québec, car la pouliche étoit une bête à longs poils."
                            },
                            {
                                "example_id": "968acb65-1bcf-4f8b-ae82-87ec0c5825aa",
                                "sense_id": "82d311ec-52c2-358a-8532-a8b62a2c7267",
                                "text": "nᵒ 2 Une médaille d'argent à M. Prigent Cougard, de Plouénan (Finistère), pour sa pouliche Mystère, dont suit le signalement : espèce carrossière ; âge, deux ans; robe aubère; taille 1 m. 54; origine : père, Sénégal, demi-sang; aug. normand; […]."
                            },
                            {
                                "example_id": "85b56e76-a434-4de9-bdb4-a14e6adcd0c1",
                                "sense_id": "82d311ec-52c2-358a-8532-a8b62a2c7267",
                                "text": "Céline Thiébault était alors une jeune fille « bienfaisante », une de ces grandes filles brunes qui paraissent vingt ans au lieu de quinze, de celles qu’à la campagne on compare volontiers à une pouliche et que les hommes, vieux et jeunes, détaillent avec une basse envie, un violent désir."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4adb1ae-02ba-32ee-aaa5-80697171b7d9",
                        "entry_id": "0da52f38-1a55-331f-9fa9-5d2306d55e53",
                        "glosses": [
                            "Jeune fille (affectueusement)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "409d812c-8f18-41dd-9189-289f1a445816",
                                "sense_id": "e4adb1ae-02ba-32ee-aaa5-80697171b7d9",
                                "text": "Viens me voir, ma belle pouliche !"
                            },
                            {
                                "example_id": "553dd411-b84a-4b84-924d-20e40d46c292",
                                "sense_id": "e4adb1ae-02ba-32ee-aaa5-80697171b7d9",
                                "text": "Je n’ai pas réussi à obtenir le numéro de portable de cette jolie pouliche."
                            },
                            {
                                "example_id": "2a36504e-975f-45e0-b034-ec74688107bc",
                                "sense_id": "e4adb1ae-02ba-32ee-aaa5-80697171b7d9",
                                "text": "Salut les pouliches."
                            },
                            {
                                "example_id": "74a087a0-1ea7-4850-94ae-8edd9ad33419",
                                "sense_id": "e4adb1ae-02ba-32ee-aaa5-80697171b7d9",
                                "text": "Je ne suis pas ta pouliche !"
                            }
                        ]
                    }
                ],
                "translations": [
