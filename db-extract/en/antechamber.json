                    },
                    {
                        "translation_id": "319b2730-2da4-415f-8251-efccc4be6cb7",
                        "source_entry_id": "0da0c7d9-da4a-3528-90cd-9a47530b5c57",
                        "source_sense_description": "small room",
                        "target_lang_word": "voorkamer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorkamer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                        "entry_id": "e19b86a8-35ef-3720-a63f-0eb8af5ef758",
                                        "glosses": [
                                            "een kamer aan de straatkant van een huis of woning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da21907f-54e7-4296-94b5-0ad20599a723",
                                                "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                                "text": "De voorkamer werd van nieuwe vloerbedekking voorzien."
                                            },
                                            {
                                                "example_id": "e8bdbbca-7ac9-473e-a119-659dfc8b3537",
                                                "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                                "text": "Een halfuur later had iedereen zich in de voorkamer verzameld."
                                            },
                                            {
                                                "example_id": "2307653f-a580-463c-9148-3c2dee956441",
                                                "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                                "text": "In de voorkamer stond een antiekrode leren chesterfieldfauteuil zij aan zij met een Louis xv -zetel die was voorzien van een oudroze fluwelen bekleding met een rozenmotief, en een voetbankje in ongeveer dezelfde kleur naast een prachtige achttiende-eeuwse salontafel met elegant houtsnijwerk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cdd0c90-ff39-4f93-88a3-0c82cfe4112a",
                        "source_entry_id": "0da0c7d9-da4a-3528-90cd-9a47530b5c57",
                        "source_sense_description": "small room",
                        "target_lang_word": "antichambre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antichambre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c21e94b3-f2d7-31cc-b373-17e8f0450d45",
                                        "entry_id": "1becebe4-6824-3c5b-8094-b6760f093534",
                                        "glosses": [
                                            "Pièce d’un appartement qui commande plusieurs autres pièces principales et dans laquelle on fait attendre les visiteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad60ac3-8d8c-4a70-aced-2b3da04e5d67",
                                                "sense_id": "c21e94b3-f2d7-31cc-b373-17e8f0450d45",
                                                "text": "Dans une étroite antichambre où donnaient plusieurs portes, et qui était éclairée par une petite lampe de fer, ils furent accostés par une des femmes de Rowena."
                                            },
                                            {
                                                "example_id": "7085456b-2894-43f3-b1f1-a1d31821c585",
                                                "sense_id": "c21e94b3-f2d7-31cc-b373-17e8f0450d45",
                                                "text": "La baronne logea sa fille dans la salle à manger, qui fut promptement transformée en chambre à coucher, grâce à l’argent du maréchal ; et l’antichambre devint, comme dans beaucoup de ménages, la salle à manger."
                                            },
                                            {
                                                "example_id": "d5782375-b057-4516-b175-cd59fbdc855a",
                                                "sense_id": "c21e94b3-f2d7-31cc-b373-17e8f0450d45",
                                                "text": "La petite antichambre formée par le palier et la cage de l’escalier sont peintes en vieux bois et représentent des ornements gothiques."
                                            },
                                            {
                                                "example_id": "6779e38b-c529-46da-8208-652d31583511",
                                                "sense_id": "c21e94b3-f2d7-31cc-b373-17e8f0450d45",
                                                "text": "Le duc, […], atteignit enfin un escalier en spirale pratiqué dans l’épaisseur d’un mur et qui s’ouvrait par une porte secrète et invisible dans l’antichambre de l’appartement de Marguerite."
                                            },
                                            {
                                                "example_id": "6580e550-4ab7-40e1-b44f-4176665044fc",
                                                "sense_id": "c21e94b3-f2d7-31cc-b373-17e8f0450d45",
                                                "text": "Un premier compartiment formant antichambre et soigneusement défendu contre les rafales par une double porte; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cda12eb-fa48-3886-816e-2084637402fd",
                                        "entry_id": "1becebe4-6824-3c5b-8094-b6760f093534",
                                        "glosses": [
                                            "Salle d’attente d'un hôtel particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "760cf10c-b1c8-47ae-a185-214f9bf9fd21",
                                                "sense_id": "1cda12eb-fa48-3886-816e-2084637402fd",
                                                "text": "Cavour a dit, dans une formule fameuse, qu’il préférait une Chambre à une antichambre. Il signifiait par là son mépris des courtisans, chambellans et autres parasites de la monarchie."
                                            },
                                            {
                                                "example_id": "7673445b-a51c-46c4-98bf-66932d57d64b",
                                                "sense_id": "1cda12eb-fa48-3886-816e-2084637402fd",
                                                "text": "Je suis le directeur de ces messieurs, le directeur que l'on salue très bas et qui s'offre le délicat plaisir de faire attendre dans l’antichambre nombre de solliciteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fea12c0-a5a9-3252-88ae-131f108d00e2",
                                        "entry_id": "1becebe4-6824-3c5b-8094-b6760f093534",
                                        "glosses": [
                                            "Dernière étape avant l'objectif final."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e2dd79-5388-4a64-b35a-f9abcbd4fca7",
                                                "sense_id": "1fea12c0-a5a9-3252-88ae-131f108d00e2",
                                                "text": "Pour lui, l'administration des finances est l'antichambre du pouvoir."
                                            },
                                            {
                                                "example_id": "af38ed50-4b2b-4ee9-a178-e3440665e267",
                                                "sense_id": "1fea12c0-a5a9-3252-88ae-131f108d00e2",
                                                "text": "Pour beaucoup de spécialistes de la physique quantique, il était temps : l'absence de ces trois septuagénaires de la liste des nobélisés devenait, d'année en année, toujours plus criante - d'autant plus qu'en 2010, le trio s'était déjà vu remettre le prix Wolf de physique, considéré comme l' antichambre du Nobel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c0271b-2a17-4821-872f-9ffc838b6a7a",
                        "source_entry_id": "0da0c7d9-da4a-3528-90cd-9a47530b5c57",
                        "source_sense_description": "small room",
                        "target_lang_word": "Vorraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0329a7fc-0cd9-3872-9a97-39b0871ca63b",
                                        "entry_id": "902c0149-38b5-37ad-8546-e0f10ac910bd",
                                        "glosses": [
                                            "Raum vor dem eigentlich angestrebten/gemeinten Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f16b91-f795-4a09-8667-160b47e1c301",
                                                "sense_id": "0329a7fc-0cd9-3872-9a97-39b0871ca63b",
                                                "text": "„Die Türen, die von einem Vorraum abgingen, waren geöffnet.“"
                                            },
                                            {
                                                "example_id": "598ca07c-db83-4ca5-b8e0-7ff6d4ac8e41",
                                                "sense_id": "0329a7fc-0cd9-3872-9a97-39b0871ca63b",
                                                "text": "„Im Vorraum der Wachstube hatte ein eindrucksvoller Haufen von Knütteln, Äxten und Gewehren gelegen; die Gewehre sorgsam zur Seite geschoben, sie sollten untersucht werden.“"
                                            },
                                            {
                                                "example_id": "a72b4c45-16f6-4352-90e4-8c6dd26f3f11",
                                                "sense_id": "0329a7fc-0cd9-3872-9a97-39b0871ca63b",
                                                "text": "„Ein Vorraum oder Vestibül liegt in der Mitte.“"
                                            },
                                            {
                                                "example_id": "c8e5d0ad-b9d2-403c-9e57-3ee83280d2eb",
                                                "sense_id": "0329a7fc-0cd9-3872-9a97-39b0871ca63b",
                                                "text": "„Im Vorraum schlug eine Uhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba0f396a-68ad-4ef3-8e4b-fe153c4d0220",
                        "source_entry_id": "0da0c7d9-da4a-3528-90cd-9a47530b5c57",
                        "source_sense_description": "small room",
                        "target_lang_word": "Vorzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd493a34-354f-38b6-8f0b-13e11112af55",
                                        "entry_id": "b1f71214-5591-33aa-9b1b-439619090f02",
                                        "glosses": [
                                            "erster, dem Interessenten/Klienten/Patienten zugänglicher Raum einer Praxis oder Verwaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681c3c7a-7f3f-4347-b325-2d0e506c5eaa",
                                                "sense_id": "bd493a34-354f-38b6-8f0b-13e11112af55",
                                                "text": "Klienten müssen sich zunächst im Vorzimmer anmelden."
                                            },
                                            {
                                                "example_id": "ab5653c6-b46c-4a4c-9b83-d801eb84f4e9",
                                                "sense_id": "bd493a34-354f-38b6-8f0b-13e11112af55",
                                                "text": "„In den Vorzimmern des Zentralrats drängen sich die Menschen, jeder glaubt, die Räterepublik sei geschaffen, um seine privaten Wünsche zu erfüllen.“"
                                            },
                                            {
                                                "example_id": "ca1cbe7e-10ce-4fa5-b103-7428ba692863",
                                                "sense_id": "bd493a34-354f-38b6-8f0b-13e11112af55",
                                                "text": "„Er zieht den ganz Überwältigten mit sich aus dem Vorzimmer in den blau-weißen Saal, während Frau Doll schweigend folgt.“"
                                            },
                                            {
                                                "example_id": "c68353a6-c335-40ed-a0ad-998a5d2a9d2f",
                                                "sense_id": "bd493a34-354f-38b6-8f0b-13e11112af55",
                                                "text": "„Die Katze richtete sich auf Dauer im Vorzimmer des Schatzmeisters ein und wurde von seinen Mitarbeitern gefüttert.“"
                                            },
                                            {
                                                "example_id": "4811e00c-2b0d-417d-a825-786a028a87b1",
                                                "sense_id": "bd493a34-354f-38b6-8f0b-13e11112af55",
                                                "text": "„Als sie uns die Tür öffnet, haben wir Mühe, unseren Koffer durch den kleinen Spalt ins Vorzimmer zu zwängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac3ad1a9-9e89-363b-abc9-1dfc955d30b1",
                                        "entry_id": "b1f71214-5591-33aa-9b1b-439619090f02",
                                        "glosses": [
                                            "Eingangsraum einer Wohnung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0139f8d0-d8ac-4829-b007-33ccd42b7f23",
                                                "sense_id": "ac3ad1a9-9e89-363b-abc9-1dfc955d30b1",
                                                "text": "„Bei der Wohnung der Zweitklägerin (Nr. 10 im ersten Stock) ist der vor der Küche gelegene Teil des Ganges bereits als Vorzimmer in den Wohnungsverband einbezogen.“"
                                            },
                                            {
                                                "example_id": "39b6fc6d-2c77-4109-a4ad-682a2029e9a9",
                                                "sense_id": "ac3ad1a9-9e89-363b-abc9-1dfc955d30b1",
                                                "text": "„Die gegenständliche Wohnung, die eine Nutzfläche von 98 m² aufweist, besteht aus zwei Zimmern, Kabinett, Küche, Vorzimmer, Dienerzimmer, Bad, WC und Loggia.“"
                                            },
                                            {
                                                "example_id": "2c256c9f-9ba9-447c-a240-9aab3f8704d9",
                                                "sense_id": "ac3ad1a9-9e89-363b-abc9-1dfc955d30b1",
                                                "text": "„Ich rapple mich auf, stolpere über den Türstaffel zum Vorzimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e09bb54c-b621-4134-a8ac-eb51510a4f93",
