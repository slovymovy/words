                "senses": [
                    {
                        "sense_id": "02c063c8-b871-3eb6-afe3-850e21e237b4",
                        "entry_id": "91828095-d21d-386a-b670-083dd3c5a7d0",
                        "glosses": [
                            "eine Rebsorte aus der Pinot-Familie, die nicht so hochwertig ist wie die übrigen Vertreter der Familie (z. B. der Pinot Noir)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592064da-e5fb-4751-a79e-bd8207895939",
                                "sense_id": "02c063c8-b871-3eb6-afe3-850e21e237b4",
                                "text": "„Der Schwarzriesling fühlt sich an zwei Orten auf der Welt besonders wohl: Der erste ist die französische Champagne, wo er Pinot Meunier heißt und einer der drei Bestandteile des besten Schaumweins der Welt ist. Der zweite ist Württemberg, wo er als sortenreiner Rotwein ausgebaut wird …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6eeb0546-74ef-3563-bce8-b99a1c4b492d",
                        "entry_id": "91828095-d21d-386a-b670-083dd3c5a7d0",
                        "glosses": [
                            "ein Wein, aus der Traubensorte Schwarzriesling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0776152-2b8d-40a2-840a-b84a3220b69c",
                                "sense_id": "6eeb0546-74ef-3563-bce8-b99a1c4b492d",
                                "text": "„… Die Becksteiner Winzer sind aber nicht nur stolz auf ihre Heimat, sondern mit Recht auch auf ihre Weine. Ihre Spezialität ist der Schwarzriesling, den sie hier zu einem fülligen Rotwein mit kräftigem Aroma und einer reifen Fruchtnote ausbauen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
