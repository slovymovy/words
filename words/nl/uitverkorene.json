{
    "word_family": [
        "verkiezen",
        "uitkiezen",
        "verkiezing",
        "uitverkiezing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "487a691c-1aa0-3660-a048-f1ce636a3d84",
                    "sense_definition": "Iemand die speciaal is uitgekozen, vaak voor een bijzondere taak of bestemming.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gekozen persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het oude verhaal werd hij gezien als de <w>uitverkorene</w> om het rijk te redden.",
                            "target_lang_translations": {
                                "ru": "В древней истории его считали <w>избранником</w>, призванным спасти королевство."
                            }
                        },
                        {
                            "text": "Slechts een kleine groep <w>uitverkorenen</w> mocht de koning vergezellen.",
                            "target_lang_translations": {
                                "ru": "Лишь небольшой группе <w>избранных</w> разрешалось сопровождать короля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de uitverkorene zijn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто специально выбран, часто для особой миссии или высокого предназначения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избранник",
                                "target_lang_sense_clarification": "человек, выбранный судьбой или для особой миссии"
                            },
                            {
                                "target_lang_word": "избранный",
                                "target_lang_sense_clarification": "субстантивированное причастие, человек с особой судьбой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae1739db-8e0c-351a-a15c-15a72de814e4",
                    "sense_definition": "De persoon die door iemand als favoriet of geliefde is gekozen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gekozen persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij stelde haar <w>uitverkorene</w> met trots voor aan haar ouders.",
                            "target_lang_translations": {
                                "ru": "Она с гордостью представила своего <w>избранника</w> родителям."
                            }
                        },
                        {
                            "text": "Uiteindelijk koos hij haar als de <w>uitverkorene</w> van zijn hart.",
                            "target_lang_translations": {
                                "ru": "В конце концов он выбрал её <w>избранницей</w> своего сердца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de uitverkorene van het hart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого выбрали в качестве возлюбленного или любимца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избранник",
                                "target_lang_sense_clarification": "возлюбленный, предмет любви или брака"
                            },
                            {
                                "target_lang_word": "избранница",
                                "target_lang_sense_clarification": "возлюбленная, предмет любви или брака (женский род)"
                            },
                            {
                                "target_lang_word": "суженый",
                                "target_lang_sense_clarification": "жених или возлюбленный, предназначенный судьбой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}