                        "source_entry_id": "3c758968-f64b-3c23-82fd-227c29532e75",
                        "source_sense_id": "4aec8543-b3d6-3a9c-9439-dcda356c0c34",
                        "target_lang_word": "недовольный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "недовольный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "084b1f3a-a548-36a6-9a56-ab07832bfee1",
                                        "entry_id": "28dc526a-2d22-37e9-a027-733a99784e00",
                                        "glosses": [
                                            "проявляющий или испытывающий неудовольствие, неудовлетворенность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a8b524-a49d-4e9c-b236-3d7306ad4998",
                                                "sense_id": "084b1f3a-a548-36a6-9a56-ab07832bfee1",
                                                "text": "Корреспондент сообщил, что на митинг собралось около сотни человек, недовольных действиями министра внутренних дел."
                                            },
                                            {
                                                "example_id": "059fab5e-9d6f-40db-8a47-c375e4b49ea3",
                                                "sense_id": "084b1f3a-a548-36a6-9a56-ab07832bfee1",
                                                "text": "Мужчины были недовольны ужином."
                                            },
                                            {
                                                "example_id": "3a793ca4-d8c9-4c6c-b87c-a5ef0f81a93e",
                                                "sense_id": "084b1f3a-a548-36a6-9a56-ab07832bfee1",
                                                "text": "Наполеон, потянув носом из табакерки, устремил недовольный, слезящийся взгляд на вошедшего ординарца."
                                            },
                                            {
                                                "example_id": "7721fa8d-ddda-473e-8794-489e1a7aebc3",
                                                "sense_id": "084b1f3a-a548-36a6-9a56-ab07832bfee1",
                                                "text": "Недовольный переменой разговора, профессор нахмурился."
                                            },
                                            {
                                                "example_id": "21091861-5c10-46c5-ac54-df07f2f666f4",
                                                "sense_id": "084b1f3a-a548-36a6-9a56-ab07832bfee1",
                                                "text": "Оба они были совершенно противоположны по характеру: Гермоген — вечно суровый, сердитый, всем недовольный, подозрительный, тяжелый в обращении с людьми, Дионисий — всегда спокойный, кроткий, благодушный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437b372b-5124-392e-a0be-d811bdaa49e6",
                                        "entry_id": "28dc526a-2d22-37e9-a027-733a99784e00",
                                        "glosses": [
                                            "субстантивир. человек, выражающий недовольство, негодующий на неправильности, недостатки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8c97d6-b4d6-4db8-ae74-84b6098611fc",
                                                "sense_id": "437b372b-5124-392e-a0be-d811bdaa49e6",
                                                "text": "Около полудня на площади Великой Победы собралось сотни полторы недовольных."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
