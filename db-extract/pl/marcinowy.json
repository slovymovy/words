                "senses": [
                    {
                        "sense_id": "d4088bef-58ff-33fe-9cbf-3abf7341d36f",
                        "entry_id": "a1872ede-7816-3332-a2fc-720483e38efc",
                        "glosses": [
                            "należący do Marcina"
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f7bb85a7-3bd2-4901-8bc0-518019d0dbef",
                                "sense_id": "d4088bef-58ff-33fe-9cbf-3abf7341d36f",
                                "text": "W Marcinowym sadzie rosną dorodne jabłonie i grusze oraz rosochate orzechy."
                            },
                            {
                                "example_id": "c0579f46-dc90-4cbd-acc2-b86c527748c7",
                                "sense_id": "d4088bef-58ff-33fe-9cbf-3abf7341d36f",
                                "text": "Marcinowa cukiernia słynie z pysznych rogali świętomarcińskich."
                            },
                            {
                                "example_id": "be78e4fd-dbc9-40f1-ac5e-8cb811bfc736",
                                "sense_id": "d4088bef-58ff-33fe-9cbf-3abf7341d36f",
                                "text": "Na skraju Marcinowego gospodarstwa stoi przydrożna figura św. Marcina."
                            },
                            {
                                "example_id": "703180b5-7557-4533-a5a6-a8cd87f7dee3",
                                "sense_id": "d4088bef-58ff-33fe-9cbf-3abf7341d36f",
                                "text": "Marcinowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
