                                "target_senses": [
                                    {
                                        "sense_id": "a5e1449b-e5cd-3dc5-b037-042bf77aee50",
                                        "entry_id": "b8273802-75ed-3e7d-b357-8e31a2a35946",
                                        "glosses": [
                                            "kobieta zbytnio przywiązująca wagę do formalności, zewnętrznych form działania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125e355b-7df2-49a7-96df-fecdb8353ddf",
                                                "sense_id": "a5e1449b-e5cd-3dc5-b037-042bf77aee50",
                                                "text": "Bibliotekarki nie są formalistkami i chociaż traci na tym statystyka, cieszą się każdym czytelnikiem — nawet, jeśli nie jest zarejestrowany. Martwią się jedynie tym, że „odpożyczane\" książki czasem giną"
