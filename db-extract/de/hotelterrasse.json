                "senses": [
                    {
                        "sense_id": "92893b3f-a942-3616-bc14-863b2361c71e",
                        "entry_id": "687d239d-bcc9-36f7-b6d2-34cbd30ba9b1",
                        "glosses": [
                            "freie Fläche an einem Hotel, die als Terrasse genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4feac070-cbbc-45cd-98c6-994f73f792cc",
                                "sense_id": "92893b3f-a942-3616-bc14-863b2361c71e",
                                "text": "„Nach dem Abendessen wurde es draußen pechschwarz, und Elisabeth saß im Halbdunkel auf der Hotelterrasse und trank Kaffee.“"
                            },
                            {
                                "example_id": "5306e334-c655-4fb3-a779-782fe4506a1c",
                                "sense_id": "92893b3f-a942-3616-bc14-863b2361c71e",
                                "text": "„Vom Rand der Hotelterrasse war die gesamte Badezone zu überblicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1e0205c-3f27-4ffa-8489-291d9c9cbd40",
                        "source_entry_id": "687d239d-bcc9-36f7-b6d2-34cbd30ba9b1",
                        "source_sense_id": "92893b3f-a942-3616-bc14-863b2361c71e",
                        "source_sense_description": "freie Fläche an einem Hotel, die als Terrasse genutzt wird",
                        "target_lang_word": "terrasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5211eb6e-8ff1-3119-b816-059f3f1df2a3",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Levée de terre artificielle en plate-forme, ordinairement soutenue par de la maçonnerie."
                                        ],
                                        "tags": [
                                            "Aménagement du sol"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8fd188-910c-4204-afa2-612bb3569b24",
                                                "sense_id": "5211eb6e-8ff1-3119-b816-059f3f1df2a3",
                                                "text": "Durtal aboutissait à une terrasse dominant la ville et il s’accoudait à une balustrade de pierre grise, sèche, trouée […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8fc1253-6e7b-3545-9585-3f454406442c",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Dans les endroits où le relief est accidenté, désigne des terrains aménagés horizontalement en étages et soutenus par des murets (→ voir terrasse agricole et rizière en terrasse)."
                                        ],
                                        "tags": [
                                            "Agronomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23dcaa9e-36b7-49b2-91ba-1931e508d905",
                                                "sense_id": "c8fc1253-6e7b-3545-9585-3f454406442c",
                                                "text": "[…] le notaire examina si personne ne pouvait l’écouter du haut d’une terrasse, en arrière ou en avant d’eux […]"
                                            },
                                            {
                                                "example_id": "e2271dd3-29c0-4a88-9a20-13d51021b5c7",
                                                "sense_id": "c8fc1253-6e7b-3545-9585-3f454406442c",
                                                "text": "« Ils l'ont défigurée », dit-il, et il poursuivit sa route, sans être sensible ni au charme des eaux pures et courantes des rapides de Phade, ni au calme harmonieux de la cuvette d’Haulmé où la Semoy divague plus que de raison, entre une terrasse et des versants à pic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2db3515-480b-39f9-ab0c-1225243d6ee0",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Plate-forme aménagée à l’un des étages d’une construction, sans faire saillie, à la différence du balcon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0e5d01-d667-4666-a429-28ab6b998d95",
                                                "sense_id": "b2db3515-480b-39f9-ab0c-1225243d6ee0",
                                                "text": "La vieille Ajaccienne, qui nous en fait les honneurs, nous fait remarquer la terrasse carrelée qui borde le salon, Mme Lætitia l'avait fait aménager pour retenir au logis Nabulione ; c'était le préau où jouait l'Empereur enfant."
                                            },
                                            {
                                                "example_id": "1db1d52d-9476-4a79-bb43-1ad0a5d98908",
                                                "sense_id": "b2db3515-480b-39f9-ab0c-1225243d6ee0",
                                                "text": "Lasse, elle ouvrit la baie vitrée et sortit sur la terrasse. Elle regardait la mer grise qui ondulait doucement devant elle."
                                            },
                                            {
                                                "example_id": "12561b2b-d950-44be-b881-b2fc9132f65d",
                                                "sense_id": "b2db3515-480b-39f9-ab0c-1225243d6ee0",
                                                "text": "Vue sur le soleil couchant depuis la terrasse du restaurant. un bâtiment de plain pied regroupe cinq chambres ventilées spacieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529d2f59-fd28-31f9-90a2-70e035604743",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Type de toiture d’un édifice, lorsqu’elle est constituée d’une plate-forme maçonnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eac2e0a0-a343-45c9-8a0a-d8c079e3c355",
                                                "sense_id": "529d2f59-fd28-31f9-90a2-70e035604743",
                                                "text": "À Moscou, le recours à la terrasse est cette fois souligné avec une emphase justificatrice hors de propos, dans la mesure où pratiquement aucun des projets concurrents n’avait eu recours à un toit en pente […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff5df2ae-e20e-3721-8a27-3b6db4b7f9dc",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Balcon de grande dimension."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "681f4d8a-43a8-330e-8594-e5b6a8474813",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Partie en plein air d’un établissement public, café ou restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7694ac3-b06f-4ca2-b26b-8f26caee565c",
                                                "sense_id": "681f4d8a-43a8-330e-8594-e5b6a8474813",
                                                "text": "J’ai toujours eu l’amour des terrasses de café, et la conception la plus flatteuse du Paradis serait, pour moi, une terrasse de café, d’où l’on ne partirait plus jamais."
                                            },
                                            {
                                                "example_id": "77c28b28-1cc3-42a1-9169-290456cc2af6",
                                                "sense_id": "681f4d8a-43a8-330e-8594-e5b6a8474813",
                                                "text": "Vers midi et demi, nous tirons le déjeuner des sacs, au café de la Bagnolle. La fin du séjour est marquée par une violente ondée qui vide les terrasses !"
                                            },
                                            {
                                                "example_id": "2276bc6d-b757-47e9-bc80-9855c5c40ec3",
                                                "sense_id": "681f4d8a-43a8-330e-8594-e5b6a8474813",
                                                "text": "Lorsque, à la terrasse du café des Cludiens, les paysans s’attardent un peu trop, lui, au coin du plus léger nuage, sourit d’un air bon enfant, semblant dire aux consommateurs : « T’en fais pas, Clope, t’en fais pas, Clépont, moi, pendant ce temps, je fais mûrir tes tomates. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6236cc5-10be-3382-900b-2158120f52ff",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Emplacement sur le trottoir d’une voie publique ou sur les places de stationnement de voitures où l’on dispose des tables et des chaises pour les consommateurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efc6497-eecc-4815-aa5e-cc51fd2d1a63",
                                                "sense_id": "e6236cc5-10be-3382-900b-2158120f52ff",
                                                "text": "Sur les boulevards, à la terrasse d’un bar-tabac, Bob, qu’un placide individu salua sans insister, repris […]"
                                            },
                                            {
                                                "example_id": "b0b41ceb-cf66-4a24-80bb-f07c0bd09169",
                                                "sense_id": "e6236cc5-10be-3382-900b-2158120f52ff",
                                                "text": "Aux terrasses des brasseries, échelonnées du faubourg Montmartre, à la rue Drouot, de larges gouttes s’écrasaient sur le sol."
                                            },
                                            {
                                                "example_id": "dc0ee531-aa99-4d5f-95c5-6d17a5d96ff6",
                                                "sense_id": "e6236cc5-10be-3382-900b-2158120f52ff",
                                                "text": "Attablé à une terrasse, cours de la République, un nom qui sonne toujours bien à l'oreille, Alfred expliqua qu'il était en phase de récupération."
                                            },
                                            {
                                                "example_id": "a3725d1a-adc7-4e02-be92-8212f652d43c",
                                                "sense_id": "e6236cc5-10be-3382-900b-2158120f52ff",
                                                "text": "Depuis la crise qu’a entraînée l’épidémie de Covid-19, les restaurateurs de la capitale peuvent, après en avoir obtenu autorisation, étendre leur terrasse sur le trottoir ou sur des places de stationnement entre le 1er avril et le 31 octobre ; au fil des ans, ces terrasses temporaires sont devenues objet de vives tensions entre la Mairie de Paris, qui cherche à dynamiser le secteur de la restauration, et les riverains agacés par les nuisances sonores, soutenus dans leurs revendications par les élus d’opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "406e0239-a5fd-3e1e-a890-c40df507b2c3",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "Surface plane ou légèrement inclinée, en bordure d’un cours d’eau, vestige d’anciens niveaux d’écoulement."
                                        ],
                                        "tags": [
                                            "Géomorphologie fluviale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c4510e-1903-4c55-9172-20676c8870e3",
                                                "sense_id": "406e0239-a5fd-3e1e-a890-c40df507b2c3",
                                                "text": "Les terrasses formées au cours du dernier million d’années témoignent en revanche de vallées étroites et encaissées dans les reliefs (e.g., Kukla, 1978; Maddy et al., 2000)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ef41ab-67bd-3abe-a617-6d92b6fba7c7",
                                        "entry_id": "6061df6b-7628-361e-a156-2750851a753d",
                                        "glosses": [
                                            "- Partie tendre qui se présente par veine dans un bloc de marbre ; cheval de terre."
                                        ],
                                        "tags": [
                                            "Marbrerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
