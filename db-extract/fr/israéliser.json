                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4157c8-991c-4e04-a685-c507f6c94b67",
                                                "sense_id": "6f5c9742-af80-37f6-9401-e6020b05b6c1",
                                                "text": "For a number of years, it has been evident that the Israeli government has intensified its efforts to Judaise and Israelise Jerusalem."
                                            },
                                            {
                                                "example_id": "2ac528ad-68ca-40a7-ae26-f805956af9a0",
                                                "sense_id": "6f5c9742-af80-37f6-9401-e6020b05b6c1",
                                                "text": "... defended it against Arab accusations, told the Israeli foreign ministry that 'if the Israeli Government went on like this even her friends would have to believe that she was trying to get rid of the Arab population on the West Bank in order to Israelise it'."
                                            },
                                            {
                                                "example_id": "11dc5bd0-6cf8-496b-95a2-24d2dbd94c49",
                                                "sense_id": "6f5c9742-af80-37f6-9401-e6020b05b6c1",
                                                "text": "Opposition has come from inside the Arab community: Jamal Zahalka, then a Balad Party MK, warned at the time that national service was a stepping stone towards imposing the army draft: 'They are trying to Israelise our youth', he said"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
