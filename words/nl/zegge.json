                            },
                            {
                                "target_lang_word": "именно",
                                "target_lang_sense_clarification": "для точного указания"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "to be precise",
                                "target_lang_sense_clarification": "when stating an exact figure"
                            },
                            {
                                "target_lang_word": "namely",
                                "target_lang_sense_clarification": "for precise specification"
                            }
                        ]
                    }
                }
            ]
        },
