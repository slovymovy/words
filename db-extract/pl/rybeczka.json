                                "target_senses": [
                                    {
                                        "sense_id": "899ecaf9-2ad7-3977-9c89-33ae0a158974",
                                        "entry_id": "491864b8-599d-331b-9cd6-60b5395f225e",
                                        "glosses": [
                                            "ryba"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb310648-3498-4e12-bd20-64bc2883b464",
                                                "sense_id": "899ecaf9-2ad7-3977-9c89-33ae0a158974",
                                                "text": "Mnohokráte po celodenním lovení v nesmírné síti ani rybička se nechytí aneb nepatrných několik na břeh přichází."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aaf83a3-7db2-3fd9-a0ed-122899e3e1d1",
                                        "entry_id": "491864b8-599d-331b-9cd6-60b5395f225e",
                                        "glosses": [
                                            "kapesní nožík se střenkou ve tvaru rybičky [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14893ca2-2902-4968-9016-e96e683fdbcc",
                                                "sense_id": "4aaf83a3-7db2-3fd9-a0ed-122899e3e1d1",
                                                "text": "Mým prvním zavíracím nožem byla před desítkami let právě rybička."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddcfe34b-06bc-3b1c-84fb-cfc9f3ea7eb7",
                                        "entry_id": "491864b8-599d-331b-9cd6-60b5395f225e",
                                        "glosses": [
                                            "zákrok hráče, kdy v pádu zasahuje míč či kotouč"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092c0bc1-d182-47d4-a428-576b5d9c36ae",
                                                "sense_id": "ddcfe34b-06bc-3b1c-84fb-cfc9f3ea7eb7",
                                                "text": "Když už to vypadalo zle, vytáhl Radek Štěpánek ze svého arsenálu úžasnou rybičku a hala byla v transu."
                                            }
                                        ]
                                    }
                                ]
