                    {
                        "sense_id": "193c0bf8-b046-3f63-9b03-a85257abf1ef",
                        "entry_id": "ea0711d1-1a9b-3eb2-ae19-73dbe7084943",
                        "glosses": [
                            "Train qui comprend les deux roues de devant et le timon d’une voiture à cheval ou d’un canon de campagne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "abaa0fba-1035-4370-a88a-11b50e74580c",
                                "sense_id": "193c0bf8-b046-3f63-9b03-a85257abf1ef",
                                "text": "C’était l’avant-train d’un de ces fardiers, usités dans les pays de forêts, et qui servent à charrier des madriers et des troncs d’arbres."
                            },
                            {
                                "example_id": "e8c6761f-86fc-4ed4-b8f3-7ff44585bc1d",
                                "sense_id": "193c0bf8-b046-3f63-9b03-a85257abf1ef",
                                "text": "Seulement l’avant-train du chariot avait été brisé par le choc."
                            }
                        ]
                    },
                    {
                        "sense_id": "edf4e8d9-f122-3441-a11d-733143654b0f",
                        "entry_id": "ea0711d1-1a9b-3eb2-ae19-73dbe7084943",
                        "glosses": [
                            "Jambes de devant et du poitrail d’un cheval."
                        ],
                        "tags": [
                            "Manège"
                        ],
                        "examples": []
                    }
                ],
