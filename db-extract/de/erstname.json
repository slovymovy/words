                "senses": [
                    {
                        "sense_id": "356fa27f-e289-3f6e-bde0-c4dc149c3214",
                        "entry_id": "dfd1b0fe-0341-33e0-b2d5-60d82278a04a",
                        "glosses": [
                            "erster einer Reihe von Vornamen eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a040f7-4a75-4503-be03-03b850e15e7a",
                                "sense_id": "356fa27f-e289-3f6e-bde0-c4dc149c3214",
                                "text": "„Zu den Statistiken aus den Nachbarländern sei angemerkt, dass sie nicht alle vergebenen Vornamen berücksichtigen, sondern nur die Erstnamen beziehungsweise einen Vornamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "992b969d-254e-3e2b-9368-e1ab2137ef4d",
                        "entry_id": "dfd1b0fe-0341-33e0-b2d5-60d82278a04a",
                        "glosses": [
                            "erste Bezeichnung eines später anders benannten Objekts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b2f0e9-3669-42d5-967e-ea6596e5edd9",
                                "sense_id": "992b969d-254e-3e2b-9368-e1ab2137ef4d",
                                "text": "„Der Erstname Jungfernmühle geht auf eine tragische Begebenheit beim Bau im Jahr 1757 in Potsdam zurück, als die Müllertochter bei der Besichtigung der neuen Mühle unter plötzlich auftretendem Wind von den Flügeln erfasst und in einem hohen Bogen auf der Galerie zerschmettert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
