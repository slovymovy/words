                    {
                        "sense_id": "f78a544b-a06f-3416-b231-243aa1bf03f6",
                        "entry_id": "47e91cd9-3207-3a12-8d38-333f25b16279",
                        "glosses": [
                            "Alternative form of hitchhiker (“advertisement at the end of a programme”)."
