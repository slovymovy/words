    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6a04a8fd-b45e-34d5-9bf8-3f6b55ab748c",
                "word": "stickybeak",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "799ba60b-bfea-46f9-8d0f-025563a77627",
                        "entry_id": "6a04a8fd-b45e-34d5-9bf8-3f6b55ab748c",
                        "tags": [
                            "plural"
                        ],
                        "form": "stickybeaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75b05fea-84da-3d61-a9b1-e7aab8b96efc",
                        "entry_id": "6a04a8fd-b45e-34d5-9bf8-3f6b55ab748c",
                        "glosses": [
                            "An overly inquisitive person, a nosey parker."
                        ],
                        "tags": [
                            "Commonwealth",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "baa4c445-f923-4d69-8eb5-64a38fd94c2b",
                                "sense_id": "75b05fea-84da-3d61-a9b1-e7aab8b96efc",
                                "text": "I walked back towards the grinning stickybeak who took a few steps backwards before fleeing for the steamy safety of his laundry."
                            },
                            {
                                "example_id": "45d54c71-4607-4362-a497-07c69fa02839",
                                "sense_id": "75b05fea-84da-3d61-a9b1-e7aab8b96efc",
                                "text": "Babies of this age are delightful stickybeaks, vitally interested in everything and everyone around them."
                            },
                            {
                                "example_id": "d6eedc10-b5bd-4436-985f-e5086748152b",
                                "sense_id": "75b05fea-84da-3d61-a9b1-e7aab8b96efc",
                                "text": "1999, Kate Grenville, The Idea of Perfection, 2012, Text Publishing, unnumbered page,\nAnd I like a chat, kind of thing.\nShe glanced at Harley.\nPlus I′m a stickybeak, as you know."
                            },
                            {
                                "example_id": "f1850332-4f18-46c5-9dae-ed8b64439ab8",
                                "sense_id": "75b05fea-84da-3d61-a9b1-e7aab8b96efc",
                                "text": "Vanessa took hold of his hand. ‘She′s a dear friend as well as my business manager and,’ she giggled as she admitted her agent′s greatest flaw, ‘when it comes to her clients, the world′s biggest stickybeak.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                        "entry_id": "6a04a8fd-b45e-34d5-9bf8-3f6b55ab748c",
                        "glosses": [
                            "An act of looking at or watching something, especially something which does not directly concern the one looking."
                        ],
                        "tags": [
                            "Commonwealth",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8221f072-525b-4569-ba0f-2ed1ba401efd",
                                "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                                "text": "Want me to have a stickybeak at that?"
                            },
                            {
                                "example_id": "e40314bf-7356-438f-b1db-552a3338cead",
                                "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                                "text": "Shall we take a stickybeak at that shop?"
                            },
                            {
                                "example_id": "187d5269-129a-47a0-84b4-eadcb6a6d982",
                                "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                                "text": "2009, Australia Justine Vaisutis, Lonely Planet, page 239,\nIt′s worth popping into the bar for a stickybeak."
                            },
                            {
                                "example_id": "7ea64789-8878-4875-92ff-c1774fc7a6c1",
                                "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                                "text": "Between properties, we stopped off for tea with my grandmother and my aunt, and my mother produced her stash of floor plans like enemy intelligence: ‘Have a stickybeak at this!’"
                            },
                            {
                                "example_id": "5bf3d39a-6453-4753-b82c-592afa8cd092",
                                "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                                "text": "God knows what the other patients and staff made of a mob of blackfellas rocking up to visit one of our own, in a private room, to have a stickybeak at the new bub."
                            },
                            {
                                "example_id": "d9b16536-4976-49ad-97b5-a78d328f1ecb",
                                "sense_id": "13de3bc6-6aa7-3a53-bf3c-3b3dbfa48370",
                                "text": "When I patted the pockets of them shorts there wasn't any phone.\n\"It's in here on the table,\" said the Irishman.\n\"And you had a good stickybeak I bet.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f24a7fe-4b24-4ff3-b942-a06bd4dfffc9",
                        "source_entry_id": "6a04a8fd-b45e-34d5-9bf8-3f6b55ab748c",
                        "source_sense_description": "nosy person",
                        "target_lang_word": "Schnüffler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnüffler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4487c9ad-4854-354c-a694-9db8eab03a87",
                                        "entry_id": "76c640c7-c31e-3bbb-a67a-7ff989cb0e1b",
                                        "glosses": [
                                            "jemand, der nach etwas sucht (herumschnüffelt), das andere belastet oder in Schwierigkeiten bringen kann"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e66611-6164-427a-b0f2-7fabe734f97d",
                                                "sense_id": "4487c9ad-4854-354c-a694-9db8eab03a87",
                                                "text": "„Was ist schließlich ein Schnüffler ohne Büro?“"
                                            },
                                            {
                                                "example_id": "d951c853-fd16-4988-b8ac-d9bd75e43ba0",
                                                "sense_id": "4487c9ad-4854-354c-a694-9db8eab03a87",
                                                "text": "„Die Staatsanwälte halten es aber auch für möglich, dass die kriminellen Schnüffler ihre Kontakte in der Telekom nur ausgenutzt und auf eigene Rechnung gearbeitet haben.“"
                                            },
                                            {
                                                "example_id": "0dfc0a84-26f8-4725-b243-66b54200e6fe",
                                                "sense_id": "4487c9ad-4854-354c-a694-9db8eab03a87",
                                                "text": "„Wenn die Schnüffler der Reichsmusikkammer in den Clubs auftauchten, beherrschte so manche Band das schnelle Umschaltspiel auf deutsche Schlagermusik in sekundenschneller Vollendung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
