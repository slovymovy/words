                "senses": [
                    {
                        "sense_id": "2f0545ab-18d3-3e4c-b43a-c1ffb0c27663",
                        "entry_id": "2948974b-420c-389e-8a8b-636da8bd00b1",
                        "glosses": [
                            "Qui entoure la trachée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c637a42-be1b-437f-a611-cb0654b9ccdf",
                                "sense_id": "2f0545ab-18d3-3e4c-b43a-c1ffb0c27663",
                                "text": "L’observation directe du phénomène circulatoire manquait ; on n’était point parvenu à surprendre le mouvement du sang, soit dans l’espace péritrachéen, soit dans les capillaires."
                            },
                            {
                                "example_id": "117b902a-5eeb-4018-ae72-3dd0469a458d",
                                "sense_id": "2f0545ab-18d3-3e4c-b43a-c1ffb0c27663",
                                "text": "Les trachées, on le sait, sont constituées par deux tuniques : la tunique interne forme l’enveloppe du canal aérifère ; la tunique externe ou membrane péritrachéenne (membrane péritonéale des Allemands) circonscrit la première enveloppe, en laissant un intervalle, l’espace péritrachéen."
                            }
                        ]
                    }
