                "senses": [
                    {
                        "sense_id": "4ee125f9-4130-346b-9d2d-31d618aad138",
                        "entry_id": "0f7e78c0-1a13-30bf-91f5-37bde779d996",
                        "glosses": [
                            "vor den Augen/der Augenpartie getragene Vorrichtung (eine Art Brille), die beim Skilaufen als Schutz gegen Blendung durch die Sonne und andere Beeinträchtigungen, zum Beispiel Flug von Schnee- oder Eiskristallen, dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fab9fd-ed7e-438e-8867-3f6c90dadf80",
                                "sense_id": "4ee125f9-4130-346b-9d2d-31d618aad138",
                                "text": "„Die Einbrecher tragen Masken, Handschuhe, der kleinere eine Skibrille über seiner Brille.“"
                            },
                            {
                                "example_id": "ba9e2b32-6dbf-477d-a69b-4917105ce33c",
                                "sense_id": "4ee125f9-4130-346b-9d2d-31d618aad138",
                                "text": "„Die Skibrille sollte die Augen vor starker UV-Strahlung schützen und auch bei grellem Sonnenschein noch eine gute Sicht ermöglichen.“"
                            },
                            {
                                "example_id": "74a8e3af-ef98-440b-b1c5-37f15a8f1d96",
                                "sense_id": "4ee125f9-4130-346b-9d2d-31d618aad138",
                                "text": "„Die Schlieren verdichteten sich, der Wind nahm zu, wir montierten unsere Skibrillen, im kniehohen Neuschnee wühlten wir uns weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
