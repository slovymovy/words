{
    "word_family": [
        "vigilant",
        "vigilantly",
        "vigil",
        "vigilante"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f735780b-06c8-3654-831b-1b3c3049b409",
                    "sense_definition": "Close and continuous attention to a task or situation to ensure safety or success.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "watchfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security team maintained constant <w>vigilance</w> throughout the high-profile event to prevent any incidents.",
                            "target_lang_translations": {
                                "ru": "Служба безопасности сохраняла постоянную <w>бдительность</w> на протяжении всего важного мероприятия, чтобы предотвратить любые инциденты."
                            }
                        },
                        {
                            "text": "Many people believe that eternal <w>vigilance</w> is the price of liberty in a democratic society.",
                            "target_lang_translations": {
                                "ru": "Многие верят, что вечная <w>бдительность</w> — это цена свободы в демократическом обществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "attentiveness",
                        "carefulness",
                        "diligence"
                    ],
                    "antonyms": [
                        "negligence",
                        "inattention"
                    ],
                    "common_phrases": [
                        "eternal vigilance",
                        "constant vigilance",
                        "maintain vigilance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пристальное и непрерывное внимание к задаче или ситуации для обеспечения безопасности или успеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительность",
                                "target_lang_sense_clarification": "неослабное внимание"
                            },
                            {
                                "target_lang_word": "настороженность",
                                "target_lang_sense_clarification": "состояние готовности к опасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d62dd00d-9f0f-3b41-a046-f52ce3983788",
                    "sense_definition": "The state of being alertly watchful, especially to avoid danger or difficulties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "watchfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lifeguard's <w>vigilance</w> saved the young swimmer who had drifted too far from the shore.",
                            "target_lang_translations": {
                                "ru": "<w>Бдительность</w> спасателя спасла юного пловца, которого унесло слишком далеко от берега."
                            }
                        },
                        {
                            "text": "Because of the recent thefts, the neighbors increased their <w>vigilance</w> and reported any suspicious activity.",
                            "target_lang_translations": {
                                "ru": "Из-за недавних краж соседи усилили <w>бдительность</w> и сообщали о любой подозрительной активности."
                            }
                        }
                    ],
                    "synonyms": [
                        "alertness",
                        "watchfulness",
                        "wariness"
                    ],
                    "antonyms": [
                        "carelessness",
                        "unwariness"
                    ],
                    "common_phrases": [
                        "increased vigilance",
                        "heightened vigilance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние повышенного внимания, особенно во избежание опасности или трудностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительность",
                                "target_lang_sense_clarification": "состояние настороженности"
                            },
                            {
                                "target_lang_word": "зоркость",
                                "target_lang_sense_clarification": "способность вовремя заметить опасность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95656442-fa03-3303-a6e4-4cb55bc19dc0",
                    "sense_definition": "A person or group of people assigned to keep watch or act as a guard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "guarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>vigilance</w> stood at the tower gates, watching for any sign of the approaching army.",
                            "target_lang_translations": {
                                "ru": "Древняя <w>стража</w> стояла у ворот башни, высматривая любые признаки приближающейся армии."
                            }
                        },
                        {
                            "text": "In the absence of a formal police force, the town relied on a volunteer <w>vigilance</w> to keep the peace.",
                            "target_lang_translations": {
                                "ru": "В отсутствие официальной полиции город полагался на добровольный <w>дозор</w> для поддержания порядка."
                            }
                        }
                    ],
                    "synonyms": [
                        "guard",
                        "sentry",
                        "watchman"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of the word referring to a person is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или группа людей, назначенных для наблюдения или охраны (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стража",
                                "target_lang_sense_clarification": "группа людей, несущих караул"
                            },
                            {
                                "target_lang_word": "дозор",
                                "target_lang_sense_clarification": "отряд для наблюдения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}