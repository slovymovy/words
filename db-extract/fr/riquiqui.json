                            "informal",
                            "invariable"
                        ],
                        "examples": [
                            {
                                "example_id": "0110cefd-ee84-4828-b4cd-1063581de558",
                                "sense_id": "bcde76c2-5a2f-3190-8d2b-344f618bc165",
                                "text": "Je suis comme le vieux Blanqui / Je dis aussi, « ni Dieu ni maître » / Ni maitresse… c’est riquiqui."
                            },
                            {
                                "example_id": "3ddf54b4-5f69-4a91-9491-9da4ab6abf23",
                                "sense_id": "bcde76c2-5a2f-3190-8d2b-344f618bc165",
                                "text": "Grand choix de variétés sur place et à emporter, musique jazzy douce et nombre de tables toutes riquiqui (ce qui en fait aussi le charme).",
                                "translation": "A wide choice of varieties [of coffee] to have in or take away, soft jazz music and a number of tiny little tables (which give the place its charm).",
                                "english": "A wide choice of varieties [of coffee] to have in or take away, soft jazz music and a number of tiny little tables (which give the place its charm)."
                            },
                            {
                                "example_id": "ed64ef7f-3765-4bd9-9d56-25d522dd55d4",
                                "sense_id": "bcde76c2-5a2f-3190-8d2b-344f618bc165",
                                "text": "Un vent de panique né d’un article riquiqui dans Paris Match : un livre sous X sera(it) imprimé à 250 000 exemplaires et publié en septembre, pour la rentrée littéraire.",
                                "translation": "A wave of panic caused by a tiny article in Paris Match: a book known as X will (allegedly) be published in September, in time for the literary season, with a print run of 250,000 copies.",
                                "english": "A wave of panic caused by a tiny article in Paris Match: a book known as X will (allegedly) be published in September, in time for the literary season, with a print run of 250,000 copies."
                            }
                        ]
                    }
