                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to keep watch over a prisoner"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to keep under surveillance"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "караулить",
                                "target_lang_sense_clarification": "неотлучно следить за задержанным"
                            },
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "обеспечивать надзор за заключенным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5293dc01-635b-3f70-ac85-dea832a1e6a4",
                    "sense_definition": "iets nauwlettend in het oog houden of controleren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toezicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige moet de hartslag van de patiënt voortdurend <w>bewaken</w>.",
                            "target_lang_translations": {
                                "en": "The nurse must constantly <w>monitor</w> the patient's heart rate.",
                                "ru": "Медсестра должна постоянно <w>отслеживать</w> пульс пациента."
                            }
                        },
                        {
                            "text": "Het is essentieel om de grenzen van het project goed te <w>bewaken</w>.",
                            "target_lang_translations": {
