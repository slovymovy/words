                                        "entry_id": "e3205d81-f746-3857-a0f2-f23b8466326d",
                                        "glosses": [
                                            "zum Volk der Kirgisen gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f1c27c-c05e-4248-b14e-3dfc55f63bf3",
                                                "sense_id": "30d9f4ab-c0ca-3c59-9bb2-daaf2f87b511",
                                                "text": "Er brachte seine kirgisische Ehefrau mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "faed95af-28e6-31fb-acce-a2af9edfe1c2",
                                        "entry_id": "e3205d81-f746-3857-a0f2-f23b8466326d",
                                        "glosses": [
                                            "zu Kirgisistan gehörig, aus Kirgisistan kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e651bda5-ba25-426f-a808-f97f4e2d09ff",
                                                "sense_id": "faed95af-28e6-31fb-acce-a2af9edfe1c2",
                                                "text": "Der kirgisische Außenminister ist heute in Berlin."
