                "senses": [
                    {
                        "sense_id": "013548cb-d567-3bea-a309-2a68da855d24",
                        "entry_id": "a60bb95b-9dce-3796-b931-09642e964459",
                        "glosses": [
                            "ein bestimmter Verlag, bei dem Werke einer bestimmten Person üblicherweise verlegt werden"
                        ],
                        "tags": [
                            "Verlagswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "42225ff8-0137-4269-ba9b-05eb70ff2715",
                                "sense_id": "013548cb-d567-3bea-a309-2a68da855d24",
                                "text": "Dazu gehörte immer wieder der heftige Flirt mit einem anderen Verlag, um vermeintlichen Druck auf seinen Hausverlag ausüben und diesen zu Zugeständnissen bewegen zu können."
                            },
                            {
                                "example_id": "e7a6d4c1-5850-4719-a48b-fc0b1e88c607",
                                "sense_id": "013548cb-d567-3bea-a309-2a68da855d24",
                                "text": "»Ich wusste gar nicht, dass Southbank Press sein Hausverlag ist!«"
                            },
                            {
                                "example_id": "6e8910ee-3cae-4cf2-af01-478b3716cb9e",
                                "sense_id": "013548cb-d567-3bea-a309-2a68da855d24",
                                "text": "Hüttenegger hat sich die Verlagsleiter rauf und runter gegeben, ohne bis heute einen Hausverlag zu finden, der lansgam an eine Sammlung seiner Werke denken würde. Er ist gleichsam der Klassiker ohne die klassische Ingredienzien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
