                        "cross_references": [
                            {
                                "target_word": "delay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "A period of time before an event occurs; the act of delaying; procrastination; lingering inactivity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca59359-3671-43c4-bae9-f1227937be5d",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "the delay before the echo of a sound"
                                            },
                                            {
                                                "example_id": "fa0bae20-7abf-48d9-b727-cd9ae31bb543",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "Two twenty minutes' delays."
                                            },
                                            {
                                                "example_id": "57370198-f0a0-45d3-9d75-1768b0e5eff4",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "Without any delay, on the morrow I sat on the judgment seat."
                                            },
                                            {
                                                "example_id": "092f1a0d-5213-4133-a400-216351626c3e",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "The government ought to be settled without the delay of a day."
                                            },
                                            {
                                                "example_id": "d14bb36b-c1b4-4fc2-b592-01b4bf38ff32",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "In this article I'm thinking about the big delays, over two hours. While rare, they make the news and help to deter people from future rail travel, both travellers and news viewers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a58c50e7-e573-30ca-bc98-bbf9084990b3",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "An audio effects unit that introduces a controlled delay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f9bb1a5-e7d6-4c91-995e-5a3a96b8925c",
                                                "sense_id": "a58c50e7-e573-30ca-bc98-bbf9084990b3",
                                                "text": "The 8-bit sound quality of many early delays did indeed leave a lot to be desired (compare this to the 16-bit digital technology of CDs)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53387a4-8456-3dcf-ab6f-c826bd134a59",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "Synonym of promise (“object representing delayed result”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee3c1329-4b4e-34ee-89cb-8676eaa6c541",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "An amount of time provided on each move before one's clock starts to tick; a less common time control than increment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "delay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "171b90e1-0fb8-3018-8e38-8eb3640670cd",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To put off until a later time; to defer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6f74b1b-3ef2-43ef-833a-e4256020e24c",
                                                "sense_id": "171b90e1-0fb8-3018-8e38-8eb3640670cd",
                                                "text": "My lord delayeth his coming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa25dcf-a83b-34c6-b8c3-c2e381d402bd",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To retard; to temporarily stop, detain, or hinder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754800ef-2b9c-4007-a659-b5e07673a875",
                                                "sense_id": "afa25dcf-a83b-34c6-b8c3-c2e381d402bd",
                                                "text": "The mail is delayed by a heavy fall of snow."
                                            },
                                            {
                                                "example_id": "b0b22a4c-2a0e-44f8-b5ff-bb3662743bb6",
                                                "sense_id": "afa25dcf-a83b-34c6-b8c3-c2e381d402bd",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5140184-60eb-3b6b-881e-d09074caa5d4",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To wait, hesitate, tarry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557c86ce-61ca-4e4d-bf84-0e30115c35e8",
                                                "sense_id": "d5140184-60eb-3b6b-881e-d09074caa5d4",
                                                "text": "Don't delay; this special offer ends at midnight!"
                                            },
                                            {
                                                "example_id": "799f89ac-3666-4e0d-9990-79766eb2f558",
                                                "sense_id": "d5140184-60eb-3b6b-881e-d09074caa5d4",
                                                "text": "Don't delay\nSomething tells me I gotta go away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47cb27d5-1b13-3c65-91f1-f7f97b8bd34a",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To allay; to temper."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d878e74-7315-4e81-88c8-775ba2204889",
                                                "sense_id": "47cb27d5-1b13-3c65-91f1-f7f97b8bd34a",
                                                "text": "The watery showers delay the raging wind."
                                            }
                                        ]
                                    }
                                ]
                            },
