                                                "sense_id": "c86a4681-e0da-35a3-b53b-77da2c78f8db",
                                                "text": "Ona zachowuje się jak typowy Baran."
                                            },
                                            {
                                                "example_id": "7e1bd525-fae9-4060-89b2-b7ea9339b8e1",
                                                "sense_id": "c86a4681-e0da-35a3-b53b-77da2c78f8db",
                                                "text": "Mój tata jest zodiakalnym Baranem, a mama – zodiakalną Panną."
                                            },
                                            {
                                                "example_id": "1fe4df94-cb44-4bff-8913-8a1cb949437b",
                                                "sense_id": "c86a4681-e0da-35a3-b53b-77da2c78f8db",
                                                "text": "Baran i Rak: horoskop partnerski podpowiada, że to połączenie nie wróży niczego dobrego."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
