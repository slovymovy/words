                                "target_senses": [
                                    {
                                        "sense_id": "3d5cc78a-83d2-3fc7-92ee-848c3e1d404a",
                                        "entry_id": "be2fb977-d7dd-3448-9349-b4b1cdbe1546",
                                        "glosses": [
                                            "Relatif à la navigation aérienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72548190-8959-493a-b5e5-3ceb182f53bc",
                                                "sense_id": "3d5cc78a-83d2-3fc7-92ee-848c3e1d404a",
                                                "text": "Ce parc aéronautique s’étendait vers le nord, aussi loin que Bert pouvait voir, méthodiquement aménagé, avec ses hangars numérotés, ses gazomètres, ses campements, ses magasins."
                                            },
                                            {
                                                "example_id": "d5f0afda-2e0a-4632-bebe-cc8db688752c",
                                                "sense_id": "3d5cc78a-83d2-3fc7-92ee-848c3e1d404a",
                                                "text": "En parlant à tour de rôle devant le microphone, nous aurions dû dire que notre victoire était celle de la technique aéronautique française et de la météorologie, beaucoup plus que le triomphe de deux hommes."
                                            },
                                            {
                                                "example_id": "04862390-f572-40de-99d5-7df399233c77",
                                                "sense_id": "3d5cc78a-83d2-3fc7-92ee-848c3e1d404a",
                                                "text": "M. Garneau a été incapable de s’entendre avec l’industrie aéronautique qui demandait de l’aide d’urgence durant la pandémie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aéronautique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                                        "entry_id": "0c4331df-3312-39e6-866b-b7281919d675",
                                        "glosses": [
                                            "Art de la navigation aérienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b26c41-a1b5-4d95-b386-995484169fb9",
                                                "sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                                                "text": "L’engouement pour l’aéronautique commençait."
                                            },
                                            {
                                                "example_id": "7853b1a0-a73b-49f2-b5cd-9eeadf7ff25c",
                                                "sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                                                "text": "L'aéronautique navale est la composante aérienne d'une marine militaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
