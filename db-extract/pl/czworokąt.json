                    },
                    {
                        "translation_id": "1d9925c0-9bd7-4af4-a8a2-31d4820cf460",
                        "source_entry_id": "ef8da256-1668-393d-a204-90748c8ce087",
                        "source_sense_id": "05980ee9-79d1-37d9-8aac-c3c411646ad6",
                        "target_lang_word": "Viereck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viereck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fa2ca08-f9bd-3e8f-99db-91fd68e21c9c",
                                        "entry_id": "8ef09d85-de6b-3e2e-b30d-89877db4ef4e",
                                        "glosses": [
                                            "ebenes (zweidimensionales) Vieleck (Polygon) mit vier Ecken und vier Seiten"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3994e9-42c7-4a5b-8104-829010d35c83",
                                                "sense_id": "7fa2ca08-f9bd-3e8f-99db-91fd68e21c9c",
                                                "text": "„Die Summe der Innenwinkel eines Vierecks beträgt 360°: α + β + ɣ + δ = 360°“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                        "entry_id": "8ef09d85-de6b-3e2e-b30d-89877db4ef4e",
                                        "glosses": [
                                            "einem Quadrat oder Rechteck ähnliche Form/Figur"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de721290-1d64-4a0c-987c-f48c143862cd",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Ein gerahmtes Bild, von unten gesehen, erscheint nicht wie ein Viereck sondern verliert seine Proportionen und rechte Winkel.“"
                                            },
                                            {
                                                "example_id": "ef2f3ad0-ea24-420f-a92d-a1fd5d0bea2d",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Sie waren etwas erweiterte Lichtspalten, rimae weniger Quadrate als Rechtecke, breit unter 2 bis gegen 3 Fuß, 63 bis 94 cm (Diocletian-Palast), hoch 3 Fuß bis 6 Fuß 8 Zoll (Diocletian), 94 bis 210 cm, oben auch mit dem Bogen schließend, mit dem Doppelbogen, mit Gesimszugabe aus Ziegel und Stein; übrigens mögen auch breite niedrige Viereck-Fenster und rundliche nicht gefehlt haben.“"
                                            },
                                            {
                                                "example_id": "25b2542d-e60d-462a-982c-d0a95c9950c0",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Das Viereck ist also nur ein Ausschnitt, man hat es in seiner Phantasie in alle Richtungen endlos auszudehnen.“"
                                            },
                                            {
                                                "example_id": "c59b52b7-c475-4b56-a04f-e860c6841736",
                                                "sense_id": "cb870d36-652e-317c-a095-71dda3de5c55",
                                                "text": "„Unter dem Viereck gewaltiger Steinblöcke sollen sich einige Grabkammern befinden, in denen angeblich reich verzierte Tongefäße wie auch menschliche Knochen und Schädel entdeckt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
