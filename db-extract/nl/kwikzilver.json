                "translations": [
                    {
                        "translation_id": "57be0d23-e118-4669-86e1-35bf09d34d96",
                        "source_entry_id": "9a502a05-e64d-3878-891e-f722c68e99ed",
                        "source_sense_id": "ea46c189-a7fd-39bc-8894-fcffc35981ed",
                        "source_sense_description": "een metaal dat vloeibaar is bij kamertemperatuur",
                        "target_lang_word": "Quecksilber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quecksilber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5488c8b3-0684-34cb-a5b2-812a4cfc3b89",
                                        "entry_id": "921cefd3-dbf0-3927-a071-719584c261d7",
                                        "glosses": [
                                            "ein chemisches Element mit der Ordnungszahl 80, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdcf05c-7e8f-48c8-90b5-9a37e47bf073",
                                                "sense_id": "5488c8b3-0684-34cb-a5b2-812a4cfc3b89",
                                                "text": "Quecksilber ist bei Zimmertemperatur flüssig."
                                            },
                                            {
                                                "example_id": "b88a7d5c-55ab-4912-a80a-fcb251bfc3f1",
                                                "sense_id": "5488c8b3-0684-34cb-a5b2-812a4cfc3b89",
                                                "text": "„Aber in ihrem Liebesthermometer war das Quecksilber unaufhörlich gefallen.“"
                                            },
                                            {
                                                "example_id": "ac9c1389-8f8e-4f7d-97f4-7d9df1fc66c4",
                                                "sense_id": "5488c8b3-0684-34cb-a5b2-812a4cfc3b89",
                                                "text": "„Seine Augen hatten die Farbe von Quecksilber.“"
                                            },
                                            {
                                                "example_id": "44b50155-922f-4737-9cd2-772de98e5dd4",
                                                "sense_id": "5488c8b3-0684-34cb-a5b2-812a4cfc3b89",
                                                "text": "„Die See dunstete schwach und spiegelte wie Quecksilber.“"
                                            },
                                            {
                                                "example_id": "1b69324c-d7c6-44c5-a781-fc521dec01eb",
                                                "sense_id": "5488c8b3-0684-34cb-a5b2-812a4cfc3b89",
                                                "text": "„Geschlechtskrankheiten wurden meist – wenn überhaupt – mit Quecksilber behandelt, das zwar eine Linderung der sichtbaren Symptome brachte, aber auch Nebenwirkungen wie Sabbern und Gleichgewichtsprobleme zur Folge hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "784d963b-645a-4e28-85a4-f882da8eea41",
