                    {
                        "sense_id": "55252399-6daa-3604-b494-962d245d1d0a",
                        "entry_id": "8e34b3dd-bd83-3ae5-bbea-911b2508685a",
                        "glosses": [
                            "Blouse portée par les hommes et les femmes au Moyen Âge."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "fcdd44e0-6e22-4c26-9b27-bd728bae9a7a",
                                "sense_id": "55252399-6daa-3604-b494-962d245d1d0a",
                                "text": "L'ancien bliaut, qui était un vêtement même pour les seigneurs, paraît répondre, en tant que mot, à la blaude, vêtement des paysans et des ouvriers."
                            },
                            {
                                "example_id": "7add991f-9882-4e14-868b-498608c8dbb6",
                                "sense_id": "55252399-6daa-3604-b494-962d245d1d0a",
                                "text": "Le bliaud était très souvent porté avec une ceinture décorative très longue."
                            },
                            {
                                "example_id": "c2acf901-58e7-422f-8089-4ba032014a15",
                                "sense_id": "55252399-6daa-3604-b494-962d245d1d0a",
                                "text": "Comme vêtement à mettre par dessus la chemise on avait le choix entre le chainse, le bliaut, la cotte, la pelisse et même le surcot."
                            }
                        ]
                    }
