                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4b4b6bcd-89f5-331d-a8c6-643740fda4cd",
                        "entry_id": "f525fd83-d442-39d9-8602-dfc03a59cf11",
                        "glosses": [
                            "iets dat bijzonder aangenaam of nuttig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd080057-e64f-4196-b9fe-875786973013",
                                "sense_id": "4b4b6bcd-89f5-331d-a8c6-643740fda4cd",
                                "text": "Een strakblauwe hemel domineert in het blikveld, het is alsof de sparren respectvol uit zicht blijven. De weldaad van een kale vlakte volgt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f0af613-df1d-4b9d-abae-d21e564c21a9",
                        "source_entry_id": "f525fd83-d442-39d9-8602-dfc03a59cf11",
                        "source_sense_id": "a7bdc3be-197e-3156-a4bb-db5e8484ad2a",
                        "source_sense_description": "een goede daad voor iemand doen",
                        "target_lang_word": "Wohltat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohltat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                        "entry_id": "631a2e94-dea7-393c-a2b0-643d9036bcb4",
                                        "glosses": [
                                            "freiwillige Aktion, mit der jemand einem Bedürftigen oder einer Gruppe Armer hilft ohne Gegenleistung; selbstlose Hilfe"
                                        ],
                                        "tags": [
                                            "Gesellschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc7cda79-4ef5-4e91-853d-7785fba8f443",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "Die 'Tafeln' sind Organisationen in Deutschland, die Wohltaten an Hungrige verteilen."
                                            },
                                            {
                                                "example_id": "cf8a05b9-0822-4f91-8a68-4f0adeccba31",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "Wie soll ich dem HERRN vergelten alle seine Wohltat, die er an mir tut?"
                                            },
                                            {
                                                "example_id": "d2225b09-d179-4a3d-b1b2-4e79932cb3ee",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "[…] jede Wohltat, die wir zugunsten des anderen erbringen, [ist] stets auch ein Dienst an G’tt. Die Hilfe und die Wohltat für unsere Mitmenschen ist von einem dualen Charakter geprägt, der Erfüllung g’ttlicher und gleichzeitig menschlicher Mizwot."
                                            },
                                            {
                                                "example_id": "05746ecc-6cae-44b4-b0df-16beee0c9c5a",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "Allen traditionellen Religionsgemeinschaften ist der Glaube gemeinsam, dass die Gottheiten Wohltaten (riyaku) in diesem oder dem nächsten Leben gewähren können. Die Alltagsreligiosität ist auch heute noch stark auf die Erlangung solcher Wohltaten ausgerichtet."
                                            },
                                            {
                                                "example_id": "63faf8b4-eb56-47ce-a8dc-c9b79e48b65f",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "In der umfangreichen Schrift De beneficiis (Über die Wohltaten), seinem moralphilosophischen Hauptwerk, setzte sich Seneca ausführlich mit der Frage auseinander, in welcher Gesinnung Wohltaten zu erweisen und zu empfangen sind."
                                            },
                                            {
                                                "example_id": "e07bc76f-fe2f-4890-ac1a-3b0593e34ba8",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "Unglaubliche 25 Milliarden Euro wird die Bundesregierung 2018 für Finanzhilfen und Steuervergünstigungen ausgeben. Längst nicht alle Wohltaten leuchten ein."
                                            },
                                            {
                                                "example_id": "49173089-e39d-43b3-8df4-f669407c0b81",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "Die SPD bringt die Beitragsparität in den Koalitionsvertrag ein und ausgerechnet ein betont konservativer CDUler darf den gesetzlich Versicherten diese Wohltat verkaufen."
                                            },
                                            {
                                                "example_id": "a4f17a3c-b4e3-4b7b-8771-d1b753ed6643",
                                                "sense_id": "44194a02-9e34-34c9-8660-15d7a9ee63a1",
                                                "text": "[Italien:] Es [das Regierungsprogramm] verspricht Steuersenkungen für die Klientel der Lega und soziale Wohltaten für die Wähler der \"Fünf Sterne\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                        "entry_id": "631a2e94-dea7-393c-a2b0-643d9036bcb4",
                                        "glosses": [
                                            "etwas, was eine positive, angenehme Wirkung auf jemanden hat"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0877575b-3034-429c-9f87-7f7f7db752fc",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "„Ein Glas kühles, klares Wasser ist so eine Wohltat an einem Hitzetag wie diesem!“"
                                            },
                                            {
                                                "example_id": "c1db614f-f5ed-45cf-8a36-8bf16812b66e",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "Die Strahlen der Sonne an einem kühlen Frühlingstag sind eine wahre Wohltat auf der Haut."
                                            },
                                            {
                                                "example_id": "a7717e49-f553-4558-845a-44f3dde9bf53",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "„Diese Stille ist eine Wohltat für meine Ohren!“"
                                            },
                                            {
                                                "example_id": "afc20da5-8e14-4923-8516-d8132eb0b39b",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "Barfuß am Strand spazieren gehen, mit jedem Schritt zentimetertief im nassen Sand versinken, das auflaufende Wasser um die Füße spielen lassen - welch ein Wohltat."
                                            },
                                            {
                                                "example_id": "f81e49c5-906e-42cb-9c47-e2dd2c5e55bb",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "[… ich] betrete eine Gasse hinter der Paizza [sic!] von Amalfi, gehe ein paar Treppen hoch und komme auf einen bequemen Weg in die Schlucht hinter Amalfi. Irgendwann sehe ich das Meer gar nicht mehr. Nur kühles Grün und das sanfte Plätschern eines Baches. […] Eine Wohltat, dieser ruhige Weg in die eingeschnittene Schlucht des Küstenstreifens."
                                            },
                                            {
                                                "example_id": "a85dd61e-2b0c-4b21-ad85-6ebed1aa19f1",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "Als die Gesellschaft auf die Straße hinaus trat, lag eine milde, blaue Nacht über der Stadt. Alle empfanden diese kühle und weiche Luft nach dem schwülen und augenbrennenden Dunst des Wirtshauses wie eine Wohltat."
                                            },
                                            {
                                                "example_id": "7b438592-6849-4cd5-8167-ca1a25140ab4",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "In der aufgeheizten Debatte über den Islam ist dieses sachliche und äußerst fundierte Buch geradezu eine Wohltat."
                                            },
                                            {
                                                "example_id": "656627dd-85a0-4bee-a767-47a7837daa79",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "[IKG-Präsidentin Charlotte Knobloch:] „Es ist immer wieder ein Glücksgefühl und eine Wohltat, Menschen zu erleben, die aus Überzeugung und beherzt helfen möchten. Die einen Missstand erkennen und diesen beseitigen wollen, unbürokratisch und ohne großes Aufsehen.“"
                                            },
                                            {
                                                "example_id": "3932584c-300a-4df9-9ea0-2e5a01b7290f",
                                                "sense_id": "bf571a29-cd45-35aa-8b22-4444812d370e",
                                                "text": "Die verbreitete neue deutsche Offenheit zu erleben, die Willkommenskultur, ist eine Wohltat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "267385b5-c687-486e-95ff-2b6d49757e5d",
                        "source_entry_id": "f525fd83-d442-39d9-8602-dfc03a59cf11",
                        "source_sense_id": "a7bdc3be-197e-3156-a4bb-db5e8484ad2a",
