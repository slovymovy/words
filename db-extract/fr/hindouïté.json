                        "entry_id": "ffa13116-6411-33fd-8a70-09a5a7a90df1",
                        "glosses": [
                            "Concept politique nationaliste indien : qualité d’être d’Inde, en particulier d’héritage hindou, sans influence culturelle extérieure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe5e2d40-2cd2-437e-81c1-a59739272f98",
                                "sense_id": "1de5325c-66e9-30e2-bbf2-ea050200623e",
                                "text": "Pendant la campagne électorale du printemps 2004, le BJP a davantage mis l'accent sur les succès remportés en matière économique que sur la défense de l’hindouïté."
                            },
                            {
                                "example_id": "4b0cccf7-441e-4a19-98b0-b068692d21d3",
                                "sense_id": "1de5325c-66e9-30e2-bbf2-ea050200623e",
                                "text": "C’est ainsi que se décline l’idéologie nationaliste de Hindutva, ou d’hindouïté."
                            }
                        ]
                    }
                ],
