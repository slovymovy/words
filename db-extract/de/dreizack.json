                                        "glosses": [
                                            "Fourche à trois dents, à trois pointes, que les poètes et les peintres donnent pour sceptre à Neptune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be45d951-4ee3-4f48-845f-36bd1394d72a",
                                                "sense_id": "bf5890f6-1a01-39f9-9ebc-0dd55f738f59",
                                                "text": "Des hommes, armés, comme Neptune, d'une sorte de trident appelé vulgairement fichouire, se mettent dans la mer jusqu'à la ceinture ; […]."
                                            }
                                        ]
                                    },
