                    {
                        "translation_id": "11e0109c-6213-45f5-a579-0201e8a0aab0",
                        "source_entry_id": "f4c79b53-3e3a-343a-a6d8-7cf92da4f8c5",
                        "target_lang_word": "Kronprinz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kronprinz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                        "entry_id": "597512f1-baad-3b38-b50f-98e5c62d9fc6",
                                        "glosses": [
                                            "nachfolgeberechtigter Sohn oder Enkel eines Königs oder Kaisers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8362249a-b636-42a0-8d0a-59bd37214b41",
                                                "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                                "text": "„Mit der Thronbesteigung seines Vaters Wilhelm I. avancierte Friedrich Wilhelm 1861 zum preußischen Kronprinzen.“"
                                            },
                                            {
                                                "example_id": "d362d0a8-48d5-4fa9-9bbf-b543a5b0e1cf",
                                                "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                                "text": "„Der begeisterte sich schon als Kronprinz für die Rheinromantik, und darum gefiel er den Rheinländern.“"
                                            },
                                            {
                                                "example_id": "805ae063-b676-405a-ac4f-e8e5ba92bec5",
                                                "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                                "text": "„Es war mitten im Sommer, Mama und Papa waren verreist, in England drängten sich die Leute auf den Straßen, sie schwenkten Fähnchen und johlten und freuten sich, denn endlich hatte der Kronprinz eine gefunden, die er heiraten wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
