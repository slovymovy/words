                    {
                        "sense_id": "2e4bc012-dbaf-3e4c-8b70-f9653a2dc448",
                        "entry_id": "0780fa87-06ef-32dd-a3c0-0576a040010b",
                        "glosses": [
                            "To make real; to realize."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ada59433-9b91-310b-a500-0c94aafd69c2",
                        "entry_id": "0780fa87-06ef-32dd-a3c0-0576a040010b",
                        "glosses": [
                            "To become actual or real."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aa577b00-f4f1-3d6a-a8ff-f9acc3227013",
                        "entry_id": "0780fa87-06ef-32dd-a3c0-0576a040010b",
                        "glosses": [
                            "To realize one's full potential."
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ae1b4c8-164f-4357-a0bd-1d0c33e8d4fc",
                        "source_entry_id": "0780fa87-06ef-32dd-a3c0-0576a040010b",
                        "source_sense_description": "make real",
                        "target_lang_word": "realisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a722eaf-f3b3-32a8-bf63-40e75ff6981f",
                                        "entry_id": "926a0457-7d43-398b-b1c4-cb7652dd121a",
                                        "glosses": [
                                            "einen Plan verwirklichen, in die Tat umsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dfc3e8-73b9-4859-96a5-3a928248a52a",
                                                "sense_id": "5a722eaf-f3b3-32a8-bf63-40e75ff6981f",
                                                "text": "Sie konnte das große Projekt jedoch nicht mehr realisieren."
                                            },
                                            {
                                                "example_id": "c0336cd2-f011-442c-9ac0-c02fa4fcc1e6",
                                                "sense_id": "5a722eaf-f3b3-32a8-bf63-40e75ff6981f",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afba7d07-940c-38c1-a391-e7cdea22bc76",
                                        "entry_id": "926a0457-7d43-398b-b1c4-cb7652dd121a",
                                        "glosses": [
                                            "in echten Wert umsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d62161-e046-46a1-8263-2f664190a990",
                                                "sense_id": "afba7d07-940c-38c1-a391-e7cdea22bc76",
                                                "text": "Auf dem kontrahierten Markt können sie ihre Gewinne nicht realisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "715344ad-d879-3bff-8779-7c42143bd5dd",
                                        "entry_id": "926a0457-7d43-398b-b1c4-cb7652dd121a",
                                        "glosses": [
                                            "sich einer Sache bewusst werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a5e8da-072e-4aca-a8c8-ece1f4095c57",
                                                "sense_id": "715344ad-d879-3bff-8779-7c42143bd5dd",
                                                "text": "„Ich kann das alles noch nicht recht realisieren.“"
                                            },
                                            {
                                                "example_id": "6fc4e087-324c-42a7-b7fc-986c24769604",
                                                "sense_id": "715344ad-d879-3bff-8779-7c42143bd5dd",
                                                "text": "Er sagte, der Gegner solle endlich realisieren, dass er keine Chance habe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebbf05d2-eb14-42b9-b882-33e137fc0a04",
                        "source_entry_id": "0780fa87-06ef-32dd-a3c0-0576a040010b",
                        "source_sense_description": "make real",
                        "target_lang_word": "verwirklichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwirklichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "482b0462-e9ed-3205-8c1b-5453ed31133b",
                                        "entry_id": "10e65264-2d54-3b04-879d-051bda495b00",
                                        "glosses": [
                                            "von der Theorie in die Realität umsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8f7791-bc73-455f-a6cf-6d7f50ccb2eb",
                                                "sense_id": "482b0462-e9ed-3205-8c1b-5453ed31133b",
                                                "text": "Jetzt geht es darum, die geplanten Sparmaßnahmen zu verwirklichen."
                                            },
                                            {
                                                "example_id": "21e5e9cf-8608-4073-bc0d-4a0099ce6c72",
                                                "sense_id": "482b0462-e9ed-3205-8c1b-5453ed31133b",
                                                "text": "„Glauben Sie mir: Das, was wir wirklich erträumen können, das können wir auch verwirklichen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b1f3750-2b15-3fc3-8ab3-89945b89d7c8",
                                        "entry_id": "10e65264-2d54-3b04-879d-051bda495b00",
                                        "glosses": [
                                            "sich ungehindert den eigenen Ideen und Anlagen entsprechend entwickeln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a9991e-920a-435a-9f1d-909420572714",
                                                "sense_id": "1b1f3750-2b15-3fc3-8ab3-89945b89d7c8",
                                                "text": "Man sollte immer versuchen, sich durch seine Arbeit zu verwirklichen."
                                            },
                                            {
                                                "example_id": "8e41fdd0-1aac-4561-b4be-f99620069eb3",
                                                "sense_id": "1b1f3750-2b15-3fc3-8ab3-89945b89d7c8",
                                                "text": "„Wir inszenieren uns für andere, wenn wir uns selbst zu verwirklichen suchen, weil das Selbst immer schon eine Sicht auf uns selbst von anderen Personen her und damit von außen darstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "69eeb681-b009-35c0-9453-a3a512f31161",
                                        "entry_id": "10e65264-2d54-3b04-879d-051bda495b00",
                                        "glosses": [
                                            "sich den innewohnenden Ideen entsprechend in die Realität umsetzen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad23829-d56b-468f-aff1-9b28d9fd8cac",
                                                "sense_id": "69eeb681-b009-35c0-9453-a3a512f31161",
                                                "text": "Als sie den Bauernhof kaufen konnte, verwirklichte sich ihr Jugendtraum."
                                            },
                                            {
                                                "example_id": "abc4d655-b4aa-42f5-a186-ee6de53ffae8",
                                                "sense_id": "69eeb681-b009-35c0-9453-a3a512f31161",
                                                "text": "Heute hatten sich seine schlimmsten Befürchtungen verwirklicht."
                                            },
                                            {
                                                "example_id": "2bfb6119-5544-4cbf-b174-a61903b3fe21",
                                                "sense_id": "69eeb681-b009-35c0-9453-a3a512f31161",
                                                "text": "„Die Vorstellung, dass erst eine ausgeprägte Verbände- und Interessenvertretungslandschaft einen Staat vollständig konsolidieren kann, verwirklichte sich in den mittel- und osteuropäischen Ländern somit in der Realität bis heute nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
