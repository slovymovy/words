                "senses": [
                    {
                        "sense_id": "61fec1a5-3472-30cc-a99d-15d81563bc2e",
                        "entry_id": "fff04d53-b665-3166-8372-7530e87b5c7c",
                        "glosses": [
                            "Emplacement disposé pour des animaux de terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3ac2f8-a9ca-462f-91f1-d032457d71b4",
                                "sense_id": "61fec1a5-3472-30cc-a99d-15d81563bc2e",
                                "text": "La Gazette de la Bourse annonce… une exposition [russe] dont voici le programme : nᵒ 1 collections d’animaux domestiques… ; nᵒ 11 aquariums et terrariums ; nᵒ 12 animaux de chasse."
                            },
                            {
                                "example_id": "ce903d73-7c74-4676-8c15-256ec59db468",
                                "sense_id": "61fec1a5-3472-30cc-a99d-15d81563bc2e",
                                "text": "Quelle est cette drôle de bête en forme de feuille ou de brindille ? C'est un phasme, complètement invisible, qui avance à tâtons. Amateur de feuilles d'eucalyptus ou de lierre, il est facile à élever en terrarium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e05e459b-1866-42f7-9a14-7c006faf2a17",
                        "source_entry_id": "fff04d53-b665-3166-8372-7530e87b5c7c",
                        "source_sense_id": "61fec1a5-3472-30cc-a99d-15d81563bc2e",
                        "target_lang_word": "Terrarium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrarium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3780ae26-93ae-3fc9-b6b3-95e4a3ad7e0c",
                                        "entry_id": "8b9b979e-e854-3ed1-9e8e-bc0f14101c8e",
                                        "glosses": [
                                            "ein meist aus Glas gefertigter Behälter, in dem kleinere Tiere (Kriechtiere, Lurche, Insekten, Spinnen) und/oder Pflanzen gezüchtet und beobachtet werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd4ace8-0712-4f1b-b679-1b517534106b",
                                                "sense_id": "3780ae26-93ae-3fc9-b6b3-95e4a3ad7e0c",
                                                "text": "„Damals stand in seinem Zimmer ein Terrarium, in dem er Reptilien hielt.“"
                                            },
                                            {
                                                "example_id": "ed712bd5-f8a9-42ba-a031-71891ecf2845",
                                                "sense_id": "3780ae26-93ae-3fc9-b6b3-95e4a3ad7e0c",
                                                "text": "„Doch als er die Spinnen aus dem Terrarium holte, stieß eine der Mütter einen spitzen Schrei aus.“"
                                            },
                                            {
                                                "example_id": "c0fe6cff-484c-4aca-a40b-b4a7f7901e6f",
                                                "sense_id": "3780ae26-93ae-3fc9-b6b3-95e4a3ad7e0c",
                                                "text": "„Das Terrarium steht am Fenster neben der Glastür zum Balkon.“"
                                            },
                                            {
                                                "example_id": "e776469d-5df7-4837-ac05-22cf58e53c33",
                                                "sense_id": "3780ae26-93ae-3fc9-b6b3-95e4a3ad7e0c",
                                                "text": "„Auf meinen Beinen lag inzwischen einer meiner Reiseatlanten, während ich die Schildkröten in ihrem Terrarium auf dem Rücksitz hinter mir angeschnallt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
