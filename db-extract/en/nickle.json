                    {
                        "sense_id": "cd249f03-0997-3bc8-9c93-8aea1151bfeb",
                        "entry_id": "0c26d16f-cff8-3ca7-b6a6-440dcdd2eb97",
                        "glosses": [
                            "Misspelling of nickel."
