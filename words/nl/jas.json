                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>jassen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form_1sg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>jas</w> snel even de aardappels voor het avondeten.",
                            "target_lang_translations": {
                                "en": "I'll quickly <w>peel</w> the potatoes for dinner.",
                                "ru": "Я быстро <w>почищу</w> картошку к ужину.",
                                "zh": "我晚饭前赶紧把土豆<w>削</w>了。",
                                "pl": "Szybko <w>obieram</w> ziemniaki na kolację."
                            }
                        },
                        {
                            "text": "Ik <w>jas</w> mijn werk erdoorheen zodat ik vroeg naar huis kan.",
                            "target_lang_translations": {
                                "en": "I'll <w>rush</w> through my work so I can go home early.",
                                "ru": "Я быстро <w>сделаю</w> свою работу, чтобы пораньше пойти домой.",
                                "zh": "我<w>赶快做</w>完工作，这样就能早点回家。",
                                "pl": "Szybko <w>robię</w> swoją pracę, żeby móc wcześniej wrócić do domu."
                            }
                        }
