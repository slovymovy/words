                    }
                ],
                "senses": [
                    {
                        "sense_id": "322c4676-5d55-378b-824a-6c109db19df3",
                        "entry_id": "f2b0c7fa-fb8a-3f32-99c6-cbc5a8eb4dd8",
                        "glosses": [
                            "een kledingstuk dat de drager bewegingsvrijheid van de armen en handen ontneemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1dc12b-cb9c-46ff-a9b6-c7a14f89341c",
                                "sense_id": "322c4676-5d55-378b-824a-6c109db19df3",
                                "text": "Om te voorkomen dat de psychiatrische patiënt zichzelf letsel toe zou brengen werd hem een dwangbuis aangedaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe745d11-f76c-4a74-a9e0-3acc21c03860",
                        "source_entry_id": "f2b0c7fa-fb8a-3f32-99c6-cbc5a8eb4dd8",
                        "source_sense_id": "322c4676-5d55-378b-824a-6c109db19df3",
                        "source_sense_description": "een kledingstuk dat de drager bewegingsvrijheid van de armen en handen ontneemt",
                        "target_lang_word": "Zwangsjacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwangsjacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                        "entry_id": "0f5fe02f-fd69-3b65-a81a-46977ca6e0ee",
                                        "glosses": [
                                            "eine Jacke aus festem Stoff, die hinten geschlossen wird und deren Ärmel auf dem Rücken miteinander verknotet werden, so dass die Person, die sie trägt, ruhig gestellt wird, da sie sich nicht mehr völlig frei bewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce15d272-1acb-424a-a9bb-0e9a2e53c043",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "Im medizinischen Bereich darf der Träger einer Zwangsjacke deshalb auch nicht ohne regelmäßige Kontrolle in dieser fixiert werden."
                                            },
                                            {
                                                "example_id": "ffaf08c2-07f1-4b3b-af33-9e35b7c6c0d9",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„Schumann musste demütigende Zwangsmaßnahmen erdulden: Wenn die Pfleger seiner nicht mehr Herr wurden, stellten sie ihn mit Medikamenten ruhig oder steckten ihn in eine Zwangsjacke.“"
                                            },
                                            {
                                                "example_id": "a86ff14a-4b43-40c0-be8a-458f93c2d67f",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„Er sah aus wie einer, der in einer Zwangsjacke steckte.“"
                                            },
                                            {
                                                "example_id": "21af6f62-92f9-4bdb-81d2-a9118f827dd4",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„Am Schluss ist Malvolio in die Zwangsjacke versetzt, weil ihn die Gräfin für wahnsinnig hält, und er verliert wirklich den Verstand.“"
                                            },
                                            {
                                                "example_id": "7c0130e6-3980-4293-af05-4c49c50a7943",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„1793 wurden zunächst die Ketten durch Zwangsjacken ersetzt, die allerdings nur noch auf ärztliche Anordnung verwendet werden durften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                        "entry_id": "0f5fe02f-fd69-3b65-a81a-46977ca6e0ee",
                                        "glosses": [
                                            "Umstände oder eine Situation, die als Einengung oder Beschränkung empfunden werden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c356c986-082c-4bdb-a1e1-7e5662c27b2d",
                                                "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                                "text": "Die islamischen Machtpolitiker wollen das Volk in eine religiöse Zwangsjacke stecken."
                                            },
                                            {
                                                "example_id": "0f3c8b20-7663-45d7-b17d-5da5bcc8dfd4",
                                                "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                                "text": "Die Geschlechterstereotypisierungen in der Werbung stecke Frauen, Männer, Mädchen und Jungen \"quasi in eine Zwangsjacke(…), die häufig für beide Geschlechter entwürdigend, erniedrigend und entmündigend sind\", heißt es in einem Berichtsentwurf des Ausschusses für die Gleichstellung der Geschlechter."
                                            },
                                            {
                                                "example_id": "4bc1f196-af9e-4b7e-acdb-197b196ebb6c",
                                                "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                                "text": "„Es ist die Sprache, die Kinder von den Regeln befreit, sie aus der Zwangsjacke der Hygiene und des Anstands, wenn sie unter sich waren, herausnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "904ea595-d000-4dc0-86cc-01e76684f5a4",
                        "source_entry_id": "f2b0c7fa-fb8a-3f32-99c6-cbc5a8eb4dd8",
                        "source_sense_id": "322c4676-5d55-378b-824a-6c109db19df3",
                        "source_sense_description": "een kledingstuk dat de drager bewegingsvrijheid van de armen en handen ontneemt",
                        "target_lang_word": "straitjacket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "straitjacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c83ce09c-e812-34cc-89c2-c09d57ed521b",
                                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                                        "glosses": [
                                            "A jacket-like garment with very long sleeves which can be secured in place, thus preventing the wearer from moving his or her arms. Often used in psychiatric hospitals to prevent patients from injuring themselves or others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ecd8d88-11d7-4eb7-afbd-aa1f0a820e06",
                                                "sense_id": "c83ce09c-e812-34cc-89c2-c09d57ed521b",
                                                "text": "There’s a couple of people actually wearing duct-tape straitjackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                                        "glosses": [
                                            "Any situation seen as confining or restricting."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae282672-e8da-4400-846b-551b4c327b57",
                                                "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                                "text": "our ever-increasing bureaucratic straitjacket of regulations"
                                            },
                                            {
                                                "example_id": "ee4eb903-6235-42d7-a3ce-fbe99f1c4a53",
                                                "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                                "text": "[I]f we remain in one discipline, we remain in a straitjacket; an adequate theory of language evolution requires a lot of interdisciplinary work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "straitjacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2eef06-abd3-3d2f-a4e8-4045b0be33d9",
                                        "entry_id": "9c78d3f1-695a-3921-ad8b-7d5590c9a78e",
                                        "glosses": [
                                            "To put someone into a straitjacket."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f29c64-3e44-49ae-ba20-619da7b243c3",
                                                "sense_id": "ce2eef06-abd3-3d2f-a4e8-4045b0be33d9",
                                                "text": "What he asked himself now was,—could Miss Edge and Miss Baker, in order to get him out of the house, have set Birt onto Elizabeth, be in league with the man to break a poor old fellow down by simply driving his sad girl out of her wits? To have her straitjacketted even, muffled in a padded room?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                        "entry_id": "9c78d3f1-695a-3921-ad8b-7d5590c9a78e",
                                        "glosses": [
                                            "To restrict the freedom of, either physically or psychologically."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042cea6b-25ca-48a0-8609-63327187c4e0",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "Charles for five whole days in a Victorian topper and tailcoat when he practically had to be straitjacketted to get him into tails for a three-hour wedding?"
                                            },
                                            {
                                                "example_id": "5a5d3651-6178-4180-8ab3-98b685386d94",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "Encouraging, allowing for, and maintaining a plurality of viewpoints concerning public policy, for instance, adaptively (even though partially and incompletely) reduces the chances of a rigidly deterministic and reductionistic mindset maladaptively straitjacketting our abilities to deal with dynamic complexity and to appreciate the benefits of malleability and self-criticality in remaining open to the challenges of our environment."
                                            },
                                            {
                                                "example_id": "96e7f470-a20c-48ed-90c2-fd7409fc2a15",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "But it has not always been like this. The last time human remains hit the headlines occurred when the government-sponsored Palmer Report was published. It was deeply antagonistic to research on human remains, and recommended straitjacketing archaeological research within the same framework as medical science."
                                            },
                                            {
                                                "example_id": "a788cb87-160f-4816-bcb3-b604fdd5efb2",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "Where most primates have a respectable pair of grasping rear hands we have two changelings: long arched pads with rounded chins at one end and stumpy thumbs straight-jacketed to baby fingers at the other."
                                            },
                                            {
                                                "example_id": "fe139531-88e6-4a7a-b600-a15fffb4b4b6",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "she couldnʼt wait to go to college, have a career and leave her parentsʼ straitjacketed lives behind"
                                            },
                                            {
                                                "example_id": "0c8fa98c-4c19-49e3-88cd-0158ea5c3cd0",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "A Labour opposition that has straitjacketed its pledges and ambitions with its fears of blowing its strongest chance in years to gain power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
