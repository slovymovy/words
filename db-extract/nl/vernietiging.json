        "nl-extract.jsonl": [
            {
                "entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                "word": "vernietiging",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7947aa20-ecab-44b1-af79-03fc6d4c2165",
                        "entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "vernietigingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "glosses": [
                            "een einde maken aan het bestaan van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50ae8d5-9d7b-4f75-bef5-57ed63cebeb7",
                                "sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                                "text": "De vernietiging van Nagasaki door een atoombom maakte een einde aan een wereldoorlog."
                            },
                            {
                                "example_id": "b6ca1e33-9255-4ef9-a93d-c03d306be8ec",
                                "sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                                "text": "‘Wie nu nog Tesla’s koopt en X gebruikt, wordt medeplichtig aan de vernietiging van vrijheid en democratie,’ kopte het doorgaans toch vrij bedeesde Nederlands Dagblad deze week boven zijn column"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fddda57-6662-4312-8a89-27aec942849f",
                        "source_entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "source_sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "source_sense_description": "einde maken aan het bestaan van iets",
                        "target_lang_word": "Zerstörung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zerstörung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11d8d563-0282-37e7-924d-853bf3051533",
                                        "entry_id": "7f3d865c-ffe6-37a3-ba21-1a08e972ca1e",
                                        "glosses": [
                                            "die Handlung, etwas zu zerstören (kaputt zu machen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2432d3a6-9f5a-4f7a-85b1-2c7e3ceb6f46",
                                                "sense_id": "11d8d563-0282-37e7-924d-853bf3051533",
                                                "text": "Die Zerstörung der Natur durch die Industrie ist erschreckend."
                                            },
                                            {
                                                "example_id": "6d2a92d1-11b3-46e4-ae54-569ffc241b87",
                                                "sense_id": "11d8d563-0282-37e7-924d-853bf3051533",
                                                "text": "\"Nach dem ersten Weltkrieg begann man Anfang 1919 gemäß den Versailler Bestimmungen mit der Zerstörung der Koblenzer Festungswerke.\""
                                            },
                                            {
                                                "example_id": "840d1a4b-58ee-4e8a-9200-5c4976b232da",
                                                "sense_id": "11d8d563-0282-37e7-924d-853bf3051533",
                                                "text": "„Doch die Zerstörung geschah nicht.“"
                                            },
                                            {
                                                "example_id": "c0040d52-c69e-4c2b-914d-3e0601c6bea2",
                                                "sense_id": "11d8d563-0282-37e7-924d-853bf3051533",
                                                "text": "„Damit hat er nicht nur zur Zerstörung der ČSR beigetragen, sondern auch zur Delegitimierung der berechtigten Forderungen der Deutschen in Böhmen, Mähren und Schlesien.“"
                                            },
                                            {
                                                "example_id": "59c3444f-c0a6-42c0-903c-964625d2b40e",
                                                "sense_id": "11d8d563-0282-37e7-924d-853bf3051533",
                                                "text": "[Irakkrieg 1991:] „Ziel der rd. 1500 US-amerikanischen, britischen, saudischen und kuwaitischen Flugzeuge ist“ […] „die rasche Zerstörung der irakischen Raketenstellungen, um die angedrohten irakischen Raketenangriffe auf Israel zu verhindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6fde788b-88c2-3d35-b94b-a1e89136f4ce",
                                        "entry_id": "7f3d865c-ffe6-37a3-ba21-1a08e972ca1e",
                                        "glosses": [
                                            "der Zustand einer Sache, die zerstört wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e116a0-d04c-495b-981a-b92c55ff3d19",
                                                "sense_id": "6fde788b-88c2-3d35-b94b-a1e89136f4ce",
                                                "text": "Als sie die Zerstörung erblickten, brachen sie in Tränen aus."
                                            },
                                            {
                                                "example_id": "1217fb57-05dc-4134-ae21-c0a5f882c6d5",
                                                "sense_id": "6fde788b-88c2-3d35-b94b-a1e89136f4ce",
                                                "text": "„Den folgenschwersten Einschnitt in der jüngeren Stadtgeschichte verursachten die alliierten Bombenangriffe in den Jahren 1944/45; sie führten zur fast vollständigen Zerstörung von weiten Teilen des Zentrums und der angrenzenden Wohngebiete.“"
                                            },
                                            {
                                                "example_id": "bef79a57-8591-4008-af67-f652e7943515",
                                                "sense_id": "6fde788b-88c2-3d35-b94b-a1e89136f4ce",
                                                "text": "„Die Zerstörung überstieg bei weitem das Maß des Angezeigten und strategisch Gebotenen.“"
                                            },
                                            {
                                                "example_id": "15948c55-5306-4912-b5c4-f1acae4b87e1",
                                                "sense_id": "6fde788b-88c2-3d35-b94b-a1e89136f4ce",
                                                "text": "„Der idyllischen Beschaulichkeit entsprach es auch, daß die Bauten auf den ersten Blick geringere Spuren der Zerstörung aufwiesen als die Straßenhäuser in der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e037215c-995d-4f3e-a0fe-08228e640bbb",
                        "source_entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "source_sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "source_sense_description": "einde maken aan het bestaan van iets",
                        "target_lang_word": "Vernichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                        "entry_id": "d1461e85-6a2a-37e8-a169-d4c1887009c5",
                                        "glosses": [
                                            "Vorgang oder Ergebnis eines Prozesses, der etwas ganz und gar zerstört, so dass der ursprüngliche Zustand (Gegenstand) kaum noch oder gar nicht mehr erkennbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea59e89-af74-465f-91d5-e59d40d1c4c7",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "Im Krieg geht es oft um die Vernichtung des Gegners."
                                            },
                                            {
                                                "example_id": "b317e6f1-28ec-4cd4-9c66-163962c3180f",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Der vollständigen Vernichtung waren die Herero nur durch wirtschaftliche Überlegungen entgangen.“"
                                            },
                                            {
                                                "example_id": "111b42f2-522d-4dad-84ad-6d9fc45a328f",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Bis zum heutigen Tag wurden im Worms 77 Stolpersteine im öffentlichen Raum verlegt, die an Deportation, Vertreibung und Vernichtung jüdischer Menschen durch die Nationalsozialisten erinnern.“"
                                            },
                                            {
                                                "example_id": "6a54b262-684a-47e8-912e-3138758c0edb",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Dafür hatte sich nach der Vernichtung der bodenständigen russischen Lebensordnung, wie Pierre unbewusst fühlte, in dieser verwüsteten russischen Mutterzelle eine neue, ganz anders geartete, aber fest gefügte Lebensordnung, nämlich die französische, erhoben.“"
                                            },
                                            {
                                                "example_id": "8974d4f4-910d-4a50-b3b3-f2a18303d3e9",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Es lief somit auf die Vertreibung und sogar Vernichtung der angestammten Bevölkerung Russlands, der Ukraine und Weißrusslands hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec2cf02-6dd7-4aea-a92b-110f713d5baf",
                        "source_entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "source_sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "source_sense_description": "einde maken aan het bestaan van iets",
                        "target_lang_word": "destruction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destruction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The act of destroying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2840b9-f2af-4db7-9ced-a7d5699dc729",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "The destruction of the condemned building will take place at noon."
                                            },
                                            {
                                                "example_id": "aa3fc8a7-592f-4aa6-971b-02f7ed67f191",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "It may be that a free society as we have known it carries in itself the forces of its own destruction, that once freedom has been achieved it is taken for granted and ceases to be valued, and that the free growth of ideas which is the essence of a free society will bring about the destruction of the foundations on which it depends."
                                            },
                                            {
                                                "example_id": "919585b2-bf88-4745-91ca-c6a9ed067ab1",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "About 1500 B.C., however, a powerful earthquake caused widespread destruction, and thereafter there were major changes. An earlier script, undeciphered, but known as Linear A, was replaced by the Greek Linear B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The results of a destructive event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78fd7c37-1092-48a2-b733-b4ce19fe90f7",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "Amid the seemingly endless destruction, a single flower bloomed."
                                            },
                                            {
                                                "example_id": "68cf2d12-32a8-44fe-956d-2fc339b69457",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "If destruction be our lot we must ourselves be its author and finisher. As a nation of freemen we must live through all time or die by suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "A group of feral cats."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb69c659-442b-40db-b854-1989f309279f",
                                                "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                                "text": "A group of wild cats is called a destruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "484b9973-5de6-49e7-b79d-84c565275600",
                        "source_entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "source_sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "source_sense_description": "einde maken aan het bestaan van iets",
                        "target_lang_word": "annihilation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annihilation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b674e5f-0886-304a-8847-bd45df93080a",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The act of destroying or otherwise turning into nothing, or nonexistence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f04818dc-9364-3f4b-99be-7a5f8a8f40ac",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The act of destroying the form or combination of parts under which a thing exists, so that the name can no longer be applied to it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b876e38-599c-4315-8498-345be95703d5",
                                                "sense_id": "f04818dc-9364-3f4b-99be-7a5f8a8f40ac",
                                                "text": "the annihilation of a corporation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a620426-f51a-30d7-8cd5-2e6794c5984b",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The state of being annihilated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25408ba-b3aa-4470-b6bb-3a222516f182",
                                                "sense_id": "5a620426-f51a-30d7-8cd5-2e6794c5984b",
                                                "text": "If you ask how religion thus falls on the thorns and faces death, and in the very act annuls annihilation, I cannot explain the matter, for it is religion's secret, and to understand it you must yourself have been a religious man of the extremer type."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0130ff04-0f7c-327d-ae77-0a0fca0ef33a",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The process of a particle and its corresponding antiparticle combining to produce energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7f3ae09-5a0b-4812-8733-fb669a89c130",
                        "source_entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "source_sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "source_sense_description": "einde maken aan het bestaan van iets",
                        "target_lang_word": "déstruction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déstruction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97d7fd25-b840-3124-8fbf-4ea8c7175bc2",
                                        "entry_id": "ac03c3e3-b098-3dda-b90e-7feea350e5c0",
                                        "glosses": [
                                            "Action de détruire, au propre et au figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485a8fe1-fd88-470b-b73c-8bad4c750762",
                                                "sense_id": "97d7fd25-b840-3124-8fbf-4ea8c7175bc2",
                                                "text": "Par contre, en solution à 1 p. 100, l’arsénite de soude exerce des actions énergiques comme herbicide, herbifuge et insecticide. A la dose de 1/2 p. 100, il a été utilisé pour la destruction des criquets."
                                            },
                                            {
                                                "example_id": "508dadcb-3c29-4d75-9f9a-b033ae2a00ae",
                                                "sense_id": "97d7fd25-b840-3124-8fbf-4ea8c7175bc2",
                                                "text": "On la dévasta, comme, au siècle précédent, on avait bombardé d’immenses agglomérations barbares, et parce qu’elle était à la fois trop forte pour être occupée par le vainqueur et trop indisciplinée, trop orgueilleuse pour se rendre dans le but d’échapper à la destruction."
                                            },
                                            {
                                                "example_id": "d79c1197-5bc6-4aea-8e46-20aff5011614",
                                                "sense_id": "97d7fd25-b840-3124-8fbf-4ea8c7175bc2",
                                                "text": "D’une manière générale, les femmes ménopausées sont les premières cibles de l’ostéoporose, en raison de la fin de la sécrétion osseuse, en raison de la fin de la sécrétion des œstrogènes, hormones qui empêchent la destruction osseuse par leur action frénatrice sur les ostéoclastes (ces cellules des os dont le rôle est à la fois de détruire l’os ancien et de le renouveler)."
                                            },
                                            {
                                                "example_id": "ba28bd6c-cafd-4b6e-8d90-a87caea03dab",
                                                "sense_id": "97d7fd25-b840-3124-8fbf-4ea8c7175bc2",
                                                "text": "Ces lettres furent recueillies, Dieu sait comment, après la destruction quasi totale de Cologne par bombardements aériens […]."
                                            },
                                            {
                                                "example_id": "7858c1ac-acc7-4841-b64b-c941d54717c4",
                                                "sense_id": "97d7fd25-b840-3124-8fbf-4ea8c7175bc2",
                                                "text": "D'après l'Insee, le chômage devrait continuer à progresser et atteindre 11% d'ici l'été, avec 75000 destructions supplémentaires d'emplois marchands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e2a3a7-4a04-3b90-a956-cb5f90656107",
                                        "entry_id": "ac03c3e3-b098-3dda-b90e-7feea350e5c0",
                                        "glosses": [
                                            "Ce qui subsiste des objets après leur destruction partielle ou totale, par opposition à construction. (généralement employé au pluriel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4cb446c-4731-4aa6-8d42-8f7ec4eda1b0",
                                                "sense_id": "88e2a3a7-4a04-3b90-a956-cb5f90656107",
                                                "text": "Les réfugiés tentent de s’installer au milieu de ces destructions qu’ils aménagent avec leur maigres moyens."
                                            },
                                            {
                                                "example_id": "9132bd19-05c0-4ad7-b9dd-c3dd6d12bca2",
                                                "sense_id": "88e2a3a7-4a04-3b90-a956-cb5f90656107",
                                                "text": "Dans ce paysage de désolation, on ne voyait plus que les destructions toutes de gravas et de poussière grise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e38ee1a2-00d7-491a-bfdb-03f783cee6fb",
                        "source_entry_id": "ec982162-875b-3031-9eee-e70731e574a2",
                        "source_sense_id": "adcd5c63-473f-33e7-adc6-be9154c95797",
                        "source_sense_description": "einde maken aan het bestaan van iets",
                        "target_lang_word": "уничтожение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "уничтожение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7c2dfb-24ac-3ae2-a3b8-752d71c9bea2",
                                        "entry_id": "8c91d81a-c399-3961-9fc3-86612b272873",
                                        "glosses": [
                                            "действие по значению гл. уничтожать; разрушение, прекращение существования чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e141e855-c54a-4d19-8ea7-1c918f76bcec",
                                                "sense_id": "1e7c2dfb-24ac-3ae2-a3b8-752d71c9bea2",
                                                "text": "9 марта на рассвете двести пятьдесят рядовых вышли из крепости; целью вылазки было уничтожение новой батареи, сильно беспокоившей осаждённых."
                                            },
                                            {
                                                "example_id": "2b5d5bf7-2185-431e-9f48-cbb0ef93dae3",
                                                "sense_id": "1e7c2dfb-24ac-3ae2-a3b8-752d71c9bea2",
                                                "text": "Сама же история добавит только, что это те же люди, которые в одном углу мира подали голос к уничтожению торговли чёрными, а в другом учили алеутов и курильцев жить и молиться — и вот они же создали, выдумали Сибирь, населили и просветили её и теперь хотят возвратить творцу плод от брошенного им зерна."
                                            },
                                            {
                                                "example_id": "90d0fc08-b6ff-4da3-8820-a30f1bd93992",
                                                "sense_id": "1e7c2dfb-24ac-3ae2-a3b8-752d71c9bea2",
                                                "text": "— Я знаю, вы требовали уничтожения налога на драгоценности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
