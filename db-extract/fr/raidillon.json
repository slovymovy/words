            {
                "entry_id": "f44fa45f-7e67-3e73-96ae-51248b6bfe92",
                "word": "raidillon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07dfadc8-f07d-4d5c-9ea0-409265f9eac4",
                        "entry_id": "f44fa45f-7e67-3e73-96ae-51248b6bfe92",
                        "tags": [
                            "plural"
                        ],
                        "form": "raidillons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c71461a-0c3f-397e-8565-fc0f6ea0ff20",
                        "entry_id": "f44fa45f-7e67-3e73-96ae-51248b6bfe92",
                        "glosses": [
                            "Petite pente raide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6edf58ea-d345-48e4-813b-b0487fc6f97f",
                                "sense_id": "3c71461a-0c3f-397e-8565-fc0f6ea0ff20",
                                "text": "Le sentier montait toujours, puis, après avoir grimpé trois raidillons particulièrement escarpés, le décor changea brusquement."
                            },
                            {
                                "example_id": "16a3c5ff-726a-46f7-a384-4d7d37d14d81",
                                "sense_id": "3c71461a-0c3f-397e-8565-fc0f6ea0ff20",
                                "text": "D’autres, en revanche, n’avaient pas eu cette chance, et des dizaines de soldats gisaient dans le raidillon, certains gémissant de peur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cda2035-24ef-3956-bd0d-53e5ec915720",
                        "entry_id": "f44fa45f-7e67-3e73-96ae-51248b6bfe92",
                        "glosses": [
                            "Sentier de traverse qui escalade une pente raide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70268796-0506-4734-9cf1-f00554a99960",
                                "sense_id": "5cda2035-24ef-3956-bd0d-53e5ec915720",
                                "text": "Nous reprenons le raidillon ; il n’est guère plus drôle à descendre qu’à monter : tantôt nous étions courbés en avant, maintenant il faut, pour la descente, se rejeter en arrière…"
                            },
                            {
                                "example_id": "1a0abee3-0995-46a6-93e5-08caf987ebe0",
                                "sense_id": "5cda2035-24ef-3956-bd0d-53e5ec915720",
                                "text": "Les Bucolin habitaient près du quartier des affaires ; un raidillon menait assez rapidement de l’une à l’autre maison ; je le dégringolais et le regravissais plusieurs fois par jour."
                            },
                            {
                                "example_id": "d30132e1-301a-48f6-b632-e9cb38a87e8c",
                                "sense_id": "5cda2035-24ef-3956-bd0d-53e5ec915720",
                                "text": "Après m’avoir cherché partout, ma mère me trouva en larmes dans le petit raidillon, contigu à Tansonville, en train de dire adieu aux aubépines."
                            },
                            {
                                "example_id": "490cccdb-7784-4cbc-be3a-46108c7f0e0f",
                                "sense_id": "5cda2035-24ef-3956-bd0d-53e5ec915720",
                                "text": "C’est alors qu’un moellon de belle taille tomba du haut du mur, me frôla l’épaule, roula à mes pieds et me précéda sur le raidillon."
                            }
                        ]
                    }
                ],
