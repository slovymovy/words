                        "form": "die Sandstürme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                        "entry_id": "3963f94e-ad62-31d7-b42d-62e57c0a5846",
                        "glosses": [
                            "Sturm oder starker Wind, der Sand mit sich führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e5ee92-3993-4864-ab93-3aa1ecbf022e",
                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                "text": "Einige Sandstürme transportieren bis zu 100 Millionen Tonnen Sand über zum Teil sehr große Entfernungen!"
                            },
                            {
                                "example_id": "29041fee-59ff-4df8-a947-d66372297e87",
                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                "text": "„Ihr neues Haus war ein Zelt, das einem starken Sandsturm schwerlich trotzen konnte.“"
                            },
                            {
                                "example_id": "58282dc7-3463-4757-a327-ed512d9997a2",
                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                "text": "„Am Ende des Tages war der Regen verebbt, doch der heftige Wind war nun in einen Sandsturm übergegangen – Hunderte von Leuten, die in Motorradbrillen Schlange standen, um Essen zu fassen, waren ein sonderbarer, aber amüsanter Anblick.“"
                            },
                            {
                                "example_id": "535bf21a-3c5d-419f-8a7e-6517f459767f",
                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                "text": "„Ferris’ Rückflug von Abu Dhabi verzögerte sich wegen eines Sandsturms, und so war es schon nach Mitternacht, als er endlich auf dem Queen-Alia-Flughafen landete.“"
                            },
                            {
                                "example_id": "5f1916f5-de68-45fb-8740-f8f32ef90bb2",
                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                "text": "„Sandstürme kommen im Frühling im Norden Chinas häufig vor, oft kommt der Sand aus der Wüste Gobi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
