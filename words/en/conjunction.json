                            },
                            {
                                "target_lang_word": "стечение",
                                "target_lang_sense_clarification": "обстоятельств"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "samenwerking",
                                "target_lang_sense_clarification": "gezamenlijke actie"
                            },
                            {
                                "target_lang_word": "combinatie",
                                "target_lang_sense_clarification": "het samengaan van zaken"
                            },
                            {
                                "target_lang_word": "samenloop",
                                "target_lang_sense_clarification": "van omstandigheden"
                            }
                        ]
