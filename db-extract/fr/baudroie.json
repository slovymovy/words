                    }
                ],
                "senses": [
                    {
                        "sense_id": "65e6ab58-bdd5-37ec-bad0-7159c9cb9a4e",
                        "entry_id": "65500ac3-bf17-3c64-9340-e54cb9957815",
                        "glosses": [
                            "Poisson osseux marin, à tête énorme, au corps oblong et presque cylindrique, vivant le long des côtes d’Europe et d’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99be46ac-3e21-4262-af56-c8ccf5734f11",
                                "sense_id": "65e6ab58-bdd5-37ec-bad0-7159c9cb9a4e",
                                "text": "La vive, la baudroie et le poulpe s’allièrent pour devenir les maîtres de la mer et s’emparer de toutes ses richesses à leur gré, au détriment des autres poissons."
                            },
                            {
                                "example_id": "66abde25-2eb4-4d65-bcb4-42691f3a4797",
                                "sense_id": "65e6ab58-bdd5-37ec-bad0-7159c9cb9a4e",
                                "text": "Sur les dalles, aux pieds des pêcheurs, s’amoncellent les pourpres aux yeux saillants, les capelans et les baudroies, les rascasses peintes de couleurs vives, les muges qui fréquentent les étangs et l’ange de mer aux ailes éployées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cd73fea-d44d-414d-b020-c4908be80ca3",
                        "source_entry_id": "65500ac3-bf17-3c64-9340-e54cb9957815",
                        "source_sense_id": "65e6ab58-bdd5-37ec-bad0-7159c9cb9a4e",
                        "target_lang_word": "Seeteufel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeteufel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08de43b6-4166-3ad6-9b15-244e70b832e3",
                                        "entry_id": "9b760a16-b81d-3bef-9dc2-45bae2285b17",
                                        "glosses": [
                                            "ein mariner Raubfisch aus der Familie der Armflosser, der mit einer Angel seine Beute ködert"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef18a22-9b29-4c61-8b5c-1ade31a3df92",
                                                "sense_id": "08de43b6-4166-3ad6-9b15-244e70b832e3",
                                                "text": "„Der Seeteufel ist in vielen Meeren zu Hause, hauptsächlich im Mittelmeer und im Nordatlantik.“"
                                            },
                                            {
                                                "example_id": "c3d9023d-c244-482d-aded-d3f8b91b3b4c",
                                                "sense_id": "08de43b6-4166-3ad6-9b15-244e70b832e3",
                                                "text": "„Eine Schönheit ist der Seeteufel wirklich nicht. Fischkenner schätzen aber seine hervorragenden inneren Qualitäten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d68c3be9-2217-4921-924f-ca25ff229539",
                        "source_entry_id": "65500ac3-bf17-3c64-9340-e54cb9957815",
