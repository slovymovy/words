        "fr-extract.jsonl": [
            {
                "entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                "word": "effluve",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "163f6310-36bf-4f13-8069-6d1b3a5e4c19",
                        "entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                        "tags": [
                            "plural"
                        ],
                        "form": "effluves"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bcb6548c-c873-3729-b0a2-22b9f221d9ed",
                        "entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                        "glosses": [
                            "Substances organiques altérées, tenues en suspension dans l’air, principalement aux endroits marécageux, et donnant particulièrement lieu à des fièvres intermittentes, rémittentes et continues."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                        "entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                        "glosses": [
                            "Émanation qui se dégage d’un corps quelconque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ce45a6-9901-4cb0-95f4-c203b32418dc",
                                "sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                                "text": "Il ne reste qu’un tableau de Lebrun représentant la Pentecôte d’une façon qui étonnerait l’auteur des Actes des apôtres. La Vierge y est au centre et reçoit pour son compte tout l’effluve du Saint-Esprit, qui, d’elle, se répand sur les apôtres."
                            },
                            {
                                "example_id": "bff66bb4-f27a-4acb-814e-205eb1f8d820",
                                "sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                                "text": "On entendait partout des chants d’oiseaux. Alors ma compagne se mit à courir en gambadant, enivrée d’air et d’effluves champêtres. Et moi je courais derrière en sautant comme elle. Est-on bête, monsieur, par moments !"
                            },
                            {
                                "example_id": "7dabb81b-81ad-4a7f-8534-491bc34f9e8a",
                                "sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                                "text": "Elle pourrait demeurer ici, l’assaillir d’invites, de chatteries, toute la nuit provoquer son désir, répandre ses effluves."
                            },
                            {
                                "example_id": "8a77385f-29cf-40f1-a007-a2e5904adf02",
                                "sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                                "text": "Lors des manifestations au foyer rural, il traînait toujours dans les environs de la salle, les effluves festives l'ayant averti qu'il se tramait quelque chose d'intéressant et, aussitôt les gens ou les invités partis, il entrait prêter ses mains noires pour aider à débarrasser."
                            },
                            {
                                "example_id": "e94d175a-1cf1-4bf8-9d1a-d5fb2414a5c8",
                                "sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                                "text": "De chaque côté de la place, il y avait des tilleuls, qui pleuraient au printemps en nous arrosant de leurs effluves apaisants."
                            }
                        ]
                    },
                    {
                        "sense_id": "d373d6a4-65b7-3bb6-b44f-d805c94ea8fc",
                        "entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                        "glosses": [
                            "Décharge électrique à faible dégagement de chaleur ayant lieu entre deux conducteurs dont la différence de potentiel n’est pas assez élevée pour engendrer un arc électrique. → voir effluveur"
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "6037c188-ef13-46fb-9f25-e849b18a62b1",
                                "sense_id": "d373d6a4-65b7-3bb6-b44f-d805c94ea8fc",
                                "text": "Dans la plupart des cas, on observe une similitude d'effets entre les actions chimique dues à l’effluve et celles dues à l’étincelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f33e350-68e5-46a6-b559-29a17bfd2281",
                        "source_entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                        "source_sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                        "source_sense_description": "Émanation qui se dégage d’un corps quelconque.",
                        "target_lang_word": "effluvium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effluvium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                        "entry_id": "7cbfa824-9ab5-3348-97ce-380973a512ec",
                                        "glosses": [
                                            "A gaseous or vaporous emission, especially a foul-smelling one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456df088-3871-4653-8cdb-0c0b25d0ddc9",
                                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                                "text": "She was now bending over a huge light wood blaze, with a pipe of rude structure and no small dimensions in her mouth, from which the occasional puff went forth, filling the apartment with the unpleasant effluvia of the vilest leaf-tobacco."
                                            },
                                            {
                                                "example_id": "fa370c07-f907-4605-87fb-5ce1b3aad590",
                                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                                "text": "It was the mere effluvium of the flame, the subtle ether that it cast off as it passed, working on us, and making us feel strong as giants and swift as eagles."
                                            },
                                            {
                                                "example_id": "b86ac18b-229e-444a-8fe2-30e8dc60af29",
                                                "sense_id": "99ceb86c-cf7b-379a-8c66-0b7bf2f4baf4",
                                                "text": "And he breathed the breath of the house—a dank savour rather than a smell—a cold, musty effluvium as from underground vaults mingled with the reeking exhalations of linoleum and mildewed and rotten woodwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7506bccf-7fe1-3d8e-92ad-5bd8df0543af",
                                        "entry_id": "7cbfa824-9ab5-3348-97ce-380973a512ec",
                                        "glosses": [
                                            "A condition causing the shedding of hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9546931-c23b-4d00-82df-d78a273f8cc8",
                                                "sense_id": "7506bccf-7fe1-3d8e-92ad-5bd8df0543af",
                                                "text": "Reversible hair loss or effluvium occurs following either endogenous or exogenous damage to anagen hair follicles[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0768dc7-0c7f-48ff-a0ea-b484e2cbce87",
                        "source_entry_id": "315ed23f-781e-36d5-b13d-82d79e8b3968",
                        "source_sense_id": "f76d8683-fb9a-328e-b77c-8dda10ef60ef",
                        "source_sense_description": "Émanation qui se dégage d’un corps quelconque.",
                        "target_lang_word": "efluvio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efluvio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "894c784e-6550-3fed-b689-9de7da7135e2",
                                        "entry_id": "c2de9138-efdb-3fdb-bb87-ab4373e43068",
                                        "glosses": [
                                            "Emanación sutil de partículas que producen un ligero olor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a69b3d-3b49-4003-9c17-387797989e82",
                                                "sense_id": "894c784e-6550-3fed-b689-9de7da7135e2",
                                                "text": "Se percibía un efluvio marino, olor a algas y a marisco."
                                            },
                                            {
                                                "example_id": "dbc82cf1-6153-4583-b323-e9fc3b448b45",
                                                "sense_id": "894c784e-6550-3fed-b689-9de7da7135e2",
                                                "text": "Durante este tiempo asaban al pájaro, el cual cocía y amarilleaba asándose; el jugo del pájaro goteaba, fluía por todas partes, tenía un efluvio muy suave."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb3c16dc-3c59-3b67-ac81-446815f01ed4",
                                        "entry_id": "c2de9138-efdb-3fdb-bb87-ab4373e43068",
                                        "glosses": [
                                            "En sentido figurado, emanación sutil que se percibe, beneficiosa o maléfica, de las estrellas, la luna, el amor, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8707c7-8011-4fab-a555-1ded2afbb4c2",
                                                "sense_id": "bb3c16dc-3c59-3b67-ac81-446815f01ed4",
                                                "text": "No, no se pararán. Acaso el instinto de cobardía propio de su raza les moverá a agazaparse breves minutos detrás de un arbusto o de una peña; pero al primer imperceptible efluvio amoroso que les traiga la cortante brisa."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
