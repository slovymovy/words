                ],
                "senses": [
                    {
                        "sense_id": "c34a2a2a-c62a-3087-bebb-b1d5ad803ad7",
                        "entry_id": "96884d35-e38b-32e6-9ea3-3ad3b7df039a",
                        "glosses": [
                            "Länge einer Hieb- und Stichwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b08b37-3d16-4be3-b00c-7bb436193af2",
                                "sense_id": "c34a2a2a-c62a-3087-bebb-b1d5ad803ad7",
                                "text": "„Die Schwertlänge kann in gewissem Sinne als Wegweiser für die Konsistenz der Typengliederung dienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "396deaaf-cbd4-389a-9208-040ab5237b28",
                        "entry_id": "96884d35-e38b-32e6-9ea3-3ad3b7df039a",
                        "glosses": [
                            "Länge der Schiene bei einer Kettensäge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e406f8e-9302-42e2-9140-1906dde91a65",
                                "sense_id": "396deaaf-cbd4-389a-9208-040ab5237b28",
                                "text": "„Eine gewisse Kontrolle der Proportionen bietet eine der sorgfältig gezeichneten Szenen in Medinet Habu, in der die Schwertlänge etwas mehr als die halbe Körpergröße der Krieger beträgt, also ca. 1 Meter oder etwas darüber betragen zu haben scheint, eine Schwertlänge, die, wie gleich noch gezeigt werden soll, durchaus an bronzezeitlichen Exemplaren zu finden ist.“"
                            },
                            {
                                "example_id": "3fc05b50-d7df-419d-9484-833f8ba783e4",
                                "sense_id": "396deaaf-cbd4-389a-9208-040ab5237b28",
                                "text": "„Zur Bewältigung stärkerer Wurzelanläufe wurde die Schwertlänge im Laufe der Versuche auf 59cm erhöht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a07d17d1-9240-3987-917e-d583a0131646",
                        "entry_id": "96884d35-e38b-32e6-9ea3-3ad3b7df039a",
                        "glosses": [
                            "Länge eines Bauteils, das durch den Schiffsrumpf geht und parallel zur Fahrtrichtung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97dd90f9-e0c0-4bf0-8df4-2fbc349e23ae",
                                "sense_id": "a07d17d1-9240-3987-917e-d583a0131646",
                                "text": "„Bei den niederelbischen Fracht-Evern betrug die Schwertlänge das Doppelte bis Dreifache der Seitenhöhe, gemessen beim Großwant vom Deck bis Unterkante Boden, während die größte Breite am unteren Ende etwa ein Drittel bis zwei Fünftel bis ein Halb der Schwertlänge erreichte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
