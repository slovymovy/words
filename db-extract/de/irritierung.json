                "senses": [
                    {
                        "sense_id": "3f83579c-8160-36ba-b053-e67f6727a3f4",
                        "entry_id": "59f5262b-71d9-3ee5-ae4f-34fceab5c0aa",
                        "glosses": [
                            "Ablenkung oder Verwirrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b219fb-a561-46fb-a238-690edae61c1f",
                                "sense_id": "3f83579c-8160-36ba-b053-e67f6727a3f4",
                                "text": "Solch eine öffentliche Erklärung sorgt doch für mehr Irritierung als für die Klarheit, die wir uns alle wünschen."
                            },
                            {
                                "example_id": "e204b3bb-31b6-459c-a4ec-2dfd8d2d105f",
                                "sense_id": "3f83579c-8160-36ba-b053-e67f6727a3f4",
                                "text": "„Auch das im Jahr 1922 entstandene sogenannte große Stilleben in Karlsruhe ist reich an perspektivischen Irritierungen, die sich sowohl auf die Großstruktur als auch auf die Kleinstruktur der Komposition beziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbf1d169-7bc6-3558-b70e-eded09126702",
                        "entry_id": "59f5262b-71d9-3ee5-ae4f-34fceab5c0aa",
                        "glosses": [
                            "Reizung, Erregung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbce708-3697-4759-a29a-1fc01abaab7c",
                                "sense_id": "fbf1d169-7bc6-3558-b70e-eded09126702",
                                "text": "Die Irritierung hier am Schienenbein wird wieder zurückgehen, wenn Sie weiter auf Kontakt zu synthetischen Stoffen verzichten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
