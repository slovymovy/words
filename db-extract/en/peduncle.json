                                            {
                                                "example_id": "7eb07aa5-621f-4e50-a59c-4cc4a268c472",
                                                "sense_id": "9bdb21e5-9f68-34ea-ba65-7bbc3577120e",
                                                "text": "Der Stiel ist vom Besen abgegangen, kannst du das reparieren?"
                                            },
                                            {
                                                "example_id": "c35f147d-d2da-4aea-ba5c-5f0c8868e24f",
                                                "sense_id": "9bdb21e5-9f68-34ea-ba65-7bbc3577120e",
                                                "text": "„In der Manier von Stadtkindern konnten sie stundenlang mit unverbrauchter Neugierde vor dem Borstenvieh hocken, mit dem Stiel einer Schaufel nach ihm stoßen und das grunzende, unlustige Schwein in Bedrängnis bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df69e926-a782-3cdf-a1c4-6ab3558970ab",
                                        "entry_id": "4e99be8a-4ebd-3b3e-974a-f47c4d455655",
