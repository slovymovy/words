                    {
                        "form_id": "25871cc0-72f0-4a97-9c68-a40a241d6a40",
                        "entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "tags": [
                            "plural"
                        ],
                        "form": "non-binaires"
                    },
                    {
                        "form_id": "eea43e71-9bfb-4437-ab1f-1f2c6d81c906",
                        "entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "tags": [],
                        "form": "non binaire"
                    },
                    {
                        "form_id": "76f5e478-a756-4893-a95c-c81aba6d4ee1",
                        "entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "tags": [],
                        "form": "nonbinaire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                        "entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "glosses": [
                            "Qui relève d’une identité de genre ni exclusivement féminine, ni exclusivement masculine, ou ni l’un ni l’autre, en-dehors du concept de la binarité de genre."
                        ],
                        "tags": [
                            "Genres humains et identités de genre"
                        ],
                        "examples": [
                            {
                                "example_id": "97357011-41a6-4075-8daf-eb4307ba6857",
                                "sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                                "text": "Ils peuvent ainsi incarner un homme, une femme mais également un individu non-binaire."
                            },
                            {
                                "example_id": "c3805358-16a4-421c-a592-1bd0507e504b",
                                "sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                                "text": "Une personne non-binaire est une personne dont le genre n’est ni exclusivement féminin, ni exclusivement masculin."
                            },
                            {
                                "example_id": "905ce33c-89bd-4fb5-9b6d-e7c61c1df997",
                                "sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                                "text": "Émotionnellement parlant, c’est très fatigant pour les trans et les gens non-binaires d’éduquer les autres."
                            },
                            {
                                "example_id": "c050971a-ef63-4f12-bce6-7b126090f23b",
                                "sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                                "text": "Quand un membre du Collège veut renouveler son adhésion, on lui demande s’il est:\n– Féminin\n– Masculin\n– Agenre\n– Non conforme à un genre\n– De genre fluide\n– Non-binaire\n– Transmasculin\n– Transféminin\n– Bispirituel(le)\n– Bigenre\n– Cisgenre\n– De genre multiple\n– Autre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c284522-c447-426e-8a0b-beba860aec72",
                        "source_entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "source_sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                        "target_lang_word": "nichtbinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nichtbinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0796849f-2e74-3c57-99e0-003538f2bba3",
                                        "entry_id": "183901d1-0a03-3b5c-a8d3-24d5211adfcc",
                                        "glosses": [
                                            "nicht einem der beiden Geschlechter weiblich oder männlich zuzuordnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ad65b4-677c-4b43-b4c8-e9f9bd517d4e",
                                                "sense_id": "0796849f-2e74-3c57-99e0-003538f2bba3",
                                                "text": "Non-binär oder nichtbinär zu sein bedeutet, sich weder dem weiblichen noch dem männlichen Geschlecht zugehörig zu fühlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ac17ff6-86bd-4c29-bea3-014f5636372c",
                        "source_entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "source_sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                        "target_lang_word": "abinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                        "entry_id": "6bcb25ef-c03e-3275-98fe-648acee62845",
                                        "glosses": [
                                            "nicht (ausschließlich) eine weibliche oder männliche Geschlechtsidentität aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f847681-a422-4268-a5fb-4d7816ecf3ab",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Wir bedanken uns bei allen abinären Geschwistern, die vor uns kamen und auch bei denen, die nach uns kommen werden.“"
                                            },
                                            {
                                                "example_id": "613a774b-b0c0-45cc-9a2a-fbb9410570dd",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Abinäre Menschen können z. B. mehrere Geschlechter haben, genderqueer sein oder ein Geschlecht haben, das weder Mann noch Frau ist.“"
                                            },
                                            {
                                                "example_id": "6fae1bc0-525a-46eb-b3ca-78be2e3c3084",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„In dem Vortrag werden Begriffe, die oft in Zusammenhang mit geschlechtlicher Vielfalt auftauchen, wie inter*, trans*, divers und abinär leicht verständlich erklärt.“"
                                            },
                                            {
                                                "example_id": "4e845523-a050-4a07-ba86-b81a7c9dba9b",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Das heißt abinäre Menschen können sich als ‚sowohl männlich als auch weiblich‘ oder als ‚weder männlich noch weiblich‘ verstehen oder das zweigeschlechtliche Konstrukt gänzlich ablehnen.“"
                                            },
                                            {
                                                "example_id": "ad910780-7980-4774-a3a5-9f5864252715",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Zum Beispiel haben nicht alle abinären Menschen auch einen geschlechtsneutral interpretierten Namen oder/und nutzen für sich im Alltag weibliche oder männliche Pronomen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78cf5657-2969-4501-913f-3faab64d938a",
                        "source_entry_id": "0134b0b7-055f-3e35-a855-1dc106955152",
                        "source_sense_id": "f461c323-9241-3bf6-9fa5-f1e5df8d191a",
                        "target_lang_word": "non-binary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-binary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c31a9ea9-953c-350b-8af5-5255a10f31aa",
                                        "entry_id": "034b0196-7fd8-3099-a95f-721036e04c4a",
                                        "glosses": [
                                            "Not binary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042b8da6-55c4-4c9d-af6f-39c090d6523e",
                                                "sense_id": "c31a9ea9-953c-350b-8af5-5255a10f31aa",
                                                "text": "Thus digital computers operate directly with digits either at the bit level, which is short for binary digit, or at the byte level where a nonbinary digit such as a decimal number or alphabetic character is represented."
                                            },
                                            {
                                                "example_id": "03946c53-d0d0-47eb-a403-b993db26d8f7",
                                                "sense_id": "c31a9ea9-953c-350b-8af5-5255a10f31aa",
                                                "text": "The most common type of encoder is one that converts a nonbinary number system into an equivalent binary system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e30a5c0-52b8-3aad-8239-3b92493aa726",
                                        "entry_id": "034b0196-7fd8-3099-a95f-721036e04c4a",
                                        "glosses": [
                                            "Having or pertaining to a gender identity not represented by the gender binary; not exclusively male or female; genderqueer."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "604491d1-ea8d-42ca-9792-4dc82cf54561",
                                                "sense_id": "1e30a5c0-52b8-3aad-8239-3b92493aa726",
                                                "text": "I'm expected to live in a world where […] forms have no or few options for non-binary people, where finding a GP who understands my non-binary needs and identity is a challenge."
                                            },
                                            {
                                                "example_id": "efcf27e1-87e5-436c-9b9e-9c9068baf296",
                                                "sense_id": "1e30a5c0-52b8-3aad-8239-3b92493aa726",
                                                "text": "[T]he most commonly used non-binary pronouns are the singular “they/their/theirs”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-binary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b168ea87-9c10-37a5-9ed3-7b9328464eb6",
                                        "entry_id": "d2d77b9b-56a4-3c9e-a5f7-e5c07520c869",
                                        "glosses": [
                                            "Something which is not a binary; a computer file that is not readable text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9614f91d-1ae4-456f-8ed7-3485e1724bf3",
                                                "sense_id": "b168ea87-9c10-37a5-9ed3-7b9328464eb6",
                                                "text": "Please don't post non-binaries into alt.binaries.doom. Pretty please."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021ec03e-f7a9-3157-aa12-b5c51770acd2",
                                        "entry_id": "d2d77b9b-56a4-3c9e-a5f7-e5c07520c869",
                                        "glosses": [
                                            "A non-binary (genderqueer) person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
