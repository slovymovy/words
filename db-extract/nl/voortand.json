                ],
                "senses": [
                    {
                        "sense_id": "d16752da-7a9d-3019-8ef3-b9bdffd9b978",
                        "entry_id": "f130dbd7-4a68-3971-862f-94d285ef7781",
                        "glosses": [
                            "snijtand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf09f4e4-0b10-4714-9937-5f18f9090eb6",
                                "sense_id": "d16752da-7a9d-3019-8ef3-b9bdffd9b978",
                                "text": "Alfred E. Neuman is de fictieve mascotte en het gezicht van het Amerikaanse satirische tijdschrift MAD. Met zijn flaporen en kenmerkende, zorgeloze glimlach met ontbrekende voortand zwerft hij al minstens sinds de jaren 20 door de Amerikaanse iconografie."
                            },
                            {
                                "example_id": "5e9ce7c8-1a6f-472f-80a0-7df3bed96c62",
                                "sense_id": "d16752da-7a9d-3019-8ef3-b9bdffd9b978",
                                "text": "Ik heb kiespijn,’ zegt Jan Mulder aan de telefoon. ‘Er is een kroon uitgevallen. Een zenuw is ontstoken, drie kronen moeten worden vervangen en aan de andere kant zit een gaatje, dus eten lukt me alleen nog met de voortanden.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4fff5b5-0620-42fa-9f86-9ec00582bac4",
                        "source_entry_id": "f130dbd7-4a68-3971-862f-94d285ef7781",
                        "source_sense_id": "d16752da-7a9d-3019-8ef3-b9bdffd9b978",
                        "target_lang_word": "Vorderzahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorderzahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                        "entry_id": "aa4c6877-d29f-3536-8496-c83f57a19e7b",
                                        "glosses": [
                                            "Zahn im Vorderkiefer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "524e628c-64ac-4335-8455-bfbced4ef067",
                                                "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                                "text": "„Durch die Lücke zwischen den Vorderzähnen war ein Stück ihrer Zunge zu sehen.“"
                                            },
                                            {
                                                "example_id": "f4c9ae7c-6e11-4d38-98ea-110c995cf398",
                                                "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                                "text": "„Der Junge zeigte ein Gebiss, in dem ein Vorderzahn fehlte.“"
                                            },
                                            {
                                                "example_id": "1af32369-9c03-468c-ad8f-80d442be4392",
                                                "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                                "text": "„Lampe sieht zunächst den kleinen Spalt zwischen den Vorderzähnen, dann schaut er, soeben erwacht und noch schlaftrunken, in lebhaft strahlende Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
