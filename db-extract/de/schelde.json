                        "sense_id": "c7b86d2c-3e1b-3983-95ee-918e6e6a2a38",
                        "entry_id": "4b98d7d4-a1ff-3954-9b96-2f164a92bf1f",
                        "glosses": [
                            "französisch-belgisch-niederländischer Fluss"
                        ],
