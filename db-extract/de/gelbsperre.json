                "senses": [
                    {
                        "sense_id": "43a14b24-8b8b-3263-9055-b846b39ffa81",
                        "entry_id": "02dddc94-0140-3484-aca5-5e43a9be2694",
                        "glosses": [
                            "Ausschluss eines Spielers, nachdem er eine bestimmte Anzahl an Gelben Karten erhalten hatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585db97d-b534-41eb-a09b-849ef5f5cdd2",
                                "sense_id": "43a14b24-8b8b-3263-9055-b846b39ffa81",
                                "text": "„Der französische Nationalspieler durfte aufgrund einer Gelbsperre aus der vergangenen Saison beim italienischen Rekordmeister nicht eingesetzt werden.“"
                            },
                            {
                                "example_id": "790e0d2b-b981-4345-b9e5-6f8ce762a0f5",
                                "sense_id": "43a14b24-8b8b-3263-9055-b846b39ffa81",
                                "text": "„Das letzte Duell entschied Mats Hummels im Viertelfinale der WM 2014 in Brasilien, jetzt fehlte er wegen seiner Gelbsperre genauso wie die verletzten Sami Khedira und Mario Gomez.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
