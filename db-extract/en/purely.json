                        "examples": [
                            {
                                "example_id": "1d2400ab-81d6-41d5-85b5-95b141fea0a0",
                                "sense_id": "e45ee146-739f-3d1b-97d8-b83d1c7cf723",
                                "text": "I am fascinated by the entire scene, I purely am."
                            }
                        ]
                    },
                    {
                        "sense_id": "40ab169f-3fcc-3606-b0bb-f16fe0a12c5b",
                        "entry_id": "32eed050-7258-3a80-b9a1-d99a8435ddd3",
                        "glosses": [
                            "Solely; exclusively; merely, simply."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e65bdf4d-bf33-4692-a5f5-aae7f4717ab2",
                                "sense_id": "40ab169f-3fcc-3606-b0bb-f16fe0a12c5b",
                                "text": "The IRA should \"lead by example\" and \"unilaterally\" abandon paramilitary violence and adopt a purely political strategy, a leading Sinn Féin MP urged yesterday."
                            },
                            {
                                "example_id": "fc2a8409-1515-4d73-9f80-323a5951612e",
                                "sense_id": "40ab169f-3fcc-3606-b0bb-f16fe0a12c5b",
                                "text": "\"But this meal tonight is not a date, not in the traditional sense. It's purely platonic, I assure you.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "4c1a19d9-b35a-3300-9a0c-f9dd52cc2a8d",
                        "entry_id": "32eed050-7258-3a80-b9a1-d99a8435ddd3",
                        "glosses": [
                            "Chastely, innocently; in a sinless manner, without fault."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e27da3-4221-4973-a7f8-723161570741",
                                "sense_id": "4c1a19d9-b35a-3300-9a0c-f9dd52cc2a8d",
                                "text": "faith and troth, / Strain'd purely from all hollow bias drawing: / Bids thee with most diuine integritie, / From heart of very heart, great Hector welcome."
                            }
                        ]
                    },
                    {
                        "sense_id": "c542d859-81f7-3398-8661-5ac9fce1c2e2",
                        "entry_id": "32eed050-7258-3a80-b9a1-d99a8435ddd3",
                        "glosses": [
                            "Without physical adulterants; refinedly, with no admixture."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "df4790ba-75bd-4d76-bcd3-6645dfe14212",
                                "sense_id": "c542d859-81f7-3398-8661-5ac9fce1c2e2",
                                "text": "By some means or other the water flows purely, and separated from the filth, in a deeper and narrower course on one side of the rock, and the refuse of the dirt and troubled water goes off on the other in a broader current [...]."
                            }
                        ]
                    }
