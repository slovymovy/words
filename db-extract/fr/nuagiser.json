                "senses": [
                    {
                        "sense_id": "d22be3df-b6b4-3cf5-a0d2-06b86f3032dc",
                        "entry_id": "4d6f74f0-fbad-3bb4-aebf-8378d1301f11",
                        "glosses": [
                            "Adapter au cloud computing (ou informatique en nuage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32814377-2226-4f60-b505-774e3ebbca43",
                                "sense_id": "d22be3df-b6b4-3cf5-a0d2-06b86f3032dc",
                                "text": "Grande est la tentation du cloud et le désir de «nuagiser» ses pratiques numériques pour s'affranchir des contraintes techniques et fonctionnelles liées, par exemple, à l'emploi de tel ou tel système d'exploitation."
                            },
                            {
                                "example_id": "565f88d8-50f0-47c5-a01a-a7804cf55523",
                                "sense_id": "d22be3df-b6b4-3cf5-a0d2-06b86f3032dc",
                                "text": "Le marché se répartit en deux acteurs : les clouds «pure placers» et les éditeurs qui «nuagisent» leurs solutions."
                            },
                            {
                                "example_id": "eaaea259-fa04-4aad-8c9f-f3c8321bf4c8",
                                "sense_id": "d22be3df-b6b4-3cf5-a0d2-06b86f3032dc",
                                "text": "iCloud : service Apple destiné à « nuagiser » tous les aspects."
                            }
                        ]
                    }
