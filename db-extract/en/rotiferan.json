                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51927172-ca6e-42d6-921e-2e4a6a29a2a2",
                                "sense_id": "360b499d-8892-3474-9150-68e3dbb5674d",
                                "text": "A whole list of other rotiferans characterize the nutrient rich waters of the early winter dry season."
                            },
                            {
                                "example_id": "089baf19-5bd3-4e57-a3d9-0a99ac24dea9",
                                "sense_id": "360b499d-8892-3474-9150-68e3dbb5674d",
                                "text": "Grazing activity of abundant populations of filter feeders such as the cladocerans Daphnia and Moina, and of Brachionus, Filinia and other herbivorous rotiferans, may considerably reduce the density of live and inert particles in the reservoir."
                            },
                            {
                                "example_id": "65d2e83c-a0fd-4b6e-88cf-4ad5b7b94de3",
                                "sense_id": "360b499d-8892-3474-9150-68e3dbb5674d",
                                "text": "A protonephridium is a network of tubules that lack internal openings as is found in platyhelminths and rotiferans."
                            }
                        ]
                    }
