    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                "word": "footpad",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9cd37e2a-d38d-48b7-befb-4abbfeb68632",
                        "entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                        "tags": [
                            "plural"
                        ],
                        "form": "footpads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4dc81f9-ed6c-3e23-9244-bcd2bc4ffb48",
                        "entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                        "glosses": [
                            "The soft underside of an animal's paw."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4af71bb-ffe2-3c45-b026-3b256223473e",
                        "entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                        "glosses": [
                            "A medicated bandage for the treatment of corns and warts."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                        "entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                        "glosses": [
                            "A thief on foot who robs travellers on the road."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b97db98b-8e20-436c-94e6-d8798b884833",
                                "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                                "text": "The fraudulent clerk and the flash \"cracksman\" interchanged experiences. The smuggler's stories of lucky ventures and successful runs were capped by the footpad’s reminiscences of foggy nights and stolen watches."
                            },
                            {
                                "example_id": "734ee998-7ba2-49db-ad6c-dffa83c9b605",
                                "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                                "text": "Col. Isaac Trumbo, who made a fortune in Utah and lost it in San Francisco, died here to-day of injuries received last Saturday night, when he was beaten by footpads."
                            },
                            {
                                "example_id": "d4753a94-2767-4dcc-8117-ad545f1ed72e",
                                "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                                "text": "He would lend it to get rid of Podson: the price of three weeks' food money extorted from him by a footpad."
                            },
                            {
                                "example_id": "5a0866a9-cf88-47e1-93b3-282e84b3ca81",
                                "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                                "text": "Coach Leather. The pliant but resolute stuff our grandfathers utilised to keep out wind, weather and footpads on the Great North Road or the Gundagai Track, according to whether you are Third or Fourth G.A."
                            },
                            {
                                "example_id": "0b724b97-10dd-48cd-8e21-7cda6dd1f8c5",
                                "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                                "text": "It suddenly occurred to me this was my mother of about two hundred years ago in England, and that I was her footpad son, returning from gaol to haunt her honest labors in the hashery."
                            },
                            {
                                "example_id": "6b2a8dad-8edc-44c9-a0ff-ccebef35f697",
                                "sense_id": "f2af7e3d-6704-3bab-ac68-9205608af3c7",
                                "text": "“The thief-catcher always sought out the cutpurses and burglars and footpads in a town; he claimed they knew more of what was really going on then any official.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "38d7561a-9ecf-3ecc-8a18-84003365934f",
                        "entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                        "glosses": [
                            "An unmade, minor walking trail formed only by foot traffic."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "28eb438e-80c4-4889-9f94-bd70c6d45054",
                                "sense_id": "38d7561a-9ecf-3ecc-8a18-84003365934f",
                                "text": "Nemarluck, if wounded in the way described by the aborigines at Talc Head, will keep to the beaten footpad leading from Delissaville to the Finnis River, and in his weakened state, will not camp any night far from a waterhole or without a fire."
                            },
                            {
                                "example_id": "0bcd8a0c-79a5-4b37-8ccc-cb50ba10aee8",
                                "sense_id": "38d7561a-9ecf-3ecc-8a18-84003365934f",
                                "text": "The rough dray track that leads to the south-cast soon becomes a poorly defined footpad which follows the tortuous pattern of the main spur through to Mount Everard, and then away to east and south to the far corner of the forest."
                            },
                            {
                                "example_id": "a54e37d2-7db8-41d1-b73a-7dbe916513e9",
                                "sense_id": "38d7561a-9ecf-3ecc-8a18-84003365934f",
                                "text": "Ignore the minor foot pad to the left — it is a scrubby track leading to a climbers' site known as Geryon Campsite."
                            },
                            {
                                "example_id": "8387a470-7a1a-416c-a3aa-5f67f2a74cd6",
                                "sense_id": "38d7561a-9ecf-3ecc-8a18-84003365934f",
                                "text": "This AAWT track varies from a four wheel drive track along the Barry Mountains to a foot pad across the snow grass plains of the high country from Hotham to Mt Bogong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ddcc885-93d4-4f7b-b3f7-69d883e2bffc",
                        "source_entry_id": "4ba68545-40d9-3d20-9b9a-d63ee8650f2f",
                        "source_sense_description": "thief on foot who robs on the road",
                        "target_lang_word": "Straßenräuber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenräuber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                        "entry_id": "4a4bf09f-fc81-31da-8c24-73c7517c3253",
                                        "glosses": [
                                            "Person, die ihre Raubüberfälle auf offener Straße begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eecf83c2-56c6-4346-a6dd-70c013daea41",
                                                "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                                "text": "„Dort drängten sich Gasthäuser, in denen Banden von Prostituierten und Straßenräubern Unterkunft gefunden hatten.“"
                                            },
                                            {
                                                "example_id": "668bad65-2251-447c-ab42-2ca9c4d860c3",
                                                "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                                "text": "„Sade läßt den historischen Giftmörder Desrues und den historischen Straßenräuber Cartouche in seinen Romanen auftreten.“"
                                            },
                                            {
                                                "example_id": "5641f6f2-893d-401e-bf37-30d8990615e5",
                                                "sense_id": "774c7d15-8bff-330d-ab2c-c96143f6f063",
                                                "text": "„Ein Straßenräuber hielt die Adam nicht unbekannte Kutsche auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
