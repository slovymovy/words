                "translations": [
                    {
                        "translation_id": "1927b62f-4d7f-49d3-91cc-99a0dc8844aa",
                        "source_entry_id": "9d7748f1-80fa-31e4-8918-23adc024c7bf",
                        "source_sense_id": "2b7455bf-eb4c-3942-8745-727f98b408d2",
                        "source_sense_description": "the quality of being beautiful",
                        "target_lang_word": "krása",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krása",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1ec4808d-9b39-3c2a-847b-998f255cb731",
                                        "entry_id": "d83828f8-e8cf-34b0-8981-b90fe2adaea5",
                                        "glosses": [
                                            "jev či vlastnost, kdy něco nebo někdo je vnímáno jako krásné"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6425c2a4-ab95-4032-bd5e-abb9732608bd",
                                                "sense_id": "1ec4808d-9b39-3c2a-847b-998f255cb731",
                                                "text": "Princeznina krása předčila Honzovo i drakovo očekávání."
                                            },
                                            {
                                                "example_id": "ea6bfe5b-2dda-4ed1-90a5-ddedd4f86687",
                                                "sense_id": "1ec4808d-9b39-3c2a-847b-998f255cb731",
                                                "text": "Krása pomíjí, blbost je věčná."
                                            },
                                            {
                                                "example_id": "c85bab66-ae28-42d2-875d-a3ece67538ed",
                                                "sense_id": "1ec4808d-9b39-3c2a-847b-998f255cb731",
                                                "text": "Podívalo se ([děvčátko], pozn. Wiki) na Taminu bez zvláštního zájmu, pohledem ženy, která je si vědoma své krásy a chce ji podtrhnout okázalým nezájmem o všechno, co není ona sama."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ee78077-6dd7-4766-b5b8-38b1a2977266",
                        "source_entry_id": "9d7748f1-80fa-31e4-8918-23adc024c7bf",
                        "source_sense_id": "2b7455bf-eb4c-3942-8745-727f98b408d2",
                        "source_sense_description": "the quality of being beautiful",
                        "target_lang_word": "Schönheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schönheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e447f1c-d1ba-3de7-a9e2-99b0add9db94",
                                        "entry_id": "1caf4c82-8d7f-33fc-b72f-a43c4231a63c",
                                        "glosses": [
                                            "die Eigenschaft, schön zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a023fe8-60e9-4d55-b439-8d5ac58cbaeb",
                                                "sense_id": "3e447f1c-d1ba-3de7-a9e2-99b0add9db94",
                                                "text": "„Soviel in dir die Liebe wächst, soviel wächst die Schönheit in dir. Denn die Liebe ist die Schönheit der Seele.“"
                                            },
                                            {
                                                "example_id": "832d9e23-94f4-4f42-8aba-ffc9db485924",
                                                "sense_id": "3e447f1c-d1ba-3de7-a9e2-99b0add9db94",
                                                "text": "„Ich sehe weibliche Schönheit und bin so geblendet, dass ich nichts anderes mehr wahrnehme.“"
                                            },
                                            {
                                                "example_id": "9a7dfc50-5a80-4619-bc5e-2f6e0fdcae8e",
                                                "sense_id": "3e447f1c-d1ba-3de7-a9e2-99b0add9db94",
                                                "text": "„Ihre Schönheit war erschütternd.“"
                                            },
                                            {
                                                "example_id": "a07f6e3c-83bb-49b9-a4b1-1cb8a08307d0",
                                                "sense_id": "3e447f1c-d1ba-3de7-a9e2-99b0add9db94",
                                                "text": "„Auf unserer Reise kamen wir an Orte, die uns den Blick öffneten für die Schönheit und Einzigartigkeit der Landschaft, die trotz des Einflusses des Menschen auf die Natur noch heute zu finden sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37c82f78-998c-33c8-91eb-784942b4e91c",
                                        "entry_id": "1caf4c82-8d7f-33fc-b72f-a43c4231a63c",
                                        "glosses": [
                                            "die schönen Seiten, die schönen Eigenschaften von etwas"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f30aa0d3-0b6d-4f3f-a1b2-f829032172db",
                                                "sense_id": "37c82f78-998c-33c8-91eb-784942b4e91c",
                                                "text": "Sie zeigte mir die Schönheiten ihres Heimatlandes."
                                            },
                                            {
                                                "example_id": "349f9228-191f-428f-adfc-32aa7e945f58",
                                                "sense_id": "37c82f78-998c-33c8-91eb-784942b4e91c",
                                                "text": "„Jetzt freilich, unter dem Sternenschein, lag alles da wie das Schloß im Märchen, und Schach hielt öfters an und sah hinauf, augenscheinlich betroffen von der Schönheit des Bildes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31e07424-5b13-38f8-a1da-49a299e34e32",
                                        "entry_id": "1caf4c82-8d7f-33fc-b72f-a43c4231a63c",
                                        "glosses": [
                                            "eine äußerlich schöne weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193bfe67-4df8-4b30-b39f-a0a4bf798a7b",
                                                "sense_id": "31e07424-5b13-38f8-a1da-49a299e34e32",
                                                "text": "Seine Freundin ist eine wahre Schönheit."
                                            },
                                            {
                                                "example_id": "929730ee-52f0-4048-8681-f0af0993e75f",
                                                "sense_id": "31e07424-5b13-38f8-a1da-49a299e34e32",
                                                "text": "Ich bin heute Abend ja von lauter Schönheiten umgeben!"
                                            },
                                            {
                                                "example_id": "97ad8c08-6a76-4fad-9b99-cfa1e351ac17",
                                                "sense_id": "31e07424-5b13-38f8-a1da-49a299e34e32",
                                                "text": "„Ein oder zwei Minuten später trennte sich ein recht gut gekleideter, doch unerfreulich aussehender Mann von der eindrucksvollen Schönheit, die meine Augen fesselte, näherte sich dem Ritter, der mit mir gesprochen hatte, und sagte ihm etwas ins Ohr.“"
                                            },
                                            {
                                                "example_id": "06e484c6-b879-4c00-9b47-6f53a9d57f45",
                                                "sense_id": "31e07424-5b13-38f8-a1da-49a299e34e32",
                                                "text": "„Carlota hätte man als präraffaelitische Schönheit bezeichnen können, während Pepa einer Yankeehure der Zwischenkriegszeit glich.“"
                                            },
                                            {
                                                "example_id": "da15029f-8aab-4223-939f-0b3d887d6788",
                                                "sense_id": "31e07424-5b13-38f8-a1da-49a299e34e32",
                                                "text": "„Mit einem Jubelschrei flog die blonde Schönheit Thomas an den Hals und warf ihn fast über den Haufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "25e5a99f-5c2e-303d-8615-2a13bba26e31",
                                        "entry_id": "1caf4c82-8d7f-33fc-b72f-a43c4231a63c",
                                        "glosses": [
                                            "auch für männliche Personen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95f470d5-1c99-47c7-918c-e72cfc3ceaad",
                                                "sense_id": "25e5a99f-5c2e-303d-8615-2a13bba26e31",
                                                "text": "„Guck dir die Qualle an, die platzt ja aus allen Nähten!“ – „Du bist ja auch nicht gerade eine Schönheit!“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
