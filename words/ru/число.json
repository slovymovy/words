                {
                    "sense_id": "440db664-56ce-3d64-b722-f8aa448155e5",
                    "sense_definition": "Перепись населения для обложения данью (в историческом контексте Древней Руси).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старых летописях упоминается <w>число</w>, проведённое монголами.",
                            "target_lang_translations": {
                                "en": "Old chronicles mention the <w>census</w> conducted by the Mongols.",
                                "zh": "古老的编年史中提到了蒙古人进行的<w>人口普查</w>。"
                            }
                        },
                        {
                            "text": "Жители города боялись, что скоро начнётся новое <w>число</w>.",
                            "target_lang_translations": {
                                "en": "The city residents feared that a new <w>census</w> would start soon.",
                                "zh": "城里的居民担心很快又要开始新一轮的<w>人口普查</w>。"
                            }
                        }
