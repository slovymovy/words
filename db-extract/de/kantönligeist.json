                "senses": [
                    {
                        "sense_id": "d7002323-f26a-3122-a1b4-9a6f170904ad",
                        "entry_id": "319d2d50-0787-3c04-bbc0-0e7c6cce8970",
                        "glosses": [
                            "a mindset or ideological trend wherein the sovereignty and interests of a particular canton are seen as supreme over federal interests"
                        ],
                        "tags": [
                            "Switzerland",
                            "derogatory",
                            "masculine",
                            "singular",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "3316bd98-5c55-4833-b9d7-477374245f5c",
                                "sense_id": "d7002323-f26a-3122-a1b4-9a6f170904ad",
                                "text": "In ihrer individuellen Mannigfaltigkeit werden die Kantone der Schweiz uns geographisch charakterisirt, und es ist uns, als ob aus diesen verschiedenen Physiognomieen schon die Grundelemente der verschiedenen „Kantönligeister“ emportauchten.",
                                "translation": "The cantons of Switzerland are geographically characterized to us in their individual diversity, and it seems to us, as if already the basic elements of the various \"cantonal mindsets\" emerged from these different physiognomies.",
                                "english": "The cantons of Switzerland are geographically characterized to us in their individual diversity, and it seems to us, as if already the basic elements of the various \"cantonal mindsets\" emerged from these different physiognomies."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4cd9cec-3ebd-3c2d-829d-7dc74571e099",
                        "entry_id": "319d2d50-0787-3c04-bbc0-0e7c6cce8970",
                        "glosses": [
                            "a person who acts in accordance with this mindset"
                        ],
                        "tags": [
                            "Switzerland",
                            "derogatory",
                            "masculine",
                            "strong",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "7c79575f-d5b5-418c-afb0-0b57257099b6",
                                "sense_id": "d4cd9cec-3ebd-3c2d-829d-7dc74571e099",
                                "text": "Ansonsten schaffen es verknöcherte, ewig-gestrige Kantönligeister und Leerparolen-verbreitende Egopolitiker noch, das ganze Land zu ruinieren.",
                                "translation": "Otherwise, ossified, reactionary people with a cantonal mindset and self-centered politicians spreading empty slogans will eventually manage to ruin the whole country.",
                                "english": "Otherwise, ossified, reactionary people with a cantonal mindset and self-centered politicians spreading empty slogans will eventually manage to ruin the whole country."
                            }
                        ]
                    }
