                "senses": [
                    {
                        "sense_id": "bb516393-c5e7-3f8e-84b5-e52afa160fda",
                        "entry_id": "25583cd5-2065-3f59-995a-328f6f3a1e56",
                        "glosses": [
                            "Dorer doublement, solidement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da6cc1c-fb43-47b8-8a95-681f6af44630",
                                "sense_id": "bb516393-c5e7-3f8e-84b5-e52afa160fda",
                                "text": "Nous sortîmes de Saint-Malo au lever du soleil, ma mère, mes quatre sœurs et moi, dans une énorme berline à l’antique, panneaux surdorés, marchepieds en dehors, glands de pourpre aux quatre coins de l’impériale."
                            },
                            {
                                "example_id": "4c7810c8-79bc-4081-9b95-3c8f61f6f933",
                                "sense_id": "bb516393-c5e7-3f8e-84b5-e52afa160fda",
                                "text": "Elle s’ouvrait au couchant par trois hautes arcades à voussures, fermées par des portes de ferronnerie surdorées."
                            }
                        ]
                    }
                ],
