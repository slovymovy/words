{
    "word_family": [
        "distance",
        "distantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                    "sense_definition": "Existing or happening far away in space, time, or relationship.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the low rumble of <w>distant</w> thunder coming from the mountains.",
                            "target_lang_translations": {
                                "ru": "Мы слышали низкий рокот <w>отдалённого</w> грома, доносившийся с гор.",
                                "zh": "我们能听到从山里传来的<w>遥远</w>的低沉雷声。"
                            }
                        },
                        {
                            "text": "She is a <w>distant</w> relative who I have only met once at a family wedding.",
                            "target_lang_translations": {
                                "ru": "Она — <w>дальняя</w> родственница, которую я встречал лишь однажды на семейной свадьбе.",
                                "zh": "她是我的一位<w>远房</w>亲戚，我只在一次家庭婚礼上见过她一次。"
                            }
                        }
                    ],
                    "synonyms": [
                        "far",
                        "far-off",
                        "faraway",
                        "remote",
                        "far-flung",
                        "outlying"
                    ],
                    "antonyms": [
                        "near"
                    ],
                    "common_phrases": [
                        "distant future",
                        "distant relative",
                        "distant memory",
                        "distant lands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или происходящий далеко в пространстве, времени или отношениях.",
                        "zh": "在空间、时间或关系上相距遥远的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "далёкий",
                                "target_lang_sense_clarification": "находящийся на большом расстоянии в пространстве или времени"
                            },
                            {
                                "target_lang_word": "дальний",
                                "target_lang_sense_clarification": "находящийся далеко; часто используется для описания родства"
                            },
                            {
                                "target_lang_word": "отдалённый",
                                "target_lang_sense_clarification": "находящийся на некотором расстоянии, удалённый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遥远",
                                "target_lang_sense_clarification": "指空间或时间上距离很远"
                            },
                            {
                                "target_lang_word": "远房",
                                "target_lang_sense_clarification": "指亲属关系疏远"
                            },
                            {
                                "target_lang_word": "偏远",
                                "target_lang_sense_clarification": "指地理位置远离中心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4dd26d9-18eb-3b96-995c-4552659ead05",
                    "sense_definition": "Emotionally unresponsive or unwilling to express genuine feelings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became cold and <w>distant</w> after we had that argument yesterday.",
                            "target_lang_translations": {
                                "ru": "Он стал холодным и <w>отстранённым</w> после нашей вчерашней ссоры.",
                                "zh": "昨天我们吵架后，他变得冷漠且<w>疏远</w>了。"
                            }
                        },
                        {
                            "text": "Her <w>distant</w> attitude made it difficult for anyone to get close to her.",
                            "target_lang_translations": {
                                "ru": "Её <w>отстранённое</w> отношение мешало кому-либо сблизиться с ней.",
                                "zh": "她那<w>冷淡</w>的态度让别人很难接近她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aloof",
                        "cold",
                        "cool",
                        "reserved",
                        "standoffish",
                        "unapproachable",
                        "remote",
                        "undemonstrative"
                    ],
                    "common_phrases": [
                        "seem distant",
                        "act distant",
                        "distant manner",
                        "distant look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоционально закрытый, не желающий выражать истинные чувства; холодный в общении.",
                        "zh": "情感上冷漠的，不愿表达真实感受的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстранённый",
                                "target_lang_sense_clarification": "безучастный, погружённый в себя, холодный"
                            },
                            {
                                "target_lang_word": "отдалённый",
                                "target_lang_sense_clarification": "безучастный, безразличный (о взгляде или отношении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷淡",
                                "target_lang_sense_clarification": "指态度不亲切，不热情"
                            },
                            {
                                "target_lang_word": "疏远",
                                "target_lang_sense_clarification": "指关系不亲密，有隔阂"
                            },
                            {
                                "target_lang_word": "冷漠",
                                "target_lang_sense_clarification": "指对人或事不关心，态度冷淡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                    "sense_definition": "Imported into a cable television system from a different market.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cable provider pays a fee to broadcast the <w>distant</w> signal to local subscribers.",
                            "target_lang_translations": {
                                "ru": "Кабельный провайдер платит сбор за трансляцию <w>удалённого</w> сигнала местным абонентам.",
                                "zh": "有线电视运营商支付费用，将<w>外地</w>信号转播给本地用户。"
                            }
                        },
                        {
                            "text": "Regulations often distinguish between local channels and <w>distant</w> stations imported from other areas.",
                            "target_lang_translations": {
                                "ru": "Правила часто проводят различие между местными каналами и <w>удалёнными</w> станциями, транслируемыми из других районов.",
                                "zh": "法规通常会区分本地频道和从其他地区引入的<w>外地</w>电视台。"
                            }
                        }
                    ],
                    "antonyms": [
                        "local"
                    ],
                    "common_phrases": [
                        "distant signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транслируемый в систему кабельного телевидения из другого региона (рынка).",
                        "zh": "指从其他地区市场引入有线电视系统的信号或频道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удалённый",
                                "target_lang_sense_clarification": "телев.: транслируемый из другого региона (рынка)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外地",
                                "target_lang_sense_clarification": "指来自其他地区或市场的"
                            },
                            {
                                "target_lang_word": "远程",
                                "target_lang_sense_clarification": "指跨越长距离传输的信号"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}