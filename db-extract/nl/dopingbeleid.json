                        "examples": [
                            {
                                "example_id": "4e95c353-3ce5-4af1-a1b0-d2a8f1c23d38",
                                "sense_id": "3bc7e6ba-7847-3a34-9922-c07fe625b61b",
                                "text": "\"Het is de enige beslissing die ik begrijp en de enige beslissing die ik kan uitleggen\", zegt Ram over de uitkomst van de bijeenkomst van de IAAF op vrijdag in Wenen. \"Er is wel vooruitgang door de Russen geboekt, maar de tolerantie voor doping is daar niet veranderd. Een sterk effectief dopingbeleid is er gewoon niet. Aan diverse belangrijke criteria hebben ze niet voldaan.\""
                            },
                            {
                                "example_id": "9cb73b71-0db6-4db1-a35f-c9d22e4f1a0a",
                                "sense_id": "3bc7e6ba-7847-3a34-9922-c07fe625b61b",
                                "text": "Ram: \"Nederland lag achterop als het om dopingbestrijding ging. Dopingbeleid is internationaal en Nederland kwam steeds meer onder druk te staan. Dat is gelukkig teruggedraaid.\""
                            }
                        ]
