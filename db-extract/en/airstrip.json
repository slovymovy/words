                        "entry_id": "d0c1af4a-0f9a-3b92-a8ae-97a4525f3914",
                        "glosses": [
                            "An aircraft landing field, usually with one runway and only basic facilities."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7931af02-f274-48ce-8fbb-dd34913a564b",
                                "sense_id": "bf2de449-0e2d-373b-923a-094d45c266fa",
                                "text": "The outfitter deposited us at a small airstrip out in the bush, promising to pick us up again in a week's time."
                            }
                        ]
                    }
                ],
