                            },
                            {
                                "target_lang_word": "lehine vasiyet edilen kişi",
                                "target_lang_sense_clarification": "hukuki terim"
                            },
                            {
                                "target_lang_word": "faydalanıcı",
                                "target_lang_sense_clarification": "vakıf veya mal varlığından yararlanan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf93c94-d6f5-3d16-be36-1d40e5f833b2",
                    "sense_definition": "A person entitled to receive the payout or death benefit from an insurance policy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to update your <w>beneficiary</w> information whenever your family situation changes.",
                            "target_lang_translations": {
                                "ru": "Важно обновлять информацию о <w>выгодоприобретателе</w> всякий раз, когда меняется ваше семейное положение.",
                                "tr": "Aile durumunuz her değiştiğinde <w>lehtar</w> bilgilerinizi güncellemeniz önemlidir."
                            }
                        },
                        {
                            "text": "The insurance company contacted the <w>beneficiary</w> shortly after the policyholder passed away.",
                            "target_lang_translations": {
                                "ru": "Страховая компания связалась с <w>бенефициаром</w> вскоре после смерти страхователя.",
                                "tr": "Sigorta şirketi, poliçe sahibinin vefatından kısa bir süre sonra <w>lehtar</w> ile iletişime geçti."
                            }
                        }
                    ],
                    "synonyms": [
                        "payee"
                    ],
                    "common_phrases": [
                        "insurance beneficiary",
                        "designated beneficiary"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "insurance context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, имеющее право на получение выплаты или страхового возмещения по страховому полису.",
                        "tr": "Bir sigorta poliçesinden tazminat veya ölüm tazminatı almaya hak kazanan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгодоприобретатель",
                                "target_lang_sense_clarification": "в страховании"
                            },
                            {
                                "target_lang_word": "бенефициар",
                                "target_lang_sense_clarification": "получатель страховой выплаты"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "lehtar",
                                "target_lang_sense_clarification": "sigorta ödemesini alacak kişi"
                            },
                            {
                                "target_lang_word": "faydalanıcı",
                                "target_lang_sense_clarification": "sigorta poliçesi hak sahibi"
                            }
                        ]
                    }
                }
            ]
        },
        {
