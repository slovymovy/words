                    {
                        "sense_id": "cd5e05b2-6f45-3482-8b3a-be5fe4cd9797",
                        "entry_id": "50524b9a-e419-3919-a8f9-ed2c263829f2",
                        "glosses": [
                            "związany z kapłaństwem lub kapłanem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26798ca9-54ed-44ad-8809-5f5230723c20",
                                "sense_id": "cd5e05b2-6f45-3482-8b3a-be5fe4cd9797",
                                "text": "Nasz proboszcz obchodzi pięćdziesiątą rocznicę święceń kapłańskich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cfcf516-cb5d-4274-82a2-9e9ee6a145b6",
                        "source_entry_id": "50524b9a-e419-3919-a8f9-ed2c263829f2",
                        "source_sense_id": "cd5e05b2-6f45-3482-8b3a-be5fe4cd9797",
                        "target_lang_word": "sacerdotal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacerdotal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11667b26-8021-3de7-9913-0e3050141201",
                                        "entry_id": "c0f1f151-8869-3bfc-94b4-136e6157440b",
                                        "glosses": [
                                            "Of or relating to priests or a high religious order; priestly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "693c4282-6f37-4bd7-b236-862e33a59e7a",
                                                "sense_id": "11667b26-8021-3de7-9913-0e3050141201",
                                                "text": "...and so neither is the Silence of the Reformed, and of the Church of England in relation to the Rebaptization of Persons Baptiz'd by Midwives and Laymen, any Argument against their receiving Sacerdotal Baptism; so long as that is the only Baptism which Christ Instituted, and which by his Law every one is bound to receive, who has not yet received it."
                                            },
                                            {
                                                "example_id": "b7b5c124-007a-40d6-a6ee-aabf4dca759e",
                                                "sense_id": "11667b26-8021-3de7-9913-0e3050141201",
                                                "text": "...some of the figures are costumed in the style of religious art, with flowing sacerdotal garments."
                                            },
                                            {
                                                "example_id": "79281988-41cf-4d48-8783-83a8c0518f82",
                                                "sense_id": "11667b26-8021-3de7-9913-0e3050141201",
                                                "text": "Verena's initial appearance in Boston, as he called her performance at Miss Birdseye's, had been a great success; and this reflection added, as I say, to his habitually sacerdotal expression."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bd746ae-4aa8-4120-92e6-1fc4ea0c472c",
                        "source_entry_id": "50524b9a-e419-3919-a8f9-ed2c263829f2",
                        "source_sense_id": "cd5e05b2-6f45-3482-8b3a-be5fe4cd9797",
