                        "examples": [
                            {
                                "example_id": "2e54f7c4-3d02-4a1e-b3eb-bcc7b54e9c9d",
                                "sense_id": "e07d59e0-1195-36f2-acfe-9792b4e2435e",
                                "text": "„Ich entdecke fünf oder sechs Kindergräber von Neugeborenen, mit knöchelhohen Holzgittern und einem schlichten weißen Kreuz, auf den Plastikblumen ein Plüschtier.“"
                            },
                            {
                                "example_id": "ba8f778a-77ad-410f-aa1e-4c38b97f78a5",
                                "sense_id": "e07d59e0-1195-36f2-acfe-9792b4e2435e",
                                "text": "„Ein Großteil der Kindergräber war in einem erbärmlichen Zustand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
