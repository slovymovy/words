                    {
                        "sense_id": "5b340e45-048e-30d4-bd26-20735b359f1f",
                        "entry_id": "796b57c9-2da7-3ccb-aa82-adf2ff0f34e8",
                        "glosses": [
                            "lookout (a vantage point)"
