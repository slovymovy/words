            "senses": [
                {
                    "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                    "sense_definition": "Ein heranwachsender junger Mensch, der sich noch vor dem Jugend- und Erwachsenenalter befindet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "heranwachsender_mensch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Draußen auf der Straße spielen viele <w>Kinder</w> miteinander und lachen laut."
                        },
                        {
                            "text": "Das kleine <w>Kind</w> schläft schon seit zwei Stunden friedlich in seinem Bett."
                        }
                    ],
                    "synonyms": [
                        "Knirps",
                        "Gör",
                        "Göre",
                        "Kid"
                    ],
                    "antonyms": [
                        "Erwachsener",
                        "Jugendlicher"
                    ],
                    "common_phrases": [
                        "kleines Kind",
                        "spielende Kinder"
                    ]
                },
                {
                    "sense_id": "0a76a62f-59b5-316e-9523-2ff61edce3b6",
                    "sense_definition": "Mensch im Hinblick auf seine Abstammung und das Verwandtschaftsverhältnis zu den eigenen Eltern.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "nachkomme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie haben drei <w>Kinder</w>, die alle schon erwachsen sind und eigene Berufe haben."
                        },
                        {
                            "text": "Er ist das älteste <w>Kind</w> einer großen Familie aus einem kleinen Dorf."
                        }
                    ],
                    "synonyms": [
                        "Nachkomme",
                        "Abkömmling",
                        "Nachwuchs",
                        "Sprössling",
                        "Spross"
                    ],
                    "antonyms": [
                        "Eltern",
                        "Großeltern",
                        "Urgroßeltern"
                    ],
                    "common_phrases": [
                        "erstes Kind",
                        "Kind der Familie"
                    ]
                },
                {
                    "sense_id": "1ec44299-ddd0-3f35-be95-773d11a5f6dc",
                    "sense_definition": "Vertrauliche, meist von älteren Personen gebrauchte Anrede an eine nahestehende oder jüngere Person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ach, mein <w>Kind</w>, mach dir doch bitte nicht so viele unnötige Sorgen um mich!"
                        },
                        {
                            "text": "Hör mir gut zu, mein <w>Kind</w>, denn ich möchte dir einen wichtigen Rat geben."
                        }
                    ],
                    "common_phrases": [
                        "mein Kind"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "als vertrauliche oder liebevolle Anrede"
                        }
                    ]
                }
            ]
        }
    ]
