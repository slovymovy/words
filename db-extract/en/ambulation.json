                    {
                        "translation_id": "6487c25c-8504-4994-b990-15ebcd9c5fe6",
                        "source_entry_id": "3ee005ba-01e5-31c4-87f8-4c94abca67b9",
                        "source_sense_id": "346803d9-3be4-3a6e-ac49-99a0ff1e9369",
                        "source_sense_description": "walking",
                        "target_lang_word": "Spaziergang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spaziergang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                        "entry_id": "de37c26f-7018-3e78-9afe-7926f0752efb",
                                        "glosses": [
                                            "geruhsames Gehen zur Erholung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14abb0c9-9e1a-4657-be79-de46f35019c3",
                                                "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                                "text": "Viele Menschen machen am Sonntag einen Spaziergang mit ihrer Familie."
                                            },
                                            {
                                                "example_id": "3a273dab-a45d-497e-a433-025bbdaa7fd4",
                                                "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                                "text": "„Der verschwand nach der Feier übrigens gleich im Kleiderschrank, ganz im Gegensatz zu den Lackschuhen, die mich bei jedem Spaziergang verfolgten, solange sie passten.“"
                                            },
                                            {
                                                "example_id": "575333c6-9c90-4859-93e8-e973baa9cfb2",
                                                "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                                "text": "„Er seufzte tief auf, und der schöne Spaziergang, von dem er sich einige Erholung für seine mißhandelte Leber versprochen, war ihm solcherart bös und bitter vergällt worden.“"
                                            },
                                            {
                                                "example_id": "4d393132-071e-4107-87f2-910082730709",
                                                "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                                "text": "„Es wurde kein Spaziergang, auch wenn das darüber geschriebene Buch so hieß, sondern ein Gewaltmarsch, ein Abenteuer mit Spelunken, Hürchen und Räuberpistolen - fingerfertig erzählten und handgreiflich auf die Brust gesetzten.“"
                                            },
                                            {
                                                "example_id": "269dbe6f-aefd-4aec-895a-4cd4654d3b5e",
                                                "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                                "text": "„Doch Gerhard kennt sich gut aus im Katz-und-Maus-Spiel und genießt seinen ersten Spaziergang im Westsektor der Stadt.“"
                                            },
                                            {
                                                "example_id": "d64e477a-2ce7-4d58-8cd6-ff5632f3ec3f",
                                                "sense_id": "0d47d021-4fae-303a-b3b8-d8ef5159a7c9",
                                                "text": "„Lea sah die weiten Spaziergänge nicht gern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78100feb-eaa1-3c53-bacc-efafc574c1e0",
                                        "entry_id": "de37c26f-7018-3e78-9afe-7926f0752efb",
                                        "glosses": [
                                            "leicht zu bewältigende Aufgabe"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eafdaf4-1cea-4478-bb28-44c58d232b54",
                                                "sense_id": "78100feb-eaa1-3c53-bacc-efafc574c1e0",
                                                "text": "Dieser Kampf wird für ihn kein Spaziergang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
