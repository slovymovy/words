                        "examples": [
                            {
                                "example_id": "2cf178ad-5db7-4653-b912-1cff86a735c8",
                                "sense_id": "29a3213a-3bc7-31e5-864c-e82f861b4f0f",
                                "text": "„Das nennt man wahre Corporate Identity: Im Hotel Sacher riechen sogar die Beautyprodukte auf den Zimmern nach der berühmten Schokoladetorte.“"
                            },
                            {
                                "example_id": "13ed6207-e7d0-4e7b-a874-c759b5bfd289",
                                "sense_id": "29a3213a-3bc7-31e5-864c-e82f861b4f0f",
                                "text": "„Vor knapp vier Jahren – im April 2000 – wurde dem damaligen Wiener FPÖ-Chef Hilmar Kabas während eines TV-Interviews eine Schokoladetorte ins Gesicht geschlagen.“"
                            },
                            {
                                "example_id": "45ddd1fb-f08b-492e-81bf-3183d864a869",
                                "sense_id": "29a3213a-3bc7-31e5-864c-e82f861b4f0f",
                                "text": "„Unzählige Patissiers und Köche haben seither getüftelt und zahlreiche Rezepte für flaumig-saftige Schokoladetorten entwickelt.“"
                            }
                        ],
