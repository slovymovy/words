                                "example_id": "066e4470-6653-4733-8594-a175095667d7",
                                "sense_id": "7129eaff-dc21-33d8-ad01-cc7988c1d71d",
                                "text": "L’objectif consiste simplement à intégrer ou à moyen-orientaliser lsraël."
                            },
                            {
                                "example_id": "2e6aad8a-d349-47db-88ea-9b6bccdd8935",
                                "sense_id": "7129eaff-dc21-33d8-ad01-cc7988c1d71d",
                                "text": "Si le tollé de l’opinion a suffi jusqu’ici à suspendre tout projet de mosquée, la décision d’Erdogan de raser le parc pour le remplacer par une réplique de caserne ottomane à l’apparence des plus islamiques est une tentative claire de «moyen-orientaliser» l’un des quartiers les plus européens de Turquie."
                            },
                            {
                                "example_id": "8046dc04-e133-4f2b-be0c-89df4ae914a5",
                                "sense_id": "7129eaff-dc21-33d8-ad01-cc7988c1d71d",
                                "text": "L'Europe est en train de se \"moyen-orientaliser\" les attentats et le sang qui coule deviennent malheureusement le quotidien #Bruxelles."
                            }
                        ]
                    }
