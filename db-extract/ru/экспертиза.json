                                    {
                                        "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                        "entry_id": "640bd353-a76c-3cff-9b6b-24c9a80334d4",
                                        "glosses": [
                                            "die genauere Betrachtung, Beobachtung oder das Betasten zur Bestimmung eines Sachverhalts oder Objektes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90942c1-635e-4c31-86a0-c55bd56aa259",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "Die Untersuchung ergab, dass es sich um eine Entzündung handelt, die dringend behandelt werden muss."
                                            },
                                            {
                                                "example_id": "c365b6e3-55a7-493b-b052-16516fdaaf07",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "„Diese Untersuchung greift auf eine vergleichsweise breite Literaturauswahl sowie auf bislang unveröffentlichtes Archivmaterial zurück.“"
                                            },
                                            {
                                                "example_id": "b197f9a2-352e-44b4-9c79-ebaf0cdb2112",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "„Die Untersuchung von Holzkohle aus vorgeschichtlichen Feuerstellen erfaßt die Veränderungen der Vegetation ungefähr während der letzten 500000 Jahre – seit der Mensch nach Entdeckung des Feuers erste Feuerstellen anlegte.“"
                                            },
                                            {
                                                "example_id": "3b50ef86-cadf-4d5c-8804-c741c6982df0",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "„Nach einer Untersuchung bei seinem Hausarzt wartet der sexuell akive Junggeselle auf das Ergebnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "154128ac-478f-434a-a342-2a2494e3eb1c",
                        "source_entry_id": "b83e87c1-777c-33c4-8884-4b2e0f50a768",
                        "source_sense_description": "рассмотрение, исследование",
                        "target_lang_word": "Gutachten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gutachten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "941a83da-1b72-3892-8dbf-5c7450ce1cbb",
                                        "entry_id": "52828d48-5017-3537-8c26-59374a63da8e",
                                        "glosses": [
                                            "Urteil von einem Fachmann oder Sachverständigen zu einer bestimmten Frage oder einem Sachverhalt auf seinem Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b074e0-8dfe-490e-815c-f3e7e4afa36c",
                                                "sense_id": "941a83da-1b72-3892-8dbf-5c7450ce1cbb",
                                                "text": "Bevor die Versicherung den Schaden am Fahrzeug begleicht, verlangt sie ein Gutachten von einem vereidigten Sachverständigen."
                                            },
                                            {
                                                "example_id": "f4d64da1-5370-4ec9-a293-9235a34dd0a6",
                                                "sense_id": "941a83da-1b72-3892-8dbf-5c7450ce1cbb",
                                                "text": "„Vier Ex-Fahnder verlangen Schadensersatz, weil sie aufgrund unlauterer Gutachten zwangspensioniert wurden.“"
                                            },
                                            {
                                                "example_id": "f1a8028b-bbdc-454b-a9a7-6af6b44d0333",
                                                "sense_id": "941a83da-1b72-3892-8dbf-5c7450ce1cbb",
                                                "text": "„Das letzte Gutachten über Jörg B. stammt aus dem Jahr 2013.“"
                                            },
                                            {
                                                "example_id": "b0a4287e-f556-42e7-98af-812ab5a1266b",
                                                "sense_id": "941a83da-1b72-3892-8dbf-5c7450ce1cbb",
                                                "text": "„Eine der ersten umfänglichen Arbeiten für den Magistrat ist ein Gutachten zur Reform des Schulwesens, das durch bürokratische Misswirtschaft zerrüttet sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
