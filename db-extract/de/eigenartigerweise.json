                "forms": [],
                "senses": [
                    {
                        "sense_id": "a21a4501-7486-35b3-9ec7-c161b4570d92",
                        "entry_id": "c5f867a3-ab16-3bc1-8a20-34c274feb01d",
                        "glosses": [
                            "aus unverständlichen Gründen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb1f078-d424-4f36-8f43-c65be9b326c1",
                                "sense_id": "a21a4501-7486-35b3-9ec7-c161b4570d92",
                                "text": "„Die eigenartigerweise nicht von einer Umfassungsmauer, sondern nur durch ein Fort geschützte antike Siedlung zog sich an den Hängen des Berges Velatouri empor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f7f2b39-b984-4d55-94c2-3a6a32762251",
                        "source_entry_id": "c5f867a3-ab16-3bc1-8a20-34c274feb01d",
                        "source_sense_id": "a21a4501-7486-35b3-9ec7-c161b4570d92",
                        "source_sense_description": "aus unverständlichen Gründen",
                        "target_lang_word": "strangely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strangely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                        "entry_id": "0f978319-00a9-320d-aaf9-509f31667b8b",
                                        "glosses": [
                                            "In a strange or coincidental manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddaeb662-b412-4c7f-af56-4ff1b74ecd21",
                                                "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                                "text": "Though I'd never gone to Boston before, everything looked strangely familiar."
                                            },
                                            {
                                                "example_id": "344ce64b-68dd-476a-9ab6-922f8d5c1fa1",
                                                "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                                "text": "Daniel was walking strangely because he had twisted his ankle."
                                            },
                                            {
                                                "example_id": "1dbfacf3-94a3-4b6a-bd5b-a1b8799c6eec",
                                                "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                                "text": "A tale of gangland warfare and filial loyalty in the Glasgow of 1958, Small Faces is an enjoyable but strangely unmoving film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27550ba9-6d68-3331-a923-fd303354b7d3",
                                        "entry_id": "0f978319-00a9-320d-aaf9-509f31667b8b",
                                        "glosses": [
                                            "Surprisingly, wonderfully."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6b8b2b-2070-49c6-8d1f-75c4fe5842c7",
                                                "sense_id": "27550ba9-6d68-3331-a923-fd303354b7d3",
                                                "text": "[…]all thy vexations / Were but my trials of thy love, and thou / Hast strangely stood the test[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dc2b4b8-4017-4783-ac45-8a2891c2b63b",
                        "source_entry_id": "c5f867a3-ab16-3bc1-8a20-34c274feb01d",
                        "source_sense_id": "a21a4501-7486-35b3-9ec7-c161b4570d92",
                        "source_sense_description": "aus unverständlichen Gründen",
                        "target_lang_word": "oddly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oddly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                                        "glosses": [
                                            "In a peculiar manner; strangely; unusually."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96541df5-ae55-4169-bb0c-197733ba4364",
                                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                                "text": "For December, it was oddly warm."
                                            },
                                            {
                                                "example_id": "a2973025-3eb2-4e20-8bf8-8e04bdc917b5",
                                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                                "text": "Novv, Sir, vvhen my Time comes, leſt they ſhou'd think it vvorth vvhile to handle my Memory vvith the ſame Freedom, I am vvilling to prevent its being ſo odly beſmear'd (or at beſt but flatly vvhite-vvash'd) by taking upon me to give the Publick This, as true a Picture of myſelf as natural Vanity vvill permit me to dravv; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                                        "glosses": [
                                            "In a manner measured by an odd number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb800333-ec5f-44d7-ae79-27174e2fa8d8",
                                                "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                                "text": "The oddly counted lords are always out of sync with at least one other evenly counted cycle. These two strange counts assured that at no single moment could all cycles end at the same time for an extraordinarily long time, for at least one odd count threw off all the even ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6080084-e9f1-478d-8ee1-7fd0d4b417b2",
                        "source_entry_id": "c5f867a3-ab16-3bc1-8a20-34c274feb01d",
                        "source_sense_id": "a21a4501-7486-35b3-9ec7-c161b4570d92",
                        "source_sense_description": "aus unverständlichen Gründen",
                        "target_lang_word": "bizarrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bizarrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                        "entry_id": "f3e2d835-7955-36aa-bc89-e549326f2811",
                                        "glosses": [
                                            "D'une façon bizarre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396823b9-3d03-49e3-a12f-9a0ab146d001",
                                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                                "text": "De notre amour bizarrement jaloux, Il veut, peut-être, en se jouant de nous, Nous effrayer […]"
                                            },
                                            {
                                                "example_id": "17df3a76-617b-4f96-9fbe-baf843100fef",
                                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                                "text": "Mais que les lois soient bizarrement faites, ça regarde, après tout, les peuples qui sont assez bêtes pour se les laisser faire."
                                            },
                                            {
                                                "example_id": "91053eee-be74-41ef-ba22-a1c1d4580868",
                                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                                "text": "Je notai qu’elle avait un début de double menton. Bizarrement, ce défaut m’émut."
                                            },
                                            {
                                                "example_id": "c0442c8b-98eb-4420-9a13-bfac0b2bb45d",
                                                "sense_id": "0bf9b9ba-19b0-3d3d-959a-0e32578f9290",
                                                "text": "J'avais pourtant cru voir le mot « ÉCOLE » sur la devanture de l'établissement juste après « auto ». Au temps pour moi, ma dyslexie passagère a encore frappé... Enfin... bizarrement, je crois ne pas être la seule à avoir souffert de ce syndrome ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
