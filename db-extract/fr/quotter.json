                "senses": [
                    {
                        "sense_id": "9124dd62-f924-3eb5-9ea1-f111dff83cf7",
                        "entry_id": "6e6b7054-de0f-37fc-8347-26cbcd768ad6",
                        "glosses": [
                            "Pointer sur l’engrenage, en parlant de la position d’une dent de roue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba9938d-d674-43e8-9c3f-6315939cceed",
                                "sense_id": "9124dd62-f924-3eb5-9ea1-f111dff83cf7",
                                "text": "Deux grands défauts qu’on doit éviter dans un engrenage, c’est qu’il soit trop fort ou trop faible. Dans le premier cas, les dents de la roue sont sujettes à quotter, c’est-à-dire, que les deux pointes de deux dents voisines vont toucher les deux faces opposées des deux ailes du pignon ; de sorte que ni la roue, ni le pignon ne peuvent se mouvoir."
                            }
                        ]
                    }
