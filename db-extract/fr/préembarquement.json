                                "target_senses": [
                                    {
                                        "sense_id": "b5cbc870-3bff-3dce-aa17-4b6179585d07",
                                        "entry_id": "73628772-93d4-33c9-8b28-1bf028ec7cd7",
                                        "glosses": [
                                            "Aktion, die nötigen Maßnahmen für eine bevorstehende Reise zu ergreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9eddabf-6b46-4f5f-a6df-3164464df156",
                                                "sense_id": "b5cbc870-3bff-3dce-aa17-4b6179585d07",
                                                "text": "„Ebenso wie Saweljitsch hatte auch die Prinzessin ihrerseits Anteil an Pierres Reisevorbereitungen genommen und ihm den Proviant für unterwegs hergerichtet.“"
                                            },
                                            {
                                                "example_id": "34fedc00-3e57-4862-b6a2-5b6eddcaf16e",
                                                "sense_id": "b5cbc870-3bff-3dce-aa17-4b6179585d07",
                                                "text": "„Ihre Reisevorbereitungen steckten mich an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
