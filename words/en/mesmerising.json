{
    "word_family": [
        "mesmerise",
        "mesmerism",
        "mesmerist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50359f58-adae-397a-a70b-65b0a16d3066",
                    "sense_definition": "Holding the attention of someone to the exclusion of all else so as to transfix them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "captivating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mesmerising</w> performance kept the entire audience silent for two hours.",
                            "target_lang_translations": {
                                "it": "L'esibizione <w>ipnotica</w> ha mantenuto l'intero pubblico in silenzio per due ore."
                            }
                        },
                        {
                            "text": "She stared at the <w>mesmerising</w> sunset over the ocean.",
                            "target_lang_translations": {
                                "it": "Fissava l' <w>incantevole</w> tramonto sull'oceano."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypnotic",
                        "captivating",
                        "fascinating",
                        "enthralling"
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "mesmerising performance",
                        "mesmerising view"
                    ],
                    "target_lang_definitions": {
                        "it": "Che cattura l'attenzione di qualcuno in modo così intenso da incantarlo o ipnotizzarlo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ipnotico",
                                "target_lang_sense_clarification": "riferito a qualcosa che cattura l'attenzione come se fosse un incantesimo"
                            },
                            {
                                "target_lang_word": "affascinante",
                                "target_lang_sense_clarification": "riferito a qualcosa di estremamente attraente o magnetico"
                            },
                            {
                                "target_lang_word": "incantevole",
                                "target_lang_sense_clarification": "riferito a qualcosa che rapisce lo sguardo o la mente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "258a0319-d2cc-3678-b525-17db8a642a97",
                    "sense_definition": "Present participle and gerund of <w>mesmerise</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "captivating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician was <w>mesmerising</w> the crowd with his complex card tricks.",
                            "target_lang_translations": {
                                "it": "Il mago stava <w>ipnotizzando</w> la folla con i suoi complessi trucchi di carte."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>mesmerising</w> his guests with stories of his travels.",
                            "target_lang_translations": {
                                "it": "Ha passato il pomeriggio <w>incantando</w> i suoi ospiti con i racconti dei suoi viaggi."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypnotizing",
                        "captivating",
                        "fascinating"
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio del verbo ipnotizzare, nel senso di catturare l'attenzione altrui."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ipnotizzando",
                                "target_lang_sense_clarification": "gerundio del verbo ipnotizzare"
                            },
                            {
                                "target_lang_word": "incantando",
                                "target_lang_sense_clarification": "gerundio del verbo incantare, usato per descrivere un'azione che cattura l'attenzione"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}