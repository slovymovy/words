                "senses": [
                    {
                        "sense_id": "28089150-7250-3444-b3dd-aa43f8f7eb4b",
                        "entry_id": "37eb8408-08f0-3e2a-8e70-dcaa2cbf7404",
                        "glosses": [
                            "ступающий пятками врозь, носками внутрь"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3d3e8610-c177-3fc9-8ef6-4abeb16fad42",
                        "entry_id": "37eb8408-08f0-3e2a-8e70-dcaa2cbf7404",
                        "glosses": [
                            "разг., субстантивир. медведь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2785399-51ba-47b4-9044-c5f5783a1d09",
                                "sense_id": "3d3e8610-c177-3fc9-8ef6-4abeb16fad42",
                                "text": "Да что толковать про беззащитных оленей и лосей, сам косолапый боярин лесов пуще огня боится строки."
                            },
                            {
                                "example_id": "7c02a85a-84a4-4132-9593-62ff741ce004",
                                "sense_id": "3d3e8610-c177-3fc9-8ef6-4abeb16fad42",
                                "text": "Косолапый разорил гнездо бурундука, поел его запасы и, может быть, съел и самого хозяина."
                            }
                        ]
                    },
                    {
                        "sense_id": "64e4390d-185c-30f5-b6dc-b9d1aca1ed88",
                        "entry_id": "37eb8408-08f0-3e2a-8e70-dcaa2cbf7404",
                        "glosses": [
                            "перен., разг. то же, что косорукий; неуклюжий, неумелый"
                        ],
                        "tags": [],
                        "examples": []
                    }
