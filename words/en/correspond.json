{
    "word_family": [
        "correspondence",
        "correspondent",
        "correspondingly",
        "corresponsive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1abab2cd-68c3-3ec6-ad63-bb301fc4ec02",
                    "sense_definition": "To be equivalent or similar in character, quantity, quality, origin, structure, or function.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The numbers on the map <w>correspond</w> to the descriptions provided in the legend.",
                            "target_lang_translations": {
                                "ru": "Цифры на карте <w>соответствуют</w> описаниям, приведенным в легенде."
                            }
                        },
                        {
                            "text": "Your actions do not always <w>correspond</w> with your words.",
                            "target_lang_translations": {
                                "ru": "Ваши действия не всегда <w>согласуются</w> с вашими словами."
                            }
                        }
                    ],
                    "synonyms": [
                        "match",
                        "agree",
                        "tally",
                        "correlate"
                    ],
                    "antonyms": [
                        "differ",
                        "clash",
                        "disagree"
                    ],
                    "common_phrases": [
                        "correspond to",
                        "correspond with",
                        "closely correspond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть эквивалентным или схожим по характеру, количеству, качеству, происхождению, структуре или функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть в соответствии с чем-либо"
                            },
                            {
                                "target_lang_word": "соотноситься",
                                "target_lang_sense_clarification": "находиться во взаимной связи или сравнении"
                            },
                            {
                                "target_lang_word": "согласовываться",
                                "target_lang_sense_clarification": "быть в нужном соотношении или согласии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cda26be-b1fe-34ef-b19d-4cc8b9828c7c",
                    "sense_definition": "To exchange messages, especially by postal letter or email, over a period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been <w>corresponding</w> with my German pen pal for three years.",
                            "target_lang_translations": {
                                "ru": "Я <w>переписываюсь</w> со своим немецким другом по переписке уже три года."
                            }
                        },
                        {
                            "text": "The two scientists began to <w>correspond</w> regularly to share their latest research findings.",
                            "target_lang_translations": {
                                "ru": "Двое ученых начали регулярно <w>переписываться</w>, чтобы делиться результатами своих последних исследований."
                            }
                        }
                    ],
                    "synonyms": [
                        "communicate",
                        "write"
                    ],
                    "common_phrases": [
                        "regularly correspond",
                        "correspond by email"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмениваться сообщениями, особенно обычными или электронными письмами, в течение некоторого времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переписываться",
                                "target_lang_sense_clarification": "обмениваться письмами"
                            },
                            {
                                "target_lang_word": "вести переписку",
                                "target_lang_sense_clarification": "поддерживать письменную связь"
                            },
                            {
                                "target_lang_word": "корреспондировать",
                                "target_lang_sense_clarification": "устаревшее или официальное: состоять в переписке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                    "sense_definition": "To have sexual intercourse with someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intimacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text suggested that the man had <w>corresponded</w> with several women during his travels.",
                            "target_lang_translations": {
                                "ru": "Исторический текст указывал на то, что этот человек <w>сожительствовал</w> с несколькими женщинами во время своих путешествий."
                            }
                        },
                        {
                            "text": "In some ancient literary contexts, the term was used to describe how couples would <w>correspond</w> privately.",
                            "target_lang_translations": {
                                "ru": "В некоторых древних литературных контекстах этот термин использовался для описания того, как пары тайно <w>вступали в связь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cohabit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common usage and is found primarily in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в половую связь с кем-либо (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сожительствовать",
                                "target_lang_sense_clarification": "находиться в интимной связи"
                            },
                            {
                                "target_lang_word": "иметь сношения",
                                "target_lang_sense_clarification": "устаревшее обозначение физической близости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}