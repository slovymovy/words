                "senses": [
                    {
                        "sense_id": "fc74616b-3741-3d5e-b697-5978435f37ac",
                        "entry_id": "e74707d8-2bf5-3954-9d59-4f2127572dbb",
                        "glosses": [
                            "Adopter une approche prophylactique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc880d0-72e1-4cb5-8c50-6e6561096b7f",
                                "sense_id": "fc74616b-3741-3d5e-b697-5978435f37ac",
                                "text": "Comme quoi, on a bien fait de te prophylactiser, tu vois, tu ne connaitras pas les aléas sinusiens !"
                            },
                            {
                                "example_id": "9156c21e-f0b4-4a79-9706-fbf21396b7d8",
                                "sense_id": "fc74616b-3741-3d5e-b697-5978435f37ac",
                                "text": "Guérir fut la médecine du passé ; prophylactiser doit être la médecine de l'avenir."
                            },
                            {
                                "example_id": "2765386f-b5af-4565-a7bb-c839031c3268",
                                "sense_id": "fc74616b-3741-3d5e-b697-5978435f37ac",
                                "text": "Prophylactiser, ou traiter, voire interner, car finalement c'est de cela qu'il s'agit."
                            }
                        ]
                    }
                ],
