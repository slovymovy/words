                "senses": [
                    {
                        "sense_id": "e34a797c-3a74-3289-9857-bbc7b4703b92",
                        "entry_id": "1a7bce01-6513-3528-b89c-b7de798692c1",
                        "glosses": [
                            "To process after other processing has been completed."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e16ec1b3-6aae-4864-8b5e-7be6aa7b39b6",
                                "sense_id": "e34a797c-3a74-3289-9857-bbc7b4703b92",
                                "text": "He's been postprocessing all morning. He hopes to finish today."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                        "entry_id": "1a7bce01-6513-3528-b89c-b7de798692c1",
                        "glosses": [
                            "To subject to postprocessing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "40f84c67-cd7a-4aff-8db2-ef60e3e95890",
                                "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                                "text": "He's been postprocessing the 3D-printed housing by doing certain grinding and polishing steps."
                            },
                            {
                                "example_id": "d7a00991-9402-4872-9157-a278844e0f93",
                                "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                                "text": "She has to postprocess the CAD/CAM file, to prepare it for the relevant machine, before she can post it."
                            },
                            {
                                "example_id": "7cf1999d-9d2c-4c16-96e4-d967215b15b9",
                                "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                                "text": "We postprocess three-dimensional GRMHD models of a jet-producing radiatively inefficient accretion flow around a spinning black hole using relativistic radiative transfer and ray-tracing to produce model spectra and images."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "464ff500-b946-4b76-8b6c-1c616582ef41",
                        "source_entry_id": "1a7bce01-6513-3528-b89c-b7de798692c1",
                        "source_sense_description": "to process after other processes have been completed",
                        "target_lang_word": "postprocesar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2e66e5b7-cd48-4298-a99e-ca6c8e1bff3e",
                        "source_entry_id": "1a7bce01-6513-3528-b89c-b7de798692c1",
                        "source_sense_description": "to process after other processes have been completed",
                        "target_lang_word": "hậu xử lý",
                        "target_lang_code": "vi",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hậu xử lý",
                                "target_lang_code": "vi",
                                "target_senses": [
                                    {
                                        "sense_id": "374d7457-2f4e-3bc7-8ad9-386cfbc894dc",
                                        "entry_id": "52167613-74f5-39a9-a178-dd993d49ffb4",
                                        "glosses": [
                                            "Thực hiện việc xử lý ở giai đoạn sau (của một quy trình, hệ thống, dữ liệu, v.v.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd3617a-2ae0-4501-beb2-fc9c57c60eb7",
                                                "sense_id": "374d7457-2f4e-3bc7-8ad9-386cfbc894dc",
                                                "text": "Đã có rất nhiều ý kiến về việc hậu xử lý linh vật ngoại lai như đập bỏ, chôn, vứt xuống sông…"
                                            },
                                            {
                                                "example_id": "881e7f1c-778a-4cb7-8398-e723d0bfa072",
                                                "sense_id": "374d7457-2f4e-3bc7-8ad9-386cfbc894dc",
                                                "text": "Thay vì dùng một bộ điều khiển mờ 729 luật phức tạp được xây dựng bởi kinh nghiệm chuyên gia, chúng tôi sử dụng một cấu trúc mờ đơn giản hơn. Thông qua giải thuật di truyền, các thông số tiền xử lý và hậu xử lí của bộ điều khiển mờ được chọn."
                                            },
                                            {
                                                "example_id": "f17eee12-8c4b-4d21-bcc0-fe50938e206f",
                                                "sense_id": "374d7457-2f4e-3bc7-8ad9-386cfbc894dc",
                                                "text": "Đầu tiên là vấn đề an ninh trật tự xã hội ổn đinh; chi phí hậu xử lý cho vấn đề môi trường rất lớn so với việc ngăn chặn ngay từ đầu; lợi ích xã hội về GDP, đó là người dân không phải bỏ ra những khoản tiền để khi khám chữa bệnh - những khoản phí không nhìn thấy được."
                                            },
                                            {
                                                "example_id": "82a21dc3-e844-41ce-8036-1d2d78787757",
                                                "sense_id": "374d7457-2f4e-3bc7-8ad9-386cfbc894dc",
                                                "text": "“NVIDIA liên hệ với chúng tôi khoảng 1,5 năm trước vì GPU chỉ hữu ích khi có dữ liệu liên tục ‘nuôi’ chúng”, Tso nói. “Giờ mọi người nhận ra dễ đưa AI đến dữ liệu hơn là di chuyển khối dữ liệu khổng lồ. Hệ thống lưu trữ của chúng tôi tích hợp nhiều chức năng AI, nên có thể tiền xử lý và hậu xử lý dữ liệu gần nơi chúng tôi thu thập và lưu trữ”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
