{
    "word_family": [
        "character",
        "characteristic",
        "characterization",
        "characterless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "100ee559-7818-3e24-aa84-7b3e952ca955",
                    "sense_definition": "To be a typical or distinguishing feature of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "define_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rolling hills and green pastures <w>characterize</w> the countryside in this region.",
                            "target_lang_translations": {
                                "ru": "Пологие холмы и зеленые пастбища <w>характеризуют</w> сельскую местность в этом регионе."
                            }
                        },
                        {
                            "text": "A lack of communication often <w>characterizes</w> a failing relationship.",
                            "target_lang_translations": {
                                "ru": "Отсутствие общения часто <w>свойственно</w> распадающимся отношениям."
                            }
                        }
                    ],
                    "synonyms": [
                        "distinguish",
                        "feature",
                        "mark",
                        "typify"
                    ],
                    "common_phrases": [
                        "characterize the era",
                        "characterize the style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть типичной или отличительной чертой чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "характеризовать",
                                "target_lang_sense_clarification": "быть характерным для чего-либо"
                            },
                            {
                                "target_lang_word": "отличать",
                                "target_lang_sense_clarification": "выделять среди других"
                            },
                            {
                                "target_lang_word": "быть свойственным",
                                "target_lang_sense_clarification": "являться типичным признаком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "246ea1c9-36cc-35ce-9cfc-7bcbde382dbf",
                    "sense_definition": "To describe or depict someone or something in a particular way, often using specific qualities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "describe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media often <w>characterize</w> the politician as being out of touch with regular people.",
                            "target_lang_translations": {
                                "ru": "СМИ часто <w>характеризуют</w> этого политика как человека, оторванного от простых людей."
                            }
                        },
                        {
                            "text": "Critics <w>characterize</w> the new law as a threat to personal privacy.",
                            "target_lang_translations": {
                                "ru": "Критики <w>описывают</w> новый закон как угрозу неприкосновенности частной жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "depict",
                        "describe",
                        "portray",
                        "represent"
                    ],
                    "common_phrases": [
                        "characterize as",
                        "accurately characterize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывать или изображать кого-либо или что-либо определенным образом, часто используя специфические качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "характеризовать",
                                "target_lang_sense_clarification": "давать описание черт"
                            },
                            {
                                "target_lang_word": "охарактеризовать",
                                "target_lang_sense_clarification": "дать оценку или описание"
                            },
                            {
                                "target_lang_word": "описывать",
                                "target_lang_sense_clarification": "представлять в словах"
                            },
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "представлять в определенном свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6ccb9f4-3019-371a-8757-bcaec2439401",
                    "sense_definition": "To determine or analyze the specific qualities or properties of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "define_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists need to <w>characterize</w> the chemical composition of the soil before planting.",
                            "target_lang_translations": {
                                "ru": "Ученым необходимо <w>определить</w> химический состав почвы перед посадкой."
                            }
                        },
                        {
                            "text": "The study aims to <w>characterize</w> the physical properties of the new alloy.",
                            "target_lang_translations": {
                                "ru": "Исследование направлено на то, чтобы <w>проанализировать</w> физические свойства нового сплава."
                            }
                        }
                    ],
                    "synonyms": [
                        "analyze",
                        "identify",
                        "define"
                    ],
                    "common_phrases": [
                        "characterize the properties",
                        "fully characterize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять или анализировать специфические качества или свойства чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "устанавливать параметры или свойства"
                            },
                            {
                                "target_lang_word": "анализировать",
                                "target_lang_sense_clarification": "изучать состав или структуру"
                            },
                            {
                                "target_lang_word": "характеризовать",
                                "target_lang_sense_clarification": "описывать физические или химические свойства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}