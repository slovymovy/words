                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e3673e7-e118-4f72-9c69-03d9c0657c46",
                                "sense_id": "75bfbb7f-d4a0-3f83-9ec0-5978d1150e86",
                                "text": "„Als Verwoerd Premierminister wurde, meldete sich ein ehemaliger Mitschüler aus Brandfort zu Wort, der daran erinnerte, wie sie beide 1917 fieberhaft auf die Ergebnisse einer Nachwahl in Calvinia warteten, ‚wo Dr. Malan gegen Senator Conroy antrat und mit 80 Stimmen verlor‘.“"
                            },
                            {
                                "example_id": "7ed47191-afa4-46d1-889f-105314327755",
                                "sense_id": "75bfbb7f-d4a0-3f83-9ec0-5978d1150e86",
                                "text": "„Vor zwei Jahren unterrichtete Gugu in Brandfort, als unser Präsident zu den Winnie-Mandela-Feiern kam.“"
                            }
                        ],
