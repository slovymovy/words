                    }
                ],
                "senses": [
                    {
                        "sense_id": "c72af069-2617-3adf-85f6-668140bc1c5d",
                        "entry_id": "33362b53-88ea-34b5-b47e-ffed51c1b054",
                        "glosses": [
                            "геогр. горизонтальная или слегка наклонная площадка на склоне местности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa783d9-6f1e-46ae-8112-7d3437a6a9c8",
                                "sense_id": "c72af069-2617-3adf-85f6-668140bc1c5d",
                                "text": "Вся обширная терраса левого берега залива, на которой расположен город, замыкается полуокружием гор, вернее, сплошной цепью высоких (до 200 м) холмов."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bec4869-ef70-3f6d-8f49-8b46389063f2",
                        "entry_id": "33362b53-88ea-34b5-b47e-ffed51c1b054",
                        "glosses": [
                            "архит. пристройка к дому — открытая или застеклённая площадка с крышей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851f8287-b561-48cd-8786-b6947de73818",
                                "sense_id": "3bec4869-ef70-3f6d-8f49-8b46389063f2",
                                "text": "Всего два-три вазона с цветами способны превратить балкон или террасу в цветущий сад."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "941574dd-45e7-45c5-9e14-0b85ea2e6a3c",
                        "source_entry_id": "33362b53-88ea-34b5-b47e-ffed51c1b054",
                        "target_lang_word": "terrace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3935618-25b9-3356-a3f6-926f32bc446b",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A flat open area on the topmost floor of a building or apartment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead19f5c-2917-49eb-99ad-ea5f48f5b0b0",
                                                "sense_id": "a3935618-25b9-3356-a3f6-926f32bc446b",
                                                "text": "On a broad ledge near the top, we found a stone cabin. Higher up was a cistern and a few more terraces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd5faca-3c46-31ee-ab61-74c4d5bca25a",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A platform that extends outwards from a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40caf7e-a6a8-4686-b837-ca229bb8e36d",
                                                "sense_id": "1fd5faca-3c46-31ee-ab61-74c4d5bca25a",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf08f78-4f86-3638-a9b5-b74dfc039ae6",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A raised, flat-topped bank of earth with sloping sides, especially one of a series for farming or leisure; a similar natural area of ground, often next to a river."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba2e6b7-3eda-4157-83e1-2aafdfa20917",
                                                "sense_id": "7cf08f78-4f86-3638-a9b5-b74dfc039ae6",
                                                "text": "All the buildings were well kept and there were terraces everywhere, most of them full of growing things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b12fa5b-d001-3afd-853d-f2f5d8f64031",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A step-like landform; (sometimes) remnants of floodplains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9a1d275-90c8-34bf-a50b-6d4a1c696455",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A row of residential houses with no gaps between them; a group of row houses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f38006ca-9249-31cc-a398-08200a6b9a15",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A street with such a group of houses in it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6819c28-bf7d-3b30-b9ab-9490158c6383",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A single house in such a group."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f9e0a9-84d7-4ecb-b105-94d6e1a0f968",
                                                "sense_id": "f6819c28-bf7d-3b30-b9ab-9490158c6383",
                                                "text": "The cameraman's pace slowed down as he approached what his mind said was where Sian lived. Like all the other houses in the street, it was a Victorian terrace with a postage stamp of an overgrown garden between its front wall and the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7312dca0-0758-3c58-9423-08a2b7b06e6f",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "The standing area of a sports stadium."
                                        ],
                                        "tags": [
                                            "British",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3047ccaa-9839-3981-931e-42bcee55bd99",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "The roof of a building, especially if accessible to the residents. Often used for drying laundry, sun-drying foodstuffs, exercise, or sleeping outdoors in hot weather."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cedbf1fe-e4ec-30e1-b8bb-08284f1a8d56",
                                        "entry_id": "e10a37c8-d47d-37a1-9b4f-2a13ae2b7007",
                                        "glosses": [
                                            "A champagne, (an ordinary occupying) the base of the shield."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52655dc4-62b0-45b4-800b-19661cc666ee",
                                                "sense_id": "cedbf1fe-e4ec-30e1-b8bb-08284f1a8d56",
                                                "text": "VAN GENNEP uses, Or, on a terrace vert a tulip gules, slipped proper and crowned of the first; LOKE in Zealand has : Argent , on a terrace vert a tulip or, slipped and leaved proper."
                                            },
                                            {
                                                "example_id": "261eb31f-7525-4aad-ae04-e514b0916d30",
                                                "sense_id": "cedbf1fe-e4ec-30e1-b8bb-08284f1a8d56",
                                                "text": "The whole upon a terrace gules. CREST : A coronet of nobility of five pearls. MOTTO : Omnia Pro Libertate."
                                            },
                                            {
                                                "example_id": "0ab4ac99-5eb1-480e-a3b0-944e32759b5b",
                                                "sense_id": "cedbf1fe-e4ec-30e1-b8bb-08284f1a8d56",
                                                "text": "267); \"Argent, on a terrace vert, a cannon mounted or, supporting a Bird of Paradise proper\" [Rjevski and Yeropkin];"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "terrace",
                                "target_lang_code": "en",
