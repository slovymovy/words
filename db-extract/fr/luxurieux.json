                        "form_id": "1e844bd4-57f2-48ee-b8cf-24786ee76747",
                        "entry_id": "457125ef-a7e9-3048-84eb-6e9e63479e34",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "luxurieuses"
