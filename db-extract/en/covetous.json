                    },
                    {
                        "translation_id": "1ea56c22-2241-4bc6-8c56-6b0e3c9dd751",
                        "source_entry_id": "058274e1-f955-380c-9ded-b4986bee671d",
                        "source_sense_id": "2851d50a-ba6e-3e78-b1b1-431205284a24",
                        "source_sense_description": "Inordinately desirous; excessively eager to obtain and possess (especially money); avaricious",
                        "target_lang_word": "prahnoucí",
