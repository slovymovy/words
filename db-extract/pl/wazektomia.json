                    {
                        "sense_id": "8218462d-8838-3d3a-aaa4-3d762e265784",
                        "entry_id": "0d8f916f-521d-36e6-9431-b249bcec4966",
                        "glosses": [
                            "zabieg urologiczny przeprowadzany u mężczyzn w celu trwałego pozbawienia ich płodności, polegający na przecięciu nasieniowodu (nasieniowodów)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b84e790-528e-4784-8292-eebb27c86540",
                                "sense_id": "8218462d-8838-3d3a-aaa4-3d762e265784",
                                "text": "Adam nie chce mieć już więcej dzieci, więc postanowił poddać się wazektomii."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5348ce2e-1647-417c-971a-228317e14190",
                        "source_entry_id": "0d8f916f-521d-36e6-9431-b249bcec4966",
                        "source_sense_id": "8218462d-8838-3d3a-aaa4-3d762e265784",
                        "target_lang_word": "vasectomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vasectomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c96a3ce-de84-385a-bdb5-3621d333060f",
                                        "entry_id": "11698acf-69b5-3779-a215-f7d74ad8563b",
                                        "glosses": [
                                            "The surgical incision of all or part of the vas deferens as a means of male sterilization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6659f613-2e1f-41b0-8321-1fd184cb9db9",
                                                "sense_id": "7c96a3ce-de84-385a-bdb5-3621d333060f",
                                                "text": "The experimental vasectomy operation was performed under sodium pentobarbital (50 mg/kg body weight, i.p) anesthesia via a lower midabdominal incision as described elsewhere."
                                            },
                                            {
                                                "example_id": "56b631bc-3c79-4445-a851-111f124ac0af",
                                                "sense_id": "7c96a3ce-de84-385a-bdb5-3621d333060f",
                                                "text": "In fact, at the Mayo Clinic in Rochester, Minn., so many men sign up for vasectomies during March Madness that appointments reach “max capacity,” said Dr. Tobias S. Kohler, a urologist and men’s health expert at the medical center who has observed this phenomenon ever since he was an attending physician a decade ago."
                                            },
                                            {
                                                "example_id": "86c088af-3a76-4a09-9cf8-e58f1c73fe3d",
                                                "sense_id": "7c96a3ce-de84-385a-bdb5-3621d333060f",
                                                "text": "Middle-aged, married fathers make up the bulk of those who have gotten vasectomies, with less than two percent of unmarried men relying on vasectomy for contraception, according to one analysis of data between 2002 and 2015 by the Department of Health and Human Services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
