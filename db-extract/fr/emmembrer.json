                ],
                "senses": [
                    {
                        "sense_id": "c0d7cffa-1594-34fb-ac17-4a61a543a7c5",
                        "entry_id": "e6a2d992-3b08-3e3a-af5b-b6dde14832c7",
                        "glosses": [
                            "Donner des membres, une armature, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcf7ed0-6964-4375-b2b6-d6424388ef90",
                                "sense_id": "c0d7cffa-1594-34fb-ac17-4a61a543a7c5",
                                "text": "Parmi ces utopies, il y a une utopie d’un nouveau développement, qui reprend toute une tradition d’utopies écrites pour l’emmembrer dans des utopies pratiquées."
                            },
                            {
                                "example_id": "d0581b26-513f-4f2f-9d5f-009caafb1aa1",
                                "sense_id": "c0d7cffa-1594-34fb-ac17-4a61a543a7c5",
                                "text": "Selon la formule audacieuse de Marie-Dominique Chenu, « la foi doit s'emmembrer de raison »."
                            },
                            {
                                "example_id": "02ba0743-8cbe-4600-b2bb-af915f179ed1",
                                "sense_id": "c0d7cffa-1594-34fb-ac17-4a61a543a7c5",
                                "text": "Une autre force peut s'emmembrer et surgir, façonnée par une volonté tenace de maintenir les valeurs spirituelles et matérielles d'un peuple."
                            }
                        ]
                    }
