                "senses": [
                    {
                        "sense_id": "deec6b03-a1d9-32e4-beab-83a1504cfae3",
                        "entry_id": "8c898c89-aa6e-3f59-90eb-78db48e00497",
                        "glosses": [
                            "niewielka restauracja, winiarnia, bar z zakąskami i napojami alkoholowymi"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "9ba6156f-8707-4f49-8cd6-47096c841461",
                                "sense_id": "deec6b03-a1d9-32e4-beab-83a1504cfae3",
                                "text": "Wciąż wspominam to bistro na Montmartre i jego niepowtarzalną atmosferę."
                            },
                            {
                                "example_id": "def2055a-da17-4b8d-8b15-a41d27a7606f",
                                "sense_id": "deec6b03-a1d9-32e4-beab-83a1504cfae3",
                                "text": "Gdzieś w Paryżu mieście jest małe, nocne bistro • Gdzie z napojów pija się tylko wódkę czystą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f06452d-41f3-4fc3-b7b4-f86a3ab78abc",
                        "source_entry_id": "8c898c89-aa6e-3f59-90eb-78db48e00497",
                        "source_sense_id": "deec6b03-a1d9-32e4-beab-83a1504cfae3",
                        "target_lang_word": "bistro",
