                    {
                        "translation_id": "3918ed42-3a09-49f8-8394-34562728306e",
                        "source_entry_id": "a8838493-dab9-3f7a-b5d2-b2d6f1e7e12e",
                        "source_sense_id": "cd6282fb-aa72-36fc-ab7c-e6a1a5c65295",
                        "target_lang_word": "Insektenkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insektenkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1841d719-5d52-34ec-8321-483ce2870dd7",
                                        "entry_id": "0a89d704-1254-3c19-a295-bfc73e8c7b6e",
                                        "glosses": [
                                            "Zweig der Zoologie, der sich mit den Insekten beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54770db9-f4ce-494b-a010-3fc0406cb783",
                                                "sense_id": "1841d719-5d52-34ec-8321-483ce2870dd7",
                                                "text": "Ich kann Ihnen nur empfehlen, sich mit Insektenkunde zu beschäftigen."
                                            },
                                            {
                                                "example_id": "c6059a21-446a-4a7b-b519-f85df282f9b1",
                                                "sense_id": "1841d719-5d52-34ec-8321-483ce2870dd7",
                                                "text": "Ziele des Sommerlager Insektenkunde sind das Kennenlernen und das Wiedererkennen von Arten."
                                            },
                                            {
                                                "example_id": "8edd800c-e8ed-4599-8c52-b7803a3f9c72",
                                                "sense_id": "1841d719-5d52-34ec-8321-483ce2870dd7",
                                                "text": "„Aber die Aneinanderreihung einer möglichst großen Zahl an Details ist auch gar kein sinnvoller Weg, eine wissenschaftliche Disziplin wie die Insektenkunde zu erschließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36095890-c4de-4407-9ed3-28360961bda2",
                        "source_entry_id": "a8838493-dab9-3f7a-b5d2-b2d6f1e7e12e",
                        "source_sense_id": "cd6282fb-aa72-36fc-ab7c-e6a1a5c65295",
                        "target_lang_word": "entomology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entomology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb0aa43-2ffc-319f-93c7-6054f77f5d99",
                                        "entry_id": "78df7ae6-52d2-3a5d-89f4-eebf2ead56f9",
                                        "glosses": [
                                            "The scientific study of insects, and (informal) of other arthropods (and occasionally other invertebrates)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6895ed0-1c7e-4b0e-ba90-9a512b888aa6",
                                                "sense_id": "9bb0aa43-2ffc-319f-93c7-6054f77f5d99",
                                                "text": "Entomology is an important field of study within biology."
                                            },
                                            {
                                                "example_id": "66603b56-c2d5-42f2-843e-4b95c821b7d7",
                                                "sense_id": "9bb0aa43-2ffc-319f-93c7-6054f77f5d99",
                                                "text": "“This suggests that most of the foraging that the bees do occurs very close to the hive,” study co-author Margarita López-Uribe, an associate professor of entomology at PSU, told CNN on Monday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efb7ba37-2107-4347-afa6-13a19e16e00d",
                        "source_entry_id": "a8838493-dab9-3f7a-b5d2-b2d6f1e7e12e",
                        "source_sense_id": "cd6282fb-aa72-36fc-ab7c-e6a1a5c65295",
                        "target_lang_word": "entomologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entomologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27178d84-4845-33ab-90f4-f9f0e759ac68",
                                        "entry_id": "5642f78d-f3c1-3e96-96b6-6cac39694144",
                                        "glosses": [
                                            "Branche de la zoologie consacrée à l’étude des insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d637dd-32fe-4093-a702-a480d29402fa",
                                                "sense_id": "27178d84-4845-33ab-90f4-f9f0e759ac68",
                                                "text": "Mon département a eu l’honneur de donner naissance au père de l’Entomologie ; l’illustre Latreille."
                                            },
                                            {
                                                "example_id": "743ffa8c-d54c-4b41-b170-9d050c5b792c",
                                                "sense_id": "27178d84-4845-33ab-90f4-f9f0e759ac68",
                                                "text": "Bien d’autres faits extrêmement intéressants mériteraient d’être exposés, mais nous ne pouvons ici qu’engager le lecteur à en suivre la description dans des traités d’entomologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "095d2b14-18b8-31a1-915f-bce9e12df337",
                                        "entry_id": "5642f78d-f3c1-3e96-96b6-6cac39694144",
                                        "glosses": [
                                            "Ouvrage traitant de cette science."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186e12a9-eb77-4c35-aa26-d1b9f51cf7fb",
                                                "sense_id": "095d2b14-18b8-31a1-915f-bce9e12df337",
                                                "text": "Et pour finir, croyez-vous qu’on écrive des entomologies pour le plaisir de décrire des mouches dédaignées du poisson ?"
                                            },
                                            {
                                                "example_id": "9d70f075-7606-48a3-8051-2227248250d6",
                                                "sense_id": "095d2b14-18b8-31a1-915f-bce9e12df337",
                                                "text": "Le voici se lancer dans une charge à fond contre « les hautes théories » ; quelques lignes de l’introduction à l’entomologie de Lacordaire lui servent de tremplin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4123633f-cb86-3c64-92c7-d623d15d7e89",
                                        "entry_id": "5642f78d-f3c1-3e96-96b6-6cac39694144",
                                        "glosses": [
                                            "Répertoire plus ou mois exhaustif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee87c2a9-8abd-43b9-8d07-817bb9e2f76f",
                                                "sense_id": "4123633f-cb86-3c64-92c7-d623d15d7e89",
                                                "text": "Médecins progressistes et rationalistes, politiciens radicaux-socialistes anticléricaux (généralement dépeints en gros paysans avares), écrivains et religieux modernistes dressent une entomologie de la France sous la Troisième République."
                                            },
                                            {
                                                "example_id": "82f356c9-df7b-41c4-8d69-946b2a4bd0ba",
                                                "sense_id": "4123633f-cb86-3c64-92c7-d623d15d7e89",
                                                "text": "« Je cherche dans le costume des éléments qui vont, en quelque sorte, modifier le corps humain. Donc celui du danseur » ; regroupés thématiquement, les excroissances, motifs et formes géométriques donnent une entomologie des obsessions qui guident les créations de l'ancien élève de Merce Cunningham."
                                            },
                                            {
                                                "example_id": "c341d32c-7661-4a52-b057-5c7f5871dda3",
                                                "sense_id": "4123633f-cb86-3c64-92c7-d623d15d7e89",
                                                "text": "Sur le plan idéologique, ces groupuscules sont de sensibilités diverses. Si l’on devait en faire une entomologie, on trouverait des catholiques traditionalistes, des néopaïens, des néofascistes et des nationalistes réactionnaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
