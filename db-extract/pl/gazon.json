                        "glosses": [
                            "ozdobny trawnik w kształcie prostokąta, koła lub owalu znajdujący się na podjeździe do pałacu lub dworu, otoczony wokół drogą dojazdową kończącą się bezpośrednio przed wejściem do rezydencji"
                        ],
                        "tags": [],
