                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb729ee-f79e-4a34-a59e-cadec360d665",
                                "sense_id": "e053e83a-e4c1-34a2-9933-f8e900e5a961",
                                "text": "An der Außenfläche des Knochens sind Schabspuren zu erkennen."
                            },
                            {
                                "example_id": "48b1efa5-cc47-48c3-811b-14b0ad69bfd8",
                                "sense_id": "e053e83a-e4c1-34a2-9933-f8e900e5a961",
                                "text": "Die Außenflächen sind wasserabweisend gestaltet."
                            },
                            {
                                "example_id": "762f6cff-747c-4cb1-bde7-ac2deaaafd38",
                                "sense_id": "e053e83a-e4c1-34a2-9933-f8e900e5a961",
                                "text": "„Archäologen gehen davon aus, dass in der ersten Hälfte des 6. Jahrhunderts auf der Außenfläche rund 500 Haushalte sesshaft waren.“"
