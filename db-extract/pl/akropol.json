                        "glosses": [
                            "w starożytnej Grecji: osiedle, część miasta znajdująca się na wzgórzu, górne miasto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f19d91f-58b5-41b2-ad03-43acfcb69413",
                                "sense_id": "2c8df5f9-7922-336e-b1ba-a0c91dbba528",
                                "text": "Od ponad roku mieszkam w Atenach, w mieszkaniu z widokiem na akropol."
