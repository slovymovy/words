                ],
                "senses": [
                    {
                        "sense_id": "dae80bd2-2bfa-37f7-a599-59216764b236",
                        "entry_id": "da860814-21d2-3c54-a122-1caa5cb34f01",
                        "glosses": [
                            "Unterschrift auf einem leeren Blatt oder in einem unausgefüllten Formular"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead5104e-1687-40e9-a813-d0a062676d64",
                                "sense_id": "dae80bd2-2bfa-37f7-a599-59216764b236",
                                "text": "Während bei einer nachträglich geleisteten Unterschrift dem VN hätte auffallen können, dass die Angaben im Formular nicht mit dem mündlich Erklärten übereinstimmen, scheidet dies bei einer Blankounterschrift aus."
                            },
                            {
                                "example_id": "06a4db3b-a694-4f35-b640-77fd2ec582af",
                                "sense_id": "dae80bd2-2bfa-37f7-a599-59216764b236",
                                "text": "„Vor dem Abflug brachte sie ihren Freund dazu, ihr eine Generalvollmacht über sein Vermögen, Blankounterschriften, die Schlüssel für sein Auto und den Tresor in der Villa samt Zahlenkombinationen zu überlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
