{
    "word_family": [
        "deteriorate",
        "deterioration"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c99ae35e-a1f4-347b-8e65-3dadcdd4bcf0",
                    "sense_definition": "Becoming progressively worse in quality, condition, or value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>deteriorating</w> weather conditions forced the rescue team to postpone their mission until the next morning.",
                            "target_lang_translations": {
                                "zh": "<w>恶化的</w>天气状况迫使救援队将任务推迟到第二天早上。"
                            }
                        },
                        {
                            "text": "Doctors are concerned about his <w>deteriorating</w> health after he failed to follow the prescribed treatment plan.",
                            "target_lang_translations": {
                                "zh": "由于他没有遵循规定的治疗方案，医生们对他的<w>衰退的</w>健康状况感到担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "worsen"
                    ],
                    "antonyms": [
                        "improving"
                    ],
                    "common_phrases": [
                        "deteriorating condition",
                        "deteriorating health"
                    ],
                    "target_lang_definitions": {
                        "zh": "指质量、状况或价值逐渐变差。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恶化的",
                                "target_lang_sense_clarification": "形容事物或状况变得更糟。"
                            },
                            {
                                "target_lang_word": "衰退的",
                                "target_lang_sense_clarification": "形容健康或状态逐渐下降。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26cf8874-4b0a-3328-89ef-a51910725d7c",
                    "sense_definition": "Present participle and gerund of <w>deteriorate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The situation is <w>deteriorating</w> rapidly as the conflict between the two nations continues to escalate.",
                            "target_lang_translations": {
                                "zh": "随着两国冲突的不断升级，局势正在迅速<w>恶化</w>。"
                            }
                        },
                        {
                            "text": "By <w>deteriorating</w> the quality of the materials, the company managed to reduce its production costs significantly.",
                            "target_lang_translations": {
                                "zh": "通过<w>降低</w>材料质量，该公司成功地大幅降低了生产成本。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指变得越来越糟的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恶化",
                                "target_lang_sense_clarification": "指局势或状况变坏。"
                            },
                            {
                                "target_lang_word": "变差",
                                "target_lang_sense_clarification": "指质量或水平下降。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}