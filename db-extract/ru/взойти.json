                        "glosses": [
                            "to mount, to go up, to climb, to ascend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ebeb8a-44de-412d-a6fe-140e520dd5c2",
                                "sense_id": "3a6c45ba-204c-3f1a-8e27-d17d27dc5196",
                                "text": "Да, чудеса́… и ду́мал ли ты, Мни́шек,\nЧто мой слуга́ взойдё́т на трон моско́вский?",
                                "translation": "Yes, it’s a wonder…and you, Mnishek,\nDid you think my servant would mount the Moscow throne?",
                                "english": "Yes, it’s a wonder…and you, Mnishek,\nDid you think my servant would mount the Moscow throne?"
                            }
                        ]
                    },
