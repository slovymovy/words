                                "target_senses": [
                                    {
                                        "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                        "entry_id": "b2533370-9b3a-35eb-b3a0-9416009cf773",
                                        "glosses": [
                                            "de feestelijke of plechtige inwijding in een ambt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5594eaf3-6c4a-453d-91b9-4d68e4be3a06",
                                                "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                                "text": "De inauguratie van Barack Obama verliep zonder problemen."
                                            },
                                            {
                                                "example_id": "d4d351e9-e6e8-4e1d-b506-ea389bb3b1d1",
                                                "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                                "text": "Honderdduizenden mensen wereldwijd demonstreren zaterdag tegen ongelijkheid en intolerantie naar aanleiding van de inauguratie van de Amerikaanse president Donald Trump"
                                            },
                                            {
                                                "example_id": "a5c19e1c-21b8-44b2-ab09-bc37ef683fe3",
                                                "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                                "text": "De controversiële betrokkenheid van Musk bij de regering van Trump, de openlijke steun van de techmiljardair aan de extreemrechtse partij AfD in Duitsland en een vermeende Hitlergroet van Musk na de inauguratie van Trump, hebben veel Tesla-eigenaren in verlegenheid gebracht"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb7dd945-7851-43a7-8fc6-09b26e1d0d06",
                        "source_entry_id": "99a5b8fc-64eb-36ad-808d-3cbda469514c",
                        "source_sense_id": "1d81488a-e427-3441-8fb2-a1a4edb78bd9",
                        "target_lang_word": "inauguration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inauguration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13b97f1a-b21f-31b8-ab4f-4e4724355da4",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Action d’inaugurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0843dd4b-9bc5-4150-894a-e513a67fbf10",
                                                "sense_id": "13b97f1a-b21f-31b8-ab4f-4e4724355da4",
                                                "text": "Nous avons mentionné sommairement, hier, l’inauguration du monument élevé à Mézières-sous-Bellegarde, par l'initiative de la municipalité et avec le concours du Souvenir français, à la mémoire des combattants des 24 et 30 novembre 1870."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4735f5b5-9ba4-3c67-9f1a-370badc2741a",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Sacre ; couronnement d'un souverain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35de9b58-d85a-4715-b804-252d2ca27a6b",
                                                "sense_id": "4735f5b5-9ba4-3c67-9f1a-370badc2741a",
                                                "text": "Chaque année, les chanoinesses élisaient entre elles la bâtonnière, dont les fonctions consistaient à porter les insignes du chapitre noble, dans les processions générales et à l’inauguration du souverain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a429f6f6-52bb-3b82-9511-f3cf9bb01cc5",
                                        "entry_id": "db2b55a9-d324-3b31-8955-7f525a8470d8",
                                        "glosses": [
                                            "Intronisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df771f94-edf0-4686-89e9-fc0db1d5e301",
                                                "sense_id": "a429f6f6-52bb-3b82-9511-f3cf9bb01cc5",
                                                "text": "Comme approchait le jour de l'inauguration du nouveau président, le désordre, la crainte et la misère étendaient leur empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
