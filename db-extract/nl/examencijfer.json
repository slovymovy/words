                        "glosses": [
                            "getal dat aangeeft hoe goed men een examen heeft gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce78dcd4-63b7-4bd5-8a67-2ff4ab225e4d",
                                "sense_id": "d034d6a4-d94e-3738-aa58-452e5e3435f2",
                                "text": "Dit jaar zijn meer leerlingen geslaagd voor hun eindexamens dan in de jaren voor corona. Bij de meeste scholen ligt het slagingspercentage van afgelopen jaar zo'n 2 tot 6 procentpunten hoger dan in de pre-coronajaren, waarschijnlijk door een extra herkansing en de mogelijkheid om het examencijfer van één vak te laten vallen."
                            },
                            {
                                "example_id": "878a8055-48b5-46a6-8c58-efa72ed16ecb",
                                "sense_id": "d034d6a4-d94e-3738-aa58-452e5e3435f2",
                                "text": "Als scholen meer zelf de kwalificatie-eisen mogen gaan bepalen, kunnen ze bijvoorbeeld ook de 'keuzedelen' uit de mbo-opleiding laten meetellen voor het examen. Keuzedelen zijn 'verdiepende' onderdelen van de opleiding. Studenten zijn wel verplicht de keuzedelen te volgen, maar die tellen nu nog niet mee voor het examencijfer."
                            }
                        ]
                    }
