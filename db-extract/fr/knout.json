                                        "glosses": [
                                            "tlustý kožený bič používaný k mučení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35168ab-8edf-44ea-983c-84d1945eda06",
                                                "sense_id": "63ee793c-cee7-358a-9ed7-566baf9ee1cd",
                                                "text": "Byl jim vyměřen strašný trest: tisíc pět set ran knutou."
                                            },
                                            {
                                                "example_id": "c02b2f44-f452-4af9-b6a2-ac3a6afc4adc",
                                                "sense_id": "63ee793c-cee7-358a-9ed7-566baf9ee1cd",
                                                "text": "Bití knutou sloužilo k vynucení přiznání při výslechu nebo jako těžší trest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c5f8c96-f105-3111-93ed-03ebaf34f358",
                                        "entry_id": "70909541-a9ea-34d2-b03a-4282deb10871",
                                        "glosses": [
                                            "nesvoboda, útlak, útisk"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971c37bb-5a20-4c2a-9598-7e8bf6a745a2",
                                                "sense_id": "9c5f8c96-f105-3111-93ed-03ebaf34f358",
                                                "text": "Uprchlíci podávali svědectví o utrpení pod knutou diktátora."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
