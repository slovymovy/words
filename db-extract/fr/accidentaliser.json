                "senses": [
                    {
                        "sense_id": "ecdf55bc-d130-3965-90fd-bf49d1881834",
                        "entry_id": "9ab36c1b-f411-3e84-9ead-cc308c7677ff",
                        "glosses": [
                            "Donner ou attribuer un caractère accidentel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47729466-bb90-4dc4-bc77-124f7bb5f599",
                                "sense_id": "ecdf55bc-d130-3965-90fd-bf49d1881834",
                                "text": "Philosopher « à coups de marteau », c’est accidentaliser la façade ontologique illusoire de l’existant : briser, casser, fragmenter, éclater, partialiser, différentialiser, démembrer, lézarder."
                            },
                            {
                                "example_id": "88b375d0-0a35-408c-94f6-e5705157b9e8",
                                "sense_id": "ecdf55bc-d130-3965-90fd-bf49d1881834",
                                "text": "Au lieu de se découvrir noire absolument, elle va accidentaliser ce fait."
                            }
                        ]
                    }
