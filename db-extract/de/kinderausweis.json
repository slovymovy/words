                "senses": [
                    {
                        "sense_id": "9fd70b34-3fb8-31ed-a642-d30019e9372f",
                        "entry_id": "9e3b86ef-a9b9-3c8c-94ad-29450e5408f2",
                        "glosses": [
                            "Ausweis für Kinder, vor allem als Ersatz für einen Reisepass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80bc6f7d-d6c1-45d3-b86c-89c881b78e1d",
                                "sense_id": "9fd70b34-3fb8-31ed-a642-d30019e9372f",
                                "text": "In viele europäische Länder brauchten Kinder für die Einreise nur einen gültigen Kinderausweis."
                            },
                            {
                                "example_id": "82b4206c-1d48-4cdf-8cd6-495f93379f43",
                                "sense_id": "9fd70b34-3fb8-31ed-a642-d30019e9372f",
                                "text": "Wer noch nicht sechzehn war, bekam keinen Personal-, sondern nur einen Kinderausweis."
                            },
                            {
                                "example_id": "5e842f6f-5c54-4f5b-ae2e-d0fc32d1ab62",
                                "sense_id": "9fd70b34-3fb8-31ed-a642-d30019e9372f",
                                "text": "In Deutschland gibt es keinen Kinderausweis mehr, er wurde durch einen Kinderreisepass ersetzt."
                            }
                        ],
