                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd7bbf17-a668-304d-8df0-6134824660db",
                                        "entry_id": "91c7be5a-3781-3a84-9ae5-d1ca81ed8810",
                                        "glosses": [
                                            "Qui appartient aux Maures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe997977-67d2-4624-a700-4369175f3992",
                                                "sense_id": "bd7bbf17-a668-304d-8df0-6134824660db",
                                                "text": "« Voici, Monsieur, quelques renseignements intéressants sur les tribus mauresques les plus voisines de notre colonie du Sénégal ; …."
                                            },
                                            {
                                                "example_id": "a35e4c53-7d94-4c90-8c10-2893b640528a",
                                                "sense_id": "bd7bbf17-a668-304d-8df0-6134824660db",
                                                "text": "Seulement, elle étouffait entre les quatre murs blancs de la cour mauresque où elle était enfermée, et elle regrettait amèrement l'immensité libre de sa plaine natale, …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mauresque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae5fb75-e98c-3a06-af8d-59750b4fce14",
                                        "entry_id": "9d6adbd4-b168-3474-b73f-b34a56726564",
                                        "glosses": [
                                            "Cocktail composé de pastis et de sirop d’orgeat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fda23f-3f5a-4f5b-a281-1ad9296d624b",
                                                "sense_id": "2ae5fb75-e98c-3a06-af8d-59750b4fce14",
                                                "text": "Attablé devant une mauresque, l’auteur considérait avec mélancolie un pilulier de métal, presque vide, qui ne contenait plus qu’un vague restant de cocaïne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3619479-d7f8-35c4-a4d5-c235c0e6a2ed",
                                        "entry_id": "9d6adbd4-b168-3474-b73f-b34a56726564",
                                        "glosses": [
                                            "Danse à la manière des Maures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceebfde6-34d5-46a5-a23f-9c17df85b72e",
                        "source_entry_id": "64cbbee1-5edd-3e89-bf0d-ff56851b43e8",
                        "source_sense_description": "of or pertaining to Moors",
                        "target_lang_word": "maurisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maurisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52434f80-24ab-353b-991a-534fd0c1d733",
                                        "entry_id": "32315edb-9922-3491-834a-6a9aca8cce0d",
                                        "glosses": [
                                            "das Volk der Mauren betreffend, zu ihnen gehörend, von ihnen stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48debe7c-bcbf-4b71-8a9b-1bf67824a73f",
                                                "sense_id": "52434f80-24ab-353b-991a-534fd0c1d733",
                                                "text": "Die maurische Herrschaft begann auf der Iberischen Halbinsel im Jahr 710."
                                            },
                                            {
                                                "example_id": "793c23b6-37b5-417e-bf5a-7ce521f80b4a",
                                                "sense_id": "52434f80-24ab-353b-991a-534fd0c1d733",
                                                "text": "Berühmte Beispiele maurischer Baukunst sind in Spanien die Moschee in Cordoba, die Alhambra in Granada und die Kathedrale von Sevilla."
                                            },
                                            {
                                                "example_id": "52cf2de4-c3f7-4237-9836-78f70d6082d8",
                                                "sense_id": "52434f80-24ab-353b-991a-534fd0c1d733",
                                                "text": "Die Flachdächer, die wie in maurischer Vergangenheit als Terrassen dienen, runden das reizvolle Bild ab."
                                            },
                                            {
                                                "example_id": "a5938f95-8d29-4b7f-b6a1-da3f7d1a3f31",
                                                "sense_id": "52434f80-24ab-353b-991a-534fd0c1d733",
                                                "text": "Bei der Übergabe verpflichtet sich das siegreiche Herrscherpaar, Religion, Gesetze und Traditionen der im Land bleibenden maurischen Bevölkerung anzuerkennen."
                                            },
                                            {
                                                "example_id": "50034e8c-0a73-4c20-b01a-e957ce362a2f",
                                                "sense_id": "52434f80-24ab-353b-991a-534fd0c1d733",
                                                "text": "„Zu den schönsten Gewächshäusern der über 70 botanischen Gärten Deutschlands zählen die Häuser im maurischen Stil in der Stuttgarter Wilhelma, die König Wilhelm I. von Württemberg einst zu seinem privaten Vergnügen errichten ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
