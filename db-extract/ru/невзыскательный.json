                    {
                        "translation_id": "97cbeb63-8553-422c-b702-5151eec8ae1d",
                        "source_entry_id": "48f544ec-8f06-3a57-b82e-2e6de2c870d7",
                        "source_sense_id": "ffa5f6d8-5313-3057-9992-ce0ca53f89c4",
                        "target_lang_word": "unexacting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexacting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c9f7776-1827-3b94-b484-0dda45b80f90",
                                        "entry_id": "65cb04d5-e909-36b5-a496-2e5b85d3937e",
                                        "glosses": [
                                            "Not demanding; uncritical; not difficult to satisfy."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e46983-c2b5-403c-9fd6-6d13aed759c8",
                                                "sense_id": "1c9f7776-1827-3b94-b484-0dda45b80f90",
                                                "text": "Florence . . . had, all through, repaid the agony of slight and coldness, and dislike, with patient unexacting love, excusing him, and pleading for him, like his better angel!"
                                            },
                                            {
                                                "example_id": "8e6b6567-38b2-48d6-811a-4ac8f6a1e07b",
                                                "sense_id": "1c9f7776-1827-3b94-b484-0dda45b80f90",
                                                "text": "But Mrs Eames was a kind, patient, unexacting woman, who took all civil words as meaning civility."
                                            },
                                            {
                                                "example_id": "dd31a931-e568-4f17-a39b-301e9dcfdaf0",
                                                "sense_id": "1c9f7776-1827-3b94-b484-0dda45b80f90",
                                                "text": "She was rarely angry; she was unexacting, good-humoured, preferring animals to people."
                                            },
                                            {
                                                "example_id": "6a2d7425-7a1c-4c8c-8b50-f090ec907010",
                                                "sense_id": "1c9f7776-1827-3b94-b484-0dda45b80f90",
                                                "text": "Locomotives of this type also work the fast passenger and other trains along the Riviera main line between Marseilles and Ventimiglia on somewhat unexacting schedules, which seem likely to persist until introduction of 25kV electric traction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "499fcc77-82f8-333d-8825-acac6a407ae9",
                                        "entry_id": "65cb04d5-e909-36b5-a496-2e5b85d3937e",
                                        "glosses": [
                                            "Not requiring precision or substantial effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44580d4-9109-4309-a136-4c62cba7fc33",
                                                "sense_id": "499fcc77-82f8-333d-8825-acac6a407ae9",
                                                "text": "It . . . yields a staple which requires a very simple and unexacting process to prepare it for market."
                                            },
                                            {
                                                "example_id": "b61ee3e0-9f7e-4c24-b08e-b195e1f07833",
                                                "sense_id": "499fcc77-82f8-333d-8825-acac6a407ae9",
                                                "text": "Diesel m.u. coaching train miles worked out at 18 per train hour, doubtless because of stopping services with unexacting schedules and lengthy turn-rounds; [...]."
                                            },
                                            {
                                                "example_id": "b30a2343-9737-448f-b1c8-a980e8e9e7c7",
                                                "sense_id": "499fcc77-82f8-333d-8825-acac6a407ae9",
                                                "text": "His hours were not long, and his work was unexacting and physically light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
