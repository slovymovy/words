                "senses": [
                    {
                        "sense_id": "fe6ee8cf-66a6-3a06-88a4-a6be521410b0",
                        "entry_id": "b4c4f4b2-12ec-3be7-aab0-c88dda2cf9f6",
                        "glosses": [
                            "Vêtement de travail d’une seule pièce de tissu qui couvre tout le corps, porté par-dessus les autres vêtements pour les protéger ou ne pas les salir."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "5e7bae99-df9a-4e91-9885-e34e8f9fbdff",
                                "sense_id": "fe6ee8cf-66a6-3a06-88a4-a6be521410b0",
                                "text": "L'accueil était plutôt lugubre : un employé au teint pâle revêtu d'un couvre-tout gris et dont le prénom devait être Urgel, comme dans Urgel Bourgie, demandait à la personne la raison de sa visite et la dirigeait généralement vers l'escalier menant à la morgue, en disant tout simplement sur un ton caverneux : « C'est en bas »."
                            },
                            {
                                "example_id": "d22cfa13-d228-4b29-bbd7-bed2db652633",
                                "sense_id": "fe6ee8cf-66a6-3a06-88a4-a6be521410b0",
                                "text": "Il n'est que loyal de notre part de nous demander lesquels doivent être reconnus par nous comme ouvrier, ceux que nous venons de décrire ou ceux auxquels nous avons fait allusion plus haut, qui portent des couvre-tout, mais qui haïssent et combattent les unions et leur cause!"
                            }
                        ]
                    }
