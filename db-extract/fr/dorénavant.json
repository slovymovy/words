                                        "sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
                                        "entry_id": "a6a873ab-9e8f-3b30-b1b5-371948d8d468",
                                        "glosses": [
                                            "ab jetzt, von jetzt an, ab sofort, in Zukunft"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e61389-018c-433c-8dea-deae5a00b5b7",
                                                "sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
                                                "text": "„Aurora verschwand; aber ihr Bild glänzte fortan den Mädchen in jeder Thräne des Thaues wieder.“"
                                            },
                                            {
                                                "example_id": "495ba89e-bad0-4275-b0f9-43628f00025b",
                                                "sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
                                                "text": "„Fortan wies Polizeipräsident von Jagow in fast jedem seiner Stimmungsberichte auf die wachsende Bedeutung der »Radikalen« hin.“"
                                            },
                                            {
                                                "example_id": "5109e0c3-c048-43e3-89bc-4593e51897f4",
                                                "sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
                                                "text": "„Fortan bearbeiten wohl auch die Bini ihr Land.“"
                                            },
                                            {
                                                "example_id": "5c57721e-ab16-485a-94a1-4878fcae8682",
                                                "sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
                                                "text": "„Arp lässt sich nach der Machtergreifung der Nazis mit Jean Arp anreden, seine Gedichte schreibt er fortan auf Französisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
