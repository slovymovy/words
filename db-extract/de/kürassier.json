                                        "sense_id": "9fa2ed10-e3db-3a25-8f99-d7519354cef6",
                                        "entry_id": "b4d735a7-fbcd-3779-9c87-634d3281b51d",
                                        "glosses": [
                                            "A cavalry soldier equipped with a cuirass (armor)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73bef768-966d-4976-9310-1de0be590005",
                                                "sense_id": "9fa2ed10-e3db-3a25-8f99-d7519354cef6",
                                                "text": "His vision was secular: the high priests 'will wear impressive robes'; the Herzl army would boast cuirassiers with silver breastplates;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bb67b00-4c28-4581-b293-5ed486add42a",
                        "source_entry_id": "0213cbde-167f-34c9-84f7-f44d7d4514df",
                        "source_sense_id": "b0f4db4e-5c33-3798-a25d-56f8f485a3d8",
                        "target_lang_word": "couraceiro",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90ffe246-0bbe-4b45-b819-a6df4a8b846a",
                        "source_entry_id": "0213cbde-167f-34c9-84f7-f44d7d4514df",
                        "source_sense_id": "b0f4db4e-5c33-3798-a25d-56f8f485a3d8",
                        "target_lang_word": "кирасир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кирасир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a55cb0a6-bd51-31c2-9756-a1eacf2f2447",
                                        "entry_id": "b2468c87-6c3b-39d7-b4a0-433aa5c2653d",
                                        "glosses": [
                                            "истор., воен. военнослужащий одного из родов тяжёлой кавалерии, носивший кирасу и каску"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ef75f8-9c32-4f76-88e4-dcde1b39f15d",
                                                "sense_id": "a55cb0a6-bd51-31c2-9756-a1eacf2f2447",
                                                "text": "Кирасиры большею частью огромного роста, в белых колетах, в черных кирасах, вместе с вороным конём кирасир нам казался великаном — не взглянешь; черные хвосты от медных касок шевелились в воздухе; стальные мундштуки, удила, перепачканные пеной, вместе с ясными бляхами стального набора воинственно блестели на чёрных ремнях сёдел."
                                            },
                                            {
                                                "example_id": "563a9533-d3f6-4007-ad0f-8eb97340c44e",
                                                "sense_id": "a55cb0a6-bd51-31c2-9756-a1eacf2f2447",
                                                "text": "Офицеры различных полков толкались тут же; необыкновенно длинный кирасир, немецкого происхождения, хладнокровно спрашивал у хромого барышника: сколько он желает получить за сию рыжую лошадь?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
