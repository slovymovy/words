                "senses": [
                    {
                        "sense_id": "597501ac-34ee-326a-abcb-6870ac7cd496",
                        "entry_id": "794e70d8-3f9b-390c-b2fe-8ba2d1f6f4ce",
                        "glosses": [
                            "Faire sortir de la Bastille, libérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "442685d2-dd88-4ef3-b4f0-b840b32ae260",
                                "sense_id": "597501ac-34ee-326a-abcb-6870ac7cd496",
                                "text": "et, dans un moment d'indignation calculée, l'autorité décida qu'il était temps de débastiller les Cordelières malgré elles."
                            },
                            {
                                "example_id": "29b8ff47-2486-42e3-8c78-af983de4263a",
                                "sense_id": "597501ac-34ee-326a-abcb-6870ac7cd496",
                                "text": "Le 28 mars 1792, on leur interdit de porter leur costume, qu'on appelait « de l'autre monde » ; en septembre, on résolut de les « débastiller »."
                            }
                        ]
                    }
