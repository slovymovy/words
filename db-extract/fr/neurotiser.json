                "senses": [
                    {
                        "sense_id": "c51d6d49-9e93-3abd-b1f0-d5d7da84e838",
                        "entry_id": "4eb8971f-8adb-3ba6-bb5c-a4c17d4837c7",
                        "glosses": [
                            "Fournir en fibres nerveuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785d8780-7717-4b3b-a615-020f5b89f643",
                                "sense_id": "c51d6d49-9e93-3abd-b1f0-d5d7da84e838",
                                "text": "Cette étude histomorphologique a permis d’objectiver que 10 % du nerf ulnaire est suffisant pour neurotiser le nerf moteur du muscle biceps."
                            },
                            {
                                "example_id": "31c80070-34f7-457b-ad2f-377ff9509b3f",
                                "sense_id": "c51d6d49-9e93-3abd-b1f0-d5d7da84e838",
                                "text": "Nous avons également constaté chez l’animal après plusieurs mois, que certains cylindraxes étaient susceptibles de multiplication et qu’un même cylindraxe pouvait neurotiser plusieurs gaines."
                            }
                        ]
                    }
