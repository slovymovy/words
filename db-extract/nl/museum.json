                ],
                "senses": [
                    {
                        "sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                        "entry_id": "e771c82a-1dfa-32eb-8591-dccbea56bb39",
                        "glosses": [
                            "een gebouw waarin voorwerpen van culturele waarde tentoongesteld worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d9cf0a7-c4d6-4e18-871c-8c09fc6597e4",
                                "sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                                "text": "Dankzij deze kaart mag ik gratis naar alle museums die er zijn!"
                            },
                            {
                                "example_id": "159b10b0-5dc7-478f-a5a2-7180be423053",
                                "sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                                "text": "In Assen komen de twee beelden samen in Window of my Eyes, een tentoonstelling in het Drents Museum over leven en werk van Harry Muskee, die met zijn Cuby + Blizzards legendarisch werd met een heel eigenzinnige Nederblues. De tentoonstelling opent morgen voor het publiek."
                            },
                            {
                                "example_id": "6e483d72-3a3d-41a9-985e-0b506e0d9c78",
                                "sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                                "text": "De herinnering aan de Nationale 7 wordt ook levend gehouden in kleine musea, vaak gerund door vrijwilligers. In een oude garage in Piolenc bij Orange is een charmant museum gevestigd met oude auto's, foto's, reclameborden en andere memorabilia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa668b12-9ad5-40bc-98ab-ed1e31f08fc2",
                        "source_entry_id": "e771c82a-1dfa-32eb-8591-dccbea56bb39",
                        "source_sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                        "source_sense_description": "een gebouw waarin voorwerpen van culturele waarde tentoongesteld worden",
                        "target_lang_word": "博物馆",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f4f784d6-0b55-4c6e-94a6-bba8f4c5cbab",
                        "source_entry_id": "e771c82a-1dfa-32eb-8591-dccbea56bb39",
                        "source_sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                        "source_sense_description": "een gebouw waarin voorwerpen van culturele waarde tentoongesteld worden",
                        "target_lang_word": "Museum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Museum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "500f91a6-7a5f-31a7-bd22-74fad3356f98",
                                        "entry_id": "7c0ec170-28fd-3acc-ade6-8cd60aa1722c",
                                        "glosses": [
                                            "eine Einrichtung zur thematischen Forschung und Archivierung, der präsentierten Aufbereitung und Ausstellung ausgewählter Ausstellungsstücke für die Öffentlichkeit mit meist pädagogischem Anspruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c95f99c6-b04d-45bf-95d7-d17749ef5508",
                                                "sense_id": "500f91a6-7a5f-31a7-bd22-74fad3356f98",
                                                "text": "Ein Besuch des Museums lohnt sich immer."
                                            },
                                            {
                                                "example_id": "8693851b-9ae3-4df1-9e09-0878cf916682",
                                                "sense_id": "500f91a6-7a5f-31a7-bd22-74fad3356f98",
                                                "text": "„Das Wort ‚Museum‘ leitet sich von einer Schöpfung Alexanders (des Großen) her, dem ‚Museion‘ in Alexandria, das als Tempel der Musen eine Stätte der Bildung und Kunst war.“"
                                            },
                                            {
                                                "example_id": "85998edc-c812-426e-a7bf-85b06a8f97e0",
                                                "sense_id": "500f91a6-7a5f-31a7-bd22-74fad3356f98",
                                                "text": "„Stattdessen brachte man sie im Museum selbst unter, nicht immer im Idealzustand.“"
                                            },
                                            {
                                                "example_id": "7c5e6450-18a0-45cb-aaac-1c7360ecde06",
                                                "sense_id": "500f91a6-7a5f-31a7-bd22-74fad3356f98",
                                                "text": "„Wir sind an einem Freitag hier, das Museum ist geschlossen.“"
                                            },
                                            {
                                                "example_id": "50cc13d2-01c2-4ddf-b42a-2c9e936de0a8",
                                                "sense_id": "500f91a6-7a5f-31a7-bd22-74fad3356f98",
                                                "text": "„So diente er sich mit seinen Fachkenntnissen in Sachen Kunst der Moderne den Herrschenden an, als die Eroberungspolitik begann und die Deutschen ihre Raubzüge in Museen und Privatsammlungen der besetzten Gebiete aufnahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecf9489c-874e-4e96-9c62-c790de3b34bd",
                        "source_entry_id": "e771c82a-1dfa-32eb-8591-dccbea56bb39",
                        "source_sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                        "source_sense_description": "een gebouw waarin voorwerpen van culturele waarde tentoongesteld worden",
                        "target_lang_word": "museum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "museum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "318a1fb5-7a66-383f-8330-3ee9a5574898",
                                        "entry_id": "8c8d32ad-0eb4-3065-8928-452200e7d65c",
                                        "glosses": [
                                            "A building or institution dedicated to the acquisition, conservation, study, exhibition, and educational interpretation of objects having scientific, historical, cultural or artistic value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10dd9d9a-4fce-41d2-b508-cb67d9966bad",
                                                "sense_id": "318a1fb5-7a66-383f-8330-3ee9a5574898",
                                                "text": "visit the history museum"
                                            },
                                            {
                                                "example_id": "db2e973d-756a-4479-aeef-b69020ce2229",
                                                "sense_id": "318a1fb5-7a66-383f-8330-3ee9a5574898",
                                                "text": "They're opening a new coin exhibition at the local museum."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "museum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb21a9c-61fc-376d-95e2-cb3be7193b49",
                                        "entry_id": "cfef68ec-ce44-3461-a639-c3bc8e8ce8fb",
                                        "glosses": [
                                            "To place in a museum."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a84ac17-c091-46d8-b621-16374bcfc429",
                                                "sense_id": "2cb21a9c-61fc-376d-95e2-cb3be7193b49",
                                                "text": "I use daily those books that for others are museumed. The glass case approach depresses me, makes books into porcelain, guts them of what they are."
                                            },
                                            {
                                                "example_id": "7a2cd517-a5a5-44a9-ac94-757e613c7c24",
                                                "sense_id": "2cb21a9c-61fc-376d-95e2-cb3be7193b49",
                                                "text": "Such museuming provides evidence that the Gulf has started building up its defences to protect its national culture, which might be seen as threatened by modern, global societies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afe0794-65fd-3984-a993-af4afcec0ac0",
                                        "entry_id": "cfef68ec-ce44-3461-a639-c3bc8e8ce8fb",
                                        "glosses": [
                                            "To visit museums."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b47a9b-7c2d-4879-b95f-c136c8b85797",
                                                "sense_id": "0afe0794-65fd-3984-a993-af4afcec0ac0",
                                                "text": "I told her I'd do just one visit to start; I don't really have time to do a lot of museuming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b490689-e8d5-49d5-b06f-e4dc8010f4a1",
                        "source_entry_id": "e771c82a-1dfa-32eb-8591-dccbea56bb39",
                        "source_sense_id": "44bc8e81-df92-3d87-8e4a-fe4f89da093d",
                        "source_sense_description": "een gebouw waarin voorwerpen van culturele waarde tentoongesteld worden",
                        "target_lang_word": "musée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b52bc18-b71f-38a4-be9f-22795367725c",
                                        "entry_id": "0a39a9a3-17a0-3cd0-b0a6-86d910f6d86d",
                                        "glosses": [
                                            "Lieu destiné à réunir, conserver, classer et exposer les œuvres d’art, les objets et les documents intéressant les sciences et leurs applications."
                                        ],
                                        "tags": [
                                            "Muséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf4f8e4-6df2-46a7-8a26-b169e7546c88",
                                                "sense_id": "0b52bc18-b71f-38a4-be9f-22795367725c",
                                                "text": "Dans un musée de sculpture ou de peinture, il me semble toujours que certains recoins perdus doivent être le théâtre de lubricités cachées."
                                            },
                                            {
                                                "example_id": "3c213e9d-ea4e-4401-a7d5-5639a2332a87",
                                                "sense_id": "0b52bc18-b71f-38a4-be9f-22795367725c",
                                                "text": "Rien ne me paraît ressembler autant à un bordel qu’un musée. On y trouve le même côté louche et le même côté pétrifié."
                                            },
                                            {
                                                "example_id": "ecb86c62-cf8e-4f8d-b907-826bdd819d9d",
                                                "sense_id": "0b52bc18-b71f-38a4-be9f-22795367725c",
                                                "text": "Outre l’ascension du peintre refoulé devenu soldat fanatique puis sauveur vénéré d’une Allemagne en perdition, le musée abordait l’Holocauste et ses millions de victimes, photographies sans concession à l’appui, montrant comment la folie d’une poignée d’individus ultradéterminés avait mené le pays dans l’horreur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8fc52b9-a0ab-3827-aa1a-6f1e221e1a53",
                                        "entry_id": "0a39a9a3-17a0-3cd0-b0a6-86d910f6d86d",
                                        "glosses": [
                                            "Lieu rempli d'objets rares, beaux, précieux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd69b14-29de-4b84-a6fd-95983ee91522",
                                                "sense_id": "d8fc52b9-a0ab-3827-aa1a-6f1e221e1a53",
                                                "text": "Cet été elle va réparer quelques petites avaries, revernir le tout, et ma chambre sera un vrai musée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f5dff3-255a-366f-8d24-1daf0dac68b7",
                                        "entry_id": "0a39a9a3-17a0-3cd0-b0a6-86d910f6d86d",
                                        "glosses": [
                                            "Lieu (ville, quartier) où se trouvent réunis des ensembles d'œuvres ou d'édifices du passé, à valeur historique et artistique → voir ville-musée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9dd6e02-edb2-4e80-8bb3-49f2ca2c9bd9",
                                                "sense_id": "a2f5dff3-255a-366f-8d24-1daf0dac68b7",
                                                "text": "Avant d'être un véritable musée de vieux hôtels plus étincelants, plus distingués les uns que les autres, avant d'être le seul quartier de Paris qui dût avoir la chance de réunir les spécimens de toutes les époques françaises, le Marais était, tout simplement, un marais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e70d167-d1cf-3a4f-8352-fa48a01ef158",
                                        "entry_id": "0a39a9a3-17a0-3cd0-b0a6-86d910f6d86d",
                                        "glosses": [
                                            "Collection de choses diverses."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee08b1e4-aa79-4026-a68c-f228f703f689",
                                                "sense_id": "1e70d167-d1cf-3a4f-8352-fa48a01ef158",
                                                "text": "C'est un vrai musée des horreurs, ici !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
