        "ru-extract.jsonl": [
            {
                "entry_id": "cbb4dca9-1960-3679-9398-998efc85be8b",
                "word": "вразброс",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7c0cde6-854f-3758-8913-85828089bbfe",
                        "entry_id": "cbb4dca9-1960-3679-9398-998efc85be8b",
                        "glosses": [
                            "разбрасывая по сторонам, в разные стороны; ручным способом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bfc3943-cdaa-4a9a-9b4b-38040f47bf09",
                                "sense_id": "a7c0cde6-854f-3758-8913-85828089bbfe",
                                "text": "…он шествует, поматывая на ходу головой и вразброс тяпая по земле ботинками."
                            },
                            {
                                "example_id": "41a87a40-4259-41e1-936b-cff4bed5afdd",
                                "sense_id": "a7c0cde6-854f-3758-8913-85828089bbfe",
                                "text": "Среди неглубоких пятен воронок на нём вразброс лежали двое немцев, белые в зелёной траве."
                            }
                        ]
                    },
                    {
                        "sense_id": "70bc024c-1b2e-3d98-b2c9-e0948cbfcb7b",
                        "entry_id": "cbb4dca9-1960-3679-9398-998efc85be8b",
                        "glosses": [
                            "разг. порознь, по отдельности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd7a699-2967-412f-b3c0-e5e46aee3165",
                                "sense_id": "70bc024c-1b2e-3d98-b2c9-e0948cbfcb7b",
                                "text": "Все вразброс, в одиночку, каждый сам для себя, каждый враг другому."
                            },
                            {
                                "example_id": "b2ada89f-77ba-468b-8b87-f683134bd893",
                                "sense_id": "70bc024c-1b2e-3d98-b2c9-e0948cbfcb7b",
                                "text": "По всему плацу солдаты стояли вразброс: около тополей, окаймлявших шоссе, около гимнастических машин, возле дверей ротной школы, у прицельных станков."
                            }
                        ]
                    },
                    {
                        "sense_id": "9322db5b-aba2-3b21-9884-6de3350d410b",
                        "entry_id": "cbb4dca9-1960-3679-9398-998efc85be8b",
                        "glosses": [
                            "разг. разбросанно, хаотично, беспорядочно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4362b3a1-e50f-4c07-929c-cfdf1147501f",
                                "sense_id": "9322db5b-aba2-3b21-9884-6de3350d410b",
                                "text": "Журналы и газеты вразброс по всему столу…"
                            }
                        ]
                    },
                    {
                        "sense_id": "fcef55d8-9714-3825-857b-ea683d10c7bf",
                        "entry_id": "cbb4dca9-1960-3679-9398-998efc85be8b",
                        "glosses": [
                            "разг. непоследовательно, хаотично, беспорядочно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "984952df-2e1e-4732-a45a-0bdccda58ef0",
                                "sense_id": "fcef55d8-9714-3825-857b-ea683d10c7bf",
                                "text": "Да и как практически устроить надзор за рабочими, которые (не то что на фабрике) работают вразброс…"
                            },
                            {
                                "example_id": "a473f7f1-1dc9-4ab7-8e8a-6e65e20bc47b",
                                "sense_id": "fcef55d8-9714-3825-857b-ea683d10c7bf",
                                "text": "Он рассказывал свою жизнь вразброс: то про одно, то про другое."
                            },
                            {
                                "example_id": "d3d8f454-a8ee-480e-b396-da0ebaa03e77",
                                "sense_id": "fcef55d8-9714-3825-857b-ea683d10c7bf",
                                "text": "Но для таких, которые читают не подряд, а вразброс ― начало, середку и последние абзацы, нужно было отгрохать конец позабористей."
                            }
                        ]
                    }
                ],
