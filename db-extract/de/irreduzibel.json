                "senses": [
                    {
                        "sense_id": "ecd600ab-9502-3cfe-affe-c992d3f8dce1",
                        "entry_id": "a4915461-f0c4-3067-8ca7-879baa0c7b09",
                        "glosses": [
                            "nicht in weitere, einfachere Grundformen zerlegbar; nicht von etwas anderem abzuleiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff8b609-5056-47ae-abd8-8d13aeefaefb",
                                "sense_id": "ecd600ab-9502-3cfe-affe-c992d3f8dce1",
                                "text": "Mathematik: „Es gibt nämlich echt aufsteigende Hauptidealketten und Primideale der Höhe 1, die kein irreduzibeles Element enthalten.“"
                            },
                            {
                                "example_id": "f16f08e8-02a6-437f-942f-509c9b19ea4a",
                                "sense_id": "ecd600ab-9502-3cfe-affe-c992d3f8dce1",
                                "text": "Philosophie: „Er beruft sich auf das Allgemeine (wie den irreduziblen Wert der Wahrheit), von dessen Wirkungsmacht er zugleich profitiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
