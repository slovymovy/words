                        "sense_id": "a84bc2c9-b378-3470-89d2-1787e982fae8",
                        "entry_id": "93a4a860-1c58-35f1-abac-c2908f3a1e3a",
                        "glosses": [
                            "Obsession de l’idée, en tant que principe philosophique platonicien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794d4e59-3dd7-4d28-a5df-934189650bd0",
                                "sense_id": "a84bc2c9-b378-3470-89d2-1787e982fae8",
                                "text": "La notion de la série fut en lui tout à la fois si confuse et si forte, qu’il en demeura comme halluciné, et qu’il remplit ses ouvrages des imaginations singulières que son idéomanie lui suggéra."
                            },
                            {
                                "example_id": "2ae71047-761e-4e60-9b73-f1cd9fe74ef4",
                                "sense_id": "a84bc2c9-b378-3470-89d2-1787e982fae8",
                                "text": "Le principe de causalité, en se révélant à l’esprit, produisit l’idéomanie universelle et profonde, que j’ai retracée à grands traits, et qui résume à elle seule toutes les superstitions scientifiques, politiques et religieuses."
                            },
                            {
                                "example_id": "a4a19e84-aac6-42b1-9bbb-ad933e872b5f",
                                "sense_id": "a84bc2c9-b378-3470-89d2-1787e982fae8",
                                "text": "La philosophie platonicienne lui apparaît comme une « idéomanie »."
                            }
                        ]
                    }
                ],
