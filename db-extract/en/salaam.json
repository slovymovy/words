                                            {
                                                "example_id": "4afaf136-66fc-431a-bb28-293cc70e4e93",
                                                "sense_id": "ff20a47a-3982-3c20-b7d4-6ddc2756d1f6",
                                                "text": "Quand le muezzin, qui est mon ami, monte à son minaret, il arrive à hauteur de ma terrasse, et m’adresse, avant de chanter la prière, un salam amical."
                                            },
                                            {
                                                "example_id": "bd7b8b3d-6e3b-4b93-9114-4700de34e9cc",
                                                "sense_id": "ff20a47a-3982-3c20-b7d4-6ddc2756d1f6",
                                                "text": "Je distribue des aumônes à tout ce monde, et recueille toute une kyrielle de bénédictions et de salams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
