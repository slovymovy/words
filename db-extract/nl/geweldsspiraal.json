                    {
                        "sense_id": "b4c66dc0-5ad0-3a33-a692-4761c14c657c",
                        "entry_id": "2b4544a4-d74d-3ed4-9c4d-0a000971902b",
                        "glosses": [
                            "proces waarbij geweld, grover geweld uitlokt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70e7a6c7-ce6e-48f2-bd01-872674b9fca8",
                                "sense_id": "b4c66dc0-5ad0-3a33-a692-4761c14c657c",
                                "text": "'De PvdA heeft grote waardering voor alle agenten die ondanks het falen van de korpsleiding en het bevoegd gezag daadkrachtig hebben opgetreden. Wat de PvdA betreft, ligt de schuld van de geweldsspiraal in Haren eerst en vooral bij de hufters die in september 2012 naar Haren kwamen om doelbewust vernielingen aan te richten, geweld te plegen en rotzooi te trappen.'"
                            },
                            {
                                "example_id": "d686312d-78ef-42c4-840a-09b104f98cfb",
                                "sense_id": "b4c66dc0-5ad0-3a33-a692-4761c14c657c",
                                "text": "Het ministerie van Veiligheid en Justitie blijft ertegen dat winkeliers wapens hebben om zich te kunnen verweren tegen overvallers. 'Het mag gewoon niet en je zou alleen maar een geweldsspiraal krijgen', aldus een woordvoerder vandaag."
                            }
                        ]
                    }
