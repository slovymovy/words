                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd7271f-026f-469b-af82-11577361a798",
                                "sense_id": "a95646f1-354f-37eb-bde0-7c65a1fa849e",
                                "text": "Even Mario is given childlike mannerisms – running open-armed like a fearless toddler, whooping with delight – to convey playful innocence."
                            }
                        ]
                    }
