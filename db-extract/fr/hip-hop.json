                "senses": [
                    {
                        "sense_id": "2a12085e-e691-31a7-b04f-573b4e3961b3",
                        "entry_id": "3b032ebe-82f4-39e0-8a8b-b342436af9ec",
                        "glosses": [
                            "Caractéristique des modes et du monde entourant la musique hip-hop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efad3b7-7478-4fbb-9cc7-dd6fa7d09258",
                                "sense_id": "2a12085e-e691-31a7-b04f-573b4e3961b3",
                                "text": "… l'artiste a joué un rôle non négligeable dans l'évolution des bijoux hip-hop."
                            }
                        ]
