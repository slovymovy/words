                "senses": [
                    {
                        "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                        "entry_id": "dfc6b498-0c89-3098-96ff-af2193a384b4",
                        "glosses": [
                            "Landschaft und Region (Autonome Region, was in etwa dem deutschen \\\"Bundesland\\\" entspricht) in Nordost-Spanien mit der Hauptstadt Barcelona."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c270f8-c564-448c-b6c2-da0fc70ec720",
                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                "text": "Katalonien ist mit seiner schönen Küste, der Costa Brava, und mit seinen herrlichen Bergen, den Pyrenäen, ein landschaftlich aber ebenso kulturell sehr vielseitiges Land."
                            },
                            {
                                "example_id": "64f9646c-768b-4b64-9468-fd9608abb2b0",
                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                "text": "„In Katalonien, dem reichsten und - neben dem Baskenland - rebellischsten Teil Spaniens, hat sich nun eine Mehrheit des Regionalparlaments dafür ausgesprochen, jene \"klassischen\" Stierkämpfe zu verbieten, in denen der Stier - nach einem genau festgelegten Ritual - getötet wird.“"
                            },
                            {
                                "example_id": "10db35eb-0670-4123-8823-abb6c932ca9c",
                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                "text": "Der Name Katalonien \"taucht erstmals in einem Gedicht des 12. Jahrhunderts auf, in dem der Graf Ramon Berenguer III. \"Dux Catalensis\" genannt wird.\""
                            },
                            {
                                "example_id": "5160feb4-8010-4de4-b68c-c30e99657f8d",
                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                "text": "„Katalonien war schon lange mediterrane Handelsmacht, als die katholischen Könige gerade ihren Kolumbus über den Atlantik schickten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
