        "fr-extract.jsonl": [
            {
                "entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                "word": "papotage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf08e352-d70b-4c0b-a0bf-a4c68f375621",
                        "entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "tags": [
                            "plural"
                        ],
                        "form": "papotages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                        "entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "glosses": [
                            "Action de papoter, bavardage."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c3dea693-9fd4-4f3f-88b3-b539892a2a63",
                                "sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                                "text": "Ici, c'est le quartier des dentellières […] ; elles font marcher leurs langues tout autant, sinon plus, que leurs fuseau : c'est un papotage sans fin."
                            },
                            {
                                "example_id": "02218734-9f57-4250-b019-f2203347b4e5",
                                "sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                                "text": "Et il se mit à singer le papotage d'une Parisienne, et jusqu'à la mimique, avec tant de gaieté que Zaheira ne put s'empêcher de rire."
                            },
                            {
                                "example_id": "7f489559-f871-446e-8bde-d5a151a8cf6d",
                                "sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                                "text": "Il fuyait ces longs papotages où tout le monde, par la médisance savamment distillée, était habillé pour l'hiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3537d4b6-0a23-4a04-9905-53671ee5523f",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                        "target_lang_word": "Plauderei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plauderei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7951a33c-2b0d-3545-93bb-a4ee52470b1b",
                                        "entry_id": "0d27837e-e7ef-36ce-8050-d9450dce54f6",
                                        "glosses": [
                                            "ungezwungene Unterhaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b03fd6-1142-49e2-8ebe-45134cbbfae5",
                                                "sense_id": "7951a33c-2b0d-3545-93bb-a4ee52470b1b",
                                                "text": "Jetzt ist es genug der Plauderei!"
                                            },
                                            {
                                                "example_id": "d93d85c2-d6e0-497c-b19b-031a4127d4ff",
                                                "sense_id": "7951a33c-2b0d-3545-93bb-a4ee52470b1b",
                                                "text": "„Die Plauderei setzte sich noch eine ganze Weile fort.“"
                                            },
                                            {
                                                "example_id": "62fb9f18-fb02-4d94-aa16-198f2db7eef7",
                                                "sense_id": "7951a33c-2b0d-3545-93bb-a4ee52470b1b",
                                                "text": "„Otto mochte keine Plaudereien, und er trank auch keinen Schluck.“"
                                            },
                                            {
                                                "example_id": "d4a4aad1-d062-4d4f-9e6d-4e5ecdca0c2a",
                                                "sense_id": "7951a33c-2b0d-3545-93bb-a4ee52470b1b",
                                                "text": "„Es kam weder ein sinnvolles Gespräch noch eine belanglose Plauderei in Gang.“"
                                            },
                                            {
                                                "example_id": "580bd6f7-e18e-4756-bdc6-c0be06b5e560",
                                                "sense_id": "7951a33c-2b0d-3545-93bb-a4ee52470b1b",
                                                "text": "„Der Offizier, dem offensichtlich die Gelegenheit zu einer kleinen Plauderei willkommen war, gesellte sich zu Pierre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16943821-578b-4be7-91de-5c565421515c",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                        "target_lang_word": "Geplauder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geplauder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0465534-4624-3a99-8622-46505f04d14b",
                                        "entry_id": "11614264-e1f7-31b9-ac4a-df6504ac3730",
                                        "glosses": [
                                            "anhaltendes Plaudern/Reden über alltägliche/unwichtige Dinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e9116b-1692-4eb6-b4a5-a6778027fef5",
                                                "sense_id": "c0465534-4624-3a99-8622-46505f04d14b",
                                                "text": "„Sie beantwortete seine Frage und fuhr dann in ihrem Geplauder fort.“"
                                            },
                                            {
                                                "example_id": "30bb0863-8bbd-4d62-81f4-f7b8014ef597",
                                                "sense_id": "c0465534-4624-3a99-8622-46505f04d14b",
                                                "text": "„Unter solchem Geplauder war der Abend vergangen, und erst lange nach Mitternacht hatte Gordon in einem Mischzustande von Müdigkeit und Angeheitertsein seinen Heimweg angetreten.“"
                                            },
                                            {
                                                "example_id": "08c55edd-6db5-4dc0-a82e-37f1efdb4736",
                                                "sense_id": "c0465534-4624-3a99-8622-46505f04d14b",
                                                "text": "„Das Geplauder war in dem leichten, gefällig anmutigen Tone geführt, der gerade nicht ausgelassen, aber für die etwas bedenklichen Zeitumstände vielleicht mutwillig genannt werden konnte.“"
                                            },
                                            {
                                                "example_id": "190ccf62-0adf-4da4-9b08-24dbd7696dd0",
                                                "sense_id": "c0465534-4624-3a99-8622-46505f04d14b",
                                                "text": "„Es kommt eben wie Geplauder daher und ist keins.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50a63d46-37c8-494f-abb0-5dc28ec7eceb",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                        "target_lang_word": "Schwatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "14d53921-736f-43af-8ace-d4687f6438a4",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                        "target_lang_word": "Plausch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plausch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef4516c-9ab5-31c3-a675-80d1ae5dd2a7",
                                        "entry_id": "b2c31cb1-830a-3779-a36d-12e453ec4ce1",
                                        "glosses": [
                                            "einfaches Alltagsgespräch; eine gemütliche Unterhaltung"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2711e74e-a369-4ad5-95b8-d25bf7cf0f17",
                                                "sense_id": "3ef4516c-9ab5-31c3-a675-80d1ae5dd2a7",
                                                "text": "Sie kam auf einen kurzen Plausch vorbei."
                                            },
                                            {
                                                "example_id": "c08c635f-219f-4d83-90c2-8a081ab61faa",
                                                "sense_id": "3ef4516c-9ab5-31c3-a675-80d1ae5dd2a7",
                                                "text": "„Nach einem kurzen Plausch erzählten wir diesem alten Mann, wir seien Deserteure von einem Kriegsschiff, und er schien uns dafür umso mehr zu mögen.“"
                                            },
                                            {
                                                "example_id": "0fd77aa6-5037-44c6-bf37-6f8666359e4e",
                                                "sense_id": "3ef4516c-9ab5-31c3-a675-80d1ae5dd2a7",
                                                "text": "„In einem begrünten Hinterhof haben sich ein paar Nachbarn auf einen Plausch und ein Gläschen Sekt zusammengefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d19ddf39-da7d-4f79-aa71-1bfac194eb4d",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
                        "target_lang_word": "small talk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small talk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                        "entry_id": "21ec2825-c31c-3941-a699-df6c5ddfbe5a",
                                        "glosses": [
                                            "Idle conversation, typically regarding innocuous or unimportant subjects, usually engaged in at social gatherings out of politeness."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e367ed-1cef-4430-ac70-cbc1fe48dec9",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "[T]o the credit of the lady it may be added, that […] without any of the arts of flattery or the gaieties of small talk, he began to be agreeable to her."
                                            },
                                            {
                                                "example_id": "0bc37d08-bda6-4962-9121-48568124799f",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "If he had a fault as a conversationalist, it was a certain tendency to monotony, a certain lack of sparkle and variety in his small-talk."
                                            },
                                            {
                                                "example_id": "e7b79413-0e0d-4661-8558-93728746015f",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "Yet for so public a figure, Jackson was socially awkward, inept at small talk and terrified when the distant audience became an adoring mob."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38a540a7-6caf-4547-9fba-8c2795c85f2b",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
