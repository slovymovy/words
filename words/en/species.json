{
    "word_family": [
        "speciation",
        "subspecies",
        "interspecies"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3aedf0eb-eba2-3d8f-ba69-3e64b6440d33",
                    "sense_definition": "A group of plants or animals that share similar characteristics and can breed with each other to produce fertile offspring.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The giant panda is an endangered <w>species</w> found in China.",
                            "target_lang_translations": {
                                "ru": "Гигантская панда — это исчезающий <w>вид</w>, обитающий в Китае.",
                                "zh": "大熊猫是中国的一种濒危<w>物种</w>。"
                            }
                        },
                        {
                            "text": "Scientists have identified a new <w>species</w> of beetle in the rainforest.",
                            "target_lang_translations": {
                                "ru": "Ученые обнаружили новый <w>вид</w> жуков в тропическом лесу.",
                                "zh": "科学家在雨林中发现了一种新的甲虫<w>物种</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "endangered species",
                        "invasive species",
                        "native species",
                        "human species",
                        "rare species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа растений или животных, обладающих схожими характеристиками и способных скрещиваться между собой, давая плодовитое потомство.",
                        "zh": "指生物学中一组具有相似特征并能相互交配产生可育后代的植物或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "биологический"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "общая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物种",
                                "target_lang_sense_clarification": "生物学分类单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb20129-c65e-38fb-b826-6fef54bc3ec0",
                    "sense_definition": "A particular type, kind, or sort of something, often used in a formal or literary context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a <w>species</w> of relief when he finally heard the news.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>своего рода</w> облегчение, когда наконец услышал новости.",
                                "zh": "当他最终听到这个消息时，感到<w>一种</w>解脱。"
                            }
                        },
                        {
                            "text": "The book describes a strange <w>species</w> of courage that few people possess.",
                            "target_lang_translations": {
                                "ru": "В книге описывается странный <w>вид</w> мужества, которым обладают немногие.",
                                "zh": "这本书描述了极少数人才拥有的那种罕见的勇气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kind",
                        "sort",
                        "type",
                        "variety"
                    ],
                    "common_phrases": [
                        "species of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный тип, род или сорт чего-либо; часто используется в формальном или литературном контексте.",
                        "zh": "指某种特定的类型、种类或形式，常用于正式或文学语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "тип"
                            },
                            {
                                "target_lang_word": "род",
                                "target_lang_sense_clarification": "категория"
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "тип"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一种",
                                "target_lang_sense_clarification": "表示类别"
                            },
                            {
                                "target_lang_word": "类型",
                                "target_lang_sense_clarification": "种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6c8d59-a664-37ab-8700-a225874ac453",
                    "sense_definition": "A specific type of atom, molecule, ion, or other particle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical reaction produces a highly reactive <w>species</w>.",
                            "target_lang_translations": {
                                "ru": "В результате химической реакции образуются высокореактивные <w>частицы</w>.",
                                "zh": "该化学反应产生了一种高活性的<w>微粒</w>。"
                            }
                        },
                        {
                            "text": "We need to identify the ionic <w>species</w> present in the solution.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить ионные <w>формы</w>, присутствующие в растворе.",
                                "zh": "我们需要确定溶液中存在的离子<w>物质</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical species",
                        "reactive species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический тип атома, молекулы, иона или другой частицы.",
                        "zh": "指化学中特定的原子、分子、离子或其他微粒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "химия"
                            },
                            {
                                "target_lang_word": "форма",
                                "target_lang_sense_clarification": "вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微粒",
                                "target_lang_sense_clarification": "化学粒子"
                            },
                            {
                                "target_lang_word": "物质",
                                "target_lang_sense_clarification": "化学形态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f657dfbb-abd5-3531-9c7d-2268f1734675",
                    "sense_definition": "The plural form of <w>specie</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank vault contained various <w>species</w> of gold and silver coins.",
                            "target_lang_translations": {
                                "ru": "В банковском хранилище находились различные <w>виды</w> золотых и серебряных монет.",
                                "zh": "银行金库里存放着各种金银<w>硬币</w>。"
                            }
                        },
                        {
                            "text": "Merchants in the past often preferred payment in hard <w>species</w> rather than paper notes.",
                            "target_lang_translations": {
                                "ru": "Торговцы в прошлом часто предпочитали оплату <w>звонкой монетой</w>, а не бумажными банкнотами.",
                                "zh": "过去的商人往往更喜欢用<w>硬币</w>支付，而不是纸币。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлические деньги (монеты) в отличие от бумажных банкнот.",
                        "zh": "指金属货币（硬币），与纸币相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонкая монета",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "металлические деньги",
                                "target_lang_sense_clarification": "финансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬币",
                                "target_lang_sense_clarification": "金属货币"
                            },
                            {
                                "target_lang_word": "现钱",
                                "target_lang_sense_clarification": "指实物货币"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}