                                    {
                                        "sense_id": "d2ac8b34-9c42-39c7-84a1-977bdac4a0e9",
                                        "entry_id": "01f4c286-1f80-3bb1-9a98-0032f8374711",
                                        "glosses": [
                                            "ein Verfahren, bei dem Lebensmittel erhitzt werden, um gefährliche Mikroorganismen unschädlich zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b4fa10-82c1-4fa1-aaa3-0e476ea425ab",
                                                "sense_id": "d2ac8b34-9c42-39c7-84a1-977bdac4a0e9",
                                                "text": "Die Pasteurisation von Milchprodukten ist notwendig, um schädliche Bakterien abzutöten."
                                            }
