                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ca2c78a-80f2-3de6-a95b-805b82636aaa",
                        "entry_id": "82a0445e-89bc-3b29-8eb9-30c26fc924bb",
                        "glosses": [
                            "иногда, изредка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc8fde0c-dd43-4921-b6a1-641cc528cb79",
                                "sense_id": "7ca2c78a-80f2-3de6-a95b-805b82636aaa",
                                "text": "Что вот я копил, чтобы книжку купить, долго копил, потому что у меня и денег-то почти никогда не бывает, разве, случится, Петруша кое-когда даст."
                            },
                            {
                                "example_id": "9a1052f0-40eb-4411-a40e-3534c5f7f55a",
                                "sense_id": "7ca2c78a-80f2-3de6-a95b-805b82636aaa",
                                "text": "Ведь кое-когда всякому хочется переменить, скажем, обстановку, образ жизни, местожительство или прочее."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf641c3e-3c3c-45c2-98c0-fa86c16b0d9f",
                        "source_entry_id": "82a0445e-89bc-3b29-8eb9-30c26fc924bb",
                        "source_sense_id": "7ca2c78a-80f2-3de6-a95b-805b82636aaa",
                        "target_lang_word": "now and then",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "now and then",
