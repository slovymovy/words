                        "examples": [
                            {
                                "example_id": "81bd8f11-7a0e-496e-afdc-f68fa9ac3734",
                                "sense_id": "0087bc21-2e17-3f84-80e5-2e7f932cf4f4",
                                "text": "Flesh dipped in the sea Ægeum will never be sweet; the herb Trigion being once bit with an aspis never groweth, and conscience once stained with innocent blood is always tied to a guilty remorse."
                            }
