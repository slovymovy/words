                                                "example_id": "51fb2d7d-ded4-46b4-9fa3-c508bc8a1111",
                                                "sense_id": "53fb651e-e427-3a63-a42f-b9b7bd169ee2",
                                                "text": "Jack discarded a length of wood, two twists of wire, his two-up kip and a spanner."
