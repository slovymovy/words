    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b1788981-6f65-331c-9fba-d35bc0ced2f0",
                "word": "thousandfold",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "de2cedff-f7ec-3157-b653-4cb6243bbfda",
                        "entry_id": "b1788981-6f65-331c-9fba-d35bc0ced2f0",
                        "glosses": [
                            "Multiplied by one thousand (1000), repeated a thousand times."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd346eb-e8e0-4c83-885d-df1008ad8045",
                                "sense_id": "de2cedff-f7ec-3157-b653-4cb6243bbfda",
                                "text": "The changes to the algorithm resulted in a thousandfold increase in efficiency, earning the engineer a small brass plaque."
                            },
                            {
                                "example_id": "85f3b173-f90f-4fd2-ae40-2c4a1cf6297e",
                                "sense_id": "de2cedff-f7ec-3157-b653-4cb6243bbfda",
                                "text": "[T]he fresh brave school-life, so full of games, adventures, and good fellowship, so ready at forgetting, so capacious at enjoying, so bright at forecasting, outweighed a thousandfold their troubles with the master of their form, and the occasional ill-usage of the big boys in the house."
                            }
                        ]
                    },
                    {
                        "sense_id": "646fcdec-865b-3da6-98b9-090f18320bf8",
                        "entry_id": "b1788981-6f65-331c-9fba-d35bc0ced2f0",
                        "glosses": [
                            "Having one thousand parts or members."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "da624995-a15a-4f7b-aacd-57739bdf6600",
                                "sense_id": "646fcdec-865b-3da6-98b9-090f18320bf8",
                                "text": "Looking into his eyes, you seemed to see there the yet lingering images of those thousand-fold perils he had calmly confronted through life."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "666491d7-e270-4280-9451-729e71e4d1c1",
                        "source_entry_id": "b1788981-6f65-331c-9fba-d35bc0ced2f0",
                        "source_sense_description": "Repeated a thousand times",
                        "target_lang_word": "milluple",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milluple",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0ac692-9c90-39bc-9066-56d27426e084",
                                        "entry_id": "d87bd6bd-9114-31e9-b1af-57ba8e2f76c5",
                                        "glosses": [
                                            "Qui contient mille fois, qui égale mille fois une quantité donnée."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88487612-1d25-4b74-8696-8d3c5cfdac75",
                                                "sense_id": "9a0ac692-9c90-39bc-9066-56d27426e084",
                                                "text": "Ce sera donc un effet forcé que cette richesse du trentuple effectif sur les comestibles ; or, si elle est en effectif trentuple sur cet objet, et en relatif centuple, milluple, incalculable sur divers détails de vêtement, logement, etc., c’est caver au plus bas et beaucoup trop bas, que de l’énoncer en moyen terme au trentuple relatif pour l’Association composée, au décuple pour la simple."
                                            },
                                            {
                                                "example_id": "f1df3fc7-7fed-44d1-bd5b-99baafcba059",
                                                "sense_id": "9a0ac692-9c90-39bc-9066-56d27426e084",
                                                "text": "Imbécile que j’étais ! double imbécile ! triple imbécile ! centuple idiot ! milluple crétin ! j’avais passé toute ma nuit à pousser la porte…\nElle s’ouvrait en dedans !…"
                                            },
                                            {
                                                "example_id": "ce275bba-6143-453e-b5a3-890afb67039e",
                                                "sense_id": "9a0ac692-9c90-39bc-9066-56d27426e084",
                                                "text": "[…] tellement qu’au lieu de dire vingtuple décuple nous dirons trentuple ; et ainsi de même quarantuple, cinquantuple, soixantuple ; et sera septantuple, octantuple et nonantuple meilleur (comme il me semble) que soixante décuple, quatre-vingtuple et quatrevingtuple décuple. Puis succédera centuple ; et combien que nous dussions dire de mille milluple ; tout ainsi que de million millionuple, il me semble que millecuple sonnerait mieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "milluple",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3a3c59-e8ca-3cfa-887f-04456f3d8308",
                                        "entry_id": "8eb183bc-e729-3b79-942e-790f9b56e881",
                                        "glosses": [
                                            "La quantité mille fois plus grande."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e71c26-d6f3-4df9-b89f-c82a38158d7a",
                                                "sense_id": "ce3a3c59-e8ca-3cfa-887f-04456f3d8308",
                                                "text": "Je vais, pour apprivoiser le lecteur, les lui présenter par degrés, en trentuple, centuple, milluple, infinitésimal."
                                            }
                                        ]
                                    }
                                ]
                            },
