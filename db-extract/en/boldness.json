                        "sense_id": "e72eaa91-7355-357c-bf2b-80c03fed4293",
                        "entry_id": "fc8bef36-e9b5-3bdf-8859-015108a00402",
                        "glosses": [
                            "The relative weight of a font; the thickness of its strokes."
