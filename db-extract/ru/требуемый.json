                ],
                "senses": [
                    {
                        "sense_id": "b3c7e8ca-5849-3e1a-8bd2-7c0f7ed837ab",
                        "entry_id": "fab7474b-4ba7-3fd7-a222-2a42760f0e11",
                        "glosses": [
                            "страд. прич. наст. вр. от требовать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "9366187c-0059-4888-ba5c-4969595e109f",
                                "sense_id": "b3c7e8ca-5849-3e1a-8bd2-7c0f7ed837ab",
                                "text": "Мама требовала, чтобы Лиза сыграла ей какой-то вальс на фортепиано, и когда та начала требуемый вальс, то стала уверять, что вальс не тот."
                            },
                            {
                                "example_id": "81ae735b-f9cb-4b92-ab16-85db09b46bbc",
                                "sense_id": "b3c7e8ca-5849-3e1a-8bd2-7c0f7ed837ab",
                                "text": "Конечно, можно снизить требуемое алгоритмом количество памяти."
                            }
                        ]
                    },
                    {
                        "sense_id": "52fd3f3a-4612-3d5d-8721-bf1c29cf2d90",
                        "entry_id": "fab7474b-4ba7-3fd7-a222-2a42760f0e11",
                        "glosses": [
                            "адъектив. необходимый, нужный, обязательный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e5e2bd-5f29-4a97-94d5-45260d2ecc88",
                                "sense_id": "52fd3f3a-4612-3d5d-8721-bf1c29cf2d90",
                                "text": "Я предложил было своих денег, но Зухин, как будто не слыхав меня, обратился к Оперову, и Оперов, достав бисерный кошелек, дал ему требуемую монету."
                            },
                            {
                                "example_id": "5e0a6985-0b1a-497b-9b6b-903ea12bdce7",
                                "sense_id": "52fd3f3a-4612-3d5d-8721-bf1c29cf2d90",
                                "text": "Иван Павлыч должен был прервать нить своих размышлений, потому что в это время нумерной подал ему требуемую рюмку очищенной с кусочком черного хлеба."
                            },
                            {
                                "example_id": "cd5dc583-18d9-409b-b511-219d0c42c516",
                                "sense_id": "52fd3f3a-4612-3d5d-8721-bf1c29cf2d90",
                                "text": "С раннего утра начались напряженные хлопоты и усилия, и в 10 часов всё пришло в требуемый порядок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "969a8910-ab36-4410-9e02-9c41c54b9b7e",
                        "source_entry_id": "fab7474b-4ba7-3fd7-a222-2a42760f0e11",
                        "target_lang_word": "erforderlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erforderlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                        "entry_id": "9426be6e-4d17-367f-8feb-24240517da79",
                                        "glosses": [
                                            "jemand/etwas ist nötig, wird gebraucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c13ed30c-54b9-48c4-8aa3-66f8bcd1670c",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "Es sind noch zwei Eier erforderlich, damit der Teig weicher wird."
                                            },
                                            {
                                                "example_id": "70542a2e-76d0-4dcd-ad0b-02d11afa5848",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "Für den Eintritt in den Staatsdienst sind zwei mindestens mit vollbefriedigend bestandene juristische Staatsexamina erforderlich."
                                            },
                                            {
                                                "example_id": "20b46f15-8726-4c6a-9264-9249febc9aa2",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Darf ein Staat notfalls Unschuldige opfern, wenn dies zur Terrorabwehr erforderlich ist?“"
                                            },
                                            {
                                                "example_id": "b54750fe-b72b-467a-8e90-96db557a4fe5",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Auch eine Unfallversicherung kann sinnvoll sein, für extravagante Hobbys wie Fallschirmspringen oder Extrembergsteigen sind allerdings Zusatzdeckungen erforderlich.“"
                                            },
                                            {
                                                "example_id": "98b36ad0-90d7-4468-ae14-4fc75890efd6",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Mehrperspektivische Betrachtungsweisen werden erforderlich, um dem Phänomenkomplex gerecht werden zu können.“"
                                            },
                                            {
                                                "example_id": "0b486751-5c86-4a45-b8a9-6f73e1df919c",
                                                "sense_id": "6e652e6e-6bd9-3d35-9326-23e1f85d898c",
                                                "text": "„Sand und Heide erwärmen sich bei Sonneneinstrahlung schnell und geben die Wärme in Form der für den Segelflug erforderlichen Thermik wieder ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
