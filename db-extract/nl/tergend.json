        "nl-extract.jsonl": [
            {
                "entry_id": "ea07dd69-e911-3eb0-b53f-12dba22e32d3",
                "word": "tergend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26d63eb6-b627-333a-9fc6-281a0e23eec8",
                        "entry_id": "ea07dd69-e911-3eb0-b53f-12dba22e32d3",
                        "glosses": [
                            "op een ergerlijke manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15a98f66-8b96-4c57-9213-4c6319aa67de",
                                "sense_id": "26d63eb6-b627-333a-9fc6-281a0e23eec8",
                                "text": "Koning Willem-Alexander heeft gereageerd op de aanslag in Nice. \"Ons hart gaat uit naar de slachtoffers van de aanslag in Nice. Frankrijk werd op de dag van zijn nationale feestdag zwaar getroffen. Wij leven intens mee met allen die nu rouwen om hun dierbaren of in tergende onzekerheid verkeren\", staat in een verklaring."
                            },
                            {
                                "example_id": "f8e9f1ff-a80d-4ae4-9e14-f05917af717b",
                                "sense_id": "26d63eb6-b627-333a-9fc6-281a0e23eec8",
                                "text": "Misschien is het in uw ogen een al te intieme onthulling, maar ik kon er niks aan doen. Ooit besloot de NS Sprinters uit te rusten zonder wc. En daar zit je dan, met tergende aandrang. Je bent overgestapt uit een intercity, waarin een rode sticker op de wc-deur met Defect je laatste restje hoop op een plas heeft weggevaagd."
                            },
                            {
                                "example_id": "367fb540-4915-46ae-aac5-4cc4d7e7fb49",
                                "sense_id": "26d63eb6-b627-333a-9fc6-281a0e23eec8",
                                "text": "Sommige mensen voelen zich van hooikoorts zo belabberd dat ze zich ziek moeten melden. Twee ontstoken ogen van de jeuk en het wrijven, tergende jeuk aan het gehemelte, een snotneus die niet wil stoppen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c69e7bed-05a5-4991-b21b-a8aac71694f3",
                        "source_entry_id": "ea07dd69-e911-3eb0-b53f-12dba22e32d3",
                        "source_sense_id": "26d63eb6-b627-333a-9fc6-281a0e23eec8",
                        "target_lang_word": "harrowing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79ef2610-7e74-3245-b4a4-02e649c56d8f",
                                        "entry_id": "94ecd94b-7977-35c8-8edd-34d1a60bd467",
                                        "glosses": [
                                            "present participle and gerund of harrow."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "harrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d22565-a912-3d25-b36f-be0a51149133",
                                        "entry_id": "b63c2f07-295f-312d-87a5-ffaf0baf230e",
                                        "glosses": [
                                            "Causing pain or distress; harrying."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0401a683-29a8-4069-80c9-cd35a867c4d6",
                                                "sense_id": "c2d22565-a912-3d25-b36f-be0a51149133",
                                                "text": "Harrowing journeys down the dark roads of anger, violence, and madness"
                                            },
                                            {
                                                "example_id": "be4a62a9-aeaf-4d0b-a3e9-3e6165f56218",
                                                "sense_id": "c2d22565-a912-3d25-b36f-be0a51149133",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2065201f-0ed5-3cda-883f-1dee85ca20b7",
                                        "entry_id": "2a309473-839c-3575-99cb-0eeccba9beef",
                                        "glosses": [
                                            "The process of breaking up earth with a harrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08566d1e-3601-4191-aad3-a300befda3aa",
                                                "sense_id": "2065201f-0ed5-3cda-883f-1dee85ca20b7",
                                                "text": "The field received two harrowings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba19dcf8-0105-34c3-9932-a54e394ac39d",
                                        "entry_id": "2a309473-839c-3575-99cb-0eeccba9beef",
                                        "glosses": [
                                            "Suffering, torment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a35553d6-57db-3f43-b491-ab1d6a8957eb",
                                        "entry_id": "2a309473-839c-3575-99cb-0eeccba9beef",
                                        "glosses": [
                                            "Ravaging; hostile incursion; spoliation; intentional widespread destruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e642c15-6037-460b-998b-20d3005b439b",
                                                "sense_id": "a35553d6-57db-3f43-b491-ab1d6a8957eb",
                                                "text": "Scientists who complain about the helplessness of politicians might consider the desolation in England which followed the harrowing of the north by William the Conqueror or the state of the Palatinate long after the end of the Thirty Years War[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45faa0c-cdb6-35ff-8c0a-7a26c66c19d0",
                                        "entry_id": "2a309473-839c-3575-99cb-0eeccba9beef",
                                        "glosses": [
                                            "Ravaging; hostile incursion; spoliation; intentional widespread destruction.",
                                            "Christ's ravaging or hostile incursion of Hell, conducted between his crucifixion and resurrection, in which he liberated the souls of the righteous held captive by Satan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c0e936-831b-4dfa-a2b4-c8ea8907f3f9",
                                                "sense_id": "f45faa0c-cdb6-35ff-8c0a-7a26c66c19d0",
                                                "text": "As in other myths, like Christ's harrowing of hell, the initiate descends into the netherworld for the magical three days."
                                            },
                                            {
                                                "example_id": "6916379f-5888-4564-aaf9-9f56931299f3",
                                                "sense_id": "f45faa0c-cdb6-35ff-8c0a-7a26c66c19d0",
                                                "text": "In the harrowing, Christ sweeps down upon death, hell, and the Devil, smashes down the doors of hell, and triumphantly carries the just off to heaven."
                                            },
                                            {
                                                "example_id": "119505bb-b52e-4a24-a14d-4fbafd7ba69d",
                                                "sense_id": "f45faa0c-cdb6-35ff-8c0a-7a26c66c19d0",
                                                "text": "The motif of the harrowing of hell was highly influential in the Insular world."
                                            },
                                            {
                                                "example_id": "8726bbec-f8c5-4e1f-bb4f-cc3528ec256c",
                                                "sense_id": "f45faa0c-cdb6-35ff-8c0a-7a26c66c19d0",
                                                "text": "But Juliana's uniquely powerful chaining of the devil is surely meant to recall Christ's harrowing of hell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66134146-14a1-49c1-a136-5b652747f3b1",
