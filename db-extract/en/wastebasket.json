        "de-extract.jsonl": [
            {
                "entry_id": "11d56637-ccb0-395f-b7d4-d3fe9d98f697",
                "word": "wastebasket",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed684ea0-7cad-3517-b6ba-f313e8a796c2",
                        "entry_id": "11d56637-ccb0-395f-b7d4-d3fe9d98f697",
                        "glosses": [
                            "kleiner Abfallbehälter, vor allem für Papiermüll: Papierkorb, Abfallkorb"
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "2bc93c28-e04c-4e4c-a411-6cc7e2711a36",
                                "sense_id": "ed684ea0-7cad-3517-b6ba-f313e8a796c2",
                                "text": "“He crumpled the invitation and card with strong, tense fingers and tossed them in the wastebasket.”",
                                "translation": "Er zerknüllte die Einladung und die Karte mit einer kräftigen Handbewegung und warf sie in den Papierkorb."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f3fab09-023f-4799-95ec-138c375d631b",
                        "source_entry_id": "11d56637-ccb0-395f-b7d4-d3fe9d98f697",
                        "source_sense_id": "ed684ea0-7cad-3517-b6ba-f313e8a796c2",
                        "source_sense_description": "kleiner Abfallbehälter",
                        "target_lang_word": "Papierkorb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papierkorb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                        "entry_id": "8498df86-388b-3936-bea0-7ded9d5a5879",
                                        "glosses": [
                                            "kleinerer Sammelbehälter für Papiermüll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e932cd-13df-4c55-9f8c-6d95e599cd6a",
                                                "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                                "text": "Oft wird der Papierkorb als Mülleimer missbraucht."
                                            },
                                            {
                                                "example_id": "537a8e61-a136-4aa8-8b30-af8f3710c18c",
                                                "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                                "text": "In den Papierkorb sollte wirklich nur Papier geworfen werden, für Teebeutel gibt es den Mülleimer."
                                            },
                                            {
                                                "example_id": "7a7cca7f-a51a-4aa3-952a-2a5891b241d8",
                                                "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                                "text": "„Tom sprang plötzlich auf, kniete vor einem Papierkorb nieder und übergab sich mit lautem Würgen, das sich mit Weinkrämpfen mischte.“"
                                            },
                                            {
                                                "example_id": "44f30bd5-60ef-4e2c-b8a4-d3be6e377df6",
                                                "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                                "text": "„Petra hat im Papierkorb des Vaters einen 20-DM-Schein entdeckt und verlangt, als sie ihn ihrem Vater gibt, 10 Prozent Finderlohn.“"
                                            },
                                            {
                                                "example_id": "e008ed4a-dc9e-4007-a724-5486501a31fe",
                                                "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                                "text": "„Der Zettel verschwand im Papierkorb.“"
                                            },
                                            {
                                                "example_id": "5db89ba5-828d-4c28-bab8-492e823a0f14",
                                                "sense_id": "f2c84edb-165d-3a45-b752-08f4ed1c89fc",
                                                "text": "„Das Drehbuch landet in einem Papierkorb der Tobis, jede Spur von ihm fehlt, der Roman existiert in zwei Fassungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2902abe-fa58-3288-8334-685c1f1e42e6",
                                        "entry_id": "8498df86-388b-3936-bea0-7ded9d5a5879",
                                        "glosses": [
                                            "Verzeichnis, in dem noch nicht endgültig gelöschte Dateien zeitweilig gespeichert werden"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440260a9-f2e7-4265-a2d6-247d510618bd",
                                                "sense_id": "b2902abe-fa58-3288-8334-685c1f1e42e6",
                                                "text": "Um das Ausspionieren von persönlichen Daten zu erschweren, kann man regelmäßig seinen Papierkorb leeren."
                                            },
                                            {
                                                "example_id": "371b4301-29e9-4ad6-874c-3364435f8cee",
                                                "sense_id": "b2902abe-fa58-3288-8334-685c1f1e42e6",
                                                "text": "Dateien im Papierkorb sind noch nicht endgültig gelöscht, sondern können noch einige Zeit wiederhergestellt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b13bae13-0da8-4fd8-b7d4-0778ec4b5517",
                        "source_entry_id": "11d56637-ccb0-395f-b7d4-d3fe9d98f697",
                        "source_sense_id": "ed684ea0-7cad-3517-b6ba-f313e8a796c2",
                        "source_sense_description": "kleiner Abfallbehälter",
                        "target_lang_word": "Abfallkorb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abfallkorb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                        "entry_id": "e84478b5-a43c-3269-8cd0-4b9b399ef9ad",
                                        "glosses": [
                                            "Behälter, in dem Müll (= Abfall) gesammelt wird, um diesen Müll, wenn der Behälter voll ist, zu entsorgen; dabei gibt es zwei Arten von"
                                        ],
                                        "tags": [
                                            "Abfallkörben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39d479d-127f-4298-97d7-31a0ea64bd06",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Wenn Du dein Zimmer aufräumst, leere bitte auch deinen Abfallkorb!“"
                                            },
                                            {
                                                "example_id": "5d8f91ba-1c54-46b1-966f-a4a60c43afb2",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Vor Verlassen der Garderobe wird diese aufgeräumt. Abfälle gehören in die Abfallkörbe.“"
                                            },
                                            {
                                                "example_id": "15cab14a-7878-44ef-a0a6-4ae58509d37a",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Vor allem die großen Städte hängen […] Jahr für Jahr mehr Abfallkörbe auf.“"
                                            },
                                            {
                                                "example_id": "bdb0b68c-e970-4732-8e2b-c5b2d44c58c6",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Durch Mitteldeutschland ziehen die Bundesautobahnen A2, A4, A9, A13, A14, A17, A36, A38, A44, A 71, A 72 sowie die A 73. Den Betriebsdienst, zu dem auch Müll auflesen und Abfallkörbe leeren gehört, sichern die Länder im Auftrag des Bundes […]“"
                                            },
                                            {
                                                "example_id": "d5ceced2-151e-4275-8add-47b8ec8c09b9",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Das illegale Entsorgen von Hausabfällen kennt man auch in Thun. Bürgerinnen und Bürger packen zu Hause Abfälle in kleine Abfallsäcke und stopfen diese auf dem Weg zum Einkaufen oder zur Arbeit in einen öffentlichen Abfallkorb.“"
                                            },
                                            {
                                                "example_id": "32c8d4e2-2514-4dc0-8fbf-843f81a364a9",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„[…] der Verzicht auf Coffee-to-go-Becher und das Unterstützen von Mehrwegbecher-Initiativen [ist] ein Beitrag gegen Littering, also achtlos in die Gegend geworfenen Müll, und überquellende Abfallkörbe in Städten.“"
                                            },
                                            {
                                                "example_id": "38702689-47be-4db9-a6d1-f8539581d86a",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Auto zu fahren, wenn auf dem gleichen Weg ein Bus unterwegs ist, ist gleichbedeutend damit, Müll auf die Straße zu schmeißen, auch wenn man direkt neben einem Abfallkorb steht.“"
                                            },
                                            {
                                                "example_id": "e1dfd4da-1e81-4ad5-af0b-d5cfa1419c35",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Weil Hundebesitzer den [Anmerkung: mit Hundekot] gefüllten Gassibeutel nicht stundenlang in der Hosentasche herumtragen können, wird dieser irgendwann – sofern kein Abfallkorb bereitsteht – als Fehlwurf in die Natur entsorgt.“"
                                            },
                                            {
                                                "example_id": "ff619abb-0f4d-4f23-8150-f0d9609be906",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Fünf Minuten vor dem Termin sah er Walker mit der Aldi-Tasche hereinkommen. Der sah sich dreimal nach allen Richtungen um, ging zuerst einige Schritte am Abfallkorb vorbei, blickte auf seine Armbanduhr, drehte sich rund herum, ging zurück zum Abfallkorb und warf das Geldpaket in der Aldi-Tasche in den Abfallkorb.“"
                                            },
                                            {
                                                "example_id": "b715f3d4-a3e3-4958-9932-0487fc2ae3d9",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Die Polizisten wurden von den Rechtsextremisten mit Flaschen, Steinen und Abfallkörben beworfen.“"
                                            },
                                            {
                                                "example_id": "68738755-3f2c-4bb5-9777-6d672e700e20",
                                                "sense_id": "f60c4e6c-7f34-3ccb-83ea-ccd86ffaaff2",
                                                "text": "„Die Randalierer […] kippten parkende Autos um und schlugen die Scheiben eines Einkaufszentrums ein. Zudem bewarfen sie die Polizisten mit Flaschen, Steinen und Abfallkörben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1be05957-6a23-3a97-862a-9b42e38837a9",
                                        "entry_id": "e84478b5-a43c-3269-8cd0-4b9b399ef9ad",
                                        "glosses": [
                                            "privat zu Hause genutzte (beispielsweise für Papier) und"
                                        ],
