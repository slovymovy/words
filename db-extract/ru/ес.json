                                    {
                                        "sense_id": "07116d3c-ab19-314d-8534-4d89dfc74391",
                                        "entry_id": "dcb99327-66f4-348f-967d-eb33b3968818",
                                        "glosses": [
                                            "Europäische Union"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee09fe0-38ab-499d-a155-4a5c5bceecda",
                                                "sense_id": "07116d3c-ab19-314d-8534-4d89dfc74391",
                                                "text": "Am 1. Mai 2004 traten 10 neue Mitglieder der EU bei, die somit nun aus 25 Mitgliedsstaaten besteht."
                                            },
                                            {
                                                "example_id": "bf5c52b0-7e38-45d7-8a04-26077b978b16",
                                                "sense_id": "07116d3c-ab19-314d-8534-4d89dfc74391",
                                                "text": "„Bund, Land und EU übernehmen den Löwenanteil, aber auch Klosterkammer, diverse Stiftungen und Spender beteiligen sich an den Kosten.“"
                                            },
                                            {
                                                "example_id": "78d1d17e-1afc-4df6-9b16-17f6d6f19f25",
                                                "sense_id": "07116d3c-ab19-314d-8534-4d89dfc74391",
                                                "text": "„In Deutschland, dem mächtigsten Land in der EU, wäre es manchem recht, wenn die Griechen den Euroklub verließen.“"
                                            },
                                            {
                                                "example_id": "e32b593c-6302-41f6-809c-ff86fde5b2ac",
                                                "sense_id": "07116d3c-ab19-314d-8534-4d89dfc74391",
                                                "text": "„Deswegen wird der Tabakanbau von der EU kräftig subventioniert.“"
                                            },
                                            {
                                                "example_id": "f46e3ddb-6e48-436b-8e86-33e578f33d0d",
                                                "sense_id": "07116d3c-ab19-314d-8534-4d89dfc74391",
                                                "text": "„Aber genau das sehen viele EU-Kritiker nicht, wenn sie die EU als einen rein ökonomischen Club abstempeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
