                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "e17b3c17-97c0-43ef-9806-c9b049330d66",
                                "sense_id": "3fe1eee0-38d2-398a-8551-6c31cc55dcca",
                                "text": "„Meine Meinung geht dahin,“ sprach er, „daß wir aus gemeinem Säckel diese Scheuer sammt allem, was darin liegt, Getraide Stroh und Heu dem Eigenthümer bezahlen, und ihn schadlos halten, dann aber das ganze Gebäude und mit ihm das fürchterliche Thier abbrennen, so braucht doch niemand sein Leben daran zu setzen. Hier ist keine Gelegenheit zu sparen, und Knauserei wäre übel angewendet.“"
                            }
                        ]
                    }
                ],
