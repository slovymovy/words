                        "glosses": [
                            "weibliche Person, die sich [beruflich] mit Pädagogik befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "734d71e8-8932-4dbd-9911-9c6e6a23ddc6",
                                "sense_id": "369f797d-c9fe-395c-a7c2-fc0c43577066",
                                "text": "Die Pädagogin hat bei ihrer Weiterbildung von den Büchern großer Pädagogen des 19. Jahrhunderts profitiert."
                            }
                        ],
