                    {
                        "translation_id": "b25281fb-0b6e-425d-ab78-793942ee1ef6",
                        "source_entry_id": "350ecc79-542c-3637-85de-db5ade581574",
                        "source_sense_id": "501dd2d5-41f6-3f5c-ad88-1fc6e7e27654",
                        "target_lang_word": "смокинг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "смокинг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "81173ad7-e406-381e-821c-17b9818b0748",
                                        "entry_id": "21b05771-344a-3635-b6f2-9475830f2911",
                                        "glosses": [
                                            "мужской пиджак, часто тёмного цвета, с лацканами, обшитыми шёлком или сатином"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34dc51aa-8512-430b-86a3-d9f72bc3806e",
                                                "sense_id": "81173ad7-e406-381e-821c-17b9818b0748",
                                                "text": "…третья ― помоложе, менее болтливая и резкая в манерах, курила и то и дело наводила длинный черепаховый лорнет на молодого человека, сидевшего рядом с ней, совсем женоподобного, ещё безбородого и подзавитого, в открытом «смокинге» с шелковыми отворотами."
                                            },
                                            {
                                                "example_id": "1b4ec1a7-707c-4e83-928e-7b1aae413961",
                                                "sense_id": "81173ad7-e406-381e-821c-17b9818b0748",
                                                "text": "Замечательно, что по стопам его пошли петербургские «подмаксимники»: высокие воротнички и яркий галстух сменили косоворотки; вместо рубашки ― смокинг; на ногах желтые штиблеты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1fefb46-18bd-3aba-b9a4-03471b0bea60",
                                        "entry_id": "21b05771-344a-3635-b6f2-9475830f2911",
                                        "glosses": [
                                            "костюм, включающий такой пиджак"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8de257-4c76-49d3-9c21-91b70b89aaa4",
                                                "sense_id": "e1fefb46-18bd-3aba-b9a4-03471b0bea60",
                                                "text": "― Галеран ― фраки и смокинги? ― Это просто костюмы. Я их даже не примерял."
                                            },
                                            {
                                                "example_id": "a5d826ff-4e4c-4064-bcc6-4e5ef2ddc05a",
                                                "sense_id": "e1fefb46-18bd-3aba-b9a4-03471b0bea60",
                                                "text": "Я вышел на сцену и просто ослеп от сверкания бриллиантов, от белых манишек, смокингов и бабочек."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
