                        "glosses": [
                            "Qui peut presque être qualifié de schisteux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d581a4-bdca-4380-a229-5ff1ac6d439f",
                                "sense_id": "a14467c8-29a5-3805-8215-509d9ff8e037",
                                "text": "En effet, on constate, tout le long de la falaise de Bandiagara, des alignements de sources à flanc de falaise, qui correspondent à des niveaux sub-schisteux."
                            },
                            {
                                "example_id": "419ca6fa-7c9a-4bce-9d8f-7d3fc675fdbe",
                                "sense_id": "a14467c8-29a5-3805-8215-509d9ff8e037",
                                "text": "Dans les montagnes de la côte septentrionale du canal de Cattaro est un calcaire tantôt blanc, compacte, sub-lithographique, tantôt rouge, sub-schisteux, employé pour le pavage."
                            },
                            {
                                "example_id": "838bff8c-f0c5-4b29-bb60-17ff6c40bc45",
                                "sense_id": "a14467c8-29a5-3805-8215-509d9ff8e037",
                                "text": "Marnes et calcaires marneux assez homogènes, gris-bleuâtre, à texture terreuse et à cassure sub-schisteuse."
                            }
                        ]
                    }
