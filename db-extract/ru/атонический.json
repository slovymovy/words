                    {
                        "translation_id": "03847cd0-b61d-48d2-bbf9-de9d804f4c23",
                        "source_entry_id": "196b0354-a361-364f-8af8-15d035fbbe4a",
                        "target_lang_word": "atone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e91472e0-d70f-3476-991b-967778785f77",
                                        "entry_id": "bfe4aa91-28f6-3269-9dfe-b81d71b69007",
                                        "glosses": [
                                            "Qui manque de tonus, de vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1891d1d-8314-4263-bd94-b045e65e5dfd",
                                                "sense_id": "e91472e0-d70f-3476-991b-967778785f77",
                                                "text": "Un corps atone."
                                            },
                                            {
                                                "example_id": "eb526d80-a390-4b00-89f3-3493583a2f18",
                                                "sense_id": "e91472e0-d70f-3476-991b-967778785f77",
                                                "text": "La gaieté illuminait les yeux naguère atones, et l’espoir relevait la tête."
                                            },
                                            {
                                                "example_id": "86b64f77-3629-4887-bf0d-bb86dab124b1",
                                                "sense_id": "e91472e0-d70f-3476-991b-967778785f77",
                                                "text": "Cet espace de temps commercialement atone mais socialement incompressible qui sépare en Europe le déjeuner du dîner."
                                            },
                                            {
                                                "example_id": "6cfafe5e-3117-4022-b8f5-62144813fab5",
                                                "sense_id": "e91472e0-d70f-3476-991b-967778785f77",
                                                "text": "Souvenir, souvenir, que me veux-tu ? L’automne\nFaisait voler la grive à travers l’air atone,\nEt le soleil dardait un rayon monotone\nSur le bois jaunissant où la bise détone."
                                            },
                                            {
                                                "example_id": "cf8a0800-b1d6-4f3d-b7cf-a5c3da489ff4",
                                                "sense_id": "e91472e0-d70f-3476-991b-967778785f77",
                                                "text": "Il avait frappé tout à l’heure pour une phrase moqueuse jetée au hasard sur ses amours, et puis il ne s’en souvenait plus, et restait là immobile, le regard atone, tenant toujours en main son loquet de porte sanglant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5993de2c-0cc4-387e-bf27-00e970b72194",
                                        "entry_id": "bfe4aa91-28f6-3269-9dfe-b81d71b69007",
                                        "glosses": [
                                            "Qui n’a pas d’accent tonique."
                                        ],
                                        "tags": [],
                                        "note": "Antonyme : tonique",
                                        "examples": [
                                            {
                                                "example_id": "4120bd60-a8e0-41d9-aab8-814bd98704f0",
                                                "sense_id": "5993de2c-0cc4-387e-bf27-00e970b72194",
                                                "text": "Voyelle atone, syllabe atone."
                                            }
                                        ]
                                    }
                                ]
                            }
