                                        "tags": [
                                            "form-of",
                                            "obsolete",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8385f0fa-dda7-4477-980a-cf417e774f79",
                        "source_entry_id": "b2cbce79-3fa7-3987-900b-a6b1f6c80ccf",
                        "source_sense_id": "c54937cd-3aca-31fd-a73b-662429e12dc8",
                        "target_lang_word": "blues",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blues",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3f75c6-47cc-3b51-b6e8-94da63b00065",
                                        "entry_id": "cb3fd50a-4f0c-3b8a-a6c8-ae9f9eb454ff",
                                        "glosses": [
                                            "een melancholieke muziekstijl, ongeveer tussen 1860 en 1900 ontstaan, die oorspronkelijk werd beoefend door Amerikaanse negerslaven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0b654f-73cc-4f54-b7fb-f0b69d539043",
                                                "sense_id": "2a3f75c6-47cc-3b51-b6e8-94da63b00065",
                                                "text": "Het meest veelzijdige festival van Rotterdam. Zo omschrijven de organisatoren van Werelds Delfshaven hun driedaagse evenement waarbij de Coolhavenkade verandert in een wereldplein met muziek variërend van Fado en afrogroove tot blues en het levenslied, afgewisseld met straattheater, poëzie, vertellingen, workshops én wereldse gerechten."
                                            },
                                            {
                                                "example_id": "a281ac8f-9342-4ab1-9c82-8e39ca2d95a0",
                                                "sense_id": "2a3f75c6-47cc-3b51-b6e8-94da63b00065",
                                                "text": "Een zwart-wit beeld uit de jaren vijftig van de vorige eeuw: regen op het Lodewijk Napoleonplein in Assen, een man met een paraplu laat zijn honden uit, huizen van baksteen onder steile driehoekige daken. Er is maar een verbinding met het beeld van de schamele behuizingen in Tutwiler, Mississippi: de blues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd21723a-f166-3ce4-8d98-4e0da5e6c0f8",
                                        "entry_id": "cb3fd50a-4f0c-3b8a-a6c8-ae9f9eb454ff",
                                        "glosses": [
                                            "droeve stemming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd7dc39-6bcb-4157-aefd-f9ab489cd7e8",
                                                "sense_id": "cd21723a-f166-3ce4-8d98-4e0da5e6c0f8",
                                                "text": "Nu Nederland niet meedoet aan het EK hebben veel voetballiefhebbers de EK-blues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83be5e45-1b11-4e72-82c1-8110a5df6566",
                        "source_entry_id": "b2cbce79-3fa7-3987-900b-a6b1f6c80ccf",
                        "source_sense_id": "c54937cd-3aca-31fd-a73b-662429e12dc8",
                        "target_lang_word": "melancholie",
