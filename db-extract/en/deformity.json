                                                "example_id": "b55d383b-70d0-4afd-bdc5-1396bff4b673",
                                                "sense_id": "8c48e890-a5da-3522-b22c-1ac7fb1c8008",
                                                "text": "„Carlotas Botticelli-Körper verkrampfte sich, bis sie es nicht mehr aushielt, Pepa das Wort abschnitt und ihr Abartigkeit vorwarf.“"
                                            }
                                        ],
