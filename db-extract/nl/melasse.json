                    {
                        "translation_id": "1855a9c8-8890-4bbe-8746-4c05c4de4d75",
                        "source_entry_id": "91f007dc-9621-37f5-a8ec-ac84b2150a83",
                        "source_sense_id": "c4ec7e54-332d-3ab2-b305-43678b218d98",
