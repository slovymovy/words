                "senses": [
                    {
                        "sense_id": "96867840-c1c9-3fa5-8323-3ea8ee751b90",
                        "entry_id": "9b5c1380-3a80-315e-9779-4f41fb500756",
                        "glosses": [
                            "Austausch (Wechsel) der Zielvorstellung (und des Planes für den Weg dorthin)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0374a80b-fb98-4139-bf2e-ad6d63a55a8b",
                                "sense_id": "96867840-c1c9-3fa5-8323-3ea8ee751b90",
                                "text": "„Und ob die Line-Maintenance – also die Wartung der Jets während der normalen Standzeiten des Flugzeugs – nun bei der Lufthansa Technik oder in der Passagiersparte aufgehängt ist, mag für viele Betrachter unerheblich sein. Aber hinter diesen Entscheidungen steht ein Strategiewechsel von Konzernchef Spohr, der sukzessive umgesetzt wird: der Abschied vom breitaufgestellten Aviation-Konzern.“"
                            },
                            {
                                "example_id": "95716564-1214-4d7a-b5f6-160b56ad59e6",
                                "sense_id": "96867840-c1c9-3fa5-8323-3ea8ee751b90",
                                "text": "„Helmholtz-Chefepidemiologe Gérard Krause hat angesichts der hochschnellenden Fallzahlen einen Strategiewechsel im Kampf gegen die Coronavirus-Pandemie gefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
