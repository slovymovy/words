                    {
                        "translation_id": "5b214cf6-0b8a-42a9-bc0c-3204759d1acd",
                        "source_entry_id": "c374bd5d-8dd5-37e8-9df5-dda41a80c71b",
                        "source_sense_id": "f85884af-7b86-35fe-ac62-216cbd3fe949",
                        "source_sense_description": "to assign an excessive value to something",
                        "target_lang_word": "overwaarderen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overwaarderen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0249419a-7779-3c62-9182-dae91b412a7b",
                                        "entry_id": "66f002e9-b3c2-3d11-a777-1e3e1a696e14",
                                        "glosses": [
                                            "aan iets een te hoge geldelijke waarde geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15f9a13f-807c-4e25-9e95-b50c1a81d07b",
                                                "sense_id": "0249419a-7779-3c62-9182-dae91b412a7b",
                                                "text": "Dit aandeel wordt overgewaardeerd, daarom verwacht ik een koersdaling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8875b5ae-6708-36e9-8823-dacf67c3401a",
                                        "entry_id": "66f002e9-b3c2-3d11-a777-1e3e1a696e14",
                                        "glosses": [
                                            "iets belangrijker vinden dan dat het eigenlijk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd791b7-1b04-4deb-bf7f-a970ed42a34f",
                                                "sense_id": "8875b5ae-6708-36e9-8823-dacf67c3401a",
                                                "text": "‘Seks moet aangeboden worden door onze overheid.’ Slabbinck zegt het zonder verpinken. ‘De mens denkt meer aan seks dan aan eten en slapen, logisch dus dat we daarop inzetten.’ Hij vindt niet dat hij met zijn uitspraak seks overwaardeert. ‘Seksualiteit is een onderdeel van het leven. Het is belangrijk voor onze persoonlijke ontwikkeling en draagt sterk bij tot onze capaciteit om gelukkig te zijn. Het gaat om gezondheid, seksuele gezondheid, en dat is een mensenrecht.’"
                                            },
                                            {
                                                "example_id": "7f95b238-b55b-4923-b44f-9d422a4cfb8e",
                                                "sense_id": "8875b5ae-6708-36e9-8823-dacf67c3401a",
                                                "text": "Een jaar voor de Olympische Spelen liet Adelinde Cornelissen zien wat zij waard is met haar ruin Parzival, al wilde zij haar twee Europese titels ook niet overwaarderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9ce35c3-6a89-453d-854c-eec3ea0392c6",
                        "source_entry_id": "c374bd5d-8dd5-37e8-9df5-dda41a80c71b",
                        "source_sense_id": "f85884af-7b86-35fe-ac62-216cbd3fe949",
                        "source_sense_description": "to assign an excessive value to something",
                        "target_lang_word": "überbewerten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überbewerten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "654d606d-a01d-33fe-bb88-01a928e5cb48",
                                        "entry_id": "0e88e7ba-5e19-36ba-a60a-5964afb7a613",
                                        "glosses": [
                                            "(einem Umstand, einer Eigenschaft/Leistung/Person) mehr Bedeutung zumessen, als sie wohl verdient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9be1b6b-1739-4d0a-abf5-1fd3c2ffebcf",
                                                "sense_id": "654d606d-a01d-33fe-bb88-01a928e5cb48",
                                                "text": "Vielleicht hast du ja recht, und ich überbewerte sein Verhalten. Vielleicht ist alles ganz harmlos."
                                            },
                                            {
                                                "example_id": "6ea47c33-54e9-4c12-8ac0-1001ee7b54fb",
                                                "sense_id": "654d606d-a01d-33fe-bb88-01a928e5cb48",
                                                "text": "„Im Übrigen neigt der Lehrer dazu, die Leistungsunterschiede zwischen den Schülern seiner Klasse überzubewerten. ‚Gute‘ Schüler der einen Klasse können in einer anderen als schwach gelten und umgekehrt.“"
                                            },
                                            {
                                                "example_id": "d2bdfc51-3938-4b7a-bb86-3459795f7ac8",
                                                "sense_id": "654d606d-a01d-33fe-bb88-01a928e5cb48",
                                                "text": "Schlaf wird überbewertet."
                                            },
                                            {
                                                "example_id": "4e8fe868-d418-4f46-b087-a1a02acc6f09",
                                                "sense_id": "654d606d-a01d-33fe-bb88-01a928e5cb48",
                                                "text": "„Wer seine Wahrnehmung aufs Negative konzentriert, bewertet es über, entdeckt immer mehr davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
