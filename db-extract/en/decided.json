                        "entry_id": "99a8c4ce-49de-3439-bbdb-19ab6db94d1d",
                        "glosses": [
                            "Clear; unmistakable, definite, unquestionable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78654d7-1c26-4a02-a6b1-9021c8ecde6c",
                                "sense_id": "57b0ce5f-86a7-3d92-9d4f-7178a566594e",
                                "text": "It was a decided victory."
                            },
                            {
                                "example_id": "ec8ad72d-fa15-4571-930a-e96c11b12722",
                                "sense_id": "57b0ce5f-86a7-3d92-9d4f-7178a566594e",
                                "text": "There was a decided ugliness to the patch of waste ground."
                            },
                            {
                                "example_id": "4ba9810e-7f71-4202-ab2e-c281de8d9c2c",
                                "sense_id": "57b0ce5f-86a7-3d92-9d4f-7178a566594e",
                                "text": "The visual indicators are a decided improvement, and have reduced the telephoning by the staff in the signalbox."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
