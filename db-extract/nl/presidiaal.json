                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2475aa31-3d7a-4a5e-b43d-f10473951bec",
                                "sense_id": "591cccc5-d049-3b05-b6ee-2f20f39fbda6",
                                "text": "Antoine en Victor deden al hun best om een gevecht te verhoeden, en ook Van Weerdt trachtte zijn presidiaal gezag te handhaven."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cf9ff8e-879d-3f06-b72e-efea40814953",
                        "entry_id": "0dc7fc6f-15ba-3297-be5b-2f51e5e1939e",
                        "glosses": [
                            "van of met betrekking tot een regeringsleider"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53a71ea-5c91-42f4-a112-2c1b6d702bcb",
                                "sense_id": "1cf9ff8e-879d-3f06-b72e-efea40814953",
                                "text": "Het gezag wordt zodoende in één persoon gesitueerd, waardoor het zichtbaarder wordt en echte binding tussen regering en geregeerden mogelijk maakt. En het bevordert, dat het gezag boven regionale- en groepsbelangen staat. Tegenover dit presidiaal gezag zal het parlement een eigen plaats vinden en een belangrijk tegenwicht kunnen bieden."
                            }
                        ]
                    }
