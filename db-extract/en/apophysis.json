                                    {
                                        "sense_id": "e57b39da-b379-33e0-a255-30d1dcc443df",
                                        "entry_id": "9a89263f-c59c-3441-8815-e568e0d81eac",
                                        "glosses": [
                                            "von einem Organismus, Organ oder Körperteil ausgebildete Verlängerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea84ea75-3189-478a-808e-67a70b100919",
                                                "sense_id": "e57b39da-b379-33e0-a255-30d1dcc443df",
                                                "text": "„Irgendwo sind nun zwei Zellen nicht vollkommen aneinandergefügt. Auf diese Stelle steuert die weiße Kugel hin, streckt einen Fortsatz aus ihrem runden Körper heraus und bohrt den in den Zwischenraum ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
