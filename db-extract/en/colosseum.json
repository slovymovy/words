                                    {
                                        "sense_id": "d3bb0f00-f201-3b0a-811e-b13162273a50",
                                        "entry_id": "52d8bfda-0479-3106-8f2e-710c36a2b4d3",
                                        "glosses": [
                                            "Immense amphithéâtre elliptique situé au centre de Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e6ff5a-d0d3-4566-b49f-23296b1aac12",
                                                "sense_id": "d3bb0f00-f201-3b0a-811e-b13162273a50",
                                                "text": "Mais, à Saint-Pierre d’abord, et au Colisée ensuite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49c1e097-2571-43c2-ac92-f881965efd4e",
                        "source_entry_id": "108b3659-ddf5-345d-9f6e-87c9083fb368",
                        "source_sense_id": "720041c2-0efc-3896-aa9b-0dc701bfb109",
                        "source_sense_description": "ancient stadium in Rome",
                        "target_lang_word": "Kolosseum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolosseum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                        "entry_id": "c3b1cb2a-10e2-32c6-b50f-02364ccfd444",
                                        "glosses": [
                                            "antikes römisches Amphitheater aus dem 1. Jahrhundert nach Christus, heute noch in Teilen erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f7ac02-a63f-414b-beb6-8445575d3122",
                                                "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                                "text": "„In Rom gab es vier Gladiatorenschulen, die größte nannte sich Ludus Magnus und war mit dem später Kolosseum genannten Flavischen Amphitheater durch einen Tunnel verbunden.“"
                                            },
                                            {
                                                "example_id": "19b62d9e-42b1-4c65-9085-1e4acd43c3c7",
                                                "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                                "text": "„Die Schornsteine der Häuser, die verfallenen Mauern, malerisch, an den Rhein und das Kolosseum gemahnend, erstreckten sich weithin durch die vom Brande betroffenen Stadtviertel, Ruine hinter Ruine.“"
                                            },
                                            {
                                                "example_id": "fc29c15d-28f4-4a1e-af18-6b85547c5284",
                                                "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                                "text": "„Ohne die Grundrechenarten kann man weder das Kolosseum bauen noch einen Militärapparat aufrechterhalten und schon gar nicht ein kalkulierbares Steuersystem etablieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
