                    "frequency": "Middle",
                    "semantic_group_id": "adaptation_forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe en soie <w>épouse</w> parfaitement les formes du corps."
                        },
                        {
                            "text": "La nouvelle route <w>épouse</w> les contours sinueux de la colline."
                        }
                    ],
                    "common_phrases": [
