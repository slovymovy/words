                ],
                "senses": [
                    {
                        "sense_id": "72315502-069d-3eea-9cc7-22b70688f137",
                        "entry_id": "9cbb7cc4-b2b1-31b9-abed-9d59967965df",
                        "glosses": [
                            "Deklination der Substantive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc3a07e0-3ef4-434a-b284-65bccf70e883",
                                "sense_id": "72315502-069d-3eea-9cc7-22b70688f137",
                                "text": "„Eine besonders ökonomische und bereits in Teilen ideale morphologische Kodierung zeichnet sich somit für die dänische Substantivflexion ab (…).“"
                            },
                            {
                                "example_id": "71d30505-f703-43d9-811f-2859c3aefcca",
                                "sense_id": "72315502-069d-3eea-9cc7-22b70688f137",
                                "text": "„Die Substantivflexion des Deutschen gilt seit jeher als ziemlich undurchschaubar, wenn nicht unsystematisch (…).“"
                            },
                            {
                                "example_id": "0ef38adf-4b70-45b6-ba89-811d8ae6b69c",
                                "sense_id": "72315502-069d-3eea-9cc7-22b70688f137",
                                "text": "„Der Umlaut ist die phonemische Veränderung im Althochdeutschen, die für die weitere Entwicklung der Substantivflexion besonders folgenreich wird.“"
                            },
                            {
                                "example_id": "fb7dd559-2d21-49a0-a4fd-a0fb85e99968",
                                "sense_id": "72315502-069d-3eea-9cc7-22b70688f137",
                                "text": "„Die indogermanische Dreiheit der Numeri - Singular, Dual zur Kennzeichnung der Paarheit, Plural - weicht der Gegenüberstellung von Singular und Plural, während sich vom Dual nur außerhalb der Substantivflexion Restformen erhalten.“"
                            },
                            {
                                "example_id": "1ee78f8a-a413-4d91-9c38-043f6d35069b",
                                "sense_id": "72315502-069d-3eea-9cc7-22b70688f137",
                                "text": "„Das überlieferte System der Substantivflexion (…) ist in seiner Auflösung so weit fortgeschritten, daß die Kasusmorpheme in der Mehrzahl der Fälle formal zusammenfallen, also mehrdeutig sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
