                        "form": "den Attentäter"
                    },
                    {
                        "form_id": "882bd7f2-10c2-4b15-a97d-3830b982f13f",
                        "entry_id": "ead54eff-4cd0-3a3f-b2f0-431cab4d78cc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Attentäter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                        "entry_id": "ead54eff-4cd0-3a3f-b2f0-431cab4d78cc",
                        "glosses": [
                            "Person, die ein Attentat begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794b2a82-8be5-4105-bff3-86e0c588f15a",
                                "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                                "text": "Der Attentäter konnte von der Polizei gefasst werden."
                            },
                            {
                                "example_id": "08654ed6-428f-45c8-b206-6cdfd7fe574f",
                                "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                                "text": "„Der Attentäter und Massenmörder von Oslo und Utöya hatte neun Jahre Zeit, seinen Plan vorzubereiten.“"
                            },
                            {
                                "example_id": "c7af378f-e56f-4101-b12a-33c7740c9b29",
                                "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                                "text": "„Es gab mindestens vier Attentäter auf der Strecke des Autokorsos.“"
                            },
                            {
                                "example_id": "57dc597f-fcdc-4f75-8f6b-c380bc652534",
                                "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                                "text": "„Als zwei Passanten in Richtung des Attentäters eilten, schoss er wieder.“"
                            },
                            {
                                "example_id": "e4b8d4b4-8dfc-45f9-a836-6cb89dff58ad",
                                "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                                "text": "„Die nächsten Tage waren von der fieberhaften Suche nach den Attentätern bestimmt.“"
                            },
                            {
                                "example_id": "aa4e1c67-e489-4308-b4cd-2c24c5f990df",
                                "sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                                "text": "[Mord an Walther Rathenau:] „Am Tag vor dem Anschlag fahren die späteren Attentäter Erwin Kern und Hermann Fischer in die mecklenburgische Landeshauptstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f070d52b-2107-4281-9f1a-f68b9d63b64a",
                        "source_entry_id": "ead54eff-4cd0-3a3f-b2f0-431cab4d78cc",
                        "source_sense_id": "c1928b73-1b03-3cbf-bbd9-5d0006c1e0e2",
                        "source_sense_description": "Person, die ein Attentat begangen hat",
                        "target_lang_word": "assassin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assassin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abded5cc-62c9-3310-b1fc-7e575d536e90",
                                        "entry_id": "75d527d1-d1c7-3d6e-b425-2be8c291fc70",
                                        "glosses": [
                                            "A member of the Nizari Ismaili Muslim community of the Alamut Period."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332d0a17-bed7-4d1a-8af7-1aa3788b4663",
                                                "sense_id": "abded5cc-62c9-3310-b1fc-7e575d536e90",
                                                "text": "The Assassines, a nation depending of Phœnicia, are esteemed among the Mahometists of a soveraigne devotion and puritie of maners; they hold, that the readiest and shortest way to gaine Paradise, is to kill some one of a contrary religion[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eab14c8-4221-37e4-bda6-39fa5f3a5fec",
                                        "entry_id": "75d527d1-d1c7-3d6e-b425-2be8c291fc70",
                                        "glosses": [
                                            "Someone who intentionally kills a person, especially a professional who kills a public or political figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64ca3b9-118f-41cd-82b6-4d2684af6925",
                                                "sense_id": "0eab14c8-4221-37e4-bda6-39fa5f3a5fec",
                                                "text": "The hand that held the bond of so many jarring interests lay powerless beneath the pall. The perils of war had been about him, and the midnight assassin had watched his path; yet he died quietly in his bed."
                                            },
                                            {
                                                "example_id": "1a13cac2-ea3d-4788-8fa0-f5508cb1e062",
                                                "sense_id": "0eab14c8-4221-37e4-bda6-39fa5f3a5fec",
                                                "text": "What has violence ever accomplished? What has it ever created? No martyr's cause can ever be stilled by an assassin’s bullet."
                                            },
                                            {
                                                "example_id": "07879c00-3c39-4f7f-872b-3bcb2df3246d",
                                                "sense_id": "0eab14c8-4221-37e4-bda6-39fa5f3a5fec",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a918c8f-caaf-3b21-a266-6a07e0855785",
                                        "entry_id": "75d527d1-d1c7-3d6e-b425-2be8c291fc70",
                                        "glosses": [
                                            "Any ruthless killer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ae7e56d-cdbf-3daf-afb1-c1f58851d737",
                                        "entry_id": "75d527d1-d1c7-3d6e-b425-2be8c291fc70",
                                        "glosses": [
                                            "An associated prime of a module."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "assassin",
