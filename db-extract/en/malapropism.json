                                        "entry_id": "80c256f0-ffd6-3ae4-a89a-c91b44fe5c31",
                                        "glosses": [
                                            "Abus de langage, emploi considéré impropre d’un mot, le plus souvent avec un effet comique involontaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70258b75-6d5f-4d97-9d5c-56e2dc28f5d7",
                                                "sense_id": "8e8ab8dd-7d35-3267-b7b1-cf5e1ffbf422",
                                                "text": "Les dictionnaires bilingues ont des difficultés à trouver des équivalents au malapropisme dans d’autres langues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f9304b0-7c83-459f-835c-257f7ba0ae80",
                        "source_entry_id": "5bbe0604-b98b-3c66-b55c-6fa4f22e564a",
