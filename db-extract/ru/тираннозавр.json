                "senses": [
                    {
                        "sense_id": "3d022fd1-9d4f-3925-bf58-76dc930d6b5f",
                        "entry_id": "a373ae4b-3a4b-3e3c-a906-d39678568294",
                        "glosses": [
                            "крупный, предположительно плотоядный динозавр позднего мелового периода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15eda38-80cd-4981-a4a5-d4963279079b",
                                "sense_id": "3d022fd1-9d4f-3925-bf58-76dc930d6b5f",
                                "text": "По всей видимости, — пишет Герберт Уэллс в знаменитых «Очерках истории цивилизации», — тираннозавры передвигались, как кенгуру, опираясь на массивный хвост и задние ноги."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e750d12-aacc-47cf-961e-6d79eac48abb",
                        "source_entry_id": "a373ae4b-3a4b-3e3c-a906-d39678568294",
                        "source_sense_id": "3d022fd1-9d4f-3925-bf58-76dc930d6b5f",
                        "target_lang_word": "tyrannosaur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannosaur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3e47fa-8214-3c0d-9e08-e3f8f6968e92",
                                        "entry_id": "84312858-4e67-38cd-b3dd-6ed2614ddb23",
                                        "glosses": [
                                            "Any large bipedal carnivorous dinosaur, of the family Tyrannosauridae, that lived in North America during the Cretaceous period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66266577-9bd8-48ad-8492-1c521775425c",
                                                "sense_id": "3b3e47fa-8214-3c0d-9e08-e3f8f6968e92",
                                                "text": "So far, Druckenmiller and his team have dug up species from seven different dino families: from big duck-billed dinos, ceretopsians, and tyrannosaurs to smaller thescelosaurs, leptoceratops, dromaeosaurs, and troodontids."
                                            },
                                            {
                                                "example_id": "4f2fb942-d8a9-4d8b-bac2-429dc82916a4",
                                                "sense_id": "3b3e47fa-8214-3c0d-9e08-e3f8f6968e92",
                                                "text": "Instead it belongs to a new species of tyrannosaur, which the researchers have dubbed Tyrannosaurus mcraeensis in a paper published on January 11 in Scientific Reports."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
