{
    "word_family": [
        "accidental",
        "accidentally",
        "accidentalness",
        "accident-prone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23fe9990-935a-35b9-9f3a-8079f1f80fa8",
                    "sense_definition": "A collision or crash involving a vehicle or other form of transportation, often resulting in damage or injury.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mishap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a serious <w>accident</w> on the highway involving three cars this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром на шоссе произошла серьезная <w>авария</w> с участием трех автомобилей.",
                                "zh": "今天早上高速公路上发生了一起涉及三辆车的严重<w>事故</w>。"
                            }
                        },
                        {
                            "text": "The police arrived quickly at the scene of the car <w>accident</w> to help the drivers.",
                            "target_lang_translations": {
                                "ru": "Полиция быстро прибыла на место <w>ДТП</w>, чтобы помочь водителям.",
                                "zh": "警察迅速赶到<w>车祸</w>现场以帮助司机。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "car accident",
                        "traffic accident",
                        "fatal accident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столкновение или авария с участием транспортного средства, часто приводящая к повреждениям или травмам.",
                        "zh": "指涉及车辆或其他交通工具的碰撞或事故，通常会导致损坏或受伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авария",
                                "target_lang_sense_clarification": "дорожное происшествие"
                            },
                            {
                                "target_lang_word": "ДТП",
                                "target_lang_sense_clarification": "дорожно-транспортное происшествие"
                            },
                            {
                                "target_lang_word": "столкновение",
                                "target_lang_sense_clarification": "наезд или удар машин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "事故",
                                "target_lang_sense_clarification": "泛指意外发生的灾祸或故障"
                            },
                            {
                                "target_lang_word": "车祸",
                                "target_lang_sense_clarification": "特指道路交通碰撞事故"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d5b5caf-2a2c-34b6-831a-8eb7e57f124e",
                    "sense_definition": "An unexpected and undesirable event that happens unintentionally, often resulting in harm or misfortune.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mishap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a complete <w>accident</w> that I broke your favorite vase while cleaning.",
                            "target_lang_translations": {
                                "ru": "Я разбил твою любимую вазу во время уборки по чистой <w>случайности</w>.",
                                "zh": "我打扫时打碎你最喜欢的花瓶完全是<w>意外</w>。"
                            }
                        },
                        {
                            "text": "She dropped the tray by <w>accident</w> when the loud noise startled her.",
                            "target_lang_translations": {
                                "ru": "Она <w>случайно</w> уронила поднос, когда ее напугал громкий шум.",
                                "zh": "当巨大的噪音吓到她时，她<w>不小心</w>把托盘掉在了地上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mishap",
                        "casualty"
                    ],
                    "antonyms": [
                        "intention"
                    ],
                    "common_phrases": [
                        "by accident",
                        "unfortunate accident",
                        "freak accident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданное и нежелательное событие, происходящее непреднамеренно и часто приводящее к вреду или неудаче.",
                        "zh": "指非故意发生的意外且不希望发生的事情，常导致损害或不幸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный случай",
                                "target_lang_sense_clarification": "событие с негативными последствиями"
                            },
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "непреднамеренное действие"
                            },
                            {
                                "target_lang_word": "неприятность",
                                "target_lang_sense_clarification": "мелкое досадное происшествие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意外",
                                "target_lang_sense_clarification": "意料之外的变故"
                            },
                            {
                                "target_lang_word": "不幸",
                                "target_lang_sense_clarification": "指遭遇灾祸或倒霉的事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b45019f-236e-39d1-ac38-2362f9837560",
                    "sense_definition": "The force of chance or luck, rather than intention or design.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They met by pure <w>accident</w> while vacationing in the same small village.",
                            "target_lang_translations": {
                                "ru": "Они встретились по чистой <w>случайности</w>, отдыхая в одной и той же небольшой деревне.",
                                "zh": "他们在同一个小村庄度假时，纯属<w>巧合</w>地相遇了。"
                            }
                        },
                        {
                            "text": "The discovery of the ancient ruins was a happy <w>accident</w> of nature.",
                            "target_lang_translations": {
                                "ru": "Обнаружение древних руин было счастливой <w>случайностью</w> природы.",
                                "zh": "发现这些古代遗迹是大自然的一次幸运的<w>偶然</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance",
                        "fortune",
                        "luck"
                    ],
                    "antonyms": [
                        "inevitability"
                    ],
                    "common_phrases": [
                        "pure accident",
                        "happy accident",
                        "accident of birth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила случая или удачи, а не намерение или замысел.",
                        "zh": "指由运气或偶然因素而非刻意设计所导致的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "стечение обстоятельств"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "везение или совпадение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巧合",
                                "target_lang_sense_clarification": "偶然的相遇或重合"
                            },
                            {
                                "target_lang_word": "偶然",
                                "target_lang_sense_clarification": "非必然的发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a996133d-29ee-3e7b-b61f-27a2621b293b",
                    "sense_definition": "An instance of unintentional urination or defecation, typically by a child or a pet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incontinence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy had an <w>accident</w> on the rug because we didn't take him out in time.",
                            "target_lang_translations": {
                                "ru": "Щенок сделал <w>лужу</w> на ковре, потому что мы не вывели его вовремя.",
                                "zh": "小狗在地毯上<w>失禁</w>了，因为我们没及时带它出去。"
                            }
                        },
                        {
                            "text": "Don't worry about the <w>accident</w>; we can clean the carpet easily.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся об этой <w>неприятности</w>, мы легко почистим ковер.",
                                "zh": "别担心这次<w>意外</w>，我们可以轻松地把地毯清理干净。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have an accident"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a polite euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай непреднамеренного мочеиспускания или дефекации, обычно у ребенка или домашнего животного.",
                        "zh": "指儿童或宠物在非预期情况下发生的排泄失禁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплошность",
                                "target_lang_sense_clarification": "эвфемизм для гигиенической неудачи"
                            },
                            {
                                "target_lang_word": "неприятность",
                                "target_lang_sense_clarification": "вежливое обозначение конфуза"
                            },
                            {
                                "target_lang_word": "авария",
                                "target_lang_sense_clarification": "шутливое или вежливое обозначение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失禁",
                                "target_lang_sense_clarification": "生理上的无法控制排泄"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2414b266-37e0-328d-8e6f-eb11733cb2dd",
                    "sense_definition": "An unplanned or unintended pregnancy, or a person born from one.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pregnancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He often joked that he was a happy <w>accident</w> because his parents weren't planning for a third child.",
                            "target_lang_translations": {
                                "ru": "Он часто шутил, что был счастливой <w>случайностью</w>, потому что родители не планировали третьего ребенка.",
                                "zh": "他常开玩笑说自己是一个幸福的<w>意外</w>，因为他父母当时并没打算要第三个孩子。"
                            }
                        },
                        {
                            "text": "The couple had to change their plans after an unexpected <w>accident</w> led to a new baby.",
                            "target_lang_translations": {
                                "ru": "Паре пришлось изменить планы после того, как неожиданная <w>случайность</w> привела к появлению ребенка.",
                                "zh": "在一次意料之外的<w>意外</w>导致怀孕后，这对夫妇不得不改变了计划。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "happy accident"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used euphemistically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незапланированная или непреднамеренная беременность, либо человек, рожденный в результате нее.",
                        "zh": "指未计划的怀孕，或由此出生的孩子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "незапланированное зачатие"
                            },
                            {
                                "target_lang_word": "сюрприз",
                                "target_lang_sense_clarification": "неожиданный ребенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意外怀孕",
                                "target_lang_sense_clarification": "非计划内的受孕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97c1f292-8685-3f07-84ce-b525a9b68a4f",
                    "sense_definition": "A nonessential property or attribute of a thing that does not affect its core essence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In philosophical terms, the color of the chair is merely an <w>accident</w> of its existence.",
                            "target_lang_translations": {
                                "ru": "С философской точки зрения, цвет стула — это лишь <w>акциденция</w> его существования.",
                                "zh": "在哲学上，椅子的颜色仅仅是其存在的一种<w>偶性</w>。"
                            }
                        },
                        {
                            "text": "The philosopher argued that the <w>accidents</w> of an object are distinct from its substance.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>акциденции</w> объекта отличны от его субстанции.",
                                "zh": "哲学家认为，一个物体的<w>偶性</w>与其本质是不同的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accidens",
                        "contingency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несущественное свойство или атрибут вещи, который не влияет на ее основную сущность.",
                        "zh": "哲学用语，指事物非本质的、偶然的属性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акциденция",
                                "target_lang_sense_clarification": "философский термин"
                            },
                            {
                                "target_lang_word": "случайное свойство",
                                "target_lang_sense_clarification": "несущественный признак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶性",
                                "target_lang_sense_clarification": "哲学中与本质相对的概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2897fe3-65dc-3190-a53c-bc26074ad0d9",
                    "sense_definition": "Describing a vehicle or vessel that has been involved in a crash or collision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigators spent hours examining the <w>accident</w> vehicle for mechanical failures.",
                            "target_lang_translations": {
                                "ru": "Следователи часами осматривали <w>аварийное</w> транспортное средство на предмет механических неисправностей.",
                                "zh": "调查人员花了几个小时检查那辆<w>出事</w>车辆是否存在机械故障。"
                            }
                        },
                        {
                            "text": "The <w>accident</w> airplane was towed away from the runway for further inspection.",
                            "target_lang_translations": {
                                "ru": "<w>Потерпевший</w> <w>аварию</w> самолет отбуксировали с взлетно-посадочной полосы для дальнейшего осмотра.",
                                "zh": "那架<w>出事</w>飞机已被拖离跑道以进行进一步检查。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "accident vehicle",
                        "accident aircraft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает транспортное средство или судно, попавшее в аварию или столкновение.",
                        "zh": "描述已发生碰撞或事故的车辆或船只。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аварийный",
                                "target_lang_sense_clarification": "попавший в аварию"
                            },
                            {
                                "target_lang_word": "битый",
                                "target_lang_sense_clarification": "о поврежденном авто"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出事",
                                "target_lang_sense_clarification": "指已经发生过事故的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2bef2cc3-9770-3a85-98f9-2f3c34c34e78",
                    "sense_definition": "A town located in Garrett County, Maryland, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small town of <w>Accident</w> is a quiet community in western Maryland.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>Аксидент</w> — это тихое поселение в западном Мэриленде.",
                                "zh": "阿克西登特小镇是马里兰州西部一个安静的社区。"
                            }
                        },
                        {
                            "text": "Visitors often stop to take pictures with the sign welcoming them to <w>Accident</w>.",
                            "target_lang_translations": {
                                "ru": "Посетители часто останавливаются, чтобы сфотографироваться со знаком, приветствующим их в <w>Аксиденте</w>.",
                                "zh": "游客们经常停下来与欢迎来到阿克西登特的标志合影。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, расположенный в округе Гарретт, штат Мэриленд, США.",
                        "zh": "位于美国马里兰州加勒特县的一个城镇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Аксидент",
                                "target_lang_sense_clarification": "название города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿克西登特",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}