                        "cross_references": [
                            {
                                "target_word": "баян",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ba646796-5bb2-31f1-b10c-1783c7aa0009",
                                        "entry_id": "92795b57-f3c6-3af4-a4c3-b85429c27866",
                                        "glosses": [
                                            "язычковый пневматический музыкальный инструмент, ручная кнопочная гармонь с полным хроматическим звукорядом на правой клавиатуре, басами и готовым аккордовым аккомпанементом на левой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704d89b4-c8f2-4233-88a1-c33e85637280",
                                                "sense_id": "ba646796-5bb2-31f1-b10c-1783c7aa0009",
                                                "text": "Хоронили тёщу — порвали два баяна."
                                            },
                                            {
                                                "example_id": "259bea49-0570-4c70-afc6-77b34347148e",
                                                "sense_id": "ba646796-5bb2-31f1-b10c-1783c7aa0009",
                                                "text": "К аккордеону подсоединились баян и барабан, музыка сделалась объёмистей, громче, смех и даже хохот катались по перрону."
                                            },
                                            {
                                                "example_id": "df761583-cd56-4884-8d81-a25e9e54168d",
                                                "sense_id": "ba646796-5bb2-31f1-b10c-1783c7aa0009",
                                                "text": "Осталась фотография, где мама с лисой, папа в красивом двубортном сером костюме, в руках у мамы аккордеон, который напрокат давал фотограф, папа на фоне своего баяна, а я с чубчиком и с маленькой гармошкой в руках."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a09d43-4822-3b9b-99b9-bf0d98a2c523",
                                        "entry_id": "92795b57-f3c6-3af4-a4c3-b85429c27866",
                                        "glosses": [
                                            "перен., сленг уже упоминавшаяся, старая шутка или уже неоднократно сообщавшаяся, ни для кого из адресатов не интересная информация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245e6a00-5c40-4b2e-ba91-cad0e7f1b05c",
                                                "sense_id": "84a09d43-4822-3b9b-99b9-bf0d98a2c523",
                                                "text": "Этот баян тут уже сто раз пробегал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a84bdce4-1d65-3fa6-9821-0cf01bf8c5fe",
                                        "entry_id": "92795b57-f3c6-3af4-a4c3-b85429c27866",
                                        "glosses": [
                                            "перен., сленг шприц, используемый для инъекции наркотиков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7fbcf26-b6bf-445a-83ac-5839bd9dbc64",
                                                "sense_id": "a84bdce4-1d65-3fa6-9821-0cf01bf8c5fe",
                                                "text": "Стучу, он открывает дверь, в руке баян торчит, болтается… // Глаз нет, походка ватная, душа сжимается…"
                                            },
                                            {
                                                "example_id": "159b31ba-444d-4b1a-b6f1-e3a18f8d58a6",
                                                "sense_id": "a84bdce4-1d65-3fa6-9821-0cf01bf8c5fe",
                                                "text": "Только поживее, а то он сейчас вырубится, там племянница ему уже десятикубовый баян поволокла. ❬…❭ Говорили, что вчера на панихиде Художнику в гроб, в карман пиджака, кто-то украдкой положил пузырь с раствором опиума ― на том свете, мол, понадобится, а в другой карман покойному сунул шприц, который на том свете тоже необходим ― как же пускать раствор без «баяна»?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
