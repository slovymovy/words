                "senses": [
                    {
                        "sense_id": "b836e08d-0d0f-35f2-baed-26a0dd62ea5c",
                        "entry_id": "34a5a0c4-af07-3d54-99fe-b2064bc9d8db",
                        "glosses": [
                            "Se dit des objets vérifiant la condition de chaîne descendante sur un certain type de sous-objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5acdac44-2aed-4467-ae72-c1d27ec22382",
                                "sense_id": "b836e08d-0d0f-35f2-baed-26a0dd62ea5c",
                                "text": "Un anneau noethérien à gauche est un anneau dans lequel tout idéal à gauche admet un système fini de générateurs (prop. 1). Lorsqu’il sera question d’un anneau artinien (resp. noethérien) sans préciser, il sera sous-entendu qu’il s’agit d’un anneau artinien (resp. noethérien) à gauche."
                            },
                            {
                                "example_id": "b38d0ce8-a40d-4090-b68e-22383feca0e6",
                                "sense_id": "b836e08d-0d0f-35f2-baed-26a0dd62ea5c",
                                "text": "Groupe artinien : Groupe dont l’ensemble des sous-groupes vérifie la condition de chaîne descendante."
                            },
                            {
                                "example_id": "48fa813a-71d2-431c-ba4a-b3b98c390236",
                                "sense_id": "b836e08d-0d0f-35f2-baed-26a0dd62ea5c",
                                "text": "Anneau artinien : Anneau qui vérifie la condition de chaîne descendante sur les idéaux."
                            },
                            {
                                "example_id": "14845ecc-8fa9-4a8c-8a36-8ea4a94e1010",
                                "sense_id": "b836e08d-0d0f-35f2-baed-26a0dd62ea5c",
                                "text": "Module artinien : Module qui vérifie la condition de chaîne descendante sur les sous-modules."
                            }
                        ]
                    }
                ],
