                            {
                                "target_word": "streak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d80a761-8fe7-3f4a-92b7-0d0b90df21ea",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To have or obtain streaks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff3d585-8822-453d-802c-da61ca333152",
                                                "sense_id": "5d80a761-8fe7-3f4a-92b7-0d0b90df21ea",
                                                "text": "If you clean a window in direct sunlight, it will streak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57042b84-37db-317d-9e33-487091fae18a",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To run quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1ff3d1-5f2f-4ded-8baf-bdc768e323f1",
                                                "sense_id": "57042b84-37db-317d-9e33-487091fae18a",
                                                "text": "\"As it was I came a hell of a crack against a Dam' rustic arbour in the garden. Dam' near stunned me. But I never stopped a second. Up and over the back fence and streaked for the common.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To run naked in public."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ab14e2-ddd0-48a0-bd0c-ceb7bec643e8",
                                                "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                                                "text": "It was a pleasant game until some guy went streaking across the field."
                                            },
                                            {
                                                "example_id": "ec4c9d7b-064c-4c8b-80d7-b7743c3c9667",
                                                "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                                                "text": "The fad began with a lone male running naked across the Florida State University campus several weeks ago. Students on other campuses began streaking in pairs, then groups, and were joined by some coeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d938ad-4a01-37fb-8776-87bb0695fa87",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To move very swiftly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "505d7e19-5055-433d-a76b-ea6066ac5fad",
                                                "sense_id": "66d938ad-4a01-37fb-8776-87bb0695fa87",
                                                "text": "But when we streaked through Doncaster at all but a mile-a-minute, with a miraculously clear road, in no more than 37 min. 18 sec. from the York start, I began to sit up and take notice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To create streaks upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7487ee53-5e27-4b1a-8793-0256ad396fcc",
                                                "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                                                "text": "You will streak a window by cleaning it in direct sunlight."
                                            },
                                            {
                                                "example_id": "0f53613a-1cdb-40c6-bf7d-5a8fe5b2d7aa",
                                                "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                                                "text": "Though his entire back down to his side fins is of a deep sable, yet a boundary line, distinct as the mark in a ship’s hull, called the “bright waist,” that line streaks him from stem to stern, with two separate colours, black above and white below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8dbaf7d-8c4d-3412-9d4e-c080335d917f",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To stretch; to extend; hence, to lay out, as a dead body."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
