            "senses": [
                {
                    "sense_id": "04e1b70f-a58d-396b-b133-ee329169f0da",
                    "sense_definition": "die Haut oder das Fleisch von jemandem fest zwischen zwei Fingern zusammendrücken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "körperliche_einwirkung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das kleine Kind lachte fröhlich, als die Großmutter es sanft in die Wange <w>kniff</w>."
                        },
                        {
                            "text": "Bitte <w>kneif</w> mich einmal kurz, damit ich wirklich sicher bin, nicht zu träumen."
                        }
                    ],
                    "synonyms": [
                        "zwicken",
                        "zwacken",
                        "pfetzen"
                    ],
                    "common_phrases": [
                        "in die Wange kneifen",
                        "in den Arm kneifen"
                    ]
                },
                {
                    "sense_id": "ca578147-efb0-35c0-81b7-981c380ff652",
                    "sense_definition": "Körperteile wie Augen oder Lippen fest zusammenpressen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "körperliche_einwirkung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen der grellen Sonne <w>kniff</w> sie unwillkürlich die Augen zusammen."
                        },
                        {
                            "text": "Er <w>kniff</w> verärgert die Lippen zusammen und sagte während des gesamten Treffens kein einziges Wort."
                        }
                    ],
                    "synonyms": [
                        "quetschen",
                        "pressen"
                    ],
                    "common_phrases": [
