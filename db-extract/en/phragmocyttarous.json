                        "glosses": [
                            "Of, relating to, or being a type of social wasp nest, in which brood combs are attached laterally to the inner surface of the sack-like envelope."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "03ffd6d1-a555-4cc7-9d57-dd676a29c823",
                                "sense_id": "da29afa0-abe9-3d46-bdd0-0c8019a43618",
                                "text": "In Ducke's classification, Polybia is placed with those species that are paper workers, are polygynous, make a nest with an envelope, and are completely phragmocyttarous."
                            },
                            {
                                "example_id": "1f1aca6d-fa1b-401b-884f-75a3395867d1",
                                "sense_id": "da29afa0-abe9-3d46-bdd0-0c8019a43618",
                                "text": "The members of this distinctive genus are rather rare, the males especially so. They were described by Araujo. The nests are phragmocyttarous."
                            },
                            {
                                "example_id": "42c225f6-0468-41d7-aac5-aef4c463e6cf",
                                "sense_id": "da29afa0-abe9-3d46-bdd0-0c8019a43618",
                                "text": "The species of Polybia build phragmocyttarous nests which consist of one to many combs attached to a branch, leaf or rock, surrounded by an envelope of carton or of mud containing an exit hole at the side or bottom of the comb. A number of species enlarge the nest by adding sue-"
                            }
                        ]
