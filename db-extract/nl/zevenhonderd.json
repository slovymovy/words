                                "sense_id": "3e22f511-bad5-33e3-8591-2939ce8e683c",
                                "text": "De totale kosten bedragen zevenhonderd euro en zevenendertig cent."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f81edd0-f561-3051-8dad-83083db8b80d",
                        "entry_id": "7643295a-a51a-3335-8e61-a8c7d7af22a6",
                        "glosses": [
                            "\\\"700\\\", het getal tussen zeshonderdnegenennegentig en zevenhonderdeen, zeven maal honderd",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "756889aa-716d-4b91-bba2-56a8cc9ab97f",
                                "sense_id": "8f81edd0-f561-3051-8dad-83083db8b80d",
                                "text": "We logeerden vlakbij het strand in kamer zevenhonderd van het grootste hotel."
                            }
                        ]
