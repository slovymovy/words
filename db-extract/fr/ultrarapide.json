                        "examples": [
                            {
                                "example_id": "668ad0a3-8dbd-422d-8dcf-3804f6477435",
                                "sense_id": "c5bb62c8-56af-30d4-a764-bc16580b0eeb",
                                "text": "Mais l’idée d’une procédure judiciaire, ultrarapide en période électorale, pour ordonner le retrait d’une information a été presque unanimement saluée comme vraisemblablement inapplicable, peut-être dangereuse, et sûrement inefficace."
                            },
                            {
                                "example_id": "af172754-dd4f-4f47-a8bf-6f70e5ed3645",
                                "sense_id": "c5bb62c8-56af-30d4-a764-bc16580b0eeb",
                                "text": "Au contraire, la codéine peut conduire à une overdose chez des métaboliseurs ultrarapides, surtout s’ils ont un faible volume de distribution (contre-indiqué chez les enfants) ; il en est de même avec l’oxycodone."
                            },
                            {
                                "example_id": "fdd04486-4505-40dc-8cfb-fadb30f47fd8",
                                "sense_id": "c5bb62c8-56af-30d4-a764-bc16580b0eeb",
                                "text": "D’autres pulsars « ultrarapides » ont été découverts depuis."
                            }
                        ]
                    }
