                                                "sense_id": "d02cc06a-28a4-357c-a63a-ea1bd590b78d",
                                                "text": "Diese Bemerkung entlockte sogar Konrad ein kleines Lächeln."
                                            },
                                            {
                                                "example_id": "39d6332d-104a-42c5-9a39-8f9be7e7bfa4",
                                                "sense_id": "d02cc06a-28a4-357c-a63a-ea1bd590b78d",
                                                "text": "Das Angebot entlockt mir doch nur ein müdes Lächeln, so leicht bin ich nicht zu überzeugen."
                                            },
                                            {
                                                "example_id": "b9c88479-f938-4d31-b120-2a60b5a1dbdf",
                                                "sense_id": "d02cc06a-28a4-357c-a63a-ea1bd590b78d",
                                                "text": "Die Reporterin arbeitete mit allen Tricks, um dem Unternehmenssprecher einen aussagekräftigen Kommentar zu entlocken."
                                            },
                                            {
                                                "example_id": "3b708efc-6fd7-4eb4-9fbe-8cb9290fcd46",
                                                "sense_id": "d02cc06a-28a4-357c-a63a-ea1bd590b78d",
                                                "text": "Könntest du nicht versuchen, ihr das Geheimnis zu entlocken, wo die Walderdbeeren wachsen?"
                                            },
                                            {
                                                "example_id": "137a4afd-0566-4cdc-9b35-beabadfe057e",
                                                "sense_id": "d02cc06a-28a4-357c-a63a-ea1bd590b78d",
                                                "text": "Ich konnte der Tuba keinen sauberen Ton entlocken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
