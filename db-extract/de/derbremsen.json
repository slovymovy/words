                                "example_id": "6c5b669c-807f-428a-8d2b-a6504e4093b1",
                                "sense_id": "07293ec2-3657-3eee-9671-9103aea04d3e",
                                "text": "„Fast hätt' i's net derbremst, bei dem Reg'n!“"
                            },
                            {
                                "example_id": "4ddb1d58-3bcb-48de-be31-33008be155f2",
                                "sense_id": "07293ec2-3657-3eee-9671-9103aea04d3e",
                                "text": "„Denn populär war das ja nicht, was der alles gemacht hat gegen den armen Jörgl, bis er ihn endlich nicht mehr derbremsen konnte.“"
                            },
                            {
                                "example_id": "2a0537c1-a6ea-44be-a4e9-6475da66e00f",
                                "sense_id": "07293ec2-3657-3eee-9671-9103aea04d3e",
                                "text": "„Dabremst hob i's nimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
