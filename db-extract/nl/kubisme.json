                        "source_sense_description": "20-eeuwse stroming binnen de beeldende kunst waarin de werkelijkheid op een sterk vereenvoudigde manier wordt weergegeven",
                        "target_lang_word": "Kubismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kubismus",
