                ],
                "senses": [
                    {
                        "sense_id": "da42e708-79d8-3fd9-9f08-6d63843919c9",
                        "entry_id": "6db83c88-0403-3944-b7dc-c801f216daa7",
                        "glosses": [
                            "van een zaak dat het uit verschillende lagen bestaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd4f365-5d8d-46f9-8607-ecb61764ff34",
                                "sense_id": "da42e708-79d8-3fd9-9f08-6d63843919c9",
                                "text": "Juventa '12 is verzekerd voor de opgelopen schade, maar gaat wel degelijk maatregelen nemen. \"We gaan gelaagd glas plaatsen in het clubhuis. Toch is dit nog steeds geen zekerheid. Het is gewoon heel lastig om zoiets tegen te houden.\""
                            },
                            {
                                "example_id": "a424d1a7-2085-4303-919c-cde335410e5e",
                                "sense_id": "da42e708-79d8-3fd9-9f08-6d63843919c9",
                                "text": "Het nieuwe kunstwerk meet 3,5 bij 1,10 meter en is gemaakt van gelaagd glas dat door Desirée Groot Koerkamp is beschilderd. De voorstelling heeft alles met het dopen te maken, de functie van deze hoek in de kerk ofschoon daar ook de overledenen worden opgebaard tijdens de dienst in de kerk."
                            }
                        ]
                    },
                    {
                        "sense_id": "396967b5-7031-332e-a0ac-3a75b56dc5a1",
                        "entry_id": "6db83c88-0403-3944-b7dc-c801f216daa7",
                        "glosses": [
                            "van een zaak dat het op veel verschillende manieren bekeken kan worden; dat het een rijke inhoud heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d779a54e-661a-4cc9-8f6e-68d74a0cece6",
                                "sense_id": "396967b5-7031-332e-a0ac-3a75b56dc5a1",
                                "text": "De Nienke van Hichtum-prijs voor jeugdliteratuur, die eens in de twee jaar wordt uitgereikt, gaat naar Benny Lindelauf voor zijn boek De hemel van Heivisj. De jury omschrijft het werk als 'een overrompelend gelaagd boek dat zich niet onder één noemer laat vangen.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fad2d23-036f-455c-8133-e2614c264b4e",
                        "source_entry_id": "6db83c88-0403-3944-b7dc-c801f216daa7",
                        "source_sense_id": "da42e708-79d8-3fd9-9f08-6d63843919c9",
                        "target_lang_word": "laminated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laminated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c73d45d-4c1c-361b-ba97-8648cc51adc2",
                                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                                        "glosses": [
                                            "Made by lamination."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96dde0c9-398b-4818-9bd7-c573be874d4a",
                                                "sense_id": "5c73d45d-4c1c-361b-ba97-8648cc51adc2",
                                                "text": "The accident was also one of several since Clapham [...] that demonstrated the role of breakable windows in the death toll. RSSB research would later confirm and reinforce the need for laminated glass to protect passengers and increase survivability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                                        "glosses": [
                                            "Consisting of many thin layers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec870e0-1a74-44f9-93c8-f2fe1c924c1b",
                                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                                "text": "A laminated arch is a timber arch made of layers of bent planks secured by treenails."
                                            },
                                            {
                                                "example_id": "73b340ce-a0e7-488b-a7e4-22717528906a",
                                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                                "text": "All springs for the engine and tender are of the laminated type with plates of carbon steel, which are secured in the spring buckles by a vertical centre rivet."
                                            },
                                            {
                                                "example_id": "dbd8784b-d06d-48a6-ae35-7e16d0ec153e",
                                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                                "text": "In general, steel springs were stipulated for primary suspension, although rubber was accepted for auxiliary springing; hydraulic dampers were specified and the use of laminated springs ruled out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "896b8a0f-e89d-38bb-a051-a377a94dea29",
                                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                                        "glosses": [
                                            "Splitting into thin layers parallel to bedding."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8b8d8b-90ad-4953-a3bf-d16d8a6cf3df",
                                                "sense_id": "896b8a0f-e89d-38bb-a051-a377a94dea29",
                                                "text": "Shale is laminated."
                                            }
                                        ]
                                    }
                                ]
                            },
