                        "entry_id": "79a3a4ef-5aeb-3640-8853-2428647af734",
                        "glosses": [
                            "Ort (an der Küste), an dem man sein Schiff, Jacht oder Boot festmachen, eventuell Fracht entladen und von Bord gehen kann"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "a586d9f2-3505-411d-8707-759a22f328ff",
                                "sense_id": "23a04cdb-49f0-3cdc-ae06-f2cd4326341d",
                                "text": "„Zollschiffsstationen sind örtliche Dienststellen der deutschen Bundeszollverwaltung mit Anlegeplätzen für Zollkreuzer und -boote.“"
                            },
                            {
                                "example_id": "7d103054-cd0d-41bf-b19d-bd84e2791a6f",
                                "sense_id": "23a04cdb-49f0-3cdc-ae06-f2cd4326341d",
                                "text": "Ein Schlepper zieht den Dampfer zu seinem Anlegeplatz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
