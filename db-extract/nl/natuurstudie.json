                        "examples": [
                            {
                                "example_id": "93d85daa-5741-461e-8290-9afa2a840015",
                                "sense_id": "8876e60e-0d40-38e8-9c94-e690e42d5edf",
                                "text": "Die Indische huiskraai leidt ons binnen in de wereld van de urbane natuurstudie waarmee we in het volgende hoofdstuk kennismaken."
                            },
                            {
                                "example_id": "b341e581-c0e2-4ca9-9f4c-e2c9bf5261a3",
                                "sense_id": "8876e60e-0d40-38e8-9c94-e690e42d5edf",
                                "text": "Maar Wevers zag dat niet zitten. \"Ik was lid van een jeugdbond voor natuurstudie en ik had een boek over de Wadden gekocht. De verhalen over wadlopen spraken mij meteen aan. Dat wilde ik gaan doen. En toen kwam dat plan om een dam naar Ameland aan te leggen. Ik dacht: dan kan ik daar niet meer wadlopen. Ik moest iets doen.\""
                            }
                        ]
                    }
