                        "glosses": [
                            "soziale Organisation der Kirchen mit Niederlassungen in/an Bahnhöfen zur Betreuung Bedürftiger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8e556e-fe13-4ef5-a61f-267c03a817a3",
                                "sense_id": "313ac522-8ca4-3db0-add1-f9e469a9ec5d",
                                "text": "„Keine Bahnhofsmission, kein Rotes Kreuz schenkt Kaffee oder eine warme Suppe aus.“"
                            },
                            {
                                "example_id": "85cb2d4b-367e-4fb5-95d2-5ec6873ceba4",
                                "sense_id": "313ac522-8ca4-3db0-add1-f9e469a9ec5d",
                                "text": "„Wir gingen durch den Wartesaal, sogar zur Bahnhofsmission, und ich erkundigte mich schließlich beim Beamten an der Sperre, ob vor kurzem ein Zug abgefahren sei.“"
                            }
                        ],
