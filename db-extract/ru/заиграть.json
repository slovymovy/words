                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5000590-9f1d-3cf8-abad-9187d53eaae0",
                        "entry_id": "1282dc55-6df8-38ff-92bd-ce93dc1c2fb4",
                        "glosses": [
                            "начать играть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f99ada0-1fa6-42e9-81ea-a9812c9207a8",
                                "sense_id": "b5000590-9f1d-3cf8-abad-9187d53eaae0",
                                "text": "Пожарники надули румяные щёки, чтобы заиграть на трубах прощальный марш."
                            },
                            {
                                "example_id": "aff31d81-2ba8-497f-879a-a6cd6646a789",
                                "sense_id": "b5000590-9f1d-3cf8-abad-9187d53eaae0",
                                "text": "Только на возвышении стоял рояль, и к нему подсел какой-то хмельной морячок и заиграл старинный вальс."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aac9c58-e5ac-3d90-9ee0-d6085b71db27",
                        "entry_id": "1282dc55-6df8-38ff-92bd-ce93dc1c2fb4",
                        "glosses": [
                            "перен. книжн. проявить себя с наилучшей стороны, во всём своём великолепии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ed2e67-7405-4bb4-91ed-47013753870d",
                                "sense_id": "6aac9c58-e5ac-3d90-9ee0-d6085b71db27",
                                "text": "Наизнанку вывернутые вещи вполне могут заиграть, как новые."
                            },
                            {
                                "example_id": "0bf57b24-9349-4cd1-810a-de7feaeecbf9",
                                "sense_id": "6aac9c58-e5ac-3d90-9ee0-d6085b71db27",
                                "text": "В конце концов дом наш заиграл, в него теперь приятно зайти, даже сотрудники «скорой помощи» говорят, что наш дом самый образцовый в городе..."
                            }
                        ]
                    },
                    {
                        "sense_id": "78ccee5a-cf47-3f58-bd5c-19602354bfe2",
                        "entry_id": "1282dc55-6df8-38ff-92bd-ce93dc1c2fb4",
                        "glosses": [
                            "разг. привести в негодность многократным использованием по назначению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "013c7e67-69ff-40f6-8916-47ef29ce837a",
                                "sense_id": "78ccee5a-cf47-3f58-bd5c-19602354bfe2",
                                "text": "Они слушали эту пластинку так часто, что в конце концов её совсем заиграли."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a814a91-591b-3d91-9788-e56a9b1df11f",
                        "entry_id": "1282dc55-6df8-38ff-92bd-ce93dc1c2fb4",
                        "glosses": [
                            "сленг присвоить; не возвратить взятую взаймы вещь хозяину"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a08d0f8-8533-4d9f-9c17-f84396ab8258",
                                "sense_id": "1a814a91-591b-3d91-9788-e56a9b1df11f",
                                "text": "Похоже, Ромка заиграл мой плеер."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
