                "senses": [
                    {
                        "sense_id": "847a79aa-5a93-321d-86ef-44740dd9aa60",
                        "entry_id": "44fcb118-e958-3865-af06-aebe2a5e5627",
                        "glosses": [
                            "spezifischer fachlicher Aufgabenbereich der Unteroffiziere und Mannschaften"
                        ],
                        "tags": [
                            "Deutsche Marine"
                        ],
                        "examples": [
                            {
                                "example_id": "a7ca4771-1374-463b-a6b1-cb554810c3c4",
                                "sense_id": "847a79aa-5a93-321d-86ef-44740dd9aa60",
                                "text": "„Der Soldat kann aber auch - nach Ablegung der erfolgreichen Prüfung - in eine andere, gleichwertige oder in eine höherwertige Verwendungsreihe überwechseln.“"
                            },
                            {
                                "example_id": "730df1c4-c0b3-4bf7-bf8c-9a367294b347",
                                "sense_id": "847a79aa-5a93-321d-86ef-44740dd9aa60",
                                "text": "„Auf Grund der unterschiedlichen Dienstposten- bzw. Planstellenausstattung in den einzelnen Ausbildungs- und Verwendungsreihen, die bestimmte militärische Tätigkeiten kennzeichnen, sind jedoch die Chancen der Hauptleute, je nach ihrer Verwendungsreihe auf einen herausgehobenen Dienstposten (A 12) eingewiesen zu werden, immer noch ungleich verteilt.“"
                            },
                            {
                                "example_id": "2bda3bba-3cf2-4325-92a1-c162dcfdb9cd",
                                "sense_id": "847a79aa-5a93-321d-86ef-44740dd9aa60",
                                "text": "„Falls der Bedarf einer AVR nicht mit den Bewerbern aus der entsprechenden Ausbildungs- und Verwendungsreihe gedeckt werden kann, besteht hier die Möglichkeit aus einer anderen Verwendungsreihe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
