                                                "example_id": "2eea8b15-f2c6-4adf-9677-84545d7a3170",
                                                "sense_id": "a852fa38-f17f-3b4c-a95b-4c89f6869cc0",
                                                "text": "Commençons notre périple en Italie du Nord. Les dialectes dits « gallo-italiques » se subdivisent en cinq groupes : lombard, piémontais, ligure, émilien et romagnol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea64ad96-665c-39c1-88c9-040afe8cde1f",
                                        "entry_id": "14ec6982-9634-3bc6-baa6-897dc0f67d25",
                                        "glosses": [
                                            "Ancienne langue parlée par le peuple Ligure pré-romain, au nord-ouest de l’Italie et au sud-est de la France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
