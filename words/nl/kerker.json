{
    "word_family": [
        "kerkeren",
        "gekerkerd"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc7c423b-2c11-3d4d-a2de-55d591b231cd",
                    "sense_definition": "een ondergrondse ruimte die bestemd is voor het opsluiten van gevangenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gevangenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief werd door de bewakers in de donkere <w>kerker</w> geworpen.",
                            "target_lang_translations": {
                                "en": "The thief was thrown into the dark <w>dungeon</w> by the guards."
                            }
                        },
                        {
                            "text": "In het oude kasteel bezochten de toeristen een vochtige <w>kerker</w> onder de grond.",
                            "target_lang_translations": {
                                "en": "In the old castle, the tourists visited a damp <w>dungeon</w> underground."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevangenis",
                        "strafcel",
                        "cachot"
                    ],
                    "common_phrases": [
                        "ondergrondse kerker",
                        "vochtige kerker"
                    ],
                    "target_lang_definitions": {
                        "en": "an underground room intended for the confinement of prisoners"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dungeon",
                                "target_lang_sense_clarification": "an underground prison cell, typically in a castle"
                            },
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "the innermost stronghold of a castle, often containing a prison"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "340a1441-2b5c-3d46-9bed-7ec4b4321bf0",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>kerkeren</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kerker</w> de gevangene volgens de oude wetten van dit land.",
                            "target_lang_translations": {
                                "en": "I <w>imprison</w> the prisoner according to the old laws of this country."
                            }
                        },
                        {
                            "text": "Als ik iemand <w>kerker</w> in dit verhaal, moet het wel geloofwaardig blijven.",
                            "target_lang_translations": {
                                "en": "If I <w>dungeon</w> someone in this story, it must remain believable."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present indicative of 'kerkeren' (to imprison in a dungeon)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imprison",
                                "target_lang_sense_clarification": "to put someone in a dungeon or prison"
                            },
                            {
                                "target_lang_word": "dungeon",
                                "target_lang_sense_clarification": "to confine someone in a dungeon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5f15be-087e-3a5b-a38d-88044cb76596",
                    "sense_definition": "gebiedende wijs van <w>kerkeren</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kerker</w> die verrader onmiddellijk en laat hem nooit meer vrij!",
                            "target_lang_translations": {
                                "en": "<w>Imprison</w> that traitor immediately and never set him free again!"
                            }
                        },
                        {
                            "text": "Luister naar mijn bevel en <w>kerker</w> iedereen die tegen de koning is.",
                            "target_lang_translations": {
                                "en": "Listen to my command and <w>dungeon</w> everyone who is against the king."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'kerkeren' (to imprison in a dungeon)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imprison",
                                "target_lang_sense_clarification": "command to put someone in a dungeon"
                            },
                            {
                                "target_lang_word": "dungeon",
                                "target_lang_sense_clarification": "command to confine someone in a dungeon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e471f4f9-8398-3f32-a7b7-b938e1eaa33d",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>kerkeren</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kerker</w> je die man alleen omdat hij een brood heeft gestolen?",
                            "target_lang_translations": {
                                "en": "Are you <w>imprisoning</w> that man just because he stole a loaf of bread?"
                            }
                        },
                        {
                            "text": "Waarom <w>kerker</w> je deze onschuldige mensen in je fantasieverhaal?",
                            "target_lang_translations": {
                                "en": "Why do you <w>dungeon</w> these innocent people in your fantasy story?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present indicative (inverted)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present indicative (inverted) of 'kerkeren' (to imprison in a dungeon)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imprison",
                                "target_lang_sense_clarification": "to put someone in a dungeon or prison"
                            },
                            {
                                "target_lang_word": "dungeon",
                                "target_lang_sense_clarification": "to confine someone in a dungeon"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}