                "senses": [
                    {
                        "sense_id": "b765031a-1dc6-38d2-b90b-4bd628164a30",
                        "entry_id": "82c02b23-56c6-3073-b1aa-b9eae071e479",
                        "glosses": [
                            "Not prejudiced."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d63c6f-5a22-4bd8-96b2-5a5fec519588",
                                "sense_id": "b765031a-1dc6-38d2-b90b-4bd628164a30",
                                "text": "On becoming a member of the College of Physicians, I made a tour of the principal cities of Europe, taking letters of introduction to eminent medical men; and gathering from many theories and modes of treatment, hints to enlarge the foundations of unprejudiced and comprehensive practice, I had resolved to fix my ultimate residence in London."
                            },
                            {
                                "example_id": "cfb7731d-5d50-4d0f-9e78-4bd5b26c599b",
                                "sense_id": "b765031a-1dc6-38d2-b90b-4bd628164a30",
                                "text": "But when it comes to capacity on the road, no unprejudiced observer can deny that Mr. Bulleid produced in these engines two designs that are capable of almost anything, whether in speed or load haulage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2b2e00e-7fdc-4b60-aedb-0d7126e3f850",
                        "source_entry_id": "82c02b23-56c6-3073-b1aa-b9eae071e479",
                        "source_sense_id": "b765031a-1dc6-38d2-b90b-4bd628164a30",
                        "source_sense_description": "not prejudiced",
                        "target_lang_word": "onbevooroordeeld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbevooroordeeld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dd36477b-3421-358e-bba9-6347e342a849",
                                        "entry_id": "a0d20c90-4162-3879-a2c8-bcbd4ce4cac4",
                                        "glosses": [
                                            "gebaseerd op waarnemingen en niet op veronderstellingen die men al van tevoren had toen men eigenlijk nog onvoldoende kennis van de zaak had"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40071072-4aec-43c9-8159-be7f1c6a3924",
                                                "sense_id": "dd36477b-3421-358e-bba9-6347e342a849",
                                                "text": "Individuele overtuigingen mogen natuurlijk de gelijke en rechtvaardige behandeling van medeburgers niet in de weg staan. Wie een openbare functie bekleedt, mag de eigen voorkeur nooit opdringen aan anderen. In een seculiere samenleving verwachten we alleen dat overheidsinstellingen zich onbevooroordeeld opstellen ­tegenover alle burgers. De overheid mag geen voorkeur laten blijken voor één ­levensbeschouwing én moet erop toezien dat iedereen de eigen levensbeschouwing kan opnemen zonder daarbij anderen voor het hoofd te stoten. Dat laatste is een heikel punt."
                                            },
                                            {
                                                "example_id": "dd436b79-16fc-4dd3-9900-6c4347a41273",
                                                "sense_id": "dd36477b-3421-358e-bba9-6347e342a849",
                                                "text": "Het proces tegen de zakenman was dus bij voorbaat spraakmakend. Het begon al met veel vertraging omdat het maar niet lukte een onbevooroordeelde jury te vinden. Want bijna iedereen kent Martin Shkreli en bijna iedereen haat hem. Van de 240 geselecteerde potentiële juryleden lieten er 200 weten dat ze geen eerlijk oordeel konden vellen over de fraude vanwege de beroerde reputatie van de verdachte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
