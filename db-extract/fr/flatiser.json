                "senses": [
                    {
                        "sense_id": "9c807630-c6e8-3e6c-b7bd-84c45cc86d60",
                        "entry_id": "ce064cfb-34ef-3136-9f5a-8f84764f5f86",
                        "glosses": [
                            "Simplifier un style graphique en éliminant par exemple les dégradés ou les ombres, et de façon générale tout ce qui semble superflu."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "729ca7af-5c8c-4a93-8c81-f7eab38bbed0",
                                "sense_id": "9c807630-c6e8-3e6c-b7bd-84c45cc86d60",
                                "text": "Google lui a emboité le pas avec le redesign de sa charte graphique… puis c'est Apple qui a “ﬂatisé” son iOS… IOS7-JQWC."
                            },
                            {
                                "example_id": "20f091e2-da39-4b84-aac0-845fb2faeb5d",
                                "sense_id": "9c807630-c6e8-3e6c-b7bd-84c45cc86d60",
                                "text": "Je suis en train de trifouiller mon userChrome.css pour essayer de \"flatiser\" Firefox, c'est assez fun."
                            },
                            {
                                "example_id": "6d08187d-f645-46ca-abf4-c767229302b2",
                                "sense_id": "9c807630-c6e8-3e6c-b7bd-84c45cc86d60",
                                "text": "Ce module propose de « flatiser » vos barres de notifications et de navigation, entre autres à la sauce Lollipop ou à la sauce iOS 7-8."
                            }
                        ]
                    }
