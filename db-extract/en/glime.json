                "senses": [
                    {
                        "sense_id": "6ca9f6d0-4892-31e0-9a53-3bd97d0a333e",
                        "entry_id": "600163e0-87ff-3cad-9219-c7efdac8c625",
                        "glosses": [
                            "To glance (at); to look sideways."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ed6feca-d8bc-4268-871d-9d59f782aaf9",
                                "sense_id": "6ca9f6d0-4892-31e0-9a53-3bd97d0a333e",
                                "text": "He was gliming at her from closer range now, and in her position—for he held her still—she could not help but glime back. He looked so humble—penitent for once, yet reproachful, his own eyes moist, and, withal, the old, audacious David, that in her own despite her anger waned."
                            },
                            {
                                "example_id": "4b469af2-7e78-4a1d-b01e-ffc73cbb0438",
                                "sense_id": "6ca9f6d0-4892-31e0-9a53-3bd97d0a333e",
                                "text": "And on Sunday evenings, while the Primitives were singing a hymn outside their chapel before going in for service, she would be tripping past, lightly shod, and wearing a hat with an ostrich feather, on her way to town, where a German band played sacred music on the promenade, and young people, walking arm-in-arm, laughed and \"glimed\" at each other under the gas-light."
                            },
                            {
                                "example_id": "875a0300-9af8-4e96-b7f4-917003b9bca5",
                                "sense_id": "6ca9f6d0-4892-31e0-9a53-3bd97d0a333e",
                                "text": "A silence falls in the four-wheeler for the rest of the road home. Felix looking straight ahead and concentrating on his driving. The girls asleep in each other's arms on the back seat. And me occasionally gliming in the rear-view mirror. The dark eyes of the Romany woman."
                            }
                        ]
                    }
