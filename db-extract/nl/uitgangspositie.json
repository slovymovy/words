                "senses": [
                    {
                        "sense_id": "e15118a4-8409-3a63-aac0-c7e17777c17f",
                        "entry_id": "fa3a8ec6-2bc0-3511-9848-e98e079402fc",
                        "glosses": [
                            "positie bij het begin van een actie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7c767a-0cc8-45f0-b0c0-0ebc3b775ffa",
                                "sense_id": "e15118a4-8409-3a63-aac0-c7e17777c17f",
                                "text": "Charleroi verspeelde na een Europese 3 op 3 een mooie uitgangspositie door twee nederlagen op rij."
                            },
                            {
                                "example_id": "09572975-2ada-4849-8bd9-30dcda6bec62",
                                "sense_id": "e15118a4-8409-3a63-aac0-c7e17777c17f",
                                "text": "Sterker nog, de adviseur schrijft zelfs: ,,Nu niet gekozen is voor een behoedzaam scenario als uitgangspositie bij het inschatten van de structurele groei, zouden alternatieven overwogen moeten worden om de gevolgen van tegenvallers op te vangen.” Extra ruimte reserveren op de begroting of toekomstige investeringen voorwaardelijk maken, kan volgens de RvS al verlichting bieden."
                            },
                            {
                                "example_id": "da3e7c38-d1fc-48b0-93f2-62c14f846d74",
                                "sense_id": "e15118a4-8409-3a63-aac0-c7e17777c17f",
                                "text": "Daarnaast kijk ik of de uitgangspositie van een model klopt door te zien of het weer van het moment juist wordt weergegeven. Komt er nu een koufront over, maar gebeurde dat volgens het model vier uur eerder, dan corrigeer ik daarvoor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d54381d-425b-4de6-861b-48a061812738",
                        "source_entry_id": "fa3a8ec6-2bc0-3511-9848-e98e079402fc",
                        "source_sense_id": "e15118a4-8409-3a63-aac0-c7e17777c17f",
