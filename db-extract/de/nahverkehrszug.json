                "senses": [
                    {
                        "sense_id": "802d307a-7384-37ee-976c-45c39ff73476",
                        "entry_id": "6e6b637f-a6fe-3c2c-b1bb-4bb520777a33",
                        "glosses": [
                            "Personenzug, der auf relativ kurzen Strecken (also nicht im Fernverkehr) fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e3a907-b708-42db-a5c4-09229cb46c41",
                                "sense_id": "802d307a-7384-37ee-976c-45c39ff73476",
                                "text": "Durch Göttingen fahren jeden Tag viele Nahverkehrszüge."
                            },
                            {
                                "example_id": "ff707ac7-d3a9-4c30-900a-fe04c6ee9565",
                                "sense_id": "802d307a-7384-37ee-976c-45c39ff73476",
                                "text": "„Es war nicht leicht, nach Quedlinburg zu kommen, man näherte sich der Stadt gemächlich, mit Nahverkehrszügen, musste ein paarmal an kleinen Stationen umsteigen.“"
                            },
                            {
                                "example_id": "7f7c4932-9e86-4dfa-8044-e990e2652062",
                                "sense_id": "802d307a-7384-37ee-976c-45c39ff73476",
                                "text": "„Er zog sich keineswegs in sein Atelier draußen am Waldrand zurück, wo er all die Dinge gehortet hatte, die er aus dem Krieg hatte mitgehen lassen, sondern er hielt sich viel in München auf, solange die Nahverkehrszüge noch fuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
