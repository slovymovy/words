                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "474b92c0-5cb8-45f5-a535-10fc5a734507",
                        "source_entry_id": "71ab3fdd-d073-3918-8ba4-181de7a8d22c",
                        "source_sense_id": "56721d12-43fd-3e3b-a4ee-6759743b3d88",
                        "target_lang_word": "matérialisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matérialisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7229bdc-ed3d-3d28-9d30-ea4b98f45f06",
                                        "entry_id": "ad0e9410-b0cc-3b04-992f-76602c45bad2",
                                        "glosses": [
                                            "Doctrine philosophique ou angle d’analyse politique qui ramène tout à la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d52211-f70c-412f-8956-b13596038710",
                                                "sense_id": "c7229bdc-ed3d-3d28-9d30-ea4b98f45f06",
                                                "text": "Enfin, même dans les ouvrages en langue vulgaire, comme dans la deuxième partie du Roman de la Rose, s’est montrée une extrême hardiesse, une extrême liberté de pensée, et jusqu’à une sorte de naturalisme et même de matérialisme prêché hautement, et mis dans la bouche de Genius, prêtre de la nature, …."
                                            },
                                            {
                                                "example_id": "7fb6a606-aa15-492f-bd79-a09fc56410e3",
                                                "sense_id": "c7229bdc-ed3d-3d28-9d30-ea4b98f45f06",
                                                "text": "La lutte des intérêts matériels et des principes moraux, de l’utilité et du devoir, du matérialisme et du spiritualisme, se représente ici avec une nouvelle force, et sous un point de vue encore plus important."
                                            },
                                            {
                                                "example_id": "239fa4fb-ce8e-492b-99d2-935882d87562",
                                                "sense_id": "c7229bdc-ed3d-3d28-9d30-ea4b98f45f06",
                                                "text": "Le matérialisme dialectique de Marx."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4258e693-74e9-3f25-8464-85536da80265",
                                        "entry_id": "ad0e9410-b0cc-3b04-992f-76602c45bad2",
                                        "glosses": [
                                            "Attitude générale ou comportement de celui qui s’attache avec jouissance aux biens, aux valeurs et aux plaisirs matériels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a16010c-33f2-4c0e-b524-ef39a81a13be",
                                                "sense_id": "4258e693-74e9-3f25-8464-85536da80265",
                                                "text": "Ils demeurent ensevelis dans le matérialisme d’une vie grossière, parce qu’ils ont désespéré de la vérité."
                                            },
                                            {
                                                "example_id": "c5c4db8a-ed6e-4594-903c-e7cc73f4965a",
                                                "sense_id": "4258e693-74e9-3f25-8464-85536da80265",
                                                "text": "Plus fière et plus anoblissante encore que les programmes imposés par la banalité officielle par les Larousses de tout acabit, enfin par cet hommage instinctif et timide rendu à l'idée courante par le matérialisme barbare et bourgeois."
                                            },
                                            {
                                                "example_id": "aaa2fc31-bcdf-4f9b-b5cf-07b03070d759",
                                                "sense_id": "4258e693-74e9-3f25-8464-85536da80265",
                                                "text": "Le matérialisme moderne, qui enrichit les uns et affame les autres, gagne toujours plus les esprits et pousse vers un scepticisme très dangereux pour l’avenir de l’humanité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e6af83b-3d5b-41ca-885b-3149c8f7728a",
                        "source_entry_id": "71ab3fdd-d073-3918-8ba4-181de7a8d22c",
                        "source_sense_id": "56721d12-43fd-3e3b-a4ee-6759743b3d88",
