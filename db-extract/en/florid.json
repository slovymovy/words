                        "entry_id": "7770894e-9be4-3046-b22f-3fad5a3b2f8f",
                        "glosses": [
                            "In a blatant, vivid, or highly disorganized state."
                        ],
                        "tags": [
                            "of a disorder"
                        ],
                        "examples": [
                            {
                                "example_id": "0cd02b2c-cce8-47b3-9eb8-57fe81513da5",
                                "sense_id": "d42688cd-9e79-3be7-b565-f6ef426e88e4",
                                "text": "florid psychosis"
                            },
                            {
                                "example_id": "22669188-64e8-497f-bcb0-1e15857657cc",
                                "sense_id": "d42688cd-9e79-3be7-b565-f6ef426e88e4",
                                "text": "His visions of their plans and his imminent detention were so florid that the reality, wherein he was unharmed and simply sitting in the cab of the RS-80 and continuing his slow work on the road, was far less plausible."
                            }
                        ]
                    },
                    {
                        "sense_id": "04cd3e60-665d-3e8d-bca3-25ee69284ab6",
                        "entry_id": "7770894e-9be4-3046-b22f-3fad5a3b2f8f",
                        "glosses": [
                            "Flourishing; in the bloom of health."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "21fd0a9c-63fe-4564-8e97-38238c80337c",
                                "sense_id": "04cd3e60-665d-3e8d-bca3-25ee69284ab6",
                                "text": "Mean while Peregrine guessing the good fortune of his friend, and allured by the attractions of the maid, who was a cleanly florid girl, employed his address to such effectual purpose, that she yielded to his efforts; and he was as happy as such a conquest could make him."
                            }
                        ]
                    }
