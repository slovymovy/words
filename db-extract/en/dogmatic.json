                                            {
                                                "example_id": "497204bd-846c-40a6-bbe3-0a4c4548dc48",
                                                "sense_id": "c3a45ffe-d887-3c39-8511-0506b76ab019",
                                                "text": "Hij bleek heel wat dogmatischer dan zijn voorganger."
