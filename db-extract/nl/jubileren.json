                        "cross_references": [
                            {
                                "target_word": "jubiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf0835a-3199-3d96-bb96-5285e3196d60",
                                        "entry_id": "503fefaf-7c3c-3ef6-8af6-969d926977da",
                                        "glosses": [
                                            "Se réjouir beaucoup d’une chose, éprouver une joie expansive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba70682e-e723-40af-a2ec-4d663b0775df",
                                                "sense_id": "2cf0835a-3199-3d96-bb96-5285e3196d60",
                                                "text": "– Mais vous, vous qui êtes, comme on vient de vous le dire, un des chefs du parti catholique dans le département, vous devez savoir que votre Dieu montrait jadis, aux âges bibliques, un goût assez vif pour les sacrifices humains et que l’odeur du sang lui était agréable. Il se réjouissait des massacres et jubilait dans les exterminations."
                                            },
                                            {
                                                "example_id": "3e8307f1-129e-492d-84f9-b772275e77bd",
                                                "sense_id": "2cf0835a-3199-3d96-bb96-5285e3196d60",
                                                "text": "À peine eus-je commencé d’écrire, je posai ma plume pour jubiler."
                                            },
                                            {
                                                "example_id": "4f5aea9c-9386-4d38-a605-6e2c00804966",
                                                "sense_id": "2cf0835a-3199-3d96-bb96-5285e3196d60",
                                                "text": "- On raconte que tu viens de clouer le bec au dirlo, jubile-t-il. C’est vrai que tu l’as traité de « merde copieuse » ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
