                        "cross_references": [
                            {
                                "target_word": "półton",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                                        "entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                                        "glosses": [
                                            "jeden z kolorów pośrednich między dwiema barwami podstawowymi"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981bb7c4-e865-4a79-9d93-4ffad6402928",
                                                "sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                                                "text": "Oliwkowy jest półtonem między żółtym a zielonym."
                                            },
                                            {
                                                "example_id": "0fc26e31-5202-47c9-beff-a95a2e26a965",
                                                "sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                                                "text": "W malarstwie typowo secesyjnym posługiwano się najczęściej liniami falistymi, operując półtonami, a jeśli już pełnymi barwami, to raczej zgaszonymi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                        "entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                                        "glosses": [
                                            "najmniejsza odległość między dwoma dźwiękami we współczesnym zachodnim systemie tonalnym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccecfa6c-46d9-402e-9e3a-e76b4b66e7c3",
                                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                                "text": "W stroju równomiernie temperowanym stosunek dwóch dźwięków w odległości półtonu jest równy ^(12])√."
                                            },
                                            {
                                                "example_id": "fdede2b1-d272-4573-b239-df0d22e69a61",
                                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                                "text": "Aby obniżyć dźwięk o półton, wystarczy dopisać do niego bemol, jeśli chcemy o tę samą wysokość podwyższyć dźwięk, używamy krzyżyka."
                                            },
                                            {
                                                "example_id": "477350f7-b577-406f-891d-728ac7b543b4",
                                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                                "text": "Kwinta czysta składa się z siedmiu półtonów."
                                            },
                                            {
                                                "example_id": "fbae50ab-79bd-46b5-85f9-8394476ee3c2",
                                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                                "text": "Półton składa się ze stu centów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
