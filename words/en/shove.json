                            {
                                "target_lang_word": "vsadit vše",
                                "target_lang_sense_clarification": "riskovat všechny žetony"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a54bf765-04b4-3a6f-9c0f-03d6b894677c",
                    "sense_definition": "To pass or distribute counterfeit money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang tried to <w>shove</w> the fake bills at the local market.",
                            "target_lang_translations": {
                                "ru": "Банда пыталась <w>сбыть</w> фальшивые купюры на местном рынке.",
                                "zh": "那伙人试图在当地市场<w>兜售假钞</w>。",
                                "cs": "Gang se pokusil <w>udat</w> falešné bankovky na místním trhu."
                            }
                        },
                        {
                            "text": "He was caught trying to <w>shove</w> bad currency.",
                            "target_lang_translations": {
                                "ru": "Его поймали при попытке <w>сбыть</w> фальшивую валюту.",
                                "zh": "他因试图<w>花假钞</w>而被抓获。",
                                "cs": "Byl chycen při pokusu <w>rozšiřovat</w> falešnou měnu."
                            }
                        }
