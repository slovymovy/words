                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>tech</w> the throw just in time to avoid taking damage.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>сбросить захват</w> как раз вовремя, чтобы избежать урона.",
                                "zh": "他及时<w>拆投</w>，避免了受到伤害。"
                            }
                        },
                        {
                            "text": "If you don't learn how to <w>tech</w>, you will lose against experienced players.",
                            "target_lang_translations": {
                                "ru": "Если ты не научишься <w>сбрасывать захваты</w>, ты будешь проигрывать опытным игрокам.",
                                "zh": "如果你不学会<w>拆投</w>，你就会输给经验丰富的玩家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tech the throw"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить маневр в файтингах, который отменяет атаку противника, например, бросок.",
                        "zh": "在格斗游戏中执行特定动作以抵消对手攻击（如投技）的操作。"
                    },
                    "translations": {
                        "ru": [
