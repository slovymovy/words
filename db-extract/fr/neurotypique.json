                "senses": [
                    {
                        "sense_id": "58a27bc3-9a58-3ed1-84e7-49acd3f7af37",
                        "entry_id": "c660bb3f-8e36-3290-bc70-d548e590ce2c",
                        "glosses": [
                            "neurotypical"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eedf065a-e92f-4d4b-afb9-887caed8beb0",
                                "sense_id": "58a27bc3-9a58-3ed1-84e7-49acd3f7af37",
                                "text": "Toux ceux et celles qui, comme moi, s'intéressent au développement du cerveau son conscients de l'importance de savoir repérer la différence entre une personne neurotypique et une autre neuro-atypique.",
                                "translation": "Those who, like me, are interested in the development of the brain are conscious of the importance of knowing how to spot the difference between a neurotypical person, and a neuro-atypical person.",
                                "english": "Those who, like me, are interested in the development of the brain are conscious of the importance of knowing how to spot the difference between a neurotypical person, and a neuro-atypical person."
                            },
                            {
                                "example_id": "20cd8401-2d0a-41c1-9e96-89df5905ed45",
                                "sense_id": "58a27bc3-9a58-3ed1-84e7-49acd3f7af37",
                                "text": "Ces gestes qui sollicitent le corps entier sont les premiers acquis chez enfant neurotypique, les étapes les plus complexes de l'habillage étant celles qui mettent en jeu les praxies fines.",
                                "translation": "These gestures which solicit the whole body are the first ones acquired by the neurotypical child, the most complex stages of dressing being the ones involving fine praxes.",
                                "english": "These gestures which solicit the whole body are the first ones acquired by the neurotypical child, the most complex stages of dressing being the ones involving fine praxes."
                            },
                            {
                                "example_id": "3a2caf5d-0424-4929-80a4-2eddf46e0270",
                                "sense_id": "58a27bc3-9a58-3ed1-84e7-49acd3f7af37",
                                "text": "Même si je suis neurotypique.",
                                "translation": "Even if I am neurotypical.",
                                "english": "Even if I am neurotypical."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
