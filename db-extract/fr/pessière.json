                                "target_word": "Fichtenwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09abb2b5-b4e4-34a5-878b-ab725e17e71d",
                                        "entry_id": "a4d9e1c0-0613-3a4f-827f-75d4e587c1af",
                                        "glosses": [
                                            "überwiegend aus Fichten bestehender Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dbe2704-60fa-4e6d-8dc2-398a29d0d8b8",
                                                "sense_id": "09abb2b5-b4e4-34a5-878b-ab725e17e71d",
                                                "text": "„Wir bogen von der Straße ab in dünnen Fichtenwald.“"
                                            },
                                            {
                                                "example_id": "b5f664dd-faa3-4f3a-97e8-df0df2b06115",
                                                "sense_id": "09abb2b5-b4e4-34a5-878b-ab725e17e71d",
                                                "text": "„Dunkle Fichtenwälder breiten sich an den Talhängen.“"
                                            },
                                            {
                                                "example_id": "f3568aa5-e37d-4776-8243-5996f0a54e1f",
                                                "sense_id": "09abb2b5-b4e4-34a5-878b-ab725e17e71d",
                                                "text": "„Sie hatten sorgfältig die Wohnungen der Weißen vermieden und waren ohne Hindernisse am vierzehnten Tage nach ihrem Aufbruche im Angesichte eines jener ungeheuern Fichtenwälder angelangt, die sich von der südlichsten Kette der Appalachen hinüberstrecken gegen den Staat Mississippi.“"
                                            }
                                        ],
