    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f02cfc0-46af-33aa-a07a-4c6b18167beb",
                    "sense_definition": "A single distinct physical object or thing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please place each <w>item</w> in the correct recycling bin.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положите каждый <w>предмет</w> в соответствующий мусорный бак.",
                                "tr": "Lütfen her <w>eşyayı</w> doğru geri dönüşüm kutusuna koyun."
                            }
                        },
                        {
                            "text": "She bought a few small <w>items</w> at the grocery store.",
                            "target_lang_translations": {
                                "ru": "Она купила несколько мелких <w>вещей</w> в продуктовом магазине.",
                                "tr": "Marketten birkaç küçük <w>şey</w> satın aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "object",
                        "thing",
                        "article"
                    ],
                    "common_phrases": [
                        "single item",
                        "collector's item",
                        "household item",
                        "luxury item"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный физический объект или вещь.",
                        "tr": "Ayrı ve belirgin bir fiziksel nesne veya eşya."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет",
                                "target_lang_sense_clarification": "общий термин для физического объекта"
                            },
                            {
                                "target_lang_word": "вещь",
                                "target_lang_sense_clarification": "бытовой предмет или покупка"
                            },
                            {
                                "target_lang_word": "штука",
                                "target_lang_sense_clarification": "разговорное; отдельный экземпляр"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eşya",
                                "target_lang_sense_clarification": "fiziksel nesne, nesne"
                            },
                            {
                                "target_lang_word": "üretim nesnesi",
                                "target_lang_sense_clarification": "fiziksel nesne"
                            },
                            {
                                "target_lang_word": "parça",
                                "target_lang_sense_clarification": "tekil eşya veya birim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae350a7d-305a-365e-8a89-0155e55260cc",
                    "sense_definition": "A separate particular detail or entry in a list, account, or document.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "list_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check every <w>item</w> on the bill carefully before paying.",
                            "target_lang_translations": {
                                "ru": "Внимательно проверьте каждую <w>позицию</w> в счёте перед оплатой.",
                                "tr": "Ödemeden önce faturadaki her <w>kalemi</w> dikkatlice kontrol edin."
                            }
                        },
                        {
                            "text": "We need to address the first <w>item</w> in the contract.",
                            "target_lang_translations": {
                                "ru": "Нам нужно обсудить первый <w>пункт</w> договора.",
                                "tr": "Sözleşmedeki ilk <w>maddeyi</w> ele almamız gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "article",
                        "entry",
                        "point"
                    ],
                    "common_phrases": [
                        "line item",
                        "item on the list",
                        "menu item"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная запись, деталь или строка в списке, счёте или документе.",
                        "tr": "Bir liste, hesap veya belgedeki ayrı bir ayrıntı veya öge."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пункт",
                                "target_lang_sense_clarification": "в списке или договоре"
                            },
                            {
                                "target_lang_word": "позиция",
                                "target_lang_sense_clarification": "в счёте, каталоге или номенклатуре"
                            },
                            {
                                "target_lang_word": "наименование",
                                "target_lang_sense_clarification": "название товара или услуги в списке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "madde",
                                "target_lang_sense_clarification": "listedeki ayrıntı veya öge"
                            },
                            {
                                "target_lang_word": "kalem",
                                "target_lang_sense_clarification": "fatura veya hesaptaki satır"
                            },
                            {
                                "target_lang_word": "öge",
                                "target_lang_sense_clarification": "liste elemanı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "595b6db3-d436-3627-ade0-bfff9f7ad4a3",
                    "sense_definition": "A specific matter or subject to be discussed, often as part of an agenda.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The next <w>item</w> for discussion concerns the annual budget.",
                            "target_lang_translations": {
                                "ru": "Следующий <w>вопрос</w> для обсуждения касается годового бюджета.",
                                "tr": "Tartışılacak sonraki <w>konu</w> yıllık bütçeyi ilgilendiriyor."
                            }
                        },
                        {
                            "text": "We have one last <w>item</w> to cover before the meeting ends.",
                            "target_lang_translations": {
                                "ru": "Нам осталось разобрать ещё один <w>пункт</w> до окончания собрания.",
                                "tr": "Toplantı bitmeden önce ele almamız gereken son bir <w>gündem maddesi</w> var."
                            }
                        }
                    ],
                    "synonyms": [
                        "subject",
                        "topic"
                    ],
                    "common_phrases": [
                        "agenda item",
                        "next item",
                        "item of business"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный вопрос или тема для обсуждения, часто как часть повестки дня.",
                        "tr": "Genellikle bir gündemin parçası olarak tartışılacak belirli bir konu veya husus."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "тема для обсуждения"
                            },
                            {
                                "target_lang_word": "пункт",
                                "target_lang_sense_clarification": "часть повестки дня"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gündem maddesi",
                                "target_lang_sense_clarification": "toplantıda tartışılacak konu"
                            },
                            {
                                "target_lang_word": "konu",
                                "target_lang_sense_clarification": "tartışma maddesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a692839c-19c1-3d3c-aeac-2f48ac2a43e4",
                    "sense_definition": "A short piece of news or an article in a newspaper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "news",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you see that <w>item</w> about the local election in today's paper?",
                            "target_lang_translations": {
                                "ru": "Ты видел ту <w>заметку</w> о местных выборах в сегодняшней газете?",
                                "tr": "Bugünkü gazetede yerel seçimlerle ilgili o <w>haberi</w> gördün mü?"
                            }
                        },
                        {
                            "text": "The magazine printed a small <w>item</w> regarding the charity event.",
                            "target_lang_translations": {
                                "ru": "Журнал напечатал небольшое <w>сообщение</w> о благотворительном мероприятии.",
                                "tr": "Dergide hayır kurumu etkinliğiyle ilgili küçük bir <w>yazı</w> yayımlandı."
                            }
                        }
