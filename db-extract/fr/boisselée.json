                        "sense_id": "c3e31e47-dd21-317e-b92d-42b1d746ecc9",
                        "entry_id": "10f453dd-97ae-3b50-8dfc-624e8d9f999b",
                        "glosses": [
                            "Surface qu’un boisseau peut ensemencer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf39ac9-03a4-4a72-b5cb-e991a632abaa",
                                "sense_id": "c3e31e47-dd21-317e-b92d-42b1d746ecc9",
                                "text": "On calcula qu’en trois jours chaque homme avait mangé une boisselée de grain, sans compter la viande et les légumes […]"
                            },
                            {
                                "example_id": "54928d8c-8054-4ba3-9018-563b4badca0b",
                                "sense_id": "c3e31e47-dd21-317e-b92d-42b1d746ecc9",
                                "text": "Ils avaient là une maison, un jardin, un pré dont ils vendaient le foin et cinq ou six boisselées de plaine : autant qu'il en fallait pour les occuper, car, si Hortense restait jeune de tournure et de volonté, il en allait autrement pour Misanger."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e4997c1-ff46-3295-8816-d1e4cd0f082c",
                        "entry_id": "10f453dd-97ae-3b50-8dfc-624e8d9f999b",
                        "glosses": [
                            "Ancienne unité de superficie autrefois usitée en France."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2eb75fc7-f576-44d9-901f-4f66c0654b9f",
                                "sense_id": "1e4997c1-ff46-3295-8816-d1e4cd0f082c",
                                "text": "La boisselée, 9ᵉ de la setérée, contenait 12 ½ perches carrées de 22 pieds de roi de côté."
                            },
                            {
                                "example_id": "09ee1c65-944f-4cbe-9a4a-ae23cae5c73a",
                                "sense_id": "1e4997c1-ff46-3295-8816-d1e4cd0f082c",
                                "text": "Quant aux 4 septérées, de 8 boisselées chacune, elles mesurent 4x8x12 = 374 ares ou 3 hectares 74."
                            }
                        ]
                    }
