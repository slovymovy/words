                "senses": [
                    {
                        "sense_id": "8161b783-0963-347f-892c-9e0f51709cf8",
                        "entry_id": "a3238f23-30e7-38e5-b223-75fc8f9d0586",
                        "glosses": [
                            "Tige de fer qui sert à attiser le foyer d’une cheminée, d’un poêle, d’une chaudière à vapeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dfb3921-49fc-4ba8-ad4a-665217671c4e",
                                "sense_id": "8161b783-0963-347f-892c-9e0f51709cf8",
                                "text": "Le père Larache l’avait attrapé par son sarrau, entre les épaules, et lui administrait une râclée sur les jambes, à coups de pique-feu."
                            },
                            {
                                "example_id": "af79e769-d6f3-4c44-aa75-f8ea708968b1",
                                "sense_id": "8161b783-0963-347f-892c-9e0f51709cf8",
                                "text": "Elle ramena successivement des planches, deux tréteaux, une caisse en assez bon état, deux casseroles, des boîtes de fer-blanc, un seau, un pique-feu, une pelle à charbon et dix billes de chêne pour servir de sièges, une pour chacun."
                            },
                            {
                                "example_id": "e466183b-9ca5-4e96-b4d0-75274d6f4ceb",
                                "sense_id": "8161b783-0963-347f-892c-9e0f51709cf8",
                                "text": "Quand il eut accroché le pique-feu à la barre de cuivre, il reprit sa place et répéta :\n— Cette fois, c’est bien l’hiver."
                            }
                        ]
                    }
                ],
