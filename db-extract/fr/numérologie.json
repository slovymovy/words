                                    {
                                        "sense_id": "502051af-167a-3b4f-86f6-57e553153f06",
                                        "entry_id": "e214be92-a36a-3fdd-9cd2-d092998e282b",
                                        "glosses": [
                                            "een vorm van waarzeggerij die zich bezighoudt met enerzijds esoterische, symbolische aspecten van getallen, en anderzijds met bredere interpretaties van getallensymboliek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b75c726-3c47-4cbf-aefd-3c2a500de1a4",
                                                "sense_id": "502051af-167a-3b4f-86f6-57e553153f06",
                                                "text": "Het ging al langer slecht met Dennis G. Hij had medicijnen tegen psychoses, maar nam die niet altijd in omdat hij vond dat hij daarmee niet goed kon functioneren. Hij was geobsedeerd door spiritisme, numerologie, spirituele en occulte zaken."
                                            },
                                            {
                                                "example_id": "9356dffa-3a91-4f9a-91c7-1fbf5146b3b4",
                                                "sense_id": "502051af-167a-3b4f-86f6-57e553153f06",
                                                "text": "De bezoekers struinen langs tafels waar tientallen aanbieders van healing, numerologie, tarotkaarten lezen, ontspanningsmassage, aurafotografie, edelstenen en nog veel meer zich presenteren."
                                            },
                                            {
                                                "example_id": "6e97d742-7580-4258-b113-c5190eb0fec3",
                                                "sense_id": "502051af-167a-3b4f-86f6-57e553153f06",
                                                "text": "Op de website van De Kas staat te lezen dat het goed denkbaar is dat bezoekers ook de gelegenheid krijgen om kennis te maken met „astrologie, tarotkaart leggen, handlezen, numerologie, auralezen, iriscopie” en dergelijke paranormale activiteiten die „steeds normaler worden gevonden.” De paranormale activiteiten zullen plaatsvinden in het wellnessgedeelte, dat bestemd is voor de ouders van de bezoekende kinderen."
                                            }
                                        ]
                                    }
