                                                "sense_id": "ea82cfbb-893b-3a8c-8a51-28e05f338175",
                                                "text": "Un rempart assuré."
                                            },
                                            {
                                                "example_id": "9ef55cce-c35a-4190-9707-71f4d01ae763",
                                                "sense_id": "ea82cfbb-893b-3a8c-8a51-28e05f338175",
