                                            {
                                                "example_id": "25eef6d2-0838-4fa2-9155-6f36c59efc29",
                                                "sense_id": "5f11eed0-5d53-3941-bdb8-e032e01f3fef",
                                                "text": "Portsmouth was Charles Dickens’ birthplace."
                                            },
                                            {
                                                "example_id": "62a5faae-1043-4e19-b504-ff8b2e5c4643",
                                                "sense_id": "5f11eed0-5d53-3941-bdb8-e032e01f3fef",
                                                "text": "At Scotswood, the main line crosses to the south bank of the Tyne, but an alternative route, on the north side of the river, used by a few trains, rejoins the Carlisle line beyond North Wylam, the birthplace of George Stephenson."
                                            }
                                        ]
                                    },
