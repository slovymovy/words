                        "cross_references": [
                            {
                                "target_word": "Jackson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc458a9-7a90-38d9-95c3-97701a117696",
                                        "entry_id": "bc015f9a-8da3-32a8-8bc2-e209ea7c59f4",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "015cd4d6-290a-4e8f-830d-5508afdbd9f9",
                                                "sense_id": "8dc458a9-7a90-38d9-95c3-97701a117696",
                                                "text": "In his cast of characters, you really see a disproportionate focus, I think, on Black women - on Kamala Harris, who he's insinuated only has her job today because of who she dated; to Judge Ketanji Brown Jackson, who he's demanded the LSAT scores of - I don't recall him demanding the LSAT scores for Brett Kavanaugh - Karine Jean-Pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09a919d4-d6e2-3eb1-99f0-b439b3b253a9",
                                        "entry_id": "bc015f9a-8da3-32a8-8bc2-e209ea7c59f4",
                                        "glosses": [
                                            "A surname originating as a patronymic.",
                                            "Andrew Jackson, President of the United States (1829–1837)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5bcc90f-a867-3c5d-9085-1d086e1963f4",
                                        "entry_id": "bc015f9a-8da3-32a8-8bc2-e209ea7c59f4",
                                        "glosses": [
                                            "A surname originating as a patronymic.",
                                            "Michael Jackson, singer and entertainer (1958–2009)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c055685-aa26-336f-ab54-971785532c21",
                                        "entry_id": "bc015f9a-8da3-32a8-8bc2-e209ea7c59f4",
                                        "glosses": [
                                            "A male given name transferred from the surname."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "947ded22-14cb-46c6-b4e2-d37a980cc04b",
                                                "sense_id": "5c055685-aa26-336f-ab54-971785532c21",
                                                "text": "Francis was named for his mother's father and Jackson himself was named for his father's mother. Not that his grandmother was called Jackson, of course - it was a maiden name (Margaret Jackson) and it was a Scottish tradition, his father informed him."
                                            },
                                            {
                                                "example_id": "b17309a7-0837-4d28-8907-55519323447e",
                                                "sense_id": "5c055685-aa26-336f-ab54-971785532c21",
                                                "text": "The sixth victim was identified as Jackson Sparks, 8, according to his family’s GoFundMe page. “This afternoon, our dear Jackson has sadly succumbed to his injuries and passed away,” an update posted to the page said days after the attack."
                                            }
                                        ]
                                    },
