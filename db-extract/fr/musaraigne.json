                "senses": [
                    {
                        "sense_id": "f1406d19-09fb-3737-9111-431de394c088",
                        "entry_id": "625d3173-f89e-3868-8c78-5bb8488ea2b4",
                        "glosses": [
                            "Espèce de petit mammifère carnassier, insectivore, de la famille des soricidés, à peu près de la grosseur d’une souris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04136215-02a3-4ec0-97a8-37433969ab1c",
                                "sense_id": "f1406d19-09fb-3737-9111-431de394c088",
                                "text": "Les musaraignes, petites souris microscopiques, grosses comme une noisette, se hasardaient hors de leur trou, et dessinaient sur le sol de capricieuses bigarrures du bout de leur petite queue pointue."
                            }
                        ]
                    },
                    {
                        "sense_id": "549b8718-a231-3407-888c-92f4fc53e844",
                        "entry_id": "625d3173-f89e-3868-8c78-5bb8488ea2b4",
                        "glosses": [
                            "Variante de musaraigne commune (mammifère insectivore)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0744cd3d-4801-4889-90d3-102e34938625",
                        "source_entry_id": "625d3173-f89e-3868-8c78-5bb8488ea2b4",
                        "target_lang_word": "Spitzmaus",
