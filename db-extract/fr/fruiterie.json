        "fr-extract.jsonl": [
            {
                "entry_id": "ad6946b0-62e6-37c1-b963-e103b6fb7469",
                "word": "fruiterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10a719b6-e753-43fe-9d0e-a4edb801ca95",
                        "entry_id": "ad6946b0-62e6-37c1-b963-e103b6fb7469",
                        "tags": [
                            "plural"
                        ],
                        "form": "fruiteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82f86fc6-a018-33de-acca-5a90255287e9",
                        "entry_id": "ad6946b0-62e6-37c1-b963-e103b6fb7469",
                        "glosses": [
                            "Lieu, entrepôt où l’on garde, où l’on conserve le fruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b3025a-5253-4759-88c6-fc469c703b20",
                                "sense_id": "82f86fc6-a018-33de-acca-5a90255287e9",
                                "text": "Porter du fruit à la fruiterie."
                            },
                            {
                                "example_id": "ed6b264a-ef67-470a-8ed6-0fed6294f9ea",
                                "sense_id": "82f86fc6-a018-33de-acca-5a90255287e9",
                                "text": "Serrer du fruit dans la fruiterie."
                            },
                            {
                                "example_id": "710c07cf-7b49-493c-a503-46615ccfef20",
                                "sense_id": "82f86fc6-a018-33de-acca-5a90255287e9",
                                "text": "En Norvège, on a publié des résultats d'essais entrepris pendant ces dernières années. Nous remarquons que les fruiteries aménagées de manière à pouvoir régler la ventilation selon les nécessités, ont donnés de meilleurs résultats que les caves."
                            },
                            {
                                "example_id": "43f3b951-b4c9-4391-ad12-89d62657e76b",
                                "sense_id": "82f86fc6-a018-33de-acca-5a90255287e9",
                                "text": "Ils déambulaient dans les buanderies sonores, dans les soutes à bois, dans les soutes à charbon, dans les fruiteries où, sur des claies superposées, s’alignaient sans fin pommes et poires, dans les laiteries aux odeurs sures où s’amoncelaient les mottes de beurre frais glorieusement marquées d’une empreinte humide, les bidons de lait, les jattes de crème fraîche, de fromage blanc, de cancoillotte."
                            }
                        ]
                    },
                    {
                        "sense_id": "3430176a-16aa-3cce-9b7c-fb9a5d17681d",
                        "entry_id": "ad6946b0-62e6-37c1-b963-e103b6fb7469",
                        "glosses": [
                            "Boutique où l’on vend au détail des fruits, du fromage, du beurre, etc."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "41778e76-f614-474d-b8f3-1a987edd25a0",
                                "sense_id": "3430176a-16aa-3cce-9b7c-fb9a5d17681d",
                                "text": "Cette gamine vicieuse et prétentieuse est la fille d’une grosse commère qui tenait, naguère, une fruiterie dans les environs du Barbès."
                            },
                            {
                                "example_id": "4d7b9447-f8be-4f04-ae29-ce89f0198e46",
                                "sense_id": "3430176a-16aa-3cce-9b7c-fb9a5d17681d",
                                "text": "Alors j’apercevais sur un étroit pan de mur, entre une fruiterie et une cordonnerie, quelque chose qui ressemblait vaguement à un entrelacement de triangles ou de cercles, et qui me disait pour moi tout seul : « Je suis passée ici lundi. Je pensais bien à toi, et je t’ai envoyé un baiser »."
                            }
                        ]
                    },
                    {
                        "sense_id": "50b184c7-3961-369b-9a9e-b096fe97b7b8",
                        "entry_id": "ad6946b0-62e6-37c1-b963-e103b6fb7469",
                        "glosses": [
                            "Commerce au détail des fruits, du fromage, du beurre."
                        ],
                        "tags": [
                            "broadly",
                            "collectively"
                        ],
                        "examples": [
                            {
                                "example_id": "e8ca7c2d-19bf-4f20-b8e7-5b08fa04b320",
                                "sense_id": "50b184c7-3961-369b-9a9e-b096fe97b7b8",
                                "text": "Il a été plusieurs années dans la fruiterie."
                            }
                        ]
                    }
