                                        "entry_id": "ef7aa289-e4ba-3190-8d52-c0b254e06093",
                                        "glosses": [
                                            "A daughter of Tantalus, said to have turned into stone while weeping for her children."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbd13338-53be-3477-be71-04bbf0d546ce",
                                        "entry_id": "ef7aa289-e4ba-3190-8d52-c0b254e06093",
                                        "glosses": [
                                            "A daughter of Phoroneus and Teledice."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6afa73f-a6f1-30cf-8976-02dee32add73",
                                        "entry_id": "ef7aa289-e4ba-3190-8d52-c0b254e06093",
                                        "glosses": [
                                            "71 Niobe, a main belt asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "383cfb43-edd3-340b-8ee7-2248739fe92d",
                                        "entry_id": "ef7aa289-e4ba-3190-8d52-c0b254e06093",
