                "senses": [
                    {
                        "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                        "entry_id": "8935f34e-6144-32e3-8939-4e22e48457b6",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6243ffe9-7318-461d-bcf0-1589cdd2893f",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Frau Schwämmle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8523fac1-0407-4a2e-9ef5-664d25b7af79",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Herr Schwämmle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "844fa1f7-7b88-45d6-a7c7-497c505cb458",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Die Schwämmles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "54d42cce-d843-41fc-aac8-87246cb98298",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Der Schwämmle trägt nie die Pullover, die die Schwämmle ihm strickt."
                            },
                            {
                                "example_id": "f659b539-6e05-4a1d-913b-af87332f1936",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwämmle kommt, geht der Herr Schwämmle.“"
                            },
                            {
                                "example_id": "88cadfd4-21c4-42d1-9f96-a2f639246938",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Schwämmle kommt und geht."
                            },
                            {
                                "example_id": "bba8b14a-c460-4927-b62e-377b82eec3dc",
                                "sense_id": "a6bb3d2c-1af4-3f8d-8bb3-52038ab96fd2",
                                "text": "Schwämmles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
