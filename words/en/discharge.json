{
    "word_family": [
        "charger",
        "recharge",
        "overcharge",
        "surcharge",
        "undercharge",
        "discharger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea4445bd-6ea6-3017-b407-c06d839e392f",
                    "sense_definition": "To officially allow someone to leave a hospital because they no longer need treatment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor decided to <w>discharge</w> the patient after his fever finally went down.",
                            "target_lang_translations": {
                                "ru": "Врач решил <w>выписать</w> пациента после того, как у него наконец спала температура."
                            }
                        },
                        {
                            "text": "She was happy to be <w>discharged</w> from hospital just in time for the holidays.",
                            "target_lang_translations": {
                                "ru": "Она была счастлива, что её <w>выписали</w> из больницы как раз к праздникам."
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "let go"
                    ],
                    "antonyms": [
                        "admit"
                    ],
                    "common_phrases": [
                        "discharged from hospital",
                        "ready for discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально разрешить кому-либо покинуть больницу, так как пациент больше не нуждается в лечении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выписывать",
                                "target_lang_sense_clarification": "из больницы"
                            },
                            {
                                "target_lang_word": "выписать",
                                "target_lang_sense_clarification": "из больницы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2ae8e45-4314-37d3-8149-e97b3a4eb79c",
                    "sense_definition": "To officially dismiss someone from a job, position, or the armed forces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier was honorably <w>discharged</w> after serving ten years in the army.",
                            "target_lang_translations": {
                                "ru": "Солдат был <w>уволен</w> в запас с почестями после десяти лет службы в армии."
                            }
                        },
                        {
                            "text": "The company had to <w>discharge</w> several employees due to the recent budget cuts.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось <w>уволить</w> нескольких сотрудников из-за недавнего сокращения бюджета."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismiss",
                        "fire",
                        "sack",
                        "terminate"
                    ],
                    "antonyms": [
                        "hire",
                        "recruit",
                        "enlist"
                    ],
                    "common_phrases": [
                        "honorably discharged",
                        "dishonorable discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально уволить кого-либо с работы, должности или со службы в вооруженных силах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увольнять",
                                "target_lang_sense_clarification": "с работы или службы"
                            },
                            {
                                "target_lang_word": "уволить",
                                "target_lang_sense_clarification": "с работы или службы"
                            },
                            {
                                "target_lang_word": "демобилизовать",
                                "target_lang_sense_clarification": "из армии"
                            },
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "от должности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65d4b18a-3e83-39c9-9098-dbcc10347efc",
                    "sense_definition": "To fire a gun or other weapon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is illegal to <w>discharge</w> a firearm within the city limits.",
                            "target_lang_translations": {
                                "ru": "Запрещено <w>стрелять</w> из огнестрельного оружия в черте города."
                            }
                        },
                        {
                            "text": "The officer had to <w>discharge</w> his weapon to stop the dangerous animal.",
                            "target_lang_translations": {
                                "ru": "Офицеру пришлось <w>применить</w> оружие, чтобы остановить опасное животное."
                            }
                        }
                    ],
                    "synonyms": [
                        "fire",
                        "shoot"
                    ],
                    "common_phrases": [
                        "discharge a firearm",
                        "accidental discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произвести выстрел из пистолета или другого оружия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелять",
                                "target_lang_sense_clarification": "из оружия"
                            },
                            {
                                "target_lang_word": "выстрелить",
                                "target_lang_sense_clarification": "из оружия"
                            },
                            {
                                "target_lang_word": "разряжать",
                                "target_lang_sense_clarification": "оружие выстрелом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67bbd975-128e-3df3-b0b3-98039de0657a",
                    "sense_definition": "To send out a substance, such as liquid, gas, or waste, into the environment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory was fined for <w>discharging</w> toxic chemicals into the local river.",
                            "target_lang_translations": {
                                "ru": "Завод был оштрафован за <w>сброс</w> токсичных химикатов в местную реку."
                            }
                        },
                        {
                            "text": "The pipe <w>discharges</w> water directly into the cooling tank.",
                            "target_lang_translations": {
                                "ru": "Труба <w>сливает</w> воду прямо в охлаждающий бак."
                            }
                        }
                    ],
                    "synonyms": [
                        "emit",
                        "release",
                        "excrete"
                    ],
                    "antonyms": [
                        "absorb"
                    ],
                    "common_phrases": [
                        "discharge waste",
                        "discharge into water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрасывать вещество, такое как жидкость, газ или отходы, в окружающую среду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "отходы или газы"
                            },
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "жидкость"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "газ или пар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1273876-24ea-38a6-8b83-83f4e7ac1acc",
                    "sense_definition": "To release electricity from a battery or other storage device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The battery will <w>discharge</w> quickly if you leave the screen brightness on high.",
                            "target_lang_translations": {
                                "ru": "Аккумулятор быстро <w>разрядится</w>, если оставить яркость экрана на высоком уровне."
                            }
                        },
                        {
                            "text": "A capacitor can <w>discharge</w> its stored energy in a fraction of a second.",
                            "target_lang_translations": {
                                "ru": "Конденсатор может <w>высвободить</w> накопленную энергию за долю секунды."
                            }
                        }
                    ],
                    "antonyms": [
                        "charge"
                    ],
                    "common_phrases": [
                        "battery discharge",
                        "fully discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высвобождать электричество из батареи или другого накопительного устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разряжать",
                                "target_lang_sense_clarification": "аккумулятор или конденсатор"
                            },
                            {
                                "target_lang_word": "разрядить",
                                "target_lang_sense_clarification": "аккумулятор или конденсатор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "981f6a2c-68b7-3b3f-a71c-501ccd5d2ac9",
                    "sense_definition": "To perform or fulfill a duty, responsibility, or legal obligation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked hard to <w>discharge</w> his duties as the head of the committee.",
                            "target_lang_translations": {
                                "ru": "Он усердно работал, чтобы <w>исполнять</w> свои обязанности главы комитета."
                            }
                        },
                        {
                            "text": "The executor must <w>discharge</w> the responsibilities outlined in the will.",
                            "target_lang_translations": {
                                "ru": "Исполнитель должен <w>выполнить</w> обязательства, изложенные в завещании."
                            }
                        }
                    ],
                    "synonyms": [
                        "fulfill",
                        "perform",
                        "execute"
                    ],
                    "antonyms": [
                        "neglect"
                    ],
                    "common_phrases": [
                        "discharge duties",
                        "discharge responsibilities"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять или исполнять обязанность, ответственность или юридическое обязательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполнять",
                                "target_lang_sense_clarification": "обязанности"
                            },
                            {
                                "target_lang_word": "исполнять",
                                "target_lang_sense_clarification": "долг или функции"
                            },
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "полномочия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f9f9f64-3733-3178-8183-4cf740a0893d",
                    "sense_definition": "The official act of allowing someone to leave a hospital or the military.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was given a full medical <w>discharge</w> after his recovery.",
                            "target_lang_translations": {
                                "ru": "Пациенту была выдана полная медицинская <w>выписка</w> после его выздоровления."
                            }
                        },
                        {
                            "text": "He received an honorable <w>discharge</w> after his term of service ended.",
                            "target_lang_translations": {
                                "ru": "Он получил почетное <w>увольнение</w> со службы после окончания срока службы."
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "dismissal"
                    ],
                    "antonyms": [
                        "admission",
                        "enlistment"
                    ],
                    "common_phrases": [
                        "hospital discharge",
                        "honorable discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный акт разрешения кому-либо покинуть больницу или военную службу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выписка",
                                "target_lang_sense_clarification": "из больницы"
                            },
                            {
                                "target_lang_word": "увольнение",
                                "target_lang_sense_clarification": "в запас или отставку"
                            },
                            {
                                "target_lang_word": "демобилизация",
                                "target_lang_sense_clarification": "из армии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb9110c4-58b1-36fa-9c9d-fb6576adba30",
                    "sense_definition": "A liquid substance that comes out of a part of the body, often due to infection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked if there was any yellow <w>discharge</w> from the wound.",
                            "target_lang_translations": {
                                "ru": "Врач спросил, были ли желтые <w>выделения</w> из раны."
                            }
                        },
                        {
                            "text": "A thick <w>discharge</w> from the eyes can be a sign of an allergy.",
                            "target_lang_translations": {
                                "ru": "Густые <w>выделения</w> из глаз могут быть признаком аллергии."
                            }
                        }
                    ],
                    "synonyms": [
                        "secretion",
                        "exudate"
                    ],
                    "common_phrases": [
                        "vaginal discharge",
                        "nasal discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкое вещество, выходящее из части тела, часто вследствие инфекции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделение",
                                "target_lang_sense_clarification": "из раны или органа"
                            },
                            {
                                "target_lang_word": "гной",
                                "target_lang_sense_clarification": "инфекционное выделение"
                            },
                            {
                                "target_lang_word": "сукровица",
                                "target_lang_sense_clarification": "прозрачное выделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22182d5d-e16f-3ddd-a679-8950f6c224c5",
                    "sense_definition": "The act of firing a gun or the release of a projectile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>discharge</w> of a firearm startled everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>выстрел</w> из огнестрельного оружия напугал всех в комнате."
                            }
                        },
                        {
                            "text": "Police are investigating the negligent <w>discharge</w> of a weapon in the park.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует неосторожное <w>применение</w> оружия в парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "firing",
                        "shot"
                    ],
                    "common_phrases": [
                        "negligent discharge",
                        "accidental discharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт выстрела из оружия или выпуск снаряда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выстрел",
                                "target_lang_sense_clarification": "из оружия"
                            },
                            {
                                "target_lang_word": "разряд",
                                "target_lang_sense_clarification": "оружия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2edec84b-894d-3e01-961c-24a25f14b646",
                    "sense_definition": "The act of performing a duty or paying off a debt.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>discharge</w> of his financial obligations took several years of hard work.",
                            "target_lang_translations": {
                                "ru": "<w>Погашение</w> его финансовых обязательств заняло несколько лет упорного труда."
                            }
                        },
                        {
                            "text": "She was praised for the faithful <w>discharge</w> of her duties as a trustee.",
                            "target_lang_translations": {
                                "ru": "Её похвалили за добросовестное <w>исполнение</w> обязанностей доверенного лица."
                            }
                        }
                    ],
                    "synonyms": [
                        "fulfillment",
                        "performance",
                        "payment"
                    ],
                    "antonyms": [
                        "default"
                    ],
                    "common_phrases": [
                        "discharge of duties",
                        "discharge of debt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт выполнения долга или погашения долга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполнение",
                                "target_lang_sense_clarification": "обязанностей"
                            },
                            {
                                "target_lang_word": "исполнение",
                                "target_lang_sense_clarification": "обязательств"
                            },
                            {
                                "target_lang_word": "выплата",
                                "target_lang_sense_clarification": "долга"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}