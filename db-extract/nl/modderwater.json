                            {
                                "example_id": "55a873bc-e3dd-431a-86a2-5a3eb18641b2",
                                "sense_id": "b07c8957-c7f7-3f6d-9d20-390b9af47910",
                                "text": "De stad Brisbane adviseert inwoners hun drinkwater te koken. De drinkwatervoorziening in de plaats is ontregeld door grote hoeveelheden modderwater in de Brisbane Rivier."
                            },
                            {
                                "example_id": "02dd4502-f8fe-4840-80a0-78f407f131f8",
                                "sense_id": "b07c8957-c7f7-3f6d-9d20-390b9af47910",
                                "text": "De twee maken zelf ook een wijntje . Die smaakt best goed, maar ziet er niet zo lekker uit („Het lijkt een beetje op modderwater”)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7333692a-e18d-41c5-9fe6-cd67f3b15495",
                        "source_entry_id": "c9fd5c1e-0241-366a-9a1f-52c93de26771",
                        "source_sense_id": "b07c8957-c7f7-3f6d-9d20-390b9af47910",
                        "source_sense_description": "door modder verontreinigd water",
                        "target_lang_word": "Schmutzwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmutzwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b8667a-b01a-36a3-b897-a830632aed61",
                                        "entry_id": "78bf4600-9e89-380b-93c0-874e23764306",
                                        "glosses": [
                                            "durch Gebrauch verunreinigtes Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d64636d-3deb-4181-a0d6-6a67f409d09e",
                                                "sense_id": "e2b8667a-b01a-36a3-b897-a830632aed61",
                                                "text": "„Die Abwassergebühren werden getrennt nach Niederschlagswasser und Schmutzwasser berechnet.“"
                                            },
                                            {
                                                "example_id": "f2ee6466-20d2-41b8-a7b2-2fb75684fb58",
                                                "sense_id": "e2b8667a-b01a-36a3-b897-a830632aed61",
                                                "text": "„Für die Einleitung von Schmutzwasser in die öffentliche Kanalisation wird eine Gebühr erhoben, die an die bezogene Trinkwassermenge (Frischwassermenge) gekoppelt ist.“"
                                            },
                                            {
                                                "example_id": "8719ce55-c99f-4538-b09f-599f18e35b3d",
                                                "sense_id": "e2b8667a-b01a-36a3-b897-a830632aed61",
                                                "text": "„Die Stadt erhebt zur Deckung der Kosten Gebühren für das Einleiten, Entwässern, Entleeren und Behandeln von Niederschlagswasser, Schmutzwasser, Schlamm aus Kleinkläranlagen sowie Abwässer aus Gruben.“"
                                            },
                                            {
                                                "example_id": "563fa5c0-9ff0-44bb-8753-77706b096db6",
                                                "sense_id": "e2b8667a-b01a-36a3-b897-a830632aed61",
                                                "text": "„Kleineinleitungen von Schmutzwasser aus Haushaltungen und ähnlichem Schmutzwasser unter acht Kubikmeter pro Tag bleiben abgabefrei, wenn der Bau der Abwasserbehandlungsanlage mindestens dem Stand der Technik (S.d.T.) entspricht und die ordnungsgemäße Schlammbehandlung sichergestellt ist (§ 8 Abs. 2 AbwAG).“"
                                            },
                                            {
                                                "example_id": "f5ec026e-348f-4cce-9525-5810f86f5ed4",
                                                "sense_id": "e2b8667a-b01a-36a3-b897-a830632aed61",
                                                "text": "„Ein durch den Gebrauch verunreinigtes Wasser wird als Schmutzwasser (Abwasser) bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
