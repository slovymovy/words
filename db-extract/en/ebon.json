                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "037916bb-8973-4f1d-8d32-2a2949d6e923",
                        "entry_id": "b6530c4f-51bf-3a35-b5d8-507e09c6e8d4",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ebon"
                    },
                    {
                        "form_id": "ea70985e-c1e3-4ac5-b35e-892324537fe6",
                        "entry_id": "b6530c4f-51bf-3a35-b5d8-507e09c6e8d4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ebon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0a7f692-4e31-30e9-8387-65797be9dcc6",
                        "entry_id": "b6530c4f-51bf-3a35-b5d8-507e09c6e8d4",
                        "glosses": [
                            "Made of ebony."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "a43827ec-c020-4d59-a713-3993d1e345f6",
                                "sense_id": "c0a7f692-4e31-30e9-8387-65797be9dcc6",
                                "text": "“A stranger knight,” sayd he, “unknowne by name, / But knowne by fame, and by an Hebene speare […].”"
                            },
                            {
                                "example_id": "cd9827c5-3dad-4393-ae81-eb7796b2e9fa",
                                "sense_id": "c0a7f692-4e31-30e9-8387-65797be9dcc6",
                                "text": "Night, sable goddess! from her ebon throne, / In rayless majesty, now stretches forth / Her leaden sceptre o'er a slumb'ring world."
                            }
                        ]
                    },
                    {
                        "sense_id": "a61736cf-6930-3c30-9b0f-0c84c72791a9",
                        "entry_id": "b6530c4f-51bf-3a35-b5d8-507e09c6e8d4",
                        "glosses": [
                            "Black in colour."
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "1d42b804-b03e-4c90-9a73-4e917971fe74",
                                "sense_id": "a61736cf-6930-3c30-9b0f-0c84c72791a9",
                                "text": "...flowers stood beside, in an alabaster vase—exotics, that say, \"our growth has been precious.\" A lute leant against the ebon stand; but the face of the lady wore the expression of deep and touching sorrow."
                            }
                        ]
                    },
                    {
                        "sense_id": "350b45a2-6ddb-3e43-a73b-cdf026562e4c",
                        "entry_id": "b6530c4f-51bf-3a35-b5d8-507e09c6e8d4",
                        "glosses": [
                            "Having dark skin; black."
                        ],
                        "tags": [
                            "literary",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "3979dfb4-92c5-4aae-910f-b4228f8e68b8",
                                "sense_id": "350b45a2-6ddb-3e43-a73b-cdf026562e4c",
                                "text": "Woona had silently and swiftly backed away; and her ebon face, Ursula saw, had changed into leaden flabbiness with some horrible fear."
                            },
                            {
                                "example_id": "5424aa3d-59b2-48f2-a132-301500c1689b",
                                "sense_id": "350b45a2-6ddb-3e43-a73b-cdf026562e4c",
                                "text": "With the quickness of thought his spear arm flew back, and then shot forward with all the force of the sinewy muscles that rolled beneath the shimmering ebon hide. True to its mark the iron-shod weapon flew, transfixing Numa’s sleek carcass from the right groin to beneath the left shoulder."
                            }
                        ]
                    }
                ],
