                "senses": [
                    {
                        "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                        "entry_id": "716b0834-4fa2-33bd-997a-6e7ccbc3110d",
                        "glosses": [
                            "Person, die sich wissenschaftlich mit Bildung beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6895081-2c0e-49c2-ac26-7989b7bc3216",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Der in Lehrerkreisen nicht unumstrittene Bildungsforscher Hans Brügelmann befasste sich bereits 2006 mit dem Thema Notenbeurteilung.“"
                            },
                            {
                                "example_id": "b7305929-f5e8-4d34-a78f-d1d366df2077",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Dieses Zitat von Bildungsforscher Michael Kerres zeigt auf, dass Digitalisierung in deutschen Schulen nicht nur durch neue Technik gelingen kann.“"
                            },
                            {
                                "example_id": "885d5eb6-c6dd-45c7-9c58-4774e25d8478",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„So ist diese Thematik nicht nur für Lehrende, Bildungsforscher oder Politiker relevant, sondern auch für jeden Lernenden.“"
                            },
                            {
                                "example_id": "2d569d8e-1c39-41fa-b045-87e27ae7af5b",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Der neuseeländische Bildungsforscher John Hattie stellte im Jahr 2009 in seiner Monographie ‚Visible Learning‘ die Frage, welche Merkmale für das schulische Lernen besonders entscheidend sind.“"
                            },
                            {
                                "example_id": "5db75467-751c-4fa4-b928-a22aaa928070",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Die Corona-Folgen für Kinder sollen gemildert werden: Die Bundesregierung will zwei Milliarden Euro in schulische und soziale Förderprogramme stecken – ein Bildungsforscher kritisiert das als nicht nachhaltig.“"
                            },
                            {
                                "example_id": "715935ef-dd52-440a-b112-1eeefba3900c",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Bildungsforscher testen dabei alle drei Jahre weltweit in repräsentativen Stichproben die Leistungen von 15 Jahre alten Schülern.“"
                            },
                            {
                                "example_id": "b454c841-9c9e-4a23-a31a-a4ce048b70d7",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Bildungsforscher und Politiker waren überzeugt davon, dass sie noch am besten mit den ganz unterschiedlichen Schülern und Leistungsständen zurechtkommt.“"
                            },
                            {
                                "example_id": "3c8fd3fd-bc8c-463d-9b04-07a1cd847760",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Bildungsforscher fragen sich schon seit längerem, warum eine häufige Nutzung digitaler Medien in der Schule für schulbezogene Zwecke negativ mit den Informations- und Kommunikations-Kompetenzen (IKT) der Schüler beim Lesen korreliert.“"
                            },
                            {
                                "example_id": "1b545b0b-7019-4fef-9088-a25cf699951b",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Bildungsforscher und Kultusminister wissen, warum sie einen echten Vergleich der Abiture, der einzubringenden Leistungen in der Oberstufe scheuen.“"
                            },
                            {
                                "example_id": "fffbea5f-aa22-40eb-ae85-f3419e81e222",
                                "sense_id": "f1165fab-a828-3ebf-b92d-2cfd547b5cd2",
                                "text": "„Das bemängeln viele Bildungsforscher, und eine andere Berufsgruppe, die besonders nah am Geschehen ist, sieht das genauso: die Lehrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
