                    }
                ],
                "senses": [
                    {
                        "sense_id": "0252a5e4-a996-35e8-abe0-a4b2cb6772bb",
                        "entry_id": "49056331-c4b8-3c02-96e0-403fd83770dc",
                        "glosses": [
                            "разг. крайне грязная, неопрятная обстановка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff61062-bfb2-456f-93f6-cf8cf02a9a35",
                                "sense_id": "0252a5e4-a996-35e8-abe0-a4b2cb6772bb",
                                "text": "Вытри, чтобы сесть за стол можно было по-человечески. Убери это свинство..."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6eed96b-9036-3448-a5f3-d3445c1952b9",
                        "entry_id": "49056331-c4b8-3c02-96e0-403fd83770dc",
                        "glosses": [
                            "перен., разг. низменные привычки, невежество, бескультурье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "379e0ca2-f660-400a-a0c8-f689a38c182e",
                                "sense_id": "b6eed96b-9036-3448-a5f3-d3445c1952b9",
                                "text": ".. с утра до вечера точно кабак! только и делают, что водку пьют... ведь это свинство!"
                            }
                        ]
                    },
                    {
                        "sense_id": "00383973-faa8-325b-82b9-591fd4fbbb34",
                        "entry_id": "49056331-c4b8-3c02-96e0-403fd83770dc",
                        "glosses": [
                            "перен., разг. непорядочный, низкий поступок, подлость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca4a820-55a9-4d19-ae63-4be05a2ddfcd",
                                "sense_id": "00383973-faa8-325b-82b9-591fd4fbbb34",
                                "text": "Война — самое большое свинство, которое когда-либо изобрёл род человеческий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b1ee3e2-76fe-4944-ad3d-d7a15e3c2178",
                        "source_entry_id": "49056331-c4b8-3c02-96e0-403fd83770dc",
                        "target_lang_word": "Schweinerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7775d655-976f-3a0d-9113-7bd22ced5ad8",
                                        "entry_id": "ff052d9e-1e77-392c-b7e5-a31253298884",
                                        "glosses": [
                                            "grobe Verunreinigung, schmutziger Zustand von Gegenständen oder Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdffa55-4f73-4859-b24a-5e812b9678df",
                                                "sense_id": "7775d655-976f-3a0d-9113-7bd22ced5ad8",
                                                "text": "Kürzlich ist mir in der Küche eine Dose Tomaten auf den Boden gefallen und aufgeplatzt – das war vielleicht eine Schweinerei!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cc9b6448-b5c7-3df0-b7c7-373fdb490727",
                                        "entry_id": "ff052d9e-1e77-392c-b7e5-a31253298884",
                                        "glosses": [
                                            "moralisch verwerfliche Handlung, unerträglicher Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f266743-3146-4b1e-97f3-90bb7ee0be60",
                                                "sense_id": "cc9b6448-b5c7-3df0-b7c7-373fdb490727",
                                                "text": "„Es war doch eine Schweinerei, träumte er weiter. Da hatte man ein Gehalt von ein paar hundert Franken im Monat, es langte wohl, es langte ganz gut. Und für das lumpige Gehalt war man verpflichtet, den Kanalräumer zu spielen. Ärger als das. Man mußte schnüffeln, anderer Leute Missetaten aufdecken, man mußte sich überall hineinmischen, keinen Augenblick hatte man Ruhe […].“"
                                            },
                                            {
                                                "example_id": "ee64424d-d3f0-4db5-ae85-83f3584c536a",
                                                "sense_id": "cc9b6448-b5c7-3df0-b7c7-373fdb490727",
                                                "text": "„Ich erwiderte nein, ich sei auch ohne Partei damals in Deutschland ins KZ geraten, weil ich mir auch ohne Partei manche Schweinerei nicht gefallen ließ.“"
                                            },
                                            {
                                                "example_id": "acd97efc-38ab-4be9-af14-4eb73767e165",
                                                "sense_id": "cc9b6448-b5c7-3df0-b7c7-373fdb490727",
                                                "text": "„In Berlin lief es zweieinhalb Jahre lang, in anderen Städten wurde es als Schweinerei, Verhöhnung der deutschen Frau, der Kriegsverletzten, der deutschen Studenten, des deutschen Beamtentums beschimpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c0d1c2c-27ed-3995-a4d2-83020897d18a",
                                        "entry_id": "ff052d9e-1e77-392c-b7e5-a31253298884",
                                        "glosses": [
                                            "sexuell Anstößiges, Unzüchtiges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae6df6b-7fd7-4669-a8e0-bff6ca322265",
                                                "sense_id": "9c0d1c2c-27ed-3995-a4d2-83020897d18a",
                                                "text": "Deinen Arbeitskollegen möchte ich bei meiner Geburtstagsfeier nicht sehen; wenn er betrunken ist, gibt er den ganzen Abend nur Schweinereien von sich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
