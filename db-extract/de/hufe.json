                    {
                        "sense_id": "59feae09-954a-353e-9a08-a63e14e59379",
                        "entry_id": "77f5f440-6eea-39a7-aefc-508384016d3e",
                        "glosses": [
                            "altes Flächenmaß, das etwa sechs bis achtzehn Hektar entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9ef0fb-df96-4f77-92da-041764df2cb6",
                                "sense_id": "59feae09-954a-353e-9a08-a63e14e59379",
                                "text": "Das Feld war zwei Hufen groß."
                            },
                            {
                                "example_id": "7f54467c-4cba-43a3-9ee7-7091aa5d67b5",
                                "sense_id": "59feae09-954a-353e-9a08-a63e14e59379",
                                "text": "„Die Lokatoren warben die Siedler, brachten sie an Ort und Stelle, teilten ihnen ihre »Hufen« zu, unterstützten sie während der schweren Anfangsjahre und erhielten dafür große Privilegien: abgabefreies Eigengut, Zinsen von einem Teil der Hufen, den Vorsitz im niederen Gericht und so fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f40544-77ac-4249-a39a-2a76b46e9ca8",
