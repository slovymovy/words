                                "target_senses": [
                                    {
                                        "sense_id": "8802158e-c5c9-30a2-a967-5a3bf6968e71",
                                        "entry_id": "20b66ee2-ac5a-370a-8b3a-8d5427a2622b",
                                        "glosses": [
                                            "bogini łowów i przyrody, łączona z Selene, Hekate i Persefoną oraz utożsamiana z rzymską Dianą"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "381c9e7c-4f66-4d09-a718-f0cb40c27af3",
                                                "sense_id": "8802158e-c5c9-30a2-a967-5a3bf6968e71",
                                                "text": "Apollo i Artemida, oboje strzelający niechybnie z łuku, uchodzili za dawców nagłej śmierci."
                                            },
                                            {
                                                "example_id": "1b202c9b-ceb3-4f6d-a905-2bfddb5dbdbb",
                                                "sense_id": "8802158e-c5c9-30a2-a967-5a3bf6968e71",
                                                "text": "Atrybutami Artemidy były: kołczan, strzały, łuk, łania, jeleń i niedźwiedź."
                                            },
                                            {
                                                "example_id": "cfb2fc98-ba47-4115-9aba-c57e716859e0",
                                                "sense_id": "8802158e-c5c9-30a2-a967-5a3bf6968e71",
                                                "text": "Obrażona bogini poskarżyła się Apollinowi i Artemidzie, którzy zabili strzałami z łuku dzieci Niobe"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2733148d-ebc0-4b5c-b574-cba4a8a9a75c",
                        "source_entry_id": "314df3fd-fe73-3eda-af8b-7e4d5c3bb086",
