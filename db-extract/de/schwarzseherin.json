                            {
                                "example_id": "15f6c32d-9ea5-4454-bcfb-3c7ad8fe8c52",
                                "sense_id": "d49fd24c-0fdb-3fb2-811c-90f61831002f",
                                "text": "Sie war schon immer eine Schwarzseherin"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "489f627b-eab8-35c0-85c8-721a3e5257d7",
                        "entry_id": "a1594cae-da62-3259-a3b0-e93575b6e7c9",
