                "senses": [
                    {
                        "sense_id": "d6c1776f-94f2-3321-bc9e-60fbda3600d7",
                        "entry_id": "62d4ded5-a986-36bd-8d57-36ee3a432145",
                        "glosses": [
                            "To typeset by exposing type characters onto photographic film, which is then used to generate printing plates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc934a7-bb20-4d3b-802e-928bf142b7dd",
                                "sense_id": "d6c1776f-94f2-3321-bc9e-60fbda3600d7",
                                "text": "These concordances have been filmset, a process by which material is composed on film guided by appropriate programs that sense in the input stream \"escape codes\" which indicate a change in type font, size, or special characters."
                            },
                            {
                                "example_id": "025c8c33-991e-4a2b-a29b-550a52cd3c62",
                                "sense_id": "d6c1776f-94f2-3321-bc9e-60fbda3600d7",
                                "text": "The electronic capabilities of today's new typesetting programs enable us to filmset type with optimum lines - comparable with the setting of Johannes Gutenberg's famous 42-line Bible."
                            }
                        ]
                    }
