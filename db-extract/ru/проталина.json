                "senses": [
                    {
                        "sense_id": "996d883a-4c11-3ae2-96ee-55837ccbedeb",
                        "entry_id": "94d6f95e-0902-39b9-9566-664d757d51da",
                        "glosses": [
                            "место, где растаял снежный или ледяной покров и обнажилось то, что было под ним"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e113c77b-a069-4d63-b1ef-07e209aeb8e5",
                                "sense_id": "996d883a-4c11-3ae2-96ee-55837ccbedeb",
                                "text": "Апрель берёт своё: везде лужи, везде бегут мутные ручьи, зачернели проталины, как грязные пятна на белой скатерти."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28aac93b-b9ba-490f-914d-a50821b80ea6",
                        "source_entry_id": "94d6f95e-0902-39b9-9566-664d757d51da",
                        "source_sense_id": "996d883a-4c11-3ae2-96ee-55837ccbedeb",
                        "target_lang_word": "glade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db7c0d8-a51c-3039-9e52-ae7d00cebf2d",
                                        "entry_id": "01b13469-b1c8-378a-804b-e8049cdf3d60",
                                        "glosses": [
                                            "An open passage through a wood; a grassy open or cleared space in a forest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f27c5a13-5347-451f-9805-0ada49c2e76e",
                                                "sense_id": "2db7c0d8-a51c-3039-9e52-ae7d00cebf2d",
                                                "text": "[…] are creating more \"glades,\" or cleared trails through the woods, for less experienced (blue) skiers. They're a throwback to the first days of skiing, before resorts cut wide swaths of trees, and machines rolled and packed the snow."
                                            },
                                            {
                                                "example_id": "15090507-62e3-4421-926f-bf217cadd847",
                                                "sense_id": "2db7c0d8-a51c-3039-9e52-ae7d00cebf2d",
                                                "text": "[…] and meads and glades so eternally vernal, that the grass shot up by the spring, untrodden, unwilted, remains at midsummer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0b83611-9028-38a0-89e8-c9acbefb37ea",
                                        "entry_id": "01b13469-b1c8-378a-804b-e8049cdf3d60",
                                        "glosses": [
                                            "An everglade."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
