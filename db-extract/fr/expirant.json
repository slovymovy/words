                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee441cd0-5fd1-3c60-83f5-1b126ac6c22e",
                        "entry_id": "8ccae0bb-04c4-3001-810b-240f0f9ab928",
                        "glosses": [
                            "Qui expire, qui est près d’expirer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f795c307-6abf-4f07-b5f4-9647fbb310ca",
                                "sense_id": "ee441cd0-5fd1-3c60-83f5-1b126ac6c22e",
                                "text": "Zopire est expirant, et ce peuple éperdu levait déjà son front dans la poudre abattu."
                            },
                            {
                                "example_id": "51e4e9ce-2558-4a33-8be9-faf41ef75e3e",
                                "sense_id": "ee441cd0-5fd1-3c60-83f5-1b126ac6c22e",
                                "text": "Cependant Gillonne […] avait déjà essuyé et parfumé la poitrine du jeune homme et en avait fait autant de ses bras modelés sur un dessin antique, de ses épaules gracieusement rejetées en arrière, de son cou ombragé de boucles épaisses et qui appartenait bien plutôt à une statue de marbre de Paros qu’au corps mutilé d’un homme expirant."
                            }
                        ]
                    },
                    {
                        "sense_id": "73bb3e8e-e995-32f6-bf3a-93c6f78b70db",
                        "entry_id": "8ccae0bb-04c4-3001-810b-240f0f9ab928",
                        "glosses": [
                            "Qui va cesser d’être."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "81c81916-5202-41cb-8eed-b01a75bce89f",
                                "sense_id": "73bb3e8e-e995-32f6-bf3a-93c6f78b70db",
                                "text": "Son bonichon couleur de fraise glissa en avant, sa voix semblait expirante."
                            },
                            {
                                "example_id": "7f11af85-5c83-41e2-af37-68b0145f789b",
                                "sense_id": "73bb3e8e-e995-32f6-bf3a-93c6f78b70db",
                                "text": "Hurtaud laissa échapper un petit rire, doux et léger comme un son de flûte, un petit rire qui gonflait et faisait onduler, sur sa cuisse, les plis de son ventre, d’un mouvement de vague expirante."
                            },
                            {
                                "example_id": "f5591dfa-9269-489f-89ee-6a53b8afab18",
                                "sense_id": "73bb3e8e-e995-32f6-bf3a-93c6f78b70db",
                                "text": "Les Bretons qui se consacrent à « raviver par la science la nationalité de leur pays » n’ont été accueillis, note-t-il [Michelet], satisfait, que par la risée, « défenseurs expirants d’une langue expirante », condamnés sans appel, comme le bonhomme Système de Renan, par l’histoire."
                            }
                        ]
                    }
                ],
