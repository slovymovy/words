                "senses": [
                    {
                        "sense_id": "793cb17a-013a-30cd-9c16-a57180719e76",
                        "entry_id": "309b24d5-f6dd-3229-963d-1b23cb12bfd9",
                        "glosses": [
                            "het verschil tussen de huidige en de gewenste stand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d51e881-dd89-45c3-a575-eac43633c12f",
                                "sense_id": "793cb17a-013a-30cd-9c16-a57180719e76",
                                "text": "Na de plaspauze stond de wielrenner op 2 minuten achterstand t.o.v. het kopgroepje."
                            },
                            {
                                "example_id": "62965c15-a819-4e35-b38a-c5a293724b94",
                                "sense_id": "793cb17a-013a-30cd-9c16-a57180719e76",
                                "text": "Na zijn ziekte had hij een behoorlijke achterstand met zijn werk."
                            },
                            {
                                "example_id": "04224da1-acf9-4eb3-8aa2-47c3458089ff",
                                "sense_id": "793cb17a-013a-30cd-9c16-a57180719e76",
                                "text": "Omdat ik de afgelopen zeven jaar schematisch gezien een behoorlijke achterstand heb opgelopen, ben ik vandaag weer begonnen."
                            },
                            {
                                "example_id": "7874222a-4a16-4776-bd7e-c777aade4ab3",
                                "sense_id": "793cb17a-013a-30cd-9c16-a57180719e76",
                                "text": "Rotterdam wil achterstanden bij leerlingen van de basisschool wegwerken door tijdens vakanties les te geven. De leerprestaties van leerlingen blijven ver achter bij die van leerlingen in de rest van Nederland. Daarom is dit jaar de vakantieschool geïntroduceerd."
                            }
                        ]
                    }
