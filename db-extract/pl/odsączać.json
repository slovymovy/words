                                        "entry_id": "4cdb1ee6-fc61-3b79-ad4e-339b23f3b199",
                                        "glosses": [
                                            "feste Bestandteile von Flüssigkeit mittels Sieb oder Tuch trennen, insbesondere bei der Lebensmittelzubereitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b9aeae-6347-4230-9eee-d98c9f1d2816",
                                                "sense_id": "178d389e-7447-30e4-bf57-03c5c9021e9e",
                                                "text": "Weiße Spargel komplett, grüne nur im unteren Drittel schälen. Schalen und Abschnitte in 2 l Wasser zusammen mit Zucker und Salz 15 Min. auskochen, abseihen, Flüssigkeit auffangen."
                                            },
                                            {
                                                "example_id": "32460194-1895-48aa-bf76-bc06add048bb",
                                                "sense_id": "178d389e-7447-30e4-bf57-03c5c9021e9e",
                                                "text": "Restliche Kochflüssigkeit durch ein Passiertuch (noch besser: durch einen Superbag mit 100 Mikrometer Maschenweite) abseihen."
                                            },
                                            {
                                                "example_id": "54a72e4f-eb59-47c7-a27d-5733ade78c62",
                                                "sense_id": "178d389e-7447-30e4-bf57-03c5c9021e9e",
                                                "text": "Schwarze Linsen in Salzwasser mit Kümmel und Lorbeerblatt weich kochen, abseihen, in Butter und etwas Selleriefond schwenken."
                                            },
                                            {
                                                "example_id": "bbae888c-ff69-45d8-a2a9-c4a4cd689878",
                                                "sense_id": "178d389e-7447-30e4-bf57-03c5c9021e9e",
                                                "text": "Normalerweise wird ein Wodka Martini im Rührglas auf Eis verrührt und dann in ein vorgekühltes Martiniglas abgeseiht."
                                            },
                                            {
                                                "example_id": "da4c4e74-ca77-460d-8199-c14848fd272c",
                                                "sense_id": "178d389e-7447-30e4-bf57-03c5c9021e9e",
                                                "text": "Alle Zutaten werden geschüttelt und in eine Cocktailschale abgeseiht, die man, wenn man möchte, mit einem Minzeblättchen dekoriert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
