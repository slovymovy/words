                                            },
                                            {
                                                "example_id": "7b99bd6a-ec15-466d-a5b3-2470bb8aec64",
                                                "sense_id": "9c5a1462-ee04-397b-9b18-2161405b5691",
                                                "text": "On a eu pas mal d’annulations."
                                            }
                                        ]
                                    },
                                    {
