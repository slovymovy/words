                "senses": [
                    {
                        "sense_id": "abaade3f-8339-3ef5-83ef-f654284ee0ea",
                        "entry_id": "5df4a0fd-8af9-3f36-bc9b-5e049cd95126",
                        "glosses": [
                            "Science qui concerne l’Amérique et ses peuples autochtones."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0b44852b-e740-3d52-9a7b-154bed7b348c",
                        "entry_id": "5df4a0fd-8af9-3f36-bc9b-5e049cd95126",
                        "glosses": [
                            "Hérésie étasunienne qui mélange les doctrines chrétiennes avec les notions locales de libertés civiles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9d0d22ee-bb8a-3c74-b1f9-38da6867840d",
                        "entry_id": "5df4a0fd-8af9-3f36-bc9b-5e049cd95126",
                        "glosses": [
                            "Admiration outrée pour les idées et les usages d’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7eab6af-a823-4594-9e36-883bcb37c409",
                                "sense_id": "9d0d22ee-bb8a-3c74-b1f9-38da6867840d",
                                "text": "L’américanisme, en France, a succédé à l’anglomanie."
                            },
                            {
                                "example_id": "ceb5daaf-5252-4626-ab69-66fa76af42af",
                                "sense_id": "9d0d22ee-bb8a-3c74-b1f9-38da6867840d",
                                "text": "Renaud aimait, cette année-là, la belle Suzie. La belle Suzie plaît par un américanisme à la portée des plus médiocres romanciers français."
                            },
                            {
                                "example_id": "900e6c52-6e2a-4452-a6bf-892de378d1e4",
                                "sense_id": "9d0d22ee-bb8a-3c74-b1f9-38da6867840d",
                                "text": "Il entretient un rapport particulier à lʼAmérique et à ses valeurs: il est une figure de lʼaméricanisme latin."
                            }
                        ]
                    },
                    {
                        "sense_id": "d82cf83d-6f02-33ca-b378-2a6833ae403a",
                        "entry_id": "5df4a0fd-8af9-3f36-bc9b-5e049cd95126",
                        "glosses": [
                            "Caractéristique de l’esprit et de l’esthétisme propres aux États-Unis d’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3599ed3-8e34-473b-a37f-87fcbfb902b3",
                                "sense_id": "d82cf83d-6f02-33ca-b378-2a6833ae403a",
                                "text": "Ils hésitèrent longtemps entre la grande salle du Jolly, oasis d'un américanisme apaisant et, juché sur le toit d'un palais, un restaurant qui flamboyait sous une profusion de globes laiteux."
                            }
                        ]
                    },
                    {
                        "sense_id": "500624a8-7dc2-3786-99c9-da482045785f",
                        "entry_id": "5df4a0fd-8af9-3f36-bc9b-5e049cd95126",
                        "glosses": [
                            "Idiotisme utilisé par des locuteurs américains de l’anglais."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dac9a5f2-633c-31c9-880d-71a641db8ca9",
                        "entry_id": "5df4a0fd-8af9-3f36-bc9b-5e049cd95126",
                        "glosses": [
                            "Idiotisme utilisé par des locuteurs américains de l’espagnol."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b76a92b-0c9a-4f4f-9ecf-2d74cd0bf1ce",
