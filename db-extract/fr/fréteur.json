                        "glosses": [
                            "Celui qui donne un véhicule de transport collectif ou de marchandises à loyer."
                        ],
                        "tags": [
                            "Transport aérien",
                            "Transport maritime"
                        ],
                        "note": "Celui qui prend à loyer un véhicule est l’affréteur",
