                    {
                        "sense_id": "ac7f6c22-f939-3927-a735-9ba2882430e7",
                        "entry_id": "26cd6079-6e75-3a98-9b30-059c74c591c7",
                        "glosses": [
                            "Celui qui dépèce des animaux pour récupérer, la graisse, les cornes, les os, etc."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5f6e407f-9434-47c9-9a98-374677743371",
                                "sense_id": "ac7f6c22-f939-3927-a735-9ba2882430e7",
                                "text": "La tête du bœuf, encore entière, ses gros yeux bleus ouverts, attend la lame du dépeceur sous une fenêtre opaque."
                            },
                            {
                                "example_id": "edf3f1bb-0dee-4cc1-aeee-a11553859e27",
                                "sense_id": "ac7f6c22-f939-3927-a735-9ba2882430e7",
                                "text": "… le dépeceur qui, armé d'un couteau à dépecer, aide a l'arrachement, par le treuil de la bande de graisse qui recouvre la moitié inférieure du flanc gauche."
                            }
                        ]
                    },
                    {
