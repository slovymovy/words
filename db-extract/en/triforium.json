                                "target_senses": [
                                    {
                                        "sense_id": "df4fc362-0678-331e-b79b-115a15bcce3e",
                                        "entry_id": "860b61a6-2d4a-3fff-a6cb-4bb77beebb45",
                                        "glosses": [
                                            "een gang boven de zijbeuk in een kerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3acb529-952a-478c-a636-2380b1b1091e",
                                                "sense_id": "df4fc362-0678-331e-b79b-115a15bcce3e",
                                                "text": "Nadat de gemeentebestuurders koster Tuijn naar beneden zijn gevolgd, laat deze op 16,6 meter hoogte de restanten van de Romaanse muren zien in het zogenaamde triforium, de galerij in het koor."
                                            },
                                            {
                                                "example_id": "f181620f-e12d-4ee0-b3ca-037ab0169cf8",
                                                "sense_id": "df4fc362-0678-331e-b79b-115a15bcce3e",
                                                "text": "Een triforium (een gang boven de zijbeuk) geeft het oude gedeelte nog meer cachet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfd7536d-b31a-4459-bfaa-ef3e49d0c783",
                        "source_entry_id": "07ee9f6a-33df-3311-8912-db04ae1ce86c",
                        "source_sense_id": "14a1ef08-883a-3de7-87aa-577bca325c58",
                        "source_sense_description": "gallery of arches",
                        "target_lang_word": "triforium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triforium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15328573-a2be-3ede-90fe-25a4265b578c",
                                        "entry_id": "8c09e88a-b4b0-3a17-9d34-6175289d885b",
                                        "glosses": [
                                            "Galerie étroite aménagée dans l’épaisseur des murs, située le plus souvent au-dessus des grandes arcades d’une église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2cea5af-3964-4f9f-84e5-1f291b057871",
                                                "sense_id": "15328573-a2be-3ede-90fe-25a4265b578c",
                                                "text": "Les grandes arcades de certaines églises romanes sont surmontées d'un triforium, derrière lequel s'étendent des tribunes plus ou moins vastes."
                                            },
                                            {
                                                "example_id": "2ebd879b-9600-449b-8517-2a12e3e5fb27",
                                                "sense_id": "15328573-a2be-3ede-90fe-25a4265b578c",
                                                "text": "Dans une cathédrale la tierce donne les chapiteaux du chœur, la quinte donne le chapiteau du triforium et l’octave donne les chapiteaux de base de la voûte, voilà pourquoi…"
                                            },
                                            {
                                                "example_id": "2eb95f23-bdc3-4d0a-ab68-62724208826f",
                                                "sense_id": "15328573-a2be-3ede-90fe-25a4265b578c",
                                                "text": "[Sur la cathédrale Saint-Jean] Dans la galerie du triforium, une frise évoque notamment un Janus bifrons, dieu latin de la Paix et des ouvertures […]"
                                            },
                                            {
                                                "example_id": "de82066e-e6b8-4743-aa53-055599086048",
                                                "sense_id": "15328573-a2be-3ede-90fe-25a4265b578c",
                                                "text": "Elle ne possède aucun narthex édifiant, aucun triforium dentelé, aucune nef vertigineuse."
                                            },
                                            {
                                                "example_id": "405032b0-4c4a-4c05-b3b9-64092ef85dfb",
                                                "sense_id": "15328573-a2be-3ede-90fe-25a4265b578c",
                                                "text": "[le rayon vert] se traduit, deux fois par an, les jours d'équinoxe par l'éclairage du Christ de la chaire par un jet de lumière de couleur verte provenant d’une pièce de verre d’un vitrail figurant Juda, dans le triforium sud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b03ae957-fa62-42de-a3aa-d760634bf868",
                        "source_entry_id": "07ee9f6a-33df-3311-8912-db04ae1ce86c",
                        "source_sense_id": "14a1ef08-883a-3de7-87aa-577bca325c58",
