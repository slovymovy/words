                "senses": [
                    {
                        "sense_id": "cd6fac45-37e2-31a9-8951-cf716090c654",
                        "entry_id": "83a71a9f-d1a8-36bc-b594-959e1beb36c0",
                        "glosses": [
                            "A piece of code that performs a task, and that can be passed new input and return output more than once."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ad5e34-a3b8-4614-8365-b2c568be9cdd",
                                "sense_id": "cd6fac45-37e2-31a9-8951-cf716090c654",
                                "text": "Although a powerful tool, coroutines can be hard to understand due to the way data can flow back and forth between sections of the code."
                            },
                            {
                                "example_id": "927a7306-c0a3-470b-b653-7af5b506e7fb",
                                "sense_id": "cd6fac45-37e2-31a9-8951-cf716090c654",
                                "text": "The actual origin of the concept of symmetric unit control is difficult to determine. One of the earliest published applications of coroutines was in the area of syntax analysis (Conway, 1963)."
                            },
                            {
                                "example_id": "fa0b6c3d-26f9-4dcb-a993-2a85b9e19768",
                                "sense_id": "cd6fac45-37e2-31a9-8951-cf716090c654",
                                "text": "Python coroutines are the product of a series of enhancements to the humble generator functions we've seen so far in the book."
                            }
                        ]
                    }
                ],
