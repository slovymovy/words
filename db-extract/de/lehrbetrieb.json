                "senses": [
                    {
                        "sense_id": "fb0f22ac-58e0-39e3-8e78-832f882a1df2",
                        "entry_id": "96aa9401-aa74-3598-ba14-fc6e66ecfa5b",
                        "glosses": [
                            "Organisation und Inhalte der Lehre (an Hochschulen)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d6422c8b-9b01-400b-a710-15f49e1232fa",
                                "sense_id": "fb0f22ac-58e0-39e3-8e78-832f882a1df2",
                                "text": "„Thomasius wandte sich dabei gegen den herkömmlichen Lehrbetrieb der Universitäten, gegen das Monopol des Lateinischen, gegen die ›scholastische‹ Methode und metaphysische Spekulation in der Wissenschaft.“"
                            },
                            {
                                "example_id": "98abc237-07a7-4cc0-ac47-ab56ae1757ef",
                                "sense_id": "fb0f22ac-58e0-39e3-8e78-832f882a1df2",
                                "text": "Wie soll man denn bei diesen Unruhen den Lehrbetrieb aufrechterhalten?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "82d67988-0411-3597-b498-9396d6c8ed86",
                        "entry_id": "96aa9401-aa74-3598-ba14-fc6e66ecfa5b",
                        "glosses": [
                            "Betrieb, in dem ausgebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9604c7b0-4f5e-4a16-aa5f-938622e1fb81",
                                "sense_id": "82d67988-0411-3597-b498-9396d6c8ed86",
                                "text": "Sein Lehrbetrieb war eine Druckerei."
                            },
                            {
                                "example_id": "5a55ac9e-ba4f-4414-bd1d-ae942b72c8b8",
                                "sense_id": "82d67988-0411-3597-b498-9396d6c8ed86",
                                "text": "Ich habe später immer wieder gerne in den Ferien in meinem ehemaligen Lehrbetrieb gejobbt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
