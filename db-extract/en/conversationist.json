                        "glosses": [
                            "Someone skilled in the art of conversation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287f4716-7f3a-457a-a992-9fc50c362f8f",
                                "sense_id": "b3c72b4f-7c64-3f50-89d8-b9339bfbe88c",
                                "text": "Witty, learned, imaginative, she was conceded to be the best conversationist in any circle."
                            },
                            {
                                "example_id": "ed0bd126-720a-4b7e-a609-9f97dbd7ca8c",
                                "sense_id": "b3c72b4f-7c64-3f50-89d8-b9339bfbe88c",
                                "text": "BROWN, SAMUEL, M.D., chemist, born in Haddington, grandson of John Brown of Haddington, whose life was devoted, with the zeal of a mediaeval alchemist, to a reconstruction of the science of atomics, which he did not live to see realised: a man of genius, a brilliant conversationist and an associate of the most intellectual men of his time, among the number De Quincey, Carlyle, and Emerson; wrote \"Lay Sermons on the Theory of Christianity,\" \"Lectures on the Atomic Theory,\" and two volumes of \"Essays, Scientific and Literary\" (1817-1856)."
                            },
                            {
                                "example_id": "78ccc9a9-e17f-4bc4-9069-c9cc0ab893ac",
                                "sense_id": "b3c72b4f-7c64-3f50-89d8-b9339bfbe88c",
                                "text": "[A] He was expert at fence, had some skill in drawing, and was a ready and eloquent conversationist and declaimer."
                            }
                        ]
                    }
