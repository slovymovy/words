                        ]
                    },
                    {
                        "sense_id": "c84fd4d8-a1e7-301d-b535-5a17744757db",
                        "entry_id": "afbc1d72-7781-3cf3-8cdf-a75ca51b4dd2",
                        "glosses": [
                            "Formed by curved lines."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e256722e-ce01-4483-a970-e7eb7f0d3aaf",
                                "sense_id": "c84fd4d8-a1e7-301d-b535-5a17744757db",
                                "text": "In early art rectilinear decoration marks an advance on curvilinear, which, in the long ages before pottery was thought of, would naturally be associated with the fibrous baskets that served as vessels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d20403fe-e908-4a09-a146-47be0f61e2ac",
                        "source_entry_id": "afbc1d72-7781-3cf3-8cdf-a75ca51b4dd2",
                        "source_sense_description": "having bends",
                        "target_lang_word": "gekrümmt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gekrümmt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f564efeb-f897-3af3-a1cf-7a2ab21d1303",
                                        "entry_id": "b52f4284-2668-3750-aa99-a2310f1901e8",
                                        "glosses": [
                                            "eine Krümmung aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6043187e-00f4-469b-a1a3-0da177cb0492",
                                                "sense_id": "f564efeb-f897-3af3-a1cf-7a2ab21d1303",
                                                "text": "„Die langgestreckte, leicht gekrümmte Form des Zürichsee gleicht in etwa einer Banane.“"
                                            },
                                            {
                                                "example_id": "1644dd1c-6ac2-4208-a12d-4f50f798e98d",
                                                "sense_id": "f564efeb-f897-3af3-a1cf-7a2ab21d1303",
                                                "text": "„Der klassische Säbel war gekrümmt und nur einseitig geschliffen.“"
                                            },
                                            {
                                                "example_id": "4ef5124b-7a96-49f6-8440-74e15bf4e3b7",
                                                "sense_id": "f564efeb-f897-3af3-a1cf-7a2ab21d1303",
                                                "text": "„Die (Schaufel)Stiele sind vielfach aus ergonomischen Gründen leicht gekrümmt.“"
                                            },
                                            {
                                                "example_id": "6bebeb12-3b61-4f61-8836-6c88d0a85db2",
                                                "sense_id": "f564efeb-f897-3af3-a1cf-7a2ab21d1303",
                                                "text": "„Am 3. Mai 1775 meldet Alexander Cummings ein \"Water Closet\" zum Patent an, dessen wichtigste Neuerung in einem zweifach gekrümmten Abflussrohr besteht.“",
                                                "translation": "[*] übertragen: Der Torwart lag vor Schmerzen gekrümmt am Boden, da der Ball ihn direkt in die Weichteile getroffen hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
