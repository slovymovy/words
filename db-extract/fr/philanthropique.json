                        "translation_id": "80c062b5-f9dd-4a28-bb49-577d38a19323",
                        "source_entry_id": "bb0de412-1afe-3a02-b986-5851618e8d85",
                        "source_sense_id": "b88777e8-3b8e-3382-bf41-843a1ee75019",
