                ],
                "senses": [
                    {
                        "sense_id": "42f03420-cf25-3bc9-a838-14462fc96749",
                        "entry_id": "8e9e2ef2-6791-351d-bd4a-7787967e4907",
                        "glosses": [
                            "отражающий, способный отражать свет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab6fff2-4dfc-4d48-af68-17f6a06d9b97",
                                "sense_id": "42f03420-cf25-3bc9-a838-14462fc96749",
                                "text": "Дворников оденут в желтые светоотражающие жилеты〈…〉"
                            },
                            {
                                "example_id": "20dda154-3857-4a4d-be2f-718b8e5e81f4",
                                "sense_id": "42f03420-cf25-3bc9-a838-14462fc96749",
                                "text": "Крем-гель содержит светоотражающие частицы и придает лицу ровный золотистый оттенок с сияющим эффектом〈…〉"
                            },
                            {
                                "example_id": "fe2990ac-808b-4b8d-8054-fee32c1d9105",
                                "sense_id": "42f03420-cf25-3bc9-a838-14462fc96749",
                                "text": "Металлизированное покрытие наносят на световод, имеющий сердцевину и стеклянную светоотражающую оболочку."
                            }
                        ]
                    }
