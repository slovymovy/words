            "senses": [
                {
                    "sense_id": "02236156-c26a-319d-b11f-a7ca6630e5f7",
                    "sense_definition": "The act of improperly dropping or leaving trash in public places.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "littering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city introduced heavy fines to discourage <w>littering</w> in public parks.",
                            "target_lang_translations": {
                                "de": "Die Stadt führte hohe Bußgelder ein, um das <w>Wegwerfen von Müll</w> in öffentlichen Parks zu verhindern."
                            }
                        },
                        {
                            "text": "Signs throughout the nature reserve warned visitors that <w>littering</w> was strictly forbidden.",
                            "target_lang_translations": {
                                "de": "Schilder im gesamten Naturschutzgebiet warnten die Besucher davor, dass <w>Littering</w> streng verboten ist."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fine for littering",
                        "stop littering",
                        "prevent littering"
                    ],
                    "target_lang_definitions": {
