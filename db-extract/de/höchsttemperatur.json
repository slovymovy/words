                        "sense_id": "1b1efa08-509f-34b1-9ecf-5b0b19ab1365",
                        "entry_id": "7a082ed4-c0c0-3132-a5f0-33ab2daf816c",
                        "glosses": [
                            "die höchste, in einem bestimmten Zeitraum erreichte Temperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0cb599-4dd8-461b-861d-f66d27f2caca",
                                "sense_id": "1b1efa08-509f-34b1-9ecf-5b0b19ab1365",
                                "text": "[Klimakrise – Trockenheit in Südeuropa 2022:] „Schon vom 10. Mai an lagen die Höchsttemperaturen in Italien fast konstant über 30 Grad.“"
                            },
                            {
                                "example_id": "6483b94a-5140-42e8-90e2-0a54d11e3874",
                                "sense_id": "1b1efa08-509f-34b1-9ecf-5b0b19ab1365",
                                "text": "„An Tagen mit einer Höchsttemperatur unter 0 Grad Celsius gab es 0,94 STEMI pro Tag, an Tagen mit Höchsttemperaturen über dem Nullpunkt lag die Ereignisrate bei 0,78.“"
                            },
                            {
                                "example_id": "54437512-57fb-47db-873d-79433ec40236",
                                "sense_id": "1b1efa08-509f-34b1-9ecf-5b0b19ab1365",
                                "text": "„Anhaltspunkte gebe aber zum Beispiel die Arbeitsstättenverordnung, die 26 Grad als zulässige Höchsttemperatur in Arbeitsräumen nennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
