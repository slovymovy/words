                                    {
                                        "sense_id": "e5961874-7434-3b61-94a1-d2e70c4cb35c",
                                        "entry_id": "1b10fe1d-c07a-374d-8ef7-443709e1451c",
                                        "glosses": [
                                            "Anhänger des Trotzkismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "340c694f-30bb-40d2-8a76-057f2af4dceb",
                                                "sense_id": "e5961874-7434-3b61-94a1-d2e70c4cb35c",
                                                "text": "Das Wort „Trotzkist“ ist für seine Feinde das Sinnbild für das Böse auf der Welt, für seine Anhänger hingegen das Bekenntnis zu Revolution und Sozialismus."
                                            }
