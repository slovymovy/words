                "senses": [
                    {
                        "sense_id": "02848a17-a506-35fb-852e-7ed02236a1bb",
                        "entry_id": "427e1f50-1408-30f6-ab95-686fffba1b85",
                        "glosses": [
                            "(meist mit Speck durchwachsenes/durchzogenes) Fleisch vom Bauch, insbesondere Schweinebauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb42e8e9-6ce1-4f2c-b8e7-7b24a343795f",
                                "sense_id": "02848a17-a506-35fb-852e-7ed02236a1bb",
                                "text": "Wenn man in Bayern ein „Wammerl“ kauft, bekommt man ein Stück Bauchfleisch."
                            },
                            {
                                "example_id": "b00abdb2-a85b-44f0-9f8a-b56d3341171e",
                                "sense_id": "02848a17-a506-35fb-852e-7ed02236a1bb",
                                "text": "Mageres und geräuchertes Bauchfleisch bezeichnet man in Österreich auch als Kaiserfleisch."
                            },
                            {
                                "example_id": "3a2de728-1a02-4c3e-8b81-7de06ff29e53",
                                "sense_id": "02848a17-a506-35fb-852e-7ed02236a1bb",
                                "text": "„Auch Phat Kaphrao (würziges Rinderfaschiertes), gegrilltes Bauchfleisch, eine Forelle im Ganzen und Tofu zaubert Zoklits in seiner kleinen Küche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
