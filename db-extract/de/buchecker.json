                                        "sense_id": "895fe7d5-18e4-320c-8f6b-e3e77c2c0f82",
                                        "entry_id": "818afd48-046a-3530-9260-d0355236c04a",
                                        "glosses": [
                                            "The small, triangular, edible nut of the beech tree."
                                        ],
