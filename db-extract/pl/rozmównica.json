                "senses": [
                    {
                        "sense_id": "e25579e9-74da-3a08-9d6a-2fa99accd2dd",
                        "entry_id": "838bcf2a-d9fc-3015-b260-26d6ccf03ca0",
                        "glosses": [
                            "pomieszczenie w zakładzie zamkniętym, ośrodku wychowawczym, itp. do prowadzenia rozmów z osobami z zewnątrz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dc0c4d-be72-4671-b217-6c364e57064e",
                                "sense_id": "e25579e9-74da-3a08-9d6a-2fa99accd2dd",
                                "text": "Jadziu, twoja mamusia czeka na ciebie w rozmównicy przy portierni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8243363c-1e37-3f2a-ae29-ef376e37f55d",
                        "entry_id": "838bcf2a-d9fc-3015-b260-26d6ccf03ca0",
                        "glosses": [
                            "pomieszczenie w klasztorze do prowadzenia rozmów z gośćmi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ab4e3d-7b48-4309-819c-a623522b6d47",
                                "sense_id": "8243363c-1e37-3f2a-ae29-ef376e37f55d",
                                "text": "Siostra Zygmunta nie powinna korzystać z rozmównicy matki prowincjalnej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5fff4fc0-5b6c-33d9-bc9a-56416da7d781",
                        "entry_id": "838bcf2a-d9fc-3015-b260-26d6ccf03ca0",
                        "glosses": [
                            "kabina z publicznym aparatem telefonicznym w urzędzie pocztowym, hotelu, itp."
