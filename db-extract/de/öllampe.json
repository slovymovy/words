                "senses": [
                    {
                        "sense_id": "d14abc7d-3659-3a4b-8b36-2eb91ebe1d35",
                        "entry_id": "d2ddc058-6a8d-34d5-a62a-a19c8358372e",
                        "glosses": [
                            "durch die Verbrennung von Öl betriebene Lampe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a3b1bc4-b430-4d7e-9392-1a066ab3b079",
                                "sense_id": "d14abc7d-3659-3a4b-8b36-2eb91ebe1d35",
                                "text": "„Die speziellen Leuchten der Lokomotiven enthielten in der Frühzeit Öllampen, die nach dem Prinzip des Argandbrenners einen mit Pflanzenöl gefüllten Behälter, einen Brennaufsatz und einen kleinen Glaskamin aufwiesen.“"
                            },
                            {
                                "example_id": "eb1601f5-98e5-4ab8-bfb2-6e7868c5aad4",
                                "sense_id": "d14abc7d-3659-3a4b-8b36-2eb91ebe1d35",
                                "text": "„Öllampen und ein kleines Feuer beleuchteten ihre Gesichter.“"
                            },
                            {
                                "example_id": "4f2a0ae7-645f-42a3-9b32-0320bc61fe72",
                                "sense_id": "d14abc7d-3659-3a4b-8b36-2eb91ebe1d35",
                                "text": "„Aber es war nur ein Groschen, ich hatte ihn, und er war kostbar: über dem Eingang – ich hatte es immer nur gesehen, wenn ich hinausgegangen war – hatte ein Herz-Jesu-Bild gehangen, mit einer Öllampe davor.“"
                            },
                            {
                                "example_id": "26b7b65c-6780-4e9f-823c-f96ab8a40c0b",
                                "sense_id": "d14abc7d-3659-3a4b-8b36-2eb91ebe1d35",
                                "text": "„Nachts verwendet man Öllampen zur Beleuchtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
