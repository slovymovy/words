                                            {
                                                "example_id": "fb3d3eac-93e0-4204-953f-442a32d26b22",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "Quel genre d’homme est-ce ?"
                                            },
                                            {
                                                "example_id": "f5fafdf2-a96e-4912-8f0f-cfbdc267db91",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "Quelle heure est-il ?"
                                            },
                                            {
                                                "example_id": "10fafc40-4a22-4446-8975-64916d0e4a2e",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "Quel âge avez-vous ?"
                                            },
                                            {
                                                "example_id": "fb53b87d-7912-40d2-9fd5-5c0e786d58d3",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "Quel temps fait-il ?"
                                            },
                                            {
                                                "example_id": "d7df3407-566d-43b1-92b3-4c0e93912521",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "Quelle mouche le pique ?"
                                            },
                                            {
                                                "example_id": "8e0de691-2102-4eec-a328-8280c47b3f51",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "À quel homme pensez-vous avoir affaire ?"
                                            },
                                            {
                                                "example_id": "81cbce3a-9e57-490e-a966-d2874dac2237",
                                                "sense_id": "69aeaae4-447c-3e68-a120-b385904c8451",
                                                "text": "Sur quelles sources vous basez-vous ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1d7e4e-269d-3a3b-8005-22283f325618",
                                        "entry_id": "01283572-8862-3960-bcb5-34970a60260c",
                                        "glosses": [
                                            "Interroge sur la qualité du nom suivant."
                                        ],
                                        "tags": [
                                            "Avec un nom"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc7e755-f098-49dc-9571-d32a2c52837e",
                                                "sense_id": "4a1d7e4e-269d-3a3b-8005-22283f325618",
                                                "text": "Quel homme est-il ?"
                                            },
                                            {
                                                "example_id": "1e6d453e-c38f-4d87-a1e5-84b0e948ff29",
                                                "sense_id": "4a1d7e4e-269d-3a3b-8005-22283f325618",
                                                "text": "Il ne sait quel parti prendre."
                                            },
                                            {
                                                "example_id": "fd9b8e0b-2c15-4e19-a38d-6715d4f69ab4",
                                                "sense_id": "4a1d7e4e-269d-3a3b-8005-22283f325618",
                                                "text": "J’aimerais comprendre de quelle façon il s’y est pris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12c45ae9-5955-3816-9398-cbd4ca768cb5",
                                        "entry_id": "a89b1c47-e9ac-37c4-ba20-17d116d0f8d2",
                                        "glosses": [
                                            "Interroge sur l’identité ou la qualité du sujet."
                                        ],
                                        "tags": [
                                            "Avec le verbe être"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6399ff70-2c8a-4291-885d-3882923e0c00",
                                                "sense_id": "12c45ae9-5955-3816-9398-cbd4ca768cb5",
                                                "text": "Quel est donc ton problème ?"
                                            },
                                            {
                                                "example_id": "0a88e086-3ec7-4d4d-a0c0-87fa607dcc7f",
                                                "sense_id": "12c45ae9-5955-3816-9398-cbd4ca768cb5",
                                                "text": "Quel est cet homme qui saura débrouiller tout ça ?"
                                            },
                                            {
                                                "example_id": "266f665d-de10-4475-a901-47a387424ee7",
                                                "sense_id": "12c45ae9-5955-3816-9398-cbd4ca768cb5",
                                                "text": "Quel est-il, celui qui viendra à ma rencontre ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                        "entry_id": "0945b45d-bcb7-3fef-a2f4-7a5bd65b7e79",
                                        "glosses": [
                                            "Employé comme tel, il a pour but de renforcer la portée du nom qu’il accompagne. Il peut être dans une phrase elliptique (sans verbe) ou à l’intérieur d’une proposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6602989c-2e4d-429d-8c65-0a008ea1bf1a",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Quelle pitié !"
                                            },
                                            {
                                                "example_id": "4f29d388-f390-4887-bed1-1888ed692acf",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Quel malheur !"
                                            },
                                            {
                                                "example_id": "4949e81c-af86-4e03-aeb9-10a030333919",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Quelle impudence !"
                                            },
                                            {
                                                "example_id": "ce82dfd7-f0e5-46c3-ba28-0134cc6bb5b8",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Quelle méchanceté !"
                                            },
                                            {
                                                "example_id": "30593444-c233-4698-8b3c-ef1b153f4020",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Quelle bonté !"
                                            },
                                            {
                                                "example_id": "53e76bfc-b66c-4d8a-8147-ef94b08eee5f",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Quelle folie d’agir ainsi !"
                                            },
                                            {
                                                "example_id": "e8cb82fb-e4af-46c4-ac59-c043ca8b0d35",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Je ne savais pas à quel point vous étiez malheureux."
                                            },
                                            {
                                                "example_id": "b5f6c27c-fe0b-4235-ba36-46ad8ee6ee96",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Il y avait beaucoup de monde à cette soirée, mais quelle soirée c’était !"
                                            },
                                            {
                                                "example_id": "4c3e9467-0932-49c4-8029-73c8684b963e",
                                                "sense_id": "20df2c72-547a-3ceb-93fe-12a0ce852b9a",
                                                "text": "Il n’y avait pas de mobilier dans la chambre, mais un lit, et quel lit ! une table, et quelle table !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
