    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5fa72d1e-3a21-32ed-8217-728e774a2ab4",
                    "sense_definition": "Lacking intelligence, common sense, or good judgment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>stupid</w> idea to go out in the rain without a coat.",
                            "target_lang_translations": {
                                "ru": "Это была <w>глупая</w> идея пойти гулять под дождем без пальто.",
                                "zh": "不穿外套就冒雨出门真是个<w>愚蠢的</w>主意。"
                            }
                        },
                        {
                            "text": "He felt <w>stupid</w> after making such a simple mistake on the test.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>глупо</w>, совершив такую простую ошибку в тесте.",
                                "zh": "在考试中犯了这么简单的错误，他觉得自己很<w>笨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unintelligent",
                        "foolish",
                        "dumb",
                        "brainless",
                        "silly",
                        "witless",
                        "dense",
                        "slow"
                    ],
                    "antonyms": [
                        "intelligent"
                    ],
                    "common_phrases": [
                        "stupid mistake",
                        "stupid question",
                        "stupid idea",
                        "stupid thing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток ума, здравого смысла или рассудительности.",
                        "zh": "缺乏智慧、常识或判断力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "основное значение; неумный"
                            },
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "разговорное, грубое; несообразительный"
                            },
                            {
                                "target_lang_word": "бестолковый",
                                "target_lang_sense_clarification": "лишенный здравого смысла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愚蠢的",
                                "target_lang_sense_clarification": "基本含义，指缺乏智慧"
                            },
                            {
                                "target_lang_word": "笨的",
                                "target_lang_sense_clarification": "口语，指不聪明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                    "sense_definition": "Used to express anger or annoyance towards something or someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't find my <w>stupid</w> keys anywhere in this messy room!",
                            "target_lang_translations": {
                                "ru": "Я нигде не могу найти свои <w>дурацкие</w> ключи в этой грязной комнате!",
                                "zh": "在这乱糟糟的房间里，我哪儿也找不到我那<w>该死的</w>钥匙！"
                            }
                        },
                        {
                            "text": "Stop making that <w>stupid</w> noise while I am trying to work.",
                            "target_lang_translations": {
                                "ru": "Прекрати издавать этот <w>дурацкий</w> звук, пока я пытаюсь работать.",
                                "zh": "我正忙着工作呢，别再发出那种<w>讨厌的</w>噪音了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "irritating",
                        "pesky",
                        "dumb",
                        "frustrating"
                    ],
                    "common_phrases": [
                        "stupid car",
                        "stupid computer",
                        "stupid job"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize annoyance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения гнева или раздражения по отношению к кому-либо или чему-либо.",
                        "zh": "用于表达对某人或某事的愤怒或厌烦。"
