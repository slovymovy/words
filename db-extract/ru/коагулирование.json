                "senses": [
                    {
                        "sense_id": "ca5fd4f0-c486-3f6e-aaf7-d0a6b62db771",
                        "entry_id": "9cbd1bbf-a054-3456-91c2-9b2274e6b7d3",
                        "glosses": [
                            "биол., хим. процесс, во время которого кровь или иная коллоидная жидкость превращается в желеобразную массу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f972a8-5830-42fe-ad02-ec35c4a1a9c9",
                                "sense_id": "ca5fd4f0-c486-3f6e-aaf7-d0a6b62db771",
                                "text": "Диссеминированное внутрисосудистое коагулирование."
                            }
                        ]
                    },
                    {
                        "sense_id": "4656caa8-996f-38c7-ba5c-dd6bc1e8ac4f",
                        "entry_id": "9cbd1bbf-a054-3456-91c2-9b2274e6b7d3",
                        "glosses": [
                            "хим., техн. метод очистки воды от нежелательных примесей путём их осаждения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1adba25f-f04c-465b-b728-bd1e734cd3a5",
                                "sense_id": "4656caa8-996f-38c7-ba5c-dd6bc1e8ac4f",
                                "text": "В песочных фильтрах загрязняющие примеси могут быть задержаны с помощью приема, называемого коагулированием."
                            }
                        ]
                    }
