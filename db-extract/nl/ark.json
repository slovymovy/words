                        "source_entry_id": "368b5c92-fab8-358d-88aa-a3d12c4ebe31",
                        "target_lang_word": "Hausboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
