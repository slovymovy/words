                        "entry_id": "a560848b-ea6b-34e1-b0cf-ae58c15b5f0d",
                        "glosses": [
                            "Sport, bei dem zusätzlich zum Joggen Müll aufgesammelt wird"
                        ],
                        "tags": [],
