                                    {
                                        "sense_id": "1ea441c1-a4db-30dc-8343-a5e88ef22e95",
                                        "entry_id": "1423e295-5718-3e30-ba00-a80d8f3cd5fa",
                                        "glosses": [
                                            "A plate or other container passed among the worshipers attending a Christian church service, into which donations of money are placed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30139de-4fc9-4278-9635-3855eccab14b",
                                                "sense_id": "1ea441c1-a4db-30dc-8343-a5e88ef22e95",
                                                "text": "1911, Lucy Maud Montgomery, The Story Girl, ch. 5 \"Peter goes to church\",\nElder Frewen, a tall, pale man, with long, sandy side-whiskers, appeared at the door of our pew with the collection plate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
