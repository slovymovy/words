{
    "word_family": [
        "consentement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fb9c289-a33b-382e-a6e2-29f479344b04",
                    "sense_definition": "Accepter la réalisation d'une chose, donner son accord ou concéder quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues négociations, la direction a <w>consenti</w> à une augmentation de salaire."
                        },
                        {
                            "text": "Il a finalement <w>consenti</w> à nous accompagner pour ce long voyage."
                        }
                    ],
                    "synonyms": [
                        "accepter",
                        "acquiescer",
                        "vouloir bien"
                    ],
                    "antonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
                        "consentir à",
                        "consentir un effort"
                    ]
                },
                {
                    "sense_id": "ae9ff06e-9f3a-3306-988d-171be0dc41b1",
                    "sense_definition": "Admettre ou reconnaître un fait ou un principe comme vrai.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "admettre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une vérité tacitement <w>consentie</w> par l'ensemble de la communauté scientifique."
                        },
                        {
                            "text": "Face à l'évidence des faits, il a <w>consenti</w> qu'une erreur avait été commise."
                        }
                    ],
                    "synonyms": [
                        "approuver",
                        "être d'accord"
                    ],
                    "antonyms": [
                        "contester",
                        "nier"
                    ]
                },
                {
                    "sense_id": "6370c4d0-1374-3aa8-8b02-2a22ab14ee80",
                    "sense_definition": "Donner officiellement son approbation pour le mariage d'un enfant ou d'une pupille.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents de la jeune fille n'ont jamais voulu <w>consentir</w> à cette union."
                        },
                        {
                            "text": "Selon la coutume de l'époque, le tuteur devait <w>consentir</w> avant toute célébration."
                        }
                    ],
                    "synonyms": [
                        "accepter"
                    ],
                    "antonyms": [
                        "s'opposer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage juridique ou traditionnel lié au mariage"
                        }
                    ]
                },
                {
                    "sense_id": "dc9feebc-08ae-39cd-b52d-8a9280424422",
                    "sense_definition": "En parlant d'un mât ou d'une pièce de bois marine, plier ou fléchir sous l'effet du vent sans se rompre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous la force de la tempête, le grand mât a commencé à <w>consentir</w> dangereusement."
                        },
                        {
                            "text": "L'équipage a vu la membrure <w>consentir</w> sous les rafales répétées du vent."
                        }
                    ]
                }
            ]
        }
    ]
