                        ]
                    },
                    {
                        "translation_id": "a8d5a8fc-ba7b-4d75-9980-bf058479a14c",
                        "source_entry_id": "c885ce88-4663-39db-bd42-d4ff7a232234",
                        "source_sense_description": "скопление пыльцевых зёрен семенных растений",
                        "target_lang_word": "pollen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "870a16ef-7009-3d7e-9036-be276ce01315",
                                        "entry_id": "dc8127bd-a798-3350-9ca8-86b8e779810f",
                                        "glosses": [
                                            "Particules reproductrices mâles produites par les loges des anthères des étamines des fleurs, transmises par le vent (anémophiles), ou les animaux (zoophiles) : les insectes (entomophiles), les oiseaux (ornithophiles), les chauves-souris, etc."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2cdee5e-8025-4e8e-89a2-ce5c06a1bfb3",
                                                "sense_id": "870a16ef-7009-3d7e-9036-be276ce01315",
                                                "text": "Je l’engageai donc à sentir de près des lis qui étaient charmants, et, tandis qu’elle se penchait, d’une très légère poussée derrière les cheveux, je lui mis le nez en plein dans les fleurs, pour la barbouiller de pollen jaune."
                                            },
                                            {
                                                "example_id": "cfb1e56a-274d-488a-9dce-6a414f18952d",
                                                "sense_id": "870a16ef-7009-3d7e-9036-be276ce01315",
                                                "text": "Tous les ans, M. Millardet féconde des vignes américaines par du pollen des vignes françaises."
                                            },
                                            {
                                                "example_id": "d8dfbc10-7456-4326-8e3c-e3e106b66667",
                                                "sense_id": "870a16ef-7009-3d7e-9036-be276ce01315",
                                                "text": "[…]: il se trouve que certains grains de pollen se sont bien conservés dans les tourbières ; or, l’étude microscopique des grains de pollen permet très souvent de reconnaître à quelle plante ils appartiennent."
                                            },
                                            {
                                                "example_id": "d7f60473-1bdd-4388-bb50-cf48a10c1709",
                                                "sense_id": "870a16ef-7009-3d7e-9036-be276ce01315",
                                                "text": "[…]; au pied des cornouillers étoilés d’or pirouettaient les premiers lapins, et le vent plus mou depuis quelques jours seulement, sentait les pollens volés aux coudriers."
                                            },
                                            {
                                                "example_id": "6d1caaca-4be9-457a-b284-be370a4df3b5",
                                                "sense_id": "870a16ef-7009-3d7e-9036-be276ce01315",
                                                "text": "Pour les plantes supérieures terrestres, il s'agit essentiellement des grains de pollen et des spores qui constituent ainsi un outil très utilisé en paléoclimatologie, grâce à leur abondance dans les sédiments humides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd25261-ce16-3a11-8ccf-1d55318d8d8a",
                                        "entry_id": "dc8127bd-a798-3350-9ca8-86b8e779810f",
                                        "glosses": [
                                            "Type de haschich."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
