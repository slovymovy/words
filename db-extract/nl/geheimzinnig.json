                        "form": "geheimzinnigers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5be0ae18-c6e8-3d96-a6fc-bb0179452bf4",
                        "entry_id": "f2a9c3ec-be48-3a40-97f3-9eb2defd6dbd",
                        "glosses": [
                            "niet te achterhalen door gebrek aan informatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e95e906-b826-4bfd-84a4-74bfc19fe501",
                                "sense_id": "5be0ae18-c6e8-3d96-a6fc-bb0179452bf4",
                                "text": "Op geheimzinnige wijze is de krant van de tafel verdwenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b66cd22e-9082-33eb-8a17-3ae78c7a495b",
                        "entry_id": "f2a9c3ec-be48-3a40-97f3-9eb2defd6dbd",
                        "glosses": [
                            "bovennatuurlijke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d916da2-4bfe-4f50-878a-737e4641a956",
                                "sense_id": "b66cd22e-9082-33eb-8a17-3ae78c7a495b",
                                "text": "Zij deed er water in en toen allerlei geheimzinnige kruiden, een beetje aarde, glanzende stenen, mossen en planten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8da87bc-f085-4d6c-9597-f2dda677dc73",
                        "source_entry_id": "f2a9c3ec-be48-3a40-97f3-9eb2defd6dbd",
                        "target_lang_word": "abstruse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstruse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                        "entry_id": "fef99f82-b4d3-3a3c-9acf-46f5a49df286",
                                        "glosses": [
                                            "Difficult to comprehend or understand; obscure."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6514ac5-bedb-414b-acdc-73182790c3a8",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "Some time the good makithe an ile end⸝ ãd the ile a godd. In this opiniõ⸝ and in ſcrutable miſterie be werithe all his wittes⸝ and at the end of his cogitacions⸝ fyndithe more abſtruſe⸝ and doutfull obiections thẽ at the beginning⸝ […]",
                                                "translation": "Sometimes the good maketh an ill end, and the ill a good. In this opinion, and inscrutable mystery be weary all his wits, and at the end of his cogitations, findeth more abstruse, and doubtfull objections than at the beginning, […]",
                                                "english": "Sometimes the good maketh an ill end, and the ill a good. In this opinion, and inscrutable mystery be weary all his wits, and at the end of his cogitations, findeth more abstruse, and doubtfull objections than at the beginning, […]"
                                            },
                                            {
                                                "example_id": "20916d3a-ab6f-4339-9b00-0926dcd78c91",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "Be leſs abſtruſe, my riddling days are paſt."
                                            },
                                            {
                                                "example_id": "826d7a10-3d6f-4041-84e8-dd18488305b6",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "Thoſe propoſitions relating to the Moon's motion, which are demonſtrated in the Principia [by Isaac Newton], do generally depend on calculations very intricate and abſtruſe, the truth of which is not eaſily examined, even by thoſe that are moſt skilful; […]"
                                            },
                                            {
                                                "example_id": "ebf1d509-6cac-4385-96ac-4cf03dc4c938",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "The beſt VVay to learn any Science, is to begin vvith a regular Syſtem, or a ſhort and plain Scheme of that Science, vvell dravvn up into a narrovv Compaſs, omitting the deeper and more abſtruſe Parts of it, and that alſo under the Conduct and Inſtruction of ſome ſkilful Teacher."
                                            },
                                            {
                                                "example_id": "5d2cfbe5-10f5-4234-8cda-2cd412a43550",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "'Tis certain, that the eaſy and obvious Philoſophy vvill always, vvith the Generality of Mankind, have the Preference to the accurate and abſtruſe; and by many vvill be recommended, not only as more agreeable, but more uſeful than the other."
                                            },
                                            {
                                                "example_id": "c90a3fe3-e6e4-40dc-a233-11fd13585e72",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "The objects of geometrical enquiry are ſo intirely abſracted from thoſe purſuits vvhich ſtir up and put in motion the unruly paſſions of the human heart, that mankind vvithout difficulty adopt not only the more ſimple theorems of the ſcience, but even thoſe abſtruſe paradoxes, vvhich hovvever they may appear ſuſceptible of demonſtration, are at variance vvith the natural conceptions vvhich the mind, vvithout the aid of philoſophy, vvould be led to entertain upon the ſubject."
                                            },
                                            {
                                                "example_id": "48301106-cba2-4ba0-91af-5756c021f8e9",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "In a thousand ways he smoothed for me the path of knowledge, and made the most abstruse inquiries clear and facile to my apprehension."
                                            },
                                            {
                                                "example_id": "6a795370-858e-46a1-80f0-5133d4596c61",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "A second rescript followed, commanding all bishops not merely to subscribe the dominant opinions on these profound and abstruse topics, but to condemn their authors, Pelagius and Cœlestius, as irreclaimable heretics, and this under pain of deprivation and banishment."
                                            },
                                            {
                                                "example_id": "be2bc7f8-6740-4cf6-8f57-30b865c5cf6c",
                                                "sense_id": "5cb8b499-27de-34e9-88e3-c60317bf9654",
                                                "text": "After the subject (victim, if you like) had read say thirty of the best solid novels of the twentieth century, I think I should draw him to the more abstruse modern novels and stories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18864e5e-2503-3ec0-8364-0139a408354c",
                                        "entry_id": "fef99f82-b4d3-3a3c-9acf-46f5a49df286",
                                        "glosses": [
                                            "Concealed or hidden; secret."
                                        ],
                                        "tags": [
                                            "formal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664c37be-9cf4-4ef4-acaf-7d1fbb04c407",
                                                "sense_id": "18864e5e-2503-3ec0-8364-0139a408354c",
                                                "text": "O vvho is he that could carrie nevves to our olde father, that thou vvert but aliue, although thou vvert hidden in the moſt abſtruſe dungeons of Barbarie; for his riches, my brothers and mine vvould fetch thee from thence."
                                            },
                                            {
                                                "example_id": "50168f7b-2345-422b-b4cc-26fdef2e1fb2",
                                                "sense_id": "18864e5e-2503-3ec0-8364-0139a408354c",
                                                "text": "[T]he abſtruſeſt Things / VVhich in the Mindes dark Temper neſtling ly, / By you expoſed are to every Eye."
                                            },
                                            {
                                                "example_id": "0ef7e582-19b5-49db-978c-be8c09a1b891",
                                                "sense_id": "18864e5e-2503-3ec0-8364-0139a408354c",
                                                "text": "Mean while th’ Eternal eye, whoſe ſight diſcernes / Abſtruſeſt thoughts, from forth his holy Mount / And from within the golden Lamps that burne / Nightly before him, ſaw without their light / Rebellion riſing, ſaw in whom, how ſpred / Among the ſons of Morn, what multitudes / Were banded to oppoſe his high Decree; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae97972b-0d03-4c85-bb64-cc6399899727",
                        "source_entry_id": "f2a9c3ec-be48-3a40-97f3-9eb2defd6dbd",
                        "target_lang_word": "apocalyptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apocalyptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a86bad68-00a0-3abc-b83e-8574cb9bea62",
                                        "entry_id": "575bf446-a95b-3d5e-9850-0aa09fbfaaa0",
                                        "glosses": [
                                            "Of or relating to an apocalypse:",
                                            "Revelatory; prophetic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25812771-eb7e-4240-ac68-f3854e1fcea5",
                                                "sense_id": "a86bad68-00a0-3abc-b83e-8574cb9bea62",
                                                "text": "Let him go and make, and burn, a pile or two [of bricks] with his own hands; he will thereby receive apocalyptic visions of a nature novel to his soul."
                                            },
                                            {
                                                "example_id": "7ae4c7be-08ab-478a-b956-02769d440a54",
                                                "sense_id": "a86bad68-00a0-3abc-b83e-8574cb9bea62",
                                                "text": "From beginning to end, and throughout, the Gospel makes such frequent use of apocalyptic motifs and the apocalyptic viewpoint that it deserves to be called the apocalyptic Gospel.\""
                                            },
                                            {
                                                "example_id": "f294df6e-b8f5-4912-91ae-4a5b199b6ca2",
                                                "sense_id": "a86bad68-00a0-3abc-b83e-8574cb9bea62",
                                                "text": "This was because apocalyptic stories — from the Greek word apohalupsis which means \"reveal\" — uses the vocabulary of symbols and numbers and contains concealed messages that secular listeners cannot comprehend."
                                            },
                                            {
                                                "example_id": "44b870e0-91aa-4d86-a423-646373df9123",
                                                "sense_id": "a86bad68-00a0-3abc-b83e-8574cb9bea62",
                                                "text": "“It’s true that as I walk out of my house in a nice quiet street and go to a nice cafe five minutes’ walk away, I have no reason to have these apocalyptic musings.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add2c3a2-5b60-391f-9eef-5ad892e698be",
                                        "entry_id": "575bf446-a95b-3d5e-9850-0aa09fbfaaa0",
                                        "glosses": [
                                            "Of or relating to an apocalypse:",
                                            "Catastrophic; disastrous."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6f0422-c0a9-46d5-80c0-35da2d084c32",
                                                "sense_id": "add2c3a2-5b60-391f-9eef-5ad892e698be",
                                                "text": "For the first time since the show began, a sense of utter loneliness overwhelmed me, a bitter despair at the uselessness of individual effort in this gigantic tragedy of apocalyptic destruction."
                                            },
                                            {
                                                "example_id": "3d8ef09c-29ac-49cf-b776-3442380197e8",
                                                "sense_id": "add2c3a2-5b60-391f-9eef-5ad892e698be",
                                                "text": "In fact, interpreters commonly declare that Mark is an \"apocalyptic\" Gospel. When they read Jesus' long speech toward the end of the Gospel (chap. 13), they even detect a veritable \"apocalypse\": \"Wars and rumors of wars, […]\""
                                            },
                                            {
                                                "example_id": "c9824c46-5647-483f-a246-f9fe49601211",
                                                "sense_id": "add2c3a2-5b60-391f-9eef-5ad892e698be",
                                                "text": "These bookends house a wealth of apocalyptic stories. The Bible, like some street preacher with a sign, shouts, \"The end is near!\""
                                            },
                                            {
                                                "example_id": "97e2a051-2e94-4f07-8a78-c6fd52d57f03",
                                                "sense_id": "add2c3a2-5b60-391f-9eef-5ad892e698be",
                                                "text": "Life in the SCP universe continually hangs by a thread, threatened constantly by the existence of a number of dangerous and apocalyptic anomalies. These threats are countered and contained by the existence of organizations such as the SCP Foundation or the Global Occult Coalition."
                                            },
                                            {
                                                "example_id": "da27e0db-18b1-4fa0-b262-ed9bc13b67b0",
                                                "sense_id": "add2c3a2-5b60-391f-9eef-5ad892e698be",
                                                "text": "[…]and the pillar of smoke which had recently begun to dissipate, as many of the fires amidships had been smothered by the onrushing water, was replaced by a vast mushroom cloud of steam, smoke, flame, and debris as the magazines detonated. In the pall of this apocalyptic destruction, the U.S. fleet takes stock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e565b6-2dc3-32f4-95ea-fa5df1809866",
                                        "entry_id": "575bf446-a95b-3d5e-9850-0aa09fbfaaa0",
                                        "glosses": [
                                            "Portending a future apocalypse (disaster, devastation, or doom)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73506b39-5048-486b-8c07-defa73743238",
                                                "sense_id": "77e565b6-2dc3-32f4-95ea-fa5df1809866",
                                                "text": "Submissions on the part of gay teachers and students and organizations were countered by apocalyptic denunciations on the part of Bible-toting mothers and fathers expertly organized by the right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3aaa3bc-61c3-3621-9efb-18cf52047212",
                                        "entry_id": "575bf446-a95b-3d5e-9850-0aa09fbfaaa0",
                                        "glosses": [
                                            "Catachresis for apoplectic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f112720-2414-4d26-aadf-72f56f5b4f28",
                                                "sense_id": "a3aaa3bc-61c3-3621-9efb-18cf52047212",
                                                "text": "He was apocalyptically furious."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apocalyptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64430874-8051-3e94-8668-08d4bc66037c",
                                        "entry_id": "a23412e5-600f-3506-a06d-b3c85b274e4f",
                                        "glosses": [
                                            "One who predicts apocalypse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "970673cc-0478-4ef6-91b7-1b786762a080",
                        "source_entry_id": "f2a9c3ec-be48-3a40-97f3-9eb2defd6dbd",
                        "target_lang_word": "mysterious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mysterious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76e678c1-7c6a-3113-927b-f2da7225a79d",
                                        "entry_id": "90cee2a0-3734-31ef-88c9-d3bb3c014938",
                                        "glosses": [
                                            "Of unknown origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a4bbdd-f9d2-4aeb-a7a9-8d9f865c28c6",
                                                "sense_id": "76e678c1-7c6a-3113-927b-f2da7225a79d",
                                                "text": "He received a mysterious phone call this morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0703aefc-412d-3bfa-b728-ec2ffdf72797",
                                        "entry_id": "90cee2a0-3734-31ef-88c9-d3bb3c014938",
                                        "glosses": [
                                            "Having unknown qualities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6edb37-9490-49c6-87c9-16b4eb711219",
                                                "sense_id": "0703aefc-412d-3bfa-b728-ec2ffdf72797",
                                                "text": "Our boss is a mysterious man who hardly ever meets with us."
                                            },
                                            {
                                                "example_id": "3c53eb10-bb6d-41e3-a45f-0848f7a008f1",
                                                "sense_id": "0703aefc-412d-3bfa-b728-ec2ffdf72797",
                                                "text": "God moves in a myſterious way, / His wonders to perform; / He plants his footſteps in the ſea, / And rides upon the ſtorm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768cdfae-5d43-3319-8c70-d8751b6a1140",
                                        "entry_id": "90cee2a0-3734-31ef-88c9-d3bb3c014938",
                                        "glosses": [
                                            "Difficult to understand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24600ca2-7261-4ca9-99bf-390a01b9f1db",
                                                "sense_id": "768cdfae-5d43-3319-8c70-d8751b6a1140",
                                                "text": "Why he left without saying goodbye is quite mysterious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66bcf6d-c3b0-3913-b3f8-5a9db1056890",
                                        "entry_id": "90cee2a0-3734-31ef-88c9-d3bb3c014938",
                                        "glosses": [
                                            "Deliberately evasive or enigmatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e5d557-2b57-4dbc-b3ae-76fdc018ae6b",
                                                "sense_id": "b66bcf6d-c3b0-3913-b3f8-5a9db1056890",
                                                "text": "Stop being mysterious and just tell me what you want."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "d6a1e036-9dae-413d-80f5-655676761672",
                        "source_entry_id": "f2a9c3ec-be48-3a40-97f3-9eb2defd6dbd",
