                "senses": [
                    {
                        "sense_id": "19ddeef3-1f65-3694-bb84-cf6284c8b1e5",
                        "entry_id": "1009db3d-090f-3afa-a815-a1d03d3655a9",
                        "glosses": [
                            "Qualifie ce qui est composé de fibres synthétiques de type polyamide aromatique, très résistantes comme le kevlar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87adea1e-0491-4a92-9663-0e2f39749fde",
                                "sense_id": "19ddeef3-1f65-3694-bb84-cf6284c8b1e5",
                                "text": "Des câbles aramides."
                            },
                            {
                                "example_id": "db83a544-becd-4d9a-bddb-284be8051292",
                                "sense_id": "19ddeef3-1f65-3694-bb84-cf6284c8b1e5",
                                "text": "Il faut goûter ici la plaisanterie à double détente de Novat qui écrit ces lignes dans les années 1870, alors que la fibre d’aramide ne fut inventée puis commercialisée sous le nom de Kevlar qu’un siècle plus tard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e054a4b-9244-43f2-b775-239d8b673682",
                        "source_entry_id": "1009db3d-090f-3afa-a815-a1d03d3655a9",
                        "source_sense_id": "19ddeef3-1f65-3694-bb84-cf6284c8b1e5",
