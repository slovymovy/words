                    }
                ],
                "senses": [
                    {
                        "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                        "entry_id": "3682a9d2-a059-36e4-801e-96fb54ce98df",
                        "glosses": [
                            "Transportunternehmer (Personen, Güter) zur See mit eigenen Schiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0213746-00b9-4e1b-8704-7f489ef359e7",
                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                "text": "Als Reeder war er ein Überseekaufmann mit internationaler Erfahrung."
                            },
                            {
                                "example_id": "af127273-d2e9-4473-b311-35489c205fbb",
                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                "text": "„Die Reeder müssten wieder dem Ideal des ehrbaren Kaufmanns folgen, wenn sie Hilfe vom Staat wollten, mahnte er.“"
                            },
                            {
                                "example_id": "cd802b93-bbba-4905-b782-c3352a2aa81d",
                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                "text": "„Daheim in Norwegen zählten die Reeder das Geld.“"
                            },
                            {
                                "example_id": "5cddf16e-76f9-4e6c-981c-844b11cc90ff",
                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                "text": "„Die Reeder gaben uns vorläufig je dreißig Dollar.“"
                            },
                            {
                                "example_id": "3f5d1699-c878-4ba5-95da-6daecd19c49f",
                                "sense_id": "287dc3cf-77eb-32df-af0b-494a2287bfb7",
                                "text": "„Der Reeder ließ die Säcke zunähen und lieferte sie an den Kunden aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
