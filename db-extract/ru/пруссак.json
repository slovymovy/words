                "senses": [
                    {
                        "sense_id": "89eac0d2-7d3f-3060-93b3-fc268e0bdfb4",
                        "entry_id": "8784b355-9f58-3bf4-9140-953cde740d93",
                        "glosses": [
                            "житель Пруссии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2e3fe6-b8c7-4654-96c6-2c6cf5c0c9bd",
                                "sense_id": "89eac0d2-7d3f-3060-93b3-fc268e0bdfb4",
                                "text": "Пронырливый пруссак фон дер Пален был вполне россиянин."
                            }
                        ]
                    },
                    {
                        "sense_id": "df336270-795c-37bc-9986-3a7c593c331c",
                        "entry_id": "8784b355-9f58-3bf4-9140-953cde740d93",
                        "glosses": [
                            "прусак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa376303-d982-47e1-b377-6cd59038b6f6",
                                "sense_id": "df336270-795c-37bc-9986-3a7c593c331c",
                                "text": "Ночью помойки в поисках растительных остатков посещают уховертки, сверчки, тараканы, особенно рыжий ― пруссак, постоянный гость мусоропроводов, успешно путешествующий по ним в домах."
                            }
                        ]
                    }
