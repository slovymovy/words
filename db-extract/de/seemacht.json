                            "singular"
                        ],
                        "form": "die Seemacht"
                    },
                    {
                        "form_id": "2f298961-2533-4219-9b2c-e6a1d78104be",
                        "entry_id": "baf062a9-e085-35c4-a1af-2189bb2cb7e7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Seemächte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc79cef8-76a2-341a-b061-3a4677e847de",
                        "entry_id": "baf062a9-e085-35c4-a1af-2189bb2cb7e7",
                        "glosses": [
                            "Staat, der über eine bedeutende militärische Flotte, Präsenz auf den Weltmeeren sowie über eine günstige seestrategische Position verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d445f76-cf88-4d42-8153-b984ebf1ce2a",
                                "sense_id": "bc79cef8-76a2-341a-b061-3a4677e847de",
                                "text": "Als die Bismarck sinkt, getroffen durch einen britischen Torpedo, geht auch das Trugbild der deutschen Seemacht zugrunde."
                            },
                            {
                                "example_id": "da9038e6-f41c-4476-9783-53e5149224b7",
                                "sense_id": "bc79cef8-76a2-341a-b061-3a4677e847de",
                                "text": "Er berichtet von den frühen Handelsplätzen an Nord- und Ostsee und von der Hanse, unter der man nicht einen Bund mittelalterlicher Städte und maritimer Seemacht verstand, sondern eine Schar reisender Kaufleute."
                            },
                            {
                                "example_id": "aa924b6d-74d5-4c97-af8a-726d53a1434f",
                                "sense_id": "bc79cef8-76a2-341a-b061-3a4677e847de",
                                "text": "Es ist die Paradoxie des historischen Augenblicks, dass Europa zur Abwehr dieser Selbstgefährdung nichts so sehr braucht wie die Teilnahme Großbritanniens – der sturen, individualistischen, erzliberalen und urdemokratischen Insel, der atlantisch und global orientierten alten Seemacht, mit der ein festungsartiger Brüsseler Zentralismus nie und nimmer zu machen sein wird."
                            },
                            {
                                "example_id": "a44ab4f6-31b8-4252-a6f9-cde872d2deb0",
                                "sense_id": "bc79cef8-76a2-341a-b061-3a4677e847de",
                                "text": "Hat mit Landmacht oder Seemacht diese Torheit er gewagt?"
                            },
                            {
                                "example_id": "966271de-c6cd-42d7-84f0-59379f248078",
                                "sense_id": "bc79cef8-76a2-341a-b061-3a4677e847de",
                                "text": "Nachdem Michael de Ruiter der britischen Seemacht in den außer-europäischen Gewässern mehrere empfindliche Verluste zugefügt hatte, schlug er sie 1666 in drei großen Schlachten im Kanal, lief mit seiner ganzen Macht in die Themse ein und nötigte England in dem darauf folgenden Jahre nachzugeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7cd9d3b0-6d39-31b5-a867-c9b3d4393ff3",
                        "entry_id": "baf062a9-e085-35c4-a1af-2189bb2cb7e7",
                        "glosses": [
                            "Macht und Herrschaft auf See"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae3e2ed-a9cf-4985-9dd9-589bf943a61b",
                                "sense_id": "7cd9d3b0-6d39-31b5-a867-c9b3d4393ff3",
                                "text": "Im 19. Jahrhundert demonstrierte man Seemacht durch Kanonenbootpolitik."
                            },
                            {
                                "example_id": "6ae6e5c9-26ab-43e9-8eea-f3ab4fad28ca",
                                "sense_id": "7cd9d3b0-6d39-31b5-a867-c9b3d4393ff3",
                                "text": "„Die Idee - oder das Klischee - einer deutschen Seemacht wurde nicht nur in der Heimat verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
