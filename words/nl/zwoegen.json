            "pos": "verb",
            "senses": [
                {
                    "sense_id": "282dd909-4bfd-35eb-b9f5-b55ca632d372",
                    "sense_definition": "zwaar en moeizaam werk verrichten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hard werken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeiders moesten de hele dag in de brandende zon <w>zwoegen</w> om de weg af te krijgen.",
                            "target_lang_translations": {
                                "en": "The workers had to <w>toil</w> all day in the burning sun to finish the road."
                            }
                        },
                        {
                            "text": "Zij bleef urenlang <w>zwoegen</w> op haar huiswerk om een goed cijfer te halen.",
                            "target_lang_translations": {
                                "en": "She kept <w>slaving away</w> at her homework for hours to get a good grade."
                            }
                        }
                    ],
                    "synonyms": [
                        "ploeteren"
                    ],
                    "antonyms": [
                        "luieren",
                        "ontspannen"
                    ],
                    "common_phrases": [
                        "zwoegen op huiswerk",
                        "zwoegen en zweten"
                    ],
                    "target_lang_definitions": {
                        "en": "To perform heavy and difficult work, often for a long period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to toil",
                                "target_lang_sense_clarification": "working extremely hard or incessantly"
                            },
                            {
                                "target_lang_word": "to slave away",
                                "target_lang_sense_clarification": "working very hard with little reward"
                            },
                            {
                                "target_lang_word": "to drudge",
                                "target_lang_sense_clarification": "doing dull, heavy, or hard work"
                            },
                            {
                                "target_lang_word": "to work hard",
                                "target_lang_sense_clarification": "general term for putting in effort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad528008-d821-3d78-9217-f130dd7d4e43",
                    "sense_definition": "moeilijk of zwaar ademhalen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ademhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de steile klim hoorde je de wandelaar zwaar <w>zwoegen</w>.",
                            "target_lang_translations": {
                                "en": "After the steep climb, you could hear the hiker <w>panting</w> heavily."
                            }
                        },
                        {
                            "text": "De oude motor begon te <w>zwoegen</w> toen de auto de heuvel op reed.",
                            "target_lang_translations": {
                                "en": "The old engine started to <w>labor</w> as the car drove up the hill."
                            }
                        }
                    ],
                    "synonyms": [
                        "ploeteren"
                    ],
                    "common_phrases": [
                        "zwaar zwoegen"
                    ],
                    "target_lang_definitions": {
                        "en": "To breathe with difficulty or heavily, often due to physical exertion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pant",
                                "target_lang_sense_clarification": "breathing with short, quick breaths"
                            },
                            {
                                "target_lang_word": "to puff",
                                "target_lang_sense_clarification": "breathing hard from effort"
                            },
                            {
                                "target_lang_word": "to labor",
                                "target_lang_sense_clarification": "breathing or moving with great difficulty"
                            }
                        ]
                    }
                }
            ]
        }
