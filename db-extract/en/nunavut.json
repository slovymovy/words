                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nunavut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb4d5bf-9672-39e5-8493-8ace53ac1705",
                                        "entry_id": "791eb0af-8a6f-32c7-a3ce-c37db72fef79",
                                        "glosses": [
                                            "Territorium im Norden Kanadas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf336044-8f2e-4e92-8f0a-8e29bec3175b",
                                                "sense_id": "bbb4d5bf-9672-39e5-8493-8ace53ac1705",
                                                "text": "Die Hauptstadt von Nunavut ist Iqaluit."
                                            },
                                            {
                                                "example_id": "5642c189-8aa6-4d99-a494-0b47ce22d9b7",
                                                "sense_id": "bbb4d5bf-9672-39e5-8493-8ace53ac1705",
                                                "text": "„Er hielt seine Idee schriftlich fest, einen Monat nachdem er von einer Angeltour nach Nunavut, in der Nähe der Frobisher-Bucht, zurückkehrte, einem brutalen, felsigen Küstenstrich am Rande der Labradorsee, die hinter dem als Lower Savage Islands bekannten Felsstreifen abrupt eine Kerbung nach Süden vollzieht, um ein einzigartiges, anderthalb Kilometer breites Rinnsal zu bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0469170-e75e-4609-b777-0e660efda9da",
                        "source_entry_id": "6c1e6af0-d8c8-304a-b018-bf7156c93990",
