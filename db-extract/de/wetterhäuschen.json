                ],
                "senses": [
                    {
                        "sense_id": "38d7a84a-36f5-3909-b410-e1eac99912c9",
                        "entry_id": "d959f291-150d-3f55-98d0-ac72935529e3",
                        "glosses": [
                            "kleines Puppenhäuschen mit Mann und Frau, welche sinnbildlich das Wetter anzeigen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "9f4a3c48-66d8-4580-9eb7-94e958a61274",
                                "sense_id": "38d7a84a-36f5-3909-b410-e1eac99912c9",
                                "text": "Das Wetterhäuschen ist ein kleines Modellhäuschen mit nebeneinanderliegenden Türen, in denen als Symbol für gutes bzw. schlechtes Wetter die Puppenfiguren einer Frau und eines Mannes auf einer Drehachse stehen, die bei Luftfeuchtigkeit schwankt, sodass die Frau oder der Mann vor das Häuschen gedreht wird."
                            },
                            {
                                "example_id": "1e8e0f90-aa72-4b52-8897-aa2f368470f3",
                                "sense_id": "38d7a84a-36f5-3909-b410-e1eac99912c9",
                                "text": "„Im Inneren des Wetterhäuschens befindet sich ein Strang fein gespannter Haare (meistens Pferdehaare ).“"
                            },
                            {
                                "example_id": "77bc575f-e13f-4e30-9d27-0c683d16522b",
                                "sense_id": "38d7a84a-36f5-3909-b410-e1eac99912c9",
                                "text": "„Für diese traditionelle Wettervorhersage benötigt man einen Feuchtigkeitsmesser, wie ihn diese beliebten Wetterhäuschen besitzen.“"
                            },
                            {
                                "example_id": "9102821b-c825-4218-8bf7-29c7814a1d0c",
                                "sense_id": "38d7a84a-36f5-3909-b410-e1eac99912c9",
                                "text": "„Vielleicht gibt es auch in Ihrem Ort ein altes Wetterhäuschen,Sie besitzen eine alte Postkarte, eine historische Aufnahme oder Sie wissen um eine Säule, die hier nicht aufgeführt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
