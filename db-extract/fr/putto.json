                    {
                        "translation_id": "ff721c7f-8a22-4090-827f-49269bb4a49a",
                        "source_entry_id": "0c0888bc-d934-321b-9047-ace47eecb268",
                        "source_sense_id": "d67cb8d3-d468-35bb-b1a8-39382df41730",
