                    },
                    {
                        "form_id": "0489430e-8b7d-4ccd-a021-38dbb99b4410",
                        "entry_id": "03d96e2a-1341-3fb0-a706-2ffaed0c0e86",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h muet))\\e.mɔ.ɡlɔ.bin\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78bc3084-90e0-3e1a-9d66-d0e47f1c5647",
                        "entry_id": "03d96e2a-1341-3fb0-a706-2ffaed0c0e86",
                        "glosses": [
                            "Hétéroprotéine de couleur rouge contenue dans les hématies et qui leur donne leur couleur. L’hème qu’elle contient sert au transport du dioxygène (oxyhémoglobine) et du dioxyde de carbone (hémoglobine réduite)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465a716f-9ce1-420b-95b5-8fbfc2529f2b",
                                "sense_id": "78bc3084-90e0-3e1a-9d66-d0e47f1c5647",
                                "text": "Chez l’homme, les globules rouges sont discoïdes ; leur dimension est de 7 à 8 μ ; ils sont constitués par une trame (stroma) de nature protéique, qui est imprégnée d'une matière colorante rouge : l’hémoglobine."
                            },
                            {
                                "example_id": "738baa85-df50-4d15-af1f-8a3df9f387f0",
                                "sense_id": "78bc3084-90e0-3e1a-9d66-d0e47f1c5647",
                                "text": "25 août 44 – Dominique est reparti, laissant derrière lui un paquet de vivres destiné aux troupes : étrange mélange de denrées dans des boîtes de fer-blanc, avec des petites clés sur chacune, des notices, des chocolats noirs de vitamines et des pastilles qui contiennent autant d’hémoglobine qu’un bœuf entier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4ba2e14-75f4-411a-9d9f-c0912e6ee1a7",
                        "source_entry_id": "03d96e2a-1341-3fb0-a706-2ffaed0c0e86",
                        "source_sense_id": "78bc3084-90e0-3e1a-9d66-d0e47f1c5647",
                        "target_lang_word": "Hämoglobin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämoglobin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                        "entry_id": "09b2e0b2-54a8-3ca4-b696-8a364d4b6e4f",
                                        "glosses": [
                                            "Protein, welches auf den Erythrozyten den Sauerstoff bindet"
                                        ],
                                        "tags": [
                                            "Biochemie",
                                            "Zellbiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a0ea8a-2781-4429-8878-5673b53fcb08",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "Hämoglobin ist sehr eisenhaltig."
                                            },
                                            {
                                                "example_id": "87e3056b-3c24-4fbb-a0ec-069ba46f4488",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Methämoglobin entsteht normalerweise nur in geringen Mengen im Körper und wird durch ein Enzym wieder in Hämoglobin umgewandelt.“"
                                            },
                                            {
                                                "example_id": "a51d7e87-7aae-4057-b4d8-12732b91865a",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Neben dem Sauerstofftransport zum Gewebe dienen die Hämoglobine auch dem Kohlendioxidtransport vom Gewebe zur Lunge.“"
                                            },
                                            {
                                                "example_id": "6ab66c66-db95-4b2b-a7f3-3903c4ecbfac",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Wie er dabei feststellte, sind sich die Hämoglobine von Menschen und Menschenaffen ähnlicher als eines von beiden dem Hämoglobin von Kühen oder Fröschen.“"
                                            },
                                            {
                                                "example_id": "870811a2-611b-47e8-8586-589c0c438c2f",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Immer wenn rote Blutkörperchen platzen – das Ereignis nennt sich Hämolyse – wird Hämoglobin frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a73c34ea-5c30-4418-9ce8-c83e0cf1756e",
                        "source_entry_id": "03d96e2a-1341-3fb0-a706-2ffaed0c0e86",
