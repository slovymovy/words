                "senses": [
                    {
                        "sense_id": "653cfe29-66ce-33ba-bbbe-1cd40d16e445",
                        "entry_id": "b5c54a57-2d56-3fe2-a7a0-457fa8fff9b6",
                        "glosses": [
                            "Gesamtheit der zum Datenaustausch verbundenen Server und Computer, die von den Mitarbeitern des deutschen Bundestages genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf3d964-6b40-40a9-aedc-6c06e67d1a8b",
                                "sense_id": "653cfe29-66ce-33ba-bbbe-1cd40d16e445",
                                "text": "„Sollte das Bundestagsnetzwerk tatsächlich komplett neu aufgebaut werden, könnte das mehrere Wochen dauern und mehrere Millionen Euro kosten.“"
                            },
                            {
                                "example_id": "152845d8-2e17-4442-9d85-433c61cf3e40",
                                "sense_id": "653cfe29-66ce-33ba-bbbe-1cd40d16e445",
                                "text": "„Dadurch hätten die Angreifer umfassenden Zugriff auf das Bundestagsnetzwerk und sollen sich mittlerweile Administratoren-Rechte verschafft haben.“"
                            },
                            {
                                "example_id": "75b8239c-56b9-405d-832d-4b0e94e77c2b",
                                "sense_id": "653cfe29-66ce-33ba-bbbe-1cd40d16e445",
                                "text": "„Die russische Hackergruppe Sofacy soll seit 2006 aktiv und darauf spezialisiert sein, vertrauliche Informationen zu stehlen. Es mehren sich die Hinweise, dass sie auch für den Angriff auf das Bundestagsnetzwerk verantwortlich ist.“"
                            },
                            {
                                "example_id": "def7b69b-a4b9-42c3-a013-191fd509eb53",
                                "sense_id": "653cfe29-66ce-33ba-bbbe-1cd40d16e445",
                                "text": "„Derzeit könne nicht ausgeschlossen werden, dass aus dem Bundestagsnetzwerk noch immer unbemerkt Daten abfließen, hatte der Rechercheverbund unter Berufung auf beteiligte Spezialisten berichtet.“"
                            },
                            {
                                "example_id": "b07dcae3-37d2-4a46-b5a5-35476756aafc",
                                "sense_id": "653cfe29-66ce-33ba-bbbe-1cd40d16e445",
                                "text": "„Bis Freitagnachmittag wurde der Trojaner dem Bericht zufolge auf 15 Computern festgestellt, die an das Bundestagsnetzwerk angeschlossen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
