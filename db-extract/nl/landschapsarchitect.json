                        "examples": [
                            {
                                "example_id": "840626a1-8da7-4f52-ae9e-a0a1c451df6f",
                                "sense_id": "d9d8d5b0-a22d-3dd7-a925-759c9326b936",
                                "text": "Een bevriende kunstenaar, tevens landschapsarchitect, beloofde het binnenplaatsje te zijner tijd te herscheppen in een dakloze 'tuinkamer', wat dat ook mocht zijn, maar het is er nooit van gekomen."
                            },
                            {
                                "example_id": "d6699c52-f13d-46c9-a08c-c0d67af5c959",
                                "sense_id": "d9d8d5b0-a22d-3dd7-a925-759c9326b936",
                                "text": "Landschapsarchitect Piet Oudolf ontwierp de bloementuinen rondom het museumgebouw, dat bewust sober is gehouden. \"Het gebouw is dienend aan de kunst, het mag niet te veel spreken. Het is een sober, eenvoudig, maar mooi gebouw geworden\", zegt Van Caldenborgh met enige trots."
                            }
                        ]
