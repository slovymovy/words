                    {
                        "translation_id": "cfe44ce4-0721-4992-a4fd-3fabeb1d10c9",
                        "source_entry_id": "34a4d182-dfa6-3fcd-a124-c49ec6ae6271",
                        "source_sense_id": "2528fa07-8638-36dd-a688-6df979c98476",
                        "target_lang_word": "ohmique",
