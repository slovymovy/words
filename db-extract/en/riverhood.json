                        "entry_id": "5e8da7a9-1100-318b-8306-49695b483682",
                        "glosses": [
                            "The quality or state of being a river."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e41fd631-4ac7-4926-bd36-0db4097a92dd",
                                "sense_id": "462cb7e7-ba3d-3579-9cd7-db8aec551a76",
                                "text": "The dull mound now cuts off the sportive infancy of the Stour from its sorely-tasked term of useful riverhood."
                            },
                            {
                                "example_id": "c42d9c0a-fa15-4b6e-b447-31c1844915cc",
                                "sense_id": "462cb7e7-ba3d-3579-9cd7-db8aec551a76",
                                "text": "Suppose we say that the wild, raging torrent captures the 'true spirit' of riverhood, that it is the 'real' thing while the sluggish version is a degenerate."
                            },
                            {
                                "example_id": "362654b5-dc6e-4bc3-b357-d19bbf961b3c",
                                "sense_id": "462cb7e7-ba3d-3579-9cd7-db8aec551a76",
                                "text": "Would it be appropriate to define harm to the river's riverhood in monetary terms as we do, rather misguidedly on our own personhood? Would monetary compensation paid to adress^([sic]) the aggrieved river's rights be adequate?"
                            }
                        ]
                    }
