                        "entry_id": "771e921a-1278-30ba-a979-5825f1b87257",
                        "glosses": [
                            "Rapport d’amour et de haine, relation où ces deux sentiments cohabitent ou alternent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f2edc5-fde0-4ba1-becb-fd908cd78805",
                                "sense_id": "2dba6f94-e98f-36c6-b94d-509ccf7feca6",
                                "text": "Ich empfinde für sie eine Art Hassliebe. J'éprouve pour elle une espèce d'amour et de haine mêlées."
                            }
                        ]
                    }
