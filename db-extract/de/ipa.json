                                        "sense_id": "fbba52a2-2d0f-311e-a2aa-d2b9725b48d3",
                                        "entry_id": "8b6fd071-2af9-3ab1-a796-6fbc3b81a1eb",
                                        "glosses": [
                                            "Initialism of International Phonetic Alphabet."
                                        ],
