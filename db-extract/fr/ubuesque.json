                    {
                        "sense_id": "d3b55a55-b6a2-3a64-866a-27cd136b7935",
                        "entry_id": "b121f166-8d58-397f-8405-de94ebb66751",
                        "glosses": [
                            "belachelijk, absurdistisch, grotesk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44f396c-7758-4e10-a431-78f0edcf4e3f",
                                "sense_id": "d3b55a55-b6a2-3a64-866a-27cd136b7935",
                                "text": "Un roi ubuesque avec sa cour et son palais baroque construit en dehors d’Erevan, dans lequel, raconte-t-on, il avait fait venir deux lions qui ont fini par dépérir.",
                                "translation": "Een groteske koning met zijn hofhouding en zijn barokke paleis dat buiten Jerewan gebouwd was, waar hij, zo vertelde men, twee leeuwen had laten komen, die vervolgens wegkwijnden."
                            }
                        ]
                    }
                ],
