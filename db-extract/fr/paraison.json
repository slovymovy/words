                                    {
                                        "sense_id": "322ff8a1-0280-3c13-b057-7b021a9b97e7",
                                        "entry_id": "03ffafc2-0d9b-3ee7-917f-f7abb02e12ba",
                                        "glosses": [
                                            "A spherical mass of glass, rolled immediately after being taken out of the furnace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579cb988-b3ab-4331-a4c1-8d049f7121e0",
                                                "sense_id": "322ff8a1-0280-3c13-b057-7b021a9b97e7",
                                                "text": "The wineglasses were from a matched dozen, each having begun as a glowing parison at the end of some blowpipe over in Murano but days before."
                                            }
