                        "glosses": [
                            "Femme qui est chargée d’une cogérance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a32fd4e-62dc-4abc-b010-5f12d9a4fa46",
                                "sense_id": "c5c4d0ec-ed49-3e06-a770-54969b2f88fd",
                                "text": "Serge Toubiana, gérant et directeur de la publication, est maintenu à son poste, assisté de Dominique Alduy comme cogérante."
                            },
                            {
                                "example_id": "0fb51b4e-cb1b-4c05-9a17-12748ed046e0",
                                "sense_id": "c5c4d0ec-ed49-3e06-a770-54969b2f88fd",
                                "text": "C’est même devenu le « petit cadeau de dernière minute » par excellence, dans la capitale catalane, assure Muriel Taurinyà, la cogérante de la boutique de produits catalans Visca, à Perpignan, qui en commande plus de 300 par année."
                            }
                        ]
                    }
