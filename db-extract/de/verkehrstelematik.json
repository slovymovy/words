                "senses": [
                    {
                        "sense_id": "50448b2d-c77a-3e0c-8650-0047d344fcb9",
                        "entry_id": "42d4134b-df8e-32be-90c3-01b62bae393d",
                        "glosses": [
                            "Einsatz der Telematik zur Steuerung und Optimierung des öffentlichen Verkehrs"
                        ],
                        "tags": [
                            "Telematik",
                            "Verkehrswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "9a015b31-9bec-41d2-9c61-d64d86273b06",
                                "sense_id": "50448b2d-c77a-3e0c-8650-0047d344fcb9",
                                "text": "„Der junge Wissenschaftler arbeitet für den deutschen Ableger der US-Firma Navtech, einer von weltweit zwei Anbietern digitaler Kartenwerke. Deren Produkte sind Grundlage einer jungen Disziplin, von der sich Fachleute erhoffen, die wachsenden Verkehrsströme effektiver, umweltgerechter und sicherer lenken zu können: der Verkehrstelematik. Solch neuen Systemen zur Verkehrssteuerung, von der individuellen Stauvorhersage über die automatische Pannenhilfe bis zur Vernetzung ganzer Verkehrssysteme etwa in Ballungsräumen, wird eine große Zukunft vorhergesagt.“"
                            },
                            {
                                "example_id": "cd3416df-6ef6-42fd-bd6c-03377125eb93",
                                "sense_id": "50448b2d-c77a-3e0c-8650-0047d344fcb9",
                                "text": "„Die technischen Möglichkeiten und Entwicklungspotenziale in der Verkehrstelematik sind am 23. April 2001 die Themen einer Tagung an der Donau-Universität Krems.“"
                            },
                            {
                                "example_id": "17d2cb57-d092-42ce-83ff-068042b12af2",
                                "sense_id": "50448b2d-c77a-3e0c-8650-0047d344fcb9",
                                "text": "„Die Themen reichten von \"Die Zukunft der Verkehrstelematik - Was kommt nach dem Roadpricing\", über \"Haftungsrisken im automotiven Sektor\" bis hin zu den Förderprogrammen des BMVIT und der Zulieferstrategie von VW Slovakia."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
