                                                "sense_id": "e043e828-f28e-3654-a8d5-12232500e640",
                                                "text": "Der Amboss war so schwer, dass er ihn nicht einmal von der Stelle rücken konnte."
                                            },
                                            {
                                                "example_id": "d3bc417c-d804-4067-8a72-c7af7aa00247",
                                                "sense_id": "e043e828-f28e-3654-a8d5-12232500e640",
                                                "text": "„Du musst … leiden oder triumphieren, Amboss oder Hammer sein.“ (Goethe)"
                                            },
                                            {
                                                "example_id": "7d4b71f2-13f6-421b-8347-ae6512f15203",
                                                "sense_id": "e043e828-f28e-3654-a8d5-12232500e640",
                                                "text": "„Wieder einmal stellte John Nicol seinen Amboss an Deck auf, um den Neuankömmlingen die Eisen abzunehmen.“"
                                            },
                                            {
                                                "example_id": "f274ea44-e8f1-43ad-9804-e474ed4f3277",
                                                "sense_id": "e043e828-f28e-3654-a8d5-12232500e640",
                                                "text": "„Schuldgefühle lasteten wie ein Amboss auf ihrer Brust.“"
                                            }
                                        ],
