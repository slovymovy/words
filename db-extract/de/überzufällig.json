                "senses": [
                    {
                        "sense_id": "443b519a-e680-371d-b5d4-0909a261aec3",
                        "entry_id": "7361dbe3-47d2-3b6e-8b50-7d17ab597a84",
                        "glosses": [
                            "eine so hohe Signifikanz habend, um nicht mehr als Zufall zu gelten, aber noch nicht so eindeutig, um eine direkte Kausalität ableiten zu können"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "67e18041-f4b5-4645-a2c0-3219dd617d41",
                                "sense_id": "443b519a-e680-371d-b5d4-0909a261aec3",
                                "text": "„Schon in der älteren Psychosomatik ist man der Annahme nachgegangen, daß einige Krankheiten überzufällig häufig mit einem bestimmten Persönlichkeitsprofil einhergehen […].“"
                            }
                        ],
