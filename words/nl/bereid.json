                    "sense_id": "ea7cc297-d212-3cd6-9115-bf65789b4c29",
                    "sense_definition": "Geneigd en willens om iets te doen; niet weigerachtig.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "willingness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ben je <w>bereid</w> om mij morgen te helpen verhuizen?",
                            "target_lang_translations": {
                                "ru": "Ты <w>готов</w> помочь мне завтра с переездом?",
                                "en": "Are you <w>willing</w> to help me move tomorrow?",
                                "pl": "Czy jesteś <w>gotów</w> pomóc mi jutro w przeprowadzce?"
                            }
                        },
                        {
                            "text": "De directeur was niet <w>bereid</w> om commentaar te geven op het incident.",
                            "target_lang_translations": {
                                "ru": "Директор был не <w>готов</w> давать комментарии по поводу инцидента.",
                                "en": "The director was not <w>willing</w> to comment on the incident.",
                                "pl": "Dyrektor nie był <w>skłonny</w> skomentować tego incydentu."
