                "senses": [
                    {
                        "sense_id": "bb00401e-312f-34e6-a4ab-e1c850fec5b1",
                        "entry_id": "bd2c4728-60aa-3957-a4f6-637f825fdf3d",
                        "glosses": [
                            "Fraternel et sororal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8201589d-4a1b-4110-af9d-a44a8e17b5d0",
                                "sense_id": "bb00401e-312f-34e6-a4ab-e1c850fec5b1",
                                "text": "Le mode de succession par ordre de primogéniture des branches collatérales (adelphiques) semble soustraire les communautés vezo d’une quelconque compétition et rivalité dans l’exercice du pouvoir."
                            },
                            {
                                "example_id": "47a298ee-e9ff-44cf-ac7c-ccce43c7c319",
                                "sense_id": "bb00401e-312f-34e6-a4ab-e1c850fec5b1",
                                "text": "La gémellité illustre, en plus des variations des rapports adelphiques, l’effet de couple, d’une portée universelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b45759c-495e-3342-83fe-274ccc259b16",
                        "entry_id": "bd2c4728-60aa-3957-a4f6-637f825fdf3d",
                        "glosses": [
                            "Entre frères et sœurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8ba2e8-ecff-4681-9f3e-f422fa1ebaab",
                                "sense_id": "7b45759c-495e-3342-83fe-274ccc259b16",
                                "text": "Pour les Ptolémées, le mariage adelphique était la règle."
                            },
                            {
                                "example_id": "b2921568-7223-4e1b-8587-87ee714c8d14",
                                "sense_id": "7b45759c-495e-3342-83fe-274ccc259b16",
                                "text": "Frères et sœurs : les liens adelphiques dans l’Occident antique et médiéval."
                            }
                        ]
                    }
                ],
