                "senses": [
                    {
                        "sense_id": "0f5ffbe9-fb69-3d43-bb4e-e1c78c3bbd02",
                        "entry_id": "ec7ce551-2b01-35d8-8380-5aebedeb6761",
                        "glosses": [
                            "Person, die helfen will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a465a17d-4ee9-4095-9087-337eee02c5ba",
                                "sense_id": "0f5ffbe9-fb69-3d43-bb4e-e1c78c3bbd02",
                                "text": "„Beez regt an, einen gemeinnützigen Verein zu gründen, der kreisweit Hilfswillige an Senioreneinrichtungen vermittelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35d38f33-7a4a-3cb1-9157-c4253095c1db",
                        "entry_id": "ec7ce551-2b01-35d8-8380-5aebedeb6761",
                        "glosses": [
                            "in besetzten Gebieten rekrutierte Hilfskraft in der deutschen Wehrmacht während des Zweiten Weltkrieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3adb47-462f-40a4-acd3-8741198adb3e",
                                "sense_id": "35d38f33-7a4a-3cb1-9157-c4253095c1db",
                                "text": "„Auf dem Territorium der Sowjetunion verstärkte sich die GFP durch Hilfswillige, ehemalige sowjetische Kriegsgefangene sowie andere Kollaborateure unterschiedlichster Gesinnung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
