            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46115452-9b5e-3c58-bb8f-d5575c22adbf",
                    "sense_definition": "Duże, płaskie naczynie używane dawniej głównie do ręcznego prania ubrań lub kąpieli.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stara <w>balia</w> stała na podwórku i łapała deszczówkę.",
                            "target_lang_translations": {
                                "nl": "De oude <w>tobbe</w> stond op het erf en ving regenwater op."
                            }
                        },
                        {
                            "text": "Na strychu znaleźliśmy dużą <w>balię do prania</w>, która należała do prababci.",
                            "target_lang_translations": {
                                "nl": "Op zolder vonden we een grote <w>waskuip</w> die van overgrootmoeder was."
                            }
                        }
                    ],
                    "synonyms": [
                        "baleja"
                    ],
                    "common_phrases": [
                        "balia do prania",
                        "drewniana balia"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane rzadziej w nowoczesnych gospodarstwach domowych"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Groot, plat vat dat vroeger voornamelijk werd gebruikt voor de handwas of om in te baden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tobbe",
                                "target_lang_sense_clarification": "houten of metalen kuip voor de was"
                            },
                            {
                                "target_lang_word": "waskuip",
                                "target_lang_sense_clarification": "kuip gebruikt voor het wassen van kleding"
                            },
                            {
                                "target_lang_word": "zinkkuip",
                                "target_lang_sense_clarification": "zinken kuip voor de was"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2b98509-72b6-31d4-ab61-92f4d2d7357d",
                    "sense_definition": "Wanna używana do kąpieli.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ciężkim dniu w pracy napełnił <w>balię</w> gorącą wodą.",
                            "target_lang_translations": {
                                "nl": "Na een zware werkdag vulde hij de <w>badtobbe</w> met heet water."
                            }
                        },
                        {
                            "text": "W starym domu wciąż stała miedziana <w>balia do kąpieli</w>.",
                            "target_lang_translations": {
                                "nl": "In het oude huis stond nog steeds een koperen <w>badtobbe</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "balia do kąpieli"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "gwara krakowska"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Badkuip gebruikt om in te baden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "badtobbe",
                                "target_lang_sense_clarification": "ouderwetse tobbe om in te baden"
                            },
                            {
                                "target_lang_word": "badkuip",
                                "target_lang_sense_clarification": "eenvoudig bad"
                            }
                        ]
                    }
                }
            ]
