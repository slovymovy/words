                    {
                        "sense_id": "1a9600fd-3d11-3efa-9b12-fe8abad51d93",
                        "entry_id": "e02ca2c5-43cc-35f5-85be-2a510342a679",
                        "glosses": [
                            "een tekst die wordt gedicteerd en door andere personen wordt opgeschreven als toets in het correct spellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ce6694-5c55-4af6-8fdb-aee163c41c52",
                                "sense_id": "1a9600fd-3d11-3efa-9b12-fe8abad51d93",
                                "text": "Ieder jaar is er een groot dictee op de televisie."
                            },
                            {
                                "example_id": "318b23d8-c823-4781-9bea-585823b4e4cf",
                                "sense_id": "1a9600fd-3d11-3efa-9b12-fe8abad51d93",
                                "text": "A.F.Th. van der Heijden, winnaar van de Constantijn Huygens-prijs en de P.C. Hooftprijs, is dit jaar de auteur van het Groot Dictee der Nederlandse Taal. Hij treedt daarmee in de voetsporen van onder anderen Lieve Joris (2015), Bart Chabot (2014) en Kees van Kooten (2013)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10a79056-5c01-4272-a84a-f7260e0566de",
                        "source_entry_id": "e02ca2c5-43cc-35f5-85be-2a510342a679",
                        "source_sense_id": "1a9600fd-3d11-3efa-9b12-fe8abad51d93",
                        "source_sense_description": "een tekst die wordt gedicteerd en door andere personen wordt opgeschreven als toets in het correct spellen",
                        "target_lang_word": "Diktat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fc7e08-0528-3e74-a7b4-92e348c77bcc",
                                        "entry_id": "82b134a2-173d-3c5c-b0ab-16b78d99b970",
                                        "glosses": [
                                            "ein Text, der von einer Person langsam gesprochen und von einer anderen Person wörtlich mitgeschrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d0fd54-3d41-4019-9d68-68e525b772e1",
                                                "sense_id": "f1fc7e08-0528-3e74-a7b4-92e348c77bcc",
                                                "text": "In der Schule mussten wir heute ein Diktat schreiben."
                                            },
                                            {
                                                "example_id": "4c952cc3-e532-4649-9175-d66fe1f1f3e0",
                                                "sense_id": "f1fc7e08-0528-3e74-a7b4-92e348c77bcc",
                                                "text": "„Doch ihre Rechtschreibung ist mangelhaft, und so muss sie den ganzen Sommer über Diktate üben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3084033-74bc-38c6-b775-8b5d7433f5ad",
                                        "entry_id": "82b134a2-173d-3c5c-b0ab-16b78d99b970",
                                        "glosses": [
                                            "das langsame Sprechen eines Textes, den ein anderer wörtlich mitschreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "351e4def-fb4b-4a7c-ba8d-71d06ccbfa11",
                                                "sense_id": "a3084033-74bc-38c6-b775-8b5d7433f5ad",
                                                "text": "Fräulein Schulze, bitte zum Diktat!"
                                            },
                                            {
                                                "example_id": "ffe76018-701a-430f-bae5-8bf9f236c3b1",
                                                "sense_id": "a3084033-74bc-38c6-b775-8b5d7433f5ad",
                                                "text": "„Christina hatte Schreiben gelernt, und um mich davon zu überzeugen, schrieb sie in meiner Gegenwart nach meinem Diktat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5be13592-0b9b-3e05-8d99-c8887bba2f14",
                                        "entry_id": "82b134a2-173d-3c5c-b0ab-16b78d99b970",
                                        "glosses": [
                                            "ein Zwang, dem man nichts entgegensetzen kann; etwas das jemandem ohne die Möglichkeit, sich zu widersetzen, befohlen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c01892-fcf9-49cf-82d9-372eeae13ce5",
                                                "sense_id": "5be13592-0b9b-3e05-8d99-c8887bba2f14",
                                                "text": "Der Vertrag von Versailles war ein hartes Diktat für das Deutsche Reich."
                                            },
                                            {
                                                "example_id": "d8ccefc4-3f1b-494e-a8b5-5e36cde7bccf",
                                                "sense_id": "5be13592-0b9b-3e05-8d99-c8887bba2f14",
                                                "text": "Wir wollen uns dem Diktat des Marktes nicht länger beugen."
                                            },
                                            {
                                                "example_id": "6525ad65-959a-4c8b-9185-1f43ac55c3b6",
                                                "sense_id": "5be13592-0b9b-3e05-8d99-c8887bba2f14",
                                                "text": "„Es war ein Diktat Deutschlands an andere souveräne Länder, die das bereitwillig akzeptiert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83a00edb-2f9f-46b1-bd92-f1ed18995fc2",
                        "source_entry_id": "e02ca2c5-43cc-35f5-85be-2a510342a679",
                        "source_sense_id": "1a9600fd-3d11-3efa-9b12-fe8abad51d93",
                        "source_sense_description": "een tekst die wordt gedicteerd en door andere personen wordt opgeschreven als toets in het correct spellen",
                        "target_lang_word": "dictation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9aea80-def5-3cda-b741-bff4b5c8898b",
                                        "entry_id": "50ec614e-7543-3c55-b13d-331fe3eca4f2",
                                        "glosses": [
                                            "Dictating, the process of speaking for someone else to write down the words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8196980d-79ca-47eb-b3ce-6dc67f423422",
                                                "sense_id": "7e9aea80-def5-3cda-b741-bff4b5c8898b",
                                                "text": "Since I learned shorthand, I can take dictation at eighty words a minute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2ba0afb-b434-35bb-9b4c-f76e2410c4fc",
                                        "entry_id": "50ec614e-7543-3c55-b13d-331fe3eca4f2",
                                        "glosses": [
                                            "An activity in school where the teacher reads a passage aloud and the students write it down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c261f77a-00a6-4474-97e1-5fb369ddec08",
                                                "sense_id": "b2ba0afb-b434-35bb-9b4c-f76e2410c4fc",
                                                "text": "We had reading and geography and Canadian history and dictation today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6b8221d-4276-3ec1-b723-1ccd87cb45a9",
                                        "entry_id": "50ec614e-7543-3c55-b13d-331fe3eca4f2",
                                        "glosses": [
                                            "The act of ordering or commanding."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "544f07b9-340a-4d92-b619-5ce841da9553",
                                                "sense_id": "a6b8221d-4276-3ec1-b723-1ccd87cb45a9",
                                                "text": "...jurors in England have formerly understood it to be their right and duty to judge only according to their consciences, and not to submit to any dictation from the court, either as to law or fact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c715c8-1976-382e-b2f7-2ef44e4dd1d6",
                                        "entry_id": "50ec614e-7543-3c55-b13d-331fe3eca4f2",
                                        "glosses": [
                                            "Orders given in an overbearing manner."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8de842-5482-42da-af7a-b9ac4309f0b1",
                                                "sense_id": "c4c715c8-1976-382e-b2f7-2ef44e4dd1d6",
                                                "text": "His habit, even with friends, was that of dictation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31654a1c-bb37-46cf-9770-c686e9c110a2",
                        "source_entry_id": "e02ca2c5-43cc-35f5-85be-2a510342a679",
                        "source_sense_id": "1a9600fd-3d11-3efa-9b12-fe8abad51d93",
                        "source_sense_description": "een tekst die wordt gedicteerd en door andere personen wordt opgeschreven als toets in het correct spellen",
                        "target_lang_word": "dictée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f42a6efb-5864-3bda-b6a2-cdd21e90a9c0",
                                        "entry_id": "3f24ec6b-c600-30b0-9ba5-ce88c2b84447",
                                        "glosses": [
                                            "Action de dicter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ffc781-67ab-4ae3-9aba-9544d74b6bea",
                                                "sense_id": "f42a6efb-5864-3bda-b6a2-cdd21e90a9c0",
                                                "text": "Le prince, ce jour-là, sortit de sa léthargie. On reprit espoir. Lamballe demanda à son valet Félix de prendre, sous sa dictée, quelques consignes."
                                            },
                                            {
                                                "example_id": "4ed0d63a-196b-4ef7-b33c-985f989136b3",
                                                "sense_id": "f42a6efb-5864-3bda-b6a2-cdd21e90a9c0",
                                                "text": "La leçon de droit débute par la dictée des cahiers du professeur, et se poursuit par une explication, voire des interrogations. Cette procédure didactique n'est pas sans rappeler l'enseignement du droit tel qu'il se développe depuis le Moyen Âge."
                                            },
                                            {
                                                "example_id": "222664bc-56ea-4e44-a750-e6cf10cf171c",
                                                "sense_id": "f42a6efb-5864-3bda-b6a2-cdd21e90a9c0",
                                                "text": "Il les récita d'une haleine, sans en omettre un seul mot, tandis que Guilleragues en écrivait les parties essentielles sous sa dictée, en une forme abrégée et indéchiffrable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3422ed5-95c7-3468-87f0-a0f39507e8aa",
                                        "entry_id": "3f24ec6b-c600-30b0-9ba5-ce88c2b84447",
                                        "glosses": [
                                            "Exercice scolaire consistant à dicter un texte à retranscrire, en vue d’apprendre l’orthographe aux enfants."
                                        ],
                                        "tags": [
                                            "Enseignement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb63cf9f-dced-46c9-8e65-1098bfc96cbe",
                                                "sense_id": "d3422ed5-95c7-3468-87f0-a0f39507e8aa",
                                                "text": "Mais supprimez donc la dictée de ces bambins ! Qui protesterait ? Nous ? Certainement non. Eux ? — Les instituteurs restent les seuls à conserver aujourd'hui la superstition de la dictée correcte. Cette question de l'orthographe les hante, et avec eux, les universitaires."
                                            },
                                            {
                                                "example_id": "0665e77d-e9a0-42f1-963a-1fd42b1f8907",
                                                "sense_id": "d3422ed5-95c7-3468-87f0-a0f39507e8aa",
                                                "text": "Mon père s’était réservé la surveillance de l’orthographe et m’administrait, chaque matin, avant mon café au lait, une dictée de six lignes, dont chaque phrase était minée comme une plage de débarquement."
                                            },
                                            {
                                                "example_id": "dada10c6-0a87-4916-a982-b8550790ecaf",
                                                "sense_id": "d3422ed5-95c7-3468-87f0-a0f39507e8aa",
                                                "text": "Le père de Marcel Pagnol – qui était instituteur – disait : « Anatole France, quel écrivain ! De chacune de ses pages, on peut faire une dictée. »"
                                            },
                                            {
                                                "example_id": "075db26b-62d1-445b-9e73-d09a317c863d",
                                                "sense_id": "d3422ed5-95c7-3468-87f0-a0f39507e8aa",
                                                "text": "Pierre avait fait une dictée sans fautes ; il avait répondu à toutes les questions sur l'arithmétique, sur l'histoire et la géographie de la France, tout cela franchement, sans hésiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1ad137d-0c85-3cf4-8b84-095e6ea41468",
                                        "entry_id": "3f24ec6b-c600-30b0-9ba5-ce88c2b84447",
                                        "glosses": [
                                            "Origine ; inspiration."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d6975e-4f1b-47c0-87fd-874be8d2072a",
                                                "sense_id": "c1ad137d-0c85-3cf4-8b84-095e6ea41468",
                                                "text": "Leurs leçons de bonté et de moralité, qui me semblaient la dictée même du cœur et de la vertu, étaient pour moi inséparables du dogme qu’ils enseignaient."
                                            },
                                            {
                                                "example_id": "d8f68814-ddce-4c76-9628-efa4e34bc396",
                                                "sense_id": "c1ad137d-0c85-3cf4-8b84-095e6ea41468",
                                                "text": "Sans doute, la prière touche à sa fin ; l’enfant, à présent, laissant les formules apprises, prie d’abondance, selon la dictée de son cœur."
                                            },
                                            {
                                                "example_id": "7a58a628-361a-420a-8376-3867e6c95606",
                                                "sense_id": "c1ad137d-0c85-3cf4-8b84-095e6ea41468",
                                                "text": "Comme les républiques précédentes, la Cinquième a progressivement échappé aux dictées apparentes de ses lois originelles. D'amendements en pratiques inédites, de débats institutionnels en propositions de réformes, la Constitution s'est quelque peu estompée dans son apparente stabilité tandis que le système politique changeait en profondeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dictée",
                                "target_lang_code": "fr",
