                "senses": [
                    {
                        "sense_id": "0489f5e8-0e92-3b60-b15b-c5dfcbcdc0d8",
                        "entry_id": "ad6be0fe-fda6-3b86-a313-c417cffa0d12",
                        "glosses": [
                            "техническая помощь: оказание помощи при использовании технических средств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d972ebe1-ae5b-4a5e-a3a3-94e478cfa0da",
                                "sense_id": "0489f5e8-0e92-3b60-b15b-c5dfcbcdc0d8",
                                "text": "Стоимость техпомощи у московских служб сопоставима по цене с эвакуацией."
                            },
                            {
                                "example_id": "315b8a6e-0781-4e18-9a1c-ca767236336f",
                                "sense_id": "0489f5e8-0e92-3b60-b15b-c5dfcbcdc0d8",
                                "text": "Оказывая техпомощь, настаивают на заключении определенных соглашений."
                            }
                        ]
                    },
                    {
                        "sense_id": "10cde058-f0f9-3282-a69c-fac10567a89d",
                        "entry_id": "ad6be0fe-fda6-3b86-a313-c417cffa0d12",
                        "glosses": [
                            "разг. служба оказывающая такую помощь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee41a72-0c88-493a-a48c-1846ed283f08",
                                "sense_id": "10cde058-f0f9-3282-a69c-fac10567a89d",
                                "text": "Необходимо позвонить в техпомощь и вызвать мастеров."
                            }
                        ]
                    }
