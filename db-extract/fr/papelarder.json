                "senses": [
                    {
                        "sense_id": "1f7087ae-86da-3b91-8258-42b36725b40c",
                        "entry_id": "1eeb2be3-1618-3af1-8a5b-bcb2ea80653a",
                        "glosses": [
                            "Se conduire envers quelqu’un de manière papelarde, hypocrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb1d097-9791-4ddc-a7cd-14a9adada048",
                                "sense_id": "1f7087ae-86da-3b91-8258-42b36725b40c",
                                "text": "Oh ! il aura beau le papelarder, répondit Pigoult qui saisit la pensée cachée dans le calembour du substitut, la main de Cécile ne dépend ni du père ni de la mère."
                            },
                            {
                                "example_id": "4b0c4e69-b333-4ad7-b49d-f189511e8c4b",
                                "sense_id": "1f7087ae-86da-3b91-8258-42b36725b40c",
                                "text": "Le vétérinaire ne disputait plus, il papelardait à l’oreille d’Honoré :\n« C’est une malchance… une petite dispute où tu n’étais pas engagé… tu n’y penseras plus demain matin. »"
                            }
                        ]
                    }
                ],
