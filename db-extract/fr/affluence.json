                                                "sense_id": "fc6e725a-1b26-311c-9ed6-16961827c167",
                                                "text": "There was a buildup of pressure in the boiler."
                                            },
                                            {
                                                "example_id": "41516990-21e4-4c07-804c-4dc8a6476ab7",
                                                "sense_id": "fc6e725a-1b26-311c-9ed6-16961827c167",
                                                "text": "Snow buildup on roads makes for hazardous driving."
