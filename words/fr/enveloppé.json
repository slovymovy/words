                                "target_lang_word": "veiled",
                                "target_lang_sense_clarification": "veiled threats or hints"
                            },
                            {
                                "target_lang_word": "oblique",
                                "target_lang_sense_clarification": "formal, indirect criticism or reference"
                            },
                            {
                                "target_lang_word": "roundabout",
