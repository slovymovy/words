                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "response",
                                "target_lang_sense_clarification": "a reaction to an action"
                            },
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "something done in reaction to a move"
                            },
                            {
                                "target_lang_word": "counter",
                                "target_lang_sense_clarification": "a move made in opposition to another"
                            }
                        ]
                    }
                }
            ]
        },
