                        "entry_id": "1d9fd664-c156-3079-97f2-5501e37ef87f",
                        "glosses": [
                            "Acronym of there is no alternative, a political slogan of Margaret Thatcher, promoting liberal capitalism."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f346b266-6e7d-4b2d-9373-5673bb8ac376",
                                "sense_id": "7edcb7a7-eeb6-308e-91e4-a0e33c169e57",
                                "text": "Tina / There is no alternative / But I got to live (You know)"
                            },
                            {
                                "example_id": "54b30002-2c01-4816-b738-88318161a355",
                                "sense_id": "7edcb7a7-eeb6-308e-91e4-a0e33c169e57",
                                "text": "Above all else, they allowed me seriously to ponder the hardest of questions: once we have conceived of a feasible socialism that blasts Thatcher’s Tina out of the water, what must we do, and how far are we willing to go, to bring it about?"
                            }
                        ]
                    }
