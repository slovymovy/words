    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f905b75-ecbb-370a-b7e0-92e490eddba8",
                    "sense_definition": "The simple past tense of the verb <w>do</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>did</w> a fantastic job organizing the office party.",
                            "target_lang_translations": {
                                "ru": "Она <w>проделала</w> фантастическую работу по организации офисной вечеринки.",
                                "es": "Ella <w>hizo</w> un trabajo fantástico organizando la fiesta de la oficina."
                            }
                        },
                        {
                            "text": "I <w>did</w> not realize how late it was until I looked at the clock.",
                            "target_lang_translations": {
                                "ru": "Я <w>не</w> осознавал, насколько было поздно, пока не посмотрел на часы.",
                                "es": "<w>No</w> me di cuenta de lo tarde que era hasta que miré el reloj."
                            }
                        },
                        {
                            "text": "We <w>did</w> everything we could to help them move house.",
                            "target_lang_translations": {
                                "ru": "Мы <w>сделали</w> всё, что могли, чтобы помочь им с переездом.",
                                "es": "<w>Hicimos</w> todo lo que pudimos para ayudarlos con la mudanza."
                            }
                        }
                    ],
                    "synonyms": [
                        "performed",
                        "executed",
                        "accomplished"
                    ],
                    "common_phrases": [
                        "did it",
                        "did not",
                        "did well",
                        "yes I did"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола \"делать\".",
                        "es": "Pasado simple del verbo \"do\" (hacer)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделал",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "делал",
                                "target_lang_sense_clarification": "несовершенный вид"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hizo",
                                "target_lang_sense_clarification": "pretérito de hacer (tercera persona)"
                            },
                            {
                                "target_lang_word": "hice",
                                "target_lang_sense_clarification": "pretérito de hacer (primera persona)"
                            },
                            {
                                "target_lang_word": "hicimos",
                                "target_lang_sense_clarification": "pretérito de hacer (primera persona plural)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d080930-5233-3ce1-9bc8-91fb0b1949e2",
                    "sense_definition": "The past participle of the verb <w>do</w> (used in non-standard or dialectal English instead of 'done').",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shouldn't have <w>did</w> that without asking for permission first.",
                            "target_lang_translations": {
                                "ru": "Ему не следовало этого <w>делать</w>, не спросив сначала разрешения.",
                                "es": "No debió haber <w>hecho</w> eso sin pedir permiso primero."
                            }
                        },
                        {
                            "text": "They have <w>did</w> it again despite all the previous warnings.",
                            "target_lang_translations": {
                                "ru": "Они снова это <w>сделали</w>, несмотря на все предыдущие предупреждения.",
                                "es": "Lo han <w>hecho</w> de nuevo a pesar de todas las advertencias previas."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "non-standard usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени глагола \"do\" (используется в нестандартном или диалектном английском вместо 'done').",
                        "es": "Participio pasado del verbo \"do\" (usado en inglés no estándar o dialectal en lugar de \"done\")."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделал",
                                "target_lang_sense_clarification": "нестандартное употребление"
                            },
                            {
                                "target_lang_word": "сделанный",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hecho",
                                "target_lang_sense_clarification": "participio de hacer"
                            }
                        ]
                    }
                }
            ]
        },
        {
