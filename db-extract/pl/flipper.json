                    }
                ],
                "translations": [
                    {
                        "translation_id": "60d114c5-57ff-4923-a52d-b1d1ca9339c3",
                        "source_entry_id": "dbe4156c-090c-38aa-943b-c0409f2fd5f8",
                        "source_sense_id": "4db76e3b-2839-3f01-b3fd-302fa49afc47",
                        "target_lang_word": "flipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f0ce05-f9b6-3a29-b75a-b47067f1f3c3",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "In marine mammals such as whales (or other aquatic animals such as sea turtles), a wide, flat limb adapted for swimming."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6632cee5-66d4-3eab-8df1-d69c02f649ac",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "A wide, flat, paddle-like rubber covering for the foot, used in swimming."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c2cc253-440a-3f05-8b1b-aac9d7ad2192",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "A flat lever in a pinball machine, triggered by the player to strike the ball and keep it in play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6a1e892-84ce-4c48-bbfb-b774fb5db159",
                                                "sense_id": "6c2cc253-440a-3f05-8b1b-aac9d7ad2192",
                                                "text": "Early pinball machines demanded that a player shake the entire table in an effort to guide the ball through the obstacles (pins—hence the name). Later iterations had mechanical flippers like today's, but more of them—six, which were distributed three on each side up and down the body of the machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752e43d0-972c-3489-95b0-912972f1b915",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "A small flat used to support a larger one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7218eced-bd3d-45f7-87de-4adc3c8c1484",
                                                "sense_id": "752e43d0-972c-3489-95b0-912972f1b915",
                                                "text": "The flipper is designed to give support by standing at a 90-degree angle to the flat. It probably gets its name from its appearance: cut out like a piece of profile scenery, it resembles the flipper of a marine animal, […]"
                                            },
                                            {
                                                "example_id": "e94d8c63-e48a-4384-9a2d-da1d873f397d",
                                                "sense_id": "752e43d0-972c-3489-95b0-912972f1b915",
                                                "text": "When standing alone, a flat may have a small extension, a FLIPPER, for added strength."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c507a38-225f-3b62-a02d-ce0f6f920eef",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "A type of ball bowled by a leg spin bowler, which spins backwards and skids off the pitch with a low bounce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19c1332f-ecb5-3fe7-b6e8-4e5e5a19fd9b",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "Television remote control, clicker."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e5a5e79-bfe7-3a57-9699-b1a21f641f8d",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "The hand."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff08c5d2-eb0a-493d-b1e0-b8b9fc8304ac",
                                                "sense_id": "8e5a5e79-bfe7-3a57-9699-b1a21f641f8d",
                                                "text": "Give me your flipper, old man, and tell me if I can be of any service to you. I'll do what you want at all hazards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea53ce73-b639-33d7-b29f-76a7d8ecbce1",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "A kind of false tooth, usually temporary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b6a7a76-fd8e-4804-95c9-9295d7f1e33c",
                                                "sense_id": "ea53ce73-b639-33d7-b29f-76a7d8ecbce1",
                                                "text": "Dr. Woo attempts to distinguish Blakeslee by pointing out that “one can fondle a breast without having anything to do with dentistry, but one cannot take molds, fabricate and insert flippers into another person's mouth without practicing dentistry.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3dbbb3a-c5be-350b-b7d0-2992daf719e3",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "A kitchen spatula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c06226-bcff-4d9a-a39a-4c40ced0c9c0",
                                                "sense_id": "d3dbbb3a-c5be-350b-b7d0-2992daf719e3",
                                                "text": "Remember the mornings when you help me fix eggs and pancakes for breakfast. You always had to use the “flipper” to turn the pancakes and eggs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0742809a-bfd7-3256-aaf4-f805f38f63d2",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "Someone who flips, in the sense of buying a house or other asset and selling it quickly for profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d24efa26-68f6-4d13-b5c0-8e5e0249cf9e",
                                                "sense_id": "0742809a-bfd7-3256-aaf4-f805f38f63d2",
                                                "text": "Two notable examples of Zombie Formalism would be the electroplated silver monochromes of Jacob Kassay (b. 1984) and the “Rain Paintings” of Lucien Smith (b. 1989), both recent favorites of the art flippers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a31c97-ecd5-3e30-820f-a280bd1751dd",
                                        "entry_id": "0c0d7374-08a1-3732-a813-8522cde22038",
                                        "glosses": [
                                            "Someone who flips in any other sense, for example throwing a coin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a59ed61-754b-37ab-a61c-63846d39e4e6",
                                        "entry_id": "e1b6bb60-b7c1-358d-872d-63a4fcbb50fb",
                                        "glosses": [
                                            "To lift one or both flippers out of the water and slap the surface of the water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
