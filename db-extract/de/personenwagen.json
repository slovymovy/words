                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "car",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f1732c-e295-30a8-a834-ccb7d82de350",
                                        "entry_id": "790ffc89-7c79-389c-bbca-50820c741935",
                                        "glosses": [
                                            "The first part of a cons in Lisp. The first element of a list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0651a81f-e9df-488c-9766-e1a0692545af",
                                                "sense_id": "d2f1732c-e295-30a8-a834-ccb7d82de350",
                                                "text": "The elements of a list are the successive cars along the \"cdr chain.\" That is, the elements are the car, the car of the cdr, the car of the cdr of the cdr, etc."
                                            }
