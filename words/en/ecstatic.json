{
    "word_family": [
        "ecstasy",
        "ecstatically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f7eca11-8dac-3192-9956-6f29db92da63",
                    "sense_definition": "Extremely happy, joyful, or excited.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans were <w>ecstatic</w> after their team won the championship game.",
                            "target_lang_translations": {
                                "tr": "Takımları şampiyonluk maçını kazandıktan sonra taraftarlar <w>kendinden geçmişti</w>."
                            }
                        },
                        {
                            "text": "She was absolutely <w>ecstatic</w> when she received the scholarship offer.",
                            "target_lang_translations": {
                                "tr": "Burs teklifini aldığında kesinlikle <w>mutluluktan havalara uçmuştu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "delighted",
                        "elated",
                        "euphoric",
                        "overjoyed",
                        "thrilled"
                    ],
                    "antonyms": [
                        "miserable",
                        "depressed",
                        "sorrowful"
                    ],
                    "common_phrases": [
                        "ecstatic crowd",
                        "ecstatic applause"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı derecede mutlu, sevinçli veya heyecanlı; havalara uçan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kendinden geçmiş",
                                "target_lang_sense_clarification": "aşırı mutluluktan veya heyecandan ötürü"
                            },
                            {
                                "target_lang_word": "coşkulu",
                                "target_lang_sense_clarification": "büyük bir sevinç ve heyecan içinde olan"
                            },
                            {
                                "target_lang_word": "mutluluktan havalara uçmuş",
                                "target_lang_sense_clarification": "aşırı mutlu ve sevinçli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78100bd4-d4cb-356d-a5d1-b8c77601d555",
                    "sense_definition": "Caused by, relating to, or characterized by intense emotional or mystical trance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mystic entered an <w>ecstatic</w> trance during the religious ritual.",
                            "target_lang_translations": {
                                "tr": "Mistik, dini ritüel sırasında <w>esrimeli</w> bir transa girdi."
                            }
                        },
                        {
                            "text": "A look of <w>ecstatic</w> contemplation was visible on the worshipper's face.",
                            "target_lang_translations": {
                                "tr": "İbadet edenin yüzünde <w>vecd dolu</w> bir tefekkür ifadesi görülüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "rapturous",
                        "delirious"
                    ],
                    "common_phrases": [
                        "ecstatic trance",
                        "ecstatic state"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yoğun bir duygusal veya mistik esrimeyle ilgili, esrimeye dayalı ya da esrimeli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "esrimeli",
                                "target_lang_sense_clarification": "mistik veya ruhani bir kendinden geçme durumuyla ilgili"
                            },
                            {
                                "target_lang_word": "vecd dolu",
                                "target_lang_sense_clarification": "derin mistik coşku veya trans hâlinde olan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c28257ee-00fc-34a5-8771-b14e5ff34f57",
                    "sense_definition": "A person who is subject to mystical trances or extreme states of ecstasy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient writings often record the prophecies spoken by religious <w>ecstatics</w>.",
                            "target_lang_translations": {
                                "tr": "Kadim metinler genellikle dini <w>vecd hâlindeki kimseler</w> tarafından dile getirilen kehanetleri kaydeder."
                            }
                        },
                        {
                            "text": "The medieval <w>ecstatic</w> claimed to experience direct visions of heaven.",
                            "target_lang_translations": {
                                "tr": "Orta Çağ'da yaşamış olan <w>esrik kişi</w>, doğrudan cennete dair vizyonlar gördüğünü iddia etti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Mistik trans veya aşırı esrime/vecd hâlleri yaşayan kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "vecd hâlindeki kimse",
                                "target_lang_sense_clarification": "mistik kendinden geçme durumu yaşayan kişi"
                            },
                            {
                                "target_lang_word": "esrik kişi",
                                "target_lang_sense_clarification": "ruhani coşkuyla kendinden geçen kimse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}