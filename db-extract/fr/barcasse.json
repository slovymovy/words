                                            {
                                                "example_id": "5f595619-7e04-4b62-aefe-6c3d772c2b90",
                                                "sense_id": "51b16706-2b2e-37c6-88eb-355d3c66bb03",
                                                "text": "К берегу причалил баркас."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca0a19fc-327e-3ccb-9b2d-3450b833e5ac",
                                        "entry_id": "c10732a8-455a-3280-8972-78ed7be0d60f",
                                        "glosses": [
                                            "морск. небольшое самоходное судно для портовых перевозок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792772b9-2927-4107-b2f6-0cd2a0a90bb4",
                                                "sense_id": "ca0a19fc-327e-3ccb-9b2d-3450b833e5ac",
                                                "text": "Рыбачка Соня как-то в мае, // Направив к берегу баркас, // Ему сказала: «Все вас знают, // А я так вижу в первый раз»."
                                            },
                                            {
                                                "example_id": "601404b5-dcd8-4bc8-9036-2e1eb6da7e41",
                                                "sense_id": "ca0a19fc-327e-3ccb-9b2d-3450b833e5ac",
                                                "text": "Несколько рыбачьих баркасов заблудилось в море, а два и совсем не вернулись ⟨…⟩."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f391e7c3-9feb-3667-92da-2ee67f74523c",
                                        "entry_id": "c10732a8-455a-3280-8972-78ed7be0d60f",
                                        "glosses": [
