                ],
                "senses": [
                    {
                        "sense_id": "815091e7-93fc-3360-b15d-b1a04785adb3",
                        "entry_id": "56e892ad-591c-31f7-8cff-acc2bb24598a",
                        "glosses": [
                            "eingeschlagene Geschwindigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74acb6a-f531-433c-8e2c-7ec8239c1167",
                                "sense_id": "815091e7-93fc-3360-b15d-b1a04785adb3",
                                "text": "„Und wenn man, wie Woldemar, Kavallerist ist, kann man ja doch auch die acht Meilen von Berlin bis Stechlin in einer Pace machen.“"
                            },
                            {
                                "example_id": "ca8c8bde-d520-4ce0-a888-b4ee33e41715",
                                "sense_id": "815091e7-93fc-3360-b15d-b1a04785adb3",
                                "text": "„Die Pferde wollten in gleicher Pace vorwärts, aber ihre Reiter, überrascht von dem Bilde, das sich vor ihnen auftat, strafften unwillkürlich die Zügel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc2faab0-b404-458b-bdbd-453541d3e1f1",
                        "source_entry_id": "56e892ad-591c-31f7-8cff-acc2bb24598a",
                        "source_sense_id": "815091e7-93fc-3360-b15d-b1a04785adb3",
                        "source_sense_description": "eingeschlagene Geschwindigkeit",
                        "target_lang_word": "rythme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rythme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                        "entry_id": "88026f06-0c23-3c74-a1ef-2f65c50b183b",
                                        "glosses": [
                                            "Nombre ; cadence ; mesure ; fréquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495dc31b-87c2-40a9-a97f-934a18fc2ee1",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Poète, il voulait être poète, créer des rythmes nouveaux, des sensations neuves et souffler au ciel toutes les sottises qui tourbillonnaient dans son cerveau."
                                            },
                                            {
                                                "example_id": "8cd3d0b0-ce1c-4133-98f8-671d66c3c392",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "On préfère construire un roman, qu'on déroule à sa guise, au rythme que l'on choisit, on l'illustre d'images d'Épinal aux coloriages grossiers, aux violentes couleurs."
                                            },
                                            {
                                                "example_id": "09ec451a-ce32-4df4-8db1-12dd6d2342fd",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Ils changent d'activité au rythme des saisons, fabriquent des charpagnes ou cherchent dans les bois les plantes médicinales."
                                            },
                                            {
                                                "example_id": "a39f8126-08a7-4794-84b1-ddcb0a0ab7a1",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Il y organise son propre travail et peut même y être rejoint par sa famille, durant les mois d'été, puisque le rythme bisannuel impose entre quatre et six mois de « belle saison » sur le littoral - […] - et le reste à Paris ([…])."
                                            },
                                            {
                                                "example_id": "45c9274e-ec19-491d-9af7-07fc3d20a907",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Quand la jeune femme appuya sur la télécommande pour verrouiller sa voiture, les clignotants bipèrent en rythme avec les lointains échos de musique et de rires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2501ec4f-4a2d-3a9b-b0a0-03f10f075fde",
                                        "entry_id": "88026f06-0c23-3c74-a1ef-2f65c50b183b",
                                        "glosses": [
                                            "Proportion des durées de notes suivant la variation des temps forts et des temps faibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10dc59c6-7867-4f34-88e9-437ddeb8a25c",
                                                "sense_id": "2501ec4f-4a2d-3a9b-b0a0-03f10f075fde",
                                                "text": "Je me trouvais précisément dans l'un de ces débits et m'y acoquinais au rythme d'un vague accordéon."
                                            },
                                            {
                                                "example_id": "aa1497ee-4656-4d21-943a-9b025c907e46",
                                                "sense_id": "2501ec4f-4a2d-3a9b-b0a0-03f10f075fde",
                                                "text": "Bien accompagnée par des musiciens talentueux dont l’harmoniciste inspiré, Vincent Bucher, Joyce Tape a chanté, dansé au rythme du blues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc3ddf1-4638-3f01-b1b6-040e66691b53",
                                        "entry_id": "88026f06-0c23-3c74-a1ef-2f65c50b183b",
                                        "glosses": [
                                            "Succession répétitive d'une variable physiologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8aaebb-8fe6-431d-b375-437b08669981",
                                                "sense_id": "cbc3ddf1-4638-3f01-b1b6-040e66691b53",
                                                "text": "Les rythmes circadiens."
                                            },
                                            {
                                                "example_id": "c0bda2a7-3b98-4090-af08-7f8f9e18d6f5",
                                                "sense_id": "cbc3ddf1-4638-3f01-b1b6-040e66691b53",
                                                "text": "Le rythme de sécrétion d'une hormone."
                                            }
                                        ]
                                    }
                                ]
                            },
