                    {
                        "sense_id": "f03f25b4-685b-364b-8299-b7bad2edecee",
                        "entry_id": "9dad8c77-d6f0-3df4-94ee-76ff25b34bc1",
                        "glosses": [
                            "Fils de laiton attachés en long sur la forme dans la fabrication du papier à la main."
                        ],
                        "tags": [
                            "Papeterie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8e57ab11-e4af-33a2-b882-01f5a7f32e1a",
                        "entry_id": "9dad8c77-d6f0-3df4-94ee-76ff25b34bc1",
                        "glosses": [
                            "Raies que font ces fils sur la feuille de papier."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3a865187-c495-40f2-87c8-921f684bf7a8",
                                "sense_id": "8e57ab11-e4af-33a2-b882-01f5a7f32e1a",
                                "text": "Les vergeures – les marques laissées par les fils du tamis utilisé pour fabriquer le papier, qui lui donnent son nom – forment des aspérités ténues, pareilles à des rides, qui projettent de subtiles ombres sur la feuille blanche."
                            },
                            {
                                "example_id": "bcf67da9-7cc9-45c3-a47e-ec21d8ac9447",
                                "sense_id": "8e57ab11-e4af-33a2-b882-01f5a7f32e1a",
                                "text": "Le papier vélin est sans vergeures et sans pontuseaux."
                            }
                        ]
                    }
