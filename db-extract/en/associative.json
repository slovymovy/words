                                        "glosses": [
                                            "unabhängig von der Reihenfolge der Rechenoperationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa8a2e19-246c-4ba9-be6a-16783a9d68ac",
                                                "sense_id": "2077e94f-fdfa-39dc-9c7c-b4813c9d7eb1",
                                                "text": "Addition und Multiplikation sind im Gegensatz zu Subtraktion und Division assoziativ."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
