                                "target_senses": [
                                    {
                                        "sense_id": "47a4b59a-b561-353a-a50a-f7f7b6f9f4e6",
                                        "entry_id": "1d001a30-3d10-371a-9650-9910310b805b",
                                        "glosses": [
                                            "Of or relating to eugenics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e659c7-1330-4087-9fb1-955595be6b2b",
                                                "sense_id": "47a4b59a-b561-353a-a50a-f7f7b6f9f4e6",
                                                "text": "In making his point, Thomas dedicated more than a dozen pages on the history of the eugenics movement to explain why “the use of abortion to achieve eugenic goals is not merely hypothetical.”"
                                            },
                                            {
                                                "example_id": "728660ed-7c6a-4669-bec4-522c560a76a3",
                                                "sense_id": "47a4b59a-b561-353a-a50a-f7f7b6f9f4e6",
                                                "text": "[Alan] Dershowitz, who as a Harvard Law professor regularly attended lunches [Jeffrey] Epstein hosted for the scientists, told the Times he was “appalled” to learn about Epstein's eugenic ambitions, but their friendship continued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa9c568-a5f4-3157-8edd-92c47d327d38",
                                        "entry_id": "1d001a30-3d10-371a-9650-9910310b805b",
                                        "glosses": [
                                            "Relating or adapting to production of strong or effective offspring."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
