                "senses": [
                    {
                        "sense_id": "931ce0cc-16db-3c19-b852-02923402147d",
                        "entry_id": "502f9bab-fcb9-3f55-b878-c4f5a1c6319b",
                        "glosses": [
                            "in mittelalterlichen Handschriften und Drucken verwendeter Überstrich, der einen folgenden Nasal anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20bb1846-668b-4666-bf15-7ec39168a6bd",
                                "sense_id": "931ce0cc-16db-3c19-b852-02923402147d",
                                "text": "„Als Nasalstrich aufgefasst sind Striche über Vokalbuchstaben im Wortinneren und am Wortende (meist -e̅, das als -en aufzulösen war).“"
                            },
                            {
                                "example_id": "a844a4cc-767b-4bdb-afa6-d75d2e4280b4",
                                "sense_id": "931ce0cc-16db-3c19-b852-02923402147d",
                                "text": "„Der Nasalstrich steht für ein darauffolgendes n oder m, also hier: an oder am, en oder em etc.“"
                            },
                            {
                                "example_id": "f93f250a-4e99-4789-8c54-de2ab7c588e3",
                                "sense_id": "931ce0cc-16db-3c19-b852-02923402147d",
                                "text": "„An Kürzeln kennt der deutsche Text der Erstausgabe nur den Nasalstrich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
