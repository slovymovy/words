                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "siatka z linek, służąca do połowu ryb lub małych zwierząt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de80c747-5fd7-45e2-9264-ca7868add335",
                                                "sense_id": "a1790017-215f-310e-958c-d60e2737843c",
                                                "text": "Rybacy wcześniej wrócili z morza, bo zerwały im się sieci i nie mogli łowić ryb."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "50a2f9b0-e3b7-3f20-85ca-96343ba0f256",
