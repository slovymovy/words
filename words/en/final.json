{
    "word_family": [
        "finalist",
        "finality",
        "finalize",
        "finally",
        "semifinal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d7b7034-a6af-3690-9d3f-e0a7d34991a3",
                    "sense_definition": "Happening or coming at the end of a series, process, or event.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>final</w> call for passengers boarding the flight to London.",
                            "target_lang_translations": {
                                "ru": "Это <w>после́днее</w> объявление о посадке на рейс в Лондон.",
                                "zh": "这是前往伦敦航班乘客的<w>最后</w>登机通知。"
                            }
                        },
                        {
                            "text": "The <w>final</w> chapter of the book was the most exciting one.",
                            "target_lang_translations": {
                                "ru": "<w>Заключи́тельная</w> глава книги была самой захватывающей.",
                                "zh": "这本书的<w>最后</w>一章是最精彩的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "last",
                        "ultimate"
                    ],
                    "antonyms": [
                        "first",
                        "initial"
                    ],
                    "common_phrases": [
                        "final stage",
                        "final destination",
                        "final warning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или наступающий в конце серии, процесса или события.",
                        "zh": "发生在系列、过程或事件末尾的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "самый общий перевод; находящийся в конце"
                            },
                            {
                                "target_lang_word": "заключи́тельный",
                                "target_lang_sense_clarification": "завершающий собой что-либо (речь, концерт, главу)"
                            },
                            {
                                "target_lang_word": "фина́льный",
                                "target_lang_sense_clarification": "относящийся к финалу, завершающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "指顺序上的末尾"
                            },
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "指过程的终点"
                            },
                            {
                                "target_lang_word": "结论性",
                                "target_lang_sense_clarification": "指作为总结的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b70e19d-a25c-3f2f-ab82-8b3203cc20f8",
                    "sense_definition": "Impossible to change or argue with; allowing no further doubt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge's decision is <w>final</w> and cannot be appealed.",
                            "target_lang_translations": {
                                "ru": "Решение судьи <w>оконча́тельное</w> и не подлежит обжалованию.",
                                "zh": "法官的判决是<w>最终</w>的，不得上诉。"
                            }
                        },
                        {
                            "text": "We need a <w>final</w> answer from you by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Нам нужен ваш <w>оконча́тельный</w> ответ к завтрашнему утру.",
                                "zh": "我们需要你在明天早上前给出<w>最终</w>答复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conclusive",
                        "decisive",
                        "definitive",
                        "ultimate",
                        "settled"
                    ],
                    "common_phrases": [
                        "final decision",
                        "final answer",
                        "final say"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подлежащий изменению или обсуждению; не допускающий сомнений.",
                        "zh": "不可更改或争辩的；不容置疑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оконча́тельный",
                                "target_lang_sense_clarification": "решающий, бесповоротный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "指决定性的"
                            },
                            {
                                "target_lang_word": "不可更改",
                                "target_lang_sense_clarification": "指无法撤销的决定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65934c1f-42de-36c8-a3d5-8626d3fdbd42",
                    "sense_definition": "Occurring at the very end of a word.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some languages, the <w>final</w> consonant is not pronounced.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках <w>коне́чный</w> согласный не произносится.",
                                "zh": "在某些语言中，<w>末尾</w>的辅音是不发音的。"
                            }
                        },
                        {
                            "text": "Stress often falls on the <w>final</w> syllable in this dialect.",
                            "target_lang_translations": {
                                "ru": "В этом диалекте ударение часто падает на <w>после́дний</w> слог.",
                                "zh": "在这种方言中，重音通常落在<w>末尾</w>的音节上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (linguistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в самом конце слова.",
                        "zh": "出现在词语最末尾的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коне́чный",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "末尾",
                                "target_lang_sense_clarification": "语言学中指词末的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98353a86-1df9-3fc5-b61e-f5c7d312071c",
                    "sense_definition": "The last match or game in a competition that decides the winner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team played very well and reached the <w>final</w>.",
                            "target_lang_translations": {
                                "ru": "Наша команда играла очень хорошо и вышла в <w>фина́л</w>.",
                                "zh": "我们的队伍表现出色，成功打进了<w>决赛</w>。"
                            }
                        },
                        {
                            "text": "Millions of people watched the World Cup <w>final</w> on television.",
                            "target_lang_translations": {
                                "ru": "Миллионы людей смотрели <w>фина́л</w> Чемпионата мира по телевизору.",
                                "zh": "数百万人通过电视观看了世界杯<w>决赛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup final",
                        "quarter-final",
                        "semi-final"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последний матч или игра в соревновании, определяющая победителя.",
                        "zh": "比赛中决定胜负的最后一场比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фина́л",
                                "target_lang_sense_clarification": "решающая встреча в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决赛",
                                "target_lang_sense_clarification": "体育比赛的最后阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b743fe0-77ea-38cc-9881-791d17ed286a",
                    "sense_definition": "An important test taken at the end of a school term or course.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is studying late every night because she has a chemistry <w>final</w> soon.",
                            "target_lang_translations": {
                                "ru": "Она занимается допоздна каждый вечер, потому что у неё скоро <w>итого́вый экза́мен</w> по химии.",
                                "zh": "她每天晚上都学习到很晚，因为她很快就要参加化学<w>期末考试</w>了。"
                            }
                        },
                        {
                            "text": "Students are often very stressed during the week of <w>finals</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты часто испытывают сильный стресс во время <w>се́ссии</w>.",
                                "zh": "学生们在<w>期末考试</w>周期间通常压力很大。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take finals",
                        "study for finals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важный экзамен, сдаваемый в конце учебного семестра или курса.",
                        "zh": "在学期或课程结束时进行的重大考试。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "итого́вый экза́мен",
                                "target_lang_sense_clarification": "экзамен в конце курса"
                            },
                            {
                                "target_lang_word": "выпускно́й экза́мен",
                                "target_lang_sense_clarification": "экзамен при окончании учебного заведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "期末考试",
                                "target_lang_sense_clarification": "学期末的考核"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a7b7a4e-1c36-3fea-9382-28b476fc3bc0",
                    "sense_definition": "To succeed in reaching the final round of a competition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>finalled</w> in the swimming event but did not win a medal.",
                            "target_lang_translations": {
                                "ru": "Он <w>вы́шел в фина́л</w> в соревнованиях по плаванию, но не выиграл медаль.",
                                "zh": "他在游泳项目中<w>进入了决赛</w>，但没有获得奖牌。"
                            }
                        },
                        {
                            "text": "Only the top eight athletes <w>finalled</w> in the 100-meter dash.",
                            "target_lang_translations": {
                                "ru": "Только восемь лучших спортсменов <w>вы́шли в фина́л</w> в беге на 100 метров.",
                                "zh": "只有前八名运动员<w>进入了决赛</w>百米短跑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно пройти в финальный раунд соревнования.",
                        "zh": "成功进入比赛的决赛阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́йти в фина́л",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进入决赛",
                                "target_lang_sense_clarification": "指晋级到最后阶段"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}