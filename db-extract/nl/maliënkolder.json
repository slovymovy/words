                ],
                "senses": [
                    {
                        "sense_id": "d9689268-8097-374b-bf5b-e3117bf62e1d",
                        "entry_id": "6bd99564-9252-32a8-843c-d68e70c92f58",
                        "glosses": [
                            "hemd gemaakt van ijzeren ringetjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea44d171-549a-4115-82b3-c21557ac557b",
                                "sense_id": "d9689268-8097-374b-bf5b-e3117bf62e1d",
                                "text": "Op zijn hoofd had de gedaante een grote helm die bedekt was met ijzeren punten. Hij droeg een geheel uit glinsterende schubben gemaakt maliënkolder en had zwarte handschoenen aan."
                            },
                            {
                                "example_id": "0b38b3cf-89ab-4dd9-bc8d-8e2ac754f4cc",
                                "sense_id": "d9689268-8097-374b-bf5b-e3117bf62e1d",
                                "text": "De twee engelen stonden doodstil naast de dennenboom. Ze hadden niets krijgshaftigs meer, zoals de laatste keer toen ze allebei in zwarte maliënkolders en rode mantels waren gekleed en er een zwaard langs hun zijde hing. Nu droegen ze een witte kaftan die tot op de grond reikte en met een touw om hun middel was gebonden."
                            },
                            {
                                "example_id": "aba0cc6d-af25-41f4-8bd2-357ac5e07339",
                                "sense_id": "d9689268-8097-374b-bf5b-e3117bf62e1d",
                                "text": "De afwachtende houding van het Sportpaleis - alsof u wilde testen of de wolvenbende de hype wel verdiende - moet dan ook gewrongen hebben voor Colombie. Die is sowieso al niet praatziek, waardoor de eerste helft van het concert meer leek op een hermetische modeshow met het codewoord ‘glitter’: in de blinddoek voor Colombies ogen, in zijn glinsterende badjas, en in de maliënkolder die hij droeg voor ‘Moonlight’ - alsof The Phantom of the Opera de nacht had doorgebracht in de stripclub."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a795d04-6ec3-4d0d-9d12-7798b56c3909",
                        "source_entry_id": "6bd99564-9252-32a8-843c-d68e70c92f58",
                        "source_sense_id": "d9689268-8097-374b-bf5b-e3117bf62e1d",
                        "target_lang_word": "Kettenhemd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kettenhemd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b9a1876-8575-3454-a0ac-f392333ec02e",
                                        "entry_id": "aa04d04d-3b33-3dc1-8843-db6ec10d5083",
                                        "glosses": [
                                            "aus Ketten bestehende Schutzkleidung, die den Oberkörper vor Schnittverletzungen schützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5fb513-49d3-4a5a-8f9c-68642f6c33f1",
                                                "sense_id": "0b9a1876-8575-3454-a0ac-f392333ec02e",
                                                "text": "Ein Kettenhemd schützte nicht vor Lanzen."
                                            },
                                            {
                                                "example_id": "3461c6a0-40ea-44a7-899a-a76aa4eea38c",
                                                "sense_id": "0b9a1876-8575-3454-a0ac-f392333ec02e",
                                                "text": "„Waren sie anfänglich aus Hanf geknüpft oder aus Leder gefertigt und zusätzlich mit Bronzescheiben versehen, so gab es seit dem 3. Jahrhundert vor Christus auch Kettenhemden aus Eisen.“"
                                            },
                                            {
                                                "example_id": "10e8f030-c6d1-4654-89da-3d43234915b4",
                                                "sense_id": "0b9a1876-8575-3454-a0ac-f392333ec02e",
                                                "text": "„Hinzu kamen ein massiver Helm mit Wangenklappen und ein circa zehn Kilogramm schweres Kettenhemd.“"
                                            },
                                            {
                                                "example_id": "908e821a-5083-4205-949b-795fa5690f1c",
                                                "sense_id": "0b9a1876-8575-3454-a0ac-f392333ec02e",
                                                "text": "„Sie bescherten ihren Kriegern die Metallscheide und das Kettenhemd.“"
                                            },
                                            {
                                                "example_id": "c1e218f5-1bf4-4ff9-bc4d-f345064680fc",
                                                "sense_id": "0b9a1876-8575-3454-a0ac-f392333ec02e",
                                                "text": "„Da die Herstellung der metallischen Schutzhemden aufwendig war und sich Reste von Kettenhemden nur in manchen Gräbern finden, rätseln Forscher über den Status der Träger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5695601-5c9c-4cdb-a98f-353a05e1ed09",
                        "source_entry_id": "6bd99564-9252-32a8-843c-d68e70c92f58",
