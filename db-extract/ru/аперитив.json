                    },
                    {
                        "translation_id": "5b0be194-38ad-492a-8c19-c1cd57c178fb",
                        "source_entry_id": "e84e3f52-ec06-389a-901b-d74af4163f6b",
                        "source_sense_id": "4a8a3b62-6290-3874-8a74-791f640a7456",
