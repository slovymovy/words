                "senses": [
                    {
                        "sense_id": "6d1e607e-5d5d-3638-bb7b-d21b36a473ac",
                        "entry_id": "e7418820-c5d0-3df4-8fb3-8b47a21eff4e",
                        "glosses": [
                            "Vorstellungen/Pläne für die Gestaltung des eigenen Lebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4e115c-ca14-4b1e-b09a-50fe6534454f",
                                "sense_id": "6d1e607e-5d5d-3638-bb7b-d21b36a473ac",
                                "text": "„Über die Jahre hinweg wird Luise immer deutlicher, wie sehr sich ihre Lebensentwürfe unterscheiden.“"
                            },
                            {
                                "example_id": "2cc26b45-e15e-46a3-953c-8c77e1042a0d",
                                "sense_id": "6d1e607e-5d5d-3638-bb7b-d21b36a473ac",
                                "text": "„Ich hatte wirklich keine Lust, noch einmal einen Monat lang darüber zu streiten, ob die Menschen ihre Lebensentwürfe selbst bestimmen oder dem Staat überlassen sollten.“"
                            },
                            {
                                "example_id": "a78b8919-6b99-473b-bca7-a64fcec5b914",
                                "sense_id": "6d1e607e-5d5d-3638-bb7b-d21b36a473ac",
                                "text": "„Der alte Mann fasst sich kurz, weil er keine Geduld hat zu langem Gerede, der Grund dafür ist jedoch weniger der mürrische Charakter, den er an den Tag legt, als die Ausweglosigkeit, in die sein gescheiterter Lebensentwurf ihn gebracht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
