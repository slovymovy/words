                "translations": [
                    {
                        "translation_id": "bc07e59d-f9ab-4ced-8744-c3eb02cad1bf",
                        "source_entry_id": "bfd002cc-d516-39d8-8d66-9da7f61d2b1c",
                        "source_sense_id": "9a072bdb-9402-375e-92f7-154f09bc1355",
                        "target_lang_word": "New Zealander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "New Zealander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2d9ab2-7aa7-38a0-8905-69f14e92c458",
                                        "entry_id": "c61040b0-961d-3e0f-9e5b-b8dfed258f68",
                                        "glosses": [
                                            "A person from New Zealand or of New Zealand descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25eb278d-31b7-4c4c-b86b-a63a32bf4a9e",
                                                "sense_id": "fe2d9ab2-7aa7-38a0-8905-69f14e92c458",
                                                "text": "There was a directional driller who I regularly ran into, a New Zealander by the name of Maurice."
                                            },
                                            {
                                                "example_id": "97c021bb-1e4e-477c-bb29-b820bb6cae18",
                                                "sense_id": "fe2d9ab2-7aa7-38a0-8905-69f14e92c458",
                                                "text": "The rate of arrivals fluctuates with the relative economic fortunes of each country, but since the late 1960s, faster growth, higher wages, greater job opportunities and a stronger dollar have been an economic magnet drawing New Zealanders across the ditch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c5003ae-bacb-4146-a55b-be78c5cd4bc9",
                        "source_entry_id": "bfd002cc-d516-39d8-8d66-9da7f61d2b1c",
                        "source_sense_id": "9a072bdb-9402-375e-92f7-154f09bc1355",
                        "target_lang_word": "Néo-Zélandais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Néo-Zélandais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f611a01-6297-36b3-a7c4-a0dc56397d24",
                                        "entry_id": "bb636c5e-4b7a-3bbb-9d47-3632f94980c6",
                                        "glosses": [
                                            "Habitant ou originaire de la Nouvelle-Zélande ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ff6b4d-a089-4389-b4bb-bbace7181c0e",
                                                "sense_id": "2f611a01-6297-36b3-a7c4-a0dc56397d24",
                                                "text": "Les hypocrites Néo-Zélandais firent un excellent accueil aux nouveaux arrivants."
                                            },
                                            {
                                                "example_id": "3f0e42eb-396e-46e8-a550-c8d8c06dd424",
                                                "sense_id": "2f611a01-6297-36b3-a7c4-a0dc56397d24",
                                                "text": "Je ne suis revenu que pour la « petite finale », ce match qui opposait les deux équipes vaincues en demi-finale, les Néo-Zélandais et nous. Pour mon retour dans l’équipe, j'ai été gâté !"
                                            },
                                            {
                                                "example_id": "c4fa81e5-15cb-4d10-a54a-e615dc205d20",
                                                "sense_id": "2f611a01-6297-36b3-a7c4-a0dc56397d24",
                                                "text": "Il sera suppléé par le pilote de réserve, le jeune Néo-Zélandais Liam Lawson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5ec50b0-928b-4ac6-b39a-8085b59a0827",
