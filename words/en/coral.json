{
    "word_family": [
        "coralline",
        "coralloid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc390759-a217-39e1-afea-f3f4b1aef640",
                    "sense_definition": "A small marine invertebrate that lives in colonies and produces a hard calcium carbonate skeleton, often forming reefs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "marine_organism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver was careful not to touch the delicate <w>coral</w> while swimming near the reef.",
                            "target_lang_translations": {
                                "ru": "Дайвер был осторожен, чтобы не коснуться хрупкого <w>коралла</w>, плавая возле рифа.",
                                "zh": "潜水员在礁石附近游泳时小心翼翼，避免碰到脆弱的<w>珊瑚</w>。"
                            }
                        },
                        {
                            "text": "Rising ocean temperatures are causing significant damage to <w>coral</w> populations around the world.",
                            "target_lang_translations": {
                                "ru": "Повышение температуры океана наносит значительный ущерб популяциям <w>кораллов</w> во всем мире.",
                                "zh": "海洋温度上升正在对全球的<w>珊瑚</w>种群造成严重破坏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coral reef",
                        "coral bleaching",
                        "coral colony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкое морское беспозвоночное, живущее колониями и образующее твердый известковый скелет, часто формирующее рифы.",
                        "zh": "一种小型海洋无脊椎动物，群体生活，并分泌坚硬的碳酸钙骨骼，常形成珊瑚礁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кора́лл",
                                "target_lang_sense_clarification": "морское животное"
                            },
                            {
                                "target_lang_word": "кора́лловый поли́п",
                                "target_lang_sense_clarification": "биология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珊瑚",
                                "target_lang_sense_clarification": "海洋生物，泛指形成珊瑚礁的珊瑚"
                            },
                            {
                                "target_lang_word": "珊瑚虫",
                                "target_lang_sense_clarification": "生物学，更具体指单个珊瑚动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2434fee1-c280-306f-ad02-df00cc1e3992",
                    "sense_definition": "The hard, stony substance secreted by certain marine polyps, often red, pink, or white, used to make jewelry and ornaments.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a vintage necklace made of polished red <w>coral</w>.",
                            "target_lang_translations": {
                                "ru": "Она носила винтажное ожерелье из полированного красного <w>коралла</w>.",
                                "zh": "她戴着一条用抛光红<w>珊瑚</w>制成的复古项链。"
                            }
                        },
                        {
                            "text": "The artisan carved the piece of <w>coral</w> into a small, intricate flower.",
                            "target_lang_translations": {
                                "ru": "Ремесленник вырезал из куска <w>коралла</w> маленький затейливый цветок.",
                                "zh": "工匠把那块<w>珊瑚</w>雕成了一朵小巧精致的花。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coral necklace",
                        "coral beads",
                        "red coral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое каменистое вещество, выделяемое определенными морскими полипами, часто красного, розового или белого цвета, используемое для изготовления украшений.",
                        "zh": "某些海洋珊瑚虫分泌出的坚硬石质物，常呈红色、粉色或白色，可用来制作首饰和装饰品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кора́лл",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珊瑚",
                                "target_lang_sense_clarification": "作首饰或装饰品材料的硬质珊瑚"
                            },
                            {
                                "target_lang_word": "红珊瑚",
                                "target_lang_sense_clarification": "尤指红色品种，用于珠宝"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41b9d6fd-9e0a-3dbe-9802-c0acd3b70b08",
                    "sense_definition": "A pinkish-orange color, resembling the shade of red coral.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridesmaids wore dresses in a vibrant shade of <w>coral</w>.",
                            "target_lang_translations": {
                                "ru": "Подружки невесты были одеты в платья яркого оттенка <w>кораллового</w>.",
                                "zh": "伴娘们穿着鲜艳<w>珊瑚色</w>的礼服。"
                            }
                        },
                        {
                            "text": "He decided to paint the bathroom walls <w>coral</w> to make the space feel warmer.",
                            "target_lang_translations": {
                                "ru": "Он решил покрасить стены ванной в <w>коралловый</w> цвет, чтобы сделать пространство более теплым.",
                                "zh": "他决定把浴室的墙刷成<w>珊瑚色</w>，让空间显得更温暖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "salmon"
                    ],
                    "common_phrases": [
                        "coral pink",
                        "bright coral",
                        "soft coral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Розовато-оранжевый цвет, напоминающий оттенок красного коралла.",
                        "zh": "一种粉橙色，类似红珊瑚的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кора́лловый цвет",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "кора́лл",
                                "target_lang_sense_clarification": "название цвета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珊瑚色",
                                "target_lang_sense_clarification": "颜色名称，偏粉橙色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "979a4782-ba3f-3abf-9702-251bdf202b47",
                    "sense_definition": "The ovaries or roe of a cooked lobster, which turn a reddish color when heated.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef used the lobster <w>coral</w> to thicken and flavor the seafood sauce.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар использовал <w>икру</w> лобстера, чтобы загустить и придать вкус соусу из морепродуктов.",
                                "zh": "主厨用<w>龙虾卵</w>给海鲜酱汁增稠并增加风味。"
                            }
                        },
                        {
                            "text": "Gourmets consider the <w>coral</w> to be one of the most delicious parts of the shellfish.",
                            "target_lang_translations": {
                                "ru": "Гурманы считают <w>икру</w> одной из самых вкусных частей моллюска.",
                                "zh": "美食家认为<w>龙虾卵</w>是这种甲壳类动物最美味的部分之一。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roe"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "culinary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Яичники или икра вареного омара, которые при нагревании приобретают красноватый цвет.",
                        "zh": "熟龙虾的卵巢或卵，受热后会变成红色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "икра́",
                                "target_lang_sense_clarification": "омара или лобстера"
                            },
                            {
                                "target_lang_word": "кора́лл",
                                "target_lang_sense_clarification": "кулинарный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "龙虾卵",
                                "target_lang_sense_clarification": "熟龙虾中加热后变红的卵或卵巢"
                            },
                            {
                                "target_lang_word": "龙虾膏",
                                "target_lang_sense_clarification": "烹饪用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab8c4ac6-604f-3484-91ea-85f5fa88eba0",
                    "sense_definition": "A toy made of polished coral, often fitted with bells, formerly given to infants to help with teething.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old portrait, the baby holds a silver rattle with a piece of <w>coral</w> at the end.",
                            "target_lang_translations": {
                                "ru": "На старинном портрете ребенок держит серебряную погремушку с кусочком <w>коралла</w> на конце.",
                                "zh": "在那幅老画像里，婴儿手里拿着一只银制的<w>珊瑚拨浪鼓</w>。"
                            }
                        },
                        {
                            "text": "The nurse gave the crying infant his <w>coral</w> to soothe his sore gums.",
                            "target_lang_translations": {
                                "ru": "Няня дала плачущему младенцу его <w>коралловую погремушку</w>, чтобы успокоить боль в деснах.",
                                "zh": "保姆把他的<w>珊瑚磨牙玩具</w>递给了哭闹的婴儿，好缓解牙龈疼痛。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрушка из полированного коралла, часто с бубенчиками, которую раньше давали младенцам для облегчения прорезывания зубов.",
                        "zh": "一种用抛光珊瑚制成、常配有小铃铛的玩具，旧时会给婴儿用来缓解出牙不适。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кора́лловая погрему́шка",
                                "target_lang_sense_clarification": "игрушка"
                            },
                            {
                                "target_lang_word": "кора́лл",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珊瑚磨牙玩具",
                                "target_lang_sense_clarification": "旧时供婴儿磨牙的珊瑚玩具"
                            },
                            {
                                "target_lang_word": "珊瑚拨浪鼓",
                                "target_lang_sense_clarification": "带铃的旧式婴儿玩具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ae4ba6c-aa17-3ac7-a86a-5af404bbb8ac",
                    "sense_definition": "Obsolete spelling of <w>corral</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, the farmer drove the cattle into the <w>coral</w> for the night.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи фермер загнал скот в <w>загон</w> на ночь.",
                                "zh": "在那份旧手稿里，农夫夜里把牛赶进<w>畜栏</w>。"
                            }
                        },
                        {
                            "text": "The spelling of <w>coral</w> to mean an enclosure is no longer in standard use.",
                            "target_lang_translations": {
                                "ru": "Написание слова <w>coral</w> в значении \"загон\" больше не является общепринятым.",
                                "zh": "“coral”用来表示<w>畜栏</w>的拼写如今已不再属于标准用法。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "spelling variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова corral (загон).",
                        "zh": "corral 的旧式拼写，意为“畜栏、围栏”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заго́н",
                                "target_lang_sense_clarification": "для скота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "畜栏",
                                "target_lang_sense_clarification": "corral 的旧拼写，指牲畜围栏"
                            },
                            {
                                "target_lang_word": "围栏",
                                "target_lang_sense_clarification": "较泛，围起来的栏舍"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e328ee0d-911b-31b8-913c-3fd3bb18ae6a",
                    "sense_definition": "Made of the hard substance secreted by marine polyps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a rare <w>coral</w> carving from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена редкая резьба по <w>кораллу</w> восемнадцатого века.",
                                "zh": "博物馆展出了一件罕见的十八世纪<w>珊瑚制的</w>雕刻品。"
                            }
                        },
                        {
                            "text": "She bought a pair of <w>coral</w> earrings to match her summer outfit.",
                            "target_lang_translations": {
                                "ru": "Она купила пару <w>коралловых</w> серег под свой летний наряд.",
                                "zh": "她买了一对<w>珊瑚制的</w>耳环来搭配她的夏装。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coral jewelry",
                        "coral island"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из твердого вещества, выделяемого морскими полипами.",
                        "zh": "由海洋珊瑚虫分泌的坚硬物质制成的。"
                    },
                    "translations": {
