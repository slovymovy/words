{
    "word_family": [
        "casual",
        "casually"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dcc02690-1e29-39a5-bd13-ff48e423f327",
                    "sense_definition": "The state or quality of being informal, relaxed, or unconcerned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>casualness</w> of the dress code made everyone feel more comfortable at the office party.",
                            "target_lang_translations": {
                                "zh": "着装要求的<w>随意</w>让大家在办公室聚会上感到更自在。"
                            }
                        },
                        {
                            "text": "She was surprised by the <w>casualness</w> with which he discussed such a serious topic.",
                            "target_lang_translations": {
                                "zh": "他讨论如此严肃的话题时表现出的<w>随意</w>让她感到惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "informality",
                        "relaxedness"
                    ],
                    "antonyms": [
                        "formality"
                    ],
                    "target_lang_definitions": {
                        "zh": "指非正式、放松或不拘小节的状态或品质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "随意",
                                "target_lang_sense_clarification": "强调行为或氛围上的不拘束、不正式。"
                            },
                            {
                                "target_lang_word": "非正式",
                                "target_lang_sense_clarification": "指不符合严格礼仪或规范的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b766dcc8-0e7f-330f-9b25-c3ecd837a923",
                    "sense_definition": "A relaxed, nonchalant, or indifferent attitude toward something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controlled way in which northern Europeans approach life is quite different from the <w>casualness</w> that characterizes American attitudes.",
                            "target_lang_translations": {
                                "zh": "北欧人对待生活那种克制的方式，与美国人态度中那种<w>漫不经心</w>截然不同。"
                            }
                        },
                        {
                            "text": "He treated the dangerous situation with a <w>casualness</w> that worried his colleagues.",
                            "target_lang_translations": {
                                "zh": "他以一种令同事担忧的<w>漫不经心</w>态度对待危险的情况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonchalance",
                        "indifference"
                    ],
                    "antonyms": [
                        "seriousness",
                        "concern"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对某事表现出的放松、漫不经心或漠不关心的态度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漫不经心",
                                "target_lang_sense_clarification": "形容对事情不放在心上，态度轻率。"
                            },
                            {
                                "target_lang_word": "漠不关心",
                                "target_lang_sense_clarification": "形容对事情冷淡，不加关注。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}