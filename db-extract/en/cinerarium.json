                    {
                        "sense_id": "625b652a-f3fa-35cd-8602-63c7f3e9428e",
                        "entry_id": "be491114-9381-39e1-aad8-993db578b547",
                        "glosses": [
                            "A place or receptacle for depositing the ashes of cremated people."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b66c615-7f87-4961-b1b8-f47d6aa146a7",
                                "sense_id": "625b652a-f3fa-35cd-8602-63c7f3e9428e",
                                "text": "They were called ossuaria, from their containing bones,—cineraria, in reference to their containing ashes,—or ollæ, pots; these had generally a narrow pointed bottom."
                            },
                            {
                                "example_id": "23797d51-c155-4d24-80c7-b5e19d8fddd4",
                                "sense_id": "625b652a-f3fa-35cd-8602-63c7f3e9428e",
                                "text": "On a great marble cinerarium (or vase for human ashes) is an inscription."
                            },
                            {
                                "example_id": "3306d818-88b7-4ace-929b-4910c797d285",
                                "sense_id": "625b652a-f3fa-35cd-8602-63c7f3e9428e",
                                "text": "After cremation the Khasi take the ashes of their dead to the clan cinerarium."
                            },
                            {
                                "example_id": "7e49c6e0-d494-4957-9e0e-4660e3179234",
                                "sense_id": "625b652a-f3fa-35cd-8602-63c7f3e9428e",
                                "text": "Relevant material is also covered on the containers for remains in those and in the entries on cineraria, columbaria, and urns."
                            }
                        ]
                    }
                ],
