    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9dd77cae-b58d-3f2e-88f1-006c84b0638a",
                    "sense_definition": "een klein, scherp en puntig uitsteeksel van een plant of een dier",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "scherpe_voorwerpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De roos heeft een scherpe <w>stekel</w> die pijn doet als je hem aanraakt.",
                            "target_lang_translations": {
                                "en": "The rose has a sharp <w>thorn</w> that hurts when you touch it."
                            }
                        },
                        {
                            "text": "Ik haalde mijn huid aan die <w>stekel</w> open toen ik in de tuin werkte.",
                            "target_lang_translations": {
                                "en": "I cut my skin open on that <w>prickle</w> while I was working in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorn",
                        "prikkel"
                    ],
                    "common_phrases": [
                        "scherpe stekel"
                    ],
                    "target_lang_definitions": {
                        "en": "a small, sharp and pointed protrusion of a plant or an animal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thorn",
                                "target_lang_sense_clarification": "on a plant"
                            },
                            {
                                "target_lang_word": "spine",
                                "target_lang_sense_clarification": "on a plant or animal"
                            },
                            {
                                "target_lang_word": "prickle",
                                "target_lang_sense_clarification": "small sharp point"
                            },
                            {
                                "target_lang_word": "sting",
                                "target_lang_sense_clarification": "sharp part of an insect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7997060f-6c5e-333c-b9a1-76fb2e6fc2d0",
                    "sense_definition": "een harde, naaldachtige structuur op de huid van bepaalde dieren zoals een egel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologische_structuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een egel gebruikt elke <w>stekel</w> op zijn rug om zich te verdedigen tegen vijanden.",
                            "target_lang_translations": {
                                "en": "A hedgehog uses every <w>spine</w> on its back to defend itself against enemies."
                            }
                        },
                        {
                            "text": "De lange <w>stekel</w> van het stekelvarken is erg indrukwekkend.",
                            "target_lang_translations": {
                                "en": "The long <w>quill</w> of the porcupine is very impressive."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stekels opzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "a hard, needle-like structure on the skin of certain animals such as a hedgehog"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quill",
                                "target_lang_sense_clarification": "of a porcupine or hedgehog"
                            },
                            {
                                "target_lang_word": "spine",
                                "target_lang_sense_clarification": "biological needle-like structure"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7bb733d3-6d2a-3581-8691-b712cc307dad",
                    "sense_definition": "besmet met hondsdolheid of zeer agressief gedrag vertonend",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medische_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond gedroeg zich plotseling erg <w>stekel</w> en agressief tegenover de voorbijgangers.",
                            "target_lang_translations": {
                                "en": "The dog suddenly acted very <w>rabid</w> and aggressive towards passersby."
                            }
                        },
                        {
                            "text": "In deze oude tekst wordt een <w>stekel</w> dier beschreven dat aan hondsdolheid lijdt.",
                            "target_lang_translations": {
                                "en": "In this old text, a <w>rabid</w> animal is described that suffers from rabies."
                            }
