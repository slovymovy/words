                        ]
                    }
                },
                {
                    "sense_id": "8d293e75-1343-3a23-91fb-2af0be3257c0",
                    "sense_definition": "Rearing on both hind legs with the forelegs extended.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The majestic stallion stood <w>rampant</w> in the field, startled by the sudden thunder.",
                            "target_lang_translations": {
                                "ru": "Величественный жеребец встал <w>на дыбы</w> в поле, испугавшись внезапного грома."
                            }
                        },
                        {
                            "text": "The statue depicts a horse <w>rampant</w>, capturing a sense of wild energy.",
                            "target_lang_translations": {
                                "ru": "Статуя изображает коня, вставшего <w>на дыбы</w>, передавая ощущение дикой энергии."
                            }
