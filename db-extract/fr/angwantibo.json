                "senses": [
                    {
                        "sense_id": "d8100dcd-8d33-326a-9372-57cbeb3f166c",
                        "entry_id": "95f5a674-b534-3665-a637-dbc0fc1f95ad",
                        "glosses": [
                            "Primate africain de la famille des lorisidés et du genre Arctocebus qui comprend deux espèces: l’angwantibo doré (Arctocebus aureus), également appelé arctocèbe doré ou encore potto doré, et l’angwantibo de Calabar (Arctocebus calabarensis), également appelé arctocèbe ou potto de Calabar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ccc259-5695-4dce-9e8f-bc8ae3376f61",
                                "sense_id": "d8100dcd-8d33-326a-9372-57cbeb3f166c",
                                "text": "L’angwantibo de Calabar est la seule espèce de primate à posséder une membrane nictitante (« troisième paupière » transparente ou translucide) en état de marche."
                            },
                            {
                                "example_id": "150b10ab-53db-4455-b32a-e0c1da77f459",
                                "sense_id": "d8100dcd-8d33-326a-9372-57cbeb3f166c",
                                "text": "L’angwantibo doré se distingue facilement de son cousin de Calabar: la fourrure du dos est rouge-dorée, plus rouge encore sur le ventre, et il n'a pas de membrane nictitante."
                            },
                            {
                                "example_id": "a169c18b-7c79-4d49-bf5e-7e8b8e31c64c",
                                "sense_id": "d8100dcd-8d33-326a-9372-57cbeb3f166c",
                                "text": "Il y avait un maki, un potto, un galago, un angwantibo..."
                            }
                        ]
                    }
                ],
