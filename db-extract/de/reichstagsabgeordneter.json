                "senses": [
                    {
                        "sense_id": "8a87721a-8275-3332-b960-15384f72c70d",
                        "entry_id": "7245a29b-78de-3604-93dc-b0f6dd3bcb75",
                        "glosses": [
                            "gewählter Vertreter im Reichstag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a2b330-b7f2-44c0-a5e4-051b448b1462",
                                "sense_id": "8a87721a-8275-3332-b960-15384f72c70d",
                                "text": "„Als erster sozialdemokratischer Reichstagsabgeordneter stimmte am 2. Dezember 1914 Karl Liebknecht gegen die Kriegskredite. Am 24. März 1916 lehnten weitere 18 Abgeordnete die Kriegskredite ab und wurden daraufhin aus der SPD ausgeschlossen.“"
                            },
                            {
                                "example_id": "1c5ffd8f-5f88-40fb-a4c2-029f6fe4ce3a",
                                "sense_id": "8a87721a-8275-3332-b960-15384f72c70d",
                                "text": "„Seit 1930 ist er direktgewählter Reichstagsabgeordneter der NSDAP für den Wahlkreis Hannover-Süd.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
