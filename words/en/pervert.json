{
    "word_family": [
        "perversion",
        "perversity",
        "perversive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e900be0a-3d98-307f-894c-39e7051d941c",
                    "sense_definition": "To corrupt or cause someone to adopt false or immoral beliefs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cult leader managed to <w>pervert</w> the minds of his young followers.",
                            "target_lang_translations": {
                                "zh": "邪教头目成功地<w>腐蚀</w>了他那些年轻追随者的思想。"
                            }
                        },
                        {
                            "text": "He was accused of attempting to <w>pervert</w> the course of justice by hiding evidence.",
                            "target_lang_translations": {
                                "zh": "他被指控试图通过隐匿证据来<w>歪曲</w>司法公正。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "lead astray"
                    ],
                    "common_phrases": [
                        "pervert the course of justice"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人堕落或使其接受错误、不道德的观念。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "腐蚀",
                                "target_lang_sense_clarification": "指在思想或道德上使人变坏。"
                            },
                            {
                                "target_lang_word": "歪曲",
                                "target_lang_sense_clarification": "指干扰或破坏公正的程序。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "979cb38d-fd7a-3384-8085-87a2bcb22b0e",
                    "sense_definition": "To misapply or use something for a wrong or harmful purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "misuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a shame to <w>pervert</w> such great talent for dishonest gain.",
                            "target_lang_translations": {
                                "zh": "为了不义之财而<w>滥用</w>如此卓越的才华，真是可惜。"
                            }
                        },
                        {
                            "text": "They <w>pervert</w> the original intent of the law to suit their own agenda.",
                            "target_lang_translations": {
                                "zh": "他们为了自己的目的而<w>曲解</w>了法律的初衷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misapply",
                        "misuse"
                    ],
                    "common_phrases": [
                        "pervert the intent"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物用于错误或有害的目的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滥用",
                                "target_lang_sense_clarification": "指不恰当地使用某物。"
                            },
                            {
                                "target_lang_word": "曲解",
                                "target_lang_sense_clarification": "指违背初衷地利用。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ab4d8e-6e05-3396-8806-9f8da634bc46",
                    "sense_definition": "To intentionally misinterpret or twist the meaning of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "misuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>pervert</w> my words to make it sound like I disagree with you.",
                            "target_lang_translations": {
                                "zh": "不要<w>歪曲</w>我的话，让我听起来好像在反对你一样。"
                            }
                        },
                        {
                            "text": "The critic tried to <w>pervert</w> the author's message in his review.",
                            "target_lang_translations": {
                                "zh": "评论家试图在他的评论中<w>曲解</w>作者想要表达的信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "twist"
                    ],
                    "common_phrases": [
                        "pervert words"
                    ],
                    "target_lang_definitions": {
                        "zh": "故意误解或扭曲某事的含义。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "歪曲",
                                "target_lang_sense_clarification": "指故意改变事实或原意。"
                            },
                            {
                                "target_lang_word": "曲解",
                                "target_lang_sense_clarification": "指对言论或文字进行错误的解释。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15f21ad2-9855-363e-861e-9b52c772678e",
                    "sense_definition": "To turn something away from its proper path or direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden storm served to <w>pervert</w> the ship from its intended course.",
                            "target_lang_translations": {
                                "zh": "突如其来的风暴使船只<w>偏离</w>了预定的航线。"
                            }
                        },
                        {
                            "text": "He tried to <w>pervert</w> the flow of the river with a makeshift dam.",
                            "target_lang_translations": {
                                "zh": "他试图用临时大坝<w>改变</w>河流的流向。"
                            }
                        }
                    ],
                    "synonyms": [
                        "divert",
                        "steer",
                        "veer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely dated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物偏离其正确的路径或方向。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使偏离",
                                "target_lang_sense_clarification": "指改变原有的行进方向。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebd52ecc-d2f4-38f1-b9ac-8f5c5042abdd",
                    "sense_definition": "To become morally corrupted or take a wrong course in life.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The society began to <w>pervert</w> as greed replaced all sense of community.",
                            "target_lang_translations": {
                                "zh": "当贪婪取代了所有的集体意识时，这个社会开始<w>堕落</w>了。"
                            }
                        },
                        {
                            "text": "He watched his once noble ideals <w>pervert</w> over many years of isolation.",
                            "target_lang_translations": {
                                "zh": "他看着自己曾经崇高的理想在多年的孤立中逐渐<w>扭曲</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "变得道德堕落或在生活中走上歧途。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "堕落",
                                "target_lang_sense_clarification": "指思想或行为变得腐化。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c78a4a51-84f5-3142-8b2f-d4ddefc23429",
                    "sense_definition": "A person whose sexual behavior is considered abnormal or offensive by society.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighborhood was terrified by the presence of a known <w>pervert</w>.",
                            "target_lang_translations": {
                                "zh": "社区里出现了一个众所周知的<w>变态者</w>，这让居民们感到恐惧。"
                            }
                        },
                        {
                            "text": "He was labeled a <w>pervert</w> for his inappropriate behavior in public.",
                            "target_lang_translations": {
                                "zh": "他因在公共场合的不当行为而被贴上了<w>变态者</w>的标签。"
                            }
                        }
                    ],
                    "synonyms": [
                        "perv"
                    ],
                    "antonyms": [
                        "normophile"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly offensive and derogatory term."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "性行为被社会视为异常或冒犯的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变态者",
                                "target_lang_sense_clarification": "指行为举止异常且令人反感的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ce0a0e-aeb1-32fb-b0d9-c6a826bd85fa",
                    "sense_definition": "A person who has turned away from accepted beliefs or morals to adopt twisted ones.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text described the religious <w>pervert</w> as someone who abandoned his faith.",
                            "target_lang_translations": {
                                "zh": "历史文献将那位宗教<w>背教者</w>描述为抛弃信仰的人。"
                            }
                        },
                        {
                            "text": "Many considered him a <w>pervert</w> of the truth for his radical new theories.",
                            "target_lang_translations": {
                                "zh": "由于他那些激进的新理论，许多人认为他是真理的<w>歪曲者</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in religious or historical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "背离公认信仰或道德而采取扭曲观念的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "背教者",
                                "target_lang_sense_clarification": "指背离原有信仰或真理的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}