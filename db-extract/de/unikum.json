                                ]
                            },
                            {
                                "target_word": "original",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3985f990-57a8-35f6-ba54-64a5a6950ff0",
                                        "entry_id": "42459c51-36d4-335f-a23f-3e3d7e7980a8",
                                        "glosses": [
                                            "An object or other creation (e.g. narrative work) from which all later copies and variations are derived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04e4b86-dd0d-4e3f-b2c4-4e132f8745da",
                                                "sense_id": "3985f990-57a8-35f6-ba54-64a5a6950ff0",
                                                "text": "This manuscript is the original."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb52bd5-6449-39c8-ab25-ae44adf67de0",
                                        "entry_id": "42459c51-36d4-335f-a23f-3e3d7e7980a8",
                                        "glosses": [
                                            "A person with a unique and interesting personality or creative talent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d30ef4f-c72c-4d22-8b8f-1ad6d1f76c94",
                                                "sense_id": "beb52bd5-6449-39c8-ab25-ae44adf67de0",
                                                "text": "I have a great mind to be in Print; but above all, I would fain be an Original, and that is a true Comical Thought: When all the Learned Men in the World are but Tranſlators, is it not a Pleaſant Jeſt, that you ſhould ſtrive to be an Original! You ſhould have obſerved your Time, and have come into the World with the Ancient Greeks for that purpoſe; for the Latines themſelves are but Copies."
                                            },
                                            {
                                                "example_id": "c10f30e8-6a66-4795-b2c3-0a02e3446102",
                                                "sense_id": "beb52bd5-6449-39c8-ab25-ae44adf67de0",
                                                "text": "Ahmad (1969) studied the personality differences among middle school girls identified as originals and unoriginals on the Minnesota's test of creative thinking."
                                            },
                                            {
                                                "example_id": "003c9ce3-6ac9-4b8e-b8e1-e61e781d6bf3",
                                                "sense_id": "beb52bd5-6449-39c8-ab25-ae44adf67de0",
                                                "text": "The originals or the creatives were more dominant than the unoriginals or the low creatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edced66-5432-3221-88f9-a609b40c30e1",
                                        "entry_id": "42459c51-36d4-335f-a23f-3e3d7e7980a8",
                                        "glosses": [
                                            "An eccentric person."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52bf8bf3-9f5c-4702-805f-89d4429899d3",
                                                "sense_id": "2edced66-5432-3221-88f9-a609b40c30e1",
                                                "text": "‘Are you an alienist?’ I interrupted. ‘Every doctor should be - a little,’ answered that original, imperturbably."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391cd88e-284d-3cd8-98bd-51e64c9f00d4",
                                        "entry_id": "42459c51-36d4-335f-a23f-3e3d7e7980a8",
                                        "glosses": [
                                            "A newly designed garment released by a fashion designer as part of a collection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e746d26e-eea5-4e59-93e4-78f29b025669",
                                                "sense_id": "391cd88e-284d-3cd8-98bd-51e64c9f00d4",
                                                "text": "Fashion Fair will give every section first hand knowledge of the latest originals and 1962-63's exciting trends."
                                            },
                                            {
                                                "example_id": "ec577dc2-5d4d-4a23-b1f2-4f8414ada001",
                                                "sense_id": "391cd88e-284d-3cd8-98bd-51e64c9f00d4",
                                                "text": "One such show was built around the Du Pont spring collection of Paris originals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5d9d983-5897-3e25-8914-9a8909f33e50",
                                        "entry_id": "42459c51-36d4-335f-a23f-3e3d7e7980a8",
                                        "glosses": [
                                            "A ridgeling."
                                        ],
                                        "tags": [],
