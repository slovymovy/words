                "senses": [
                    {
                        "sense_id": "7bf66cd1-ffed-31f1-a7ce-99876568a0b9",
                        "entry_id": "4bbea22f-4d1f-3c7f-95b1-787daa96143f",
                        "glosses": [
                            "прост. связанный, соотносящийся по значению с существительным курица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5548d250-03d7-46e6-af9f-5f1d67c88317",
                                "sense_id": "7bf66cd1-ffed-31f1-a7ce-99876568a0b9",
                                "text": "[Петрович (муж, мелкий стряпчий из мещан):] На баб-то дивиться нечего, на них курячья слепота бывает .."
                            },
                            {
                                "example_id": "ce731ca7-9a85-4ab4-9490-6c8961495ed8",
                                "sense_id": "7bf66cd1-ffed-31f1-a7ce-99876568a0b9",
                                "text": "На рассвете разбудил крик петуха: куры у Машки зимуют за стенкой в соседней комнате. Сквозь дрёму с лаской и улыбкой слушал петушиный крик, тихие, тоненько журчащие курячьи разговоры."
                            }
                        ]
                    }
