                ],
                "senses": [
                    {
                        "sense_id": "70b59cd8-f465-3fc0-b345-d848972a1f18",
                        "entry_id": "9b0f3c83-652f-3653-b2b8-8a6ae4dbe498",
                        "glosses": [
                            "Défaire de qui est entortillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be814b79-72b7-4e38-b2c2-e9f70753ce3c",
                                "sense_id": "70b59cd8-f465-3fc0-b345-d848972a1f18",
                                "text": "La vieille fille avait déjà ôté la coiffe de papier doré et commencé à détortillonner le bonnet de fer de la bouteille quand ses yeux revinrent au miroir, sérieux et grands ouverts."
                            },
                            {
                                "example_id": "490b5648-50df-412a-9fbe-1fb7d5e6698e",
                                "sense_id": "70b59cd8-f465-3fc0-b345-d848972a1f18",
                                "text": "Cette opération du tortillonnage existe donc toujours, et exige, après le bruissage, l’opération contraire de détortillonner, c’est-à-dire de déformer les tortillons, pour pouvoir les soumettre à de nouveaux passages aux défeutreurs simples et doubles, machines à réunir, puis enfin aux bobinoirs."
                            }
                        ]
                    }
                ],
