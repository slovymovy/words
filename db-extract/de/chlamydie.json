                                        "entry_id": "204a591b-78ee-3d70-a888-4b2bee103154",
                                        "glosses": [
                                            "Any of several common, often asymptomatic, sexually transmitted diseases caused by the microorganism Chlamydia trachomatis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd131a9b-e5b1-4d68-8ad0-28916b99622f",
                                                "sense_id": "417e8fe8-becd-3973-b572-f58a06901391",
                                                "text": "That makes sense, because we’re all looking for flowery language from our physicians. “Like the sunlight shines upon the hidden grassy meadow, so does chlamydia cast a warm glow upon your private parts.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72986af-1327-3a77-9ca8-cb1811333826",
                                        "entry_id": "204a591b-78ee-3d70-a888-4b2bee103154",
                                        "glosses": [
                                            "Any of various coccoid microorganisms of the genus Chlamydia that are pathogenic to humans and other animals."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
