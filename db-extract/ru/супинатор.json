                ],
                "senses": [
                    {
                        "sense_id": "da23f327-d8fe-369c-a6d5-1d65ac1094dc",
                        "entry_id": "6f1db7fd-56ee-34e3-97b0-0fdd848b51e8",
                        "glosses": [
                            "анат. мышца, осуществляющая супинацию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277c1bec-a054-4417-8c80-6db15f8db412",
                                "sense_id": "da23f327-d8fe-369c-a6d5-1d65ac1094dc",
                                "text": "Супинатор, m. supinator, располагается под поверхностными мышцами."
                            },
                            {
                                "example_id": "877e4d8a-219f-4f7e-904f-1841d069d240",
                                "sense_id": "da23f327-d8fe-369c-a6d5-1d65ac1094dc",
                                "text": "― Да, батенька, уж подлинно наделил вас господь, ― продолжал восторгаться доктор. ― Видите эти вот шары? Они у нас в анатомии называются бицепсами, то есть двухглавыми. А это ― так называемые супинаторы и пронаторы."
                            }
                        ]
                    },
                    {
                        "sense_id": "4853d666-383d-3468-adf6-e098b457a4ac",
                        "entry_id": "6f1db7fd-56ee-34e3-97b0-0fdd848b51e8",
                        "glosses": [
                            "специальная стелька, вкладываемая в обувь при плоскостопии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59ffcc0-a82d-426c-8601-4ac3ddb40e91",
                                "sense_id": "4853d666-383d-3468-adf6-e098b457a4ac",
                                "text": "На таких каблуках женщины, должно быть, выглядели беспомощно, поскольку обувная конструкция того времени не предусматривала супинаторов, а также жестких берцев, которые держали бы стопу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25e3e68c-0477-43e3-a52d-1124d3945d82",
                        "source_entry_id": "6f1db7fd-56ee-34e3-97b0-0fdd848b51e8",
                        "source_sense_description": "мышца",
                        "target_lang_word": "supinateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supinateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b3bb96-3b65-3050-8c38-2c7ea5066218",
                                        "entry_id": "22a814c3-8bf0-3ba2-849e-72c8abd953a7",
                                        "glosses": [
                                            "Qualifie les deux muscles de l’avant-bras qui servent au mouvement de supination."
                                        ],
                                        "tags": [
                                            "Muscles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53cccd59-f574-42a8-b075-6539ddfdcd9d",
                                                "sense_id": "d4b3bb96-3b65-3050-8c38-2c7ea5066218",
                                                "text": "En effet, les appuis sont différents si vous avez une foulée supinatrice, pronatrice ou universelle. Alors qu’une foulée supinatrice affiche une phase de propulsion sur la pointe extérieure du pied, une foulée universelle l’effectue sous les orteils."
                                            },
                                            {
                                                "example_id": "d5ad00ac-b4ba-4ac1-bb4d-2066a345c797",
                                                "sense_id": "d4b3bb96-3b65-3050-8c38-2c7ea5066218",
                                                "text": "Il existe trois types de foulées : la foulée universelle qui caractérise 50 % des coureurs, la foulée pronatrice qui représente 40 % des coureurs, et enfin la foulée supinatrice qui représente 10 % des coureurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supinateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cee748f-383d-3a17-9a63-0f5d0d9e3a61",
                                        "entry_id": "78f61370-d3bc-3f49-88b8-1f4c3a4cc13c",
                                        "glosses": [
                                            "Chacun des deux muscles qui font mouvoir l’avant-bras et la main de manière que, lorsqu’ils se contractent, la paume de la main se trouve en dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c1b655-1e37-44ca-988c-d5292ce1e9c1",
                                                "sense_id": "2cee748f-383d-3a17-9a63-0f5d0d9e3a61",
                                                "text": "Le long supinateur."
                                            },
                                            {
                                                "example_id": "ea63dfd7-c245-4b60-ba28-73f2808a2e89",
                                                "sense_id": "2cee748f-383d-3a17-9a63-0f5d0d9e3a61",
                                                "text": "Le court supinateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5608a0e1-5bf6-3e57-8f69-0c05d46255fc",
                                        "entry_id": "78f61370-d3bc-3f49-88b8-1f4c3a4cc13c",
                                        "glosses": [
                                            "Coureur qui s’appuie plus sur l’extérieur des pieds."
                                        ],
                                        "tags": [
                                            "Course à pied"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
