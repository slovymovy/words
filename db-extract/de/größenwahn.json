                "senses": [
                    {
                        "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                        "entry_id": "865b1482-d35a-30b8-92ff-301a62c110be",
                        "glosses": [
                            "schmeichelnde Fehleinschätzung der eigenen Möglichkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a243bb-8455-4783-b3db-963ee0007070",
                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                "text": "Größenwahn war und ist Merkmal der meisten Diktatoren."
                            },
                            {
                                "example_id": "af4d13df-1da3-400c-9b8c-32ec5f855d93",
                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                "text": "„Johann Eckert hatte schon immer unter Größenwahn gelitten.“"
                            },
                            {
                                "example_id": "b46b6316-ff7f-444e-b552-416ffc6c39f9",
                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                "text": "„Alle waren dem Größenwahn verfallen.“"
                            },
                            {
                                "example_id": "41b9c093-5f11-4c14-9af9-c138f5d1e7c5",
                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                "text": "„In seinem Größenwahn öffnete und schloss er die Mine der Hoffnung, wie es ihm passte, obwohl ganz Stadtland von besagter Mine lebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e62f20c-69ba-3f89-b4ce-57055150075a",
                        "entry_id": "865b1482-d35a-30b8-92ff-301a62c110be",
                        "glosses": [
                            "aus [1] sich ableitendes Bedürfnis nach Anerkennung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df071bb-f602-4da7-8867-dfa9a3c3aee5",
                                "sense_id": "0e62f20c-69ba-3f89-b4ce-57055150075a",
                                "text": "Größenwahn war und ist Merkmal der meisten Diktatoren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83a2aa0b-226b-4b2c-9baf-feb64b8ee016",
                        "source_entry_id": "865b1482-d35a-30b8-92ff-301a62c110be",
                        "source_sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                        "source_sense_description": "schmeichelnde Fehleinschätzung der eigenen Möglichkeiten",
                        "target_lang_word": "megalomania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megalomania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9581a431-2e22-34f3-bde3-ae57e10aecd8",
                                        "entry_id": "7236cdff-e4f2-3316-8427-b41cb8d0ecbd",
                                        "glosses": [
                                            "A psychopathological condition characterized by delusional fantasies of wealth, power, or omnipotence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a61c67-5412-455d-9fd8-f1c300e19d47",
                                                "sense_id": "9581a431-2e22-34f3-bde3-ae57e10aecd8",
                                                "text": "As to Ernest... He is quite as nervously broken down as I am but it manifests itself in different ways. His inclination is towards megalomania and mine towards melancholy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fca7fe0-8d0a-3947-b6e7-0ac152d5b201",
                                        "entry_id": "7236cdff-e4f2-3316-8427-b41cb8d0ecbd",
                                        "glosses": [
                                            "Narcissistic personality disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f8d0b1a-1697-3b5c-8359-34f9647cac2d",
                                        "entry_id": "7236cdff-e4f2-3316-8427-b41cb8d0ecbd",
                                        "glosses": [
                                            "An obsession with grandiose or extravagant things or actions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa77dd1-4ef3-4932-b627-4492a02f7ad0",
                        "source_entry_id": "865b1482-d35a-30b8-92ff-301a62c110be",
                        "source_sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                        "source_sense_description": "schmeichelnde Fehleinschätzung der eigenen Möglichkeiten",
                        "target_lang_word": "mégalomanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégalomanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                        "entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                                        "glosses": [
                                            "Manie qui consiste soit en un désir insatiable de gloire, de grandeur, soit dans l’illusion qu’on les possède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba6151b-fa7e-4bb2-8b95-3dbf2a83d524",
                                                "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                                "text": "Une faiblesse, cependant : son ambition démesurée, qui tourne à la mégalomanie. Il se rêve à la Chambre, au gouvernement."
                                            },
                                            {
                                                "example_id": "a0d463d1-8e99-4b66-a592-a33815831446",
                                                "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
