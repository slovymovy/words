    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aad2dfbe-393f-36b2-b684-f7740c9e02fb",
                "word": "ferocity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8e5b1816-193b-4286-ad87-6416f7a80edd",
                        "entry_id": "aad2dfbe-393f-36b2-b684-f7740c9e02fb",
