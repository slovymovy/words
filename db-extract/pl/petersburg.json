                        "entry_id": "fb8c575d-da0d-3598-8d5f-9c84c4fe4c7a",
                        "glosses": [
                            "miasto w Rosji, położone w delcie Newy nad Zatoką Fińską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6609876-eb65-480c-bd03-4f3feb44fb75",
                                "sense_id": "cd77215f-5e54-393d-9931-93c8fc16d622",
                                "text": "Nie wiadomo z daleka, kto nadchodzi z głębi literackich czeluści. Poeta z Petersburga? Prozaik z Wiednia? Scenarzysta z Birmy? Bajkopisarka z Seulu? Maleńki liryk z Japonii? Tym razem jest to dramaturg z Botswany. – ((…)) – mówi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
