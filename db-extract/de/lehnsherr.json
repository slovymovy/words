                        "sense_id": "8cfadaed-bd6f-3834-875e-6a18a1978d44",
                        "entry_id": "b7fe5bd8-8191-32ca-931f-1ae33599020e",
                        "glosses": [
                            "Eigentümer von Grundbesitz, das an einen Lehnsmann übertragen wird"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c25f4bce-c20e-4abd-8ce4-d9b6177ad4ff",
                                "sense_id": "8cfadaed-bd6f-3834-875e-6a18a1978d44",
                                "text": "„Oberster Lehnsherr war der jeweilige oberste Landesherr, König oder Herzog, der Lehen an seine Fürsten vergab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3a698d4-272e-42e0-a4ae-42c91ca5cd47",
                        "source_entry_id": "b7fe5bd8-8191-32ca-931f-1ae33599020e",
                        "source_sense_id": "8cfadaed-bd6f-3834-875e-6a18a1978d44",
                        "source_sense_description": "historisch: Eigentümer von Grundbesitz, das an einen Lehnsmann übertragen wird",
                        "target_lang_word": "liege",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb8d9fc-a10f-36d5-92af-2c62d759c102",
                                        "entry_id": "afa69073-fa7b-37b2-8bd5-ca96a40276b9",
                                        "glosses": [
                                            "A free and independent person; specifically, a lord paramount; a sovereign."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                                        "entry_id": "afa69073-fa7b-37b2-8bd5-ca96a40276b9",
                                        "glosses": [
                                            "A king or lord."
                                        ],
                                        "tags": [
                                            "in full liege lord"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca62e7f0-17ae-4eac-8a02-073ca4cd075c",
                                                "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                                                "text": "More health and happiness betide my liege / Than can my care-tuned tongue deliver him!"
                                            },
                                            {
                                                "example_id": "ff64b170-cfb4-4444-ae16-1c217e238a07",
                                                "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                                                "text": "Kings, my liege, may take a lesson from him"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee11a75-8e03-3b31-a7de-7449698f721c",
                                        "entry_id": "afa69073-fa7b-37b2-8bd5-ca96a40276b9",
                                        "glosses": [
                                            "The subject of a sovereign or lord; a liegeman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "liege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                                        "entry_id": "9305acbd-c12f-3fe0-b504-879a442e1388",
                                        "glosses": [
                                            "Sovereign; independent; having authority or right to allegiance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973ae7de-face-4cc6-8060-e294c5d7458c",
                                                "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                                                "text": "a liege lord"
                                            },
                                            {
                                                "example_id": "4b97541b-ff38-4dc3-82a5-3a0358d05cf5",
                                                "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                                                "text": "She look'd as grand as doomsday and as grave: / And he, he reverenced his liege lady there;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a00fb2f-fb5e-3b06-90bc-dc8fb2c69308",
                                        "entry_id": "9305acbd-c12f-3fe0-b504-879a442e1388",
                                        "glosses": [
                                            "Serving an independent sovereign or master; bound by a feudal tenure; obliged to be faithful and loyal to a superior, such as a vassal to his lord; faithful."
