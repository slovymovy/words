                        "cross_references": [
                            {
                                "target_word": "ephedra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d65ae571-a27c-3da7-8c89-2622feef4968",
                                        "entry_id": "b25c2abd-610b-333c-84f0-e347401fb160",
                                        "glosses": [
                                            "Any plant of the genus Ephedra of gymnosperm shrubs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00487747-d3ff-3b65-b8b2-0bed1a0320cb",
                                        "entry_id": "b25c2abd-610b-333c-84f0-e347401fb160",
                                        "glosses": [
                                            "A stimulant derived from the plant Ephedra sinica used in traditional Chinese herbal medicine and in over-the-counter weight-loss aids."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fee06d2-8819-43ff-a34e-4a9a235a6f62",
                                                "sense_id": "00487747-d3ff-3b65-b8b2-0bed1a0320cb",
                                                "text": "Consider ephedra, an herbal stimulant that gained popularity as a weight-loss supplement in the 1990s — until hundreds of people reported ephedra-related problems including heart attacks, seizures and even deaths."
                                            },
                                            {
                                                "example_id": "034e838b-3ab1-4583-9779-9aabd0094a6a",
                                                "sense_id": "00487747-d3ff-3b65-b8b2-0bed1a0320cb",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades. At the top of the list of popular herbs are echinacea and ginseng, whereas garlic, St. John's wort, soybean, ephedra and others are also surging in popularity or have been historically prevalent."
                                            }
                                        ]
                                    }
