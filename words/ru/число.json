                {
                    "sense_id": "e718280e-60e5-3881-b827-1cbf79bdaa19",
                    "sense_definition": "Математическая величина, при помощи которой производится счёт или измерение.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "math_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Запишите полученное <w>число</w> в свою тетрадь.",
                            "target_lang_translations": {
                                "en": "Write down the obtained <w>number</w> in your notebook.",
                                "zh": "把算出的<w>数</w>写在你的笔记本上。"
                            }
                        },
                        {
                            "text": "Семь — это нечётное <w>число</w>.",
                            "target_lang_translations": {
                                "en": "Seven is an odd <w>number</w>.",
                                "zh": "七是一个奇<w>数</w>。"
                            }
                        }
