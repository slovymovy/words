                "senses": [
                    {
                        "sense_id": "d4f07d3d-cc69-325d-9f21-16a0572949c0",
                        "entry_id": "cfe80cbb-e89a-3b01-958c-8d2037e2704e",
                        "glosses": [
                            "von Heisenberg formulierter Begriff für die Tatsache, dass es grundsätzlich unmöglich ist, gleichzeitig Ort und Impuls eines Teilchens (beispielsweise eines Elektrons) genau zu bestimmen"
                        ],
                        "tags": [
                            "Quantenphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "67133762-e463-4f81-b1a1-49bf976a718b",
                                "sense_id": "d4f07d3d-cc69-325d-9f21-16a0572949c0",
                                "text": "Die Heisenbergsche Unschärferelation leugnet nicht die Kausalität im subatomaren Bereich; sie behauptet lediglich die Unmöglichkeit genauer Messungen in diesem Bereich, da selbst die feinsten Messmittel wie beispielsweise das Licht unkontrollierbar durch ihre eigene Energie den Zustand des zu messenden Objektes verändern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
