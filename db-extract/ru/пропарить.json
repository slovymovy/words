                    {
                        "sense_id": "8840a000-0d49-38a4-ac46-ced475dc19c5",
                        "entry_id": "3c1ff009-753c-34c8-9545-20a89fb743ec",
                        "glosses": [
                            "разг. что-либо упустить, пропустить, не успеть"
                        ],
