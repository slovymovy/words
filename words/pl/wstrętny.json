{
    "word_family": [
        "wstręt",
        "wstrętnie",
        "wstrętność"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "215ca239-90cd-35f9-bf9f-06cf8fb23a69",
                    "sense_definition": "wywołujący silne uczucie obrzydzenia, odrazy lub niechęci swoim wyglądem, zapachem bądź smakiem",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_obrzydzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starej piwnicy unosił się <w>wstrętny</w> zapach stęchłego jedzenia.",
                            "target_lang_translations": {
                                "ru": "В старом подвале стоял <w>отвратительный</w> запах тухлой еды."
                            }
                        },
                        {
                            "text": "Musiałem natychmiast wyrzucić te zepsute owoce, bo miały <w>wstrętny</w> smak.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось немедленно выбросить эти испорченные фрукты, потому что у них был <w>противный</w> вкус."
                            }
                        }
                    ],
                    "synonyms": [
                        "obrzydliwy",
                        "ohydny",
                        "odrażający",
                        "paskudny",
                        "odpychający"
                    ],
                    "antonyms": [
                        "ładny",
                        "piękny",
                        "atrakcyjny",
                        "apetyczny",
                        "pociągający"
                    ],
                    "common_phrases": [
                        "wstrętny zapach",
                        "wstrętny smak",
                        "wstrętny widok"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий сильное чувство отвращения или неприязни своим видом, запахом или вкусом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий отвращение видом, вкусом или запахом"
                            },
                            {
                                "target_lang_word": "омерзительный",
                                "target_lang_sense_clarification": "крайне неприятный, вызывающий омерзение"
                            },
                            {
                                "target_lang_word": "противный",
                                "target_lang_sense_clarification": "неприятный для чувств восприятия"
                            },
                            {
                                "target_lang_word": "мерзкий",
                                "target_lang_sense_clarification": "вызывающий гадливость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23eeaac9-5f99-30f2-bf61-d5f010752c1c",
                    "sense_definition": "o człowieku lub jego zachowaniu: bardzo niemiły, złośliwy bądź sprawiający przykrość i rozczarowanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie_i_charakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To było naprawdę <w>wstrętne</w> zachowanie z twojej strony wobec młodszej siostry.",
                            "target_lang_translations": {
                                "ru": "Это было действительно <w>гадкое</w> поведение с твоей стороны по отношению к младшей сестре."
                            }
                        },
                        {
                            "text": "Jesteś po prostu <w>wstrętny</w>, że zapomniałeś o moich urodzinach i nawet nie zadzwoniłeś.",
                            "target_lang_translations": {
                                "ru": "Ты просто <w>невыносим</w>, раз забыл о моем дне рождения и даже не позвонил."
                            }
                        }
                    ],
                    "synonyms": [
                        "paskudny",
                        "przebrzydły",
                        "obmierzły"
                    ],
                    "antonyms": [
                        "miły",
                        "dobry"
                    ],
                    "common_phrases": [
                        "wstrętne zachowanie",
                        "wstrętny charakter"
                    ],
                    "target_lang_definitions": {
                        "ru": "о человеке или поведении: крайне неприятный, злобный, подлый или доставляющий огорчение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гадкий",
                                "target_lang_sense_clarification": "о человеке или подлом поступке"
                            },
                            {
                                "target_lang_word": "мерзкий",
                                "target_lang_sense_clarification": "низкий, крайне скверный по поведению"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "очень скверный, дурной по отношению к другим"
                            },
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "дурной, злой по характеру или поведению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}