                    },
                    {
                        "sense_id": "14060f26-37c4-3444-988f-d2dcd288c9cc",
                        "entry_id": "2eea2eab-64e4-360c-a859-ff606b8949c2",
                        "glosses": [
                            "Any of various other flatfishes of family Scophthalmidae that are found in marine or brackish waters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f32e608d-9ac2-4a23-821c-93aa6308a713",
                                "sense_id": "14060f26-37c4-3444-988f-d2dcd288c9cc",
                                "text": "Eldridge closed the despatch-case with a snap and, rising briskly, walked down the corridor to his solitary table in the dining-car. Mulligatawny soup, poached turbot, roast leg of lamb—the usual railway dinner."
                            }
                        ]
                    },
