                                "sense_id": "19f4de73-7512-38ff-a545-3026cf632f14",
                                "text": "Op een heldere winterdag gingen we schaatsen.",
                                "translation": "On a clear winter day, we went ice skating.",
                                "english": "On a clear winter day, we went ice skating."
                            },
                            {
                                "example_id": "40f49322-d909-4099-90ba-55140a65eea1",
                                "sense_id": "19f4de73-7512-38ff-a545-3026cf632f14",
                                "text": "Het was een koude winterdag met temperaturen onder het vriespunt.",
                                "translation": "It was a cold winter day with temperatures below freezing.",
                                "english": "It was a cold winter day with temperatures below freezing."
                            },
                            {
                                "example_id": "8e786e8e-f69f-4699-ba37-65f62bdf7d54",
                                "sense_id": "19f4de73-7512-38ff-a545-3026cf632f14",
                                "text": "Tijdens een winterdagje gingen we altijd naar opa en oma.",
                                "translation": "On a short winter day, we always went to grandma and grandpa's house.",
                                "english": "On a short winter day, we always went to grandma and grandpa's house."
                            }
                        ]
