                "senses": [
                    {
                        "sense_id": "b907320c-da22-34c5-89be-934434d2c44d",
                        "entry_id": "f63b4bfd-19e9-3110-811f-448cfbe624bc",
                        "glosses": [
                            "Chercheur en début de carrière préparant une thèse de doctorat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ede6edf-776c-4496-ad44-24d90c3d15bf",
                                "sense_id": "b907320c-da22-34c5-89be-934434d2c44d",
                                "text": "Une des pistes à suivre pour un doctorant à la recherche d’originalité est de rechercher ce type de bases inexploitées et de mobiliser sa force de persuasion (et son entourage) pour en obtenir l’accès."
                            },
                            {
                                "example_id": "743c45c0-85a7-42ca-b6cf-799d8df00d58",
                                "sense_id": "b907320c-da22-34c5-89be-934434d2c44d",
                                "text": "Le biochar est une sorte d’éponge, compare Cyril Girardin, doctorant en sciences du sol à l’Inrae."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fab2330-9e6f-4ba6-b22d-be392ce44f8b",
                        "source_entry_id": "f63b4bfd-19e9-3110-811f-448cfbe624bc",
                        "source_sense_id": "b907320c-da22-34c5-89be-934434d2c44d",
                        "target_lang_word": "Doktorand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktorand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                        "entry_id": "33797395-2a21-3685-aec6-7a7a051f0e31",
                                        "glosses": [
                                            "Student, der die Doktorwürde anstrebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30289bfe-20f3-4558-96d2-9c32977f0e9b",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "Der Doktorand steht kurz vor der Doktorprüfung."
                                            },
                                            {
                                                "example_id": "ce8cf4fe-61e8-478c-967d-d308544902e6",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "„Wie oft das geschah und wie viele Doktoranden und Doktorandinnen er zum Dr. begleitet hat, mag dahinstehen.“"
                                            },
                                            {
                                                "example_id": "98cfa191-f677-4c23-8a6a-71966f8b01d4",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "„Ein Schweizer Doktorand twittert kritisch über China. Danach will seine Professorin an der Universität St. Gallen nichts mehr mit ihm zu tun haben – sie fürchtet, kein Visum mehr zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e5982778-4973-4b64-a1ef-e791831f74b1",
                                                "sense_id": "cddec4f6-2347-33af-989b-0308f08a1d57",
                                                "text": "„Selbst die Doktoranden sahen unglaublich jung aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
