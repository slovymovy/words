{
    "word_family": [
        "serendipity",
        "serendipitously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31bfc6bc-4fe1-3949-8db7-fb1a2d83c7af",
                    "sense_definition": "Happening or found by chance in a happy or beneficial way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Finding my old diary in the attic was a purely <w>serendipitous</w> event. ",
                            "target_lang_translations": {
                                "de": "Mein altes Tagebuch auf dem Dachboden zu finden, war ein rein <w>glücklicher Zufall</w>."
                            }
                        },
                        {
                            "text": "They had a <w>serendipitous</w> encounter at the train station after years of not speaking.",
                            "target_lang_translations": {
                                "de": "Sie hatten nach Jahren ohne Kontakt eine <w>zufällige</w> Begegnung am Bahnhof."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortuitous",
                        "chanceable",
                        "accidental",
                        "unplanned"
                    ],
                    "common_phrases": [
                        "serendipitous discovery",
                        "serendipitous encounter",
                        "serendipitous finding"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch glücklichen Zufall geschehend oder gefunden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "glücklich",
                                "target_lang_sense_clarification": "durch positiven Zufall"
                            },
                            {
                                "target_lang_word": "zufällig",
                                "target_lang_sense_clarification": "unvorhergesehen und ohne Absicht"
                            },
                            {
                                "target_lang_word": "glückhaft",
                                "target_lang_sense_clarification": "von Glück begünstigt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f65fa97-707b-3a45-9597-753680a69615",
                    "sense_definition": "Favorable, fortunate, or beneficial.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The timing of the job offer was <w>serendipitous</w> for her career goals. ",
                            "target_lang_translations": {
                                "de": "Der Zeitpunkt des Stellenangebots war <w>äußerst günstig</w> für ihre karrierebezogenen Ziele."
                            }
                        },
                        {
                            "text": "The weather was <w>serendipitous</w> for our outdoor wedding.",
                            "target_lang_translations": {
                                "de": "Das Wetter war <w>sehr günstig</w> für unsere Hochzeit im Freien."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortunate",
                        "lucky",
                        "providential"
                    ],
                    "common_phrases": [
                        "serendipitous timing",
                        "serendipitous event"
                    ],
                    "target_lang_definitions": {
                        "de": "Günstig, vorteilhaft oder vom Glück begünstigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "günstig",
                                "target_lang_sense_clarification": "vorteilhaft für eine Situation"
                            },
                            {
                                "target_lang_word": "glücklich",
                                "target_lang_sense_clarification": "vorteilhaft oder erfreulich"
                            }
                        ]
                    }
