                "senses": [
                    {
                        "sense_id": "033797a8-fe47-39e1-9f1b-cd615c71bb90",
                        "entry_id": "44c0149a-b943-3753-9546-0afd31fca29a",
                        "glosses": [
                            "tang waarmee je spijkers kunt uittrekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5684da07-54a7-4b18-b5bc-bf61fb2979a9",
                                "sense_id": "033797a8-fe47-39e1-9f1b-cd615c71bb90",
                                "text": "De dief haalde uit een kist een gedeukte hoed, schildersgerief, een kiel, een knijptang, een paar versleten schoenen en een mandoline. Op de bodem van de kist lag een pak, in rode zijde gewikkeld: de Mona Lisa"
                            },
                            {
                                "example_id": "c5ca6d5b-b38f-4412-bf41-346d4dfe2710",
                                "sense_id": "033797a8-fe47-39e1-9f1b-cd615c71bb90",
                                "text": "In de wagen vonden de agenten onder meer zaklampen, knijptangen en werkhandschoenen. De vier twintigers en een dertiger konden geen plausibele uitleg geven over hun aanwezigheid op het bedrijventerrein in Genk. Het inbrekersmateriaal werd in beslag genomen."
                            }
                        ]
                    }
                ],
