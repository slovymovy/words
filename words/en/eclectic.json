{
    "word_family": [
        "eclecticism",
        "eclectically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                    "sense_definition": "Selecting the best elements from a variety of different sources, styles, or systems.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect is known for her <w>eclectic</w> style, blending modern glass with traditional stone."
                        },
                        {
                            "text": "He has an <w>eclectic</w> approach to cooking, combining techniques from many different cultures."
                        }
                    ],
                    "antonyms": [
                        "orthodox",
                        "standard"
                    ],
                    "common_phrases": [
                        "eclectic style",
                        "eclectic approach"
                    ]
                },
                {
                    "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                    "sense_definition": "Composed of diverse, unrelated, or unspecialized parts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "diversity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library contains an <w>eclectic</w> collection of books ranging from ancient history to modern science fiction."
                        },
                        {
                            "text": "They have an <w>eclectic</w> group of friends who come from very different backgrounds."
                        }
                    ],
                    "synonyms": [
                        "heterogeneous"
                    ],
                    "antonyms": [
                        "homogeneous",
                        "uniform",
                        "exclusive"
                    ],
                    "common_phrases": [
                        "eclectic collection",
                        "eclectic group"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "838209af-06a4-3a05-adeb-e8916e415654",
                    "sense_definition": "A person who chooses ideas or methods from various sources rather than following a single system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>eclectic</w>, she incorporates meditation, yoga, and prayer into her daily routine."
                        },
                        {
                            "text": "Many modern philosophers are <w>eclectics</w> who draw wisdom from both Eastern and Western traditions."
                        }
                    ]
                }
            ]
        }
    ]
