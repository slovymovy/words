                "translations": [
                    {
                        "translation_id": "7f622240-2a1c-4354-b5ed-29e10c06dfd3",
                        "source_entry_id": "6eef36cc-e8e8-3d16-a116-4ddd552b38eb",
                        "source_sense_id": "35f40a52-a9a5-3ab0-aa64-c6831296a23a",
                        "source_sense_description": "formalisieren, etwas formell bekräftigen",
                        "target_lang_word": "formalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "163a4894-9605-3428-8ead-846c0a9d535e",
                                        "entry_id": "f46dcd1f-ed75-3da6-a7de-7e5ebc204f7c",
                                        "glosses": [
                                            "einer gewissen (vereinfachenden) Form unterwerfen"
                                        ],
                                        "tags": [
                                            "häufig über Prozesse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25367d29-5734-404e-a161-219b94ff8858",
                                                "sense_id": "163a4894-9605-3428-8ead-846c0a9d535e",
                                                "text": "„Er formalisierte den Bildungsprozeß und pervertierte ihn damit. Kam es früher auf den Umfang und die Tiefe der Bildung an, so legen vor allem unsere Linken heute vorrangig auf die Äußerlichkeit der Bildungsdauer Wert.“"
                                            },
                                            {
                                                "example_id": "cd283f6e-6e58-4187-96e9-ce7211415216",
                                                "sense_id": "163a4894-9605-3428-8ead-846c0a9d535e",
                                                "text": "„Vielfach erfolgen gerade interne Projektanträge nicht formalisiert und ungefiltert, so dass eigentlich nicht von einem Antrag gesprochen werden kann.“"
                                            },
                                            {
                                                "example_id": "6e484bd3-dd81-4dc3-95b6-a3211002099f",
                                                "sense_id": "163a4894-9605-3428-8ead-846c0a9d535e",
                                                "text": "„Normalerweise ist das Formalisieren einer Theorie und das in dieser Tätigkeit zum Ausdruck kommende Streben nach einer möglichst präzisen Fassung der Theorie kein Selbstzweck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bea654c-23a6-35f1-86e5-326e1d6ef093",
                                        "entry_id": "f46dcd1f-ed75-3da6-a7de-7e5ebc204f7c",
                                        "glosses": [
                                            "eine gewisse Form der Darstellung, zum Beispiel auch ein inneliegendes Prinzip finden, damit etwas besser verstanden und vermittelt werden kann"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c16c30-a815-404a-aac9-7bd1e7fd59dd",
                                                "sense_id": "7bea654c-23a6-35f1-86e5-326e1d6ef093",
                                                "text": "„Die Genese dieser Explizitdefinition kann so verstanden werden: Man formalisiert die beiden ersten Axiome, d. h. man abstrahiert von ihrem Inhalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8976dd5-828c-4063-a896-d55f97b2a52b",
