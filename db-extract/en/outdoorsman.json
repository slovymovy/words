                        "glosses": [
                            "A man who spends time in outdoor pursuits or sports."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5402c7-5da4-4b99-96a0-8c037a8b7ba4",
                                "sense_id": "569fec4d-758c-3ed4-b7fe-74e7093f8879",
                                "text": "Whenever the kids ask my wife what to get Ol' Whosis for Christmas, she tells them, \"You know how he loves outdoor sports. Why don't you get him something outdoorsy?\" […] Let me state here that there should be a law prohibiting any person who uses the term \"outdoorsy\" from dispensing advice about what kinds of presents to buy an outdoorsman."
                            },
                            {
