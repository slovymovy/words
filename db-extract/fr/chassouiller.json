                "senses": [
                    {
                        "sense_id": "905a7233-c161-39c1-8cd1-8ac594eccc7a",
                        "entry_id": "f2ce8bbe-48cd-32c5-b810-91bdcee636d4",
                        "glosses": [
                            "Chasser sans véritable conviction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d811d1c-4568-4198-97b9-3236f1b35c7d",
                                "sense_id": "905a7233-c161-39c1-8cd1-8ac594eccc7a",
                                "text": "Je connais pas du tout le 06, pouvez vous m'indiquer un coin sympa pour chassouiller sachant que je reviens sur Marseille par la suite."
                            },
                            {
                                "example_id": "6f1bfb5f-00a6-453a-8fde-cb3a29931023",
                                "sense_id": "905a7233-c161-39c1-8cd1-8ac594eccc7a",
                                "text": "Nous partions donc, côte à côte, sans jamais nous chamailler à ce propos, chassouiller chacun son tour à l'entour des rochers aussi plats qu'accueillants qui habitaient le lieu dit, plage de l'Indépendance, du Plateau, à un kilomètre pile en amont des Deux-Moulins."
                            },
                            {
                                "example_id": "0ee47758-0d81-458c-a711-e1d15de75cfc",
                                "sense_id": "905a7233-c161-39c1-8cd1-8ac594eccc7a",
                                "text": "C'est un séjour \"visite\", mais si je pouvais chassouiller un petit peu en même temps...."
                            },
                            {
                                "example_id": "ef1a2c42-af97-4432-8eb1-d711a306b221",
                                "sense_id": "905a7233-c161-39c1-8cd1-8ac594eccc7a",
                                "text": "Le Maitre commence à chassouiller au bord, il y a déjà fait quelques rencontres sympathoches..."
                            }
                        ]
                    }
                ],
