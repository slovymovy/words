                                        "sense_id": "cb16c3d5-3c71-3006-9007-606b633797c7",
                                        "entry_id": "95208ed7-3a92-3233-9d66-79d69dd0e702",
                                        "glosses": [
                                            "Un des deux recueils de la mythologie des peuples germaniques du Nord, dont chaque chapitre est un petit poème qui roule sur les prédictions, la magie et les géants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "091ce844-ba51-4219-899d-2c4720f39bb8",
                                                "sense_id": "cb16c3d5-3c71-3006-9007-606b633797c7",
                                                "text": "Balder, de son nom nordique, et Kad-Balder ou Kal-Balladoer, pour les traditions celtiques, était fils du grand dieu Odin, nous disent les Eddas scandinaves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00e8727a-d78a-49e6-b262-12202a870903",
                        "source_entry_id": "bfe5fd1d-ac22-3dc3-aacb-f876b526d177",
                        "source_sense_id": "c9b40b55-c3c8-315d-b2f3-57a7bc7cec9a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Edda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "293a17a9-e73e-3ac8-bea9-1ea0ffce3733",
                                        "entry_id": "44b312ae-1696-3b6d-8e69-7424d1366034",
                                        "glosses": [
                                            "ältere Edda: altisländische Sammlung von Götter- und Heldensagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0101b0a1-b8da-4494-b14b-8087e1935e22",
                                                "sense_id": "293a17a9-e73e-3ac8-bea9-1ea0ffce3733",
                                                "text": "„Die Sprache der Edda ist die des alten Island und Norwegen…“"
                                            },
                                            {
                                                "example_id": "89d38fb4-b7d8-4dc2-a96f-258031d5e6ab",
                                                "sense_id": "293a17a9-e73e-3ac8-bea9-1ea0ffce3733",
                                                "text": "„Auch in der Edda, der Sammlung altnordischer Dichtung, sind Zaubersprüche überliefert.“"
                                            },
                                            {
                                                "example_id": "386ecb2c-3ac9-4601-9daa-96b9ffcbc4d7",
                                                "sense_id": "293a17a9-e73e-3ac8-bea9-1ea0ffce3733",
                                                "text": "„Der Schmied Arnhjún trat vor und rezitierte einige Strophen des Hávamál aus der Edda.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a01f75f-8267-33b5-ae43-29d2ec18caa2",
                                        "entry_id": "44b312ae-1696-3b6d-8e69-7424d1366034",
                                        "glosses": [
                                            "jüngere Edda: altisländisches Lehrbuch für Dichtkunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f2e3d6-823f-4c07-9bbc-2bbe14a1fdbd",
                                                "sense_id": "6a01f75f-8267-33b5-ae43-29d2ec18caa2",
                                                "text": "Aus der Edda von Snorri Sturluson sollten die Skalden, die jungen altnordischen Dichter, die Dichtkunst kennen lernen."
                                            },
                                            {
                                                "example_id": "b09d0e46-09fb-4b2a-8f57-329cd821a52d",
                                                "sense_id": "6a01f75f-8267-33b5-ae43-29d2ec18caa2",
                                                "text": "„Die Edda des Snorri Sturluson ist eines der merkwürdigsten Bücher der Weltliteratur.“"
                                            },
                                            {
                                                "example_id": "acd52c6a-98ce-42c6-b285-8a6096919e96",
                                                "sense_id": "6a01f75f-8267-33b5-ae43-29d2ec18caa2",
                                                "text": "„So eindeutig die Erwähnung Snorris als Verfasser der ›Edda‹ in der Handschrift U auch scheinen mag, so umstritten ist doch - vor allem in der älteren Literatur - die Autorenschaft des Snorri Sturluson.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
