                "senses": [
                    {
                        "sense_id": "9d80db2d-be1a-30a9-a0b7-ead75ccf21b8",
                        "entry_id": "26eb7652-035c-3e51-a9cc-03b9d6a35ac7",
                        "glosses": [
                            "Zusammenkunft/Sitzung einer Loge, zum Beispiel einer Freimaurerloge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991d0726-8e8f-45ab-a32d-770f61c35011",
                                "sense_id": "9d80db2d-be1a-30a9-a0b7-ead75ccf21b8",
                                "text": "„Die nächsten drei Tage nach der Logensitzung, in der er seine Rede gehalten hatte, lag er zu Hause auf dem Diwan, nahm keine Besuche an und fuhr auch selbst zu niemand.“"
                            },
                            {
                                "example_id": "8bee290f-c8f1-48a2-959c-606f535551f3",
                                "sense_id": "9d80db2d-be1a-30a9-a0b7-ead75ccf21b8",
                                "text": "„Eines steht auf jeden Fall fest, eine Logensitzung findet nach festen Regeln statt.“"
                            },
                            {
                                "example_id": "cfdce3a9-818f-4bf8-a573-19fce0385283",
                                "sense_id": "9d80db2d-be1a-30a9-a0b7-ead75ccf21b8",
                                "text": "„Peter Remark besuchte jedenfalls äußerst regelmäßig die Logensitzungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
