                                    {
                                        "sense_id": "80654edf-d8ba-3eb0-a845-041cb73d1cc4",
                                        "entry_id": "3ed34d02-abf5-3d65-8e4f-975248b5d4e6",
                                        "glosses": [
                                            "de maniakale speculatie met tulpenbollen zoals die plaatsvond van 1634 tot 1637 in Nederland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a57464e-e7b3-48f4-a52a-4a1a3ce759f9",
                                                "sense_id": "80654edf-d8ba-3eb0-a845-041cb73d1cc4",
                                                "text": "Financieel analisten vergelijken de bitcoin niet zelden met een zeepbel of de Nederlandse tulpenmanie in de zeventiende eeuw, toen vraag en aanbod en speculatie de tulpenprijs vanaf 1634 opdreven tot duizenden guldens per bol. Vervolgens stortte de prijs in 1637 compleet in."
                                            },
                                            {
                                                "example_id": "83f0d2e5-7639-48fd-a7c0-eeffedc3e1e1",
                                                "sense_id": "80654edf-d8ba-3eb0-a845-041cb73d1cc4",
                                                "text": "De tulpenmanie in de zeventiende eeuw behoefde geen internet. Uit angst de boot te missen hechtten Hollandse kooplieden massaal geloof aan het onzinverhaal dat ze hun kapitaal in tulpenbollen moesten steken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd6916b1-951b-4c5f-a538-c469617780b8",
                        "source_entry_id": "4ea8d68f-b7a2-3b97-a40f-e8d6e2a13973",
