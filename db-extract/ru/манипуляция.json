                "senses": [
                    {
                        "sense_id": "244cf8c7-aa5d-374e-832c-e66d5c315d5b",
                        "entry_id": "7d41584c-087a-3dab-b247-b50df4aead43",
                        "glosses": [
                            "действие по значению гл. манипулировать; сложный приём, сложное действие над чем-либо при работе руками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "525835ee-0172-4d7f-aa9d-067e20257a50",
                                "sense_id": "244cf8c7-aa5d-374e-832c-e66d5c315d5b",
                                "text": "Хирургическая манипуляция (перевязка)."
                            },
                            {
                                "example_id": "2220fd22-a43e-4e6d-85ff-262f8999e637",
                                "sense_id": "244cf8c7-aa5d-374e-832c-e66d5c315d5b",
                                "text": "Медицинская манипуляция (наложение гипсовой лонгеты, вправление вывиха)."
                            }
                        ]
                    },
                    {
                        "sense_id": "51a842f2-121a-3b96-bb40-342f875a04a1",
                        "entry_id": "7d41584c-087a-3dab-b247-b50df4aead43",
                        "glosses": [
                            "цирк. показ фокусов, основанных на ловкости рук, на быстроте и точности движений кистей и пальцев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e039a4-0a8a-4999-9e58-ec6cc3d18bb2",
                                "sense_id": "51a842f2-121a-3b96-bb40-342f875a04a1",
                                "text": "Ловкая манипуляция колодой карт."
                            }
                        ]
                    },
                    {
                        "sense_id": "6451adbf-ed5c-3315-a63b-4f52062eaa5f",
                        "entry_id": "7d41584c-087a-3dab-b247-b50df4aead43",
                        "glosses": [
                            "перен. ловкая проделка, махинация"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4e8ad8b7-e19e-3524-8ae8-20280dd84a9d",
                        "entry_id": "7d41584c-087a-3dab-b247-b50df4aead43",
                        "glosses": [
                            "техн. действие манипулятора"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8ab98752-4d06-3eab-96ea-8ffba9ed2ebe",
                        "entry_id": "7d41584c-087a-3dab-b247-b50df4aead43",
                        "glosses": [
                            "перен., неодобр. действие, имеющее цель заставить кого-либо сделать что-либо (обычно — противоречащее его желанию, интересам и т. п.) и использующее для этого представление чего-либо в искажённом виде"
                        ],
                        "tags": [],
                        "examples": []
                    }
