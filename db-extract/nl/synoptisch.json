                "senses": [
                    {
                        "sense_id": "3e2373f3-c8e9-33c6-816e-141ddab5d865",
                        "entry_id": "e62e134b-a67f-38d4-b7b5-90aa8a1cb6da",
                        "glosses": [
                            "betreffende de weersituatie over een groot gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbdd591c-4c1e-4fde-81ee-9d5fbd9a47cb",
                                "sense_id": "3e2373f3-c8e9-33c6-816e-141ddab5d865",
                                "text": "Verderop staat de echte weerinfo: de Synoptische analyse en termijnberoordelingen van de KNMI-meteorologen (de tekstjes). En de daarbij horende beroemde Bracknell-Faxkaarten, de KNMI-Hirlam-. Deutscher Wetterdienst (GME)- en ECMWF-kaarten."
                            },
                            {
                                "example_id": "2c157376-3cd4-4938-af4b-69c71e53142f",
                                "sense_id": "3e2373f3-c8e9-33c6-816e-141ddab5d865",
                                "text": "Iedere dag komt er via een satellietverbinding een foto vanuit de ruimte van het gebied waar het schip zich bevindt. Daarnaast ontvangt de boot per satelliet de bekende 'gribfiles', voorspellingen voor het weer op een bepaald deel van de oceaan. Er zijn de synoptische meteokaarten, die de luchtdruk weergeven en infrarood beelden met informatie over neerslag."
                            }
                        ]
                    },
                    {
                        "sense_id": "629670e4-4ed6-30b6-a9ab-c83898d1f1d6",
                        "entry_id": "e62e134b-a67f-38d4-b7b5-90aa8a1cb6da",
                        "glosses": [
                            "de drie evangelies die een grote overeenkomst met elkaar hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1473cbe-4682-47fc-af02-1201a96892da",
                                "sense_id": "629670e4-4ed6-30b6-a9ab-c83898d1f1d6",
                                "text": "Bird gaat ook uitgebreid in op wat bekend staat als het ”synoptisch probleem”. Mattheüs, Markus en Lukas (de synoptische evangeliën) vertonen veel overeenkomsten. Maar hoe is hun onderlinge relatie precies en hoe zijn deze evangeliën ontstaan?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a37855ee-2528-3193-8457-0e18c72ba6da",
                        "entry_id": "e62e134b-a67f-38d4-b7b5-90aa8a1cb6da",
                        "glosses": [
                            "overzicht gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5d23e6-cae6-4bf7-9e3e-75e75d2cfa13",
                                "sense_id": "a37855ee-2528-3193-8457-0e18c72ba6da",
                                "text": "Het verslag van de gemengde parlementaire commissie Fiscale hervorming heeft donderdag voor wrijvingen gezorgd binnen de meerderheid. De liberalen en Etienne Schouppe (CD&V) onthielden zich samen met Vlaams Belang, terwijl N-VA als enige tegenstemde. Rik Daems (Open VLD) kondigde aan dat hij de synoptische tabel van de hoorzittingen tijdens het plenaire debat in de Senaat zou indienen. De commissie weigerde donderdag om die tabel te integreren in het verslag."
                            }
                        ]
                    }
