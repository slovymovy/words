                                "target_senses": [
                                    {
                                        "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                        "entry_id": "94b7b21e-7e99-35a3-b3ce-f66a8a586a81",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname, in Deutschland dritthäufigster Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6644dd31-c053-4a44-b8e4-633c157951b2",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Herr Schneider ist ein sehr erfolgreicher Vertriebler."
                                            },
                                            {
                                                "example_id": "934d36c3-71b5-4be5-8b05-5bf45d2471b1",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Schneiders Wohnung ist immer blitzblank."
                                            },
                                            {
                                                "example_id": "1e7b7b7b-249a-4df0-a9a3-f7a631176156",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Der Schneider wollte zum Hochzeitstag nach Las Vegas, die Schneider zog Haselünne vor."
                                            },
                                            {
                                                "example_id": "af7350b3-2c9f-4b0d-8e77-9980b827392d",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Frau Schneider ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "83ec58ca-5744-4fc2-bf5c-af4ce2ee1316",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Herr Schneider wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "0b6f3420-a7ad-4647-8d5e-6d363ddd8086",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Die Schneiders fliegen heute nach Sri Lanka."
                                            },
                                            {
                                                "example_id": "8cc5262e-b81d-43d7-8241-013c3febae91",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Der Schneider trägt nie die Pullover, die die Schneider ihm strickt."
                                            },
                                            {
                                                "example_id": "fe50e8e9-6af6-43e7-97fc-2529ccc0a8e1",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schneider kommt, geht der Herr Schneider.“"
                                            },
                                            {
                                                "example_id": "81b8a3bf-dfe6-4792-937b-4f6bfb8226bd",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Schneider kommt und geht."
                                            },
                                            {
                                                "example_id": "cc906317-c108-4b58-9ada-1225fe17e9d6",
                                                "sense_id": "26cf5d1a-9884-39b2-9903-a457165d1d17",
                                                "text": "Schneiders kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
