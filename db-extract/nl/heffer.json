                    {
                        "sense_id": "b93c4e8a-0a3c-3a81-a42e-f5bd5b6b6d73",
                        "entry_id": "cde0e49a-e9b6-3824-9b73-5c0b7872f4cc",
                        "glosses": [
                            "apparaat waarmee je iets omhoog kunt brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f5a540-fd92-48cd-88cc-1d742400e1c4",
                                "sense_id": "b93c4e8a-0a3c-3a81-a42e-f5bd5b6b6d73",
                                "text": "Hij ontwierp een transparante duikershelm om onder water onbelemmerd om je heen te kunnen kijken, wilde tegen muren lopen met magnetische schoenen en met zijn ‘Heffer’ op een schijf boven een tafel zweven."
                            }
                        ]
                    },
                    {
                        "sense_id": "d20e602c-cee7-3883-8661-7e0ae8d972e3",
                        "entry_id": "cde0e49a-e9b6-3824-9b73-5c0b7872f4cc",
                        "glosses": [
                            "lift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ed42ef9-f14a-4799-bfa0-8b0fbf8b9e92",
                                "sense_id": "d20e602c-cee7-3883-8661-7e0ae8d972e3",
                                "text": "Dat leidt er toe dat af en toe op verschillende niveaus mensen de lift uit moeten én er snel weer in voordat de deur zich automatisch sluit en het vooraf ingetoetste hoog-laag parcours vervolgt. Vooral tijdens de spits, de lunch, kan het druk zijn in de electronisch aangestuurde heffer. Een stief kwartiertje ben je zo onderweg.Brandalarm"
                            }
                        ]
                    },
                    {
                        "sense_id": "f7b28e67-192c-33ad-9d5e-1c70e3b86d5a",
                        "entry_id": "cde0e49a-e9b6-3824-9b73-5c0b7872f4cc",
                        "glosses": [
                            "iemand die te vaak het glas heft"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
