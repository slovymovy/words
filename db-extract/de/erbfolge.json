                    {
                        "translation_id": "482c2739-84b2-4a86-8c8d-1fd30f172b3c",
                        "source_entry_id": "79ed7050-6a60-3f4a-8858-4b787d3dd7ed",
                        "source_sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                        "source_sense_description": "sich durch Abstammung oder auch Testament ergebende Abfolge unter den Erben eines Nachlasses",
                        "target_lang_word": "succession",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succession",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72e99abc-5d06-3d27-af36-fd690fb9e777",
                                        "entry_id": "a7fb9dd1-59c7-3121-b524-a44b10cf5922",
                                        "glosses": [
                                            "Suite ou série de personnes ou de choses qui se succèdent les unes aux autres sans interruption, ou à peu d’intervalle l’une de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "030a3749-52c6-4cdd-8ee9-a0f4da0b7b2f",
                                                "sense_id": "72e99abc-5d06-3d27-af36-fd690fb9e777",
                                                "text": "Le terrain ardoisier montre une succession de schistes et de quartzites des nuances les plus diverses, dont l’inclinaison générale est vers le sud de la boussole."
                                            },
                                            {
                                                "example_id": "23ae89fb-c0dc-4eab-95c6-09ad95f731bc",
                                                "sense_id": "72e99abc-5d06-3d27-af36-fd690fb9e777",
                                                "text": "Le sorgho, planté en succession de la culture commerciale, est desséché sur pied 8 à 10 jours avant de semer le cotonnier (…), afin d'obtenir une couverture morte dans laquelle est effectué le semis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdebd465-f3d8-36c6-b664-17f33d03c65e",
                                        "entry_id": "a7fb9dd1-59c7-3121-b524-a44b10cf5922",
                                        "glosses": [
                                            "Héritage, transmission de biens à la mort d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac543ab2-8e59-45e2-929b-93c38f7d2674",
                                                "sense_id": "bdebd465-f3d8-36c6-b664-17f33d03c65e",
                                                "text": "[…] un de nos camarades du Ministère nous avait raconté qu’il avait touché, le matin même, trente mille francs de la succession d’une tante."
                                            },
                                            {
                                                "example_id": "dc0ae43b-8b03-4fa3-b71a-678357eb0066",
                                                "sense_id": "bdebd465-f3d8-36c6-b664-17f33d03c65e",
                                                "text": "Marx comparait le changement d’ère historique à une succession civile ; les temps nouveaux héritent des acquisitions antérieures."
                                            },
                                            {
                                                "example_id": "a0fa5f7a-59fc-4315-9ed7-b811f7b706ab",
                                                "sense_id": "bdebd465-f3d8-36c6-b664-17f33d03c65e",
                                                "text": "Grégoire de Tours nous montre dans ses récits que les enfants naturels du Roi ont le même droit que les enfants légitimes ; la succession de ces souverains se partage entre eux sans tenir compte spécialement de la légitimité de la naissance."
                                            },
                                            {
                                                "example_id": "20c50af3-6cca-43b0-9258-aa91728924ed",
                                                "sense_id": "bdebd465-f3d8-36c6-b664-17f33d03c65e",
                                                "text": "Pierre Savary avait au surplus l’administration des fiefs de Boutervilliers et de la Grimbardière, dévolus à ses enfants sur la succession de sa femme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfdecb78-13d3-3f96-be21-0afe3abe5451",
                                        "entry_id": "a7fb9dd1-59c7-3121-b524-a44b10cf5922",
                                        "glosses": [
                                            "Manière dont se fait la transmission des héritages."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97700ae-4c57-4cd5-ae8e-8a6b09326103",
                                                "sense_id": "cfdecb78-13d3-3f96-be21-0afe3abe5451",
                                                "text": "On dit encore que, profondément atteint, sous la rongeure d’un mal qui ne pardonne pas, Abd-ul-Hamid est préoccupé de sa succession."
                                            },
                                            {
                                                "example_id": "7274ebfb-47ef-4e2d-bcaa-aaa3cba6f714",
                                                "sense_id": "cfdecb78-13d3-3f96-be21-0afe3abe5451",
                                                "text": "En Allemagne des difficultés, se sont présentées au sujet de l'application du décret bolchéviste du 27 avril 1918 par lequel le droit de succession est abrogé dans toute son étendue et toute la masse successorale devient la propriété de la république soviétique après le décès du de cujus."
                                            },
                                            {
                                                "example_id": "6b8dbd89-bbe6-40dc-826f-ce96022e364f",
                                                "sense_id": "cfdecb78-13d3-3f96-be21-0afe3abe5451",
                                                "text": "— Ce serait tout de même raide d’avoir un jour à payer des droits de succession sur la Tolose qui en fait m’appartient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945a6f05-47a7-37d9-91e4-b908c56dad5c",
                                        "entry_id": "a7fb9dd1-59c7-3121-b524-a44b10cf5922",
                                        "glosses": [
                                            "Mention apposée sur une œuvre pour indiquer qu’elle provient d’un legs, d’une donation ou d’une dation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
