                        "examples": [
                            {
                                "example_id": "48e5da02-1dbd-4ff5-8906-fddd055c5ea1",
                                "sense_id": "6d40291a-e135-398a-89fa-2d93d95deb5f",
                                "text": "Че́рез полчаса́ в за́ле ме́жду други́ми ря́жеными появи́лась ещё ста́рая ба́рыня в фи́жмах — э́то был Никола́й.",
                                "translation": "Half an hour later there appeared among the other mummers in the ballroom an old lady in a hooped skirt—this was Nicholas.",
                                "english": "Half an hour later there appeared among the other mummers in the ballroom an old lady in a hooped skirt—this was Nicholas."
                            }
                        ]
