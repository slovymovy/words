                ],
                "senses": [
                    {
                        "sense_id": "ff41f1eb-33c8-3036-9956-374dd3f5c0a4",
                        "entry_id": "4f49e664-19c1-3146-b9b8-a0124110e7b8",
                        "glosses": [
                            "Fixer au sol avec des sardines (piquets)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eab9fe2-5a79-4834-9e0e-94f8e3d29e18",
                                "sense_id": "ff41f1eb-33c8-3036-9956-374dd3f5c0a4",
                                "text": "Sinon faut pas oublier que t'as toujours le choix de la sardiner au sol et de la sangler en plus si besoin"
                            },
                            {
                                "example_id": "1b557436-5832-4285-a923-8b2c299d39b4",
                                "sense_id": "ff41f1eb-33c8-3036-9956-374dd3f5c0a4",
                                "text": "La toile n'est pas tendue, compte tenu de la difficulté de sardiner dans la dalle en béton"
                            }
                        ]
                    },
                    {
                        "sense_id": "5cd6a319-80d2-3414-a93e-cc688c4e4b7b",
                        "entry_id": "4f49e664-19c1-3146-b9b8-a0124110e7b8",
                        "glosses": [
                            "S’entasser comme des sardines dans une boîte de conserve."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "adb8eb3a-7e92-41ed-8ae7-feac6ba28d8e",
                                "sense_id": "5cd6a319-80d2-3414-a93e-cc688c4e4b7b",
                                "text": "Il jouissait du spectacle auquel, pour une fois, il ne participait pas. Les grappes humaines de pousser, de se contorsionner, d’ahaner ; femmes, hommes, vieux, jeunes, raisins verts ou mûrs, de s’entasser, de se sardiner, de se pilonner, de se comprimer, sans doute pressés d’en finir avec la vie, d’offrir à la ratp reconnaissante les ultimes gouttes de leur jus aigre ou sûr."
                            },
                            {
                                "example_id": "4bc1d185-02df-4dbe-8694-b9d693ee0914",
                                "sense_id": "5cd6a319-80d2-3414-a93e-cc688c4e4b7b",
                                "text": "Mais bon, ceci est un vaste débat, mais ce qui est sûr, la capacité du parc n'étant pas prête d'augmenter, il va falloir continuer a se sardiner !"
                            }
                        ]
                    }
                ],
