                                "target_senses": [
                                    {
                                        "sense_id": "95b3533c-ad66-39d1-bd3d-46dac53aed91",
                                        "entry_id": "2aeaba36-fe7b-3a1c-b613-3667b5c11127",
                                        "glosses": [
                                            "To make ugly (sometimes with up)."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68d614d1-bb2c-49c6-898d-9539049ed881",
                                                "sense_id": "95b3533c-ad66-39d1-bd3d-46dac53aed91",
                                                "text": "I move noiselessly, eat my food carefully without uglying the dining table with its remnants, fold my bedsheets in neat rectangles and place them on the bed in perfect symmetry."
                                            },
                                            {
                                                "example_id": "28b95d4e-9fb5-4e87-8e68-7d3e17188908",
                                                "sense_id": "95b3533c-ad66-39d1-bd3d-46dac53aed91",
                                                "text": "There is time when the absence of either integrity or humility has uglied the face of the church before the world and turned Christianity into just another cocoon of condemnation and hypocrisy."
                                            },
                                            {
                                                "example_id": "d216e127-a91a-4e73-862b-aa746caa090c",
                                                "sense_id": "95b3533c-ad66-39d1-bd3d-46dac53aed91",
                                                "text": "He had spent half of his journey mulling over how he would savour his revenge. He could already envision her pretty little form lying prone at his feet. He would take great pleasure in uglying her up a little before killing her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc542bc8-260c-4e47-9b44-19aab4c549ab",
                        "source_entry_id": "96102039-6d15-3f0d-a00a-c115da2ad33e",
                        "source_sense_id": "ff8608c5-77d5-3759-a09f-483279fbe6e5",
                        "target_lang_word": "laid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7a3cbcb-71c3-3fcc-9b53-7e98816d2198",
                                        "entry_id": "7663b139-848c-30d6-82e2-cc01a18bdcc6",
                                        "glosses": [
                                            "Qui a quelque défaut qui se remarque dans les proportions, dans les formes ou dans les couleurs qui constituent la beauté chez les hommes et chez les animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e93d0eb6-7237-4c9c-b786-c8f8da0edc91",
                                                "sense_id": "c7a3cbcb-71c3-3fcc-9b53-7e98816d2198",
                                                "text": "On me tenait pour laide en général avec ma maigreur, ma bouche trop grande, mes vilaines dents, mon visage asymétrique, mon nez de travers. Me voilà belle à cette heure, et tous les hommes me le disent."
                                            },
                                            {
                                                "example_id": "5ea84fec-3dd6-4433-a77a-867b91466417",
                                                "sense_id": "c7a3cbcb-71c3-3fcc-9b53-7e98816d2198",
                                                "text": "C'est M. Lefèvre, l’ancien acteur des Variétés, qui a fait éclore un jour cette phrase dans la bouche de mademoiselle Juliette, une figurante laide et rousse qu'Odry, par antiphrase, appelait Joliette."
                                            },
                                            {
                                                "example_id": "ba42d922-a03c-4414-aa5d-d6f5ea99c1d1",
                                                "sense_id": "c7a3cbcb-71c3-3fcc-9b53-7e98816d2198",
                                                "text": "Cet enfant est bien constitué, mais il est laid de visage. — Elle est laide à faire peur. — Ce chien est des plus laids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afdad7fd-3639-3c40-9a1a-277e7c825fa6",
                                        "entry_id": "7663b139-848c-30d6-82e2-cc01a18bdcc6",
                                        "glosses": [
                                            "Qui est désagréable à voir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf15d658-b0e3-4adb-b6b8-19b5b525b939",
                                                "sense_id": "afdad7fd-3639-3c40-9a1a-277e7c825fa6",
                                                "text": "Ce meuble est laid."
                                            },
                                            {
                                                "example_id": "18a1fbe5-8032-4bae-b0ef-5afdb3f353ab",
                                                "sense_id": "afdad7fd-3639-3c40-9a1a-277e7c825fa6",
                                                "text": "Cette maison, cette tapisserie, cette étoffe est fort laide."
                                            },
                                            {
                                                "example_id": "d0b99640-64ea-4393-a2b5-0a530367394f",
                                                "sense_id": "afdad7fd-3639-3c40-9a1a-277e7c825fa6",
                                                "text": "Le temps est bien laid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a33a54-152b-3540-897d-72c2365229af",
                                        "entry_id": "7663b139-848c-30d6-82e2-cc01a18bdcc6",
                                        "glosses": [
                                            "Qui est déshonnête, contraire à la bienséance, au devoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a0678e-c9bb-496b-bad5-79d1ca7746d1",
                                                "sense_id": "26a33a54-152b-3540-897d-72c2365229af",
                                                "text": "Ce que vous faites là, ce que vous dites là est laid."
                                            },
                                            {
                                                "example_id": "ea4b740a-af46-4456-9b53-95a801d92833",
                                                "sense_id": "26a33a54-152b-3540-897d-72c2365229af",
                                                "text": "Mauvaise putain qui me mignote, se frotte à moi, se dit toute prise d’amour, profite de la faiblesse que j’ai pour elle, et me berne quand je dors, et me dérobe mon sceau de roi ? Ne sais-tu pas qu’il n’est acte plus laid, pire que vol ? Que d’aucuns sujet (sic) en mon royaume, fût-ce le plus grand, je ne tolérerais qu’il usât du cachet d’autrui sans le faire bâtonner ? Et c’est du mien qu’on se sert !"
                                            },
                                            {
                                                "example_id": "90ca2dd7-0322-4959-84a1-5cade7ed7963",
                                                "sense_id": "26a33a54-152b-3540-897d-72c2365229af",
                                                "text": "Bien et mal sont d'ailleurs intimement liés à beau et laid. Une mauvaise action est qualifiée d'affreuse au même titre qu'une peinture jugée inesthétique. On dit à un enfant : « C'est très laid ce que tu as fait là », et on parle d'un beau geste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e58c7c6e-0086-3089-afa6-a226ec5d3f59",
                                        "entry_id": "e92955b0-ecf1-3d1e-ac7a-fa75d28f0114",
                                        "glosses": [
                                            "Une personne laide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f54859c-093b-4b55-994f-a8ae2d2e885f",
                                                "sense_id": "e58c7c6e-0086-3089-afa6-a226ec5d3f59",
                                                "text": "Fi ! Le laid !"
                                            },
                                            {
                                                "example_id": "64cd5cb7-6370-4410-9ee0-cb41247128cc",
                                                "sense_id": "e58c7c6e-0086-3089-afa6-a226ec5d3f59",
                                                "text": "Fi ! La laide !"
                                            },
                                            {
                                                "example_id": "3e21d21b-eb0f-48f6-b932-1a43b9178c4d",
                                                "sense_id": "e58c7c6e-0086-3089-afa6-a226ec5d3f59",
                                                "text": "Une fausse laide."
                                            },
                                            {
                                                "example_id": "214c2c25-4137-4080-8649-9db087ae1474",
                                                "sense_id": "e58c7c6e-0086-3089-afa6-a226ec5d3f59",
                                                "text": "On pense tous secrètement que les choses viennent plus facilement aux gens beaux; ce sont les laids qui doivent faire l'effort de devenir créatifs et de se distinguer en sortant des proverbiaux « sentiers battus »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996d89f1-79b4-344e-bcd8-b53320bf8566",
                                        "entry_id": "e92955b0-ecf1-3d1e-ac7a-fa75d28f0114",
                                        "glosses": [
                                            "En parlant des choses."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b823d13c-bcb7-41cb-9c4c-6fe9172f114c",
                                                "sense_id": "996d89f1-79b4-344e-bcd8-b53320bf8566",
                                                "text": "Ils accepteront la division en homme productif et en homme de culture. Cette division elle-même est un phénomène culturel, comme la croyance à l’esprit et à la matière, au bien et au mal, au beau et au laid."
                                            },
                                            {
                                                "example_id": "52ae810c-b738-4241-bf7d-30c77b46f628",
                                                "sense_id": "996d89f1-79b4-344e-bcd8-b53320bf8566",
                                                "text": "Les romantiques ont fait une place toute nouvelle à l’expression du laid dans la littérature."
                                            },
                                            {
                                                "example_id": "96c764ce-5fd3-4650-aa71-38193e93350f",
                                                "sense_id": "996d89f1-79b4-344e-bcd8-b53320bf8566",
                                                "text": "Je vous ai dit le beau de l’aventure, mais voici le laid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
