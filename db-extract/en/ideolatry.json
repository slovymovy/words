                        "entry_id": "de14cb73-6f72-3c9d-8884-3d9682bae8fa",
                        "glosses": [
                            "The worship, attachment, or devotion to a concept originating and existing in the mind as a result of mental understanding, awareness, or activity."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4ff2fb6-7e02-32d5-9368-7e8da813f081",
                        "entry_id": "de14cb73-6f72-3c9d-8884-3d9682bae8fa",
                        "glosses": [
                            "The worship or devotion to the thoughts and intents derived from the human mind."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a930c7c-9f88-387f-aa8e-16c7f8deb217",
                        "entry_id": "de14cb73-6f72-3c9d-8884-3d9682bae8fa",
                        "glosses": [
                            "The worship of the human intellect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e59692-8f15-43f5-8ed3-37db4b78803f",
                                "sense_id": "8a930c7c-9f88-387f-aa8e-16c7f8deb217",
                                "text": "The human mind can be easily deceived and convinced of its superiority and self-sufficiency, which is the core of Ideolatry."
                            },
                            {
                                "example_id": "1bbf1b03-3c62-44d7-b315-f83377f83820",
                                "sense_id": "8a930c7c-9f88-387f-aa8e-16c7f8deb217",
                                "text": "Placing the human intellect on a pedestal and worshipping its potential is the core of Ideolatry and can severely diminish man’s ability to be completely fulfilled."
                            }
                        ]
                    }
                ],
