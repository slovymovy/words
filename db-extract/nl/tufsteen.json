                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tosca",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae0b2a5-05df-3d8a-90fe-f08fc59fc7f7",
                                        "entry_id": "8de93bd8-c8a8-3b44-89db-d9625f20c6ad",
                                        "glosses": [
                                            "Caliza ligera y muy porosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057c99d4-1790-418e-b419-03361befe662",
                                                "sense_id": "9ae0b2a5-05df-3d8a-90fe-f08fc59fc7f7",
                                                "text": "La espuma del mar es alguna vez detenida entre las piedras por el calor del Sol tornada en esponja o tosca, que es una piedra para adobar el pergamino."
                                            },
                                            {
                                                "example_id": "d3f69f36-22ff-4184-aa94-909887966c0a",
                                                "sense_id": "9ae0b2a5-05df-3d8a-90fe-f08fc59fc7f7",
                                                "text": "La tropa se partió en puntas, como una tosca que se desmorona en el agua."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11c17bf2-6d3e-3987-8374-bd99346e8ef2",
                                        "entry_id": "8de93bd8-c8a8-3b44-89db-d9625f20c6ad",
                                        "glosses": [
                                            "Por extensión, fragmento de roca cualquiera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b15f4d-bf96-41cc-8322-a15a3a41ec7b",
                                                "sense_id": "11c17bf2-6d3e-3987-8374-bd99346e8ef2",
                                                "text": "Hice detener el coche, ellos bajaron y estuvieron un rato tirando piedras al agua. Había uno, un chico riojano, que buscaba unas toscas, chatas, y las lanzaba haciéndolas picar varias veces sobre el agua... ‘¡dos, tres, cuatro!’, contaba."
                                            },
                                            {
                                                "example_id": "15bb49ed-92c0-4bd0-96bf-d6ce8dd6160b",
                                                "sense_id": "11c17bf2-6d3e-3987-8374-bd99346e8ef2",
                                                "text": "Y con él en la mano y el paso cauto de un ladrón, Robaina se metió en el cuarto de Monagas, que, entregado, dormía como una tosca, y lo pintó de negro, que lo dejó como un mirlo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "20ca61ad-bc00-3905-9ea9-6f8d5f68e88b",
                                        "entry_id": "8de93bd8-c8a8-3b44-89db-d9625f20c6ad",
                                        "glosses": [
                                            "Sedimento de sales de calcio y fósforo que se acumula sobre la superficie dental."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tosca",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c40d1129-16e3-3740-bdb7-1ce3e898464e",
                                        "entry_id": "e0f11d33-ce16-3951-8c32-b97281bf6adb",
                                        "glosses": [
                                            "Forma del femenino singular de tosco."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ead9ff5-dc94-4d49-8388-a058fd7aba0b",
                                                "sense_id": "c40d1129-16e3-3740-bdb7-1ce3e898464e",
                                                "text": "Las mis obras por defuera\naltas vos pareçerán,\nmas pasando la barrera,\nde vna tosca manera\nlabradas se mostrarán."
                                            },
                                            {
                                                "example_id": "5fbace39-dbea-4fe6-8ebd-3ace4417d802",
                                                "sense_id": "c40d1129-16e3-3740-bdb7-1ce3e898464e",
                                                "text": "Generalmente las cabañas tienen una tosca yacija de paja, heno u hojas secas extendidas en el suelo o sobre unas tablas algo elevadas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
