                "senses": [
                    {
                        "sense_id": "1231d315-79a1-3dd7-8de1-722322c30e2d",
                        "entry_id": "fec984e8-1db1-3101-bf53-ae15aa5f08cc",
                        "glosses": [
                            "Vorschlag, eine bestimmte Arbeit gegen Bezahlung anzunehmen"
