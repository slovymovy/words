                },
                {
                    "sense_id": "5e88bea9-f8de-3851-8c6f-5f0bc64b8914",
                    "sense_definition": "A person who is overweight or plump.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "body_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a bit of a <w>chub</w> as a child but grew into a very athletic teenager.",
                            "target_lang_translations": {
                                "fr": "Il était un peu <w>potelé</w> enfant, mais il est devenu un adolescent très athlétique."
                            }
                        },
                        {
                            "text": "The nickname was meant to tease the boy for being a <w>chub</w>.",
                            "target_lang_translations": {
