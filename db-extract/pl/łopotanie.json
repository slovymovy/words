                        "glosses": [
                            "wytwarzanie charakterystycznego dźwięku poprzez szybkie poruszanie przedmiotem"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ff19e984-6f72-3ca0-a0e4-a963c4e01f00",
                        "entry_id": "43491862-3b51-391f-9577-44694374879b",
                        "glosses": [
                            "wytwarzanie charakterystycznego dźwięku będąc szybko poruszanym"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "449dd345-5ec5-4ee8-a477-149db09d132c",
                                "sense_id": "ff19e984-6f72-3ca0-a0e4-a963c4e01f00",
                                "text": "Woda na Bajkale była jak szyba, cisza panowała uroczysta i słychać było tylko łopotanie kół nabierających wodę, a za statkiem widniał długi i głęboki gościniec i dwie groble z wodą spienioną — to droga, którędy przechodził statek"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7ada2901-9488-30fa-b7ab-f05e9980fabe",
                        "entry_id": "43491862-3b51-391f-9577-44694374879b",
                        "glosses": [
                            "poruszanie skrzydłami w górę i w dół"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "2ec90cbc-927f-4d88-99cc-d77ab9204ab0",
                                "sense_id": "7ada2901-9488-30fa-b7ab-f05e9980fabe",
                                "text": "Dzień był zimny, wilgotny, ale jasny; powietrze roiło się od kawek, które zamieszkiwały dachy i szczyty baszt, a które spłoszone niezwykłym ruchem, kołowały z wielkiem łopotaniem skrzydeł nad zamkiem"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
