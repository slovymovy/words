                "translations": [
                    {
                        "translation_id": "6a1a62dc-cbee-42e7-8d45-54b924d9fff5",
                        "source_entry_id": "ba8b5cf2-27ae-35db-b915-d422d9885d77",
                        "target_lang_word": "opportunistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opportunistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7c60a1-72aa-3f8f-bd31-64af30b61133",
                                        "entry_id": "11e63ad2-98ef-3a3b-98e7-6a032ff97f5f",
                                        "glosses": [
                                            "Taking advantage of situations that arise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01eb35e5-ed2c-40bb-be06-fcddc8d28124",
                                                "sense_id": "ae7c60a1-72aa-3f8f-bd31-64af30b61133",
                                                "text": "The danger now isn't so much from the AIDS virus itself as from opportunistic infections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                        "entry_id": "11e63ad2-98ef-3a3b-98e7-6a032ff97f5f",
                                        "glosses": [
                                            "Taking advantage of situations to advance one's own interests without regard for moral principles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29ab905-3f04-4317-bf3f-b584c66a1581",
                                                "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                                "text": "You can't trust somebody that opportunistic: he'll stab you in the back the first chance he gets."
                                            },
                                            {
                                                "example_id": "b845d842-fddd-448d-993e-8ee9bc7b3f25",
                                                "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                                "text": "[…] an opportunistic relative masquerading as his rescuer, […]"
                                            },
                                            {
                                                "example_id": "23a02d66-16c8-49ce-b1ba-09e89a33eb02",
                                                "sense_id": "c7127f96-a31e-3e1b-ae52-36dd27be80bc",
                                                "text": "Now, maybe you see this as sort of an obvious and opportunistic publicity play by a competing social-media service. Maybe it even seems crass to you—a little grave-dancy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
