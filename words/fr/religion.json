                    "frequency": "High",
                    "semantic_group_id": "foi_et_culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La constitution de notre pays garantit pleinement la liberté de <w>religion</w> à tous les citoyens."
                        },
                        {
                            "text": "Ces historiens étudient les conflits armés connus sous le nom de guerres de <w>religion</w> au seizième siècle."
                        }
                    ],
