                        "examples": [
                            {
                                "example_id": "e254af4c-f182-44b4-b746-950aa096def9",
                                "sense_id": "318940d0-733b-358b-ab65-50c6d7964e76",
                                "text": "Это был аффект безумства и помешательства, но и аффект природы, мстящей за свои вечные законы безудержно и бессознательно, как и все в природе."
                            }
                        ]
