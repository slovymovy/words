                                            {
                                                "example_id": "25e16404-0a9c-436c-8ccb-2d9a3365e1f9",
                                                "sense_id": "7c3717f6-5c6a-36fe-8192-255b1b70154c",
                                                "text": "Suppose a Person hath learnt to sing in the Treble Cliff only, and would sing Notes prick'd in the Tenor Cliff on the middle tine with F# […]"
                                            }
