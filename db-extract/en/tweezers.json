                    {
                        "translation_id": "6b6ec9e8-14c2-49fe-8005-a82e8b154e28",
                        "source_entry_id": "1337ec6a-ea56-3015-b840-3ebc2060926f",
                        "source_sense_id": "9ad093f2-9d32-3278-bc6f-3790491c3eaa",
                        "source_sense_description": "small pincer-like instrument, usually made of metal, used for handling small objects",
                        "target_lang_word": "Pinzette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pinzette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                        "entry_id": "89bcb9a6-a80b-34b7-978c-b24927f96faf",
                                        "glosses": [
                                            "Instrument, das zum Greifen und Halten kleiner Gegenstände benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf6e3b1-c803-46de-9646-e215c244139e",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "Die kleinen Bauteile kann man nur mit Hilfe einer Pinzette greifen."
                                            },
                                            {
                                                "example_id": "54808e26-2c2f-4e63-991c-25f9fc868c3f",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "Mit einer kleinen Pinzette zupfen sich Frauen störende Haare aus dem Gesicht."
                                            },
                                            {
                                                "example_id": "f73ba36c-869f-43a7-ae89-f70a716226f4",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "„Immer wieder rutscht die Pinzette ab oder ich kriege das Insekt nicht richtig am Kopf zu fassen.“"
                                            },
                                            {
                                                "example_id": "390a63fb-4887-4edf-8714-f4cb0c0fabdf",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "„Mit einer Pinzette faßte er eine Ecke von Herrn Puntareras' Konterfei, über der sich kein Stempel befand und hob sie äußerst vorsichtig einen Millimeter hoch.“"
                                            },
                                            {
                                                "example_id": "b04b0995-24ef-4b8d-a060-7059f93c540b",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "„Er knackt die Scheren mit einem Nußknacker und zieht das Fleisch mit einer gebogenen Pinzette heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
