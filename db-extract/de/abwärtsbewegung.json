                            {
                                "example_id": "b0452a33-f911-4706-bb08-cd59e3090c43",
                                "sense_id": "7c437a9a-0a56-36ba-8117-741772a6cee6",
                                "text": "Wie viele Aufwärtsbewegungen und Abwärtsbewegungen so ein Sessellift wohl an einem Tage macht?"
                            }
                        ],
