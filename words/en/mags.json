            "senses": [
                {
                    "sense_id": "f4d29f45-f8d4-3497-87e2-126d5ebf8058",
                    "sense_definition": "A diminutive of the female given name <w>Maggie</w>, which is itself a diminutive of <w>Margaret</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
