{
    "word_family": [
        "appendage",
        "appendix",
        "appendant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91418974-c44a-3fa4-86ca-3f54b92024e0",
                    "sense_definition": "To add something as an extra or supplementary part to a larger work or document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "add_to",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author decided to <w>append</w> a list of references to the final chapter of the book."
                        },
                        {
                            "text": "Please <w>append</w> your signature to the bottom of the contract before returning it."
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "annex",
                        "supplement"
                    ],
                    "antonyms": [
                        "remove",
                        "detach"
                    ],
                    "common_phrases": [
                        "append to document"
                    ]
                },
                {
                    "sense_id": "6f96a5c3-8aac-3d1f-9900-91272c25162a",
                    "sense_definition": "To write or add new data to the end of an existing file or digital object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "add_to",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program will <w>append</w> the new log entries to the existing text file automatically."
                        },
                        {
                            "text": "You can <w>append</w> data to the database without overwriting the information that is already stored there."
                        }
                    ],
                    "synonyms": [
                        "add"
                    ],
                    "common_phrases": [
                        "append to file"
                    ]
                },
                {
                    "sense_id": "0b673285-149c-3e8c-aec3-decbda52c814",
                    "sense_definition": "To hang or attach something physically to another object.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A wax seal was <w>appended</w> to the official royal decree to verify its authenticity."
                        },
                        {
                            "text": "The ancient tradition required a small charm to be <w>appended</w> to the ceremonial sword."
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "suspend"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ae15c03-aedc-3e55-afc2-67150551310a",
                    "sense_definition": "The act or process of adding data to the end of an existing file.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system performs an <w>append</w> operation whenever new user activity is recorded in the log."
                        },
                        {
                            "text": "Each <w>append</w> to the file increases its total size on the hard drive."
                        }
                    ],
                    "synonyms": [
                        "addition"
                    ],
                    "common_phrases": [
                        "file append"
                    ]
                }
            ]
        }
    ]
}