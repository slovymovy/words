{
    "word_family": [
        "nutritious",
        "nutrition",
        "nutritional",
        "nutritionist",
        "nutriment",
        "nutritive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ef11888-a8e4-3f12-9d50-310c01b78d30",
                    "sense_definition": "A substance that provides nourishment essential for growth and the maintenance of life.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nourishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plants absorb every essential <w>nutrient</w> they need directly from the soil through their roots.",
                            "target_lang_translations": {
                                "ru": "Растения поглощают каждое необходимое <w>питательное вещество</w> напрямую из почвы через свои корни."
                            }
                        },
                        {
                            "text": "A balanced diet should provide a rich <w>nutrient</w> source for your body to function properly.",
                            "target_lang_translations": {
                                "ru": "Сбалансированная диета должна обеспечивать богатый источник <w>питательных веществ</w> для правильного функционирования вашего организма."
                            }
                        }
                    ],
                    "synonyms": [
                        "nutriment"
                    ],
                    "common_phrases": [
                        "essential nutrient",
                        "rich nutrient",
                        "absorb nutrient",
                        "nutrient deficiency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, обеспечивающее питание, необходимое для роста и поддержания жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "питательное вещество",
                                "target_lang_sense_clarification": "общее название для компонентов пищи"
                            },
                            {
                                "target_lang_word": "нутриент",
                                "target_lang_sense_clarification": "биологический или медицинский термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68979eef-babe-3458-99ff-9637114b7b37",
                    "sense_definition": "Providing nourishment or serving as a source of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nourishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist studied the <w>nutrient</w> properties of various types of seaweed found in the area.",
                            "target_lang_translations": {
                                "ru": "Ученый изучил <w>питательные</w> свойства различных видов морских водорослей, найденных в этом районе."
                            }
                        },
                        {
                            "text": "This <w>nutrient</w> solution helps the young plants grow much faster than they would in plain water.",
                            "target_lang_translations": {
                                "ru": "Этот <w>питательный</w> раствор помогает молодым растениям расти гораздо быстрее, чем в обычной воде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nutrient solution",
                        "nutrient properties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивающий питание или служащий источником пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "питательный",
                                "target_lang_sense_clarification": "содержащий необходимые вещества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}