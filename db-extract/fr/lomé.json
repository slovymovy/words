                "forms": [],
                "senses": [
                    {
                        "sense_id": "282881ee-d82f-3c7e-8a65-374715217b3b",
                        "entry_id": "88057eb0-695b-3831-b2a8-67966467d058",
                        "glosses": [
                            "Ville et capitale du Togo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b151c949-ca18-4c66-9c4e-19615b77c435",
                                "sense_id": "282881ee-d82f-3c7e-8a65-374715217b3b",
                                "text": "Pendant trois ans, c'est un homme à l’enthousiasme éteint, mort à Lomé, qui veillera sans états d’âme sur le retrait de la France d'Afrique : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad67b08a-9cf8-3853-83ff-2ad9ca7196ea",
                        "entry_id": "88057eb0-695b-3831-b2a8-67966467d058",
                        "glosses": [
                            "Gouvernement togolais."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "7bfacad5-f2f2-4225-8507-3a857c3c9249",
                                "sense_id": "ad67b08a-9cf8-3853-83ff-2ad9ca7196ea",
                                "text": "Les discussions porteront essentiellement sur les opportunités d’investissements au Togo. A ce rendez-vous, Lomé veut surtout attirer l’attention des fleurons des secteurs de l’énergie solaire, de la Tech ou encore celui de l’automobile."
                            }
                        ]
                    }
                ],
