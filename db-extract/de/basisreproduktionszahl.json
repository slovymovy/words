                        "examples": [
                            {
                                "example_id": "fb08edbc-b4eb-43fb-a3c7-d692d4e36b0c",
                                "sense_id": "2d7a2683-e8c2-3d4b-8dbf-0bd4db2f23a7",
                                "text": "Die Basisreproduktionszahl R0 gibt an, wie viele Menschen eine erkrankte Person durchschnittlich infiziert, wenn in der Bevölkerung keine Immunität gegen den Erreger vorhanden ist."
