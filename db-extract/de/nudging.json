                                            {
                                                "example_id": "a9d2afeb-68ff-4f7e-8cff-eb00a0d33dd8",
                                                "sense_id": "3442161d-bc94-3343-9458-1d2e89855b66",
                                                "text": "It has been remarked that nudging is also a euphemism for psychological manipulation as practiced in social engineering."
