                    {
                        "translation_id": "45c7c9fb-4ca5-41a9-b49a-0be2af26eaa6",
                        "source_entry_id": "0d4a8232-6b0a-34cb-9a47-3df261028061",
                        "source_sense_id": "1de5cc86-40af-303e-972c-568b6a70556c",
