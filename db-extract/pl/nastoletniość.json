                "translations": [
                    {
                        "translation_id": "a366cd2c-fe45-433d-8112-d86e09e390fe",
                        "source_entry_id": "1d225021-73ee-3ddc-a436-67c6723af4f0",
                        "source_sense_id": "66568a60-fc7f-3110-bc52-62df637f0b81",
                        "target_lang_word": "teenageness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teenageness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2385022c-e7e1-36bf-9841-3b39f4344f79",
                                        "entry_id": "03cf900d-d653-3426-bc32-d13567f896b5",
                                        "glosses": [
                                            "The quality of being or being like a teenager."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1393aa70-ac74-439f-bba0-689cd116b980",
                                                "sense_id": "2385022c-e7e1-36bf-9841-3b39f4344f79",
                                                "text": "Your teen experience is so central to what Zen Buddhists call “this great matter of birth and death,” that to be fully awake to your teenageness is to be a genuinely spiritual person."
                                            },
                                            {
                                                "example_id": "7fd8600a-f8fb-4d8d-a9cd-9427140775ef",
                                                "sense_id": "2385022c-e7e1-36bf-9841-3b39f4344f79",
                                                "text": "I almost feel sorry for them but then I realize that their response to her teenageness is helping shape her for the future."
                                            },
                                            {
                                                "example_id": "0a8adab8-90c4-450d-8675-a9fdcf59f905",
                                                "sense_id": "2385022c-e7e1-36bf-9841-3b39f4344f79",
                                                "text": "Mr. Avalon must have been near fifty now, but still some kind of feckless teenageness clung to him, in his lank, shining hair, his unbuttoned black shirts, the school-boyish way he'd kick back at his teaching desk, sneakers crossed on the tabletop."
                                            },
                                            {
                                                "example_id": "9a4b3e5b-8532-4b87-9fb8-58e5ff7d725f",
                                                "sense_id": "2385022c-e7e1-36bf-9841-3b39f4344f79",
                                                "text": "I wish I hadn't resisted the magnetic pull of teenageness into that roiling heart of communal feeling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
