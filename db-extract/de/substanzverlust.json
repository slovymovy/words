                "senses": [
                    {
                        "sense_id": "fb6432b4-43dd-39b9-aa18-017d464b0b00",
                        "entry_id": "cd5950aa-4bb7-3835-b063-4be40be1d759",
                        "glosses": [
                            "Verlieren an Substanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214d9d7d-4021-424c-8b7e-d74726a4e747",
                                "sense_id": "fb6432b4-43dd-39b9-aa18-017d464b0b00",
                                "text": "„Lässt sich das Wesentliche der biblischen Hoffnung ohne Substanzverlust übersetzen?“"
                            },
                            {
                                "example_id": "874d9400-0704-44c0-a7bf-0a66335e940f",
                                "sense_id": "fb6432b4-43dd-39b9-aa18-017d464b0b00",
                                "text": "„Eine Narbe besteht aus einer Gewebsneubildung, die einen Substanzverlust ersetzt oder nach einem entzündlichen Prozeß sich eingestellt hat.“"
                            },
                            {
                                "example_id": "75402c46-5a08-409d-8658-9c878505cbf7",
                                "sense_id": "fb6432b4-43dd-39b9-aa18-017d464b0b00",
                                "text": "„Die Heilungsvorgänge einer offenen Wunde mit Substanzverlust ohne Infektion, oder wenigstens ohne nennenswerte Infektion, verläuft etwa folgendermaßen.“"
                            },
                            {
                                "example_id": "325e7121-28b2-45d8-8ae7-c705c877171b",
                                "sense_id": "fb6432b4-43dd-39b9-aa18-017d464b0b00",
                                "text": "„Bei Wunden mit Substanzverlust fließt zuerst Blut ab; steht dann die Blutung, so bildet sich aus dem teilweise eintrocknendem Blute am Wundrand eine Kruste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
