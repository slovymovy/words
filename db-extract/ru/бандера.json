                "senses": [
                    {
                        "sense_id": "c8e67522-aca1-387f-988d-96a64457542d",
                        "entry_id": "d5b7819e-de58-3672-beaa-d874d2be4523",
                        "glosses": [
                            "украинская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa766b0b-d0bb-45cc-be14-e84e18d5512c",
                                "sense_id": "c8e67522-aca1-387f-988d-96a64457542d",
                                "text": "15 октября 1959 года в Мюнхене был убит один из лидеров украинских националистов Степан Бандера."
                            },
                            {
                                "example_id": "516d8ae9-a69c-4948-9e84-3f5a7dc3dbfb",
                                "sense_id": "c8e67522-aca1-387f-988d-96a64457542d",
                                "text": "Степан Бандера ― лидер движения за независимость Украины и руководитель Организации украинских националистов."
                            }
                        ]
                    }
                ],
