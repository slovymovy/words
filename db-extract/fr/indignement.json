        "fr-extract.jsonl": [
            {
                "entry_id": "5ca13c6d-72f6-353b-a742-a26d327c0b2a",
                "word": "indignement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                        "entry_id": "5ca13c6d-72f6-353b-a742-a26d327c0b2a",
                        "glosses": [
                            "D’une manière indigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b828c8f-f48e-48a4-9aa3-a167265f2144",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Prendrait-elle pour roi l’esclave de Mycène […] Qui s’est au roi d’Argos indignement soumis ?"
                            },
                            {
                                "example_id": "233e7782-cfe0-4249-bdf5-f6018945797c",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Quand un roi fainéant, la vergogne des princes, Laissant à ses flatteurs le soin de ses provinces, Entre les voluptés indignement s’endort."
                            },
                            {
                                "example_id": "4906cdfe-b440-4a92-a3d0-8db1087bb6bb",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Un prince que j'estime, indignement m’offense."
                            },
                            {
                                "example_id": "a9b8fd58-075c-4c81-bd4f-b1483c166045",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Un trône indignement renversé et miraculeusement rétabli."
                            },
                            {
                                "example_id": "c64e7fab-a03b-4dda-b694-46fa6e82a8f8",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Par des soldats peut-être indignement traînée."
                            },
                            {
                                "example_id": "56e3b6d5-106b-4aed-9ee7-76153bab0462",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Et je ne prétends pas, indignement épris, Rougir devant mon frère et souffrir des mépris."
                            },
                            {
                                "example_id": "45ff071d-e504-408e-9405-14fc434bc46b",
                                "sense_id": "8bb3f78d-4fa0-34a8-924b-7c09fd5a83a6",
                                "text": "Et d’un cruel spectacle indignement avide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b09aa4aa-e6de-47b4-8a6e-7809c63fa2e4",
