                "senses": [
                    {
                        "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                        "entry_id": "2dba0404-aa19-3d67-b797-d489ada07b8b",
                        "glosses": [
                            "klebender Textil- oder Plastikstreifen zum Befestigen eines Verbandes oder, dann mit einer Auflage aus Mull, direkt zum Bedecken von Wunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce4fb42-ee22-4f1e-86e2-64f0b3204543",
                                "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                "text": "Das selbstklebende Heftpflaster wurde 1882 von Beiersdorf erfunden."
                            },
                            {
                                "example_id": "f465f22a-dea2-4e40-b057-613def10b67c",
                                "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                "text": "„Der einfachste Verband ist das Heftpflaster, eine kleine sterile Wundauflage, die mit einem Pflaster fest verbunden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46fb504e-bbcc-4b43-8f16-90ece559538d",
                        "source_entry_id": "2dba0404-aa19-3d67-b797-d489ada07b8b",
                        "source_sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
