                                "sense_id": "20466e3c-e87e-3ade-8d00-9e2fd7f0a1ef",
                                "text": "„Alle Bahnhöfe an den wichtigsten Zugstrecken haben Informationsschalter, an denen man Auskunft über Bahnverbindungen und Fahrpläne bekommen kann.“"
                            },
                            {
                                "example_id": "6b59886a-c38b-43b2-b499-8da21bf218e6",
                                "sense_id": "20466e3c-e87e-3ade-8d00-9e2fd7f0a1ef",
                                "text": "„Noch funktionierten die Bahnverbindungen im Kessel.“"
                            }
                        ],
