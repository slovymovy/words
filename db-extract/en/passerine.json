                                    {
                                        "sense_id": "85e516da-255c-3da1-a76b-442c25210bbd",
                                        "entry_id": "e33c2e9e-aa85-3439-b9e6-fa16d41f3edf",
                                        "glosses": [
                                            "Nom usuel de Thymelaea passerina plante de la famille des Thyméléacées que l'on rencontre dans les zones sèches et rocailleuses du sud de l'Europe et Moyen-Orient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff6474c-d20f-407a-ad1d-e300662b5758",
                                                "sense_id": "85e516da-255c-3da1-a76b-442c25210bbd",
                                                "text": "La passerine dioïque, qui se trouve dans les Pyrénées."
                                            },
                                            {
                                                "example_id": "9a915f83-9765-4303-804a-032411ded798",
                                                "sense_id": "85e516da-255c-3da1-a76b-442c25210bbd",
                                                "text": "La passerine thymélée, DC, dite vulgairement herbe de Mont-Serrat, et qui était le daphné thymélée de Linné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e88b69-7d0c-3d6c-b222-2330ade195db",
                                        "entry_id": "e33c2e9e-aa85-3439-b9e6-fa16d41f3edf",
                                        "glosses": [
                                            "Genre de passereaux de l’ordre des granivores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6646f03-7091-4368-9af6-2f53e2f322ad",
                                                "sense_id": "24e88b69-7d0c-3d6c-b222-2330ade195db",
                                                "text": "La passerine bleue, dont le mâle a été décrit sous le nom de bruant Canada ; c’est l’embérize bleue de Latham, dite aussi ministre."
                                            },
                                            {
                                                "example_id": "d919657e-82d8-4a9a-b636-985e61a06b5b",
                                                "sense_id": "24e88b69-7d0c-3d6c-b222-2330ade195db",
                                                "text": "La passerine oryzivore, appelée vulgairement ortolan de riz et bruant de la Caroline ; c’est l’embérize oryzivore de Latham ; d’autres ont employé les mots « mangeurs de riz » pour traduire le nom spécifique."
                                            },
                                            {
                                                "example_id": "72a1128a-d471-44d8-81a3-3fe59a8b115d",
                                                "sense_id": "24e88b69-7d0c-3d6c-b222-2330ade195db",
                                                "text": "La passerine des pâturages ; elle est devenue l’embérize des troupeaux."
                                            },
                                            {
                                                "example_id": "fe6a1382-5164-43e2-a49e-2af6d87213ec",
                                                "sense_id": "24e88b69-7d0c-3d6c-b222-2330ade195db",
                                                "text": "La passerine musicienne (États-Unis) de Vieillot, confondue à tort avec le petit chanteur de Cuba dont elle diffère beaucoup ; ce dernier est la passerine lépide (Cuba, Haïti) de Vieillot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
