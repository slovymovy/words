                "senses": [
                    {
                        "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                        "entry_id": "693ae684-3b7d-3b0e-8724-60583615504f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c761ac0-97d5-4901-99f3-0227fec59767",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Frau Backhaus ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "58e66528-781f-4646-8453-22a3945ba70e",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Herr Backhaus wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "89fabfae-d624-4f40-88d5-75d07919e2e5",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Die Backhaus fliegen heute nach Helsinki."
                            },
                            {
                                "example_id": "f2a93886-b2de-4655-a573-c4cef369a135",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Der Backhaus trägt nie die Pullover, die die Backhaus ihm strickt."
                            },
                            {
                                "example_id": "c8f43787-df4a-4252-83f7-51a32d8fab18",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Backhaus kommt, geht der Herr Backhaus.“"
                            },
                            {
                                "example_id": "585aa8f5-7dcd-4df7-817d-5ea6d1424993",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Backhaus kommt und geht."
                            },
                            {
                                "example_id": "8df8f408-4f48-4b52-8a1c-6819ed9b3052",
                                "sense_id": "eb42e102-e39b-36e8-8fea-e27cd19e721f",
                                "text": "Backhausens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
