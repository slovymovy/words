                ],
                "senses": [
                    {
                        "sense_id": "6666d60c-e0ba-3274-b5f6-dfbc90bdda78",
                        "entry_id": "3fc04f42-3d6c-34d9-8412-4096776d9b5f",
                        "glosses": [
                            "Art und Weise, wie jemand oder etwas wahrgenommen und/oder beurteilt wird; Image"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77cdde40-0199-46f1-88c9-05d6a8ad3752",
                                "sense_id": "6666d60c-e0ba-3274-b5f6-dfbc90bdda78",
                                "text": "„Świat wielkiej mody coraz chętniej otwiera się na recykling tekstyliów i tworzyw sztucznych, coraz częściej budując swój image na koncepcji zrównoważonego rozwoju.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b871d1e-541e-40da-89f6-81ff38e1284d",
                        "source_entry_id": "3fc04f42-3d6c-34d9-8412-4096776d9b5f",
                        "source_sense_id": "6666d60c-e0ba-3274-b5f6-dfbc90bdda78",
                        "source_sense_description": "Art und Weise, wie jemand oder etwas wahrgenommen und/oder beurteilt wird; Image",
                        "target_lang_word": "Image",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Image",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                        "entry_id": "21a4ec11-f0c0-303b-9d31-f195591f50aa",
                                        "glosses": [
                                            "inneres Bild, das sich Personen von einem Objekt (zum Beispiel von einem Produkt, einer Person, Gruppe oder Organisation) machen; dieses Bild wird dann oft dem Objekt zugeschrieben und beeinflusst damit dessen Ansehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0f0175-4d60-438e-9cbc-b45493176c43",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "Ich muss mein Image schützen."
                                            },
                                            {
                                                "example_id": "13938f91-9575-4f0a-8a27-af98066c4087",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "Wiktionary hat ein gutes Image."
                                            },
                                            {
                                                "example_id": "92ec05ab-ebd6-4cd5-a2c5-23e819f5472b",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "Die Latina gehört zu den heißesten Frauen in Hollywood, doch ihr Image als Sex -Symbol findet die Schauspielerin erniedrigend."
                                            },
                                            {
                                                "example_id": "b1b468cb-a98d-42bc-9018-e35471005fac",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "Der Zeitungsbericht über die Arbeitsbedingungen im Vertrieb hat dem guten Image der Firma geschadet."
                                            },
                                            {
                                                "example_id": "1fad5985-080c-4861-8559-2f47fae49f67",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "Der Rapper spielt mit dem Image des bösen Jungen."
                                            },
                                            {
                                                "example_id": "2a8591eb-2e23-4a90-ab82-75fcf7b4a9f2",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "„Das verloren gegangene Image hängt natürlich nicht nur mit Fernsehkrimis, Vorabendserien oder Bestsellerlisten voller Thriller und Krimis zusammen, auch wenn dadurch ein schräges Bild vermittelt wird.“"
                                            },
                                            {
                                                "example_id": "97d33b1d-dd14-4f92-a589-6be6c5081d53",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "„Wahlkämpfe werden mit den Images von Spitzenpolitikern statt mit Parteiprogrammen geführt, Parteitage sollen Fernsehbilder liefern statt programmatische Diskussionen ermöglichen.“"
                                            },
                                            {
                                                "example_id": "295cf1fb-ce7c-4f00-a064-51ff01740984",
                                                "sense_id": "19dd910a-2011-39a4-8e9b-9fa7d26c3662",
                                                "text": "„Sein Image als harter Hund hatte verdeckt, wie dünnhäutig er eigentlich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5adbcc15-a629-3844-ac06-b9e2813ab5b7",
                                        "entry_id": "21a4ec11-f0c0-303b-9d31-f195591f50aa",
                                        "glosses": [
                                            "Abbild eines Datenträgers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77327b44-2f6d-4cb1-a092-dddb24dd8d55",
                                                "sense_id": "5adbcc15-a629-3844-ac06-b9e2813ab5b7",
                                                "text": "Ein Image enthält Informationen über die Struktur des Originalspeichers, dies ermöglicht es, schnell exakte Kopien eines Datenträgers herzustellen."
                                            },
                                            {
                                                "example_id": "09668052-d1e9-4005-99a8-836f53fe5c89",
                                                "sense_id": "5adbcc15-a629-3844-ac06-b9e2813ab5b7",
                                                "text": "Das Image einer Distribution überträgt man unter Linux mit dem Befehl dd auf einen USB-Stick."
                                            },
                                            {
                                                "example_id": "f95a9598-e06d-466a-a26c-eea8b92c2dbf",
                                                "sense_id": "5adbcc15-a629-3844-ac06-b9e2813ab5b7",
                                                "text": "„Jonathan Riddell präsentiert hier eine Lösung in Form von Docker-Images für KDE Neon. Ist eine Docker-Umgebung aufgesetzt, lassen sich diese Images schnell ausrollen. Dazu hat Ridell im Docker-Hub zwei Images bereitgestellt.“"
                                            },
                                            {
                                                "example_id": "f33b026b-be8a-4588-8393-04b12a597003",
                                                "sense_id": "5adbcc15-a629-3844-ac06-b9e2813ab5b7",
                                                "text": "[Schlagzeile:] „Opensuse mit neuem Image für den Raspberry Pi“"
                                            },
                                            {
                                                "example_id": "282260c8-eca4-4a1d-aa18-270807905d31",
                                                "sense_id": "5adbcc15-a629-3844-ac06-b9e2813ab5b7",
                                                "text": "„Sie finden das aktuelle Image (jedes Jahr wird ein neues erstellt) unter Siduction-Images zum Download, dazu finden sich Images mit Cinnamon, GNOME, KDE, LXDE, LXQT, Mate, XFCE und ohne grafische Oberfläche – hierzu sollte man schon etwas ein versierter Debian-Nutzer sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
