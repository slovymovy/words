                        "translation_id": "4574dabf-e8ba-4480-8055-f4f97ba0d5bb",
                        "source_entry_id": "7e9dde66-e6cf-3df2-90d5-526594ad7f2b",
                        "source_sense_id": "255cc71d-d921-3a78-9ddb-0a2e4272dae9",
                        "target_lang_word": "ergonomía",
