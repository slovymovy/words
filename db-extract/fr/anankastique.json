                                        "glosses": [
                                            "An anankastic phrase or utterance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb830464-91b0-380f-b321-2db35a66d422",
                                        "entry_id": "51c8e3f9-8ee7-3a9f-8097-157052e43be3",
                                        "glosses": [
                                            "An obsessive-compulsive individual."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1988d71-7469-4b0c-bf2f-41b78f0307d2",
                                                "sense_id": "bb830464-91b0-380f-b321-2db35a66d422",
                                                "text": "Like many anankastics, he suffers from a disturbance in the capacity to act, which is revealed especially as an impediment to beginning something new and completing something."
