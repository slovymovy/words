                        "glosses": [
                            "korte leren broek met bretels als deel van een Duitse klederdracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5589d33a-85f0-4792-9973-42f0b0081f73",
                                "sense_id": "7ee156d5-a78e-3831-96c1-fc1ed6a8c168",
                                "text": "Niet alleen Hofer toont zich in de campagne gematigd. Ook zijn tegenstander Alxander Van der Bellen doet als linkse Groene kandidaat zijn best om de stemmers van het midden voor zich te winnen. Ook hij toont zich als een vaderlandslievende patriot in Lederhose en op zijn verkiezingsposters is het woord Heimat geen vies woord."
                            },
                            {
                                "example_id": "9baa0798-fe42-461b-bf90-b9617b9c6742",
                                "sense_id": "7ee156d5-a78e-3831-96c1-fc1ed6a8c168",
                                "text": "Nog een paar dingen die men dient te weten: de serveersters heten Madl, het is heel normaal om ze te roepen met termen als Spatzl, en als ze de strik van hun rok links dragen zijn ze vrijgezel. Beierse klederdracht is niet verplicht maar de afgelopen jaren wel erg modieus geworden, en verhoogt volgens vaste bezoekers de flirtfactor: Dirndl voor de dames, Lederhose voor de heren."
                            }
                        ]
                    }
