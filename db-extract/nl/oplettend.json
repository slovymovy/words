        "nl-extract.jsonl": [
            {
                "entry_id": "650456c0-70a1-349e-8b85-27c59ab20293",
                "word": "oplettend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f6a60a5-1472-3876-b5c3-62df39e2f66d",
                        "entry_id": "650456c0-70a1-349e-8b85-27c59ab20293",
                        "glosses": [
                            "met zorgvuldige aandacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c15961-d1a5-4e31-9a24-466ef174b54c",
                                "sense_id": "7f6a60a5-1472-3876-b5c3-62df39e2f66d",
                                "text": "De politie heeft zondag in Oldenzaal een fietsendief op heterdaad betrapt en aangehouden. De verdachte werd gespot door een oplettende voorbijganger, die hem zag lopen met een fiets waarvan hij steeds het achterwiel optilde."
                            },
                            {
                                "example_id": "233cf1b2-f74c-4c02-93dd-dc4c483d550a",
                                "sense_id": "7f6a60a5-1472-3876-b5c3-62df39e2f66d",
                                "text": "Door oplettende getuigen kon een verdachte worden aangehouden. De politie is echter nog op zoek naar een of meerdere verdachten en het voertuig waar zij in reden."
                            },
                            {
                                "example_id": "286cd2de-3692-47cd-ac04-3c205457403f",
                                "sense_id": "7f6a60a5-1472-3876-b5c3-62df39e2f66d",
                                "text": "Ik schrijf veel en ben steeds bezig met waarover ik ga schrijven, niet met waarover ik geschreven heb. Totdat ik daar door een oplettende lezer aan word herinnerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f0d96d2-3467-40f5-ad92-07528434bfd8",
                        "source_entry_id": "650456c0-70a1-349e-8b85-27c59ab20293",
                        "source_sense_id": "7f6a60a5-1472-3876-b5c3-62df39e2f66d",
                        "source_sense_description": "met zorgvuldige aandacht",
                        "target_lang_word": "keen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Often with a prepositional phrase, or with to and an infinitive: showing a quick and ardent responsiveness or willingness; eager, enthusiastic, interested."
                                        ],
                                        "tags": [
                                            "Commonwealth"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97acdea0-bc3f-484a-9ae6-e8f8e4bb9587",
                                                "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                                "text": "I’m keen on computers."
                                            },
                                            {
                                                "example_id": "e28a1bab-1b3c-4aca-9a60-13a43247fab4",
                                                "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                                "text": "I’m keen on you.",
                                                "translation": "I like you.",
                                                "english": "I like you."
                                            },
                                            {
                                                "example_id": "9b2e56de-a969-4771-ba58-a76bbd5a313c",
                                                "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                                "text": "She’s keen to learn another language."
                                            },
                                            {
                                                "example_id": "2206be90-a28d-4003-a465-e3e500bda0e5",
                                                "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                                "text": "“Do you want to go on holiday with me?” “Yes, I’m keen.”"
                                            },
                                            {
                                                "example_id": "c5ae7ce8-f243-4794-84b6-b860b2b5dabe",
                                                "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                                "text": "Ophe[lia] You are keene my Lord, you are keene. / Ham[let] It would coſt you a groaning, to take off my edge."
                                            },
                                            {
                                                "example_id": "0cf8efe4-3c1c-4c49-ac3f-71643877d32b",
                                                "sense_id": "bca92650-d635-38b8-87a5-4191c14fe874",
                                                "text": "In fact, she doesn't mention the fact that I've obviously been avoiding her, just sounds genuinely thrilled to hear from me, and as soon as I mention getting together she suggests Monday, which is rather keen, even for Portia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8de8965-6238-380a-9184-6bc2e292b15f",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Fierce, intense, vehement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0616c8ba-3ee2-4dc4-b35f-2e90a0655752",
                                                "sense_id": "e8de8965-6238-380a-9184-6bc2e292b15f",
                                                "text": "This boy has a keen appetite."
                                            },
                                            {
                                                "example_id": "ea800cfc-6232-4188-a876-b06e45799206",
                                                "sense_id": "e8de8965-6238-380a-9184-6bc2e292b15f",
                                                "text": "[N]euer did I know / A creature that did beare the ſhape of man / So keene and greedy to confound a man."
                                            },
                                            {
                                                "example_id": "abbf5e7a-9638-452b-b19b-843897a316f0",
                                                "sense_id": "e8de8965-6238-380a-9184-6bc2e292b15f",
                                                "text": "Her love of a good dinner herself, and her still keener love of the approbation she won by setting it before others, kept up perpetual warfare with her savingness […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf43816-ba60-38be-8c62-e85f6623e067",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Having a fine edge or point; sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670e5af6-4090-4011-afa6-bf18eefb3dd0",
                                                "sense_id": "aaf43816-ba60-38be-8c62-e85f6623e067",
                                                "text": "The tongues of mocking wenches are as keen\n As is the Razors edge, inuisible: […]"
                                            },
                                            {
                                                "example_id": "d292546e-2002-45b1-9967-5356a6c53ceb",
                                                "sense_id": "aaf43816-ba60-38be-8c62-e85f6623e067",
                                                "text": "Come thick Night, / And pall thee in the dunneſt ſmoake of Hell, / That my keene Knife ſee not the Wound it makes, / Nor Heauen peepe through the Blanket of the darke, / To cry, hold, hold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc1253d-57c3-3744-925b-fbfcee1bbd45",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Acute of mind, having or expressing mental acuteness; penetrating, sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c1a43e9-dfe9-4f94-9da3-3ef74cae9f79",
                                                "sense_id": "3dc1253d-57c3-3744-925b-fbfcee1bbd45",
                                                "text": "For when we rage, aduiſe is often ſeene\n By blunting vs to make our wits more keene."
                                            },
                                            {
                                                "example_id": "32ae0ded-9f71-42c9-842c-0d7beb8bd684",
                                                "sense_id": "3dc1253d-57c3-3744-925b-fbfcee1bbd45",
                                                "text": "So, when remote futurity is brought / Before the keen inquiry of her thought, / A terrible sagacity informs / The poet's heart; […]"
                                            },
                                            {
                                                "example_id": "d461f7a7-660d-41e2-8ef6-1debd60e93d0",
                                                "sense_id": "3dc1253d-57c3-3744-925b-fbfcee1bbd45",
                                                "text": "These books will fill, and well fill, certain stretches of life […] But in old or nervous or solemnest or dying hours, when one needs the impalpably soothing and vitalizing influences of abysmic Nature, or its affinities in literature or human society, and the soul resents the keenest mere intellection, they will not be sought for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "509b80a2-60a4-37d7-97bf-6b7c3959f8bf",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Acrimonious, bitter, piercing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad9a765a-936a-460f-9d57-7c74e5c7e07b",
                                                "sense_id": "509b80a2-60a4-37d7-97bf-6b7c3959f8bf",
                                                "text": "keen satire or sarcasm"
                                            },
                                            {
                                                "example_id": "8da9079d-cc99-494e-aa9b-4299654c9f14",
                                                "sense_id": "509b80a2-60a4-37d7-97bf-6b7c3959f8bf",
                                                "text": "O lawfull let it be / That I have roome with Rome to curſe a while, / Good Father Cardinall, cry thou Amen / To my keene curſes; for without my wrong / There is no tongue hath power to curſe him right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d52bedc-4bb8-356d-9cd5-4779f38eb694",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Of cold, wind, etc.: cutting, penetrating, piercing, sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "329736df-78cc-4e6a-848b-2221a26985bb",
                                                "sense_id": "7d52bedc-4bb8-356d-9cd5-4779f38eb694",
                                                "text": "a keen wind"
                                            },
                                            {
                                                "example_id": "bdcfcd7b-d950-420a-8658-f1920acbe4e7",
                                                "sense_id": "7d52bedc-4bb8-356d-9cd5-4779f38eb694",
                                                "text": "the cold is very keen"
                                            },
                                            {
                                                "example_id": "2d63fea7-5b30-4968-ad69-0d45a92ccdfa",
                                                "sense_id": "7d52bedc-4bb8-356d-9cd5-4779f38eb694",
                                                "text": "Chearful at morn he wakes from ſhort repoſe, / Breaſts the keen air, and carolls as he goes; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071ea4b9-1354-3414-a06d-bae15abdd075",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Of prices, extremely low as to be competitive."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "415ee157-a520-3e74-b751-3b3f7ee66554",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Marvelous."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c946d2f1-e6ae-4a9e-b92e-20c4bbd6b8df",
                                                "sense_id": "415ee157-a520-3e74-b751-3b3f7ee66554",
                                                "text": "I just got this peachy keen new dress."
                                            },
                                            {
                                                "example_id": "fedf3034-b6e4-487b-8913-240dfe71d5c6",
                                                "sense_id": "415ee157-a520-3e74-b751-3b3f7ee66554",
                                                "text": "Oh, but they're weird and they're wonderful / Oh, Bennie, she's really keen / She's got electric boots, a mohair suit / You know I read it in a magazine, oh / B-B-B-Bennie and the Jets"
                                            },
                                            {
                                                "example_id": "fa9a74e2-de69-452a-bd7a-6bbd0f124013",
                                                "sense_id": "415ee157-a520-3e74-b751-3b3f7ee66554",
                                                "text": "Well our hosts here attacked us with a fantastic Dismodulating Anti Phase stun ray and then invited us to this amazingly keen meal by way of making it up to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14056ce6-7b86-3389-92c2-20c6a9d96f91",
                                        "entry_id": "faaa8485-3df1-33f3-8d8f-2dc92dbd0222",
                                        "glosses": [
                                            "Brave, courageous; audacious, bold."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "keen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "421b03d7-e0f3-30c6-806e-6abb59a554f7",
                                        "entry_id": "185e3b18-7c6c-36ea-b478-fc2b690a7d05",
                                        "glosses": [
                                            "To make cold, to sharpen."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9871f50-560f-4408-bcf5-346b00806c8d",
                                                "sense_id": "421b03d7-e0f3-30c6-806e-6abb59a554f7",
                                                "text": "This is the pureſt exerciſe of health, / The kind refreſher of the ſummer-heats; / Nor, when cold Winter keens the brightening flood, / Would I weak-ſhivering linger on the brink."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "keen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dc6093b-3cdf-3e61-959c-576611c24d28",
                                        "entry_id": "d2e6b69e-c27e-3cd2-a54e-ce2fc1636612",
                                        "glosses": [
                                            "A prolonged wail for a deceased person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f893e8a-bf44-48d5-a76f-5c0b00ba1bcf",
                                                "sense_id": "2dc6093b-3cdf-3e61-959c-576611c24d28",
                                                "text": "[S]he went so swiftly that he could only follow her to the door. The large shape of the car swallowed her up; and the car twisted softly around the little drive and away to the London road. Minutes later he heard its Klaxon, just one sharp keen, like the harsh cry of a sea-bird."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "keen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "602de2f9-9ba2-3663-a7fc-1f5c7778d343",
                                        "entry_id": "c8d01e3a-07af-33aa-bb96-9fae944d71ed",
                                        "glosses": [
                                            "To utter a keen."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeadc2b7-4e63-4337-b881-85a2bc4de33a",
                                                "sense_id": "602de2f9-9ba2-3663-a7fc-1f5c7778d343",
                                                "text": "Last night he had put down too much Potheen / (A vulgar blend of Methyl and Benzene) / That, at some Wake, he might the better keen. / (Keen—meaning 'brisk'? Nay, here the Language warps: / 'Tis singing bawdy Ballads to a Corpse.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e00a21-4229-38fa-9850-2fc8735f66f1",
                                        "entry_id": "c8d01e3a-07af-33aa-bb96-9fae944d71ed",
                                        "glosses": [
                                            "To utter with a loud wailing voice or wordless cry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce5b55c3-5924-45a7-aee5-50b832ac9bee",
                                                "sense_id": "f0e00a21-4229-38fa-9850-2fc8735f66f1",
                                                "text": "Pelicans fly below us with stiffly formal strokes, and gulls wheel and keen."
                                            },
                                            {
                                                "example_id": "8fb01144-4a17-47d2-9d2b-b5cab78c4b38",
                                                "sense_id": "f0e00a21-4229-38fa-9850-2fc8735f66f1",
                                                "text": "Satiran, lost in his own grief, shuddered once, then lifted his head to the sky and keened out his loss to the heavens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbdf8b3f-317e-3e3a-97b2-4cd1173ac5c4",
                                        "entry_id": "c8d01e3a-07af-33aa-bb96-9fae944d71ed",
                                        "glosses": [
                                            "To mourn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3b105c-f2d7-4384-9e08-c4be2d0d23d4",
                                                "sense_id": "dbdf8b3f-317e-3e3a-97b2-4cd1173ac5c4",
                                                "text": "I keened my Gran, I keened my babies, but then my words poured out of my grief. I don't have the full heart like that for Owen, sorry as I am for his goin. Without the heavy grief on me I can maybe think of the words easier."
                                            },
                                            {
                                                "example_id": "21fb2736-395c-4a0e-9071-34acc8e40914",
                                                "sense_id": "dbdf8b3f-317e-3e3a-97b2-4cd1173ac5c4",
                                                "text": "She sniffed and nodded and cried and wailed and keened for her husband, who would never come back to her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
