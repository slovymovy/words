                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d853f3b-4c14-3013-88e5-333cc699ffb5",
                        "entry_id": "943bf3cb-288a-3ff1-863c-c85f00a16980",
                        "glosses": [
                            "To needlessly destroy or deface other people’s property or public property; to commit vandalism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90512909-7b72-4887-8e93-fa8bd1b6bdc6",
                                "sense_id": "8d853f3b-4c14-3013-88e5-333cc699ffb5",
                                "text": "But... No. Luján broke his violin. That part definitely happened; he remembers it with distressing clarity. His relationship with Luján has never been much more than tepidly professional, but the man was a professional. To vandalise a precious instrument like that would be unthinkable for him, or anybody in the orchestra. There is something wrong."
                            },
                            {
                                "example_id": "b32badbc-aff4-4c88-90b1-a020f13a520b",
                                "sense_id": "8d853f3b-4c14-3013-88e5-333cc699ffb5",
                                "text": "Unfortunately, one side of the new five-car train is daubed in graffiti, having been vandalised in Wembley Yard, en route from Switzerland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b2cd8d2-5d9b-4b4c-893a-739dfef646dd",
                        "source_entry_id": "943bf3cb-288a-3ff1-863c-c85f00a16980",
                        "source_sense_id": "8d853f3b-4c14-3013-88e5-333cc699ffb5",
                        "source_sense_description": "to needlessly destroy",
                        "target_lang_word": "vandaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76832624-03e0-361e-82e5-3f7c55748404",
                                        "entry_id": "5373a970-e506-3e4b-a88b-5c11c110ad5e",
                                        "glosses": [
                                            "Commettre un acte de vandalisme, détériorer avec le souci évident de nuire."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7649a480-22dc-4ebe-b6ec-1f654ebfda36",
                                                "sense_id": "76832624-03e0-361e-82e5-3f7c55748404",
                                                "text": "Des militants du mouvement écologiste Just Stop Oil ont vandalisé un tableau de Velazquez, à Londres, le 6 novembre 2023."
                                            },
                                            {
                                                "example_id": "cd74b23e-47cc-490d-aa5a-d3d24c4eda11",
                                                "sense_id": "76832624-03e0-361e-82e5-3f7c55748404",
                                                "text": "Lors d’une visite dans un sanctuaire religieux du village arabe de Kifl Haris, des Israéliens orthodoxes ont été filmés en train de vandaliser des biens, en criant « Mort aux Arabes » et « Que votre village brûle », sous la protection de l’armée israélienne, a rapporté vendredi le journal Haaretz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e56be811-ddfd-4ead-9fef-a77bdf9a343e",
                        "source_entry_id": "943bf3cb-288a-3ff1-863c-c85f00a16980",
                        "source_sense_id": "8d853f3b-4c14-3013-88e5-333cc699ffb5",
                        "source_sense_description": "to needlessly destroy",
                        "target_lang_word": "vandalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                        "entry_id": "dabe8cb4-0872-3fa5-9547-b47d7fbdaed7",
                                        "glosses": [
                                            "absichtlich verwüsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf1f456-f322-4592-b20c-92c33f022574",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Wenn der Safe leergeräumt ist und wir gut in der Zeit liegen, können wir noch ein wenig vandalisieren, es heißt ja nicht umsonst ›Erst die Arbeit, dann das Vergnügen‹“"
                                            },
                                            {
                                                "example_id": "a45e3fe4-efe5-4682-8762-2dcc911e8b6e",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Viele seiner Busfahrer müssen zusehen, wie aufgeputschte Jugendliche ihren Bus vandalisieren, und werden beim Versuch, für Ordnung zu sorgen, bespuckt und angepöbelt.“"
                                            },
                                            {
                                                "example_id": "84ac6e3d-a9fa-4585-b4ec-d00a09715574",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Er erhält Morddrohungen und sein Büro wird vandalisiert.“"
                                            },
                                            {
                                                "example_id": "e30abafc-719c-4621-beec-dc277c02363f",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Während der französischen Revolution und der dritten Republik wurde der Palast als Abladeplatz von Leichen nach Massakern, als Gefängnis, Baracke und Pferdestall benutzt und natürlich vandalisiert.“"
                                            },
                                            {
                                                "example_id": "61080061-53d1-4f3a-93de-73252f8eb564",
                                                "sense_id": "9493cb24-41ac-308f-bf92-152113a8e43f",
                                                "text": "„Als hätte ein Unbekannter jedes einzelne Zimmer in bösartiger, niederträchtiger Absicht vandalisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
