                                            {
                                                "example_id": "31a1aa0d-c7f4-49ee-aa27-86e3af3240a4",
                                                "sense_id": "53097967-06c8-32bb-998a-084522e15b5a",
                                                "text": "The creator of the viral “Trump Gaza” AI-generated video depicting the Gaza Strip as a Dubai-style paradise has said it was intended as a political satire of Trump’s “megalomaniac idea”."
                                            }
                                        ]
                                    }
                                ]
