{
    "word_family": [
        "dissent",
        "dissenter",
        "dissentient",
        "dissentious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "232efd08-8bfd-3648-b8e1-6ffda4bc2472",
                    "sense_definition": "Strong disagreement, conflict, or contention within a group; discord.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee's refusal to compromise caused bitter <w>dissension</w> among its members.",
                            "target_lang_translations": {
                                "nl": "De weigering van de commissie om een compromis te sluiten veroorzaakte bittere <w>tweedracht</w> onder de leden."
                            }
                        },
                        {
                            "text": "Leaders feared that internal <w>dissension</w> would tear the political party apart before the election.",
                            "target_lang_translations": {
                                "nl": "Leiders vreesden dat interne <w>verdeeldheid</w> de politieke partij vóór de verkiezingen zou verscheuren."
                            }
                        }
                    ],
                    "synonyms": [
                        "discord",
                        "strife",
                        "friction",
                        "contention"
                    ],
                    "antonyms": [
                        "harmony",
                        "agreement",
                        "concord"
                    ],
                    "common_phrases": [
                        "cause dissension",
                        "internal dissension",
                        "sow dissension"
                    ],
                    "target_lang_definitions": {
                        "nl": "Sterke onenigheid, conflict of tweedracht binnen een groep."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tweedracht",
                                "target_lang_sense_clarification": "verdeeldheid of ruzie binnen een groep"
                            },
                            {
                                "target_lang_word": "onenigheid",
                                "target_lang_sense_clarification": "het niet met elkaar eens zijn"
                            },
                            {
                                "target_lang_word": "verdeeldheid",
                                "target_lang_sense_clarification": "het ontbreken van eensgezindheid"
                            },
                            {
                                "target_lang_word": "wrijving",
                                "target_lang_sense_clarification": "conflict of spanningen tussen mensen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c89c9f47-0d16-3758-ab73-af8e023ba685",
                    "sense_definition": "An expression or declaration of disagreement, especially an overt or vocal dispute.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Frequent verbal <w>dissensions</w> during board meetings prevented any real progress from being made.",
                            "target_lang_translations": {
                                "nl": "Frequente verbale <w>geschillen</w> tijdens bestuursvergaderingen verhinderden dat er echte vooruitgang werd geboekt."
                            }
                        },
                        {
                            "text": "He tolerated open debate, but public <w>dissension</w> against his final decisions was strictly forbidden.",
                            "target_lang_translations": {
                                "nl": "Hij tolereerde een open debat, maar publieke <w>tegenstem</w> tegen zijn uiteindelijke beslissingen was strikt verboden."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissent",
                        "objection"
                    ],
                    "antonyms": [
                        "assent",
                        "consent"
                    ],
                    "common_phrases": [
                        "voice dissension"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een uiting of verklaring van meningsverschil, met name een openlijk of luidruchtig geschil."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geschil",
                                "target_lang_sense_clarification": "openlijk conflict of dispuut"
                            },
                            {
                                "target_lang_word": "tegenstem",
                                "target_lang_sense_clarification": "geuite afwijkende mening"
                            },
                            {
                                "target_lang_word": "dissidentie",
                                "target_lang_sense_clarification": "openlijke afwijzing van heersende opvattingen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
