                                "target_senses": [
                                    {
                                        "sense_id": "4c4543f7-61fa-3f7f-847b-09c8d942e39f",
                                        "entry_id": "4aa10950-03c9-3cbe-ae18-c660fcd0a046",
                                        "glosses": [
                                            "Qui est capable de recevoir certaines qualités, certaines impressions, certaines modifications."
                                        ],
                                        "tags": [],
                                        "note": "Se dit tant au sens physique qu’au sens moral",
                                        "examples": [
                                            {
                                                "example_id": "35ab01dc-9c1d-48a0-9078-fda7028661b4",
                                                "sense_id": "4c4543f7-61fa-3f7f-847b-09c8d942e39f",
                                                "text": "Un moulin à vent se compose essentiellement d’un arbre porté sur un petit bâtiment en bois, qui est susceptible de tourner autour d’un fort pivot vertical, et qui peut par conséquent être orienté convenablement."
                                            },
                                            {
                                                "example_id": "32444263-89b4-4bbf-b670-10de8f417d59",
                                                "sense_id": "4c4543f7-61fa-3f7f-847b-09c8d942e39f",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique."
                                            },
                                            {
                                                "example_id": "e8796c7d-bde1-4967-9b2c-09496fed78a4",
                                                "sense_id": "4c4543f7-61fa-3f7f-847b-09c8d942e39f",
                                                "text": "Un tel milieu est susceptible de protoner tout substrat organique et de favoriser des réactions improbables en chimie classique."
                                            },
                                            {
                                                "example_id": "1802ce92-54d0-4191-b086-8007533f9834",
                                                "sense_id": "4c4543f7-61fa-3f7f-847b-09c8d942e39f",
                                                "text": "Or l’objet susceptible de projeter cette ombre au contour anguleux, n’est autre que le verre à pied peint en blanc, qui n’en finit pas d’exhiber ses rondeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1bdf32c-a5a7-3c73-bc5b-de714fb31c06",
                                        "entry_id": "4aa10950-03c9-3cbe-ae18-c660fcd0a046",
                                        "glosses": [
                                            "Qui est facile à blesser, à froisser, qui s’offense aisément, en parlant de personnes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be34a706-9c84-4db4-9901-b8dcf1ef0ca4",
                                                "sense_id": "a1bdf32c-a5a7-3c73-bc5b-de714fb31c06",
                                                "text": "Avant 1789, les gentilshommes verriers ne sortaient jamais sans leur épée, c’était toujours cette arme à la main qu’en présence de deux témoins se vidaient les querelles et différends qui souvent s’élevaient entre ces hommes, susceptibles et chatouilleux."
                                            },
                                            {
                                                "example_id": "67e9a449-aed5-4a4e-abdc-cb2306d27538",
                                                "sense_id": "a1bdf32c-a5a7-3c73-bc5b-de714fb31c06",
                                                "text": "Invité à commenter le débat entourant la censure de La petite vie, Steven Guilbeault y est allé de cette déclaration surprenante : « Notre droit s’arrête là où la blessure de quelqu’un d’autre commence ». (...) Cette affirmation est grave et je suis obligé de lui poser quelques questions pour l’inviter à clarifier sa réflexion. Sans quoi nous devrons constater qu’il vient de se soumettre à la « tyrannie des susceptibles »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b166a6b5-b305-355b-92bd-2eda820ade83",
                                        "entry_id": "4aa10950-03c9-3cbe-ae18-c660fcd0a046",
                                        "glosses": [
                                            "Se dit d’un cheval de trot qui, par tempérament ou par humeur, court le risque de se montrer fautif en se mettant au galop."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "182384a3-fafb-4a4b-9470-f1cdedf9ab72",
                        "source_entry_id": "69a14e00-e8d6-3ee4-bbf7-d292dfcd9ccb",
                        "source_sense_description": "Easily offended",
                        "target_lang_word": "empfindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empfindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "körperlich leicht auf äußere Einflüsse reagierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b9d949-ec74-4f1d-a99c-5986127a662a",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "Er ist gegen hohe Temperaturen sehr empfindlich."
                                            },
                                            {
                                                "example_id": "01b4bbb9-6f9c-493b-be6e-891ce8232679",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Als Blonde reagiere ich sehr empfindlich auf die Sonne. Ich muß mich immer gut mit Sonnencreme einschmieren.“"
                                            },
                                            {
                                                "example_id": "53a2378e-3cd9-4a04-8151-f9661e8fe09c",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            },
                                            {
                                                "example_id": "a898190d-5850-443f-bdd4-214d038c1586",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Dubslav, sonst empfindlich gegen Zug, hatte die Thüren aufmachen lassen, und von dem großen Portal her zog ein erquicklicher Luftstrom bis auf die mit weiß und schwarzen Fliesen gedeckte Veranda hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "leicht, schnell beleidigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1744fa-1663-43d2-b817-bfafaae9faff",
                                                "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                                "text": "Man muss bei ihm sehr aufpassen, was man sagt: Er ist sehr empfindlich."
                                            },
                                            {
                                                "example_id": "5d3a2674-88f0-4e34-9fae-285a5e93c3b8",
                                                "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                                "text": "„Ihr Tod war genauso wenig ein Unfall, wie mein Hintern ein Unfall ist, sagte ich zu Svanhvít und hoffte, dass sie nicht empfindlich war, eine klitzekleine Portion grober Wortwahl zu ertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e558d2f8-ea41-35ac-9223-d3e7ca88d976",
