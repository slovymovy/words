                    {
                        "sense_id": "9cb873e2-2d15-3e47-8297-ea7473e11475",
                        "entry_id": "890e782f-083a-3824-b563-c3a1c2aa94da",
                        "glosses": [
                            "A hydrophobic compound or material."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2fe83cb2-5cb5-38a0-ac87-6b889969aefc",
                        "entry_id": "890e782f-083a-3824-b563-c3a1c2aa94da",
                        "glosses": [
                            "Someone who is affected by hydrophobia (a fear or aversion to water)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdcb1fe7-a21f-41aa-9fcd-baaa217ba803",
                                "sense_id": "2fe83cb2-5cb5-38a0-ac87-6b889969aefc",
                                "text": "The shock of the meeting triremes was tremendous, and in a moment the poor little hydrophobes were spluttering in the pond: […]"
                            },
                            {
                                "example_id": "218d521c-0eb7-4db4-9bc5-ca003d4f054e",
                                "sense_id": "2fe83cb2-5cb5-38a0-ac87-6b889969aefc",
                                "text": "If I talk to 10 people, there is usually a fellow hydrophobe among them. It is hard to pick them out, because a person who is afraid of water looks very much like a normal person. But, from talking with fellow hydrophobes, I have discovered something we almost all share: more times than not, our fear of water stems from one intensely bad experience that came during our childhoods."
                            }
                        ]
                    }
                ],
