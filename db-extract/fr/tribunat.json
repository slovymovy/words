            {
                "entry_id": "7036c5b5-6858-3902-8621-a920535385ca",
                "word": "tribunat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77edf8b6-5cd7-4fb3-b8da-a922c3cf83cc",
                        "entry_id": "7036c5b5-6858-3902-8621-a920535385ca",
                        "tags": [
                            "plural"
                        ],
