                    {
                        "translation_id": "2418a8af-1559-4f63-b931-d94baac1afbe",
                        "source_entry_id": "fa08a990-673e-3dfc-b33e-44a17a336147",
                        "source_sense_id": "cc2bdb95-8f6a-39e6-85f6-34793f73d445",
