                        "glosses": [
                            "Opération faisant perdre la couleur verte, dans la fabrication des tissus pastel, pour leur faire prendre un ton bleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "033d5143-14e7-40ff-bf70-35dbfe97e59d",
                                "sense_id": "c4a8d86b-3c48-34e8-a926-9c902d18cad1",
                                "text": "Restée jaune clair dans le bain, elle vire au vert dès qu’on la sort. Égouttée, étalée, elle passe progressivement au bleu. C'est pourquoi cette exposition à l’air est appelée déverdissage."
                            }
                        ]
                    },
                    {
                        "sense_id": "fde933de-d87a-3f7c-ad1d-45f97f9f266a",
                        "entry_id": "74c75f8d-dd81-3703-b00d-bc788260e9f5",
                        "glosses": [
                            "Traitement du vin, pour faire baisser son acidité."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "329c0e25-7dc4-4d84-b374-5faa4b613fd2",
                                "sense_id": "fde933de-d87a-3f7c-ad1d-45f97f9f266a",
                                "text": "Elle paraissait même au début devoir être tout-à-fait excessive, et c’est pourquoi ceux qui ont été obligés de vendanger de bonne heure ont dû avoir recours au déverdissage, accordé par la circulaire ministérielle du 5 octobre 1922."
                            }
                        ]
                    },
