                        "sense_id": "118f417f-e5a0-3ae5-9f6b-ab56a8375d79",
                        "entry_id": "ea7930a5-ef3c-3f05-a191-22653eaac782",
                        "glosses": [
                            "Planche reliée à un canot à moteur par des cordes grâce à laquelle on glisse sur l’eau ; sport pratiqué avec cette planche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f34b984-951d-4f6f-8ca6-cab35bf00abc",
                                "sense_id": "118f417f-e5a0-3ae5-9f6b-ab56a8375d79",
                                "text": "Or c’est à ce moment précis qu’il distingua parmi les fortes vagues un garçon blond vêtu d’un collant de caoutchouc noir qui s’efforçait de se tenir en équilibre sur un aquaplane et, du sommet des crêtes d’écume, envoyait la main à la jeune femme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26449aa4-76d8-4a73-aaa0-0419d69aca9a",
                        "source_entry_id": "ea7930a5-ef3c-3f05-a191-22653eaac782",
                        "source_sense_id": "118f417f-e5a0-3ae5-9f6b-ab56a8375d79",
                        "target_lang_word": "aquaplane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquaplane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52332310-a906-33f8-b72c-9a5551c33b8a",
                                        "entry_id": "7d124a8c-886f-3b25-8567-abd665abb140",
                                        "glosses": [
                                            "A board on which a person stands to ride for leisure which is pulled on a water surface by a motorboat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14291e4e-1414-4cf6-ba56-5e30fc41a283",
                                                "sense_id": "52332310-a906-33f8-b72c-9a5551c33b8a",
                                                "text": "At high tide in the afternoon I watched his guests diving from the tower of his raft, or taking the sun on the hot sand of his beach while his two motor-boats slit the waters of the Sound, drawing aquaplanes over cataracts of foam."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aquaplane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf44869d-ac2c-3d0b-92df-f1dde5b66f74",
                                        "entry_id": "a645afd9-6a0b-39f6-bc5d-c910bc725263",
                                        "glosses": [
                                            "To ride for leisure standing up on a board pulled on a water surface by a motorboat."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88466dfd-e0f4-48c0-a4c0-133f4aecfca9",
                                                "sense_id": "cf44869d-ac2c-3d0b-92df-f1dde5b66f74",
                                                "text": "She waved her arm—a significant and imperative signal—but she realised, almost as she did it, that there was scant chance of any one aquaplaning at thirty or forty kilometres an hour looking to the right or to the left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391759b7-14b0-3201-878b-57762894a1a4",
                                        "entry_id": "a645afd9-6a0b-39f6-bc5d-c910bc725263",
                                        "glosses": [
                                            "Of a car or other road vehicle: to lose traction with the road due to the vehicle's tyres sliding on a film of water on the road."
                                        ],
                                        "tags": [
                                            "British",
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032785e6-a961-4005-b5fe-55cbb605ec88",
                                                "sense_id": "391759b7-14b0-3201-878b-57762894a1a4",
                                                "text": "So much water. They were held up by it, the tyres skating over a film of rain. Aquaplaning. Flying his sister’s fancy car through the wet air. Touching nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
