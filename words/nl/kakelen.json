    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50513372-bb02-3bcc-94ab-b4fadd2f1f3a",
                    "sense_definition": "het maken van het kenmerkende geluid van een kip of gans",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "dierengeluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kippen in de ren beginnen luid te <w>kakelen</w> zodra ze de boer zien.",
                            "target_lang_translations": {
                                "en": "The chickens in the run start to <w>cackle</w> loudly as soon as they see the farmer.",
                                "ru": "Куры в загоне начинают громко <w>кудахтать</w>, как только видят фермера."
                            }
                        },
                        {
                            "text": "Toen hij de kippen kwam voeren, <w>kakelden</w> zij opgewonden en pikten hongerig naar het voer.",
                            "target_lang_translations": {
                                "en": "When he came to feed the chickens, they <w>clucked</w> excitedly and pecked hungrily at the feed.",
                                "ru": "Когда он пришел покормить кур, они возбужденно <w>закудахтали</w> и стали жадно клевать корм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "luid kakelen",
                        "kakelen als een kip"
                    ],
                    "target_lang_definitions": {
                        "en": "to make the characteristic sound of a chicken or goose",
                        "ru": "издавать характерный звук, свойственный курице или гусю"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cackle",
                                "target_lang_sense_clarification": "the sharp, broken cry of a hen or goose"
                            },
                            {
                                "target_lang_word": "cluck",
                                "target_lang_sense_clarification": "the short, low sound made by a hen"
                            },
                            {
                                "target_lang_word": "gabble",
                                "target_lang_sense_clarification": "the rapid, noisy sound of geese"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кудахтать",
                                "target_lang_sense_clarification": "о звуках курицы"
                            },
                            {
                                "target_lang_word": "гоготать",
                                "target_lang_sense_clarification": "о звуках гуся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fe6882b-3414-38cb-bb2c-55ba75a164bd",
                    "sense_definition": "op een luidruchtige, drukke of zinloze manier praten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hele middag zaten de buren luidruchtig te <w>kakelen</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "The neighbors were <w>chattering</w> noisily in the garden all afternoon.",
                                "ru": "Весь день соседи шумно <w>болтали</w> в саду."
                            }
                        },
                        {
                            "text": "En dat mens <w>kakelde</w> de hele avond over van alles en niets.",
                            "target_lang_translations": {
                                "en": "And that person <w>cackled</w> on all evening about everything and nothing.",
                                "ru": "И эта особа весь вечер <w>трещала</w> обо всем и ни о чем."
                            }
                        }
                    ],
                    "synonyms": [
                        "snateren",
                        "kwebbelen",
                        "leuteren",
                        "zwetsen"
                    ],
                    "antonyms": [
                        "zwijgen"
                    ],
                    "common_phrases": [
                        "aan één stuk door kakelen",
                        "luidruchtig kakelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt voor druk gepraat"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to talk in a loud, busy, or senseless manner",
                        "ru": "говорить шумно, суетливо или бессмысленно"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cackle",
                                "target_lang_sense_clarification": "to talk or chatter in a loud, shrill way"
                            },
                            {
                                "target_lang_word": "chatter",
                                "target_lang_sense_clarification": "to talk quickly and continuously about unimportant things"
                            },
                            {
                                "target_lang_word": "prattle",
                                "target_lang_sense_clarification": "to talk at length in a foolish or inconsequential way"
                            },
                            {
                                "target_lang_word": "gabble",
                                "target_lang_sense_clarification": "to talk rapidly and unintelligibly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "пустословить, много говорить"
                            },
                            {
                                "target_lang_word": "трещать",
                                "target_lang_sense_clarification": "говорить быстро и без умолку"
                            },
                            {
                                "target_lang_word": "тараторить",
                                "target_lang_sense_clarification": "говорить очень быстро и громко"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f7ab818-ae6c-3928-b027-5ccf40ff429f",
                    "sense_definition": "lachen met een kort, onderbroken geluid dat lijkt op dat van een kip",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude vrouw begon gemeen te <w>kakelen</w> na haar gemene grap.",
                            "target_lang_translations": {
                                "en": "The old woman began to <w>cackle</w> meanly after her mean joke.",
                                "ru": "Старуха злобно <w>захохотала</w> после своей подлой шутки."
                            }
                        },
                        {
                            "text": "Ze hoorden de heks in het sprookje luid <w>kakelen</w> in haar huisje.",
                            "target_lang_translations": {
                                "en": "They heard the witch in the fairy tale <w>cackling</w> loudly in her cottage.",
                                "ru": "Они слышали, как ведьма в сказке громко <w>гогочет</w> в своей избушке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gemeen kakelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to laugh with a short, broken sound resembling that of a chicken",
                        "ru": "смеяться коротким, прерывистым звуком, напоминающим куриное кудахтанье"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cackle",
                                "target_lang_sense_clarification": "to laugh with a shrill, broken sound"
                            },
                            {
                                "target_lang_word": "chuckle",
                                "target_lang_sense_clarification": "to laugh quietly or inwardly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хохотать",
                                "target_lang_sense_clarification": "громко и резко смеяться"
                            },
                            {
                                "target_lang_word": "гоготать",
                                "target_lang_sense_clarification": "грубо или громко смеяться"
                            }
                        ]
                    }
                }
