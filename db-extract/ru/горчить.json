                "senses": [
                    {
                        "sense_id": "3b347606-c5e5-334a-820d-ef1e9b4e7701",
                        "entry_id": "7f6c8e83-c8e2-3125-b4ba-d7ee6ce8b855",
                        "glosses": [
                            "разг., тж. безл. отдавать горечью, иметь горьковатый привкус или вкус"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b13ca7-ab90-4c11-ab35-0abd976ac4a9",
                                "sense_id": "3b347606-c5e5-334a-820d-ef1e9b4e7701",
                                "text": "То масло горчит, то в крупе гадки много, то говядина не жирна."
                            },
                            {
                                "example_id": "ca19585b-767d-4583-a12c-572686e13613",
                                "sense_id": "3b347606-c5e5-334a-820d-ef1e9b4e7701",
                                "text": "Где-то в груди горчило, будто она наглоталась дыму, а отчего, Настёна не знала."
                            }
                        ]
                    }
