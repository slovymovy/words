                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bdd45aa-b6ef-40ef-8af7-c3e8628283f6",
                                "sense_id": "d8a054e9-a015-38f6-9f76-34c29dd97925",
                                "text": "„Und dabei schämte ich mich gleichzeitig vor den Frauen, die von mir als Vorleser was erwarteten.“"
                            },
                            {
                                "example_id": "ac1e24e9-bd68-42f2-ad5e-898ec92a568f",
                                "sense_id": "d8a054e9-a015-38f6-9f76-34c29dd97925",
                                "text": "„Und in Karl Kraus als Vorleser ist Canetti diesem Phänomen auch begegnet; vielleicht hat ihm der Cousin dafür die Augen geöffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
