                "senses": [
                    {
                        "sense_id": "c2633ebd-bb09-33a9-9352-391485439f37",
                        "entry_id": "740f766c-8580-3796-ad25-28d1ea9c8d9b",
                        "glosses": [
                            "weibliche Person, die mehrere ähnliche Straftaten in einer Serie begeht oder begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738269c4-605c-4444-9ef5-01bd772ccdb1",
                                "sense_id": "c2633ebd-bb09-33a9-9352-391485439f37",
                                "text": "„Sieben Wochen nach dem Mord an einer Polizistin in Heilbronn hat die Auswertung von DNA-Spuren die Ermittler auf die Spur einer mutmaßlichen Serientäterin gebracht.“"
                            },
                            {
                                "example_id": "5aa70ad3-f8d2-4fe3-89eb-33c8bd3d3aff",
                                "sense_id": "c2633ebd-bb09-33a9-9352-391485439f37",
                                "text": "„Die wegen des Heilbronner Polizistenmords gesuchte Serientäterin gibt es möglicherweise gar nicht.“"
                            },
                            {
                                "example_id": "376f262d-08ac-4143-a0e3-8d7cd7aba8de",
                                "sense_id": "c2633ebd-bb09-33a9-9352-391485439f37",
                                "text": "„Beinahe mit Sicherheit war er Weißer: weiß, da Serientäter gewöhnlich innerhalb ihrer eigenen Volksgruppe morden und alle Opfer weiß waren; männlich, da Serientäterinnen in unserem Zeitalter praktisch unbekannt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
