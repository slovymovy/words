                        "form": "amatonormativités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "412219f6-09f5-3081-963a-dffaebca1305",
                        "entry_id": "11b135ba-ea06-361a-9680-b59feceea648",
                        "glosses": [
                            "Pensée dans laquelle la relation d’amour romantique est considérée comme la norme."
                        ],
                        "tags": [
                            "LGBTQ",
                            "Société"
                        ],
                        "examples": [
                            {
                                "example_id": "b2bb9bad-8edc-4ff3-aefa-462724d0dacc",
                                "sense_id": "412219f6-09f5-3081-963a-dffaebca1305",
                                "text": "L’amatonormativité est globalement cette supposition générale que les relations romantiques sont universelles chez les humains. On nous apprend dès tout petit que le prince doit trouver sa princesse, et qu’ensemble ils vivront heureux et auront beaucoup d’enfants."
                            },
                            {
                                "example_id": "92803473-8e3b-4c4f-a305-8f89b8bfbb19",
                                "sense_id": "412219f6-09f5-3081-963a-dffaebca1305",
                                "text": "L’amatonormativité se définit le plus souvent comme l’ensemble des discours et pratiques qui priorisent les relations de couple (accompagnées de relations sexuelles) au détriment d’autres types de relations (amitiés, polyA sous toutes ses formes)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f52d5edf-69da-47fd-8746-38f3d26d067c",
                        "source_entry_id": "11b135ba-ea06-361a-9680-b59feceea648",
                        "source_sense_id": "412219f6-09f5-3081-963a-dffaebca1305",
                        "target_lang_word": "amatonormativity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amatonormativity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee00dc8d-1d6a-33de-b44c-c6b50f1765f3",
                                        "entry_id": "c289e330-ccc4-3df5-8fc7-f27a09d16d07",
                                        "glosses": [
                                            "The assumption that all human beings pursue love or romance, especially by means of a monogamous long-term relationship."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf8f218-f98d-43d7-b6c0-31d7453bd79c",
                                                "sense_id": "ee00dc8d-1d6a-33de-b44c-c6b50f1765f3",
                                                "text": "Amatonormativity is oppressive when it privileges members of one form of caring relationship at the expense of noncomformists, whose opportunities are thereby significantly worsened."
                                            },
                                            {
                                                "example_id": "1625d7e8-d7d2-4e6e-86ec-bc9ad9935bd0",
                                                "sense_id": "ee00dc8d-1d6a-33de-b44c-c6b50f1765f3",
                                                "text": "Casual amatonormativity is routine even in scholarly research."
                                            },
                                            {
                                                "example_id": "44a7b01c-9780-4cd2-b2f5-8348057e9ec1",
                                                "sense_id": "ee00dc8d-1d6a-33de-b44c-c6b50f1765f3",
                                                "text": "\"I dislike [Valentine's Day] because I'm aromantic and it's very symbolic of the culture of amatonormativity,\" thesis student Aiden Juge commented."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
