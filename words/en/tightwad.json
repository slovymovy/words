{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b6889a6-b362-3a11-bea9-d40ac4753be3",
                    "sense_definition": "A person who is excessively reluctant to spend money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stingy_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That <w>tightwad</w> would drive ten miles just to save a few cents on gas.",
                            "target_lang_translations": {
                                "ru": "Этот <w>скряга</w> готов проехать десять миль лишь ради того, чтобы сэкономить пару центов на бензине."
                            }
                        },
                        {
                            "text": "He always leaves a generous tip so that nobody considers him a <w>tightwad</w>.",
                            "target_lang_translations": {
                                "ru": "Он всегда оставляет щедрые чаевые, чтобы никто не счёл его <w>жмотом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "miser",
                        "skinflint"
                    ],
                    "antonyms": [
                        "spendthrift"
                    ],
                    "common_phrases": [
                        "such a tightwad",
                        "notorious tightwad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal derogatory usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который крайне неохотно тратит деньги; скряга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скряга",
                                "target_lang_sense_clarification": "жадный человек"
                            },
                            {
                                "target_lang_word": "жадина",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "жмот",
                                "target_lang_sense_clarification": "просторечное"
                            },
                            {
                                "target_lang_word": "скупердяй",
                                "target_lang_sense_clarification": "чрезмерно экономный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4a9e4570-2dda-3940-a256-a1da51c792ee",
                    "sense_definition": "A small village located in the state of Missouri, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The road trip took us right through <w>Tightwad</w> on our way to the lake.",
                            "target_lang_translations": {
                                "ru": "По пути к озеру наш маршрут пролегал прямо через <w>Тайтвад</w>."
                            }
                        },
                        {
                            "text": "Many tourists stop in <w>Tightwad</w> simply to take a picture of the humorous town sign.",
                            "target_lang_translations": {
                                "ru": "Многие туристы останавливаются в <w>Тайтваде</w> просто для того, чтобы сфотографировать забавный дорожный знак с названием городка."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая деревня в штате Миссури, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тайтвад",
                                "target_lang_sense_clarification": "название населённого пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
