                        "examples": [
                            {
                                "example_id": "4249a900-9fab-4945-8e05-693c25c7e2aa",
                                "sense_id": "1d70ce31-dcf5-33b6-8012-25dc526ac375",
                                "text": "„Dabei ist Reisen als Freizeitbeschäftigung noch gar nicht so alt: Erholungs- und Vergnügungsreisen gibt es erst seit dem 19. Jahrhundert.“"
                            },
                            {
                                "example_id": "dd986411-5f52-4d50-9ba6-81aacdca884b",
                                "sense_id": "1d70ce31-dcf5-33b6-8012-25dc526ac375",
                                "text": "„Hoffmanns Gesundheitszustand ist schlecht, sein Organismus so angegriffen, daß er die Notwendigkeit fühlt, eine Erholungsreise in die Schlesischen Berge zu machen.“"
                            }
                        ],
