                "forms": [],
                "senses": [
                    {
                        "sense_id": "95c3eafa-8af6-33fe-a94f-d7fbe935a809",
                        "entry_id": "ce271d9a-6b23-3000-ae70-6366b9b9db22",
                        "glosses": [
                            "A prefecture-level city, the provincial capital of Zhejiang, in eastern China; a former imperial capital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac849be8-abf8-4a66-9b63-fe64348ac2c0",
                                "sense_id": "95c3eafa-8af6-33fe-a94f-d7fbe935a809",
                                "text": "In the Province of Chekiang, near the chief City of Hangcheu, runs a River, which in regard of its courſe, is called ſometimes Che, at other times Cientang, and in ſome places Cingan."
                            },
                            {
                                "example_id": "7d473911-70ae-4c22-8088-1251a7e8d6e6",
                                "sense_id": "95c3eafa-8af6-33fe-a94f-d7fbe935a809",
                                "text": "Tibetan colors and gilding are frequently mentioned in Chinese texts, and several monuments survive northwest of Beijing and in Hangzhou in southeast China that were designed by Tibetan monks and were very likely built and carved by both Tibetan and Chinese artists."
                            },
                            {
                                "example_id": "f9f04ecf-eef5-41cd-b152-fb156f79a9d4",
                                "sense_id": "95c3eafa-8af6-33fe-a94f-d7fbe935a809",
                                "text": "A former imperial capital famed for its West Lake and surrounding temples, Hangzhou has lately grown famous as the hometown of internet commerce giant Alibaba."
                            },
                            {
                                "example_id": "e2933896-a78e-41f6-a803-562429f28d0b",
                                "sense_id": "95c3eafa-8af6-33fe-a94f-d7fbe935a809",
                                "text": "China’s outbreaks and the ensuing restrictions have led to a number of events being canceled or postponed, most recently the Asian Games originally scheduled for September in the city of Hangzhou, 177 kilometers (110 miles) west of Shanghai."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d232275-979a-321a-8923-642717fac55e",
                        "entry_id": "ce271d9a-6b23-3000-ae70-6366b9b9db22",
                        "glosses": [
                            "The adjacent bay of the East China Sea, separating Shanghai from Ningbo."
                        ],
