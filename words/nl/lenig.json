{
    "word_family": [
        "lenigheid",
        "lenigen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5f83b10-c853-39f0-a415-d3e904db34ee",
                    "sense_definition": "gemakkelijk en soepel kunnen bewegen met het lichaam",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_gesteldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>lenige</w> gymnast maakte een perfecte salto tijdens de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The <w>flexible</w> gymnast performed a perfect somersault during the competition."
                            }
                        },
                        {
                            "text": "Je moet erg <w>lenig</w> zijn om deze moeilijke yoga-oefening goed uit te voeren.",
                            "target_lang_translations": {
                                "en": "You have to be very <w>supple</w> to perform this difficult yoga exercise correctly."
                            }
                        }
                    ],
                    "synonyms": [
                        "soepel",
                        "flexibel"
                    ],
                    "antonyms": [
                        "stijf",
                        "stram"
                    ],
                    "common_phrases": [
                        "lenig lichaam",
                        "erg lenig"
                    ],
                    "target_lang_definitions": {
                        "en": "being able to move the body easily and smoothly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flexible",
                                "target_lang_sense_clarification": "referring to the ability to bend limbs easily"
                            },
                            {
                                "target_lang_word": "supple",
                                "target_lang_sense_clarification": "moving or bending with ease and grace"
                            },
                            {
                                "target_lang_word": "limber",
                                "target_lang_sense_clarification": "referring to muscles or people that are warmed up and flexible"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d712e5a5-92b5-3d68-89ac-471253d7a291",
                    "sense_definition": "op een soepele en behendige manier bewegend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_gesteldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat sprong <w>lenig</w> op de hoge schutting om de vogel te vangen.",
                            "target_lang_translations": {
                                "en": "The cat jumped <w>nimbly</w> onto the high fence to catch the bird."
                            }
                        },
                        {
                            "text": "Hij klom <w>lenig</w> over het hekje en rende daarna snel het bos in.",
                            "target_lang_translations": {
                                "en": "He climbed <w>agilely</w> over the gate and then ran quickly into the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "soepel",
                        "flexibel"
                    ],
                    "antonyms": [
                        "onhandig",
                        "stijf"
                    ],
                    "common_phrases": [
                        "lenig klimmen",
                        "lenig bewegen"
                    ],
                    "target_lang_definitions": {
                        "en": "moving in a smooth and nimble manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nimbly",
                                "target_lang_sense_clarification": "moving quickly and lightly"
                            },
                            {
                                "target_lang_word": "agilely",
                                "target_lang_sense_clarification": "moving with coordination and ease"
                            },
                            {
                                "target_lang_word": "supplely",
                                "target_lang_sense_clarification": "moving in a smooth, flexible way"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6165f7ca-d412-3f48-96a7-7014e6e52378",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>lenigen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>lenig</w> de pijn van de slachtoffers door hen medicijnen te geven.",
                            "target_lang_translations": {
                                "en": "I <w>alleviate</w> the pain of the victims by giving them medicine."
                            }
                        },
                        {
                            "text": "Met deze maatregelen <w>lenig</w> ik de ergste nood in de getroffen regio.",
                            "target_lang_translations": {
                                "en": "With these measures, I <w>relieve</w> the worst distress in the affected region."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'lenigen' (to alleviate or soothe)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alleviate",
                                "target_lang_sense_clarification": "to make suffering or a problem less severe"
                            },
                            {
                                "target_lang_word": "soothe",
                                "target_lang_sense_clarification": "to gently calm or reduce pain"
                            },
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to cause pain or difficulty to become less severe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03a42ccc-5dc8-3f72-8d36-fcd821dade0e",
                    "sense_definition": "de gebiedende wijs van <w>lenigen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Lenig</w> de nood van de armen door een gulle donatie te doen.",
                            "target_lang_translations": {
                                "en": "<w>Alleviate</w> the plight of the poor by making a generous donation."
                            }
                        },
                        {
                            "text": "<w>Lenig</w> de pijn onmiddellijk met dit nieuwe koelende verband.",
                            "target_lang_translations": {
                                "en": "<w>Soothe</w> the pain immediately with this new cooling bandage."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative form of 'lenigen' (to alleviate or soothe)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alleviate",
                                "target_lang_sense_clarification": "command to make something less severe"
                            },
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "command to lessen pain or distress"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}