                        "entry_id": "c6e96e4a-8b9a-33d9-801f-bd2fa47a54aa",
                        "glosses": [
                            "Lehre von der wirtschaftlichen Herstellung von Werkstücken mit einer geometrisch bestimmbaren Form"
                        ],
                        "tags": [
                            "Produktionstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "dcfe82b0-57a1-4228-b2f0-8161bfb507fd",
                                "sense_id": "516c56d5-48d7-34d0-9f7a-504c5fde61c4",
                                "text": "„Allerdings ist es den Holländern gelungen, die Fertigungstechnik solcher Chips stark zu vereinfachen.“"
                            },
                            {
                                "example_id": "595d6a01-37a7-4870-9ce9-3adfa5c31132",
                                "sense_id": "516c56d5-48d7-34d0-9f7a-504c5fde61c4",
                                "text": "„Der Rückkauf erfolgt über einen Zeitraum von höchstens zwei Jahren, wie das in der Klima- und Fertigungstechnik tätige Unternehmen am Donnerstag mitteilt.“"
                            }
