                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother sat in the rocking chair <w>nursing</w> her baby to sleep.",
                            "target_lang_translations": {
                                "ru": "Мать сидела в кресле-качалке, <w>убаюкивая</w> ребенка грудью."
