                        ],
                        "form": "die Götzenbilder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                        "entry_id": "a2ab3504-90c0-3bab-9933-5e1c116fcda6",
                        "glosses": [
                            "Bild eines Götzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e54089e-3dd3-43b6-9d15-1c41baa286fa",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Zwischen den knorrigen Bäumen im Vorgarten seines alten, vernachlässigten Anwesens bewahrt er eine sonderbare Sammlung großer Steine auf, seltsam angeordnet und bemalt, sodass sie den Götzenbildern in obskuren asiatischen Tempeln gleichen.“"
                            },
                            {
                                "example_id": "6b8016ee-3a62-41f0-9282-de600a27a168",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Denn wo tagsüber Mauern aufragten, eröffneten sich nun ständig neue Ausblicke auf Bäume und Wege, Blumen und Sträucher, steinerne Götzenbilder und Pagoden.“"
                            },
                            {
                                "example_id": "75687f20-d814-4d79-a4b5-fa13da6965ae",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Er berichtete, dass sie auf Händen und Knien im Kreis um ihr Götzenbild herumschleichen und an einem derart widerwärtigen Ritual teilnahmen, dass er nicht wagte, es zu beschreiben.“"
                            },
                            {
                                "example_id": "fe453f35-4673-4a7f-84ed-0aef1781f646",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Solange das Götzenbild an Bord des Flugzeugs war, konnte jeden Augenblick etwas Schreckliches geschehen.“"
                            },
                            {
                                "example_id": "ca6f9b13-8931-4787-ab6b-777f390750ca",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Wie Pilger wanderten wir zu jenem Feld, durchstöberten die Überreste der Ernte nach verdächtigen Zeichen und versammelten uns um die Vogelscheuche, als wäre sie ein mächtiges Götzenbild in schäbiger Verkleidung, ein heiliger, zur falschen Jahreszeit erschienener Avatar.“"
                            },
                            {
                                "example_id": "b33f528c-42ac-411c-ab40-59a7ae373de0",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Ein Blick auf die Seitenzahlen zeigte mir, dass die dazwischen liegende Seite fehlte, sodass ich keinen weiteren Hinweis auf jenes fremdartige Götzenbild auf dem Hügel erhielt.“"
                            },
                            {
                                "example_id": "12996388-a027-4641-b067-2c25aed42313",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Das Götzenbild vom Träumenden, Tsathoggua, stand nicht mehr auf seinem Steinsockel.“"
                            },
                            {
                                "example_id": "b907c359-1ab6-473d-b969-8125fc2987f8",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Für dich ist Miguel ein Abtrünniger, der das Grün, die Farbe des Propheten, verraten hat für ihre Hymnen und hölzernen Götzenbilder.“"
                            },
                            {
                                "example_id": "f52ee971-b969-4114-ba17-dc0de29ef22d",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Dieses düstere Götzenbild verkörperte mit seiner umfassenden, abgrundtiefen Bestialität die Seele dieser dämonischen Stadt.“"
                            },
                            {
                                "example_id": "689ed5c0-0673-44ec-9350-a60fc8b90476",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Dort finden sich Steine, die wie Bruchstücke urzeitlicher Basreliefs aussehen oder an winzige prähistorische Götzenbilder und Figurinen erinnern; andere wiederum scheinen Inschriften zu tragen, Buchstaben einer längst vergessenen, nicht mehr entzifferbaren Schrift.“"
                            },
                            {
                                "example_id": "4fb134b7-a5b0-43f1-a3ea-bcbb2becbb7e",
                                "sense_id": "4e6e0ae4-dcea-315d-819d-50a39725544f",
                                "text": "„Sie ging zum Schulgelände und wunderte sich nicht, dort das Götzenbild vorzufinden, das die Leute gemacht hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
