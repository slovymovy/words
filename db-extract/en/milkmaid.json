                    {
                        "translation_id": "49112cb5-1bde-4b47-a7cd-0c17f0d56c5e",
                        "source_entry_id": "26e667bb-30fd-3b82-9d2f-73e9edbea8fd",
                        "source_sense_id": "53745f79-b21f-37eb-812f-290e580aa8b5",
                        "source_sense_description": "a young woman who milks the cows on a farm",
                        "target_lang_word": "melkmeisje",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melkmeisje",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "74c01f71-09c2-3630-8706-f66be41ed6bf",
                                        "entry_id": "692cc34f-0a46-392e-b73c-3f82a349a553",
                                        "glosses": [
                                            "meisje dat melk van de boer aan huis verkoopt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "531d95e6-46c8-4b89-822c-d82463da35c9",
                                                "sense_id": "74c01f71-09c2-3630-8706-f66be41ed6bf",
                                                "text": "Met een interne verhuizing in het Rijksmuseum begint de inrichting van de grootste Vermeer-tentoonstelling ooit. Het Melkmeisje en de drie andere Vermeers uit de Eregalerij zijn naar de Philipsvleugel gebracht."
                                            },
                                            {
                                                "example_id": "a03a8a19-cbb7-4086-9d3a-aa17a45d983d",
                                                "sense_id": "74c01f71-09c2-3630-8706-f66be41ed6bf",
                                                "text": "Kandidaten die bij de Wat Weet U van…vraag even geen idéé hebben en dan in het wildeweg wat gaan roepen, het zijn altijd bijzondere momenten. Begrijpelijk ook. Raden kan wat opleveren. Bij Ranomi Kromowidjojo helaas niet. Wat de oud-zwemkampioene wist van Het Melkmeisje? ‘Zeeland, zeep, is dat boter? Nederlands? Oer-Hollands? Reclame? Televisieserie? Een film?’ Was het de druk? De spotlights? Of wist zij -nota bene in het jaar van Vermeer- het écht niet? In dat laatste geval toch even een bezoekje brengen aan het Rijksmuseum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c498435-0dff-4f6f-9117-9181eb229a1b",
                        "source_entry_id": "26e667bb-30fd-3b82-9d2f-73e9edbea8fd",
                        "source_sense_id": "53745f79-b21f-37eb-812f-290e580aa8b5",
                        "source_sense_description": "a young woman who milks the cows on a farm",
                        "target_lang_word": "laitière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laitière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab4c840c-33d0-3e93-857f-9c7c1eaec164",
                                        "entry_id": "d80bf359-3e01-302c-a108-3dd4fda25a84",
                                        "glosses": [
                                            "Celle dont le métier est de vendre du lait, de la crème, et autres produits dérivés du lait."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d02b919c-d5ef-4ee2-bb91-e2a210ab2f95",
                                                "sense_id": "ab4c840c-33d0-3e93-857f-9c7c1eaec164",
                                                "text": "A qui en veut-il ? A quelque laitière ou quelque chevrière dont il a fait rencontre dans la montagne ?"
                                            },
                                            {
                                                "example_id": "236e53d8-644b-423d-b286-7bf7de40d3b5",
                                                "sense_id": "ab4c840c-33d0-3e93-857f-9c7c1eaec164",
                                                "text": "Un soir que le berger revenait des champs, la laitière ne l’accueillit pas comme d’ordinaire, en lui disant: « Salut et bonne chance! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9433e9f9-d3a9-34ea-b797-e6cc971c754e",
                                        "entry_id": "d80bf359-3e01-302c-a108-3dd4fda25a84",
                                        "glosses": [
                                            "Vache qui donne beaucoup de lait."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "986d6e9e-710f-4dd6-a4d0-b540b3e7cd9b",
                                                "sense_id": "9433e9f9-d3a9-34ea-b797-e6cc971c754e",
                                                "text": "À chaque occasion de communiquer, les membres de la Coopérative de l’eau 79, maître d’ouvrage des bassines, montrent veaux aux yeux tendres, rieuses biquettes et placides laitières."
                                            },
                                            {
                                                "example_id": "2ddab141-68cc-416b-bd2f-5329257fe454",
                                                "sense_id": "9433e9f9-d3a9-34ea-b797-e6cc971c754e",
                                                "text": "C’est une bonne laitière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c8f76d-c94b-3a34-b33e-72767dd48695",
                                        "entry_id": "d80bf359-3e01-302c-a108-3dd4fda25a84",
                                        "glosses": [
                                            "Récipient servant à conserver le lait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8406160b-c8a0-44bf-acf6-e16e6b5f0de9",
                                                "sense_id": "14c8f76d-c94b-3a34-b33e-72767dd48695",
                                                "text": "Ces bidons ressemblaient à la laitière dans laquelle nous allions chercher le lait à la fin de la journée. C’était comme des laitières de géants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87134395-c083-3d88-830f-c73a083902a1",
                                        "entry_id": "d80bf359-3e01-302c-a108-3dd4fda25a84",
                                        "glosses": [
                                            "Nourrice qui allaite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd74c5b8-af59-46ff-8c9b-ad0578ef546b",
                                                "sense_id": "87134395-c083-3d88-830f-c73a083902a1",
                                                "text": "À ce coup, c’est les laitières ! Elles réceptionnent, faut croire !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laitière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a58d711-c5b0-3464-a983-9dfe0c2e7f4a",
                                        "entry_id": "2a3a9b3e-7208-3ecd-8aa7-a04392746586",
                                        "glosses": [
