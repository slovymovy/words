                                "sense_id": "d8a2686a-a9ff-3126-96d6-340c08eba119",
                                "text": "De straatlichten gingen aan bij avondschemering.",
                                "translation": "The street lights came on at dusk.",
                                "english": "The street lights came on at dusk."
                            },
                            {
                                "example_id": "c52036d4-ee7b-4bc5-a178-fa0149a90dfb",
                                "sense_id": "d8a2686a-a9ff-3126-96d6-340c08eba119",
                                "text": "In de avondschemering lijkt de stad te kalmeren.",
                                "translation": "In the evening twilight, the city seems to calm down.",
                                "english": "In the evening twilight, the city seems to calm down."
                            },
                            {
                                "example_id": "c3fc965f-7b32-4282-acb6-e07e36db4ea9",
                                "sense_id": "d8a2686a-a9ff-3126-96d6-340c08eba119",
                                "text": "Veel dieren worden actief tijdens de avondschemering.",
                                "translation": "Many animals become active during the dusk.",
                                "english": "Many animals become active during the dusk."
                            }
                        ]
