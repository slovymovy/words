                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f03aa698-08b0-4a5b-9f8d-2fd22cfe6973",
                                                "sense_id": "9025b017-1adb-390e-9afd-7611aa38ac9a",
