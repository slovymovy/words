{
    "word_family": [
        "doctor",
        "document",
        "documentary",
        "doctorate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ed3ac6a-27d7-3e6c-b387-ec4ddb858018",
                    "sense_definition": "Informal short form of <w>document</w>, especially a digital file.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you send me the <w>doc</w> via email?",
                            "target_lang_translations": {
                                "ru": "Можешь прислать мне этот <w>документ</w> по электронной почте?",
                                "zh": "你能通过电子邮件把这份<w>文档</w>发给我吗？"
                            }
                        },
                        {
                            "text": "I saved the text <w>doc</w> on my desktop.",
                            "target_lang_translations": {
                                "ru": "Я сохранил текстовый <w>документ</w> на рабочем столе.",
                                "zh": "我把那个文本<w>文档</w>保存在了桌面上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "document"
                    ],
                    "common_phrases": [
                        "Word doc",
                        "Google Doc",
                        "text doc",
                        "attached doc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное сокращение от слова \"документ\", особенно цифровой файл.",
                        "zh": "“Document”的非正式缩写，尤指数字文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "документ",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "док",
                                "target_lang_sense_clarification": "компьютерный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文档",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "文件",
                                "target_lang_sense_clarification": "指代电子文档"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7357fe5-3345-364d-946c-370cbf5423d3",
                    "sense_definition": "Informal short form of <w>doctor</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_doctor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to go to the <w>doc</w> about my cough.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сходить к <w>врачу</w> по поводу кашля.",
                                "zh": "我得因为咳嗽去看<w>医生</w>。"
                            }
                        },
                        {
                            "text": "The <w>doc</w> said I should be fine in a few days.",
                            "target_lang_translations": {
                                "ru": "<w>Доктор</w> сказал, что я поправлюсь через несколько дней.",
                                "zh": "<w>医生</w>说我过几天就会好的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "see the doc",
                        "check with the doc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное сокращение от слова \"доктор\".",
                        "zh": "“Doctor”的非正式缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врач",
                                "target_lang_sense_clarification": "медицинский специалист"
                            },
                            {
                                "target_lang_word": "доктор",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医生",
                                "target_lang_sense_clarification": "医疗专业人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f488d16-2913-342b-bde5-02e2757c04b2",
                    "sense_definition": "Informal short form of <w>documentary</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_documentary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a <w>doc</w> about lions in Africa.",
                            "target_lang_translations": {
                                "ru": "Мы посмотрели <w>документалку</w> про львов в Африке.",
                                "zh": "我们看了一部关于非洲狮子的<w>纪录片</w>。"
                            }
                        },
                        {
                            "text": "He is filming a crime <w>doc</w> for television.",
                            "target_lang_translations": {
                                "ru": "Он снимает криминальную <w>документалку</w> для телевидения.",
                                "zh": "他正在为电视台拍摄一部犯罪题材的<w>纪录片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "docu"
                    ],
                    "common_phrases": [
                        "nature doc",
                        "crime doc",
                        "TV doc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное сокращение от \"документальный фильм\".",
                        "zh": "“Documentary”的非正式缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "документалка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "документальный фильм",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪录片",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8745071-33ef-3247-8ed9-4cd1674077a6",
                    "sense_definition": "A Dr. Martens shoe or boot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_boots",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a pair of black <w>Docs</w> to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела пару черных <w>мартинсов</w> на вечеринку.",
                                "zh": "她穿着一双黑色的<w>马汀靴</w>去参加了派对。"
                            }
                        },
                        {
                            "text": "My old <w>Docs</w> are finally worn out.",
                            "target_lang_translations": {
                                "ru": "Мои старые <w>мартинсы</w> окончательно износились.",
                                "zh": "我那双旧<w>马汀靴</w>终于穿坏了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of Docs",
                        "wear Docs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ботинки бренда Dr. Martens.",
                        "zh": "马汀博士（Dr. Martens）品牌的鞋或靴子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мартинсы",
                                "target_lang_sense_clarification": "разговорное название обуви"
                            },
                            {
                                "target_lang_word": "доки",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马汀靴",
                                "target_lang_sense_clarification": "品牌鞋履的常用称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9e8311bd-213d-3624-8d73-e7a998ee26eb",
                    "sense_definition": "A nickname or form of address for a doctor or a learned person.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_doctor",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "Thanks for fixing my leg, <w>Doc</w>.",
                            "target_lang_translations": {
                                "ru": "Спасибо, что подлечили ногу, <w>Док</w>.",
                                "zh": "谢谢你治好了我的腿，<w>医生</w>。"
                            }
                        },
                        {
                            "text": "Hey <w>Doc</w>, what do you think about this?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>Док</w>, что ты об этом думаешь?",
                                "zh": "嘿，<w>医生</w>，你觉得这个怎么样？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "What's up Doc",
                        "Hey Doc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище или форма обращения к врачу или ученому.",
                        "zh": "对医生或学者的昵称或称呼方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Док",
                                "target_lang_sense_clarification": "дружеское обращение"
                            },
                            {
                                "target_lang_word": "доктор",
                                "target_lang_sense_clarification": "формальное обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医生",
                                "target_lang_sense_clarification": "口语称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1592087-0580-3cb8-a803-00cf970914de",
                    "sense_definition": "Initialism of Department of Commerce.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_org",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>DOC</w> published a new report on trade.",
                            "target_lang_translations": {
                                "ru": "<w>Министерство торговли</w> опубликовало новый отчет о торговле.",
                                "zh": "<w>商务部</w>发布了一份关于贸易的新报告。"
                            }
                        },
                        {
                            "text": "She has worked at the <w>DOC</w> for ten years.",
                            "target_lang_translations": {
                                "ru": "Она проработала в <w>Министерстве торговли</w> десять лет.",
                                "zh": "她在<w>商务部</w>工作了十年。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура Министерства торговли США.",
                        "zh": "美国商务部（Department of Commerce）的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Министерство торговли",
                                "target_lang_sense_clarification": "государственный орган"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "商务部",
                                "target_lang_sense_clarification": "政府机构"
                            }
                        ]
                    }
                }
            ]
        }
    ]
