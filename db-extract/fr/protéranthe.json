                        "target_lang_word": "proteranthous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proteranthous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ea7e6c-81e2-3e61-989a-1fdcbde4a016",
                                        "entry_id": "9bb5c0ba-0902-34c8-8848-cdfdfa71cfbd",
                                        "glosses": [
                                            "Of a plant: having flowers that appear earlier than the leaves."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecbb52a0-89f2-4dcd-8744-ff5b62eefb7c",
                                                "sense_id": "04ea7e6c-81e2-3e61-989a-1fdcbde4a016",
                                                "text": "Proteranthous (-us). Where flowering precedes leafing."
                                            },
                                            {
                                                "example_id": "7690259c-4bf4-4e4d-bf29-933a862e82b6",
                                                "sense_id": "04ea7e6c-81e2-3e61-989a-1fdcbde4a016",
                                                "text": "The prevernal period begins with the first blooming after the period of rest, and lasts until the foliation of the proteranthous trees, altogether hardly more than two weeks."
                                            },
                                            {
                                                "example_id": "ff95c171-3e8f-485b-896e-6e2d14f00470",
                                                "sense_id": "04ea7e6c-81e2-3e61-989a-1fdcbde4a016",
                                                "text": "The heteranthous inflorescence is a development from the proteranthous condition in which the growth of the pseudobulb and leaves is deferred until after the flowering […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f2e45f-2a22-3362-af75-65dca09d8b45",
                                        "entry_id": "9bb5c0ba-0902-34c8-8848-cdfdfa71cfbd",
                                        "glosses": [
                                            "Of a plant: having leaves that appear earlier than the flowers."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e0392c-ab15-4a8a-9df5-ddd9fe561424",
                                                "sense_id": "99f2e45f-2a22-3362-af75-65dca09d8b45",
                                                "text": "Proteranthous; when leaves appear before the flowers."
                                            },
                                            {
                                                "example_id": "1378b302-8973-4c21-9b4a-c8fa0a834233",
                                                "sense_id": "99f2e45f-2a22-3362-af75-65dca09d8b45",
                                                "text": "In hysteranthous plants, the photosynthesis rate is very low from flower emergence until anthesis. […] In contrast, in proteranthous growth the foliage dies down before the flower is produced and photosynthesis takes place before flowering[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
