                "senses": [
                    {
                        "sense_id": "8ffd494d-7b6a-3c6a-84d9-1c6d1792d963",
                        "entry_id": "622165b7-72bc-3c0b-81da-5fbf46e97f46",
                        "glosses": [
                            "Ausrichtung eines Zahns nach rückwärts/hinten (distal)"
                        ],
                        "tags": [
                            "Kieferorthopädie",
                            "Zahnheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "1031f5f1-b66e-458d-b96c-13c839113ad5",
                                "sense_id": "8ffd494d-7b6a-3c6a-84d9-1c6d1792d963",
                                "text": "„Bei der Distalisierung werden die Backenzähne nach hinten geschoben, um Platz für die übrigen Zähne im Kiefer zu schaffen. Mit solchen Apparaturen kann man ein Ziehen von Zähnen zur Platzgewinnung vermeiden.“"
                            },
                            {
                                "example_id": "563cb2fa-388b-4e83-ba7a-3030cbadc84a",
                                "sense_id": "8ffd494d-7b6a-3c6a-84d9-1c6d1792d963",
                                "text": "„Unter den zahlreichen festsitzenden Zahnspangen zur Distalisierung der 1. Molaren ist die Pendelapparatur am Besten untersucht und eine der effektivsten derartigen Apparaturen, die alle ein Headgear ersetzen sollen.“"
                            },
                            {
                                "example_id": "770bf819-90a4-4307-9e96-013b732b5b94",
                                "sense_id": "8ffd494d-7b6a-3c6a-84d9-1c6d1792d963",
                                "text": "„Bei umfangreichen Distalisierungen muss häufig frühzeitig der Weisheitszahn entfernt werden, da sonst der 2. Molar zu weit nach bukkal durchbricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
