{
    "word_family": [
        "stapler",
        "stapling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed118cd2-b890-3b8c-82d2-55d564a9ced6",
                    "sense_definition": "A small piece of thin wire pushed through sheets of paper and bent over the ends to hold them together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fastener_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a <w>staple</w> to attach this photograph to the application form.",
                            "target_lang_translations": {
                                "ru": "Мне нужна <w>скоба</w>, чтобы прикрепить эту фотографию к анкете.",
                                "zh": "我需要一个<w>订书钉</w>把这张照片固定在申请表上。"
                            }
                        },
                        {
                            "text": "Please remove the <w>staple</w> before you put the document in the shredder.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, удалите <w>скобу</w>, прежде чем класть документ в шредер.",
                                "zh": "在把文件放进碎纸机之前，请先取下<w>订书钉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fastener"
                    ],
                    "common_phrases": [
                        "remove a staple",
                        "staple remover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кусочек тонкой проволоки, который проталкивают через листы бумаги и загибают на концах для их скрепления.",
                        "zh": "一种用于将纸张固定在一起的小型金属丝，两端弯曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоба",
                                "target_lang_sense_clarification": "для степлера"
                            },
                            {
                                "target_lang_word": "скобка",
                                "target_lang_sense_clarification": "канцелярская"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "订书钉",
                                "target_lang_sense_clarification": "办公用品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d908ad2e-6c13-37fb-b6b1-1459a273cf1f",
                    "sense_definition": "A U-shaped metal fastener with pointed ends, driven into a surface to hold a wire or hook in place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fastener_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a heavy <w>staple</w> to fix the fencing wire to the wooden post.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал тяжелую <w>скобу</w>, чтобы прикрепить проволоку ограждения к деревянному столбу.",
                                "zh": "农夫用一个沉重的<w>U型钉</w>把围栏铁丝固定在木柱上。"
                            }
                        },
                        {
                            "text": "Make sure the <w>staple</w> is hammered in tight so the cable does not come loose.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>скоба</w> забита плотно, чтобы кабель не разболтался.",
                                "zh": "确保<w>U型钉</w>钉紧了，这样电缆才不会松动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "construction or fencing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "U-образный металлический крепеж с заостренными концами, вбиваемый в поверхность для фиксации провода или крюка.",
                        "zh": "一种U型金属紧固件，两端尖锐，用于固定电线或钩子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоба",
                                "target_lang_sense_clarification": "строительная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "U型钉",
                                "target_lang_sense_clarification": "建筑或围栏用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daffd003-37be-355f-842c-e2fe256fc92a",
                    "sense_definition": "A basic and essential food item or product that is used frequently and in large amounts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "essential_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rice is a <w>staple</w> for billions of people around the world.",
                            "target_lang_translations": {
                                "ru": "Рис — это <w>основной продукт питания</w> для миллиардов людей по всему миру.",
                                "zh": "大米是全球数十亿人的<w>主食</w>。"
                            }
                        },
                        {
                            "text": "Bread, milk, and eggs are considered kitchen <w>staples</w> in many households.",
                            "target_lang_translations": {
                                "ru": "Хлеб, молоко и яйца считаются <w>продуктами первой необходимости</w> во многих семьях.",
                                "zh": "面包、牛奶和鸡蛋在许多家庭中被视为厨房<w>必需品</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "necessity",
                        "essential",
                        "basic"
                    ],
                    "antonyms": [
                        "luxury"
                    ],
                    "common_phrases": [
                        "pantry staple",
                        "kitchen staple",
                        "staple food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовый и необходимый продукт питания или товар, который используется часто и в больших количествах.",
                        "zh": "人们经常大量使用的基本且必需的食品或商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основной продукт",
                                "target_lang_sense_clarification": "питания"
                            },
                            {
                                "target_lang_word": "продукт первой необходимости",
                                "target_lang_sense_clarification": "базовый товар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主食",
                                "target_lang_sense_clarification": "基本食物"
                            },
                            {
                                "target_lang_word": "必需品",
                                "target_lang_sense_clarification": "基本生活用品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a100a67e-d7fe-3e30-be20-9c21cdee28e8",
                    "sense_definition": "A main or important element of something, especially something that occurs regularly or is a standard feature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "essential_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High-speed car chases are a <w>staple</w> of modern action movies.",
                            "target_lang_translations": {
                                "ru": "Скоростные погони — это <w>неотъемлемая часть</w> современных боевиков.",
                                "zh": "高速飞车追逐是现代动作电影的<w>主要部分</w>。"
                            }
                        },
                        {
                            "text": "Jeans have become a fashion <w>staple</w> for people of all ages.",
                            "target_lang_translations": {
                                "ru": "Джинсы стали <w>базовым элементом</w> моды для людей всех возрастов.",
                                "zh": "牛仔裤已成为各年龄段人群的时尚<w>必备品</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feature",
                        "standard"
                    ],
                    "antonyms": [
                        "rarity"
                    ],
                    "common_phrases": [
                        "fashion staple",
                        "staple of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главный или важный элемент чего-либо, особенно того, что происходит регулярно или является стандартной чертой.",
                        "zh": "某事物的主要或重要组成部分，通常指经常出现或标准化的特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неотъемлемая часть",
                                "target_lang_sense_clarification": "элемент"
                            },
                            {
                                "target_lang_word": "основная черта",
                                "target_lang_sense_clarification": "характеристика"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "разговора, сюжета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主要部分",
                                "target_lang_sense_clarification": "核心要素"
                            },
                            {
                                "target_lang_word": "常客",
                                "target_lang_sense_clarification": "常见元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7bd2ca7-e6b3-360b-acf1-d97e58598c1c",
                    "sense_definition": "A fiber of cotton, wool, or flax, categorized by its length and quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "textile_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Egyptian cotton is famous for its long <w>staple</w>, which produces very smooth fabric.",
                            "target_lang_translations": {
                                "ru": "Египетский хлопок славится своим длинным <w>волокном</w>, из которого получается очень гладкая ткань.",
                                "zh": "埃及棉以其长<w>纤维</w>而闻名，这种纤维能织出非常光滑的布料。"
                            }
                        },
                        {
                            "text": "The manufacturer checks the <w>staple</w> of the wool before spinning it into yarn.",
                            "target_lang_translations": {
                                "ru": "Производитель проверяет <w>штапель</w> шерсти перед прядением.",
                                "zh": "制造商在将羊毛纺成纱线之前会检查其<w>纤维</w>质量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fiber"
                    ],
                    "common_phrases": [
                        "long staple",
                        "short staple"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "textiles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Волокно хлопка, шерсти или льна, классифицируемое по длине и качеству.",
                        "zh": "棉花、羊毛或亚麻的纤维，按长度和质量分类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штапель",
                                "target_lang_sense_clarification": "текстиль"
                            },
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "сырье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "纺织原料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00c9f93e-acd3-34b2-811f-7ca82d1bae41",
                    "sense_definition": "A town or place that historically had the exclusive right to purchase or produce certain goods for export.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, Calais served as a <w>staple</w> for the English wool trade.",
                            "target_lang_translations": {
                                "ru": "В средневековье Кале служил <w>складочным местом</w> для английской торговли шерстью.",
                                "zh": "在中世纪，加来是英国羊毛贸易的<w>贸易中心</w>。"
                            }
                        },
                        {
                            "text": "Merchants gathered at the <w>staple</w> to sell their goods under royal authority.",
                            "target_lang_translations": {
                                "ru": "Купцы собирались в <w>торговом центре</w>, чтобы продавать свои товары с королевского разрешения.",
                                "zh": "商人们聚集在<w>贸易中心</w>，在皇室授权下销售他们的商品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "market",
                        "center"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город или место, исторически имевшее исключительное право на покупку или производство определенных товаров для экспорта.",
                        "zh": "历史上拥有特定出口商品独家购买或生产权的城镇或地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складочное место",
                                "target_lang_sense_clarification": "историческое"
                            },
                            {
                                "target_lang_word": "центр торговли",
                                "target_lang_sense_clarification": "рынок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贸易中心",
                                "target_lang_sense_clarification": "历史上的集散地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a3d2c15-063d-329d-af18-2db853f5cc90",
                    "sense_definition": "Forming a basic, large, or important part of something; standard or principal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "essential_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wheat is the <w>staple</w> crop grown in this agricultural region.",
                            "target_lang_translations": {
                                "ru": "Пшеница — это <w>основная</w> культура, выращиваемая в этом сельскохозяйственном регионе.",
                                "zh": "小麦是该农业区种植的<w>主要</w>作物。"
                            }
                        },
                        {
                            "text": "The company relies on its <w>staple</w> products to maintain steady revenue.",
                            "target_lang_translations": {
                                "ru": "Компания полагается на свои <w>базовые</w> продукты для поддержания стабильного дохода.",
                                "zh": "该公司依靠其<w>主要</w>产品来维持稳定的收入。"
                            }
                        }
                    ],
                    "synonyms": [
                        "main",
                        "chief",
                        "principal",
                        "key",
                        "standard"
                    ],
                    "antonyms": [
                        "minor",
                        "secondary"
                    ],
                    "common_phrases": [
                        "staple diet",
                        "staple crop",
                        "staple industry",
                        "staple product"
                    ],
                    "target_lang_definitions": {
                        "ru": "Составляющий основную, большую или важную часть чего-либо; стандартный или главный.",
                        "zh": "构成某事物的基本、主要或重要部分；标准的或主要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "главный"
                            },
                            {
                                "target_lang_word": "базовый",
                                "target_lang_sense_clarification": "стандартный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主要的",
                                "target_lang_sense_clarification": "核心的"
                            },
                            {
                                "target_lang_word": "基本的",
                                "target_lang_sense_clarification": "标准的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14dcbf9c-82a1-358d-8936-fb233330d2fa",
                    "sense_definition": "To fasten or join things together using a staple.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fasten_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>staple</w> the receipt to the invoice so it does not get lost.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>прикрепи</w> чек к счету степлером, чтобы он не потерялся.",
                                "zh": "请把收据<w>装订</w>在发票上，以免丢失。"
                            }
                        },
                        {
                            "text": "She <w>stapled</w> the pages together in the top left corner.",
                            "target_lang_translations": {
                                "ru": "Она <w>скрепила</w> страницы в верхнем левом углу.",
                                "zh": "她把这些页面在左上角<w>装订</w>在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "attach",
                        "secure"
                    ],
                    "antonyms": [
                        "detach"
                    ],
                    "common_phrases": [
                        "staple together",
                        "staple to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скреплять или соединять вещи вместе с помощью скобы (степлера).",
                        "zh": "用订书钉将物品固定或连接在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "степлером"
                            },
                            {
                                "target_lang_word": "сшивать",
                                "target_lang_sense_clarification": "документы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装订",
                                "target_lang_sense_clarification": "用订书机"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "210948e5-aaed-3cfd-b540-7d2b0a1c634c",
                    "sense_definition": "A village and civil parish in Kent, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited a small church in <w>Staple</w> during our trip to Kent.",
                            "target_lang_translations": {
                                "ru": "Мы посетили небольшую церковь в <w>Стейпле</w> во время нашей поездки в Кент.",
                                "zh": "在去肯特郡旅行期间，我们参观了<w>斯泰普尔</w>的一座小教堂。"
                            }
                        },
                        {
                            "text": "The village of <w>Staple</w> is located in the Dover district.",
                            "target_lang_translations": {
                                "ru": "Деревня <w>Стейпл</w> находится в районе Дувр.",
                                "zh": "<w>斯泰普尔</w>村位于多佛区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня и гражданский приход в графстве Кент, Англия.",
                        "zh": "英国肯特郡的一个村庄和民政教区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стейпл",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯泰普尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a331f2cb-cd67-3ddc-91ea-136fa0c15f94",
                    "sense_definition": "A surname of English origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Staples</w> has been working at the firm for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Стейплс</w> работает в фирме уже более двадцати лет.",
                                "zh": "<w>斯泰普尔</w>先生在这家公司工作已经超过二十年了。"
                            }
                        },
                        {
                            "text": "The <w>Staples</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Стейплс</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>斯泰普尔</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского происхождения.",
                        "zh": "源自英语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стейпл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯泰普尔",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
