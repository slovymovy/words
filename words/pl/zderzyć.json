{
    "word_family": [
        "zderzenie",
        "zderzak",
        "zderzeniowy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b071f5d-7f1f-3836-bc1b-01e46165713a",
                    "sense_definition": "spowodować uderzenie jednego obiektu w drugi",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kolizja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca <w>zderzył</w> auto z betonowym słupem podczas parkowania.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>столкнул</w> машину с бетонным столбом во время парковки."
                            }
                        },
                        {
                            "text": "Nieostrożny rowerzysta <w>zderzył</w> się z przechodniem na chodniku.",
                            "target_lang_translations": {
                                "ru": "Неосторожный велосипедист <w>столкнулся</w> с прохожим на тротуаре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zderzyć z przeszkodą"
                    ],
                    "target_lang_definitions": {
                        "ru": "привести к удару одного объекта о другой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкнуть",
                                "target_lang_sense_clarification": "привести к столкновению двух предметов"
                            },
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "разговорный вариант, ударить чем-то во что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aced4f6f-9720-3a67-941a-1ff16c9bcbc7",
                    "sense_definition": "wpaść na siebie w wyniku nagłego kontaktu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kolizja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dwa samochody <w>zderzyły</w> się na skrzyżowaniu z powodu śliskiej nawierzchni.",
                            "target_lang_translations": {
                                "ru": "Два автомобиля <w>столкнулись</w> на перекрестке из-за скользкого покрытия."
                            }
                        },
                        {
                            "text": "Pociągi <w>zderzyły</w> się czołowo w pobliżu stacji kolejowej.",
                            "target_lang_translations": {
                                "ru": "Поезда <w>столкнулись</w> лоб в лоб недалеко от железнодорожной станции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zderzyć się czołowo"
                    ],
                    "target_lang_definitions": {
                        "ru": "натолкнуться друг на друга в результате внезапного контакта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкнуться",
                                "target_lang_sense_clarification": "удариться друг о друга при движении"
                            },
                            {
                                "target_lang_word": "врезаться",
                                "target_lang_sense_clarification": "сильно удариться во что-то при движении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81002646-cf2b-38bc-8adc-46e6245f0acc",
                    "sense_definition": "napotkać trudności lub konfrontację z czymś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "konfrontacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody idealista musiał w końcu <w>zderzyć</w> się z rzeczywistością.",
                            "target_lang_translations": {
                                "ru": "Молодому идеалисту пришлось в конце концов <w>столкнуться</w> с реальностью."
                            }
                        },
                        {
                            "text": "Projekt <w>zderzył</w> się z ogromną krytyką ze strony ekspertów.",
                            "target_lang_translations": {
                                "ru": "Проект <w>столкнулся</w> с огромной критикой со стороны экспертов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zderzyć się z rzeczywistością"
                    ],
                    "target_lang_definitions": {
                        "ru": "столкнуться с трудностями или конфронтацией"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкнуться",
                                "target_lang_sense_clarification": "встретиться с чем-то неприятным или трудным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff55679e-eb87-3288-8a6c-145684179073",
                    "sense_definition": "zestawić dwa pojęcia w celu ukazania kontrastu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "porównanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor postanowił <w>zderzyć</w> poglądy konserwatystów z opiniami liberałów.",
                            "target_lang_translations": {
                                "ru": "Автор решил <w>сопоставить</w> взгляды консерваторов с мнениями либералов."
                            }
                        },
                        {
                            "text": "Warto <w>zderzyć</w> te dwie teorie, aby wyciągnąć obiektywne wnioski.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>сопоставить</w> эти две теории, чтобы сделать объективные выводы."
                            }
                        }
                    ],
                    "synonyms": [
                        "porównywać",
                        "zestawiać"
                    ],
                    "common_phrases": [
                        "zderzyć poglądy"
                    ],
                    "target_lang_definitions": {
                        "ru": "сопоставить два понятия, чтобы показать контраст"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопоставить",
                                "target_lang_sense_clarification": "сравнить для выявления различий"
                            },
                            {
                                "target_lang_word": "противопоставить",
                                "target_lang_sense_clarification": "поставить в оппозицию друг другу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}