                "senses": [
                    {
                        "sense_id": "31fd262c-a0f6-3fc7-9579-ed63dd13148a",
                        "entry_id": "a06bb97d-a38f-3458-b034-e2a0b1ce2324",
                        "glosses": [
                            "kraina historyczna, przedrewolucyjna prowincja francuska położona w środkowej części kraju, w północno-wschodniej części Masywu Centralnego z historyczną stolicą w Limoges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518e952b-9b75-4953-ad61-5575cba9333d",
                                "sense_id": "31fd262c-a0f6-3fc7-9579-ed63dd13148a",
                                "text": "Za panowania Ludwika XV zaczął się ziemniak pojawiać w Anjou i Limousinie"
                            },
                            {
                                "example_id": "1c725724-6642-47e5-834c-00ae4a2747fe",
                                "sense_id": "31fd262c-a0f6-3fc7-9579-ed63dd13148a",
                                "text": "W górach Gesandanu, w dolinach Owernii, Limousinu, więcej niż w dwudziestu wsiach ani jednej żyjącej duszy; wszędzie trupy niepochowane"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e924c858-4acc-330f-89d9-51e5f38db584",
                        "entry_id": "a06bb97d-a38f-3458-b034-e2a0b1ce2324",
                        "glosses": [
                            "dawny region administracyjny we Francji, zniesiony w 2015 roku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
