                        "sense_id": "25a0f965-53ec-3a41-91bf-49a048d79403",
                        "entry_id": "7448cd03-b7ac-3b78-8bb3-a9cbeb922d2d",
                        "glosses": [
                            "beschadiging van het ook door een uitwendige chemische of fysieke factor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50402452-8ef2-45b0-8aa9-d60a788f7130",
                                "sense_id": "25a0f965-53ec-3a41-91bf-49a048d79403",
                                "text": "Net als in eerdere jaren werden de meeste mensen voor brandwonden behandeld (36 procent) en oogletsel (27 procent). Bijna de helft van alle vuurwerkslachtoffers was jonger dan twintig jaar."
                            },
                            {
                                "example_id": "abcd0148-0c1e-4520-8fa5-69d14f17a12c",
                                "sense_id": "25a0f965-53ec-3a41-91bf-49a048d79403",
                                "text": "De politie meldt dat het slachtoffer met oogletsel en verwonding aan zijn hand naar Het Oogziekenhuis Rotterdam is gebracht. Het incident had plaats aan de Havikstraat."
                            },
                            {
                                "example_id": "ff85e736-0d89-4f85-a359-401d1a0fe9b6",
                                "sense_id": "25a0f965-53ec-3a41-91bf-49a048d79403",
                                "text": "Het ging om een helikopter van de politie die opnamen maakte van rellen tijdens een demonstratie van linkse groepen. De veroordeelde man richtte de pen op de heli om te voorkomen dat de politie die opnamen kon maken. De rechter oordeelde dat de man wist dat hij oogletsel aan de inzittenden kon toebrengen en dat het gevaar bestond dat de helikopter zou neerstorten."
                            }
                        ]
                    }
