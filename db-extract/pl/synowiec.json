                "senses": [
                    {
                        "sense_id": "832776d8-afa1-3a08-8c95-b96e3b13ca4d",
                        "entry_id": "6f5d9a47-ccec-3452-aefe-ad3e3565234f",
                        "glosses": [
                            "syn rodzonego brata lub rodzonej siostry"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "60ef9533-b251-4f50-8911-b19f632552f1",
                                "sense_id": "832776d8-afa1-3a08-8c95-b96e3b13ca4d",
                                "text": "A że własnych dzieci nie miał, cały majątek zostawił synowcowi."
                            },
                            {
                                "example_id": "8f21bbdb-6e62-45f8-9d41-bb3bf96555bd",
                                "sense_id": "832776d8-afa1-3a08-8c95-b96e3b13ca4d",
                                "text": "Szabel nam nie zabraknie, szlachta na koń wsiędzie, • Ja z synowcem na czele i? – jakoś to będzie!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
