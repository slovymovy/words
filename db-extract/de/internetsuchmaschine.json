                "senses": [
                    {
                        "sense_id": "148e57cb-2782-3e5e-8b07-8e71d2504961",
                        "entry_id": "7724a295-3556-3325-a2fb-148187dc222d",
                        "glosses": [
                            "Suchmaschine, mit der man im Internet suchen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86f526b-37f3-4d9b-bca6-5f1d43b8aa01",
                                "sense_id": "148e57cb-2782-3e5e-8b07-8e71d2504961",
                                "text": "„Allerdings erscheint ein gewisser Bedeutungsschwund unübersehbar. Gibt man das Kürzel DHV zum Beispiel bei der Internetsuchmaschine Google ein, dann stößt man auf den Deutschen Harmonika Verband, den Deutschen Hanf Verband, den Deutschen Hundesportverband, den Deutschen HebammenVerband, den Deutschen Holstein Verband für die Zucht Holsteiner Kühe – und dann erst auf die Berufsgewerkschaft DHV.“"
                            },
                            {
                                "example_id": "827ec944-7d10-4919-a789-3d266439f156",
                                "sense_id": "148e57cb-2782-3e5e-8b07-8e71d2504961",
                                "text": "„Eines Ihrer jüngsten Projekte ist die „Geschichtenbox“, eine Internetsuchmaschine, die zum Vorlesen einlädt bzw. anleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
