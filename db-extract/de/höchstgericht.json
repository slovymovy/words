                                "example_id": "89843b68-38cf-4776-88e5-e643119b62cc",
                                "sense_id": "715cc32f-f3fe-3b72-942c-e2ddd8379077",
                                "text": "„Ab Mittwoch verhandelt das deutsche Höchstgericht das Pendant zur österreichischen GIS.“"
                            },
                            {
                                "example_id": "f666d516-be98-44b3-9aa3-590d69e9e339",
                                "sense_id": "715cc32f-f3fe-3b72-942c-e2ddd8379077",
                                "text": "„Damals reagierte Peter Zanoni, Eigentümer der Concord Card Casinos und größter privater Poker-Anbieter, gelassen. Hatte er doch zuvor mit dem Gang zum Verfassungsgerichtshof (VfGH) – und der Entscheidung des Höchstgerichts in seinem Sinn – die Ausschreibung von drei Poker-Lizenzen erst erwirkt.“"
                            },
                            {
                                "example_id": "6b5c35e9-f730-473a-ba45-9ef09e4099b1",
                                "sense_id": "715cc32f-f3fe-3b72-942c-e2ddd8379077",
                                "text": "„Amerikas Höchstgericht entschied mit fünf zu vier Stimmen.“"
                            }
