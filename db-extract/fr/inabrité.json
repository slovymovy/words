                                    {
                                        "sense_id": "1647f40d-0386-39b5-b48d-8fb26b53946b",
                                        "entry_id": "aa6e44a4-d3e7-38e4-b08b-a88d774e5924",
                                        "glosses": [
                                            "Without shelter; exposed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eea945f-d6c3-496e-8783-5daafa7e1923",
                                                "sense_id": "1647f40d-0386-39b5-b48d-8fb26b53946b",
                                                "text": "This platform was used by the owning company's trains, but those of the District, and later of the Piccadilly Line, were relegated to the other platform, virtually devoid of covering, and accessible only by an unsheltered path passing behind the buffer stops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add8274a-2166-3b7a-8526-d313084251de",
                                        "entry_id": "aa6e44a4-d3e7-38e4-b08b-a88d774e5924",
                                        "glosses": [
                                            "Without being sheltered against."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8e43a7-8425-4701-95dd-3738bdc05b1e",
                                                "sense_id": "add8274a-2166-3b7a-8526-d313084251de",
                                                "text": "The rain came down upon my head\nUnshelter’d—and the heavy wind\nWas giantlike—so thou, my mind!— […]"
                                            }
                                        ]
                                    }
                                ]
                            }
