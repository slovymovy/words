                "senses": [
                    {
                        "sense_id": "5151a6ca-9eb6-3159-85b0-282693e2e6fb",
                        "entry_id": "71ecee63-fa89-3212-8484-e4aa32bd5288",
                        "glosses": [
                            "isolierter kurzer Abschnitt einer RNA, übriggebliebener Schnipsel oder eigens herausgeschnittenes/gebildetes Kettenteil"
                        ],
                        "tags": [
                            "Molekularbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4e9a7407-8570-4e2e-8291-6d7f73831a71",
                                "sense_id": "5151a6ca-9eb6-3159-85b0-282693e2e6fb",
                                "text": "„Aus diesem Grund ist für die Replikation immer ein Primer-Strang erforderlich, der typischerweise aus einem kurzen RNA-Fragment besteht […].“"
                            },
                            {
                                "example_id": "3a5df51d-0f57-4b27-a485-3f8cbd797030",
                                "sense_id": "5151a6ca-9eb6-3159-85b0-282693e2e6fb",
                                "text": "„Während der Initiation der Transkription werden eine Transkriptionsblase und ein kurzes RNA-Fragment gebildet.“"
                            },
                            {
                                "example_id": "df35dc14-998e-4ccb-9e5b-9d8cde14429f",
                                "sense_id": "5151a6ca-9eb6-3159-85b0-282693e2e6fb",
                                "text": "„Dadurch können Proteine identifiziert werden, die mit der Ziel-RNA interagiert haben und nun durch ein verknüpftes RNA-Fragment radioaktiv markiert sind.“"
                            },
                            {
                                "example_id": "ae73d298-9b3b-4a7a-9eb1-4fdc4fc2cfe6",
                                "sense_id": "5151a6ca-9eb6-3159-85b0-282693e2e6fb",
                                "text": "„Die anfänglich doppelsträngige RNA (aus verschiedenen Quellen) wird durch die Nuklease Dicer in kleine, interferierende RNA-Fragmente (~20–30 Nukleotide) gespalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
