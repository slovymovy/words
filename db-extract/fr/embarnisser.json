                "senses": [
                    {
                        "sense_id": "585b4e84-46c0-3a88-97a4-eea8729f4c32",
                        "entry_id": "b1a7e5c4-723e-3341-ab75-aad82922111a",
                        "glosses": [
                            "Couvrir, souvent en donnant un aspect poisseux ou verni."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "7e253f08-0505-4ec2-9f5c-dffdaaf7d0ab",
                                "sense_id": "585b4e84-46c0-3a88-97a4-eea8729f4c32",
                                "text": "Il a réussi à transformer les fruits en teinture avec sa magie noire pour \"s'embarnisser\" le portrait et faire peur aux petits domos!"
                            },
                            {
                                "example_id": "8733d7fb-e5ce-402d-99ab-955183d5d1ff",
                                "sense_id": "585b4e84-46c0-3a88-97a4-eea8729f4c32",
                                "text": "Non seulement, elle embarnisse les filets et occasionne un long travail de nettoyage mais, surtout, elle fait fuir les poissons et appauvrit les fonds de pêche en réduisant fortement la biodiversité."
                            },
                            {
                                "example_id": "c9407bb3-07db-4283-80ad-5d84aa5b98e2",
                                "sense_id": "585b4e84-46c0-3a88-97a4-eea8729f4c32",
                                "text": "Vous pouvez apercevoir la pince à beignet, mais cela n'est pas indispensable, vous pouvez utiliser deux fourchette pour les embarnisser de sucre"
                            }
                        ]
                    }
                ],
