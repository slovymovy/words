                ],
                "translations": [
                    {
                        "translation_id": "b8fa274f-c267-4c28-a67a-f0ea4e728b00",
                        "source_entry_id": "f0ba76d7-de59-3d34-ba62-ec281f7ead03",
                        "target_lang_word": "lumberman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumberman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0741c5af-1ce7-35a5-a2b4-af1133efa740",
                                        "entry_id": "573cab83-a8e8-3e40-9d62-3603bb379477",
                                        "glosses": [
                                            "A man involved in the production or sale of lumber; a lumberjack or logger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2edf628-56c9-4530-8a56-0eb2a6ac423d",
                                                "sense_id": "0741c5af-1ce7-35a5-a2b4-af1133efa740",
                                                "text": "And the shoes they weren't shoes, but knee-length leather boots, like a dressy version of lumberman's boots or a rougher version of riding boots. He hadn't seen even pictures of such things since the few silent movies run in some of the little art theaters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9afcffa3-75cc-4edb-a324-7970d723a344",
                        "source_entry_id": "f0ba76d7-de59-3d34-ba62-ec281f7ead03",
                        "target_lang_word": "lumber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "Wood sawn into planks or otherwise prepared for sale or use, especially as a building material."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c808d1d-7ea7-49ec-aa27-ae795b5d2b11",
                                                "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                                                "text": "4 December 1883, Chester A. Arthur, Third State of the Union Address\nThe resources of Alaska, especially in fur, mines, and lumber, are considerable in extent and capable of large development, while its geographical situation is one of political and commercial importance.;"
                                            },
                                            {
                                                "example_id": "110c2651-f632-4380-9cdf-2bcfea30a2f8",
                                                "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                                                "text": "Here they live by fishing on the most plentiful coasts in the world; there they fell trees, by the sides of large rivers, for masts and lumber […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "Old furniture or other items that take up room, or are stored away."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34982c6-e24b-4800-8c51-79f70d933b2a",
                                                "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                                                "text": "On the ſecond day of my impriſonment, I was viſited by the duke of L⁠—⁠—, a friend of my lord, who found me ſitting upon a trunk, in a poor little dining-room filled with lumber, and lighted with two bits of tallow-candle, which had been left over night."
                                            },
                                            {
                                                "example_id": "eeb66978-759d-4a18-a993-06070aa5a87c",
                                                "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                                                "text": "We made all haste down stairs, and soon threw open the street door, for the reception of as much lumber, of all sorts, as our house would hold, brought into it by several who thought it necessary to move their furniture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf24242c-388e-3a54-b4d2-2874928425fb",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "Useless or cumbrous material."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9864abf1-4f89-4539-b43e-8f1ba0e1f8e6",
                                                "sense_id": "cf24242c-388e-3a54-b4d2-2874928425fb",
                                                "text": "The bookful blockhead ignorantly read, / With loads of learned lumber in his head,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef493906-d0ca-330d-bd29-485d5e72e685",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "A pawnbroker's shop, or room for storing articles put in pawn; hence, a pledge, or pawn."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8870379a-1e7c-41d8-9d72-f6f74cae1120",
                                                "sense_id": "ef493906-d0ca-330d-bd29-485d5e72e685",
                                                "text": "a. 1746, Lady Grisell Baillie Murray, Memoirs of the Lives and Characters of the Right Honourable George Baillie\nThey put all the little plate they had […] in the lumber, which is pawning it, till the ships came."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bff5038-7063-30cb-9dba-9f0b9d58a34a",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "A baseball bat."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17a21663-18c5-3d97-953d-4420890efac2",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "An erect penis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To move clumsily and heavily; to move slowly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e323d862-8158-4ebd-bc95-5d550dbcd508",
                                                "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                                "text": "...he was only apprized of the arrival of the Monkbarns division by the gee-hupping of the postilion, as the post-chaise lumbered up behind him."
                                            },
                                            {
                                                "example_id": "ee0a81d3-0427-4e81-9ee3-69cf3b2cc262",
                                                "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                                "text": "The trooper climbed back on the rock and slid down to take the cadaver lowered to him by Bradly, who lumbered down to assist in carrying it."
                                            },
                                            {
                                                "example_id": "0e9f8dfd-6d1c-46ee-9ca8-b45b4646acc1",
                                                "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                                "text": "2002, Russell Allen, \"Incantations of the Apprentice\", on Symphony X, The Odyssey.\nThrough eerie reach of ancient woods / Where lumbering mists arise / I journey for nines moons of the year / To where a land of legend lies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To load down with things, to fill, to encumber, to impose an unwanted burden on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943e3048-aed6-42ba-bf11-31ad08ef7c16",
                                                "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                                "text": "They’ve lumbered me with all these suitcases."
                                            },
                                            {
                                                "example_id": "dca7ec64-5f10-4ff7-9665-fa8bcfeebd69",
                                                "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                                "text": "I got lumbered with that boring woman all afternoon."
                                            },
                                            {
                                                "example_id": "a4091127-e212-4e50-9640-048832a07046",
                                                "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                                "text": "The mean utensils, pewter measures, empty cans and casks, with which this room was lumbered, proclaimed it that of the host, who slept, surrounded by his professional implements of hospitality and stock in trade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc58689d-5ecf-374b-8777-3bb061e37f94",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To heap together in disorder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cfa6b1e-14ae-4987-a2be-794f70eed2e7",
                                                "sense_id": "bc58689d-5ecf-374b-8777-3bb061e37f94",
                                                "text": "so much stuff lumberd together"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f106814-c493-3ac4-9dfa-a8c89e8815f8",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To fill or encumber with lumber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c81b206-1ea8-4efa-8252-9b95bf7da909",
                                                "sense_id": "3f106814-c493-3ac4-9dfa-a8c89e8815f8",
                                                "text": "to lumber up a room"
                                            }
                                        ]
                                    },
