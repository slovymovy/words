                                    {
                                        "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                        "entry_id": "6f8a7e3b-d6eb-3b87-8eee-54f8c793fb5e",
                                        "glosses": [
                                            "Établissement de production de soins et de services liés à la santé où les malades et les blessés sont soignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f8e8b4-b5e8-4730-915e-0ab9e4b4a790",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Thorsavn possède un hôpital moderne que lui envieraient bien des arrondissements de Paris et un Sanatorium pour les tuberculeux."
                                            },
                                            {
                                                "example_id": "44fe3d34-14d0-4653-afde-485c3b751f59",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Oui, sans doute, il est pitoyable que des personnes aisées occupent indûment des lits dans les hôpitaux."
                                            },
                                            {
                                                "example_id": "d9122e07-7e9a-46cb-8b0f-0630e7cc2aa4",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Ici, tout le monde a un travail, de beaux vêtements, des cappuccinos à volonté et des vieux dans des hôpitaux qui s’effondrent."
                                            },
                                            {
                                                "example_id": "cfe85be5-5237-484e-af58-b8e6e6417923",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Hôpital général."
                                            },
                                            {
                                                "example_id": "f4284044-7635-4a64-a065-bd82be4ae6ec",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Les médecins d’un hôpital."
                                            },
                                            {
                                                "example_id": "432f6108-c375-4d3a-ad6f-ceb4f0e934df",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Se faire soigner à l’hôpital."
                                            },
                                            {
                                                "example_id": "552e491c-c050-455b-a8e6-0698c871bb48",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "L’hôpital du Val-de-Grâce."
                                            },
                                            {
                                                "example_id": "05768fdb-44cd-46e1-9ea7-25cb33ac5dcb",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Service d’hôpital."
                                            },
                                            {
                                                "example_id": "6bfd3efb-3a8e-4453-a314-61d4e96aa7f1",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Lit d’hôpital."
                                            },
                                            {
                                                "example_id": "116ce031-66e7-462d-afb6-1384535a5139",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Hôpital militaire, établissement où sont reçus et traités les militaires malades et blessés."
                                            },
                                            {
                                                "example_id": "2f34c8de-84ce-4bd3-8470-b9ab77e17ecb",
                                                "sense_id": "38a44736-da09-3eea-8d43-829c18e2b6e0",
                                                "text": "Vaisseau-hôpital ou bateau-hôpital, se dit d’un vaisseau disposé pour recevoir et traiter les malades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98c942d-2fa9-30de-9bd1-17febf31e090",
                                        "entry_id": "6f8a7e3b-d6eb-3b87-8eee-54f8c793fb5e",
                                        "glosses": [
                                            "Maison où il y a plusieurs personnes malades."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a495daf-2a53-4e61-b54c-69b88c97a1e2",
                                                "sense_id": "e98c942d-2fa9-30de-9bd1-17febf31e090",
                                                "text": "C’est un hôpital !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
