            "senses": [
                {
                    "sense_id": "007b0bd8-40e1-368b-a2f5-efe1ba00be94",
                    "sense_definition": "Komplex aus beweglichen Bauelementen, bei dem die Bewegung eines Teils die Bewegung anderer Teile steuert oder hervorruft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Mechanismus</w> der alten Turmuhr muss regelmäßig gewartet und geölt werden."
                        },
                        {
                            "text": "Wenn man diesen Hebel drückt, setzt sich der gesamte <w>Mechanismus</w> sofort in Gang."
                        }
                    ],
                    "synonyms": [
                        "Werk"
                    ],
                    "common_phrases": [
                        "komplexer Mechanismus",
                        "den Mechanismus auslösen"
                    ]
                },
                {
                    "sense_id": "0397592b-3df0-3008-b6ac-f8817f63488d",
                    "sense_definition": "Struktur oder geordnetes System von Faktoren, die nach bestimmten Gesetzmäßigkeiten zusammenwirken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man braucht viel Erfahrung, um den <w>Mechanismus</w> der modernen Finanzmärkte zu verstehen."
                        },
                        {
                            "text": "Der menschliche Körper besitzt einen erstaunlichen <w>Mechanismus</w> zur Selbstheilung kleinerer Wunden."
                        }
                    ],
                    "synonyms": [
                        "Ablauf",
                        "Prozess"
                    ],
                    "common_phrases": [
                        "automatischer Mechanismus",
                        "ein funktionierender Mechanismus"
                    ]
                },
                {
                    "sense_id": "8375a8a7-cc1b-35a2-8d0d-3cd348ea6bde",
                    "sense_definition": "Philosophische Lehre, nach der sämtliche Erscheinungen und Vorgänge in der Natur rein mechanisch und kausal erklärbar sind",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Zeitalter der Aufklärung erlebte der philosophische <w>Mechanismus</w> eine weite Verbreitung."
                        },
                        {
                            "text": "Viele Denker lehnten den radikalen <w>Mechanismus</w> ab, weil er menschliches Bewusstsein auf Materie reduzierte."
