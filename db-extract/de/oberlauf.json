                "senses": [
                    {
                        "sense_id": "7191c0d4-d204-3e86-a978-c9e51e3e8b1b",
                        "entry_id": "a841f622-c645-3efb-be54-2e6a6631e808",
                        "glosses": [
                            "Teil des Flusslaufs von seinem Anfang, in der Regel von der Quelle an"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1e9d04-0dd8-41e2-92b9-95438db32730",
                                "sense_id": "7191c0d4-d204-3e86-a978-c9e51e3e8b1b",
                                "text": "„Der Oberlauf der Ahr zeigt hingegen einen ganz anderen Charakter.“"
                            },
                            {
                                "example_id": "b0cad51c-b4c0-4783-956e-a4e5422f0053",
                                "sense_id": "7191c0d4-d204-3e86-a978-c9e51e3e8b1b",
                                "text": "„Von der Schelde-Mündung bis zum Oberlauf des Rheins gab es nun eine durchgehende Frontlinie.“"
                            },
                            {
                                "example_id": "f0e11bb6-a529-44e3-8bc6-97b7857d7851",
                                "sense_id": "7191c0d4-d204-3e86-a978-c9e51e3e8b1b",
                                "text": "„Die Siedler beschlossen nach diesem Fund, die Insel gründlich zu durchforschen und am nächsten Morgen, dem 30. Oktober, die Mercy hinaufzufahren, um vom Oberlauf aus weiter nach Westen vorzudringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
