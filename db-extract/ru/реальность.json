                            "prepositional"
                        ],
                        "form": "реа́льности"
                    },
                    {
                        "form_id": "75b8987b-9fde-4dc7-aeaf-d7c855f0117f",
                        "entry_id": "63126100-fdbc-3aeb-9555-2d53023dad07",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "реа́льностях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db31ecf4-25d8-30b0-a565-cdd57e7f91e8",
                        "entry_id": "63126100-fdbc-3aeb-9555-2d53023dad07",
                        "glosses": [
                            "сущностное выражение свойства, описываемого прилагательным реальный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d81b128-108f-4aca-97c7-6a461757346b",
                                "sense_id": "db31ecf4-25d8-30b0-a565-cdd57e7f91e8",
                                "text": "Второй раз я поехал и потому, что он пригласил, и потому, что в мирной жизни, чтобы проверить реальность своих задумок, надо лет пять, а то и десять."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbfb678e-5eb8-3e8b-a32c-330b988ff3e0",
                        "entry_id": "63126100-fdbc-3aeb-9555-2d53023dad07",
                        "glosses": [
                            "филос. то же, что действительность; то, что существует на самом деле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da43e815-e0dd-4365-a986-8255588bf605",
                                "sense_id": "cbfb678e-5eb8-3e8b-a32c-330b988ff3e0",
                                "text": "Таня лежала на спине и, глядя в смутно белеющий потолок, осторожно разделяла сон и реальность."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55865005-e308-4b55-9526-76337804d3e6",
                        "source_entry_id": "63126100-fdbc-3aeb-9555-2d53023dad07",
                        "source_sense_description": "действительность",
                        "target_lang_word": "reality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9db39c24-802c-38a6-a5ae-735cb3f6dcfb",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "The state of being actual or real; realness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a35b67-8fcb-4032-85ef-4e5feeb19098",
                                                "sense_id": "9db39c24-802c-38a6-a5ae-735cb3f6dcfb",
                                                "text": "The reality of the crash scene on TV dawned upon him only when he saw the victim was no actor but his friend."
                                            },
                                            {
                                                "example_id": "df922a23-6b94-4353-9a38-fd2ed5812d80",
                                                "sense_id": "9db39c24-802c-38a6-a5ae-735cb3f6dcfb",
                                                "text": "While the SCP universe is, of course, filled with things that we would certainly not consider \"real\", most of the SCPs are tangible or perceivable in some way. There are those concepts, however, whose reality is debatable, even to the SCP Foundation, begging them to ask the question of what, exactly, is real."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e70ab3-9d7a-387c-9765-cbfeeed7099f",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "The real world."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f90ebf-126f-4e67-9738-1e30746d17df",
                                                "sense_id": "e6e70ab3-9d7a-387c-9765-cbfeeed7099f",
                                                "text": "A man very often fancies that he understands a critic, when in reality he does not comprehend his meaning."
                                            },
                                            {
                                                "example_id": "eb016d57-29b8-4f5c-a2cc-e337f9b51e0a",
                                                "sense_id": "e6e70ab3-9d7a-387c-9765-cbfeeed7099f",
                                                "text": "As a political system democracy seems to me extraordinarily foolish,[…]. My servant is, so far as I am concerned, welcome to as many votes as he can get.[…]I do not suppose that it matters much in reality whether laws are made by dukes or cornerboys, but I like, as far as possible, to associate with gentlemen in private life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "A real entity, event, or other fact."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "663d2a1e-3a99-4d19-a84c-ff6dff9a2e35",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "The ultimate reality of life is that it ends in death."
                                            },
                                            {
                                                "example_id": "5ff6e2cd-92a6-40fe-a105-5fc240494d13",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "And to realities yield all her shows."
                                            },
                                            {
                                                "example_id": "42e3b19f-323b-4fb6-91ea-6064f396e186",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "My neck, Sir, may be an idea to you, but to me it is a reality."
                                            },
                                            {
                                                "example_id": "22acda11-1e88-4632-861d-5c6fc827a652",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "A dream, of simple fantasy / That I, wished was reality / That you'd, come knocking at my door / And we'd, relive this dream once more"
                                            },
                                            {
                                                "example_id": "ec103abf-08b2-4931-9f1b-92673aac8050",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "Recent historical studies indicate that we must continue to challenge the notion that there is an unproblematic story of queer liberation. For example, how do local histories account for realities such as the increased racial segregation of the New York bar scene after Stonewall?"
                                            },
                                            {
                                                "example_id": "b344d02c-2d75-4ef2-b338-130b276c48a8",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "Given the economic realities of contemporary Poland, a requirement to provide information on movable assets which exceed PLN 10,000 in value cannot be held to be excessive."
                                            },
                                            {
                                                "example_id": "8822457b-fa7d-446b-925e-5a96fc8a1890",
                                                "sense_id": "8f98f49f-0cc1-3ed7-b9a6-d5ae72f7329b",
                                                "text": "It is time the international community faced the reality: we have an unmanageable, unfair, distortionary global tax regime. It is a tax system that is pivotal in creating the increasing inequality that marks most advanced countries today[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd2e1ab6-f962-35fd-845a-96894af705d3",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "The entirety of all that is real."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f036330-5dcf-471b-91c4-bc687c06b1e7",
                                                "sense_id": "dd2e1ab6-f962-35fd-845a-96894af705d3",
                                                "text": "Across the entire Universe. Never stopping, never faltering, never fading. People and planets and stars will become dust. And the dust will become atoms and the atoms will become... nothing. And the wavelength will continue, breaking through the rift at the heart of the Medusa Cascade into every dimension, every parallel, every single corner of creation. This is my ultimate victory, Doctor! The DESTRUCTION! Of REALITY! ITSELF!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e709b6-a00e-3783-af17-211426b43ad7",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "An individual observer's own subjective perception of that which is real."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b56e8286-e9ed-39c5-96b5-6c93ceb88dc9",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "Loyalty; devotion."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f297434-d245-4494-9e41-762a0ad544f4",
                                                "sense_id": "b56e8286-e9ed-39c5-96b5-6c93ceb88dc9",
                                                "text": "To express our reality to the emperor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e71e25-70ae-3442-9b9b-57821bf9c3fe",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "Realty; real estate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70fcddfa-9f35-3528-9bbd-6e311da10bc6",
                                        "entry_id": "1e5bd644-36d0-30f5-91c3-6ca4acf00430",
                                        "glosses": [
                                            "Reality television."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f4e350-cea3-4981-86b8-05223ae5cf9d",
                                                "sense_id": "70fcddfa-9f35-3528-9bbd-6e311da10bc6",
                                                "text": "a foray into reality programming"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16d39be8-a3fa-4822-8886-f5d788333dcc",
                        "source_entry_id": "63126100-fdbc-3aeb-9555-2d53023dad07",
                        "source_sense_description": "действительность",
                        "target_lang_word": "Realität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Realität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                        "entry_id": "2f1fa681-9f73-3c00-8247-3f4d7daa3951",
                                        "glosses": [
                                            "das, was tatsächlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a808662d-859b-4278-b671-eae27f28823f",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "Die Werbeaussagen entsprechen nicht der Realität."
                                            },
                                            {
                                                "example_id": "66933d91-e7ed-4709-a4ea-2d264598740d",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "„Welch dreiste Verleugnung der Realität, die Mussa vor ihm so deutlich beim Namen genannt hatte.“"
                                            },
                                            {
                                                "example_id": "df4d4eb3-d6d8-485b-9cd7-66580c288141",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "Ihre politischen Vorstellungen sind jenseits jedweder Realität."
                                            },
                                            {
                                                "example_id": "1ece6243-fbb2-4394-b86b-bfa7bac92acd",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "Unser guter Bürgermeister hat schon immer einen ausgeprägten Sinn für die Realität gehabt."
                                            },
                                            {
                                                "example_id": "77ae0fb2-dcfb-4283-84f3-b5b8ca8a2bd7",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "Die Realität zeigt uns, dass Verhandlungen mit diesen Verbrechern völlig sinnlos sind."
                                            },
                                            {
                                                "example_id": "1305995c-60d2-47ca-8ba6-7e1e62354b13",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "Wenn wir der Realität ins Auge schauen, erkennen wir, dass Leiden auch nur eine dumme Angewohnheit ist."
                                            },
                                            {
                                                "example_id": "f9d7d68d-9649-4e2d-a3f7-808a985268dc",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "Völlig die Realität verkennend hatte der Präsident noch in den letzten Kriegstagen auf einen Sieg gebaut."
                                            },
                                            {
                                                "example_id": "5ca4f38d-a2bf-4535-adab-c8ef1ba34c23",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "In der virtuellen Realität ist es eben doch nicht ganz so real, nur scheinbar real."
                                            },
                                            {
                                                "example_id": "0d89ce0e-292c-4687-a09a-99da701fbd61",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "„Es muß aus der Realität kommen, der jüngsten Geschichte, der unmittelbaren Tragödie des deutschen Volkes.“"
                                            },
                                            {
                                                "example_id": "b7ba6e2f-831a-4da4-9d02-59070e8c182b",
                                                "sense_id": "ecc68e51-528b-3ad0-bd29-eff0b74454c8",
                                                "text": "„Jeder kennt das Stereotyp vom reichen Juden, von einem, der gerne Geschäfte macht. […] Mit der Realität hat es nichts zu tun, besonders in Deutschland nicht. Hier sind die meisten Jüdinnen und Juden arm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c26ec7f-8f79-381a-a5cb-6f169c14cca5",
                                        "entry_id": "2f1fa681-9f73-3c00-8247-3f4d7daa3951",
                                        "glosses": [
                                            "Immobilien"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "no-singulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6610f29a-16f1-42bd-90bc-60544c962386",
                                                "sense_id": "3c26ec7f-8f79-381a-a5cb-6f169c14cca5",
                                                "text": "Die Weiner Realitäten OG mit Sitz in der Südsteiermark ist Ihr Ansprechpartner in Sachen Immobilien."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
