                    {
                        "translation_id": "694a5b7e-972f-4a52-a599-7aa1e8b62071",
                        "source_entry_id": "2d2091b3-8b59-3433-9ea9-c81fcb64ac7d",
                        "source_sense_description": "действие по значению гл. излагать, изложить",
                        "target_lang_word": "exposé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exposé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2250e0d9-af5b-3351-a2d6-ee06493727c8",
                                        "entry_id": "e6fb7003-5c92-3064-a7cc-6c546921fb91",
                                        "glosses": [
                                            "Qui a été exposé, dans un musée, par exemple."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e5561fb-bb32-3191-a5bc-ffe3708ba34d",
                                        "entry_id": "e6fb7003-5c92-3064-a7cc-6c546921fb91",
                                        "glosses": [
                                            "Qui est susceptible d’être en danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e182d548-29c8-49de-bb3d-3a8417828118",
                                                "sense_id": "7e5561fb-bb32-3191-a5bc-ffe3708ba34d",
                                                "text": "Ils arrivent actuellement au terme de la protection humorale dont ils bénéficiaient après leur 1^(ère) dose de rappel et sont donc très exposés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exposé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d277a1ee-7eb7-32f2-bbcd-a809518232f1",
                                        "entry_id": "124b06e9-7c9d-368b-a1b7-4273c57e4b69",
                                        "glosses": [
                                            "Récit d’un ou de plusieurs faits et des circonstances qui les ont accompagnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b0420d7-d450-425e-9a83-50bed0076ff8",
                                                "sense_id": "d277a1ee-7eb7-32f2-bbcd-a809518232f1",
                                                "text": "Dans ce mémoire, l’exposé des faits n’est pas exact."
                                            },
                                            {
                                                "example_id": "08885eb3-5d9e-4682-a58e-93576b124d50",
                                                "sense_id": "d277a1ee-7eb7-32f2-bbcd-a809518232f1",
                                                "text": "Exposé sommaire, rapide, succinct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9db4d18-6b2f-3630-bd7e-10f2a2960db4",
                                        "entry_id": "124b06e9-7c9d-368b-a1b7-4273c57e4b69",
                                        "glosses": [
                                            "Compte rendu ; explication ; développement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db849725-d05c-4379-9de2-ec65bfd60a85",
                                                "sense_id": "a9db4d18-6b2f-3630-bd7e-10f2a2960db4",
                                                "text": "On pourrait remplir des pages entières avec l’exposé sommaire des thèses contradictoires, cocasses et charlatanesques qui forment le fond des harangues de nos grands hommes ; rien ne les embarrasse […]."
                                            },
                                            {
                                                "example_id": "8ebcf222-1e3d-4f51-8434-94b53133f707",
                                                "sense_id": "a9db4d18-6b2f-3630-bd7e-10f2a2960db4",
                                                "text": "Devant la réprobation presque unanime qui accueillit mon exposé, je me décourageai et me ralliai à l’interprétation probabiliste de Born, Bohr et Heisenberg […]."
                                            },
                                            {
                                                "example_id": "95d73f7c-a453-46a6-a1be-8caf1f33685b",
                                                "sense_id": "a9db4d18-6b2f-3630-bd7e-10f2a2960db4",
                                                "text": "Normalement, les assimilations théoriques ne vous poseront aucun problème même si on voit çà et là des mastériens de psychologie par exemple être bloqués sur les exposés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf6a657-293f-33ca-8cb7-68cb5a716561",
                                        "entry_id": "124b06e9-7c9d-368b-a1b7-4273c57e4b69",
                                        "glosses": [
                                            "Présentation d'un thème musical, avant de passer à l'improvisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50442df-fa21-4970-9981-1681fdd5a14b",
                                                "sense_id": "adf6a657-293f-33ca-8cb7-68cb5a716561",
                                                "text": "Cette position de retrait permet à Miles de dissimuler bon nombre de ratés dans les exposés et une certaine tendance à canarder dans les passages difficiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exposé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d544f1-80a3-3387-bc23-b2964d9f3b86",
                                        "entry_id": "d28df75d-0d62-3711-b6ec-c3515527a64c",
                                        "glosses": [
                                            "Participe passé masculin singulier de exposer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d8045a2-11bc-4d65-bd01-0ed937de132a",
                                                "sense_id": "16d544f1-80a3-3387-bc23-b2964d9f3b86",
                                                "text": "L’auteur immortel du Traité de la Vie et de la Mort a, dans cet ouvrage, exposé d’une manière admirable l’influence que le cerveau, le poumon et le cœur exercent réciproquement l’un sur l’autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa2d8ae2-0b9c-4414-b7b4-7221d8fd036e",
                        "source_entry_id": "2d2091b3-8b59-3433-9ea9-c81fcb64ac7d",
                        "source_sense_description": "действие по значению гл. излагать, изложить",
                        "target_lang_word": "présentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "présentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Action de présenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55dc542-86c0-43ef-a681-97f81c46c915",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "La présentation de la Vierge, Fête que l’église catholique célèbre le 21 novembre en l’honneur de la Vierge et pour rappeler qu’elle fut présentée au Temple."
                                            },
                                            {
                                                "example_id": "abcf7412-d158-45c6-bec1-f2b90b1b65fe",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "La chasuble blanche du Commun des Vierges, liturgiquement obligatoire pour ce 21 novembre, jour de la Présentation de Marie, devint aussitôt la chasuble rouge des Martyrs."
                                            },
                                            {
                                                "example_id": "1f4787bc-7d36-4cf0-a920-209ada00ae2b",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "Je me gardai bien, en revanche, de manquer le spectacle de ma petite Glodie, montant à pas menus les marches de l’escalier, ainsi qu’une Marie dans la Présentation, et serrant contre son giron, entre ses deux menottes, la corbeille de biscuits étagés qui montaient jusqu’à son menton."
                                            },
                                            {
                                                "example_id": "11bfc1d4-18e1-4735-8596-0f6fd974b8e9",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "La présentation de l’Enfant Jésus, Fête que l’église catholique célèbre le 2 février, en même temps que la Purification de la Vierge."
                                            },
                                            {
                                                "example_id": "04969b14-49f2-4302-bad1-20168891e763",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "Présentation à la cour, La cérémonie de présenter au roi et à sa famille les personnes qui avaient droit à cet honneur."
                                            },
                                            {
                                                "example_id": "ff4d725f-c145-4a9f-a43a-b93b61c0135f",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "Il y eut ce jour-là plusieurs présentations."
                                            },
                                            {
                                                "example_id": "476b4b7e-0fb1-4ddf-a04f-f00741563c35",
                                                "sense_id": "f8e969fa-9fa5-30f3-be39-61381f75d132",
                                                "text": "Après délibération du conseil des ministres, le Parlement est saisi du projet de loi au moyen d’un décret de présentation préparé par le secrétariat général du Gouvernement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6901f3-c745-3a64-941a-717ea953785c",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Action de présenter.",
                                            "Action de présenter une personne à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7692e2b-e69d-4415-aaf7-de2bca252269",
                                                "sense_id": "0d6901f3-c745-3a64-941a-717ea953785c",
                                                "text": "La présentation des fiancés eut lieu à l’église."
                                            },
                                            {
                                                "example_id": "9a8a3f52-bf9c-49eb-b74e-d4de4469374b",
                                                "sense_id": "0d6901f3-c745-3a64-941a-717ea953785c",
                                                "text": "Faire les présentations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72fc801f-0229-3980-b96a-7b6817d0c943",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Droit de présenter à une place, à un emploi, à un bénéfice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8973ac-2282-43a0-8902-5582caef5893",
                                                "sense_id": "72fc801f-0229-3980-b96a-7b6817d0c943",
                                                "text": "Cette place est à la nomination du ministre, sur la présentation du préfet."
                                            },
                                            {
                                                "example_id": "a448d7c1-a69a-4f0a-b0be-39f58b9f19f2",
                                                "sense_id": "72fc801f-0229-3980-b96a-7b6817d0c943",
                                                "text": "Cette cure était à la présentation de tel abbé, de tel seigneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98eb503-5635-3a91-b6a6-b7c2d84690f4",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Acte par lequel un procureur déclarait se présenter pour telle partie."
                                        ],
                                        "tags": [
                                            "Ancien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36d3294-3ff7-4813-8e8f-6b89a40ef016",
                                                "sense_id": "e98eb503-5635-3a91-b6a6-b7c2d84690f4",
                                                "text": "Il y avait un greffe où se faisaient les présentations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7d8c830-c58c-3106-9fc8-dc60d1f40c76",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Action de montrer, de la manière de faire valoir une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954c52f1-2cbc-4d69-b58e-a86b46202470",
                                                "sense_id": "b7d8c830-c58c-3106-9fc8-dc60d1f40c76",
                                                "text": "J’ai assisté à la présentation de ce film."
                                            },
                                            {
                                                "example_id": "d465bdd6-d4a8-4901-a96c-664718d9dc0d",
                                                "sense_id": "b7d8c830-c58c-3106-9fc8-dc60d1f40c76",
                                                "text": "La présentation de ces marchandises est très heureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bf8d174-cb18-3562-8de1-f264ff1eb525",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Action de présenter un effet pour le faire payer. La présentation d’une lettre de change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cd4540-3bc7-463c-ae22-b7ebf2214ed2",
                                                "sense_id": "3bf8d174-cb18-3562-8de1-f264ff1eb525",
                                                "text": "Un effet payable à présentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45434187-3100-3908-8915-379e7ef78445",
                                        "entry_id": "43ae52be-0e8e-3063-9788-da5ab3802757",
                                        "glosses": [
                                            "Enchaînement d’images à l’interactivité nulle ou limitée et destiné à être projeté sur un grand écran lors d’une réunion pour servir de support lors d’un exposé oral."
                                        ],
                                        "tags": [
                                            "Bureautique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582bde06-1678-4b40-8842-d5d6f3361634",
                                                "sense_id": "45434187-3100-3908-8915-379e7ef78445",
                                                "text": "Je vous ai mis ma présentation en pièce jointe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
