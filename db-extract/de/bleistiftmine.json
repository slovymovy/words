                        "entry_id": "5163da57-4e79-37b2-8051-f82f0a77304d",
                        "glosses": [
                            "Mine de crayon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66377b1-d73a-476e-b0bc-f6561da1a6a2",
                                "sense_id": "cb2a212a-e7d2-3444-8dc2-001e593df9f2",
                                "text": "Die Bleistiftminen des Druckbleistiftes brechen leicht und sind nicht gerade günstig im Preis.",
                                "translation": "Les mines de crayon de portemine cassent facilement et sont relativement coûteuses."
                            },
                            {
                                "example_id": "b88ff1df-1a70-4c40-a8f3-0aa43552d2a8",
                                "sense_id": "cb2a212a-e7d2-3444-8dc2-001e593df9f2",
                                "text": "Ein klassischer Bleistift besteht aus einer Bleistiftmine und lackiertem Holz.",
                                "translation": "Un crayon classique est composé d’une mine de crayon et de bois laqué."
                            }
                        ]
                    }
