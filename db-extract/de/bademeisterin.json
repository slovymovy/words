                    {
                        "sense_id": "05f19842-14ba-3a84-bdc5-72c9d8e5139a",
                        "entry_id": "ba81b659-b4d9-3370-8d39-432117937a67",
                        "glosses": [
                            "weibliche Person, die im Schwimmbad den Badebetrieb überwacht und Badeunfälle zu verhindern sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "244f8b24-4c1f-4ac9-94a7-c7af6731bedb",
                                "sense_id": "05f19842-14ba-3a84-bdc5-72c9d8e5139a",
                                "text": "Bademeisterinnen müssen ein Rettungsschwimmabzeichen besitzen."
                            },
                            {
                                "example_id": "5aef65e1-4a3e-4b3b-943d-57dd8be9f7a3",
                                "sense_id": "05f19842-14ba-3a84-bdc5-72c9d8e5139a",
                                "text": "„Die 45-jährige Wahlwienerin ist die erste Bademeisterin überhaupt und achtet seit fünf Saisonen darauf, dass nicht irgendjemand unfreiwillig badengeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
