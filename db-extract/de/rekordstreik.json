                ],
                "senses": [
                    {
                        "sense_id": "61a7ce68-cd31-3c9e-99d9-317b96f354bf",
                        "entry_id": "985b5110-f818-3fb0-b8ab-3326e7007af6",
                        "glosses": [
                            "Streik, der noch nie dagewesene Ausmaße erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70bc763-2501-424e-a69b-0204f4494947",
                                "sense_id": "61a7ce68-cd31-3c9e-99d9-317b96f354bf",
                                "text": "„Die Deutsche Bahn will den Rekordstreik der Lokführer juristisch prüfen - schätzt die Erfolgsaussichten aber als gering ein.“"
                            },
                            {
                                "example_id": "ab2ce132-b80a-4c55-9f94-15b52fa76038",
                                "sense_id": "61a7ce68-cd31-3c9e-99d9-317b96f354bf",
                                "text": "„Als Reaktion auf den Rekordstreik bei der Bahn bringen Niedersachsens Metallarbeitgeber ein einmaliges Aussetzen des Sonntagsfahrverbots für Lkw ins Spiel.“"
                            },
                            {
                                "example_id": "8f850236-d3ba-47c1-8fd4-a014ecef8c31",
                                "sense_id": "61a7ce68-cd31-3c9e-99d9-317b96f354bf",
                                "text": "„Der geplante Rekordstreik bei der Deutschen Bahn kostet die Wirtschaft nach Prognose von Forschern einen dreistelligen Millionenbetrag.“"
                            },
                            {
                                "example_id": "718fa30d-14bc-450b-87c5-b0a310937330",
                                "sense_id": "61a7ce68-cd31-3c9e-99d9-317b96f354bf",
                                "text": "„Der viertägige Rekordstreik hatte bereits am Mittwoch im Güterverkehr begonnen.“"
                            },
                            {
                                "example_id": "60c2c553-ab8f-4c19-b3f8-b00f2988e948",
                                "sense_id": "61a7ce68-cd31-3c9e-99d9-317b96f354bf",
                                "text": "„Es wird ein Rekordstreik sein, und das Land und seine Bürger wettern jetzt schon, weil sich jeder irgendwie betroffen fühlt, wenn Zug- und S-Bahnverkehr zum Erliegen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
