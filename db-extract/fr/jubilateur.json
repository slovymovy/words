                    {
                        "sense_id": "09a268eb-1b5b-3fe2-9e17-57c2f7201120",
                        "entry_id": "d2612f95-aec6-3069-9212-b1a1a1372028",
                        "glosses": [
                            "Qui jubile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f368411-5170-499d-81ff-029b78ecdeff",
                                "sense_id": "09a268eb-1b5b-3fe2-9e17-57c2f7201120",
                                "text": "Joies, douleurs : un paroxysme de souffrance, puis l’accord déchirant se résout en un accord jubilateur."
                            },
                            {
                                "example_id": "aa53ef40-2fa3-438a-8aa2-17e15c81b9c9",
                                "sense_id": "09a268eb-1b5b-3fe2-9e17-57c2f7201120",
                                "text": "Que leur importe la honte que peut ressentir un vieux papy perdu sur les hauts plateaux de la Meseta sous le regard narquois d’un hidalgo jubilateur ?"
                            },
                            {
                                "example_id": "077c2be6-9e0a-4752-90b5-a0a3caeaab7b",
                                "sense_id": "09a268eb-1b5b-3fe2-9e17-57c2f7201120",
                                "text": "Vous pouvez compter sur moi, je ne me priverai pas de ces deux spectacles vengeurs, dont vous percevez la jubilatrice et compensatoire cruauté."
                            },
                            {
                                "example_id": "49aae660-e835-444f-a0ac-829564633780",
                                "sense_id": "09a268eb-1b5b-3fe2-9e17-57c2f7201120",
                                "text": "La concierge lui sauta dessus dès son entrée dans le vestibule pour lui annoncer avec une insolence larvée et jubilatrice qu’elle devait déguerpir à la fin du mois."
                            }
                        ]
                    }
                ],
