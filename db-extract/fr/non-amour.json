                "senses": [
                    {
                        "sense_id": "6ab83b65-402c-3f46-a11c-c9abbc898ff5",
                        "entry_id": "dbff3948-631c-3bca-98ea-14a0215182be",
                        "glosses": [
                            "Fait de ne pas être aimé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299f3933-e8dd-40e8-9ead-2b226a918c5d",
                                "sense_id": "6ab83b65-402c-3f46-a11c-c9abbc898ff5",
                                "text": "La menace est l’abandon précoce, la solitude, le non-amour parfois surmajoré dans le souvenir ou dans la désignation du ou des responsables."
                            },
                            {
                                "example_id": "95b744e0-d3eb-452f-9161-88b7b5990250",
                                "sense_id": "6ab83b65-402c-3f46-a11c-c9abbc898ff5",
                                "text": "Parfois, c’est une plainte tragique, une plaie toujours ouverte, comme Angelo ne cessera de me le dire pendant trois ans, comme Philippe s’acharnera à me prouver le non-amour de son père, et Françoise le non-amour de sa mère."
                            }
                        ]
                    }
                ],
