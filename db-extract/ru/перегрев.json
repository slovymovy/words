                "senses": [
                    {
                        "sense_id": "afe202ac-7e03-30d5-88af-88ae3f75121d",
                        "entry_id": "8af02431-399e-35b3-9693-529e1d386a32",
                        "glosses": [
                            "нагрев механизма или иного устройства до температуры, вредящей его нормальной работе"
                        ],
                        "tags": [],
