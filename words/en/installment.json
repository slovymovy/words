{
    "word_family": [
        "install",
        "installation",
        "installer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "063a5784-8408-3256-94b8-9f7dc74c00bc",
                    "sense_definition": "One of several regular payments made over a period of time until a debt or total amount is paid off.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to pay for my new laptop in monthly <w>installments</w>.",
                            "target_lang_translations": {
                                "nl": "Ik besloot mijn nieuwe laptop in maandelijkse <w>termijnen</w> te betalen.",
                                "zh": "我决定用每月<w>分期付款</w>的方式购买这台新笔记本电脑。"
                            }
                        },
                        {
                            "text": "They could not afford to pay the full price at once, so they paid in <w>installments</w>.",
                            "target_lang_translations": {
                                "nl": "Ze konden het zich niet veroorloven om de volle prijs in één keer te betalen, dus betaalden ze in <w>termijnen</w>.",
                                "zh": "他们无法一次付清全款，所以选择了<w>分期付款</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monthly installment",
                        "pay in installments",
                        "installment plan"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een van meerdere regelmatige betalingen over een periode totdat een schuld of totaalbedrag is afbetaald.",
                        "zh": "指分期付款中的每一笔款项，直到债务或总额付清为止。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "termijn",
                                "target_lang_sense_clarification": "betalingstermijn"
                            },
                            {
                                "target_lang_word": "afbetaling",
                                "target_lang_sense_clarification": "gedeeltelijke betaling van een schuld"
                            },
                            {
                                "target_lang_word": "schijf",
                                "target_lang_sense_clarification": "deel van een betaling"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分期付款",
                                "target_lang_sense_clarification": "指分次支付的款项"
                            },
                            {
                                "target_lang_word": "期",
                                "target_lang_sense_clarification": "量词，指分期付款的次数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a0579a8-a99e-393a-b8df-af1c3de16f7e",
                    "sense_definition": "A single part of a printed, broadcast, or published story or series.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone is waiting eagerly for the next <w>installment</w> of the movie series.",
                            "target_lang_translations": {
                                "nl": "Iedereen wacht vol spanning op het volgende <w>deel</w> van de filmreeks.",
                                "zh": "大家都在热切期待这部电影系列的下一<w>集</w>。"
                            }
                        },
                        {
                            "text": "The magazine published the story in weekly <w>installments</w>.",
                            "target_lang_translations": {
                                "nl": "Het tijdschrift publiceerde het verhaal in wekelijkse <w>afleveringen</w>.",
                                "zh": "杂志社以每周一<w>部分</w>的形式连载了这个故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "episode",
                        "part"
                    ],
                    "common_phrases": [
                        "next installment",
                        "latest installment",
                        "final installment"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een enkel deel van een gedrukt, uitgezonden of gepubliceerd verhaal of een serie.",
                        "zh": "指出版物、广播或影视系列作品中的单一部分或集数。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aflevering",
                                "target_lang_sense_clarification": "van een serie of tv-programma"
                            },
                            {
                                "target_lang_word": "deel",
                                "target_lang_sense_clarification": "van een boek, film of serie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "集",
                                "target_lang_sense_clarification": "影视剧或连载作品的单一部分"
                            },
                            {
                                "target_lang_word": "部分",
                                "target_lang_sense_clarification": "连载作品的组成部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "932d5f05-691d-3816-bd46-4efc86694e0f",
                    "sense_definition": "One of a series of parts of something presented or delivered at scheduled intervals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We received the second <w>installment</w> of the report today.",
                            "target_lang_translations": {
                                "nl": "We hebben vandaag het tweede <w>deel</w> van het rapport ontvangen.",
                                "zh": "我们今天收到了这份报告的第二<w>部分</w>。"
                            }
                        },
                        {
                            "text": "They released the course materials in regular <w>installments</w> over the term.",
                            "target_lang_translations": {
                                "nl": "Ze brachten het cursusmateriaal gedurende het semester in regelmatige <w>tranches</w> uit.",
                                "zh": "他们在整个学期内<w>分批</w>发布了课程材料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "first installment",
                        "by installments"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een van een reeks onderdelen van iets dat op vaste tijdstippen wordt gepresenteerd of geleverd.",
                        "zh": "指按预定时间间隔分批呈现或交付的系列事物中的一部分。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tranche",
                                "target_lang_sense_clarification": "gedeeltelijke levering of uitkering"
                            },
                            {
                                "target_lang_word": "deel",
                                "target_lang_sense_clarification": "onderdeel van een reeks"
                            },
                            {
                                "target_lang_word": "schijf",
                                "target_lang_sense_clarification": "fasegewijze uitkering of levering"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部分",
                                "target_lang_sense_clarification": "整体中的一部分"
                            },
                            {
                                "target_lang_word": "批",
                                "target_lang_sense_clarification": "分批交付的量词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2987fe2-d95f-3de5-8214-8d19149ea620",
                    "sense_definition": "The formal act or ceremony of placing someone into an official position or office.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many dignitaries attended the official <w>installment</w> of the new president.",
                            "target_lang_translations": {
                                "nl": "Vele waardigheidsbekleders woonden de officiële <w>installatie</w> van de nieuwe president bij.",
                                "zh": "许多政要出席了新总统的正式<w>就职典礼</w>。"
                            }
                        },
                        {
                            "text": "The priest prepared for his <w>installment</w> ceremony at the cathedral.",
                            "target_lang_translations": {
                                "nl": "De priester bereidde zich voor op zijn <w>installatie</w>ceremonie in de kathedraal.",
                                "zh": "牧师为他在大教堂举行的<w>就职典礼</w>做好了准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "installation",
                        "investiture",
                        "investment"
                    ],
                    "common_phrases": [
                        "formal installment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formal and less common than installation"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De formele handeling of ceremonie waarbij iemand in een officiële functie of ambt wordt geplaatst.",
                        "zh": "指将某人安置在正式职位或官职上的仪式。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "installatie",
                                "target_lang_sense_clarification": "officiële plechtige ambtvaardiging"
                            },
                            {
                                "target_lang_word": "inauguratie",
                                "target_lang_sense_clarification": "plechtige ambtsaanvaarding"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "就职典礼",
                                "target_lang_sense_clarification": "正式的任职仪式"
                            },
                            {
                                "target_lang_word": "任命",
                                "target_lang_sense_clarification": "授予职位的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbea85ad-a530-3cb6-8f33-91e43f6d1907",
                    "sense_definition": "A designated ceremonial seat or stall in which a official, knight, or dignitary is placed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each knight took his assigned <w>installment</w> in the chapel.",
                            "target_lang_translations": {
                                "nl": "Elke ridder nam zijn toegewezen <w>erezetel</w> in de kapel in.",
                                "zh": "每位骑士都在礼拜堂就座于指定的<w>席位</w>。"
                            }
                        },
                        {
                            "text": "The historical hall contained a elaborate grand <w>installment</w> for the ruler.",
                            "target_lang_translations": {
                                "nl": "De historische zaal bevatte een uitbundige grote <w>troonzetel</w> voor de heerser.",
                                "zh": "这座历史悠久的大厅里为统治者设有一张精致华丽的<w>宝座</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een aangewezen ceremoniële zitplaats of zetel waarin een gezagdrager, ridder of waardigheidsbekleder wordt geplaatst.",
                        "zh": "指为官员、骑士或显贵指定的礼仪性座位。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "koorbank",
                                "target_lang_sense_clarification": "ceremoniële zitplaats"
                            },
                            {
                                "target_lang_word": "erezetel",
                                "target_lang_sense_clarification": "officiële zitplaats"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "席位",
                                "target_lang_sense_clarification": "正式的礼仪座位"
                            },
                            {
                                "target_lang_word": "宝座",
                                "target_lang_sense_clarification": "统治者的尊贵座位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}