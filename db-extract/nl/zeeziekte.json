                    {
                        "sense_id": "fe16efe5-91ff-30dc-bd89-b9dd31a50b3a",
                        "entry_id": "8d3aed6f-6daa-3609-a7e8-13cce62a03b9",
                        "glosses": [
                            "misselijkheid als gevolg van de onregelmatige beweging van een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119d3780-a669-40ff-9cd7-c4edf36a9b4e",
                                "sense_id": "fe16efe5-91ff-30dc-bd89-b9dd31a50b3a",
                                "text": "Zij heeft al jaren last van zeeziekte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2405b898-93f9-4a96-a493-12eb7722756f",
                        "source_entry_id": "8d3aed6f-6daa-3609-a7e8-13cce62a03b9",
                        "source_sense_id": "fe16efe5-91ff-30dc-bd89-b9dd31a50b3a",
                        "source_sense_description": "misselijkheid als gevolg van de onregelmatige beweging van een schip",
                        "target_lang_word": "Seekrankheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seekrankheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                        "entry_id": "e86759ac-51b1-37c4-bb10-ddefb32c9fb0",
                                        "glosses": [
                                            "Reizzustand der Gleichgewichtsorgane durch die ungewohnten Schiffsschwankungen, der zu Übelkeit und Erbrechen führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd71cb24-7704-4226-94d6-e19dcd277494",
                                                "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                                "text": "Die Seekrankheit behebt sich in wenigen Tagen von selbst."
                                            },
                                            {
                                                "example_id": "bae01f60-de2a-43fc-9054-e6c3637c4545",
                                                "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                                "text": "„Dabei mussten ich und einige andere im Boot bei stürmischer See oft gegen die Seekrankheit ankämpfen.“"
                                            },
                                            {
                                                "example_id": "3a8fdda6-f625-4bf5-b969-97f8e701b3a9",
                                                "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                                "text": "„Roland hatte mir zugeflüstert, auf den Färöern wohnten jene, die die Wikingerschiffe wegen Seekrankheit verlassen mussten, als sie auf dem Weg nach Island waren.“"
                                            },
                                            {
                                                "example_id": "8de6ac9e-9ee5-45ca-9db9-cdb941dd5502",
                                                "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                                "text": "„Sie verließen niemals ihre Kabine - wir nahmen an, daß sie unter der Seekrankheit litten.“"
                                            },
                                            {
                                                "example_id": "a4901416-a607-482b-8de9-6fd72e823faf",
                                                "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                                "text": "„Am ersten Tag war ich wegen Seekrankheit von meinen Pflichten befreit, doch am nächsten Morgen machte ich mich ernsthaft ans Werk.“"
                                            },
                                            {
                                                "example_id": "2f2cfe85-0e13-4520-82aa-e5ffb3e6bd4c",
                                                "sense_id": "17a7821e-9d80-35ae-bf77-9ef83f2b3838",
                                                "text": "„Der Wind SO 4-6 ist böig, die See ist wellig, der Skipper kämpft Einhand mit dem achterlichen Wind, teilweise wird nur mit der Genua gesegelt. Die Bordfrau nimmt zum ersten Mal Tabletten gegen Seekrankheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f159e5d-57c2-445b-898e-4aa177abb4e6",
                        "source_entry_id": "8d3aed6f-6daa-3609-a7e8-13cce62a03b9",
                        "source_sense_id": "fe16efe5-91ff-30dc-bd89-b9dd31a50b3a",
                        "source_sense_description": "misselijkheid als gevolg van de onregelmatige beweging van een schip",
