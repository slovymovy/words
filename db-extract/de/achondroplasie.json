                ],
                "senses": [
                    {
                        "sense_id": "dae3e013-7b14-33cf-9fa8-f451077e0eb2",
                        "entry_id": "b43949de-a0e6-310d-9851-c5a46d1a3c92",
                        "glosses": [
                            "erbliche Erkrankung die gekennzeichnet ist durch Minderwuchs aufgrund eines gestörten enchondralen Längenwachstums, durch Fehlen der Knorpelwachstumszone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e74fd4-c81f-4dc6-a7db-509ae05a3c82",
                                "sense_id": "dae3e013-7b14-33cf-9fa8-f451077e0eb2",
                                "text": "„Außerdem gibt es bisher kaum Möglichkeiten, die Achondroplasie zu behandeln, weil sie – im Unterschied zu anderen Formen des Kleinwuchses – so gut wie nicht auf Wachstumshormone anspricht.“"
                            },
                            {
                                "example_id": "2ef19ae6-0bf6-4f50-88e0-e3d3b452f939",
                                "sense_id": "dae3e013-7b14-33cf-9fa8-f451077e0eb2",
                                "text": "„Bei der Achondroplasie sind die langen Knochen der Extremitäten stark verkürzt.“"
                            },
                            {
                                "example_id": "9a680726-5dc5-4957-b2a2-022feaa93360",
                                "sense_id": "dae3e013-7b14-33cf-9fa8-f451077e0eb2",
                                "text": "„Bei der Achondroplasie aber setzt die Verknöcherung der Wachstumsfugen zu früh ein.“"
                            },
                            {
                                "example_id": "9a7cf7b5-bbcf-47a7-b785-f01fef6a926a",
                                "sense_id": "dae3e013-7b14-33cf-9fa8-f451077e0eb2",
                                "text": "„Zur genaueren Erforschung der Achondroplasie entwickelten Forscher geeignete \"Mausmodelle\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
