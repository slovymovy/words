                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a718d7-00d3-4956-b40c-e5013de54919",
                                "sense_id": "a88f13c8-5e30-33e5-a704-b34239445d6e",
                                "text": "This humour broke out at first in many little oddnesses: he had never any stated hours for his dinner, supper, or sleep; because, said he, we ought to attend the calls of nature, and not set our appetites to our meals […]"
                            },
                            {
                                "example_id": "0ebeb24d-92d4-45ab-972d-13b13616fc72",
                                "sense_id": "a88f13c8-5e30-33e5-a704-b34239445d6e",
                                "text": "Neither was he intimate with any of the other bigger boys, who were warned off by his oddnesses, for he was a very queer fellow; […]"
                            }
                        ]
                    }
