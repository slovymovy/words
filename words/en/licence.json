{
    "word_family": [
        "licensee",
        "licenser",
        "licensing",
        "sublicence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                    "sense_definition": "An official document or permission that gives you the right to own, do, or use something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must carry your driving <w>licence</w> at all times when operating a motor vehicle.",
                            "target_lang_translations": {
                                "ru": "Вы должны всегда иметь при себе водительское <w>удостоверение</w> при управлении транспортным средством."
                            }
                        },
                        {
                            "text": "The restaurant was forced to close because it did not have a valid liquor <w>licence</w>.",
                            "target_lang_translations": {
                                "ru": "Ресторан был вынужден закрыться, так как у него не было действующей <w>лицензии</w> на продажу алкоголя."
                            }
                        },
                        {
                            "text": "The software <w>licence</w> agreement specifies that you can only install the program on one computer.",
                            "target_lang_translations": {
                                "ru": "<w>Лицензионное</w> соглашение на программное обеспечение гласит, что вы можете установить программу только на один компьютер."
                            }
                        }
                    ],
                    "synonyms": [
                        "permit",
                        "authorization",
                        "certification"
                    ],
                    "antonyms": [
                        "prohibition",
                        "ban"
                    ],
                    "common_phrases": [
                        "driving licence",
                        "liquor licence",
                        "software licence",
                        "marriage licence"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Canadian, Australian, South African, Irish, New Zealand, Malaysian, and Singaporean spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свобода действий или самовыражения, особенно когда она выходит за рамки того, что обычно считается приемлемым или правильным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вольность",
                                "target_lang_sense_clarification": "отступление от правил или фактов"
                            },
                            {
                                "target_lang_word": "свобода",
                                "target_lang_sense_clarification": "право действовать по своему усмотрению"
                            },
                            {
                                "target_lang_word": "дозволенность",
                                "target_lang_sense_clarification": "отсутствие строгих ограничений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                    "sense_definition": "Freedom of action or expression, especially when it goes beyond what is usually considered acceptable or correct.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director took some poetic <w>licence</w> with the historical facts to make the movie more exciting.",
                            "target_lang_translations": {
                                "ru": "Режиссер допустил некоторую поэтическую <w>вольность</w> в отношении исторических фактов, чтобы сделать фильм более захватывающим."
                            }
                        },
                        {
                            "text": "The artist felt he had the <w>licence</w> to experiment with bold colors and abstract shapes.",
                            "target_lang_translations": {
                                "ru": "Художник чувствовал, что у него есть <w>свобода</w> экспериментировать с яркими цветами и абстрактными формами."
                            }
                        }
                    ],
                    "synonyms": [
                        "freedom",
                        "latitude",
                        "liberty"
                    ],
                    "antonyms": [
                        "restriction",
                        "constraint"
                    ],
                    "common_phrases": [
                        "poetic licence",
                        "artistic licence",
                        "creative licence"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Canadian, Australian, South African, Irish, New Zealand, Malaysian, and Singaporean spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свобода действий или самовыражения, особенно когда она выходит за рамки того, что обычно считается приемлемым или правильным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вольность",
