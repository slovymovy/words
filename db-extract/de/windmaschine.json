                "senses": [
                    {
                        "sense_id": "6858f10b-c0a8-3feb-a9f7-eb29265c3bd4",
                        "entry_id": "2ffeb652-1002-3548-ace7-e24e35183406",
                        "glosses": [
                            "Gerät zur künstlichen Erzeugung von Wind oder dem Geräusch von Wind"
                        ],
                        "tags": [
                            "Theater",
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "c0f89bef-da83-44e9-a407-1467f33794fa",
                                "sense_id": "6858f10b-c0a8-3feb-a9f7-eb29265c3bd4",
                                "text": "„Die Windmaschine wurde abrupt ausgeschaltet, und lautes Gekicher ertönte, gefolgt von hastigen Schritten.“"
                            },
                            {
                                "example_id": "4d77188d-85f1-4b46-ad68-b8bf83b4d200",
                                "sense_id": "6858f10b-c0a8-3feb-a9f7-eb29265c3bd4",
                                "text": "„Sie warfen die Windmaschine an und das Teil flatterte heldenhaft hinter ihm her.“"
                            },
                            {
                                "example_id": "6f9e96f9-20f7-4776-9063-ba4bcb92d8d7",
                                "sense_id": "6858f10b-c0a8-3feb-a9f7-eb29265c3bd4",
                                "text": "„Die Hunde treffen im Studio auf viele fremde Gerüche, auf Windmaschine und Blitzlicht, werden schließlich hoch genommen und springen am Ende aus einer geringen Höhe auf eine Matratze.“"
                            },
                            {
                                "example_id": "2ea3446b-75d6-4b91-aa5d-8212dda99b79",
                                "sense_id": "6858f10b-c0a8-3feb-a9f7-eb29265c3bd4",
                                "text": "„Die Windmaschine brachte es in leichte Bewegung und ließ auch ihr langes, hellblondes Haar um ihr perfekt geschminktes Gesicht spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
