                                    {
                                        "sense_id": "f8d9d535-bc82-383b-a26b-6a3cd54e02f4",
                                        "entry_id": "a117e35a-14e1-3283-a273-0b136e3935fe",
                                        "glosses": [
                                            "völlige Übereinstimmung der Meinungen mehrerer Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c0c6e2-ba5c-41d2-8752-da22ecc3a3fc",
                                                "sense_id": "f8d9d535-bc82-383b-a26b-6a3cd54e02f4",
                                                "text": "„Spaniens neue Sozialhilfe passiert das Parlament ohne Gegenstimmen. Diese Einmütigkeit ist fast eine Sensation – und zeigt, wie ernst die Lage ist.“"
