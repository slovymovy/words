                "senses": [
                    {
                        "sense_id": "3afc0329-d78c-3ef6-920e-7648308b0b00",
                        "entry_id": "3f78def3-a98c-3032-8abf-21702177674c",
                        "glosses": [
                            "Figur, die aus mindestens drei durch gerade Linien verbundenen, voneinander verschiedenen Punkten besteht"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "8a53548a-53cb-4818-9c8b-25ed1b4ba43c",
                                "sense_id": "3afc0329-d78c-3ef6-920e-7648308b0b00",
                                "text": "„Ein Achteck […] ist ein Polygon mit acht Ecken und acht Seiten.“"
                            },
                            {
                                "example_id": "1fcc379b-37a2-4adb-8d07-74047cc133f3",
                                "sense_id": "3afc0329-d78c-3ef6-920e-7648308b0b00",
                                "text": "„Neben Dreiecken lassen sich auch andere Polygone als Grundrisse von Pyramiden verwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fbc4f4a-b00e-41a2-9022-0e9686d839be",
                        "source_entry_id": "3f78def3-a98c-3032-8abf-21702177674c",
