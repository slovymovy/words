                        "sense_id": "ba4cf44a-4987-3a11-824d-634dc419b71f",
                        "entry_id": "84d435cf-185d-3239-abc2-8fada01905da",
                        "glosses": [
                            "Caractère de ce qui est orthogonal, de ce qui possède un angle droit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ecf548-8f0f-4e1a-a18d-247023b00cc2",
                                "sense_id": "ba4cf44a-4987-3a11-824d-634dc419b71f",
                                "text": "L’orthogonalité et la symétrie du jeu d’instructions caractérisent principalement l’indépendance des instructions par rapport aux types et au format de données, à la mémorisation et à l’adressage des opérandes."
                            }
                        ]
                    }
                ],
                "translations": [
