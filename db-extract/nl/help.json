                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a302d31-60e7-47f0-a29e-e0d03415ff9b",
                                                "sense_id": "bd5d2fbd-838d-389c-8a4d-3e4c8e4ad4c6",
                                                "text": "helpppp that's too funny, did she rlly say that?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
