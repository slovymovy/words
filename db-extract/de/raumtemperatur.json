                ],
                "senses": [
                    {
                        "sense_id": "35abd2b5-4375-3a35-8ce7-22be57defd56",
                        "entry_id": "24f32707-0227-3c5e-b818-bfa0b81a1720",
                        "glosses": [
                            "der Wärmegrad der Luft in einem bestimmten Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a5658b-2097-47b3-91f7-e1bb7e09db00",
                                "sense_id": "35abd2b5-4375-3a35-8ce7-22be57defd56",
                                "text": "Die Wissenschaftler befragten die Bewohner zu Lüftungsverhalten, gewünschter Raumtemperatur, Einstellungen und auch Emotionen bezüglich der neuen Technik."
                            },
                            {
                                "example_id": "be58dbcb-969c-4f05-8e8e-e513fb32fdba",
                                "sense_id": "35abd2b5-4375-3a35-8ce7-22be57defd56",
                                "text": "„Infolgedessen ist Kohlendioxid bei Raumtemperatur mehr als fünfzigmal wasserlöslicher als Stickstoff und mehr als fünfundzwanzigmal wasserlöslicher als Sauerstoff.“"
                            },
                            {
                                "example_id": "c39476d3-6c50-4893-a2aa-cc404e11d395",
                                "sense_id": "35abd2b5-4375-3a35-8ce7-22be57defd56",
                                "text": "„[Der Physik-Professor Thomas Parnell] wollte mit dem sogenannten Pechtropfenexperiment nachweisen, dass Pech sich zwar wie ein Feststoff anfühlt und sich bei Raumtemperatur mit einem Hammer entzweischlagen lässt, sich aber dennoch wie eine Flüssigkeit verhält.“"
                            },
                            {
                                "example_id": "b03ba763-2fc2-4ee4-b072-2f18ebc1c8e6",
                                "sense_id": "35abd2b5-4375-3a35-8ce7-22be57defd56",
                                "text": "„Kaum ein Stoff ist so sagenumwoben wie ein Supraleiter bei Raumtemperatur, auf kaum einem liegen so große Hoffnungen. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dc69023-1606-423e-ab14-7fe7ae68f926",
