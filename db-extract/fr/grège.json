                "senses": [
                    {
                        "sense_id": "61c9cfff-bf79-3037-bdb2-b2cb26e642f0",
                        "entry_id": "d4f356f3-2207-3563-b559-222ebf5c1451",
                        "glosses": [
                            "Qualifie la soie à l'état brut."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "40db2577-e2d6-4777-9442-3ab4f7c30201",
                                "sense_id": "61c9cfff-bf79-3037-bdb2-b2cb26e642f0",
                                "text": "Les procédés employés pour le traitement préparatoire de la soie consistent en deux opérations principales: […] nᵒ 2 le moulinage qui comprend le dévidage, le doublage et la torsion que l'on fait subir à la soie grège pour la transformer en fils propres à être décreusés et tissés."
                            }
                        ]
                    },
                    {
                        "sense_id": "18c51007-1c99-353a-b735-65fd95f4f5d0",
                        "entry_id": "d4f356f3-2207-3563-b559-222ebf5c1451",
                        "glosses": [
                            "De la couleur beige clair de la soie grège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5ee901-3ba9-4aa5-9e93-ad6e548090f2",
                                "sense_id": "18c51007-1c99-353a-b735-65fd95f4f5d0",
                                "text": "À chaque missive, l’avouerai-je,\nJe crains de vous causer l’ennui\nEt cette attente, comme un missile,\nEndolorit ma tête grège."
                            },
                            {
                                "example_id": "5f88586f-5e3e-4a24-9024-569bc257a0ee",
                                "sense_id": "18c51007-1c99-353a-b735-65fd95f4f5d0",
                                "text": "Les couleurs donnent dans le camaïeu discret du haut de gamme des berlines : blanc et grège, noir et gris perle."
                            },
                            {
                                "example_id": "abda5d42-0cd9-4bd0-8ec5-9c70764ba40f",
                                "sense_id": "18c51007-1c99-353a-b735-65fd95f4f5d0",
                                "text": "Son ventre retombait en plis grassouillets sur une taillole de flanelle grège retenant le pantalon."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
