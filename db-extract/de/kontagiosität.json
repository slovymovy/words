                    {
                        "sense_id": "90e41aeb-4449-38d1-8010-7a372c96ce9f",
                        "entry_id": "9048da10-e85f-32af-86fa-8c2e473fce76",
                        "glosses": [
                            "Eigenschaft, ansteckend, infektiös, krankheitserregend (kontagiös) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1be17927-70cc-4fa3-ad50-9f8aa248c7a0",
                                "sense_id": "90e41aeb-4449-38d1-8010-7a372c96ce9f",
                                "text": "„Im Grunde musste die Medizin selbst ihre alten Wahrheiten über die Kontagiosität der Pest verwerfen, da sie aus einer Zeit stammten, als keine rationellen Kriterien für Wahrheit bestanden.“"
                            },
                            {
                                "example_id": "dc3468b7-895e-47ca-a5f4-d124706dc144",
                                "sense_id": "90e41aeb-4449-38d1-8010-7a372c96ce9f",
                                "text": "„Ist es unter diesen Umständen möglich, den Gründen nachzugehen, warum die Virusausscheidung – ausgedrückt durch die Kontagiosität des Infizierten – erst gegen das Ende der Inkubationsperiode zu konstatieren ist?“"
                            }
                        ],
