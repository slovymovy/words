                {
                    "sense_id": "e70922a8-df91-37b8-8892-ff11b5e3b9ee",
                    "sense_definition": "Laundry, especially when hung on a line to dry.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apparel_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please help me bring in the <w>clothes</w> before it starts raining.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помоги мне занести <w>бельё</w>, пока не пошёл дождь.",
                                "nl": "Help je me even de <w>was</w> binnen te halen voordat het begint te regenen?",
                                "pl": "Pomóż mi, proszę, zebrać <w>pranie</w>, zanim zacznie padać.",
                                "de": "Bitte hilf mir, die <w>Wäsche</w> reinzuholen, bevor es anfängt zu regnen.",
                                "fr": "S'il te plaît, aide-moi à rentrer le <w>linge</w> avant qu'il ne commence à pleuvoir.",
                                "it": "Per favore, aiutami a ritirare i <w>panni</w> prima che inizi a piovere.",
