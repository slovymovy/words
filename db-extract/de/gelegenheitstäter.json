                        "sense_id": "020a3dcf-bd43-373a-8f67-0278295348a9",
                        "entry_id": "0c1d82aa-c273-332c-81ed-0e855df56b08",
                        "glosses": [
                            "Person, die von Zeit zu Zeit und nicht regelmäßig verwerfliche Taten (meist Straftaten) begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd92a077-53aa-4ecf-b2c9-59d13326aa64",
                                "sense_id": "020a3dcf-bd43-373a-8f67-0278295348a9",
                                "text": "Dressel ist doch nur ein Gelegenheitstäter. Wenn es passt, steckt er was ein, aber der ist gar nicht in der Lage, einen professionellen Überfall zu planen."
                            },
                            {
                                "example_id": "cfd40b2f-5f72-46c9-b03b-ed8ba441c5fb",
                                "sense_id": "020a3dcf-bd43-373a-8f67-0278295348a9",
                                "text": "„Sie hatten das Schloss an der Haustür und das an der Wohnungstür so vorsichtig aufgebrochen, dass dabei nur wenig Schaden entstanden war. Es handelte sich also offenbar um Profis, nicht um Gelegenheitstäter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
