                        "examples": [
                            {
                                "example_id": "8c7ffb81-b0f0-4bfa-9381-ec47004dd2eb",
                                "sense_id": "991ddaef-23c4-3c73-b7fc-3394606fcad0",
                                "text": "En 1905, le tiers seulement des séries aménagées de la pignade landaise subissait des coupes principales portant sur des bois àgés de 40 à 54 ans."
                            },
                            {
                                "example_id": "5784a97e-c5b6-4e7b-86ff-5bcde6fe9ebf",
                                "sense_id": "991ddaef-23c4-3c73-b7fc-3394606fcad0",
                                "text": "Les pignades (bois de pins) de futaie n’étaient guère plus gaies que les surettes (bois de liéges)."
                            },
                            {
                                "example_id": "9ae5058c-4397-44b8-8a39-34379f6bca1c",
                                "sense_id": "991ddaef-23c4-3c73-b7fc-3394606fcad0",
                                "text": "Thérèse trouvait étrange d'évoquer l'après-midi accablant, le ciel gorgé de fumée, le fuligineux azur, cette pénétrante odeur de torche qu'épandent les pignades consumées – et son propre cœur ensommeillé où prenait forme lentement le crime."
                            }
                        ]
                    }
