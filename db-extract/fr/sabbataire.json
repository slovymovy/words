                ],
                "senses": [
                    {
                        "sense_id": "9565bfd3-cd14-3c06-9838-e1ae77eb3492",
                        "entry_id": "7f47962d-72a2-3859-8f48-3e6298850cc5",
                        "glosses": [
                            "Juif converti qui, dans le premier siècle de l’Église chrétienne, était attaché à la célébration du sabbat et aux autres observances judaïques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5b1a473-ada2-3920-b98b-3c434a152531",
                        "entry_id": "7f47962d-72a2-3859-8f48-3e6298850cc5",
                        "glosses": [
                            "Anabaptiste qui observe le sabbat comme les Juifs, parce qu’il n'aurait été aboli par aucune loi dans le Nouveau Testament."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5656b657-1d61-460f-8ade-e8b399c88b9b",
                        "source_entry_id": "7f47962d-72a2-3859-8f48-3e6298850cc5",
                        "target_lang_word": "Sabbatarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sabbatarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbaf56af-92ce-3cfa-bcff-69ca6cda0128",
                                        "entry_id": "e940ea0b-b793-3fe4-b488-4e6b37c5435a",
                                        "glosses": [
                                            "A person who regards and keeps the seventh day of the week (\\\"Saturday\\\", the Israelite or Jewish Sabbath) as holy in conformity with the fourth commandment of the Decalogue, such as an Orthodox Jew, Seventh-day Adventist, Seventh Day Baptist, a member of the Church of God (Seventh Day); a Sabbath-keeper, a Saturday-keeper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f740e0d-0e5f-304d-866f-d83f05b56355",
                                        "entry_id": "e940ea0b-b793-3fe4-b488-4e6b37c5435a",
                                        "glosses": [
                                            "A person who regards and keeps the first day of the week as holy and often considers it as a replacement for the seventh-day Sabbath, a Sunday-keeper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8843376-6186-447d-839e-8e2761a123d0",
                                                "sense_id": "2f740e0d-0e5f-304d-866f-d83f05b56355",
                                                "text": "During the sixties [1860s] the Sabbatarians were particularly active in their attacks on Sunday excursions, and this had an effect both on the companies and the public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1248e97c-7406-3849-bb8c-78ab730f1d27",
                                        "entry_id": "e940ea0b-b793-3fe4-b488-4e6b37c5435a",
                                        "glosses": [
                                            "A person who favors the strict observance of the Sabbath (either the sixth, seventh, or first day of the week)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bcbd813-8a2b-34f9-b2ab-323f06b24540",
                                        "entry_id": "e940ea0b-b793-3fe4-b488-4e6b37c5435a",
                                        "glosses": [
                                            "A member of a non-Jewish religious sect originating in Russia distinguished by observance of Jewish rites and festivals including Saturday as the day of rest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Sabbatarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "291974b2-fb68-3119-a5d0-1e8763407e26",
                                        "entry_id": "b5c84255-9511-3357-a780-0e228cf60661",
                                        "glosses": [
                                            "Of or pertaining to the Sabbath, or the tenets of Sabbatarians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "267fc8eb-5a9b-409a-92f0-4143f7d67b81",
                                                "sense_id": "291974b2-fb68-3119-a5d0-1e8763407e26",
                                                "text": "The Newcastle & Carlisle Railway announced a special Sunday excursion from Newcastle to Carlisle for August 29, 1841, and immediately ran up against strong Sabbatarian opposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6de5f00c-5c4e-44be-82aa-3b3f24e55cfe",
                        "source_entry_id": "7f47962d-72a2-3859-8f48-3e6298850cc5",
                        "target_lang_word": "субботник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "субботник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad14b3f-2e95-3197-80a6-a8d1ddb32391",
                                        "entry_id": "3a028e63-113d-32f2-9af9-5b207e61e5f7",
                                        "glosses": [
                                            "советск. организованный неоплачиваемый труд на благо общества в свободное от работы время, в выходные (как правило, в субботу)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44fe879a-d755-4cd6-a819-789b3ace9f40",
                                                "sense_id": "6ad14b3f-2e95-3197-80a6-a8d1ddb32391",
                                                "text": "Днём рождения субботников считается 12 апреля 1919 года, когда в депо «Москва-Сортировочная» 15 коммунистов, проработав ночью 10 часов, отремонтировали три паровоза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55803b70-0ce5-32a6-9d96-7bf48f05d5ed",
                                        "entry_id": "3a028e63-113d-32f2-9af9-5b207e61e5f7",
                                        "glosses": [
                                            "устар. регулярное культурное мероприятие, которое устраивалось по субботам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000d0dd7-d08d-4ee4-b080-7400aa70fd86",
                                                "sense_id": "55803b70-0ce5-32a6-9d96-7bf48f05d5ed",
                                                "text": "Сегодняшний художественный субботник (Литейный, 58) обещает быть особенно интересным."
                                            },
                                            {
                                                "example_id": "76a4328c-d204-460a-a9e2-41915bdb8ffe",
                                                "sense_id": "55803b70-0ce5-32a6-9d96-7bf48f05d5ed",
                                                "text": "Уже несколько лет тому назад я возбуждал вопрос о незаконном участии наших артистов в этих субботниках, которые в прежнее время имели характер литературных вечеров, теперь же они дают не только формальные спектакли, но даже полные оперетки, что совершенно противозаконно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ee4ddb-7e61-3fbd-ab92-3fe8a1e71af6",
                                        "entry_id": "3a028e63-113d-32f2-9af9-5b207e61e5f7",
                                        "glosses": [
                                            "истор., школьн. порка в субботу за проступки, совершённые в течение недели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aa5cabe-684e-440e-85ad-eab6bbc57958",
                                                "sense_id": "81ee4ddb-7e61-3fbd-ab92-3fe8a1e71af6",
                                                "text": "В описываемые мною времена в киевской гимназии существовали ещё классические «субботники». ❬…❭ Я, лично, был высечен, и не очень больно, всего три раза в первом классе, по «субботникам», за ноли и единицы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf6c2c9-928e-3663-9ca1-7f1f7a03b2d7",
                                        "entry_id": "3a028e63-113d-32f2-9af9-5b207e61e5f7",
                                        "glosses": [
                                            "истор., разг. очерк или рассказ, написанный для публикации в рубрике «Субботники», выходившей в субботних выпусках ежедневной русской газеты «Новое время» (издавалась в 1868—1917 годах в Санкт-Петербурге)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070f6011-8c66-4c13-a9ad-d75773783021",
                                                "sense_id": "ccf6c2c9-928e-3663-9ca1-7f1f7a03b2d7",
                                                "text": "Хоть ты и говоришь, что я исписался, но я всё-таки завтра посылаю субботник. Субботник очень «вумный»! В нём много не ума, а «вума»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ff04f7-bd45-3641-a378-0388f50b0bf0",
                                        "entry_id": "3a028e63-113d-32f2-9af9-5b207e61e5f7",
                                        "glosses": [
                                            "жарг. бесплатное обслуживание проститутками сутенёра, его друзей и избранных клиентов"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "субботник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f8a7a1e9-2f1d-3fe0-a1fb-e40ca2d6bdd2",
                                        "entry_id": "847f954c-f57c-31ab-948a-608c578b61b4",
                                        "glosses": [
                                            "истор., религ. приверженец секты субботников среди русских в конце XVIII века, соблюдающих ветхозаветный закон о субботе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012a6747-d52e-435e-a23a-ec7e4b52c436",
                                                "sense_id": "f8a7a1e9-2f1d-3fe0-a1fb-e40ca2d6bdd2",
                                                "text": "Есть, правда, одна секта «субботников», или иудействующих христиан, насаждение которой приписывается еврею Схарию, но дух этой секты, почитающей за необходимое «исполнить прежде закон ветхий, а потом Христов», указывает, что происхождение такого учения сродно известным местам Евангелия, а не Ветхого Завета и не Талмуда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af3d497b-8a7f-3cd6-b015-c2bec5668368",
                                        "entry_id": "847f954c-f57c-31ab-948a-608c578b61b4",
                                        "glosses": [
                                            "истор., разг. посетитель регулярных мероприятий, устраиваемых по субботам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e637de37-649a-417d-8401-1048fd086c59",
                                                "sense_id": "af3d497b-8a7f-3cd6-b015-c2bec5668368",
                                                "text": "Посетители булгаковских вечеров на Дмитровке в доме Щученка, куда Константин Александрович перебрался по смерти отца, назывались «субботниками»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
