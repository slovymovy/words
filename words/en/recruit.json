{
    "word_family": [
        "recruitment",
        "recruiter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeda30b7-2134-36b0-b3c6-0a1c5d016fea",
                    "sense_definition": "To find and persuade people to join a company, an organization, or the armed forces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>recruit</w> more engineers to help with the new project.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>нанять</w> больше инженеров для помощи в новом проекте.",
                                "zh": "公司计划<w>招聘</w>更多工程师来协助新项目。"
                            }
                        },
                        {
                            "text": "They are trying to <w>recruit</w> volunteers to help clean up the local park.",
                            "target_lang_translations": {
                                "ru": "Они пытаются <w>набрать</w> добровольцев для уборки местного парка.",
                                "zh": "他们正在尝试<w>招募</w>志愿者来帮忙清理当地公园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hire",
                        "enlist",
                        "enroll",
                        "employ",
                        "sign up",
                        "take on"
                    ],
                    "antonyms": [
                        "fire",
                        "dismiss",
                        "discharge"
                    ],
                    "common_phrases": [
                        "recruit new members",
                        "recruit staff",
                        "recruit volunteers",
                        "actively recruit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находить и убеждать людей вступить в компанию, организацию или вооруженные силы.",
                        "zh": "寻找并说服人们加入公司、组织或军队。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нанимать",
                                "target_lang_sense_clarification": "брать на работу (общий термин)"
                            },
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "собирать группу людей, штат или волонтеров"
                            },
                            {
                                "target_lang_word": "вербовать",
                                "target_lang_sense_clarification": "привлекать к службе (часто военной) или в организацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "招聘",
                                "target_lang_sense_clarification": "指公司招募员工"
                            },
                            {
                                "target_lang_word": "招募",
                                "target_lang_sense_clarification": "指招集人员加入组织或军队"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a7dcd3a-5b50-3277-9bde-36ebe7a1834c",
                    "sense_definition": "To attract or activate cells, such as immune cells, to a specific area of the body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The immune system releases chemicals to <w>recruit</w> white blood cells to the site of infection.",
                            "target_lang_translations": {
                                "ru": "Иммунная система выделяет химические вещества, чтобы <w>привлечь</w> лейкоциты к месту инфекции.",
                                "zh": "免疫系统释放化学物质，将白细胞<w>募集</w>到感染部位。"
                            }
                        },
                        {
                            "text": "Signals from the damaged tissue help <w>recruit</w> stem cells to begin the repair process.",
                            "target_lang_translations": {
                                "ru": "Сигналы от поврежденных тканей помогают <w>мобилизовать</w> стволовые клетки для начала процесса восстановления.",
                                "zh": "来自受损组织的信号有助于<w>动员</w>干细胞开始修复过程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mobilize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать или активировать клетки (например, иммунные) в определенной области тела.",
                        "zh": "吸引或激活身体特定区域的细胞（如免疫细胞）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "активировать для действия (биол.)"
                            },
                            {
                                "target_lang_word": "привлекать",
                                "target_lang_sense_clarification": "притягивать к определенному месту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "募集",
                                "target_lang_sense_clarification": "生物学中指将细胞聚集到某处"
                            },
                            {
                                "target_lang_word": "动员",
                                "target_lang_sense_clarification": "指调动细胞参与生理过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4485e366-f514-3846-be88-d66ec906267d",
                    "sense_definition": "To restore or regain health, energy, or strength.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the countryside to <w>recruit</w> his health after a long illness.",
                            "target_lang_translations": {
                                "ru": "Он отправился в деревню, чтобы <w>восстановить</w> здоровье после долгой болезни.",
                                "zh": "大病一场后，他去乡下<w>恢复</w>健康。"
                            }
                        },
                        {
                            "text": "She needed a few days of rest to <w>recruit</w> her spirits before returning to work.",
                            "target_lang_translations": {
                                "ru": "Ей нужно было несколько дней отдыха, чтобы <w>восстановить</w> душевные силы перед возвращением к работе.",
                                "zh": "在重返工作岗位前，她需要休息几天来<w>恢复</w>精神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recover",
                        "recuperate",
                        "restore"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "standard in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливать или возвращать здоровье, энергию или силы.",
                        "zh": "恢复健康、精力或体力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "возвращать в прежнее состояние"
                            },
                            {
                                "target_lang_word": "поправлять",
                                "target_lang_sense_clarification": "улучшать здоровье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指身体或精神状态回到正常"
                            },
                            {
                                "target_lang_word": "调养",
                                "target_lang_sense_clarification": "指通过休息改善健康状况"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1da30f0a-53d1-301b-a163-b992b64035bb",
                    "sense_definition": "A person who has recently joined the armed forces or the police and is still being trained.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "hiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant shouted orders at the new <w>recruits</w> on the parade ground.",
                            "target_lang_translations": {
                                "ru": "Сержант выкрикивал приказы новым <w>новобранцам</w> на плацу.",
                                "zh": "中士在操场上对<w>新兵</w>大声下达命令。"
                            }
                        },
                        {
                            "text": "Every <w>recruit</w> must pass a strict physical fitness test before joining the unit.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>новобранец</w> должен пройти строгий тест на физическую подготовку перед вступлением в подразделение.",
                                "zh": "每名<w>新兵</w>在加入部队前都必须通过严格的体能测试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conscript",
                        "trainee",
                        "enlistee"
                    ],
                    "antonyms": [
                        "veteran"
                    ],
                    "common_phrases": [
                        "army recruit",
                        "police recruit",
                        "raw recruit",
                        "new recruit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который недавно вступил в вооруженные силы или полицию и проходит обучение.",
                        "zh": "刚加入军队或警察部队且仍在接受训练的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новобранец",
                                "target_lang_sense_clarification": "солдат, недавно призванный на службу"
                            },
                            {
                                "target_lang_word": "призывник",
                                "target_lang_sense_clarification": "лицо, подлежащее призыву на военную службу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新兵",
                                "target_lang_sense_clarification": "指刚入伍的士兵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9476665b-37f8-3e5f-8d43-721260270ba2",
                    "sense_definition": "A new member of an organization, company, or team.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager introduced the new <w>recruits</w> to the rest of the office staff.",
                            "target_lang_translations": {
                                "ru": "Менеджер представил новых <w>сотрудников</w> остальному персоналу офиса.",
                                "zh": "经理向办公室的其他员工介绍了这些<w>新员工</w>。"
                            }
                        },
                        {
                            "text": "We are looking for a bright young <w>recruit</w> to join our sales department.",
                            "target_lang_translations": {
                                "ru": "Мы ищем способного молодого <w>сотрудника</w> в наш отдел продаж.",
                                "zh": "我们正在寻找一位聪明的年轻人作为<w>新员工</w>加入销售部。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hire",
                        "newcomer",
                        "novice",
                        "appointee"
                    ],
                    "common_phrases": [
                        "fresh recruit",
                        "potential recruit",
                        "latest recruit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новый член организации, компании или команды.",
                        "zh": "组织、公司或团队的新成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новый сотрудник",
                                "target_lang_sense_clarification": "человек, недавно принятый на работу"
                            },
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "новый участник команды или группы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新员工",
                                "target_lang_sense_clarification": "指刚加入公司的人"
                            },
                            {
                                "target_lang_word": "新人",
                                "target_lang_sense_clarification": "指刚加入团队或组织的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}