    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7da85e52-8763-3a35-a5d1-843547563a47",
                    "sense_definition": "Qui s'avance ou se développe de façon continue et par degrés.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "graduel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a constaté une amélioration <w>progressive</w> de son état de santé."
                        },
                        {
                            "text": "Ce village de montagne subit un déclin <w>progressif</w> du nombre de ses habitants."
                        }
                    ],
                    "antonyms": [
                        "régressif"
                    ],
                    "common_phrases": [
                        "déclin progressif",
                        "amélioration progressive"
                    ]
                },
                {
                    "sense_id": "78c5aa1b-e9b5-3d18-aef2-427ff8de75bf",
                    "sense_definition": "Dont le taux augmente au fur et à mesure que la valeur imposée s'élève.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fiscalité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans plusieurs pays, l'impôt <w>progressif</w> permet de réduire les inégalités économiques."
                        },
                        {
                            "text": "La ville a mis en place une taxe <w>progressive</w> sur les consommations d'énergie."
                        }
                    ],
                    "antonyms": [
                        "régressif"
                    ],
                    "common_phrases": [
                        "impôt progressif",
                        "taxe progressive"
                    ]
                },
                {
                    "sense_id": "f07d26c5-7b03-3624-a60f-123a04697fb6",
                    "sense_definition": "Qualifie des verres correcteurs dont la puissance varie pour permettre de voir net de près comme de loin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "optique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'opticien lui a conseillé d'acheter des verres <w>progressifs</w> pour corriger sa presbytie."
                        },
                        {
                            "text": "Il faut souvent quelques jours d'adaptation pour s'habituer à de nouvelles lunettes <w>progressives</w>."
                        }
                    ],
                    "common_phrases": [
                        "verres progressifs",
                        "lunettes progressives"
                    ]
                },
                {
                    "sense_id": "809da7e4-a070-3702-bb00-dc04306c11da",
                    "sense_definition": "Qui favorise ou recherche le progrès technique, social ou politique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "progrès",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe défendait une vision <w>progressive</w> de l'histoire et de la société."
                        },
                        {
                            "text": "Certains membres du parlement soutiennent des idées <w>progressives</w> en matière d'éducation."
                        }
                    ],
                    "synonyms": [
                        "progressiste"
                    ],
                    "common_phrases": [
                        "idées progressives",
                        "société progressive"
                    ]
                },
                {
                    "sense_id": "2506befd-d67b-34b6-a5b6-f605183830ba",
                    "sense_definition": "Qui correspond à un déplacement physique ou matériel vers l'avant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mouvement <w>progressif</w> de l'animal est freiné par la boue sur le chemin."
                        },
                        {
                            "text": "Les physiciens analysent la propagation d'une onde <w>progressive</w> à la surface d'un liquide."
                        }
                    ],
                    "common_phrases": [
                        "mouvement progressif",
                        "onde progressive"
                    ]
                },
                {
                    "sense_id": "fc0b4c31-1dcb-3024-b075-48e191655770",
                    "sense_definition": "Qui gagne peu à peu différentes parties du corps ou s'intensifie par étapes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "médical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient présente une paralysie <w>progressive</w> qui commence par toucher les jambes."
                        },
                        {
                            "text": "Cette affection <w>progressive</w> nécessite une surveillance médicale accrue dès son apparition."
                        }
                    ],
                    "common_phrases": [
                        "paralysie progressive"
                    ]
                }
            ]
        }
    ]
}