                ],
                "senses": [
                    {
                        "sense_id": "6ddba9a4-7fd7-377f-b6d4-92d0d7d0301f",
                        "entry_id": "b081c09e-3206-3986-96fc-1d92396c31ba",
                        "glosses": [
                            "Haushaltsgerät zum automatischen Waschen und Trocknen von Wäsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34970204-6464-4403-8b99-2a8a8aaa3be8",
                                "sense_id": "6ddba9a4-7fd7-377f-b6d4-92d0d7d0301f",
                                "text": "Der Waschtrockner ist erst 1½ Jahre alt und wäscht gut, aber er trocknet nicht mehr; offensichtlich ist der Thermostat kaputt, da es beim Trocknen nicht mehr warm dabei wird."
                            },
                            {
                                "example_id": "8eb0e1a9-6343-430b-9858-83e37ad7c484",
                                "sense_id": "6ddba9a4-7fd7-377f-b6d4-92d0d7d0301f",
                                "text": "„Alles auf einen Blick. Altmaier beschloss, nicht nur zu hausen, sondern zu wohnen, steckte 20 000 Mark in die Wohnung, kaufte Möbel, Geschirrspüler und Waschtrockner. Das ist ein Gerät, das wäscht und trocknet, erklärt er, selbst noch ein wenig erstaunt, dass es so etwas gibt.“"
                            },
                            {
                                "example_id": "09d950aa-fb31-424c-9260-3c01ef48d5b3",
                                "sense_id": "6ddba9a4-7fd7-377f-b6d4-92d0d7d0301f",
                                "text": "„Ich hoffe, ich entgehe einer Zwangseinweisung und nehme mir ganz fest vor, bis zum Herbst endlich einen Waschtrockner zu besorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
