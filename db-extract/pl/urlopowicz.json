                        "source_sense_id": "8d992931-4e48-3bb5-8779-d12f28d40eb0",
                        "target_lang_word": "vacancier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacancier",
