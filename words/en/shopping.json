    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53440937-cba2-3c58-ad9e-105fe6634496",
                    "sense_definition": "The activity of visiting stores to buy goods or services.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On Saturdays we usually do the <w>shopping</w> for the whole week.",
                            "target_lang_translations": {
                                "ru": "По субботам мы обычно делаем <w>покупки</w> на всю неделю.",
                                "zh": "我们通常在周六<w>采购</w>一周所需的物品。"
                            }
                        },
                        {
                            "text": "She loves going <w>shopping</w> for new clothes at the mall.",
                            "target_lang_translations": {
                                "ru": "Она любит ездить на <w>шоппинг</w> за новой одеждой в торговый центр.",
                                "zh": "她喜欢去商场<w>逛街</w>买新衣服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "purchasing",
                        "buying"
                    ],
                    "antonyms": [
                        "selling"
                    ],
                    "common_phrases": [
                        "go shopping",
                        "do the shopping",
                        "online shopping",
                        "shopping center",
                        "shopping list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по посещению магазинов с целью покупки товаров или услуг.",
                        "zh": "前往商店购买商品或服务的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупки",
