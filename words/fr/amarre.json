            "senses": [
                {
                    "sense_id": "1b4ac04a-1b83-3743-91af-fd2c4a6b3b5b",
                    "sense_definition": "Cordage ou câble servant à immobiliser un bateau à un quai ou à un autre navire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cordage_maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le matelot a lancé une solide <w>amarre</w> vers le quai pour immobiliser le voilier."
                        },
                        {
                            "text": "Dès que l'équipage a pu larguer les <w>amarres</w>, le navire a pris le large."
                        }
                    ],
                    "common_phrases": [
                        "larguer les amarres",
                        "lâcher les amarres",
                        "rompre ses amarres"
                    ]
                },
                {
                    "sense_id": "3936c88f-437a-3aaa-a4d1-3b27065f6bc8",
                    "sense_definition": "Corde, câble ou lien utilisé pour attacher solidement un objet quelconque.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cordage_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendu une <w>amarre</w> autour des caisses pour éviter qu'elles ne bougent pendant le trajet."
                        },
                        {
                            "text": "La grande tente était solidement fixée au sol grâce à une <w>amarre</w> accrochée à un piquet."
                        }
                    ]
                },
                {
                    "sense_id": "ee96f68f-66a8-3132-8a05-6dc129014875",
                    "sense_definition": "Pièce de bois percée en son milieu dans laquelle passait l'axe d'un moulinet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mecanique_ancienne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan a examiné l'<w>amarre</w> en bois afin de comprendre le mécanisme du vieux treuil."
                        },
                        {
                            "text": "Dans cet engin de levage, chaque <w>amarre</w> servait à maintenir l'axe de rotation bien en place."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Terme technique ancien"
                        }
                    ]
                }
            ]
        },
        {
