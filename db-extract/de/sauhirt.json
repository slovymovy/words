                                        "sense_id": "0dbfd6f6-2722-31c0-a1e2-fe0d0ccc6b42",
                                        "entry_id": "f7162c3b-01ad-35b1-a99f-27c9bc78d0f6",
                                        "glosses": [
                                            "A person who herds and tends swine, a keeper of swine (pigs)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c55b06-85e5-42c2-bf9e-795a5628400d",
                                                "sense_id": "0dbfd6f6-2722-31c0-a1e2-fe0d0ccc6b42",
                                                "text": "But what of that vast number of the human kind who were always in the background? What of the hewers of wood and drawers of water, the swineherds, the shepherds, the carpenters, the hedgers and cobblers?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
