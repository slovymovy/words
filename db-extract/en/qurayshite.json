                "senses": [
                    {
                        "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                        "entry_id": "2bc58843-a739-39d6-8304-6f39bb3a0079",
                        "glosses": [
                            "part of, or descended from, the Quraysh tribe."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "03036731-c533-4ad1-ba01-3d397df3eb68",
                                "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                "text": "A member of the Qurayshite Umayyad family wanted to claim the poet al-Farazdaq's bride al-Nawār, though the poet thought he could prove that he had a clear claim because he had paid the bride price."
                            },
                            {
                                "example_id": "e1219159-5a66-4f6f-a514-0cc5cb2e66b1",
                                "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                "text": "If anyone comes to Muhammad from the Qurayshite camp without the permission of his superiors, he [Muhammad] will send him back; however, if any of those who are with Muhammad comes to the Qurayshite camp, they [the Qurayshites] will not send him back."
                            },
                            {
                                "example_id": "3075fc56-1054-48ad-95e2-8f33497db191",
                                "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                "text": "He sought to understand the social contexts in which Qurayshite descent was a reasonable condition and those in which it was not."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
