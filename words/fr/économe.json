    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "330e22d7-5540-358e-9117-83a344e12acc",
                    "sense_definition": "Qui évite les dépenses superflues et gère ses biens ou son argent avec modération.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "epargne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est très <w>économe</w> et met de l'argent de côté chaque mois pour voyager."
                        },
                        {
                            "text": "Une personne <w>économe</w> préfère cuisiner à la maison plutôt que de commander au restaurant."
                        }
                    ],
                    "synonyms": [
                        "parcimonieux",
                        "prévoyant",
                        "modéré"
                    ],
                    "antonyms": [
                        "dépensier",
                        "gaspilleur"
                    ]
                },
                {
                    "sense_id": "7be1f223-bafc-39a3-ab88-3c8aa1ccfab7",
                    "sense_definition": "Qui fait un usage mesuré ou limité de quelque chose, comme de son temps ou de ses efforts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "epargne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute la réunion, cet homme discret s'est montré particulièrement <w>économe</w> de ses paroles."
                        },
                        {
                            "text": "Le coureur de fond doit rester <w>économe</w> de ses forces au début de la course."
                        }
                    ],
                    "synonyms": [
                        "modéré",
                        "parcimonieux",
                        "sobre"
                    ],
                    "antonyms": [
                        "prodigue"
                    ],
                    "common_phrases": [
                        "économe de ses paroles",
                        "économe de ses forces"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90e790a4-048c-3e6c-866c-102d78187e95",
                    "sense_definition": "Ustensile de cuisine servant à retirer finement la peau des fruits et des légumes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il attrape l'<w>économe</w> pour peler rapidement les pommes de terre avant de les cuire."
                        },
                        {
                            "text": "N'oublie pas de nettoyer l'<w>économe</w> après avoir épluché toutes les carottes."
                        }
                    ],
                    "synonyms": [
                        "éplucheur",
                        "épluche-légumes",
                        "couteau éplucheur",
                        "épluchoir"
                    ]
                },
                {
                    "sense_id": "c74496fe-9176-3b90-a0f3-a2910e72408c",
                    "sense_definition": "Personne chargée de la gestion matérielle, des approvisionnements ou de la comptabilité d'une collectivité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>économe</w> du pensionnat vérifie minutieusement chaque commande de denrées alimentaires."
                        },
                        {
                            "text": "Toutes les dépenses matérielles de l'établissement doivent recevoir l'accord préalable de l'<w>économe</w>."
                        }
                    ],
                    "common_phrases": [
                        "économe en chef"
                    ]
                }
            ]
        }
    ]
