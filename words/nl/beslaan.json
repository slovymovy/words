{
    "word_family": [
        "beslag",
        "beslaglegging",
        "hoefbeslag"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0edd7e90-3559-3acb-a179-3eb73064abe4",
                    "sense_definition": "Een bepaalde ruimte of oppervlakte innemen of bestrijken.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ruimte_innemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe fabriek zal een enorm <w>beslaan</w> van wel tien hectare.",
                            "target_lang_translations": {
                                "en": "The new factory will <w>occupy</w> a huge area of up to ten hectares."
                            }
                        },
                        {
                            "text": "Noord-Brabant <w>beslaat</w> een gebied van 4919 vierkante kilometer.",
                            "target_lang_translations": {
                                "en": "North Brabant <w>covers</w> an area of 4,919 square kilometers."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestrijken",
                        "innemen",
                        "bezetten"
                    ],
                    "common_phrases": [
                        "een gebied beslaan",
                        "een oppervlakte beslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To occupy or cover a certain space or surface area."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "to occupy a certain area or space"
                            },
                            {
                                "target_lang_word": "comprise",
                                "target_lang_sense_clarification": "to consist of or encompass a certain area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f03750b5-3bac-3a4e-9deb-fbd2ec85c2cd",
                    "sense_definition": "Door condensatie van waterdamp dof, vochtig of ondoorzichtig worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condensatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ruiten <w>besloegen</w> volledig waardoor ik tijdens het rijden niets meer kon zien.",
                            "target_lang_translations": {
                                "en": "The windows <w>fogged up</w> completely, so I couldn't see anything while driving."
                            }
                        },
                        {
                            "text": "Zodra je van de kou naar binnen stapt, zullen je brillenglazen direct <w>beslaan</w>.",
                            "target_lang_translations": {
                                "en": "As soon as you step inside from the cold, your glasses will immediately <w>mist up</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanslaan",
                        "condenseren"
                    ],
                    "common_phrases": [
                        "brillenglazen beslaan",
                        "ramen beslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To become dull, damp, or opaque due to the condensation of water vapor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fog up",
                                "target_lang_sense_clarification": "of glass or mirrors, becoming covered in condensation"
                            },
                            {
                                "target_lang_word": "mist up",
                                "target_lang_sense_clarification": "of windows or lenses, becoming covered in light condensation"
                            },
                            {
                                "target_lang_word": "condense",
                                "target_lang_sense_clarification": "to have water vapor turn into liquid on a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e23d8a97-4bae-3a56-9795-cabf58c847a6",
                    "sense_definition": "Een paard voorzien van hoefijzers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "paardenverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoefsmid moest gisteren het onrustige paard opnieuw <w>beslaan</w>.",
                            "target_lang_translations": {
                                "en": "The farrier had to <w>shoe</w> the restless horse again yesterday."
                            }
                        },
                        {
                            "text": "Het paard werd vakkundig <w>beslagen</w> voordat het aan de lange tocht begon.",
                            "target_lang_translations": {
                                "en": "The horse was professionally <w>shod</w> before starting the long journey."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een paard beslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To fit a horse with horseshoes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shoe",
                                "target_lang_sense_clarification": "to fit a horse with metal shoes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e8dd116-9456-378d-bc94-f6cc34d237ec",
                    "sense_definition": "Geheel omgeven of bedekken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ruimte_innemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dichte mist leek het hele landschap te <w>beslaan</w>.",
                            "target_lang_translations": {
                                "en": "The dense fog seemed to <w>shroud</w> the entire landscape."
                            }
                        },
                        {
                            "text": "Met een fijne laag goudstof wist de kunstenaar het beeld te <w>beslaan</w>.",
                            "target_lang_translations": {
                                "en": "The artist managed to <w>coat</w> the statue with a fine layer of gold dust."
                            }
                        }
                    ],
                    "synonyms": [
                        "omgeven",
                        "bedekken",
                        "omhullen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In de betekenis van omgeven of bedekken is het woord verouderd."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To completely surround or cover."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "to completely coat or overlay a surface"
                            },
                            {
                                "target_lang_word": "shroud",
                                "target_lang_sense_clarification": "to cover or envelop so as to conceal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}