                                                "example_id": "3865bd2b-6c50-4c4a-b0bc-6aba6a9c0939",
                                                "sense_id": "66096238-09a7-329f-bbad-af8466d84aa8",
                                                "text": "But his words died in a strange gurgling in the throat; the eyes suddenly became fixed; the mouth fell; once he stretched out his hands convulsively, but they instantly relaxed, and his head sunk on Norbourne's arm."
                                            },
                                            {
                                                "example_id": "63673fba-4b3e-4da5-8d85-530f35ef68b4",
                                                "sense_id": "66096238-09a7-329f-bbad-af8466d84aa8",
                                                "text": "Her thumb and nail lightly flicked the palm of my hand until I could bear it no longer and closed my hand convulsively over hers."
                                            }
                                        ]
