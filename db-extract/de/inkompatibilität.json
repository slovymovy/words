                "senses": [
                    {
                        "sense_id": "62892d95-4052-32c5-82ca-40de42df7f37",
                        "entry_id": "337134c4-9813-3cd5-b1b3-de60d8de3f2e",
                        "glosses": [
                            "die Eigenschaft, nicht kompatibel zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc6eaa2-6c6c-4bc5-9ef8-8bbe1cd46ac2",
                                "sense_id": "62892d95-4052-32c5-82ca-40de42df7f37",
                                "text": "„Die Inkompatibilität ist die Unvereinbarkeit der gleichzeitigen Ausübung öffentlicher Funktionen in verschiedenen Gewalten und wird aus dem Grundsatz der Gewaltenteilung hergeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "293000b8-7ef6-347f-91cc-dfad245846d3",
                        "entry_id": "337134c4-9813-3cd5-b1b3-de60d8de3f2e",
                        "glosses": [
                            "mangelnde Verträglichkeit, Kombinierbarkeit sprachlicher Elemente im Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed3e12ca-1add-4f6a-985d-bbadb484c556",
                                "sense_id": "293000b8-7ef6-347f-91cc-dfad245846d3",
                                "text": "„Auf semantischen Merkmalen als bedeutungskonstitutiven Elementen beruhen Kompatibilität oder Inkompatibilität lexikalischer Einheiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
