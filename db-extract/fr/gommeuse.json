                "senses": [
                    {
                        "sense_id": "cfe93960-6fb6-3d14-a417-5a9813307a8f",
                        "entry_id": "df3bbd77-c220-35bf-a94a-b2fc54d71c7e",
                        "glosses": [
                            "Personne élégante, prétentieuse, désœuvrée et vaniteuse."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "210ac4c2-f27d-4424-bb91-b8272f3ee015",
                                "sense_id": "cfe93960-6fb6-3d14-a417-5a9813307a8f",
                                "text": "J’ai une voiture, disait une gommeuse à la mode."
                            },
                            {
                                "example_id": "a6ea8cb5-2f18-40a8-9d49-9a89871f6699",
                                "sense_id": "cfe93960-6fb6-3d14-a417-5a9813307a8f",
                                "text": "Des bandits, un pendu, des moines gloutons, un bossu, une maquerelle. Une jeune gommeuse qui refuse l'aumône à sa propre mère ; une autre qui ajuste son bas : « Il est bien tiré »."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf70e376-2c90-382e-a47e-f9408891c9ad",
                        "entry_id": "df3bbd77-c220-35bf-a94a-b2fc54d71c7e",
                        "glosses": [
                            "Chanteuse de café-concert."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ec039483-7687-4242-aae3-ce583623dc40",
                                "sense_id": "cf70e376-2c90-382e-a47e-f9408891c9ad",
                                "text": "Un caf' conc' du boulevard de Sébastopol avec ses gommeuses, ses chanteuses de genre."
                            },
                            {
                                "example_id": "4370a8d1-1c5d-4c62-8919-dcd73aa6005f",
                                "sense_id": "cf70e376-2c90-382e-a47e-f9408891c9ad",
                                "text": "Des cravates qui hurlaient sur tous les tons et sans doute coupées dans les robes à paillettes d'une ancienne gommeuse des « Folies-Bergère »."
                            },
                            {
                                "example_id": "0ee3370f-a3e9-410e-ae09-91df58141758",
                                "sense_id": "cf70e376-2c90-382e-a47e-f9408891c9ad",
                                "text": "Sa robe de scène, sa robe parfaite de « gommeuse » manifestait le goût et l’invention de Madame Landolff, costumière qui n’a pas été égalée."
                            }
                        ]
                    }
                ],
