                ],
                "senses": [
                    {
                        "sense_id": "d4919289-3776-3b68-80ff-7ea736b5f57a",
                        "entry_id": "9b572411-f3d4-30cf-bfa2-dc97f8da2722",
                        "glosses": [
                            "Licht, das von einer Lampe ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbd0fab-a248-414d-9e16-14285a3ba45f",
                                "sense_id": "d4919289-3776-3b68-80ff-7ea736b5f57a",
                                "text": "„Das Lampenlicht, das von der Kirche nach oben flutet, scheint ein Stück Dunkelheit in den geheimnisvollen Himmel zu tragen, einen eisernen Kern.“"
                            },
                            {
                                "example_id": "95dfd093-33c1-4389-af08-35ac274510a0",
                                "sense_id": "d4919289-3776-3b68-80ff-7ea736b5f57a",
                                "text": "„Das Lampenlicht spiegelte sich in ihren Augen.“"
                            },
                            {
                                "example_id": "1637f75e-9ff3-4f99-8935-f8a875c7328a",
                                "sense_id": "d4919289-3776-3b68-80ff-7ea736b5f57a",
                                "text": "„Vom Lampenlicht sahen die Zeitungen in den Fenstern orangefarben aus.“"
                            },
                            {
                                "example_id": "1c7b120d-84de-4d15-b7ff-7e8d53d0dfa3",
                                "sense_id": "d4919289-3776-3b68-80ff-7ea736b5f57a",
                                "text": "„Simen Tjing blickte mit weit aufgerissenen Augen bei dem Lampenlichte scharf hin: Es war Goldlotos, die sich mit flachem Haarknoten als Mädchen verkleidet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
