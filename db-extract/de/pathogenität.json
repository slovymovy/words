                        "sense_id": "3ab450f5-8777-31c0-a42c-3abbcee7c579",
                        "entry_id": "546ac46f-3b8e-3c67-ac9c-0753ac4784e1",
                        "glosses": [
                            "Eigenschaft von Stoffen oder Kleinstlebewesen, Krankheiten/krankhafte Veränderungen auslösen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3115aa5c-7a7c-4a06-9b7a-2925294c492b",
                                "sense_id": "3ab450f5-8777-31c0-a42c-3abbcee7c579",
                                "text": "„Die krankmachende Fähigkeit eines Erregers nennt man seine Pathogenität (von pathos, das Leiden) oder seine Expressivität (seine Fähigkeit, Symptome zu erzeugen).“"
                            },
                            {
                                "example_id": "e684c1b7-9990-468c-987a-572ae1d1a34f",
                                "sense_id": "3ab450f5-8777-31c0-a42c-3abbcee7c579",
                                "text": "„Die Pathogenität von Viren ist die Voraussetzung für die Entstehung von Krankheiten. Sie kommt durch vielfältige Eigenschaften des Wirtes und des Virus zustande.“"
                            }
                        ],
