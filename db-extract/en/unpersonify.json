                        "entry_id": "8d088722-d354-35a5-ad4e-355e53dd1f56",
                        "glosses": [
                            "To undo the personification of; to remove the personhood of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba8051b-3166-4dc4-b181-61e7fefacdde",
                                "sense_id": "7bb9ec9c-55ab-3b1b-b952-d75e08f246a8",
                                "text": "[…] with a life-destroying, hideous article clumsily stuck before the personified noun to unpersonify it, to make masculine what should be feminine, […]"
                            },
                            {
                                "example_id": "4cbb7465-ccbf-4411-8d7b-c7ee62386a68",
                                "sense_id": "7bb9ec9c-55ab-3b1b-b952-d75e08f246a8",
                                "text": "Now he found it did nothing to unpersonify them. He'd loved his steed. He'd loved his hound. Their blood had been red."
                            }
                        ]
                    }
