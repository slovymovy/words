                                "example_id": "1fabf89d-61eb-41cf-b707-a656433e2fcc",
                                "sense_id": "79812b7b-5dc7-329b-a657-32f37bf2645e",
                                "text": "Grapjes, dolletjes, in-de-zeik-nemertjes maken de jongens ook niet. Dat kan ook niet. Welke grap kun je hierover in hemelsnaam bedenken?"
                            },
                            {
                                "example_id": "afc051e5-c7b8-478f-ab5f-2d3d5d326ca7",
                                "sense_id": "79812b7b-5dc7-329b-a657-32f37bf2645e",
                                "text": "Thans leggen de kievieten hare eijeren zeer in de laagte, op kleine dolletjes of hoogten, midden in het water, hetwelk een droogen zomer, althans voorzomer, voorspelt."
                            }
                        ]
                    }
