                "senses": [
                    {
                        "sense_id": "417dfe5c-580c-336c-8d81-cf7033f9f35b",
                        "entry_id": "e0ea1be1-367a-3cae-99bb-76937c1bb20a",
                        "glosses": [
                            "Standort fern vom Zentrum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a3f19e-3b6b-48ca-becb-a6e4d54b4904",
                                "sense_id": "417dfe5c-580c-336c-8d81-cf7033f9f35b",
                                "text": "„Die Geschichte von Tsumkwe, diesem Außenposten im Busch, entspricht der Geschichte von Schwarzafrika, es ist die Geschichte Afrikas in einer Parabel von Ausbeutung und Verfall.“"
                            },
                            {
                                "example_id": "23f34b5e-7af0-420b-872c-29c793ba22d8",
                                "sense_id": "417dfe5c-580c-336c-8d81-cf7033f9f35b",
                                "text": "„Die Stämme schreckten nicht davor zurück, militärische Außenposten anzugreifen, Garnisonen zu belagern und sich den Briten sogar in offenen Schlachten zu stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
