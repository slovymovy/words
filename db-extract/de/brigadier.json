                                        "sense_id": "1f227090-90fd-3faf-9b30-491025c0c6b6",
                                        "entry_id": "ec9ca07d-af05-3155-ab4b-291c42e0edca",
                                        "glosses": [
                                            "A field officer of the highest grade, below general officers, NATO grade O7."
