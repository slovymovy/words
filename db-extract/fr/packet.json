                        "entry_id": "8ee3bfa0-f135-3365-827a-d2bbf1c75644",
                        "glosses": [
                            "Navire d'une ligne régulière."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "72213905-0b61-4436-bca0-19317c514bea",
                                "sense_id": "9aab5de2-0d59-3fdd-abac-01a9fe311468",
                                "text": "Sur l’avis de M. le résident, je dus prendre passage, le 25, sur le packet allant à Batavia et qui passe chaque mois à Coupang."
                            },
                            {
                                "example_id": "a914192c-f8c5-4205-bccf-c9bc026310d5",
                                "sense_id": "9aab5de2-0d59-3fdd-abac-01a9fe311468",
                                "text": "Par le packet de Janvier qui nous amenait le P. Klaine nous est aussi arrivé Mr Louis Petit, jeune naturaliste que Mr Bouvier m’avait recommandé voilà 2 ans."
                            },
                            {
                                "example_id": "661806d9-3deb-429f-87a0-638f6b5beb81",
                                "sense_id": "9aab5de2-0d59-3fdd-abac-01a9fe311468",
                                "text": "Après six mois de séjour dans notre charmante colonie, je repris le chemin de la France, non sur un vaisseau de guerre, mais sur le packet qui fait deux fois par mois le trajet de Saint-Namire à la Vera-Cruz."
                            }
                        ]
                    }
