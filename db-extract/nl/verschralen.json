                                            {
                                                "example_id": "157a884b-c049-44ed-a1bc-95f1b1880eee",
                                                "sense_id": "1c98dd99-6a5e-3f50-abe2-90d2f66e0109",
                                                "text": "A manor-house clock from the far depths of shadow struck the hour, one, in a small, attenuated tone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a0cb9b-cf55-39d8-829c-ae8ff82836aa",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To make thinner, as by physically reshaping, starving, or decaying."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45639451-a7e3-41da-9e20-f2d1afdd654b",
                                                "sense_id": "44a0cb9b-cf55-39d8-829c-ae8ff82836aa",
                                                "text": "Clumps of attenuated turkeys were suspended here and there."
                                            },
                                            {
                                                "example_id": "a3fb69b7-6732-488c-9c1c-b21c08de4082",
                                                "sense_id": "44a0cb9b-cf55-39d8-829c-ae8ff82836aa",
                                                "text": "Lovell, wan and hollow-eyed, his arm in a sling, his once burly frame gaunt and attenuated with disease, nodded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29728cde-2ae6-3c1b-83f5-c1d0daf5474c",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To become thin or fine; to grow less."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5437186-d714-3ec6-8cda-91c84529b8b0",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To weaken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15c84f8-abba-4e16-ba44-8e08be637097",
                                                "sense_id": "e5437186-d714-3ec6-8cda-91c84529b8b0",
                                                "text": "We may reject and reject till we attenuate history into sapless meagreness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6289ed96-daf8-3797-9a3c-64acb6d81dc1",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To rarefy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71da268c-0fca-41f1-8e65-ab2774450296",
                                                "sense_id": "6289ed96-daf8-3797-9a3c-64acb6d81dc1",
                                                "text": "\"It speedily became apparent that the entire strangeness of our circumstances and surroundings—great loss of weight, attenuated but highly oxygenated air, consequent exaggeration of the results of muscular effort, rapid development of weird plants from obscure spores, lurid sky—was exciting my companion unduly.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "649fd047-a266-389f-b96a-a5f2532f86ca",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To reduce the virulence of a bacterium or virus."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5686a101-ca57-351e-8e64-d00b15e3cd8c",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To reduce the amplitude of an electrical, radio, or optical signal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e61a54b-d563-3a0b-b96c-439abe13f2ea",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "(of a beer) To become less dense as a result of the conversion of sugar to alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fade1134-415d-4a2a-b6be-3988c07b61b0",
                                                "sense_id": "3e61a54b-d563-3a0b-b96c-439abe13f2ea",
                                                "text": "A beer which does not attenuate to the expected level in fermentation will have more residual sugar and thus be sweeter and heavier-bodied."
                                            }
                                        ]
                                    }
                                ]
