    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f56ef58-93ac-3893-bec7-05b8046b2b71",
                    "sense_definition": "Débarrasser le nez de ses mucosités en soufflant dans un mouchoir, ou nettoyer le nez d'une autre personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand tu as un rhume, pense à te <w>moucher</w> avec un mouchoir propre."
                        },
                        {
                            "text": "La mère s'arrête un instant pour <w>moucher</w> son petit garçon en larmes."
                        }
                    ],
                    "common_phrases": [
                        "se moucher le nez"
                    ]
                },
                {
                    "sense_id": "c9a334e8-f957-300c-adda-30f1f7d5565f",
                    "sense_definition": "Réprimander vivement quelqu'un ou lui répliquer avec fermeté pour le remettre à sa place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa remarque insolente, il s'est fait <w>moucher</w> immédiatement devant toute la classe."
                        },
                        {
                            "text": "Elle a su le <w>moucher</w> d'une seule phrase bien sentie lors du débat."
                        }
                    ],
                    "synonyms": [
                        "rabrouer",
                        "rembarrer"
                    ],
                    "common_phrases": [
                        "se faire moucher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "c6cd1637-47ca-3bb2-ab0e-f2d1e22df249",
                    "sense_definition": "Éteindre une chandelle ou couper l'extrémité calcinée de sa mèche pour améliorer son éclairage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux domestique passa dans la galerie pour <w>moucher</w> les bougies du lustre."
                        },
                        {
                            "text": "Avant d'aller dormir, elle prit soin de <w>moucher</w> la chandelle sur sa table."
                        }
                    ],
                    "synonyms": [
                        "éteindre"
                    ],
                    "common_phrases": [
                        "moucher la chandelle",
                        "moucher une bougie"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "0afc44b0-3a75-360d-9d75-df5143d8ae21",
                    "sense_definition": "Abattre ou tuer quelqu'un, en particulier avec une arme à feu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malfaiteur s'est fait <w>moucher</w> lors d'un règlement de comptes nocturne."
                        },
                        {
                            "text": "Dans cette ruelle malfamée, le complice craignait de se faire <w>moucher</w> par ses rivaux."
                        }
                    ],
                    "synonyms": [
                        "abattre",
                        "descendre"
                    ],
                    "traits": [
                        {
