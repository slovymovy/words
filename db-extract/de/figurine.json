                    {
                        "form_id": "2c2ac3a9-a146-47e2-a157-7b8f39dd2c40",
                        "entry_id": "c9b4ac0f-f579-30ce-a618-3684622d9261",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Figurinen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0b6833d-500f-3f92-aa07-75232f394277",
                        "entry_id": "c9b4ac0f-f579-30ce-a618-3684622d9261",
                        "glosses": [
                            "kleine, künstlich hergestellte Figur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31218642-94de-47cf-8ad2-ec1d861df50e",
                                "sense_id": "f0b6833d-500f-3f92-aa07-75232f394277",
                                "text": "„Der allergrößte Teil der anthropomorphen Figurinen sind weibliche Gestalten.“"
                            },
                            {
                                "example_id": "cd3a3fd7-3a22-4ee4-98cc-5508651c9add",
                                "sense_id": "f0b6833d-500f-3f92-aa07-75232f394277",
                                "text": "„Er prüfte eingehend Figur und Anstelligkeit des Mädchens und versprach ihr, einen Weg zu finden, damit Lany sie als Figurine für die Ballette der Oper nehme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a88eca8-dfb1-308b-ac4d-3f855245c95f",
                        "entry_id": "c9b4ac0f-f579-30ce-a618-3684622d9261",
                        "glosses": [
                            "kleiner Kostümentwurf, Modellbild, Modezeichnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4040cd-86ef-4de9-99bb-b854c4c59632",
                                "sense_id": "6a88eca8-dfb1-308b-ac4d-3f855245c95f",
                                "text": "Eine gute Figurine spiegelt die Wirkung der Kleider wider."
                            },
                            {
                                "example_id": "fb08e4d6-a984-4cb5-b968-dda26993aa86",
                                "sense_id": "6a88eca8-dfb1-308b-ac4d-3f855245c95f",
                                "text": "„So wird Ludwig XI. nie verfehlen, vor den Figurinen seines Hutes niederzuknien; Heinrich IV. wird stets jovial, Maria Stuart weinerlich, Richelieu grausam sein, kurz, alle Charaktere erscheinen aus Liebe zu simplen Vorstellungen und aus Rücksicht auf die Unwissenheit aus einem einzigen Guß, so daß der Dramatiker, statt zu erheben, hinabzieht, statt zu belehren, verdummt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d29c0d0-8e7a-477f-9d11-11cd3fbea81a",
                        "source_entry_id": "c9b4ac0f-f579-30ce-a618-3684622d9261",
                        "source_sense_id": "f0b6833d-500f-3f92-aa07-75232f394277",
                        "source_sense_description": "kleine, künstlich hergestellte Figur",
                        "target_lang_word": "figurine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                        "entry_id": "46f6a49a-bdfc-32cb-83b6-240067a65994",
                                        "glosses": [
                                            "A small carved or molded figure; a statuette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f37ed64-266d-48a0-9dc0-ee989a10ac57",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "Galvanised by this knowledge, the figurine family take to exercise and healthy eating in the park, forming themselves into the key words \"Eat\" (better), \"Move\" (more) and \"Live\" (longer) of the government's urgings and soon the municipal landscape is filled with other happy, healthier families who, incidentally, look even more delicious en masse."
                                            },
                                            {
                                                "example_id": "352f8ba8-3d16-4d08-acda-568b639cbe5a",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "While figurines were an integral part of Late Neolithic and Early Copper Age life, they disappear from society until the later Nuragic period.[…]The lack of figurines is a conscious choice, as is the decision to produce over 500 bronze figurines (bronzetti) in phases III and IV of the Nuragic period."
                                            },
                                            {
                                                "example_id": "17394593-3b3f-48ac-8b5a-75777649bab4",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "For the abbreviation of the name of the pieces, each player is free to use the name which is commonly used in his/her country. Examples: F = fou (French for bishop), L = loper (Dutch for bishop). In printed periodicals, the use of figurines is recommended."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
