                ],
                "translations": [
                    {
                        "translation_id": "2687e858-be86-4b55-93a8-26d61b4e65f6",
                        "source_entry_id": "11ded9b5-912b-324a-93cc-3080c2fe9b69",
                        "source_sense_id": "a4c5f426-f6e6-32be-a529-e95f43e5c2af",
                        "target_lang_word": "distress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b94fd14-ca7b-33cc-b424-c6558b8f364e",
                                        "entry_id": "35522992-d30c-3da1-a3c4-eaec9115ead8",
                                        "glosses": [
                                            "Physical or emotional discomfort, suffering, or alarm, particularly of a more acute nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0d58e43-06e3-4478-ab18-c8eb957551d9",
                                                "sense_id": "3b94fd14-ca7b-33cc-b424-c6558b8f364e",
                                                "text": "To heighten his distress, he is approached by his wife, and bitterly upbraided for his perfidy in concealing from her his former connexions (with that unhappy girl who is here present with her child, the innocent offspring of her amours, fainting at the sight of his misfortunes, being unable to relieve him farther), and plunging her into those difficulties she never shall be able to surmount."
                                            },
                                            {
                                                "example_id": "3977eb1d-117b-4878-b051-b5a22807757c",
                                                "sense_id": "3b94fd14-ca7b-33cc-b424-c6558b8f364e",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f802cc-47b7-33f7-a8ea-6e9e35eafce2",
                                        "entry_id": "35522992-d30c-3da1-a3c4-eaec9115ead8",
                                        "glosses": [
                                            "A cause of such discomfort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec15e12c-a879-3219-8657-ff27427a2554",
                                        "entry_id": "35522992-d30c-3da1-a3c4-eaec9115ead8",
                                        "glosses": [
                                            "Serious danger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efa2cc2-8cd6-40c1-bee3-b754e636a06a",
                                                "sense_id": "ec15e12c-a879-3219-8657-ff27427a2554",
                                                "text": "I immediately considered that this must be some ship in distress, and that they had some comrade, or some other ship in company, and fired these gun for signals of distress, and to obtain help."
                                            },
                                            {
                                                "example_id": "7bfe2a7c-0b68-4376-85e1-0675af2de866",
                                                "sense_id": "ec15e12c-a879-3219-8657-ff27427a2554",
                                                "text": "At length they perceived a little cottage; two persons in the decline of life dwelt in this desert, who were always ready to give every assistance in their power to their fellow-creatures in distress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f951e0b0-6b66-3287-ad43-2ca16d9fd1b6",
                                        "entry_id": "35522992-d30c-3da1-a3c4-eaec9115ead8",
                                        "glosses": [
                                            "An aversive state of stress to which a person cannot fully adapt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2aba9f5d-de1d-3a44-b512-2c7d38f5f482",
                                        "entry_id": "35522992-d30c-3da1-a3c4-eaec9115ead8",
                                        "glosses": [
                                            "A seizing of property without legal process to force payment of a debt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1afa1a8-f908-3d70-8918-cf8175c23898",
                                        "entry_id": "35522992-d30c-3da1-a3c4-eaec9115ead8",
                                        "glosses": [
                                            "The thing taken by distraining; that which is seized to procure satisfaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abba6949-9ffd-4b29-a26e-d589a888086b",
                                                "sense_id": "e1afa1a8-f908-3d70-8918-cf8175c23898",
                                                "text": "If he were not paid, he would straight go and take a distress of goods and cattle."
                                            },
                                            {
                                                "example_id": "50756b5e-3e10-45d8-b5e8-7099d9e1f3a9",
                                                "sense_id": "e1afa1a8-f908-3d70-8918-cf8175c23898",
                                                "text": "The distress thus taken must be proportioned to the thing distrained for."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "distress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3246cba5-0f7e-32f6-966b-6bdf190471e4",
                                        "entry_id": "093173a7-aca6-3321-b37e-b64b1c324b64",
                                        "glosses": [
                                            "To cause strain or anxiety to someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45dd2264-32e1-46bd-b16f-1020d7a71552",
                                                "sense_id": "3246cba5-0f7e-32f6-966b-6bdf190471e4",
                                                "text": "She respects me, no doubt, but has no longer any passionate feeling for me, and my death will distress her without plunging her in despair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ddf79f6-991a-33a1-837c-50cdce7a181e",
                                        "entry_id": "093173a7-aca6-3321-b37e-b64b1c324b64",
                                        "glosses": [
                                            "To retain someone’s property against the payment of a debt; to distrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261dcdc3-75b9-4173-b3e3-b73306da7c26",
                                                "sense_id": "6ddf79f6-991a-33a1-837c-50cdce7a181e",
                                                "text": "This power of distress, as anciently used, became as oppressive as the feudal forfeiture. It was as hard for the tenant to be stripped in an instant of all his goods, for arrears of rent, as to be turned out of the possession of his farm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be2af683-a346-3df5-816c-984462c891ec",
                                        "entry_id": "093173a7-aca6-3321-b37e-b64b1c324b64",
                                        "glosses": [
                                            "To treat a new object to give it an appearance of age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0401082-7fc2-498e-af41-f93065c855b1",
                                                "sense_id": "be2af683-a346-3df5-816c-984462c891ec",
                                                "text": "a pair of distressed jeans"
                                            },
                                            {
                                                "example_id": "d143f05a-d23d-4f76-be48-9e4d639021c9",
                                                "sense_id": "be2af683-a346-3df5-816c-984462c891ec",
                                                "text": "She distressed the new media cabinet so that it fit with the other furniture in the room."
                                            },
                                            {
                                                "example_id": "c99bef13-93b5-41ea-a88e-08499f2bd869",
                                                "sense_id": "be2af683-a346-3df5-816c-984462c891ec",
                                                "text": "If you don't want to be considered a dude you should distress your binoculars in the way that antique dealers distress new paintings to make them look old."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
