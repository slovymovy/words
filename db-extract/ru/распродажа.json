                "senses": [
                    {
                        "sense_id": "11d0562f-0d78-36d0-8ee6-d909951c3039",
                        "entry_id": "fae32e9a-48ec-3e37-9a2a-24ad990f229a",
                        "glosses": [
                            "действие по значению гл. распродавать; сбыт товара с целью быстрой ликвидации всего имеющегося запаса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0119b54-65bd-4ebc-b182-82ff6c2d9121",
                                "sense_id": "11d0562f-0d78-36d0-8ee6-d909951c3039",
                                "text": "У партии власти нет стратегии, нет идей, и она продолжает дальнейшую распродажу страны, унижение населения."
                            },
                            {
                                "example_id": "6a951294-a28d-449f-a08f-70badb15aba7",
                                "sense_id": "11d0562f-0d78-36d0-8ee6-d909951c3039",
                                "text": "Распродажи автомобилей, произведённые в 2008 году, могут продлиться дольше ожидаемого."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d257729d-bd78-4343-9c3a-5b0dc69187bf",
                        "source_entry_id": "fae32e9a-48ec-3e37-9a2a-24ad990f229a",
                        "source_sense_id": "11d0562f-0d78-36d0-8ee6-d909951c3039",
                        "target_lang_word": "fire sale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fire sale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "031c7f9b-767e-357b-b7b0-a52ed0e33eca",
                                        "entry_id": "e3af052a-5657-3851-b6f3-e6d8e6a2305f",
                                        "glosses": [
                                            "A clearance sale at greatly reduced prices, often at losses."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a38a84-975f-4197-a721-61b266d4141e",
                                                "sense_id": "031c7f9b-767e-357b-b7b0-a52ed0e33eca",
                                                "text": "By the following year, Lehman’s enormous holdings in subprime loans were all but wiped out, and Bush was enlisted to see if he could engineer a fire sale of some of the bank’s empire of debt to the Mexican billionaire Carlos Slim."
                                            },
                                            {
                                                "example_id": "5f3f7464-fa41-4d5e-b1bd-27f3ff34ca0e",
                                                "sense_id": "031c7f9b-767e-357b-b7b0-a52ed0e33eca",
                                                "text": "Bruce was happy with a point and is now focused on surviving a fire-sale at the KC Stadium before the transfer window shuts, with Tom Huddlestone linked with West Ham. “We have lost 14 players and brought in five or six but the transfer window [closing] is still three weeks away,” he said."
                                            },
                                            {
                                                "example_id": "81c69e2f-5e5a-48b4-8008-70ec5a656449",
                                                "sense_id": "031c7f9b-767e-357b-b7b0-a52ed0e33eca",
                                                "text": "The fire sale comes a week after FTX provided a $250 million emergency line of credit to BlockFi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20b1c44d-a48b-4f8f-b34d-72a20cdb0155",
                        "source_entry_id": "fae32e9a-48ec-3e37-9a2a-24ad990f229a",
