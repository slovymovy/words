        "nl-extract.jsonl": [
            {
                "entry_id": "66708cad-cdff-303f-b9ea-1ac83e7860ce",
                "word": "uitdelgen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b6d409c-336b-3b0b-a6ed-603895845c01",
                        "entry_id": "66708cad-cdff-303f-b9ea-1ac83e7860ce",
                        "glosses": [
                            "uitwissen, vernietigen, uitroeien, verdelgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc36a057-0f9e-4d43-8bdc-12bb3f943426",
                                "sense_id": "1b6d409c-336b-3b0b-a6ed-603895845c01",
                                "text": "De tollenaar wendt zich in zijn nood tot God en niet tot de mensen. „O God”, zegt hij. Hij weet dat bij God veel vergeving van de zonden te vinden is, dat Hij alleen de overtredingen kan uitdelgen. Hij weet dat God bezworen heeft geen lust te hebben in de dood van de zondaar, maar daarin dat hij zich bekeert en leeft."
                            },
                            {
                                "example_id": "a933d82f-6645-40df-b11c-7bdc5df2914b",
                                "sense_id": "1b6d409c-336b-3b0b-a6ed-603895845c01",
                                "text": "„Indien de rechtvaardige nauwelijks zalig wordt, waar zal de goddeloze en zondaar verschijnen?” Mozes zegt: Delg mij nu uit Uw boek wat U geschreven hebt. Hij wilde liever met Paulus verbannen zijn, dan dat God het ganse volk zou uitdelgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b33cfd8f-b80e-47da-a91c-eca11fedd9dc",
                        "source_entry_id": "66708cad-cdff-303f-b9ea-1ac83e7860ce",
                        "source_sense_id": "1b6d409c-336b-3b0b-a6ed-603895845c01",
                        "source_sense_description": "uitwissen",
                        "target_lang_word": "deaden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deaden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                        "entry_id": "fc86d706-2bc4-3960-bd02-0d0a52dd5859",
                                        "glosses": [
                                            "To render less lively; to diminish; to muffle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe20b89a-4f87-4b98-a0ba-faf1e4f0de47",
                                                "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                                "text": "deaden the pain"
                                            },
                                            {
                                                "example_id": "92385b69-eda2-4c4d-b430-e7a867f0db1d",
                                                "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                                "text": "deaden sound"
                                            },
                                            {
                                                "example_id": "41a69365-602e-47e0-adc7-1a38f7412ea4",
                                                "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                                "text": "deaden the senses"
                                            },
                                            {
                                                "example_id": "928dd1b4-dd80-4ae0-bd9a-03a459014217",
                                                "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                                "text": "Painkillers helped to deaden the pain."
                                            },
                                            {
                                                "example_id": "4a2820d9-9bd2-4764-a878-e5b18b072ecd",
                                                "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                                "text": "Thick curtains deaden the sound of traffic."
                                            },
                                            {
                                                "example_id": "e45e00d8-732e-441d-99e5-7063211bd2a0",
                                                "sense_id": "75a61ba1-ce83-34db-a889-ee65a9e4873b",
                                                "text": "Routine can deaden one’s enthusiasm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ececb67-64d0-35bf-a9aa-d4a090ccc8b3",
                                        "entry_id": "fc86d706-2bc4-3960-bd02-0d0a52dd5859",
                                        "glosses": [
