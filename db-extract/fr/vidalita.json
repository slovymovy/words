                        "glosses": [
                            "Chant typique d’Amérique du Sud (en particulier Argentine du nord-est et Uruguay), voisin de la vidala."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167b6931-46df-43b1-8ae0-2db37eb89969",
                                "sense_id": "8d815abf-c24d-33ee-b370-993d772d2e18",
                                "text": "Le colonel prit sa guitare, et tournant légèrement le dos à la fille du prote, parce qu’il ne pensait qu’à elle et pour elle seule jouait, se mit à chanter des vidalitas où sombraient des désirs confus."
                            }
                        ]
