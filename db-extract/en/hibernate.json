                                            {
                                                "example_id": "fb787fdf-77bf-4690-95b6-78b8713e0b42",
                                                "sense_id": "d5d069db-738b-30fc-a196-c22218b95bda",
                                                "text": "V Blatné již potřetí přezimoval pár čápů bílých, samec dokonce počtvrté."
                                            },
                                            {
                                                "example_id": "35bfb657-5ba9-4d86-93e2-9bfbbd6d48dd",
                                                "sense_id": "d5d069db-738b-30fc-a196-c22218b95bda",
                                                "text": "Během zimy chraňte svůj nábytek před deštěm a mrazem. Nejlepší je nechat jej přezimovat v garáži, ve sklepě nebo v přístřešku se zabezpečeným prouděním vzduchu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
