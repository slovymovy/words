                        "entry_id": "0dbd7316-d35e-3fac-afd0-f5f9a060d50d",
                        "glosses": [
                            "An amount of time or a particular time interval."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56bddf09-c2b9-4e6b-b871-b5deeccb7d25",
                                "sense_id": "3f0fd666-5243-3783-8943-3096408e5b9f",
                                "text": "The duration of the flight will be about 2 hours 45 minutes."
                            },
                            {
                                "example_id": "49149dda-5858-4d85-b685-48a8afbd20a7",
                                "sense_id": "3f0fd666-5243-3783-8943-3096408e5b9f",
                                "text": "She was moaning for the entire duration of the advert break."
                            },
                            {
                                "example_id": "7031b57b-d135-46f8-a29c-70f3b1cb6cbd",
                                "sense_id": "3f0fd666-5243-3783-8943-3096408e5b9f",
                                "text": "To make matters worse, we pass through a torrential rainstorm, which makes window-gazing almost impossible, leaving me glad that the trip is less than 30 minutes duration."
                            }
                        ]
                    },
                    {
                        "sense_id": "44743bb3-e5a8-365e-8cbc-baa22d1860ed",
                        "entry_id": "0dbd7316-d35e-3fac-afd0-f5f9a060d50d",
                        "glosses": [
                            "The time taken for the current situation to end, especially the current war."
                        ],
                        "tags": [
                            "countable",
                            "singular",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b350370b-3201-46c4-a5af-61fa070a57f5",
                                "sense_id": "44743bb3-e5a8-365e-8cbc-baa22d1860ed",
                                "text": "Rationing will last at least for the duration."
                            }
                        ]
                    },
