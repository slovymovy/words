            "senses": [
                {
                    "sense_id": "0e488b93-7800-32ae-af4b-9829a292d973",
                    "sense_definition": "Taki, który został dokładnie zdefiniowany, sprecyzowany lub ustalony.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "precyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy podjąć decyzję w <w>określonym</w> czasie.",
                            "target_lang_translations": {
                                "ru": "Мы должны принять решение в <w>определенное</w> время."
                            }
                        },
                        {
                            "text": "Te leki trzeba brać o <w>określonych</w> porach dnia.",
                            "target_lang_translations": {
                                "ru": "Эти лекарства нужно принимать в <w>определённое</w> время дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "ustalony",
                        "konkretny",
                        "sprecyzowany"
                    ],
                    "antonyms": [
                        "nieokreślony"
                    ],
                    "common_phrases": [
                        "określony czas",
                        "określony sposób"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точно установленный, определенный или конкретизированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определенный",
                                "target_lang_sense_clarification": "точно установленный, конкретный"
                            },
                            {
                                "target_lang_word": "конкретный",
                                "target_lang_sense_clarification": "точно заданный, определенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62909ce9-d30d-38c6-8641-6b26ea6e0482",
                    "sense_definition": "Taki, o którym mowa, ale którego nazwy lub szczegółów nie chce się ujawniać.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Za tą kampanią oszczerstw stoją <w>określone</w> środowiska polityczne, ale nie będę wymieniał nazwisk.",
                            "target_lang_translations": {
                                "ru": "За этой клеветнической кампанией стоят <w>определённые</w> политические круги, но называть имён я не буду."
                            }
                        },
                        {
                            "text": "Dziennikarz sugerował, że ustawę napisano pod <w>określone</w> firmy z branży paliwowej.",
                            "target_lang_translations": {
                                "ru": "Журналист намекал, что закон написали под <w>определённые</w> компании из топливной отрасли."
                            }
                        }
                    ],
                    "synonyms": [
                        "pewny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Некий, какой-то, о котором говорят, но не называют прямо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "некий",
                                "target_lang_sense_clarification": "неизвестный или не называемый прямо человек/предмет"
                            },
                            {
                                "target_lang_word": "определенный",
                                "target_lang_sense_clarification": "в значении 'некий', 'какой-то'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc6ae2d7-06a7-31fe-9f06-b95b1515b1a1",
                    "sense_definition": "Imiesłów przymiotnikowy bierny od czasownika <w>określić</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zadanie zostało <w>określone</w> jako bardzo trudne przez nauczyciela.",
                            "target_lang_translations": {
                                "ru": "Задание было <w>определено</w> учителем как очень сложное."
                            }
                        },
                        {
                            "text": "Miejsce spotkania zostało <w>określone</w> wczoraj wieczorem.",
                            "target_lang_translations": {
                                "ru": "Место встречи было <w>определено</w> вчера вечером."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие, обозначающее, что действие было совершено над объектом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определенный",
                                "target_lang_sense_clarification": "краткая или полная форма причастия"
                            }
                        ]
                    }
                }
            ]
        }
