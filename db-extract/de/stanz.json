                    {
                        "translation_id": "ad240739-20ad-46ce-9e6d-11021e924976",
                        "source_entry_id": "504d5977-20a0-30d8-9fce-faa29d8f53cc",
                        "source_sense_id": "4f9ad01a-0352-33d5-93a7-b9c8fd4e2c63",
                        "source_sense_description": "Landgut eines Viehzüchters",
                        "target_lang_word": "estância",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estância",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50d416f8-f010-3f41-8cf2-6639cb8fec72",
                                        "entry_id": "c92f913a-665f-317b-aca8-23caca54c73d",
                                        "glosses": [
                                            "A large rural estate in Latin America; a kind of ranch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca257cfe-dad8-4db9-9e10-fcd79029f080",
                                                "sense_id": "50d416f8-f010-3f41-8cf2-6639cb8fec72",
                                                "text": "Some of the campsites are close to estancias; some are run by the parks service and have showers; and the remainder are in more remote locations with no vehicle access or facilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c38ef94f-5df2-4339-8633-268fb80ae0b5",
                        "source_entry_id": "504d5977-20a0-30d8-9fce-faa29d8f53cc",
                        "source_sense_id": "4f9ad01a-0352-33d5-93a7-b9c8fd4e2c63",
                        "source_sense_description": "Landgut eines Viehzüchters",
                        "target_lang_word": "estancia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estancia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55bc0f0c-5592-3fde-8229-e91292995642",
                                        "entry_id": "50cb73a9-e775-33dd-adfd-76acf283806d",
                                        "glosses": [
                                            "Vaste exploitation agricole d’Amérique du Sud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf4d592-1d42-43b4-9940-f72311d4cdce",
                                                "sense_id": "55bc0f0c-5592-3fde-8229-e91292995642",
                                                "text": "Le sol un peu salin qui s’étend au pied des montagnes convient admirablement aux troupeaux et produit un fourrage excellent. On le choisit donc de préférence pour l’établissement des estancias."
                                            },
                                            {
                                                "example_id": "5cc40e47-2f69-4542-94b4-2058f2a7bf9b",
                                                "sense_id": "55bc0f0c-5592-3fde-8229-e91292995642",
                                                "text": "Mon cher ami, j’ai l’honneur de vous annoncer qu’avant même d’avoir vu votre fille, je l’adopte et vous fais majordome d’une de mes estancias !"
                                            },
                                            {
                                                "example_id": "91797470-9cfd-4cb2-996c-a49d40f1f7d3",
                                                "sense_id": "55bc0f0c-5592-3fde-8229-e91292995642",
                                                "text": "Ces gens prenaient part à la conversation, comme on fait dans les estancias, d’une voix lente, sans inflexions, et espacées, qui eût révélé même à des aveugles les immenses plaines de l’Amérique."
                                            },
                                            {
                                                "example_id": "6378215f-fc0a-496f-aee7-91b435e1968c",
                                                "sense_id": "55bc0f0c-5592-3fde-8229-e91292995642",
                                                "text": "Un homme très grand et corpulent, chevelure rebelle et barbe blanche, qui après avoir été peón d’estancia, châtreur de moutons, contremaître, puis marin sur le bateau-école Baquenado et enfin baleinier, a fait une pause dans ses courses sur les mers australes pour devenir le plus grand écrivain du Chili."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
