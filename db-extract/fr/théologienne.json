                                    {
                                        "sense_id": "71086305-a3d7-3edb-8c4c-c9ba87e1659f",
                                        "entry_id": "ef1ee9e0-a6ea-33ef-b633-8135b4a41464",
                                        "glosses": [
                                            "weibliche Person, die Theologie studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31c7fb1-b779-47a9-a57f-2397bf6df2df",
                                                "sense_id": "71086305-a3d7-3edb-8c4c-c9ba87e1659f",
                                                "text": "„Die meisten katholischen Gemeinden werden von Laien geführt, also von ausgebildeten Theologinnen und Theologen, die auch heiraten können.“"
                                            },
                                            {
                                                "example_id": "360e9fde-957f-4e72-826d-22cfccaef153",
                                                "sense_id": "71086305-a3d7-3edb-8c4c-c9ba87e1659f",
                                                "text": "„Während dieses Handels kam der Onkel der schönen Theologin vorbei, die ihre Thesen so gut verfocht, und der ich so sanfte Lehren in Naturkunde erteilt hatte, erkannte und umarmte mich und lud mich für den nächsten Tag zu sich zum Mittagessen ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d75b507-aace-4fd8-ba01-2db7731a6536",
                        "source_entry_id": "9cf0caac-25d7-35a1-97a7-9cccc9f726e5",
                        "source_sense_id": "e592dcfc-7d43-3837-acdd-baa478622286",
