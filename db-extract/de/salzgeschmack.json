                "senses": [
                    {
                        "sense_id": "0a1cd84f-2926-3e76-a12f-fa19fff16455",
                        "entry_id": "58c0a0f2-9de4-3105-a303-4c4228dde7c2",
                        "glosses": [
                            "salziger Geschmack, Geschmack nach Salz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f143ea39-429a-4c6b-a5c9-818b24b203e2",
                                "sense_id": "0a1cd84f-2926-3e76-a12f-fa19fff16455",
                                "text": "„Wie viele Male war er, mit dem Salzgeschmack der Tränen in Nase und Mund, eingeschlafen, außerstande, sich noch irgend länger zur Wehr zu setzen?“"
                            },
                            {
                                "example_id": "c66422d9-4380-4da9-bb89-898fd046c9a3",
                                "sense_id": "0a1cd84f-2926-3e76-a12f-fa19fff16455",
                                "text": "„Er ließ das Fahrrad an der Tür stehen, ging hinaus auf das Steilufer und stand im Wind. Der dunkle Wellenschlag des Meeres und am fernen Ufer die Lichter von Figueretas. Vom Meer ein schwacher Salzgeschmack.“"
                            },
                            {
                                "example_id": "9a02352b-7e76-4009-adec-76ff84018731",
                                "sense_id": "0a1cd84f-2926-3e76-a12f-fa19fff16455",
                                "text": "„Salzgeschmack auf ihrer Brust, der Geruch der Spucke anderer Männer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
