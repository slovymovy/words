                "translations": [
                    {
                        "translation_id": "b043163e-09da-4986-8afa-20a60423ffb2",
                        "source_entry_id": "a5f44bc3-3e31-3dd4-abed-fe21555dfc60",
                        "source_sense_id": "3575411f-ff16-3a84-bdf7-e95330c422be",
                        "source_sense_description": "een auto die niet in eigendom is maar voor een korte periode en tegen betaling wordt gehuurd",
                        "target_lang_word": "Mietwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mietwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                        "entry_id": "5fadff18-44a3-3c35-9738-9f521b4b1816",
                                        "glosses": [
                                            "Fahrzeug, das man gegen eine Gebühr vorübergehend als Selbstfahrer nutzen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c7d5cc-ce5a-4b19-9057-17e0e09d511d",
                                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                                "text": "Wenn das eigene Fahrzeug in die Werkstatt muss, braucht man womöglich einen Mietwagen."
                                            },
                                            {
                                                "example_id": "ffdfc583-3513-45b3-89ae-237f0bedc556",
                                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                                "text": "„Einige kamen im Mietwagen oder mit dem Taxi von der Bahnstation im Tal herauf.“"
                                            },
                                            {
                                                "example_id": "ac64183c-c78c-4a4f-bded-6bbcb89a3e9e",
                                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                                "text": "„Touristen steigen aus ihren kleinen weißen Mietwagen, kaufen sich Süßigkeiten und Hotdogs.“"
                                            },
                                            {
                                                "example_id": "833da346-8d14-4535-af74-8b5f476ce9d7",
                                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                                "text": "„Mit dem Mietwagen brauchen wir sieben Stunden Richtung Trikala, der Weg ist nicht schwer zu finden: immer nach Norden.“"
                                            },
                                            {
                                                "example_id": "5439c30f-04ae-48bc-822b-640b9ffb16b1",
                                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                                "text": "„Ich aß also zu Mittag, kleidete mich dann an und fuhr in einem Mietwagen zum Palazzo Matalone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a1cc649-6f5d-451d-821a-ae4d9c6f966b",
                        "source_entry_id": "a5f44bc3-3e31-3dd4-abed-fe21555dfc60",
                        "source_sense_id": "3575411f-ff16-3a84-bdf7-e95330c422be",
                        "source_sense_description": "een auto die niet in eigendom is maar voor een korte periode en tegen betaling wordt gehuurd",
                        "target_lang_word": "Mietauto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mietauto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86009bf1-8510-36f0-8150-74a25ee791b5",
                                        "entry_id": "e1692ec9-2039-3704-a979-8f4edd7eecb4",
                                        "glosses": [
                                            "gegen einen Geldbetrag für bestimmte Zeit ausgeliehenes Auto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54717bee-c4d6-4025-bf5b-194f2a78eda6",
                                                "sense_id": "86009bf1-8510-36f0-8150-74a25ee791b5",
                                                "text": "Wenn man in der Stadt wohnt, sind Mietautos meist günstiger als ein eigenes Auto."
                                            },
                                            {
                                                "example_id": "015af754-0095-4c74-af94-18fcda139bc5",
                                                "sense_id": "86009bf1-8510-36f0-8150-74a25ee791b5",
                                                "text": "„Wir nahmen uns ein Mietauto und ohne Hintertürchen wurde uns in fließendem Englisch ein nagelneuer Wagen übergeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1e4d1ad-4cc7-3503-8d45-54ffc663eb25",
                                        "entry_id": "e1692ec9-2039-3704-a979-8f4edd7eecb4",
                                        "glosses": [
                                            "anderes Wort für Taxi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63bf3f8-7744-4471-a74b-4d5e6f51c360",
                                                "sense_id": "f1e4d1ad-4cc7-3503-8d45-54ffc663eb25",
                                                "text": "Nach der Feier nahm er ein Mietauto, um nach Hause zu kommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
