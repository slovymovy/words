                "senses": [
                    {
                        "sense_id": "2bfb1fda-8e1b-389f-bd1d-addfbbac4698",
                        "entry_id": "108a1b05-b3d5-3040-9958-560cb64f90c2",
                        "glosses": [
                            "van iets dat men er nog niet overheen heeft gelopen; nog niet bedorven door menselijk inmenging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ae9c6c-5dd4-48fa-82f8-8a62c9c04ea5",
                                "sense_id": "2bfb1fda-8e1b-389f-bd1d-addfbbac4698",
                                "text": "Alles was wit, behalve hij zoals hij dwars over de onbetreden velden ging."
                            }
                        ]
                    },
                    {
                        "sense_id": "39b2ccc4-afcb-30b2-a437-d5ade36f0e58",
                        "entry_id": "108a1b05-b3d5-3040-9958-560cb64f90c2",
                        "glosses": [
                            "van iets dat het nog nooit gedaan of geprobeerd is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d21a41ac-51a6-494a-83c6-2cef78776bb5",
                                "sense_id": "39b2ccc4-afcb-30b2-a437-d5ade36f0e58",
                                "text": "Ze vervolgt: ,,Ik heb mezelf nooit beperkingen opgelegd en ik ga er ook niet mee beginnen. We kunnen pas verandering forceren als we bereid zijn risico's te nemen en zonder vrees onbetreden paden opgaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6dbf6cf-511b-4969-aff2-6fc2e7c0f8d8",
                        "source_entry_id": "108a1b05-b3d5-3040-9958-560cb64f90c2",
                        "source_sense_id": "2bfb1fda-8e1b-389f-bd1d-addfbbac4698",
                        "source_sense_description": "van iets dat men er nog niet overheen heeft gelopen",
                        "target_lang_word": "untrodden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untrodden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd982a5b-3506-3747-a22f-7aede24ac3e1",
                                        "entry_id": "3d559823-66d1-30a9-a036-ad03a51310eb",
                                        "glosses": [
                                            "That has never been trod upon; unexplored, unspoiled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a99e746-5ad7-483a-b68b-19aee09e6f81",
                                                "sense_id": "bd982a5b-3506-3747-a22f-7aede24ac3e1",
                                                "text": "Proofs of the presence of the white man are found all over the Territory in the shape of old bouilli tins, &c., and often when out after a strayed horse, I have imagined myself to be in wilds untrodden except by the foot of the blackfellow, but the sight of an unassuming empty sardine tin would remind me that the ubiquitous digger had been there first."
                                            },
                                            {
                                                "example_id": "ca7abc5e-cda5-49ec-931a-9d99b7e89877",
                                                "sense_id": "bd982a5b-3506-3747-a22f-7aede24ac3e1",
                                                "text": "If he could only get away from the holes in the banks, he thought, there would be no more faces. He swung off the path and plunged into the untrodden places of the wood."
                                            },
                                            {
                                                "example_id": "c2fd6abd-2f2e-42ef-b730-a1d21a47d4e8",
                                                "sense_id": "bd982a5b-3506-3747-a22f-7aede24ac3e1",
                                                "text": "Their path led them past sharp cliffs, along narrow trails unknown and untrodden, past headlong boulders strewn across barren, treeless, wind-haunted heights."
                                            },
                                            {
                                                "example_id": "f321baa4-fdd0-4fdc-97e7-501a812a53cb",
                                                "sense_id": "bd982a5b-3506-3747-a22f-7aede24ac3e1",
                                                "text": "Moreover the most becoming place for temples and altars he said to be that which, while being most visible, would be most untrodden; for it is pleasant for those who are undefiled to approach it."
                                            },
                                            {
                                                "example_id": "0fbbf266-0cc3-4bd8-b281-962f52869793",
                                                "sense_id": "bd982a5b-3506-3747-a22f-7aede24ac3e1",
                                                "text": "The upper layer of the soil is, therefore, less solid than in other trampled habitats and the optimum development of the community can only take place in the broader joints between paving stones in more untrodden places, often in strips of pavement at the foots^([sic]) of walls where the shifting sand accumulates and turbulent air currents may play an important role."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9271ee9-ae6a-3f9f-b967-a2ff879611f6",
                                        "entry_id": "3d559823-66d1-30a9-a036-ad03a51310eb",
                                        "glosses": [
                                            "Of a person: undefeated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
