                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "1404de62-ed53-478e-ad3b-14ca1371d920",
                                "sense_id": "224d3b2d-add4-3980-962c-730cf9e72a40",
                                "text": "Die Brocki Grischun fährt die Produktion der «ChurMaska» hoch – nachdem sie lange stillstand. Inzwischen wurden die ersten Exemplare verkauft."
                            },
                            {
                                "example_id": "d08faa86-7cb6-4789-8774-c3c6091ec46d",
                                "sense_id": "224d3b2d-add4-3980-962c-730cf9e72a40",
                                "text": "Doch mit dem Analog-Trend, der auch in der Zeit von Social Media anhält, kommen immer mehr Jugendliche mit Kameras, die sie geerbt oder in einem Brocki gefunden haben."
                            },
                            {
                                "example_id": "1f9b5f96-7689-4893-b1b0-d9d116764b1b",
                                "sense_id": "224d3b2d-add4-3980-962c-730cf9e72a40",
                                "text": "»[…]Ich denke, ich bringe das verbleibende Geschirr in die Brocki und kaufe gleich alles neu. Einen Mix aus alt und neu möchte ich nicht haben. Ç'est ne pas élégant, weißt du.«"
                            }
                        ]
                    }
