{
    "word_family": [
        "moist",
        "moisture",
        "moistness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4052e5e4-4f6a-38ca-b2ef-96887be4f30d",
                    "sense_definition": "To make something slightly wet or damp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a damp cloth to <w>moisten</w> the dry soil in the pot.",
                            "target_lang_translations": {
                                "ru": "Она использовала влажную ткань, чтобы <w>увлажнить</w> сухую почву в горшке.",
                                "de": "Sie benutzte ein feuchtes Tuch, um die trockene Erde im Topf <w>anzufeuchten</w>."
                            }
                        },
                        {
                            "text": "Apply a little water to <w>moisten</w> the edges of the dough before sealing.",
                            "target_lang_translations": {
                                "ru": "Нанесите немного воды, чтобы <w>увлажнить</w> края теста перед тем, как их защипнуть.",
                                "de": "Tragen Sie ein wenig Wasser auf, um die Ränder des Teigs vor dem Verschließen <w>zu befeuchten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dampen",
                        "wet"
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "common_phrases": [
                        "moisten the lips",
                        "moisten the soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо слегка влажным или сырым.",
                        "de": "Etwas leicht nass oder feucht machen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увлажня́ть",
                                "target_lang_sense_clarification": "несовершенный вид, процесс придания влажности"
                            },
                            {
                                "target_lang_word": "увлажни́ть",
                                "target_lang_sense_clarification": "совершенный вид, результат придания влажности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "befeuchten",
                                "target_lang_sense_clarification": "etwas mit Feuchtigkeit benetzen"
                            },
                            {
                                "target_lang_word": "anfeuchten",
                                "target_lang_sense_clarification": "etwas leicht nass machen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b1cce04-f9e1-3329-ad64-792db0f0fde4",
                    "sense_definition": "To become slightly wet or damp.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His eyes began to <w>moisten</w> as he listened to the sad story.",
                            "target_lang_translations": {
                                "ru": "Его глаза начали <w>увлажняться</w>, когда он слушал грустную историю.",
                                "de": "Seine Augen begannen <w>feucht zu werden</w>, als er die traurige Geschichte hörte."
                            }
                        },
                        {
                            "text": "The air grew cold and the ground started to <w>moisten</w> with the morning dew.",
                            "target_lang_translations": {
                                "ru": "Воздух стал холодным, и земля начала <w>увлажняться</w> от утренней росы.",
                                "de": "Die Luft wurde kalt und der Boden begann durch den Morgentau <w>feucht zu werden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dampen"
                    ],
                    "common_phrases": [
                        "eyes moisten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться слегка влажным или сырым.",
                        "de": "Leicht nass oder feucht werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увлажня́ться",
                                "target_lang_sense_clarification": "несовершенный вид, процесс становления влажным"
                            },
                            {
                                "target_lang_word": "увлажни́ться",
                                "target_lang_sense_clarification": "совершенный вид, результат становления влажным"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "feucht werden",
                                "target_lang_sense_clarification": "allgemein Feuchtigkeit annehmen"
                            },
                            {
                                "target_lang_word": "sich befeuchten",
                                "target_lang_sense_clarification": "von selbst feucht werden (z. B. Augen)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}