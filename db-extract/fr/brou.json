                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "husk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3457d2e-a21e-3f92-8d68-466792771b53",
                                        "entry_id": "8c9acdb3-3c30-3606-b9dc-9c60ceaa0c3a",
                                        "glosses": [
                                            "An infection in cattle caused by a species of Dictyocaulus or lungworm"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceceec25-34e6-4a38-bd6a-c94a2dae98bb",
                                                "sense_id": "e3457d2e-a21e-3f92-8d68-466792771b53",
                                                "text": "The symptoms of Husk are a constant cough, rapid loss of flesh, difficulty in breathing and, in the later stages, loss of appetite and diarrhœa."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "husk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6481078a-7369-35d4-91f1-26fa120efec4",
                                        "entry_id": "9ada6a9e-0e7e-3b57-beff-4fd627b200dc",
                                        "glosses": [
                                            "To cough, clear one's throat."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9b7f1c-3683-4e6d-aec7-7f6d5e090a3b",
                                                "sense_id": "6481078a-7369-35d4-91f1-26fa120efec4",
                                                "text": "Back on the veranda he said to Lace gravely, \"I do believe that poor child's in the family way.\" Lace, tracing the pattern of the matting with his boot, husked, and murmured, \"Yes — I think so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bd7ea8-93b1-3768-aa33-0281f292c54c",
                                        "entry_id": "9ada6a9e-0e7e-3b57-beff-4fd627b200dc",
                                        "glosses": [
                                            "To say huskily, to utter in a husky voice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "080b3b09-28e0-4acb-858d-3ea832ed1182",
                                                "sense_id": "51bd7ea8-93b1-3768-aa33-0281f292c54c",
                                                "text": "The French captain did not immediately respond; he looked at his men with a miserable expression [...]; still he hesitated, drooped, and finally husked, \"Je me rends,\" with a look still more wretched."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
