                        "form": "den Morgenspaziergang"
                    },
                    {
                        "form_id": "20e9c5cc-96ce-472f-ab96-bcd65fe6caa1",
                        "entry_id": "ddc58ddd-0f3a-3e58-9cad-57bdd2259fc8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Morgenspaziergänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                        "entry_id": "ddc58ddd-0f3a-3e58-9cad-57bdd2259fc8",
                        "glosses": [
                            "geruhsames Gehen zur morgendlichen Erholung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c05effc-fc75-4c98-816c-6cd51a6b6c56",
                                "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                                "text": "Sie genoss ihren Morgenspaziergang im Wald."
                            },
                            {
                                "example_id": "1e15f7cf-95aa-4b00-9180-161bd4111d2c",
                                "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                                "text": "Während meines Morgenspazierganges sah ich einen Hasen über die Straße hoppeln."
                            },
                            {
                                "example_id": "d434d5f0-9433-4730-a6ab-4602f9e8bd41",
                                "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                                "text": "„Wir stehen wie üblich früh auf und machen unseren Morgenspaziergang. Hand in Hand laufen wir wieder über den Feldweg.“"
                            },
                            {
                                "example_id": "00c75da4-2662-4344-a8a1-3db5733f3f1c",
                                "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                                "text": "„Nun bin ich wieder in Charlottenburg, in der Heimat meiner Kinderzeit, mache meine Morgenspaziergänge in dem Charlottenburger Schloßgarten, für den ich als Kind solche schwärmerische Liebe empfand, und wandere durch Lützow an dem Hause vorbei, wo ich geboren bin.“"
                            },
                            {
                                "example_id": "f0ffb446-9c71-4316-904e-842b895613d0",
                                "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                                "text": "„Jenes Kleid wäre freilich zu einem Morgenspaziergange nicht tauglich gewesen, weil es in reichen Falten fast bis auf den Fußboden nieder ging.“"
                            },
                            {
                                "example_id": "fb40f810-68a5-4af1-9ffd-2f86a2c0b470",
                                "sense_id": "efaac882-e053-30ea-8f9f-d55d47c00ecb",
                                "text": "„Diesen Brief erhielt der alte Fürst spät am Abend, während er allein in seinem Kabinett war: am folgenden Tag machte er seinen gewöhnlichen Morgenspaziergang, war aber dem Verwalter, dem Gärtner und dem Baumeister gegenüber sehr wortkarg und sprach niemand an, obwohl er sehr grimmig aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
