                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe film heeft mij zeker niet <w>teleurgesteld</w>.",
