                        "entry_id": "50e82023-c0bf-3de0-ae16-accfe18d91a1",
                        "glosses": [
                            "Scheiße, die von Ratten stammt"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "957743cc-5d5d-440f-b4b7-33c4d5c1b501",
                                "sense_id": "c85bad4a-1e99-34db-aa0a-d5172da0c9d8",
                                "text": "„Der Keller war lang gezogen, muffig und roch nach Rattenscheiße, aber er wurde durch ein niedriges Gelände in zwei Bereiche unterteilt.“"
                            },
                            {
                                "example_id": "647e69a0-0841-4646-b672-b5261ab16dcc",
                                "sense_id": "c85bad4a-1e99-34db-aa0a-d5172da0c9d8",
                                "text": "„Wanderte nur eine Hand voll Reisbauern der Dritten Welt nicht aus, wurde man womöglich bei ihnen wiedergeboren - und musste sein kostbares Leben damit verbringen, unter der sengenden Sonne Asiens Fliegen totzuschlagen und ranzigen Brei mit Rattenscheiße zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c449e47-88cb-42ae-a76c-53bb8aeed6e4",
                        "source_entry_id": "50e82023-c0bf-3de0-ae16-accfe18d91a1",
                        "source_sense_id": "c85bad4a-1e99-34db-aa0a-d5172da0c9d8",
                        "source_sense_description": "Scheiße, die von Ratten stammt",
                        "target_lang_word": "ratshit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratshit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb26649b-83e2-3845-bd10-dfce711e869d",
                                        "entry_id": "012e5f7b-ea3b-31b7-8749-3b4be3c3946f",
                                        "glosses": [
                                            "The excrement of a rat."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e282a8-3da6-4c0b-9f53-6ce05e7c0d54",
                                                "sense_id": "bb26649b-83e2-3845-bd10-dfce711e869d",
                                                "text": "“Do you think they have ratshit in them?” Wynkyn asked. “Swan says most hamburgers have ratshit in them.”"
                                            },
                                            {
                                                "example_id": "45ac7995-c34a-4959-bff8-995a81719777",
                                                "sense_id": "bb26649b-83e2-3845-bd10-dfce711e869d",
                                                "text": "‘Terry stop it! R—′s on, remember. If we get busted we′re ratshit. We′ll never see each other again.’"
                                            },
                                            {
                                                "example_id": "b6a2209f-e34e-46fd-9d16-84c4dc3823c7",
                                                "sense_id": "bb26649b-83e2-3845-bd10-dfce711e869d",
                                                "text": "He slammed the choke in again. ‘No, don′t you stall, you ratshit plane!’"
                                            },
                                            {
                                                "example_id": "ca336f0e-6ca7-4835-91f3-45b0257b2d14",
                                                "sense_id": "bb26649b-83e2-3845-bd10-dfce711e869d",
                                                "text": "“Aw, who cares? It′s all going to hell anyway. You have your turn, eat, get drunk, screw; and fifty years from now none of it′ll matter a ratshit.”"
                                            },
                                            {
                                                "example_id": "20de06c3-b92a-47bf-b0cc-823bc9d490b3",
                                                "sense_id": "bb26649b-83e2-3845-bd10-dfce711e869d",
                                                "text": "So they pulled the furniture away from the wall and found a pile of little dried ratshit pellets behind the dresser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86db871-092f-3ba7-882f-184ff4020b42",
                                        "entry_id": "012e5f7b-ea3b-31b7-8749-3b4be3c3946f",
                                        "glosses": [
                                            "Nonsense, bullshit."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e087a0c-cb95-42df-a68b-662bc967127c",
                                                "sense_id": "d86db871-092f-3ba7-882f-184ff4020b42",
                                                "text": "He also said that most of the kids at school were full of ratshit and that only one or two sheilas made the place any better than buggery."
                                            },
                                            {
                                                "example_id": "62e2cffa-0f8b-46a7-b37a-59f8cd10cbeb",
                                                "sense_id": "d86db871-092f-3ba7-882f-184ff4020b42",
                                                "text": "1995, Irene Moores, Arthur Murray, Aboriginal Deaths in Custody Watch Committee, Voices of Aboriginal Australia: Past, Present, Future, page 49,\nDo you see, Mr Bryant, why your old dream of getting to where you could really do something at last is going to be proved to be so much ratshit? Do you see why self-determination that isn′t really real is so much ratshit?"
                                            },
                                            {
                                                "example_id": "2feedfb0-9cbd-4368-a96f-0039aff7adb4",
                                                "sense_id": "d86db871-092f-3ba7-882f-184ff4020b42",
                                                "text": "Kerin, one of the most pro-development Ministers, told his colleagues: ‘The EIS is ratshit and the guidelines are laughable’."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ratshit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8d8413-1a18-3acc-bcdc-69c9e6bab5a5",
                                        "entry_id": "796fe8dd-d702-3223-8b8d-ae793c22a1ab",
                                        "glosses": [
                                            "Of very poor quality, badly substandard, useless; damaged or broken; unwell, exhausted."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5290e5a-2166-4e6f-ba8c-5429a34df5a0",
                                                "sense_id": "ad8d8413-1a18-3acc-bcdc-69c9e6bab5a5",
                                                "text": "In the morning I was ratshit, just a bundle of nerves."
                                            },
                                            {
                                                "example_id": "2d14d37e-b93e-496c-9233-f4b8107ea639",
                                                "sense_id": "ad8d8413-1a18-3acc-bcdc-69c9e6bab5a5",
                                                "text": "For a moment Cashin thought that he would be sick, that he would spew over Hopgood.\n‘You′re looking ratshit,’ said Hopgood. ‘Even more ratshit.’"
                                            },
                                            {
                                                "example_id": "45150461-7a1c-4aa4-822e-03bebb09adf2",
                                                "sense_id": "ad8d8413-1a18-3acc-bcdc-69c9e6bab5a5",
                                                "text": "When I was a little girl, my mother had this ratshit recorder, reel to reel, there were no cassettes then,... anyway, when I was lonely or hurt or scared, she'd play it for me. It was THE HIGH AND THE MIGHTY."
                                            },
                                            {
                                                "example_id": "ed12e7cb-4d39-4bde-9e7d-e9a2cd41895a",
                                                "sense_id": "ad8d8413-1a18-3acc-bcdc-69c9e6bab5a5",
                                                "text": "‘That′s ratshit advice, Danny!’ Sammy, realising Bullnose was making a meal of it, cut in."
                                            },
                                            {
                                                "example_id": "28b8b94c-26fe-4c35-844b-c95b18ea14ae",
                                                "sense_id": "ad8d8413-1a18-3acc-bcdc-69c9e6bab5a5",
                                                "text": "\"The letter is written by the dictator of a rat-shit little country.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
