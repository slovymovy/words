                            },
                            {
                                "target_lang_word": "para basıcı",
                                "target_lang_sense_clarification": "Madeni para üretimini gerçekleştiren zanaatkar."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8654eb8a-62af-3062-8eb9-0357865e2c27",
                    "sense_definition": "iemand die geld wisselt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>munter</w> wisselde de vreemde valuta om voor lokale munten.",
                            "target_lang_translations": {
