                    {
                        "translation_id": "487332c9-1786-4ca3-b4b7-903c575c3db6",
                        "source_entry_id": "948d9d8c-bf2b-37cd-a207-e4af895fa0a7",
                        "source_sense_id": "0e9ee2de-8932-3617-94a6-4382cafd1bee",
                        "source_sense_description": "form of soccer",
                        "target_lang_word": "futsal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futsal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c597e3-39fd-32ea-82be-d4055b800e0d",
                                        "entry_id": "efd78917-b067-3238-bc7b-f46a3538d9f8",
                                        "glosses": [
                                            "Variante du football, qui se joue en salle, par équipe de cinq avec un ballon plus petit et plus lourd que le ballon utilisé par les équipes de 11 joueurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ee31a9-0c42-4aa9-a850-5353a893a1ed",
                                                "sense_id": "f2c597e3-39fd-32ea-82be-d4055b800e0d",
                                                "text": "L’Association mondiale de futsal a son siège à Asunción, au Paraguay."
                                            },
                                            {
                                                "example_id": "54c6c220-5af8-4b73-a1df-a52ddd8a8db8",
                                                "sense_id": "f2c597e3-39fd-32ea-82be-d4055b800e0d",
                                                "text": "Créé en 1930 en Uruguay, le futsal, \"football de salon\", reconnu par la FFF depuis une dizaine d’années, n’est apparu en France qu’à la fin des années 1970."
                                            },
                                            {
                                                "example_id": "ec00b448-8f6f-4e3a-863f-dc73cb9a7fb0",
                                                "sense_id": "f2c597e3-39fd-32ea-82be-d4055b800e0d",
                                                "text": "Entre activités à Lesneven en journée, comme le futsal, le VTT, l’escalade, ou en soirée, avec des crêp’partie, Top Chef, du karaoké, à l’extérieur, avec les vendredis du sport à Brest, la Récré des 3 curés à Milizac, ou la bouée tractée à Bertheaume, toutes les places ont été prises d’assaut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c76d3f1-10aa-4430-84ac-55f21a450655",
                        "source_entry_id": "948d9d8c-bf2b-37cd-a207-e4af895fa0a7",
                        "source_sense_id": "0e9ee2de-8932-3617-94a6-4382cafd1bee",
                        "source_sense_description": "form of soccer",
                        "target_lang_word": "Futsal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Futsal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93598aea-b741-3ba5-a0c7-8150e22dba54",
                                        "entry_id": "2c213876-e903-3b0c-a346-db5166344824",
                                        "glosses": [
                                            "aus Südamerika stammende Form des Hallen- bzw. Kleinfeldfußballs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300d4a18-6405-40dd-9211-a9c644a719fc",
                                                "sense_id": "93598aea-b741-3ba5-a0c7-8150e22dba54",
                                                "text": "Futsal unterscheidet sich von anderen Arten des Hallenfußballs vor allem dadurch, dass das Spielfeld durch Linien (Handballfeld) und nicht durch Banden begrenzt wird. Es wird generell mit fünf Spielern auf Handballtore mit einem sprungreduzierten Ball gespielt,"
                                            },
                                            {
                                                "example_id": "c110687a-c32d-4a2a-a0b2-5e9d365b7460",
                                                "sense_id": "93598aea-b741-3ba5-a0c7-8150e22dba54",
                                                "text": "Futsal unterscheidet sich vom klassischen Hallenfußball durch die „Vier-Sekunden-Regel“. Für ruhende Bälle stehen jeweils nur vier Sekunden zur weiteren Spielausführung zur Verfügung, sonst wechselt der Ballbesitz zur gegnerischen Mannschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
