                "senses": [
                    {
                        "sense_id": "0b90a65a-b733-3ebc-bf38-4180c7fa1b04",
                        "entry_id": "6e7b728b-e370-3158-9cae-ac8067f65709",
                        "glosses": [
                            "tytuł grzecznościowy w Indiach, odpowiednik polskiego „pan”, dawniej również tytuł grzecznościowy wobec Europejczyka w czasach kolonialnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c71fb3b-0d95-4050-bee5-dcc464aa6c21",
                                "sense_id": "0b90a65a-b733-3ebc-bf38-4180c7fa1b04",
                                "text": "Oto do pokoju naszego wciska się chuda postać umundurowanego Hindusa (…) i recytuje słodkim głosem: — Mój sahib pyta sahiba, czy sahib życzy herbaty od mego sahiba?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "039890f8-dd38-4528-9ad9-7e8e7e036649",
                        "source_entry_id": "6e7b728b-e370-3158-9cae-ac8067f65709",
                        "source_sense_id": "0b90a65a-b733-3ebc-bf38-4180c7fa1b04",
                        "target_lang_word": "sahib",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sahib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "469c3e8a-85a2-388e-a2b7-f44ee8a1d021",
                                        "entry_id": "11bcb8f1-55c1-3646-a432-ea07e4a735c4",
                                        "glosses": [
                                            "A term of respect for a white European or other man of rank in colonial India."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23d05945-1293-4fad-9f21-a5a42f8693be",
                                                "sense_id": "469c3e8a-85a2-388e-a2b7-f44ee8a1d021",
                                                "text": "One day when the Man's Wife and the Tertium Quid had just arrived in the Cemetery, they saw some coolies breaking ground. They had marked out a full-size grave, and the Tertium Quid asked them whether any Sahib was sick. They said that they did not know; but it was an order that they should dig a Sahib's grave."
                                            },
                                            {
                                                "example_id": "3638c38d-6579-45eb-a109-1d99d5836d63",
                                                "sense_id": "469c3e8a-85a2-388e-a2b7-f44ee8a1d021",
                                                "text": "One must never forget that one is a Sahib, and that some day, when examinations are passed, one will command natives."
                                            },
                                            {
                                                "example_id": "577cffd6-13a9-43cb-ac61-9b3cd086cb57",
                                                "sense_id": "469c3e8a-85a2-388e-a2b7-f44ee8a1d021",
                                                "text": "After, went to sahib and packed up sahib's things. We had four hire-ponies; three for loads, and one for sahib to ride. Sahib had a Chinese saddle, that he put on a high horse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d0199fa-c007-4077-84e1-71aa34f15960",
                        "source_entry_id": "6e7b728b-e370-3158-9cae-ac8067f65709",
                        "source_sense_id": "0b90a65a-b733-3ebc-bf38-4180c7fa1b04",
                        "target_lang_word": "sahib",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sahib",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a61cf10-eadc-33a8-8907-0aa2a32dca6b",
                                        "entry_id": "b8b06375-4f6d-3569-9b77-a9e11bbdb5b6",
                                        "glosses": [
                                            "Titre de respect en Inde, il était notamment utilisé comme une manière respectueuse de s'adresser à un Européen, considéré comme un invité d'honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f01ccd4-1b13-4722-89f9-e2f15398364f",
                                                "sense_id": "2a61cf10-eadc-33a8-8907-0aa2a32dca6b",
                                                "text": "C'est un sahib très savant. — Lui, un sahib ! C'est un kala admi (un homme noir) incapable même de courir derrière la queue d'un mulet de potier."
                                            },
                                            {
                                                "example_id": "66453e84-4ef1-47f2-91a4-301404241a45",
                                                "sense_id": "2a61cf10-eadc-33a8-8907-0aa2a32dca6b",
                                                "text": "Sahib Tintin, le Maharadjah désirerait vous voir. — C’est bien. J’arrive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aede83f-12a5-4470-881b-12ecea4091da",
                        "source_entry_id": "6e7b728b-e370-3158-9cae-ac8067f65709",
                        "source_sense_id": "0b90a65a-b733-3ebc-bf38-4180c7fa1b04",
