                                "target_lang_sense_clarification": "all people"
                            },
                            {
                                "target_lang_word": "each",
                                "target_lang_sense_clarification": "every one individually"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "любой человек"
                            },
                            {
                                "target_lang_word": "всякий",
                                "target_lang_sense_clarification": "любой из людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d14626a-95b2-38b5-a55d-4b822c11795d",
                    "sense_definition": "geeft aan dat een aantal per persoon of per stuk verdeeld is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verdeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar gaf de kinderen twee appels <w>elk</w> voor de lunch.",
                            "target_lang_translations": {
                                "en": "The teacher gave the children two apples <w>each</w> for lunch.",
                                "ru": "Учитель дал детям по две яблока <w>каждому</w> на обед."
                            }
                        },
                        {
                            "text": "Zij kregen bij de ingang drie muntjes <w>elk</w> om te besteden.",
                            "target_lang_translations": {
                                "en": "They received three tokens <w>each</w> at the entrance to spend.",
                                "ru": "Они получили на входе по три монетки <w>каждый</w>, чтобы их потратить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "twee appels elk"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates that a number is divided per person or per piece",
                        "ru": "указывает на то, что количество распределено на человека или на штуку"
                    },
                    "translations": {
                        "en": [
                            {
