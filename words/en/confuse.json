{
    "word_family": [
        "confusion",
        "confused",
        "confusing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c54ffce8-c823-3b9a-b8f2-e280ac49eb4b",
                    "sense_definition": "To make someone feel uncertain, puzzled, or unable to understand something clearly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complicated instructions completely <w>confused</w> the new students.",
                            "target_lang_translations": {
                                "ru": "Сложные инструкции окончательно <w>сбили с толку</w> новых студентов.",
                                "zh": "复杂的说明书把新生彻底<w>搞糊涂</w>了。",
                                "es": "Las instrucciones complicadas <w>confundieron</w> completamente a los nuevos estudiantes."
                            }
                        },
                        {
                            "text": "Please do not <w>confuse</w> the issue by bringing up irrelevant details.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>запутывайте</w> дело, приводя неуместные подробности.",
                                "zh": "请不要提出无关的细节来<w>搅乱</w>问题。",
                                "es": "Por favor, no <w>confundas</w> el asunto sacando a relucir detalles irrelevantes."
                            }
                        }
                    ],
                    "synonyms": [
                        "puzzle",
                        "perplex",
                        "bewilder",
                        "baffle",
                        "confound",
                        "muddle",
                        "disorient"
                    ],
                    "antonyms": [
                        "clarify",
                        "enlighten"
                    ],
                    "common_phrases": [
                        "confuse the issue",
                        "confuse matters",
                        "easily confuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то чувствовать неуверенность, озадачить или лишить ясности понимания.",
                        "zh": "使某人感到困惑、迷茫或无法清晰理解某事。",
                        "es": "Hacer que alguien se sienta inseguro, desconcertado o incapaz de entender algo con claridad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "лишать соображения, приводить в замешательство"
                            },
                            {
                                "target_lang_word": "запутывать",
                                "target_lang_sense_clarification": "делать неясным, сложным для понимания"
                            },
                            {
                                "target_lang_word": "смущать",
                                "target_lang_sense_clarification": "вызывать недоумение, растерянность или неловкость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使困惑",
                                "target_lang_sense_clarification": "使人感到不解或迷茫"
                            },
                            {
                                "target_lang_word": "搅乱",
                                "target_lang_sense_clarification": "使事情变得混乱或难以理解"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "confundir",
                                "target_lang_sense_clarification": "causar desconcierto o falta de claridad mental"
                            },
                            {
                                "target_lang_word": "desconcertar",
                                "target_lang_sense_clarification": "dejar a alguien sin saber qué pensar o hacer"
                            },
                            {
                                "target_lang_word": "embrollar",
                                "target_lang_sense_clarification": "hacer que una situación sea más difícil de entender"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48675c4e-1c00-36b8-9edb-1011e2947174",
                    "sense_definition": "To wrongly think that one person or thing is someone or something else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People often <w>confuse</w> me with my twin brother.",
                            "target_lang_translations": {
                                "ru": "Люди часто <w>путают</w> меня с моим братом-близнецом.",
                                "zh": "人们经常把我跟我双胞胎哥哥<w>搞混</w>。",
                                "es": "La gente a menudo me <w>confunde</w> con mi hermano gemelo."
                            }
                        },
                        {
                            "text": "You should not <w>confuse</w> confidence with arrogance.",
                            "target_lang_translations": {
                                "ru": "Не следует <w>путать</w> уверенность с высокомерием.",
                                "zh": "你不应该把自信和傲慢<w>混淆</w>起来。",
                                "es": "No deberías <w>confundir</w> la confianza con la arrogancia."
                            }
                        }
                    ],
                    "synonyms": [
                        "mix up",
                        "mistake",
                        "muddle up"
                    ],
                    "antonyms": [
                        "distinguish"
                    ],
                    "common_phrases": [
                        "confuse with",
                        "confuse for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочно принимать одного человека или предмет за другого.",
                        "zh": "错误地将一个人或事物当作另一个人或事物。",
                        "es": "Pensar erróneamente que una persona o cosa es otra distinta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путать",
                                "target_lang_sense_clarification": "не различать, принимать одно за другое"
                            },
                            {
                                "target_lang_word": "перепутать",
                                "target_lang_sense_clarification": "совершить ошибку в идентификации (совершенный вид)"
                            },
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "не видеть разницы между понятиями или вещами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混淆",
                                "target_lang_sense_clarification": "将事物混在一起，无法区分"
                            },
                            {
                                "target_lang_word": "搞混",
                                "target_lang_sense_clarification": "错误地识别或区分"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "confundir",
                                "target_lang_sense_clarification": "tomar una cosa o persona por otra"
                            },
                            {
                                "target_lang_word": "equivocarse",
                                "target_lang_sense_clarification": "cometer un error al identificar a alguien o algo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "101a76fe-fbb3-3842-a129-898f03587004",
                    "sense_definition": "Disordered or mixed up; an archaic form of the adjective confused.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text was written in a <w>confuse</w> and difficult style.",
                            "target_lang_translations": {
                                "ru": "Древний текст был написан <w>запутанным</w> и трудным стилем.",
                                "zh": "那篇古文的写作风格十分<w>混乱</w>且晦涩难懂。",
                                "es": "El texto antiguo estaba escrito en un estilo <w>confuso</w> y difícil."
                            }
                        },
                        {
                            "text": "His thoughts remained <w>confuse</w> despite his attempts to organize them.",
                            "target_lang_translations": {
                                "ru": "Его мысли оставались <w>сбивчивыми</w>, несмотря на попытки привести их в порядок.",
                                "zh": "尽管他试图整理思绪，但他的想法依然十分<w>杂乱</w>。",
                                "es": "Sus pensamientos permanecían <w>confusos</w> a pesar de sus intentos por organizarlos."
                            }
                        }
                    ],
                    "antonyms": [
                        "organize"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The standard modern adjective is 'confused'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочный или смешанный; устаревшая форма прилагательного \"confused\".",
                        "zh": "杂乱无章或混乱的；这是形容词 confused 的古旧用法。",
                        "es": "Desordenado o mezclado; una forma arcaica del adjetivo 'confused'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "сложный, непонятный"
                            },
                            {
                                "target_lang_word": "сбивчивый",
                                "target_lang_sense_clarification": "беспорядочный, лишенный логики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混乱的",
                                "target_lang_sense_clarification": "缺乏秩序或逻辑的"
                            },
                            {
                                "target_lang_word": "杂乱的",
                                "target_lang_sense_clarification": "混杂在一起且不整齐的"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "confuso",
                                "target_lang_sense_clarification": "que carece de orden o claridad"
                            },
                            {
                                "target_lang_word": "desordenado",
                                "target_lang_sense_clarification": "que no tiene una estructura lógica o física"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}