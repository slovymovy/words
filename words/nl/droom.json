                    "semantic_group_id": "sleeping_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik had vannacht een heel vreemde <w>droom</w>.",
                            "target_lang_translations": {
                                "en": "I had a very strange <w>dream</w> last night.",
                                "ru": "Мне сегодня ночью приснился очень странный <w>сон</w>.",
                                "pl": "Miałem zeszłej nocy bardzo dziwny <w>sen</w>.",
                                "de": "Ich hatte letzte Nacht einen sehr seltsamen <w>Traum</w>.",
                                "fr": "J'ai fait un <w>rêve</w> très étrange cette nuit.",
                                "it": "Stanotte ho fatto uno <w>sogno</w> molto strano.",
                                "cs": "Dnes v noci se mi zdál velmi zvláštní <w>sen</w>.",
                                "tr": "Bu gece çok tuhaf bir <w>rüya</w> gördüm.",
                                "es": "Tuve un <w>sueño</w> muy extraño anoche.",
                                "zh": "我昨晚做了一个很奇怪的<w>梦</w>。"
                            }
                        },
                        {
                            "text": "In mijn <w>droom</w> kon ik vliegen als een vogel.",
                            "target_lang_translations": {
                                "en": "In my <w>dream</w> I could fly like a bird.",
                                "ru": "В моем <w>сне</w> я мог летать как птица.",
                                "pl": "W moim <w>śnie</w> potrafiłem latać jak ptak.",
                                "de": "In meinem <w>Traum</w> konnte ich wie ein Vogel fliegen.",
                                "fr": "Dans mon <w>rêve</w>, je pouvais voler comme un oiseau.",
                                "it": "Nel mio <w>sogno</w> potevo volare come un uccello.",
                                "cs": "Ve svém <w>sně</w> jsem mohl létat jako pták.",
                                "tr": "<w>Rüyamda</w> bir kuş gibi uçabiliyordum.",
                                "es": "En mi <w>sueño</w> podía volar como un pájaro.",
                                "zh": "在我的<w>梦</w>里，我可以像鸟一样飞翔。"
