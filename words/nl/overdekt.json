                            }
                        },
                        {
                            "text": "In een <w>overdekt</w> winkelcentrum winkel je altijd droog.",
                            "target_lang_translations": {
                                "fr": "Dans un centre commercial <w>couvert</w>, on fait toujours ses courses au sec."
