                {
                    "sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                    "sense_definition": "A secluded and narrow valley, especially one with a river running through it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers set up their camp in a sheltered <w>glen</w> near the stream.",
                            "target_lang_translations": {
                                "ru": "Туристы разбили лагерь в укрытой <w>лощине</w> у ручья.",
                                "it": "Gli escursionisti hanno montato il campo in una <w>valletta</w> riparata vicino al ruscello."
                            }
                        },
                        {
                            "text": "Mist covered the wooded <w>glen</w> as the sun began to rise over the mountains.",
                            "target_lang_translations": {
                                "ru": "Туман окутал лесистую <w>узкую долину</w>, когда солнце начало всходить над горами.",
                                "it": "La nebbia copriva la <w>valletta</w> boscosa mentre il sole iniziava a sorgere sopra le montagne."
                            }
                        }
                    ],
                    "synonyms": [
                        "valley",
                        "dale"
                    ],
                    "common_phrases": [
                        "wooded glen",
                        "mountain glen",
                        "fairy glen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уединенная узкая долина, особенно с протекающей по ней рекой.",
                        "it": "Una valle stretta e isolata, specialmente una attraversata da un fiume."
                    },
                    "translations": {
