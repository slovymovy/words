{
    "word_family": [
        "administration",
        "administrative",
        "administrator",
        "administrate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34a37171-b482-32f2-9c97-ef3d84d1a41a",
                    "sense_definition": "To manage, supervise, or govern the conduct or execution of something, such as a business, program, or country.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new director was hired to <w>administer</w> the daily operations of the large hospital.",
                            "target_lang_translations": {
                                "ru": "Новый директор был нанят, чтобы <w>управлять</w> повседневной деятельностью этой крупной больницы."
                            }
                        },
                        {
                            "text": "It is difficult to <w>administer</w> a program when the budget is constantly being reduced.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>руководить</w> программой, когда бюджет постоянно сокращается."
                            }
                        }
                    ],
                    "synonyms": [
                        "manage",
                        "direct",
                        "govern",
                        "supervise",
                        "run"
                    ],
                    "common_phrases": [
                        "administer a program",
                        "administer justice",
                        "administer an estate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять, контролировать или руководить ведением или исполнением чего-либо, например, бизнеса, программы или страны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "руководить деятельностью"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "быть во главе процесса"
                            },
                            {
                                "target_lang_word": "администрировать",
                                "target_lang_sense_clarification": "осуществлять административное управление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb50ee5a-248b-3911-a0ae-77d06268b79d",
                    "sense_definition": "To give or apply a medical treatment or drug to a patient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse will <w>administer</w> the medication to the patient every four hours.",
                            "target_lang_translations": {
                                "ru": "Медсестра будет <w>вводить</w> лекарство пациенту каждые четыре часа."
                            }
                        },
                        {
                            "text": "It is important to <w>administer</w> first aid immediately after an accident occurs.",
                            "target_lang_translations": {
                                "ru": "Важно <w>оказать</w> первую помощь сразу после несчастного случая."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispense",
                        "give",
                        "apply"
                    ],
                    "common_phrases": [
                        "administer medication",
                        "administer first aid",
                        "administer a dose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать или применять медицинское лечение или лекарство пациенту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить",
                                "target_lang_sense_clarification": "лекарство или препарат"
                            },
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "лекарство пациенту"
                            },
                            {
                                "target_lang_word": "оказывать",
                                "target_lang_sense_clarification": "первую помощь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2e67a03-dedc-31c0-9a50-f20658b2c0af",
                    "sense_definition": "To formally give or oversee the taking of something, such as an oath, a test, or a penalty.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "formal_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge will <w>administer</w> the oath of office to the newly elected mayor.",
                            "target_lang_translations": {
                                "ru": "Судья <w>приведет к</w> присяге вновь избранного мэра."
                            }
                        },
                        {
                            "text": "Teachers are required to <w>administer</w> the standardized test under very strict conditions.",
                            "target_lang_translations": {
                                "ru": "Учителя обязаны <w>проводить</w> стандартизированный тест в очень строгих условиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "deliver",
                        "inflict",
                        "proffer"
                    ],
                    "common_phrases": [
                        "administer an oath",
                        "administer a test",
                        "administer a punishment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально проводить или контролировать принятие чего-либо, например, присяги, теста или наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "тест или экзамен"
                            },
                            {
                                "target_lang_word": "приводить к",
                                "target_lang_sense_clarification": "присяге"
                            },
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "наказание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70698147-c871-3d6f-a48f-608330d6f38b",
                    "sense_definition": "To distribute or deal out something in portions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity began to <w>administer</w> relief supplies to the victims of the flood.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация начала <w>распределять</w> гуманитарную помощь среди пострадавших от наводнения."
                            }
                        },
                        {
                            "text": "The committee must <w>administer</w> the funds fairly among all the applicants.",
                            "target_lang_translations": {
                                "ru": "Комитет должен справедливо <w>распределить</w> средства между всеми заявителями."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "allocate",
                        "allot",
                        "apportion"
                    ],
                    "common_phrases": [
                        "administer relief",
                        "administer funds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределять или выдавать что-либо частями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "ресурсы или помощь"
                            },
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "порциями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a925f61e-6870-31f4-8a55-6450841044a4",
                    "sense_definition": "To manage and settle the financial affairs and property of a deceased person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was appointed to <w>administer</w> the estate after the owner passed away without a will.",
                            "target_lang_translations": {
                                "ru": "Адвокат был назначен <w>управлять</w> имуществом после того, как владелец скончался, не оставив завещания."
                            }
                        },
                        {
                            "text": "It can take several months to fully <w>administer</w> a complex inheritance.",
                            "target_lang_translations": {
                                "ru": "Полное <w>оформление</w> сложного наследства может занять несколько месяцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "settle",
                        "liquidate"
                    ],
                    "common_phrases": [
                        "administer an estate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять и урегулировать финансовые дела и имущество умершего человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "наследственным имуществом"
                            },
                            {
                                "target_lang_word": "распоряжаться",
                                "target_lang_sense_clarification": "имуществом покойного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}