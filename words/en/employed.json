        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d56baf9-bca2-30fc-b117-352700c8a419",
                    "sense_definition": "Having a paid job; working.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "job_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>employed</w> as a manager at a local bank.",
                            "target_lang_translations": {
                                "ru": "Она в настоящее время <w>трудоустроена</w> менеджером в местном банке.",
                                "de": "Sie ist derzeit als Managerin bei einer örtlichen Bank <w>angestellt</w>.",
                                "pl": "Obecnie jest <w>zatrudniona</w> jako menedżer w lokalnym banku.",
                                "tr": "Şu anda yerel bir bankada müdür olarak <w>çalışıyor</w>.",
                                "zh": "她目前在当地一家银行<w>受雇</w>担任经理。"
                            }
                        },
                        {
                            "text": "He hopes to be gainfully <w>employed</w> again very soon.",
                            "target_lang_translations": {
                                "ru": "Он надеется очень скоро снова быть официально <w>трудоустроенным</w>.",
                                "de": "Er hofft, sehr bald wieder <w>erwerbstätig</w> zu sein.",
                                "pl": "Ma nadzieję, że wkrótce znów będzie <w>pracował</w> zarobkowo.",
                                "tr": "Çok yakında yeniden kazançlı bir işte <w>istihdam edilmeyi</w> umuyor.",
                                "zh": "他希望很快能再次获得一份有报酬的<w>工作</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "working",
                        "hired"
                    ],
                    "antonyms": [
                        "unemployed",
                        "jobless"
                    ],
                    "common_phrases": [
                        "gainfully employed",
                        "self-employed",
                        "currently employed",
                        "fully employed"
                    ],
                    "target_lang_definitions": {
