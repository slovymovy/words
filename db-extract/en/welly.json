                        ],
                        "examples": [
                            {
                                "example_id": "be916305-60bd-4fdf-8058-f8599835dd37",
                                "sense_id": "6cc9e58d-befd-38da-be54-09fb1207c57f",
                                "text": "Dad has great big welly boots. For squishing in the mud; Two great big black welly boots: Thud, thud, thud."
                            }
                        ]
                    },
                    {
                        "sense_id": "721cb33d-b1e4-30dc-961b-b279ec3dc352",
                        "entry_id": "f57060be-8917-32e1-859b-c2230aa1097a",
