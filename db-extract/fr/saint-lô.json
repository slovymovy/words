                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département de la Manche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e34d76c4-38e2-4f04-ac32-c7cbc1a3c234",
                                "sense_id": "a09217fd-780f-3f25-849d-159c68996bd4",
                                "text": "Tandis que les deux maris visitaient Saint-Lô, ses vieilles maisons, sa jolie cathédrale à chaire extérieure, les deux femmes se confinèrent dans leurs chambres, y déjeunèrent et n’en sortirent qu’au moment du départ."
                            },
                            {
                                "example_id": "43dad5df-9bfb-4b3d-a565-38654221ca43",
                                "sense_id": "a09217fd-780f-3f25-849d-159c68996bd4",
                                "text": "Il pleuvait des jours entiers à Saint-Lô, cet automne d'il y a quinze ans, et cela faisait de grandes flaques dans la cour de la caserne."
                            },
                            {
                                "example_id": "ba5174ae-b495-49ef-a5d2-597a1f37a2ab",
                                "sense_id": "a09217fd-780f-3f25-849d-159c68996bd4",
                                "text": "À Saint-Lô, le groupe Rebirth, ex-Easybike, projette d’assembler 48 000 vélos en 2023."
                            }
                        ]
                    }
