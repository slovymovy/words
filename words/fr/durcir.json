                                "target_lang_word": "harden",
                                "target_lang_sense_clarification": "stance, attitude or tone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ужесточить",
                                "target_lang_sense_clarification": "законы, правила, наказания"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verschärfen",
                                "target_lang_sense_clarification": "Regeln, Gesetze, Strafen"
                            },
                            {
                                "target_lang_word": "verhärten",
                                "target_lang_sense_clarification": "Fronten, Positionen, Standpunkte"
                            }
