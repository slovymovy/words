                ],
                "senses": [
                    {
                        "sense_id": "7b804f32-cfcd-3904-ae08-8b12c172cb5d",
                        "entry_id": "58f80767-b0a1-3005-93c2-66c112122d77",
                        "glosses": [
                            "Beeinträchtigung eines Spielablaufs oder auch Verhaltensauffälligkeit bei Spielenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5edff661-4993-4d02-b174-4b1de493b40f",
                                "sense_id": "7b804f32-cfcd-3904-ae08-8b12c172cb5d",
                                "text": "„Bei der Einführung von Spielen, bei Spielstörungen sowie in den Reflexions- und Auswertungsphasen muß er zeitweise Steuerungsfunktionen selbst wahrnehmen und in die Spielprozesse manchmal direkt eingreifen.“"
                            },
                            {
                                "example_id": "a5f0949d-3ce4-402b-85b5-c116aa196a70",
                                "sense_id": "7b804f32-cfcd-3904-ae08-8b12c172cb5d",
                                "text": "„Die Aufzählung der Spielstörungen beansprucht keine Vollständigkeit und stellt keine Rangfolge dar.“"
                            },
                            {
                                "example_id": "1ba90b20-62e4-4680-b2a0-5d3ea8cca0bf",
                                "sense_id": "7b804f32-cfcd-3904-ae08-8b12c172cb5d",
                                "text": "„Als Spielstörung ist auch übermäßig aggressives Verhalten im Spiel zu verstehen, das häufig bei Kindern mit hirnorganischen Schädigungen oder Funktionsstörungen zu finden ist und diesen Kindern auf dem Hintergrund ihres Erethismus (übermäßige Erregbarkeit) nur dranghafte Destruktivität zulässt.“"
                            },
                            {
                                "example_id": "38e5b0e7-9036-4329-b6d1-7dcd468af096",
                                "sense_id": "7b804f32-cfcd-3904-ae08-8b12c172cb5d",
                                "text": "„Manchmal wird erst rückblickend aus einer manifesten Lern- oder Arbeitshemmung eine Spielstörung in der Kindheit diagnostiziert, die damit die Kontinuität einer bis in die frühe Kindheit zurückreichenden milieureaktiven Leistungshemmung herstellt.“"
                            },
                            {
                                "example_id": "9ec99d5f-e0e9-4f1c-977e-d90e3f8c2ec2",
                                "sense_id": "7b804f32-cfcd-3904-ae08-8b12c172cb5d",
                                "text": "„Leidet ein Vorschulkind mit Defiziten der motorischen Planung, das (im Gegensatz zu den meisten Kindern seines Alters) zwar nicht gern auf Spielplätzen, aber dafür umso lieber im Haus spielt, an einer Spielstörung?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
