                "senses": [
                    {
                        "sense_id": "d49dbcc5-859c-3e40-927f-5ae7678d9a7c",
                        "entry_id": "810ceb79-91df-3ca4-bc80-17f03a7d85c2",
                        "glosses": [
                            "Zustand, in dem das empfundene Geschlecht (Geschlechtsidentität) von den (ursprünglichen) körperlichen Geschlechtsmerkmalen abweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919e9a7a-1aab-4060-8b93-2efb139fda6b",
                                "sense_id": "d49dbcc5-859c-3e40-927f-5ae7678d9a7c",
                                "text": "„In diesem Buch möchte ich diese Veränderungen in der Auffassung von Transidentität anhand der verschiedenen Diagnosen »Transsexualismus« (ICD-10), »Genderdysphorie« (DSM-5), »Geschlechtsinkongruenz« (ICD-11) und »Transidentität« (ein Begriff, der in keinem international gebräuchlichen Diagnosesystem auftaucht) darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3a44092-d34a-4005-99e1-7aed7cb40ecc",
                        "source_entry_id": "810ceb79-91df-3ca4-bc80-17f03a7d85c2",
                        "source_sense_id": "d49dbcc5-859c-3e40-927f-5ae7678d9a7c",
                        "source_sense_description": "Abweichung zwischen Geschlechtsidentität und körperlichen Geschlechsmerkmalen",
                        "target_lang_word": "transidentity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transidentity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03df9ebd-3f4f-32a6-89ed-a18e416f2fbb",
                                        "entry_id": "a5ab8ef6-5289-3e52-aef6-33b9bacb1b2e",
                                        "glosses": [
                                            "Transness; the state of being transgender."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d159ba8-4370-42de-b3ab-b8d654d11450",
                                                "sense_id": "03df9ebd-3f4f-32a6-89ed-a18e416f2fbb",
                                                "text": "[Joanne; male → transgender (i.e.neither male nor female) or genderqueer; 44; preoperative]\nJoanne's decision to come out publicly shows that ze transformed from not accepting hir transidentity to embracing and affirming it."
                                            },
                                            {
                                                "example_id": "6d173459-3a0b-4e71-b504-8e524b932a10",
                                                "sense_id": "03df9ebd-3f4f-32a6-89ed-a18e416f2fbb",
                                                "text": "Her transidentity, which bridged the established dichotomy between gender identity and anatomical sex, was the result of her choice to undergo a de-construction/re-construction process of her body: new breasts, hips and thighs, hair loss, beard removal […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e3daac5-fa29-4dc1-8911-2d09e7de0839",
                        "source_entry_id": "810ceb79-91df-3ca4-bc80-17f03a7d85c2",
                        "source_sense_id": "d49dbcc5-859c-3e40-927f-5ae7678d9a7c",
                        "source_sense_description": "Abweichung zwischen Geschlechtsidentität und körperlichen Geschlechsmerkmalen",
                        "target_lang_word": "transidentité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transidentité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8acd5f2e-9503-365c-a5f7-7dc15b728732",
                                        "entry_id": "f2b90ff5-8d63-3041-bfe2-8c8995e03c17",
                                        "glosses": [
                                            "État d’une personne qui s’identifie d’un genre différent que celui déterminé à la naissance."
                                        ],
                                        "tags": [
                                            "Transitude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f293a5-09d3-4f36-9af3-0b47dcf04648",
                                                "sense_id": "8acd5f2e-9503-365c-a5f7-7dc15b728732",
                                                "text": "Si l’on avait dit à Blaise, quand il était encore étudiant à Versailles, qu’il monterait un jour sur scène pour affirmer sa transidentité, il ne l’aurait probablement pas cru."
                                            },
                                            {
                                                "example_id": "b417569a-64f4-4d3f-bbb0-28e6bfa6c7bb",
                                                "sense_id": "8acd5f2e-9503-365c-a5f7-7dc15b728732",
                                                "text": "Les fouilles devraient alors être réalisées par des agents du même genre, préalablement sensibilisés à la transidentité."
                                            },
                                            {
                                                "example_id": "309b59a0-b5ed-4122-844c-fae414ab1e74",
                                                "sense_id": "8acd5f2e-9503-365c-a5f7-7dc15b728732",
                                                "text": "À l’image de la hausse des chiffres sur les discriminations qui soulèvent la question « sont-elles plus nombreuses ou les victimes les dénoncent-elles plus qu’auparavant ? », la transidentité pose une question similaire : « les chiffres des transitions augmentent-ils ou les personnes trans sont-elles mieux informées et plus soutenues pour engager des transitions ? »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd78dd2-b015-3513-adc6-feac76e88262",
                                        "entry_id": "f2b90ff5-8d63-3041-bfe2-8c8995e03c17",
                                        "glosses": [
                                            "Identité plurielle, qui traverse plusieurs définitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19a192f-73db-4f14-8174-22320d3e27cc",
                                                "sense_id": "efd78dd2-b015-3513-adc6-feac76e88262",
                                                "text": "…recherche sur la transnationalité, la transculturalité et la transidentité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
