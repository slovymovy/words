                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "04675aa8-8c95-4621-98b4-6e71a10845ec",
                        "source_entry_id": "04a57178-70e2-3905-8a66-f3f133c69792",
                        "source_sense_id": "74579c36-ad2c-3a95-84ee-04b6fea51a51",
                        "target_lang_word": "Elbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c123c43e-6d85-3e94-b489-74bcb7caea41",
                                        "entry_id": "b23c05e7-c6ce-3800-a2fd-d6c060274752",
                                        "glosses": [
                                            "mitteleuropäischer Fluss, Strom in Europa, der im Riesengebirge entspringt, danach Tschechien und Deutschland durchfließt und nordwestlich von Hamburg in die Nordsee mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8586a162-6d86-40ad-9bb2-b0c9d32e950b",
                                                "sense_id": "c123c43e-6d85-3e94-b489-74bcb7caea41",
                                                "text": "Die Elbe entspringt im Riesengebirge."
                                            },
                                            {
                                                "example_id": "f798b253-e4bf-47d1-8cdc-a8966cb975ea",
                                                "sense_id": "c123c43e-6d85-3e94-b489-74bcb7caea41",
                                                "text": "„Der Platz war auch dafür geeignet, insofern als hier vermutlich eine alte Handelsstraße, die von der Elbe kam, die Dosse überschritt und sich bereits eine größere wendische Niederlassung hier befunden hatte, die im 10. Jh. Mittelpunkt eines Burgwardes war.“"
                                            },
                                            {
                                                "example_id": "0dc87d5c-b434-4ea6-8534-965ba43d3bda",
                                                "sense_id": "c123c43e-6d85-3e94-b489-74bcb7caea41",
                                                "text": "Wir überquerten die Elbe."
                                            },
                                            {
                                                "example_id": "5704bb44-306e-49f9-a5d5-468c18353b28",
                                                "sense_id": "c123c43e-6d85-3e94-b489-74bcb7caea41",
                                                "text": "Die Kinder versuchten, in der Elbe zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Elbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c38d09-1104-3a63-b131-4eb6134940c1",
                                        "entry_id": "d7b9c0d5-0b79-3ce3-976f-fda9b999a63f",
                                        "glosses": [
                                            "Fabelwesen, Naturgeist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a115129-e576-408a-b930-6240970a3b98",
                                                "sense_id": "b9c38d09-1104-3a63-b131-4eb6134940c1",
                                                "text": "Elben werden oft mit spitzen Ohren dargestellt."
                                            },
                                            {
                                                "example_id": "e58c5206-7206-4ec7-962b-3e5f20ee1a5d",
                                                "sense_id": "b9c38d09-1104-3a63-b131-4eb6134940c1",
                                                "text": "„Kein Wunder, daß den klugen Elben und Zwergen die Gabe der Weißsagung zugeschrieben wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Elbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                        "entry_id": "c87515a8-3b87-39c6-a7fc-10bd67ecad22",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c98609-e250-4c79-ade4-5871c6840ca4",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "Frau Elbe ist nett."
                                            },
                                            {
                                                "example_id": "959b7bd4-a33a-452b-ac61-109fac0d7691",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "Wir sind heute Abend bei Elbes eingeladen."
                                            },
                                            {
                                                "example_id": "647c6440-539a-41cd-97fd-a0aa7a9ce21a",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "Die Elbes von nebenan haben jetzt einen Hund."
                                            },
                                            {
                                                "example_id": "04d9b58e-4634-4a0c-80a0-2f2932c16d9e",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "Der alte Elbe kauft sich einen neuen Rasenmäher."
                                            },
                                            {
                                                "example_id": "19d3c2ad-7fd2-4a56-8143-f1124e9956c4",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "Wo steckt denn Elbe schon wieder?"
                                            },
                                            {
                                                "example_id": "8e590001-f253-46fe-8281-16ea5e92182b",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "„In A. (d.h. Auguste) von der Elbes Erzählung ‚Astolf der Cherusker‘ [Berlin 1898] erhält der junge Brukterer Ubbo von seiner Schwester Veleda folgenden Rat für den Umgang mit den Römern: …“"
                                            },
                                            {
                                                "example_id": "4ca6268c-4fee-4d7a-b574-b082d6ca463f",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "„Die Grünen-Außenpolitikerin Müller wertet die neue Nachrufregel Westerwelles daher als Nachgeben gegenüber früheren Diplomaten mit FDP-Parteibuch. ‚Die Elbes im Ministerium versuchten damals ihr letztes Gefecht, es war eine Art Kulturkampf – und den haben sie verloren‘, so Müller.“"
                                            },
                                            {
                                                "example_id": "c3a4c5ac-9efc-4c55-a6f0-2a0598cfcb30",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "„Wie das ihm sagen. Lieber mich von Elbes demütigen lassen. Ermahne meinen Sohn, besser mich, das Kreuze krumm, jeden Schlag in mich gefressen. Warum arbeite ich, wir kauften bei Elbes. Herr Elbe stammt aus der gleichen Straße wie ich. Jugendbekanntschaft.“"
                                            },
                                            {
                                                "example_id": "797e72a1-7a41-4db3-ba20-bcd3094a1052",
                                                "sense_id": "bc9434dd-978a-3138-b956-a4ad7e87c78a",
                                                "text": "„Gut drei Wochen hat das Eichhörnchen jetzt bei den Elbes gelebt. Doch nun kommt die Zeit, Abschied zu nehmen. Dany wird wieder ausgewildert. „Wir werden noch den Schlafkasten hinstellen und Futter bereithalten“, sagt [Karl-Heinz] Elbe. Doch dann muss sich Dany wieder an die freie Wildbahn gewöhnen. “"
                                            }
