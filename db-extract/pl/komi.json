                                        "examples": [
                                            {
                                                "example_id": "8e0f55a7-f804-4b56-bf41-27a491ddccb9",
                                                "sense_id": "9f691fbd-b5e5-3a9e-a4be-00769d6e4b11",
                                                "text": "In 1376 he set out to establish his mission among the Komi people of the Perm’ region, and achieved enough success for the Metropolitan to make him bishop […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
