                "senses": [
                    {
                        "sense_id": "50aa6bc3-7e89-309d-8230-4fb0a3d02917",
                        "entry_id": "686ff76e-3cd7-3276-90c8-77ff454c7d19",
                        "glosses": [
                            "Conserver dans le plain mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4566b6ce-156e-48b2-a308-96f1760aa961",
                                "sense_id": "50aa6bc3-7e89-309d-8230-4fb0a3d02917",
                                "text": "Ce séjour dans le plain mort est ce qu'on appelle morplamer."
                            },
                            {
                                "example_id": "c0febb1f-3f0a-4b37-bb83-f3231060d09f",
                                "sense_id": "50aa6bc3-7e89-309d-8230-4fb0a3d02917",
                                "text": "Quand il a servi à ces mille cuirs, c'est un plain mort ; il ne sert plus qu'à sauver, c'est-à-dire, à conserver les cuirs en attendant qu'on les travaille, ou à morplamer, c’est-à-dire, préparer au plain neuf les cuirs qui ont été pelés & sauvés."
                            }
                        ]
                    }
                ],
