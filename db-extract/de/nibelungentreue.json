                    {
                        "form_id": "be6d2f69-1bbb-4621-a121-27042c735986",
                        "entry_id": "7f32b7bb-9282-3e2d-a662-b96c1e75fac9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Nibelungentreue"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                        "entry_id": "7f32b7bb-9282-3e2d-a662-b96c1e75fac9",
                        "glosses": [
                            "unbedingte Treue bis in den Tod"
                        ],
                        "tags": [
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b4e2631b-6cd4-4fbb-85da-858111313dd8",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„Ich sage schon gar nichts mehr gegen Ihren Professor, aber in diesem Falle wirkt die Nibelungentreue direkt grotesk!“"
                            },
                            {
                                "example_id": "675783e1-e277-4ff2-82e4-6105523adf4c",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„Nein, wenn Eugen Gerstenmaier nicht wäre und ein paar Unabhängige, die vergeblich nach Gesinnungsgenossen ausspähen, könnte man verzweifeln an so viel Untertanengeist, der obendrein mit Nibelungentreue verbrämt ist:[…].“"
                            },
                            {
                                "example_id": "dc71b536-250c-495d-a72a-f88f6c9b8215",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„[Tony] Blairs Entscheidung, im Umgang mit der westlichen Supermacht mögliche Differenzen niemals in die Öffentlichkeit zu tragen, verschärft den Eindruck blinder Nibelungentreue.“"
                            },
                            {
                                "example_id": "8ada75a7-c8f6-44c4-927b-2a4c38051e8c",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„Wenig Glück war dem Philosophen [Ernst] Bloch beschieden, wenn er sich auf das Feld der weit ausholenden Politikentwürfe herabließ - seine Nibelungentreue dem Marxismus gegenüber brachte ihn zu finsteren Fehlurteilen und veranlasste ihn, manch unappetitlichen Kommentar zu menschenverachtenden Inszenierungen (wie etwa den Stalinschen Schauprozessen) abzugeben.“"
                            },
                            {
                                "example_id": "5a18de3c-88b1-445b-bafd-9f6a514e43d2",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„Ob Simbabwe oder Libyen - das jetzige Verhalten Namibias lässt auf eine Nibelungentreue gegenüber den Machthabern schließen.“"
                            },
                            {
                                "example_id": "a3aea3aa-fd2e-44ba-8cda-fa5a562de5f8",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„Während der Kulturrevolution verbrachte [Israel] Epstein Jahre in Einzelhaft, aber das erschütterte seine Nibelungentreue zum chinesischen Kommunismus nicht.“"
                            },
                            {
                                "example_id": "6bc6375e-4f49-4f4f-832d-da2c605405ab",
                                "sense_id": "d5d33620-b05a-38fd-b4f1-e0b3963e9de0",
                                "text": "„Aber er hat recht damit, dass Teheran mehr verlieren könnte als nur strategische Vorteile in der Levante, wenn Assad stürzt, während die Iraner in ungebrochener Nibelungentreue zu ihm halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
