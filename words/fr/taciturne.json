                        "village taciturne"
                    ]
                },
                {
                    "sense_id": "f8226848-5d27-3ec6-98b6-b2f80fb3542c",
                    "sense_definition": "Qui inspire ou impose le silence, la mélancolie ou la gravité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "environnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une ambiance <w>taciturne</w> régnait dans la salle de réunion après l'annonce de la fermeture."
                        },
                        {
                            "text": "Le poète contemplait la beauté d'une nuit <w>taciturne</w> où seule brillait une lune pâle."
