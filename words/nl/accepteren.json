    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c92493ac-2bac-3b97-b64a-9275667545e3",
                    "sense_definition": "iets dat wordt aangeboden in ontvangst nemen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontvangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanzelfsprekend <w>accepteren</w> wij deze gulle donatie graag voor ons goede doel.",
                            "target_lang_translations": {
                                "en": "Naturally, we would like to <w>accept</w> this generous donation for our charity.",
                                "ru": "Разумеется, мы с радостью <w>примем</w> это щедрое пожертвование для нашего благотворительного фонда."
                            }
                        },
                        {
                            "text": "Een eerlijke ambtenaar mag nooit steekpenningen of smeergeld <w>accepteren</w>.",
                            "target_lang_translations": {
                                "en": "An honest official must never <w>accept</w> bribes or hush money.",
                                "ru": "Честный чиновник никогда не должен <w>принимать</w> взятки или подкуп."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvaarden",
                        "aannemen"
                    ],
                    "antonyms": [
                        "weigeren",
                        "afwijzen"
                    ],
                    "common_phrases": [
                        "een donatie accepteren",
                        "een cadeau accepteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to receive something that is offered",
                        "ru": "принимать что-то предложенное"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accept",
                                "target_lang_sense_clarification": "to receive something willingly"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "to receive or acquire something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "соглашаться взять предложенное"
                            },
                            {
                                "target_lang_word": "принять",
                                "target_lang_sense_clarification": "совершить акт получения подарка или предложения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6dd7ca4-2a04-3337-a0e9-60977e11c084",
                    "sense_definition": "zich neerleggen bij een situatie of iemands gedrag goedkeuren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "goedkeuring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eerst had haar familie moeite hem te <w>accepteren</w>, maar later waren ze dol op hem.",
                            "target_lang_translations": {
                                "en": "At first her family had trouble <w>accepting</w> him, but later they were fond of him.",
                                "ru": "Сначала её семье было трудно его <w>принять</w>, но позже они его очень полюбили."
                            }
                        },
                        {
                            "text": "Wij kunnen dit slechte voorstel niet <w>accepteren</w>, dus het moet direct van tafel.",
                            "target_lang_translations": {
                                "en": "We cannot <w>accept</w> this bad proposal, so it must be taken off the table immediately.",
                                "ru": "Мы не можем <w>принять</w> это плохое предложение, поэтому оно должно быть немедленно снято с обсуждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvaarden",
                        "aannemen"
                    ],
                    "antonyms": [
                        "verwerpen",
                        "bestrijden"
                    ],
                    "common_phrases": [
                        "de gevolgen accepteren",
                        "iemand accepteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to resign oneself to a situation or approve of someone's behavior",
                        "ru": "смириться с ситуацией или одобрить чье-то поведение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accept",
                                "target_lang_sense_clarification": "to regard as proper or to endure patiently"
                            },
                            {
                                "target_lang_word": "tolerate",
                                "target_lang_sense_clarification": "to allow or endure something"
                            },
                            {
                                "target_lang_word": "embrace",
                                "target_lang_sense_clarification": "to accept or support a person or idea willingly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "признавать кого-то или что-то как должное"
                            },
                            {
                                "target_lang_word": "смириться",
                                "target_lang_sense_clarification": "принять неприятную ситуацию"
                            },
                            {
                                "target_lang_word": "соглашаться",
                                "target_lang_sense_clarification": "одобрять предложение или условие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
