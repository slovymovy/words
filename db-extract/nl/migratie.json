                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "894f363c-5f79-3f53-87e2-e6094165e60b",
                                        "entry_id": "b5252c09-fe07-3ac7-a6fd-adfb9a95dc25",
                                        "glosses": [
                                            "Seasonal moving of animals, as mammals, birds or fish, especially between breeding and non-breeding areas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87115ca2-9360-44e3-af2e-2ada637794db",
                                                "sense_id": "894f363c-5f79-3f53-87e2-e6094165e60b",
                                                "text": "Many of these classic methods are still used, with some modern improvements. For example, with the aid of special microphones and automated sound detection software, ornithologists recently reported […] that pine siskins (Spinus pinus) undergo an irregular, nomadic type of nocturnal migration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9db7e8-0f66-3b26-9dde-ead7179fe03d",
                                        "entry_id": "b5252c09-fe07-3ac7-a6fd-adfb9a95dc25",
                                        "glosses": [
                                            "Movement in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32f2e3d1-ae96-4c62-8f9d-aa8b45985d17",
                                                "sense_id": "aa9db7e8-0f66-3b26-9dde-ead7179fe03d",
                                                "text": "The migration of lead from a can to the food inside it can cause lead poisoning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576d7372-96a2-3abd-89f7-d9368b3e7856",
                                        "entry_id": "b5252c09-fe07-3ac7-a6fd-adfb9a95dc25",
                                        "glosses": [
                                            "Instance of changing a platform from an environment to another one."
                                        ],
