    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b79dbd28-1606-335c-a66c-a218510d61d5",
                    "sense_definition": "Turned or twisted to one side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The picture on the wall was hanging <w>askew</w> after the earthquake.",
                            "target_lang_translations": {
                                "it": "Il quadro sulla parete era appeso <w>storto</w> dopo il terremoto."
                            }
                        },
                        {
                            "text": "He wore his hat <w>askew</w> to look more casual.",
                            "target_lang_translations": {
                                "it": "Portava il cappello <w>di traverso</w> per sembrare più disinvolto."
                            }
                        }
                    ],
                    "synonyms": [
                        "awry",
                        "crooked",
                        "lopsided"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "hanging askew",
                        "worn askew"
                    ],
                    "target_lang_definitions": {
                        "it": "Girato o storto verso un lato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "storto",
                                "target_lang_sense_clarification": "riferito a oggetti o posizioni non allineate"
                            },
                            {
                                "target_lang_word": "obliquo",
                                "target_lang_sense_clarification": "riferito a una posizione inclinata"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eea1824-4833-39f3-ac08-12f2598d40d5",
                    "sense_definition": "Untoward or unfavourable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unfavourable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everything went <w>askew</w> during the poorly planned event.",
                            "target_lang_translations": {
                                "it": "Tutto è <w>andato storto</w> durante l'evento mal pianificato."
                            }
                        },
                        {
                            "text": "The project plans went <w>askew</w> due to a lack of funding.",
                            "target_lang_translations": {
                                "it": "I piani del progetto sono <w>andati storti</w> a causa della mancanza di fondi."
                            }
                        }
                    ],
                    "synonyms": [
                        "awry"
                    ],
                    "common_phrases": [
                        "plans went askew"
                    ],
                    "target_lang_definitions": {
                        "it": "Andato male o in modo sfavorevole."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "andato storto",
                                "target_lang_sense_clarification": "riferito a piani o eventi che non hanno avuto successo"
                            },
                            {
                                "target_lang_word": "fallito",
                                "target_lang_sense_clarification": "riferito a progetti o iniziative"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "77680d15-092b-3dca-bd61-497e802e0ddf",
                    "sense_definition": "In a manner that is tilted to one side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shelf was mounted <w>askew</w> on the wall.",
                            "target_lang_translations": {
                                "it": "La mensola era montata <w>storta</w> sulla parete."
                            }
                        },
                        {
                            "text": "He tilted his head <w>askew</w> to listen better.",
                            "target_lang_translations": {
                                "it": "Ha inclinato la testa <w>di lato</w> per ascoltare meglio."
                            }
                        }
                    ],
                    "synonyms": [
                        "awry",
                        "crooked"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "tilted askew"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo inclinato verso un lato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "di traverso",
                                "target_lang_sense_clarification": "riferito a una posizione inclinata o non dritta"
                            },
                            {
                                "target_lang_word": "storto",
                                "target_lang_sense_clarification": "riferito a come qualcosa è posizionato"
                            }
                        ]
                    }
                }
            ]
        },
