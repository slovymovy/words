                        "form": "die Widerstandskraft"
                    },
                    {
                        "form_id": "e5bd922f-af63-4502-81a3-990c07804af9",
                        "entry_id": "acf40ccf-70b4-3c26-b75b-700507d75228",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Widerstandskräfte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                        "entry_id": "acf40ccf-70b4-3c26-b75b-700507d75228",
                        "glosses": [
                            "Eigenschaft, sich bedrohlichen Verhältnissen wehren, entgegensetzen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121ede60-a9f4-452c-aac3-7c3e0addda2c",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„Dabei hängt die Widerstandskraft der Menschen gerade in Zeiten der Krise von der Verlässlichkeit ihrer sozialen Beziehungen ab.“"
                            },
                            {
                                "example_id": "6c308c61-183e-4a1a-8255-365b91990d5d",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„Das eigentlich Erstaunliche an Mangrovenwäldern sei nicht ihre Widerstandskraft, sondern ihre Fähigkeit, immer wieder neues Terrain zu erobern, schreibt der Meeresbiologe Daniel Alongi in der jüngsten Ausgabe von Estuarine Science.“"
                            },
                            {
                                "example_id": "0119dc03-01a5-402e-ad54-90b064e0981e",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„Während ein paar Würmer kaum größeren Schaden anrichten, führt ein massiver Befall zu Blutarmut und verminderter Widerstandskraft gegen andere Krankheiten.“"
                            },
                            {
                                "example_id": "1ac3d4fe-cc9c-4c29-849d-20d58bfc4357",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„In ihrer Widerstandskraft und Unerschütterlichkeit wollten sich dann eine Stadt und eine Nation wiedererkennen.“"
                            },
                            {
                                "example_id": "b9d66e15-6dae-4787-95ea-10c28a194997",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„Die weichen Blütenblätter, in denen die Duftstoffe gebildet werden, sollten daher nicht zu empfindlich sein und bei Nässe schnell faulen; auch sollten insgesamt starke Widerstandskräfte gegen die üblichen Pilzkrankheiten bestehen.“"
                            },
                            {
                                "example_id": "fbdba57f-4eaf-4e1d-aeb6-71388cace117",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„Die Eltern hätten es natürlich gut gemeint mit Hannah, als sie deren Widerstandskräfte durch gutes Essen stärken wollten.“"
                            },
                            {
                                "example_id": "efd7036a-b1ff-487a-9d92-387cd1d293b1",
                                "sense_id": "5b3b91b5-2e9c-3bd1-a8c6-605f227002bd",
                                "text": "„Wie kein anderer hat der Deutsche wieder und wieder darauf gedrängt, die Widerstandskräfte der Volkswirtschaften zu stärken: Solide Staatshaushalte, Strukturreformen, Stopp der ultraexpansiven Geldpolitik sind Stichworte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
