                "senses": [
                    {
                        "sense_id": "9ab117ab-39a4-37f0-95c0-037735af7335",
                        "entry_id": "8243c086-0e62-322d-81a9-85ec9167c953",
                        "glosses": [
                            "Verteidigungsformation, bei der Wagen und Karren kreisförmig angeordnet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0d116db-c2c4-4975-8a34-3de68d4b0736",
                                "sense_id": "9ab117ab-39a4-37f0-95c0-037735af7335",
                                "text": "„Die Reitergruppe griff die geöffnete Wagenburg an, eroberte sie und hielt sie bis zur Ankunft der zu Hilfe eilenden Infanterie.“"
                            },
                            {
                                "example_id": "1e5ce8e6-f01e-4a67-abb1-5c1da2530646",
                                "sense_id": "9ab117ab-39a4-37f0-95c0-037735af7335",
                                "text": "„Die Wagenburg hatte den Vorteil, dass die Kämpfenden schwerer fliehen konnten.“"
                            },
                            {
                                "example_id": "7b8a6d51-516d-4e83-8e45-efcce2e2a6a5",
                                "sense_id": "9ab117ab-39a4-37f0-95c0-037735af7335",
                                "text": "„Als die Kanonade begann, stürmten Tausende von Bauernsoldaten in panischem Durcheinander innerhalb der Wagenburg hinunter zur Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
