                        ],
                        "form": "die Verkehrswenden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                        "entry_id": "28ef63b9-4e03-30b1-b11a-8c680f89411f",
                        "glosses": [
                            "grundlegende Umstellung der Straßen-, Flug-, Schiffs- und Schienenverkehre so, dass diese (nahezu) emissionsfrei werden"
                        ],
                        "tags": [
                            "Logistik",
                            "Umwelt",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "4e0cb5c8-e886-4f0e-92e9-fbf471049591",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "Eine Maßnahme der Verkehrswende ist vollkommen klar: Tschüss, Verbrenner!"
                            },
                            {
                                "example_id": "1005e200-1d4f-4d8a-8c17-5a5d9a3e358d",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„»Aber es gibt ja immer noch keine wirkliche Verkehrswende.«“"
                            },
                            {
                                "example_id": "59ea7710-015b-4863-931e-276790627d21",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "Bei ca. 47,5 Millionen Verbrennern auf Deutschlands Straßen in 2022 sind wir von einer echten Verkehrswende meilenweit entfernt."
                            },
                            {
                                "example_id": "811f2ea6-905f-47ce-8374-c835bffd3267",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Eine Verkehrswende ist nicht in Sicht.“"
                            },
                            {
                                "example_id": "f6269a35-c0b6-4318-ac4c-81e2f2a17665",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "Das Tempo der Verkehrswende ist einfach zu langsam."
                            },
                            {
                                "example_id": "59053e25-66d5-4a22-a858-5b20e4c7e699",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Allem aktuellen Gelaber von der Verkehrswende zum Trotz wurde es merkwürdig still um die externen Kosten, sie wurden jedenfalls nicht mehr offen kommuniziert.“"
                            },
                            {
                                "example_id": "282599be-c6d6-459e-80f4-7ad3293214c5",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "Die Klimaschutz-Bewegung \"Fridays for Future\" demonstriert für eine Verkehrswende und die Einhaltung der Pariser Klimaziele."
                            },
                            {
                                "example_id": "5a2a25c9-009b-4ff0-ac24-be61ee565e12",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Die Verkehrswende muss sich zuerst in den Köpfen der Menschen abspielen, mit technische Umstellungen wird man sie nicht lösen können, meinen Experten.“"
                            },
                            {
                                "example_id": "b9a55d89-b58e-4fc9-a42d-169aa35ecbbc",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Wenn es um die Verkehrswende in Zeiten des Klimaschutzes geht, sollen vor allem Elektroantriebe die fossilen Treibstoffe ersetzen.“"
                            },
                            {
                                "example_id": "45b5d0d0-daa1-40d2-94ca-e90d3d37db38",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Die Elektromobilität gilt als zentraler Baustein eines nachhaltigen und klimaschonenden Verkehrssystems auf Basis erneuerbarer Energien, wie es mit der Verkehrswende angestrebt wird.“"
                            },
                            {
                                "example_id": "b3c5339a-404b-48fb-8d30-436a91a92dbd",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Lithium wird nach jetzigem Stand der Technik für die Herstellung von Akkus für E-Autos benötigt und ist deshalb für die angestrebte Verkehrswende weg vom fossilen Verbrennermotor hin zur E-Mobilität von zentraler Bedeutung.“"
                            },
                            {
                                "example_id": "879e4e45-091c-4477-8832-c716068779be",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Ist die Verkehrswende in Deutschland gefährdet?“"
                            },
                            {
                                "example_id": "905b2349-1338-4706-b8ce-884e602eb8fe",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "[Schlagzeile:] „Mehr Rad, weniger Auto: Region Hannover plant Verkehrswende“"
                            },
                            {
                                "example_id": "ce2e412a-2f25-4f9d-8ce8-c2c8e32b43c7",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "[Das Maßnahmenpaket 2030 und der Masterplans Nachhaltige Mobilität der Stadt Nürnberg] „sollen die Grundlage für die Verkehrswende in Nürnberg bieten, welche zahlreiche Erweiterungen und Taktverdichtungen der Straßenbahn Nürnberg vorsehen.“"
                            },
                            {
                                "example_id": "4dce4f44-fd9c-4b81-97e2-11de9c68b819",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "[Mobilität auf dem Land:] „In vielen Gegenden geht ohne Auto gar nichts. Hier ist eine Verkehrswende dringend nötig“ […]."
                            },
                            {
                                "example_id": "65b24519-976f-46d6-aae7-9381f9232c76",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„Seit die Planungen für die Energie- und Verkehrswende und zur Abkehr von fossilen Brennstoffen immer konkreter werden, rückt der rasche Aus- und Aufbau von Produktionsstandorten für Batteriezellen in Europa immer mehr in den Blickpunkt.“"
                            },
                            {
                                "example_id": "b36ad56d-f438-41a5-9d1c-8e5c15a061ec",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "„»Mit einer Bauzeit von ca. 20 Jahren stellt sich die Frage, ob die U5 die angemessene Antwort auf die Dringlichkeit für mehr Klimaschutz und eine schnellwirksame Verkehrswende darstellt.«“"
                            },
                            {
                                "example_id": "0feff457-fc5a-4d03-b0b9-4b4c43d928ae",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "[Verringerung der Berliner CO₂-Emissionen bis 2030 um mindestens 95 Prozent im Vergleich zu 1990:] „Um das in dieser kurzen Zeit zu erreichen, müsste das Land viele Extra-Milliarden in die Verkehrswende, die Wärmeversorgung und die Dämmung von Gebäuden investieren.“"
                            },
                            {
                                "example_id": "8618f8a2-0237-4f9d-b655-2859328cbb94",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "[Schlagzeile:] „Mehr Schiene, weniger Straße – Wie realistisch ist die Verkehrswende im Güterverkehr?“"
                            },
                            {
                                "example_id": "e457b9fc-c378-4b75-a42d-e8ee12ef5ed8",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "74,4 km neue Bahnstrecken in 2022 sind ein nur ein sehr kleiner Beitrag zur Verkehrswende in Deutschland."
                            },
                            {
                                "example_id": "d303d0a7-c694-47a0-8fe0-c874cc8dad44",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "Der Flugverkehr wird bei Maßnahmen zur Verkehrswende praktisch ignoriert."
                            },
                            {
                                "example_id": "0e6d40a7-b4da-402c-b995-276770df85b6",
                                "sense_id": "745e9db8-5b22-387c-923c-3894f6f634df",
                                "text": "Beim internationalen Warenverkehr mit dreckigsten Containerschiffen gibt es keine Verkehrswende."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
