                ],
                "senses": [
                    {
                        "sense_id": "4b938a5c-4bb9-37a4-95a7-2ca3d4a36b66",
                        "entry_id": "4cc9ad59-97b0-3259-b8e0-2a023db96964",
                        "glosses": [
                            "Station in einem Krankenhaus für akute Notfälle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab8ef3a-7653-4e22-8320-52d18ad25549",
                                "sense_id": "4b938a5c-4bb9-37a4-95a7-2ca3d4a36b66",
                                "text": "Nach seinem Autounfall wurde er mit dem Krankenwagen in die Notaufnahme gebracht."
                            },
                            {
                                "example_id": "99ba5bfa-3d1f-497f-bd8e-b5cd29df484d",
                                "sense_id": "4b938a5c-4bb9-37a4-95a7-2ca3d4a36b66",
                                "text": "„Trotz allem waren sie jedoch beeindruckt, dass er es geschafft hatte, sich selbst zur Notaufnahme zu fahren.“"
                            },
                            {
                                "example_id": "b4a8218d-f418-4cfb-b2f5-32fb0d611bbc",
                                "sense_id": "4b938a5c-4bb9-37a4-95a7-2ca3d4a36b66",
                                "text": "„An diesem Sonntagabend wartet niemand weiter in der Notaufnahme des Klinikums Kehl.“"
                            },
                            {
                                "example_id": "3602fcee-5693-47c4-9080-787f2f6a47c2",
                                "sense_id": "4b938a5c-4bb9-37a4-95a7-2ca3d4a36b66",
                                "text": "„Das Bild des im Körper wie eingewachsenen Lenkrades verfolgte mich auf dem Weg in die Notaufnahme.“"
                            },
                            {
                                "example_id": "856b64a5-018b-4155-ab4f-d1d5d1c56eeb",
                                "sense_id": "4b938a5c-4bb9-37a4-95a7-2ca3d4a36b66",
                                "text": "„Sie war von der Notaufnahme inzwischen auf ein Zimmer verlegt worden, die Nummer 403.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97f57f1e-1e7b-3d61-bbab-61cdb981f018",
                        "entry_id": "4cc9ad59-97b0-3259-b8e0-2a023db96964",
                        "glosses": [
                            "die Aufnahme von flüchtigen Bürgern der DDR in die Bundesrepublik"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ccba1cb3-46ea-427e-aee3-89269a4c9170",
                                "sense_id": "97f57f1e-1e7b-3d61-bbab-61cdb981f018",
                                "text": "„Zur Notaufnahme bestimmte Lager wurden zunächst in Gießen und Uelzen (Bohldamm) eingerichtet. Das Notaufnahmelager Marienfelde folgte später.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
