                    {
                        "translation_id": "d804a5cb-a2af-4c91-ac3e-998b967eb586",
                        "source_entry_id": "d76cc907-258a-32e6-a338-ed4ca67b8ba5",
                        "source_sense_id": "8f611f1d-d585-3170-9d45-62fe6cac519d",
                        "target_lang_word": "Monotheismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monotheismus",
