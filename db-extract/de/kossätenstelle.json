                "senses": [
                    {
                        "sense_id": "4520069a-d64f-3682-9afd-e6bdd6eb0f15",
                        "entry_id": "06519261-3f59-3e58-942a-24b2c3d59721",
                        "glosses": [
                            "Anwesen eines Kossäten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd33408d-b3be-4c6e-a46c-3006676e97b2",
                                "sense_id": "4520069a-d64f-3682-9afd-e6bdd6eb0f15",
                                "text": "„Es fiel Paule auch nicht ein, als sein Vater starb und ihm die Kossätenstelle vererbte, auf diese Stelle zu verzichten, sie zu verkaufen und Bossdom zu verlassen, und also machte er sich zum Mitschuldigen der Verhältnisse, denen er lebenslänglich die Schuld an seiner Lage zuschob.“"
                            },
                            {
                                "example_id": "2c1b7292-eb80-4cc5-94b9-cb7b348f1098",
                                "sense_id": "4520069a-d64f-3682-9afd-e6bdd6eb0f15",
                                "text": "„Nach den Verwüstungen des Dreißigjährigen Krieges wurden 1652 17 Höfe und neun Kossätenstellen gezählt, doch waren hiervon 14 Höfe und vier Kossätenstellen wüst.“"
                            },
                            {
                                "example_id": "e4fae90d-7d77-4b6c-95cb-f536036aa3dc",
                                "sense_id": "4520069a-d64f-3682-9afd-e6bdd6eb0f15",
                                "text": "„1583 waren außerdem zwei Kossäten ansässig, eine Kossätenstelle war erst 1576 neu eingerichtet worden.“"
                            },
                            {
                                "example_id": "b148ca38-f26c-45dc-ab1f-5af3d5d4e38e",
                                "sense_id": "4520069a-d64f-3682-9afd-e6bdd6eb0f15",
                                "text": "„Die übrige Fläche wurde unter die Ansiedler verteilt. Jeder bekam 2- 3 Hufe Land, jede Kossätenstelle 1 bis 1 ½ Hufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
