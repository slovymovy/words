                                "target_lang_word": "chłopiec",
                                "target_lang_sense_clarification": "Syn w każdym wieku, pieszczotliwie."
                            },
                            {
                                "target_lang_word": "chłopak",
                                "target_lang_sense_clarification": "Syn, potocznie."
                            },
                            {
                                "target_lang_word": "syn",
                                "target_lang_sense_clarification": "Męskie potomstwo."
                            }
                        ],
                        "fr": [
