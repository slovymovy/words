                                    },
                                    {
                                        "sense_id": "fbdbc6ef-5788-373c-9abe-091182720fe4",
                                        "entry_id": "5e2fe423-08cd-3514-a5e3-71dfaed7dcf2",
                                        "glosses": [
                                            "To view or see again; to look back on."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1a9353-a962-4987-bbe9-ca52cd825a01",
                                                "sense_id": "fbdbc6ef-5788-373c-9abe-091182720fe4",
                                                "text": "Cam[illo] What I do next, ſhall be next to tell the King // Of this Eſcape, and whither they are bound: // Wherein my hope is, I ſhall ſo prevail, // To force him after: in whoſe company // I ſhall review Sicilia; for whoſe ſight, // I have a Woman’s Longing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc819d0-189a-38c9-85eb-72dde681abdf",
                                        "entry_id": "5e2fe423-08cd-3514-a5e3-71dfaed7dcf2",
                                        "glosses": [
                                            "To retrace; to go over again."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
