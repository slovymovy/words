                                                "sense_id": "b82d3869-62fc-3343-8e0c-bbb50cf5cfbb",
                                                "text": "the whole Scene of affairs was changed from Spain to France there now lay the prospective"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28bec010-4480-373d-bb06-cd524e3308ba",
                                        "entry_id": "b25aeb16-34f4-3f0d-ab52-002215f004d8",
                                        "glosses": [
                                            "A perspective glass."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f0e004-f66a-48ee-9752-fe10ee33b31c",
                                                "sense_id": "28bec010-4480-373d-bb06-cd524e3308ba",
                                                "text": "[T]hey [two pavillions] were trimmed on the inside with rich armour and military furniture, hanged up as upon the walls; and behind the tents there were represented, in prospective, the tops of divers other tents, as if it had been a camp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2cd60b0-50c0-3917-9910-e36217331854",
                                        "entry_id": "b25aeb16-34f4-3f0d-ab52-002215f004d8",
                                        "glosses": [
                                            "A prospective (potential) member, student, employee, date, partner, etc."
                                        ],
                                        "tags": [
                                            "informal",
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d62005d-bef1-4c5f-a4ce-8dc2a9ef2492",
                                                "sense_id": "d2cd60b0-50c0-3917-9910-e36217331854",
                                                "text": "Would you like to show the prospective around?"
                                            },
                                            {
                                                "example_id": "5ecb1374-d024-4e46-bcf0-61365f583b54",
                                                "sense_id": "d2cd60b0-50c0-3917-9910-e36217331854",
                                                "text": "I'm meeting the prospectives at 3."
                                            },
                                            {
                                                "example_id": "4005d6c9-86f7-4c04-acf2-c61ed12640e2",
                                                "sense_id": "d2cd60b0-50c0-3917-9910-e36217331854",
                                                "text": "At the moment, meeting interesting, 'could be, maybe not' prospectives around the globe keeps her entertained."
                                            }
                                        ]
