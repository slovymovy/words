{
    "word_family": [
        "roam",
        "roamer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a3662e9-92af-3f1f-9d63-b516444dc548",
                    "sense_definition": "The ability to use a mobile phone to make calls or access data when traveling outside of the home network's coverage area.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "telecommunications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should check the <w>roaming</w> charges before you travel abroad to avoid a huge bill.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить тарифы на <w>роуминг</w> перед поездкой за границу, чтобы избежать огромного счета."
                            }
                        },
                        {
                            "text": "My phone automatically switched to international <w>roaming</w> as soon as I crossed the border.",
                            "target_lang_translations": {
                                "ru": "Мой телефон автоматически переключился на международный <w>роуминг</w>, как только я пересек границу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "international roaming",
                        "roaming charges",
                        "data roaming",
                        "roaming fees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможность использовать мобильный телефон для звонков или доступа к данным при нахождении вне зоны покрытия домашней сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роуминг",
                                "target_lang_sense_clarification": "услуга связи вне домашней сети"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2baba5e-c897-320c-b517-b7fd6f79a35f",
                    "sense_definition": "The act of wandering or traveling around without a specific destination or purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of <w>roaming</w> across Europe, he finally decided to settle down in a small village.",
                            "target_lang_translations": {
                                "ru": "После многих лет <w>скитаний</w> по Европе он наконец решил поселиться в небольшой деревне."
                            }
                        },
                        {
                            "text": "Her restless <w>roaming</w> through the woods helped her clear her mind after a long day.",
                            "target_lang_translations": {
                                "ru": "Ее беспокойные <w>блуждания</w> по лесу помогли ей прояснить мысли после долгого дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "wandering",
                        "rambling",
                        "meandering"
                    ],
                    "common_phrases": [
                        "restless roaming",
                        "constant roaming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемещению или путешествию без определенного пункта назначения или цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скитания",
                                "target_lang_sense_clarification": "продолжительные странствия без цели"
                            },
                            {
                                "target_lang_word": "странствия",
                                "target_lang_sense_clarification": "путешествия по разным местам"
                            },
                            {
                                "target_lang_word": "блуждания",
                                "target_lang_sense_clarification": "бесцельное хождение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9f5a86f-4f85-3273-8aed-a0c837bd1488",
                    "sense_definition": "The present participle and gerund of <w>roam</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle were <w>roaming</w> freely across the open fields during the summer months.",
                            "target_lang_translations": {
                                "ru": "В летние месяцы скот свободно <w>бродил</w> по открытым полям."
                            }
                        },
                        {
                            "text": "He enjoys <w>roaming</w> the city streets late at night when everything is quiet.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>бродить</w> по городским улицам поздно ночью, когда все затихает."
                            }
                        }
                    ],
                    "synonyms": [
                        "wandering",
                        "strolling"
                    ],
                    "common_phrases": [
                        "roaming the streets",
                        "roaming around"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «roam» (бродить, скитаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "медленно ходить без цели"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "путешествовать без постоянного места жительства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}