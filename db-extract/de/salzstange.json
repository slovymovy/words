                                "sense_id": "4c35ef06-3b6c-3117-8cab-05d504f45953",
                                "text": "Salzstangen schmecken mir besser als Sesamstangen."
                            },
                            {
                                "example_id": "1a84e0c9-2be1-4302-af6c-8dddaae2ab9d",
                                "sense_id": "4c35ef06-3b6c-3117-8cab-05d504f45953",
                                "text": "„Ich lese Zeitung und knabbere das Salz von Salzstangen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
