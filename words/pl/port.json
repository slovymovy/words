{
    "word_family": [
        "porcik",
        "portowy",
        "portowiec"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eed7e52-91cc-3f60-bbf4-67ac768f6f7c",
                    "sense_definition": "Obszar na wybrzeżu morza, jeziora lub rzeki, wyposażony w infrastrukturę umożliwiającą przyjmowanie statków, ich załadunek i rozładunek.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maritime_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Duży statek pasażerski powoli wpłynął do <w>portu</w>.",
                            "target_lang_translations": {
                                "ru": "Большой пассажирский корабль медленно вошел в <w>порт</w>.",
                                "de": "Ein großes Passagierschiff lief langsam in den <w>Hafen</w> ein."
                            }
                        },
                        {
                            "text": "W tym <w>porcie</w> przeładowuje się tysiące kontenerów dziennie.",
                            "target_lang_translations": {
                                "ru": "В этом <w>порту</w> ежедневно перегружают тысячи контейнеров.",
                                "de": "In diesem <w>Hafen</w> werden täglich Tausende Container umgeschlagen."
                            }
                        }
                    ],
                    "synonyms": [
                        "przystań"
                    ],
                    "common_phrases": [
                        "wpłynąć do portu",
                        "port morski",
                        "port rybacki",
                        "wyjść z portu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория на берегу моря, озера или реки, оборудованная инфраструктурой для приема судов, их погрузки и разгрузки.",
                        "de": "Bereich an der Küste eines Meeres, Sees oder Flusses mit Anlagen zum Anlegen, Beladen und Entladen von Schiffen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порт",
                                "target_lang_sense_clarification": "место для стоянки судов"
                            },
                            {
                                "target_lang_word": "гавань",
                                "target_lang_sense_clarification": "прибрежная часть водного пространства"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hafen",
                                "target_lang_sense_clarification": "für Schiffe"
                            },
                            {
                                "target_lang_word": "Seehafen",
                                "target_lang_sense_clarification": "am Meer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f6ec6c-7859-3303-ad81-7e4e46c9913b",
                    "sense_definition": "Miasto nadmorskie, w którym znajduje się port; miasto portowe.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdańsk to znany polski <w>port</w> nad Morzem Bałtyckim.",
                            "target_lang_translations": {
                                "ru": "Гданьск — известный польский <w>порт</w> на Балтийском море.",
                                "de": "Danzig ist eine bekannte polnische <w>Hafenstadt</w> an der Ostsee."
                            }
                        },
                        {
                            "text": "Zatrzymaliśmy się w małym <w>porcie</w>, aby zjeść świeżą rybę.",
                            "target_lang_translations": {
                                "ru": "Мы остановились в маленьком <w>порту</w>, чтобы поесть свежей рыбы.",
                                "de": "Wir machten in einem kleinen <w>Hafenort</w> halt, um frischen Fisch zu essen."
                            }
                        }
                    ],
                    "synonyms": [
                        "miasto portowe"
                    ],
                    "common_phrases": [
                        "duży port",
                        "znany port"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приморский город, в котором расположен порт; портовый город.",
                        "de": "Küsten- oder Uferstadt mit einem Hafen; Hafenstadt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порт",
                                "target_lang_sense_clarification": "город"
                            },
                            {
                                "target_lang_word": "портовый город",
                                "target_lang_sense_clarification": "город с портом"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hafenstadt",
                                "target_lang_sense_clarification": "Stadt mit Hafen"
                            },
                            {
                                "target_lang_word": "Hafen",
                                "target_lang_sense_clarification": "als Stadt bezogen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4039fc8f-1efb-3dbd-8422-aca4d547baa2",
                    "sense_definition": "Duże lotnisko wyposażone w infrastrukturę do stałej obsługi samolotów pasażerskich i towarowych.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Główny <w>port</w> lotniczy w kraju obsługuje miliony pasażerów rocznie.",
                            "target_lang_translations": {
                                "ru": "Главный <w>аэропорт</w> страны обслуживает миллионы пассажиров в год.",
                                "de": "Der wichtigste <w>Flughafen</w> des Landes fertigt jährlich Millionen Passagiere ab."
                            }
                        },
                        {
                            "text": "Do najbliższego <w>portu</w> lotniczego mamy tylko dwadzieścia minut samochodem.",
                            "target_lang_translations": {
                                "ru": "До ближайшего <w>аэропорта</w> нам всего двадцать минут на машине.",
                                "de": "Bis zum nächsten <w>Flughafen</w> brauchen wir nur zwanzig Minuten mit dem Auto."
                            }
                        }
                    ],
                    "synonyms": [
                        "lotnisko"
                    ],
                    "common_phrases": [
                        "port lotniczy",
                        "międzynarodowy port lotniczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный аэродром, оборудованный для постоянного обслуживания пассажирских и грузовых самолетов.",
                        "de": "Großer Flugplatz mit Infrastruktur zur regelmäßigen Abfertigung von Passagier- und Frachtflugzeugen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аэропорт",
                                "target_lang_sense_clarification": "комплекс для самолетов"
                            },
                            {
                                "target_lang_word": "воздушная гавань",
                                "target_lang_sense_clarification": "авиационный термин"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Flughafen",
                                "target_lang_sense_clarification": "für Flugzeuge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6e2d004-4162-3ba7-870c-6c15fc7e88ba",
                    "sense_definition": "Gniazdo w komputerze lub innym urządzeniu służące do podłączania sprzętu zewnętrznego lub przesyłania danych.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój nowy laptop nie ma standardowego <w>portu</w> USB.",
                            "target_lang_translations": {
                                "ru": "У моего нового ноутбука нет стандартного USB-<w>порта</w>.",
                                "de": "Mein neuer Laptop hat keinen standardmäßigen USB-<w>Port</w>."
                            }
                        },
                        {
                            "text": "Podłącz drukarkę do odpowiedniego <w>portu</w> z tyłu obudowy.",
                            "target_lang_translations": {
                                "ru": "Подключи принтер к соответствующему <w>порту</w> на задней панели корпуса.",
                                "de": "Schließe den Drucker an den entsprechenden <w>Anschluss</w> auf der Rückseite des Gehäuses an."
                            }
                        }
                    ],
                    "synonyms": [
                        "złącze"
                    ],
                    "common_phrases": [
                        "port USB",
                        "port szeregowy",
                        "port HDMI"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разъем в компьютере или другом устройстве, служащий для подключения внешнего оборудования или передачи данных.",
                        "de": "Buchse an einem Computer oder Gerät zum Anschließen externer Hardware oder zur Datenübertragung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порт",
                                "target_lang_sense_clarification": "компьютерный интерфейс"
                            },
                            {
                                "target_lang_word": "разъём",
                                "target_lang_sense_clarification": "гнездо подключения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Port",
                                "target_lang_sense_clarification": "Computeranschluss"
                            },
                            {
                                "target_lang_word": "Anschluss",
                                "target_lang_sense_clarification": "Buchse an Geräten"
                            },
                            {
                                "target_lang_word": "Schnittstelle",
                                "target_lang_sense_clarification": "Hardware-Verbindung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83c2f84e-ae68-35d0-9b68-9b8192183d64",
                    "sense_definition": "Miejsce dające poczucie bezpieczeństwa, spokoju i ochrony przed problemami.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu latach podróży wreszcie znalazł swój bezpieczny <w>port</w>.",
                            "target_lang_translations": {
                                "ru": "После долгих лет странствий он наконец нашел свою безопасную <w>гавань</w>.",
                                "de": "Nach vielen Jahren des Reisens fand er schließlich seinen sicheren <w>Hafen</w>."
                            }
                        },
                        {
                            "text": "Dom rodzinny był dla niej cichym <w>portem</w> w trudnych czasach.",
                            "target_lang_translations": {
                                "ru": "Родной дом был для нее тихой <w>гаванью</w> в трудные времена.",
                                "de": "Das Elternhaus war für sie in schweren Zeiten ein ruhiger <w>Hafen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "azyl",
                        "schronienie",
                        "przystań"
                    ],
                    "common_phrases": [
                        "bezpieczny port",
                        "cichy port",
                        "zawinąć do portu"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, дающее чувство безопасности, спокойствия и защиты от проблем.",
                        "de": "Ort, der Geborgenheit, Ruhe und Schutz vor Problemen bietet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гавань",
                                "target_lang_sense_clarification": "безопасное место (перен.)"
                            },
                            {
                                "target_lang_word": "пристанище",
                                "target_lang_sense_clarification": "укрытие"
                            }
                        ],
                        "de": [
