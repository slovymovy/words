                ],
                "senses": [
                    {
                        "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                        "entry_id": "d95471d0-cec7-36b4-a9a5-9427012830eb",
                        "glosses": [
                            "To behave like a hipster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b320059-50e2-45d7-a096-304d13dd3e95",
                                "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                "text": "But it was a white staff member of a reform school who gave Claude Brown the first notion he ever had that there might be something in the world besides dope and sex and hipstering."
                            },
                            {
                                "example_id": "b7dd4f22-fdf9-44db-bf9c-231a417b9c83",
                                "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                "text": "The hipsters are hipstering, the businessmen are businessing, the parents are parenting, the children are childrening, and the black teenagers are calling each other niggers."
                            },
                            {
                                "example_id": "c8040874-eb28-4a48-ba84-042f4b00856c",
                                "sense_id": "1b2c3f81-c119-373b-97cd-c03ec8d9a0f7",
                                "text": "If you're up for a night of hipstering, this is a good spot to begin - a grungy joint that nevertheless hosts a solid varying roster of blues, funk, reggae, rock and indie bands."
                            }
                        ]
                    },
                    {
                        "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                        "entry_id": "d95471d0-cec7-36b4-a9a5-9427012830eb",
                        "glosses": [
                            "To dress or decorate in a hip fashion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f52ab5e-da0d-482e-bd2d-a376c26ec6fa",
                                "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                "text": "Claire's permission, to be going out with this fine, circumspect woman, all hipstered out and cowboy booted, without a chaperone."
                            },
                            {
                                "example_id": "90620b43-c15c-4dbc-9b69-7b9495116c1c",
                                "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                "text": "I nudged Theo. “I give him three hours before he's hipstered it back up again."
                            },
                            {
                                "example_id": "6d33d44d-3a16-4f75-afd0-16829c5d3226",
                                "sense_id": "8657ed1f-2c82-34d6-873c-e2405e73ad23",
                                "text": "Victorian frock coats and neckwear, with facial hair that would make any hipster contemplate giving up hipstering and taking up..."
                            }
                        ]
                    }
                ],
