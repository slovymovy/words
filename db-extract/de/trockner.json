                ],
                "senses": [
                    {
                        "sense_id": "ab3c1c12-0aae-3bed-b74a-5e588eaee4dd",
                        "entry_id": "89d73e43-69eb-3c64-960a-b83ad4ef9a43",
                        "glosses": [
                            "Maschine zum Trocknen von Materialien in allen Lebensbereich und in der Industrie (Haare, Kleider, Substrate, Autos und andere)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d47f86e-0a32-47e0-9c0d-39f1efb8e7f9",
                                "sense_id": "ab3c1c12-0aae-3bed-b74a-5e588eaee4dd",
                                "text": "Nicht alle Kleidungsstücke sind für den Trockner geeignet."
                            },
                            {
                                "example_id": "71a618da-327e-48b7-8cfe-e9e078b38671",
                                "sense_id": "ab3c1c12-0aae-3bed-b74a-5e588eaee4dd",
                                "text": "„1965 brachte der Hersteller seinen ersten Trockner auf den Markt, seither wird in Gütersloh an der Effizienzsteigerung gearbeitet. Das reicht bis zur Schontrommel mit wabenförmig geprägter Wand, die für eine bessere Durchwirbelung der Wäsche mit Warmluft sorgt.“"
                            },
                            {
                                "example_id": "e0acea0f-6f55-4744-92ce-827e85639666",
                                "sense_id": "ab3c1c12-0aae-3bed-b74a-5e588eaee4dd",
                                "text": "„Ich gehe in die Wäscherei zurück. Schleudere die Wäsche. Lege sie in den Trockner und drehe den Knopf auf Start zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
