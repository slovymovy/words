                        "entry_id": "44c88262-2f34-3db5-acef-a4b5e6521725",
                        "glosses": [
                            "Soldat romain qui portait un javelot."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "a69492df-5a67-4d9c-a709-a10c0fe58478",
                                "sense_id": "c077aab6-49a3-3d4f-a181-363fa53cb260",
                                "text": "Le hastaire avait en outre deux javelots dont l’un était le fameux pilum légionnaire, que l’on retrouve plus tard dans l’armement franc."
                            },
                            {
                                "example_id": "b76b23c0-f200-46a7-84d8-b0d988bf49bd",
                                "sense_id": "c077aab6-49a3-3d4f-a181-363fa53cb260",
                                "text": "Le second [ordre] était composé de deux centuries formant un effectif de 220 hommes dirigés par le premier hastaire (primus hastatus)."
                            }
                        ]
                    }
                ],
