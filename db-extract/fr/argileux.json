                    {
                        "translation_id": "98f7af5b-b427-4926-805e-a42e43557ad2",
                        "source_entry_id": "640953fa-91d7-316f-9c78-91b0c3dfda7d",
                        "source_sense_id": "a62a1884-ebe8-3a98-9d3a-acf4efbd7d1f",
                        "target_lang_word": "глинистый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глинистый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aab37020-9cec-3ac4-9f2e-961636fe7176",
                                        "entry_id": "ceb5b0d6-ffcc-3b9f-bfac-eb896d0dc51d",
                                        "glosses": [
                                            "содержащий глину, состоящий из глины, изобилующий глиной"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e832350-2946-42dd-b8d0-1c79c0b659d4",
                                                "sense_id": "aab37020-9cec-3ac4-9f2e-961636fe7176",
                                                "text": "Сначала сбитая катышками пыль превратилась в жидкую грязь, которую месили колёса, толчки стали меньше, и по глинистым колеям потекли мутные ручьи."
                                            },
                                            {
                                                "example_id": "9230d8ef-2ae1-4e66-ad50-e51e7ae8c659",
                                                "sense_id": "aab37020-9cec-3ac4-9f2e-961636fe7176",
                                                "text": "Кроме того, гравий мелкой фракции может использоваться как «разрыхлитель» на тяжелых почвах, что дает возможность высадить любимые растения даже на глинистых почвах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d106ada-5ed1-3590-bf5b-fc60cb99cfcf",
                                        "entry_id": "ceb5b0d6-ffcc-3b9f-bfac-eb896d0dc51d",
                                        "glosses": [
                                            "напоминающий глину, имеющий цвет глины"
                                        ],
