                "senses": [
                    {
                        "sense_id": "42aaeb97-1496-3b7f-a5a2-47e35b770e71",
                        "entry_id": "26e5b19c-22ee-31da-b485-1ed8c714abc5",
                        "glosses": [
                            "Skier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "630f185c-a9d8-48cc-88bb-cc4ddbaa2188",
                                "sense_id": "42aaeb97-1496-3b7f-a5a2-47e35b770e71",
                                "text": "Oui, je me vois vraiment reskier, mon plus gros challenge sera ma jambe, savoir ce qu'elle pourra supporter."
                            },
                            {
                                "example_id": "197d2ca3-5c33-42c3-9d32-9cdc52fa3c12",
                                "sense_id": "42aaeb97-1496-3b7f-a5a2-47e35b770e71",
                                "text": "Mais la saison de la Tessinoise (18 ans), qui ne pourra pas reskier avant trois mois, est fortement compromise."
                            },
                            {
                                "example_id": "d8a75710-a584-41de-bc91-fab0af2036ae",
                                "sense_id": "42aaeb97-1496-3b7f-a5a2-47e35b770e71",
                                "text": "Je ne savais pas si j'allais pouvoir reskier un jour, et encore moins si j'allais réussir à retrouver mon niveau."
                            }
                        ]
                    }
