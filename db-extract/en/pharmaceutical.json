                                        "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                        "entry_id": "ce60c3d0-f35d-3bc3-8ac2-ce9138635530",
                                        "glosses": [
                                            "Mittel gegen körperliche oder psychische Beschwerden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837931bc-1297-456a-a275-fd056f50e3c7",
                                                "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                                "text": "Es gibt noch nicht gegen alle Krankheiten eine wirksame Arznei."
                                            },
                                            {
                                                "example_id": "ee8b1de6-c5d1-4038-b9da-fce4df5642fe",
                                                "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                                "text": "„Sie erhielt drei Scherf Silber und flößte dem Kleinen etwas Arznei ein.“"
                                            },
                                            {
                                                "example_id": "f2f8340b-3fbc-42db-ace6-e0c0cce71864",
                                                "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                                "text": "„Obwohl er ärztlich behandelt, zur Ader gelassen und mit allerlei Arzneien angefüllt wurde, genas er doch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb09e30b-762e-4fd2-b0cb-f144fce27ce0",
                        "source_entry_id": "c13bfa31-b846-3c78-afd7-c70c4afa260f",
                        "source_sense_id": "b385addc-4c23-3420-8dee-969ba836c934",
