                                    {
                                        "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                                        "entry_id": "dccb2d62-b3ac-34fa-8ef6-3cc9b83d49cc",
                                        "glosses": [
                                            "A perceived change in some function, sensation or appearance of a person that indicates a disease or disorder, such as fever, headache or rash; strictly, a symptom is felt or experienced by the patient, while a sign can be detected by an observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93de309e-8ea5-4dc8-9ec5-62203430f405",
                                                "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                                                "text": "The doctor told that his coughing and sneezing was the symptom of standing for too long in the rain."
                                            },
                                            {
                                                "example_id": "267045c4-72bd-4585-8680-a92b69d55dc0",
                                                "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                                                "text": "Swollen breasts, morning sickness, and a missed period are classic symptoms of pregnancy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                        "entry_id": "dccb2d62-b3ac-34fa-8ef6-3cc9b83d49cc",
                                        "glosses": [
                                            "A signal; anything that indicates, or is characteristic of, the presence of something else, especially of something undesirable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd1d4c4-d95b-48ee-b9db-52f55a23f691",
                                                "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                                "text": "Lying, hiding one's true feelings, and having affairs are typical symptoms of a doomed marriage."
                                            },
                                            {
                                                "example_id": "6fdfbe75-a450-4fc9-be26-c6dfc77274b8",
                                                "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                                "text": "\"Nay, nay,\" exclaimed Lord Norbourne, \"I cannot go quite so far as that. I have, thanks to your hospitality, laid in a stock of health enough for the ensuing winter: but as to the general benevolence of which you talk, I confess I find no symptoms: if I did, they would alarm me more than those of the gout.\""
                                            },
                                            {
                                                "example_id": "1bacc17f-bf7f-4ad3-aa47-d746a9150987",
                                                "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                                "text": "Some people see birth outside of marriage as a social problem—a sign of a breakdown in the traditional family and a symptom of moral decay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
