                        {
                            "text": "Самым <w>распространённым</w> изданием того века была эта газета.",
                            "target_lang_translations": {
                                "de": "Die <w>am weitesten verbreitete</w> Publikation jenes Jahrhunderts war diese Zeitung."
                            }
