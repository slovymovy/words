                ],
                "senses": [
                    {
                        "sense_id": "cf006453-99b5-3d72-8901-2efeeb55438b",
                        "entry_id": "477c0fde-18b0-3cad-892d-f285651702eb",
                        "glosses": [
                            "członek Grupy Wagnera, prywatnej firmy wojskowej powiązanej z Federacją Rosyjską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1295867-15b5-4cae-bc8a-f9fcc66a2a9c",
                                "sense_id": "cf006453-99b5-3d72-8901-2efeeb55438b",
                                "text": ", Polska Agencja Prasowa, 26 czerwca 2023, pap.pl.."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0574c39-b556-4a33-b3a0-ef80d3cb4269",
                        "source_entry_id": "477c0fde-18b0-3cad-892d-f285651702eb",
                        "source_sense_id": "cf006453-99b5-3d72-8901-2efeeb55438b",
                        "target_lang_word": "Wagnerite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wagnerite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fa54630-4891-3c87-96e7-d0cfce7b0ff0",
                                        "entry_id": "7eb47eaa-9495-34b6-9224-791f7da25050",
                                        "glosses": [
                                            "An admirer of the German composer Richard Wagner or his work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0853d94-6266-42ef-a99e-e4257a486041",
                                                "sense_id": "0fa54630-4891-3c87-96e7-d0cfce7b0ff0",
                                                "text": "The magic and charm of Bayreuth will never vanish. It is an experience every music lover in general and every Wagnerite in particular owes to himself at least once in a lifetime."
                                            },
                                            {
                                                "example_id": "47b05114-d141-4137-acf8-4f9a71db2d1e",
                                                "sense_id": "0fa54630-4891-3c87-96e7-d0cfce7b0ff0",
                                                "text": "As always, this year's 30 performances were sold out well before curtain time, with nearly 60,000 Wagnerites paying hundreds of euros for the best tickets."
                                            },
                                            {
                                                "example_id": "c3d0694a-56a9-4669-ad16-412623f05aaf",
                                                "sense_id": "0fa54630-4891-3c87-96e7-d0cfce7b0ff0",
                                                "text": "Herrmann, like many Wagnerites, started listening to opera as a youngster: \"My father played the old 78 rpm recordings for me, and had me read the Edda [Old Norse sagas, one of Wagner's major sources for his 'Ring'].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739b4faf-64b1-3249-9007-763a412922f1",
                                        "entry_id": "7eb47eaa-9495-34b6-9224-791f7da25050",
                                        "glosses": [
                                            "A mercenary from the Wagner Group PMC."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac2cf71b-49e4-41be-a312-648d0c04ce8d",
                                                "sense_id": "739b4faf-64b1-3249-9007-763a412922f1",
                                                "text": "Until international law settles the status of PMCs, the Kremlin will continue to use them in the international arena. According to Reuters, about 400 ‘Wagnerites’ have been recently sent to Venezuela to protect president Nicolas Maduro."
                                            },
                                            {
                                                "example_id": "5c1cba99-5dfd-4c51-8504-0f8ead3eaaea",
                                                "sense_id": "739b4faf-64b1-3249-9007-763a412922f1",
                                                "text": "Wagnerites: \"We need more drones, ideally armed. And MRAPs, and more thermal sights, and better comms, and new helicopters to replace those lost...\"\nPrigozhin: \"Best I can do is another movie\""
                                            },
                                            {
                                                "example_id": "1c16ad3d-04e1-4958-b557-f7e2093e4ed8",
                                                "sense_id": "739b4faf-64b1-3249-9007-763a412922f1",
                                                "text": "“The enemy again made a desperate attempt to storm the city of Soledar from different directions and threw the most professional units of the Wagnerites into battle,” Ukraine’s military said on Monday, echoing comments made by Ukraine’s president, Volodymyr Zelenskiy, on Sunday."
                                            },
                                            {
                                                "example_id": "9622bd5b-3dfd-4758-be00-99afb792e125",
                                                "sense_id": "739b4faf-64b1-3249-9007-763a412922f1",
                                                "text": "\"We will not leave Bakhmut,\" vowed Prigozhin in his audio message. \"We'll simply die in double the numbers until all [the Wagnerites] are finished. And when the Wagnerites are completely finished, most likely Shoigu and Gerasimov will have to pick up machine guns.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19979932-2b98-4d60-8911-2f85a067ddeb",
                        "source_entry_id": "477c0fde-18b0-3cad-892d-f285651702eb",
                        "source_sense_id": "cf006453-99b5-3d72-8901-2efeeb55438b",
                        "target_lang_word": "ва́гнеровец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ва́гнеровец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ef26e4-6e89-3080-b6b8-aff26afbd80c",
                                        "entry_id": "e31ec8a8-dc70-33e5-8f2f-2a32cf28b9bb",
                                        "glosses": [
                                            "неол., воен. боец группы Вагнера, российской частной военной компании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e218f9ef-e8bb-48cf-bf9e-e88f42afe8b2",
                                                "sense_id": "b4ef26e4-6e89-3080-b6b8-aff26afbd80c",
                                                "text": "За те пять лет, что мы знаем о существовании ЧВК Вагнера, не нашлось ни одного наёмника, который решился бы рассказать о своём опыте ― даже родственники погибших «вагнеровцев» (а погибли сотни) говорили редко и далеко не обо всём, отмечает издание."
                                            },
                                            {
                                                "example_id": "c394f4d5-64e8-4ad5-ad14-57d2ca9a7556",
                                                "sense_id": "b4ef26e4-6e89-3080-b6b8-aff26afbd80c",
                                                "text": "Главред сайта «Цензор. нет» Юрий Бутусов заявил, что СБУ хотела выманить «вагнеровцев», чтобы использовать для обмена пленными с Россией, но операция провалилась из-за офиса Зеленского."
                                            },
                                            {
                                                "example_id": "5ced2781-8243-4883-8449-26e28628e70b",
                                                "sense_id": "b4ef26e4-6e89-3080-b6b8-aff26afbd80c",
                                                "text": "Официальные лица до сих пор не комментируют кадры забитого кувалдой вагнеровца."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
