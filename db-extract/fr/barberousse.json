                                                "sense_id": "22eee110-e6cc-3634-96d5-de722b89b3ba",
                                                "text": "The radiant goddess, wise in womans wisdom, foresaw a future as secure as the oak pillars of redbeards hall, and knew true hearts gladness as the sacred vows were made."
                                            },
                                            {
                                                "example_id": "28d6373a-9af8-44a1-aa5d-bf454e68b4ea",
                                                "sense_id": "22eee110-e6cc-3634-96d5-de722b89b3ba",
                                                "text": "Thor, Redbeard, strong-armed wielder of Mjolnir, guardian of mankind, we make you welcome."
                                            }
                                        ]
