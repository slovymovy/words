                    "sense_definition": "The act of expressing strong disapproval or harsh criticism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced public <w>censure</w> after his controversial remarks were broadcast on national television."
                        },
                        {
                            "text": "She accepted the <w>censure</w> of her colleagues with grace, acknowledging that her mistake had been serious."
                        }
                    ],
