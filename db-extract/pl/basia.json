                        "glosses": [
                            "zoonim, którym powszechnie woła się wiewiórki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315dd38f-ece7-4da6-9a5e-25eee310b1ba",
                                "sense_id": "be9a7157-db24-3b20-89a7-3d1b39a9efe3",
                                "text": "— Basia, Basia, Basia… — Pokazałam orzech wiewiórce, a potem położyłam na ścieżce"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
