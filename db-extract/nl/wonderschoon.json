                ],
                "senses": [
                    {
                        "sense_id": "d6a754c5-8e3c-3519-9e0c-b09d023129d5",
                        "entry_id": "e7abe4e4-759c-3780-b3b3-4644d87ea4e5",
                        "glosses": [
                            "heel erg mooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc3cca9-c89d-4108-8d45-0600b7a8112b",
                                "sense_id": "d6a754c5-8e3c-3519-9e0c-b09d023129d5",
                                "text": "„De allermooiste negerin van de hele wereld en haar blonde wonderschone vriendin verdwijnen in de bocht”, staat in Gipharts roman Ik ook van jou uit 1992. Het zinnetje in het best verkochte debuut van dat jaar was indertijd niet aanstootgevend. Vorige week besloot uitgeverij Nijgh & Van Ditmar tot een jubileumeditie. De vraag was alleen: wat te doen met het woord ‘negerin’ dat enkele malen in de roman voorkomt?"
                            },
                            {
                                "example_id": "93223d02-623f-4b36-a72b-665aa57e90a3",
                                "sense_id": "d6a754c5-8e3c-3519-9e0c-b09d023129d5",
                                "text": "Mijn ogen zagen dat het wonderschoon was, maar ik kon er, doordat ik nog door de storm op Mount Whitney in shock was, geen seconde van genieten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62d00f45-661d-4235-af24-ff53d0fab201",
                        "source_entry_id": "e7abe4e4-759c-3780-b3b3-4644d87ea4e5",
                        "source_sense_id": "d6a754c5-8e3c-3519-9e0c-b09d023129d5",
                        "source_sense_description": "heel erg mooi",
                        "target_lang_word": "beautiful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beautiful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Possessing beauty, impressing the eye; attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7660656-96d7-4fe3-ba44-761534bc1048",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "Anyone who has ever met her thought she was absolutely beautiful."
                                            },
                                            {
                                                "example_id": "025f4c93-7484-4ab0-9e5f-48b2eef399c0",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "There's a beautiful lake by the town."
                                            },
                                            {
                                                "example_id": "afb8746d-45e5-48fa-9bca-c470eca5e72c",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "“Is Olga de Coude very beautiful?” she asked. And Tarzan laughed and kissed her again. “Not one-tenth so beautiful as you, dear,” he said."
                                            },
                                            {
                                                "example_id": "e90beb53-d43f-4be0-b1ee-5c8d618ebab1",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion."
                                            },
                                            {
                                                "example_id": "142b8518-087a-4bd1-98c1-1f3974e356d0",
                                                "sense_id": "5a03204f-5be2-3525-a7fb-8bc9c2c37c0b",
                                                "text": "It is a beautiful kitchen! — It is beautiful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be27594f-d02e-3f3b-91b8-82d865f2fd21",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Possessing beauty, impressing the eye; attractive.",
                                            "Used emphatically or ironically, after the noun it qualifies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be6dd6f-d54b-4f51-8574-a33ed5551764",
                                                "sense_id": "be27594f-d02e-3f3b-91b8-82d865f2fd21",
                                                "text": "the house beautiful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c5df40-ae28-3d9d-8746-b5db355e021e",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "That one likes very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e86672b-9b77-4a9e-9fd4-22bd509ec015",
                                                "sense_id": "56c5df40-ae28-3d9d-8746-b5db355e021e",
                                                "text": "He was a beautiful person; he would drop everything to help you."
                                            },
                                            {
                                                "example_id": "2c0dcfb3-5c40-45b2-8e4b-2bfe034430b4",
                                                "sense_id": "56c5df40-ae28-3d9d-8746-b5db355e021e",
                                                "text": "You've done a beautiful thing today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Affording pleasure to any of the senses, especially that of hearing; delightful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29be4c44-20e7-43dd-b9b9-cd439119fa13",
                                                "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                                "text": "Beethoven's most beautiful sonata"
                                            },
                                            {
                                                "example_id": "e564c1a9-e540-498c-b6fd-4a2b7f11462c",
                                                "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                                "text": "It's beautiful outside, let's go for a walk."
                                            },
                                            {
                                                "example_id": "606e1104-b9e5-459e-9f5e-3ac8757fb634",
                                                "sense_id": "335fbc71-e26f-3b28-ba73-c7726575aa79",
                                                "text": "These carnations smell beautiful but those daffodils smell funny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91ee0786-c66d-374a-b0fc-c39124dce714",
                                        "entry_id": "3c0e5c4a-3e49-3dc4-918b-e52561bf34f2",
                                        "glosses": [
                                            "Impressing with charm in an intellectual or moral way, through inherent suitability or elegance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db427e1c-79fd-44b2-8eef-9b85e89dc8f4",
                                                "sense_id": "91ee0786-c66d-374a-b0fc-c39124dce714",
                                                "text": "The skater performed a beautiful axel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beautiful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34c53754-179b-3856-8c97-4d82b1fa06f2",
                                        "entry_id": "85c64f0a-a954-3d5b-9790-d42e2404a38b",
                                        "glosses": [
                                            "Someone who is beautiful. Can be used as a term of address."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495d6ce2-709e-4bb1-9d08-4ddb59fddec6",
                                                "sense_id": "34c53754-179b-3856-8c97-4d82b1fa06f2",
                                                "text": "The man was faithful to his wife, ignoring the many blonde beautifuls who surrounded him wherever he went."
                                            },
                                            {
                                                "example_id": "380f70b2-4444-45dc-a83e-33d8450155f4",
                                                "sense_id": "34c53754-179b-3856-8c97-4d82b1fa06f2",
                                                "text": "Hey, beautiful!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9268adc3-4053-4c43-8acc-dea51b904ae0",
                        "source_entry_id": "e7abe4e4-759c-3780-b3b3-4644d87ea4e5",
                        "source_sense_id": "d6a754c5-8e3c-3519-9e0c-b09d023129d5",
                        "source_sense_description": "heel erg mooi",
                        "target_lang_word": "wonderful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wonderful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                                        "entry_id": "4347fbcd-a7a9-3d53-a289-d09c3d8456d3",
                                        "glosses": [
                                            "Tending to excite wonder; surprising, extraordinary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c3b590b-f894-400c-8497-5e38a80ebb37",
                                                "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                                                "text": "His delusion was not wonderful, but most natural."
                                            },
                                            {
                                                "example_id": "b7ef151b-1ada-4aa6-a5cc-b9602fb99f76",
                                                "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                                                "text": "It is not wonderful that Mrs Smith declined to visit the beer garden, in view of her militant temperance. [=It is no wonder that she declined.]"
                                            },
                                            {
                                                "example_id": "464dc830-74bb-4ae2-bcd4-0d5205955782",
                                                "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                                                "text": "'Ha!' cried Dangerfield, with a sort of gasp, and a violent smirk, the joyousness of which was, however, counteracted by a lurid scowl and a wonderful livid glare in his wild eyes; […]"
                                            },
                                            {
                                                "example_id": "bb5ee2ed-32d4-4f59-b298-e9e1e602b70d",
                                                "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                                                "text": "The difference in the circumstances of the kingdom at the two dates might fairly account for the change of policy in regard to the Solway. In 1563 the two countries were held by distinct and hostile governments, and it was not wonderful that the debateable ground of the Solway should be exempted from restrictions which could not be enforced over its whole surface, and which, if enforced on the Scotch side only, would be certainly broken through by the English marauders. In 1685, however, both kingdoms were ruled over by one sovereign; a more amicable policy had, since the accession of James I., been adopted in legislation; and it might therefore be supposed that the exception in favour of the Solway had lapsed by implication, and that the fisheries of all parts of the kingdom were thenceforward to be governed by uniform statutory regulations."
                                            },
                                            {
                                                "example_id": "ed224cb8-92ad-42fb-9b44-92a01906d499",
                                                "sense_id": "8c57ebb1-0f7a-3763-a040-2b6031955740",
                                                "text": "He is massively corrupt. It is wonderful how the man's popularity survives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d229d7b-afdc-3c56-b884-47dae4625d88",
                                        "entry_id": "4347fbcd-a7a9-3d53-a289-d09c3d8456d3",
                                        "glosses": [
                                            "Surprisingly excellent; very good or admirable, extremely impressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "206aa21c-ad00-4d26-b422-1bb134686498",
                                                "sense_id": "5d229d7b-afdc-3c56-b884-47dae4625d88",
                                                "text": "They served a wonderful six-course meal."
                                            },
                                            {
                                                "example_id": "af4535f7-988f-4cbc-a2df-c91a45323d70",
                                                "sense_id": "5d229d7b-afdc-3c56-b884-47dae4625d88",
                                                "text": "What appears to be wonderful may turn out to be anything but."
                                            },
                                            {
                                                "example_id": "89831f59-6e9a-42a0-820c-ae77a230df14",
                                                "sense_id": "5d229d7b-afdc-3c56-b884-47dae4625d88",
                                                "text": "Though they obviously realized that these episodes were part of something wonderful and important and lasting, the writers and producers couldn’t have imagined that 20 years later “Treehouse Of Horror” wouldn’t just survive; it’d thrive as one of the most talked-about and watched episodes of every season of The Simpsons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wonderful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6230dee-1438-3516-b853-654bd6b9a724",
                                        "entry_id": "b5b8d271-ebde-37fd-bfd1-1dc279938346",
                                        "glosses": [
                                            "Exceedingly, to a great extent."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c1730c-d7ab-4ca4-802b-9639464fc388",
                                                "sense_id": "b6230dee-1438-3516-b853-654bd6b9a724",
                                                "text": "[…] wherein they were no sooner entered, but they saw that it was wonderful dark, and it seemed unto them that it should be a very large hall, and there they heard very fearful howlings, as though there had been a legion of hell-hounds […]"
                                            },
                                            {
                                                "example_id": "c473bc10-5fd0-4eae-b5bd-0d521af00219",
                                                "sense_id": "b6230dee-1438-3516-b853-654bd6b9a724",
                                                "text": "It was wonderful stormy weather that night, and it so befell that there was sailing by the Jutland coast a little north of the east mouth of the Limfirth a man of Iceland bound south […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
