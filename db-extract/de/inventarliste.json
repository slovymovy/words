                "senses": [
                    {
                        "sense_id": "3456797b-8dc4-3813-9452-3068185cc260",
                        "entry_id": "ad4f9cf2-9c60-30f9-b772-cf4d6410d5e3",
                        "glosses": [
                            "Verzeichnis über alle Gegenstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11b01d3-440e-4dba-a328-7e14a8241516",
                                "sense_id": "3456797b-8dc4-3813-9452-3068185cc260",
                                "text": "„Ohne Inventarliste kannst du nicht wissen, was wo verschwunden ist und was nicht.“"
                            },
                            {
                                "example_id": "81ee62b7-aa85-4fb5-b080-879c428e42ec",
                                "sense_id": "3456797b-8dc4-3813-9452-3068185cc260",
                                "text": "„Dafür wurden ständig Gegenstände angeschafft, wie beispielsweise Bälle oder Ähnliches, für die eine Inventarliste zu führen war.“"
                            },
                            {
                                "example_id": "24611f17-487c-46c5-835d-bc4b022725ae",
                                "sense_id": "3456797b-8dc4-3813-9452-3068185cc260",
                                "text": "„Sie sind verpflichtet, über das hinterlassene Mobiliar eine Inventarliste in zweifacher Ausfertigung zu erstellen.“"
                            },
                            {
                                "example_id": "9f17e758-1005-4275-a7d2-3a58f40a841c",
                                "sense_id": "3456797b-8dc4-3813-9452-3068185cc260",
                                "text": "„Der Hausmeister hat erklärt, die Inventarliste nicht zu unterschreiben und nicht in die Wohnung hinaufzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
