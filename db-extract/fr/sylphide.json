                                    {
                                        "sense_id": "88732f1f-2ab4-3669-b105-0d36c8219129",
                                        "entry_id": "e643cf69-1d4d-3d53-bd25-ad88f3502656",
                                        "glosses": [
                                            "Luftgeist im (mittelalterlichen) Zauberglauben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6129cba3-acb2-4580-a347-8d695080d210",
                                                "sense_id": "88732f1f-2ab4-3669-b105-0d36c8219129",
                                                "text": "Oberon ist ein Sylphe (selten: eine Sylphe)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a45d95-921e-434b-98f8-f3a6ca58f350",
                        "source_entry_id": "a9869b6d-9b50-3be4-a96b-a3d27fec38c9",
                        "source_sense_id": "4ddfee09-6852-3cdc-b447-5d475b56e790",
                        "source_sense_description": "Sylphe femelle",
                        "target_lang_word": "sylph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sylph",
