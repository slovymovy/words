        "nl-extract.jsonl": [
            {
                "entry_id": "5187491e-4733-38fa-aa21-c1f5f8d005c1",
                "word": "oude",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2f760634-e63f-373e-8de2-2a6a2036cd59",
                        "entry_id": "5187491e-4733-38fa-aa21-c1f5f8d005c1",
                        "glosses": [
                            "verbogen vorm van de stellende trap van oud"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c0230233-3337-45ba-9685-9763c41f4fa5",
                                "sense_id": "2f760634-e63f-373e-8de2-2a6a2036cd59",
                                "text": "\"Dat wordt straks wel even wennen\", zegt machinist Jos van der Veen tegen RTV Noord. Hij had gisteravond zijn laatste rit naar het \"oude hoofdstation\"\". \"Ik vind het mooi om een stukje spoorweggeschiedenis mee te maken, zowel aan het einde van iets of het begin van iets. Nu mag ik het einde meemaken, hartstikke leuk.\""
                            },
                            {
                                "example_id": "8417056c-7cce-4e5d-ade5-e17e0240b49b",
                                "sense_id": "2f760634-e63f-373e-8de2-2a6a2036cd59",
                                "text": "In een oude National Geographic had ik ooit als kind een artikel over deze trail gelezen, 4.286 kilometer door Amerika. Dit heb ik altijd onthouden, maar ik had nooit gedacht dat zo’n lange wandeltocht voor mij weggelegd zou zijn."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b329ce8d-0e0b-35c2-9498-8c3840539bc3",
                "word": "oude",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc261e77-4f04-34b0-9c26-11eac70f6a1a",
                        "entry_id": "b329ce8d-0e0b-35c2-9498-8c3840539bc3",
                        "glosses": [
                            "iemand die oud is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19fa712b-1454-479d-ae23-1efe05c53d88",
                                "sense_id": "fc261e77-4f04-34b0-9c26-11eac70f6a1a",
                                "text": "Dat is voor de ouden net zo belangrijk als voor de jongen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d93f79f1-9271-37f7-a07a-769a6fd07874",
                        "entry_id": "b329ce8d-0e0b-35c2-9498-8c3840539bc3",
                        "glosses": [
                            "situatie zoals die er altijd al is geweest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c25f395-1e58-48d1-98a4-95fdea896de5",
                                "sense_id": "d93f79f1-9271-37f7-a07a-769a6fd07874",
                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                            }
                        ]
                    }
                ],
