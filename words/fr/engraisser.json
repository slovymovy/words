            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5e18434-39b7-3598-87f6-c421395aea05",
                    "sense_definition": "Nourrir abondamment des animaux d'élevage pour les rendre gros et gras avant la vente ou l'abattage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "elevage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éleveur <w>engraisse</w> ses porcs avec des céréales locales durant tout l'automne."
                        },
                        {
                            "text": "Il faut plusieurs semaines pour bien <w>engraisser</w> ces volailles avant les fêtes de fin d'année."
                        }
                    ],
                    "synonyms": [
                        "gaver"
                    ],
                    "antonyms": [
                        "affamer"
                    ],
                    "common_phrases": [
                        "engraisser le bétail",
                        "engraisser des porcs",
                        "engraisser des volailles"
                    ]
                },
                {
                    "sense_id": "e1bff9a0-3f1a-3ce0-a1dc-d3f624c552b6",
                    "sense_definition": "Répandre des fertilisants sur une terre ou une parcelle pour accroître sa fertilité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque printemps, le jardinier <w>engraisse</w> la terre avec du fumier bien décomposé."
                        },
                        {
                            "text": "Les agriculteurs <w>engraissent</w> les champs pour améliorer le rendement des futures cultures."
                        }
                    ],
                    "synonyms": [
                        "amender",
                        "fertiliser",
                        "fumer"
                    ],
                    "antonyms": [
                        "appauvrir",
                        "épuiser"
                    ],
                    "common_phrases": [
                        "engraisser la terre",
                        "engraisser les champs",
                        "engraisser le sol"
                    ]
                },
                {
                    "sense_id": "a37bd1d8-8c77-3271-b179-22bafc19429a",
                    "sense_definition": "Prendre du poids corporel, devenir corpulent ou plus gros.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a abandonné ses entraînements sportifs, il a visiblement <w>engraissé</w>."
                        },
                        {
                            "text": "Si tu continues à manger autant de friandises le soir, tu risques d'<w>engraisser</w> rapidement."
                        }
                    ],
                    "synonyms": [
                        "grossir"
                    ],
                    "antonyms": [
                        "maigrir",
                        "mincir"
                    ],
                    "common_phrases": [
                        "engraisser visiblement"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Souvent péjoratif lorsqu'il s'applique à un être humain."
                        }
                    ]
                },
                {
                    "sense_id": "8429e2ad-0b7b-379f-8949-46553f524e8c",
                    "sense_definition": "S'enrichir financièrement de façon démesurée, souvent au détriment d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces intermédiaires malhonnêtes ne cherchent qu'à <w>engraisser</w> leur propre compte en banque."
                        },
                        {
                            "text": "En période de crise économique, quelques profiteurs s'<w>engraissent</w> sans aucun scrupule."
                        }
                    ],
                    "synonyms": [
                        "s'enrichir"
                    ],
                    "antonyms": [
                        "s'appauvrir",
                        "se ruiner"
                    ],
                    "common_phrases": [
                        "engraisser les intermédiaires",
                        "s'engraisser sur le dos"
                    ]
                },
                {
                    "sense_id": "fab2d337-5b84-30c0-b6b1-85f1ca40a00f",
                    "sense_definition": "Recharger artificiellement une plage en sable ou en galets pour contrer les effets de l'érosion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "littoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité doit régulièrement <w>engraisser</w> la plage avant le début de la saison estivale."
                        },
                        {
                            "text": "Des milliers de mètres cubes de galets sont apportés afin d'<w>engraisser</w> le littoral fragilisé."
                        }
                    ],
                    "synonyms": [
                        "recharger"
                    ],
                    "common_phrases": [
                        "engraisser une plage",
                        "engraisser le littoral"
                    ]
                }
            ]
        }
    ]
