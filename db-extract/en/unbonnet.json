                "senses": [
                    {
                        "sense_id": "0b6cb1e8-ed14-30b9-a10e-2401acfd5255",
                        "entry_id": "c004c1eb-0ed5-3b5c-b935-ead4eac38a91",
                        "glosses": [
                            "To remove a bonnet from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "baa82436-8bdc-4d2c-8958-7d91ec0fbe69",
                                "sense_id": "0b6cb1e8-ed14-30b9-a10e-2401acfd5255",
                                "text": "Jacob received them with much gallantry, uncloaking and unbonnetting the ladies, assisted by his two staring and awkward auxiliaries, welcoming their husbands and fathers, and apologizing, as best he might, for the absence of his helpmate;"
                            },
                            {
                                "example_id": "afa881a0-ec98-4e0e-b34c-df684c94a178",
                                "sense_id": "0b6cb1e8-ed14-30b9-a10e-2401acfd5255",
                                "text": "\"Do nothing but rise, unbonnet yourself, and be silent\""
                            }
                        ]
                    },
                    {
                        "sense_id": "de3a8472-5dc3-3076-b517-e5c618ae28f2",
                        "entry_id": "c004c1eb-0ed5-3b5c-b935-ead4eac38a91",
                        "glosses": [
                            "To take off one's bonnet."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "82f7d65a-b73c-4bfa-9a86-842a9e5a40f3",
                                "sense_id": "de3a8472-5dc3-3076-b517-e5c618ae28f2",
                                "text": "He cast his penetrating glance around, and then unbonneting to the Duke, he said respectfully, […]"
                            },
                            {
                                "example_id": "7305dacb-39cb-4826-9984-54208ad64def",
                                "sense_id": "de3a8472-5dc3-3076-b517-e5c618ae28f2",
                                "text": "Mrs. Bobaline looked curiously at the shrinking girl, as she unbonneted, and was secretly pleased to see only a meek little face […]"
                            },
                            {
                                "example_id": "f7bf714e-fc41-4fea-a831-b7b124d790aa",
                                "sense_id": "de3a8472-5dc3-3076-b517-e5c618ae28f2",
                                "text": "Unbonnetting before their betters might be more pleasant than having greatness thrust upon them;"
                            }
                        ]
                    }
                ],
