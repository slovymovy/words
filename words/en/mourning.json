{
    "word_family": [
        "mourn",
        "mourner",
        "mournful",
        "mournfully",
        "mournfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47297698-8f01-3ac0-b427-c985b0bdf51a",
                    "sense_definition": "The expression of deep sorrow or grief, typically for someone who has died.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "grief_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire nation was in <w>mourning</w> after the beloved leader passed away.",
                            "target_lang_translations": {
                                "ru": "Вся страна была в <w>трауре</w> после кончины любимого лидера.",
                                "de": "Die gesamte Nation befand sich in <w>Trauer</w>, nachdem die geliebte Führungspersönlichkeit verstorben war."
                            }
                        },
                        {
                            "text": "She observed a strict period of <w>mourning</w> following her husband's death.",
                            "target_lang_translations": {
                                "ru": "Она соблюдала строгий <w>траур</w> после смерти мужа.",
                                "de": "Sie hielt nach dem Tod ihres Mannes eine strenge <w>Trauerzeit</w> ein."
                            }
                        }
                    ],
                    "synonyms": [
                        "grief",
                        "lamentation",
                        "sorrow",
                        "bereavement"
                    ],
                    "antonyms": [
                        "rejoicing",
                        "celebration"
                    ],
                    "common_phrases": [
                        "in mourning",
                        "national mourning",
                        "day of mourning",
                        "period of mourning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение глубокой печали или скорби, обычно по умершему.",
                        "de": "Der Ausdruck tiefer Traurigkeit oder des Schmerzes, typischerweise über den Tod einer Person; auch die Zeit des Gedenkens."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "траур",
                                "target_lang_sense_clarification": "состояние скорби, период выражения печали"
                            },
                            {
                                "target_lang_word": "скорбь",
                                "target_lang_sense_clarification": "глубокая печаль, горе"
                            },
                            {
                                "target_lang_word": "оплакивание",
                                "target_lang_sense_clarification": "процесс выражения горя"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Trauer",
                                "target_lang_sense_clarification": "Gefühl des Schmerzes oder Zustand nach einem Todesfall"
                            },
                            {
                                "target_lang_word": "Trauerzeit",
                                "target_lang_sense_clarification": "Periode des Trauerns"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c74d41bd-2897-3651-9336-25a647c969c0",
                    "sense_definition": "Traditional black clothing worn by people to symbolize their grief over a death.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grief_clothes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, widows were expected to wear black <w>mourning</w> for at least a year.",
                            "target_lang_translations": {
                                "ru": "В прошлом от вдов ожидали, что они будут носить черный <w>траур</w> не менее года.",
                                "de": "In der Vergangenheit wurde von Witwen erwartet, dass sie mindestens ein Jahr lang schwarze <w>Trauerkleidung</w> trugen."
                            }
                        },
                        {
                            "text": "She refused to wear <w>mourning</w> to the funeral, choosing a dark blue dress instead.",
                            "target_lang_translations": {
                                "ru": "Она отказалась надеть <w>траур</w> на похороны, выбрав вместо этого темно-синее платье.",
                                "de": "Sie weigerte sich, zur Beerdigung <w>Trauer</w> zu tragen, und entschied sich stattdessen für ein dunkelblaues Kleid."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear mourning",
                        "dressed in mourning",
                        "full mourning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная черная одежда, которую носят в знак скорби по умершему.",
                        "de": "Traditionelle, meist schwarze Kleidung, die als Zeichen der Trauer um einen Verstorbenen getragen wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "траур",
                                "target_lang_sense_clarification": "одежда в знак скорби"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Trauerkleidung",
                                "target_lang_sense_clarification": "spezielle Kleidung für Trauerfälle"
                            },
                            {
                                "target_lang_word": "Trauer",
                                "target_lang_sense_clarification": "Kleidung, z. B. in 'Trauer tragen'"
                            },
                            {
                                "target_lang_word": "Trauerbekleidung",
                                "target_lang_sense_clarification": "Kleidung bei Todesfällen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5c8d551-ebe9-3515-b1f3-25001431e88e",
                    "sense_definition": "Present participle and gerund of <w>mourn</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are still <w>mourning</w> the loss of their family home.",
                            "target_lang_translations": {
                                "ru": "Они все еще <w>оплакивают</w> потерю своего семейного дома.",
                                "de": "Sie <w>trauern</w> immer noch um den Verlust ihres Elternhauses."
                            }
                        },
                        {
                            "text": "<w>Mourning</w> is a natural and necessary process after a tragedy.",
                            "target_lang_translations": {
                                "ru": "<w>Скорбь</w> — это естественный и необходимый процесс после трагедии.",
                                "de": "Das <w>Trauern</w> ist ein natürlicher und notwendiger Prozess nach einer Tragödie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>mourn</w>.",
                        "de": "Partizip Präsens und Gerundium von 'mourn'; das Trauern oder Beklagen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплакивание",
                                "target_lang_sense_clarification": "действие/процесс"
                            },
                            {
                                "target_lang_word": "скорбь",
                                "target_lang_sense_clarification": "состояние"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "trauern",
                                "target_lang_sense_clarification": "Verbform: Schmerz empfinden oder bekunden"
                            },
                            {
                                "target_lang_word": "Trauern",
                                "target_lang_sense_clarification": "substantiviertes Verb: der Vorgang des Trauerns"
                            },
                            {
                                "target_lang_word": "Beklagen",
                                "target_lang_sense_clarification": "das Bedauern oder Betrauern eines Verlusts"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "506c9527-08ad-36c7-b54c-daa00c3bd1e5",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We have an appointment with Dr. <w>Mourning</w> at the clinic today.",
                            "target_lang_translations": {
                                "ru": "У нас сегодня прием у доктора <w>Морнинга</w> в клинике.",
                                "de": "Wir haben heute einen Termin bei Dr. <w>Mourning</w> in der Klinik."
                            }
                        },
                        {
                            "text": "The <w>Mourning</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Морнинг</w> живет в этом городе уже несколько поколений.",
                                "de": "Die Familie <w>Mourning</w> lebt seit Generationen in dieser Stadt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Морнинг",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mourning",
                                "target_lang_sense_clarification": "Eigenname, Nachname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}