                {
                    "sense_id": "64b946f1-9a49-3921-a3c6-c35241ef3889",
                    "sense_definition": "Weibliches Hausrind, das meist zur Gewinnung von Milch und Fleisch gehalten wird",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bovines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der saftigen Weide grasen friedlich mehrere <w>Kühe</w>."
                        },
                        {
                            "text": "Der Landwirt steht jeden Morgen sehr früh auf, um jede einzelne <w>Kuh</w> zu melken."
                        }
                    ],
                    "antonyms": [
                        "Bulle",
                        "Färse",
                        "Kalb",
                        "Stier"
                    ],
                    "common_phrases": [
                        "eine Kuh melken",
                        "Kühe auf der Weide"
                    ]
                },
                {
                    "sense_id": "2326e0ba-7b69-33c9-a2cd-ff4e90ebc51a",
                    "sense_definition": "Abwertende Bezeichnung für eine als dumm, ungeschickt oder unangenehm empfundene Frau",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pejorative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Streit beschimpfte er seine Nachbarin lautstark als blöde <w>Kuh</w>."
                        },
                        {
                            "text": "Ärgere dich nicht über diese unhöfliche <w>Kuh</w>, sie beleidigt ständig andere Leute."
                        }
                    ],
                    "common_phrases": [
                        "blöde Kuh"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "abwertend"
                        }
                    ]
                },
                {
                    "sense_id": "b0789e5b-b7ae-342e-9075-0cbf943f27f5",
                    "sense_definition": "Weibliches Exemplar bestimmter großer Säugetierarten wie Elefanten, Wale oder Elche",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wildlife",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Angeführt wird die Elefantenherde stets von einer erfahrenen alten <w>Kuh</w>."
                        },
                        {
                            "text": "Bei Elchen und Walen nennt man das Weibchen <w>Kuh</w> und das Männchen Bulle."
