            {
                "entry_id": "c0ad5006-aa0f-329c-add0-82e5ceefbcc4",
                "word": "vail",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "faec7eea-e5dc-4f8b-b38a-dffd12cc544e",
                        "entry_id": "c0ad5006-aa0f-329c-add0-82e5ceefbcc4",
                        "tags": [
                            "plural"
                        ],
                        "form": "vails"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3528975d-df66-384b-b14f-60d707cf3880",
                        "entry_id": "c0ad5006-aa0f-329c-add0-82e5ceefbcc4",
                        "glosses": [
                            "Profit; return; proceeds."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ca8779e3-7576-4bd1-8056-0e10a9c86f7d",
                                "sense_id": "3528975d-df66-384b-b14f-60d707cf3880",
                                "text": "My house is as t’were the Caue, where the yong Out-lawe hoords the stolne vayles of his occupation […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e7d5e2f2-6e14-36b4-b148-b0b916e7b541",
                        "entry_id": "c0ad5006-aa0f-329c-add0-82e5ceefbcc4",
                        "glosses": [
                            "Money given to servants by visitors; a gratuity; also vale."
                        ],
                        "tags": [
                            "in-plural",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6c47a3a2-24dc-4fea-bd7c-68449c71d341",
                                "sense_id": "e7d5e2f2-6e14-36b4-b148-b0b916e7b541",
                                "text": "Do you remember, how many Rich Gowns and Petticoats, how many lac’d Pinners, Hoods, Scarfs, and Nightrails, I have given you, since the three Years you have serv’d me, together with many other Vails, Perquisites, and Profits you have enjoy’d in my Service?"
                            },
                            {
                                "example_id": "2085d92f-bdde-4a9d-80af-d86bf3ffa08b",
                                "sense_id": "e7d5e2f2-6e14-36b4-b148-b0b916e7b541",
                                "text": "[…] it is a maxim among the gentlemen of our cloth, that those masters who promise the most, perform the least; and I have often heard them say, they have found the largest vails in those families where they were not promised any."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
