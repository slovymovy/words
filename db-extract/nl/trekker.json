                    {
                        "sense_id": "09fae885-5525-30c7-bc36-1e8f3e09e551",
                        "entry_id": "11d47330-cc1a-3d25-917c-0d0856c6a7e9",
                        "glosses": [
                            "iemand die een trektocht maakt, vaak voor een wat langere periode (met bijv. het doel zich uiteindelijk op een verafgelegen plek te vestigen)"
                        ],
