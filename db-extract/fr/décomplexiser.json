                ],
                "senses": [
                    {
                        "sense_id": "ed5224d7-685c-3504-addf-0321ffbf3bf7",
                        "entry_id": "1a4e5bf0-46a9-3893-ac87-d8a8138aadfc",
                        "glosses": [
                            "Rendre moins complexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17dda46-507e-419d-b0c8-bf985bf0bfbf",
                                "sense_id": "ed5224d7-685c-3504-addf-0321ffbf3bf7",
                                "text": "C’est le sens de l’événement et il faut à tout prix “décomplexiser” cette situation, ce qui ne se réalisera que quand on aura découvert le désintéressement et la sincérité."
                            },
                            {
                                "example_id": "b5ac818a-ae45-4ece-831e-fd4d175341b0",
                                "sense_id": "ed5224d7-685c-3504-addf-0321ffbf3bf7",
                                "text": "Il faut à tout prix « décomplexiser » les situations et cela se fera quand on aura découvert le désintéressement et la sincérité."
                            },
                            {
                                "example_id": "0d07aeea-7290-4fad-b53c-f76d0f27e0fb",
                                "sense_id": "ed5224d7-685c-3504-addf-0321ffbf3bf7",
                                "text": "Puisque la complexité de nos lois ouvre la voie à ce genre d'abus : l'existence de paradis fiscaux : il nous faut –décomplexiser- nos lois pour qu’elles n’ouvrent pas la voie à ce genre d’abus."
                            }
                        ]
                    }
                ],
