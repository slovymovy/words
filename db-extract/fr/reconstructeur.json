                        "glosses": [
                            "Celui (homme, entreprise, ou animal) qui construit, qui sait et qui pratique l’art de construire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "34545498-60e2-390a-9dd2-ca21140289c2",
                        "entry_id": "80ab6952-ef2c-3de6-a5a1-64ae7d2b26ed",
                        "glosses": [
                            "Personne chargée d'un travail de reconstruction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a51135-08fe-4cf8-bc82-44168859b73c",
                                "sense_id": "34545498-60e2-390a-9dd2-ca21140289c2",
                                "text": "À notre gauche, un dévers de deux mètres et, au-delà, à nous toucher, se succédant sans interruption sur toute la longueur du trajet, les chantantes brigades des reconstructeurs."
                            }
                        ]
