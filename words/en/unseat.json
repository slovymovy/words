                    "frequency": "Middle",
                    "semantic_group_id": "physical_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden turn in the path nearly <w>unseated</w> the rider from her horse."
                        },
                        {
                            "text": "Hitting a deep pothole while cycling can easily <w>unseat</w> an inexperienced cyclist."
                        }
                    ],
                    "synonyms": [
                        "deseat"
                    ],
                    "common_phrases": [
                        "unseat the rider",
                        "unseated from his horse",
                        "unseated from the saddle"
                    ]
                },
                {
                    "sense_id": "79efa421-0d03-31f5-8408-96dc356c5618",
                    "sense_definition": "To remove someone from an official position, elected office, or title; to defeat an incumbent.",
