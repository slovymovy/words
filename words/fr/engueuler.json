            "pos": "verb",
            "senses": [
                {
                    "sense_id": "faffe86d-f457-3002-bff5-f55c30b7210d",
                    "sense_definition": "Réprimander vivement quelqu'un, le disputer avec véhémence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patron a <w>engueulé</w> Paul parce qu'il est arrivé avec deux heures de retard au travail.",
                            "target_lang_translations": {
                                "en": "The boss <w>yelled at</w> Paul because he arrived at work two hours late.",
                                "ru": "Начальник <w>отчитал</w> Пола, потому что тот пришёл на работу с опозданием на два часа.",
                                "de": "Der Chef hat Paul <w>zusammengestaucht</w>, weil er zwei Stunden zu spät zur Arbeit kam.",
                                "es": "El jefe <w>regañó</w> a Paul porque llegó al trabajo con dos horas de retraso.",
                                "zh": "老板<w>训斥</w>了保罗，因为他上班迟到了两个小时。"
                            }
                        },
                        {
                            "text": "Mon père m'a <w>engueulé</w> quand il a découvert ma mauvaise note en mathématiques.",
                            "target_lang_translations": {
                                "en": "My father <w>yelled at</w> me when he found out about my poor maths grade.",
                                "ru": "Отец <w>отругал</w> меня, когда узнал о моей плохой оценке по математике.",
                                "de": "Mein Vater hat mich <w>ausgeschimpft</w>, als er meine schlechte Mathenote entdeckte.",
                                "es": "Mi padre me <w>regañó</w> cuando descubrió mi mala nota en matemáticas.",
                                "zh": "我爸爸发现我数学成绩很差，就把我<w>骂</w>了一顿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "se faire engueuler",
                        "engueuler copieusement"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To scold someone harshly or angrily for a fault or misdeed.",
                        "ru": "Резко отчитать кого-либо, строго выговорить за проступок.",
                        "de": "Jemanden scharf und verärgert für ein Fehlverhalten zurechtweisen. Umgangssprachlich.",
                        "es": "Reprender a alguien con dureza y enfado por una falta cometida. Uso coloquial.",
                        "zh": "严厉地批评或责备某人，语气常带愤怒。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yell at",
                                "target_lang_sense_clarification": "loud, angry reprimand"
                            },
                            {
                                "target_lang_word": "tell off",
                                "target_lang_sense_clarification": "informal, sharp reprimand"
                            },
                            {
                                "target_lang_word": "scold",
                                "target_lang_sense_clarification": "reprimand, typically a child"
                            }
                        ],
