            {
                "entry_id": "49fda350-354f-3e25-ab18-99a7997e34a2",
                "word": "colombelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd058302-950f-4c47-aa3e-29b6ed4f2fbc",
                        "entry_id": "49fda350-354f-3e25-ab18-99a7997e34a2",
                        "tags": [
