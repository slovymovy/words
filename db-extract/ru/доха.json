                    {
                        "translation_id": "e766c9a0-ea26-4454-ac12-5dcbaabc028c",
                        "source_entry_id": "dcb2fc92-3288-300f-add4-797278e614c1",
                        "target_lang_word": "Doha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                        "entry_id": "1d7a0d4c-c3b7-3f30-a0bd-b0d7ce36dc56",
                                        "glosses": [
                                            "Hauptstadt von Katar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fe1614b-dfb6-4813-9ffc-a50408622ff9",
                                                "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                                "text": "„Wie in vielen größeren Städten am Persischen Golf wird auch die Skyline Dohas zunehmend von meist solitären Hochhäusern dominiert, z.T. mit markanten arabischen Stilzitaten.“"
                                            },
                                            {
                                                "example_id": "ba1304cd-e0c2-4a3e-bc9f-44e75998adff",
                                                "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                                "text": "„Al-Wadschba, eine Festung im Südwesten Dohas, wurde 1882 von ar-Rayyan gebaut und war im folgenden Jahr Schauplatz der Schlacht, in welcher das Volk Katars unter Führung der Briten an der Seite der Alliierten Scheich Qasim das Osmanische Reich bekämpfte und den Grundstein zu seiner Unabhängigkeit legte.“"
                                            },
                                            {
                                                "example_id": "36965792-c4cd-420e-a187-046a5ca9f5a3",
                                                "sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                                                "text": "„Auslöser der Unruhen sind die unter der Ägide der UN in Doha (Qatar) laufenden Friedensverhandlungen zwischen der sudanesischen Regierung und den wichtigsten Aufständischen-Fraktionen in Darfur. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72f8f080-7938-4ed7-89d4-39fb6a8d8db6",
                        "source_entry_id": "dcb2fc92-3288-300f-add4-797278e614c1",
                        "target_lang_word": "Doha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c1c268-715b-387b-8dfe-69136049370d",
                                        "entry_id": "10e87b5f-6adf-3133-9de1-5c2645f94550",
                                        "glosses": [
                                            "Capitale et métropole du Qatar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78d224f-cc06-4e32-9c31-323b09083da0",
                                                "sense_id": "a7c1c268-715b-387b-8dfe-69136049370d",
                                                "text": "Quand on voulait connaître la programmation des matchs au stade Lusali de Doha, le moteur de recherche affichait un petit France-Brésil en finale."
                                            },
                                            {
                                                "example_id": "1a1d6d10-861c-471c-a5b7-3afa61b4b80a",
                                                "sense_id": "a7c1c268-715b-387b-8dfe-69136049370d",
                                                "text": "Hier, un tribunal de Doha, capitale du Qatar, a condamné « Laura », une touriste néerlandaise de 22 ans qui avait porté plainte pour viol, à un an de prison avec sursis, pour « adultère »."
                                            },
                                            {
                                                "example_id": "54dd4bcf-18db-4ac2-bcde-8f37eaacd8bf",
                                                "sense_id": "a7c1c268-715b-387b-8dfe-69136049370d",
                                                "text": "Direction le commissariat d’Al Saad, dans la banlieue est de Doha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8e1378-c31f-3294-a082-98c667403e24",
                                        "entry_id": "10e87b5f-6adf-3133-9de1-5c2645f94550",
                                        "glosses": [
                                            "Gouvernement qatarien."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981d507d-e5eb-4141-9431-3c328540fb22",
                                                "sense_id": "ff8e1378-c31f-3294-a082-98c667403e24",
                                                "text": "Autre preuve des excellentes relations Paris-Doha, des militaires français (pilotes, navigateurs et techniciens) entraînent les futurs pilotes et mécaniciens de ces 36 Rafale sur la base de Mont-de-Marsan, dans les Landes, et des marins français ont participé à des manœuvres navales conjointes, en septembre, avec leurs « collègues » du Qatar."
                                            },
                                            {
                                                "example_id": "f7f821ad-7160-484d-8f1a-cb20dc7c09e8",
                                                "sense_id": "ff8e1378-c31f-3294-a082-98c667403e24",
                                                "text": "À l’approche de la compétition qui débute le 20 novembre, Doha est l’objet de vives critiques en raison de ses multiples atteintes aux droits humains, notamment concernant les femmes, les personnes LGBTQ+ ou les migrants travaillant sur la construction des stades."
                                            },
                                            {
                                                "example_id": "759902c9-07cf-4400-bbbd-d6bd9e5a635a",
                                                "sense_id": "ff8e1378-c31f-3294-a082-98c667403e24",
                                                "text": "Nabil Ennasri, docteur en sciences politiques et auteur de L’empire du Qatar, le nouveau maître du jeu ? (éd. Points sur les i), revient sur la stratégie du « soft power » par le sport adoptée par Doha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
