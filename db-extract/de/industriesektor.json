                "senses": [
                    {
                        "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                        "entry_id": "d6975ca0-d172-37cc-85fc-ff3b8bc174f4",
                        "glosses": [
                            "Bereich der Wirtschaft, der sich mit der Produktion von Gütern befasst; Gesamtheit aller industriell produzierenden Unternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df2579f-3ddf-4196-9038-5e24a59d835f",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "Der Industriesektor gehört zum sekundären Sektor."
                            },
                            {
                                "example_id": "f234b260-28ba-4d01-bc86-3bef18c61458",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Einen wesentlichen Anteil im Industriesektor haben das Ernährungsgewerbe und die Metallverarbeitung.“"
                            },
                            {
                                "example_id": "978f901a-2d4a-4878-ae01-37ceb19b0900",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Der Industriesektor ist mit 22,6 % am BIP beteiligt.“"
                            },
                            {
                                "example_id": "ae741923-1865-452c-8943-4914b1fa3af0",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Der Industriesektor trägt 8,1 % zur Wertschöpfung bei.“"
                            },
                            {
                                "example_id": "bd160a0c-1a2a-4c5c-9bd4-a7246398490a",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "[Kuba:] „Der eigene Industriesektor ist sehr schwach.“"
                            },
                            {
                                "example_id": "32254f3e-5666-4266-b558-0d4371550da2",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "[Russlands Angriffskrieg auf die Ukraine 2022:] „Die bislang verhängten Sanktionen zielen darauf ab,“ […] „bestimmte Industriesektoren von der Versorgung mit Hightech abzuschneiden.“"
                            },
                            {
                                "example_id": "ba79c0ec-fb27-4348-9086-f52d5acb1963",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Im Industriesektor hat die Staatsführung in Peking bereits Leuchtturmprojekte zugelassen - so dürfen die westlichen Konzerne Shell und BP gemeinsam mit chinesischen Partnern Schieferöl und -Gasvorkommen erkunden und nutzbar machen.“"
                            },
                            {
                                "example_id": "156fdba2-636b-4ad4-931e-a209f678b9a5",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Durch die rasante Ausweitung des Streckennetzes entsteht ein übergreifender Wachstumsimpuls, der sämtliche Industriesektoren (Kohlebergbau, Maschinenindustrie, Roheisen- und Stahlproduktion) aber auch den Handel anschiebt.“"
                            },
                            {
                                "example_id": "8c4f31fb-411a-4978-b6ae-a8615310e655",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "[USA 2018:] „China sagte zu, mehr US-Produkte zu kaufen, etwa aus der Landwirtschaft und dem Energie- und Industriesektor.“"
                            },
                            {
                                "example_id": "2d566779-bada-4243-ac81-7fce6320ddde",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Der Dogan-Konzern, an den für den Verkauf rund 890 Millionen Euro fließen sollen, ist ebenfalls im Energie- und Industriesektor aktiv.“"
                            },
                            {
                                "example_id": "7ad7421c-38a6-485f-bbe8-8bb5c9244fa8",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Wirtschaftskraft und CO₂-Emissionen hängen eng zusammenhängen, darum ist es wenig überraschend, dass der Industriesektor für den größten Anteil (35%) der gesamten Treibhausgase verantwortlich ist.“"
                            },
                            {
                                "example_id": "c7b3bf82-9bb6-4d1a-a5d4-b336dbc45048",
                                "sense_id": "f9b929e4-e34f-33bd-bd6e-10c663f0db13",
                                "text": "„Für ihn kommt es gar nicht so darauf an, das Management in Chinas Industriesektor davon zu überzeugen, dass sie ihre CO₂-Emissionen und die Nutzung fossiler Energie reduzieren müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
