                "senses": [
                    {
                        "sense_id": "0a59f740-bc77-3c0d-a1f4-b867d0699268",
                        "entry_id": "b9741ca5-4465-3f37-8567-439ab3aa9ffb",
                        "glosses": [
                            "Ort (Stelle), an dem etwas mit etwas, zum Beispiel ein Botenstoff mit einem Rezeptor oder eine Raumkapsel mit einem Raumlabor, Kontakt herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be186427-b04c-48c5-a618-cb442d8c7e16",
                                "sense_id": "0a59f740-bc77-3c0d-a1f4-b867d0699268",
                                "text": "„Trifft eine Riesenfresszelle auf eine T-Zelle und passt ihre Kriegstrophäe auf die Andockstelle der T-Zelle wie ein Schlüssel ins Schloss, dann wird die T-Zelle in Alarmbereitschaft versetzt und vermehrt sich durch Teilung.“"
                            },
                            {
                                "example_id": "9409e720-1044-4039-adb2-9b0c9e9cde0f",
                                "sense_id": "0a59f740-bc77-3c0d-a1f4-b867d0699268",
                                "text": "Diese Proteine in der Oberflächenmembran von Zellen werden von Viren häufig als Andockstellen genutzt."
                            },
                            {
                                "example_id": "04e62602-c576-4d4b-8df3-b0aa4190ad3a",
                                "sense_id": "0a59f740-bc77-3c0d-a1f4-b867d0699268",
                                "text": "Das an der Raumstation Mir ergänzte Modul Kristall erhielt 1995 eine Andockstelle für das amerikanische Space Shuttle."
                            },
                            {
                                "example_id": "1aba9eae-4213-43af-8377-0f14d683fd6b",
                                "sense_id": "0a59f740-bc77-3c0d-a1f4-b867d0699268",
                                "text": "„Die in sich geschlossene Utopie verfügt über keine Andockstelle an die Realität des Hier und Jetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
