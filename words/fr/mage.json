                    "frequency": "Low",
                    "semantic_group_id": "occulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte fantastique, un puissant <w>mage</w> protège le royaume contre les créatures maléfiques."
                        },
                        {
                            "text": "Après une violente dispute avec son mari, elle consulte un <w>mage</w> qui lui prédit l'avenir."
                        }
                    ],
                    "synonyms": [
