                                "target_senses": [
                                    {
                                        "sense_id": "84da632c-7efe-313c-af61-8ab6c29f6fd1",
                                        "entry_id": "e62574d4-a9e6-36dd-a76f-cc5c9b1dfcb3",
                                        "glosses": [
                                            "alle zu seiner Bestimmung nötigen Teile habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a5b689-427f-4327-8e7b-9bdef10e1701",
                                                "sense_id": "84da632c-7efe-313c-af61-8ab6c29f6fd1",
                                                "text": "Ein vollständiger Satz Briefmarken ist wertvoller als ein unvollständiger."
                                            },
                                            {
                                                "example_id": "d5b36bbf-caa6-43d4-b927-e6f55264942f",
                                                "sense_id": "84da632c-7efe-313c-af61-8ab6c29f6fd1",
                                                "text": "Da er ausdrücklich bemerkt daß er nichts ausgelassen und nur den Inhalt zusammen gedrängt habe, so wird dieser vollständiger und zusammenhängender sein als bei späteren Auffassungen möglich gewesen wäre."
                                            },
                                            {
                                                "example_id": "764883c8-457d-4748-9351-ababc83a18f0",
                                                "sense_id": "84da632c-7efe-313c-af61-8ab6c29f6fd1",
                                                "text": "Wenn man zur Sommerzeit an einem schönen Sonntag-Nachmittag durch diejenigen Straßen der Altstadt geht, in welchen die großen Kaufmannshäuser stehen, Catharinenstraße, Grimm, Wandrahmen, Gröningerstraße und da herum, so hat man ein Bild der vollständigsten Einsamkeit und Verödung."
                                            },
                                            {
                                                "example_id": "b1962b20-2e96-4463-bafa-51af54c6f66d",
                                                "sense_id": "84da632c-7efe-313c-af61-8ab6c29f6fd1",
                                                "text": "Eine Anzahl seiner Musikstücke, die kürzlich in den großen Konzerten von Lamoureux und bei Colonne gespielt worden waren, hatten dieselben so sehr gepackt, daß sie die Mühe nicht scheuten, zur bisher vollständigsten Aufführung seiner geistlichen Musik in die Provinz zu reisen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd1c2cec-ce79-36ab-844e-48bfba82a980",
                                        "entry_id": "e62574d4-a9e6-36dd-a76f-cc5c9b1dfcb3",
                                        "glosses": [
                                            "ohne Abstriche, ganz und gar"
                                        ],
                                        "tags": [
                                            "in adverbieller Verwendung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b048480-547a-4c23-8d64-4a437a3be040",
                                                "sense_id": "dd1c2cec-ce79-36ab-844e-48bfba82a980",
                                                "text": "Ich bin mir vollständig im Klaren darüber, dass ich mich hier selbst belaste."
                                            },
                                            {
                                                "example_id": "ef9f71a6-65f0-42ca-9857-08bfe5b3a8d5",
                                                "sense_id": "dd1c2cec-ce79-36ab-844e-48bfba82a980",
                                                "text": "Die Insel ist vollständig von Wasser umgeben."
                                            },
                                            {
                                                "example_id": "6c1a12a1-1b0b-4667-81a9-7da6d5a4db09",
                                                "sense_id": "dd1c2cec-ce79-36ab-844e-48bfba82a980",
                                                "text": "Man kann sich sicher sein, dass dieser Text vollständig der Wahrheit entspricht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
