                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb44e7e-fb97-495a-983a-932d04fb637c",
                                "sense_id": "13f41ee5-2ba1-38aa-bf4a-b2e1797d8929",
                                "text": "- Tu viens manger avec nous ? - Non désolé j’ai pas de dinar sur moi."
                            }
                        ]
