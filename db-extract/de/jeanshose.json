                                "sense_id": "d8abe727-19b6-38b8-b162-dd91d6d76e56",
                                "text": "„In Jeanshose und mit geöffnetem Jackenkragen stapft der Bundespräsident durch den 40 Zentimeter hohen Schnee.“"
                            },
                            {
                                "example_id": "22febe5a-e880-408f-a03d-77198aaddca3",
                                "sense_id": "d8abe727-19b6-38b8-b162-dd91d6d76e56",
                                "text": "„Weil sein Haar nicht kurz und ordentlich geschnitten war und weil er eine Jeanshose und eine Cordjacke trug, vermuteten sie Drogen in seiner Tasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
