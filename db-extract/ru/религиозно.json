                    {
                        "translation_id": "2ebf3c68-243f-4d0b-9eca-bce190639c9a",
                        "source_entry_id": "3058d495-977f-323d-aaec-baf64151cec1",
                        "source_sense_id": "e4123404-918b-3083-b191-1fef5e93565f",
                        "target_lang_word": "religieus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "religieus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2d416fe8-13a7-3d0b-9aba-fc90d914b41a",
                                        "entry_id": "9e2239fe-d14e-362d-bdc5-44af6c668a5a",
                                        "glosses": [
                                            "te maken hebbend met godsdienst en geloof"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9144f3e8-e898-4c01-a5cf-516dfaa291de",
                                                "sense_id": "2d416fe8-13a7-3d0b-9aba-fc90d914b41a",
                                                "text": "De paus is een religieuze leider."
                                            },
                                            {
                                                "example_id": "10a455ad-1c19-445a-a58f-47b77097d856",
                                                "sense_id": "2d416fe8-13a7-3d0b-9aba-fc90d914b41a",
                                                "text": "Zelfs mensen die zich religieus noemen, verlaten zich op hoogopgeleide natuurkundigen en kankerspecialisten."
                                            },
                                            {
                                                "example_id": "1ae99427-34cc-41c7-9c0e-8da210ba7e4c",
                                                "sense_id": "2d416fe8-13a7-3d0b-9aba-fc90d914b41a",
                                                "text": "De man die vastzit vanwege de moord op de Japanse oud-premier Shinzo Abe heeft tegen de politie gezegd dat hij aanvankelijk een leider van een religieuze groep wilde doden, meldt het Japanse persbureau Kyodo. Zijn moeder zou financieel in de problemen zijn geraakt door donaties aan deze groep, die volgens de verdachte door Abe werd gepromoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706fec68-770e-3648-8289-8b2576c5a562",
                                        "entry_id": "9e2239fe-d14e-362d-bdc5-44af6c668a5a",
                                        "glosses": [
                                            "niet door objectieve feiten weerlegbaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c37f1c9-a844-444e-aba4-e97edd5906a0",
                                                "sense_id": "706fec68-770e-3648-8289-8b2576c5a562",
                                                "text": "Wat er belangrijk aan was, was dat deze rechtszaken en de reportagereeks van Reporter-Magasinet de ogen moesten hebben geopend van hen die zich met bijna religieus, of in elk geval blind, vertrouwen hadden laten verleiden door alle profeten die predikten over verdrongen herinneringen aan seksuele vergrijpen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "religieus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cb812691-1409-31ce-88f6-0c46b6bbf85f",
                                        "entry_id": "7010fc0e-5c74-32af-920c-19fbc56b1083",
                                        "glosses": [
                                            "iemand die lid is van een godsdienstige woongemeenschap na een plechtige belofte haar leefregels te volgen"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b11230-a4e1-4d6e-84ed-0c87e1cea000",
                                                "sense_id": "cb812691-1409-31ce-88f6-0c46b6bbf85f",
                                                "text": "Er is geen kwestie van dat de religieus de wereld verlaat en de kerstening hiervan overlaat aan de leek: hij blijft volop in de wereld en niet om eigen ziel en zaligheid trekt hij de eenzaamheid in, maar om wille van de leek, opdat deze door en langs hem iets moge bereiken en proeven van dat onverdeelde waardoor reeds hier op aarde alles als nieuw en anders wordt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbff6ae5-39a2-4587-9db2-0b6a8d382460",
                        "source_entry_id": "3058d495-977f-323d-aaec-baf64151cec1",
                        "source_sense_id": "e4123404-918b-3083-b191-1fef5e93565f",
                        "target_lang_word": "religijnie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "religijnie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d4807107-686e-358c-921b-4fb2dae578c9",
                                        "entry_id": "0a506bcb-bf55-3d36-a41b-28a81e58ebd3",
                                        "glosses": [
                                            "w sposób religijny; zgodnie z zasadami religii, religijności"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07fe8e4-5fa7-4b54-861b-c6f0710e3768",
                                                "sense_id": "d4807107-686e-358c-921b-4fb2dae578c9",
                                                "text": "Od dobrej koegzystencji tak licznych i odmiennych religijnie, językowo, obyczajowo i prawnie społeczności zależało powodzenie w funkcjonowaniu państwa"
                                            },
                                            {
                                                "example_id": "7180ff92-8676-48be-93fc-0288205d0832",
                                                "sense_id": "d4807107-686e-358c-921b-4fb2dae578c9",
                                                "text": "Odkąd sięga historyczna pamięć, niemal cała ludzkość żyje religijnie — tego dowodu prawdy i wagi religii nie wolno ignorować"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8566c2-f6f7-4e58-9fc2-bda90ec2d73b",
                        "source_entry_id": "3058d495-977f-323d-aaec-baf64151cec1",
                        "source_sense_id": "e4123404-918b-3083-b191-1fef5e93565f",
                        "target_lang_word": "religieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "religieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6578362-9e51-387a-8776-1ed338baef10",
                                        "entry_id": "1adebf3e-eb30-3142-93e0-969833f8a5c6",
                                        "glosses": [
                                            "D’une manière religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f90357c-f7eb-4359-87fc-8c260c008c3c",
                                                "sense_id": "e6578362-9e51-387a-8776-1ed338baef10",
                                                "text": "Ainsi, des deux parts, la terre, c’est-à-dire la vie présente, ou, en d’autres termes, la vie éternelle dans sa manifestation présente, au lieu d’être comprise religieusement et sanctifiée, est désanctifiée, si je puis m’exprimer ainsi, avilie, profanée, et abandonnée au hasard, à la fatalité, et au mal."
                                            },
                                            {
                                                "example_id": "b8ee7868-6f68-44a6-aa4b-f26b2c83264f",
                                                "sense_id": "e6578362-9e51-387a-8776-1ed338baef10",
                                                "text": "[…], et, quoiqu'elle n'eût pas été élevée très religieusement, elle avait demandé a sa gouvernante de la conduire à l'église Saint-Augustin où affluaient, ce jour-là, les pénitentes de distinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aabcf961-71f1-3390-8f02-0ed34735b93b",
                                        "entry_id": "1adebf3e-eb30-3142-93e0-969833f8a5c6",
                                        "glosses": [
                                            "Exactement, scrupuleusement et avec respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba13700c-d3c7-4cf5-a3d8-398602879fa7",
                                                "sense_id": "aabcf961-71f1-3390-8f02-0ed34735b93b",
                                                "text": "Il accordait à son frère une grande habileté. Selon lui, ce gros garçon endormi ne sommeillait jamais que d’un œil, comme les chats à l’affût devant un trou de souris. Et voilà qu’Eugène passait les soirées entières dans le salon jaune, écoutant religieusement ces grotesques que lui, Aristide, avait si impitoyablement raillés."
                                            },
                                            {
                                                "example_id": "6fc416d6-7c29-41d8-b95b-214a0b1b7272",
                                                "sense_id": "aabcf961-71f1-3390-8f02-0ed34735b93b",
                                                "text": "Dans une Vendée religieusement fidèle à ses martyrs, dans son village même, Clémenceau, le « bleu », était moins qu’un autre prophète."
                                            },
                                            {
                                                "example_id": "d41900c1-8f0f-4989-87fa-677c883077d4",
                                                "sense_id": "aabcf961-71f1-3390-8f02-0ed34735b93b",
                                                "text": "Après un long examen des fantaisies capriolantes des locataires qui n’offraient rien de normal, qui se succédaient en renversant les institutions de leurs devanciers, ni plus ni moins que les dynasties, il s’était octroyé une charte, mais il l’observait religieusement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1010c19f-c45d-3c4d-b88f-0d092bbfcb11",
                                        "entry_id": "1adebf3e-eb30-3142-93e0-969833f8a5c6",
                                        "glosses": [
                                            "Dans le même sens et en se moquant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94e83fc-b110-4b86-ab5d-b2fd0b3f76fa",
                                                "sense_id": "1010c19f-c45d-3c4d-b88f-0d092bbfcb11",
                                                "text": "Ma capacité me valut le soin des bottes de la communauté [saint-simonienne] ; pendant deux mois, je vécus dans le cirage ; chaque jour je frottais quarante paires de bottes religieusement,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
