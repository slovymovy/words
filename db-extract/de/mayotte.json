                                "target_senses": [
                                    {
                                        "sense_id": "98f272e3-4d05-384c-bd37-817e487c2887",
                                        "entry_id": "89692888-2c3a-3fbe-8ac3-9e4044b1222e",
                                        "glosses": [
                                            "An archipelago, overseas department, and administrative region of France, formerly an overseas territorial collectivity, located between Africa's mainland and Madagascar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba502d8-d12d-490d-adac-c8a776d5988c",
                                                "sense_id": "98f272e3-4d05-384c-bd37-817e487c2887",
                                                "text": "At least several hundred people are feared to have been killed after the worst cyclone in almost a century ripped through the French Indian Ocean territory of Mayotte on Saturday, uprooting trees, tearing houses apart and pounding the impoverished archipelago’s already weak infrastructure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58971fe5-dbe9-4e27-b12d-ff3a0bd41bee",
                        "source_entry_id": "7b1fe831-2a82-3f8b-ac97-d7eddd42497b",
                        "source_sense_id": "e2fa0a4f-fec1-308c-bf7a-6da42e8965b8",
                        "source_sense_description": "zu Frankreich gehörige Untergruppe der Komoren",
                        "target_lang_word": "Mayotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
