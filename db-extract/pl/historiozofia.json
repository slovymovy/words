                    },
                    {
                        "translation_id": "5b9e6c45-f2a3-423c-bded-ce956ab14b77",
                        "source_entry_id": "ec09ba6f-e438-305a-9e83-0ae23e62d514",
                        "source_sense_id": "eedda4e7-3c76-3e2f-b5c6-37aee05ae5d9",
                        "target_lang_word": "Geschichtsphilosophie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschichtsphilosophie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a76af8d2-3e7c-32cb-b2bf-8da9f5dace28",
                                        "entry_id": "b7fff248-0997-3be1-9347-17d73b62a402",
                                        "glosses": [
                                            "Teilbereich der Philosophie, der sich mit den allgemeinen Gesetzlichkeiten und dem Sinn der Geschichte sowie den speziellen geschichtswissenschaftlichen Denkformen beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe41ccac-b637-4450-a815-b99bd87a07f9",
                                                "sense_id": "a76af8d2-3e7c-32cb-b2bf-8da9f5dace28",
                                                "text": "„Geschichtsphilosophie hat zum Gegenstand ihrer Überlegungen stets auch die Philosophiegeschichte, ja mehr noch: auch die Philosophie der Geschichte der Geschichtsphilosophie."
                                            },
                                            {
                                                "example_id": "2ce294d2-b040-4630-96a2-97f0d5d7c869",
                                                "sense_id": "a76af8d2-3e7c-32cb-b2bf-8da9f5dace28",
                                                "text": "„So etwas passte natürlich auch zu der teleologischen Literaturauffassung, die sich im 19. Jahrhundert im Zuge der Liebe zur Geschichtsphilosophie eingebürgert hat.“"
                                            },
                                            {
                                                "example_id": "e7bfac40-ddaa-4a27-9056-b98563abb6b5",
                                                "sense_id": "a76af8d2-3e7c-32cb-b2bf-8da9f5dace28",
                                                "text": "„Ohne sich dessen bewußt zu werden, verwandelte die bürgerliche Geistigkeit im achtzehnten Jahrhundert die Geschichte in einen Prozess. Dieses Geschehnis, das die Neuzeit inauguriert, ist identisch mit der Genese der Geschichtsphilosophie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
