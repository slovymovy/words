                "senses": [
                    {
                        "sense_id": "52824a17-10ce-3d0f-abb1-a0c5484c8568",
                        "entry_id": "c238bafa-546a-324a-ae4e-aac8c03e9345",
                        "glosses": [
                            "韓國泡菜"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b26a219-00e1-44e6-bd1a-f4deda1b08d4",
                                "sense_id": "52824a17-10ce-3d0f-abb1-a0c5484c8568",
                                "text": "\"Yeah.\" He gestured to the kimchi. \"Well, get it in ya, then.\"\n\"It's better hot.\" she said.",
                                "translation": "“是啊。”他指了指泡菜。 “那就吃吧。”\n“热的更好吃。”她说。"
                            },
                            {
                                "example_id": "ec36d2d9-06cc-4220-a9e2-b68a04f46168",
                                "sense_id": "52824a17-10ce-3d0f-abb1-a0c5484c8568",
                                "text": "Despite the stew’s debt to kimchi, you know it has come into its own when it’s served with kimchi as a side dish.",
                                "translation": "尽管这道炖菜借鉴了泡菜的风味，但当它与泡菜一起作为配菜上桌时，你就知道它已经真正展现出了自身的特色。"
                            }
                        ]
                    },
                    {
                        "sense_id": "c734ec69-b3cb-30e5-93b1-17a2d935df78",
                        "entry_id": "c238bafa-546a-324a-ae4e-aac8c03e9345",
                        "glosses": [
                            "朝鮮人；高麗棒子"
                        ],
                        "tags": [
                            "countable",
                            "derogatory",
                            "slang",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "357ab69d-65c5-422e-a308-e366fead5988",
                                "sense_id": "c734ec69-b3cb-30e5-93b1-17a2d935df78",
                                "text": "How did I know the kimchis were trying to smuggle the crate out of Japan?",
                                "translation": "我怎么知道那些棒子是想把那箱东西走私出日本呢？"
                            },
                            {
                                "example_id": "3ec9eea9-b126-4c84-9c61-e7ab753de5f9",
                                "sense_id": "c734ec69-b3cb-30e5-93b1-17a2d935df78",
                                "text": "In the United States, Germans are sometimes called \"krauts\" ... Koreans \"kimchis,\" and poor white Southerners \"crackers\"...",
                                "translation": "在美国，德国人有时被称为“krauts”（德国佬），韩国人被称为“kimchis”（泡菜），而贫穷的南方白人则被称为“crackers”（乡巴佬）……"
                            },
                            {
                                "example_id": "0390dce7-5ef4-4a30-be8c-9c52b26c8cf4",
                                "sense_id": "c734ec69-b3cb-30e5-93b1-17a2d935df78",
                                "text": "... he doesn't know the difference between Ping-Pongs and Kimchis.",
                                "translation": "他连“乒乓人”和“泡菜人”都分不清。"
                            }
                        ]
                    }
