                                    {
                                        "sense_id": "dd75d28a-ae52-3900-a4ed-9928b75e660b",
                                        "entry_id": "7aec045d-729e-30fa-a071-3a3e3207cbff",
                                        "glosses": [
                                            "In a convenient manner, form, or situation; without difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815e4779-513c-4b27-b338-472710593592",
                                                "sense_id": "dd75d28a-ae52-3900-a4ed-9928b75e660b",
                                                "text": "his body was now conveniently inclin'd towards me, and just softly chucking his smooth beardless chin, I asked him if he was afraid of a lady?",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85aa1af8-e182-3c0d-8e26-17eb0060c695",
                                        "entry_id": "7aec045d-729e-30fa-a071-3a3e3207cbff",
                                        "glosses": [
                                            "In a manner provoking suspicion due to how well it suits someone's purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292db347-06b0-4deb-ae9b-152f4691de05",
                                                "sense_id": "85aa1af8-e182-3c0d-8e26-17eb0060c695",
                                                "text": "You expect me to believe that someone created a wormhole, and now conveniently has disassembled it?"
                                            },
                                            {
                                                "example_id": "dc0ab232-b4f5-41b9-ad6a-7132e582ba4b",
                                                "sense_id": "85aa1af8-e182-3c0d-8e26-17eb0060c695",
                                                "text": "If you prefer to deal in actual figures, as opposed to conveniently distracting speculative ones, then do recall that the British taxpayer bailed out Lloyds to the tune of around £20bn, and continues to face a massive loss on those shares."
                                            }
                                        ]
