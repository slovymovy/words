                        "examples": [
                            {
                                "example_id": "14914f90-2d1e-4a60-92ad-e6303b19ca41",
                                "sense_id": "5c8f6dc1-6dcc-34b9-a96c-97bfeb7ad61b",
                                "text": "Er war mit der Abbindung der Getreidehalme beschäftigt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d5642cae-f6d9-3716-bda7-4c8dde1e99a2",
                        "entry_id": "369ccce4-4555-3dbf-82ed-379522de8576",
                        "glosses": [
                            "Vorgang, bei dem Hölzer aneinander angepasst und immer wieder zur Probe aneinandergefügt werden"
                        ],
                        "tags": [
                            "Zimmerei"
                        ],
                        "examples": [
                            {
                                "example_id": "555d419b-9f17-40b1-8c3e-37e1902cfd22",
                                "sense_id": "d5642cae-f6d9-3716-bda7-4c8dde1e99a2",
                                "text": "Die Abbindung des neuen Dachstuhles hat länger gedauert als erwartet."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e45300e6-dc75-3127-8a97-04c22f03ecfe",
                        "entry_id": "369ccce4-4555-3dbf-82ed-379522de8576",
                        "glosses": [
                            "das Zusammenbinden von Holzfässern durch metallene Reifen"
                        ],
                        "tags": [
                            "Böttcherei"
                        ],
                        "examples": [
                            {
                                "example_id": "7ffc6c78-5866-410b-8747-fe21db7c6954",
                                "sense_id": "e45300e6-dc75-3127-8a97-04c22f03ecfe",
                                "text": "Du musst noch lernen, wie die Abbindung eines Fasses richtig funktioniert."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "b2d2f6f1-de39-31f6-8c6a-2fced0545f25",
                        "entry_id": "369ccce4-4555-3dbf-82ed-379522de8576",
                        "glosses": [
                            "das Aushärten von Baustoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dd1f785-e8bd-432c-9517-1188a533d06f",
                                "sense_id": "b2d2f6f1-de39-31f6-8c6a-2fced0545f25",
                                "text": "Noch ist die Abbindung des Betons nicht abgeschlossen."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "4198f3b4-3cda-3542-be3a-73f3ed7b42a2",
                        "entry_id": "369ccce4-4555-3dbf-82ed-379522de8576",
                        "glosses": [
                            "das Abbinden von Gliedmaßen zur Stoppung von Blutungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531e2f0e-66c7-4a5d-b88a-83555a817aeb",
                                "sense_id": "4198f3b4-3cda-3542-be3a-73f3ed7b42a2",
                                "text": "„Was die Gefäßgeschwulst an der Mündung der Harnröhre betrifft, so rathet Clarke vorzüglich zur Wegschaffung derselben entweder durch die Abbindung oder durch die Schere, welches allerdings, sobald sie eine beträchtliche Größe und Schmerzhaftigkeit erreicht hat, das zweckmäßigste bleibt, dahingegen bey einem geringern Grade des Uebels oft schon adstringirende kalte Fomentationen aus dem Aufguß von Absinthium, serpillum, mit rothem Wein, Tinct. Terrae Catechu u. s. w., nebst dem Einlegen einer starken Kerze und dem dadurch verursachten Zusammendrücken der Geschwulst vollkommen ausreichen.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    }
