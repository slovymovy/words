                                        "sense_id": "15c4bdcb-bda2-3a7d-9c4f-887402fadae1",
                                        "entry_id": "9db61fa6-298b-3233-979a-3f5b9233c3d0",
                                        "glosses": [
                                            "An action which is not worth the difficulty involved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hassle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "350aaf71-787d-3df1-bcfb-db05e42a62d7",
                                        "entry_id": "002437e2-dcf4-3588-902c-c7502cf9ecec",
                                        "glosses": [
                                            "To trouble, to bother, to annoy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abcadf1a-702b-4906-85bc-5a8a92de3734",
                                                "sense_id": "350aaf71-787d-3df1-bcfb-db05e42a62d7",
                                                "text": "The unlucky boy was hassled by a gang of troublemakers on his way home."
                                            },
                                            {
                                                "example_id": "d05638c7-a27b-4336-8c7a-c5ce49f86fc8",
                                                "sense_id": "350aaf71-787d-3df1-bcfb-db05e42a62d7",
                                                "text": "\"Oh uncool bush! Unloose this passle Of furry cats that you hassle!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75ffb84c-94b0-3787-ab11-47b425801dd1",
                                        "entry_id": "002437e2-dcf4-3588-902c-c7502cf9ecec",
                                        "glosses": [
                                            "To pick a fight or start an argument with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "610c5f8f-827f-33a3-b936-a3fb5ee04c3b",
                                        "entry_id": "002437e2-dcf4-3588-902c-c7502cf9ecec",
                                        "glosses": [
                                            "To work through something troublesome; to be bothered by."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e76f36b-cdfd-42f8-8874-5c60ffc414f7",
                                                "sense_id": "610c5f8f-827f-33a3-b936-a3fb5ee04c3b",
                                                "text": "If you don't want to hassle through converting formats, you'll have to stick with one program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ccffc9-9762-35d0-8d94-7fea1fa43289",
                                        "entry_id": "002437e2-dcf4-3588-902c-c7502cf9ecec",
                                        "glosses": [
                                            "To engage in a mock dogfight."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f453228d-6b86-4210-aa24-1a98c8d27d55",
                                                "sense_id": "c4ccffc9-9762-35d0-8d94-7fea1fa43289",
                                                "text": "Likewise, “hassling”—mock dogfighting—was strictly forbidden, and so naturally young fighter jocks could hardly wait to go up in, say, a pair of F–100s and start the duel by making a pass at each other at 800 miles an hour, […]"
                                            },
                                            {
                                                "example_id": "8d89055a-ba84-40b7-b0cf-9487fd49ecf8",
                                                "sense_id": "c4ccffc9-9762-35d0-8d94-7fea1fa43289",
                                                "text": "If you were caught 'hassling,' as we called dogfighting, your career could end. The edict against dogfighting divided our squadron into three factions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
