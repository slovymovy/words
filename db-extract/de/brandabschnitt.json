                ],
                "senses": [
                    {
                        "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                        "entry_id": "52fc0a80-5e1f-3e81-b138-6b8d4d90ff59",
                        "glosses": [
                            "baulich klar definierter, eingegrenzter Bereich in Gebäuden, in dem sich ein Feuer lokal ausbreiten könnte, um die Schutzziele in anderen Bereichen zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21c98fb-cc58-42e6-8205-5d4eabbf1ace",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„Ein Brandabschnitt ist der Bereich eines Gebäudes zwischen seinen Außenwänden und/oder den Wänden, die als Brandwände über alle Geschosse ausgebildet sind.“"
                            },
                            {
                                "example_id": "1716fef5-14d6-49d0-8d26-17f721745410",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„Bei diesem Vorgang transportiert der durch das Brandgeschehen entwickelte Auftrieb die Schadstoffe und Rußpartikel nach oben in den Deckenbereich des Brandabschnitts.“"
                            },
                            {
                                "example_id": "b3151c25-c9de-479f-8c9d-d609c18ad2f4",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„Zum Beispiel existieren dort Bereiche, die im Brandfall nicht aufgegeben werden dürfen, die Evakuierung erfolgt nicht ins Freie, sondern zunächst in benachbarte Brandabschnitte.“"
                            },
                            {
                                "example_id": "67bdf3e0-f850-4802-a1c9-b015b5650126",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„In Gebäuden mit mehr als drei Geschossen schreibt die BayBO vor, dass Treppenhäuser als eigene Brandabschnitte ausgeführt werden.“"
                            },
                            {
                                "example_id": "ba210ec0-1983-4ffc-9b52-11d4bb240adf",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„Ein Brandabschnitt wird von einem oder mehreren Gebäuden, Gebäudeabschnitten oder Lägern im Freien gebildet, die untereinander keine, jedoch zu anderen Gebäuden, Gebäudeabschnitten oder Lägern eine räumliche oder bauliche Trennung aufweisen.“"
                            },
                            {
                                "example_id": "5080c0c5-9317-4771-a480-e573ab5370a0",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„Das Baurecht verlangt die Unterteilung bestimmter Gebäude in Brandabschnitte, um den Übertritt von Feuer und Rauch auf benachbarte Gebäude oder Gebäudeteile wirksam zu verhindern.“"
                            },
                            {
                                "example_id": "75afcdd3-bae2-4a5c-a2b4-19e0823725bf",
                                "sense_id": "26deaa00-fe15-382f-872c-0a337f39331a",
                                "text": "„Brandabschnitte können auch durch die Einhaltung notwendiger Abstände von Gebäuden oder Nutzungen geschaffen werden, die einer Ausbreitung von Feuer vorbeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
