                "senses": [
                    {
                        "sense_id": "1329b0bf-d5a1-3fb8-80dc-72711e295d42",
                        "entry_id": "c544e153-74e8-38b4-9d94-78b3422fa4bc",
                        "glosses": [
                            "Beauftragung eines externen Betriebsarztes und einer externen Fachkraft für Arbeitssicherheit (als Option für kleinere Unternehmen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "617973f6-96f4-4040-a5d9-102aa5b05314",
                                "sense_id": "1329b0bf-d5a1-3fb8-80dc-72711e295d42",
                                "text": "„Im Rahmen der Regelbetreuung verpflichtet der Unternehmer Betriebsärzte und Fachkräfte für Arbeitssicherheit vertraglich, ihn und alle Beschäftigten auf dem Gebiet der Arbeitssicherheit und des Gesundheitsschutzes zu unterstützen und zu beraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d0fc218-88cc-3925-8e1f-b76fa0801471",
                        "entry_id": "c544e153-74e8-38b4-9d94-78b3422fa4bc",
                        "glosses": [
                            "Normalfall des Ablaufes einer Versorgung (Betreuung) in einer betreuenden Organisation wie zum Beispiel einem Kindergarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a53cff-403a-4bae-86be-515a94f26062",
                                "sense_id": "5d0fc218-88cc-3925-8e1f-b76fa0801471",
                                "text": "„Die konkrete Regelung: Spätestens wenn die Sieben-Tage-Inzidenz an drei aufeinanderfolgenden Tagen den Schwellenwert von 200 überschritten hat, wird ab dem übernächsten Tag die Regelbetreuung in Kitas und Kindertagespflege untersagt.“"
                            },
                            {
                                "example_id": "ca9b7be4-dc6f-41c2-adbd-43111326b468",
                                "sense_id": "5d0fc218-88cc-3925-8e1f-b76fa0801471",
                                "text": "In den Kindertageseinrichtungen kann wieder die Regelbetreuung stattfinden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
