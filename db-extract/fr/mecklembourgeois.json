                ],
                "senses": [
                    {
                        "sense_id": "bfece714-bf43-3064-a83c-2e6d6581eae2",
                        "entry_id": "fd002f53-5e7c-3c56-a9bf-1b21deeb9103",
                        "glosses": [
                            "Habitant ou ressortissant du Mecklembourg."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29063001-c49c-4e59-9878-bb8ded132721",
                                "sense_id": "bfece714-bf43-3064-a83c-2e6d6581eae2",
                                "text": "Un Mecklembourgeois, M. Brussow, se procure les écrevisses nécessaires au peuplement des cours d'eaux, de la manière suivante."
                            },
                            {
                                "example_id": "61b7c895-18b0-4d67-9cd3-7f806b1a4cb9",
                                "sense_id": "bfece714-bf43-3064-a83c-2e6d6581eae2",
                                "text": "— Nous, maîtres ici, gueulent Bavarois et Mecklembourgeois, nous, maîtres ici, nous, maîtres partout."
                            },
                            {
                                "example_id": "e12ece21-06ee-4c34-89cf-7a47b4417228",
                                "sense_id": "bfece714-bf43-3064-a83c-2e6d6581eae2",
                                "text": "– J’ai bien observé le port, hier soir. Le soldat qui prend le troisième quart est un gros lourd de Mecklembourgeois."
                            }
                        ]
                    }
                ],
