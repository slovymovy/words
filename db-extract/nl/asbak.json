                    {
                        "translation_id": "a037b8f4-b426-4fea-b5a7-69b98ab263a7",
                        "source_entry_id": "dc231ca3-4747-34e3-9f71-692f4afa5fc4",
                        "source_sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
                        "source_sense_description": "opvangbak",
                        "target_lang_word": "Aschenbecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aschenbecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                        "entry_id": "e1436928-2c4a-3a1b-b43b-2183ea2dace3",
                                        "glosses": [
                                            "Schale für Tabakasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b6c9abf-7eb6-44ce-b109-835393bfebed",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "Wo ist bloß der Aschenbecher?"
                                            },
                                            {
                                                "example_id": "5c22a108-aab1-4fc6-a112-11d1a9b42866",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "Der Aschenbecher ist bis zum Rand mit Zigarettenkippen gefüllt."
                                            },
                                            {
                                                "example_id": "9c8fed46-d781-4bb7-9871-5f6734e2cfcb",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Er überzeugt sich genau, daß die Scheine nirgendwo unter dem Aschenbecher hervorsehen.“"
                                            },
                                            {
                                                "example_id": "dc278dfb-810d-43a6-8870-34af73772d14",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Solowjew drückte seine Zigarre aus, was den ganzen Aschenbecher verwüstete.“"
                                            },
                                            {
                                                "example_id": "340edd87-4c93-4c95-a4ff-9d7e3868f321",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Der Alte tätschelte ihm die Wange und fing dann an, die Aschenbecher in der Wartehalle zu leeren.“"
                                            },
                                            {
                                                "example_id": "3febae00-bed0-41e9-a456-451a1caa8139",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Sie streift die Asche im Aschenbecher ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4606f24-b713-4b41-a4b1-e54d27f534af",
                        "source_entry_id": "dc231ca3-4747-34e3-9f71-692f4afa5fc4",
                        "source_sense_id": "acf06be8-443f-3116-939f-1d4d809bc7c0",
