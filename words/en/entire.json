                        "ru": [
                            {
                                "target_lang_word": "жеребец",
                                "target_lang_sense_clarification": "некастрированный конь"
                            },
                            {
                                "target_lang_word": "некастрированный самец",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种马",
                                "target_lang_sense_clarification": "指未阉割的雄性马"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f852498-c297-3374-b0be-54803dde8ddb",
                    "sense_definition": "A complete envelope, card, or wrapper with stamps and markings, collected as a whole item.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector paid a high price for the rare postal <w>entire</w> from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Коллекционер заплатил высокую цену за редкую почтовую <w>цельную вещь</w> девятнадцатого века.",
                                "zh": "收藏家花高价买下了这件十九世纪稀有的<w>邮政整件</w>。"
                            }
                        },
                        {
                            "text": "It is often better to preserve the <w>entire</w> rather than cutting off the stamp.",
                            "target_lang_translations": {
                                "ru": "Часто лучше сохранить <w>цельную вещь</w>, чем вырезать марку.",
                                "zh": "保留<w>邮政整件</w>通常比剪下邮票更好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "postal entire"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "philately"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный конверт, карточка или обертка с марками и пометками, коллекционируемые как единое целое.",
                        "zh": "指带有邮票和邮戳的完整信封、明信片或包装，作为整体收藏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цельная вещь",
                                "target_lang_sense_clarification": "филателистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邮政整件",
                                "target_lang_sense_clarification": "集邮术语"
                            }
                        ]
                    }
                }
            ]
