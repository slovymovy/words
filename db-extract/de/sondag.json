                ],
                "senses": [
                    {
                        "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                        "entry_id": "defbc59c-e1d6-3c0d-b10c-b695b3c3b316",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57747854-3091-457a-b007-5bcbfd23a0fb",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Frau Sondag ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1fcd7d89-bcd0-491b-ad9f-cfad5044edf8",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Herr Sondag wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ac8ff501-01fe-4c06-b82d-b49d2c67180a",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Die Sondags fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9793765d-10d0-4975-ac82-d63005bd16a2",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Der Sondag trägt nie die Schals, die die Sondag ihm strickt."
                            },
                            {
                                "example_id": "2ac55e2a-e0ed-4c07-89fc-b2222807506b",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sondag kommt, geht der Herr Sondag.“"
                            },
                            {
                                "example_id": "9cfb2f38-04e0-437a-b7e5-164220add022",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Sondag kommt und geht."
                            },
                            {
                                "example_id": "bc9187d6-0380-491a-9b8f-97d9f02a651e",
                                "sense_id": "639cdbaf-b9f9-3bf2-b4f3-f296d2f2de8a",
                                "text": "Sondags kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
