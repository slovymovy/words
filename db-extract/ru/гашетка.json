                                    {
                                        "sense_id": "9511d3df-8494-32e6-ba9e-02738fcdab04",
                                        "entry_id": "de84cfb3-ce01-33e2-95ad-fcbe149dd691",
                                        "glosses": [
                                            "To cause, to precipitate, to bring (something) about in response or as a result."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ef21f6-cdcf-469e-b241-83525b788b36",
                                                "sense_id": "9511d3df-8494-32e6-ba9e-02738fcdab04",
                                                "text": "The controversial article triggered a deluge of angry letters from readers."
                                            },
                                            {
                                                "example_id": "8f8926bc-2045-4c35-80e9-81ed3b2994e1",
                                                "sense_id": "9511d3df-8494-32e6-ba9e-02738fcdab04",
                                                "text": "The accident followed torrential early morning rain that triggered widespread flooding across Scotland's tracks, including south of Carmont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37517c02-8af1-34a7-8db3-2832bf8b9695",
                                        "entry_id": "de84cfb3-ce01-33e2-95ad-fcbe149dd691",
                                        "glosses": [
                                            "To spark a response, especially a negative emotional response, in (a person)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58285fd1-5a20-4453-b98b-1c0130e2876d",
                                                "sense_id": "37517c02-8af1-34a7-8db3-2832bf8b9695",
                                                "text": "This story contains a rape scene and may be triggering for rape victims."
                                            },
                                            {
                                                "example_id": "3cd7e340-3a3b-4810-8637-7e807184999a",
                                                "sense_id": "37517c02-8af1-34a7-8db3-2832bf8b9695",
                                                "text": "People get triggered simply by seeing a Trump."
                                            },
                                            {
                                                "example_id": "1a0933b4-19f4-40cf-8bcb-6b23714b7df5",
                                                "sense_id": "37517c02-8af1-34a7-8db3-2832bf8b9695",
                                                "text": "I encountered a forum user who didn't agree with me, so I wrote some comments with my political slogans to trigger that clueless kiddo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c042194c-da0e-3000-8723-e40b3a44c902",
                                        "entry_id": "de84cfb3-ce01-33e2-95ad-fcbe149dd691",
                                        "glosses": [
                                            "To activate; to become active."
                                        ],
                                        "tags": [
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763649be-1484-42d1-aae1-3ff3185ef1ed",
                                                "sense_id": "c042194c-da0e-3000-8723-e40b3a44c902",
                                                "text": "Sodium nitrite (750 ppm) was added after the alarm triggered at three hours, and corrosion did not occur for over eight hours."
