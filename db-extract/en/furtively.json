                    {
                        "translation_id": "afabd870-750f-4498-b1f4-3dcf002c4d59",
                        "source_entry_id": "2a45fd33-56a9-3219-9032-6665bbd29f8a",
                        "source_sense_id": "fba0a30c-8ef1-3f03-b113-65b1c69a3f5c",
                        "source_sense_description": "in a furtive manner",
                        "target_lang_word": "furtivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furtivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                        "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                                        "glosses": [
                                            "D’une manière furtive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692eb8d8-62bb-4d8d-b927-78f9f7e14852",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "La nouvelle d’une révolution en Macédoine lui fit prendre la résolution de sortir furtivement de Thèbes."
                                            },
                                            {
                                                "example_id": "b7565387-46af-4624-aa75-7ca238963e33",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Elles voudraient jouir furtivement du plaisir de vous aimer et d’être aimées sans que vous y prissiez garde."
                                            },
                                            {
                                                "example_id": "041cf9b5-a879-4430-9878-1966e27dbd65",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Anicet jette furtivement un poignard à ses pieds."
                                            },
                                            {
                                                "example_id": "72ef434e-a18c-4248-a346-d65d4e37d790",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Un coup d’œil caressant furtivement jeté."
                                            },
                                            {
                                                "example_id": "3b202553-6f99-49a6-b585-c0d483eb27ed",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Elle se savait belle et, lorsqu'elle était seule, il lui arrivait de tirer furtivement de sa poche un petit miroir pour s'y contempler."
                                            },
                                            {
                                                "example_id": "83e0f385-4c0a-468a-aa7d-1e7ae28e0d9c",
                                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                                "text": "Une petite pluie froide faisait furtivement briller la couverture d'un appentis et tinter sur le zinc, à de rares intervalles, de pesantes gouttes d'eau qui s'échappaient d'une chanlatte percée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194bac91-05d8-387a-8854-9f45fc9ec72a",
                                        "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                                        "glosses": [
                                            "D’une manière à échapper à la vigilance des radars des ennemis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0268fd8-fccc-47a2-a094-61fc1c88a5f9",
                                                "sense_id": "194bac91-05d8-387a-8854-9f45fc9ec72a",
                                                "text": "Les éclaireurs volant furtivement ont pu photographier les installations nucléaires illicites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af7f4210-e10b-49a9-b5a7-f721aa5545bb",
                        "source_entry_id": "2a45fd33-56a9-3219-9032-6665bbd29f8a",
                        "source_sense_id": "fba0a30c-8ef1-3f03-b113-65b1c69a3f5c",
                        "source_sense_description": "in a furtive manner",
                        "target_lang_word": "subrepticement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subrepticement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cdcb21c-f996-37c2-9ccd-f8bb21eee761",
                                        "entry_id": "25646870-d8f7-3c71-b4a7-d9eddc46e60d",
                                        "glosses": [
                                            "D’une manière subreptice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674364df-d870-4df8-aab1-b82af6f1add4",
                                                "sense_id": "6cdcb21c-f996-37c2-9ccd-f8bb21eee761",
                                                "text": "Bert se hâta de les suivre, mais il lui fut impossible d’avancer assez vite et assez subrepticement pour surprendre en quel endroit ils avaient caché les vivres."
                                            },
                                            {
                                                "example_id": "7e4de161-c4ab-4fd4-9e2d-00deacb7eeb2",
                                                "sense_id": "6cdcb21c-f996-37c2-9ccd-f8bb21eee761",
                                                "text": "Il se penche sur sa main, mais tire subrepticement de sa poche une loupe de bijoutier et en profite pour examiner les bagues de plus près."
                                            },
                                            {
                                                "example_id": "8c2e2e5c-7396-4478-96c2-8b72978a9473",
                                                "sense_id": "6cdcb21c-f996-37c2-9ccd-f8bb21eee761",
                                                "text": "7 mai 42 – La statue de Jeanne d’Arc a été subrepticement pavoisée et les Allemands ne s’en sont aperçus que quelques heures plus tard."
                                            },
                                            {
                                                "example_id": "f8874222-9738-448f-ad6c-796ae4cf1678",
                                                "sense_id": "6cdcb21c-f996-37c2-9ccd-f8bb21eee761",
                                                "text": "Il me semble que la méconnaissance des pièges totalitaires du langage juridique est souvent profonde dans nos États. Si les justiciables n'y prennent garde, le chancre du totalitarisme peut prendre souche, subrepticement, et la liberté individuelle y perdre, lentement mais sûrement, des plumes."
                                            },
                                            {
                                                "example_id": "cf25c3a3-9452-422b-8acd-63452c4afd29",
                                                "sense_id": "6cdcb21c-f996-37c2-9ccd-f8bb21eee761",
                                                "text": "Mais aujourd'hui, la modernisation des installations fait planer un grave péril sur les 70 sites fortifiés à usage agricole. A Cussy-le-Châtel, à Chalvosson (Villaines), à Chevigny-lès-Millery, les exploitants rebouchent subrepticement les fossés pour étendre leurs bâtiments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
