                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc13e42-bfed-4fa9-8210-1753f9082862",
                                                "sense_id": "ac276b36-add0-37d3-bffa-9b9c1e3ace72",
                                                "text": "[Witkacy] jeden z rozdziałów Szkiców tytułuje: Ogólna teoria sztuki a kryteria oceny dzieł"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "16406cdf-e074-3883-8653-8901093cf78c",
                                        "entry_id": "c5b7e7d1-e5f9-3843-81ee-23f043e83a78",
                                        "glosses": [
                                            "wypowiadać czyjś tytuł podczas mówienia o nim lub do niego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06380c19-cf06-478d-a5c7-cf7d4de93277",
                                                "sense_id": "16406cdf-e074-3883-8653-8901093cf78c",
                                                "text": "Tym bardziej więc zdziwiło mnie, że w zapadłych wioskach Irlandczyk jest jakoś dziwnie tytułowany – ani to imieniem, ani nazwiskiem…"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
