{
    "word_family": [
        "vlak",
        "vlakte",
        "vlakheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64aeded1-4252-342b-8c8e-22ad35af5e0c",
                    "sense_definition": "het minder snel stijgen of dalen van een ontwikkeling waardoor een grafiek horizontaler loopt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De groei van de huizenprijzen zal volgend jaar waarschijnlijk iets gaan <w>afvlakken</w>.",
                            "target_lang_translations": {
                                "en": "House price growth will likely start to <w>level off</w> a bit next year."
                            }
                        },
                        {
                            "text": "De economische groei begint na jaren van snelle toename eindelijk te <w>afvlakken</w>.",
                            "target_lang_translations": {
                                "en": "After years of rapid increase, economic growth is finally starting to <w>flatten out</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nivelleren"
                    ],
                    "common_phrases": [
                        "groei gaat afvlakken",
                        "stijging begint afvlakken"
                    ],
                    "target_lang_definitions": {
                        "en": "the slowing down of an increase or decrease in a development, causing a graph to become more horizontal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to level off",
                                "target_lang_sense_clarification": "of a trend or graph"
                            },
                            {
                                "target_lang_word": "to flatten out",
                                "target_lang_sense_clarification": "of a curve or growth rate"
                            },
                            {
                                "target_lang_word": "to plateau",
                                "target_lang_sense_clarification": "to reach a stable level after growth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "983ca96c-69d2-381f-9816-38300bccf847",
                    "sense_definition": "het verminderen of dempen van grote schommelingen of uitschieters",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid probeert de pieken in het energieverbruik te <w>afvlakken</w> met nieuwe maatregelen.",
                            "target_lang_translations": {
                                "en": "The government is trying to <w>smooth out</w> the peaks in energy consumption with new measures."
                            }
                        },
                        {
                            "text": "Door de uitschieters te <w>afvlakken</w> krijgen we een beter beeld van het gemiddelde.",
                            "target_lang_translations": {
                                "en": "By <w>smoothing out</w> the outliers, we get a better picture of the average."
                            }
                        }
                    ],
                    "synonyms": [
                        "nivelleren"
                    ],
                    "common_phrases": [
                        "pieken afvlakken",
                        "schommelingen afvlakken"
                    ],
                    "target_lang_definitions": {
                        "en": "reducing or dampening large fluctuations or outliers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to smooth out",
                                "target_lang_sense_clarification": "fluctuations or peaks"
                            },
                            {
                                "target_lang_word": "to dampen",
                                "target_lang_sense_clarification": "to reduce the intensity of variations"
                            },
                            {
                                "target_lang_word": "to level out",
                                "target_lang_sense_clarification": "to make more uniform"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f29a9afb-5121-3062-922c-797cd240d2eb",
                    "sense_definition": "iets wat oneffen of bol is weer glad of vlak maken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman moest het ruwe hout eerst voorzichtig <w>afvlakken</w> met een schaaf.",
                            "target_lang_translations": {
                                "en": "The carpenter first had to carefully <w>flatten</w> the rough wood with a plane."
                            }
                        },
                        {
                            "text": "Je kunt de randen van de steen <w>afvlakken</w> om hem passend te maken.",
                            "target_lang_translations": {
                                "en": "You can <w>level</w> the edges of the stone to make it fit."
                            }
                        }
                    ],
                    "synonyms": [
                        "egaliseren",
                        "schaven",
                        "vlakmaken"
                    ],
                    "common_phrases": [
                        "oneffenheden afvlakken",
                        "randen afvlakken"
                    ],
                    "target_lang_definitions": {
                        "en": "making something that is uneven or convex smooth or flat again"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flatten",
                                "target_lang_sense_clarification": "to make a surface flat"
                            },
                            {
                                "target_lang_word": "to level",
                                "target_lang_sense_clarification": "to make even or horizontal"
                            },
                            {
                                "target_lang_word": "to smooth",
                                "target_lang_sense_clarification": "to remove roughness or bumps"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5902dac2-fb31-3771-be8d-7ce80896f024",
                    "sense_definition": "het minder intens, vitaal of levendig worden van emoties of persoonlijkheid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de zware medicatie begon zijn enthousiasme voor het leven merkbaar te <w>afvlakken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the heavy medication, his enthusiasm for life began to <w>dull</w> noticeably."
                            }
                        },
                        {
                            "text": "Het is een manier om de pijn die je voelt te <w>afvlakken</w>.",
                            "target_lang_translations": {
                                "en": "It is a way to <w>blunt</w> the pain you are feeling."
                            }
                        }
                    ],
                    "common_phrases": [
                        "emoties afvlakken",
                        "gevoelens afvlakken"
                    ],
                    "target_lang_definitions": {
                        "en": "the process of emotions or personality becoming less intense, vital, or lively"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to dull",
                                "target_lang_sense_clarification": "to make emotions less sharp or intense"
                            },
                            {
                                "target_lang_word": "to flatten",
                                "target_lang_sense_clarification": "of affect or emotional response"
                            },
                            {
                                "target_lang_word": "to blunt",
                                "target_lang_sense_clarification": "to weaken the force of feelings"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}