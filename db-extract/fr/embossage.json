                "senses": [
                    {
                        "sense_id": "4b28a7a3-2bea-31ce-964d-2846a5bf29ff",
                        "entry_id": "67f8c8b1-7f2b-3d4f-980f-cb437e9d9f46",
                        "glosses": [
                            "Action d’embosser, ou état d’un navire embossé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622e8554-ad20-46b4-b99f-18ff13c84001",
                                "sense_id": "4b28a7a3-2bea-31ce-964d-2846a5bf29ff",
                                "text": "L’embossage n’est pas une manœuvre aisée, surtout lorsqu’on doit l’exécuter à plusieurs navires et sous le feu de l’ennemi."
                            }
                        ]
                    },
                    {
                        "sense_id": "87084f75-2f8f-3b86-80a3-8f41e5a16896",
                        "entry_id": "67f8c8b1-7f2b-3d4f-980f-cb437e9d9f46",
                        "glosses": [
                            "Technique qui a pour objectif de créer des formes en relief dans du papier ou un autre matériau déformable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d649a159-91ed-4367-a0a0-109500469d38",
                                "sense_id": "87084f75-2f8f-3b86-80a3-8f41e5a16896",
                                "text": "Au tournant du 20e siècle, les bouteilles sont souvent pourvues d’embossage: le nom du médicament et celui de la compagnie pharmaceutique sont donc directement inscrits dans le verre."
                            }
                        ]
                    },
                    {
                        "sense_id": "3809a21e-3812-3291-8650-e0a8c2e46e41",
                        "entry_id": "67f8c8b1-7f2b-3d4f-980f-cb437e9d9f46",
                        "glosses": [
                            "Remplissage d’un boyau."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "ac8b6ae9-1e90-47d7-b390-e81e9a8f6ed4",
                                "sense_id": "3809a21e-3812-3291-8650-e0a8c2e46e41",
                                "text": "Les poussoirs ou embossoirs à saucisses \"poussent\" la chair à saucisse dans les boyaux en enlevant l’air et sont plus pratiques et plus rapides que l’embossage avec un hachoir à viande."
                            }
                        ]
                    }
                ],
