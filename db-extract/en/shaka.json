                        "entry_id": "9be3b6dd-2b50-3721-97ea-fb95f18170ac",
                        "glosses": [
                            "A greeting gesture in which the thumb and little finger are extended while curling the three middle fingers in a semi-fist, used to express a variety of positive meanings including all right, hello and goodbye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1434adf9-56da-4828-b217-6092dd8b5ac1",
                                "sense_id": "ce13efca-0c1c-3b36-9f81-8dac9694c646",
                                "text": "Greet someone with the slang, “Howzit?” and say goodbye with a flash of the “shaka” sign (fist closed, thumb and pinky extended) and you have established your credibility with Hawaii natives."
                            },
                            {
                                "example_id": "289d294d-e4ea-43fa-9b50-e3ed3ae172bd",
                                "sense_id": "ce13efca-0c1c-3b36-9f81-8dac9694c646",
                                "text": "US President-elect Obama flashes the 'shaka' before he greets a crowd […]"
                            }
                        ]
                    }
