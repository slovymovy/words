{
    "word_family": [
        "speckle",
        "speckled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8fbcaa7-01f1-3631-8257-b2f1d5eeff31",
                    "sense_definition": "A tiny spot or particle, especially of dirt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "small_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a tiny <w>speck</w> of dust on the camera lens.",
                            "target_lang_translations": {
                                "cs": "Na čočce fotoaparátu bylo malé <w>smítko</w> prachu."
                            }
                        },
                        {
                            "text": "The distant ship was just a small <w>speck</w> on the horizon.",
                            "target_lang_translations": {
                                "cs": "Vzdálená loď byla na obzoru jen malou <w>tečkou</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spot",
                        "fleck",
                        "mote",
                        "particle"
                    ],
                    "common_phrases": [
                        "tiny speck"
                    ],
                    "target_lang_definitions": {
                        "cs": "Drobná částečka nebo skvrnka, zejména nečistoty."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smítko",
                                "target_lang_sense_clarification": "drobná částečka nečistoty, prachu"
                            },
                            {
                                "target_lang_word": "skvrnka",
                                "target_lang_sense_clarification": "malá barevná značka nebo bod"
                            },
                            {
                                "target_lang_word": "tečka",
                                "target_lang_sense_clarification": "malý bod, často v přeneseném smyslu pro něco velmi malého"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdb3ef23-1d94-33c4-9ed9-8b8d6c461f83",
                    "sense_definition": "A very small amount; a particle; a whit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is not a <w>speck</w> of truth in his entire story.",
                            "target_lang_translations": {
                                "cs": "V celém jeho příběhu není ani <w>zrnko</w> pravdy."
                            }
                        },
                        {
                            "text": "She did not have a <w>speck</w> of regret for her decision.",
                            "target_lang_translations": {
                                "cs": "Necítila ani <w>trochu</w> lítosti nad svým rozhodnutím."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "iota",
                        "whit",
                        "scrap"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi malé množství; trocha."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zrnko",
                                "target_lang_sense_clarification": "přeneseně malé množství (např. zrnko pravdy)"
                            },
                            {
                                "target_lang_word": "trocha",
                                "target_lang_sense_clarification": "obecné vyjádření malého množství"
                            },
                            {
                                "target_lang_word": "ani kapka",
                                "target_lang_sense_clarification": "idiomatické vyjádření nulového množství (např. ani kapka pravdy)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6474463-a4e9-36d8-9a77-7b962fca93e2",
                    "sense_definition": "A juniper-flavoured ham originally from Tyrol.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a platter of thinly sliced <w>speck</w> and local cheese.",
                            "target_lang_translations": {
                                "cs": "Objednali jsme si talíř tence nakrájeného <w>specku</w> a místního sýra."
                            }
                        },
                        {
                            "text": "The restaurant serves authentic <w>speck</w> imported directly from the Alps.",
                            "target_lang_translations": {
                                "cs": "Restaurace podává autentický <w>speck</w> dovážený přímo z Alp."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Associated with Tyrol and Alpine cuisine."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jalovcem kořeněná šunka původem z Tyrolska."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "speck",
                                "target_lang_sense_clarification": "tradiční tyrolská sušená šunka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5df17a73-f5a5-3c35-bd32-2039d4aa7e40",
                    "sense_definition": "To mark with specks; to speckle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist decided to <w>speck</w> the canvas with tiny drops of white paint.",
                            "target_lang_translations": {
                                "cs": "Umělec se rozhodl <w>pokropit</w> plátno drobnými kapkami bílé barvy."
                            }
                        },
                        {
                            "text": "The old paper was <w>speck</w>ed with brown spots due to age.",
                            "target_lang_translations": {
                                "cs": "Starý papír byl věkem <w>posetý</w> hnědými skvrnkami."
                            }
                        }
                    ],
                    "synonyms": [
                        "speckle",
                        "spot"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrýt něčím drobným, vytvořit skvrnky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokropit",
                                "target_lang_sense_clarification": "vytvořit drobné skvrnky (např. barvou)"
                            },
                            {
                                "target_lang_word": "poset",
                                "target_lang_sense_clarification": "pokrýt povrch mnoha drobnými body"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ccb30533-314e-37ab-8adc-8eafdb242497",
                    "sense_definition": "A surname from German.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by a professor named <w>Speck</w>.",
                            "target_lang_translations": {
                                "cs": "Výzkumnou práci napsal profesor jménem <w>Speck</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Speck</w> is visiting the office today for a meeting.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Speck</w> dnes navštíví kancelář kvůli schůzce."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení německého původu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Speck",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}