                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc6c896-1b31-47a1-ba5d-bfea7c9dc9a2",
                                                "sense_id": "6d996d9b-597c-300c-9e68-14b222fc6c81",
                                                "text": "The dropper left the suitcase with the bomb next to the garbage can."
                                            },
