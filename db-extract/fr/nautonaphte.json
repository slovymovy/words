                        "examples": [
                            {
                                "example_id": "8e52b599-7f63-4069-a072-f47639c65765",
                                "sense_id": "2df15bcd-7b3d-3cf3-a718-9388efd50666",
                                "text": "Le nautonaphte « Eridan » est bondé ; des troupes pour Madagascar, des officiers, des marins, des fonctionnaires destinés à être essaimés sur le trajet, des commerçants pour l'Indochine, quelques uns pour Changhai."
                            },
                            {
                                "example_id": "120d6d46-1551-4d97-917b-5ae35ea99c23",
                                "sense_id": "2df15bcd-7b3d-3cf3-a718-9388efd50666",
                                "text": "On appelle ce bateau un « nautonaphte » parce qu'il fonctionne au fuel et non au charbon. Treize mille tonneaux. Huit cent quinze personnes à bord. Piscine, théâtre, cinéma, salle de bar, salon de coiffure, et j'en passe."
                            }
                        ]
                    }
