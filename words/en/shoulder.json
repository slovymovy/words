{
    "word_family": [
        "shoulder blade",
        "broad-shouldered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "238e280f-1868-3209-8a18-2891a787d5bf",
                    "sense_definition": "The part of the human body between the neck and the upper arm, or the corresponding part of an animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parrot was sitting comfortably on Steve's <w>shoulder</w>.",
                            "target_lang_translations": {
                                "ru": "Попугай удобно сидел на <w>плече</w> Стива.",
                                "pl": "Papuga siedziała wygodnie na <w>ramieniu</w> Steve'a."
                            }
                        },
                        {
                            "text": "She tapped him on the <w>shoulder</w> to get his attention.",
                            "target_lang_translations": {
                                "ru": "Она похлопала его по <w>плечу</w>, чтобы привлечь его внимание.",
                                "pl": "Poklepała go po <w>ramieniu</w>, aby zwrócić jego uwagę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "look over shoulder",
                        "shoulder to shoulder",
                        "on one's shoulders",
                        "cry on shoulder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела человека или животного между шеей и рукой.",
                        "pl": "Część ciała człowieka lub zwierzęcia między szyją a ramieniem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плечо",
                                "target_lang_sense_clarification": "часть тела"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ramię",
                                "target_lang_sense_clarification": "część ciała"
                            },
                            {
                                "target_lang_word": "bark",
                                "target_lang_sense_clarification": "staw barkowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2bb0a72-18d9-3517-b1fe-6f585435d205",
                    "sense_definition": "The part of a piece of clothing that covers the shoulder.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat was a bit tight across the <w>shoulders</w>.",
                            "target_lang_translations": {
                                "ru": "Пальто было немного узким в <w>плечах</w>.",
                                "pl": "Płaszcz był nieco ciasny w <w>ramionach</w>."
                            }
                        },
                        {
                            "text": "She wore a dress with a padded <w>shoulder</w> that was popular in the eighties.",
                            "target_lang_translations": {
                                "ru": "Она носила платье с подкладными <w>плечами</w>, которые были популярны в восьмидесятых.",
                                "pl": "Nosiła sukienkę z poduszeczkami na <w>ramionach</w>, które były popularne w latach osiemdziesiątych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "padded shoulder",
                        "shoulder pad",
                        "shoulder strap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть одежды, закрывающая плечо.",
                        "pl": "Część ubrania zakrywająca ramię."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плечо",
                                "target_lang_sense_clarification": "часть одежды"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ramię",
                                "target_lang_sense_clarification": "część ubrania"
                            },
                            {
                                "target_lang_word": "bark",
                                "target_lang_sense_clarification": "w odzieży"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5730e886-ed40-3398-ae4e-571b41861cc8",
                    "sense_definition": "A strip of land bordering a road where vehicles can stop in an emergency.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stopped the car on the <w>shoulder</w> of the highway to change the flat tire.",
                            "target_lang_translations": {
                                "ru": "Он остановил машину на <w>обочине</w> шоссе, чтобы поменять спущенное колесо.",
                                "pl": "Zatrzymał samochód na <w>poboczu</w> autostrady, aby zmienić przebitą oponę."
                            }
                        },
                        {
                            "text": "It is dangerous to drive on the <w>shoulder</w> unless you have an emergency.",
                            "target_lang_translations": {
                                "ru": "Опасно ехать по <w>обочине</w>, если у вас нет чрезвычайной ситуации.",
                                "pl": "Jazda po <w>poboczu</w> jest niebezpieczna, chyba że masz sytuację awaryjną."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "hard shoulder",
                        "soft shoulder",
                        "pull onto shoulder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоса земли вдоль дороги, где транспортные средства могут остановиться в случае чрезвычайной ситуации.",
                        "pl": "Pas ziemi wzdłuż drogi, na którym pojazdy mogą zatrzymać się w sytuacjach awaryjnych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обочина",
                                "target_lang_sense_clarification": "дорога"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pobocze",
                                "target_lang_sense_clarification": "droga"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1408822d-2f10-3887-8c49-07b484cbe800",
                    "sense_definition": "A cut of meat from the upper part of the front leg of an animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We roasted a <w>shoulder</w> of lamb for dinner last Sunday.",
                            "target_lang_translations": {
                                "ru": "Мы запекли баранью <w>лопатку</w> на ужин в прошлое воскресенье.",
                                "pl": "W zeszłą niedzielę upiekliśmy jagnięcą <w>łopatkę</w> na obiad."
                            }
                        },
                        {
                            "text": "The recipe calls for a slow-cooked pork <w>shoulder</w>.",
                            "target_lang_translations": {
                                "ru": "Рецепт требует свиной <w>лопатки</w> медленного приготовления.",
                                "pl": "Przepis wymaga wolno gotowanej <w>łopatki</w> wieprzowej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pork shoulder",
                        "lamb shoulder",
                        "shoulder of mutton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отруб мяса из верхней части передней ноги животного.",
                        "pl": "Kawałek mięsa z górnej części przedniej nogi zwierzęcia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопатка",
                                "target_lang_sense_clarification": "мясо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "łopatka",
                                "target_lang_sense_clarification": "mięso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "550974ec-6ae5-31a9-9d49-85bd35106e8d",
                    "sense_definition": "A part of a hill or mountain just below the peak, resembling a human shoulder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They hiked up the north-western <w>shoulder</w> of the mountain.",
                            "target_lang_translations": {
                                "ru": "Они поднялись на северо-западное <w>плечо</w> горы.",
                                "pl": "Wędrowali w górę północno-zachodniego <w>zbocza</w> góry."
                            }
                        },
                        {
                            "text": "The cabin was nestled on the rocky <w>shoulder</w> of the hill.",
                            "target_lang_translations": {
                                "ru": "Хижина приютилась на скалистом <w>уступе</w> холма.",
                                "pl": "Chatka była usytuowana na skalistym <w>zboczu</w> wzgórza."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть холма или горы чуть ниже вершины, напоминающая плечо человека.",
                        "pl": "Część wzgórza lub góry tuż poniżej szczytu, przypominająca kształtem ludzkie ramię."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плечо",
                                "target_lang_sense_clarification": "горы"
                            },
                            {
                                "target_lang_word": "уступ",
                                "target_lang_sense_clarification": "география"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zbocze",
                                "target_lang_sense_clarification": "góry"
                            },
                            {
                                "target_lang_word": "ramię",
                                "target_lang_sense_clarification": "grzbietu górskiego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90fc0506-d9e7-340c-b38b-9043d207f760",
                    "sense_definition": "A period of time between the peak season and the off-season, often used in travel or business.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Flights are much cheaper if you travel during the <w>shoulder</w> season.",
                            "target_lang_translations": {
                                "ru": "Авиабилеты намного дешевле, если вы путешествуете в <w>межсезонье</w>.",
                                "pl": "Loty są znacznie tańsze, jeśli podróżujesz w <w>sezonie przejściowym</w>."
                            }
                        },
                        {
                            "text": "Hotels often lower their rates in the <w>shoulder</w> months of spring and autumn.",
                            "target_lang_translations": {
                                "ru": "Отели часто снижают цены в <w>переходные</w> месяцы весны и осени.",
                                "pl": "Hotele często obniżają ceny w <w>miesiącach przejściowych</w> wiosną i jesienią."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder season",
                        "shoulder period",
                        "shoulder months"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени между пиковым сезоном и межсезоньем, часто используемый в туризме.",
                        "pl": "Okres czasu między szczytem sezonu a okresem poza sezonem, często stosowany w turystyce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "межсезонье",
                                "target_lang_sense_clarification": "туризм"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sezon przejściowy",
                                "target_lang_sense_clarification": "turystyka"
                            },
                            {
                                "target_lang_word": "niski sezon",
                                "target_lang_sense_clarification": "biznes"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b4a577d-fbf1-303b-bc63-2978abf71dd4",
                    "sense_definition": "To accept and bear a difficult responsibility, burden, or blame.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager had to <w>shoulder</w> the blame for the project's failure.",
                            "target_lang_translations": {
                                "ru": "Менеджеру пришлось <w>взять на себя</w> вину за провал проекта.",
                                "pl": "Menedżer musiał <w>wziąć na siebie</w> winę za niepowodzenie projektu."
                            }
                        },
                        {
                            "text": "She <w>shouldered</w> the responsibility of raising three children alone.",
                            "target_lang_translations": {
                                "ru": "Она <w>взвалила на плечи</w> ответственность за воспитание троих детей в одиночку.",
                                "pl": "<w>Wzięła na swoje barki</w> odpowiedzialność za samotne wychowanie trojga dzieci."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "shoulder the blame",
                        "shoulder responsibility",
                        "shoulder the burden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать на себя трудную ответственность, бремя или вину.",
                        "pl": "Przyjąć i znosić trudną odpowiedzialność, ciężar lub winę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать на себя",
                                "target_lang_sense_clarification": "ответственность"
                            },
                            {
                                "target_lang_word": "взваливать на плечи",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "brać na barki",
                                "target_lang_sense_clarification": "odpowiedzialność"
                            },
                            {
                                "target_lang_word": "wziąć na siebie",
                                "target_lang_sense_clarification": "winę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb03816-0200-3ae0-a0fe-bffc65b2aec5",
                    "sense_definition": "To push someone or something using one's shoulder, often to make way through a crowd.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>shoulder</w> his way through the busy market.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>пробиться</w> через оживленный рынок.",
                                "pl": "Udało mu się <w>przepchnąć</w> przez zatłoczony targ."
                            }
                        },
                        {
                            "text": "The rude man <w>shouldered</w> me aside to get on the bus first.",
                            "target_lang_translations": {
                                "ru": "Грубый мужчина <w>оттолкнул меня плечом</w>, чтобы войти в автобус первым.",
                                "pl": "Niegrzeczny mężczyzna <w>odsunął mnie ramieniem</w>, aby wejść do autobusu jako pierwszy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder one's way",
                        "shoulder aside",
                        "shoulder through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толкать кого-то или что-то плечом, часто чтобы пробраться через толпу.",
                        "pl": "Popychać kogoś lub coś ramieniem, często aby utorować sobie drogę przez tłum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробиваться",
                                "target_lang_sense_clarification": "сквозь толпу"
                            },
                            {
                                "target_lang_word": "толкать плечом",
                                "target_lang_sense_clarification": "физическое действие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozpychać się",
                                "target_lang_sense_clarification": "łokciami/ramionami"
                            },
                            {
                                "target_lang_word": "potrącić ramieniem",
                                "target_lang_sense_clarification": "fizycznie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c78d6bb-5ff9-3bf5-955a-cc90a05d7f56",
                    "sense_definition": "To put something on one's shoulders in order to carry it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "carry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers <w>shouldered</w> their heavy packs and started walking.",
                            "target_lang_translations": {
                                "ru": "Туристы <w>закинули на плечи</w> свои тяжелые рюкзаки и пошли.",
                                "pl": "Wędrowcy <w>zarzucili na ramiona</w> ciężkie plecaki i ruszyli w drogę."
                            }
                        },
                        {
                            "text": "He <w>shouldered</w> his gym bag and walked out the door.",
                            "target_lang_translations": {
                                "ru": "Он <w>повесил на плечо</w> спортивную сумку и вышел за дверь.",
                                "pl": "<w>Zarzucił na ramię</w> torbę sportową i wyszedł przez drzwi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder a pack",
                        "shoulder a rifle",
                        "shoulder a bag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Класть что-то на плечи, чтобы нести.",
                        "pl": "Położyć coś na ramionach, aby to nieść."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закидывать на плечо",
                                "target_lang_sense_clarification": "груз"
                            },
                            {
                                "target_lang_word": "нести на плече",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zarzucić na ramię",
                                "target_lang_sense_clarification": "bagaż"
                            },
                            {
                                "target_lang_word": "nieść na ramieniu",
                                "target_lang_sense_clarification": "ciężar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}