                        "cross_references": [
                            {
                                "target_word": "прилипа́ла",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0127d015-8b53-373e-8625-5dce3e91a31f",
                                        "entry_id": "9ed6558d-9736-3088-b0ff-14f2df16b861",
                                        "glosses": [
                                            "зоол., ихтиол. морская рыба, имеющая присоску на голове, при помощи которой она прикрепляется, прилипает к рыбам, китам, днищам кораблей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3f58ce-d47d-40b4-a171-88b1d7d937df",
                                                "sense_id": "0127d015-8b53-373e-8625-5dce3e91a31f",
                                                "text": "Прилипалы .. имеют тройную пользу для себя: так сказать, даровой проезд, полную безопасность от других хищников .. и кое-какие крохи от обильного стола прожорливых акул."
                                            },
                                            {
                                                "example_id": "e9f4e180-e2e4-4437-8557-d3bcb2757eb6",
                                                "sense_id": "0127d015-8b53-373e-8625-5dce3e91a31f",
                                                "text": "Прилипалы питаются мелкими кусочками пищи, остающимися от акульей охоты, и, кроме того, они поедают некоторых ракообразных паразитов на коже и в жаберных щелях акул."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "прилипа́ла",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "64a6abad-10e1-3945-b0a3-8045e709b62f",
                                        "entry_id": "845aee8e-f0ef-3ab8-80ac-22fc8f98b992",
                                        "glosses": [
                                            "разг., сниж., неодобр. или презр. навязчивый, надоедливый человек"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "685e5949-0738-3317-8821-92b6084aa59d",
                                        "entry_id": "845aee8e-f0ef-3ab8-80ac-22fc8f98b992",
                                        "glosses": [
                                            "разг., сниж., неодобр. или презр. тот, кто примазывается к кому-либо или чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0ff407-269e-4a2e-8965-46a92ab69e61",
                                                "sense_id": "685e5949-0738-3317-8821-92b6084aa59d",
                                                "text": "Особенно он ненавидел «окололитературных прилипал», которые проникали во все щели помещения, в котором хотя бы чуть-чуть «пахло литературой»."
                                            },
                                            {
                                                "example_id": "0adbaa21-6dbb-42e0-97bf-0734b01a867c",
                                                "sense_id": "685e5949-0738-3317-8821-92b6084aa59d",
                                                "text": "Соперничество, перешедшее во вражду, им навязали окружающие: публика, истерические поклонницы, докучные «знатоки», критики, журналисты, дельцы от музыки и всевозможные прилипалы."
                                            },
                                            {
                                                "example_id": "d2a45f74-1ad3-4248-9271-036fc488c988",
                                                "sense_id": "685e5949-0738-3317-8821-92b6084aa59d",
                                                "text": "Аналогичная ситуация в футболе, хоккее, да что говорить — там, где есть коммерческий интерес, обязательно появляются прилипалы."
                                            },
                                            {
                                                "example_id": "28582928-ad06-4a7a-94bd-062126559fe2",
                                                "sense_id": "685e5949-0738-3317-8821-92b6084aa59d",
                                                "text": "Таня знала, что Пипа, как обычно, станет покупать всем мороженое и блины с шоколадом, а прилипалы за это будут подобострастно смотреть ей в рот и смеяться каждой её шутке."
                                            }
                                        ]
                                    },
