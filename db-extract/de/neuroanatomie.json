                        "entry_id": "8e4cb09f-0fa7-3607-817a-9dff96c79464",
                        "glosses": [
                            "Teilgebiet der Neurowissenschaften, das sich mit dem Aufbau des Nervensystems befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3d49be-612b-48c6-9a86-d3b00d6b1950",
                                "sense_id": "2e6ff51d-34a1-3ac3-89e6-a565ec1d744d",
                                "text": "In der Neuroanatomie sind Kommissuren Querbahnen zwischen der rechten und linken Hirnhälfte oder zwischen der rechten und linken Hälfte des Rückenmarks."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
