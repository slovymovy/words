                "senses": [
                    {
                        "sense_id": "f7488423-89ce-3704-b6c2-783e34785a2d",
                        "entry_id": "d0c51fdd-1cd8-31b1-b490-e2b2826f4cb5",
                        "glosses": [
                            "der Versuch, zum Erliegen gekommenen Lebensfunktionen durch gezielte Maßnahmen wieder in Gang zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba9d8a1-e255-4660-9b93-8531875fbf0d",
                                "sense_id": "f7488423-89ce-3704-b6c2-783e34785a2d",
                                "text": "„Dieser [Der Notarzt] konnte – trotz der vorausgegangenen Wiederbelebungsversuche des Rettungsteams – aber nur noch den Tod der Frau feststellen.“"
                            },
                            {
                                "example_id": "816e7073-a49d-40cb-a338-8a26b6919f54",
                                "sense_id": "f7488423-89ce-3704-b6c2-783e34785a2d",
                                "text": "„Er war schon eine Weile tot, und alle Wiederbelebungsversuche blieben erfolglos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33d09edc-7977-35f2-a3e7-8d7b2d161854",
                        "entry_id": "d0c51fdd-1cd8-31b1-b490-e2b2826f4cb5",
                        "glosses": [
                            "der Versuch, eine alte Mode, einen alten Stil etc. wieder einzuführen, wieder aufleben zu lassen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "62f74daf-046a-4d7d-87a4-5c530bdc022f",
                                "sense_id": "33d09edc-7977-35f2-a3e7-8d7b2d161854",
                                "text": "„Das neue Team hinter der Loveparade macht Ernst mit dem Wiederbelebungsversuch des Techno-Umzuges.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
