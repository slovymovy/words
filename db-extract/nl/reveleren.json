                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disclose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59c02829-7559-3d0d-a238-3f041035fa45",
                                        "entry_id": "0de4848a-ffa6-3f02-92eb-a132d75e3eff",
                                        "glosses": [
                                            "To open up, unfasten."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "944f02c7-62ae-4c29-a137-8e9845354c49",
                                                "sense_id": "59c02829-7559-3d0d-a238-3f041035fa45",
                                                "text": "The estrich layeth her eggs under sand, where the heat of the discloseth them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb511b4e-c30c-3d89-bfa9-62a517bb9b34",
                                        "entry_id": "0de4848a-ffa6-3f02-92eb-a132d75e3eff",
                                        "glosses": [
                                            "To uncover, physically expose to view."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cee0d4b-2b90-4f74-abe5-c3c3da5a5e9d",
                                                "sense_id": "bb511b4e-c30c-3d89-bfa9-62a517bb9b34",
                                                "text": "The shells being broken, […] the stone included in them is thereby disclosed and set at liberty."
                                            },
                                            {
                                                "example_id": "b61a931b-727c-4218-9627-3783223a32bb",
                                                "sense_id": "bb511b4e-c30c-3d89-bfa9-62a517bb9b34",
                                                "text": "And it seemed to me that the dream smote the roof above my bed, and the roof opened and disclosed the outer dark, and in the dark travelled a bearded star, and the night was quick with fiery signs."
                                            },
                                            {
                                                "example_id": "7661d4ed-9cde-46c5-8248-bd6a2d41ff60",
                                                "sense_id": "bb511b4e-c30c-3d89-bfa9-62a517bb9b34",
                                                "text": "Some [nest toys] open to disclose a set of babies, tumbling dolls with weights, or old men might open so that they could be used as money-boxes."
                                            },
                                            {
                                                "example_id": "34dab46a-0430-47dc-9e66-518d5d631dd9",
                                                "sense_id": "bb511b4e-c30c-3d89-bfa9-62a517bb9b34",
                                                "text": "Its brown curtain was only half drawn, disclosing the elegant legs, clad in transparent black, of a female seated inside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14589000-f233-3f5c-b53f-10602b931731",
                                        "entry_id": "0de4848a-ffa6-3f02-92eb-a132d75e3eff",
                                        "glosses": [
                                            "To expose to the knowledge of others; to make known, state openly, reveal (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75723e81-1c40-4d1d-9cad-6d9a0dc83e3c",
                                                "sense_id": "14589000-f233-3f5c-b53f-10602b931731",
                                                "text": "Her lively looks a sprightly mind disclose."
                                            },
                                            {
                                                "example_id": "15ebb2a1-9cb7-4ba3-88a7-ee9658dae687",
                                                "sense_id": "14589000-f233-3f5c-b53f-10602b931731",
                                                "text": "If I disclose my passion, / Our friendship's at an end."
                                            },
                                            {
                                                "example_id": "2ff7574f-8603-425a-8559-47cb70c5dfbd",
                                                "sense_id": "14589000-f233-3f5c-b53f-10602b931731",
                                                "text": "Skogan's study is based on weak data. Worse yet, he fails to disclose […] that his data reveal no statistically significant relationship between disorder and crime with regard to four out of five crime variables. Skogan only […] discusses the results of the one test that supports the […] theory"
                                            },
                                            {
                                                "example_id": "9bd0ba62-7d07-4867-97dd-d8d310bb6e3a",
                                                "sense_id": "14589000-f233-3f5c-b53f-10602b931731",
                                                "text": "I feel duty bound to disclose I'm trans. I have a certain emotional investment in the relationship, [so] I've decided I have to disclose, and it scares me."
                                            },
                                            {
                                                "example_id": "c1246571-efdd-4384-bd81-e9df23f9896c",
                                                "sense_id": "14589000-f233-3f5c-b53f-10602b931731",
                                                "text": "Disclosing to a child his or her own HIV-positive status is yet another complicated process. Who should disclose and when and how that person should do it are prominent questions […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disclose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "226a01f8-0f93-3e40-86b1-e192d58a67fe",
                                        "entry_id": "7d47a9e4-2ad9-3499-88cc-fdc0896cb27f",
                                        "glosses": [
                                            "A disclosure."
                                        ],
