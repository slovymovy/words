                                "target_senses": [
                                    {
                                        "sense_id": "97a2514b-3443-317b-bddb-4dd292467eb3",
                                        "entry_id": "397557c0-1622-325a-a117-44159d13d8ca",
                                        "glosses": [
                                            "Sac, mallette, valise qui contient les objets ou les effets que le voyageur emporte et qu’il conserve avec lui pendant le transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926f11e7-90ca-40f9-acac-fd446fa31c9b",
                                                "sense_id": "97a2514b-3443-317b-bddb-4dd292467eb3",
                                                "text": "A Foligno, dix minutes d’arrêt. Dix minutes de pillage dans un infime et sale restaurant-gargotte où se précipite le flot des voyageurs affamés, altérés, exténués, traînant leur volumineux « bagage à main » et demandant à grands cris un restaurateur qui les restaure."
                                            },
                                            {
                                                "example_id": "525ce01e-ec12-4d02-acc5-446de84cf8a8",
                                                "sense_id": "97a2514b-3443-317b-bddb-4dd292467eb3",
                                                "text": "Les voyageurs peuvent garder avec eux, dans le compartiment de voiture qui leur est assigné, leur petit bagage à main, à condition que celui-ci ne soit pas à charge des autres voyageurs ou de nature à les incommoder."
                                            },
                                            {
                                                "example_id": "1c481cc5-f03c-4c3d-95f0-6030400a0e09",
                                                "sense_id": "97a2514b-3443-317b-bddb-4dd292467eb3",
                                                "text": "Que pouvez-vous prendre dans votre bagage à main ? …"
                                            }
                                        ]
                                    }
