                "forms": [
                    {
                        "form_id": "4469fac1-b689-4e40-b43f-6ceda67009f8",
                        "entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "suicidaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29c43bc9-b19f-382b-97fc-238cffd2cf08",
                        "entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "glosses": [
                            "Qui exprime une intention de se suicider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a7f74d-9d2b-40b2-a332-fd9f7f7961c9",
                                "sense_id": "29c43bc9-b19f-382b-97fc-238cffd2cf08",
                                "text": "Comportement suicidaire."
                            },
                            {
                                "example_id": "8f018809-229e-4d19-b1a9-c91cc32166bc",
                                "sense_id": "29c43bc9-b19f-382b-97fc-238cffd2cf08",
                                "text": "Ses héros, hommes et femmes, projections de la fumée de sa pipe tragique, ombres portées sur le mur de sa rancœur, de son taedium vitæ, apparaissent tous et toutes ainsi que suicidaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f6606b8-4607-3da2-9758-c4262e53b04b",
                        "entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "glosses": [
                            "Relatif au suicide."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "be32ffe4-e2e0-31d7-8c48-8ae2a77b20de",
                        "entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "glosses": [
                            "Qui est voué à l’échec, qui n’a aucune chance de réussir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "780266e6-3017-4299-8929-f314cb57acea",
                                "sense_id": "be32ffe4-e2e0-31d7-8c48-8ae2a77b20de",
                                "text": "Prendre ce chemin est suicidaire."
                            },
                            {
                                "example_id": "1d185c27-d6fa-4c20-afa4-052445dd2661",
                                "sense_id": "be32ffe4-e2e0-31d7-8c48-8ae2a77b20de",
                                "text": "Etant donné que 70 % des électeurs conservateurs sont favorables au Brexit, en sortir est pour elle suicidaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "42cace25-a10b-39d3-b4cc-a99142524c91",
                        "entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "glosses": [
                            "Qui mène à la ruine, à la destruction."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b24462ef-e252-4e5f-8161-0613395fae52",
                                "sense_id": "42cace25-a10b-39d3-b4cc-a99142524c91",
                                "text": "Adieu ses majestés, adieu les présidents, adieu scrutins et lois électorales : les gens choisiront, parmi les apprentis marabouts, leurs propres divinités et vivront de rituels stupides et d’exaltations suicidaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "afaf9956-f607-33d4-a27a-d13605bc127f",
                        "entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "glosses": [
                            "Qui comporte un risque mortel."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "039c7076-ba4b-455d-adc8-aa070f81b663",
                        "source_entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "target_lang_word": "lebensmüde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lebensmüde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8117fa7c-a59c-33b7-a3cb-748719042d95",
                                        "entry_id": "2b73e2e4-86ff-38ef-9644-62621ca2052a",
                                        "glosses": [
                                            "am Leben keine Freude habend, des Lebens überdrüssig, den Tod herbeisehnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5ef7555-868e-4b62-8b9e-74505f898579",
                                                "sense_id": "8117fa7c-a59c-33b7-a3cb-748719042d95",
                                                "text": "„In der Abgeschiedenheit der zerklüfteten Gipfel findet der lebensmüde Held des Films für seine letzten Tage Unterschlupf im halb zerfallenen Steinhaus der Witwe Ascen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6893010b-61f2-3696-87d8-c4524cca9671",
                                        "entry_id": "2b73e2e4-86ff-38ef-9644-62621ca2052a",
                                        "glosses": [
                                            "ausgesprochen leichtsinnig; unvernünftig mutig, so dass das eigene Leben aufs Spiel gesetzt wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8bd189-334e-4201-a18e-df1bfb1a2b27",
                                                "sense_id": "6893010b-61f2-3696-87d8-c4524cca9671",
                                                "text": "Da soll ich runterspringen? Ich bin doch nicht lebensmüde!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a72625bf-c769-49d2-b60a-757a36455b6b",
                        "source_entry_id": "f4185129-eaf3-3dcd-a7b3-f3cddf131488",
                        "target_lang_word": "suicidal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suicidal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2b0f90-b5e9-3382-aec3-777989e9b5e2",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Pertaining to suicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e686d2b7-2c1b-4ed3-8ba5-fdfa952a64b1",
                                                "sense_id": "5a2b0f90-b5e9-3382-aec3-777989e9b5e2",
                                                "text": "He is an authority on the precursors of suicidal behavior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Likely to commit, or to attempt to commit, suicide."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4430fe27-0d8c-4622-a682-f99a563374d0",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "After losing his job, his wife, and his leg in a single week, he became suicidal."
                                            },
                                            {
                                                "example_id": "c6ecf5f7-c801-4253-9947-ce1aa9d77f4f",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "The campaign aimed to give commuters the confidence to trust their own instincts and intervene if they spot someone vulnerable who may be at risk of suicide, and to talk to them to interrupt their suicidal thoughts."
                                            },
                                            {
                                                "example_id": "935a9235-d03e-4f3a-8299-5fbb09b30b40",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "Seven people were killed and 66 injured after a High Speed Train slammed into a stationary vehicle that had been parked across the main line by a suicidal driver."
                                            },
                                            {
                                                "example_id": "6cdfdc7c-42e6-47a3-9e7f-6d2b4badc98a",
                                                "sense_id": "2c83c318-9c6a-3835-ae51-327466a8bdbe",
                                                "text": "It makes me feel better that I’m not the only one who fantasizes about being struck down by a meteor on my way to work. Mind you, I’m not actively suicidal at all. I just kinda think being dead without actually killing myself would be easier and way less exhausting.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c9a9e4c-4dee-3464-bf05-737255f86819",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Highly likely to certain to result in the deaths of the participants; dangerous or reckless to such a degree as to be tantamount to suicide for those taking part."
                                        ],
                                        "tags": [
                                            "of a voluntarily-chosen course of action"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5c7b9b2-aef2-4408-9394-0ae66715753b",
                                                "sense_id": "3c9a9e4c-4dee-3464-bf05-737255f86819",
                                                "text": "Now, that, admittedly, did do an awful lot more damage (the 5th and 6th were almost completely wiped out), but the High Seas Fleet was, in turn, almost completely wiped out (in fact, basically was wiped out, to a man) by the oncoming rest of the British Grand Fleet, and it was decided by everybody that this kind of, like, suicidal, completely suicidal, charge was probably a bit out of character for Hipper, and so we didn't take that particular one into account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e596be0-b5a8-3201-a171-df289dc3640a",
                                        "entry_id": "5a24f4df-09c2-397a-bde3-19b6fc47ef3f",
                                        "glosses": [
                                            "Extremely reckless."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d20b8c6-41a3-42a3-adeb-a6a2c125074b",
                                                "sense_id": "4e596be0-b5a8-3201-a171-df289dc3640a",
                                                "text": "His driving habits are utterly suicidal."
                                            },
                                            {
                                                "example_id": "a6db15b6-663b-428e-869f-4f5051c70015",
                                                "sense_id": "4e596be0-b5a8-3201-a171-df289dc3640a",
                                                "text": "“We’ve got civilizational suicidal empathy going on,” Musk said, borrowing the term from Gad Saad, a Canadian scholar who is also a frequent Rogan host."
                                            }
                                        ]
                                    }
                                ]
                            },
