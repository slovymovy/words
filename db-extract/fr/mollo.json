                        "examples": [
                            {
                                "example_id": "5e8a8adf-686d-442f-b21c-caffd5aa8046",
                                "sense_id": "61185a2f-3021-3f93-b5c6-7e8d3ac0ba80",
                                "text": "Mollo, les gars, s’agit pas de se faire remarquer !"
                            },
                            {
                                "example_id": "e2a5dc66-4a15-4f1f-a91a-861bc27c60a3",
                                "sense_id": "61185a2f-3021-3f93-b5c6-7e8d3ac0ba80",
                                "text": "Lui qui voyait en Macron « un traître » aux idées « ringardes » avant de moquer sa « com’ » à tout-va et ses « postures » de Jupiter au petit pied sort désormais les violons. Et il n’appuie pas mollo sur l’archet."
                            },
                            {
                                "example_id": "aab03361-aa89-41c4-9acb-ebb356f65364",
                                "sense_id": "61185a2f-3021-3f93-b5c6-7e8d3ac0ba80",
                                "text": "Il y a des gens qui disent que j'ai joué mollo au départ et fort ensuite, mais le jeu a changé complètement."
                            }
                        ]
                    },
