                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "def4450c-4c56-341f-a9fb-f955ed1d5cf3",
                "word": "teleurgesteld",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                        "entry_id": "def4450c-4c56-341f-a9fb-f955ed1d5cf3",
                        "glosses": [
                            "verdrietig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e1f8547-f295-42c3-91e2-710ea50079b9",
                                "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                "text": "Ik zakte teleurgesteld neer op een houten bankje naast het raam en opende het gastenboek van het café dat als ‘trail-register’ fungeerde."
                            },
                            {
                                "example_id": "c21cf6fe-79d6-44cb-ab78-e17425468ba0",
                                "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                "text": "Ruald keek een beetje teleurgesteld, maar drong niet verder aan."
                            },
                            {
                                "example_id": "0f1d6a75-7cbd-49a8-a9e9-8d2f44c5ae97",
                                "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                "text": "De European Broadcasting Union (EBU), die het Eurovisie Songfestival organiseert, snapt dat er in Oekraïne teleurgesteld is gereageerd op de keuze om het evenement volgend jaar niet in het door oorlog getroffen land te houden. De organisatie blijft echter bij de beslissing dat het winnende land Oekraïne momenteel niet aan de eisen voldoet om het Songfestival te organiseren, meldt ze op Twitter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20cb319b-65bd-406f-bfc4-480adbf1af1e",
                        "source_entry_id": "def4450c-4c56-341f-a9fb-f955ed1d5cf3",
                        "source_sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                        "source_sense_description": "een onaangenaam gevoel hebbend omdat een verwachting of hoop niet uitgekomen is",
                        "target_lang_word": "disappointed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disappointed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                                        "entry_id": "1f16eefd-c37a-3a74-93b2-f40ca709c2c7",
                                        "glosses": [
                                            "Defeated of expectations or hope; experiencing disappointment; let down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ba9c33-9595-46c6-ae6a-7a8baeb03ca9",
                                                "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                                                "text": "After all his anticipation, the trip left him deeply disappointed."
                                            },
                                            {
                                                "example_id": "26c65602-e597-425d-9f8e-366e91e96f95",
                                                "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                                                "text": "If they came to hear me beg, they will be disappointed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21db216a-e9fb-38fb-8311-a82c90af32a1",
                                        "entry_id": "1f16eefd-c37a-3a74-93b2-f40ca709c2c7",
                                        "glosses": [
                                            "Defeated of expectations or hope; experiencing disappointment; let down.",
                                            "Having had a marriage proposal rejected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1e8c05-15f9-479c-a5e5-cd1942250c44",
                                                "sense_id": "21db216a-e9fb-38fb-8311-a82c90af32a1",
                                                "text": "Scattered here and there amongst the steerage passengers were men of a different class: men whose previous lives had not fitted them for the hard and uncertain lot that certainly lay before them - pale-faced boys from Melbourne shops; middle-aged and disappointed men; one and all hoping for a turn of luck in the lottery of the newly-discovered goldfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "101cd6cd-4d37-3d43-8edc-1e7037909965",
                                        "entry_id": "1f16eefd-c37a-3a74-93b2-f40ca709c2c7",
                                        "glosses": [
                                            "Expressing or indicating disappointment."
                                        ],
                                        "tags": [],
                                        "examples": [
