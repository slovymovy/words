                                        "glosses": [
                                            "starogrecka szkoła filozoficzna kładąca nacisk na wewnętrzną dyscyplinę moralną, wypełnianie obowiązków które na nas spadły oraz odcięciu się od emocji i zdarzeń zewnętrznych, w celu osiągnięcia szczęścia"
                                        ],
                                        "tags": [],
