                ],
                "senses": [
                    {
                        "sense_id": "966f9613-580a-3e72-bc5c-962b7e107e9d",
                        "entry_id": "15d1c070-f510-325c-bf03-74bc45b21e27",
                        "glosses": [
                            "Preis, der als sehr günstig angesehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8edd05-5344-43e9-9db2-0e9ccaa4e975",
                                "sense_id": "966f9613-580a-3e72-bc5c-962b7e107e9d",
                                "text": "Diese Lampe wurde zu einem Spottpreis angeboten."
                            },
                            {
                                "example_id": "d4be59d1-9cdf-42cc-b6e0-2cd67aa3a03b",
                                "sense_id": "966f9613-580a-3e72-bc5c-962b7e107e9d",
                                "text": "„Wieder sollten wir Mehl und Zucker empfangen, und wieder hatten die Truppen vor uns alles zu Spottpreisen an die Bevölkerung verkauft.“"
                            },
                            {
                                "example_id": "fab4762a-1ecc-4ea8-8d33-e16039be7bf7",
                                "sense_id": "966f9613-580a-3e72-bc5c-962b7e107e9d",
                                "text": "„Sie sprechen zu diesem Zweck nicht nur private Kunstsammler an, die hier neuerdings in großer Zahl vorhanden sind, sondern gehen auch auf Trödelmärkte, wo Tafelbilder zu Spottpreisen verramscht werden.“"
                            },
                            {
                                "example_id": "6f23e687-d6c8-401f-aad1-916b40dee91b",
                                "sense_id": "966f9613-580a-3e72-bc5c-962b7e107e9d",
                                "text": "„Zunächst verkauften Samuel Maharero und andere Herero-Obere große Ländereien zu Spottpreisen.“"
                            },
                            {
                                "example_id": "0e933023-3735-47a1-b5b5-b7db794df535",
                                "sense_id": "966f9613-580a-3e72-bc5c-962b7e107e9d",
                                "text": "„Sie wird alles in einen dicken schwarzen Abfallsack stopfen – sogar den Hermès-Schal, den Sisi für einen Spottpreis bei einem Straßenhändler ergattert hatte und auf den Madam ungeheuer neidisch gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
