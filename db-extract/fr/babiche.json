                        "examples": [
                            {
                                "example_id": "6963ce0f-e529-4ce9-bb94-16427fe299cb",
                                "sense_id": "3bb2dbb0-e42c-3700-befa-14a977c682ae",
                                "text": "Le collier de babiche lui coupait le cou et entrait dans sa chair comme un couteau. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 29)"
                            },
                            {
                                "example_id": "62b6a35b-2939-46c2-901e-f655106a1eee",
                                "sense_id": "3bb2dbb0-e42c-3700-befa-14a977c682ae",
                                "text": "Il vous semble que vous êtes mal réveillé. Vous n’arrivez pas à nouer la babiche du harnais des chiens."
                            },
                            {
                                "example_id": "3afe2d84-678d-4b60-af6c-d3bcc80e8c96",
                                "sense_id": "3bb2dbb0-e42c-3700-befa-14a977c682ae",
                                "text": "Il se servait de la peau du caribou pour les babiches ."
                            }
                        ]
