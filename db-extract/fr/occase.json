                "senses": [
                    {
                        "sense_id": "9575df6e-c283-3d79-a07f-ca3818773b07",
                        "entry_id": "e1e20483-e8e2-3524-bb23-1e1f0c705929",
                        "glosses": [
                            "Circonstance favorable, événement dont il faut profiter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "76bb51b8-7657-4d35-b015-a22935597326",
                                "sense_id": "9575df6e-c283-3d79-a07f-ca3818773b07",
                                "text": "Rien à faire : je suis embarquée dans la désinvolture et ça me reprend à chaque occase."
                            },
                            {
                                "example_id": "50325a36-ad05-4b18-b600-41f8ac33edcb",
                                "sense_id": "9575df6e-c283-3d79-a07f-ca3818773b07",
                                "text": "Rien à voir, le vicelard dans la pègre, pour situer les choses en gros, c’est celui qui louvoie, saisit l’occase des bonnes arnaques avec un minimum de risques… celui qui sait mener les bonnes embrouilles, qui manœuvre pour s’en sortir… s’arracher à la scoumoune."
                            },
                            {
                                "example_id": "1bf8b243-2393-4ad0-adc8-3be0c26975d1",
                                "sense_id": "9575df6e-c283-3d79-a07f-ca3818773b07",
                                "text": "Ils ne se mouillent jamais les pinglots, observent, localisent, et s’emparent du butin à la première occase, avant de disparaître en lévitation, sans laisser de traces."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1a74c7d-d6c6-38bd-8f7b-e15ff886e1da",
                        "entry_id": "e1e20483-e8e2-3524-bb23-1e1f0c705929",
                        "glosses": [
                            "Objet que l’on recherche et qui est proposé à des conditions intéressantes."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "21948c29-81be-4555-abfd-a1afa2074e1f",
                                "sense_id": "f1a74c7d-d6c6-38bd-8f7b-e15ff886e1da",
                                "text": "Pas question de rater la dernière occase."
                            },
                            {
                                "example_id": "14ae3ed1-d1ba-4497-b6ef-53ac51fd24bd",
                                "sense_id": "f1a74c7d-d6c6-38bd-8f7b-e15ff886e1da",
                                "text": "Une bonne occase, trouvée sur Internet, qui avait sérieusement écorné mes économies en me coûtant huit cents dollars […]"
                            }
                        ]
                    }
