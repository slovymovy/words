                                "target_senses": [
                                    {
                                        "sense_id": "17c483cd-2aee-38fb-ab98-fb1e520d4a85",
                                        "entry_id": "f62d10b0-b3c7-3b2b-a214-5f83fcb3586f",
                                        "glosses": [
                                            "muza astronomii (łącznie z astrologią), jedna z towarzyszek Apolla; córka Zeusa i Mnemosyne"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57822527-3763-43e0-8c55-8a3854b94bd2",
                                                "sense_id": "17c483cd-2aee-38fb-ab98-fb1e520d4a85",
                                                "text": "Urania i jej siostry uświetniały śpiewem biesiady bosko-ludzkie oraz uczty olimpijskie bogów."
                                            },
                                            {
                                                "example_id": "39ec88ac-37e0-48b8-a5d8-3ef6cfde6d02",
                                                "sense_id": "17c483cd-2aee-38fb-ab98-fb1e520d4a85",
                                                "text": "Atrybutami Uranii były: cyrkiel, globus gwiezdny (model sfery niebieskiej), pałeczka służącą do wskazywania czegoś na globusie (wskaźnik) i wieniec z gwiazd."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d6bd74d3-04f5-32b7-aab5-3027b94bc97e",
                                        "entry_id": "f62d10b0-b3c7-3b2b-a214-5f83fcb3586f",
                                        "glosses": [
                                            "jedna z okeanid"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "b6acf565-abb0-3a38-835b-223198e8e931",
