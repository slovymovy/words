                        "examples": [
                            {
                                "example_id": "40f4889f-8af3-441d-88a8-d3f6baa64cbd",
                                "sense_id": "cf5cc954-a007-333d-9fdb-a71564c40133",
                                "text": "In 2006 riep Grossman de Israëlische regering samen met medeschrijver Amos Oz op om de oorlog in Libanon te beëindigen. Twee dagen later kwam een van zijn zoons om in diezelfde oorlog door een antitankraket. Die ervaring werd onderdeel van zijn boek Een vrouw op de vlucht voor een bericht, waarin een Israëlische moeder haar zoon aan het front verliest. Hij schreef ook het boek Uit de tijd vallen over het verlies van zijn zoon."
                            },
                            {
                                "example_id": "02090e08-6f80-423f-af54-e24811917466",
                                "sense_id": "cf5cc954-a007-333d-9fdb-a71564c40133",
                                "text": "Zeker zes Oekraïense militairen zijn vanochtend in het oosten van het land omgekomen. Vier doden vielen toen hun voertuig werd geraakt door een antitankraket van de opstandelingen, zeggen de Oekraïense autoriteiten. Later sneuvelden nog eens twee militairen toen ze op een landmijn reden. Zaterdag waren ook drie militairen omgekomen door een landmijn."
                            }
                        ]
                    }
