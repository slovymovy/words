                    }
                ],
                "senses": [
                    {
                        "sense_id": "6aaaf77f-e645-3757-8ebb-2b4d21de349c",
                        "entry_id": "2b634842-001d-3514-9d5a-0a80d4d47f28",
                        "glosses": [
                            "een metalen slagwerkinstrument bestaande uit een ronde, iets gekromde metalen schijf die, afhankelijk van het gebruik, in het midden opgehangen is in een standaard of met een koord of riem wordt vastgehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1f44c7d-b6c2-4a05-b105-1dfaf43019bc",
                                "sense_id": "6aaaf77f-e645-3757-8ebb-2b4d21de349c",
                                "text": "In de jaren vijftig begon Kakehashi als reparateur van elektronische orgels. Zijn kennis van het binnenwerk van Hammondorgels stelde hem in staat een losstaande drumcomputer te ontwikkelen waarmee trommels, cimbalen en andere percussie-elementen geprogrammeerd konden worden. In 1967 vond hij de Rhythm Ace-computer uit, die in meer dan honderd steeds beter programmeerbare versies op de markt kwam. In 1970 stichtte hij het bedrijf Roland dat behalve door synthesizers, samplers, sequencers en workstations bovenal bekend werd door de gebruiksvriendelijke drummachine TR-808."
                            },
                            {
                                "example_id": "85297b74-8875-433c-a260-63214a416151",
                                "sense_id": "6aaaf77f-e645-3757-8ebb-2b4d21de349c",
                                "text": "Ook een goede vondst: de percussionist die de muziek voorzag van hoorspelachtige geluidseffecten en zijn slagwerk bij het onweer in de tweede akte zo virtuoos liet donderen dat zijn cimbaal als een hoosbui op het podium kletterde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a772f4-7c0d-4f66-b0ad-894d02a6b3bf",
                        "source_entry_id": "2b634842-001d-3514-9d5a-0a80d4d47f28",
                        "source_sense_id": "6aaaf77f-e645-3757-8ebb-2b4d21de349c",
                        "source_sense_description": "een metalen slagwerkinstrument bestaande uit een ronde schijf",
                        "target_lang_word": "cymbal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cymbal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                        "entry_id": "96d170b4-f728-34ea-aefc-c91ecebe4039",
                                        "glosses": [
                                            "A concave plate of metal, usually brass or bronze, that produces a sharp, ringing sound when struck: played either in pairs, by striking them together, or singly by striking with a drumstick or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43996ce2-a885-46b6-85e3-e234dd16fc28",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "The trumpets, sackbuts, psalteries and fifes,\nTabours and cymbals and the shouting Romans,\nMake the sun dance."
                                            },
                                            {
                                                "example_id": "7be745e3-b5f3-44ac-9305-8f38e28c7c1c",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "Though I speak with the tongues of men and of angels, and have not charity, I am become as sounding brass, or a tinkling cymbal."
                                            },
                                            {
                                                "example_id": "f6e5d0d6-2f25-42bd-94a3-8ef40533a59b",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "Trumpets and Drums shall fright her from the Throne,\nAs sounding Cymbals aid the lab'ring Moon."
                                            },
                                            {
                                                "example_id": "690eac1e-c7ae-49b7-96fa-8182caa15e44",
                                                "sense_id": "32b07db3-4af4-3aa3-bc7b-27c4af22bdfa",
                                                "text": "I see the Crusaders' tumultuous armies—hark, how the cymbals clang […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
