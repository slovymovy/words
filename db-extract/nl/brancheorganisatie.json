                        "examples": [
                            {
                                "example_id": "25557c7f-8f54-43fc-bd77-8639c886a706",
                                "sense_id": "1a1f6111-1748-358a-a32d-c64366f05c40",
                                "text": "De brancheorganisatie is het eerste aanspreekpunt voor de overheid om te communiceren met bedrijven."
                            },
                            {
                                "example_id": "cc36350d-8bed-4142-9042-da4ca57278c2",
                                "sense_id": "1a1f6111-1748-358a-a32d-c64366f05c40",
                                "text": "Webwinkels zijn het beu dat een deel van de klanten kleding en andere spullen gebruikt om het vervolgens retour te sturen. Ze starten samen met brancheorganisatie Thuiswinkel.org een proef met labels die aan producten worden bevestigd. Alleen als het label nog aan het product zit, mag het binnen 14 dagen worden teruggestuurd en kunnen klanten het volledige bedrag terugkrijgen."
                            },
                            {
                                "example_id": "50cb6eee-8b48-4826-a0d1-b7dc57ad05ed",
                                "sense_id": "1a1f6111-1748-358a-a32d-c64366f05c40",
                                "text": "Nederlandse bioscopen hebben gisteren hun beste dag gehad sinds het begin van de coronapandemie twee jaar geleden. Op Eerste Pinksterdag gingen 189.263 mensen naar de film, meldt brancheorganisatie NVBF."
                            }
                        ]
