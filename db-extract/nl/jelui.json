        "nl-extract.jsonl": [
            {
                "entry_id": "90552433-a8c2-39f4-884c-93c70ff9b337",
                "word": "jelui",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a2bc5e2-cb38-3700-a5d8-7db90fdd4dcf",
                        "entry_id": "90552433-a8c2-39f4-884c-93c70ff9b337",
                        "glosses": [
                            "nominatief (onderwerp) met werkwoordsvorm op -t"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30956bfe-4167-4513-9737-1b801018150f",
                                "sense_id": "4a2bc5e2-cb38-3700-a5d8-7db90fdd4dcf",
                                "text": "Jelui zult toch niets aan mij hebben (…)"
                            },
                            {
                                "example_id": "b9add37f-15c4-471f-9eb2-b6bdf32b3e21",
                                "sense_id": "4a2bc5e2-cb38-3700-a5d8-7db90fdd4dcf",
                                "text": "Moet jelui ze niet zoeken dan?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ab388462-f9b4-307b-9c9e-4149fab6f6b1",
                        "entry_id": "90552433-a8c2-39f4-884c-93c70ff9b337",
                        "glosses": [
                            "nominatief (onderwerp) met werkwoordsvorm op -n"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ecd8bc4-db55-4b88-b2e3-24db8a0751a1",
                                "sense_id": "ab388462-f9b4-307b-9c9e-4149fab6f6b1",
                                "text": "Jelui zijn niet in de kampong!"
                            },
                            {
                                "example_id": "03a51d8b-9e22-4d37-970b-588bff164bde",
                                "sense_id": "ab388462-f9b4-307b-9c9e-4149fab6f6b1",
                                "text": "Jelui kunnen dat niet zoo voelen als ik (…)"
                            },
                            {
                                "example_id": "bfe7bda1-adc2-4c98-9e1b-19cd907e88b1",
                                "sense_id": "ab388462-f9b4-307b-9c9e-4149fab6f6b1",
                                "text": "Konden jelui in Australië aarden?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f73a0dd3-da25-362a-b2e1-7f04d404bece",
                        "entry_id": "90552433-a8c2-39f4-884c-93c70ff9b337",
                        "glosses": [
                            "datief (meewerkend voorwerp)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "587a09d1-25ad-43f6-89cf-a03af6aa9522",
                                "sense_id": "f73a0dd3-da25-362a-b2e1-7f04d404bece",
                                "text": "‘Nou, tot ziens, het beste,’ zei hij op besliste toon, ‘het ga jelui goed.’"
                            },
                            {
                                "example_id": "448c1243-6f19-4e94-a32e-77a47ec93f2a",
                                "sense_id": "f73a0dd3-da25-362a-b2e1-7f04d404bece",
                                "text": "Ik kom er goed af van avond, ik heb maar eenige Bladvullingen, die ik jelui gaauw zal voordreunen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c88e3d4b-f881-39cd-bf64-6be081be4dd1",
                        "entry_id": "90552433-a8c2-39f4-884c-93c70ff9b337",
                        "glosses": [
                            "accusatief (lijdend voorwerp)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef8697c-c949-4dc3-9ad6-d16be3f39cc8",
                                "sense_id": "c88e3d4b-f881-39cd-bf64-6be081be4dd1",
                                "text": "Ofschoon ik van plan ben, jelui Zaterdagmiddag te komen opzoeken, en je dan wel mijn wedervaren van de heele week zal vertellen, wil ik je nu toch maar even 'n briefje schrijven (…)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
