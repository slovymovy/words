{
    "word_family": [
        "internally",
        "internalize",
        "internalization",
        "internality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dda64223-5e16-3d80-8a9e-2c34dff44786",
                    "sense_definition": "Situated on the inside or within something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_inside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>internal</w> structure of the building was damaged by the fire.",
                            "target_lang_translations": {
                                "ru": "<w>Внутренняя</w> структура здания была повреждена пожаром.",
                                "zh": "大火损坏了建筑的<w>内部</w>结构。"
                            }
                        },
                        {
                            "text": "We need to examine the <w>internal</w> parts of the machine to find the problem.",
                            "target_lang_translations": {
                                "ru": "Нам нужно осмотреть <w>внутренние</w> части машины, чтобы найти проблему.",
                                "zh": "我们需要检查机器的<w>内部</w>零件以找出问题所在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interior",
                        "inner",
                        "inside"
                    ],
                    "antonyms": [
                        "external",
                        "exterior"
                    ],
                    "common_phrases": [
                        "internal structure",
                        "internal mechanism",
                        "internal walls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся внутри чего-либо или в пределах какого-либо пространства.",
                        "zh": "位于某物内部或范围之内的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "расположенный внутри объекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部的",
                                "target_lang_sense_clarification": "位于物体内部的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c139c9e-f90f-338e-a751-16d95b3b1199",
                    "sense_definition": "Located or occurring within the body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "biological_inside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver suffered severe <w>internal</w> bleeding after the accident.",
                            "target_lang_translations": {
                                "ru": "После аварии у водителя открылось сильное <w>внутреннее</w> кровотечение.",
                                "zh": "事故发生后，司机出现了严重的<w>体内</w>出血。"
                            }
                        },
                        {
                            "text": "Doctors are concerned about damage to his <w>internal</w> organs.",
                            "target_lang_translations": {
                                "ru": "Врачи обеспокоены повреждением его <w>внутренних</w> органов.",
                                "zh": "医生们很担心他受损的<w>内脏</w>器官。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inner"
                    ],
                    "antonyms": [
                        "external"
                    ],
                    "common_phrases": [
                        "internal bleeding",
                        "internal organs",
                        "internal medicine",
                        "internal injury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся или происходящий внутри организма.",
                        "zh": "位于身体内部或发生在身体内部的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "относящийся к органам тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体内的",
                                "target_lang_sense_clarification": "涉及身体器官或生理机能的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f90b8c6-0fb5-33ff-8e2d-ec3e74062ccf",
                    "sense_definition": "Relating to the private or non-public affairs of an organization or company.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "organizational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This document is for <w>internal</w> use only and should not be shared.",
                            "target_lang_translations": {
                                "ru": "Этот документ предназначен только для <w>внутреннего</w> пользования и не подлежит распространению.",
                                "zh": "此文件仅供<w>内部</w>使用，不得外传。"
                            }
                        },
                        {
                            "text": "The company conducted an <w>internal</w> investigation into the error.",
                            "target_lang_translations": {
                                "ru": "Компания провела <w>внутреннее</w> расследование ошибки.",
                                "zh": "公司针对该错误进行了<w>内部</w>调查。"
                            }
                        }
                    ],
                    "antonyms": [
                        "external"
                    ],
                    "common_phrases": [
                        "internal audit",
                        "internal use",
                        "internal memo",
                        "internal review"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к частным или непубличным делам организации или компании.",
                        "zh": "与组织或公司的私下或非公开事务有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "корпоративный, служебный"
