    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9706a988-295b-39c9-b9c7-eadfdf52f1d4",
                    "sense_definition": "Een juridische procedure of rechtszaak officieel in gang zetten tegen iemand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als u niet op tijd betaalt, moet het bedrijf een rechtszaak tegen u <w>aanspannen</w>. ",
                            "target_lang_translations": {
                                "en": "If you do not pay on time, the company will have to <w>bring</w> a lawsuit against you."
                            }
                        },
                        {
                            "text": "De gedupeerde burgers <w>spanden</w> gezamenlijk een kort geding <w>aan</w> tegen de gemeente.",
                            "target_lang_translations": {
                                "en": "The affected citizens jointly <w>instituted</w> summary proceedings against the municipality."
                            }
                        }
                    ],
                    "synonyms": [
                        "inleiden",
                        "starten"
                    ],
                    "antonyms": [
                        "intrekken",
                        "staken"
                    ],
                    "common_phrases": [
                        "een rechtszaak aanspannen",
                        "een proces aanspannen",
                        "een geding aanspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially initiate a legal proceeding or lawsuit against someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring",
                                "target_lang_sense_clarification": "legal action or lawsuit"
                            },
                            {
                                "target_lang_word": "institute",
                                "target_lang_sense_clarification": "legal proceedings"
                            },
                            {
                                "target_lang_word": "file",
                                "target_lang_sense_clarification": "a lawsuit or case"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "017103a1-99c6-32b4-a825-ae6c0233a5b6",
                    "sense_definition": "Strakker trekken of onder verhoogde spanning brengen van bijvoorbeeld touwen of spieren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je buikspieren goed <w>aanspannen</w> tijdens het uitvoeren van deze zware oefening.",
                            "target_lang_translations": {
                                "en": "You need to properly <w>tense</w> your abdominal muscles while performing this heavy exercise."
                            }
                        },
                        {
                            "text": "Toen het hard begon te waaien, moesten we de scheerlijnen van de tent stevig <w>aanspannen</w>.",
                            "target_lang_translations": {
                                "en": "When the wind picked up, we had to <w>tighten</w> the tent guy lines securely."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantrekken",
                        "aantrekken",
                        "strakker trekken"
                    ],
                    "antonyms": [
                        "ontspannen",
                        "verlappen"
                    ],
                    "common_phrases": [
                        "de spieren aanspannen",
                        "de touwen aanspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pull tighter or put under tension, such as ropes or muscles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tighten",
                                "target_lang_sense_clarification": "ropes, straps, or muscles"
                            },
                            {
                                "target_lang_word": "tense",
                                "target_lang_sense_clarification": "muscles"
                            },
                            {
                                "target_lang_word": "flex",
                                "target_lang_sense_clarification": "muscles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab52f763-d7f6-3340-a98a-0916a88cd903",
                    "sense_definition": "Trekdieren met een tuig vastmaken voor een voertuig zoals een wagen of ploeg.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer <w>spande</w> de paarden <w>aan</w> voor de oude houten kar.",
                            "target_lang_translations": {
                                "en": "The farmer <w>hitched</w> the horses to the old wooden cart."
                            }
                        },
                        {
                            "text": "Voordat we kunnen vertrekken naar het veld, moeten we de ossen nog <w>aanspannen</w>.",
                            "target_lang_translations": {
                                "en": "Before we can leave for the field, we still have to <w>harness</w> the oxen."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorspannen",
                        "inkarren"
                    ],
                    "antonyms": [
                        "uitspannen"
                    ],
                    "common_phrases": [
                        "paarden aanspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "To harness draft animals to a vehicle such as a cart or plough."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harness",
                                "target_lang_sense_clarification": "draft animals to a wagon or plow"
                            },
                            {
                                "target_lang_word": "hitch",
                                "target_lang_sense_clarification": "animals to a vehicle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
