                {
                    "sense_id": "12f21a83-375b-35af-82f6-89d7984b1c5f",
                    "sense_definition": "A device used for cleaning or inspecting the inside of an oil or gas pipeline.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer sent a <w>pig</w> through the pipeline to clear the blockage.",
                            "target_lang_translations": {
                                "ru": "Инженер запустил <w>скребок</w> по трубопроводу, чтобы устранить засор.",
