                "senses": [
                    {
                        "sense_id": "1591c7dc-a574-36bf-a953-591c5097e6e6",
                        "entry_id": "4bf685a8-2c5c-3aa0-b8f2-3947e4c06d35",
                        "glosses": [
                            "Gestank, der durch Verwesungsprozesse verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c26f4c9-d61b-491d-8e9b-aed376a3e3b3",
                                "sense_id": "1591c7dc-a574-36bf-a953-591c5097e6e6",
                                "text": "„Bald wurden es unglaublich viele, sie ähnelten gottlosen Katakomben namenloser Bedrohungen; und ihr beißender Verwesungsgestank wurde nahezu unerträglich.“"
                            },
                            {
                                "example_id": "5ea8be40-4f04-4c12-bc86-01d9c84727df",
                                "sense_id": "1591c7dc-a574-36bf-a953-591c5097e6e6",
                                "text": "„Modriger Verwesungsgestank wehte Lamb entgegen und raubte ihm den Atem.“"
                            },
                            {
                                "example_id": "aa047552-8945-4080-974b-6df1d83bb5f3",
                                "sense_id": "1591c7dc-a574-36bf-a953-591c5097e6e6",
                                "text": "„Wenn er sich einem von ihnen näherte, gaben die Flecken nicht nur ein schwaches Leuchten von sich, sondern einen penetranten Verwesungsgestank.“"
                            },
                            {
                                "example_id": "9cc30986-0f55-42b5-95a9-946794ff604f",
                                "sense_id": "1591c7dc-a574-36bf-a953-591c5097e6e6",
                                "text": "„Ein ekelerregender Verwesungsgestank begann sich im Tunnel auszubreiten.“"
                            },
                            {
                                "example_id": "dc32d4cc-8664-4737-bc77-081a9df8e694",
                                "sense_id": "1591c7dc-a574-36bf-a953-591c5097e6e6",
                                "text": "„Sie war es, die den Geruch verbreitete - einen Geruch, der zwar beispiellos widerlich, aber dennoch kein Verwesungsgestank war, sondern an die Ausdünstung irgendeines ekelhaften und unreinen Sumpfgeschöpfes erinnerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
