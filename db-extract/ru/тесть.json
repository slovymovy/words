                                        "examples": [
                                            {
                                                "example_id": "24f46e23-433c-4c0f-b04a-60346467dbbe",
                                                "sense_id": "f1298106-8a5f-3302-a02c-b0c1654c1479",
                                                "text": "Můj tchán se nabídl, že nám pomůže s opravou domu."
