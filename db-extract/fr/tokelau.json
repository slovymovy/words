                        "target_lang_word": "Tokelau-eilanden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tokelau-eilanden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10249513-0f49-3d46-a743-994cffaf5422",
                                        "entry_id": "d1c4d168-d9da-3284-a226-01cd72aab7d6",
                                        "glosses": [
                                            "eilandengroep bestaande uit drie atollen met een gezamenlijke oppervlakte van 10 km² in het zuiden van de Stille Oceaan\\nDe eilanden liggen ten noorden van de Samoa-eilanden (Samoa en Amerikaans-Samoa), ten oosten van Tuvalu, ten zuiden van de Phoenixeilanden, die tot Kiribati behoren, en ten noordwesten van de Cookeilanden."
                                        ],
                                        "tags": [
                                            "toponiem: eiland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d989bd7-8b56-488f-859a-123975bf9286",
                                                "sense_id": "10249513-0f49-3d46-a743-994cffaf5422",
                                                "text": "De jongens waren begin oktober bij de Tokelau-eilanden in Nieuw-Zeeland met een speedbootje de zee opgegaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da1373a-333d-3063-b7c5-d6ffb52e5c91",
                                        "entry_id": "d1c4d168-d9da-3284-a226-01cd72aab7d6",
                                        "glosses": [
                                            "overzees gebiedsdeel van Nieuw-Zeeland, volgens ISO-norm ISO 3166-1 aangeduid met de driecijferige landcode: 772, de drieletterige landcode: TKL en de tweeletterige landcode: TK"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd64abc-4f27-4748-9b96-e774fc7ce5aa",
                                                "sense_id": "5da1373a-333d-3063-b7c5-d6ffb52e5c91",
                                                "text": "De Tokelau-eilanden zullen als eerste natie ter wereld volledig overschakelen op zonne-energie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
