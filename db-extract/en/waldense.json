                        "source_sense_id": "b9f4531f-9610-3c5d-95fd-22409045b188",
                        "source_sense_description": "member of a sect of dissenters",
                        "target_lang_word": "Waldenser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
