                    {
                        "sense_id": "6f23f704-6df3-34e3-8077-dc1eca3d404a",
                        "entry_id": "ca5f3090-0216-3b02-b413-5ed6cbe0f364",
                        "glosses": [
                            "Angehöriger der gleichnamigen hellenistischen Dynastie in Vorderasien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd28366-8421-423d-bd3f-79965f8dacd9",
                                "sense_id": "6f23f704-6df3-34e3-8077-dc1eca3d404a",
                                "text": "„Neben den Werken des Flavius Josephus sind es hier für die Ära der Seleukiden (200-141 v.Chr.) und der gegen sie rebellierenden jüdischen Hasmonäer (167-37 v.Chr.) hauptsächlich die apokryphen Makkabäer-Bücher, die schildern, wie die Hellenisierung der jüdischen Gesellschaft zunehmend auch auf den Tempelkult übergriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
