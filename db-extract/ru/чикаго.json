                                    {
                                        "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                        "entry_id": "6c6ce34a-03b2-3b9b-8f3c-af23e356dd24",
                                        "glosses": [
                                            "A large city, the county seat of Cook County, in northeastern Illinois, United States, located on Lake Michigan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f03761-8f65-4043-89e7-e43a84280e29",
                                                "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                                "text": "I am an American, Chicago born—Chicago, that somber city—and go at things as I have taught myself, free-style, and will make the record in my own way: first to knock, first admitted; sometimes an innocent knock, sometimes a not so innocent."
                                            },
                                            {
                                                "example_id": "13fbf256-acdb-45a2-b6fd-a2e3d734d937",
                                                "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                                "text": "Chicago is now #1 in murder and sausages. That sounds like my kind of town!"
                                            },
                                            {
                                                "example_id": "c5c3bfc7-186e-42fa-8a63-4a53c8a6d1b3",
                                                "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                                "text": "Homan, who was on the ground in Chicago, maintained it was a “criminal operation.” Acting Deputy Attorney General Emil Bove was also in Chicago on Sunday to observe immigration enforcement operations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
