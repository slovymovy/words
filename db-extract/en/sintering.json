                                        "glosses": [
                                            "Procédé de fabrication de pièces consistant à chauffer une poudre sans la mener jusqu’à la fusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d7de84-9749-4b8e-aedd-91b6c077fdc2",
                                                "sense_id": "22f55e84-662e-339b-834d-c0b82dc18b0d",
                                                "text": "Ce frittage peut être réalisé sur des xérogels à liaisons covalentes, de silice ou de silice-alumine par exemple, lors d’une calcination dans l’air sec."
                                            }
                                        ]
