                                        "entry_id": "f4ad982a-cd42-358b-abef-d7826fb86d63",
                                        "glosses": [
                                            "eine für viele griechische Städte in der Antike typische burgähnliche Anlage, meist auf einem Hügel, oberhalb der Unterstadt gelegen"
                                        ],
                                        "tags": [
                                            "im weitesten Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb4ba0b-23e9-42fd-96fe-1f43a84ed49a",
                                                "sense_id": "6d9fbe39-16fe-3028-811e-6e9dfffffc23",
                                                "text": "„…zeichnet sich erst für die Mittlere Bronzezeit eine neuerliche dichte Besiedlung des attischen Landes ab. Vor allem entstehen jetzt zahlreiche befestigte Akropolen lokaler Fürsten in ausgeprägten Sicherheitslagen.“"
                                            },
                                            {
                                                "example_id": "228b8542-c861-4d29-9350-3eb3961316b5",
                                                "sense_id": "6d9fbe39-16fe-3028-811e-6e9dfffffc23",
                                                "text": "„Die Akropolis von Mykene mit ihrem Befestigungswall, dem Löwentor und dem intramuralen Rundgrab ist ein Paradebeispiel dieser Epoche […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf647055-75a7-361c-a234-c6ddff98d874",
                                        "entry_id": "f4ad982a-cd42-358b-abef-d7826fb86d63",
                                        "glosses": [
                                            "Akropolis von Athen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5f006d-d53b-4cde-b0da-377c1681ce4d",
                                                "sense_id": "bf647055-75a7-361c-a234-c6ddff98d874",
                                                "text": "„Die über der Stadt [Athen] thronende Akropolis mit dem ionischen Parthenon blickt auf eine wuchernde, moderne, kosmopolitische Großstadt in neuem Wohlstand.“"
                                            }
                                        ],
