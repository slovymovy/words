                        "glosses": [
                            "sportclub waar hockeyers lid van zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09de97c0-992e-4dd7-b95e-9735c5db09e9",
                                "sense_id": "502c050a-d690-3027-b737-defb77cd609a",
                                "text": "Bij de hockeyvereniging waar het model speelde, zijn de leden een geldinzamelingsactie begonnen. Ze willen hiermee de ouders steunen bij onvoorziene kosten die niet door de verzekering worden betaald."
                            },
                            {
                                "example_id": "7c529159-6c5f-45e9-b21f-26b30426e342",
                                "sense_id": "502c050a-d690-3027-b737-defb77cd609a",
                                "text": "Het verhaal wordt al meteen nog mooier. Op zoek naar een leuke sportclub voor haar zoons bezocht zijn moeder ooit de plaatselijke voetbalclub, maar bekroop haar een slecht gevoel. Op de terugweg gingen ze toch ook even bij de hockeyvereniging kijken."
                            }
                        ]
                    }
