                "forms": [
                    {
                        "form_id": "d80aef01-0db3-41fe-a310-3bc1824cbb9e",
                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                        "tags": [
                            "plural"
                        ],
                        "form": "eyewashes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75607de5-98a7-3285-a574-d3668d4e0e0d",
                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                        "glosses": [
                            "The washing out of the eyes with copious solution (usually water alone) to quickly remove an irritant, as for example in laboratories and industrial plants; the washing solution itself."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fd56a898-2483-4ae9-abce-d5e5af203555",
                                "sense_id": "75607de5-98a7-3285-a574-d3668d4e0e0d",
                                "text": "an eyewash station on every floor of the building"
                            },
                            {
                                "example_id": "4d6c2064-b32e-4d57-85a2-6c3e82f4e286",
                                "sense_id": "75607de5-98a7-3285-a574-d3668d4e0e0d",
                                "text": "a bottle of eyewash"
                            }
                        ]
                    },
                    {
                        "sense_id": "97d67b81-c934-328f-a803-0b5352724e7f",
                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                        "glosses": [
                            "A soothing medicated lotion for the eyes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a10b4a28-7568-3ad6-8be2-3702693dbe32",
                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                        "glosses": [
                            "Camouflage; disguise; false front; pretense; nonsense."
                        ],
                        "tags": [
                            "figuratively",
                            "slang",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "83ec5f6b-ff88-46dd-bad8-9b541369248c",
                                "sense_id": "a10b4a28-7568-3ad6-8be2-3702693dbe32",
                                "text": "Near-synonyms: whitewash, window dressing"
                            },
                            {
                                "example_id": "3f707ee2-5b43-4834-a36a-05c23fe2df26",
                                "sense_id": "a10b4a28-7568-3ad6-8be2-3702693dbe32",
                                "text": "Talking of being eaten by dogs, there's a dachshund at Brinkley who when you first meet him will give you the impression that he plans to convert you into a light snack between his regular meals. Pay no attention. It's all eyewash. […] He wouldn't hurt a fly, but he has to put up a front because his name's Poppet. One can readily appreciate that when a dog hears himself addressed day in and day out as Poppet, he feels he must throw his weight about. His self-respect demands it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbefb0aa-e4c5-420a-8d68-a793dd3831fe",
                        "source_entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                        "source_sense_description": "lotion",
                        "target_lang_word": "collyre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "778f5cc5-dd1f-33cd-a074-51fd2533fda7",
                                        "entry_id": "43f599f1-1e73-33a1-bcd0-42645404ec73",
                                        "glosses": [
                                            "Médicament sous la forme d’un liquide, d’une solution ou suspension stérile, aqueuse ou huileuse. Gouttes ophtalmiques destinées à l'instillation oculaire."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50b0676-808d-4570-977d-75a3affbe9f5",
                                                "sense_id": "778f5cc5-dd1f-33cd-a074-51fd2533fda7",
                                                "text": "Nitrate d'Argent.— Médicament employé comme antiseptique cautérisant sous forme de crayon (pierre infernale) et de collyre à 10 centigr. pour 100 gr. d'eau dans les maladies des yeux ; […]."
                                            },
                                            {
                                                "example_id": "340cf4d1-8160-4522-b8b4-d52d1b2f2bea",
                                                "sense_id": "778f5cc5-dd1f-33cd-a074-51fd2533fda7",
                                                "text": "Ou bien l’envie subite la prendra de faire une toilette complète à son enfant, de le peigner, de lui enduire les yeux de collyre, afin de le présenter dans cet état à son amant."
                                            },
                                            {
                                                "example_id": "2e629253-19a8-439b-b793-ae550992dfa0",
                                                "sense_id": "778f5cc5-dd1f-33cd-a074-51fd2533fda7",
                                                "text": "Quelques observations d’empoisonnement à la suite d'injection vaginales avec de l’eau de Goulard, de l'usage de collyres à base de plomb, montrent que l'absorption se fait par les diverses muqueuses."
                                            },
                                            {
                                                "example_id": "eac9b438-3c8d-4948-9812-b07451977af2",
                                                "sense_id": "778f5cc5-dd1f-33cd-a074-51fd2533fda7",
                                                "text": "Ces médicaments sont vendus sous la forme, de gouttes ou de poudres appelés collyres . Mettez-en plusieurs fois par jour parce que les larmes les diluent et les font assez vite ressortir de l’œil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91657151-ffa1-40df-9295-5bed0ffb29f5",
                        "source_entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                        "source_sense_description": "means of creating deceptive impression",
                        "target_lang_word": "очковтира́тельство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "очковтира́тельство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fb063cbc-6a80-3be8-b1fd-f77d39b21aae",
                                        "entry_id": "5d3f36a0-0707-3266-b80a-be818089af0a",
                                        "glosses": [
                                            "разг. намеренный обман с целью представить что-либо в более выгодном свете, чем есть на самом деле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "993b9b4b-9d8d-4298-ac74-7a181e7af500",
                                                "sense_id": "fb063cbc-6a80-3be8-b1fd-f77d39b21aae",
                                                "text": "— Только, пожалуйста, без буянства, — предусмотрительно подчеркнул Волька. — И без очковтирательства. То есть без обмана."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
