                        ],
                        "examples": [
                            {
                                "example_id": "5d86b96b-4531-425a-b0b4-68cf00bd4de9",
                                "sense_id": "24a61451-47bc-3ae1-be22-0f565233e462",
                                "text": "...to treat the metal with nitro-hydrochloric acid, evaporate to dryness, redigest with hydrochloric acid, and then precipitate the filtered solution..."
                            },
                            {
                                "example_id": "90aa9e8e-3fe0-4f42-bc2c-4080c829c6e5",
                                "sense_id": "24a61451-47bc-3ae1-be22-0f565233e462",
                                "text": "...but the professors had not digested their knowledge with practical execution in mind, with the result that my boy is having to redigest it."
                            },
                            {
                                "example_id": "683d2721-6d4b-4521-8a72-a267b7c49795",
                                "sense_id": "24a61451-47bc-3ae1-be22-0f565233e462",
                                "text": "The ability of ruminants to rework their feed and continually redigest it enables them to gain more nourishment..."
