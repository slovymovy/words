                "senses": [
                    {
                        "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                        "glosses": [
                            "A mixture of fine solid particles or liquid droplets suspended in a gaseous medium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5587d8ab-fe60-4b7c-8d19-a45ef50b5701",
                                "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                                "text": "Examples of common aerosols are mist, fog, and smoke."
                            },
                            {
                                "example_id": "b6fcaade-a97f-4615-984d-4f601bb78d97",
                                "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                                "text": "The entire side of the barge chases itself inward, like the steel has become liquid and is running down a deain, and the metal turns bright as shock waves simply turn that thick layer of rust into an aerosol, blast it free from the steel borne on a wave of sound so powerful that it hurts Hiro down inside his chest and makes him feel sick."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1d306f4-534c-312e-8055-d10d9ab44bd0",
                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                        "glosses": [
                            "An aerosol can."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a877cc48-7ce7-3778-bfb2-62897ae4d14b",
                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                        "glosses": [
                            "The payload (e.g. insecticide, paint, oil, cosmetics) and propellant contained by an aerosol can."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "920f0093-781f-3f22-a9a6-4ab29418947a",
                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                        "glosses": [
                            "A colloidal system in which the dispersed phase is composed of either solid or liquid particles and in which the dispersal medium is some gas, usually air."
                        ],
                        "tags": [],
                        "examples": []
                    }
