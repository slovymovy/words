                        }
                    ]
                },
                {
                    "sense_id": "2eb76707-569b-3998-beb5-42151c5bda80",
                    "sense_definition": "Exclamation familière pour souligner l'évidence d'une situation ou reprocher à quelqu'un son manque d'attention ou de bon sens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "interpellation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Allô</w>, vous n'allez tout de même pas partir en randonnée sans chaussures adaptées !"
                        },
                        {
                            "text": "Elle a refusé cette opportunité magnifique, non mais <w>allô</w>, à quoi pensait-elle ?"
