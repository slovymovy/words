                "senses": [
                    {
                        "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                        "entry_id": "83c547da-b088-3250-963e-6be2598ccd33",
                        "glosses": [
                            "действие по значению гл. подскочить; небольшой скачок вверх"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d797d4-3c80-4154-a47a-0ad4d93563c5",
                                "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                "text": "Анисим тоже сел с подскоком и подбоченился, так как считал себя красивым."
                            },
                            {
                                "example_id": "98719c3f-dd44-4070-835a-b6adf88c6b2a",
                                "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                "text": "Этим летчиком оказался Стефановский. Он начал с того же, что и его предшественник: с пробежек, подскоков, подлётов."
                            },
                            {
                                "example_id": "599207e2-2cb7-4ad2-81c7-d68c3cdb6c14",
                                "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                "text": "Я подготавливаю таблетку на случай подскока давления; нитроглицерин, конечно, тоже."
                            }
                        ]
                    }
                ],
