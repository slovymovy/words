                        "form": "die Allerheiligen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                        "entry_id": "3d4851d2-f8d0-3362-ac30-bc45cdcbae63",
                        "glosses": [
                            "Gedenktag zu allen Heiligen; in Österreich und teilweise in Deutschland sowie der Schweiz gesetzlich anerkannter Feiertag am 1. November; römisch-katholisches Hochfest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1c0bb2-9b34-4d7c-9c85-e5a2caeed6a4",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "Am 1. November ist Allerheiligen."
                            },
                            {
                                "example_id": "66367721-f8db-48d8-80c2-0957904f93e8",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "In der Kirche wird an Allerheiligen aller Heiligen gedacht."
                            },
                            {
                                "example_id": "5a84c680-0369-47dc-8f3a-0f0fc7b78221",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "Der Tag nach Allerheiligen ist Allerseelen."
                            },
                            {
                                "example_id": "4f8d97c4-5126-45d1-9166-915d45306899",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "Allerheiligen wird in der westlichen Kirche am 1. November begangen, in den orthodoxen Kirchen am ersten Sonntag nach Pfingsten."
                            },
                            {
                                "example_id": "fcd11806-b7b6-4a1c-821f-adcacee0fd9f",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "Auch Anglikaner und manche protestantische Gemeinschaften feiern Allerheiligen."
                            },
                            {
                                "example_id": "d6b218d9-8903-4382-a6b1-edb436788aa7",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "„Allerhand Flugblätter wurden verteilt, an Allerheiligen war der Besuch der nationalen Gedenkstätten größer als in früheren Jahren.“"
                            },
                            {
                                "example_id": "e90ec2df-bc24-4668-b308-0b55a3aebd60",
                                "sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                                "text": "„Allerheiligen hatte ich die Messe gehört und wollte gerade eine Gondel besteigen, um nach Venedig zurückzukehren; da begegnete mir eine Frau nach Lauras Art, die einen Brief zu meinen Füßen fallen ließ und weiterging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6764570c-4950-40ce-acfc-3ecbea8334a4",
                        "source_entry_id": "3d4851d2-f8d0-3362-ac30-bc45cdcbae63",
                        "source_sense_id": "477495ec-2ccc-3579-a722-592288796a16",
                        "source_sense_description": "Christentum: Gedenktag zu allen Heiligen",
                        "target_lang_word": "All Hallows",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "All Hallows",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "265fe2a5-840c-3945-8301-cd79ca53d7b7",
                                        "entry_id": "30f40c7c-6221-33d6-8102-cd2100b52fa4",
                                        "glosses": [
                                            "The saints, taken collectively."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bafc4b3c-2ce2-4270-85ec-9f8be560e824",
                                                "sense_id": "265fe2a5-840c-3945-8301-cd79ca53d7b7",
                                                "text": "There should be four Reveals that year, and no more; one at the feast of All hallown, another at the feast of St. Erkenwald."
                                            },
                                            {
                                                "example_id": "2bf88894-c2b1-4ead-b3f5-fc336169bbf2",
                                                "sense_id": "265fe2a5-840c-3945-8301-cd79ca53d7b7",
                                                "text": "In this parish were, anciently, two Chantries; one situated in Edlesborough, and dedicated to St. Mary; 1 and the other in the Hamlet of Dagnall, dedicated to All Hallows [...]."
                                            },
                                            {
                                                "example_id": "563ae101-3636-4a4a-ae71-18458c93f998",
                                                "sense_id": "265fe2a5-840c-3945-8301-cd79ca53d7b7",
                                                "text": "I swear by All-hallows that I will not let any have it to hire, nor will I sell it, since thou hast made it holy by dwelling therein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c4504d-2370-30b0-ad7c-0134c2565f3d",
                                        "entry_id": "30f40c7c-6221-33d6-8102-cd2100b52fa4",
                                        "glosses": [
                                            "All Saints' Day, the 1st of November; the Christian feast day honoring all Christian saints."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
