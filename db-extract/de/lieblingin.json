                ],
                "senses": [
                    {
                        "sense_id": "9cdba37f-2397-3247-9e7c-5a31fa100ced",
                        "entry_id": "f36f4284-c4b7-3092-bb80-895c24c14bba",
                        "glosses": [
                            "veraltet, auch früher wohl selten: Kosename (Anrede) für einen geliebten (weiblichen) Menschen, aber auch für ein bestimmtes, besonders geliebtes weibliches Tier"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1928d68c-4ef1-341c-b4d5-2d1dbaea899f",
                        "entry_id": "f36f4284-c4b7-3092-bb80-895c24c14bba",
                        "glosses": [
                            "Bezeichnung für eine von einer bestimmten Person oder Gruppe, oder auch allgemein geschätzte, beliebte weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2056b18-5376-4b64-93ab-88ee2e8fe16d",
                                "sense_id": "1928d68c-4ef1-341c-b4d5-2d1dbaea899f",
                                "text": "Gottes Lieblingin ist die Demut. (nach E.M.Arndt)"
                            },
                            {
                                "example_id": "52cddb3d-6002-44dd-9a10-c486fa89ecc6",
                                "sense_id": "1928d68c-4ef1-341c-b4d5-2d1dbaea899f",
                                "text": "\"Heil dem Edlen, der dich immer / Sich zur Lieblingin erkohr\" (Elise Sommer, Poetische Versuche 1806)"
                            },
                            {
                                "example_id": "97ab99df-378d-49b5-9314-3e81d6c744b7",
                                "sense_id": "1928d68c-4ef1-341c-b4d5-2d1dbaea899f",
                                "text": "\"da diese es kurz vor der nahen Verheiratung ihrer Lieblingin nicht noch am Ende mit ihr verderben wollte.\" Friederike Helene Unger (1751–1813) Julchen Grünthal 1,275)"
                            },
                            {
                                "example_id": "5acf3dbd-23cb-4410-8ca4-ac48552189cf",
                                "sense_id": "1928d68c-4ef1-341c-b4d5-2d1dbaea899f",
                                "text": "\"An den seligen Brüsten ihrer Lieblingin überkriecht sie (die Könige) das Grauen und macht sie schlottrig und lustlos.\" (Rilke, Matte Laurids Brigge)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "54dc35f8-3a87-33c6-aba7-415e002eb4dc",
                        "entry_id": "f36f4284-c4b7-3092-bb80-895c24c14bba",
                        "glosses": [
                            "Bezeichnung für eine von einflussreichen Instanzen, Institutionen, Personen o.ä. bevorzugte meist weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007908c6-c751-4324-9626-01084ddd9c30",
                                "sense_id": "54dc35f8-3a87-33c6-aba7-415e002eb4dc",
                                "text": "\"Dann, wann die Lieblingin der Zeit, die jüngste, schönste Tochter der Zeit, die neue Kirche hervorgehen wird aus diesen befleckten veralteten Formen …\" (Hölderlin, Hyperion)"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76974b2d-d2e2-448b-a3f1-fdbe6a540c9b",
                        "source_entry_id": "f36f4284-c4b7-3092-bb80-895c24c14bba",
