                                    {
                                        "sense_id": "85a4c474-0b2a-34d1-aafc-3d27e6c6a3f7",
                                        "entry_id": "1194433b-a722-30d2-9473-685eaf30cb52",
                                        "glosses": [
                                            "Sans interruption ; d'une seule traite."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2805cc2a-d79c-41b4-b597-63fb5abeb052",
                                                "sense_id": "85a4c474-0b2a-34d1-aafc-3d27e6c6a3f7",
                                                "text": "Le pêcheur ne fit pas ce récit tout de suite ; car à tout moment Zadig, ému et transporté, lui disait : \"Quoi ? vous ne savez rien de la destinée de la reine ?\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b7fa03-61ff-3bf9-a29a-6b4065f6440a",
                                        "entry_id": "1194433b-a722-30d2-9473-685eaf30cb52",
                                        "glosses": [
                                            "Sur-le-champ ; aussitôt ; sans délai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b722520d-abe8-456b-86f9-7ac9d90e7cc9",
                                                "sense_id": "74b7fa03-61ff-3bf9-a29a-6b4065f6440a",
                                                "text": "Hervé, en arrivant à la pointe, vit tout de suite que le malheureux bateau était irrémissiblement perdu."
                                            },
                                            {
                                                "example_id": "6f5f0203-85fa-425e-8736-9a60c10d5903",
                                                "sense_id": "74b7fa03-61ff-3bf9-a29a-6b4065f6440a",
                                                "text": "Colombe comprit tout de suite qu’elle s’entendrait avec le duc d’Aumale."
                                            },
                                            {
                                                "example_id": "2d71ff76-91bb-4238-af89-a4a9ba3a6880",
                                                "sense_id": "74b7fa03-61ff-3bf9-a29a-6b4065f6440a",
                                                "text": "Le talochage se fait sans attendre, tout de suite après avoir projeté la matière. On atténue les traces de rotation de la taloche à l'aide d'une éponge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc13e657-b6ce-35f5-966f-c7dd86a9b6ab",
                                        "entry_id": "1194433b-a722-30d2-9473-685eaf30cb52",
                                        "glosses": [
                                            "Présentement, en ce moment, à l’heure qu’il est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06652abe-ab62-4f2a-89c5-0bd0066e2ff9",
                                                "sense_id": "dc13e657-b6ce-35f5-966f-c7dd86a9b6ab",
                                                "text": "Comment ça, il ne manque personne ? Voilà une chambrée de douze lits où vous êtes tout de suite trois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tout de suite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9265d53-4518-38e0-af9a-745b78227191",
                                        "entry_id": "e65cd2d9-e317-373c-9f3a-e0aee7bb0b48",
                                        "glosses": [
                                            "Utilisée pour dire à une personne qu’elle pousse un raisonnement trop loin, qu’à partir de peu, elle extrapole tout de suite, trop vite et de façon erronée."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edfce08b-ec8e-479e-9b24-5aef730bbf85",
                                                "sense_id": "f9265d53-4518-38e0-af9a-745b78227191",
                                                "text": "Arthur : Bon… Alors y’a deux solutions. Soit votre allergie ne s’arrange pas, mais alors pas du tout, soit, mais ça m’étonnerai vu que j’vous l’ai formellement interdit, vous êtes encore allées fouiner du côté d’un site sacré !\nGuenièvre : Mais non, pas du tout !\nSéli : Tout de suite !"
                                            },
                                            {
                                                "example_id": "fc6daa99-74d1-4170-9c97-2fe346e5278b",
                                                "sense_id": "f9265d53-4518-38e0-af9a-745b78227191",
                                                "text": "— Non mais regardez-moi cette merde ! On patauge dans les toxines ! Y’a encore quelqu’un qui fait le ménage dans ce corps ?\n— Hoooo, tout d’suite, l’autre !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
