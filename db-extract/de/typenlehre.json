                ],
                "senses": [
                    {
                        "sense_id": "3c5f1720-22d3-3643-9fa9-42ea406f24b0",
                        "entry_id": "753baca5-8e08-3b78-9f30-44fb9298a1e1",
                        "glosses": [
                            "die Lehre von Typen; eine Theorie, Menschen nach ihren Eigenschaften oder Charakter (eindeutig) in abgegrenzte Klassen (›Typen‹) zu kategorisieren"
                        ],
                        "tags": [
                            "auch Esoterik"
                        ],
                        "examples": [
                            {
                                "example_id": "0772ae67-31f8-4244-b044-324d576ae5b0",
                                "sense_id": "3c5f1720-22d3-3643-9fa9-42ea406f24b0",
                                "text": "Modernere Formen einer Typenlehre stammen von C.G. Jung oder E. Kretschmer."
                            },
                            {
                                "example_id": "c09c8ac3-b380-41e5-9aa5-6d280d709b2d",
                                "sense_id": "3c5f1720-22d3-3643-9fa9-42ea406f24b0",
                                "text": "Neben wissenschaftlicher Herangehensweisen gibt es auch esoterische Typenlehren wie das Enneagramm."
                            },
                            {
                                "example_id": "14a9b1fe-c22a-4d42-9214-4e8730e655d8",
                                "sense_id": "3c5f1720-22d3-3643-9fa9-42ea406f24b0",
                                "text": "Vorneuzeitliche Typenlehren bringen die Typen oft mit Naturelementen in Verbindung."
                            },
                            {
                                "example_id": "2b86c896-1a81-4924-ac29-6492ac603129",
                                "sense_id": "3c5f1720-22d3-3643-9fa9-42ea406f24b0",
                                "text": "Die Einteilung der Temperamente in der Antike (sanguinisch, cholerisch, phlegmatisch, melancholisch) ist ein Beispiel für eine Typenlehre."
                            },
                            {
                                "example_id": "a2c040ff-73a1-4cd1-b825-ffc37a9736ec",
                                "sense_id": "3c5f1720-22d3-3643-9fa9-42ea406f24b0",
                                "text": "Schon immer wurde mit dem Prinzip der Typenlehre versucht, die Individuen nach bestimmten Merkmalen zu Klassen zusammenzufassen und sie damit von anderen Individuen, die diese Merkmale nicht innehaben, deutlich abzugrenzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
