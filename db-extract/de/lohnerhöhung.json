                ],
                "senses": [
                    {
                        "sense_id": "9a0100dd-9efb-3fe9-8c36-bb602b5aec43",
                        "entry_id": "085887e7-e8ad-362b-bfb3-6d7a37e6dfa9",
                        "glosses": [
                            "Erhöhung/Verbesserung des Arbeitslohns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98cb957-71d3-441a-89d6-3b8012e8532d",
                                "sense_id": "9a0100dd-9efb-3fe9-8c36-bb602b5aec43",
                                "text": "„Obwohl bei der geforderten Lohnerhöhung Habba und Sámal die Sprecher der Arbeiter gewesen waren, hatte man nicht sie gegen zehn Uhr abends zum Verhör in die Wachstube gebracht.“"
                            },
                            {
                                "example_id": "cbac10a4-338d-4821-8bd5-d9a251ac11b8",
                                "sense_id": "9a0100dd-9efb-3fe9-8c36-bb602b5aec43",
                                "text": "„Dabei hatten erstmals slowakische Mitarbeiter eines großen westlichen Konzerns gegen den Status der Slowakei als Billiglohnland protestiert und deutliche Lohnerhöhungen durchgesetzt.“"
                            },
                            {
                                "example_id": "dd1300ef-0479-4f49-b37f-e5ed3df3e9d7",
                                "sense_id": "9a0100dd-9efb-3fe9-8c36-bb602b5aec43",
                                "text": "„Die Beamten haben nach langem Verhandeln endlich eine Lohnerhöhung erhalten, die inzwischen bereits so entwertet ist, daß sie jetzt kaum noch einen Liter Milch in der Woche dafür kaufen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
