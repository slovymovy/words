            {
                "entry_id": "7d9fc0df-db9f-349d-b140-577990ff8589",
                "word": "resserre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0fbeaef-7abb-4d9f-afee-b4da9fae46b4",
                        "entry_id": "7d9fc0df-db9f-349d-b140-577990ff8589",
                        "tags": [
                            "plural"
                        ],
                        "form": "resserres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                        "entry_id": "7d9fc0df-db9f-349d-b140-577990ff8589",
                        "glosses": [
                            "Endroit où l’on range, où l’on serre certains objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45957326-575d-4f72-90b4-c71a9263b33b",
                                "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                                "text": "Les resserres sont exclusivement réservées aux pigeons."
                            },
                            {
                                "example_id": "6fd0f1f7-95c3-4ee8-89f1-582f2bd913ee",
                                "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                                "text": "Entre des maisons grises, des resserres, des magasins d'outillage, des bars, des trottoirs étroits, la rue de Lappe ouvrait sa médiocre perspective […]."
                            },
                            {
                                "example_id": "795f6cda-3498-435f-93c5-23f2ad5fe5e4",
                                "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                                "text": "Le soir venu, je prends sur moi de pousser la porte : c’était la resserre à l’huile et, dans une jarre, un gros rat s’était noyé."
                            },
                            {
                                "example_id": "a56b48fa-5033-44ef-8872-cce36a960432",
                                "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                                "text": "Il s’était caché dans une resserre, derrière des sacs de grains."
                            },
                            {
                                "example_id": "d7965089-17fd-4831-bc6b-07f1ab5aa0d0",
                                "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                                "text": "Est-ce qu’ils font comme en Piémont ici ? Il y a toujours une chambre de resserre, presque sous les toits."
                            },
                            {
                                "example_id": "e8571c3a-30cb-4621-9581-d896cf9a4490",
                                "sense_id": "2a3fd568-ae86-38fd-9421-90976e529a2b",
                                "text": "Au fond du jardin, Mathilde avait fait son délice de l’ancienne resserre à outils."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
