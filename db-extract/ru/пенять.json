                    {
                        "sense_id": "6b52617b-9241-3071-a5af-f65eeb73ee0b",
                        "entry_id": "a5d3ea72-6d68-3a78-a78d-8ddb60327aff",
                        "glosses": [
                            "to reproach (with), to blame"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7be44b43-cba0-445d-80a4-9c0a3d2075a7",
                                "sense_id": "6b52617b-9241-3071-a5af-f65eeb73ee0b",
                                "text": "пеня́й на себя́",
                                "translation": "you alone are to blame; you have only yourself to blame",
                                "english": "you alone are to blame; you have only yourself to blame"
                            },
                            {
                                "example_id": "d2663415-519f-42e2-9f0d-9d4992dc566e",
                                "sense_id": "6b52617b-9241-3071-a5af-f65eeb73ee0b",
                                "text": "не́чего на зе́ркало пеня́ть, коли ро́жа крива́",
                                "translation": "≈ don't lay your own faults at another person's door; don't blame your own faults on others",
                                "english": "≈ don't lay your own faults at another person's door; don't blame your own faults on others"
                            }
                        ]
                    }
