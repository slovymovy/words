                    "sense_id": "5dcfb588-b9a9-38a1-8cd6-a62a9bce89d1",
                    "sense_definition": "The standard unit used to measure electrical potential or electromotive force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The standard household outlet in this country provides a current of 230 <w>volts</w>.",
                            "target_lang_translations": {
                                "ru": "Стандартная бытовая розетка в этой стране обеспечивает напряжение 230 <w>вольт</w>."
                            }
                        },
                        {
                            "text": "You need to check the <w>volt</w> capacity of the battery before plugging it into the device.",
                            "target_lang_translations": {
                                "ru": "Вам нужно проверить <w>вольтовую</w> мощность аккумулятора перед подключением его к устройству."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volt capacity",
                        "thousand volts",
                        "low volt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартная единица измерения электрического потенциала или электродвижущей силы."
                    },
                    "translations": {
