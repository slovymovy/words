                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ceba093-07cd-3101-809a-048e6665435e",
                                        "entry_id": "d0dcd5e0-cf93-3fed-8ef1-3b884f99906b",
                                        "glosses": [
                                            "geiziger Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2f7cc1-cdc0-4e36-9ff1-b66300d742f3",
                                                "sense_id": "8ceba093-07cd-3101-809a-048e6665435e",
                                                "text": "„Der alte M … ist ein geiziger, rangiger Filz, der seine Frau im Leben was Rechts geplagt und eingeschränkt hat.“ - Die Leiden des jungen Werther"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "017a9097-02c2-3c64-827b-5c34896eb1e7",
