                    {
                        "translation_id": "7e55279d-97c2-4106-a9ff-9fcc784c7e5e",
                        "source_entry_id": "a20977db-c790-3a75-b359-fb41c6694b9a",
                        "source_sense_id": "e2e2cc98-1397-3379-883c-18e11cdd3019",
                        "target_lang_word": "Seine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d948f333-9a26-31eb-a93e-b4f823874420",
                                        "entry_id": "8d81c168-ecf4-37ea-84f7-33ba29c5a5d5",
                                        "glosses": [
                                            "Fleuve français, qui coule dans le Bassin parisien et arrose notamment Troyes, Paris et Rouen."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71aae30d-967f-43a2-9029-d57017caccc7",
                                                "sense_id": "d948f333-9a26-31eb-a93e-b4f823874420",
                                                "text": "Hilperik entra à Paris sans aucune opposition, et logea ses guerriers dans les tours qui défendaient les ponts de la ville, alors environnée par la Seine."
                                            },
                                            {
                                                "example_id": "1e23796c-0c9b-47fe-a3bc-fcdd4bc1fdd3",
                                                "sense_id": "d948f333-9a26-31eb-a93e-b4f823874420",
                                                "text": "Je contemple un instant la Seine qui traîne comme une limace. Elle est faite de toute la boue de Paris."
                                            },
                                            {
                                                "example_id": "684ebc37-a63a-46fa-b09a-daba1bf76c64",
                                                "sense_id": "d948f333-9a26-31eb-a93e-b4f823874420",
                                                "text": "Louis le pieux meurt en 840 sur le Rhin. Un an plus tard, la flotte danoise embouque l’estuaire de la Seine."
                                            },
                                            {
                                                "example_id": "aadcf633-befa-4ff0-b61f-97085555dded",
                                                "sense_id": "d948f333-9a26-31eb-a93e-b4f823874420",
                                                "text": "Ce travail a été fait à Paris. Nous aimerions que, si l’existence de cet élément 93 est confirmée, on le nommât Sequanium (Sq), en hommage à la vaillante et généreuse civilisation qui a fleuri sur les bords de la Seine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91fd6d5f-4bfc-3c79-b444-86a6ed31c6ab",
                                        "entry_id": "8d81c168-ecf4-37ea-84f7-33ba29c5a5d5",
                                        "glosses": [
                                            "Ancien département français correspondant à la ville de Paris et à sa proche banlieue, de 1795 à 1968."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9095e7-cd53-4e45-882d-12f0ad08e152",
                                                "sense_id": "91fd6d5f-4bfc-3c79-b444-86a6ed31c6ab",
                                                "text": "Article unique. — La commune de Clamart est distraite du canton de Sceaux (arrondissement de Sceaux, département de la Seine) et rattachée au canton de Vanves (même arrondissement et même département)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3cc10bb-f8e1-3479-99cb-4a04420c92da",
                                        "entry_id": "8d81c168-ecf4-37ea-84f7-33ba29c5a5d5",
                                        "glosses": [
                                            "Rivière canadienne du Manitoba, affluent de la rivière Rouge juste au sud de Winnipeg."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4d94f7d-ef5e-32bb-be2c-2cc10c5840f5",
                                        "entry_id": "8d81c168-ecf4-37ea-84f7-33ba29c5a5d5",
                                        "glosses": [
                                            "Rivière canadienne de l’Ontario, s’écoulant du lac des Mille Lacs au lac à la Pluie."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
