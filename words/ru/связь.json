                                "zh": "他父亲的老<w>关系</w>帮他找到了工作。",
                                "nl": "De oude <w>connecties</w> van zijn vader hielpen hem aan de baan.",
                                "pl": "W znalezieniu pracy pomogły mu dawne <w>znajomości</w> ojca.",
                                "de": "Die alten <w>Beziehungen</w> seines Vaters halfen ihm, die Stelle zu bekommen.",
                                "fr": "Les anciennes <w>relations</w> de son père l'ont aidé à trouver ce travail.",
                                "it": "Le vecchie <w>conoscenze</w> del padre lo hanno aiutato a trovare lavoro.",
                                "cs": "Pomohly mu získat práci otcovy staré <w>známosti</w>.",
                                "tr": "İşe girmesine babasının eski <w>çevresi</w> yardımcı oldu.",
                                "es": "Los viejos <w>contactos</w> de su padre le ayudaron a conseguir el trabajo."
                            }
                        },
