                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09280073-ca60-4f55-be7f-cc0df5c20030",
                                "sense_id": "bf547289-affd-3ebe-a0fb-2bb065b0faf7",
                                "text": "Mam na imię Amelia i jestem twoją daleką krewną ze strony ojca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ad2e4269-3863-384d-828e-d4979be582c1",
                        "entry_id": "a4184a16-8ecf-3777-a519-c61f52b2cbfb",
                        "glosses": [
                            "miasto we Włoszech, w regionie Umbria, w prowincji Terni"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "cab7cdde-6ba3-358e-b5d3-69f3565ed491",
                        "entry_id": "a4184a16-8ecf-3777-a519-c61f52b2cbfb",
                        "glosses": [
                            "gmina we Włoszech z siedzibą władz w Amelii (1.2)"
                        ],
                        "tags": [],
