                    {
                        "translation_id": "26aff914-9977-4454-8364-dbcd7eb35cfa",
                        "source_entry_id": "61be627b-5bd5-3441-b972-b29a5e5fa601",
                        "source_sense_id": "cff80490-1d45-36c4-859c-95a5f12884e5",
