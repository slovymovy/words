                "senses": [
                    {
                        "sense_id": "56aaf358-9843-32de-afc4-f0780cdfcc25",
                        "entry_id": "d5de0286-b20c-3c8f-9d81-af014cdcb38d",
                        "glosses": [
                            "ausgedachte Aufgabe, die das Herbeiführen des Matts in einer vorgeschriebenen Anzahl von Zügen fordert"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "59f3086e-4fda-4ed9-82bb-3ff757811839",
                                "sense_id": "56aaf358-9843-32de-afc4-f0780cdfcc25",
                                "text": "„Als das grandioseste Schachproblem aller Zeiten komponiert wurde, lebte Vladimir Nabokov schon nicht mehr; aber es hätte ihm, der selber im Problemschach aktiv war, gefallen.“"
                            },
                            {
                                "example_id": "77b1ebb9-8327-4e62-94f9-073b9b78bcbc",
                                "sense_id": "56aaf358-9843-32de-afc4-f0780cdfcc25",
                                "text": "„Man muss sich darüber im Klaren sein, dass der Kampf bei Schachproblemen nicht eigentlich zwischen Weiß und Schwarz stattfindet, sondern zwischen dem Problemautor und dem hypothetischen Löser.“"
                            },
                            {
                                "example_id": "a152eeac-0ffc-4b39-9163-18c142cba79b",
                                "sense_id": "56aaf358-9843-32de-afc4-f0780cdfcc25",
                                "text": "„Sie hungerten nach Gesellschaft, dachte Lillian, – nicht nach Schachproblemen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
