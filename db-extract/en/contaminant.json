                        "examples": [
                            {
                                "example_id": "c8f9fd41-c15a-448d-aa90-1fe82c22f298",
                                "sense_id": "9208669a-e1b5-36bb-a2e4-44ecb46454d7",
                                "text": "Put the lid on the jar to keep contaminants out."
