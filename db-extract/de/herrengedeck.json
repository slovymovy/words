                ],
                "senses": [
                    {
                        "sense_id": "6bd712e4-abb0-3c5d-993d-c35dfc30c340",
                        "entry_id": "27e3c174-dd13-3d42-979d-bd6363239022",
                        "glosses": [
                            "Kombination zweier alkoholischer Getränke, die je nach Region aus einem Pils, einem Kölsch, einem Altbier oder einem Hellen, sowie einem Korn besteht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ac4002fb-c1ef-4046-8f2a-add35911a090",
                                "sense_id": "6bd712e4-abb0-3c5d-993d-c35dfc30c340",
                                "text": "Er bestellte ein Herrengedeck, liess das Schnapsglas mit dem Korn ins Bierglas gleiten und nahm einen tiefen Schluck."
                            },
                            {
                                "example_id": "5edf251b-1ba0-47aa-9c47-4bf078994a4c",
                                "sense_id": "6bd712e4-abb0-3c5d-993d-c35dfc30c340",
                                "text": "Zumindest lässt sich die Entstehung des Herrengedecks in die Stripbars rund um die Reeperbahn zurückverfolgen: Dort galt ein Herrengedeck in den Nachkriegsjahren als obligatorischer Mindestverzehr."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b429a506-4018-31ab-8b47-c16ec268f4b0",
                        "entry_id": "27e3c174-dd13-3d42-979d-bd6363239022",
                        "glosses": [
                            "Cocktail, der aus Bier und Sekt besteht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "989806d6-f161-4958-9bc6-4481c5087f49",
                                "sense_id": "b429a506-4018-31ab-8b47-c16ec268f4b0",
                                "text": "Sein Kollege bestellte ein Herrengedeck und er trank das Glas in wenigen Zügen ganz aus, obwohl er den Sekt darin normalerweise nicht mochte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "44ca1c33-21dd-3e08-9805-3b05930ace5d",
                        "entry_id": "27e3c174-dd13-3d42-979d-bd6363239022",
                        "glosses": [
                            "eine Flasche Bier und eine 0,2l-Flasche Sekt"
                        ],
                        "tags": [
                            "archaic",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "baebb0dd-00d8-4527-a761-72248d7a7757",
                                "sense_id": "44ca1c33-21dd-3e08-9805-3b05930ace5d",
                                "text": "Ein Herrengedeck galt auf der Reeperbahn lange als Mindestverzehr."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
