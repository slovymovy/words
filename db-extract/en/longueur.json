                "senses": [
                    {
                        "sense_id": "0b68b731-fc99-33e7-a981-9563d5500bec",
                        "entry_id": "149c4de0-85df-3e79-a65f-648cd50fdef5",
                        "glosses": [
                            "A lengthy passage in a dramatic or literary work, especially a dull or tedious one; a period of boredom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda0366b-c2a5-4075-9dbc-0662b660753d",
                                "sense_id": "0b68b731-fc99-33e7-a981-9563d5500bec",
                                "text": "Most of the reasons given for its disappearance make sense: people are happier, busier; the work done by the anti-Freudian skeptics has finally taken hold of the popular imagination, so that people have no time for analytic longueurs and no patience with its mystifications."
                            },
                            {
                                "example_id": "9624bb14-f37d-4ffe-984b-3929f2dda937",
                                "sense_id": "0b68b731-fc99-33e7-a981-9563d5500bec",
                                "text": "He cultivated the aura, if not quite of the Anti-Christ, at least of an Anti-Sun King, discountenancing his uncle and shocking the dévots by preferring the intimacy and informality of a clique of drinking companions to the formal longueurs of the courtly round […]."
                            },
                            {
                                "example_id": "7633f965-31e9-4d75-98a4-589c349ebbff",
                                "sense_id": "0b68b731-fc99-33e7-a981-9563d5500bec",
                                "text": "[T]he reader can’t help feeling that a few judicious nips and tucks might have dispersed the longueurs that waft around the third quarter of the book."
                            },
                            {
                                "example_id": "3d37f7eb-9a98-4c73-97a9-6681f3286092",
                                "sense_id": "0b68b731-fc99-33e7-a981-9563d5500bec",
                                "text": "Claire Fontaine (who are actually a duo) have queered the phrase, lending its pungency and ambiguity to a biennale that I wish were nearly so succinct. There are longueurs. There are detours and incomprehensible delays."
                            }
                        ]
                    }
