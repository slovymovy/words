                        "glosses": [
                            "A box from which dice are thrown in gaming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e164c0ac-9e33-4e99-bf17-d78a84d92642",
                                "sense_id": "39b13463-709e-3f7b-b786-d72809da0a56",
                                "text": "For Corinius, who gave not a fig for music or dirges, but liked well of carding and dicing, had brought forth his dice box to play with the son of Corund."
                            },
                            {
                                "example_id": "00429710-80f3-42a6-abfa-1cd7860dd7be",
                                "sense_id": "39b13463-709e-3f7b-b786-d72809da0a56",
                                "text": "[…] there is a sort of chivalry among the knights of the dice-box: the fame of great players is known all over Europe."
                            },
                            {
                                "example_id": "5eb490e9-beaf-4cc3-bf54-4d7f9ee75f46",
                                "sense_id": "39b13463-709e-3f7b-b786-d72809da0a56",
                                "text": "The houses looked as if they had been shaken out of a dice box on to the land and stayed just where they lit."
                            }
                        ]
                    }
