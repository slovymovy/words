                    },
                    {
                        "form_id": "366cc364-b56a-4ec4-97ef-4727236a6dcf",
                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Burgunder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61064a91-0208-383f-9962-f9fd55c340d8",
                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                        "glosses": [
                            "Vertreter eines ostgermanischer Volksstammes; dieser wurde im 2. bis 4. Jahrhundert in der Lausitz und im östlichen Brandenburg nachgewiesen, im 4. Jahrhundert nach Mainfranken umgesiedelt und nach Auseinandersetzungen mit den Alemannen ins Rhonegebiet umgesiedelt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fe76c659-5289-478f-8b14-ae4b74154c05",
                                "sense_id": "61064a91-0208-383f-9962-f9fd55c340d8",
                                "text": "„Als die Burgunder unter Gundahar nach Westen ausgriffen, wurden sie 436 vom weströmischen Feldherrn Aetius und verbündeten Hunnen geschlagen […] und ins Rhônegebiet umgesiedelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                        "glosses": [
                            "Wein aus der Weinbauregion Burgund oder Bourgogne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b5b15d-c549-4761-9d2b-8650c24e3511",
                                "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                "text": "„[…] Die Phantasie trinkt mit: Die floralen Aromen im Burgunder – das ist wie ein Gartenspaziergang im Frühling wenn alles blüht und duftet, aber nichts wirklich dominant ist.“"
                            },
                            {
                                "example_id": "1515f75b-601a-4592-8830-2fe0a1c8a3aa",
                                "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                "text": "„[…] Denn die Verbraucher – auch gerade die in Übersee – haben genug von der „simplen Allerweltsbotschaft“ des Chardonnay; sie wünschen sich intellektuellere Weine wie Riesling und Burgunder.“"
                            },
                            {
                                "example_id": "089e9b73-8bb7-4005-a9c9-9f1d018deeba",
                                "sense_id": "0271eda3-40f6-3fb8-a345-e5ed6820dfbf",
                                "text": "„Zum Lendenbraten wurde Burgunder gereicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dd9a57f0-962d-396a-a0c4-8f3684ba5463",
                        "entry_id": "a7343d1b-37d7-3af8-9793-271419bf7024",
                        "glosses": [
                            "Wein aus Burgunder Rebsorten wie der Graue oder Weiße Burgunder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dccf69f-7105-4830-8fc5-30abb15dd511",
                                "sense_id": "dd9a57f0-962d-396a-a0c4-8f3684ba5463",
                                "text": "Der Samtrot ist der schwäbische Vertreter unter den Burgundern."
                            },
                            {
                                "example_id": "b917ba78-0750-4641-b4da-2f8b7429c661",
                                "sense_id": "dd9a57f0-962d-396a-a0c4-8f3684ba5463",
                                "text": "„Sophie biß sich auf die Lippen, als sie merkte, daß sie beim Füllen meines Glases ein wenig Burgunder vergossen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
