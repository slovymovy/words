                "senses": [
                    {
                        "sense_id": "e501e637-08b4-3571-8aef-2f8767a95e4c",
                        "entry_id": "3632292d-d0b2-38aa-a222-077fdda2114e",
                        "glosses": [
                            "Plan zur bestmöglichen, erfolgversprechenden Beherrschung eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec55afc-8194-46f8-b2d7-35cc75a72f0c",
                                "sense_id": "e501e637-08b4-3571-8aef-2f8767a95e4c",
                                "text": "„Die Hauptanforderung in vielen Regelspielen ist, die eigene Spielstrategie auf die des Gegners abzustimmen und dabei auch Wahrscheinlichkeiten ins Kalkül zu ziehen.“"
                            },
                            {
                                "example_id": "8074191d-fd68-4c72-99e0-b26756d220b6",
                                "sense_id": "e501e637-08b4-3571-8aef-2f8767a95e4c",
                                "text": "„Bei den Erklärungen zu beiden Spielen war wieder zu beobachten, dass die jüngeren Kinder kaum verbal ihre Spielstrategie erläutern konnten, die sie benutzten.“"
                            },
                            {
                                "example_id": "869139d5-27ff-4408-bd58-adace2671fb4",
                                "sense_id": "e501e637-08b4-3571-8aef-2f8767a95e4c",
                                "text": "„Während Vogts seinem Nachfolger Joachim Löw zur Überarbeitung von Spielstrategie und Ausbildung rät, wirft Matthäus dem Bundestrainer nach dem Halbfinal-Aus bei der EURO taktische Fehler vor.“"
                            },
                            {
                                "example_id": "8c417e58-4286-4dfc-bff1-922a6dabc312",
                                "sense_id": "e501e637-08b4-3571-8aef-2f8767a95e4c",
                                "text": "„Während für Klopp schon die Suche nach der Final-Elf zu einem kniffligen Puzzlespiel wird, muss sich Jupp Heynckes nur über eine erfolgsverheißende Spielstrategie für das Endspiel am Samstag den Kopf zerbrechen.“"
                            },
                            {
                                "example_id": "2384eb59-e0a8-4db4-96bd-9ef82114faf6",
                                "sense_id": "e501e637-08b4-3571-8aef-2f8767a95e4c",
                                "text": "„Seine Spielstrategie für die beiden Schlusstage hat sich die ehemalige Nummer eins der Welt schon zurecht gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
