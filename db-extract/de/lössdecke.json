                ],
                "senses": [
                    {
                        "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                        "entry_id": "f1284ddc-ada7-30f7-896d-5949dc450db0",
                        "glosses": [
                            "der Löss, der den Erdboden, die darunterliegenden geologischen Schichten abdeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc26edc-afb9-4edd-924b-dca3a6e8088e",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Aufgrund der fruchtbaren Lössdecken in Mitteldeutschland konnte sich dort eine ertragreiche Landwirtschaft entwickeln."
                            },
                            {
                                "example_id": "b1f923ed-1632-488d-a094-fdc7f1b9db00",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Die mächtigsten Lössdecken findet man in Ostasien, insbesondere in China."
                            },
                            {
                                "example_id": "1cb58c66-06e5-4457-9883-cbc7f328ae52",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Die Region ruht auf einem Kalkmassiv, das von einer Lössdecke überzogen ist und ist eine intensiv landwirtschaftlich genutztes Gebiet."
                            },
                            {
                                "example_id": "a9a53fa8-71f2-497f-8848-c5555d88dfc4",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Lössdecken entstanden vor den Moränen Norddeutschlands und in den Senken der Kölner Bucht und Mitteldeutschlands, aber auch in den kleineren Nischen um Harz und Weserbergland."
                            },
                            {
                                "example_id": "5ff720c8-580e-41ba-844c-7c07558926c3",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Die in weiten Bereichen vorherrschende bis zu 15 Meter tiefe Lössdecke, sowie die Mergel- und Tonböden verhindern jedoch durch einen guten Wasserhaushalt Trockenschäden."
                            },
                            {
                                "example_id": "475d6cf9-a66d-4218-8608-e98bb2a65e92",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Der geologische Untergrund wird von den Schichten des Oberen Muschelkalkes und dem Unteren Keuper bestimmt. Diese sind von zusammenhängenden Lössdecken unterschiedlicher Mächtigkeit bedeckt."
                            },
                            {
                                "example_id": "716c3c66-caca-4c62-83b8-cab763c6036d",
                                "sense_id": "39297286-5d73-38c9-aff7-e5e58c1201d4",
                                "text": "Im östlichen Teil liegen verdeckt unter einer mächtigen Lössdecke jurassische und tertiäre Gestein, in die teilweise vulkanisches Material eingedrungen ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
