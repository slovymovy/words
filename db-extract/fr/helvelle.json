                        "cross_references": [
                            {
                                "target_word": "elfin saddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec82ff54-3b07-3476-8123-7f074731252d",
                                        "entry_id": "c852580d-8949-3af3-b5ed-770c26553100",
                                        "glosses": [
                                            "Any of certain ascomycetous fungi of genus Helvella with an irregular cap resembling a saddle, especially Helvella crispa or Helvella lacunosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ed5b31-7e4a-40eb-b1cc-4a28475fc941",
                                                "sense_id": "ec82ff54-3b07-3476-8123-7f074731252d",
                                                "text": "Here too are the false morels (genus Gyromitra) and elfin saddles (genus Helvella), which are generally regarded — or suspected — to be poisonous when consumed, especially if eaten raw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71cc835e-cc8e-34d9-a507-b1c371953076",
                                        "entry_id": "c852580d-8949-3af3-b5ed-770c26553100",
                                        "glosses": [
                                            "Any member of species Gyromitra infula of ascomycetes, which similarly resemble a saddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f0bcdb-1a47-42b9-bc34-bfd7c8f50c64",
                                                "sense_id": "71cc835e-cc8e-34d9-a507-b1c371953076",
                                                "text": "2005, Pacific Northwest Forest and Range Experiment Station (Portland, Oregon), Research Note PNW-RN-546, page 7,\nOf the several species of Gyromitra that might be encountered in Alaska, two are especially important for morel hunters to learn: Gyromitra esculenta ssp. lato, the beefsteak false morel, and G. infula ssp. lato, the elfin saddle."
                                            },
                                            {
                                                "example_id": "42c7f1ae-7416-443a-a984-c9376d315ac7",
                                                "sense_id": "71cc835e-cc8e-34d9-a507-b1c371953076",
                                                "text": "[…]since the Bohemian morel can be confused with the toxic elfin saddle (Gyromitra infula) or other undesirable fungi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
