                                        "sense_id": "14e34c9b-ef4d-3eb3-b2e8-b760e44bb52b",
                                        "entry_id": "47f9181a-94df-39ae-840e-fcefa1199da9",
                                        "glosses": [
                                            "Surface plane généralement horizontale laissée libre, servant à diverses opérations manuelles au moyen d'outils rangés à proximité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72003edd-9953-3b12-9a3d-b4c3ea53d305",
                                        "entry_id": "47f9181a-94df-39ae-840e-fcefa1199da9",
                                        "glosses": [
                                            "Table murale fixe, oblongue, destinée à la préparation des repas et autres travaux culinaires, comportant un ou plusieurs éviers et munie dans le bas de petites armoires de rangement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb64452-80fa-4c29-8c78-2d2aa1495b83",
                                                "sense_id": "72003edd-9953-3b12-9a3d-b4c3ea53d305",
                                                "text": "Vaporisez sur les vitres, dans les toilettes pour un petit coup rapide, sur le plan de travail de la cuisine, les plaques de cuisson, dans la poubelle, sur les robinets, sur les lavabos, les miroirs… et séchez avec un chiffon propre. Inutile de rincer. C’est ça, l’avantage !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c7333d-9a31-4de1-8f00-d9f1f7554fc7",
                        "source_entry_id": "a140d004-8165-3d8a-94f9-96dbd3c6ee55",
