            "senses": [
                {
                    "sense_id": "b4f0f41f-262a-334c-b979-d64a0bcca754",
                    "sense_definition": "Głośny, nieprzyjemny hałas lub zgiełk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hałas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na korytarzu szkolnym panował wielki <w>harmider</w> podczas przerwy.",
                            "target_lang_translations": {
                                "ru": "На школьном коридоре во время перемены стоял страшный <w>гам</w>."
                            }
                        },
                        {
                            "text": "Dzieci robiły taki <w>harmider</w>, że trudno było się skupić na pracy.",
                            "target_lang_translations": {
                                "ru": "Дети подняли такой <w>гвалт</w>, что было трудно сосредоточиться на работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "hałas",
                        "huk",
                        "jazgot"
                    ],
                    "common_phrases": [
                        "robić harmider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, неприятный шум или гам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "общий термин для громких, неприятных звуков"
                            },
                            {
                                "target_lang_word": "гам",
                                "target_lang_sense_clarification": "громкий, беспорядочный шум от множества голосов"
                            },
                            {
                                "target_lang_word": "гвалт",
                                "target_lang_sense_clarification": "сильный, нестройный шум, крики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fa8c245-946b-39da-8ecb-ea72d4faf46b",
                    "sense_definition": "Stan chaosu, zamieszania i niepokoju.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zamieszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W biurze panował totalny <w>harmider</w> przed przyjazdem ważnego klienta.",
                            "target_lang_translations": {
                                "ru": "В офисе царила полная <w>суматоха</w> перед приездом важного клиента."
                            }
                        },
                        {
                            "text": "Wszyscy biegali w <w>harmiderze</w>, próbując naprawić awarię systemu.",
                            "target_lang_translations": {
                                "ru": "Все бегали в <w>неразберихе</w>, пытаясь устранить сбой системы."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrzawa",
                        "zgiełk",
                        "zamieszanie",
                        "rwetes"
                    ],
                    "common_phrases": [
                        "wielki harmider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние хаоса, беспорядка и суеты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суматоха",
                                "target_lang_sense_clarification": "беспорядочная беготня, суета, неразбериха"
                            },
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "состояние полного беспорядка и путаницы"
                            },
                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "состояние тревоги и суеты, вызванное неожиданным событием"
                            }
                        ]
                    }
                }
            ]
        }
