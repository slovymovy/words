{
    "word_family": [
        "święto",
        "święty",
        "święcić",
        "świętować"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9d91c4e8-b68b-3c29-a4be-4c1113240092",
                    "sense_definition": "W sposób uroczysty, związany z obchodzeniem święta lub ważnej okazji.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uroczystość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy goście byli <w>odświętnie</w> ubrani na tę wyjątkową kolację.",
                            "target_lang_translations": {
                                "ru": "Все гости были <w>празднично</w> одеты на этот особенный ужин."
                            }
                        },
                        {
                            "text": "Stół w salonie został <w>odświętnie</w> nakryty białym obrusem.",
                            "target_lang_translations": {
                                "ru": "Стол в гостиной был <w>празднично</w> накрыт белой скатертью."
                            }
                        }
                    ],
                    "synonyms": [
                        "uroczyście"
                    ],
                    "common_phrases": [
                        "odświętnie ubrany",
                        "odświętnie nakryty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественно, в соответствии с праздничным случаем или важным событием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "празднично",
                                "target_lang_sense_clarification": "в манере, соответствующей празднику"
                            },
                            {
                                "target_lang_word": "торжественно",
                                "target_lang_sense_clarification": "в официальной, приподнятой обстановке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43bd58f-403b-350a-826c-8db7c5c76ab7",
                    "sense_definition": "W sposób elegancki, formalny, odpowiedni na specjalne wyjście.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uroczystość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na premierę w teatrze wszyscy przyszli bardzo <w>odświętnie</w> ubrani.",
                            "target_lang_translations": {
                                "ru": "На премьеру в театре все пришли очень <w>нарядно</w> одетыми."
                            }
                        },
                        {
                            "text": "Mężczyzna wyglądał <w>odświętnie</w> w swoim nowym garniturze.",
                            "target_lang_translations": {
                                "ru": "Мужчина выглядел <w>парадно</w> в своем новом костюме."
                            }
                        }
                    ],
                    "synonyms": [
                        "galowo",
                        "wyjściowo"
                    ],
                    "common_phrases": [
                        "odświętnie ubrany"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элегантно, официально, подходящим образом для особого случая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарядно",
                                "target_lang_sense_clarification": "об одежде или внешнем виде"
                            },
                            {
                                "target_lang_word": "парадно",
                                "target_lang_sense_clarification": "очень официально, по-выходному"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0ee9e3-15d1-3150-95ba-55d0d70f3273",
                    "sense_definition": "Rzadko, tylko przy specjalnych okazjach.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rzadkość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten zabytkowy samochód jest używany tylko <w>odświętnie</w> podczas parad.",
                            "target_lang_translations": {
                                "ru": "Этот старинный автомобиль используется только <w>по праздникам</w> во время парадов."
                            }
                        },
                        {
                            "text": "W tym domu <w>odświętnie</w> otwiera się najlepsze wino z piwniczki.",
                            "target_lang_translations": {
                                "ru": "В этом доме <w>по особым случаям</w> открывают лучшее вино из погреба."
                            }
                        }
                    ],
                    "synonyms": [
                        "świątecznie"
                    ],
                    "antonyms": [
                        "zwyczajnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Редко, только по особым случаям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по праздникам",
                                "target_lang_sense_clarification": "в исключительных случаях"
                            },
                            {
                                "target_lang_word": "в исключительных случаях",
                                "target_lang_sense_clarification": "редко, не в обычное время"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}