                                            {
                                                "example_id": "56326a50-18a2-4cb5-af52-5a8987417b0d",
                                                "sense_id": "6ac00b1d-4bd6-3e68-841b-d94793a585a4",
                                                "text": "Nadat ze thuis het besluit hadden genomen om naar Hotel Luxor terug te keren, was het plannen smeden begonnen. Een bezigheid die de eerste dag nogal chaotisch verliep."
                                            }
                                        ]
