                                            {
                                                "example_id": "c00873af-2077-4666-a683-59438867b3f7",
                                                "sense_id": "e17e0c4e-d213-3182-9369-a2b3a05bc0f3",
                                                "text": "He spoke with an affected English accent."
                                            },
                                            {
                                                "example_id": "1df6b062-4380-48ea-b925-f291ed11f471",
                                                "sense_id": "e17e0c4e-d213-3182-9369-a2b3a05bc0f3",
                                                "text": "The affected articulation of his opinions made it challenging to discern his true stance."
                                            },
                                            {
                                                "example_id": "e2868d12-b855-48c4-90a6-4c0472fb6db1",
                                                "sense_id": "e17e0c4e-d213-3182-9369-a2b3a05bc0f3",
                                                "text": "He drove over last Saturday with this English babe that’s in this new picture he’s writing. She was pretty affected, but very good-looking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24225785-4582-3132-8915-1013b38bee99",
                                        "entry_id": "6b564553-b30b-38b9-8cc5-82f10e68c36c",
                                        "glosses": [
                                            "Emotionally moved; touched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
