{
    "word_family": [
        "вопросительный",
        "вопрошать",
        "вопрошающий"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "999d2f51-2c84-3d89-b3c0-fd4f3b06e807",
                    "sense_definition": "высказывание, обращение к кому-либо для получения ответа или информации",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня́ есть один <w>вопрос</w> к учителю.",
                            "target_lang_translations": {
                                "en": "I have one <w>question</w> for the teacher.",
                                "zh": "我有一个<w>问题</w>要问老师。"
                            }
                        },
                        {
                            "text": "Студент задал сложный <w>вопрос</w> во время лекции.",
                            "target_lang_translations": {
                                "en": "The student asked a difficult <w>question</w> during the lecture.",
                                "zh": "学生在讲座期间提出了一个复杂的<w>问题</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "задать вопрос"
                    ],
                    "target_lang_definitions": {
                        "en": "A sentence, phrase, or word used to ask for information, a reply, or a response.",
                        "zh": "用于请求信息、回复或回应的句子、短语或词语。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "question",
                                "target_lang_sense_clarification": "A request for information or a response."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问题",
                                "target_lang_sense_clarification": "指需要回答的疑问。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aca97f4-6c4c-3f14-b7e2-ed57a34200c1",
                    "sense_definition": "важное обстоятельство или дело, требующее внимания",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны обсудить этот важный <w>вопрос</w> сегодня.",
                            "target_lang_translations": {
                                "en": "We must discuss this important <w>matter</w> today.",
                                "zh": "我们今天必须讨论这个重要的<w>问题</w>。"
                            }
                        },
                        {
                            "text": "Я пришел к вам по личному <w>вопросу</w>.",
                            "target_lang_translations": {
                                "en": "I came to see you about a personal <w>matter</w>.",
                                "zh": "我来找你是为了私人的<w>事情</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "дело"
                    ],
                    "common_phrases": [
                        "личный вопрос"
                    ],
                    "target_lang_definitions": {
                        "en": "An important matter, subject, or affair that requires attention or discussion.",
                        "zh": "需要关注或讨论的重要事项、主题或事务。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "matter",
                                "target_lang_sense_clarification": "A subject or situation under consideration."
                            },
                            {
                                "target_lang_word": "issue",
                                "target_lang_sense_clarification": "A topic or subject of concern or debate."
                            },
                            {
                                "target_lang_word": "business",
                                "target_lang_sense_clarification": "A matter or affair that concerns someone."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "事情",
                                "target_lang_sense_clarification": "指需要处理的事务。"
                            },
                            {
                                "target_lang_word": "问题",
                                "target_lang_sense_clarification": "指讨论的主题或议题。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "555e278a-7897-3238-9adc-b01d5a6c044c",
                    "sense_definition": "сложная задача или проблема, требующая решения",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Экологический <w>вопрос</w> сейчас очень актуален для города.",
                            "target_lang_translations": {
                                "en": "The environmental <w>issue</w> is very relevant for the city right now.",
                                "zh": "环境<w>问题</w>对这座城市来说现在非常紧迫。"
                            }
                        },
                        {
                            "text": "Решение этого <w>вопроса</w> займет много времени.",
                            "target_lang_translations": {
                                "en": "Solving this <w>problem</w> will take a lot of time.",
                                "zh": "解决这个<w>问题</w>需要很长时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "проблема"
                    ],
                    "common_phrases": [
                        "решить вопрос"
                    ],
                    "target_lang_definitions": {
                        "en": "A complex task, challenge, or problem that needs to be solved.",
                        "zh": "需要解决的复杂任务、挑战或难题。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "problem",
                                "target_lang_sense_clarification": "A difficulty that needs to be resolved."
                            },
                            {
                                "target_lang_word": "issue",
                                "target_lang_sense_clarification": "A difficult situation or concern."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问题",
                                "target_lang_sense_clarification": "指需要解决的困难或难题。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14a94456-4c6c-30a7-9f6a-f94ae6aedf4d",
                    "sense_definition": "знак препинания, ставящийся в конце предложения",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В конце предложения нужно поставить <w>вопрос</w>.",
                            "target_lang_translations": {
                                "en": "You need to put a <w>question mark</w> at the end of the sentence.",
                                "zh": "句末需要加上一个<w>问号</w>。"
                            }
                        },
                        {
                            "text": "Учитель попросил исправить <w>вопрос</w> в тетради.",
                            "target_lang_translations": {
                                "en": "The teacher asked to correct the <w>question mark</w> in the notebook.",
                                "zh": "老师要求修改笔记本里的<w>问号</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вопросительный знак"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи для обозначения знака препинания"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A punctuation mark (?) used at the end of an interrogative sentence.",
                        "zh": "用于疑问句末尾的标点符号（?）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "question mark",
                                "target_lang_sense_clarification": "The specific punctuation mark used to indicate a question."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问号",
                                "target_lang_sense_clarification": "指表示疑问的标点符号。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
