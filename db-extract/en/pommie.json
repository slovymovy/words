                        "examples": [
                            {
                                "example_id": "0f5c0548-a653-4a5c-b25e-e86ac56bc069",
                                "sense_id": "2544a8fd-071d-33a2-8a5b-addaab0b48b3",
                                "text": "“It′ll be a long time before I do that,” the pilot said grimly. “She′s my Queen as well as yours, you know. I′m not a bloody Pommie.”[…]“Too right, it′s difficult,” the Australian said. And then he added, “All Pommies aren′t bloody. I used that as a kind of figure of speech.”"
                            },
                            {
                                "example_id": "0515ad5d-15f3-464e-9f56-6f6ae6fb66a1",
                                "sense_id": "2544a8fd-071d-33a2-8a5b-addaab0b48b3",
                                "text": "A Pommie. They were sending him to England to work with a Pommie. After all that he had done for this country they were shipping him off to a cold, rain-infested, windy little isle to work a case with a Pommie."
                            },
                            {
                                "example_id": "271931fc-3dcd-4ccc-838c-c626ec50f313",
                                "sense_id": "2544a8fd-071d-33a2-8a5b-addaab0b48b3",
                                "text": "There are a lot of Pommies in Australia; travelling round, looking for work, and Dad reckoned you could pay them peanuts.[…]If Sissy couldn′t go back to school, I thought she should help out more, then we wouldn′t have to hire a Pommie house girl."
                            }
                        ]
                    }
