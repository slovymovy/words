                "senses": [
                    {
                        "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                        "entry_id": "55e49f9a-3ecf-32ee-a226-24628fe42e9b",
                        "glosses": [
                            "Regulierung der Feuchtigkeit, insbesondere des Schweißes; Eigenschaft (von Stoffen, Materialien und Produkten wie Kleidung, Schuhen), die Feuchtigkeit (den Schweiß) aufzunehmen, abzuleiten und schnell verdunsten zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15efd12-6b58-4c10-ac97-1788607b29c9",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Die DRI-FIT Technologie sorgt für eine sehr gute Atmungsaktivität und optimales Feuchtigkeitsmanagement – für schweißfreies Mitfiebern.“"
                            },
                            {
                                "example_id": "6ed985fa-4919-46bf-b577-2b45a3213c47",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Das ausgeklügelte Feuchtigkeitsmanagement hält Deine Haut angenehm trocken.“"
                            },
                            {
                                "example_id": "1bf47c41-3c37-4036-a1c2-6146f815ef8f",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Es besteht aus unglaublich leichtem, offenem Mesh-Gewebe und bietet somit optimales Feuchtigkeitsmanagement und ein angenehm trockenes Tragegefühl.“"
                            },
                            {
                                "example_id": "5fa0176f-8f2e-4f6a-9083-e2d158f4f476",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Sehr atmungsaktive und geruchshemmende Wanderleggings mit aktivem Feuchtigkeitsmanagement und Handytasche“"
                            },
                            {
                                "example_id": "405328a0-ea59-4c08-9c46-333326724152",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Eine effektive Belüftung unterstützt das Feuchtigkeitsmanagement, indem sie den Luftstrom ermöglicht und Feuchtigkeit von der Haut ableitet.“"
                            },
                            {
                                "example_id": "ac3e4446-c11a-4cc6-ae6d-7cf59d9c4848",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Die Lyocell-Faser bietet ein hervorragendes Feuchtigkeitsmanagement und bietet daher eine bessere Regulierung des Schlafklimas als z.B. Baumwolle.“"
                            },
                            {
                                "example_id": "208e5a2d-f503-4e3c-8efa-a07842819b78",
                                "sense_id": "6f8caa61-3fcc-3d16-8111-35bfec5ce5c4",
                                "text": "„Kombination aus Stabilität und Spitzen-Komfort Unser hochwertiges Kissen ist jeweils mit Daunen und Federn gefüllt und bieten Ihnen ein gutes Liegegefühl, ebenso haben Sie ein optimales Feuchtigkeitsmanagement.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
