                "senses": [
                    {
                        "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                        "entry_id": "b69f0aec-9fc2-36c1-94b3-6fab11abd6de",
                        "glosses": [
                            "in Ostasien als Brennkraut verwendete Beifußwolle"
                        ],
                        "tags": [
                            "TCM",
                            "Naturheilmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "339cb52a-bdb3-4a3f-9e29-fc2568111d7a",
                                "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                "text": "„Nun brannte die alte Liu dem Kinde über den Augenbrauen, auf dem Nacken, in den Fingergelenken der Hände und auf der Herzgrube insgesamt fünf Moxen ab und legte es dann zum Schlafe nieder.“"
                            },
                            {
                                "example_id": "eeed8ac7-210e-49a3-99bb-ae6768956831",
                                "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                "text": "„Im Gesicht ist Moxa ebenfalls kontraindiziert. Die einzige Ausnahme ist der Punkt Yìntáng auf der Stirn zwischen den Augenbrauen. Die Geschlechtsteile sind generell nicht mit Moxa zu behandeln. Während der Menstruation kein Moxa!“"
                            },
                            {
                                "example_id": "1d535987-1524-43a4-a745-5001791a704b",
                                "sense_id": "96ccab3f-6f38-34e4-89ac-89a39fb341d8",
                                "text": "„Im Bian Gue Shin Shu heißt es: „Dringen Kälte und Wind in den Körper ein, behandle mit Moxa.“ Und im Lingshu wird formuliert: „Was die Nadel nicht zu heilen vermag, dagegen wirkt das Brennen (= Moxa).“ “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac894deb-fce0-302f-bc2d-696d21176520",
                        "entry_id": "b69f0aec-9fc2-36c1-94b3-6fab11abd6de",
                        "glosses": [
                            "Moxibustion"
                        ],
