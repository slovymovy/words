                    "frequency": "Low",
                    "semantic_group_id": "overtuigend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De partij behaalde een <w>riante</w> overwinning bij de verkiezingen.",
                            "target_lang_translations": {
