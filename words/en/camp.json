                        ],
                        "zh": [
                            {
                                "target_lang_word": "夏令营",
                                "target_lang_sense_clarification": "暑期组织的活动"
                            },
                            {
                                "target_lang_word": "训练营",
                                "target_lang_sense_clarification": "以技能训练为目的的活动"
                            }
                        ]
                    }
                },
                {
