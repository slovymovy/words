                                "pl": "Załóż kurtkę, bo inaczej <w>zmokniesz</w> na deszczu.",
                                "de": "Zieh eine Jacke an, sonst wirst du im Regen <w>nass</w>.",
                                "fr": "Mets un manteau, sinon tu vas être <w>mouillé</w> sous la pluie.",
                                "it": "Mettiti una giacca, altrimenti ti <w>bagnerai</w> sotto la pioggia.",
                                "cs": "Vezmi si bundu, jinak v dešti <w>zmokneš</w>.",
                                "tr": "Bir ceket giy, yoksa yağmurda <w>ıslanırsın</w>.",
                                "es": "Ponte una chaqueta, de lo contrario te vas a <w>mojar</w> en la lluvia."
                            }
                        },
                        {
                            "text": "Hij maakte de tafel schoon met een <w>natte</w> doek.",
                            "target_lang_translations": {
                                "en": "He cleaned the table with a <w>wet</w> cloth.",
                                "ru": "Он вытер стол <w>мокрой</w> тряпкой.",
                                "pl": "Wytarł stół <w>mokrą</w> szmatką.",
                                "de": "Er machte den Tisch mit einem <w>nassen</w> Tuch sauber.",
                                "fr": "Il a nettoyé la table avec un chiffon <w>mouillé</w>.",
                                "it": "Ha pulito il tavolo con un panno <w>bagnato</w>.",
                                "cs": "Uklidil stůl <w>mokrým</w> hadrem.",
                                "tr": "Masayı <w>ıslak</w> bir bezle temizledi.",
                                "es": "Él limpió la mesa con un paño <w>mojado</w>."
                            }
                        }
