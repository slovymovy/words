                "senses": [
                    {
                        "sense_id": "91e25fbb-fdf3-3785-aa4f-4b8a9f36d569",
                        "entry_id": "c796ba73-2379-3172-887c-59e6dc234afe",
                        "glosses": [
                            "Cheminot manœuvrant des wagons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155c26c9-cd31-413b-8080-32d347c5eb52",
                                "sense_id": "91e25fbb-fdf3-3785-aa4f-4b8a9f36d569",
                                "text": "L’on manœuvre ces leviers au moyen de cordes passant sur des moufles, et chaque wagonnier peut enrayer de la sorte les roues de deux wagons."
                            },
                            {
                                "example_id": "ac121070-96b9-4e03-864a-4c8374ee75ec",
                                "sense_id": "91e25fbb-fdf3-3785-aa4f-4b8a9f36d569",
                                "text": "Le wagonnier, pendant que le second wagon se remplit, conduit le premier dans la cuve du vigneron."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce510f12-888f-3d85-aaf9-b8e93b352aba",
                        "entry_id": "c796ba73-2379-3172-887c-59e6dc234afe",
                        "glosses": [
                            "Galibot, préposé à la conduite et à la manœuvre des wagonnets dans les mines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6558fe63-d797-4ba4-9920-b9e6499f428e",
                                "sense_id": "ce510f12-888f-3d85-aaf9-b8e93b352aba",
                                "text": "Il était wagonnier dans une mine de charbon à Dortmund, où Henri naquit en 1920, et il décéda peu après de la tuberculose."
                            }
                        ]
                    }
                ],
