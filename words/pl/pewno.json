                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dzbanie było <w>pewno</w> świeżej wody ze studni.",
                            "target_lang_translations": {
                                "ru": "В кувшине было <w>полно</w> свежей колодезной воды.",
                                "en": "There was plenty of fresh water from the well in the jug.",
                                "nl": "In de kruik zat <w>vol</w> vers water uit de put.",
                                "de": "Im Krug war <w>voll</w> frisches Wasser aus dem Brunnen.",
                                "fr": "Il y avait <w>plein d'</w>eau fraîche de puits dans la cruche.",
