                        "source_sense_id": "fb9c3bde-5f9b-3630-b374-16eb70e3c394",
                        "source_sense_description": "sterke emoties van schok en ontzetting oproepend",
                        "target_lang_word": "herzzerreißend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzzerreißend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7df6aec7-83a9-30b6-ad93-aca741ba5912",
                                        "entry_id": "687d2803-8a0f-3a9c-9c7e-7d3aa938e2b1",
                                        "glosses": [
                                            "tiefstes Mitgefühl erweckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe194e6-3e67-41ee-938b-12b386f6fe55",
                                                "sense_id": "7df6aec7-83a9-30b6-ad93-aca741ba5912",
                                                "text": "Am Ende von Titanic musste ich weinen, weil es so herzzerreißend war!"
                                            },
                                            {
                                                "example_id": "f95d92fc-2c9e-4a1c-b788-bf1531528183",
                                                "sense_id": "7df6aec7-83a9-30b6-ad93-aca741ba5912",
                                                "text": "Der arme Hund war angefahren worden. Es war so herzzerreißend, als der Arzt ihn einschläferte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01dd01b-4583-4ae0-af83-bebf2b807d1f",
                        "source_entry_id": "ba6268bf-95ff-3b6a-86fe-34bef0c815bd",
                        "source_sense_id": "fb9c3bde-5f9b-3630-b374-16eb70e3c394",
                        "source_sense_description": "sterke emoties van schok en ontzetting oproepend",
                        "target_lang_word": "heart-rending",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heart-rending",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "133403f1-c977-3110-abfe-510c5ad4b134",
                                        "entry_id": "8f7821db-37de-30c5-8c69-703d71d6b4d3",
                                        "glosses": [
                                            "Alternative form of heartrending."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a0e5f72-598a-4db6-9671-a47e354ec99b",
                                                "sense_id": "133403f1-c977-3110-abfe-510c5ad4b134",
                                                "text": "With much delicacy, avoiding to instance in her self-experience, she told me, that so long ago as when she used to play the part of the Little Son to Mrs. Porter’s Isabella, (I think it was) when that impressive actress has been bending over her in some heart-rending colloquy, she has felt real hot tears come trickling from her, which (to use her powerful expression) have perfectly scalded her back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53119816-13b4-41e3-9ace-33ca2b7588b9",
                        "source_entry_id": "ba6268bf-95ff-3b6a-86fe-34bef0c815bd",
                        "source_sense_id": "fb9c3bde-5f9b-3630-b374-16eb70e3c394",
                        "source_sense_description": "sterke emoties van schok en ontzetting oproepend",
                        "target_lang_word": "déchirant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déchirant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39964253-0bd2-3cda-a4d8-91009033d0d5",
                                        "entry_id": "7f443956-cdd7-3880-a675-7168001a024f",
                                        "glosses": [
                                            "Qui déchire le cœur, l'âme, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577dbcb8-ad0d-410d-bac3-60d411efeb18",
                                                "sense_id": "39964253-0bd2-3cda-a4d8-91009033d0d5",
                                                "text": "Un spectacle déchirant. - Des cris déchirants. - Une situation déchirante. - Des remords déchirants."
                                            },
                                            {
                                                "example_id": "8bb8e85f-ed42-4299-995c-c488decec610",
                                                "sense_id": "39964253-0bd2-3cda-a4d8-91009033d0d5",
                                                "text": "Henri se pinça au travers de la jambe de son pantalon pour s’assurer qu’il n’était pas la proie d’un rêve… Non, elle vivait, elle parlait, c’était une jeune Anglaise d’une beauté déchirante, tout à fait cela, oui, déchirante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déchirant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30112215-4898-328d-9bdb-77d347f233e4",
                                        "entry_id": "48e32615-0c0b-39d8-ba35-27b510cd9ca6",
                                        "glosses": [
                                            "Participe présent de déchirer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad45b4ec-a1e2-4b94-a0db-3df6d3cc1356",
                                                "sense_id": "30112215-4898-328d-9bdb-77d347f233e4",
                                                "text": "Il appuya sa tête livide sur l’épaule de la jeune femme, et ses doigts crispés se cramponnèrent, en la déchirant, à la fine batiste brodée qui couvrait d’un flot de gaze le corps de Marguerite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3121d474-f0b9-49c5-a5de-9d5f85de26c7",
                        "source_entry_id": "ba6268bf-95ff-3b6a-86fe-34bef0c815bd",
