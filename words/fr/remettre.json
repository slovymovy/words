            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93847955-8447-3747-b75d-1878e0e8021c",
                    "sense_definition": "Replacer une chose à l'endroit où elle se trouvait auparavant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "placement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>remettre</w> les livres sur l'étagère après les avoir lus."
                        },
                        {
                            "text": "Elle <w>remet</w> toujours ses clés dans le tiroir de l'entrée en rentrant."
                        }
                    ],
                    "common_phrases": [
                        "remettre en place",
                        "remettre à sa place"
                    ]
                },
                {
                    "sense_id": "c78e9b45-df3c-3871-877c-abc39b2a8b29",
                    "sense_definition": "Enfiler ou porter de nouveau un vêtement ou un accessoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait froid dehors, tu devrais <w>remettre</w> ton manteau avant de sortir."
                        },
                        {
                            "text": "Elle <w>remet</w> ses lunettes pour lire attentivement les petites lignes."
                        }
                    ],
                    "common_phrases": [
                        "remettre son manteau",
                        "remettre ses chaussures"
                    ]
                },
                {
                    "sense_id": "7041c483-dd4f-3f8a-a3c0-f9e3714d8e64",
                    "sense_definition": "Donner ou livrer quelque chose à la personne à qui elle est destinée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur va <w>remettre</w> les diplômes aux étudiants lors de la cérémonie officielle."
                        },
                        {
                            "text": "Veuillez <w>remettre</w> cette lettre en mains propres au responsable du service."
                        }
                    ],
                    "common_phrases": [
                        "remettre un prix",
                        "remettre en mains propres",
                        "remettre un document"
                    ]
                },
                {
                    "sense_id": "0985b3d0-1c45-3014-a095-25c09a296bbc",
                    "sense_definition": "Différer une action ou reporter un événement à une date ultérieure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>remettre</w> la réunion à la semaine prochaine en raison d'un imprévu."
                        },
                        {
                            "text": "Il ne faut jamais <w>remettre</w> à demain ce qu'on peut faire le jour même."
                        }
                    ],
                    "common_phrases": [
                        "remettre à demain",
                        "remettre à plus tard",
                        "remettre à la semaine prochaine"
                    ]
                },
                {
                    "sense_id": "96f6f9e6-dbf5-37db-a6a9-71817ee51664",
                    "sense_definition": "Retrouver la santé, ses forces ou sa sérénité après une maladie ou une épreuve.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "retablissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fallu plusieurs semaines au patient pour se <w>remettre</w> de cette mauvaise grippe."
                        },
                        {
                            "text": "Après cette triste nouvelle, elle a eu beaucoup de peine à s'en <w>remettre</w>."
                        }
                    ],
                    "common_phrases": [
                        "se remettre d'une maladie",
                        "s'en remettre"
                    ]
                },
                {
                    "sense_id": "e76e8ba2-ebff-343e-ac68-8dd59b6dd318",
                    "sense_definition": "Recommencer à pratiquer une activité après une interruption.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recommencement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une courte pause café, les ouvriers vont se <w>remettre</w> au travail."
                        },
                        {
                            "text": "Je compte me <w>remettre</w> au sport dès le début du mois prochain."
                        }
                    ],
                    "common_phrases": [
                        "se remettre au travail",
                        "se remettre au sport"
                    ]
                },
                {
                    "sense_id": "45a529aa-45db-358f-a1a2-5fa520171822",
                    "sense_definition": "Reconnaître ou identifier quelqu'un ou quelque chose qu'on a déjà vu dans le passé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son visage m'est très familier, mais je n'arrive pas à le <w>remettre</w> exactement."
                        },
                        {
                            "text": "Est-ce que tu me <w>remets</w> ou as-tu oublié notre rencontre à Lyon l'été dernier ?"
                        }
                    ],
                    "common_phrases": [
                        "remettre quelqu'un",
                        "remettre un visage"
                    ]
                },
                {
                    "sense_id": "5792a290-47e6-3dff-8a86-247fd7293cfb",
                    "sense_definition": "Rejeter par la bouche le contenu de l'estomac.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant était tellement barbouillé en voiture qu'il a fini par tout <w>remettre</w>."
                        },
                        {
                            "text": "Après avoir mangé ce poisson avarié, il s'est senti mal et a failli <w>remettre</w>."
                        }
                    ],
                    "synonyms": [
                        "rendre"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé familièrement au sens de vomir"
                        }
                    ]
                }
            ]
        }
    ]
