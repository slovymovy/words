                                "target_senses": [
                                    {
                                        "sense_id": "5d9a05a6-f1de-3e95-a0d3-835f5c2c48b8",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The act of reflecting or the state of being reflected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04accaef-5b08-3a53-8d65-2dc9e3f535d9",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The property of a propagated wave being thrown back from a surface (such as a mirror)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "Something, such as an image, that is reflected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f049bd06-037c-4698-8e82-5855b570b943",
                                                "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                                "text": "The dog barked at his own reflection in the mirror."
                                            },
                                            {
                                                "example_id": "fada00df-0069-4381-b16b-ac431e3f859f",
                                                "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                                "text": "A body of black that carried no reflection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "Careful thought or consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642fc9da-1073-467f-bfcc-1aca32e4159d",
                                                "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                                "text": "After careful reflection, I have decided not to vote for that proposition."
                                            },
                                            {
                                                "example_id": "c2e42dd5-b911-4dc2-a15a-9dfd14287fe4",
                                                "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "A representative manifestation or outcome of a condition, trend or trait."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5a0e80-9377-4914-80f6-d2ca735cab39",
                                                "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                                "text": "Our recent results are a reflection of the progress we've made as a team."
                                            },
                                            {
                                                "example_id": "8596d24a-1480-4e82-a4ed-e8d67d373d28",
                                                "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                                "text": "Zuckerberg said last month that the name change was a reflection of how much Facebook had evolved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "A representative manifestation or outcome of a condition, trend or trait.",
                                            "Used to make an implied criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209d4a4b-ef36-4d22-b4b1-6eb9e33dd7fb",
                                                "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                                                "text": "It is a reflection on his character that he never came back to see them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The process or mechanism of determining the capabilities of an object at run-time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f713b35-1477-44de-b3e2-dc9a724c2e46",
                                                "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                                                "text": "DynamicMBeanFacade uses Java's reflection API to introspect the managed resource and discover data type information for attributes."
                                            }
                                        ]
                                    },
                                    {
