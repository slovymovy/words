                            },
                            {
                                "target_word": "convertisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ffb69c-ffcf-31a0-8712-0ad32e9e0bd6",
                                        "entry_id": "d53691b9-ce94-3a6a-879e-726640f5b1bb",
                                        "glosses": [
                                            "Machine électrique destinée à changer les caractéristiques d’un courant électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81f50c6-db3c-4046-9b12-250a61350261",
                                                "sense_id": "f0ffb69c-ffcf-31a0-8712-0ad32e9e0bd6",
                                                "text": "Le site belfortain de General Electric a fabriqué le convertisseur du parc hydrolien de Paimpol-Bréhat …. En pénétrant dans notre convertisseur, cette énergie va être transformée plusieurs fois pour cheminer le long du câble sous-marin en courant continu haute tension …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f503a1c9-6f2a-37f2-9330-377c56301e7a",
                                        "entry_id": "d53691b9-ce94-3a6a-879e-726640f5b1bb",
                                        "glosses": [
                                            "Réacteur chimique industriel où les impuretés contenues dans un métal en fusion sont oxydées pour obtenir un métal affiné"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e3b1fd0-9d67-34ce-964d-748e816ccbd5",
                                        "entry_id": "d53691b9-ce94-3a6a-879e-726640f5b1bb",
                                        "glosses": [
                                            "Celui qui opère ou s’efforce d’opérer des conversions religieuses."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ebf0ada-6cfe-44da-bdfc-b0a6f0cb2d63",
                                                "sense_id": "4e3b1fd0-9d67-34ce-964d-748e816ccbd5",
                                                "text": "Du moins, on m’a conté que monseigneur Martha, un grand convertisseur, ne le quitte plus."
                                            },
                                            {
                                                "example_id": "162479fb-37d9-407e-a574-ee97c5840c13",
                                                "sense_id": "4e3b1fd0-9d67-34ce-964d-748e816ccbd5",
                                                "text": "Mais les succès de ces convertisseurs bénévoles devaient être considérables, à en juger par les récriminations qu'il souleva de la part des auteurs des Évangiles et par les flèches que leur décochent les satiriques latins, …"
                                            },
                                            {
                                                "example_id": "7d653ffc-0b5e-480f-a167-19b8666fa5a4",
                                                "sense_id": "4e3b1fd0-9d67-34ce-964d-748e816ccbd5",
                                                "text": "Déconvertis par leur convertisseur… oui, j’en ai connu plus d’un."
                                            },
                                            {
                                                "example_id": "78f79f39-df65-4c14-935d-6ff9c2ac15f5",
                                                "sense_id": "4e3b1fd0-9d67-34ce-964d-748e816ccbd5",
                                                "text": "Il y va aussi d’un désintérêt pour La Comédie humaine au profit de La Divine Comédie — car somme toute, Sue n’ignore pas l’art tout balzacien d’« individualiser le type » et de « typiciser l’individu » : il le traite seulement à sa façon, substituant par exemple à la physiognomonie l’imagerie démoniaque familière aux sermonnaires et convertisseurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
