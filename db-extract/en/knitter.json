                "senses": [
                    {
                        "sense_id": "e23d05d0-9685-3341-bbc7-bb10d21bb5fa",
                        "entry_id": "b56e55b8-d7d3-3054-8dab-991f6d7e144e",
                        "glosses": [
                            "A person or a machine that knits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c17107-59fa-4150-985f-f4696ba3ad1f",
                                "sense_id": "e23d05d0-9685-3341-bbc7-bb10d21bb5fa",
                                "text": "“Ave! Old knitter of black wool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "254f8bfa-ba2d-49e1-bbf0-62e574130771",
                        "source_entry_id": "b56e55b8-d7d3-3054-8dab-991f6d7e144e",
                        "source_sense_id": "e23d05d0-9685-3341-bbc7-bb10d21bb5fa",
                        "source_sense_description": "one who knits",
                        "target_lang_word": "tricoteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7559ebf-a8dd-369b-b8b4-56105b857d4f",
                                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                                        "glosses": [
                                            "Ouvrier ou artisan qui tricote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82cd7552-ae9d-4601-8a56-26f0e5765417",
                                                "sense_id": "d7559ebf-a8dd-369b-b8b4-56105b857d4f",
                                                "text": "« À l'orée des année 1930. ,... nous vivions au premier. Mon père, tricoteur, avait son atelier au rez de chaussée. J'étais fasciné par les bobines, les écheveaux de laine brute de toutes les couleurs »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90fec1bf-764d-3667-811c-567cb5e70ff3",
                                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                                        "glosses": [
                                            "Homme qui sur les trains de bois, se démène avec les jambes pour assurer la flottaison."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61b56f09-8b59-4fb1-b01d-c48135a93c24",
                                                "sense_id": "90fec1bf-764d-3667-811c-567cb5e70ff3",
                                                "text": "À la vérité, mes deux cousins, par leur mérite personnel, s'étaient élevés à l'emploi de facteurs, ce qui les avait tirés de la classe des tricoteurs, qu'ils commandaient; leurs voyages étaient payés comme pour un trayeur, à chacun des dix trains, descendant à Paris qui étaient sous leur inspection, et ils faisaient bien leurs affaires. , Bibliothèque de la Pléiade, Tome 1, p. 743."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17102ba2-8720-3a4d-85b4-b4b4c87f2db9",
                                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                                        "glosses": [
                                            "Celui qui fait des déplacements, des mouvements rapides."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47424fb9-04e8-4df2-9e24-7761cfdfaf26",
                                                "sense_id": "17102ba2-8720-3a4d-85b4-b4b4c87f2db9",
                                                "text": "Contrôle de la rondelle [de hockey], tricoteur, un peu tiède à visiter les coins et se poster devant le filet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581c809f-6b8f-3a91-8d0c-31ee841ae317",
                                        "entry_id": "60c3d4ab-efc2-352b-899e-3d2d94466c8f",
                                        "glosses": [
                                            "Celui qui fait des associations de notes de musiques, d’idées, de mots qui semblent construits, structurés et réguliers comme un tricot."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f7a3d35-99fd-4b9b-854d-fd6c5057bdd2",
                                                "sense_id": "581c809f-6b8f-3a91-8d0c-31ee841ae317",
                                                "text": "Autour de Pascal Bouaziz, guitariste et chanteur, tricoteur de mots, on retrouve … et l’on assiste à quelque chose de rare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f2f3178-295a-4c04-8442-32f0bab21372",
                        "source_entry_id": "b56e55b8-d7d3-3054-8dab-991f6d7e144e",
                        "source_sense_id": "e23d05d0-9685-3341-bbc7-bb10d21bb5fa",
                        "source_sense_description": "one who knits",
                        "target_lang_word": "tricoteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricoteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd8a5ee-c48c-38ff-8080-853bf6b1969e",
                                        "entry_id": "94aaaf72-258b-382c-bebb-95a12544e7a4",
                                        "glosses": [
                                            "Femme qui tricote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f2a89c4-2242-4ad7-8cce-0c875377db9f",
                                                "sense_id": "bfd8a5ee-c48c-38ff-8080-853bf6b1969e",
                                                "text": "Propos de la Tante de Lucie :\nLa tricoteuse a veillé huit jours la vieille et elle s’est mise héritière."
                                            },
                                            {
                                                "example_id": "4c9060df-a58e-4264-b057-d42f439924a0",
                                                "sense_id": "bfd8a5ee-c48c-38ff-8080-853bf6b1969e",
                                                "text": "Jacomard avait trouvé ce seul moyen pour « tuer son bourdon » et ne pas tromper sa fiancée, une tricoteuse à domicile des environs de Verdun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3403d8e7-e5bb-33e4-9557-85ce9002183d",
                                        "entry_id": "94aaaf72-258b-382c-bebb-95a12544e7a4",
                                        "glosses": [
                                            "S’est dit, pendant la Révolution, des femmes du peuple qui assistaient aux séances de la Convention, des assemblées populaires, du tribunal révolutionnaire en apportant leur ouvrage de tricot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b81fef-bdaf-4d2b-86a2-a32f15edef8f",
                                                "sense_id": "3403d8e7-e5bb-33e4-9557-85ce9002183d",
                                                "text": "Il ne manquait pas une seule séance de la Commune et il récitait tous les jours devant la municipalité, aux grands applaudissements des tricoteuses et des sans-culottes, un hymne nouveau."
                                            },
                                            {
                                                "example_id": "dad220a7-cbbd-40a6-bb08-634446510ceb",
                                                "sense_id": "3403d8e7-e5bb-33e4-9557-85ce9002183d",
                                                "text": "Les empereurs qui avaient persécuté les chrétiens, les tricoteuses et les sans-culottes m’apparaissaient comme les plus odieuses incarnations du Mal."
                                            },
                                            {
                                                "example_id": "132f6716-c3ed-4311-b620-102fa2a6fb9e",
                                                "sense_id": "3403d8e7-e5bb-33e4-9557-85ce9002183d",
                                                "text": "28 juin 1941 – Benoîte, qui me voit danser une danse du scalp dans ma chambre, s’amène comme une commère, une tricoteuse, une concierge, et veut m’arracher des mains ma lettre-butin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2240aa66-4075-3c6d-8ea5-02aa8556ae13",
                                        "entry_id": "94aaaf72-258b-382c-bebb-95a12544e7a4",
                                        "glosses": [
                                            "Celle qui fait des déplacements, des mouvements rapides."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdeefb42-eb81-3d38-8b49-014a34f7f78a",
