                    "frequency": "VeryLow",
                    "semantic_group_id": "disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse was limping due to a painful <w>cleft</w> on its leg.",
                            "target_lang_translations": {
