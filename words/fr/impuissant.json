    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b575d874-cf22-3dce-bd09-22019c34c570",
                    "sense_definition": "Qui n'a pas la force, le pouvoir ou les moyens d'agir ou d'empêcher quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à cette terrible catastrophe naturelle, les secours sont restés <w>impuissants</w>."
                        },
                        {
                            "text": "Elle se sentait totalement <w>impuissante</w> devant l'injustice de la décision prise."
                        }
                    ],
                    "antonyms": [
                        "puissant"
                    ],
                    "common_phrases": [
                        "rester impuissant",
                        "se sentir impuissant"
                    ]
                },
                {
                    "sense_id": "914cd71f-a878-3a75-8658-2725dd9e3daf",
                    "sense_definition": "Qui ne produit aucun effet, qui s'avère vain ou inefficace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a laissé éclater une colère <w>impuissante</w> contre la machine en panne."
                        },
                        {
                            "text": "Toutes leurs protestations sont restées des démarches <w>impuissantes</w> sans résultat."
                        }
                    ],
                    "antonyms": [
                        "efficace"
                    ],
                    "common_phrases": [
                        "colère impuissante"
                    ]
                },
                {
                    "sense_id": "25b61b95-5e8a-3786-99f3-21ad1681bb2d",
                    "sense_definition": "En parlant d'un homme, qui est incapable d'accomplir l'acte sexuel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sexualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a expliqué que son traitement pouvait le rendre temporairement <w>impuissant</w>."
                        },
                        {
                            "text": "Cet homme souffrait en silence d'être devenu <w>impuissant</w> après son opération."
                        }
                    ],
                    "common_phrases": [
                        "rendre impuissant"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbe620b0-5227-3719-ba85-36c9f764ac64",
                    "sense_definition": "Personne qui n'a pas les moyens ou le pouvoir d'agir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette crise, le citoyen a souvent l'impression d'être un simple <w>impuissant</w>."
                        },
                        {
                            "text": "Ils refusent d'être traités comme des <w>impuissants</w> et cherchent à s'organiser."
                        }
                    ]
                },
                {
                    "sense_id": "eedb4ab7-2c75-30a6-8b93-aa231b930087",
                    "sense_definition": "Homme atteint d'une incapacité physiologique à réaliser l'acte sexuel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sexualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il redoutait plus que tout d'être considéré comme un <w>impuissant</w>."
                        },
                        {
                            "text": "Ce récit explore la détresse intime d'un <w>impuissant</w> face au jugement des autres."
                        }
                    ],
                    "synonyms": [
                        "babilan"
                    ]
                }
            ]
        }
    ]
}