                                            {
                                                "example_id": "fc9ea9b5-281b-479c-a4b4-f6bfa013d46e",
                                                "sense_id": "6de70f0b-362c-375b-aa25-fedd5624e59d",
                                                "text": "De suerte que el buen piloto debe tener muy entendida su ballestilla como el buen arcabucero su arcabuz, que para dar en el blanco sabe la puntería que le ha de alzar o abajar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "613ac4df-86c9-3886-a4d6-277414be7350",
                                        "entry_id": "2bb616cb-9af2-38ed-81eb-f595e6794120",
                                        "glosses": [
                                            "Habilidad del tirador para dar en el punto que quiere tocar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc154e8-4339-4561-ae8d-7086e7690e02",
                                                "sense_id": "613ac4df-86c9-3886-a4d6-277414be7350",
                                                "text": "siendo derecha, asienta mejor en el pecho, hállase más presto el punto sin bajar la cabeza ni torcer el ojo buscándole, cosa de mucha importancia a la buena puntería."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11d7b6e0-6043-46ff-9faf-72fc34d48bf5",
                        "source_entry_id": "86586144-fef8-32ea-8cb7-619eaec541a8",
                        "target_lang_word": "justesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                        "entry_id": "c2bdc0c8-ab10-3d52-a375-665a58b69b50",
                                        "glosses": [
                                            "Qualité de ce qui est juste, exact, convenable, tel qu’il doit être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "105eb1bf-0e28-482f-869e-6a257e8d7e6c",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "Existe-t-il un type de preuves incontournables qu’il suffirait d’évoquer pour persuader de la justesse de sa position ses opposants les plus tenaces ?"
                                            },
                                            {
                                                "example_id": "d92199c4-8f0b-44c5-b0f1-d0b285084930",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "Cette balance est d’une extrême justesse."
                                            },
                                            {
                                                "example_id": "f0f02aa3-6ddb-454a-8a17-aed4a3288bcf",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "La justesse d’une arme à feu."
                                            },
                                            {
                                                "example_id": "6575c796-8526-4995-bfba-b791cec3012e",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "La justesse de la voix."
                                            },
                                            {
                                                "example_id": "cba3feb5-3b0f-4f88-a7df-c679c2f7a3ac",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "La justesse d’une expression."
                                            },
                                            {
                                                "example_id": "e04645c9-89ac-45aa-bab4-b2d1169c6713",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "La justesse d’une idée, d’une observation, d’un raisonnement."
                                            },
                                            {
                                                "example_id": "db052fe3-843b-47c6-afe0-69ef048e0afe",
                                                "sense_id": "98d7b3f9-db17-3c1e-be3b-d3617416e489",
                                                "text": "Des réflexions pleines de justesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47921b5b-e581-3d6b-ac77-c78ba45cd11d",
                                        "entry_id": "c2bdc0c8-ab10-3d52-a375-665a58b69b50",
                                        "glosses": [
                                            "Manière de faire une chose avec exactitude, avec précision, sans faute ni écart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5e1502-8d3f-4e56-bcb5-8afa589a9280",
                                                "sense_id": "47921b5b-e581-3d6b-ac77-c78ba45cd11d",
                                                "text": "Faisons aimer aux jeunes les justesses et délicatesses grammaticales en les initiant au grotesque et au ridicule des expressions incorrectes."
                                            },
                                            {
                                                "example_id": "ecafbd67-e21f-41d9-94d8-32a349a37b58",
                                                "sense_id": "47921b5b-e581-3d6b-ac77-c78ba45cd11d",
                                                "text": "[…], j'ai entendu une voix féminine qui chantait d'une justesse plus qu'approximative, deux chansons d'une ringardise affligeante, à cent mille lieues de tes goûts musicaux."
                                            },
                                            {
                                                "example_id": "8dc746ee-7eac-439f-a5a5-6cfda8a4b202",
                                                "sense_id": "47921b5b-e581-3d6b-ac77-c78ba45cd11d",
                                                "text": "Il écrit, il pense, il parle avec beaucoup de justesse."
                                            },
                                            {
                                                "example_id": "1165c05b-62c0-4415-9b2d-e54212fe38f2",
                                                "sense_id": "47921b5b-e581-3d6b-ac77-c78ba45cd11d",
                                                "text": "Ce récit a été fait avec une parfaite justesse d’inflexions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e3f7cb-a324-36e6-bb3f-6e6d34452ca3",
                                        "entry_id": "c2bdc0c8-ab10-3d52-a375-665a58b69b50",
                                        "glosses": [
                                            "Qualité qui fait apprécier les choses d’une manière exacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf3be29-bff5-41ee-ad32-d06d3ffd0731",
                                                "sense_id": "06e3f7cb-a324-36e6-bb3f-6e6d34452ca3",
                                                "text": "La justesse de l’oreille."
                                            },
                                            {
                                                "example_id": "bf603673-989d-45d8-b911-89ddf74b2b5f",
                                                "sense_id": "06e3f7cb-a324-36e6-bb3f-6e6d34452ca3",
                                                "text": "La justesse du coup d’œil."
                                            },
                                            {
                                                "example_id": "daee2ba1-cdce-4230-af9f-448aa804540c",
                                                "sense_id": "06e3f7cb-a324-36e6-bb3f-6e6d34452ca3",
                                                "text": "La justesse de l’esprit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
