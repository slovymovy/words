                "senses": [
                    {
                        "sense_id": "b28cb26e-471f-3cc8-8c50-dbb225f348de",
                        "entry_id": "8c8ee14e-9514-3067-8f21-7272902f86c9",
                        "glosses": [
                            "Faire tendre vers le wahabisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0878c1-1803-40a6-ad7a-b90aad336ce7",
                                "sense_id": "b28cb26e-471f-3cc8-8c50-dbb225f348de",
                                "text": "Passant alliance directement avec la dictature militaire (De Numeiri puis de Béchir), en court-circuitant les Confréries, Tourabi rêvait (ou faisait mine de rêver, ne cherchant en fait qu’à asseoir son pouvoir) de «purifier» l’islam historique du pays pour le « wahabiser » (d’où le soutien Saoudi)."
                            },
                            {
                                "example_id": "ee9b12ee-0dcf-46a9-8327-c1d243d466f0",
                                "sense_id": "b28cb26e-471f-3cc8-8c50-dbb225f348de",
                                "text": "Au lieu de «wahabiser» l’Etat, c’est plutôt le pouvoir politique qui va « saoudiser » les religieux wahhabites."
                            }
                        ]
                    }
                ],
