                "senses": [
                    {
                        "sense_id": "ea0fe9fb-d6de-31d0-b21b-ef13322cf601",
                        "entry_id": "ae75e338-a972-3d76-9e09-1185befd741c",
                        "glosses": [
                            "Variante orthographique de grafigner."
                        ],
                        "tags": [
                            "France",
                            "Québec",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "56078bc8-5271-4bd4-b747-c64806bace3c",
                                "sense_id": "ea0fe9fb-d6de-31d0-b21b-ef13322cf601",
                                "text": "Je l’ai graffigné et je lui ai garoché un tabouret sur la goule."
                            },
                            {
                                "example_id": "5bc83396-2f40-4372-ac84-f21b1a324404",
                                "sense_id": "ea0fe9fb-d6de-31d0-b21b-ef13322cf601",
                                "text": "– J’ai vu que tu tombais ! Heureusement qu’il y avait tout ce thym : tu aurais pu te graffigner la figure !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ffa28575-bfc1-365d-a686-1196d54a5af8",
                        "entry_id": "ae75e338-a972-3d76-9e09-1185befd741c",
                        "glosses": [
                            "Érafler, Égratigner, voire griffer."
                        ],
                        "tags": [
                            "Parler gaga"
                        ],
                        "examples": [
                            {
                                "example_id": "554b8a9c-0217-4350-bc99-142dbaeaf6de",
                                "sense_id": "ffa28575-bfc1-365d-a686-1196d54a5af8",
                                "text": "Tu vas finir par me graffigner le bras, que tout le monde va s’imaginer que je me suis battu avec une nichée de chats !"
                            }
                        ]
                    }
