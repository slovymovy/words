                        "glosses": [
                            "государство, управляемое царём или царицей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4529c875-1dd6-472d-bb02-7deec5c18cbc",
                                "sense_id": "42937fb3-4e43-377a-9d70-aec136e12ce9",
                                "text": "Итак сказал: некоторый человек высокого рода отправлялся в дальнюю страну, чтобы получить себе царство и возвратиться…"
                            }
                        ]
