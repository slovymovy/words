                            {
                                "example_id": "2910b15a-c6e1-462b-9d66-a5c9659fe394",
                                "sense_id": "76ab49bf-40a7-3d65-9920-a395a3d0f33c",
                                "text": "Vader en zoon zijn de hoofdpersonen van de film Of Fathers and Sons van de Syrische documentairemaker Talal Derki. De film gaat zaterdag in première tijdens het documentairefestival IDFA. Derki won het vertrouwen van de vader en volgde het gezin ruim twee jaar."
                            }
