                                "example_id": "15fe2c77-f3e2-423c-a1a9-3c00328b5404",
                                "sense_id": "2cf71cd0-c42a-3320-aa6b-c3ccc129bdad",
                                "text": "Powiedziała Dariuszowi o wypadkach w Zamościu i Zielonej Górze."
                            }
