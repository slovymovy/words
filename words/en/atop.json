                                "ru": "Древний замок стоял <w>на вершине</w> крутого холма, возвышаясь над всей долиной."
                            }
                        },
                        {
                            "text": "He placed a bright gold star <w>atop</w> the Christmas tree.",
                            "target_lang_translations": {
                                "ru": "Он поместил яркую золотую звезду <w>на верхушку</w> рождественской елки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sit atop",
                        "perched atop"
                    ],
                    "target_lang_definitions": {
