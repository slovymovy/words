                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e4510985-01bc-4116-9262-4b07d86a3add",
                        "source_entry_id": "0f4b6024-8882-3647-809b-bee7987a5dc9",
                        "source_sense_id": "e20adc53-c873-3337-9e3b-9b65736f4b41",
                        "target_lang_word": "tout-terrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout-terrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73937c0e-2a6e-34bf-9ef6-73b450a6b50e",
                                        "entry_id": "26054402-1136-32f8-822d-abdec8de6fdc",
                                        "glosses": [
                                            "Qualifie un engin qui est conçu pour pouvoir manœuvrer aussi bien sur la route qu’en terrain naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b1d90cc-0ae9-4c80-8d98-5f76654c92d2",
                                                "sense_id": "73937c0e-2a6e-34bf-9ef6-73b450a6b50e",
                                                "text": "Des études sur simulateur (Rudin-Brown, 2004 ; Rudin-Brown et McCurdie, 2004 ; Lee, 1995), ainsi que des études expérimentales, laissent penser que les conducteurs de véhicules tout-terrain, de pick-up et de camionnettes évaluent leur vitesse avec moins de précision, parce qu'ils sont assis plus haut, au-dessus de la chaussée, que les conducteurs de voitures particulières."
                                            },
                                            {
                                                "example_id": "bc5f44dd-91cd-4a4e-81fb-ae70fd810968",
                                                "sense_id": "73937c0e-2a6e-34bf-9ef6-73b450a6b50e",
                                                "text": "Cependant, une voiture tout-terrain est obligatoire pour les sorties dans les wadis, en montagne et dans le désert, et également sur la côte de la région d'Al-Wusta."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tout-terrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c216c965-6a5a-3726-8c85-9045b2eaf621",
                                        "entry_id": "dcdffde8-e89a-3a83-aa21-a410aaaa42b9",
                                        "glosses": [
                                            "Véhicule automobile à transmission intégrale conçu pour pouvoir manœuvrer aussi bien sur la route qu’en terrain naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff31fa31-6399-4fc8-b17a-05d615b11e5e",
                                                "sense_id": "c216c965-6a5a-3726-8c85-9045b2eaf621",
                                                "text": "Les tout-terrains peuvent être une engeance pour les amateurs de plein air."
                                            },
                                            {
                                                "example_id": "7a9d39fd-06b4-42ae-bf07-1a3a0a824752",
                                                "sense_id": "c216c965-6a5a-3726-8c85-9045b2eaf621",
                                                "text": "Je vends des planches, des boards, des rollers, des surfs et des tout-terrains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
