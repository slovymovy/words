                                "example_id": "7d1f3f2e-369b-407b-9b04-85978cf21e4b",
                                "sense_id": "b775e2e7-a0a5-3be4-baba-e0d1ade72b0d",
                                "text": "À Saint-Germain, un escalier dessert tout au plus deux logis par niveau et les « allées » ne sont utilisées systématiquement que pour « désassujetir » les garde-robes."
                            },
                            {
                                "example_id": "6afe14bd-379d-4518-85e4-2462f8da32bf",
                                "sense_id": "b775e2e7-a0a5-3be4-baba-e0d1ade72b0d",
                                "text": "Mais comment se «désassujetir» par rapport au monde ?"
                            }
                        ]
                    }
