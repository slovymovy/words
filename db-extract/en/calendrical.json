    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e99dbb9-1b0b-3285-8f51-3b67ffd48acd",
                "word": "calendrical",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f6131e7-90c0-3561-8482-3a488ed46d0d",
                        "entry_id": "4e99dbb9-1b0b-3285-8f51-3b67ffd48acd",
                        "glosses": [
                            "Of, pertaining to, or used by a calendar system."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "40db6853-cb27-4777-9979-6785dc03d0d8",
                                "sense_id": "9f6131e7-90c0-3561-8482-3a488ed46d0d",
                                "text": "At that point, humanity crosses another threshold, miniaturizes its universe into symbolic form, and takes a toddling step toward iconography, writing, and the first stammerings of calendrical notation and mathematics."
                            },
                            {
                                "example_id": "078e44a2-52ee-40db-b978-4f0d99c25ab2",
                                "sense_id": "9f6131e7-90c0-3561-8482-3a488ed46d0d",
                                "text": "Although other ancient Mesoamerican societies, even in the Preclassic period, also possessed calendars, only the Maya calendar can be translated directly into today's calendrical system."
                            },
                            {
                                "example_id": "257b5b75-ebbe-4b70-aaae-414955e132d8",
                                "sense_id": "9f6131e7-90c0-3561-8482-3a488ed46d0d",
                                "text": "This growing focus on calendrical matters in early modern Europe paralleled, and in some measure directly influenced, a renewed interest among Jews in their own calendar."
                            },
                            {
                                "example_id": "68fee4ba-d979-4281-98c3-8b1636d9c74f",
                                "sense_id": "9f6131e7-90c0-3561-8482-3a488ed46d0d",
                                "text": "In Vietnam, the calendrical system of \"heavenly stems and earthly branches\" sounds quite mystical and foreign, but this lunar calendar can in fact be translated quite simply into a Western calendar year with a formula and a chart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a73b7780-3267-4dd8-a985-c49c61027539",
                        "source_entry_id": "4e99dbb9-1b0b-3285-8f51-3b67ffd48acd",
                        "source_sense_id": "9f6131e7-90c0-3561-8482-3a488ed46d0d",
                        "source_sense_description": "of, pertaining to, or used by a calendar system",
                        "target_lang_word": "calendaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calendaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                        "entry_id": "b6657046-8201-3562-a82a-f45fa637411d",
                                        "glosses": [
                                            "Relatif au calendrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ebab63-edca-44f8-99a1-80f765ca1884",
                                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                                "text": "Année calendaire, période commençant le premier janvier et se terminant le 31 décembre."
                                            },
                                            {
                                                "example_id": "d194726b-0362-43b5-af94-70b6bf263427",
                                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                                "text": "Journée calendaire, période de 24 heures allant de minuit à minuit."
                                            },
                                            {
                                                "example_id": "ab529451-6647-4c73-823c-c1cce444fabc",
                                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                                "text": "Jour calendaire, tout jour de l’année, qu’il soit ouvrable ou férié, ouvré ou chômé."
                                            },
                                            {
                                                "example_id": "a25096bd-c4ee-4d4e-b145-9038c54b455b",
                                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                                "text": "Ainsi, Ricœur introduit un « tiers-temps» qui prend sa pleine expression dans le temps calendaire, en référence au temps du calendrier."
                                            },
                                            {
                                                "example_id": "39fac8a6-735a-4959-b895-e426b073a810",
                                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                                "text": "La stratégie gouvernementale prétend réduire notre dépendance au soja d’Amérique du Sud, responsable de la disparition de millions d’hectares au Brésil et en Argentine, mais ne fixe aucun indicateur quantitatif ou calendaire et n’évoque pas la réduction de la consommation de viande et de produits laitiers, point pourtant indissociable de cette question."
                                            }
                                        ]
                                    }
                                ]
                            },
