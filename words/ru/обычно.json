{
    "word_family": [
        "обычай",
        "обычный",
        "обыкновение",
        "обыденный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f1e3fb8f-cacd-3341-9e80-eb175fb5f69a",
                    "sense_definition": "В большинстве случаев, как это происходит постоянно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>обычно</w> встаю рано утром, чтобы успеть сделать все дела.",
                            "target_lang_translations": {
                                "nl": "Ik sta <w>meestal</w> vroeg in de ochtend op om al mijn taken af te krijgen."
                            }
                        },
                        {
                            "text": "По вечерам мы <w>обычно</w> гуляем в парке рядом с домом.",
                            "target_lang_translations": {
                                "nl": "'s Avonds wandelen we <w>gewoonlijk</w> in het park bij ons huis."
                            }
                        }
                    ],
                    "synonyms": [
                        "как пра́вило",
                        "ча́ще всего́",
                        "как всегда́",
                        "как при́нято",
                        "в поря́дке веще́й",
                        "всё как всегда́",
                        "как во́дится",
                        "привы́чно",
                        "как всегда́ во́дится"
                    ],
                    "antonyms": [
                        "изредка",
                        "никогда"
                    ],
                    "common_phrases": [
                        "как обычно"
                    ],
                    "target_lang_definitions": {
                        "nl": "In de meeste gevallen; zoals het meestal gaat."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "meestal",
                                "target_lang_sense_clarification": "geeft aan dat iets in de meeste gevallen gebeurt"
                            },
                            {
                                "target_lang_word": "gewoonlijk",
                                "target_lang_sense_clarification": "geeft aan dat iets volgens de gewoonte gebeurt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0076b215-522f-3558-9ef6-82c68395d680",
                    "sense_definition": "Так, как происходит в большинстве случаев.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В это время года здесь <w>обычно</w> идет сильный дождь.",
                            "target_lang_translations": {
                                "nl": "In deze tijd van het jaar regent het hier <w>meestal</w> hard."
                            }
                        },
                        {
                            "text": "Автобус <w>обычно</w> приходит по расписанию без опозданий.",
                            "target_lang_translations": {
                                "nl": "De bus komt <w>doorgaans</w> op tijd volgens het schema."
                            }
                        }
                    ],
                    "synonyms": [
                        "чаще всего",
                        "как правило"
                    ],
                    "antonyms": [
                        "необычно"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zoals het in de meeste gevallen plaatsvindt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "meestal",
                                "target_lang_sense_clarification": "geeft aan dat iets in de meeste gevallen gebeurt"
                            },
                            {
                                "target_lang_word": "doorgaans",
                                "target_lang_sense_clarification": "geeft aan dat iets de standaard of regel is"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eb40833-d22d-36ff-ae5d-9857383eea1e",
                    "sense_definition": "Ничем не выделяясь, заурядно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он одевался <w>обычно</w>, не стараясь привлечь к себе внимание.",
                            "target_lang_translations": {
                                "nl": "Hij kleedde zich <w>gewoontjes</w> en probeerde niet de aandacht op zich te vestigen."
                            }
                        },
                        {
                            "text": "Этот день прошел <w>обычно</w>, без каких-либо сюрпризов.",
                            "target_lang_translations": {
                                "nl": "Deze dag verliep <w>normaal</w>, zonder enige verrassingen."
                            }
                        }
                    ],
                    "synonyms": [
                        "заурядно",
                        "привычно"
                    ],
                    "antonyms": [
                        "необычно"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zonder op te vallen; alledaags of saai."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gewoontjes",
                                "target_lang_sense_clarification": "iets dat niet opvallend of bijzonder is"
                            },
                            {
                                "target_lang_word": "normaal",
                                "target_lang_sense_clarification": "iets dat niet afwijkt van het gemiddelde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e6c164e-9927-306c-96c0-da2af3727145",
                    "sense_definition": "Оценочная характеристика ситуации как привычной.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для него <w>обычно</w> опаздывать на важные встречи.",
                            "target_lang_translations": {
                                "nl": "Het is <w>gebruikelijk</w> voor hem om te laat te komen op belangrijke afspraken."
                            }
                        },
                        {
                            "text": "В этой семье <w>обычно</w> собираться за столом по воскресеньям.",
                            "target_lang_translations": {
                                "nl": "In dit gezin is het <w>gebruikelijk</w> om op zondag aan tafel samen te komen."
                            }
                        }
                    ],
                    "synonyms": [
                        "привычно"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een beoordeling van een situatie als zijnde een gewoonte."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gebruikelijk",
                                "target_lang_sense_clarification": "iets dat volgens de gewoonte of traditie is"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0bcf4f3-edb2-3334-9021-96401889de7d",
                    "sense_definition": "Краткая форма среднего рода от прилагательного <w>обычный</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его поведение было <w>обычно</w> для человека в такой ситуации.",
                            "target_lang_translations": {
                                "nl": "Zijn gedrag was <w>gewoon</w> voor iemand in zo'n situatie."
                            }
                        },
                        {
                            "text": "Всё в этом доме было <w>обычно</w> и очень уютно.",
                            "target_lang_translations": {
                                "nl": "Alles in dit huis was <w>gewoon</w> en erg gezellig."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Korte vorm van het bijvoeglijk naamwoord 'gewoon'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gewoon",
                                "target_lang_sense_clarification": "iets dat niet bijzonder of afwijkend is"
                            }
                        ]
                    }
                }
            ]
        }
    ]
