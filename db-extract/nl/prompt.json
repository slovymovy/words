                                "target_senses": [
                                    {
                                        "sense_id": "f3fbd9e4-b203-3097-97ea-28801596c103",
                                        "entry_id": "e1e4b0b4-0d05-3237-bcda-34165a758f39",
                                        "glosses": [
                                            "Punctual or according to schedule; at the planned time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "on time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "978e156a-b384-326d-8932-94a947e95991",
                                        "entry_id": "a6bc039c-8d63-3825-adfd-ccacd79f1f04",
                                        "glosses": [
                                            "Punctually or according to the schedule."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b19173-5814-4b7e-8bb9-a0f9265b5315",
                                                "sense_id": "978e156a-b384-326d-8932-94a947e95991",
                                                "text": "The train arrived on time for the first time this week."
                                            },
                                            {
                                                "example_id": "013b65a8-8936-4e49-9e7c-bb30da2548ef",
                                                "sense_id": "978e156a-b384-326d-8932-94a947e95991",
                                                "text": "A company that makes a fetish of never exceeding the budget invites game-playing and other malarky. It is easy to forget the obvious: that it involves no skill to come in on time and under budget if the schedule and budget are generous enough."
                                            },
                                            {
                                                "example_id": "9eda8277-b043-4cfe-8df0-7c8ea7573fca",
                                                "sense_id": "978e156a-b384-326d-8932-94a947e95991",
                                                "text": "My train arrives on time - an eight-car Class 387. A handful of passengers alight, but not too many board - certainly not enough to warrant eight cars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0f3893b-a057-32d9-9f11-9cb5230ab224",
                                        "entry_id": "a6bc039c-8d63-3825-adfd-ccacd79f1f04",
                                        "glosses": [
                                            "By installments, payments over a period of time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f406ae43-0f06-4a4a-b7de-a3d5ad70dbad",
                                                "sense_id": "e0f3893b-a057-32d9-9f11-9cb5230ab224",
                                                "text": "They bought their dining-room furniture on time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e6d58f1-9748-347e-9936-7a33a3928155",
                                        "entry_id": "a6bc039c-8d63-3825-adfd-ccacd79f1f04",
                                        "glosses": [
                                            "By a player's running out of time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab904744-d9a4-4fa4-b47c-9b3c950709d5",
                                                "sense_id": "1e6d58f1-9748-347e-9936-7a33a3928155",
                                                "text": "Smith beat Jones on time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
