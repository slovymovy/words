                "senses": [
                    {
                        "sense_id": "410d7ea6-783b-3171-8d8d-ba6b95ed0348",
                        "entry_id": "1bb5892e-ec81-3f38-9f47-e91f43540161",
                        "glosses": [
                            "Éteindre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c04db9a-ad2e-4d50-ba31-a5b7268a224c",
                                "sense_id": "410d7ea6-783b-3171-8d8d-ba6b95ed0348",
                                "text": "À l’issue de cet accident d’amour qui, selon Vadim, a « désallumé » pour toujours son étincelle intérieure, sa mère accepte d’envisager des noces."
                            },
                            {
                                "example_id": "803b0661-86a5-4048-be07-fcc1bb44bcfb",
                                "sense_id": "410d7ea6-783b-3171-8d8d-ba6b95ed0348",
                                "text": "Faudrait juste savoir par où commencer pour désallumer l’attente, slaquer le hamster, faire corps avec tout ce qui a de la misère à exister."
                            }
                        ]
                    }
