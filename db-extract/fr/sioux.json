            {
                "entry_id": "aaea2e66-c88f-3dc2-94e4-3d58d58180a0",
                "word": "sioux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7d3dd02-89bf-3a03-8c7f-bcdae0595bfa",
                        "entry_id": "aaea2e66-c88f-3dc2-94e4-3d58d58180a0",
                        "glosses": [
                            "Relatif aux Sioux, qui appartient au peuple des Sioux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d42c4a-2a54-4fe0-9003-837940a3eb08",
                                "sense_id": "e7d3dd02-89bf-3a03-8c7f-bcdae0595bfa",
                                "text": "La catlinite est exploitée principalement dans une carrière située à proximité de la rivière Mississipi, en territoire sioux, […]"
                            },
                            {
                                "example_id": "430c4da9-8a13-466f-8d29-0bc1545fd178",
                                "sense_id": "e7d3dd02-89bf-3a03-8c7f-bcdae0595bfa",
                                "text": "La fête des morts, qui réunit finalement des bandes siouses, saulteuses et cries, au total plus de 2 000 Amérindiens, s'étale sur deux semaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3d82754-d02a-3b6f-8d61-4ed018f41761",
                        "entry_id": "aaea2e66-c88f-3dc2-94e4-3d58d58180a0",
                        "glosses": [
                            "Qui fait preuve d’ingéniosité."
                        ],
                        "tags": [
                            "figuratively",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c7fbd606-9adc-4a9d-bfa2-c2cc84f0f2ef",
                                "sense_id": "b3d82754-d02a-3b6f-8d61-4ed018f41761",
                                "text": "Rédigés de manière tout aussi sioux, d’autres amendements suggèrent de considérer chaque logement de fonction de l’État — celui des préfets compris — comme un HLM."
                            }
                        ]
                    }
                ],
