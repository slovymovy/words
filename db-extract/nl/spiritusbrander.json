                        "examples": [
                            {
                                "example_id": "e8eea23c-6382-406c-b3e3-bea5fa7863cc",
                                "sense_id": "1f25ca40-1eb6-3317-bb82-9a86097f9fa4",
                                "text": "Zelfs de stoom uit de klep van de locomotief steeg met een zangerig gepruttel ten hemel op, als melk die in een kinderkamer op een spiritusbrander aan de kook raakt."
                            },
                            {
                                "example_id": "9edfc693-8aac-4e4f-ad6b-fee19c6d13c6",
                                "sense_id": "1f25ca40-1eb6-3317-bb82-9a86097f9fa4",
                                "text": "Via radiospots, advertenties en de website van de Brandwonden Stichting geeft de organisatie veiligheidstips over het gebruik van kaarsen. Naast deze adviezen geeft de stichting ook veiligheidstips over spiritusbranders, oliebollen bakken en vuurwerk."
                            }
