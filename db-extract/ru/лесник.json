                                        "sense_id": "d5f5a775-3a4b-38a4-8593-aeaa989d2d81",
                                        "entry_id": "3b2527a4-e123-38fe-b11b-00f491de4625",
                                        "glosses": [
                                            "Person, die sich beruflich mit der Pflege des Waldes und den darin lebenden Tieren befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cca5870-70b1-4bc1-a2f7-cc8d159d6648",
                                                "sense_id": "d5f5a775-3a4b-38a4-8593-aeaa989d2d81",
                                                "text": "„Deshalb wurde an der tschechischen Grenze seit 1970 nichts mehr von dem unternommen, was der Forstmann üblicherweise unter Waldhege versteht. Die Bäume, die 1983 bei einem Gewittersturm knickten, blieben liegen, wurden weder abtransportiert noch verbrannt, sondern moderten vor sich hin.“"
                                            }
