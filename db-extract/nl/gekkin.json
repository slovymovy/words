                "senses": [
                    {
                        "sense_id": "478f54bd-cac6-318f-b56d-9e3b50c2f356",
                        "entry_id": "afb131d2-d4c6-33ff-aab1-51408a4c426a",
                        "glosses": [
                            "een mal, gek meisje of vrouw"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "ba231b94-4dd7-49c6-8643-318be50b06b8",
                                "sense_id": "478f54bd-cac6-318f-b56d-9e3b50c2f356",
                                "text": "Dan horen we in voice-over het essay dat een van hen schreef in opdracht van de leraar die hen op hun vrije zaterdag liet nablijven. „U ziet ons, zoals u ons wilt zien, in de eenvoudigste termen (…). U ziet ons als brein, atleet, gekkin, prinses en crimineel.” Allemaal stereotypen die bevestigd worden door de beelden die volgen, waarin de personages een voor een geïntroduceerd worden. Ze hebben slechts één overeenkomst: vervelende ouders."
                            }
                        ]
                    },
                    {
                        "sense_id": "0663d711-5246-37b3-a391-d165864d5c3c",
                        "entry_id": "afb131d2-d4c6-33ff-aab1-51408a4c426a",
                        "glosses": [
                            "een vrouwelijke psychiatrische patiënt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db46bcaf-9357-4570-9fe0-3ad03e8d7bde",
                                "sense_id": "0663d711-5246-37b3-a391-d165864d5c3c",
                                "text": "Zij spookt door mijn hoofd als de gekkin op de zolder van Mr. Rochester in Jane Eyre. De vrouw in de rafelige bruidsjurk."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a0b870f-9ea2-3fbb-9786-418436a835f2",
                        "entry_id": "afb131d2-d4c6-33ff-aab1-51408a4c426a",
                        "glosses": [
                            "Japanse luit"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45f8bba3-3a9d-4d37-a77d-dbb66d48c2fc",
                        "source_entry_id": "afb131d2-d4c6-33ff-aab1-51408a4c426a",
                        "source_sense_id": "478f54bd-cac6-318f-b56d-9e3b50c2f356",
                        "source_sense_description": "een vrouwelijke psychiatrische patiënt",
                        "target_lang_word": "lunatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lunatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                        "entry_id": "29f24dfb-f140-381c-aa6a-1256444accb6",
                                        "glosses": [
                                            "An insane person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e21d48-4081-43e4-80b0-2da56e7f1854",
                                                "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                                "text": "While there are other races (or individuals—heaven forgive me, I am no ethnologist) who think you a criminal or a lunatic unless you carefully plod along from step to step like a hippopotamus out of water."
                                            },
                                            {
                                                "example_id": "c0fdf044-75e6-4630-ae89-61c6bbe7b650",
                                                "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                                "text": "You may be right\nI may be crazy\nOh, but it just may be a lunatic you're looking for"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lunatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "919627e7-ffdf-3c9b-9feb-09f4e64839a4",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Crazed, mad, insane, demented."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Relating to the Moon; lunar."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2370c0cf-bde5-4ceb-bdfa-47f5e8c518cd",
                                                "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                                "text": "As the narrator turns his attention to the moon itself and its Lunatic inhabitants, Heinsius seems to draw on the True History, but is still within the confines of the Icaromenippus."
                                            },
                                            {
                                                "example_id": "70da88a6-946f-4697-8477-726284e1d8be",
                                                "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                                "text": "That or I might bounce off something I hit and head back out into space, become the light in the eye of some lunatic observer, looking up at the big blue ball and seeing me bang something in their retina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3992182-e050-3ccb-acfc-94a759da2e04",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Influenced or affected by the Moon."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd31f492-2b86-4c36-a76a-c0e1d49c3151",
                                                "sense_id": "b3992182-e050-3ccb-acfc-94a759da2e04",
                                                "text": "This I remember: she was false as the lunatic sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
