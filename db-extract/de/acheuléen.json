                ],
                "senses": [
                    {
                        "sense_id": "e44c7564-bd2c-3114-9274-961282ac094c",
                        "entry_id": "2d28df14-5c97-32ed-a181-764a6b07ade6",
                        "glosses": [
                            "eine vorwiegend in Afrika anzutreffende Kulturstufe und Periode der Altsteinzeit, für die der Faustkeil das Charakteristikum ist. Das Acheuléen wird auf die Zeit von 1,5 Million bis 150 Tausend Jahren vor unserer Zeit datiert."
                        ],
                        "tags": [
                            "Vor- und Frühgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "5081773c-3304-4c36-8634-2b1bf2e05980",
                                "sense_id": "e44c7564-bd2c-3114-9274-961282ac094c",
                                "text": "„Zweitens blieben die in den Süden Eurasiens gelangten Menschen bei ihrer Steinbearbeitungstechnik … und hatten keine Kenntnis und keinen Kontakt mit dem Acheuléen. Die Faustkeile des Acheuléen erreichten von Afrika aus nur Ubeidiya am Jordan.“"
                            },
                            {
                                "example_id": "00d01332-b2ee-4102-a188-6a64623d6806",
                                "sense_id": "e44c7564-bd2c-3114-9274-961282ac094c",
                                "text": "„Die Leitform des Acheuléen ist der Faustkeil, der in Afrika vor etwa 1,5 Millionen Jahren (Altsteinzeit) erstmals auftritt, in Europa allerdings deutlich später.“"
                            },
                            {
                                "example_id": "6d53ddfd-73f3-4169-990c-58526c48397d",
                                "sense_id": "e44c7564-bd2c-3114-9274-961282ac094c",
                                "text": "„… Aus gleicher stratigraphischer Position stammen auch in St. Acheul, einem Vorort von Amiens, Funde, die von Gabriel de Mortillet zur Bezeichnung des Acheuléen gewählt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4076e84c-5c55-4b4e-b325-0b7e8f10a5d4",
                        "source_entry_id": "2d28df14-5c97-32ed-a181-764a6b07ade6",
                        "source_sense_id": "e44c7564-bd2c-3114-9274-961282ac094c",
                        "source_sense_description": "Kulturstufe und Periode der Altsteinzeit",
                        "target_lang_word": "Acheulean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acheulean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "443dddec-b1dc-36ab-97c9-c70b4c74ac76",
                                        "entry_id": "988812f3-6b0c-3fc6-9d9c-28f2f42b1407",
                                        "glosses": [
                                            "Of or pertaining to a lower Paleolithic period characterized by the presence of flaked bifacial hand axes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f61c54-f86f-47ac-a00a-ce211d48a381",
                                                "sense_id": "443dddec-b1dc-36ab-97c9-c70b4c74ac76",
                                                "text": "Assuming that language ability extends back to the hominids, we see a slow process of cultural development over millions of years, and then in the Acheulean period of Homo erectus, about three hundred thousand years ago, we find the first engraved tool."
                                            },
                                            {
                                                "example_id": "edc8ca2d-f917-4923-957c-ec1ab506cd3c",
                                                "sense_id": "443dddec-b1dc-36ab-97c9-c70b4c74ac76",
                                                "text": "When early modern humans – the ones who would eventually become us – started to move out of Africa something over a hundred thousand years ago, Acheulean tools were the technology of choice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Acheulean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf3a184-326e-3392-bf2d-fb6942cf5f8c",
                                        "entry_id": "7b613a73-312f-3124-af31-700f2ff1cf84",
                                        "glosses": [
                                            "A lower Paleolithic period characterized by the presence of flaked bifacial hand axes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e21561a4-dd85-4e5c-b4b4-df842ec5037a",
                        "source_entry_id": "2d28df14-5c97-32ed-a181-764a6b07ade6",
                        "source_sense_id": "e44c7564-bd2c-3114-9274-961282ac094c",
