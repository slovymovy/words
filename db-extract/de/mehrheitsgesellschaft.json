                "senses": [
                    {
                        "sense_id": "5c932e66-4974-3f66-bc05-9c8b6466bd83",
                        "entry_id": "855ae642-063f-3c04-abed-3ce4cc94a8c6",
                        "glosses": [
                            "überwiegender Teil der Gesellschaft eines Landes/einer Nation mit ihrer eigenen Kultur und Tradition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744ae7ee-ae30-438c-8481-5be61088fa0a",
                                "sense_id": "5c932e66-4974-3f66-bc05-9c8b6466bd83",
                                "text": "„Parallelgesellschaften sind wichtig und gut sowohl für Einwanderer als auch für die Mehrheitsgesellschaft.“"
                            },
                            {
                                "example_id": "1e50f53f-b604-43e0-95cf-0dc6860bbd93",
                                "sense_id": "5c932e66-4974-3f66-bc05-9c8b6466bd83",
                                "text": "„Und wenn man es genauer betrachtet, zeigt sich auch hier wieder, was bereits in anderen Situationen sichtbar wurde: Eine Teilhabe am Leben der Mehrheitsgesellschaft wird weder gesucht noch eingefordert - nicht nach deren Spielregeln.“"
                            },
                            {
                                "example_id": "d8c5e413-a675-4a4d-b155-2acb43d7012d",
                                "sense_id": "5c932e66-4974-3f66-bc05-9c8b6466bd83",
                                "text": "„Aber immer ist es die Minderheit, die der Mehrheitsgesellschaft das Gesicht der Menschenwürde gibt, bewahrt und dort, wo diese Menschenwürde verloren gegangen ist, erkämpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
