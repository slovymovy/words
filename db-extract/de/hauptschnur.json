                "senses": [
                    {
                        "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                        "entry_id": "6592c1ca-8302-3c46-930b-5c43c1f2a999",
                        "glosses": [
                            "Teil der Angelschnur, der entweder auf der Rolle aufgespult werden kann oder direkt an der Spitze der Angelrute befestigt ist"
                        ],
                        "tags": [
                            "Angelfischerei"
                        ],
                        "examples": [
                            {
                                "example_id": "364646a4-0719-4ffd-a665-a9901fa53c25",
                                "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                                "text": "\"Die Hauptschnur der Nacht- und Grundangeln wird entweder an beyden Enden mit einem Stein versehen, und so in die Tiefe gesenkt, oder […]\""
                            },
                            {
                                "example_id": "375d7ea3-5018-4d9a-8b66-09165ba3277e",
                                "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                                "text": "\"Will man diese Schnur auf den Wurf in klaren und fließenden Gewässern gebrauchen, so nimmt man von der Hauptschnur nur zwei Haare und zu jeder Verästelung ein Haar.\""
                            },
                            {
                                "example_id": "9bb39ba6-d794-4d9a-bb54-06827c0570cd",
                                "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                                "text": "„Die Sportfischer dort knüpfen meist sechs kleine Goldhaken direkt an die Hauptschnur und garnieren sie mit Maden.“"
                            },
                            {
                                "example_id": "570ec20d-0a71-4c63-a777-c153c621fd9a",
                                "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                                "text": "„Bspw. sind Karpfen sehr misstrauisch. Dem wird mit einem sehr unscheinbaren Vorfach begegnet, welches auf Grund gelegt den Köder für den Fisch nicht zur eigentlichen Hauptschnur zugehörig erscheinen lässt.“"
                            },
                            {
                                "example_id": "1981fbec-a4c4-4efc-86a5-b860e1568f78",
                                "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                                "text": "Während des Drills zog der große Hai fast die gesamte Hauptschnur von der Rolle."
                            },
                            {
                                "example_id": "296a7aeb-77d0-4791-96df-6564999b6142",
                                "sense_id": "677b6834-fd79-3f6b-92cb-cac2f9ead554",
                                "text": "Die meisten Angler wählen die Hauptschnur etwas dicker als das Vorfach."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
