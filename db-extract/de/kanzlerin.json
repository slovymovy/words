                "senses": [
                    {
                        "sense_id": "6d2afce4-10a3-3c9d-afc8-43d8d0f64c14",
                        "entry_id": "8e35ecc5-7aef-3c7c-88c9-3583736dfb77",
                        "glosses": [
                            "Regierungschefin eines Staates (zum Beispiel der Bundesrepublik Deutschland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfca61c8-650c-4794-9c17-0b84874548a8",
                                "sense_id": "6d2afce4-10a3-3c9d-afc8-43d8d0f64c14",
                                "text": "„Die Havarie-Reaktoren haben die Kanzlerin zur schnellsten politischen Kehrtwende der Nachkriegsgeschichte bewogen und ihre staunende Union mit einer neuen bürgerlichen Anti-AKW-Bewegung konfrontiert.“"
                            },
                            {
                                "example_id": "2441e40d-0c17-451c-8fd6-9bb1b835ab6d",
                                "sense_id": "6d2afce4-10a3-3c9d-afc8-43d8d0f64c14",
                                "text": "„Von den griechischen Titelseiten blickt mittlerweile nahezu jeden Tag die verkniffene Kanzlerin.“"
                            },
                            {
                                "example_id": "f56135a1-65ea-4eb2-9483-f68a4aa58cf0",
                                "sense_id": "6d2afce4-10a3-3c9d-afc8-43d8d0f64c14",
                                "text": "„Schon im Vorfeld des Treffens hatte die Kanzlerin auf die Bedeutung der kulturellen Angebote hingewiesen.“"
                            },
                            {
                                "example_id": "e6de26de-77b5-43b7-8cda-64863f14f764",
                                "sense_id": "6d2afce4-10a3-3c9d-afc8-43d8d0f64c14",
                                "text": "„Selbst die Kanzlerin hatte ja lange Zeit Gabriel als ihren potentiellen Widersacher im Wahlkampf gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
