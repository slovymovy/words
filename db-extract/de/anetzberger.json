                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd9a275-3781-4c1f-91ca-e0e70c874c56",
                                "sense_id": "80c054ef-bb30-3429-b0df-5ea73c5a39cb",
                                "text": "„Am 2. Mai 1960 begann die Baufirma Anetzberger aus Obernzell mit den Erd- und Bauarbeiten.“"
                            },
                            {
                                "example_id": "4cafe15b-11a0-4469-af74-81bbc78c22ac",
                                "sense_id": "80c054ef-bb30-3429-b0df-5ea73c5a39cb",
                                "text": "„Anetzberger hatte wahrscheinlich geglaubt, der sich nähernde Triebwagen fahre geradeaus nach Freyung und blieb auf der Abzweigung ins Rottaler Gleis stehen.“"
                            },
                            {
                                "example_id": "1d8373a4-3aa9-43b8-b45c-5b82d5d60446",
                                "sense_id": "80c054ef-bb30-3429-b0df-5ea73c5a39cb",
                                "text": "„Kreisrat Anetzberger erklärte, daß nunmehr der Erdaushub am Krankenhaus Obernzell beendet sei und man mit den Betonarbeiten beginne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
