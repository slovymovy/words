                        "glosses": [
                            "van iets of iemand dat hij of zij de goede verzorging heeft ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cc6a4b8-9bf5-4aed-a39a-1bd28ec79b41",
                                "sense_id": "a63d6138-c299-342b-8cf6-c27634a00e1e",
                                "text": "Hij draaide zijn gevulde, goedverzorgde lichaam nog eens om op de verende divan, alsof hij opnieuw voor lange tijd wilde inslapen, omarmde het kussen en drukte er zijn wang tegenaan; maar plotseling richtte hij zich op, hij ging zitten en deed zijn ogen wijd open."
                            },
                            {
                                "example_id": "68036965-a8f4-4aed-bbf3-e21cc3a49d56",
                                "sense_id": "a63d6138-c299-342b-8cf6-c27634a00e1e",
                                "text": "De peuter bezweek korte tijd later in het ziekenhuis. Het jongetje was volgens officier van justitie Eli Gabel 'een vrolijk, energiek jongetje, een goedverzorgd kindje'. Zowel het slachtoffertje als de verdachte zijn van Ghanese origine."
                            }
                        ]
                    }
