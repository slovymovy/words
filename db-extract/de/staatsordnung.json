                ],
                "senses": [
                    {
                        "sense_id": "e4e1cc7c-d233-3201-9825-a4a67cfdf4db",
                        "entry_id": "5d19d2cd-0fec-3e35-a8d2-4946972243d1",
                        "glosses": [
                            "Verfasstheit eines Staates; politisches, gesellschaftliches System eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf64325-0bef-4e32-a670-cdc312796aec",
                                "sense_id": "e4e1cc7c-d233-3201-9825-a4a67cfdf4db",
                                "text": "„Vorbildlich ist vielen Mitgliedern von Arbeitskreisen innerhalb der Linkspartei die untergegangene DDR, die sie als ‚legitimen Versuch‘ einer sozialistischen Staatsordnung werten.“"
                            },
                            {
                                "example_id": "53264741-2d4b-41e1-8878-b1118eaacd56",
                                "sense_id": "e4e1cc7c-d233-3201-9825-a4a67cfdf4db",
                                "text": "„Dementsprechend habe seine Fragerichtung darauf gezielt, wie eine dauerhafte, gute Staatsordnung zu errichten sei und wie die Institutionen konstruiert sein müssten, um dieses Ziel zu gewährleisten.“"
                            },
                            {
                                "example_id": "5456a25b-e031-4451-81a6-298a0479926d",
                                "sense_id": "e4e1cc7c-d233-3201-9825-a4a67cfdf4db",
                                "text": "„Bei den Beratungen über das Zuwanderungsgesetz sei mit der SPD festgelegt worden, daß die Loyalität zur deutschen Staatsordnung eine wichtige Voraussetzung für die Einbürgerung sei, sagte Koch vor der Präsidiumssitzung seiner Partei in Berlin.“"
                            },
                            {
                                "example_id": "87a9f45c-9f72-4b76-a94e-ad0d86b2d2c0",
                                "sense_id": "e4e1cc7c-d233-3201-9825-a4a67cfdf4db",
                                "text": "„Die Tradition der autoritären Staatsordnungen Russlands zwingt jeden Autor, sich im Koordinatensystem der Macht zu positionieren: Man kann die politische Führung unterstützen, dagegen aufbegehren oder schweigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
