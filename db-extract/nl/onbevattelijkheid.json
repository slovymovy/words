                        "examples": [
                            {
                                "example_id": "fd9a5188-1e04-448a-9101-7c249e8952aa",
                                "sense_id": "bed28864-e612-3824-923e-19bd73eee4e3",
                                "text": "Zoals die dingen gaan: je laat het bezoek uit, en voordat ieder zijns weegs gaat, blijf je elkaar nog een hele poos op de stoep gelijk staan geven - over de verspilling van een leven, over de onbevattelijkheid van het verlies."
                            },
                            {
                                "example_id": "009e43a7-09af-4c97-87d0-9556ca4938b4",
                                "sense_id": "bed28864-e612-3824-923e-19bd73eee4e3",
                                "text": "De combinatie van nabijheid en onbevattelijkheid is angstaanjagend"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2c032eb-9f91-3f20-a33a-98ef379bbc31",
                        "entry_id": "e9db3e53-cb13-3f0f-a41f-755bf6275949",
