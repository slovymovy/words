                    {
                        "sense_id": "e299d578-400a-328e-893a-80f6cb27a1b6",
                        "entry_id": "cadda7d2-36cb-32ca-aafd-10b38bfc3331",
                        "glosses": [
                            "bovennatuurlijke boodschapper van God die het einde van onenigheid verkondigt of een afbeelding daarvan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229eefe1-0050-4319-877a-e1676e5b0e98",
                                "sense_id": "e299d578-400a-328e-893a-80f6cb27a1b6",
                                "text": "We drinken thee met kleine schuimpjes en kijken uit het halfronde zolderraam op het Paleisplein, waar een bronzen Aleksandr I, verkleed als vredesengel, op een roodgranieten zuil poseert."
                            },
                            {
                                "example_id": "fcab1de6-7156-47a3-ae37-40de4cf84042",
                                "sense_id": "e299d578-400a-328e-893a-80f6cb27a1b6",
                                "text": "De gouden vredesengel op de klokkentoren herinnert eraan dat de bouwwerkzaamheden samenvielen met de Eerste Wereldoorlog."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ddb9da7-14b8-3ce9-92af-d8b799357fd0",
                        "entry_id": "cadda7d2-36cb-32ca-aafd-10b38bfc3331",
                        "glosses": [
                            "iemand met een zeer krachtige en idealistische inzet om onenigheid op te lossen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d11fcf5d-c6d5-4002-9c13-c174d9db5237",
                                "sense_id": "6ddb9da7-14b8-3ce9-92af-d8b799357fd0",
                                "text": "Na een venijnige burgeroorlog van drie jaar sloten Molukse moslims en christenen op 12 februari 2002 in Malino, Zuid-Sulawesi, een vredesovereenkomst. Sindsdien zijn er uit aller heren landen vredesengelen neergestreken op de Duizend Eilanden om de Molukkers van hun `trauma's' af te helpen en `verzoening' te preken."
                            },
                            {
                                "example_id": "5dfffc8e-f051-49e9-9ad3-e1b825930d6f",
                                "sense_id": "6ddb9da7-14b8-3ce9-92af-d8b799357fd0",
                                "text": "Europeanen komen van Venus, Amerikanen van Mars. Treffender is het verschil in denkwereld niet uit te drukken. Maar Kagan zei ook dat Europa zijn toevlucht kon nemen tot de rol van vredesengel, omdat het veilig schuilt onder de Amerikaanse defensieparaplu."
                            },
                            {
                                "example_id": "ce7b16cd-5f55-4ca8-bceb-e282623ceb59",
                                "sense_id": "6ddb9da7-14b8-3ce9-92af-d8b799357fd0",
                                "text": "Dat de Amerikaanse verkiezingsspecialist Arthur Finkelstein Sharon als een vredesengeltje de verkiezingscampagne instuurt, is volgens Mordechai Sharabi een uitgekiende tactische zet."
                            }
                        ]
                    }
