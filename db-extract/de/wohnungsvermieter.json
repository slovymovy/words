                                "example_id": "a4deef79-0029-41ba-bc5e-889322b33f31",
                                "sense_id": "17d84614-4312-387e-8456-f0e6f456f291",
                                "text": "Der Wohnungsvermieter hat den Mietern der Wohnung gekündigt, da sie hohe Mietschulden angehäuft haben."
                            },
                            {
                                "example_id": "e53e1195-d916-44ac-bd0a-1d2f6be44635",
                                "sense_id": "17d84614-4312-387e-8456-f0e6f456f291",
                                "text": "„Deutschlands größter Wohnungsvermieter Vonovia will die Nummer zwei auf dem Markt, die Deutsche Wohnen, für rund 18 Milliarden Euro schlucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
