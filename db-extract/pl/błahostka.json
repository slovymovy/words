                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "9843b561-37fc-435a-9b47-8a7b2f00d30a",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "zupełna błahostka",
                                "translation": "a real trifle",
                                "english": "a real trifle"
                            },
                            {
                                "example_id": "bf94a116-0e85-40b3-aa5e-52944506a418",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "zwykłe błahostki",
                                "translation": "an ordinary small thing",
                                "english": "an ordinary small thing"
                            },
                            {
                                "example_id": "40d808f0-3739-4624-9e68-f5e3cb66bf70",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "błahostka bez znaczenia",
                                "translation": "a meaningless trifle",
                                "english": "a meaningless trifle"
                            },
                            {
                                "example_id": "92ad633f-6c29-47cf-bee0-afc2517d558d",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "przejmować się błahostkami",
                                "translation": "to worry about trifles",
                                "english": "to worry about trifles"
                            },
                            {
                                "example_id": "c8390400-17c5-47dc-ab1f-a8f2bcce4edd",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "zajmować się błahostkami",
                                "translation": "to deal with trifles",
                                "english": "to deal with trifles"
                            },
                            {
                                "example_id": "bc2578d6-7988-4a68-aa92-e2e2a8470617",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "cieszyć się z błahostek",
                                "translation": "to be glad for the little things",
                                "english": "to be glad for the little things"
                            },
                            {
                                "example_id": "d1b79669-a96d-4267-b17f-54bf6c462210",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "marnować czas na błahostki",
                                "translation": "to waste time on small fries",
                                "english": "to waste time on small fries"
                            },
                            {
                                "example_id": "0a203a7a-55da-4274-8666-2689d2acb407",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "pokłócić się o błahostkę",
                                "translation": "to argue about trifles",
                                "english": "to argue about trifles"
                            },
                            {
                                "example_id": "0e872f80-aab1-48ec-831c-a0716ff10bb0",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "czepiać się o błahostki",
                                "translation": "to nitpick trifles",
                                "english": "to nitpick trifles"
                            },
                            {
                                "example_id": "4f059a8d-27ac-4879-9512-e971dab08d82",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "myśleć o błahostkach",
                                "translation": "to think about trifles",
                                "english": "to think about trifles"
                            },
                            {
                                "example_id": "51cba8fa-8b87-4710-94e5-3a95fc2a87ff",
                                "sense_id": "57cbce65-3f9a-32d9-88a9-af07ef85cd26",
                                "text": "rozmawiać o błahostkach",
                                "translation": "to talk about trifles",
                                "english": "to talk about trifles"
                            }
                        ]
