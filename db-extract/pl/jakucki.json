                                    {
                                        "sense_id": "ab78818d-3b7d-3d02-b1e0-2128e15160d5",
                                        "entry_id": "8a4ff87a-c7d4-3b62-8586-386a82919c6e",
                                        "glosses": [
                                            "Langue turcique de la famille des langues altaïques parlée en Sibérie et en Yakoutie, traditionnellement par les Sakha ou Yakoutes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ce6044-7ca6-4d1e-8087-ddda9c177484",
                                                "sense_id": "ab78818d-3b7d-3d02-b1e0-2128e15160d5",
                                                "text": "[…], le yakoute constitue au contraire un idiome tardif faisant usage de mutations très jeunes. Il aurait été même, primitivement, un idiome non-turc fort saturé de mongolismes, et près de devenir un dialecte mongol. Les éléments turcs y sont ensuite entrés en telle masse que la langue yakoute actuelle porte une physionomie apparemment turque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb52ae17-6281-3b06-9295-5ccb17dded72",
                                        "entry_id": "8a4ff87a-c7d4-3b62-8586-386a82919c6e",
                                        "glosses": [
                                            "Race de cheval sibérien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cea35f-7888-43b8-acf7-a23a46c35279",
                                                "sense_id": "cb52ae17-6281-3b06-9295-5ccb17dded72",
                                                "text": "Le yakoute est un poney qui vit en Sibérie, dans la région de la Yakoutie, près du cercle polaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd52450e-ce5b-4719-82be-518ca5a46008",
                        "source_entry_id": "da52338b-aac7-308e-874e-31e368a65dfd",
                        "source_sense_id": "0ceba0af-a79e-314e-a7cd-df7f9e290349",
                        "target_lang_word": "jakutisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jakutisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "075befda-e766-3852-961b-61963240d443",
                                        "entry_id": "f6d986d1-0164-31b7-a693-97d19c5f005f",
                                        "glosses": [
                                            "auf das Volk der Jakuten bezogen, von ihm stammend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9eea0f2-a949-490d-ac88-517ba535b647",
                                                "sense_id": "075befda-e766-3852-961b-61963240d443",
                                                "text": "Jakutische Minderheiten gibt es am Amur, auf Sachalin, in Magadan und in der Region Krasnojarsk."
                                            },
                                            {
                                                "example_id": "d1874a6b-085c-4516-8929-3ee73cba9b5c",
                                                "sense_id": "075befda-e766-3852-961b-61963240d443",
                                                "text": "Schon bald zogen dann die ersten jakutischen Pferde ein, die ebenfalls an das harsche Klima der Region angepasst sind."
                                            },
                                            {
                                                "example_id": "6343bf7d-0708-4bb9-8442-40c09e463f70",
                                                "sense_id": "075befda-e766-3852-961b-61963240d443",
                                                "text": "In Jakutien wurde eine besondere Hunderasse – die jakutische Laika – gezüchtet. Diese Hunde zeichnen sich durch Ausdauer, langes Fell und blaue Augen aus."
                                            },
                                            {
                                                "example_id": "0138eaaa-9739-4fbc-a155-a5d51cff19bb",
                                                "sense_id": "075befda-e766-3852-961b-61963240d443",
                                                "text": "Auf dem Museumsgelände befindet sich auch ein alter jakutischer Turm von 1685."
                                            },
                                            {
                                                "example_id": "c3a0484a-fe2a-4d8b-9781-2eb4ce97e240",
                                                "sense_id": "075befda-e766-3852-961b-61963240d443",
                                                "text": "Die jakutische Küche ist wenig bekannt, dabei ist sie sehr eigenartig und kann viele einmalige gastronomische Eindrücke schenken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
