            "senses": [
                {
                    "sense_id": "1734f63b-b8ae-31c4-8cac-6c5cbbab8f02",
                    "sense_definition": "Indique la personne ou la chose à laquelle quelque chose est destiné.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "destination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté ce joli livre <w>pour</w> mon frère."
                        },
                        {
                            "text": "Ce cadeau d'anniversaire est <w>pour</w> toi."
                        }
