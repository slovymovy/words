                            {
                                "example_id": "f074e8e3-88e3-4cb8-8ece-747812cafcc9",
                                "sense_id": "2159ac16-d263-330b-862f-71213588422f",
                                "text": "Il y faut la corne et le crin, le thé, la sauge, la myrrhe, la brosse et les bruxelles [sic], la gymnastique, l’éponge, le zwieback et tout un aguerrissement graduel à la lumière, à l’air extérieur, au pupitre."
                            }
                        ]
