                        "entry_id": "bc57e8fb-9240-3a76-aca7-5935ea19460e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "swartest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                        "entry_id": "bc57e8fb-9240-3a76-aca7-5935ea19460e",
                        "glosses": [
                            "黑色的，黝黑的，黑褐色的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478e0cd8-a50f-4985-80e9-b0db4f1dd87e",
                                "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                                "text": "Men schalle then sone se / Att mydday hytt shalle swarte be"
                            },
                            {
                                "example_id": "d532d367-5b42-40c6-a4a6-1491f93056b6",
                                "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                                "text": "A nation strange, with visage swart"
                            },
                            {
                                "example_id": "188f582e-91e5-4c79-9eff-a42aca013849",
                                "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                                "text": "Lame, foolish, crooked, swart, prodigious,"
                            },
                            {
                                "example_id": "7cd4cc71-fd8d-4f86-a98e-ecf3e6412033",
                                "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                                "text": "Shall be a hell to look upon […]"
                            },
                            {
                                "example_id": "41361a21-6c10-4090-ab50-7a8c5673a9a5",
                                "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                                "text": "The merry soldiers footing it with the swart savage maids"
                            },
                            {
                                "example_id": "f6d90b94-06a2-49cb-bd1a-63e0dda9797b",
                                "sense_id": "0d7f51c3-9a24-3324-b9a1-2ceeff9a818a",
                                "text": "Swartest night stretched over wretched men there."
                            }
                        ]
                    },
                    {
                        "sense_id": "dab94db2-776f-3c39-83c5-29d7a6f9dbf6",
                        "entry_id": "bc57e8fb-9240-3a76-aca7-5935ea19460e",
                        "glosses": [
                            "黑色的"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "293247a0-674d-3f70-90f2-893a767ca196",
                        "entry_id": "bc57e8fb-9240-3a76-aca7-5935ea19460e",
                        "glosses": [
                            ":Template:廢 黑暗的；惡意的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab6fbff-2798-49c5-8c1b-47219ef4b566",
                                "sense_id": "293247a0-674d-3f70-90f2-893a767ca196",
                                "text": "The keeping eunuchs were at back, solemn in stately rows, bespeared and bescimitared, the Danish, Irish, and German of their countenances lost in the daub which made them swart."
                            },
                            {
                                "example_id": "d57ec0a5-6a42-433f-9c33-5515af4eff67",
                                "sense_id": "293247a0-674d-3f70-90f2-893a767ca196",
                                "text": "Suddenly the swart figure of Time stood up before the gods, with both hands dripping with blood and a red sword dangling idly from his fingers, and said: “Sardathrion is gone! I have overthrown it!”"
                            }
                        ]
                    }
                ],
