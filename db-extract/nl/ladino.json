                        "target_lang_word": "ladino",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ladino",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                        "entry_id": "2af4f19c-6c6e-34ab-a4ca-8e2a3f5f180c",
                                        "glosses": [
                                            "románský jazyk sefardských Židů; kód lad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296f4f07-3f1c-4942-828c-35d03f9d4521",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "Například jazykem sefardských Židů ladino dnes prý na světě aktivně mluví několik tisíc lidí."
                                            },
                                            {
                                                "example_id": "21962cee-cce0-41f8-be53-1a815333d8f6",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "Významným počinem v dějinách diasporní sefardské literatury bylo v letech 1547 a 1553 vydání tzv. ferrarského překladu Bible, který převáděl Tanach do specifického jazyka odvozeného od španělštiny, který se v moderní odborné literatuře obvykle nazývá ladino."
                                            },
                                            {
                                                "example_id": "3d0c6b8f-2c37-44b7-a474-0a8960c5ee8c",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "Kapela Kon Sira… se na svém prvním albu právě na sefardské písně, zpívané v jazyce ladino, zaměřuje."
                                            },
                                            {
                                                "example_id": "c1f7f999-bc4d-49fe-8617-ea5562e73b7f",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "program: tradiční židovské písně v ladinu, hebrejštině a jidiš, sefardské a jemenské melodie, afroamerické spirituály, world music"
                                            },
                                            {
                                                "example_id": "9fbb5814-b58e-4e03-9ae1-c592442d43c6",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "Sefardi si uchovali jazyk vycházející ze staré španělštiny – ladino"
                                            },
                                            {
                                                "example_id": "7ec9c072-71a4-4b92-92c0-f47766ee833d",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "Po dobytí Bosny a Hercegoviny Turky (1463, 1481) se rozvíjelo souběžně několik literatur: katolická chorvatská, psaná lidovým jazykem a zprvu cyrilicí, pak latinkou, příp. latinsky; (…) muslimská v národním jazyce a arabským písmem (tzv. ajamiado-literatura), ale i v turečtině, arabštině a perštině; od poloviny 16.stol. i židovská sefardská psaná tzv. ladinem (variantou španělštiny)."
                                            },
                                            {
                                                "example_id": "aa705b4e-904e-434e-9653-3d7c063c123e",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "například slovo paz (mír, klid) je v ladinu používáno ve stejné významové šíři a ve stejných větných konstrukcích jako v hebrejštině slovo šalom"
                                            },
                                            {
                                                "example_id": "0796b88e-bdc5-4eef-a8e7-015c9148d97e",
                                                "sense_id": "f40b53be-c86e-31ef-866f-cbdc7dddf8a2",
                                                "text": "Sefardští, tedy španělští Židé si do svých nových domovů přinesli nejen bohatou hebrejsky psanou literaturu, ale též svou hovorovou středověkou španělštinu, z níž se časem vyvinul jazyk zvaný ladino."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39433432-6d7f-3b6a-ae79-88ad514ee71e",
                                        "entry_id": "2af4f19c-6c6e-34ab-a4ca-8e2a3f5f180c",
                                        "glosses": [
                                            "románský jazyk těsně spjatý s furlanštinou a rétorománštinou, jímž se mluví v italských provinciích Bolzano, Trento a Belluno; kód lld"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
