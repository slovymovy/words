                        ],
                        "examples": [
                            {
                                "example_id": "833b4874-a22d-4572-a673-f094d244e05e",
                                "sense_id": "e5862694-620c-3060-bd0d-3f41c6926743",
                                "text": "Bert effleura successivement un bon nombre de métiers : il fut groom dans un magasin de nouveautés et chez un médecin, garçon de pharmacie, apprenti plombier, griffonneur d’adresses, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc2e2836-d401-3973-83a5-688c627e9d68",
                        "entry_id": "274100e2-6519-3d78-a005-e999ca8a9c72",
                        "glosses": [
                            "Auteur qui écrit beaucoup et vite, sans souci de la forme."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b30e92a2-d2ea-4da6-b88d-1752b7038c6d",
                                "sense_id": "bc2e2836-d401-3973-83a5-688c627e9d68",
                                "text": "N'imitons pas ces soi-disant écrivains, phraseurs éloquents, griffonneurs de papier, qui se croient autorisés à bouleverser, à corrompre notre belle langue française."
                            }
                        ]
                    }
