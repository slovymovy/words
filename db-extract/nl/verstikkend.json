        "nl-extract.jsonl": [
            {
                "entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                "word": "verstikkend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d039544-de36-35c6-b44d-6a6aca806789",
                        "entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                        "glosses": [
                            "met het gevoel dat je stikt (geen adem meer krijgt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b62eeef-7c49-4ada-8ede-5f4918968fa3",
                                "sense_id": "6d039544-de36-35c6-b44d-6a6aca806789",
                                "text": ",,Ik kreeg zo’n jaar of vijf geleden als ik ergens moest optreden voor het eerst last van duizelingen, ademhalingsproblemen, een verstikkend gevoel. Dan wilde ik gewoon niet meer en moest Marit op me inpraten om toch het podium op te gaan. Ik heb er allerlei artsen voor afgelopen: ik dacht lange tijd dat het iets fysieks was. Pas anderhalf jaar geleden heb ik aan mezelf toegegeven dat het iets psychisch was en ben ik drie keer per week naar een psycholoog gegaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "42e094f7-672c-36a2-9774-3c8617e5c79f",
                        "entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                        "glosses": [
                            "gevoel dat je ergens in gevangen zit en daar niet uit kunt komen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8cce435a-99a1-4faf-ae73-5f83d94a1e45",
                                "sense_id": "42e094f7-672c-36a2-9774-3c8617e5c79f",
                                "text": "De laatste twee van de 25 ronden waren verstikkend spannend. De 34-jarige Farah nam de leiding en versnelde, maar struikelde twee keer bijna. Hij bleef op de been en liet zich niet meer inhalen. Het stadion ontplofte bijkans toen hij als eerste over de finish kwam in een bijzonder scherpe tijd van 26.49,51."
                            }
                        ]
                    },
                    {
                        "sense_id": "2165d538-5c73-30a0-908a-ec502e05371e",
                        "entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                        "glosses": [
                            "bedrukt somber gevoel hebbend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7d689936-ce74-44aa-ac19-b7c8d9d91bfd",
                                "sense_id": "2165d538-5c73-30a0-908a-ec502e05371e",
                                "text": "Leon ten Voorde was deze week aanwezig in De Lutte, waar FC Twente op trainingskamp was. ,,De trainer en de ploeg kunnen wel wat nieuw elan gebruiken. De sfeer op het trainingscomplex in Hengelo is wat verstikkend door de slechte resultaten\", aldus Leon. ,,Ik kan me er wat bij voorstellen. Als je continue hetzelfde doet in Hengelo heb je het gevoel dat je sowieso niet verder komt\", vult Fardau aan."
                            }
                        ]
                    },
                    {
                        "sense_id": "af8c50b7-c4ea-361c-9d54-0688e5b397ca",
                        "entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                        "glosses": [
                            "heel erg warm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9bcee0d-5c44-48ca-ae16-3bedb39b8dab",
                                "sense_id": "af8c50b7-c4ea-361c-9d54-0688e5b397ca",
                                "text": "En waarom lieten ze de jonge Joey – die nog nooit in het buitenland was geweest – dat onherbergzame en verstikkend hete gebied in lopen, toen hij dacht dat hij de weg beter wist?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8c67f11-6aae-426e-9337-05150cc8b799",
                        "source_entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                        "source_sense_id": "6d039544-de36-35c6-b44d-6a6aca806789",
                        "target_lang_word": "oppressive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppressive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef9e49dd-9e6b-3635-b983-a38bd7f6ebbf",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Burdensome or difficult to bear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097fb18a-cc00-4571-b23c-103880609e0e",
                                                "sense_id": "ef9e49dd-9e6b-3635-b983-a38bd7f6ebbf",
                                                "text": "The oppressive tax laws made it difficult to start a small company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ecbacf-dad2-3cfb-a38f-63aa433bfb89",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Tyrannical or exercising unjust power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d550405-8a96-4a7c-bece-0947214ad95a",
                                                "sense_id": "b1ecbacf-dad2-3cfb-a38f-63aa433bfb89",
                                                "text": "The oppressive land-owners kept a grip on the labourers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Weighing heavily on the spirit; being quite intense, excessive or overwhelming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd76d23-fbef-4788-b436-2479cb59a75b",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Will the oppressive heat of summer never end?"
                                            },
                                            {
                                                "example_id": "82898cec-122d-4482-8ebd-bf0e75521d10",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Without being slaves in fact, their condition is little better than vassalage in its most oppressive form."
                                            },
                                            {
                                                "example_id": "1aaecdc3-4255-4957-a835-9d20b57ecb78",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "The class of noblemen, who, at this particular epoch, had lost nothing of their primitive vigour, saw with pleasure the influence of the French depressed; but they suffered scarcely less from the absolute and oppressive influence which the Spaniards had acquired over them."
                                            },
                                            {
                                                "example_id": "de7f4e25-1faf-423e-9a24-651bb86e6c49",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Their mantle was for a while worn unconsciously by him who showed to us Macbeth: and here again, in the deepening gloom of this tragic tale, we feel the oppressive influence of this invisible power, from the time we hear the prophetic rhymes, the spell has begun its work, and the clouds of misfortune blacken round us; and the fated course moves solemnly onward, irresistible and unerring as the progress of the sun, and soon to end in a night of horror."
                                            },
                                            {
                                                "example_id": "1f5e8c07-f7a1-4a72-9634-038a21e0b279",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "With startling and oppressive force of illustration, he brings before us the fact, that in that grandest city of the earth, “if all the churches, chapels and buildings devoted to public worship, were filled to their last seat, there would be still left outside the buildings as many people as the whole population—men, women and children—in the cities of Leeds, Bristol, Sheffield and Birmingham.”"
                                            },
                                            {
                                                "example_id": "1c02f9ed-1526-44cf-91c3-fa1e98950037",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "It had been one of those unnaturally still and oppressive days when scarcely a leaf quivers, and every breath of air seems charged with electricity. Suddenly the thunder began to growl. Before many minutes eveiy pine-needle was shaking with a fierce chill wind, and a torrent of rain swept down the valley and drenched us through to the skin."
                                            },
                                            {
                                                "example_id": "b87edafb-7c32-4072-9fde-870169ca428d",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "He defines it as belief in exalted spiritual powers by whose help human weakness is supplemented in its struggle with the oppressive forces of the natural world."
                                            },
                                            {
                                                "example_id": "ae76728c-285a-4e8a-ad40-ef7b3120e562",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "Mr. Wardlaw had left the castle: so also had Charlotte, by her own wish, her residence there having been found too oppressive to herself to be continued for the present."
                                            },
                                            {
                                                "example_id": "c59ed678-89b0-431e-90a2-8e0030fa962e",
                                                "sense_id": "c45cc5d0-3bc6-3300-91f1-c3dbcd42eb5b",
                                                "text": "The possibility that women are not very sensitive to odours is often suggested to men by the perfumes of oppressive strength which women frequently use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c5d09a-0b65-3bc0-bc6e-278edc67f546",
                                        "entry_id": "732f64fc-29a8-361c-8938-ad6b43284972",
                                        "glosses": [
                                            "Hot and humid."
                                        ],
                                        "tags": [
                                            "of the weather"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c87797-45e1-4fca-8d1a-8879359c8c06",
                        "source_entry_id": "3598a4af-481c-31ae-8c4c-7cc9a5da8f0c",
                        "source_sense_id": "6d039544-de36-35c6-b44d-6a6aca806789",
                        "target_lang_word": "choking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                                        "glosses": [
                                            "The process in which a person's airway becomes blocked, resulting in asphyxia in cases that are not treated promptly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "201a3b46-1f0d-48ca-acbd-61665d993b0c",
                                                "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                                "text": "In the last 6 years, there has been a great effort to educate the public concerning the prevention of choking due to accidental aspiration of foods or small objects by children."
                                            },
                                            {
                                                "example_id": "484a7683-4ce6-4ed7-af53-191a4dfb7576",
                                                "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                                "text": "The study found that 29 percent of nonfood-related chokings were caused by latex balloons."
                                            },
                                            {
                                                "example_id": "a5b6687a-b9d0-4276-86a9-ecfd1b042782",
                                                "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                                "text": "Choking occurs when the respiratory passage in the throat or windpipe is blocked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                                        "glosses": [
                                            "The act of coughing when a person finds it difficult to breathe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d731ec22-7f46-4b80-b4e5-c3bd2b485b68",
                                                "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                                "text": "Putting the latter on her head and the former on the table, the old woman, after telling Oliver that she had come to sit up with him, drew her chair close to the fire and went off into a series of short naps, chequered at frequent intervals with sundry tumblings forward, and divers moans and chokings."
                                            },
                                            {
                                                "example_id": "32e35242-8a76-480c-9e6a-58ad1cb4fed3",
                                                "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                                "text": "The chokings, which now always succeed every epileptic sleep, are violent beyond description, and last a long time."
                                            },
                                            {
                                                "example_id": "fc624ba2-1c7b-4f9e-95e0-ad19fb64036a",
                                                "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                                "text": "\"I applied,” says he in his first memoir, “a large plate of copper upon the pit of the stomach and a ring of the same metal around each limb: and in three or four minutes the chokings, palpitations, and vomitings ceased."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                                        "glosses": [
                                            "The act of trying to kill a person by strangulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06d713f-6650-4c60-9214-80f525ba7c07",
                                                "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                                "text": "She tells of many chokings and blows inflicted by the defendant, and says her health was thereby affected and, presumably, her life endangered."
                                            },
                                            {
                                                "example_id": "dd741b6a-8b71-4e83-8d43-dd2996441003",
                                                "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                                "text": "This particular man was a small, wiry , athletic Negro who had confessed to many chokings and rapings of young women."
                                            },
                                            {
                                                "example_id": "96adaef3-4e1d-44a2-87a5-449470190139",
                                                "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                                "text": "Judges should not decide which police chokings are acceptable, and which are not, based on Orwellian newspeak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db980b6c-f3ef-306a-b7a2-898edf00aa7f",
                                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                                        "glosses": [
                                            "The result of something being choked."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e3b592-91d3-4ae1-89bb-336dbaffecaf",
                                                "sense_id": "db980b6c-f3ef-306a-b7a2-898edf00aa7f",
                                                "text": "This feature has been found effective in reducing injector trouble, resulting either from the clogging of sieves or the choking of the annular orifices of the injectors by fine particles of coal."
                                            }
                                        ]
                                    }
                                ]
                            },
