                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van verwrongen of vervormen.",
                        "ru": "Форма прошедшего времени и причастие прошедшего времени глагола to contort (искривлять, перекашивать, скручивать)."
                    },
                    "translations": {
