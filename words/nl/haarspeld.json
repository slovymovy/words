    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b61482da-427c-391b-83a7-1e503b1ec08e",
                    "sense_definition": "een dunne speld van metaal of plastic waarmee je het haar kunt vastzetten of opsteken",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "haaraccessoires",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij gebruikte een zilveren <w>haarspeld</w> om haar lange haar in een knot te doen.",
                            "target_lang_translations": {
                                "en": "She used a silver <w>hairpin</w> to put her long hair in a bun."
                            }
                        },
                        {
                            "text": "In de meeste supermarkten worden verschillende soorten <w>haarspelden</w> verkocht.",
                            "target_lang_translations": {
                                "en": "In most supermarkets, different types of <w>hairpins</w> are sold."
                            }
                        }
                    ],
                    "synonyms": [
                        "haarnaald",
                        "schuifje"
                    ],
                    "common_phrases": [
                        "metalen haarspeld",
                        "haarspeld in het haar"
                    ],
                    "target_lang_definitions": {
                        "en": "a thin pin made of metal or plastic used to secure or style hair"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hairpin",
                                "target_lang_sense_clarification": "a thin, U-shaped pin for hair"
                            },
                            {
                                "target_lang_word": "hair clip",
                                "target_lang_sense_clarification": "a general term for various hair fasteners"
                            },
                            {
                                "target_lang_word": "bobby pin",
                                "target_lang_sense_clarification": "a specific type of small, tight metal hairpin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "047912c6-ec3d-3700-911e-77ffc916f6ed",
                    "sense_definition": "een zeer scherpe bocht in een weg, vaak in de bergen; verkorting van <w>haarspeldbocht</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heel langzaam volgden we de contouren van de <w>haarspelden</w> naar beneden in het dal.",
                            "target_lang_translations": {
                                "en": "Very slowly we followed the contours of the <w>hairpins</w> down into the valley."
                            }
                        },
                        {
                            "text": "De wielrenners hadden moeite met de steile <w>haarspelden</w> tijdens de beklimming van de berg.",
                            "target_lang_translations": {
                                "en": "The cyclists had trouble with the steep <w>hairpin turns</w> during the climb up the mountain."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gevaarlijke haarspelden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "shortening of haarspeldbocht"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a very sharp bend in a road, often in mountains; short for hairpin bend"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hairpin",
                                "target_lang_sense_clarification": "a very sharp U-shaped turn in a road"
                            },
                            {
                                "target_lang_word": "hairpin bend",
                                "target_lang_sense_clarification": "the full term for a sharp mountain turn"
                            },
                            {
                                "target_lang_word": "hairpin turn",
                                "target_lang_sense_clarification": "a sharp 180-degree turn"
                            }
                        ]
                    }
                }
            ]
        }
    ]
