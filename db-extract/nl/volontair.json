                                    {
                                        "sense_id": "ad62bf61-fd3b-3f35-b658-6825a83de8ee",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To enlist oneself as a volunteer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To do or offer to do something voluntarily."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ac2bc5-8b99-4b6e-9d92-86f76e6e5555",
                                                "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                                "text": "to volunteer for doing the dishes"
                                            },
                                            {
                                                "example_id": "19ac49e6-90e9-48b7-b7a6-c62e93b394d3",
                                                "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                                "text": "Miranda: No good. Both routes are blocked. See these doors? The only way past is to get someone to open them from the other side.\nShepard: It's not a fortress; there's got to be something. Here, maybe we can send someone in through this ventilation shaft.\nJacob: Practically a suicide mission. I volunteer.\nMiranda: I appreciate the thought, Jacob, but you couldn't shut down the security systems in time. We need to send a tech expert."
                                            },
                                            {
                                                "example_id": "124b2515-fbdc-44e6-9f8b-15b935ca1164",
                                                "sense_id": "88d7b8eb-07db-3ec9-9c73-3dc0f0c6dad4",
                                                "text": "The typical volunteer may live in Utah, which ranked first in the percentage of people who said they volunteered among all 50 states and Washington, DC. […] The median amount of time per year spent volunteering was 52 hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13060a47-7c38-3d51-a37d-e1fb96a86d2e",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To offer, usually unprompted."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc082df-d212-489b-af40-3236010f22b5",
                                                "sense_id": "13060a47-7c38-3d51-a37d-e1fb96a86d2e",
                                                "text": "to volunteer an explanation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07718a7-d134-3ff9-8c2f-a7d2a8468ba0",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To offer the services of (someone else) to do something."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3942b67-fef8-4ed9-945b-49880d228969",
                                                "sense_id": "a07718a7-d134-3ff9-8c2f-a7d2a8468ba0",
                                                "text": "My sister volunteered me to do the dishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "586e7b64-a1b8-39f1-9c6f-4720528df248",
                                        "entry_id": "f3cfaadb-2a6d-31f0-8cf0-da228eee3119",
                                        "glosses": [
                                            "To grow without human sowing or intentional cultivation."
                                        ],
