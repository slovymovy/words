{
    "word_family": [
        "immune",
        "immunity",
        "immunize",
        "immunology",
        "immunological"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b895e9d5-7a13-3230-9c64-ad9e15210c1a",
                    "sense_definition": "The medical process of making a person resistant to an infectious disease by administering a vaccine.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Routine <w>immunization</w> against influenza is recommended for all healthcare workers.",
                            "target_lang_translations": {
                                "zh": "建议所有医护人员进行流感的常规<w>免疫接种</w>。"
                            }
                        },
                        {
                            "text": "Public health programs focus on increasing the rate of childhood <w>immunization</w> to prevent outbreaks.",
                            "target_lang_translations": {
                                "zh": "公共卫生项目致力于提高儿童<w>免疫接种</w>率以预防疾病爆发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vaccination"
                    ],
                    "common_phrases": [
                        "childhood immunization",
                        "routine immunization"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过接种疫苗使人对传染病产生抵抗力的医疗过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "免疫接种",
                                "target_lang_sense_clarification": "指通过医疗手段预防疾病的整体过程。"
                            },
                            {
                                "target_lang_word": "预防接种",
                                "target_lang_sense_clarification": "常用于公共卫生语境下的常规免疫程序。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8827afbd-cd52-31dc-912e-58f33dae9480",
                    "sense_definition": "A specific instance or dose of a vaccine given to a person or animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first <w>immunization</w> a baby receives is typically against hepatitis B.",
                            "target_lang_translations": {
                                "zh": "婴儿接受的第一次<w>疫苗接种</w>通常是针对乙肝的。"
                            }
                        },
                        {
                            "text": "She required several <w>immunizations</w> before traveling to the tropical region.",
                            "target_lang_translations": {
                                "zh": "她在前往热带地区前需要进行几次<w>疫苗接种</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vaccine",
                        "shot",
                        "jab"
                    ],
                    "common_phrases": [
                        "receive an immunization",
                        "required immunizations"
                    ],
                    "target_lang_definitions": {
                        "zh": "给予人或动物的特定疫苗剂量或接种行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "疫苗接种",
                                "target_lang_sense_clarification": "指具体的接种行为或次数。"
                            },
                            {
                                "target_lang_word": "针",
                                "target_lang_sense_clarification": "口语中指代接种疫苗的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57794179-a3f8-37b4-b70b-f0fc934a727a",
                    "sense_definition": "The natural or biological process by which an organism develops resistance to a pathogen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Natural <w>immunization</w> via previous infection can provide long-term protection against certain viruses.",
                            "target_lang_translations": {
                                "zh": "通过既往感染获得的自然<w>免疫</w>可以提供针对某些病毒的长期保护。"
                            }
                        },
                        {
                            "text": "The duration of <w>immunization</w> depends heavily on the individual's overall health and immune system strength.",
                            "target_lang_translations": {
                                "zh": "<w>免疫</w>的持续时间很大程度上取决于个人的整体健康状况和免疫系统强度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immunity"
                    ],
                    "target_lang_definitions": {
                        "zh": "生物体对病原体产生抵抗力的自然或生物学过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "免疫",
                                "target_lang_sense_clarification": "指机体对疾病的自然防御能力。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}