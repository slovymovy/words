                                "target_senses": [
                                    {
                                        "sense_id": "29cd7bff-6445-31ed-b792-1c8fcd4bf6dd",
                                        "entry_id": "a3b3e953-aaf3-316b-a178-bc6280864271",
                                        "glosses": [
                                            "A colourless, odourless solid, H₃PO₄, often in solution as a syrupy liquid, used in the manufacture of fertilizers, detergents and pharmaceuticals and as an additive in cola drinks."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
