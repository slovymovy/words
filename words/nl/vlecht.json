{
    "word_family": [
        "vlechten",
        "vlechtwerk",
        "invlechten",
        "omvlechten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "063e226a-635f-3d21-b361-d3c1703267ef",
                    "sense_definition": "streng ineengevlochten haar, touw of andere vezels",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "haarstijl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt haar lange haar het liefst in een nette <w>vlecht</w>.",
                            "target_lang_translations": {
                                "en": "She prefers to wear her long hair in a neat <w>braid</w>."
                            }
                        },
                        {
                            "text": "Voordat ze ging slapen, maakte haar moeder altijd een losse <w>vlecht</w> in haar haar.",
                            "target_lang_translations": {
                                "en": "Before going to sleep, her mother always put her hair in a loose <w>braid</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een dikke vlecht",
                        "een losse vlecht"
                    ],
                    "target_lang_definitions": {
                        "en": "a length of interwoven hair, rope, or other fibers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "braid",
                                "target_lang_sense_clarification": "intertwined strands of hair or fiber"
                            },
                            {
                                "target_lang_word": "plait",
                                "target_lang_sense_clarification": "intertwined strands of hair or straw, chiefly British"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e5a96084-a6b6-303a-8e79-be3a5635171a",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>vlechten</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vlecht</w> elke ochtend het haar van mijn dochter voor school.",
                            "target_lang_translations": {
                                "en": "I <w>braid</w> my daughter's hair every morning before school."
                            }
                        },
                        {
                            "text": "In de zomer <w>vlecht</w> ik vaak manden van verse wilgentakken in de tuin.",
                            "target_lang_translations": {
                                "en": "In the summer, I often <w>weave</w> baskets from fresh willow branches in the garden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'vlechten': to braid, plait, or weave"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "braid",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "plait",
                                "target_lang_sense_clarification": "first-person singular present, chiefly British"
                            },
                            {
                                "target_lang_word": "weave",
                                "target_lang_sense_clarification": "first-person singular present, for baskets or branches"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db193df7-edc2-3481-a479-1c3e622304d0",
                    "sense_definition": "gebiedende wijs van <w>vlechten</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vlecht</w> het touw niet te strak, anders kun je het later niet meer losmaken.",
                            "target_lang_translations": {
                                "en": "Do not <w>braid</w> the rope too tightly, otherwise you won't be able to untie it later."
                            }
                        },
                        {
                            "text": "<w>Vlecht</w> eerst de drie buitenste strengen voordat je met de rest begint.",
                            "target_lang_translations": {
                                "en": "<w>Braid</w> the three outer strands first before starting with the rest."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'vlechten': braid, plait, or weave"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "braid",
                                "target_lang_sense_clarification": "imperative"
                            },
                            {
                                "target_lang_word": "plait",
                                "target_lang_sense_clarification": "imperative, chiefly British"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}