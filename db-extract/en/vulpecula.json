                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2da67a8-eb52-4be9-869f-766ca06782ae",
                                                "sense_id": "7fb994ba-79e3-3cd6-90eb-d42f3bd6ae7c",
                                                "text": "Grimms Wörterbuch führt „rother Fuchs“, eine Bezeichnung für ein Blau mit Rotton, als Beispiel an."
                                            }
                                        ],
                                        "sense_index_json": "\"16\""
                                    },
                                    {
                                        "sense_id": "77a2eab8-ce99-31ed-a095-a63f67f5846f",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
