                "senses": [
                    {
                        "sense_id": "af831f1b-ebce-3d48-8815-2ae9e29e59ec",
                        "entry_id": "02625b09-a59e-34e0-a3c0-c59833402cd9",
                        "glosses": [
                            "stark duftende Substanz, der man - vor allem früher - eine heilende Wirkung bei Benommenheit/Ohnmacht zuschrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c1d571-99b2-4479-b01d-8cfcbb061b3f",
                                "sense_id": "af831f1b-ebce-3d48-8815-2ae9e29e59ec",
                                "text": "„Ich versuchte es deshalb mit Riechsalz.“"
                            },
                            {
                                "example_id": "4b47a8c3-1ddd-4f2e-80a5-3b41b0e8b9e5",
                                "sense_id": "af831f1b-ebce-3d48-8815-2ae9e29e59ec",
                                "text": "„Ich wäre vielleicht sogar eingeschlafen, hätte ich mir nicht ein wenig Riechsalz unter die Nase gehalten, das mich zum Niesen brachte und so gewaltsam wachhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
