                    "sense_definition": "Een grote loofboom waar kastanjes aan groeien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staat een hele oude <w>kastanje</w> midden op ons dorpsplein.  ",
                            "target_lang_translations": {
                                "en": "There is a very old <w>chestnut tree</w> in the middle of our village square."
                            }
                        },
                        {
                            "text": "In de lente bloeit de grote <w>kastanje</w> met prachtige witte bloemen.",
                            "target_lang_translations": {
                                "en": "In spring the large <w>chestnut tree</w> blooms with beautiful white flowers."
                            }
                        }
                    ],
                    "synonyms": [
                        "kastanjeboom"
                    ],
                    "target_lang_definitions": {
