                    {
                        "sense_id": "ce93677b-4c1b-3743-af4b-7b9337461a7a",
                        "entry_id": "37253e75-808b-30e9-b657-3b83bbb39915",
                        "glosses": [
                            "Trainingsmethode im Boxsport, bei der man in die Luft schlägt und versucht, imaginäre Punkte zu treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f905047-4e3e-4873-862f-e486fe61c7de",
                                "sense_id": "ce93677b-4c1b-3743-af4b-7b9337461a7a",
                                "text": "Das Schattenboxen wird von Boxern oft trainiert, um die Schnelligkeit und Ausdauer zu fördern."
                            },
                            {
                                "example_id": "70e68df2-b6a3-4480-a1b8-8464f3d5930d",
                                "sense_id": "ce93677b-4c1b-3743-af4b-7b9337461a7a",
                                "text": "„Er machte ein paar Runden Schattenboxen.“"
                            },
                            {
                                "example_id": "869b8c47-bbd1-4bf2-ace9-fde355d419e8",
                                "sense_id": "ce93677b-4c1b-3743-af4b-7b9337461a7a",
                                "text": "Da beim Üben gegen einen imaginären Feind gekämpft wird, erinnert Tai Chi an Schattenboxen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6bfcfab-5b3f-3356-b1a5-c30f3e04f16d",
                        "entry_id": "37253e75-808b-30e9-b657-3b83bbb39915",
                        "glosses": [
                            "eine Boxart aus China"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccde354a-380f-42dd-a33a-d2734596029b",
                                "sense_id": "b6bfcfab-5b3f-3356-b1a5-c30f3e04f16d",
                                "text": "Da beim Üben gegen einen imaginären Feind gekämpft wird, erinnert Tai Chi an Schattenboxen."
                            },
                            {
                                "example_id": "a3fb06d4-91c5-4b57-bfa9-e21437ca7239",
                                "sense_id": "b6bfcfab-5b3f-3356-b1a5-c30f3e04f16d",
                                "text": "Bereits in den frühen Morgenstunden strömen die Menschen in Massen in die Parks zur Frühgymnastik, zum Schattenboxen."
                            }
                        ],
