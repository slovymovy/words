                "translations": [
                    {
                        "translation_id": "3c27579e-63c0-439f-8e7e-857039097223",
                        "source_entry_id": "952da845-d4df-3d53-866b-5c1d5e0d1fb8",
                        "source_sense_id": "c6002d9b-fc2d-302e-828d-bce49de59c37",
                        "target_lang_word": "Debüt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Debüt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e170b24c-672d-3c10-97ff-3f4a42d55571",
                                        "entry_id": "cd607b88-9ce3-37fc-8275-0c8f2063a0c4",
                                        "glosses": [
                                            "erstes Auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761a827c-5b72-4d4a-b29d-c1306b454d6c",
                                                "sense_id": "e170b24c-672d-3c10-97ff-3f4a42d55571",
                                                "text": "Der Sänger gab sein Debüt."
                                            },
                                            {
                                                "example_id": "16566b31-3598-468d-be2e-1642b939d93f",
                                                "sense_id": "e170b24c-672d-3c10-97ff-3f4a42d55571",
                                                "text": "„Auch der Q8 ist ein Crossover, er wird vornehmlich elektrisch und per Plug-in-Hybrid angetrieben, Debüt wahrscheinlich nicht vor 2018.“"
                                            },
                                            {
                                                "example_id": "0472c9a8-d7a1-4397-b9c5-ae37893fca5b",
                                                "sense_id": "e170b24c-672d-3c10-97ff-3f4a42d55571",
                                                "text": "„Im langersehnten Augenblick seines wissenschaftlichen Debüts konnte er es nicht lassen, sich an seine Landsleute zu wenden.“"
                                            },
                                            {
                                                "example_id": "64ffa0af-5b4e-4ad1-9987-db6255d1dffe",
                                                "sense_id": "e170b24c-672d-3c10-97ff-3f4a42d55571",
                                                "text": "„Nach diesem schiefgegangenen Debüt wollte ihn der Pfarrer nie wieder am Altar sehen.“"
                                            },
                                            {
                                                "example_id": "8e142f56-ec0d-4305-b296-3274da22411d",
                                                "sense_id": "e170b24c-672d-3c10-97ff-3f4a42d55571",
                                                "text": "„Nach einem solchen Debüt ist es kein Wunder, dass Canetti nun auch Dramen schreibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
