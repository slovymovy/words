                ],
                "senses": [
                    {
                        "sense_id": "5e125ce4-fb75-36f6-8972-455e5fc13e3e",
                        "entry_id": "5ade29d1-6517-38b4-9918-2bc0b0e13d2d",
                        "glosses": [
                            "Länge einer gelaufenen/zu laufenden beziehungsweise zu Fuß zurückgelegten Strecke"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7ad3a91d-0ca5-4c02-bf76-1f5fed5214e5",
                                "sense_id": "5e125ce4-fb75-36f6-8972-455e5fc13e3e",
                                "text": "„Seit den Olympischen Winterspielen von 1998 in Nagano besteht das Team im Mannschaftswettbewerb aus vier Kombinierern mit einer Laufdistanz von jeweils 5 km.“"
                            },
                            {
                                "example_id": "53a357f2-03c2-48d7-ad42-dc46e8c53c96",
                                "sense_id": "5e125ce4-fb75-36f6-8972-455e5fc13e3e",
                                "text": "„Die Laufdistanzen waren auf 800 Meter beschränkt.“"
                            },
                            {
                                "example_id": "50b53b83-accf-45ff-958c-da793b3a97e5",
                                "sense_id": "5e125ce4-fb75-36f6-8972-455e5fc13e3e",
                                "text": "„Hohes Tempo, eine hohe durchschnittliche Laufdistanz sowie eine herausragende Anzahl an Sprints zeichnen ihn besonders aus.“"
                            },
                            {
                                "example_id": "284853db-bb59-4e2a-abc8-821c0b251a57",
                                "sense_id": "5e125ce4-fb75-36f6-8972-455e5fc13e3e",
                                "text": "„Ein größerer Spielraum in Spielformen mit mehreren Spielern hingegen provoziert häufig längere Laufdistanzen, weniger direkte Duelle und somit Belastungen unterhalb höchster Intensität.“"
                            },
                            {
                                "example_id": "f20c1ac0-d594-4f57-a426-4361b73127cf",
                                "sense_id": "5e125ce4-fb75-36f6-8972-455e5fc13e3e",
                                "text": "„Einige wenige Ultramarathon-Läufe haben als Laufdistanz ein ganzzahliges Vielfaches der Marathondistanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
