                            {
                                "example_id": "19123c57-6fad-4267-bb19-8ebdb0812336",
                                "sense_id": "4cb44a2c-31fc-3efb-99cf-9fc8478ef9d5",
                                "text": "Tijdens het seizoen was er elke dinsdag een bal in de stadsfeestzaal, en Margaret liet er niet eentje lopen en vanwege haar lichtvoetigheid was ze erg in trek."
                            },
                            {
                                "example_id": "b2a2c14c-5a27-44e2-b7e1-5f3fd3f731e0",
                                "sense_id": "4cb44a2c-31fc-3efb-99cf-9fc8478ef9d5",
                                "text": "\"Kijk maar naar Kevin Strootman en Ron Vlaar. Afellay moest het juist altijd hebben van zijn technische begaafdheid en lichtvoetigheid.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "8ad54ea2-45e7-3df3-bc8a-e99d92ec8dc5",
                        "entry_id": "fc856e0b-8531-36a5-8dec-0c0dc5b89225",
                        "glosses": [
                            "het vrolijk en niet zo ernstig zijn"
                        ],
