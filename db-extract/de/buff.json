                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96da41a-4c26-407a-8498-277811e37af5",
                                                "sense_id": "4d8e21c9-5d40-37fa-b4f0-64852897fe5c",
                                                "text": "That's right: I'm taking driver's ed next semester. Hiring an interpreter for CHS and the deaf school outta my own hefty pockets. You're welcome. Oh, and I'm going to get really skinny and buff. All slim like a swimsuit model."
                                            }
                                        ]
