                        "target_lang_word": "babka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "731b91c4-ae7b-321a-aa8b-d80a2bb0de23",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "stará žena, bába"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55e18ba0-1d83-4259-a92f-b484422177de",
                                                "sense_id": "731b91c4-ae7b-321a-aa8b-d80a2bb0de23",
                                                "text": "Klerikální vůdce bojuje za Řím; klerikální babka bojuje, jak se domnívá, za svého Pánaboha."
                                            },
                                            {
                                                "example_id": "9375b900-f247-4318-8e71-ed3f45752a86",
                                                "sense_id": "731b91c4-ae7b-321a-aa8b-d80a2bb0de23",
                                                "text": "K nám se vetchá babka plouhá. Kdo jsi, zjeve? — „Lidská touha, stárnu, stárnu rok co rok.“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c32a9e2f-9333-363a-a5e3-f9c96d585d3d",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "způsob uvázání šátku na hlavě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a7f91a-8f99-4a61-86c8-a5a2aac50f22",
                                                "sense_id": "c32a9e2f-9333-363a-a5e3-f9c96d585d3d",
                                                "text": "Stará žena kývala vážně hlavou, až se jí konečky u červené babky pohazovaly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df9a443-64b4-3089-9af3-02879a1fafe0",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "kovadlinka k naklepávání kosy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b05cd579-1305-48e8-b354-8c843d382073",
                                                "sense_id": "0df9a443-64b4-3089-9af3-02879a1fafe0",
                                                "text": "„Umím sekat nejen travnou i obilnou kosou — ale umím ji na kosiště nasadit a když ji v setí ztupím, na babce ji naklepat umím,“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da5fb97d-17d0-3d0d-8e96-397dd4765735",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "suchohřib žlutomasý"
                                        ],
                                        "tags": [
                                            "lidově"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42bd9f41-60b8-42e9-842d-48d5d8d0ef87",
                                                "sense_id": "da5fb97d-17d0-3d0d-8e96-397dd4765735",
                                                "text": "Poslední dobou hodně rostou babky, asi jich zajdu pár do lesa nasbírat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "632e32f2-9522-3f03-8418-46e823777afc",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "peníz (původně drobná uherská mince), nepatrný peníz, maličkost"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d12e7ff-61b4-4414-a77b-59885ce057d0",
                                                "sense_id": "632e32f2-9522-3f03-8418-46e823777afc",
                                                "text": "Dostal jsem ani ne pár babek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3425aabe-8723-3440-8a54-457660f36252",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "stará zaječice"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "900b1bff-fd49-3f9a-b537-e3a75524c68d",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "porodní bába"
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38238a2f-dea6-478b-9a25-6434d150fb79",
                                                "sense_id": "900b1bff-fd49-3f9a-b537-e3a75524c68d",
                                                "text": "Děti nesené ke křtu, byly zavinovány do povijanu červené barvy, která měla ochranný význam. Na Podblanicku nesla babka dítě ve velkém, sametovém vyšívaném přehozu, jejž si zavazovala pod krkem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daab17aa-4118-3c99-a06e-fbd8b866c743",
                                        "entry_id": "e39e934f-c4af-3585-b715-022637e941bb",
                                        "glosses": [
                                            "část tkacího stroje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d06491-387a-495c-b931-234618256215",
                                                "sense_id": "daab17aa-4118-3c99-a06e-fbd8b866c743",
                                                "text": "„Babky pro automatické stavy se vyrábějí podle ON 81 3180.“"
                                            }
                                        ]
                                    }
                                ]
