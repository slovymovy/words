                "senses": [
                    {
                        "sense_id": "a90cfed1-e9a4-3005-98d7-5ea63915ded4",
                        "entry_id": "1589acf1-af91-3678-9228-4cdbd2187b03",
                        "glosses": [
                            "delight, joy, comfort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e99f84-499b-43d8-bdc4-93a81571e966",
                                "sense_id": "a90cfed1-e9a4-3005-98d7-5ea63915ded4",
                                "text": "Я пригласил своего спутника выпить вместе стакан чая, ибо со мной был чугунный чайник — единственная отрада моя в путешествиях по Кавказу.",
                                "translation": "I invited my fellow traveller to join me at tea for I had with me a cast-iron teakettle—my sole comfort on my Caucasian travels.",
                                "english": "I invited my fellow traveller to join me at tea for I had with me a cast-iron teakettle—my sole comfort on my Caucasian travels."
                            }
                        ]
                    }
                ],
