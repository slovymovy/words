                                "target_senses": [
                                    {
                                        "sense_id": "52f3868d-6d98-31c6-af0a-699ca7cc6946",
                                        "entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                                        "glosses": [
                                            "To make ugly; to destroy or worsen the appearance or attractiveness of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433ac140-3c14-4b15-a64c-2d0b2b9df30b",
                                                "sense_id": "52f3868d-6d98-31c6-af0a-699ca7cc6946",
                                                "text": "These guys around that block had this thing about how I was uglifying the neighborhood."
                                            },
                                            {
                                                "example_id": "3c90af93-61a2-4095-a4a5-8eee97b22332",
                                                "sense_id": "52f3868d-6d98-31c6-af0a-699ca7cc6946",
                                                "text": "She uglifies every thing near her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4adccca-33c9-347d-bd29-916fa15b5eb3",
                                        "entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                                        "glosses": [
                                            "To become ugly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd48ca71-52cb-44a3-b9dd-2d1702112b69",
                                                "sense_id": "b4adccca-33c9-347d-bd29-916fa15b5eb3",
                                                "text": "Inevitably those bodies age and uglify under her influence, but if they are outstandingly beautiful at the outset, that process takes longer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56eb424a-1103-3726-bb81-f877175a9004",
