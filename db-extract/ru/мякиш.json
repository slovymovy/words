                "senses": [
                    {
                        "sense_id": "be0157c7-b9df-3775-b3b1-3164d2cad520",
                        "entry_id": "c178ddc3-89aa-36b8-a4f1-b1cfcecb0833",
                        "glosses": [
                            "мягкая часть хлеба, находящаяся под коркой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f546dcf-eb58-4c16-ae09-cd2fe3540409",
                                "sense_id": "be0157c7-b9df-3775-b3b1-3164d2cad520",
                                "text": "Хлебный мякиш."
                            },
                            {
                                "example_id": "8d166785-c77b-4063-a524-e0353ffe0cd8",
                                "sense_id": "be0157c7-b9df-3775-b3b1-3164d2cad520",
                                "text": "Растительное масло и патока улучшают свойства мякиша, а сахар и незначительная добавка ржаной муки повышают питательность, калорийность и улучшают вкус хлеба."
                            }
                        ]
                    }
                ],
