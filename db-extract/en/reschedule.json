                                                "example_id": "d2bf7645-1d8f-4006-9d65-5fcb03deb530",
                                                "sense_id": "c448d718-5e64-3343-9224-54cc756a6571",
                                                "text": "Bien sûr, notre patrimoine génétique s’impose à nous, mais, tout au long de la vie, notre cerveau peut être reprogrammé par les relations affectives et amoureuses."
                                            }
                                        ]
