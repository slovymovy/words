                            "Finanzen"
                        ],
                        "examples": [
                            {
                                "example_id": "cbad736d-b33c-4d0c-8188-10a18fc6a503",
                                "sense_id": "c4188691-1737-3b49-9bce-8a83f44fa219",
                                "text": "Peter wird seine Bank wechseln, weil ihm eine andere Bank höhere Zinssätze verspricht."
                            },
                            {
                                "example_id": "d1a6c1cc-1c7c-4fc9-9d9b-f27776483145",
                                "sense_id": "c4188691-1737-3b49-9bce-8a83f44fa219",
                                "text": "„Wie hoch der Zinssatz jeweils ausfällt, richtet sich danach, wie hoch das vermutete Risiko ist, dass man sein verliehenes Geld nie wiedersieht.“"
                            },
                            {
                                "example_id": "d0a2cd60-74c0-403d-879d-fca56954628f",
                                "sense_id": "c4188691-1737-3b49-9bce-8a83f44fa219",
                                "text": "„1539 musste Luther in Leipzig gegen Zinssätze von 40 Prozent wettern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
