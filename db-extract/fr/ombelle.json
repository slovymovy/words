                "senses": [
                    {
                        "sense_id": "6e8c6930-c381-3591-8fb4-56255600189d",
                        "entry_id": "6e0c5d1e-12b9-31a7-b46f-a2232fe57b3e",
                        "glosses": [
                            "Inflorescence où tous les pédicelles sont attachés au même point de la tige et toutes les fleurs s’élèvent au même niveau selon une surface sphérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d0b277c-5501-4936-b152-b8488792c5e7",
                                "sense_id": "6e8c6930-c381-3591-8fb4-56255600189d",
                                "text": "L’ombelle peut ressembler à une corymbe mais dans celle-ci, les pédoncules naissent de différents points de la tige."
                            },
                            {
                                "example_id": "e7bd45cf-f4d3-4907-9146-4b5c7a65a5b7",
                                "sense_id": "6e8c6930-c381-3591-8fb4-56255600189d",
                                "text": "Le panais, le sureau, le cerfeuil ont leurs fleurs en ombelle."
                            },
                            {
                                "example_id": "8b5d7583-3caa-4196-bf0e-cec2f211f5dc",
                                "sense_id": "6e8c6930-c381-3591-8fb4-56255600189d",
                                "text": "Plus de honte et plus de scrupules à goûter les plaisirs de la route, le vol d'un papillon autour d'une ombelle de ciguë, la chanson pointue d'un roitelet des haies; …."
                            }
                        ]
                    }
                ],
