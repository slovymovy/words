                "senses": [
                    {
                        "sense_id": "703172c5-530e-3a57-a498-c9878d18ee2b",
                        "entry_id": "0ef3b75c-ced3-33ba-bac0-826c85942570",
                        "glosses": [
                            "ein Baum, dessen Früchte die Watschen sind, sodass wer daran rüttelt, sich derart benimmt, dass er körperliche Bestrafung zu erbetteln scheint"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "706a6665-d298-44c5-9f95-68796ecc1ced",
                                "sense_id": "703172c5-530e-3a57-a498-c9878d18ee2b",
                                "text": "Du rüttelst heut schon den ganzen Tag am Watschenbaum!"
                            },
                            {
                                "example_id": "f25016e8-f920-468a-8f94-9572f9bea8b5",
                                "sense_id": "703172c5-530e-3a57-a498-c9878d18ee2b",
                                "text": "„Was aber Watschenbaum heißt, das wissen die wenigsten Leut’. Da muß man sich schon gut umgesehen haben in der Welt. […] Dann kann man auftrumpfen: der Watschenbaum, das ist kein Baum, er tut nur so. Der Watschenbaum ist ein fester Arm, und was fünffingerig dranhängt, daraus macht man die Watschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
