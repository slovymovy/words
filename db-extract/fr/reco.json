                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0de1e6-2483-4cb4-82ee-b78f05acf5f3",
                                "sense_id": "6b2e3970-d71d-3ce1-952a-2fc60c7dd984",
                                "text": "Vol de reco, faire une reco, partir en reco…"
                            }
                        ]
                    },
                    {
                        "sense_id": "72bcd7b4-0387-369b-a042-8dc2cac7d732",
                        "entry_id": "343eb946-62f0-372c-8841-00be6aedf0e7",
                        "glosses": [
                            "Reconnaissance d’un lieu pour en connaître les détails."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e549c77c-7b5a-4f14-8c91-b372f5ccc26a",
                                "sense_id": "72bcd7b4-0387-369b-a042-8dc2cac7d732",
                                "text": "Bon, les p’tits gars, ce matin, vous allez me faire une reco de Saint-Maximin et me trouver un troquet sympa !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a476cec3-42bc-399a-b428-60717c730f47",
                        "entry_id": "343eb946-62f0-372c-8841-00be6aedf0e7",
                        "glosses": [
                            "Reconnexion à un réseau ou à un service."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ba313854-d073-4cc6-9629-e870fe9c8c3f",
                                "sense_id": "a476cec3-42bc-399a-b428-60717c730f47",
                                "text": "La reco échoue encore, la barbe !"
                            }
                        ]
                    },
                    {
                        "sense_id": "06cafe22-9dbe-3c4a-babe-7a757d2dc6eb",
                        "entry_id": "343eb946-62f0-372c-8841-00be6aedf0e7",
                        "glosses": [
                            "Recommandation."
