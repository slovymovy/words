                "senses": [
                    {
                        "sense_id": "cf90d13b-c3e6-3666-afa0-8a8d299868ba",
                        "entry_id": "ac7876cc-4612-3a10-817a-78ec76c7c3f2",
                        "glosses": [
                            "to push forward, to barge (through)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30dd84ff-9216-42ef-80fa-ca3be75cc997",
                                "sense_id": "cf90d13b-c3e6-3666-afa0-8a8d299868ba",
                                "text": "попере́ть сквозь толпу́",
                                "translation": "to barge through the crowd",
                                "english": "to barge through the crowd"
                            },
                            {
                                "example_id": "fbd4965f-3d3a-484e-aa24-16cc1708aeeb",
                                "sense_id": "cf90d13b-c3e6-3666-afa0-8a8d299868ba",
                                "text": "про́тив () не попрёшь",
                                "translation": "you have to face (); there's nothing you can do (with)",
                                "english": "you have to face (); there's nothing you can do (with)"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3c16711-0d44-34de-b280-a5cdb12981e7",
                        "entry_id": "ac7876cc-4612-3a10-817a-78ec76c7c3f2",
                        "glosses": [
                            "to pour out, to flow out, to erupt, to gush out, to burst forth"
                        ],
                        "tags": [
                            "also",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ac4eba6f-27f1-4758-aca8-a182233a45ea",
                                "sense_id": "f3c16711-0d44-34de-b280-a5cdb12981e7",
                                "text": "ла́ва попёрла из верши́ны вулка́на",
                                "translation": "lava erupted [burst forth] from the top of the volcano",
                                "english": "lava erupted [burst forth] from the top of the volcano"
                            },
                            {
                                "example_id": "7801954d-96af-4b6e-8d48-fe368d2c983f",
                                "sense_id": "f3c16711-0d44-34de-b280-a5cdb12981e7",
                                "text": "зло́ба так и попёрла из него́",
                                "translation": "he burst with fury",
                                "english": "he burst with fury"
                            },
                            {
                                "example_id": "d7aa9444-8544-4eb1-9756-1fcc09ab6a51",
                                "sense_id": "f3c16711-0d44-34de-b280-a5cdb12981e7",
                                "text": "уда́ча попёрла кому́-либо",
                                "translation": "someone has a windfall; someone has a big/lucky break",
                                "english": "someone has a windfall; someone has a big/lucky break"
                            }
                        ]
                    },
                    {
                        "sense_id": "e57c5446-a8a6-3fc4-90b3-2ee3c660347a",
