                    ]
                },
                {
                    "sense_id": "a052cd4b-51c8-3d1c-9cbf-434a22afbf1b",
                    "sense_definition": "ein Feuer durch regelmäßige Zufuhr von Brennstoff am Brennen halten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie legten immer wieder trockenes Holz nach, um das Feuer zu <w>nähren</w>."
                        },
                        {
                            "text": "Der frische Wind trieb Sauerstoff in die Glut und <w>nährte</w> die Flammen zusätzlich."
                        }
                    ],
                    "synonyms": [
                        "schüren",
                        "unterhalten"
                    ],
                    "common_phrases": [
                        "das Feuer nähren",
                        "die Flammen nähren"
                    ]
                },
                {
                    "sense_id": "f5ea230d-6e8a-3828-8fb4-91140dc1267e",
                    "sense_definition": "dem Körper spürbar Energie liefern, sättigend und reich an Nährstoffen sein",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nahrungsaufnahme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein Teller mit frischer Hafergrütze <w>nährt</w> gut und gibt Kraft für den ganzen Vormittag."
                        },
                        {
                            "text": "Die warme Suppe <w>nährte</w> die erschöpften Wanderer nach dem langen Marsch durch die Kälte."
