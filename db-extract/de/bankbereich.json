                "senses": [
                    {
                        "sense_id": "fc4d0078-403b-3537-9a97-a5da71bf6c33",
                        "entry_id": "3741a101-90b7-3c8e-8f55-e52f43f5cd27",
                        "glosses": [
                            "Summe der Angelegenheiten, die die Geldinstitute betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675c40ae-06c2-429e-89a9-6c9bcbafcfc5",
                                "sense_id": "fc4d0078-403b-3537-9a97-a5da71bf6c33",
                                "text": "„Im Bankbereich umfassen die angebotenen Leistungen nicht nur die klassischen Finanzprodukte und Services.“"
                            },
                            {
                                "example_id": "af8fb2d7-b479-4684-9cd0-3dc537e300bb",
                                "sense_id": "fc4d0078-403b-3537-9a97-a5da71bf6c33",
                                "text": "„Auf die Risiken und Chancen für den Bankbereich wird im Verlauf der Arbeit eingegangen.“"
                            },
                            {
                                "example_id": "ccc7e648-2583-41d6-bbfa-fcacbb174cfa",
                                "sense_id": "fc4d0078-403b-3537-9a97-a5da71bf6c33",
                                "text": "„Im Bankbereich werden so beispielsweise papierhafte Überweisungsträger gescannt und in digitaler Form als Grafikdokument archiviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
