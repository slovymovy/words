                                                "sense_id": "65f5ad6d-3686-38b1-8795-fcc8a61a78ea",
                                                "text": "A society where a topic cannot be discussed, does not have free speech."
                                            },
                                            {
                                                "example_id": "4077e775-465b-4496-b6c5-72cb5d36a95c",
                                                "sense_id": "65f5ad6d-3686-38b1-8795-fcc8a61a78ea",
