                "senses": [
                    {
                        "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                        "entry_id": "3c786e05-6f2b-3a43-b765-bbe1d5540cb6",
                        "glosses": [
                            "Schmerzgefühl im Bauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a8d3134-d84e-41b5-80a9-6aef747f2a38",
                                "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                                "text": "„Jedes kleine Bauchzwicken, das Sophie als Kind begleitet hatte, lag laut Adelheid an der schrecklichen Fertigmilch, die Sophie bekommen hatte.“"
                            },
                            {
                                "example_id": "ac8e963c-c117-4cc6-ac8d-be38e4955165",
                                "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                                "text": "„Die letzte Ärztin hatte sie sogar aufgefordert, sich wegen dem lächerlichen Bauchzwicken nicht so anzustellen.“"
                            },
                            {
                                "example_id": "a3306e29-d226-4220-b3e5-90478af4732a",
                                "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                                "text": "„Rohes Gemüse ist recht unverträglich und macht Bauchzwicken und heftige Blähungen bei Leuten, die das nicht gewohnt sind.“"
                            },
                            {
                                "example_id": "e851ace3-e303-43e8-98db-498cfd0466ca",
                                "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                                "text": "„Kein Arzt findet eine stimmige Erklärung, auch dieses ewige Bauchzwicken und die verdammten Nackenschmerzen erscheinen unerklärlich.“"
                            },
                            {
                                "example_id": "8fafe90b-1cd8-4773-b647-d1b51f908547",
                                "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                                "text": "„Begonnen hatte es mit Bauchzwicken, einer unspezifischen Beschwerde, wie das in der Medizinersprache hieß.“"
                            },
                            {
                                "example_id": "389a5a0f-534c-4e17-a01b-494d9c175717",
                                "sense_id": "71295c6f-96d2-3dcc-a2b6-a4c52a591f00",
                                "text": "„Es dauerte nicht lange, und ich hatte vor Mathestunden Bauchzwicken und vor Matheklausuren Alpträume und Schweißausbrüche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
