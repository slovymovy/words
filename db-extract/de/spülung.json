                "senses": [
                    {
                        "sense_id": "024bf2cf-0afd-3557-a55a-c02ec653668f",
                        "entry_id": "8975961d-6ad7-3e24-bef8-55a9bc00666a",
                        "glosses": [
                            "Bauteil am WC, das alles aus dem Toilettenbecken in dem Abfluss spült"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "487b843a-ca8d-4b7a-97ca-71decf637f24",
                                "sense_id": "024bf2cf-0afd-3557-a55a-c02ec653668f",
                                "text": "Du hast vergessen, die Spülung zu betätigen!"
                            },
                            {
                                "example_id": "c87c779b-eeeb-4b7e-8874-a76bb6f2526e",
                                "sense_id": "024bf2cf-0afd-3557-a55a-c02ec653668f",
                                "text": "Seit gestern ist unsere Spülung kaputt, der Handwerker wurde bereits verständigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33acc632-aa7e-36fb-b6b6-4da93db4bd32",
                        "entry_id": "8975961d-6ad7-3e24-bef8-55a9bc00666a",
                        "glosses": [
                            "mit Wasser oder einem flüssigen Medikament erfolgende Reinigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16771dfa-1176-436e-97e3-afc8de3c993c",
                                "sense_id": "33acc632-aa7e-36fb-b6b6-4da93db4bd32",
                                "text": "Vom Arzt wurde ihm eine Spülung verordnet."
                            },
                            {
                                "example_id": "c04e91df-a73a-41ec-a4d4-e7c44a818d1d",
                                "sense_id": "33acc632-aa7e-36fb-b6b6-4da93db4bd32",
                                "text": "Der Ohrenarzt musste eine Spülung machen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8516e979-3b3b-36e1-ac65-ff8162239a47",
