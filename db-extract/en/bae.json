                        "examples": [
                            {
                                "example_id": "dba0dbc0-cfd3-4ed9-831a-4096aff4e1fd",
                                "sense_id": "5003fe81-079e-32b9-966d-3ef3e78c4b1d",
                                "text": "He's a lamb indeed, that baes like a bear.",
                                "translation": "他真是只小绵羊，吠声却像头熊。"
                            },
                            {
                                "example_id": "4e0da1bc-5b32-4fa1-aae2-401f6d6c82ff",
                                "sense_id": "5003fe81-079e-32b9-966d-3ef3e78c4b1d",
                                "text": "...the ewe that will not hear her lamb when it baes will never answer a calf when he bleats.",
                                "translation": "……母羊要是听不见她自己小羊的啼声，她决不会回答一头小牛的叫喊。"
                            }
                        ]
