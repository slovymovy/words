                },
                {
                    "sense_id": "f06e0265-e1c9-3154-a66d-a876c9eee99d",
                    "sense_definition": "Fervor, intensity of emotion or expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She defended her opinion with surprising <w>warmth</w> during the debate.",
                            "target_lang_translations": {
                                "ru": "Она отстаивала своё мнение с удивительной <w>горячностью</w> во время дебатов.",
                                "zh": "在辩论中，她以令人惊讶的<w>热烈</w>态度捍卫了自己的观点。",
                                "es": "Defendió su opinión con sorprendente <w>pasión</w> durante el debate."
                            }
                        },
                        {
                            "text": "There was a certain <w>warmth</w> in his voice when he spoke of his home country.",
                            "target_lang_translations": {
                                "ru": "В его голосе звучала определённая <w>теплота</w>, когда он говорил о родине.",
                                "zh": "当他谈到祖国时，他的声音里带着一种<w>深情</w>。",
                                "es": "Había cierta <w>calidez</w> en su voz cuando hablaba de su país natal."
                            }
                        }
                    ],
                    "synonyms": [
                        "fervor",
                        "passion",
                        "intensity",
                        "zeal"
                    ],
                    "antonyms": [
                        "apathy",
                        "coolness"
