                                "target_lang_word": "right side",
                                "target_lang_sense_clarification": "fabric"
                            },
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "front of building or object"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正面",
                                "target_lang_sense_clarification": "织物或物体"
                            }
                        ]
                    }
                }
            ]
