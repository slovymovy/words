                    "frequency": "Middle",
                    "semantic_group_id": "decline_wasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Months of bed rest caused severe muscular <w>atrophy</w> in his legs."
                        },
                        {
                            "text": "Without regular practice, you will notice a gradual <w>atrophy</w> of your language skills."
                        }
                    ],
                    "synonyms": [
                        "wasting",
                        "degeneration",
                        "deterioration",
                        "decay"
                    ],
                    "antonyms": [
                        "hypertrophy"
                    ],
                    "common_phrases": [
                        "muscular atrophy",
                        "muscle atrophy"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                    "sense_definition": "To wither, degenerate, or waste away, especially from disuse or disease.",
