                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fascinating documentary managed to completely <w>engross</w> the students."
                        },
                        {
                            "text": "She was so <w>engrossed</w> in her book that she missed her bus stop."
                        }
                    ],
                    "common_phrases": [
