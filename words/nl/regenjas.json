                            }
                        },
                        {
                            "text": "Ik wou dat ik mijn <w>regenjas</w> had meegenomen naar het bos.",
                            "target_lang_translations": {
                                "en": "I wish I had brought my <w>raincoat</w> to the forest."
                            }
                        }
                    ],
                    "synonyms": [
