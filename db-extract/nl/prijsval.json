                        "examples": [
                            {
                                "example_id": "38faab02-27b3-4f0a-832a-2027b8385fb5",
                                "sense_id": "58a57be6-3bc0-373c-ab5e-a097df6ab766",
                                "text": "De prijzen aan de pomp blijven de komende tijd waarschijnlijk dalen. De OPEC, het kartel van olieproducerende landen, heeft vandaag in Wenen besloten het huidige productieniveau te handhaven. Een aantal OPEC-leden had aangedrongen op een beperking van de productie om de prijsval te stoppen. Maar Saudi-Arabië en een aantal Golfstaten voelen daar niets voor."
                            },
                            {
                                "example_id": "5f3d2e78-7c56-4a85-9e7d-1bf39da920d1",
                                "sense_id": "58a57be6-3bc0-373c-ab5e-a097df6ab766",
                                "text": "Maar ook de prijsval van aardgas met 37 procent die in 2013 begon, verklaart voor een deel de waardedaling, meldt het Centraal Bureau voor de Statistiek (CBS)."
                            }
                        ]
                    }
