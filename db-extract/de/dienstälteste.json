                        "examples": [
                            {
                                "example_id": "4c7bb417-c0e1-46f8-b566-ffe11960030d",
                                "sense_id": "fa3aa387-d09a-3eb1-aae0-7fe436187f20",
                                "text": "„Damit war Mugabe der dienstälteste Präsident im südlichen Afrika, was seine außenpolitische Statur vergrößerte.“"
                            },
                            {
                                "example_id": "69c36541-ece5-4c4b-acac-54c1ee3a4db8",
                                "sense_id": "fa3aa387-d09a-3eb1-aae0-7fe436187f20",
                                "text": "„Dienstältester Abgeordneter ist Dr. Gregor Gysi (Die Linke), der dem Bundestag seit dem 3. Oktober 1990 (mit einer Unterbrechung von 2002 bis 2005) angehört.“"
                            }
