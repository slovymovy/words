                ],
                "senses": [
                    {
                        "sense_id": "5e1e4380-59d8-345b-b715-6df59fd0c889",
                        "entry_id": "5f9c2d35-b0ce-3548-b221-f71dcadc3e05",
                        "glosses": [
                            "jemand, der etwas (fabrikmäßig oder in großem Maße) herstellt oder herstellen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9699cc45-ce6c-4e19-b7a7-038eecfa8edc",
                                "sense_id": "5e1e4380-59d8-345b-b715-6df59fd0c889",
                                "text": "Von manch altem Fabrikanten hat man keine vorurteilsfreie Vorstellung."
                            },
                            {
                                "example_id": "af549228-eb7b-470e-a3a0-f2274714fe89",
                                "sense_id": "5e1e4380-59d8-345b-b715-6df59fd0c889",
                                "text": "„Die Fabrikanten, mit denen er verhandelt hatte, kamen alle zum Diner.“"
                            },
                            {
                                "example_id": "f5eba649-04b9-4c01-8871-61bb9c48cad7",
                                "sense_id": "5e1e4380-59d8-345b-b715-6df59fd0c889",
                                "text": "„Er kaufte sich sogar eine Adler-Schreibmaschine und tippte einmal in der Woche seine Bestellungen an die Fabrikanten darauf, was seinen Praktikantinnen imponierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5f6169b-dd27-3df2-87ac-a6c950e361a9",
                        "entry_id": "5f9c2d35-b0ce-3548-b221-f71dcadc3e05",
                        "glosses": [
                            "Besitzer, Eigentümer oder Betreiber einer Fabrik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea45bde2-45f3-4e1a-90aa-1c98b192743b",
                                "sense_id": "a5f6169b-dd27-3df2-87ac-a6c950e361a9",
                                "text": "Von manch altem Fabrikanten hat man keine vorurteilsfreie Vorstellung."
                            },
                            {
                                "example_id": "89881a27-b50b-4974-957c-ddfc3b7e9c81",
                                "sense_id": "a5f6169b-dd27-3df2-87ac-a6c950e361a9",
                                "text": "„Die Fabrikanten, mit denen er verhandelt hatte, kamen alle zum Diner.“"
