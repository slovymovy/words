                                            {
                                                "example_id": "b7b3d495-2c55-47db-be0e-f8c28a27a103",
                                                "sense_id": "e16d8b95-c2ac-37ca-88b4-143e51883aa4",
                                                "text": "Wer an Beriberi erkrankt, leidet unter anderem an Lähmungen."
