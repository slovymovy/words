{
    "word_family": [
        "Christmassy",
        "Christmastime",
        "Christmasing"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f5610d1d-f05c-359e-8a9c-961aa0d52eb3",
                    "sense_definition": "A festival or holiday commemorating the birth of Jesus Christ, celebrated on December 25 in Western Christianity.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "holiday",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Do you celebrate <w>Christmas</w> with your family every year?",
                            "target_lang_translations": {
                                "ru": "Вы празднуете <w>Рождество</w> с семьей каждый год?"
                            }
                        },
                        {
                            "text": "This <w>Christmas</w> we will open presents and then go to grandma’s for dinner.",
                            "target_lang_translations": {
                                "ru": "В это <w>Рождество</w> мы откроем подарки, а потом поедем к бабушке на ужин."
                            }
                        }
                    ],
                    "synonyms": [
                        "Noel",
                        "Yule",
                        "Chrimbo"
                    ],
                    "common_phrases": [
                        "merry christmas",
                        "christmas day",
                        "christmas tree",
                        "christmas present"
                    ],
                    "target_lang_definitions": {
                        "ru": "Христианский праздник в честь рождения Иисуса Христа, отмечаемый 25 декабря в западной традиции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рождество",
                                "target_lang_sense_clarification": "общепринятое название праздника"
                            },
                            {
                                "target_lang_word": "Рождество Христово",
                                "target_lang_sense_clarification": "полное официальное и религиозное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47cf41e3-8408-37b9-8a1f-a26b7c09b288",
                    "sense_definition": "The period of time before and after Christmas Day during which people prepare for and celebrate the holiday.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The last three <w>Christmases</w> have been very good for local retailers.",
                            "target_lang_translations": {
                                "ru": "Последние три <w>рождественских сезона</w> были очень удачными для местных розничных торговцев."
                            }
                        },
                        {
                            "text": "Many <w>christmas</w> shoppers spent less this December than they did last year.",
                            "target_lang_translations": {
                                "ru": "Многие <w>рождественские</w> покупатели потратили в этом декабре меньше, чем в прошлом году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "christmas season",
                        "christmas shopping",
                        "christmas holiday"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени до и после Рождества, посвященный подготовке и празднованию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рождественские праздники",
                                "target_lang_sense_clarification": "период торжеств"
                            },
                            {
                                "target_lang_word": "Рождество",
                                "target_lang_sense_clarification": "в значении праздничного сезона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "851f9f5b-f6f5-308f-9430-635df207353b",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author Lloyd <w>Christmas</w> is known for his unique storytelling style.",
                            "target_lang_translations": {
                                "ru": "Автор Ллойд <w>Кристмас</w> известен своим уникальным стилем повествования."
                            }
                        },
                        {
                            "text": "We are meeting with Mr. <w>Christmas</w> to discuss the new contract.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с мистером <w>Кристмасом</w>, чтобы обсудить новый контракт."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "used as a family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кристмас",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e58d154-6628-3c4f-ba53-4c11e3ba4d4b",
                    "sense_definition": "The name of several places in the United States, such as a town in Florida.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many people visit <w>Christmas</w>, Florida, just to get their mail postmarked there.",
                            "target_lang_translations": {
                                "ru": "Многие люди посещают город <w>Кристмас</w> во Флориде только для того, чтобы получить почтовый штемпель этого места."
                            }
                        },
                        {
                            "text": "The small community of <w>Christmas</w> is located in Orange County.",
                            "target_lang_translations": {
                                "ru": "Небольшая община <w>Кристмас</w> расположена в округе Ориндж."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to United States geography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких населенных пунктов в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кристмас",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17adf11a-480f-3744-85fc-56fd52bb4c08",
                    "sense_definition": "Sprigs of holly and other evergreen plants used as holiday decorations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hall was decorated with bits of <w>Christmas</w> tucked into every corner.",
                            "target_lang_translations": {
                                "ru": "Старый зал был украшен кусочками <w>рождественской зелени</w>, расставленной по всем углам."
                            }
                        },
                        {
                            "text": "They used a bunch of <w>Christmas</w> to make the garland look more festive.",
                            "target_lang_translations": {
                                "ru": "Они использовали охапку <w>хвойных веток</w>, чтобы гирлянда выглядела более празднично."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "older usage referring to the greenery itself"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ветки падуба и других вечнозеленых растений, используемые в качестве праздничного украшения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рождественская зелень",
                                "target_lang_sense_clarification": "декоративные ветки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "911a6cca-359e-3362-be57-26c7468570ee",
                    "sense_definition": "Having a color scheme of red and green.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer chose a <w>Christmas</w> pattern for the winter blankets.",
                            "target_lang_translations": {
                                "ru": "Дизайнер выбрал <w>рождественский</w> узор для зимних одеял."
                            }
                        },
                        {
                            "text": "She wore a <w>christmas</w> sweater with bright red and green stripes.",
                            "target_lang_translations": {
                                "ru": "На ней был <w>рождественский</w> свитер в ярко-красную и зеленую полоску."
                            }
                        }
                    ],
                    "common_phrases": [
                        "christmas colors"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe color combinations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий красно-зеленую цветовую гамму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рождественских цветов",
                                "target_lang_sense_clarification": "о расцветке"
                            },
                            {
                                "target_lang_word": "красно-зеленый",
                                "target_lang_sense_clarification": "описание палитры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02f591c2-eb61-366f-b855-e1f21481e872",
                    "sense_definition": "Describing a dish served with both red and green chili sauce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like my enchiladas <w>Christmas</w> style with both sauces.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел энчиладас в стиле <w>«Рождество»</w>, с обоими соусами."
                            }
                        },
                        {
                            "text": "The restaurant is famous for its <w>christmas</w> burritos featuring red and green peppers.",
                            "target_lang_translations": {
                                "ru": "Ресторан знаменит своими буррито <w>«Рождество»</w> с красным и зеленым перцем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "christmas style"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in New Mexican cuisine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо, подаваемое одновременно с красным и зеленым соусом чили (кухня Нью-Мексико)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«Рождество»",
                                "target_lang_sense_clarification": "стиль подачи с двумя соусами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9864bd61-8b62-3211-adae-4b3d51eae42e",
                    "sense_definition": "To celebrate the holiday of Christmas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new advertisement asks how different families <w>Christmas</w> in their own way.",
                            "target_lang_translations": {
                                "ru": "В новой рекламе спрашивается, как разные семьи <w>празднуют Рождество</w> по-своему."
                            }
                        },
                        {
                            "text": "We usually <w>Christmas</w> at home with a big dinner and movies.",
                            "target_lang_translations": {
                                "ru": "Мы обычно <w>отмечаем Рождество</w> дома с большим ужином и фильмами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage of the noun as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Праздновать Рождество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "праздновать Рождество",
                                "target_lang_sense_clarification": "отмечать праздник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f033d0d-4e9f-364f-a1ed-bfbc0cbebb06",
                    "sense_definition": "To spend the Christmas season in a specific location.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>Christmas</w> in the mountains to see the snow.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>провести Рождество</w> в горах, чтобы увидеть снег."
                            }
                        },
                        {
                            "text": "He has <w>Christmased</w> in many different countries over the years.",
                            "target_lang_translations": {
                                "ru": "За эти годы он <w>встречал Рождество</w> во многих разных странах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить рождественские каникулы в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить Рождество",
                                "target_lang_sense_clarification": "о месте пребывания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "194d62af-d65b-378a-a74f-88519bb46ea0",
                    "sense_definition": "To decorate a place with holiday greenery or ornaments.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town was completely <w>Christmased</w> with lights and bows by early December.",
                            "target_lang_translations": {
                                "ru": "К началу декабря город был полностью <w>украшен к Рождеству</w> огнями и бантами."
                            }
                        },
                        {
                            "text": "Let's finish <w>Christmasing</w> the living room before the guests arrive.",
                            "target_lang_translations": {
                                "ru": "Давайте закончим <w>украшать</w> гостиную до прихода гостей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать помещение рождественской зеленью или игрушками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать к Рождеству",
                                "target_lang_sense_clarification": "декорировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfda6933-5cab-3013-b10e-ac62a32c6a29",
                    "sense_definition": "To become exhausted or overwhelmed by holiday celebrations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By the end of the week, the children were all <w>Christmased</w> out and went to bed early.",
                            "target_lang_translations": {
                                "ru": "К концу недели дети совсем <w>устали от праздников</w> и рано легли спать."
                            }
                        },
                        {
                            "text": "I am feeling a bit <w>Christmased</w> out after attending three parties in a row.",
                            "target_lang_translations": {
                                "ru": "Я чувствую, что немного <w>пресытился Рождеством</w> после трех вечеринок подряд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "christmased out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used in the form 'Christmased out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устать или пресытиться рождественскими празднованиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перенасытиться Рождеством",
                                "target_lang_sense_clarification": "устать от праздников"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "08ec3184-f913-31ed-b774-266e5d339b55",
                    "sense_definition": "An exclamation used to express surprise, annoyance, or frustration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>Christmas</w>! I completely forgot to buy the milk.",
                            "target_lang_translations": {
                                "ru": "Ой, <w>ёлки-палки</w>! Я совсем забыл купить молоко."
                            }
                        },
                        {
                            "text": "<w>Christmas</w>! I didn't know you were standing right behind me.",
                            "target_lang_translations": {
                                "ru": "<w>Боже мой</w>! Я и не знал, что ты стоишь прямо за моей спиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "jiminy Christmas",
                        "Jimmy Christmas"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a milder substitute for religious oaths"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее удивление, раздражение или досаду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ёлки-палки",
                                "target_lang_sense_clarification": "мягкое ругательство"
                            },
                            {
                                "target_lang_word": "Боже мой",
                                "target_lang_sense_clarification": "выражение удивления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}