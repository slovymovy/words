                ],
                "senses": [
                    {
                        "sense_id": "d4804629-eac7-3ce7-bfd6-6d2bd686c940",
                        "entry_id": "a7b5d040-0987-373a-b422-e4f5c2563577",
                        "glosses": [
                            "Stäbchen aus magnetischem Material, das in Flüssigkeiten gegeben wird, um es mithilfe eines Magnetrührers in eine Drehung zu versetzen"
                        ],
                        "tags": [
                            "Laborausstattung"
                        ],
                        "examples": [
                            {
                                "example_id": "32f6fd80-4d35-4fd2-b0b5-b4b13eb919f2",
                                "sense_id": "d4804629-eac7-3ce7-bfd6-6d2bd686c940",
                                "text": "„Der Magnetrührstab im Reaktionskolben wird vom Magnetrührer in Bewegung gesetzt.“"
                            },
                            {
                                "example_id": "3ccd9028-6cc5-4f7b-9782-54e5576a08cf",
                                "sense_id": "d4804629-eac7-3ce7-bfd6-6d2bd686c940",
                                "text": "„Zur Vermeidung von Siederverzügen während der Destillation (plötzliches, explosionsartiges Verdampfen des Destillationsgutes) wird während der Destillation mit einem Magnetrührstab und Magnetrührer gerührt.“"
                            },
                            {
                                "example_id": "fc2cad54-08c7-405e-b3ac-867a1f305882",
                                "sense_id": "d4804629-eac7-3ce7-bfd6-6d2bd686c940",
                                "text": "„Das Rühren solcher Kulturen erfolgt am besten langsam und mit großflächigen Rührblättern oder mit einem dicken Magnetrührstab.“"
                            },
                            {
                                "example_id": "054b9773-0f85-490b-8fd4-2ed92baccf65",
                                "sense_id": "d4804629-eac7-3ce7-bfd6-6d2bd686c940",
                                "text": "„Als Reaktionsgefässe dienten vier 2 ml Schraubdeckgläser mit passendem Magnetrührstab, welche in den 60 ml Autoklaven (Premex) eingesetzt wurden.“"
                            },
                            {
                                "example_id": "70d59a50-1bba-40b2-982c-2599609105a9",
                                "sense_id": "d4804629-eac7-3ce7-bfd6-6d2bd686c940",
                                "text": "„Ein fest verschraubbarer Schlenk-Kolben mit N₂-Anschluß (vorzugsweise mit PTFE-Hahn) und Magnetrührstab wird dreimal ausgeheizt und jeweils mit getrocknetem N₂ begast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
