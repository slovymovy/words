                    {
                        "translation_id": "e77854d7-1faf-45e2-bc5a-9efd022eba79",
                        "source_entry_id": "21e23cac-1476-3888-8a06-b45b0ba79dbc",
                        "source_sense_id": "3f165914-8767-3d95-a680-3b322df50707",
