{
    "word_family": [
        "mustardy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                    "sense_definition": "A pungent powder or paste made from the seeds of certain plants, used as a condiment or spice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "condiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually put a little bit of <w>mustard</w> on my hot dog to give it more flavor.",
                            "target_lang_translations": {
                                "ru": "Я обычно кладу немного <w>горчицы</w> в хот-дог, чтобы придать ему больше вкуса."
                            }
                        },
                        {
                            "text": "When the waitress brought the food, I asked whether she had any Dijon <w>mustard</w> for my sandwich.",
                            "target_lang_translations": {
                                "ru": "Когда официантка принесла еду, я спросил, есть ли у нее дижонская <w>горчица</w> для моего сэндвича."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Dijon mustard",
                        "wholegrain mustard",
                        "honey mustard",
                        "hot mustard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый порошок или паста из семян определенных растений, используемые в качестве приправы или специи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горчица",
                                "target_lang_sense_clarification": "приправа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a563fe94-bfe4-3845-bd34-d191c14258fc",
                    "sense_definition": "A plant of the genus Brassica or related genera, typically having yellow flowers and pungent seeds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fields were covered in bright yellow <w>mustard</w> flowers during the early spring.",
                            "target_lang_translations": {
                                "ru": "Ранней весной поля были покрыты ярко-желтыми цветами <w>горчицы</w>."
                            }
                        },
                        {
                            "text": "Farmers often grow <w>mustard</w> as a cover crop to improve the quality of the soil.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто выращивают <w>горчицу</w> как покровную культуру для улучшения качества почвы."
                            }
                        }
                    ],
                    "synonyms": [
                        "senvy"
                    ],
                    "common_phrases": [
                        "mustard seed",
                        "wild mustard",
                        "mustard plant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение рода Brassica или родственных родов, обычно с желтыми цветами и острыми семенами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горчица",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "690fab03-3355-387d-b72b-46f03d882d79",
                    "sense_definition": "A dark, brownish-yellow color resembling the condiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to paint the kitchen walls a warm shade of <w>mustard</w> to match the wooden cabinets.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить стены кухни в теплый оттенок <w>горчичного</w>, чтобы они сочетались с деревянными шкафами."
                            }
                        },
                        {
                            "text": "The vintage sofa was upholstered in a deep <w>mustard</w> that looked very stylish.",
                            "target_lang_translations": {
                                "ru": "Винтажный диван был обит тканью глубокого <w>горчичного цвета</w>, что выглядело очень стильно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mustard yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный, коричневато-желтый цвет, напоминающий приправу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горчичный цвет",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "горчичный",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef36922f-c5f5-3a8f-8999-ec335433156b",
                    "sense_definition": "The edible leaves of the mustard plant, often used in salads or as a cooked green.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed fresh <w>mustard</w> and cress sandwiches for lunch in the garden.",
                            "target_lang_translations": {
                                "ru": "На обед в саду мы с удовольствием ели сэндвичи со свежей <w>горчицей</w> и кресс-салатом."
                            }
                        },
                        {
                            "text": "Adding some <w>mustard</w> greens to the salad provides a nice peppery bite.",
                            "target_lang_translations": {
                                "ru": "Добавление <w>листьев горчицы</w> в салат придает приятную перечную остроту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mustard greens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобные листья горчицы, часто используемые в салатах или в качестве приготовленной зелени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листовая горчица",
                                "target_lang_sense_clarification": "зелень"
                            },
                            {
                                "target_lang_word": "зелень горчицы",
                                "target_lang_sense_clarification": "листья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "442267e2-8133-32f0-ad6f-e48a0eed5267",
                    "sense_definition": "Energy, power, or speed, especially when throwing a ball.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher really put some <w>mustard</w> on that last throw to strike out the batter.",
                            "target_lang_translations": {
                                "ru": "Питчер действительно вложил <w>силу</w> в этот последний бросок, чтобы выбить бьющего."
                            }
                        },
                        {
                            "text": "If you want the ball to reach the goal, you need to put more <w>mustard</w> on it.",
                            "target_lang_translations": {
                                "ru": "Если ты хочешь, чтобы мяч долетел до ворот, тебе нужно ударить по нему с большей <w>силой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "put some mustard on it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергия, сила или скорость, особенно при броске мяча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "в броске или ударе"
                            },
                            {
                                "target_lang_word": "мощь",
                                "target_lang_sense_clarification": "энергия движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "185daf99-0ba4-3854-9b7d-e064aa5f0f7c",
                    "sense_definition": "A shortened term for <w>mustard gas</w>, a toxic chemical warfare agent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were terrified of the potential use of <w>mustard</w> during the trench warfare.",
                            "target_lang_translations": {
                                "ru": "Солдаты были в ужасе от возможного применения <w>иприта</w> во время окопной войны."
                            }
                        },
                        {
                            "text": "Historical documents describe the horrific effects of <w>mustard</w> on those exposed to it.",
                            "target_lang_translations": {
                                "ru": "Исторические документы описывают ужасающее воздействие <w>горчичного газа</w> на тех, кто подвергся его воздействию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Ellipsis of mustard gas"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название горчичного газа (иприта), токсичного боевого отравляющего вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иприт",
                                "target_lang_sense_clarification": "горчичный газ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e80dfb31-1bdb-3a3d-86af-6d4eef013bb2",
                    "sense_definition": "Having a dark yellow color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>mustard</w> sweater that complemented his dark hair perfectly.",
                            "target_lang_translations": {
                                "ru": "На нем был <w>горчичный</w> свитер, который идеально подчеркивал его темные волосы."
                            }
                        },
                        {
                            "text": "The room was decorated with <w>mustard</w> walls and minimalist furniture.",
                            "target_lang_translations": {
                                "ru": "Комната была оформлена со стенами <w>горчичного цвета</w> и минималистичной мебелью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mustard yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий темно-желтый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горчичный",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0a27041-41aa-3c40-b0f8-484adf3ed33d",
                    "sense_definition": "Excellent, very good, or highly skilled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new striker is absolutely <w>mustard</w> and has already scored five goals this season.",
                            "target_lang_translations": {
                                "ru": "Новый нападающий просто <w>классный</w> и уже забил пять голов в этом сезоне."
                            }
                        },
                        {
                            "text": "They finished the project in less than a week, which was <w>mustard</w>.",
                            "target_lang_translations": {
                                "ru": "Они закончили проект меньше чем за неделю, это было просто <w>круто</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходный, очень хороший или высококвалифицированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "высшего качества"
                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "очень способный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b9942205-bc8c-3124-be89-8d670291b525",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Mustard</w> has lived in this small village for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Мастард</w> живет в этой маленькой деревне уже более сорока лет."
                            }
                        },
                        {
                            "text": "The local library was named after the <w>Mustard</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Мастард</w>, которая пожертвовала землю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мастард",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}