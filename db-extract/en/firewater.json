    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                "word": "firewater",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bbd4cbb0-4699-4283-b3ce-dccde50611e8",
                        "entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "tags": [
                            "plural"
                        ],
                        "form": "firewaters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1159ad6-c27c-3391-b45b-a9da1e6ec235",
                        "entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "glosses": [
                            "High-proof alcoholic beverage, especially whiskey (especially in the context of its sale to or consumption by Native Americans)."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d9cc690b-1837-49d7-88ee-f27466e10e3a",
                                "sense_id": "b1159ad6-c27c-3391-b45b-a9da1e6ec235",
                                "text": "High Jack had been drinking too much rum ever since we landed in Boca. You know how an Indian is—the palefaces fixed his clock when they introduced him to firewater."
                            },
                            {
                                "example_id": "3e636c69-f609-44eb-aba2-0f39adea4e20",
                                "sense_id": "b1159ad6-c27c-3391-b45b-a9da1e6ec235",
                                "text": "Four polite Englishmen in their middle 20s, feigning like firewater drunks in a Eugene O'Neill play: it's exactly the stuff that makes their detractors groan."
                            }
                        ]
                    },
                    {
                        "sense_id": "931061cc-487d-330e-a569-85821f95cc5c",
                        "entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "glosses": [
                            "Water for use in firefighting."
                        ],
                        "tags": [
                            "countable",
                            "especially",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf0c0edb-b7ac-4494-b89f-4ebb67adf5b1",
                                "sense_id": "931061cc-487d-330e-a569-85821f95cc5c",
                                "text": "A continuously circulated firewater line supplies a deluge cooling system in each gathering center for fire containment."
                            },
                            {
                                "example_id": "b1c09d20-f8c8-4fbe-8d51-ce82721c29fb",
                                "sense_id": "931061cc-487d-330e-a569-85821f95cc5c",
                                "text": "A break in a firewater line at BP Whiting Refinery caused water with an oil-like sheen to spread outside the refinery's walls along a section of Indianapolis Boulevard Tuesday night."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddb8d965-1c5c-31e6-9183-ac0ccbafac2c",
                        "entry_id": "7c4465c3-727a-3674-98f6-4c59bc504efb",
                        "glosses": [
                            "High-temperature hydraulic condensate discharged from industrial boilers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
