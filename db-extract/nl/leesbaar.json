                                "example_id": "6272b123-f46e-4c57-a813-e1a2c3fb653e",
                                "sense_id": "ba0bea7d-5242-3282-a951-e0521648591b",
                                "text": "Dit handschrift is moeilijk te lezen, maar het gedrukte boek is veel leesbaarder",
                                "translation": "This handwriting is difficult to read, but the printed book is much more readable.",
                                "english": "This handwriting is difficult to read, but the printed book is much more readable."
                            },
                            {
                                "example_id": "93225772-d9d0-4fb8-bb01-9419a66f32d4",
                                "sense_id": "ba0bea7d-5242-3282-a951-e0521648591b",
                                "text": "Deze lettergrootte is te klein, kunnen we een leesbaarder lettertype gebruiken?",
                                "translation": "This font size is too small, can we use a more legible font?",
                                "english": "This font size is too small, can we use a more legible font?"
                            },
                            {
                                "example_id": "de140ab1-3ee2-4d7c-be34-d7e9bec68222",
                                "sense_id": "ba0bea7d-5242-3282-a951-e0521648591b",
                                "text": "Het rapport is goed gestructureerd en leesbaar, zelfs voor niet-experts.",
                                "translation": "The report is well-structured and readable, even for non-experts.",
                                "english": "The report is well-structured and readable, even for non-experts."
