                    {
                        "sense_id": "b23df514-431c-3a98-bd78-02812749180a",
                        "entry_id": "03852641-8c93-3616-a3a1-cf4719c40d26",
                        "glosses": [
                            "Angehörige der alteingesessenen Oberschicht im antiken Rom; altrömische Adlige"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6a3120be-77b5-47a2-b9d7-ec0a3bd1b452",
                                "sense_id": "b23df514-431c-3a98-bd78-02812749180a",
                                "text": "„Dasselbe gilt von den zahlreichen sonstigen Porträts dieser Zeit, mag es sich um ein bürgerliches römisches Ehepaar, um die Kaiserin Livia oder junge Patrizierinnen handeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "491a2428-0ca3-321e-b5f5-321384104671",
                        "entry_id": "03852641-8c93-3616-a3a1-cf4719c40d26",
                        "glosses": [
                            "Bürgerin im Mittelalter, die wohlhabend und vornehm war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d28f4a14-544e-4aaf-bd78-df05c97ebcf2",
                                "sense_id": "491a2428-0ca3-321e-b5f5-321384104671",
                                "text": "„Eine Reihe von Gräfinnen oder Edlen, noch mehr aus dem niederen Adel, dazu Patrizierinnen aus Mainz, einige auch aus anderen Städten, bildeten bis zur Reformationszeit den Konvent; […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
