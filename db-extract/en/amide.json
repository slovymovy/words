                                    {
                                        "sense_id": "a5eafdda-396a-3f93-b98b-50a1b5a30dfe",
                                        "entry_id": "f31c9b7a-83ac-330f-aebb-4d0d80aa6c0a",
                                        "glosses": [
                                            "pochodna kwasu organicznego, w której grupa hydroksylowa została zastąpiona grupą aminową"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "462952f4-fb86-4d02-adbe-75216a33c6ee",
                                                "sense_id": "a5eafdda-396a-3f93-b98b-50a1b5a30dfe",
                                                "text": "Kwasu nikotynowego i amidu tego kwasu nie należy mylić ze szkodliwą nikotyną, która znajduje się w tytoniu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
