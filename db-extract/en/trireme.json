                "senses": [
                    {
                        "sense_id": "d6caf438-147f-385a-aa15-70bffd9650b7",
                        "entry_id": "c358121d-60cd-36fb-ac07-4470995a57e2",
                        "glosses": [
                            "A galley with three banks of oars, one above the other, used mainly as a warship."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01714dca-fdf8-4d78-9b2b-f766a23f67a7",
                        "source_entry_id": "c358121d-60cd-36fb-ac07-4470995a57e2",
                        "source_sense_id": "d6caf438-147f-385a-aa15-70bffd9650b7",
                        "source_sense_description": "galley with three banks of oars",
                        "target_lang_word": "triréma",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b3613180-fd9e-4f8f-9114-00c30d61c99c",
                        "source_entry_id": "c358121d-60cd-36fb-ac07-4470995a57e2",
                        "source_sense_id": "d6caf438-147f-385a-aa15-70bffd9650b7",
                        "source_sense_description": "galley with three banks of oars",
                        "target_lang_word": "trirème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trirème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                        "entry_id": "279b24c4-dd18-3413-bf60-7157a33e74d8",
                                        "glosses": [
                                            "Galère à trois rangs de rames."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7491c0d-30b9-4b21-b795-ee0fbde50cb5",
                                                "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                                "text": "Un charpentier de Corinthe, Aminoclès, imagina d'installer trois rangs de rameurs en les étageant les uns au-dessus des autres. Cette idée, qui donna naissance aux trirèmes, ne fut pas stérile: on construisit des galères qui avaient quatre, cinq, six, sept, huit et même dix étages de rameurs. Alexandre en porta le nombre jusqu'à douze en inventant les dodécadères."
                                            },
                                            {
                                                "example_id": "96a3cefe-ea41-47f2-8369-7f47d218ad2b",
                                                "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                                "text": "Parmi elles, j’en retiendrai d’abord une, récemment mise en exergue, pour son « exemplarité » : la reconstruction expérimentale d’une trirème antique sous les auspices de Napoléon III, Empereur des Français."
                                            },
                                            {
                                                "example_id": "3c90ae1b-24cc-44e6-8a85-a8c7e9fbb812",
                                                "sense_id": "0471950c-69c2-3a20-9578-9fbd85e5e745",
                                                "text": "N’appartenant pas à l’école réaliste, seul au milieu de quelques amis, Flaubert perçoit ainsi son œuvre comme une chaloupe au milieu des textes étrangers, autant de trirèmes gigantesques, pour reprendre son image de navigateur développée dans une comparaison pleine de modestie entre Salammbô et Les Misérables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dfa4541-df6b-47e8-a044-6a1c2f48255a",
                        "source_entry_id": "c358121d-60cd-36fb-ac07-4470995a57e2",
                        "source_sense_id": "d6caf438-147f-385a-aa15-70bffd9650b7",
                        "source_sense_description": "galley with three banks of oars",
                        "target_lang_word": "Trireme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trireme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "094dde02-4de4-3024-a35c-9e4866849129",
                                        "entry_id": "5b3ce959-c483-3ae8-802a-1d733477ab4b",
                                        "glosses": [
                                            "Kriegsschiff mit jeweils drei übereinanderliegenden Ruderbänken back- und steuerbords"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a602b8-2f11-45d9-887f-432ab09c71fd",
                                                "sense_id": "094dde02-4de4-3024-a35c-9e4866849129",
                                                "text": "„Kriegsschiffe wie die Triremen wurden für den Kampfeinsatz, vor allem für das Rammen feindlicher Schiffe konstruiert.“"
                                            },
                                            {
                                                "example_id": "532caab9-0105-4b76-a1e6-69df52ab2846",
                                                "sense_id": "094dde02-4de4-3024-a35c-9e4866849129",
                                                "text": "„Eine Bireme (Zweiruderer) hatte zwei Ruderbänke, und die Trireme (Dreiruderer) dementsprechend drei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
