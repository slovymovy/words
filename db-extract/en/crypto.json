                        "examples": [
                            {
                                "example_id": "fba3f63e-47ca-4a0b-8da4-4f420f28e0c9",
                                "sense_id": "e396a60c-03ef-30bc-b5e0-a22aea5a99c2",
                                "text": "The government is looking to classify crypto as an asset class, as demanded by the crypto exchanges, rather than as a currency, two sources told Reuters."
                            },
                            {
                                "example_id": "0826a411-b70c-4115-9d81-3fd7462e755c",
                                "sense_id": "e396a60c-03ef-30bc-b5e0-a22aea5a99c2",
                                "text": "The Basel Committee on Banking Supervision published its final disclosure framework for banks’ crypto asset exposures and amendments to its crypto prudential standard on July 17. The disclosure framework includes a standardised table and templates outlining the requirements for banks to disclose qualitative and quantitative information on crypto assets."
                            }
                        ]
                    }
