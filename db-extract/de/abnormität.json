                ],
                "senses": [
                    {
                        "sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                        "entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                        "glosses": [
                            "Abweichung vom Üblichen/Normalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f81c9b2-a756-4045-b079-38e9cd80e939",
                                "sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                                "text": "„Das Böse ist für den Kriminalpsychiater Kröber keine Abnormität, sondern ein Teil des Menschseins – es ist der Preis der Entscheidungsfreiheit jedes Einzelnen im Sinne der biblischen Schöpfungsgeschichte.“"
                            },
                            {
                                "example_id": "b63b9263-051b-4a97-b9e8-690b1f2fe7fb",
                                "sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                                "text": "„Sie hatten schon so manche Abnormität gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6446d4b2-cae8-3ea7-a287-1b77486fde38",
                        "entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                        "glosses": [
                            "krankhafte Erscheinung"
                        ],
                        "tags": [
                            "meist Medizin"
                        ],
                        "examples": [
                            {
                                "example_id": "8a5b8f62-8bdb-4453-bdf4-0052ada9604f",
                                "sense_id": "6446d4b2-cae8-3ea7-a287-1b77486fde38",
                                "text": "Bei ihr wurde eine Abnormität im Gehirn festgestellt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d3fe4468-010a-313d-9fc1-a0b8feddb9b9",
                        "entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                        "glosses": [
                            "Wesen, das missgebildet ist"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "43516eba-40eb-49c8-b674-8fe32fc2e294",
                                "sense_id": "d3fe4468-010a-313d-9fc1-a0b8feddb9b9",
                                "text": "Früher wurden Abnormitäten auf Jahrmärkten als Attraktion zur Schau gestellt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c237e70-cad6-4b36-a545-c99b7d8b59ab",
                        "source_entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                        "source_sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                        "source_sense_description": "Abweichung vom Üblichen/Normalen",
                        "target_lang_word": "abnormality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "The state or quality of being abnormal; variation; irregularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c8c773d-1a68-45cd-b85e-6fcb1f2336de",
                                                "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                                "text": "Taylor said that her fame makes her \"sometimes\" miss the normality of being able to hang out with friends but that she's had to get used to \"the abnormality of my life\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "Something abnormal; an aberration; an abnormal occurrence or feature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1105f1de-6ba5-46b3-a72a-ad1184d2815a",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "I want a full genetic analysis. We're going to examine any abnormality we find no matter how insignificant it seems."
                                            },
                                            {
                                                "example_id": "7284ac2f-3efa-4a79-bc17-2dbf7c46a283",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "The factors that filter out who “gets through” from conception to birth include chromosomal or genetic abnormalities of the fetus or the mother’s stress response to changes in her environment, Catalano said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6cd988b-0e1c-446d-90de-b2b02b74f4ad",
                        "source_entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                        "source_sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                        "source_sense_description": "Abweichung vom Üblichen/Normalen",
                        "target_lang_word": "anormalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anormalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0940f73-3d01-3151-b8e2-fc625c21192e",
                                        "entry_id": "7aa2760d-82e6-3e4a-a7b3-fee726845f8d",
                                        "glosses": [
                                            "État ou nature de ce qui est anormal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3cd30d0-326d-4908-855f-f5c6197adbc8",
                                                "sense_id": "e0940f73-3d01-3151-b8e2-fc625c21192e",
                                                "text": "Chez les nations de langue anglaise Hitler et Goering ont été aisément reconnus comme des cas pathologiques étalant leur anormalité dans chacun de leurs actes, dans tous les gestes de leur vie."
                                            },
                                            {
                                                "example_id": "4be37061-67de-4742-b1cb-65934943b0c8",
                                                "sense_id": "e0940f73-3d01-3151-b8e2-fc625c21192e",
                                                "text": "La reconnaissance de l’anormalité est liée à des circonstances de temps, de lieu et de personne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
