{
    "word_family": [
        "prime",
        "primacy",
        "primal",
        "primary"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f327900-b109-3a9b-9842-48a6abf38876",
                    "sense_definition": "Relating to the earliest ages of the world or history.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ancient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers discovered <w>primeval</w> forests that had remained untouched for thousands of years.",
                            "target_lang_translations": {
                                "tr": "Kaşifler, binlerce yıldır el değmemiş <w>ilk çağlara ait</w> ormanlar keşfettiler."
                            }
                        },
                        {
                            "text": "Deep in the cave, they found paintings that offered a glimpse into <w>primeval</w> human life.",
                            "target_lang_translations": {
                                "tr": "Mağaranın derinliklerinde, <w>ilk çağ</w> insan yaşamına dair ipuçları sunan resimler buldular."
                            }
                        }
                    ],
                    "synonyms": [
                        "ancient",
                        "primordial",
                        "prehistoric"
                    ],
                    "antonyms": [
                        "modern",
                        "recent"
                    ],
                    "common_phrases": [
                        "primeval forest"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dünyanın veya tarihin en eski dönemleriyle ilgili."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ilk çağlara ait",
                                "target_lang_sense_clarification": "Tarih öncesi dönemleri ifade ederken kullanılır."
                            },
                            {
                                "target_lang_word": "kadim",
                                "target_lang_sense_clarification": "Çok eski ve köklü olan anlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c3ca377-0542-312a-9bc9-429369402005",
                    "sense_definition": "Very simple, basic, or undeveloped.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "simple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village relied on <w>primeval</w> methods of farming that had not changed in centuries.",
                            "target_lang_translations": {
                                "tr": "Köy, yüzyıllardır değişmemiş <w>ilkel</w> tarım yöntemlerine güveniyordu."
                            }
                        },
                        {
                            "text": "Despite the modern city nearby, the plumbing in the old house was quite <w>primeval</w>.",
                            "target_lang_translations": {
                                "tr": "Yakındaki modern şehre rağmen, eski evdeki tesisat oldukça <w>ilkeldi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "primitive",
                        "rudimentary"
                    ],
                    "antonyms": [
                        "advanced",
                        "sophisticated"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok basit, temel düzeyde veya gelişmemiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ilkel",
                                "target_lang_sense_clarification": "Gelişmemiş veya basit yöntemler için kullanılır."
                            },
                            {
                                "target_lang_word": "basit",
                                "target_lang_sense_clarification": "Karmaşık olmayan, temel düzeyde."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1167e43e-b99f-38af-92bf-66a90f1bbcb4",
                    "sense_definition": "Existing from the very beginning; original.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ancient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that there is a <w>primeval</w> force driving all living things.",
                            "target_lang_translations": {
                                "tr": "Filozof, tüm canlıları harekete geçiren <w>ilk</w> bir gücün olduğunu savundu."
                            }
                        },
                        {
                            "text": "Many cultures share a <w>primeval</w> myth about the creation of the universe.",
                            "target_lang_translations": {
                                "tr": "Birçok kültür, evrenin yaratılışı hakkında <w>ilk</w> bir miti paylaşır."
                            }
                        }
                    ],
                    "synonyms": [
                        "original",
                        "primal"
                    ],
                    "target_lang_definitions": {
                        "tr": "En başından beri var olan; özgün veya ilk."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ilk",
                                "target_lang_sense_clarification": "Başlangıçta var olan anlamında."
                            },
                            {
                                "target_lang_word": "özgün",
                                "target_lang_sense_clarification": "Temel ve orijinal olan."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}