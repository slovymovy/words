                    {
                        "sense_id": "1ceb0a7c-790a-3e22-ae33-bd5f65cec1ec",
                        "entry_id": "3b7fcb4b-8334-3dce-9b28-2a8bdd9576a4",
                        "glosses": [
                            "Still to be paid; owed as a debt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c06dfa33-44b0-4d75-8a13-9526206a500f",
                                "sense_id": "1ceb0a7c-790a-3e22-ae33-bd5f65cec1ec",
                                "text": "These seven subscriptions remain owing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7809473a-3697-4970-aba1-e67b837549cd",
                        "source_entry_id": "3b7fcb4b-8334-3dce-9b28-2a8bdd9576a4",
                        "source_sense_id": "1ceb0a7c-790a-3e22-ae33-bd5f65cec1ec",
                        "source_sense_description": "still to be paid",
                        "target_lang_word": "обязанный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обязанный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17f9fff2-f16a-3f64-83af-537c558eb12b",
                                        "entry_id": "a87e4b23-1099-3855-a7ea-6d703e6e4a0e",
                                        "glosses": [
                                            "имеющий что-либо своей обязанностью, долгом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5ab532-0856-480e-8b6b-60acab10ce94",
                                                "sense_id": "17f9fff2-f16a-3f64-83af-537c558eb12b",
                                                "text": "Муромский не мог отказаться, ибо чувствовал себя обязанным, и таким образом Берестов возвратился домой со славою, затравив зайца и ведя своего противника раненым и почти военнопленным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c93d571-7131-38cb-9496-a9dbf3daddbc",
                                        "entry_id": "a87e4b23-1099-3855-a7ea-6d703e6e4a0e",
                                        "glosses": [
                                            "получивший что-либо, достигший чего-либо и т. п. благодаря кому-либо, чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ee9454-c155-40d1-a0ee-adc4462eadbe",
                                                "sense_id": "5c93d571-7131-38cb-9496-a9dbf3daddbc",
                                                "text": "И это говорил человек, всем обязанный своему доброму отчиму и неумевший заработать копейки?"
                                            },
                                            {
                                                "example_id": "c5f6eeb5-2a2e-4df5-b13b-f597cf1ca44a",
                                                "sense_id": "5c93d571-7131-38cb-9496-a9dbf3daddbc",
                                                "text": "Для меня нет ничего тягостнее, ужаснее, как быть обязанным кому-либо: вы делаете из сего исключение, и для меня ничего нет приятнее, как изъявлять вам мою благодарность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091bdeb7-74f5-3b21-be28-1aa8c2b08596",
                                        "entry_id": "a87e4b23-1099-3855-a7ea-6d703e6e4a0e",
                                        "glosses": [
                                            "благодарный, признательный кому-либо за что-либо"
                                        ],
                                        "tags": [
                                            "только краткие формы"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "обязанный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "19d46818-eee8-3c29-a9b9-d421edc66eef",
                                        "entry_id": "ba45541f-a68f-33a5-84ce-4ee9d58f1ba2",
                                        "glosses": [
                                            "страд. прич. прош. вр. от обязать"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75bc1964-190c-44c9-b7e2-43247d9088ba",
                                                "sense_id": "19d46818-eee8-3c29-a9b9-d421edc66eef",
                                                "text": "Его обижали все, кому было не лень, потому что он был сирота и родился до брака, ребёнок любви, обязанный ответить судьбе за грех его родителей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
