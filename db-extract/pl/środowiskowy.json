                                        "entry_id": "40cc1797-7b42-33d9-9b8c-dd89061a1b86",
                                        "glosses": [
                                            "Pertaining to the environment."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f851a89-3add-487b-affb-0257307794d2",
                                                "sense_id": "ce84c5f4-c8e5-36c4-a855-b81b96a6a9a1",
                                                "text": "That worries the government, which fears that environmental activism could become the foundation for more general political opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dc0c7b-b28f-3587-8b8c-027d85682d8f",
                                        "entry_id": "40cc1797-7b42-33d9-9b8c-dd89061a1b86",
                                        "glosses": [
                                            "Environmentally friendly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09bad37-1ecc-45c0-a666-17f259b405f7",
                                                "sense_id": "e1dc0c7b-b28f-3587-8b8c-027d85682d8f",
                                                "text": "Because consumers who are buying such productss cannot fully internalize the external utility of their purchase, prices for environmental products and other environmental innovations may be insufficiently high to cover their costs ( Kaas, 1993; Cleff and Rennings, 1999)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "environmental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d2adde-bad5-3f97-8f5a-3cf106e4a0b4",
                                        "entry_id": "2cae6995-32bf-39ea-b53a-668619d99760",
                                        "glosses": [
                                            "Any factor relating to the physical environment in which hardware is operated, such as the room temperature or the number of racks used to hold equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0309ce8a-1f5f-479e-80f5-31cb277633ba",
                                                "sense_id": "c0d2adde-bad5-3f97-8f5a-3cf106e4a0b4",
                                                "text": "The process to enable migration from the vendor-supplied configuration to a new architecture depends on many system environmentals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c845b1b-ceaa-4c68-8c01-c428b56ea489",
