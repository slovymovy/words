        "fr-extract.jsonl": [
            {
                "entry_id": "a8ff641e-102c-3cdf-b55e-730ee3fe7160",
                "word": "philatéliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "897082c3-a59e-45e7-a451-5eddbd205429",
                        "entry_id": "a8ff641e-102c-3cdf-b55e-730ee3fe7160",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "philatélistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfb192e0-4899-340a-860b-2684e8685909",
                        "entry_id": "a8ff641e-102c-3cdf-b55e-730ee3fe7160",
                        "glosses": [
                            "Personne qui collectionne les timbres, les affranchissements postaux ou fiscaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b9ff71-6f4b-4734-bd56-8ea0bf00f177",
                                "sense_id": "cfb192e0-4899-340a-860b-2684e8685909",
                                "text": "Le philatéliste en herbe y perd le plaisir de demander autour de soi des timbres tout juste arrivés d’autres parties du monde."
                            },
                            {
                                "example_id": "e98e45c8-cbc9-4ff5-95de-59074824c0c4",
                                "sense_id": "cfb192e0-4899-340a-860b-2684e8685909",
                                "text": "Nous ne ferons pas l’injure de penser qu’un seul de tous les philatélistes de par le monde ignore qu’en 1840 le premier timbre de l’histoire de la poste fut émis en Grande-Bretagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8118b4eb-6044-4bdc-941b-619a7bc5b8fb",
                        "source_entry_id": "a8ff641e-102c-3cdf-b55e-730ee3fe7160",
                        "source_sense_id": "cfb192e0-4899-340a-860b-2684e8685909",
                        "target_lang_word": "Philatelist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philatelist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                        "entry_id": "a9c4c47a-1951-3437-acbc-0017f5fa14fb",
                                        "glosses": [
                                            "Person, die sich beruflich oder als Hobby mit Briefmarken befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8f52dd-6354-4128-89c0-7c3b6c15560b",
                                                "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                                "text": "Viele Philatelisten treffen sich regelmäßig an bestimmten Tauschtagen."
                                            },
                                            {
                                                "example_id": "7dbd7e7c-8685-4d5a-9450-d0f1d0e8db4b",
                                                "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                                "text": "„Als Philatelist ist dieser nicht bekannt.“"
                                            },
                                            {
                                                "example_id": "ce97dd55-c247-4862-b5af-489f21e4ac87",
                                                "sense_id": "2af9c395-25a1-366d-8922-c8aa6ecbf94c",
                                                "text": "„Der renommierte Philatelist und Autor unzähliger Werke über die Philatelie, Fred Melville, hat einmal errechnet, dass Philipp von Ferrari bis zum Beginn des Ersten Weltkrieges pro Jahr durchschnittlich 10 000 Pfund für seine Briefmarkensammlung ausgegeben habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0a30c5c-9720-4c59-93ef-e285b4f131fc",
