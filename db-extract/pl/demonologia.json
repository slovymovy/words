                        "target_lang_word": "демонология",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "демонология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                                        "entry_id": "d79b987b-291c-3cc3-9eaf-38fc0b000c98",
                                        "glosses": [
                                            "учение о демонах в некоторых религиях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0798d77-4ccb-4f17-8fb9-77c87912ddc8",
                                                "sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                                                "text": "Настолько не забыл, что даже в средневековую демонологию Азазел перешёл, изображаемый эмблематически голым дикарём, который тащит за рога, доставшегося ему, жертвенного козла."
                                            },
                                            {
                                                "example_id": "b159f2b8-57c7-42ef-a554-ec4a55206ad4",
                                                "sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                                                "text": "Но демонология — суть Искусство обращать силу демона против него самого."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
