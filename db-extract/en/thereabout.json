                    },
                    {
                        "translation_id": "bb2bea10-c0ff-495a-8f4c-e190e147168f",
                        "source_entry_id": "f768f02e-bfdf-35b6-a341-2491e438f1ca",
                        "source_sense_description": "about or near that place",
                        "target_lang_word": "dortherum",
