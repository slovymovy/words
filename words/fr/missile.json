            "senses": [
                {
                    "sense_id": "35eb0bdb-88ec-3c9c-9a8b-63f39723adb8",
                    "sense_definition": "Projectile autopropulsé et guidé à distance, transportant une charge explosive vers une cible.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée a détecté le tir d'un <w>missile</w> balistique au-dessus de la mer."
                        },
                        {
                            "text": "Les systèmes de défense ont intercepté plusieurs <w>missiles</w> ennemis pendant la nuit."
                        }
                    ],
                    "common_phrases": [
                        "missile balistique",
                        "tir de missile"
                    ]
                },
                {
                    "sense_id": "75288e1b-92de-3a0e-b3d5-58ebfecb0660",
                    "sense_definition": "Tout objet quelconque lancé ou projeté dans le but d'atteindre et de frapper une cible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants ont jeté divers <w>missiles</w> improvisés en direction des forces de l'ordre."
                        },
                        {
                            "text": "La catapulte antique projetait de lourds <w>missiles</w> de pierre contre les remparts de la ville."
                        }
                    ]
                },
                {
