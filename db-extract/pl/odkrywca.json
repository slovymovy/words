                "translations": [
                    {
                        "translation_id": "3f9407c7-6f54-422a-9161-1b84f6e8afb1",
                        "source_entry_id": "2ef9ba43-8a36-3abe-ab70-4b2cb44e016b",
                        "source_sense_id": "42c5c778-2334-3711-b0ec-e1ce4fa8cb7b",
                        "target_lang_word": "discoverer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discoverer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                        "entry_id": "da5d1566-bdd9-3e77-b39f-c5e40457e52e",
                                        "glosses": [
                                            "One who discovers: a person who has discovered something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b978042-14b5-4a5d-b0f2-092db21348b1",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "[W]hen the flowꝛes there haue been ſufficiently wꝛought, they [bees] ſend abꝛoade their diſcouerers to finde out moꝛe foode."
                                            },
                                            {
                                                "example_id": "5933d33f-b98a-42a2-bbe7-9e847ad56f87",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "The ſpecies of elaſtic fluid, which its great diſcoverer, Dr. Prieſtley, denominated the dephlogiſticated nitrous air, and others have ſince called gazeous oxyd of azot, is in general not unknown to chemiſts, though they are unacquainted with its compoſition, its moſt extraordinary effects, and probably with its perfect preparation."
                                            },
                                            {
                                                "example_id": "5fc94570-db2e-43c6-a7eb-7e278689f523",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "[M]any of the most successful discoverers of metallic wealth have been entirely ignorant of the methods by which a great mine should be opened, developed, and worked."
                                            },
                                            {
                                                "example_id": "b7973313-c383-4742-992a-421ea9012fd2",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "But this was subterfuge to defeat the curiosity of a chance discoverer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbfeb86c-e18c-4993-8e13-7de4b11d3e00",
                        "source_entry_id": "2ef9ba43-8a36-3abe-ab70-4b2cb44e016b",
                        "source_sense_id": "42c5c778-2334-3711-b0ec-e1ce4fa8cb7b",
                        "target_lang_word": "Entdecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entdecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf30c98-a936-3c98-9e60-7accfd8a0c41",
                                        "entry_id": "5366355b-35f3-3b79-999f-fcbdeffae13d",
                                        "glosses": [
                                            "jemand, der auf der Suche nach etwas Unbekanntem ist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a1defb4-0333-3c6b-afd5-55daa55162c0",
                                        "entry_id": "5366355b-35f3-3b79-999f-fcbdeffae13d",
                                        "glosses": [
                                            "jemand, der etwas bis dahin Unbekanntes gefunden hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b1eb8f-c234-401d-ab98-be1f385af437",
                                                "sense_id": "2a1defb4-0333-3c6b-afd5-55daa55162c0",
                                                "text": "Kolumbus wird häufig als Entdecker von Amerika bezeichnet."
                                            },
                                            {
                                                "example_id": "6d408863-e400-4be0-bd22-6de95350bb27",
                                                "sense_id": "2a1defb4-0333-3c6b-afd5-55daa55162c0",
                                                "text": "„Europäische Entdecker werden um 1670 die Zahl der Soldaten in Benin auf bis zu 100000 schätzen.“"
                                            },
                                            {
                                                "example_id": "6a2460ff-028b-4341-af32-b09cb584cff8",
                                                "sense_id": "2a1defb4-0333-3c6b-afd5-55daa55162c0",
                                                "text": "„Im Verlauf seiner langen Reise beschreibt der Deutsche so genau wie kaum ein Entdecker vor ihm weite Teile des Inneren Nordwestafrikas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
