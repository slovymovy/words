                    {
                        "sense_id": "b1a972d2-4534-39bd-ae09-dd3d64a32293",
                        "entry_id": "64875ef4-84ed-396a-bd1d-a159c5746050",
                        "glosses": [
                            "Prinz oder auch Prinzessin in Fasching/Fastnacht/Karneval"
