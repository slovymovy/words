                "senses": [
                    {
                        "sense_id": "7c3fa66c-51be-3340-bfac-6723598badba",
                        "entry_id": "b1c1107e-1658-3baa-8cbd-ec25e9b4f330",
                        "glosses": [
                            "einfach gestalteter Kapellenbau oder abgeteilter Bereich in einem Spital, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7765d1e5-ae97-454e-9a49-307794b6ae55",
                                "sense_id": "7c3fa66c-51be-3340-bfac-6723598badba",
                                "text": "„Die Spitalkapelle ist ein rechteckiger gotischer Anbau des Spitalgebäudes mit einem Dachreiter.“"
                            },
                            {
                                "example_id": "22dfe1d3-e731-4b44-b2a9-81f78892d9e9",
                                "sense_id": "7c3fa66c-51be-3340-bfac-6723598badba",
                                "text": "„Die wohl interessanteste Weiterverwendung eines klösterlichen Gebäudes stellt die ehemalige Spitalkapelle dar.“"
                            },
                            {
                                "example_id": "59e52cbc-78eb-4883-89e6-4f961443de47",
                                "sense_id": "7c3fa66c-51be-3340-bfac-6723598badba",
                                "text": "„Die Spitalkapelle wird erstmals im Jahr 1355 erwähnt.“"
                            },
                            {
                                "example_id": "2fe04dab-1857-4078-9afe-8aebe9660fa7",
                                "sense_id": "7c3fa66c-51be-3340-bfac-6723598badba",
                                "text": "„Durch die Wiedereröffnung der ehemaligen Spitalkapelle im Frühjahr 2006 erfuhr das Museum eine wichtige Bereicherung.“"
                            },
                            {
                                "example_id": "04ef7f17-77d8-4f90-9431-bd5ac8195058",
                                "sense_id": "7c3fa66c-51be-3340-bfac-6723598badba",
                                "text": "„Würde die Spitalkapelle nicht so versteckt im Heilsbronner Zentrum liegen, wäre sie sicher eines der meist fotografierten Gebäude der Stadt.“"
                            }
                        ],
