                        "entry_id": "683328db-d1bb-30a6-91f6-5f858bff3940",
                        "glosses": [
                            "Dispositif servant à mesurer la dentelure des timbres (nombre de dents sur une longueur donnée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f32fcf3b-3c06-492c-9630-40d9e8d87b79",
                                "sense_id": "6eb82141-1ab5-33d0-97fd-6a444e8fba5e",
                                "text": "Les émotions surgissent des choses les plus petites et les plus communes le nom d’une fleur un papillon le sourire d’une postière le nombre de dents d’un timbre mesuré à l’odontomètre."
                            }
                        ]
                    }
                ],
