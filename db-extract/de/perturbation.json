                                        "entry_id": "e106803e-956b-3d17-be80-136ff270ba70",
                                        "glosses": [
                                            "то, что мешает кому-либо, чему-либо; затруднение, препятствие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
