                ],
                "translations": [
                    {
                        "translation_id": "eccc9c47-0c77-4482-9bb7-ca5f926643ab",
                        "source_entry_id": "96dafd84-c1ec-355e-a4e1-718282d0d532",
                        "source_sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                        "source_sense_description": "Gerät, das Papier/Dokumente a) scannt und versendet und b) empfängt und ausdruckt",
                        "target_lang_word": "fax machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fax machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "739e70ed-be7f-3eb8-94dd-37d2a3b3c113",
                                        "entry_id": "48e03c95-a2d2-3769-9386-ed0df0a7b3a5",
                                        "glosses": [
                                            "A device which scans, transmits, receives and prints documents (faxes) transmitted by telephone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a231b506-ab8e-4a42-8fc2-ed69ee4bb69b",
                                                "sense_id": "739e70ed-be7f-3eb8-94dd-37d2a3b3c113",
                                                "text": "Rachel inserted the entire stack into the hydrolab's fax machine. Knowing only a few fax numbers by heart, she had limited choices, but she had already made up her mind who would be receiving these pages and her note. Holding her breath, she carefully typed in the person’s fax number."
                                            },
                                            {
                                                "example_id": "81f0bbdb-81dc-4163-8b70-b007e3b0a8e5",
                                                "sense_id": "739e70ed-be7f-3eb8-94dd-37d2a3b3c113",
                                                "text": "I made my notes, by hand, collated all relevant requests, stood in the copy room by a noisy fax machine and slowly fed the documents into it, thinking of someone in New York – a dream city to me – waiting by a similar contraption as my document came through to them, at the exact same time I sent it, which felt so very modern in the doing of it, a triumph over distance and time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f70350a-1687-4992-872d-3fee7097cdbf",
                        "source_entry_id": "96dafd84-c1ec-355e-a4e1-718282d0d532",
                        "source_sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                        "source_sense_description": "Gerät, das Papier/Dokumente a) scannt und versendet und b) empfängt und ausdruckt",
                        "target_lang_word": "télécopieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "télécopieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                                        "entry_id": "59a8df98-b1d5-350e-9538-f5a7825a7b09",
                                        "glosses": [
                                            "Appareil émetteur et récepteur de télécopie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5390c433-129a-4ae8-9353-9b31d95c65ee",
                                                "sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                                                "text": "Je suis assis à ma table en pin à lorgner … vers le télécopieur qui s'est mis depuis quelques secondes à me tirer la langue en format A4."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bacfd42a-fff4-408c-b378-f432dd5277b9",
                        "source_entry_id": "96dafd84-c1ec-355e-a4e1-718282d0d532",
                        "source_sense_id": "47aa9457-eccc-30d1-b6b2-8ce157f4b2e0",
                        "source_sense_description": "Gerät, das Papier/Dokumente a) scannt und versendet und b) empfängt und ausdruckt",
                        "target_lang_word": "fax",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fax",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebbdc998-bf12-3e96-abe4-e5c92b145376",
                                        "entry_id": "24902a9b-e597-3c7a-8cae-367d3ee4f337",
                                        "glosses": [
                                            "Document numérisé, transmis par liaison téléphonique, puis imprimé par le matériel de réception."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed089e9-f19a-465b-b326-5fa9c5d7ea49",
                                                "sense_id": "ebbdc998-bf12-3e96-abe4-e5c92b145376",
                                                "text": "Avouez que c’est fabuleux ! On approche à grands pas du troisième millénaire en se taillant un chemin de crête sur la route du progrès. On lance des TGV, des fax et des fusées. On creuse un tunnel sous la Manche, on se balade sur la Lune, on embarque pour Mars, mais il y a pas moyen de prendre un train à la gare Saint-Lazare."
                                            },
                                            {
                                                "example_id": "cc151bfc-56f6-4bd1-a6d2-99d4786a17dc",
                                                "sense_id": "ebbdc998-bf12-3e96-abe4-e5c92b145376",
                                                "text": "Oublient-ils leurs impressions dans l’imprimante et leurs fax dans la télécopieuse ? Leurs mots de passe ressemblent-ils à « lucie » ou « vincent73 » ?"
                                            },
                                            {
                                                "example_id": "5f1e7ebc-8203-4dc2-aa8c-8efa36ae26ab",
                                                "sense_id": "ebbdc998-bf12-3e96-abe4-e5c92b145376",
                                                "text": "En outre, les effectifs ont été renforcés ; la gestion informatique est en cours de révision ; des kits de prélèvements buccaux ont été achetés en masse ; enfin, l'envoi des dossiers à Ecully ou aux autorités requérantes devrait se faire bientôt par télématique, et non plus par fax ou courrier."
                                            },
                                            {
                                                "example_id": "9f2f03ac-8308-456b-bbca-eb27b3881089",
                                                "sense_id": "ebbdc998-bf12-3e96-abe4-e5c92b145376",
                                                "text": "Expédié en cours de journée, un fax aura plus de chance d'atteindre son destinataire et donc d'être lu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554abec0-abad-3450-bf15-35f35529508d",
                                        "entry_id": "24902a9b-e597-3c7a-8cae-367d3ee4f337",
                                        "glosses": [
                                            "L’appareil permettant la numérisation, la transmission, la réception, et l’impression du facsimilé."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9583c38f-3c05-4f5b-89ea-2c1e5e5c0250",
                                                "sense_id": "554abec0-abad-3450-bf15-35f35529508d",
                                                "text": "Notons que l’on peut brancher sur le réseau un modem ou un fax (carte fax) qui fonctionnera exactement comme s'il était sur l'ordinateur local."
                                            },
                                            {
                                                "example_id": "9b30d3bf-6cf8-480e-aed3-4e99ab3b5e11",
                                                "sense_id": "554abec0-abad-3450-bf15-35f35529508d",
                                                "text": "Aujourd’hui, une TPE (pharmacies, notaires, cabinet de médecins...) dispose d’un petit autocom local (Diatonis de France Telecom par exemple) avec un ou deux abonnements TO (2 ou 4 lignes simultanées), d’un fax sur ligne analogique séparé et d’un accès ADSL."
                                            },
                                            {
                                                "example_id": "cc28f63d-d291-4a57-a1be-e2040bf36670",
                                                "sense_id": "554abec0-abad-3450-bf15-35f35529508d",
                                                "text": "Le fax est aussi un outil indispensable en termes de sécurité, ajoute un haut fonctionnaire japonais. Quelle que soit l’heure, quand vous envoyez un message par fax, il est imprimé sur papier automatiquement dès sa réception. Même s’il y a une catastrophe comme un tremblement de terre et que l’électricité ou les communications sont coupées, vous êtes certain que le destinataire possède une copie physique du message. Pour nous, c’est important."
                                            },
                                            {
                                                "example_id": "b6e8b87e-b584-4f73-b1df-f4367d2ec164",
                                                "sense_id": "554abec0-abad-3450-bf15-35f35529508d",
                                                "text": "Lorsque nous numérotons un numéro sur un fax, il appelle classiquement le fax distant et le canal bearer devient actif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
