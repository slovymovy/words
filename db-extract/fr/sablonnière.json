                        "sense_id": "b787fa5b-6f75-32b1-9daf-f9e551e232fa",
                        "entry_id": "ebf181e2-acb4-33fe-8ca1-44208e93b23e",
                        "glosses": [
                            "Lieu d’où l’on tire du sablon, du sable fin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52193bba-3728-46f1-b52b-27daff1f5e2b",
                                "sense_id": "b787fa5b-6f75-32b1-9daf-f9e551e232fa",
                                "text": "Une sablonnière à ciel ouvert."
                            },
                            {
                                "example_id": "8da890bd-7f6f-491f-8f41-5e41fb161d40",
                                "sense_id": "b787fa5b-6f75-32b1-9daf-f9e551e232fa",
                                "text": "Le terrain gras et noir se prêtait au développement des herbes dont il semblait le complice ; le mercier découvrit non loin de là une sablonnière, et le jour suivant il marcha vers Grateloup, traînant après lui une brouette et une bêche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0a96feb-3e2e-47b8-b240-4ca5e427f058",
                        "source_entry_id": "ebf181e2-acb4-33fe-8ca1-44208e93b23e",
                        "source_sense_id": "b787fa5b-6f75-32b1-9daf-f9e551e232fa",
