                "senses": [
                    {
                        "sense_id": "b94810ed-1c64-3fb6-b24a-e2429af1dbc2",
                        "entry_id": "bf0cc2fa-3fa3-319e-9425-bc68bf0e6e73",
                        "glosses": [
                            "Se livrer à la réflexion, réfléchir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb669af-fa2f-4f1a-8266-700775aab228",
                                "sense_id": "b94810ed-1c64-3fb6-b24a-e2429af1dbc2",
                                "text": "Madame Lasserre fit quelques emplettes et tout en réflexionnant, comme disent si bien les Vaudois, nous redescendîmes sur le quai."
                            },
                            {
                                "example_id": "9a03c201-b0f0-4337-855f-643fe2c4b560",
                                "sense_id": "b94810ed-1c64-3fb6-b24a-e2429af1dbc2",
                                "text": "Quand vient le temps de “réflexionner” profondément…"
                            },
                            {
                                "example_id": "3b8a41e2-fd38-40ed-a51c-04550eeb96c2",
                                "sense_id": "b94810ed-1c64-3fb6-b24a-e2429af1dbc2",
                                "text": "Faut pas me demander de réflexionner pour le moment, je crois que ça devient dur pour aujourd'hui !"
                            },
                            {
                                "example_id": "d29c70d0-e580-4482-b231-05cd7699d77b",
                                "sense_id": "b94810ed-1c64-3fb6-b24a-e2429af1dbc2",
                                "text": "Il faut agir et non réflexionner."
                            }
                        ]
                    }
