                        "glosses": [
                            "Qui ressemble à du chanvre, à de la filasse de chanvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6376cb-d3cd-4ff5-a64f-58793bbe10d3",
                                "sense_id": "151ed788-5df9-345f-a71c-c1a611447929",
                                "text": "sans prendre en aucune façon l'aspect ordinaire des cheveux de n'importe quelle race . Cependant ils se rapprochent assez , par leur texture chanvrée, de certains cheveux blonds filasse de nos paysans du Maine ou de la Bretagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8e33c08-3007-3ea3-95d5-877b8739f2e0",
                        "entry_id": "30e3affc-d3ab-3009-88e2-45a8fda17d43",
                        "glosses": [
                            "Qui contient du chanvre, qui est fait avec du chanvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fc51f3-0f42-450e-b229-338655ad8e44",
                                "sense_id": "f8e33c08-3007-3ea3-95d5-877b8739f2e0",
                                "text": "Il le porte un instant... puis le range à la diable, à sa place usuelle, contre le piquet de son logis de tressages chanvrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a54d2f1-1d4a-3a13-87dc-57dbaa1863a5",
