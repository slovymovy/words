                    },
                    {
                        "translation_id": "ff9d45cd-ddfa-4d1a-a9aa-8a86d6779125",
                        "source_entry_id": "4998954f-6423-3fba-bffa-39c49c17f4d3",
                        "source_sense_id": "12460ea6-970c-385e-a99a-b2725084ecc6",
