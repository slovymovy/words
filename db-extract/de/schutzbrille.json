                ],
                "senses": [
                    {
                        "sense_id": "8a7443b3-208d-3159-8886-31638725b0bf",
                        "entry_id": "33eb00a7-06ca-361d-b7a9-dfdc367cb3c3",
                        "glosses": [
                            "Brille, die vor Schäden am Auge bewahren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b692ef-fc3f-4e23-93ff-a2d2d445d57b",
                                "sense_id": "8a7443b3-208d-3159-8886-31638725b0bf",
                                "text": "„Sie setzten ihre Schutzbrillen auf und zwängten sich in die schusssicheren Westen.“"
                            },
                            {
                                "example_id": "58e119db-a5af-47e9-aa46-56d70e333a09",
                                "sense_id": "8a7443b3-208d-3159-8886-31638725b0bf",
                                "text": "„Ein Rapper hat sich die totale Sonnenfinsternis in den USA absichtlich ohne spezielle Schutzbrille angesehen und musste jetzt drei Konzerte absagen […].“"
                            },
                            {
                                "example_id": "7a849d4b-7aa2-4f97-9955-8f8a81ddfe88",
                                "sense_id": "8a7443b3-208d-3159-8886-31638725b0bf",
                                "text": "„Pettenkofer band sein Handtuch um den Hals, setzte seine Schutzbrille auf und drückte die Mütze fester auf den Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "439ddb8d-4dcc-4d4d-8d4c-e2dbb3fa4a5c",
