                    "sense_definition": "Gebiedende wijs van <w>kenmerken</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kenmerk</w> alle dozen duidelijk voordat ze naar de opslag gaan.",
                            "target_lang_translations": {
                                "ru": "Четко <w>промаркируйте</w> все коробки перед отправкой на склад.",
                                "en": "<w>Label</w> all boxes clearly before they go to storage.",
                                "pl": "Wyraźnie <w>oznacz</w> wszystkie kartony, zanim trafią do magazynu."
                            }
                        },
                        {
                            "text": "<w>Kenmerk</w> deze e-mail als urgent zodat hij direct wordt gelezen.",
                            "target_lang_translations": {
                                "ru": "<w>Пометьте</w> это письмо как срочное, чтобы его сразу прочитали.",
                                "en": "<w>Mark</w> this email as urgent so it is read immediately.",
                                "pl": "<w>Oznacz</w> ten e-mail jako pilny, aby został natychmiast przeczytany."
