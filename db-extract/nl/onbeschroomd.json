                                        "sense_id": "eb378d32-fb0d-3428-9767-4f88b433bd0e",
                                        "entry_id": "932d6f1c-9a1f-3185-8cc9-55bb2309c075",
                                        "glosses": [
                                            "Courageous, daring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87dd2987-0646-4e24-8d34-37f65c9d3889",
                                                "sense_id": "eb378d32-fb0d-3428-9767-4f88b433bd0e",
                                                "text": "Bold deeds win admiration and, sometimes, medals."
                                            },
                                            {
                                                "example_id": "029a1ca1-38ea-4536-bde4-d914476a9cf2",
                                                "sense_id": "eb378d32-fb0d-3428-9767-4f88b433bd0e",
                                                "text": "Not unnaturally, “Auntie” took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head."
                                            },
                                            {
                                                "example_id": "b8e14d43-5735-42af-a0fb-089c469807aa",
                                                "sense_id": "eb378d32-fb0d-3428-9767-4f88b433bd0e",
                                                "text": "It would be extraordinarily bold of me to give it a try after seeing what has happened to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d348f09d-60dd-34cf-9fe7-7a60182d642e",
                                        "entry_id": "932d6f1c-9a1f-3185-8cc9-55bb2309c075",
                                        "glosses": [
                                            "Visually striking; conspicuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7203d7-030b-4b80-8dde-614287ac4823",
                                                "sense_id": "d348f09d-60dd-34cf-9fe7-7a60182d642e",
                                                "text": "the painter's bold use of colour and outline"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff7e4499-03f3-38b3-8fb7-bb26c5df1b85",
                                        "entry_id": "932d6f1c-9a1f-3185-8cc9-55bb2309c075",
                                        "glosses": [
                                            "Having thicker strokes than the ordinary form of the typeface."
                                        ],
                                        "tags": [
                                            "of typefaces"
                                        ],
                                        "examples": [
                                            {
