                        "source_sense_id": "f6c9f04d-a06b-39ae-838d-14a1481adfb8",
                        "source_sense_description": "zo fanatiek, eenzijdig op één zaak gericht raken dat het gek of vreemd is",
                        "target_lang_word": "infatuation",
