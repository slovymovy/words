                                        "glosses": [
                                            "Se dit d’un animal (vertébré tétrapode) dont l’embryon et le fœtus sont protégés par un amnios et une allantoïde."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6245d664-140c-47b3-91d5-c247af557193",
                                                "sense_id": "d2671ebd-fb61-367a-b34c-56a858a03116",
                                                "text": "Les reptiles, les oiseaux et les mammifères sont des vertébrés amniotes."
                                            }
                                        ]
                                    }
                                ]
                            },
