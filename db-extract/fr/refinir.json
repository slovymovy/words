                "senses": [
                    {
                        "sense_id": "e4bbdeb4-f9d3-36e1-851c-83f078a4191f",
                        "entry_id": "1bab72db-7d42-3566-9c60-72685e0cbe78",
                        "glosses": [
                            "Finir à nouveau."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0599247c-1407-47d4-a5f5-8b67824730df",
                                "sense_id": "e4bbdeb4-f9d3-36e1-851c-83f078a4191f",
                                "text": "Je viens de refinir ma pièce pour le Gymnase, seconde façon, où, au lieu de quelques corrections indiquées, je me suis laissée aller à la fièvre de tout refaire autrement."
                            },
                            {
                                "example_id": "43c3fa80-776d-45c5-8776-8a0bb8b8e6fd",
                                "sense_id": "e4bbdeb4-f9d3-36e1-851c-83f078a4191f",
                                "text": "Il lui avait répondu qu’il trouvait plus simple de changer une seule vitre que de sabler et refinir un dessus en bois."
                            }
                        ]
                    }
                ],
