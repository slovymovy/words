                ],
                "senses": [
                    {
                        "sense_id": "2c2dfd2e-fb10-3c00-a470-fc7936cac836",
                        "entry_id": "891fec76-dd28-3422-8f86-500be30e4fb1",
                        "glosses": [
                            "bedenking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "845ac945-7eeb-4eed-9169-c9d64b1ec1b5",
                                "sense_id": "2c2dfd2e-fb10-3c00-a470-fc7936cac836",
                                "text": "Zijn bezwaar werd direct behandeld en opgelost."
                            },
                            {
                                "example_id": "f6b1b11d-5234-4f67-b073-3534b3bad39b",
                                "sense_id": "2c2dfd2e-fb10-3c00-a470-fc7936cac836",
                                "text": "Jochem wuifde haar zogenaamde bezwaar met zijn dikke rechterknuist weg."
                            },
                            {
                                "example_id": "3de7fa56-ac04-4c29-8e5d-1e8aa86deb05",
                                "sense_id": "2c2dfd2e-fb10-3c00-a470-fc7936cac836",
                                "text": "In haar voorbereiding is ze in mijn huid gekropen en heeft inmiddels op mijn eventuele bezwaren iets gevonden waarmee ze keihard van tafel kunnen worden geveegd."
                            }
                        ]
                    },
                    {
                        "sense_id": "56e917fa-122f-3ab0-a209-59fa7a95f5a1",
                        "entry_id": "891fec76-dd28-3422-8f86-500be30e4fb1",
                        "glosses": [
                            "moeilijkheid, nadeel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c3eea1-a456-4570-adf3-6c35cb4a46f4",
                                "sense_id": "56e917fa-122f-3ab0-a209-59fa7a95f5a1",
                                "text": "Het plan om midden in de stad een windturbine te plaatsten heeft grote bezwaren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80522ee2-ef29-404e-adae-a6345d344dce",
                        "source_entry_id": "891fec76-dd28-3422-8f86-500be30e4fb1",
