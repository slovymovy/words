                    {
                        "form_id": "cfb14256-a256-48a5-8508-e5f5906c5e58",
                        "entry_id": "318c4bb8-9b2b-3a62-9fab-0f205de64fbd",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "непринуждённостях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f048688d-2ecd-3716-a2f2-ea8e3bdc2fc1",
                        "entry_id": "318c4bb8-9b2b-3a62-9fab-0f205de64fbd",
                        "glosses": [
                            "свойство по значению прилагательного непринуждённый; естественность, простота в обращении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0b6787-9063-4df4-a25d-d896c13a1b71",
                                "sense_id": "f048688d-2ecd-3716-a2f2-ea8e3bdc2fc1",
                                "text": "Граф представил меня; я хотел казаться развязным, но чем больше старался взять на себя вид непринуждённости, тем более чувствовал себя неловким."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85da990c-588d-4f88-87f0-be447976e786",
                        "source_entry_id": "318c4bb8-9b2b-3a62-9fab-0f205de64fbd",
                        "source_sense_id": "f048688d-2ecd-3716-a2f2-ea8e3bdc2fc1",
                        "target_lang_word": "aisance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aisance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "Liberté de corps et d’esprit dans le travail, dans les mouvements, dans les manières, dans le commerce de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b171f4e5-fa88-4c49-9581-3e51aeced1d9",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "Avec une aisance qui confond —une aisance, une force d’élément— il menait de front quatre livres, des pièces de théâtre, des polémiques de journal, des affaires de toutes sortes."
                                            },
                                            {
                                                "example_id": "48ddb4c5-df08-43c0-9239-db1e559dfb76",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "Mmes Daudoird et Clara Lemonnier, dont la première portait l’habit noir avec un chic et une aisance qui auraient damé le pion au clubman le plus élégant."
                                            },
                                            {
                                                "example_id": "acc6b150-fd0e-4969-8d68-faf433ac844f",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "L’aisance avec laquelle les poètes juifs maniaient le vers français permet de supposer que leur talent a dû s’exercer dans les genres les plus variés."
                                            },
                                            {
                                                "example_id": "59ece4f3-91b2-4597-a132-b4d1e38cf818",
                                                "sense_id": "28954b75-7ccc-3d30-80da-fe7dc40475fe",
                                                "text": "Ils manient avec une élégante aisance les mètres latins les plus compliqués et les vocables les plus choisis de la mythologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "État de fortune suffisant pour se procurer les commodités de la vie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc95ecd6-6358-4039-99a0-433cf3e8096c",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "Elle vit l’opulence & les richesses succéder à l’aisance ; & son père , avant tout cela , avoit connu le mésaise & presque la pauvreté."
                                            },
                                            {
                                                "example_id": "7e6f9885-369d-4885-bb5d-4d39228f1251",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "Aussi, dès qu’un paysan a réalisé une minime aisance, fait-il badigeonner d’ocre la façade et les murs intérieurs de son réduit : […]"
                                            },
                                            {
                                                "example_id": "4103bc40-ad86-4dd2-bb5e-4b70f1315608",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "[…] moi, mon rêve est de me retirer dans quelques années d’ici, au fond de l’une de nos belles provinces mexicaines avec une modeste aisance, vous voyez que je ne suis pas ambitieux."
                                            },
                                            {
                                                "example_id": "978af20e-9c51-4411-aad2-6d2f302f23c3",
                                                "sense_id": "2079afc7-8a2a-34ab-bf1f-03ed9a304f0b",
                                                "text": "Le fait, d’ailleurs, est patent, incontesté, affirmé de tous côtés : l’aisance s’est énormément développée parmi les ruraux des Côtes-du-Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "Espace forestier dans lequel les villageois pouvaient tirer leur subsistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099cb134-bcea-4143-82f4-0e0f55c561c7",
                                                "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                                "text": "Il sera permis à tous et chacun de nos sujets, manants dudit village, de sartager chaque année un demi journal d’aisance, pour y semer du dur grain et ensuite une avoine tant seulement."
                                            },
                                            {
                                                "example_id": "606115d4-935a-45c2-a4ee-6b4de102ae66",
                                                "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                                "text": "[…] ; à quoi Sa Sérénissime Éminence voulant pourvoir, fait défense sérieuse à tous un chacun de sartager les voies herdales et aisances communes, comme aussi de faire fendre ni labourer en aucune manière le gazon commun, sans enseignement et permission expresse compétente, à peine d’une amende de dix florins d'or pour chaque fois, […]."
                                            },
                                            {
                                                "example_id": "2719f098-5c50-4148-866b-22e77e7c576b",
                                                "sense_id": "f954e383-b023-3122-a8b4-dc587539bd8d",
                                                "text": "Aux premiers temps, l'exploitation avait comme seule et unique règle : les besoins: on ne prenait en forêt que ce qui était utile (les « aisances » ou « commodités ») et on laissait sur place tout le reste. Chacun se servait là où bon lui semblait, et coupait les arbres qui lui convenaient: la forêt était le domaine de la liberté, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                        "entry_id": "3b99ea13-1e95-38cc-ae68-0016ac1df52b",
                                        "glosses": [
                                            "Lieu pratiqué dans une maison pour y satisfaire les besoins naturels."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed24481-63f3-4526-9b4b-116912f3adcf",
                                                "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                                "text": "Lieux d’aisances."
                                            },
                                            {
                                                "example_id": "b89ceb81-4b62-436c-9b06-5e832dc30437",
                                                "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                                "text": "Cabinet d’aisances."
                                            },
                                            {
                                                "example_id": "bea0f13d-9990-4cb3-b874-5cb4b127053e",
                                                "sense_id": "f46000cf-b769-3010-ab91-5577adca75d6",
                                                "text": "Fosse d’aisances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11f7d951-fd9c-4d28-aee5-e01299471ca3",
                        "source_entry_id": "318c4bb8-9b2b-3a62-9fab-0f205de64fbd",
                        "source_sense_id": "f048688d-2ecd-3716-a2f2-ea8e3bdc2fc1",
                        "target_lang_word": "sans-façon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans-façon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c0b6073-d3a3-3e65-b93a-5b9c3bb5e217",
                                        "entry_id": "2acbe6b4-bfef-3508-8f7f-2a915c9a59e8",
                                        "glosses": [
                                            "Manière d’agir sans faire de façons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1438b56b-6d03-4ac9-98e6-f1f99a6f018e",
                                                "sense_id": "0c0b6073-d3a3-3e65-b93a-5b9c3bb5e217",
                                                "text": "Sanréal était un petit homme de trente-trois ans, avec des cheveux d’un noir sale, et d’une taille épaisse. Il affectait toutes sortes de choses et, par-dessus tout la bonhomie et le sans-façon ; mais sans renoncer pour cela, tant s’en faut, à la finesse et à l’esprit."
                                            },
                                            {
                                                "example_id": "8850797e-383d-4047-ae91-3c38c8bf7799",
                                                "sense_id": "0c0b6073-d3a3-3e65-b93a-5b9c3bb5e217",
                                                "text": "Le sans-façon de cette réception campagnarde égaya beaucoup les jeunes hôtes, et leur convive, serein et enjoué comme à l’ordinaire, fit honneur aux viandes froides et aux sauces figées du repas impromptu."
                                            },
                                            {
                                                "example_id": "f6f1c9b5-d238-439a-9b4c-3779ec9eeb14",
                                                "sense_id": "0c0b6073-d3a3-3e65-b93a-5b9c3bb5e217",
                                                "text": "Il tendit sa main avec un sans-façon de gentilhomme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sans-façon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "982d6760-9457-3b34-b32d-0a8b129d0914",
                                        "entry_id": "1a4ba3ff-b8ca-3d6e-a498-f5a9e0ade83f",
                                        "glosses": [
                                            "Qualifie une personne qui agit sans faire de manière, simplement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e31027-0122-43d9-8baa-011fce99a495",
                                                "sense_id": "982d6760-9457-3b34-b32d-0a8b129d0914",
                                                "text": "Le Président est sans façon, déclare le lieutenant"
                                            },
                                            {
                                                "example_id": "ac5dbe9a-8b6b-4ea0-ba8d-40978e91e663",
                                                "sense_id": "982d6760-9457-3b34-b32d-0a8b129d0914",
                                                "text": "Près des humbles mortels les Dieux sont sans façon;… — (Correspondance littéraire secrète, 1775)"
                                            },
                                            {
                                                "example_id": "153f0784-a56b-461a-b363-14075388cb0d",
                                                "sense_id": "982d6760-9457-3b34-b32d-0a8b129d0914",
                                                "text": "Il est sans-façon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sans-façon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab6aff33-1525-3415-a450-558c141122f5",
                                        "entry_id": "d464a7ca-0ea8-3a5e-bf22-62a591165ae6",
                                        "glosses": [
                                            "Sans faire de manière, en toute simplicité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b21f52e-ead7-45ca-a4f4-ea5666215031",
                                                "sense_id": "ab6aff33-1525-3415-a450-558c141122f5",
                                                "text": "… nous en agirons sans façon, sans cérémonie... ne voyez en nous que de bons voisins, qui vous estiment, …"
                                            },
                                            {
                                                "example_id": "dbcf2745-c001-40d1-9c01-649ffb4b3f17",
                                                "sense_id": "ab6aff33-1525-3415-a450-558c141122f5",
                                                "text": "Nous avons dîné sans-façon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59fa7ad9-41bf-40bd-93ea-7276674b6c07",
                        "source_entry_id": "318c4bb8-9b2b-3a62-9fab-0f205de64fbd",
                        "source_sense_id": "f048688d-2ecd-3716-a2f2-ea8e3bdc2fc1",
                        "target_lang_word": "décontraction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décontraction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83c31dd6-3cf9-380f-8e08-648a2c6d4b14",
                                        "entry_id": "4310b203-caf6-3448-b152-e5640fcea8cb",
                                        "glosses": [
                                            "Action de décontracter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df63c94-c8e9-46b0-a68f-b6f593dd0c33",
                                                "sense_id": "83c31dd6-3cf9-380f-8e08-648a2c6d4b14",
                                                "text": "Or, la décontraction — ou, pour employer le terme américain, le relax — joue un rôle essentiel dans la production du swing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef87a95-6fa1-3a78-958a-4008cc12b15f",
                                        "entry_id": "4310b203-caf6-3448-b152-e5640fcea8cb",
                                        "glosses": [
                                            "Relaxation des muscles quand le signal (surtout via l'acétylcholine et le calcium intracellulaire libre) de leur contraction prend fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3cf1e45-0d49-4400-96b1-cef4d9763588",
                                                "sense_id": "3ef87a95-6fa1-3a78-958a-4008cc12b15f",
                                                "text": ". C’est par asphyxie que meurt l’animal intoxiqué; il y a d’abord accélération de la respiration, puis ralentissement; cette dernière période est de plus caractérisée par ce fait que l'inspiration se fait amplement et que l'eXpiration est lente, difficile; enfin la scène se termine par un ralentissement considérable et l’asphyxie. En présence de ces faits, et étant d0nnée la lenteur que nous avons constatée dans la décontraction musculaire, nous pouvons, dit l’auteur, admettre que les muscles expirateurs ne sont pas assez forts pour vaincre la résistance que leur opposent les inspirateurs au début de leur décontraction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "395f478d-7521-412e-a7a5-94a3889e6572",
                        "source_entry_id": "318c4bb8-9b2b-3a62-9fab-0f205de64fbd",
                        "source_sense_id": "f048688d-2ecd-3716-a2f2-ea8e3bdc2fc1",
                        "target_lang_word": "désinvolture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désinvolture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0566b11-ecfe-3e74-a4de-46f51191568c",
                                        "entry_id": "a1c1ba27-ca0d-3605-8ee5-2743180ee0d0",
                                        "glosses": [
                                            "Tournure ou tenue pleine d’aisance et de laisser-aller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e85f9c1-75fe-491d-bb2b-2b1713cb5beb",
                                                "sense_id": "a0566b11-ecfe-3e74-a4de-46f51191568c",
                                                "text": "Il est venu, voilà tout. Il m’a tiré des mains de M. Vampa, où, malgré mes apparences pleines de désinvolture, comme vous dites, je faisais fort mauvaise figure, je l’avoue."
                                            },
                                            {
                                                "example_id": "5e60c271-5bbf-4d4b-84d6-541c32e79b13",
                                                "sense_id": "a0566b11-ecfe-3e74-a4de-46f51191568c",
                                                "text": "Quand elle fut assise dans sa loge, elle se cambra la taille avec une désinvolture de duchesse."
                                            },
                                            {
                                                "example_id": "07653459-1554-43f5-b4fb-8e5a32c5e3e5",
                                                "sense_id": "a0566b11-ecfe-3e74-a4de-46f51191568c",
                                                "text": "Le tribunal était comme un théâtre. Les avocats s’animaient comme s’ils jouaient une pièce de Shakespeare. Ils parlaient haut et fort avec une désinvolture qui caractérise les acteurs de théâtre. Je n'aimais pas du tout la façon dont ces avocats parlaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007ef56f-99ce-38c4-876a-931ec0143651",
                                        "entry_id": "a1c1ba27-ca0d-3605-8ee5-2743180ee0d0",
                                        "glosses": [
                                            "Manière trop libre d’agir, de se comporter à l’égard de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee47e49a-bffe-4cb2-b3e3-6ebd4f8f1152",
                                                "sense_id": "007ef56f-99ce-38c4-876a-931ec0143651",
                                                "text": "Ce jeune homme est d’une désinvolture qui confine à l’impertinence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
