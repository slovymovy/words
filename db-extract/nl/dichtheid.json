                    {
                        "translation_id": "32616e38-aebc-4fc0-9756-15941560ec7b",
                        "source_entry_id": "0e4003dd-0807-3437-abcd-132723077c30",
                        "source_sense_id": "fd2e88c0-3b8d-3184-90e4-b5958d6097c8",
