                "senses": [
                    {
                        "sense_id": "4df72f5b-81b1-387a-b6b2-39226acf132b",
                        "entry_id": "6ac9df06-4a31-33d7-a063-a08f31b65a1d",
                        "glosses": [
                            "Intense study of someone or something."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "165e1f1a-2fe9-40e4-a3b6-ab4c455bb4f0",
                                "sense_id": "4df72f5b-81b1-387a-b6b2-39226acf132b",
                                "text": "Thenceforth I thought thee worth my nearer view / And narrower scrutiny."
                            },
                            {
                                "example_id": "b261db22-dc66-40c9-bb1e-5035fd057a2d",
                                "sense_id": "4df72f5b-81b1-387a-b6b2-39226acf132b",
                                "text": "So much for the occupant of the britscha, who waits, as all the horses are out at a ball or a scrutiny."
                            },
                            {
                                "example_id": "b904c9e6-810a-4388-9cf5-647d8d15d1b1",
                                "sense_id": "4df72f5b-81b1-387a-b6b2-39226acf132b",
                                "text": "Younger [Customs] examiners, who, perhaps, have not yet acquired the intuition resulting from years of experience, seem partly responsible for the closer examination of incoming luggage. Not only is this closer scrutiny arousing feelings of resentment among passengers, but it is causing serious delays in the departure of boat trains, many of which have been reaching their destinations two or three hours late."
                            },
                            {
                                "example_id": "9d0babf5-2f6c-4bd3-8abd-2e8e357e5b42",
                                "sense_id": "4df72f5b-81b1-387a-b6b2-39226acf132b",
                                "text": "Certainly, upon closer scrutiny, it becomes apparent that current usage rather than eighteenth-century usage is the basis of the interpretation of fanny as a sexual term."
                            }
                        ]
                    },
                    {
                        "sense_id": "7924f4ac-daa7-34cd-8d50-aa51f29adef4",
                        "entry_id": "6ac9df06-4a31-33d7-a063-a08f31b65a1d",
                        "glosses": [
                            "Thorough inspection of a situation or a case."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a66b512d-d6ba-43aa-8e80-ee85ceb0e4e0",
                                "sense_id": "7924f4ac-daa7-34cd-8d50-aa51f29adef4",
                                "text": "come under scrutiny"
                            },
                            {
                                "example_id": "5307afbd-d1c7-4918-93e6-a31044c4b35d",
                                "sense_id": "7924f4ac-daa7-34cd-8d50-aa51f29adef4",
                                "text": "A number of other mergers of U.S. railroads are mooted, but the I.C.C. [Interstate Commerce Commission] has made it clear that its assent to the N.& W.-Virginian proposal, which was unopposed by competitors or stockholders, should not be taken as an indication that others will swiftly pass its scrutiny."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7acfefd-c42f-3c67-a972-318fe3621c15",
                        "entry_id": "6ac9df06-4a31-33d7-a063-a08f31b65a1d",
                        "glosses": [
                            "An examination of catechumens, in the last week of Lent, who were to receive baptism on Easter Day."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "54e3a6b1-7ac3-3dca-855b-6ffd29ff6c79",
                        "entry_id": "6ac9df06-4a31-33d7-a063-a08f31b65a1d",
                        "glosses": [
                            "A ticket, or little paper billet, on which a vote is written."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b630d9c7-2304-3d8d-b30d-cb5ba5082f03",
                        "entry_id": "6ac9df06-4a31-33d7-a063-a08f31b65a1d",
                        "glosses": [
                            "An examination by a committee of the votes given at an election, for the purpose of correcting the poll."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a9ff3910-f4e0-4cb5-8d31-b5180c993189",
                                "sense_id": "b630d9c7-2304-3d8d-b30d-cb5ba5082f03",
                                "text": "The Returning Officer on the day appointed to make a scrutiny of the poll"
                            }
                        ]
                    }
