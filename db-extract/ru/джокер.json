                "translations": [
                    {
                        "translation_id": "de5ebcbf-7322-49c3-930b-b6db36378b98",
                        "source_entry_id": "269bddbc-2c72-354a-bb45-9fdccd7517c1",
                        "target_lang_word": "joker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad9e5ef-fe27-3788-b00d-b0da619985d7",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A person who makes jokes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8a593d-2472-3143-84e9-9734c4386e14",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A funny person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fc4d605-369a-300e-8137-357b3132315a",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A jester."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16b074f3-89ff-3767-87a8-f9555a3ff359",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A playing card that features a picture of a joker (that is, a jester) and that may be used as a wild card in some card games."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "Something kept in reserve that can be used to gain an advantage; a trump card."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6198425-59e1-4d44-8e07-5ca189363e01",
                                                "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                                "text": "Rebus decided to use their joker. 'Mr Lintz made a phone call to this office. He was talking for over twenty minutes.'"
                                            },
                                            {
                                                "example_id": "a47005c7-d1a8-4681-8adb-4be7108f5b13",
                                                "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                                "text": "Tash Wilson played her 'joker' , pulling her chair so close our legs were almost touching. 'Hey, Chris, do you want to go out sometime? All you've got to do is say the word.'"
                                            },
                                            {
                                                "example_id": "7080d0e6-b9a2-40f4-89c7-f84f42ff45a5",
                                                "sense_id": "599a1d9e-cbe0-3327-8c09-8216508a84af",
                                                "text": "The director made me understand that my bubble of stardom could burst just as soon as it had been inflated if I didn't watch my attitude. Then he used his joker. I had an understudy so if I messed up or tried to create a scene, I would be summarily replaced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36926e8f-c6a0-3d3e-a927-20f048ec03a0",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "An unspecified, vaguely disreputable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5713a2d3-008f-4b46-9290-a792dbe4efdf",
                                                "sense_id": "36926e8f-c6a0-3d3e-a927-20f048ec03a0",
                                                "text": "Some joker keeps throwing eggs at my windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87048809-5a6e-3140-baf2-c2adf4d244fb",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "An unspecified, vaguely disreputable person.",
                                            "A loser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b302b7a5-1c66-42f4-b53c-b27758910a81",
                                                "sense_id": "87048809-5a6e-3140-baf2-c2adf4d244fb",
                                                "text": "Don't waste your breath on these jokers round here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480a0a5b-87f0-3382-a7d7-814e6725edf3",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A man."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A clause in a contract that undermines its apparent provisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7513ae7-c259-42d9-95ef-55e307b9bfb9",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "Discussion of contracts and the many provisions contained therein led to a vote making it the sense of the convention that manufacturers should use a simple sales contract, free from jokers."
                                            },
                                            {
                                                "example_id": "5784fd73-457e-448e-bba3-053d9b2aa84b",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "Then, sir, on page 12 of the agreement there is a joker clause, which provides for payments in addition to the ten per cent, […]"
                                            },
                                            {
                                                "example_id": "4cefa02a-01a0-4a82-9d77-b96eda4b04c7",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "Stone claimed that there was a Joker in the contract, one clause (No. 2) calling for two weeks' notice and another (No. 8) calling for payment on a par-day basis after the first two weeks."
                                            },
                                            {
                                                "example_id": "cab65f81-7c8a-4355-8369-40e4661b2041",
                                                "sense_id": "018d1672-8a40-3bf0-b7d5-7e9fd007e1b7",
                                                "text": "The object of these provisions is to prevent insertion of \"jokers\" or \"sleepers\" in bills and securing passage under the false color of the title."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5dad722-4489-3711-854a-d56309167100",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A friendly unit that acts as a suspected hostile unit in a military excercise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1998f197-b004-4c03-a006-cfe8bc7df216",
                                                "sense_id": "b5dad722-4489-3711-854a-d56309167100",
                                                "text": "Joker - A friendly track or contact acting as a \"suspect\" track for exercise purposes only. (STANAG 1241)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8f6add-5f73-36d9-8da4-eb544c9037a5",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "The option, in a pub quiz, of selecting one particular round in which one's team will score double points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c83afc9-e23e-4cda-b55f-de71e99e8655",
                                                "sense_id": "1b8f6add-5f73-36d9-8da4-eb544c9037a5",
                                                "text": "We used our joker as soon as the topic of sports was announced, since we are sport experts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39dfa485-0468-375f-9223-15ccd2ca63db",
                                        "entry_id": "638587e3-0f5d-386c-9356-bc0dfcccae57",
                                        "glosses": [
                                            "A fairy chess piece that moves like the last piece that was moved by the opponent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a989fc43-f009-45fd-a09f-275f44cc57e5",
                                                "sense_id": "39dfa485-0468-375f-9223-15ccd2ca63db",
                                                "text": "The problem is that it would be difficult to use a joker offensively since you could never know how it was going to move, meaning it’d be most useful setting it up for potential queen/rook captures to disincentivize your opponent from moving those pieces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
