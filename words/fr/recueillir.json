{
    "word_family": [
        "recueil",
        "cueillir",
        "cueillette",
        "accueillir",
        "accueil"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "153e5d98-427e-37af-ac4d-c9c00b897826",
                    "sense_definition": "Collecter des informations, des avis ou des fonds auprès de diverses sources.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "collecter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes tentent de <w>recueillir</w> des informations fiables auprès des témoins de l'accident."
                        },
                        {
                            "text": "Cette organisation caritative a réussi à <w>recueillir</w> des fonds pour aider les sinistrés."
                        }
                    ],
                    "synonyms": [
                        "rassembler"
                    ],
                    "common_phrases": [
                        "recueillir des informations",
                        "recueillir des fonds",
                        "recueillir des témoignages"
                    ]
                },
                {
                    "sense_id": "2e45afde-bbb8-3f49-8c98-923c48eab2a5",
                    "sense_definition": "Accueillir et abriter chez soi une personne ou un animal sans abri ou en détresse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abriter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de <w>recueillir</w> un chien blessé qu'ils avaient trouvé dans la forêt."
                        },
                        {
                            "text": "Pendant la tempête, les habitants ont généreusement <w>recueilli</w> plusieurs voyageurs bloqués."
                        }
                    ],
                    "common_phrases": [
                        "recueillir un animal",
                        "recueillir un chien",
                        "recueillir des réfugiés"
                    ]
                },
                {
                    "sense_id": "e118706b-b782-3a78-ae0b-96a4697342bb",
                    "sense_definition": "Obtenir ou remporter des voix, des suffrages ou l'approbation d'un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obtenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau candidat espère <w>recueillir</w> les suffrages de la population locale."
                        },
                        {
                            "text": "Sa proposition de réforme a <w>recueilli</w> une large adhésion parmi les membres du conseil."
                        }
                    ],
                    "synonyms": [
                        "gagner"
                    ],
                    "common_phrases": [
                        "recueillir les suffrages",
                        "recueillir une majorité",
                        "recueillir des votes"
                    ]
                },
                {
                    "sense_id": "2ff277d7-d76a-33d0-8cc5-dcf3d7005d1c",
                    "sense_definition": "Faire silence en soi-même pour méditer ou prier, en particulier en mémoire de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meditation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une foule nombreuse est venue se <w>recueillir</w> devant le monument pour rendre hommage aux disparus."
                        },
                        {
                            "text": "Chaque année, elle prend le temps de se <w>recueillir</w> en silence sur la tombe de ses grands-parents."
                        }
                    ],
                    "common_phrases": [
                        "se recueillir en silence"
                    ]
                },
                {
                    "sense_id": "11532a37-d350-335c-9345-7834e98d3372",
                    "sense_definition": "Recevoir ou intercepter un liquide qui coule ou qui tombe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "collecter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cultivateur fixe un petit bol en bois pour <w>recueillir</w> la résine de l'arbre."
                        },
                        {
                            "text": "Les habitants ont placé plusieurs seaux sous le toit percé afin de <w>recueillir</w> les gouttes d'eau."
                        }
                    ],
                    "common_phrases": [
                        "recueillir la résine",
                        "recueillir la sève"
                    ]
                },
                {
                    "sense_id": "d080c8a0-992b-366d-800a-13e6d561951d",
                    "sense_definition": "Recevoir des biens ou des droits patrimoniaux par voie d'héritage légal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obtenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme a fini par <w>recueillir</w> une succession complexe après de longues démarches notariales."
                        },
                        {
                            "text": "Faute de descendance directe, le cousin éloigné va <w>recueillir</w> tous les biens du domaine."
                        }
                    ],
                    "common_phrases": [
                        "recueillir une succession",
                        "recueillir un héritage"
                    ]
                }
            ]
        }
    ]
}