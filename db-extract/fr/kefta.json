                ],
                "senses": [
                    {
                        "sense_id": "4dfe12e4-69c9-31b5-bef4-c3b3eceb6cbb",
                        "entry_id": "bfb80cd9-8349-36c3-ba47-f2d99c2b6df2",
                        "glosses": [
                            "gewürztes Hackfleisch aus Lamm oder Rind; Köfte"
                        ],
                        "tags": [
                            "regional (Maghreb",
                            "Marokko",
                            "Algerien",
                            "Tunesien)"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec99bfd-7c17-447d-9931-d8f1da9ab853",
                                "sense_id": "4dfe12e4-69c9-31b5-bef4-c3b3eceb6cbb",
                                "text": "« Savez-vous que le vendeur de sandwichs n’a pas le droit de préparer la kefta d’avance. »",
                                "translation": "„Wussten Sie, dass ein Sandwich-Verkäufer nicht berechtigt ist, die Köfte im Voraus zu zubereiten.“"
                            },
                            {
                                "example_id": "276ade2b-53d5-43bf-b084-cf2b3fd8a342",
                                "sense_id": "4dfe12e4-69c9-31b5-bef4-c3b3eceb6cbb",
                                "text": "« ll ne reste que la kefta! Pardi, de la viande hachée, par cette chaleur, est-ce bien raisonnable ? »",
                                "translation": "„Bleibt nur [noch] Köfte! [War ja] klar, [ausgerechnet] Hackfleisch, bei dieser Hitze, ist das [noch] ganz vernünftig/zumutbar?“"
                            },
                            {
                                "example_id": "4efbb04d-1c87-4b85-b701-6f561e73e638",
                                "sense_id": "4dfe12e4-69c9-31b5-bef4-c3b3eceb6cbb",
                                "text": "« Les boulettes de kefta arrivent, cuites à point et abondamment épicées. »",
                                "translation": "„Da kommen [auch schon] die Köfte-Bällchen, gar auf den Punkt und reichlich gewürzt.“"
                            },
                            {
                                "example_id": "5dba55d6-cb2c-4611-b0d4-bd1c5ab058c5",
                                "sense_id": "4dfe12e4-69c9-31b5-bef4-c3b3eceb6cbb",
                                "text": "« Mon père a invité des hommes, je leur ai fait de la kefta, je t’en envoie un peu pour ta belle-fille enceinte, je sais ce qu’est l’envie. »",
                                "translation": "„Mein Vater hat Männer eingeladen, ich habe ihnen Köfte gemacht, ich schicke dir etwas davon für deine schwangere Schwiegertochter, ich weiß [ja], wonach ihr gelüstet.“"
                            }
                        ],
