                "senses": [
                    {
                        "sense_id": "5c08b0d5-6493-3ea3-80c1-0bc9ae693c00",
                        "entry_id": "10c8357d-a31a-35e1-a8bd-70b9d492fc22",
                        "glosses": [
                            "устар. то же, что удостаивать"
