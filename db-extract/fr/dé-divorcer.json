                "senses": [
                    {
                        "sense_id": "ded994c4-a6cf-39e9-80cb-754946f89852",
                        "entry_id": "561818f0-0aff-337b-a799-e8c6b613cbfd",
                        "glosses": [
                            "Annuler son divorce."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1744a904-9993-45b8-bf0e-633fd6512683",
                                "sense_id": "ded994c4-a6cf-39e9-80cb-754946f89852",
                                "text": "Même que je finissais par penser qu’ils devraient « dé-divorcer », puisque leur séparation nous rendait tous les trois malheureux."
                            },
                            {
                                "example_id": "23106ab6-9911-443f-9fd8-fc9c21d23545",
                                "sense_id": "ded994c4-a6cf-39e9-80cb-754946f89852",
                                "text": "En effet si le divorce est là pour se dé-marier, rien n’est prévu pour dé-divorcer..."
                            },
                            {
                                "example_id": "8ab5a88a-6136-478e-8b26-192acdf5e311",
                                "sense_id": "ded994c4-a6cf-39e9-80cb-754946f89852",
                                "text": "C’est ce que montre cette terrible histoire : dé-divorcer est alors impossible."
                            }
                        ]
                    }
