    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10769b4b-2902-38a4-a360-d175416764f8",
                    "sense_definition": "The most important or essential part of something; the essence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>core</w> of the problem is a lack of communication between departments.",
