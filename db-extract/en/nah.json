                    {
                        "translation_id": "951b2a97-6c2b-4ff4-acbc-2151e2e41bcf",
                        "source_entry_id": "daa64778-35b8-34b9-8958-e4a8ae3ee05a",
                        "source_sense_id": "059b3ff7-524c-3f9c-a9d9-6d0efad93046",
