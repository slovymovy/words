                ],
                "senses": [
                    {
                        "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                        "entry_id": "d1a71510-fde4-38d6-8a34-5095050ffcc1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2aa6bfb-5eaa-4eb9-bf91-e10aa25f335b",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Frau Aichele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5789164e-6184-419e-b2d9-7a29c4644c01",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Herr Aichele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ad953ff3-ab74-43ad-b178-7f9cef7177b1",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Die Aicheles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "727ecd1f-ea84-4992-85d8-5cea0be4d6e8",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Der Aichele trägt nie die Pullover, die die Aichele ihm strickt."
                            },
                            {
                                "example_id": "3976199b-c06b-4190-a253-0bb1227ee476",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aichele kommt, geht der Herr Aichele.“"
                            },
                            {
                                "example_id": "d46a5d8f-ce71-485d-81bc-e1f49664ee41",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Aichele kommt und geht."
                            },
                            {
                                "example_id": "ef43415a-10b3-49b2-9a7a-86ff07df96a8",
                                "sense_id": "42abf88f-6baa-36e9-a0e2-260df17ca0aa",
                                "text": "Aicheles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
