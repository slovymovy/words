                    {
                        "form_id": "79e5dd15-fe43-48e7-9c8b-d33753b3adcd",
                        "entry_id": "001880f4-7d1b-3132-89fc-84a94b313610",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Gebärdensprache"
                    },
                    {
                        "form_id": "61e1338d-0dc6-4f35-b3df-9502d227dbde",
                        "entry_id": "001880f4-7d1b-3132-89fc-84a94b313610",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gebärdensprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                        "entry_id": "001880f4-7d1b-3132-89fc-84a94b313610",
                        "glosses": [
                            "„Zeichensprache“, Sprache der Gehörlosen mit gestischen und mimischen Ausdrücken (Gebärden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f96d22-5d61-4670-b837-d85858668caf",
                                "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                                "text": "Die Gebärdensprache ist als Sprache akzeptiert."
                            },
                            {
                                "example_id": "ab947750-6671-4dda-92ec-d185eb62d139",
                                "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                                "text": "„Die Erkenntnis, daß Gebärdensprachen Sprachsysteme darstellen, die den Lautsprachen analog sind, entwickelte sich aber erst seit Mitte der 1960er Jahre.“"
                            },
                            {
                                "example_id": "950a22b7-7855-4134-8f48-d62bf8c154ff",
                                "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                                "text": "„Es gibt ja auch unter Menschen Gebärdensprachen, wenn die Lautsprache aus irgendeinem Grund nicht angewendet werden kann oder soll, wie z. B. bei Taubstummen, bei Trappisten, deren Ordensregel das Sprechen verbietet, oder in gesellschaftlichen Schichten, die auf geheime Verständigung Wert legen.“"
                            },
                            {
                                "example_id": "dfd6054d-e318-4a4b-9ae6-c124ac602e91",
                                "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                                "text": "„Besser, so scheint es, steht es mit der sogenannten Geberdensprache; der Eine macht dem Anderen ein sichtbares Zeichen, das dieser so versteht und nur so verstehen kann, wie es von Jenem gemeint ist.“"
                            },
                            {
                                "example_id": "0ef10eef-1b01-4b5b-8a4c-a3302c4ac997",
                                "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                                "text": "„Die Gebärdensprache tritt ein ins Zeitalter ihrer technischen Reproduzierbarkeit.“"
                            },
                            {
                                "example_id": "876c7147-1211-4b2c-9a5d-2bc74cbcc098",
                                "sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                                "text": "„Rosas Hände, die in der Gebärdensprache immer lebendig waren, fanden auch im Ruhestand keine Ruhe, sie wollte kochen, konnte aber nicht, denn sie sah nichts, und ihre Hände folgten nun anderen Gesetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9d1cdcd-eb34-424a-9c87-a4d51957cac1",
                        "source_entry_id": "001880f4-7d1b-3132-89fc-84a94b313610",
                        "source_sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                        "source_sense_description": "Sprache der Gehörlosen",
                        "target_lang_word": "sign language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sign language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5a499c-b42e-39b7-9ad1-0380212498fc",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "One of several natural languages, typically used by the deaf, in which words consist of hand shapes, motions, positions, and facial expressions."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d4bab63-1701-4e80-9545-664787bee543",
                                                "sense_id": "2b5a499c-b42e-39b7-9ad1-0380212498fc",
                                                "text": "It is safe to say that the academic world is now convinced that sign languages are real languages in every sense of the term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d5662df-b40c-321f-86ab-c6f0c6074e82",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "The sign language (sense 1) that is used locally or that is mistakenly believed to be the only one."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5f7055-ffbe-412e-b983-1f8d5028ab96",
                                                "sense_id": "1d5662df-b40c-321f-86ab-c6f0c6074e82",
                                                "text": "I'm taking night classes to learn sign language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3606d53f-ea5b-3695-9d04-8edeb92c347f",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "Sign languages (sense 1) considered collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a69fd08-1545-42a2-9f34-1011cf3af3d0",
                                                "sense_id": "3606d53f-ea5b-3695-9d04-8edeb92c347f",
                                                "text": "There are some unique properties found in sign language compared to spoken language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af40b8a4-eafc-3a53-9685-f62ebaa092b8",
                                        "entry_id": "bf4d6296-81ed-3da6-b968-788819961161",
                                        "glosses": [
                                            "Communication through gestures as a substitute for language, for example, between monks under a vow of silence or during trade amongst different linguistic groups."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c40c14-85e4-4397-a0eb-e4d84a8a8736",
                                                "sense_id": "af40b8a4-eafc-3a53-9685-f62ebaa092b8",
                                                "text": "Even Maxwell the trader, who has been most among them, is compelled to resort to the curious sign language common to most of the prairie tribes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69780d69-a8fb-4c3e-bd5d-41cecacf97cd",
                        "source_entry_id": "001880f4-7d1b-3132-89fc-84a94b313610",
                        "source_sense_id": "adeb11b5-0b42-330f-8739-b99fb68716ac",
                        "source_sense_description": "Sprache der Gehörlosen",
                        "target_lang_word": "langue des signes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langue des signes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18695182-1bc8-3251-976d-574cd0773b87",
                                        "entry_id": "417ba0f0-dfe4-38ee-805a-e80313392708",
                                        "glosses": [
                                            "Langue gestuelle utilisant les mouvements des mains, du visage et du corps dans son ensemble, employée par les personnes sourdes ou muettes, ou malentendantes pour communiquer."
                                        ],
                                        "tags": [
                                            "Handicap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c608e175-52da-4da6-973b-0f36ffc7425e",
                                                "sense_id": "18695182-1bc8-3251-976d-574cd0773b87",
                                                "text": "Personne ne conteste plus le statut de langue à la langue des signes […]."
                                            },
                                            {
                                                "example_id": "4c7e7546-6687-4394-bc0b-f7d767e86490",
                                                "sense_id": "18695182-1bc8-3251-976d-574cd0773b87",
                                                "text": "Les yeux du public, des internautes, puis des médias américains étaient rivés sur la performance d’Amber Galloway Gallego, qui a livré en direct une traduction en langue des signes des chansons de l’artiste américain."
                                            },
                                            {
                                                "example_id": "068aa9b3-8625-4f9b-86f0-b17de9d8af29",
                                                "sense_id": "18695182-1bc8-3251-976d-574cd0773b87",
