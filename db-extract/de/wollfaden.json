                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6519d760-d63f-4f2e-a70b-8f4009ddb2d1",
                                "sense_id": "a8f2d392-630c-3f1a-9b96-b2c39bf62fcc",
                                "text": "Schmidts Katze liebt Wollfäden."
                            },
                            {
                                "example_id": "2dd448a6-e262-45f4-9b9f-90adcc583171",
                                "sense_id": "a8f2d392-630c-3f1a-9b96-b2c39bf62fcc",
                                "text": "„Ihr Haar hatte sie mit einem dicken, leuchtend roten Wollfaden im Nacken zusammengebunden.“"
                            },
                            {
                                "example_id": "617c5e08-8ff0-4b62-99fa-84a6ca7ac3ee",
                                "sense_id": "a8f2d392-630c-3f1a-9b96-b2c39bf62fcc",
                                "text": "„Die Spurensicherung würde in den nächsten Tagen die Wollfäden aus Elísabets Auto mit Ásas Schal abgleichen.“"
                            }
                        ],
