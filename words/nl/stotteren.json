{
    "word_family": [
        "stotteraar",
        "gestotter",
        "stottertherapie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "245d0223-ba0a-3c26-bfe0-403892e71288",
                    "sense_definition": "moeilijk uit je woorden komen door dezelfde klanken of lettergrepen onvrijwillig te herhalen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "spraakgebrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij begint vaak te <w>stotteren</w> als hij voor een grote groep mensen moet spreken.",
                            "target_lang_translations": {
                                "en": "He often starts to <w>stutter</w> when he has to speak in front of a large group of people."
                            }
                        },
                        {
                            "text": "Het kind kon door de zenuwen alleen maar <w>stotteren</w> tegen de leraar.",
                            "target_lang_translations": {
                                "en": "Because of the nerves, the child could only <w>stammer</w> at the teacher."
                            }
                        }
                    ],
                    "synonyms": [
                        "hakkelen",
                        "stamelen"
                    ],
                    "common_phrases": [
                        "beginnen te stotteren",
                        "erg stotteren"
                    ],
                    "target_lang_definitions": {
                        "en": "To have difficulty speaking by involuntarily repeating the same sounds or syllables"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stutter",
                                "target_lang_sense_clarification": "to speak with spasmodic repetition of sounds"
                            },
                            {
                                "target_lang_word": "stammer",
                                "target_lang_sense_clarification": "to speak with involuntary pauses or repetitions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c7baa72-ad76-356f-a539-22886f881bf7",
                    "sense_definition": "het onregelmatig en schokkerig lopen van een motor",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technisch_falen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude auto begon te <w>stotteren</w> vlak voordat hij midden op de weg stilviel.",
                            "target_lang_translations": {
                                "en": "The old car started to <w>sputter</w> just before it stalled in the middle of the road."
                            }
                        },
                        {
                            "text": "Ik hoorde de motor <w>stotteren</w> en wist meteen dat de benzine bijna op was.",
                            "target_lang_translations": {
                                "en": "I heard the engine <w>stutter</w> and knew immediately that the gas was almost empty."
                            }
                        }
                    ],
                    "synonyms": [
                        "haperen",
                        "inhouden"
                    ],
                    "common_phrases": [
                        "motor blijft stotteren",
                        "begon te stotteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "met betrekking tot motoren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The irregular and jerky running of an engine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stutter",
                                "target_lang_sense_clarification": "of an engine, to make repeated short sounds or run unevenly"
                            },
                            {
                                "target_lang_word": "sputter",
                                "target_lang_sense_clarification": "to make a series of soft explosive sounds"
                            },
                            {
                                "target_lang_word": "splutter",
                                "target_lang_sense_clarification": "to make a spitting or choking sound"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}