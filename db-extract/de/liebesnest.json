                                        "entry_id": "c568c67a-a125-3561-9c55-8d76c54a4986",
                                        "glosses": [
                                            "A residence, especially a condominium or cabin, where a couple (particularly a newly cohabiting or married couple) can enjoy each other's company."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97e819b9-99aa-4694-8c46-ac9eacd7e6ae",
                                                "sense_id": "80b100bf-0711-3657-9f2f-e1b106bbf00b",
                                                "text": "You two may enter the real estate process assuming that finding a little love nest is simply a matter of spotting a dream pad, placing an offer, and picking out curtains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f5ebc03-d15a-3b23-9a08-751670329052",
                                        "entry_id": "c568c67a-a125-3561-9c55-8d76c54a4986",
                                        "glosses": [
                                            "A place suitable for or used for having sexual intercourse."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038954eb-ef6e-497e-9523-a0e2be05768d",
                                                "sense_id": "1f5ebc03-d15a-3b23-9a08-751670329052",
                                                "text": "She even purchased a Mexican-style house to live in which she described as her \"Los Angeles love nest\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4954bfe2-632e-3f07-8e68-8c847f89e001",
                                        "entry_id": "c568c67a-a125-3561-9c55-8d76c54a4986",
                                        "glosses": [
                                            "The vagina."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af084362-e557-4f45-bbbd-5ffcdf2ee8ca",
                                                "sense_id": "4954bfe2-632e-3f07-8e68-8c847f89e001",
                                                "text": "She [Anka Radakovich] has given us her personal tips on oral sex—“whatever you do, keep your tongue moving ... occasionally some women like a finger or two inserted into the love nest”."
                                            },
                                            {
                                                "example_id": "e1b8d4b6-4ab8-4a24-a9a5-7d8bba0c399d",
                                                "sense_id": "4954bfe2-632e-3f07-8e68-8c847f89e001",
                                                "text": "He […] jerked my legs apart and, while the unconscious old kraut's juice seeped from my love nest, buried his face in the moist crevice, sucking, licking and lapping with the energy of ten men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d62b1e90-dfa1-4ca6-a91a-d993f1e5a289",
