                    {
                        "sense_id": "15d4ec00-54d1-31bf-a9d4-76516be9c02d",
                        "entry_id": "5067e60a-4f53-3e3d-9635-464b851d6620",
                        "glosses": [
                            "Déclaration par laquelle l’armée se déclare contre le gouvernement en place afin de provoquer sa chute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597040ba-69df-4e43-80b7-5497594121fb",
                                "sense_id": "15d4ec00-54d1-31bf-a9d4-76516be9c02d",
                                "text": "Les généraux de salon, à force de fréquenter les antichambres du pouvoir, rêvent de pronunciamientos."
                            }
                        ]
                    },
                    {
                        "sense_id": "678b8bd7-67f7-3661-8b4c-d10352eb5585",
                        "entry_id": "5067e60a-4f53-3e3d-9635-464b851d6620",
                        "glosses": [
                            "Coup d’État."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e2090aae-138d-4d13-8f15-065c998e70c9",
                                "sense_id": "678b8bd7-67f7-3661-8b4c-d10352eb5585",
                                "text": "Quelques années de bannissement, dont une loi d’amnistie effaça ultérieurement les traces, furent l’unique peine infligée à quelques-uns de ceux qui avaient gravement offensé la patrie en tentant d'organiser, contre la République parlementaire, un pronunciamiento militaire."
                            },
                            {
                                "example_id": "795043f4-9099-4156-ade3-cb54c5721502",
                                "sense_id": "678b8bd7-67f7-3661-8b4c-d10352eb5585",
                                "text": "Jamais un pronunciamiento n’a déclenché de guerre civile. Jusqu’en 1936 : et ce sera un grand changement."
                            }
                        ]
                    }
