                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "35721a01-aa47-352e-bd0a-463b4167e67c",
                        "entry_id": "bb82af1c-eef1-3f1f-90f0-e860fd04854f",
                        "glosses": [
                            "certainly, for sure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43480b92-7469-4cd8-a002-22d39dc27f10",
                                "sense_id": "35721a01-aa47-352e-bd0a-463b4167e67c",
                                "text": "'Meneer Duyn, u bent lid van de Tweede Kamer?' 'Jazeker.'",
                                "translation": "'Mr. Duyn, are you a member of the House of Representatives?' 'Certainly.'",
                                "english": "'Mr. Duyn, are you a member of the House of Representatives?' 'Certainly.'"
                            },
                            {
                                "example_id": "3bd4a60a-e112-425c-9ba1-9f0e7edccadc",
                                "sense_id": "35721a01-aa47-352e-bd0a-463b4167e67c",
                                "text": "'Ga nu weg.' 'Jazeker, meneer G.'",
                                "translation": "'Go away now' 'Certainly, Mr. G.'",
                                "english": "'Go away now' 'Certainly, Mr. G.'"
                            },
                            {
                                "example_id": "7176f5b0-5130-4f76-b72e-128de23d5d62",
                                "sense_id": "35721a01-aa47-352e-bd0a-463b4167e67c",
                                "text": "Jazeker, het zal op een significante manier afwijken van het conventionele christendom, vooral in zijn moderne Anglo-Amerikaanse vorm.",
                                "translation": "Certainly, it will significantly differ from the conventional Christianity, especially in its modern Anglo-American form.",
                                "english": "Certainly, it will significantly differ from the conventional Christianity, especially in its modern Anglo-American form."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "3a7c6973-9769-3fc3-8ca0-c9d007b10a7c",
                "word": "jazeker",
                "pos": "intj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                        "entry_id": "3a7c6973-9769-3fc3-8ca0-c9d007b10a7c",
                        "glosses": [
                            "een bevestiging die alle onzekerheid ontkent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ae3a84-3b94-4ed1-a0c5-865866fff3cf",
                                "sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                                "text": "\"Jazeker!\" zei hij en haalde de gevraagde sleutel uit zijn zak."
                            },
                            {
                                "example_id": "25649eaf-cab1-47fc-8046-bf8c0f39c546",
                                "sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                                "text": "Jazeker,' zegt ze."
                            },
                            {
                                "example_id": "3d9bdf56-da44-49ab-85ee-2003ac0375e6",
                                "sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                                "text": "Jazeker, we waren al op jonge leeftijd oorlogsdeskundigen."
                            },
                            {
                                "example_id": "a7fff6bd-4ae6-4206-883d-dac13ef53ebb",
                                "sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                                "text": "Jazeker! de hypotheker!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3879d0e9-a5c9-4c1a-9cf1-eba2fd7c0498",
                        "source_entry_id": "3a7c6973-9769-3fc3-8ca0-c9d007b10a7c",
                        "source_sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                        "source_sense_description": "een bevestiging die alle onzekerheid ontkent",
                        "target_lang_word": "certainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "In a way which is certain; with certainty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d57d5d-7e5a-4160-9e91-43ef23e26163",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "he verily thought he had young live frogs in his belly, qui vivebant ex alimento suo, that lived by his nourishment, and was so certainly persuaded of it, that for many years following he could not be rectified in his conceit."
                                            },
                                            {
                                                "example_id": "acad7d4d-3217-4638-bf27-04d0a5664d95",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "The torque was \"built up\" in the special back axle and the car crawled tankwise but very certainly over the obstacles without a jar or hesitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "Without doubt, surely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f5edfd-a190-46a3-b3d7-c40fc07f1c6f",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "The accident was certainly caused by human error."
                                            },
                                            {
                                                "example_id": "c6e95e92-978c-49ae-9844-6e3da1e1bab4",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "That was certainly sweet of him."
                                            },
                                            {
                                                "example_id": "72e8830c-37fa-428a-a001-0713feed9d07",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "'I'm all grown up now' -'You certainly have (grown)!'"
                                            },
                                            {
                                                "example_id": "d45ba451-4f5d-428c-9d74-ab88e2d6ec73",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "b27e5847-2b91-4193-81d0-5d87b301fe6d",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "An emphatic affirmative answer; of course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f25142-62b5-44da-806f-561c4542c5e9",
                                                "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                                "text": "Would you like it with ice?  Certainly, and with lemon please."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b28f7932-cac4-4ce3-9a32-26c52128b810",
                        "source_entry_id": "3a7c6973-9769-3fc3-8ca0-c9d007b10a7c",
                        "source_sense_id": "1a696f71-1b12-3b19-a82d-6c6c59da6920",
                        "source_sense_description": "een bevestiging die alle onzekerheid ontkent",
                        "target_lang_word": "sure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b407ed3-fa87-33e2-b6da-1e73364c6252",
                                        "entry_id": "d80d53ae-a39a-3552-96ef-029028acbc1d",
                                        "glosses": [
                                            "Physically secure and certain, non-failing, reliable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79b28b0-38d0-4aa6-baf4-cd841b256f45",
                                                "sense_id": "2b407ed3-fa87-33e2-b6da-1e73364c6252",
                                                "text": "This investment is a sure thing."
                                            },
                                            {
                                                "example_id": "c01950d3-dda6-4c9e-bda2-dd24f99c076b",
                                                "sense_id": "2b407ed3-fa87-33e2-b6da-1e73364c6252",
                                                "text": "The bailiff had a sure grip on the prisoner's arm."
                                            },
                                            {
                                                "example_id": "fe01e85f-01d3-4608-87c9-0741194d5454",
                                                "sense_id": "2b407ed3-fa87-33e2-b6da-1e73364c6252",
                                                "text": "'In the end,' said Mustapha Mond, 'the Controllers realized that force was no good. The slower but infinitely surer methods of ectogenesis, Neo-Pavlovian conditioning and hypnopædia…'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                        "entry_id": "d80d53ae-a39a-3552-96ef-029028acbc1d",
                                        "glosses": [
                                            "Certain in one's knowledge or belief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "966e272c-69d2-4595-aff6-ff23672ac719",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "The very excess of the extravagance, in fact, by suggesting to the reader continually the mere aeriality of the entire speculation, furnishes the surest means of disenchanting him from the horror which might else gather upon his feelings."
                                            },
                                            {
                                                "example_id": "c7ecaa17-46bb-41ce-a9cb-3fe4f73d63d5",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track. The three returned wondering and charmed with Mrs. Cooke; they were sure she had had no hand in the furnishing of that atrocious house."
                                            },
                                            {
                                                "example_id": "bdf9767d-23a7-44f2-9a04-f1e80aa2f76f",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "Roy: I'm 95% sure it was him.\nJen: You... you said you were 99% sure.\nRoy: I'm 97% sure it was him."
                                            },
                                            {
                                                "example_id": "60072610-7784-47ed-a8d7-c03d3c13286d",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "Are you sure to succeed, as polls say? —Well, I am at least certain of making it to the podium this time."
                                            },
                                            {
                                                "example_id": "bf4f90d6-9dd2-4506-be4b-5a61aced8d99",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "He was sure of being a finalist."
                                            },
                                            {
                                                "example_id": "dfe15cb6-3b31-4e5f-97f8-31c972e6b873",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "They aren't sure who will attend for sure."
                                            },
                                            {
                                                "example_id": "d7e01362-93e6-43a6-b14c-941dfe0251aa",
                                                "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                                                "text": "You seemed sure that the car was his. Yeah. I’m not sure what is the point of spending hours and hours discussing this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869e0664-db06-3195-816a-3f11369759ce",
                                        "entry_id": "d80d53ae-a39a-3552-96ef-029028acbc1d",
                                        "glosses": [
                                            "Certain to act or be a specified way."
                                        ],
                                        "tags": [
                                            "followed by a to infinitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d70050b6-7b3c-4fc1-9a57-3321408048b3",
                                                "sense_id": "869e0664-db06-3195-816a-3f11369759ce",
                                                "text": "Be sure to lock the door when you leave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e587657-cc0a-3b11-a997-dbe1ea7e2681",
                                        "entry_id": "d80d53ae-a39a-3552-96ef-029028acbc1d",
                                        "glosses": [
                                            "Free from danger; safe; secure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c75593-9f88-4de8-8bdd-9a15ca34b371",
                                                "sense_id": "7e587657-cc0a-3b11-a997-dbe1ea7e2681",
                                                "text": "Feare not: the Forreſt is not three leagues off, / If we recouer that, we are ſure enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a6e66be-9b41-3fdb-a0e2-234cb66ea1e4",
                                        "entry_id": "d80d53ae-a39a-3552-96ef-029028acbc1d",
                                        "glosses": [
                                            "Betrothed; engaged to marry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff749cf2-9547-4b66-b9f7-1fbae49d8ef2",
                                                "sense_id": "5a6e66be-9b41-3fdb-a0e2-234cb66ea1e4",
                                                "text": "c. 1513-1518 (probably date written, published after 1535) Thomas More, History of King Richard III\nThe king was sure to Dame Elizabeth Lucy, and her husband before God."
                                            },
                                            {
                                                "example_id": "269793fc-1aa3-4f43-9128-9fc676c59baf",
                                                "sense_id": "5a6e66be-9b41-3fdb-a0e2-234cb66ea1e4",
                                                "text": "I presum'd […] [that] you had been sure, as fast as faith could bind you, man and wife."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d2f8e1d-28ea-3179-8bed-9c1e7af01e5d",
                                        "entry_id": "2855f587-c14b-3eba-81a9-2f1d265865ff",
                                        "glosses": [
                                            "Without doubt, certainly."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395e165b-7126-419d-a2a4-6f26a1bc244f",
                                                "sense_id": "0d2f8e1d-28ea-3179-8bed-9c1e7af01e5d",
                                                "text": "Sure he's coming! Why wouldn't he?"
                                            },
                                            {
                                                "example_id": "74af318b-8721-4be3-b727-91afc1457ad5",
                                                "sense_id": "0d2f8e1d-28ea-3179-8bed-9c1e7af01e5d",
                                                "text": "\"Did you kill that bear yourself?\" ―\"I sure did!\""
                                            },
                                            {
                                                "example_id": "2c4caac9-e5f1-4f3f-ad35-e4e6c0e26a84",
                                                "sense_id": "0d2f8e1d-28ea-3179-8bed-9c1e7af01e5d",
                                                "text": "It sure is cold out"
                                            },
                                            {
                                                "example_id": "1507407a-05cb-422e-8d65-371cc0b9c2d3",
                                                "sense_id": "0d2f8e1d-28ea-3179-8bed-9c1e7af01e5d",
                                                "text": "These high and gusty relishes of life, sure,\nHave no allayings of mortality in them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5222e17c-bfce-33a0-8d56-faf6d10537c3",
                                        "entry_id": "2855f587-c14b-3eba-81a9-2f1d265865ff",
                                        "glosses": [
                                            "Without fail, surely."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e44ce46-a9db-4247-8df5-e04e40096155",
                                                "sense_id": "5222e17c-bfce-33a0-8d56-faf6d10537c3",
                                                "text": "Theſe are the wings ſhall make it flie as ſwift,\nAs dooth the lightening: or the breath of heauen,\nAnd kill as ſure as it ſwiftly flies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0f5469-8514-3714-8dbd-03dd02eeff4c",
                                        "entry_id": "b63702b9-f3e4-3c42-823f-92daa5126175",
                                        "glosses": [
                                            "Yes; of course."
                                        ],
                                        "tags": [
                                            "in response to a request for help or a favour"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5cb769-d07c-47bf-9434-cc246743fa16",
                                                "sense_id": "ed0f5469-8514-3714-8dbd-03dd02eeff4c",
                                                "text": "\"Could you tell me where the washrooms are?\" \"Sure, they're in the corner over there.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75770f7-6efa-3fcb-a072-ef660ab24d8d",
                                        "entry_id": "b63702b9-f3e4-3c42-823f-92daa5126175",
                                        "glosses": [
                                            "Yes; I guess; you could say that; a weak or noncommittal positive response."
                                        ],
                                        "tags": [
                                            "in response to other questions"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd70653a-97a9-42ff-bf54-dbca328f5347",
                                                "sense_id": "d75770f7-6efa-3fcb-a072-ef660ab24d8d",
                                                "text": "\"Do you like cats?\" \"Sure.\""
                                            },
                                            {
                                                "example_id": "ff4e36fc-bbfa-42c4-b14f-223e2e77baaf",
                                                "sense_id": "d75770f7-6efa-3fcb-a072-ef660ab24d8d",
                                                "text": "\"Do you want me to put this in the garage?\" \"Sure, go ahead.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255f7bb7-61c7-3c4c-9add-16704b99a8bc",
                                        "entry_id": "b63702b9-f3e4-3c42-823f-92daa5126175",
                                        "glosses": [
                                            "You're welcome; polite response to being thanked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5510596a-d9a9-46e6-9d78-b37c6d73c0b8",
                                                "sense_id": "255f7bb7-61c7-3c4c-9add-16704b99a8bc",
                                                "text": "\"Thanks for helping me with that electrical fault.\" \"Sure. Any time.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
