                    "frequency": "Middle",
                    "semantic_group_id": "aviation_cloud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airplane left a long white <w>contrail</w> across the clear blue sky."
                        },
                        {
                            "text": "We could see several <w>contrails</w> crisscrossing high above the mountains."
                        }
                    ],
                    "synonyms": [
                        "condensation trail",
                        "vapor trail"
                    ],
                    "common_phrases": [
                        "leave a contrail"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3794df4f-3e82-3434-8be5-61736142daa1",
                    "sense_definition": "To produce an artificial cloud of condensed water vapor while flying.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation_cloud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jet was <w>contrailing</w> heavily as it climbed into the freezing upper atmosphere."
                        },
                        {
                            "text": "At that high altitude, the aircraft began to <w>contrail</w> conspicuously."
                        }
                    ]
                }
