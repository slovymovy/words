            {
                "entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                "word": "glen",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a23b241c-a8a9-4dea-8d47-121f56ec3d37",
                        "entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "glens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                        "entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                        "glosses": [
                            "A secluded and narrow valley, especially one with a river running through it; a depression between hills; a dale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b43efb7-fe06-4f29-8f41-0bf7ab3b72c1",
                                "sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                                "text": "What riches too, of gold and jewels, might not be hidden among those forest-shrouded glens and peaks? And beyond, and beyond again, ever new islands, new continents perhaps, an inexhaustible wealth of yet undiscovered worlds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a836612d-9776-4f29-9556-e59f7f262455",
                        "source_entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                        "source_sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                        "source_sense_description": "secluded and narrow valley",
                        "target_lang_word": "dal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1de01b-0708-378e-af78-19aa997afa06",
                                        "entry_id": "31a07808-72de-374c-9bfb-850439443f0d",
                                        "glosses": [
                                            "een laagte in een heuvel- of bergstreek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df84f60-ed85-4c1e-aba0-90343c6ec3dc",
                                                "sense_id": "4e1de01b-0708-378e-af78-19aa997afa06",
                                                "text": "In een dal is er meer kans op overstromingen dan in hoger gelegen gebieden."
                                            },
                                            {
                                                "example_id": "54e8c637-e68f-4449-962a-727767170f78",
                                                "sense_id": "4e1de01b-0708-378e-af78-19aa997afa06",
                                                "text": "Toen Teresa zich omdraaide naar het huis, zag ze dat Sarah hen nakeek; ze bleef bij het raam staan tot ze in het dal waren en ze haar niet meer konden zien."
                                            },
                                            {
                                                "example_id": "1731faad-cc4d-43b4-a023-89cef7e359e3",
                                                "sense_id": "4e1de01b-0708-378e-af78-19aa997afa06",
                                                "text": "De hagen trekken donkere strepen over het landschap en beneden in het dal zijn mensen die door een weiland wandelen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2622b08f-28b8-3459-85eb-dc07675268b1",
                                        "entry_id": "09348fc5-db97-3cad-a812-20e82119b9a9",
                                        "glosses": [
                                            "een bepaald soort tegel"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "729b5723-034f-479d-bbd5-7d1f88555da7",
                        "source_entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                        "source_sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                        "source_sense_description": "secluded and narrow valley",
                        "target_lang_word": "vallei",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vallei",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                                        "entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
                                        "glosses": [
                                            "een laagte tussen bergen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5fbaacd-5601-4661-baeb-4b80ff14da85",
                                                "sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                                                "text": "In bergachtige gebieden wonen de meeste mensen in een vallei.'"
                                            },
                                            {
                                                "example_id": "d61e6af0-4d93-4e93-aeb8-e2ae5eb5f1ed",
                                                "sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                                                "text": "Het pad slingerde langs rotsige heuvels en uitgestrekte valleien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71a302c1-586d-444b-bbfc-2dff7f47e5c5",
                        "source_entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                        "source_sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                        "source_sense_description": "secluded and narrow valley",
                        "target_lang_word": "vallon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vallon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                        "entry_id": "deb2899e-f3f1-3b48-8aa3-ce7bc6fbf01f",
                                        "glosses": [
                                            "Petite vallée, espace de terre resserré entre deux coteaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1582d601-c67a-4c13-966b-a0fcf83ca7e9",
                                                "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                                "text": "Jusqu’après Valpuiseaux, sur plus d'une lieue, les groupes de fermes se suivent. Ensuite le vallon est solitaire, pli étroit et profond dont les côtés sont striés par une infinité de vaux très courts."
                                            },
                                            {
                                                "example_id": "6e4fa9b3-9d2f-430c-8597-f8ed216395f7",
                                                "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                                "text": "Vallon de Bouafles. — La craie marneuse est très développée dans les vallons qui viennent déboucher à Bouafles ; elle est très nettement visible en particulier, un peu en amont de Basse-Copette sur la route de Campneuseville et elle monte là extrêmement haut."
                                            },
                                            {
                                                "example_id": "90086749-c0b2-469f-8376-85aa01ef2d73",
                                                "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                                "text": "Dans cette partie de son cours, la Lanterne reçoit les eaux de nombreux ruisseaux ou « rus » provenant des vallons tourbeux voisins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80ec15c8-1150-4920-9ff3-ad2a382fdaef",
                        "source_entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                        "source_sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                        "source_sense_description": "secluded and narrow valley",
                        "target_lang_word": "Tobel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tobel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                                        "entry_id": "c0a56c2f-ad3a-326a-b612-5fee5e8db159",
                                        "glosses": [
                                            "enges Tal, tiefer Einschnitt im Gelände"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80496a3b-de76-4980-b2aa-486d969e5229",
                                                "sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                                                "text": "„Ein 46 Jahre alter Autofahrer ist am Jochpass bei Bad Hindelang im Oberallgäu mit seinem Auto in einen Abhang gestürzt und schwer verletzt worden. […] Das Auto überschlug sich mehrmals und blieb etwa 200 Meter von der Straße entfernt in dem Tobel auf dem Dach liegen.“"
                                            },
                                            {
                                                "example_id": "75ae14ed-8969-4fec-93fc-5c81c7eb3342",
                                                "sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                                                "text": "„Der Fussweg durchs Tobel ist erst wieder durchgehend begehbar, wenn sicher ist, dass nicht weiteres Gestein in die Tiefe zu stürzen droht […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
