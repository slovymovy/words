                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "действие по глаголу нарушить"
                            },
                            {
                                "target_lang_word": "ущемление",
                                "target_lang_sense_clarification": "нарушение чьих-либо прав или достоинства"
                            }
                        ]
                    }
                }
            ]
        }
