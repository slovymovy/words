                ],
                "senses": [
                    {
                        "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                        "entry_id": "54b36f3c-9b33-39b1-ae4c-df1e5978c457",
                        "glosses": [
                            "kleiner Schreibblock aus Papier, der zum Aufschreiben von Notizen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19eb9ee0-9ecf-4576-8834-ba85e74db939",
                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                "text": "Vielleicht haben Sie jedoch auch einen ganz anderen Spieler auf Ihrem Notizblock, wenn es darum geht, den besten Akteur der FIFA Klub-WM 2009 zu suchen."
                            },
                            {
                                "example_id": "92cdc9ae-f314-4d11-bfe2-23b86e150aa2",
                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                "text": "„Der Notizblock lag bereits geöffnet auf dem Tisch.“"
                            },
                            {
                                "example_id": "77cef619-ff62-46c6-b323-765f9ada1c8c",
                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                "text": "„Mit Notizblock und Stift begaben sie die 15- und 16-Jährigen auf dem Schulhof, in der U-Bahn oder in den Straßen von Berlin-Kreuzberg auf die Suche nach Wörtern, die typisch für Kiezdeutsch sind.“"
                            },
                            {
                                "example_id": "60cbc45e-094f-4644-809f-ae2fad79d88b",
                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                "text": "„Ich habe dann auch meinen Notizblock aus dem Rucksack geholt und die gerade gelesenen Fremdworte aufgeschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3934d1f2-b76d-46f9-a98d-e3177fc1c499",
                        "source_entry_id": "54b36f3c-9b33-39b1-ae4c-df1e5978c457",
                        "source_sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
