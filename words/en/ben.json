            "senses": [
                {
                    "sense_id": "0cf51d42-595f-3a8b-a084-1df447bbdb47",
                    "sense_definition": "A short form of the male given names <w>Benjamin</w> or <w>Benedict</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Ben</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "ru": "<w>Бен</w> приедет навестить нас в эти выходные.",
                                "zh": "<w>本</w>这个周末要来看我们。"
                            }
                        },
                        {
                            "text": "I asked <w>Ben</w> if he wanted to join our football team.",
                            "target_lang_translations": {
                                "ru": "Я спросил <w>Бена</w>, хочет ли он присоединиться к нашей футбольной команде.",
                                "zh": "我问<w>本</w>想不想加入我们的足球队。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая форма мужских имен Бенджамин или Бенедикт.",
                        "zh": "男性名字本杰明或本尼迪克特的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бен",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本",
                                "target_lang_sense_clarification": "男性名字"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec156012-1881-38bb-b586-b6640eed49f8",
                    "sense_definition": "A mountain or high peak, used especially in names of mountains in Scotland and Ireland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to climb the <w>ben</w> early in the morning to catch the sunrise.",
                            "target_lang_translations": {
                                "ru": "Мы решили подняться на <w>гору</w> рано утром, чтобы застать рассвет.",
                                "zh": "我们决定清晨去爬那座<w>山</w>，为了看日出。"
                            }
                        },
                        {
                            "text": "Snow can still be seen on the top of the <w>ben</w> even in late spring.",
                            "target_lang_translations": {
                                "ru": "Снег всё ещё можно увидеть на вершине <w>горы</w> даже поздней весной.",
                                "zh": "即使在暮春时节，依然能看到那座<w>山峰</w>顶上有积雪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Ben Nevis"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland, Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гора или высокий пик (используется преимущественно в названиях гор в Шотландии и Ирландии).",
                        "zh": "山峰或高山，常用于苏格兰和爱尔兰的地名中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гора",
                                "target_lang_sense_clarification": "в Шотландии и Ирландии"
                            },
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "горная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山",
                                "target_lang_sense_clarification": "苏格兰或爱尔兰语境下的山峰"
                            },
                            {
                                "target_lang_word": "山峰",
                                "target_lang_sense_clarification": "高山"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3c03328-4e72-3a0b-a298-3217b0ef4cf8",
                    "sense_definition": "A US one hundred dollar bill.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled a few <w>bens</w> out of his wallet to pay for the expensive dinner.",
                            "target_lang_translations": {
                                "ru": "Он вытащил несколько <w>стодолларовых купюр</w> из бумажника, чтобы расплатиться за дорогой ужин.",
                                "zh": "他从钱包里掏出几张<w>百元美钞</w>来支付昂贵的晚餐。"
                            }
                        },
                        {
                            "text": "It is rare to see people paying with <w>bens</w> at a grocery store.",
                            "target_lang_translations": {
                                "ru": "Редко можно увидеть людей, расплачивающихся <w>стодолларовыми купюрами</w> в продуктовом магазине.",
                                "zh": "在杂货店很少见到有人用<w>百元美钞</w>付款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Benjamin"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стодолларовая купюра США.",
                        "zh": "美国一百美元面值的纸币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стодолларовая купюра",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "«Бенджамин»",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "百元美钞",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20ce6ef3-145f-3afe-8d74-6362fa74993c",
                    "sense_definition": "A tree, <w>Moringa</w> <w>oleifera</w>, also known as the horseradish tree, or the oil obtained from its seeds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seeds of the <w>ben</w> tree are used to produce a clear, odorless oil.",
                            "target_lang_translations": {
                                "ru": "Семена дерева <w>моринга</w> используются для производства прозрачного масла без запаха.",
                                "zh": "<w>辣木</w>树的种子被用来生产一种透明无味的油。"
                            }
                        },
                        {
                            "text": "Oil of <w>ben</w> has been used in perfumes and cosmetics for centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Беновое</w> масло веками использовалось в парфюмерии и косметике.",
                                "zh": "<w>辣木</w>油几个世纪以来一直被用于香水和化妆品中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moringa",
                        "horseradish tree",
                        "drumstick tree"
                    ],
                    "common_phrases": [
                        "oil of ben"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерево Моринга масличная или масло, получаемое из его семян.",
                        "zh": "辣木树，或从其种子中提取的油。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моринга",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "беновое дерево",
                                "target_lang_sense_clarification": "ботаника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辣木",
                                "target_lang_sense_clarification": "植物名称"
