                ],
                "senses": [
                    {
                        "sense_id": "9bba1695-c4ac-3dda-8897-91627a5b998b",
                        "entry_id": "2e0cd500-0cab-3011-b859-6fd2913c35c6",
                        "glosses": [
                            "Miracle économique, croissance économique forte et inattendue dans une région particulière."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "21adc245-c22b-4691-982d-77a9313952a1",
                                "sense_id": "9bba1695-c4ac-3dda-8897-91627a5b998b",
                                "text": "Bald zeigte sich, dass das chinesische Wirtschaftswunder doch nicht am Ende war.",
                                "translation": "Il est vite apparu que le miracle économique chinois n'était pas terminé."
                            },
                            {
                                "example_id": "0a81cad1-5099-40d5-8624-bc6103d79af7",
                                "sense_id": "9bba1695-c4ac-3dda-8897-91627a5b998b",
                                "text": "Zusammengenommen ergeben all diese Faktoren eine Gemengelage, die manche schon von einem Ende des chinesischen Wirtschaftswunders sprechen lassen, vom \"Peak China\", einem überschrittenen Gipfel, dem nun der Abstieg folgen muss.",
                                "translation": "Tous ces facteurs réunis créent une situation confuse qui fait que certains parlent déjà de la fin du miracle économique chinois, du « Peak China », un sommet dépassé qui doit maintenant être suivi d’un déclin."
                            }
                        ]
                    }
                ],
