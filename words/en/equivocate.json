{
    "word_family": [
        "equivocation",
        "equivocal",
        "equivocator",
        "unequivocal",
        "equivocally",
        "unequivocally"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ab3affe-69dc-330b-a8b4-321dca791101",
                    "sense_definition": "To speak ambiguously or use double meanings, especially in order to mislead or avoid telling the truth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speaking_ambiguously",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked directly about the missing funds, the politician chose to <w>equivocate</w> rather than give a clear answer."
                        },
                        {
                            "text": "Please stop <w>equivocating</w> and tell us whether you support the proposal or not."
                        }
                    ],
                    "synonyms": [
                        "prevaricate",
                        "evade"
                    ],
                    "common_phrases": [
                        "equivocate on the issue"
                    ]
                },
                {
                    "sense_id": "7f541c72-78d9-3da4-aa55-7b289ec90c15",
                    "sense_definition": "To make something ambiguous or equivocal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speaking_ambiguously",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat deliberately <w>equivocated</w> the terms of the treaty to delay signing it."
                        },
                        {
                            "text": "He managed to <w>equivocate</w> his earlier promises by adding several vague conditions."
                        }
                    ]
                }
            ]
        }
    ]
}