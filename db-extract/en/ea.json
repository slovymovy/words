                "senses": [
                    {
                        "sense_id": "1b8fb90f-f857-3b17-bbb8-8a49d1b920fe",
                        "entry_id": "a432052c-47d6-338d-a995-f23a4a8e1f20",
                        "glosses": [
                            "The name of Enki in Akkadian and Babylonian mythology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f0f777-cdf4-40b7-9db9-c99f92d8a9c5",
                                "sense_id": "1b8fb90f-f857-3b17-bbb8-8a49d1b920fe",
                                "text": "The Chaldeans had great faith in Ea, their god of healing, to whom prayers were said in case of sickness, but herb remedies were also given the patient by the god's representative in the community."
                            }
                        ]
                    }
                ],
