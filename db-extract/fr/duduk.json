                "senses": [
                    {
                        "sense_id": "2ef93d88-e9e9-3519-8f55-90124d6794df",
                        "entry_id": "4c858fd4-448f-38e0-98ae-6076665415e7",
                        "glosses": [
                            "Instrument de musique arménien, à anche double comme le hautbois que l’on retrouve dans quelques pays du Caucase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ccc58e-b36f-469d-af99-19a94cd01370",
                                "sense_id": "2ef93d88-e9e9-3519-8f55-90124d6794df",
                                "text": "Le son nostalgique du duduk a traversé les rideaux de pluie, déjoué les volutes du vent et vibrait encore aux oreilles, alors qu’il s’était déjà tu."
                            },
                            {
                                "example_id": "b6a6c73a-3357-45dc-a4b1-64639fafa51f",
                                "sense_id": "2ef93d88-e9e9-3519-8f55-90124d6794df",
                                "text": "Il ouvrit l’étui et en sortit un instrument en bois qui ressemblait à une flûte.\n- C’est un duduk d’Arménie. Tu connais ? me demanda-t-il avec un sourire radieux."
                            },
                            {
                                "example_id": "8b43c594-e216-4faf-80da-f74e773c6529",
                                "sense_id": "2ef93d88-e9e9-3519-8f55-90124d6794df",
                                "text": "J’eus néanmoins un sombre pressentiment quand, le premier jour de la traversée, frère Eustache m’arracha des mains mon duduk alors que je jouais un air pour François d’Assise."
                            }
                        ]
                    }
                ],
