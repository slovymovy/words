    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "46acfb29-9643-3075-8eea-f4cfd800f7e1",
                "word": "monotonic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a8c84868-98f8-3871-9ada-2c8d28670f2b",
                        "entry_id": "46acfb29-9643-3075-8eea-f4cfd800f7e1",
                        "glosses": [
                            "Of or using the Greek system of diacritics which discards the breathings and employs a single accent to indicate stress. It replaced polytonic system in 1982."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8bc55288-0cca-3265-9f97-96062a53b6b2",
                        "entry_id": "46acfb29-9643-3075-8eea-f4cfd800f7e1",
                        "glosses": [
                            "Of a function: that either never decreases or never increases as its independent variable increases."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "573beca4-cbb8-3b0a-8f68-bd10e3981afe",
                        "entry_id": "46acfb29-9643-3075-8eea-f4cfd800f7e1",
                        "glosses": [
                            "Uttered in a monotone; monotonous."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "291a7afa-8357-4d4b-9020-5e99b530084f",
                                "sense_id": "573beca4-cbb8-3b0a-8f68-bd10e3981afe",
                                "text": "The Same Spade talk-alike, super-cynical heroine of the piece is named Emma Victor, and there's no end to her rapid-fire, monotonic, street-smart patter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c0114ce-d789-41a0-8b9d-451eaeeb7e86",
                        "source_entry_id": "46acfb29-9643-3075-8eea-f4cfd800f7e1",
                        "source_sense_description": "mathematics: never decreasing or increasing as its independent variable increases",
                        "target_lang_word": "monotone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b473e2-bf24-3b7e-bad6-99b1b53257b5",
                                        "entry_id": "21e34591-63de-3f89-9c30-60fa2eb85c5c",
                                        "glosses": [
                                            "Qui est toujours sur le même ton, qui n’est pas varié dans ses intonations ou dans ses inflexions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc700b3-e961-4aaa-8ecb-ff2d8e178656",
                                                "sense_id": "e4b473e2-bf24-3b7e-bad6-99b1b53257b5",
                                                "text": "Les cris des coqs, les sabots des ânes poussés par l’encouragement sonore et monotone des paysans, réveillèrent Elhamy le lendemain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312e1a71-ba45-3e41-adfa-475f503f44eb",
                                        "entry_id": "21e34591-63de-3f89-9c30-60fa2eb85c5c",
                                        "glosses": [
                                            "Qualifie un orateur dont le débit n’est pas varié."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66529ff2-dec3-3b83-b890-0c4a8ce93421",
                                        "entry_id": "21e34591-63de-3f89-9c30-60fa2eb85c5c",
                                        "glosses": [
                                            "Qualifie des choses qui sont uniformes, qui manquent de variété."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857997d1-c781-4b45-be20-ce4d661cbe7e",
                                                "sense_id": "66529ff2-dec3-3b83-b890-0c4a8ce93421",
                                                "text": "La région que nous parcourons est une vaste plaine monotone, sans arbres et presque sans reliefs, qui s’élève insensiblement à fur et à mesure que nous avançons."
                                            },
                                            {
                                                "example_id": "8d7966e9-f3d3-4859-b87b-3ffe02737d62",
                                                "sense_id": "66529ff2-dec3-3b83-b890-0c4a8ce93421",
                                                "text": "A la même époque, Malcolm Flemyng, médecin à Édimbourg, recommande lui aussi, en 1760, de manger avec frugalité, de préférence une alimentation monotone, riche en légumes, racines et verdure, mais sans adjonction de beurre, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad22b3c-a71b-3eca-9295-f151b3040c41",
                                        "entry_id": "21e34591-63de-3f89-9c30-60fa2eb85c5c",
                                        "glosses": [
                                            "Qualifie une fonction à une seule variable, continue et uniquement croissante ou décroissante dans un intervalle donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09aa411f-89da-4899-905e-c06fc0b53e86",
                                                "sense_id": "0ad22b3c-a71b-3eca-9295-f151b3040c41",
                                                "text": "Une fonction continue et strictement monotone sur [a, b] est inversible."
                                            },
                                            {
                                                "example_id": "dccd7c68-8619-4ec9-82b1-aed55e1301c1",
                                                "sense_id": "0ad22b3c-a71b-3eca-9295-f151b3040c41",
                                                "text": "L’inégalité T > 0 provient de l’hypothèse de croissance monotone de l’entropie avec l’énergie interne (Callen, 1985)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
