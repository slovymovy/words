                        "cross_references": [
                            {
                                "target_word": "pagination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea308b38-78ff-3371-86e1-1c0e5d89b97b",
                                        "entry_id": "0040ee1b-8a79-391e-b7ce-b3e9126b096c",
                                        "glosses": [
                                            "Action ou manière de paginer, numérotation des pages."
                                        ],
                                        "tags": [
                                            "Imprimerie",
                                            "Livre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77f1aac-2810-466e-9aae-68dd606d836e",
                                                "sense_id": "ea308b38-78ff-3371-86e1-1c0e5d89b97b",
                                                "text": "En mars 1978 apparaissait chez les libraires le premier reprint qui, s’il livrait enfin à de nombreux chercheurs le texte intégral, n’en respectait ni la pagination, ni le format."
                                            },
                                            {
                                                "example_id": "2df87d12-1a7b-4c1f-825a-e1e763937c2a",
                                                "sense_id": "ea308b38-78ff-3371-86e1-1c0e5d89b97b",
                                                "text": "La pagination de ce livre commence au titre."
                                            },
                                            {
                                                "example_id": "c62c9537-b4be-4d82-a1f0-6c1f840455b8",
                                                "sense_id": "ea308b38-78ff-3371-86e1-1c0e5d89b97b",
                                                "text": "La pagination de la préface est en chiffres romains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbed5c1d-ec45-3114-9167-d0c979c996a5",
                                        "entry_id": "0040ee1b-8a79-391e-b7ce-b3e9126b096c",
                                        "glosses": [
                                            "Nombre de pages d’un ouvrage imprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12a148e-b62e-40df-a738-e8dda509875f",
                                                "sense_id": "cbed5c1d-ec45-3114-9167-d0c979c996a5",
                                                "text": "Très attendu par les annonceurs, le premier numéro de ELLE Canada contient 140 pages de publicité pour une pagination totale de 276 pages. Le nouveau mensuel prévoit une diffusion garantie de 100 000 exemplaires."
                                            },
                                            {
                                                "example_id": "a64bb5f6-91c1-4ff1-8cd8-b36f71c2d50d",
                                                "sense_id": "cbed5c1d-ec45-3114-9167-d0c979c996a5",
                                                "text": "Notre dernière édition bat les records avec une pagination de 80 pages !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0262c8f4-30c7-3c90-bbc1-363de4406509",
                                        "entry_id": "0040ee1b-8a79-391e-b7ce-b3e9126b096c",
                                        "glosses": [
                                            "Technique, utilisée sur les ordinateurs, pour découper les espaces d’adressage de la mémoire vive en zones égales (pages) afin de les sauvegarder dans la mémoire virtuelle et de les restaurer en mémoire vive en fonction des besoins du système d’exploitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654de6c7-bb34-409c-9fdb-68cc53c03273",
                                                "sense_id": "0262c8f4-30c7-3c90-bbc1-363de4406509",
                                                "text": "Dans les OS Windows ou Linux, on trouve les mécanismes de pagination de mémoire qui est le socle de la mémoire virtuelle. Celle-ci permet de dépasser la taille de la mémoire RAM et physique en simulant de la mémoire virtuelle mais aussi permettre de partager des zones mémoires entre processus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
