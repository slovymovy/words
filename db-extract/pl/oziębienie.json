                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c26e8c7-a6a3-42db-96d7-ddf852a3b8d2",
                                                "sense_id": "2bf2eeb1-3208-31db-9d53-3819fe7082ea",
                                                "text": "Für die Abkühlung der Lebensmittel sind die Kühlschränke gut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6ab5cc10-09e3-37a1-80d5-ad3b36c68d5a",
