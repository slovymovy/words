                    "sense_definition": "Something that is certain to happen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the championship is not a <w>cinch</w> yet.",
                            "target_lang_translations": {
                                "cs": "Vyhrát šampionát ještě není žádná <w>jistota</w>."
                            }
                        },
                        {
                            "text": "It is a <w>cinch</w> that they will arrive on time.",
                            "target_lang_translations": {
                                "cs": "Je <w>tutovka</w>, že dorazí včas."
                            }
