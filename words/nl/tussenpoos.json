{
    "word_family": [
        "tussen",
        "poos"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12457175-6ecf-36e8-bf88-c5b03fe2b797",
                    "sense_definition": "Een periode van tijd tussen twee gebeurtenissen of handelingen in.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De treinen rijden vandaag met een <w>tussenpoos</w> van een kwartier.",
                            "target_lang_translations": {
                                "en": "Today, the trains are running at <w>intervals</w> of fifteen minutes."
                            }
                        },
                        {
                            "text": "Na een korte <w>tussenpoos</w> ging de vergadering weer verder.",
                            "target_lang_translations": {
                                "en": "After a short <w>interval</w>, the meeting resumed."
                            }
                        }
                    ],
                    "synonyms": [
                        "pauze",
                        "onderbreking",
                        "tussentijd",
                        "interval"
                    ],
                    "common_phrases": [
                        "met een tussenpoos"
                    ],
                    "target_lang_definitions": {
                        "en": "A period of time between two events or actions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interval",
                                "target_lang_sense_clarification": "time between events"
                            },
                            {
                                "target_lang_word": "gap",
                                "target_lang_sense_clarification": "a temporary pause or space in time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25ff9a08-7934-3f0e-932d-3c9ec126c247",
                    "sense_definition": "Korte onderbrekingen in een doorlopende activiteit of proces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De camera registreert dezelfde scène met een <w>tussenpoos</w> van enkele seconden.",
                            "target_lang_translations": {
                                "en": "The camera records the same scene with an <w>interval</w> of a few seconds."
                            }
                        },
                        {
                            "text": "Hij werkte urenlang door met slechts een enkele korte <w>tussenpoos</w>.",
                            "target_lang_translations": {
                                "en": "He worked for hours with only a single short <w>break</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderbreking",
                        "pauze",
                        "break"
                    ],
                    "common_phrases": [
                        "korte tussenpozen"
                    ],
                    "target_lang_definitions": {
                        "en": "Short interruptions in a continuous activity or process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "a pause in work or activity"
                            },
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "a temporary stop in action"
                            },
                            {
                                "target_lang_word": "recess",
                                "target_lang_sense_clarification": "a temporary stoppage of an activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d24df05-b8db-3916-a23a-2724ca753860",
                    "sense_definition": "Niet constant, maar met onderbrekingen; zo nu en dan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het regende de hele middag bij <w>tussenpozen</w>.",
                            "target_lang_translations": {
                                "en": "It rained all afternoon <w>at intervals</w>."
                            }
                        },
                        {
                            "text": "Hij hoorde bij <w>tussenpozen</w> een vreemd geluid op de zolder.",
                            "target_lang_translations": {
                                "en": "He heard a strange noise in the attic <w>intermittently</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bij tussenpozen"
                    ],
                    "target_lang_definitions": {
                        "en": "Not constant, but with interruptions; from time to time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at intervals",
                                "target_lang_sense_clarification": "occurring from time to time"
                            },
                            {
                                "target_lang_word": "intermittently",
                                "target_lang_sense_clarification": "with pauses in between"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f56075-db93-3361-9458-9589721e2ab3",
                    "sense_definition": "Zonder enige onderbreking; aan één stuk door.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De machines in de fabriek draaien dag en nacht zonder <w>tussenpozen</w>.",
                            "target_lang_translations": {
                                "en": "The machines in the factory run day and night <w>without interruption</w>."
                            }
                        },
                        {
                            "text": "Zij studeerde urenlang zonder <w>tussenpozen</w> om zich voor te bereiden op het examen.",
                            "target_lang_translations": {
                                "en": "She studied for hours <w>without a break</w> to prepare for the exam."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zonder tussenpozen"
                    ],
                    "target_lang_definitions": {
                        "en": "Without any interruption; continuously."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "without interruption",
                                "target_lang_sense_clarification": "continuously"
                            },
                            {
                                "target_lang_word": "without a break",
                                "target_lang_sense_clarification": "non-stop"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}