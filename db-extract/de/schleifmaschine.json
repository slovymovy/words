                ],
                "senses": [
                    {
                        "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                        "entry_id": "fd386d07-02b9-30a5-8137-7efb9842405d",
                        "glosses": [
                            "Elektrowerkzeug, typischerweise mit zwei sich drehenden Schleifscheiben, das zum Schleifen, Glätten und Formen von Materialien, normalerweise Metall, verwendet wird und für die dauerhafte Montage auf einer Werkbank ausgelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca486eb-be8b-41e4-8e71-d4b2752646c7",
                                "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                "text": "„Binnen kürzester Zeit habe ich die Schleifmaschine angeschlossen und eingeschaltet.“"
                            },
                            {
                                "example_id": "8b63e141-9827-4e6a-a824-0dc9c44eafe5",
                                "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                "text": "„Ein junger Mann sagte, ein Schmirgel reiche nicht aus, man müsse eine Schleifmaschine verwenden.“"
                            },
                            {
                                "example_id": "23581fca-0cc1-4a89-9833-41e11baad802",
                                "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                "text": "„Wenn eine neue Schleifscheibe auf die Schleifmaschine gebracht worden ist, so muß darauf geachtet werden, daß die Schutzhaube wieder richtig angebracht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
