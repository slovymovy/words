            {
                "entry_id": "a4b2341f-8960-337d-ac82-4a3c931ef804",
                "word": "honds",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c6d20749-0360-3f47-92b7-b469cc7cf64f",
                        "entry_id": "a4b2341f-8960-337d-ac82-4a3c931ef804",
                        "glosses": [
                            "de taal die honden spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36277379-196f-4bcc-921f-423226f61d4f",
                                "sense_id": "c6d20749-0360-3f47-92b7-b469cc7cf64f",
                                "text": "Onze commandanten kunnen om een tactische luchtaanval in het zuiden van Afghanistan vragen en hun piloten weten precies wat ze dan moeten doen. Maar test een Fiat Punto 'vijfdeurs' op de rondweg en je kunt net zo goed honds spreken."
                            },
                            {
                                "example_id": "3550f3a2-8211-4afa-a29f-26934d2d5c50",
                                "sense_id": "c6d20749-0360-3f47-92b7-b469cc7cf64f",
                                "text": "Spreek jij honds?"
                            },
                            {
                                "example_id": "ae7998b8-03d2-4fa4-8c6a-963eee42b4d0",
                                "sense_id": "c6d20749-0360-3f47-92b7-b469cc7cf64f",
                                "text": "Is 'waf' honds voor 'yo'?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "61be3425-8d14-3a9a-bcfe-3ece283409c7",
                "word": "Honds",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e3026fdc-c161-3455-83b3-08830870d743",
                        "entry_id": "61be3425-8d14-3a9a-bcfe-3ece283409c7",
                        "glosses": [
                            "de taal die honden spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b0fe61-4e71-4256-bbb9-2d0f75ede5aa",
                                "sense_id": "e3026fdc-c161-3455-83b3-08830870d743",
                                "text": "'Spreek jij Honds?' fluisterde Jill, naar hem overleunend. 'Duits. Deze honden zijn geïmporteerd uit Duitsland, waar ze ook oorspronkelijk getraind zijn. Het bleek gemakkelijker om de agenten te hertrainen dan de honden. Daarbij kan de gemiddelde burger door de Duitse commando's de honden geen bevelen geven."
                            },
                            {
                                "example_id": "c48701ff-d334-42c6-a5c3-fb4e623813d1",
                                "sense_id": "e3026fdc-c161-3455-83b3-08830870d743",
                                "text": "'John Daga spreekt Honds.' 'Watte?' 'John Daga spreekt Honds. Hij spreekt Kats, Rats en Honds. En mensentaal natuurlijk."
                            }
                        ]
                    }
                ],
