    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6402a729-d29e-336c-a781-311b4a04f6cd",
                    "sense_definition": "Guidance, teaching, or instruction, especially by an expert or mentor.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under the <w>tutelage</w> of a renowned chef, she mastered the art of pastry making."
                        },
                        {
                            "text": "His piano technique improved dramatically during his years under private <w>tutelage</w>."
                        }
                    ],
                    "synonyms": [
                        "tutorage",
                        "tutorship"
                    ],
                    "common_phrases": [
                        "under the tutelage of"
                    ]
                },
                {
                    "sense_id": "4f18dd90-1470-3abc-b7eb-7307e1d9035c",
                    "sense_definition": "The act of guarding, protecting, or exercising authority over another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fledgling state remained under the military <w>tutelage</w> of its allied neighbors."
                        },
                        {
                            "text": "Throughout the medieval period, the monastery remained under the protective <w>tutelage</w> of the king."
                        }
                    ],
                    "synonyms": [
                        "guardianship",
                        "protection"
                    ]
                },
                {
                    "sense_id": "2d508ec2-d73e-3031-a0b6-27ca91836c59",
                    "sense_definition": "The condition or state of being under the care, protection, or custody of a guardian.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young heir could not control his estate while he was still in legal <w>tutelage</w>."
                        },
                        {
                            "text": "Upon reaching the age of majority, she was finally released from parental <w>tutelage</w>."
                        }
                    ],
                    "synonyms": [
                        "guardianship"
                    ]
                }
            ]
        }
    ]
}