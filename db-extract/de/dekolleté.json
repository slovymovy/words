                ],
                "senses": [
                    {
                        "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                        "entry_id": "21aea343-b511-35e2-8185-4fb6a59a9b08",
                        "glosses": [
                            "Halsausschnitt von Blusen, Kleidern et cetera bei der Damenoberbekleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2952e26-4281-4088-b2ef-75786380ebdd",
                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                "text": "„Die Sonne scheint senkrecht durch das Schiebedach, legt sich auf ihre Schultern und kitzelt ihr Dekolleté.“"
                            },
                            {
                                "example_id": "e1c0a3b7-7277-461a-918a-6db538b93e22",
                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                "text": "„Man sieht sofort auf ihr Dekolleté.“"
                            },
                            {
                                "example_id": "590a6f5f-36d7-4aed-bb06-5b5258900b61",
                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                "text": "„Wir können gar nicht anders, als auf ihr tiefausgeschnittenes Dekolleté und ihre nach oben und zur Mitte geschobene Brust zu sehen.“"
                            },
                            {
                                "example_id": "2b13f13c-aa6f-486c-be9c-8de97a566c36",
                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                "text": "„Sie stellte das Tablett ab, beugte sich zu Grenfeld herunter und gewährte ihm einen unerwarteten Blick in ihr Dekolleté.“"
                            },
                            {
                                "example_id": "a1f6a612-802f-45e1-b53e-3a26ffb45a74",
                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                "text": "„Als er seinen Blick auf ihr Dekolleté richtete, zog sie ihr Cape enger um die Schultern und rückte etwas von ihm weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
