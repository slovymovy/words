                    "semantic_group_id": "temporal_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Koche du ruhig das Abendessen, ich lese <w>solange</w> ein Buch.",
                            "target_lang_translations": {
                                "en": "Go ahead and cook dinner; I will read a book <w>in the meantime</w>.",
                                "ru": "Спокойно готовь ужин, а я <w>пока</w> почитаю книгу.",
                                "nl": "Kook jij maar rustig het avondeten, ik lees <w>ondertussen</w> een boek.",
                                "pl": "Gotuj spokojnie kolację, ja <w>w tym czasie</w> poczytam książkę.",
                                "fr": "Prépare tranquillement le dîner, je vais lire un livre <w>en attendant</w>.",
                                "it": "Tu prepara pure la cena, io <w>nel frattempo</w> leggo un libro.",
                                "cs": "Klidně uvař večeři, já si <w>zatím</w> budu číst knihu.",
                                "tr": "Sen rahatça akşam yemeğini pişir, ben <w>bu arada</w> bir kitap okurum.",
                                "es": "Tú prepara la cena con calma, yo leeré un libro <w>mientras tanto</w>.",
                                "zh": "你安心做晚饭吧，我<w>先</w>看会儿书。"
                            }
                        },
                        {
                            "text": "Der Zug hat Verspätung, also trinken wir <w>solange</w> einen Kaffee.",
                            "target_lang_translations": {
                                "en": "The train is delayed, so we will drink a coffee <w>in the meantime</w>.",
                                "ru": "Поезд задерживается, так что мы <w>пока</w> выпьем кофе.",
                                "nl": "De trein heeft vertraging, dus we drinken <w>in de tussentijd</w> een koffie.",
                                "pl": "Pociąg ma opóźnienie, więc napijmy się <w>tymczasem</w> kawy.",
                                "fr": "Le train a du retard, nous allons donc boire un café <w>en attendant</w>.",
                                "it": "Il treno è in ritardo, quindi <w>intanto</w> beviamo un caffè.",
                                "cs": "Vlak má zpoždění, takže si <w>zatím</w> dáme kávu.",
                                "tr": "Tren gecikmeli, bu yüzden biz de <w>o zamana kadar</w> bir kahve içelim.",
                                "es": "El tren tiene retraso, así que tomamos un café <w>mientras tanto</w>.",
                                "zh": "火车晚点了，所以我们<w>先</w>去喝杯咖啡吧。"
                            }
                        }
