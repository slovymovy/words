                    },
                    {
                        "translation_id": "cbaee1ac-da55-41e3-bbc9-a13e9e79ff4a",
                        "source_entry_id": "f7b11c60-8d39-35b4-9d83-a6e76c211cad",
                        "source_sense_id": "d81bbce5-f283-31ae-a127-952179193cd8",
