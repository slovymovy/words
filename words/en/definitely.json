                },
                {
                    "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                    "sense_definition": "In a definite manner; decisively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager spoke <w>definitely</w> about the new rules, leaving no room for argument.",
                            "target_lang_translations": {
                                "ru": "Менеджер высказался о новых правилах <w>определённо</w>, не оставив места для возражений.",
                                "zh": "经理<w>明确地</w>谈到了新规定，没有留下任何争论的余地。"
                            }
                        },
                        {
                            "text": "She turned <w>definitely</w> towards the door and walked out of the room.",
                            "target_lang_translations": {
                                "ru": "Она <w>решительно</w> повернулась к двери и вышла из комнаты.",
                                "zh": "她<w>果断地</w>转身朝门口走去，离开了房间。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чётко, ясно или решительно.",
                        "zh": "以明确、果断的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решительно",
                                "target_lang_sense_clarification": "твёрдо, без колебаний"
                            },
                            {
                                "target_lang_word": "определённо",
                                "target_lang_sense_clarification": "ясно, точно, недвусмысленно"
                            },
                            {
                                "target_lang_word": "чётко",
                                "target_lang_sense_clarification": "ясно и понятно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果断地",
                                "target_lang_sense_clarification": "形容态度坚决"
                            },
                            {
                                "target_lang_word": "明确地",
                                "target_lang_sense_clarification": "形容表达清晰、不含糊"
                            }
