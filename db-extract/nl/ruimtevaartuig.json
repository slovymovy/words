                                "sense_id": "e1f626ce-4b8d-3227-ae3a-13de55a2f196",
                                "text": "Het ruimtevaartuig landde veilig op Mars.",
                                "translation": "The spacecraft landed safely on Mars.",
                                "english": "The spacecraft landed safely on Mars."
                            },
                            {
                                "example_id": "245396fc-49a9-4fc6-9d31-69e81e95e658",
                                "sense_id": "e1f626ce-4b8d-3227-ae3a-13de55a2f196",
                                "text": "Ze zijn van plan een nieuw ruimtevaartuig te lanceren volgende maand.",
                                "translation": "They plan to launch a new spacecraft next month.",
                                "english": "They plan to launch a new spacecraft next month."
                            },
                            {
                                "example_id": "67daded2-df8b-49e7-8f73-303a228786b9",
                                "sense_id": "e1f626ce-4b8d-3227-ae3a-13de55a2f196",
                                "text": "Het kleine ruimtevaartuigje was bedoeld voor korte missies.",
                                "translation": "The small spacecraft was intended for short missions.",
                                "english": "The small spacecraft was intended for short missions."
                            }
                        ]
