                "senses": [
                    {
                        "sense_id": "33adafaa-e906-3f94-871f-a5121915c3f6",
                        "entry_id": "eda126ac-d43a-35f9-9d0c-a27971601c13",
                        "glosses": [
                            "napój o małej zawartości esencji; słaba kawa"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0344a967-72a2-4695-9c7e-2b6700f1e905",
                                "sense_id": "33adafaa-e906-3f94-871f-a5121915c3f6",
                                "text": "Co to za lura!? Kawa powinna być czarna, mocna, ostra i aromatyczna. Zrób mi drugą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5c77baab-8f34-3bdf-af06-99b974f9668b",
                        "entry_id": "eda126ac-d43a-35f9-9d0c-a27971601c13",
                        "glosses": [
                            "wodnista niesmaczna zupa"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3ab77ad2-b74c-3653-8976-636d1015878d",
                        "entry_id": "eda126ac-d43a-35f9-9d0c-a27971601c13",
                        "glosses": [
                            "przestępcze herbata"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da683b07-24b3-46fd-9db9-b70ca62cfd96",
                        "source_entry_id": "eda126ac-d43a-35f9-9d0c-a27971601c13",
                        "source_sense_id": "33adafaa-e906-3f94-871f-a5121915c3f6",
                        "target_lang_word": "бурда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бурда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "249337a4-f7bb-32c3-8403-abb3c999dbda",
                                        "entry_id": "245a9929-d9dd-3d93-834c-b2ba3faf5480",
                                        "glosses": [
                                            "разг. мутная жидкость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee2461a-8759-4b18-aa8a-2dee0915cfa7",
                                                "sense_id": "249337a4-f7bb-32c3-8403-abb3c999dbda",
                                                "text": "Когда я спросил воды, мне вылили из бамбука … такую грязную бурду, что я отказался даже пробовать её."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e5e0de-50e1-3269-964a-b76865452130",
                                        "entry_id": "245a9929-d9dd-3d93-834c-b2ba3faf5480",
                                        "glosses": [
                                            "разг. плохо приготовленное, невкусное питьё (чай, кофе и т. п.) или чрезмерно жидкий, невкусный суп, похлёбка и т. д."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c96e04b-8b67-408d-b04d-156788777e43",
                                                "sense_id": "a6e5e0de-50e1-3269-964a-b76865452130",
                                                "text": "— Не знаю, какой нужно иметь свинский вкус, чтобы есть эту бурду."
                                            },
                                            {
                                                "example_id": "14d31d34-e15a-4128-a393-60b5089f58db",
                                                "sense_id": "a6e5e0de-50e1-3269-964a-b76865452130",
                                                "text": "— Папочка …, бери же стакан, чай давно остыл …. — Сколько раз говорил — крепче, не могу же я бурду пить."
                                            },
                                            {
                                                "example_id": "424612e4-9896-43d3-81f0-50a0aa41a8ee",
                                                "sense_id": "a6e5e0de-50e1-3269-964a-b76865452130",
                                                "text": "Проснулся в 8, выпил ту бурду, которая называется теперь кофеем, и опять заснул часа на полтора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeb216d-0fda-31f5-95a7-2df546a58df3",
                                        "entry_id": "245a9929-d9dd-3d93-834c-b2ba3faf5480",
                                        "glosses": [
                                            "разг. низкосортный или суррогатный алкоголь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeff039-a7bd-47df-9ac2-2e04857965d7",
                                                "sense_id": "0eeb216d-0fda-31f5-95a7-2df546a58df3",
                                                "text": "Свою сожительницу он послал на рынок за какими-то покупками, а сам всё пил стакан за стаканом невообразимую бурду, которую ярославец подавал за настоящую вишнёвую наливку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17846454-e152-39af-be86-83c0e25aed5b",
                                        "entry_id": "245a9929-d9dd-3d93-834c-b2ba3faf5480",
                                        "glosses": [
                                            "перен. путаница, вздор, чепуха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30c4e3c-1828-4e88-b97a-744e3eef1312",
                                                "sense_id": "17846454-e152-39af-be86-83c0e25aed5b",
                                                "text": "— Уверяю, заботы немного, только говори бурду какую хочешь, только подле сядь и говори."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
