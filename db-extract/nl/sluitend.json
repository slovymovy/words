                    {
                        "sense_id": "181a9b36-56ca-3c45-946e-3cd6f71b7bc5",
                        "entry_id": "d2caedd3-3728-3457-9034-a61ab5fa1680",
                        "glosses": [
                            "van iets dat het helemaal klopt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da4cfb9-aacc-4aab-a886-5b68aaa6fca9",
                                "sense_id": "181a9b36-56ca-3c45-946e-3cd6f71b7bc5",
                                "text": "De penningmeester wist weer eens een sluitende begroting te produceren, zonder een overschot maar ook zonder een tekort."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef62acfb-ec4d-33a7-91f1-e695ce2475f6",
                        "entry_id": "d2caedd3-3728-3457-9034-a61ab5fa1680",
                        "glosses": [
                            "waar geen speld tussen te krijgen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a03c7faf-b5a3-4717-ab06-4d6b2b766b45",
                                "sense_id": "ef62acfb-ec4d-33a7-91f1-e695ce2475f6",
                                "text": "De redenaar hield een sluitend betoog, maar zelfs toen was nog niet iedereen overtuigd."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d4813d5-cd83-3340-b5b1-3598dd075e78",
                        "entry_id": "d2caedd3-3728-3457-9034-a61ab5fa1680",
                        "glosses": [
                            "van bijvoorbeeld een raam of deur dat die gesloten wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b98a4f6-612f-4637-a146-953eaf6f12be",
                                "sense_id": "6d4813d5-cd83-3340-b5b1-3598dd075e78",
                                "text": "De slecht sluitende deur bleef op een kier openstaan."
                            }
                        ]
                    }
