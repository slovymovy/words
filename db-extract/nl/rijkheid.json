                                        "examples": [
                                            {
                                                "example_id": "ec494f54-fda6-48e4-a5f3-9e0ddd8bec12",
                                                "sense_id": "22933396-0cb3-3d62-bce3-c245557c60cc",
                                                "text": "By using the same classification system for all the dictionaries surveyed, it was possible to compare the lexical richness of each against the other."
                                            },
                                            {
                                                "example_id": "b8d0d124-bc3a-4ef2-a76b-af01c8bd0e6c",
                                                "sense_id": "22933396-0cb3-3d62-bce3-c245557c60cc",
                                                "text": "Describing us as multilingual emphasizes our achievements and that learning English adds to the richness of our identity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69347ad2-e4d4-3a33-a77b-a123fe6a0895",
