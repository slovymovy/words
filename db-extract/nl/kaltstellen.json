                "senses": [
                    {
                        "sense_id": "b84cc664-6e3a-303e-a150-686782dd3310",
                        "entry_id": "98113935-2ed0-3050-8ba8-2ecdfca54a38",
                        "glosses": [
                            "monddood maken, m.n. de (politieke of culturele) invloed van iemand verminderen dan wel elimineren"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f577552f-e0c6-49a5-8bfa-bcd3571c1329",
                                "sense_id": "b84cc664-6e3a-303e-a150-686782dd3310",
                                "text": "De krant wilde de man met ongemakkelijke standpunten kaltstellen."
                            },
                            {
                                "example_id": "27bbf9ba-be59-4d6d-9de8-21d3f501b97f",
                                "sense_id": "b84cc664-6e3a-303e-a150-686782dd3310",
                                "text": "⧖ Eerst tien jaren later is de brief van 10 December 1858 aan Malwine bekend geworden, n.l. in Hesekiel's ‘Buch vom Grafen Bismarck (1868)’, maar de spraakmakende gemeente in Duitschland heeft er toen ook terstond de hand op gelegd. Kaltstellen doet men iemand, als men hem tijdelijk of voorgoed uit zijn kring van politieken invloed verwijdert en aldus machteloos maakt."
                            }
                        ]
                    }
