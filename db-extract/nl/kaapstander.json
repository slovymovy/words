                        "entry_id": "616b9d5e-3074-3631-85d6-4b29781439e0",
                        "glosses": [
                            "een vertikaal opgestelde windas die rondgedraaid wordt door middel van vier of meer handspaken, en waarmee zware lasten kunnen worden geheven of verplaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b923f206-fee3-482b-9d2c-25ee0d0b4133",
                                "sense_id": "2553b63a-0041-3a2e-bff1-01bf72ceb7b0",
                                "text": "Het touw waaraan de last is vastgemaakt, wordt langzaam maar zeker om de ronddraaiende spil van de kaapstander opgewikkeld."
                            }
                        ]
                    }
                ],
