{
    "word_family": [
        "луковица",
        "луковый",
        "лучник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "415c27bf-17e5-316a-8079-3888a453236f",
                    "sense_definition": "Растение или его луковица, используемые в пищу как овощ.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для приготовления супа нужно мелко нарезать <w>лук</w>.",
                            "target_lang_translations": {
                                "en": "You need to finely chop the <w>onion</w> to make the soup."
                            }
                        },
                        {
                            "text": "Я добавил в салат свежий <w>репчатый</w> <w>лук</w>.",
                            "target_lang_translations": {
                                "en": "I added fresh <w>onion</w> to the salad."
                            }
                        }
                    ],
                    "synonyms": [
                        "репчатый лук",
                        "луковица"
                    ],
                    "common_phrases": [
                        "репчатый лук",
                        "нарезать лук"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant or its bulb, used as a vegetable in cooking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "onion",
                                "target_lang_sense_clarification": "The common vegetable bulb used in cooking."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7ba5afa-8a3a-393c-b31f-b2032ae043e7",
                    "sense_definition": "Молодые зеленые листья лука, употребляемые в пищу.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной мы часто едим <w>зелёный</w> <w>лук</w> с огорода.",
                            "target_lang_translations": {
                                "en": "In the spring, we often eat <w>green onions</w> from the garden."
                            }
                        },
                        {
                            "text": "Посыпьте готовое блюдо мелко нарезанным <w>зелёным</w> <w>луком</w>.",
                            "target_lang_translations": {
                                "en": "Sprinkle the finished dish with finely chopped <w>green onions</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "зелёный лук"
                    ],
                    "common_phrases": [
                        "зелёный лук"
                    ],
                    "target_lang_definitions": {
                        "en": "Young green leaves of the onion plant, used as a vegetable or garnish."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "green onion",
                                "target_lang_sense_clarification": "Also known as spring onion or scallion."
                            },
                            {
                                "target_lang_word": "scallion",
                                "target_lang_sense_clarification": "A common term for young, mild onions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad4df81c-cc96-3a2c-a897-a1b097031c4f",
                    "sense_definition": "Ручное оружие для метания стрел.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древние воины использовали <w>лук</w> и стрелы для охоты.",
                            "target_lang_translations": {
                                "en": "Ancient warriors used a <w>bow</w> and arrows for hunting."
                            }
                        },
                        {
                            "text": "Спортсмен натянул <w>лук</w> и прицелился в мишень.",
                            "target_lang_translations": {
                                "en": "The athlete drew the <w>bow</w> and aimed at the target."
                            }
                        }
                    ],
                    "common_phrases": [
                        "натянуть лук"
                    ],
                    "target_lang_definitions": {
                        "en": "A hand-held weapon used for shooting arrows."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bow",
                                "target_lang_sense_clarification": "A weapon for archery."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b8a179-0a1c-3f63-a546-06026b91341d",
                    "sense_definition": "Внешний вид, стиль одежды или образ человека.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У неё сегодня очень стильный <w>лук</w> для вечеринки.",
                            "target_lang_translations": {
                                "en": "She has a very stylish <w>look</w> for the party today."
                            }
                        },
                        {
                            "text": "Модный блогер выложила свой новый <w>лук</w> в социальные сети.",
                            "target_lang_translations": {
                                "en": "The fashion blogger posted her new <w>look</w> on social media."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стильный лук"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "используется в молодежной среде и индустрии моды"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person's overall appearance, style of dress, or outfit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look",
                                "target_lang_sense_clarification": "A specific style or outfit."
                            },
                            {
                                "target_lang_word": "outfit",
                                "target_lang_sense_clarification": "A set of clothes worn together."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19fc176a-e268-35c4-8d37-598a0b0babc8",
                    "sense_definition": "Род травянистых растений семейства Луковые.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дикий <w>лук</w> часто встречается в лесах средней полосы.",
                            "target_lang_translations": {
                                "en": "Wild <w>allium</w> is often found in the forests of the central region."
                            }
                        },
                        {
                            "text": "Ботаники изучают различные виды растений рода <w>лук</w>.",
                            "target_lang_translations": {
                                "en": "Botanists study various species of plants in the <w>allium</w> genus."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A genus of herbaceous plants in the Allium family."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "allium",
                                "target_lang_sense_clarification": "The botanical genus name for onions, garlic, and related plants."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d8bcaa4-410d-303e-b885-d9c594826911",
                    "sense_definition": "Травянистое растение семейства Лилейные, часто называемое гусиным луком.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Первым весенним цветком в лесу часто бывает <w>птичий</w> <w>лук</w>.",
                            "target_lang_translations": {
                                "en": "The first spring flower in the forest is often the <w>gagea</w>."
                            }
                        },
                        {
                            "text": "Маленькие желтые цветы <w>птичьего</w> <w>лука</w> появляются сразу после таяния снега.",
                            "target_lang_translations": {
                                "en": "The small yellow flowers of the <w>gagea</w> appear right after the snow melts."
                            }
                        }
                    ],
                    "synonyms": [
                        "птичий лук",
                        "гейджия"
                    ],
                    "target_lang_definitions": {
                        "en": "A herbaceous plant of the lily family, often called goose onion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gagea",
                                "target_lang_sense_clarification": "The botanical name for the genus commonly known as yellow star-of-Bethlehem."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "845b81ea-8b4c-368a-8530-d547c145aeb8",
                    "sense_definition": "Многолетнее луковичное растение, известное как морской лук.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В медицине иногда используют экстракт из <w>морского</w> <w>лука</w>.",
                            "target_lang_translations": {
                                "en": "Extract from <w>sea squill</w> is sometimes used in medicine."
                            }
                        },
                        {
                            "text": "Растение <w>морской</w> <w>лук</w> произрастает в прибрежных районах Средиземноморья.",
                            "target_lang_translations": {
                                "en": "The <w>sea squill</w> plant grows in the coastal regions of the Mediterranean."
                            }
                        }
                    ],
                    "synonyms": [
                        "ургинея приморская"
                    ],
                    "target_lang_definitions": {
                        "en": "A perennial bulbous plant known as sea onion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sea squill",
                                "target_lang_sense_clarification": "A Mediterranean plant formerly used in medicine."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}