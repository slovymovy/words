                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a6f981dc-30c1-46f5-a436-64fadbb6b0fe",
                                "sense_id": "c033f170-7814-381f-bfde-a2484b7d46d2",
                                "text": "Canvassing it was like fishing for salmon: you might throw out anything in the shape of a fly, the most gaudy, the most moonshiny, the most unlife-like and unrealizable thing that could be fastened upon a hook […]"
                            }
