                        "sense_id": "a9ed5dc7-f95e-3760-95cb-6a6f7db8f405",
                        "entry_id": "d7f6910c-93f3-39e1-82bf-e49072005230",
                        "glosses": [
                            "Name mehrerer Orte in Deutschland, Österreich und Tschechien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b77efcb-f311-4e71-b134-870d0a4607f5",
                                "sense_id": "a9ed5dc7-f95e-3760-95cb-6a6f7db8f405",
                                "text": "Schneeberg liegt in Deutschlands Osten."
                            },
                            {
                                "example_id": "49c14f69-5026-4d6a-a99e-164768cc5afa",
                                "sense_id": "a9ed5dc7-f95e-3760-95cb-6a6f7db8f405",
                                "text": "„Schon im 12. Jahrhundert setzte im Erzgebirge ein lebhafter Bergbau ein, der sich besonders um Freiberg, Annaberg, später auch Schneeberg und im Osterzgebirge um Altenberg (Zinn) entwickelte und zu der frühen Besiedlung des Gebirges beitrug.“"
                            }
                        ],
