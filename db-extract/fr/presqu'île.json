        "fr-extract.jsonl": [
            {
                "entry_id": "c3eab1ad-9ae1-3036-bb9f-a261cd8cb31f",
                "word": "Presqu'île",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "032e719f-9e25-3a83-bde7-ed6bf707cbbe",
                        "entry_id": "c3eab1ad-9ae1-3036-bb9f-a261cd8cb31f",
                        "glosses": [
                            "Partie centrale de Lyon située entre le Rhône et la Saône."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "554e0ec8-cacf-47c9-8202-6835bf04f8f1",
                                "sense_id": "032e719f-9e25-3a83-bde7-ed6bf707cbbe",
                                "text": "Avec 30 000 passages par jour, la Presqu’île de Lyon est l’endroit le plus fréquenté de l’agglomération."
                            },
                            {
                                "example_id": "581d2e3e-6a9a-4255-b8df-e73f724b4214",
                                "sense_id": "032e719f-9e25-3a83-bde7-ed6bf707cbbe",
                                "text": "Toujours dans Lyon, des travaux sur le pont Bonaparte, qui relie Bellecour et Vieux-Lyon pourrait créer quelques embouteillages fin juillet, tandis que de l’autre côté de la Presqu’île, au niveau du carrefour de la rue Barre et du pont Guillotière, des travaux sur le réseau de chauffage auront lieu de juillet jusqu’à septembre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "855ca38a-fbf6-36e7-9241-34e2b61905f6",
                "word": "presqu'île",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b86c425-e494-4398-abac-aab35bdfc3dc",
                        "entry_id": "855ca38a-fbf6-36e7-9241-34e2b61905f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "presqu’îles"
                    },
                    {
                        "form_id": "a0e0a820-f068-479b-9f56-073008c172b5",
                        "entry_id": "855ca38a-fbf6-36e7-9241-34e2b61905f6",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "presqu’ile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6bc8f88-ee80-35fd-8600-1a113fa2e7f1",
                        "entry_id": "855ca38a-fbf6-36e7-9241-34e2b61905f6",
                        "glosses": [
                            "Terre qui est presque une île, qui n’est reliée au continent que par une mince bande de terre, appelée isthme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d913d7f7-8f88-4358-b4ff-6df65b8e2209",
                                "sense_id": "c6bc8f88-ee80-35fd-8600-1a113fa2e7f1",
                                "text": "Elle est bâtie au milieu de la mer, sur une butte de sable, à l’extrémité d’une presqu’île, dont l’isthme étroit, long et demi-circulaire, forme sa rade immense."
                            },
                            {
                                "example_id": "4f647ddc-b626-4e24-9bcf-b2491301cca1",
                                "sense_id": "c6bc8f88-ee80-35fd-8600-1a113fa2e7f1",
                                "text": "Mytilène […] s’étageait autrefois en amphithéâtre sur une presqu’île à demi détachée, qui était reliée à la terre que par des ponts de pierre blanche."
                            },
                            {
                                "example_id": "3183acc8-4037-4dd3-8916-d9fac67a3395",
                                "sense_id": "c6bc8f88-ee80-35fd-8600-1a113fa2e7f1",
                                "text": "Sur la côte inhospitalière de l’Atlantique battue par les vents et la houle du large, à mi-chemin environ entre le cap Spartel et Mogador, s’ouvre une baie spacieuse, entre un promontoire rocheux et une presqu’île frangée d’écume."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2f005ad-4008-3d4c-bb91-6085e5e0761d",
                        "entry_id": "855ca38a-fbf6-36e7-9241-34e2b61905f6",
                        "glosses": [
                            "Terre qui s’avance dans la mer et qui est unie au continent par une large étendue de terres."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bb668bf5-e18e-438e-8199-ffdc3c94a2a4",
                                "sense_id": "d2f005ad-4008-3d4c-bb91-6085e5e0761d",
                                "text": "Regardez sur cette carte cette longue presqu’île armoricaine, perdue en mer, isolée de tout, comme un brise-lames opposé aux colères océaniennes ; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb985deb-bf2a-430d-ab6d-28b404c8f82d",
                        "source_entry_id": "855ca38a-fbf6-36e7-9241-34e2b61905f6",
                        "target_lang_word": "Halbinsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbinsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                        "entry_id": "be2c1f0e-ed6b-333b-b3d6-0a016337b806",
                                        "glosses": [
                                            "ein Gebiet oder Stück Land, welches von drei Seiten von Wasser umschlossen ist, und nur durch an einer Seite eine (schmale) Landverbindung zum Festland besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80506b02-76ae-41ae-a8d6-59ea8db8fe82",
                                                "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                                "text": "Das Kap Arkona liegt auf der Halbinsel Wittow."
                                            },
                                            {
                                                "example_id": "42a97657-4185-47ae-835c-57c885e151a8",
                                                "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                                "text": "„Die Halbinsel stand in der See wie ein scharfer Schiffsbug, sie stieg nur langsam an zu einem gefalteten Dünenbuckel, der baumlos war, mit hartem Strandhafer bedeckt.“"
                                            },
                                            {
                                                "example_id": "f97cc9b3-ab20-46dd-920c-f61cbfad867d",
                                                "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                                "text": "„Der Umriss des Kontinents ist kaum gegliedert, die Küstenlinie hat nur wenige Inseln, Halbinseln und Meeresbuchten.“"
                                            },
                                            {
                                                "example_id": "b37153d0-c00a-4b98-a4ba-637b1b899048",
                                                "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                                "text": "„Die eisige Halbinsel selbst wurde 1799 ein Teil Russlands.“"
                                            },
                                            {
                                                "example_id": "731a523a-9087-4e17-b4c3-7f61775220f3",
                                                "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                                "text": "„Das Dorf mit seinen etwa 100 Bewohnern liegt an der Ostküste der kleinen Halbinsel.“"
                                            },
                                            {
                                                "example_id": "3da1042e-c15c-46a7-ab8b-2b426ce9c356",
                                                "sense_id": "01620e3d-f6cc-359e-bc2b-27850d847e01",
                                                "text": "„Im Jahr 1997 erkannte Moskau mit der Unterzeichnung des sogenannten \"Großen Vertrags\" die Grenzen der Ukraine an, inklusive der mehrheitlich von ethnischen Russen bewohnten Halbinsel Krim.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf1a0b1-4212-4930-9e33-9e166f989d52",
