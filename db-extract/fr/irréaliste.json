                                    {
                                        "sense_id": "4c343803-9744-302f-af34-1673d7854ed5",
                                        "entry_id": "da2924e0-fc1b-3939-82f3-2677da03d6aa",
                                        "glosses": [
                                            "nicht der Wirklichkeit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4da0852-7434-463c-9a4f-a30cdfa2619d",
                                                "sense_id": "4c343803-9744-302f-af34-1673d7854ed5",
                                                "text": "Seine Freundin konnte keine unrealistischen Filme leiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ec8ec01-77fa-3f75-bcd1-fe19a5218b4c",
                                        "entry_id": "da2924e0-fc1b-3939-82f3-2677da03d6aa",
                                        "glosses": [
                                            "nicht realisierbar, nicht zu verwirklichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ac141a2-bd74-45e3-b29b-8c43ec9c63a5",
                                                "sense_id": "7ec8ec01-77fa-3f75-bcd1-fe19a5218b4c",
                                                "text": "Deine Planungen sind absolut unrealistisch."
                                            },
                                            {
                                                "example_id": "5072b6a4-8241-4fc7-b938-4f540b64febb",
                                                "sense_id": "7ec8ec01-77fa-3f75-bcd1-fe19a5218b4c",
                                                "text": "„»Das Entscheidende an dieser Studie ist, dass diese Forderung, dass wir Mitte des Jahrhunderts CO2-neutral werden müssen, um 1,5 Grad noch zu erreichen, jetzt unrealistisch ist. Wir müssen bis 2035 CO2-neutral werden«, sagt der Münchner Klimaforscher Niklas Boers von der Technischen Universität München.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f416dc8c-2183-45ed-8f75-4eaf8882aff5",
                        "source_entry_id": "685015ea-6d50-364a-88b1-3617ebba009b",
                        "source_sense_id": "d58edab4-76f9-3fb0-be01-a988245357f6",
                        "target_lang_word": "unrealistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
