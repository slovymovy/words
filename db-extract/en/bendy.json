                "senses": [
                    {
                        "sense_id": "ef523d23-308f-3512-9824-013c753cb4e3",
                        "entry_id": "8dc37427-6570-3416-bef3-e4b58e998cf0",
                        "glosses": [
                            "Having the ability to be bent easily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6906ab8-70f0-49e9-842b-6b39be2ed08b",
                                "sense_id": "ef523d23-308f-3512-9824-013c753cb4e3",
                                "text": "Bendy rulers are far more fun than the wooden ones."
                            }
                        ]
                    },
                    {
                        "sense_id": "50878eb4-c830-309c-970e-dbdb3c876e79",
                        "entry_id": "8dc37427-6570-3416-bef3-e4b58e998cf0",
                        "glosses": [
                            "Of a person, flexible; having the ability to bend easily; resilient."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "94ee7a3e-84e8-4546-a7d9-370fff49dc81",
                                "sense_id": "50878eb4-c830-309c-970e-dbdb3c876e79",
                                "text": "When I was in the scene in the barn he encouraged me to do as many contortions as I could, and he seemed to like the fact I was so 'bendy.' … After all how many young actresses in Hollywood are \"bendy\"?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bbb2abdc-8bbb-3211-9e64-bf6c69a68129",
                        "entry_id": "8dc37427-6570-3416-bef3-e4b58e998cf0",
                        "glosses": [
                            "Containing many bends and twists."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba755750-ff32-48a5-a19b-eff9757fc281",
                                "sense_id": "bbb2abdc-8bbb-3211-9e64-bf6c69a68129",
                                "text": "a bendy road"
                            }
                        ]
                    },
                    {
                        "sense_id": "d27b46e2-8f7e-3caf-ba38-d554038f4bc8",
                        "entry_id": "8dc37427-6570-3416-bef3-e4b58e998cf0",
                        "glosses": [
                            "Articulated."
                        ],
                        "tags": [
                            "of a vehicle"
                        ],
                        "examples": [
                            {
                                "example_id": "766d0b7e-9e54-4c87-b143-8b79ce62b2ea",
                                "sense_id": "d27b46e2-8f7e-3caf-ba38-d554038f4bc8",
                                "text": "“The bendy bus is very easy to get on to and can carry twice as many passengers and more people can sit down,” Ms. Cottam said."
                            }
                        ]
                    }
                ],
