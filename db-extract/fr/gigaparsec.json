                        "cross_references": [
                            {
                                "target_word": "Gigaparsec",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0bbde8-e02b-3e16-a8d1-f97ec9abc52e",
                                        "entry_id": "e279cb21-e43c-3d7f-a437-f7b8cc788daa",
                                        "glosses": [
                                            "Entfernung von Sternen im Ausmaß von einer Milliarde Parsec (entspricht etwa 3,26 Milliarden Lichtjahren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58191f33-13ce-4bed-9c76-c51cc5e68573",
                                                "sense_id": "ea0bbde8-e02b-3e16-a8d1-f97ec9abc52e",
                                                "text": "Wenn eine Galaxie ca. 4.3 Gigaparsec bzw. 14 Milliarden Lichtjahre von uns entfernt ist, entfernt sie sich schon mit Lichtgeschwindigkeit von uns."
                                            },
                                            {
                                                "example_id": "f9db8729-226d-41d5-a619-2c900e279531",
                                                "sense_id": "ea0bbde8-e02b-3e16-a8d1-f97ec9abc52e",
                                                "text": "»Och, na ja, der beobachtbare Teil des Universums hat einen Durchmesser von um die 14 Gigaparsec, das sind so in etwa 45 Milliarden Lichtjahre.«"
                                            },
                                            {
                                                "example_id": "c8a0c481-84eb-482f-b3e3-d6b9ccfeab5c",
                                                "sense_id": "ea0bbde8-e02b-3e16-a8d1-f97ec9abc52e",
                                                "text": "\"Mit unseren Messungen können wir die am besten passenden Modelle mit einer Gigaparsec großen 'Void' ausschließen, die als Alternative zur Dunklen Energie ins Spiel gebracht worden sind\", erklärt Adam Riess von der Johns Hopkins University in Baltimore."
                                            },
                                            {
                                                "example_id": "449c6fce-2ace-48f5-9370-4c59ca39f987",
                                                "sense_id": "ea0bbde8-e02b-3e16-a8d1-f97ec9abc52e",
                                                "text": "Wenn es aber um den Raum geht, bekommen wir es mit Gigaparsec zu tun, also Hunderten Milliarden von Lichtjahren."
                                            },
                                            {
                                                "example_id": "ef5e50ae-acf1-4294-b9dc-7abc4f06e6e9",
                                                "sense_id": "ea0bbde8-e02b-3e16-a8d1-f97ec9abc52e",
                                                "text": "Neben Simulationen von Bereichen von mehr als einigen Gigaparsec Ausdehnung wurde die Rechnerbasis außerdem so angepasst, dass die Erstellung von 3D-Modellen des Universums möglich wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
