                        "glosses": [
                            "In a proportionable manner; proportionately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9b7056-3fce-4830-869b-14be2de814ff",
                                "sense_id": "0b921a77-2983-3add-b4fb-8dcfe8940128",
                                "text": "Happy is that man that hath so proportionably directed his estate, as his riches may discharge and supply the same, without care or encombrance to himselfe[…]."
                            },
                            {
                                "example_id": "4342fd76-215f-4aef-9ef8-512a80c925d9",
                                "sense_id": "0b921a77-2983-3add-b4fb-8dcfe8940128",
                                "text": "It may at first appear strange, but I believe it is true, that I cannot by means of money raise a poor man and enable him to live much better than he did before, without proportionably depressing others in the same class."
                            }
                        ]
                    }
