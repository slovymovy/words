                                    },
                                    {
                                        "sense_id": "6ded73a8-36ba-3a1f-a830-ed17a46f3a2b",
                                        "entry_id": "f8e74775-e0ce-330e-8102-412f69876b15",
                                        "glosses": [
                                            "demonstracja polityczna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4223a423-256d-4b38-bb25-d953dba609a9",
                                                "sense_id": "6ded73a8-36ba-3a1f-a830-ed17a46f3a2b",
                                                "text": "Tym razem fala protestów zmusi rządy do przejścia od słów do czynów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "30029c92-8336-34dc-8fea-670b432cbcce",
                                        "entry_id": "f8e74775-e0ce-330e-8102-412f69876b15",
                                        "glosses": [
                                            "weksel zaprotestowany"
                                        ],
                                        "tags": [
