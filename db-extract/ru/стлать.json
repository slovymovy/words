                        "sense_id": "e8497191-4c80-3689-b17b-ace637a21284",
                        "entry_id": "30c9d7e3-7984-385b-b8ab-3bd5544622db",
                        "glosses": [
                            "to spread, to lay, to make (bed)"
                        ],
                        "tags": [
                            "imperfective"
                        ],
                        "examples": [
                            {
                                "example_id": "a49ab1ee-85ad-4a1f-8509-902219b1b4e2",
                                "sense_id": "e8497191-4c80-3689-b17b-ace637a21284",
                                "text": "Ма́ма сте́лет мне посте́ль.",
                                "translation": "Mum is making a bed for me.",
                                "english": "Mum is making a bed for me."
                            },
                            {
                                "example_id": "f82fd4f7-bd5b-4da3-b3b8-1028768fcf8d",
                                "sense_id": "e8497191-4c80-3689-b17b-ace637a21284",
                                "text": "Когда́ бу́дем стлать лино́леум?",
                                "translation": "When shall we put linoleum on?",
                                "english": "When shall we put linoleum on?"
                            }
                        ]
