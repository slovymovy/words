{
    "word_family": [
        "rechargeable",
        "recharger",
        "recharging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac94fcc9-4e7b-3279-8272-fde9fed2d1e8",
                    "sense_definition": "To invigorate and revitalize one's energy level by resting or removing stressful agents for a period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "revitalization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is nice to be able to <w>recharge</w> and come back fresh for the remainder of the year.",
                            "target_lang_translations": {
                                "ru": "Приятно иметь возможность <w>перезарядиться</w> и вернуться полным сил на остаток года."
                            }
                        },
                        {
                            "text": "I need a weekend at the beach to <w>recharge</w> my batteries after this long project.",
                            "target_lang_translations": {
                                "ru": "Мне нужны выходные на пляже, чтобы <w>подзарядить</w> батарейки после этого долгого проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "recharge one's batteries"
                    ],
                    "common_phrases": [
                        "recharge your batteries",
                        "need to recharge",
                        "time to recharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить силы и энергию путем отдыха или избавления от стресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезарядиться",
                                "target_lang_sense_clarification": "восстановить силы"
                            },
                            {
                                "target_lang_word": "набраться сил",
                                "target_lang_sense_clarification": "отдохнуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea823d5c-9c53-3bc1-b5a8-358b67e82be6",
                    "sense_definition": "To restore electrical energy in a battery or a device powered by one.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train will start <w>recharging</w> itself while it is running in service.",
                            "target_lang_translations": {
                                "ru": "Поезд начнет <w>подзаряжаться</w> самостоятельно во время движения по маршруту."
                            }
                        },
                        {
                            "text": "Don't forget to <w>recharge</w> your phone before we leave for the trip.",
                            "target_lang_translations": {
                                "ru": "Не забудь <w>зарядить</w> телефон перед тем, как мы отправимся в поездку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recharge a phone",
                        "recharge the battery",
                        "fully recharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить электрический заряд в аккумуляторе или устройстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезаряжать",
                                "target_lang_sense_clarification": "аккумулятор или устройство"
                            },
                            {
                                "target_lang_word": "заряжать",
                                "target_lang_sense_clarification": "повторно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b161100-64c1-3e55-8931-9d00a8097751",
                    "sense_definition": "To request payment again from a customer, often for the same service or due to a previous error.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer was <w>recharged</w> for the same brake work that had already been completed.",
                            "target_lang_translations": {
                                "ru": "Клиенту <w>повторно выставили счет</w> за ту же работу по тормозам, которая уже была выполнена."
                            }
                        },
                        {
                            "text": "The company had to <w>recharge</w> the client after the initial transaction failed.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось <w>повторно списать средства</w> с клиента после того, как первая транзакция не прошла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recharge the customer",
                        "recharge for services"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно выставить счет клиенту, часто из-за ошибки или за ту же услугу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторно выставить счет",
                                "target_lang_sense_clarification": "клиенту"
                            },
                            {
                                "target_lang_word": "пересчитать",
                                "target_lang_sense_clarification": "оплату"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f46f784-47bb-31ec-b220-1b679238a753",
                    "sense_definition": "To load a firearm with ammunition again.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier had to <w>recharge</w> his rifle quickly during the drill.",
                            "target_lang_translations": {
                                "ru": "Солдату пришлось быстро <w>перезарядить</w> винтовку во время учений."
                            }
                        },
                        {
                            "text": "It takes several seconds to <w>recharge</w> the old musket with powder and ball.",
                            "target_lang_translations": {
                                "ru": "Требуется несколько секунд, чтобы <w>зарядить</w> старый мушкет порохом и пулей."
                            }
                        }
                    ],
                    "synonyms": [
                        "reload"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова зарядить огнестрельное оружие боеприпасами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезаряжать",
                                "target_lang_sense_clarification": "оружие"
                            },
                            {
                                "target_lang_word": "перезарядить",
                                "target_lang_sense_clarification": "оружие (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7efbbc2-d825-3bbd-881d-a2c5d0469dfd",
                    "sense_definition": "To launch a new or repeated attack against an enemy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cavalry began to <w>recharge</w> the enemy lines after the first wave retreated.",
                            "target_lang_translations": {
                                "ru": "Кавалерия начала <w>повторную атаку</w> на вражеские позиции после отступления первой волны."
                            }
                        },
                        {
                            "text": "They charge and <w>recharge</w> along the sea to drive back the fleet.",
                            "target_lang_translations": {
                                "ru": "Они атакуют и <w>вновь бросаются в бой</w> вдоль берега моря, чтобы отбросить флот."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать новую или повторную атаку на противника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вновь атаковать",
                                "target_lang_sense_clarification": "пойти в повторную атаку"
                            },
                            {
                                "target_lang_word": "перегруппироваться для атаки",
                                "target_lang_sense_clarification": "военный контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d77e74b4-3216-3b42-97c5-a19cf8183ad3",
                    "sense_definition": "To add or restore water to an underground aquifer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hydrology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rainfall is necessary to <w>recharge</w> the local groundwater supplies.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди необходимы для <w>пополнения</w> местных запасов грунтовых вод."
                            }
                        },
                        {
                            "text": "The project aims to <w>recharge</w> the aquifer using treated rainwater.",
                            "target_lang_translations": {
                                "ru": "Проект направлен на <w>восполнение</w> водоносного горизонта с использованием очищенной дождевой воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recharge an aquifer",
                        "groundwater recharge"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пополнять запасы воды в подземном водоносном горизонте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнять",
                                "target_lang_sense_clarification": "запасы подземных вод"
                            },
                            {
                                "target_lang_word": "восполнять",
                                "target_lang_sense_clarification": "водоносный горизонт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "121fe080-ba1b-3b0b-894a-986f5736bd13",
                    "sense_definition": "The act or instance of charging an electrical device again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My phone has needed five <w>recharges</w> in the last month due to the old battery.",
                            "target_lang_translations": {
                                "ru": "Моему телефону потребовалось пять <w>подзарядок</w> за последний месяц из-за старого аккумулятора."
                            }
                        },
                        {
                            "text": "The electric car requires a full <w>recharge</w> after every three hundred miles.",
                            "target_lang_translations": {
                                "ru": "Электромобилю требуется полная <w>перезарядка</w> через каждые триста миль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full recharge",
                        "battery recharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай повторной зарядки электрического устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезарядка",
                                "target_lang_sense_clarification": "процесс зарядки устройства"
                            },
                            {
                                "target_lang_word": "подзарядка",
                                "target_lang_sense_clarification": "неполная или повторная зарядка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "475a2f64-a206-3c05-b6ce-ea7e5c6e2b3e",
                    "sense_definition": "The process of regaining physical or mental strength by taking a break from stress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revitalization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>recharge</w> over the weekend helped him face the busy week ahead.",
                            "target_lang_translations": {
                                "ru": "Быстрая <w>перезагрузка</w> на выходных помогла ему подготовиться к предстоящей напряженной неделе."
                            }
                        },
                        {
                            "text": "She felt that a mental <w>recharge</w> was necessary after the intense exams.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что после напряженных экзаменов ей необходима ментальная <w>передышка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mental recharge",
                        "quick recharge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс восстановления физических или душевных сил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузка",
                                "target_lang_sense_clarification": "эмоциональная или ментальная"
                            },
                            {
                                "target_lang_word": "восстановление сил",
                                "target_lang_sense_clarification": "отдых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f33f871d-f539-31e7-a360-71039022ed5f",
                    "sense_definition": "Water that has moved from the surface down into an underground aquifer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hydrology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The annual <w>recharge</w> of the basin depends heavily on the winter snowpack.",
                            "target_lang_translations": {
                                "ru": "Ежегодное <w>пополнение</w> бассейна сильно зависит от зимнего снежного покрова."
                            }
                        },
                        {
                            "text": "Scientists measured the <w>recharge</w> to determine the sustainability of the well.",
                            "target_lang_translations": {
                                "ru": "Ученые измерили <w>приток воды</w>, чтобы определить устойчивость скважины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aquifer recharge",
                        "annual recharge"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вода, переместившаяся с поверхности в подземный водоносный горизонт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инфильтрация",
                                "target_lang_sense_clarification": "пополнение подземных вод"
                            },
                            {
                                "target_lang_word": "питание",
                                "target_lang_sense_clarification": "водоносного горизонта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}