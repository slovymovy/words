                "senses": [
                    {
                        "sense_id": "a2f2b99b-021e-3262-bd79-39904c5920d8",
                        "entry_id": "c7788fa0-129d-3955-9ebe-0ec0c323c10b",
                        "glosses": [
                            "für gewerbliche Ausflüge genutzter Leiterwagen im alten Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29db7178-ba52-4398-b0de-25fab94076a7",
                                "sense_id": "a2f2b99b-021e-3262-bd79-39904c5920d8",
                                "text": "„Aus dem Leiterwagen entwickelte sich durch quer darübergelegte Bretter der Zeiselwagen für den lokalen Personentransport (insbesondere im Ausflugsverkehr).“"
                            },
                            {
                                "example_id": "8959616e-f714-46fa-a46c-b499780d7275",
                                "sense_id": "a2f2b99b-021e-3262-bd79-39904c5920d8",
                                "text": "„Mein Vergnügen erneuert sich, indem ich dies schreibe, jetzt aber würde ich dies nicht mehr thun, wenigstens nicht in so kurzen Terminen, und es machen, wie die Wiener, und mich der Zeiselwagen bedienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
