                        "glosses": [
                            "Lautkombination, die einen Diphthong ausmacht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "91dd36be-e7c8-3d9d-a318-6ab94235cc85",
                        "entry_id": "a3e1cf71-173a-337b-af0a-522412875b06",
                        "glosses": [
                            "Linguistik: doppelter Konsonant"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bdcf26c3-183d-371b-abdc-f3f05b1da216",
                        "entry_id": "a3e1cf71-173a-337b-af0a-522412875b06",
                        "glosses": [
                            "Linguistik: doppelter Vokal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c7701b-9ecf-427b-bfbc-8ce441b55d78",
                                "sense_id": "bdcf26c3-183d-371b-abdc-f3f05b1da216",
                                "text": "„Die aschkenasischen Juden haben jedoch nicht nur den Akzent von der Endsilbe zurückgezogen, sie haben darüber hinaus die Aussprache der Vokale verändert, vor allem in Doppellaute zerdehnt, wie sie es später oder vielleicht auch gleichzeitig mit den deutschen Vokalen taten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "366c3075-18b6-464c-8854-d58e89038af9",
                        "source_entry_id": "a3e1cf71-173a-337b-af0a-522412875b06",
                        "source_sense_id": "8c61b2ca-71d3-327a-b58e-3482299262f7",
                        "source_sense_description": "Linguistik: Lautkombination, die einen Diphthong ausmacht",
                        "target_lang_word": "diphthong",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diphthong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b46cbf82-d5dd-35b0-82eb-71c4c4453efa",
                                        "entry_id": "7b32b597-e07a-3196-ae02-7f8bec1e4c47",
                                        "glosses": [
                                            "A complex vowel sound that begins with the sound of one vowel and ends with the sound of another vowel, in the same syllable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "552b2b29-59e7-3cf0-bd4b-210815cbf372",
                                        "entry_id": "7b32b597-e07a-3196-ae02-7f8bec1e4c47",
                                        "glosses": [
                                            "A diaphoneme realized as a two-target vowel in some but not necessarily all dialects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                        "entry_id": "7b32b597-e07a-3196-ae02-7f8bec1e4c47",
                                        "glosses": [
                                            "A vowel digraph or ligature."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d04f4a23-662b-4c63-9940-64e429b214b2",
                                                "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                                "text": "And he might have written the name, also, with the diphthong æ, as well as the single vowel, in the initial syllable, throughout all the preceding forms."
                                            },
                                            {
                                                "example_id": "87489c8d-31c0-4e75-9e85-9776fd0e6965",
                                                "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                                "text": "An improper diphthong has only one of the vowels sounded; as, ea in heat, oa in coal."
                                            },
                                            {
                                                "example_id": "9eb62d20-8fc1-4995-9527-67f4102cb732",
                                                "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                                "text": "The diphthong ae is sounded like ē (§7); that is, it has the sound of ey in they."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
