                "senses": [
                    {
                        "sense_id": "2a8493fe-a250-32c0-8a95-cb52b5285dc2",
                        "entry_id": "36042141-527a-3b58-97d8-d7f9468e4d4a",
                        "glosses": [
                            "założenie, że Bóg i religia nie mają znaczenia dla ludzkiego życia; apatyczny stosunek do kwestii istnienia bądź nieistnienia Boga"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "860a1bb5-b6ed-4164-b7ad-a8893875c923",
                                "sense_id": "2a8493fe-a250-32c0-8a95-cb52b5285dc2",
                                "text": "Apateizm — to postawa indyferentyzmu wobec samej kwestii istnienia/nieistnienia Boga, także wobec teizmu i ateizmu jako zdeklarowanej wiary/niewiary"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "632ca609-d6b5-44cd-92b2-025c34c13be4",
                        "source_entry_id": "36042141-527a-3b58-97d8-d7f9468e4d4a",
                        "source_sense_id": "2a8493fe-a250-32c0-8a95-cb52b5285dc2",
                        "target_lang_word": "apatheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apatheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd461f22-72d8-337c-aeda-98c6ab6242aa",
                                        "entry_id": "985b86b0-840e-3259-a6f5-ebc4be6e4036",
                                        "glosses": [
                                            "Apathy towards the existence of a god; belief that the question of the existence of a god is unimportant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6464132b-ed2b-4a2c-84de-07e987f15922",
                                                "sense_id": "dd461f22-72d8-337c-aeda-98c6ab6242aa",
                                                "text": "[A]patheism is an attitude, not a belief system, and the over-riding fact is that these people are relaxed about religion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c89da1ab-982c-4763-a7ec-39c7c721ac7c",
                        "source_entry_id": "36042141-527a-3b58-97d8-d7f9468e4d4a",
                        "source_sense_id": "2a8493fe-a250-32c0-8a95-cb52b5285dc2",
                        "target_lang_word": "indifférence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indifférence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e18f5b8c-669c-3573-a9a6-18271297a00b",
                                        "entry_id": "3c987cdd-a613-30c2-b102-6e749eebbf02",
                                        "glosses": [
                                            "État d’une personne qui n’extériorise pas ses sentiments, ses états d’âme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e41e3f2d-e34a-4e82-896e-267b584186a7",
                                                "sense_id": "e18f5b8c-669c-3573-a9a6-18271297a00b",
                                                "text": "État d’indifférence, état mental qui ne contient ni plaisir ni douleur."
                                            },
                                            {
                                                "example_id": "51892d02-b658-4f5d-8192-c8644cda9a43",
                                                "sense_id": "e18f5b8c-669c-3573-a9a6-18271297a00b",
                                                "text": "Liberté d’indifférence, état d’une âme libre de choisir entre deux partis, parce qu’aucun motif ne la fait pencher vers l’un plutôt que vers l’autre."
                                            },
                                            {
                                                "example_id": "a6f882c1-cdf1-4615-ba32-8f03f71a71c2",
                                                "sense_id": "e18f5b8c-669c-3573-a9a6-18271297a00b",
                                                "text": "Quoique l’huissier affectât cet air d’indifférence que l’habitude des affaires donne aux officiers ministériels, il fit à la cabaretière et à son mari ce clignement d’yeux qui signifie : mauvaise affaire !…"
                                            },
                                            {
                                                "example_id": "51b76e9b-19b6-410b-b74d-e45e9d87ce97",
                                                "sense_id": "e18f5b8c-669c-3573-a9a6-18271297a00b",
                                                "text": "Sachez qu’aujourd’hui seule l’indifférence est payante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e48b7b-95f3-3d98-a429-f8b0d91d8b99",
                                        "entry_id": "3c987cdd-a613-30c2-b102-6e749eebbf02",
                                        "glosses": [
                                            "État d’une personne qui n’a aucun intérêt pour ce qui l’entoure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56be24a4-0cad-4c04-8d6e-05f572866b65",
                                                "sense_id": "50e48b7b-95f3-3d98-a429-f8b0d91d8b99",
                                                "text": "Il regardait ce paysage familier avec la même sensation d’indifférence songeuse que l'on éprouve en regardant un port inconnu, où on n'est jamais allé, où on n'ira jamais, du pont d'un navire, lors d'une courte escale."
                                            },
                                            {
                                                "example_id": "5da87c27-a38a-4906-bd53-13c9ee8572d3",
                                                "sense_id": "50e48b7b-95f3-3d98-a429-f8b0d91d8b99",
                                                "text": "En donnant trop d’importance aux belles actions, on rend finalement un hommage indirect et puissant au mal car on laisse supposer alors que ces belles actions n’ont tant de prix que parce qu’elles sont rares, et que la méchanceté et l’indifférence sont des moteurs bien plus fréquents dans les actions des hommes."
                                            },
                                            {
                                                "example_id": "6dd7246b-72b4-4759-82b8-e674ef0bd600",
                                                "sense_id": "50e48b7b-95f3-3d98-a429-f8b0d91d8b99",
                                                "text": "Faites entrer cette personne, dit péremptoirement M. Camusot dont le mécontentement perça, malgré son apparente indifférence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0ee35a-7dd0-3dda-948b-f7cfeba1b769",
                                        "entry_id": "3c987cdd-a613-30c2-b102-6e749eebbf02",
                                        "glosses": [
                                            "État d’une personne qui n’est pas sensible à l’amour."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f7d426-6523-40f6-8ae2-b670cc362443",
                                                "sense_id": "1b0ee35a-7dd0-3dda-948b-f7cfeba1b769",
                                                "text": "J’ai pitié de ceux qui vont deux à deux, enchaînés par l’indifférence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ecc90c-9242-30da-86c8-5bfd795ef872",
                                        "entry_id": "3c987cdd-a613-30c2-b102-6e749eebbf02",
                                        "glosses": [
                                            "Manque total d'intérêt pour une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135b86c6-f770-4a36-8d22-9b3e1dd433fe",
                                                "sense_id": "f3ecc90c-9242-30da-86c8-5bfd795ef872",
                                                "text": "L’indifférence en matière de foi était devenue de règle, car d’hostilité on n’en sentait point trop encore ; à peine sourdait-elle, peut-être, dans quelques propos sacrilèges."
                                            },
                                            {
                                                "example_id": "8c4ef10e-539c-49aa-a4ea-95da88914d16",
                                                "sense_id": "f3ecc90c-9242-30da-86c8-5bfd795ef872",
                                                "text": "Quand elles se parlaient, c'était avec politesse, mais avec une mutuelle indifférence."
                                            },
                                            {
                                                "example_id": "729d368a-f7bb-46a2-af83-68f08078885c",
                                                "sense_id": "f3ecc90c-9242-30da-86c8-5bfd795ef872",
                                                "text": "Nous savons faire la part des choses ; l’indifférence pour les dogmes n'est pas toujours l’indifférence pour la religion même, et nous comprenons que des âmes vraiment pieuses puissent se détourner non satisfaites d'un enseignement dogmatique, sans pour cela éteindre en elles la passion des choses divines."
                                            },
                                            {
                                                "example_id": "de9c936f-9338-4b40-8876-b3aef53b225b",
                                                "sense_id": "f3ecc90c-9242-30da-86c8-5bfd795ef872",
                                                "text": "Peu enclins à admettre que leurs pratiques puissent être ainsi mises en cause, ces Etats accueillent généralement les avis de cette institution avec une indifférence polie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f4800fc-b42d-4b01-b5f8-d07bfe2eee0d",
                        "source_entry_id": "36042141-527a-3b58-97d8-d7f9468e4d4a",
                        "source_sense_id": "2a8493fe-a250-32c0-8a95-cb52b5285dc2",
                        "target_lang_word": "religieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "religieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb455fd-226e-3d02-85ed-d00c4fede117",
                                        "entry_id": "bfcb1d7c-0bb8-337c-bcdf-c6f3babaaa34",
                                        "glosses": [
                                            "Celle qui s’est engagé par des vœux à suivre une certaine règle déterminée par l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba40b1a-4f3f-41c4-a877-cc8af3e78144",
                                                "sense_id": "4fb455fd-226e-3d02-85ed-d00c4fede117",
                                                "text": "Il se trouva ainsi, d’après les lois de l’église, coupable d’un double sacrilège, comme bigame, et comme mari d’une femme qui avait reçu le voile de religieuse."
                                            },
                                            {
                                                "example_id": "5bc89ea2-80da-4c1d-be6e-9be67c7f4204",
                                                "sense_id": "4fb455fd-226e-3d02-85ed-d00c4fede117",
                                                "text": "Ils étaient, en outre, convaincus — et non sans raison — qu’à part les religieuses et les Amazones, les Européennes n’ont pas plus de goût pour la vie solitaire ou unisexuelle, que les Turkestanes, qui ont obtenu le droit de se remarier, lorsque leurs maris sont absents plus de vingt jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e07e3bff-4817-39d4-a6dd-01f40f4ac41e",
                                        "entry_id": "bfcb1d7c-0bb8-337c-bcdf-c6f3babaaa34",
                                        "glosses": [
                                            "Pâtisserie composée de deux choux à la crème pâtissière superposés, un grand surmonté d’un petit, et dont la forme peut rappeler une religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3653c804-619f-4673-b256-f611a76b70eb",
                                                "sense_id": "e07e3bff-4817-39d4-a6dd-01f40f4ac41e",
                                                "text": "Depuis plus de trente ans, chaque dimanche, vous achetez dans la même boulangerie une religieuse au chocolat."
                                            },
                                            {
                                                "example_id": "4e2edff1-286e-4d95-af3a-bc4a59f5a024",
                                                "sense_id": "e07e3bff-4817-39d4-a6dd-01f40f4ac41e",
                                                "text": "Par éviscération abdominale, le légiste (aidé d’une brigade de mitrons) dénombra par ordre d’entrée en scène : 18 tartelettes amandines, 26 pets-de-nonne, 13 paris-brest, 8 polonaises, 3 apfelstrudels, 1 demi saint-honoré, 5 poires Bourdaloue, 6 religieuses, 34 profiteroles, 3 quarts de kugelhopf, 1 brioche à la parisienne, 1 cake à l’ancienne, 3 babas au rhum et 137 éclairs au chocolat et 2 au café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553536b0-8b6f-333b-a1d1-2663ac8a5737",
                                        "entry_id": "bfcb1d7c-0bb8-337c-bcdf-c6f3babaaa34",
                                        "glosses": [
                                            "Pratiquante."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "religieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "818f024a-b93c-307e-b410-6b0f39fdf1a1",
                                        "entry_id": "952f47d5-112b-3744-983f-63b1097bc3af",
                                        "glosses": [
                                            "Féminin singulier de religieux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e652f53b-09d5-4283-a329-058416d7265f",
                                                "sense_id": "818f024a-b93c-307e-b410-6b0f39fdf1a1",
                                                "text": "Le légalisme est la pratique qui respecte de manière absolue les lois religieuses prises à la lettre et qui soumet rigoureusement la vie religieuse à la régulation par les lois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e04dc829-089a-4aad-9d17-bba5f705ceab",
                        "source_entry_id": "36042141-527a-3b58-97d8-d7f9468e4d4a",
                        "source_sense_id": "2a8493fe-a250-32c0-8a95-cb52b5285dc2",
