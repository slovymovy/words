                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "598e5588-c40a-3a65-a75e-ab527a11d738",
                                        "entry_id": "2fb073bb-106b-3e72-8d66-bba80aee6ab7",
                                        "glosses": [
                                            "A plant, Brassica oleracea var. italica, of the cabbage family, Brassicaceae; especially, the tree-shaped flower and stalk that are eaten as a vegetable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "285c9dbc-3fa0-4599-a96d-0ac1272a52f4",
                                                "sense_id": "598e5588-c40a-3a65-a75e-ab527a11d738",
                                                "text": "You can also get oriental broccolis such as kailaan and nabana, which are easy to grow and really tasty."
                                            },
                                            {
                                                "example_id": "e108e52c-3132-4479-ad03-d7b906d9a883",
                                                "sense_id": "598e5588-c40a-3a65-a75e-ab527a11d738",
                                                "text": "Examples of leafy vegetables are broccoli, spinach, celery, and chicory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "452243c6-2b86-332c-a56e-bf026a2f9601",
                                        "entry_id": "2fb073bb-106b-3e72-8d66-bba80aee6ab7",
                                        "glosses": [
                                            "Marijuana."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fe5b90-01cd-41f5-9bb4-47f4d1f498d5",
                                                "sense_id": "452243c6-2b86-332c-a56e-bf026a2f9601",
                                                "text": "I be smokin' broccoli, mama told me eat my veggies"
                                            },
                                            {
                                                "example_id": "fb56b277-d91a-4ac8-81bc-071a41ebac79",
                                                "sense_id": "452243c6-2b86-332c-a56e-bf026a2f9601",
                                                "text": "All I want is cottage, roll a cigar full of broccoli"
                                            }
                                        ]
                                    }
