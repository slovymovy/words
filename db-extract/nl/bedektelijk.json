                "senses": [
                    {
                        "sense_id": "1e065156-10a9-37e5-ae08-140e26b3fb01",
                        "entry_id": "582f91c9-c2dc-3cfa-88a2-b12ca60b17fa",
                        "glosses": [
                            "op een slinkse manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50a6dfa0-951e-48b0-a3a1-2d4ef5b798ad",
                                "sense_id": "1e065156-10a9-37e5-ae08-140e26b3fb01",
                                "text": "Acht engelen waren bedektelijk bij de poort op de wal geklommen, om de welkom te blazen en de Vorst aan te kondigen."
                            },
                            {
                                "example_id": "739381a4-e355-4818-b33c-a0cad0e2d5a0",
                                "sense_id": "1e065156-10a9-37e5-ae08-140e26b3fb01",
                                "text": "Walter de Chatillon met vrees bevangen dorst de algemene slag niet wagen; hij trok dan des nachts met zijn leger naar Atrecht, en dit zo bedektelijk dat de Vlamingen, niets van die aftocht gemerkt hebbende, des morgens verwonderd en verbaasd waren daar zij geen enkele Fransman meer ontwaarden."
                            }
                        ]
                    }
