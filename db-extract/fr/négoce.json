                "senses": [
                    {
                        "sense_id": "cb7b38d0-b702-3acd-afb4-d9c7d4aa8b38",
                        "entry_id": "e7c2fbdf-c78a-3826-a70a-84579fe17cf4",
                        "glosses": [
                            "Trafic, commerce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2b79de-b785-4fdd-b6ed-06583d37e6bc",
                                "sense_id": "cb7b38d0-b702-3acd-afb4-d9c7d4aa8b38",
                                "text": "Il y eut certes des juifs qui s'adonnèrent au commerce, et qui poursuivirent des négoces importants."
                            },
                            {
                                "example_id": "2ed39f2d-6937-4769-bbe1-3779623d3fad",
                                "sense_id": "cb7b38d0-b702-3acd-afb4-d9c7d4aa8b38",
                                "text": "Au fil des mois, je m’étais liée d’amitié avec les Shiwas, une tribu indienne voisine. Avec eux, j’aimais faire du négoce pour sortir de mon ordinaire et améliorer celui de la cabane."
                            }
                        ]
                    },
                    {
                        "sense_id": "030fc1ae-2c32-3a10-ad74-d3817a457ddb",
                        "entry_id": "e7c2fbdf-c78a-3826-a70a-84579fe17cf4",
                        "glosses": [
                            "Trafic douteux."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "68fdb19a-9350-4b06-9a24-a054708db95d",
                                "sense_id": "030fc1ae-2c32-3a10-ad74-d3817a457ddb",
                                "text": "Cet homme se livre à un étrange négoce."
                            },
                            {
                                "example_id": "5e2f459e-ba9c-4823-8edc-9e83dabed066",
                                "sense_id": "030fc1ae-2c32-3a10-ad74-d3817a457ddb",
                                "text": "On ne sait quel négoce font ces gens-là."
                            }
                        ]
                    }
                ],
