                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c208fa34-bec9-4239-be09-33612c63a450",
                        "entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "tags": [
                            "plural"
                        ],
                        "form": "diablesses"
                    },
                    {
                        "form_id": "c6da2e4e-b746-42f5-881e-da62826ee36a",
                        "entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "tags": [
                            "masculine"
                        ],
                        "form": "diable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94090cd7-e308-3873-bdeb-8ea9e40b7fd7",
                        "entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "glosses": [
                            "Démone, diable femelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ba7899-0c32-4c40-8519-1fc313faae20",
                                "sense_id": "94090cd7-e308-3873-bdeb-8ea9e40b7fd7",
                                "text": "À mort ! à mort ! la diablesse ! et vive la vieille Angleterre !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e606fe6b-86ab-3065-924e-9c5222dd5e84",
                        "entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "glosses": [
                            "Femme méchante et acariâtre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4c101311-3c06-49f1-ad24-277a6f48228e",
                                "sense_id": "e606fe6b-86ab-3065-924e-9c5222dd5e84",
                                "text": "Tu en répondras à notre seigneur, alors, vieille diablesse, dit l’homme en se retirant."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1f490d6-702e-3b4c-989e-8f7165d8bae6",
                        "entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "glosses": [
                            "Fille ou femme turbulente, espiègle ou malicieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e21e65-db26-4c1e-b0fb-47f3aaeb549b",
                                "sense_id": "a1f490d6-702e-3b4c-989e-8f7165d8bae6",
                                "text": "Ah ! lorsque les filles s’intéressent aux marguerites, aux pleines lunes et aux quartiers […] l’amour est proche, la chute n’est pas éloignée. Mais pour un homme seul, avec une diablesse de cet âge, que faire sinon la marier ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe939d5c-13bd-496b-9a5c-821bdc7c2d42",
                        "source_entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "source_sense_id": "94090cd7-e308-3873-bdeb-8ea9e40b7fd7",
                        "source_sense_description": "Diable femelle",
                        "target_lang_word": "she-devil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "she-devil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be0e15bb-354f-3ca7-bec5-7c2ae0f05d12",
                                        "entry_id": "56d3f5d8-1002-3b20-a64e-83c79285a905",
                                        "glosses": [
                                            "A female devil (as opposed to a he-devil, male devil)."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a9e0e7-bd58-4589-ae68-bdd525fb7f50",
                                                "sense_id": "be0e15bb-354f-3ca7-bec5-7c2ae0f05d12",
                                                "text": "In order to exorcise this she-devil, the attendants made circles on the walls with charcoal, within each was written: \"Adam, Eve, Lilas, avaunt!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca96ca06-cf75-369f-b152-781709e1ea12",
                                        "entry_id": "56d3f5d8-1002-3b20-a64e-83c79285a905",
                                        "glosses": [
                                            "A woman whose bad temper, cruelty or wicked ways are so extreme as to evoke an image of the devil."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c34451-7330-4b2a-8cc1-62ef059ee367",
                                                "sense_id": "ca96ca06-cf75-369f-b152-781709e1ea12",
                                                "text": "Monsieur Margot groaned. “Go, then, my friend,” said he, “procure the ladder! Oh, those she devils!—what could make me such a fool!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59e87360-47fd-47e2-ab8a-cb0618526d61",
                        "source_entry_id": "dc763344-ff5e-3591-a213-90e4c3d56fbb",
                        "source_sense_id": "94090cd7-e308-3873-bdeb-8ea9e40b7fd7",
                        "source_sense_description": "Diable femelle",
                        "target_lang_word": "deviless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deviless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2379df-4d21-3cba-b2e6-e5873e2d9c16",
                                        "entry_id": "017ced27-a1fc-3607-b741-2e3f95655d5c",
                                        "glosses": [
                                            "A female devil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe91a99f-4dd1-4a0c-92b0-c73c2c6bc625",
                                                "sense_id": "fa2379df-4d21-3cba-b2e6-e5873e2d9c16",
                                                "text": "Then I see a sudden scattering of goblins and demons and devilesses in all directions: they run into houses, up alleys, — hide behind door-ways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
