                "senses": [
                    {
                        "sense_id": "f94137b8-d490-3ef4-a22f-61a705bb89fe",
                        "entry_id": "8686589e-664f-34f4-b0e9-29dc849a9d74",
                        "glosses": [
                            "twee kaarten met dezelfde waarde (bijvoorbeeld: twee negens of twee boeren) in de hand van een speler"
                        ],
                        "tags": [
                            "poker"
                        ],
                        "examples": [
                            {
                                "example_id": "133d8ef4-79ed-46b2-888f-07563207ef60",
                                "sense_id": "f94137b8-d490-3ef4-a22f-61a705bb89fe",
                                "text": "Wanneer er dus twee of meer spelers een pair maken, wint de speler met het hoogste pair. Een pair vrouwen is dus hoger dan een pair boeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "44253b44-678e-3be1-a73e-26c744607da5",
                        "entry_id": "8686589e-664f-34f4-b0e9-29dc849a9d74",
                        "glosses": [
                            "inzetmogelijkheid die winst geeft als de roulette op een even getal groter dan nul uitkomt"
                        ],
                        "tags": [
                            "roulette"
                        ],
                        "examples": [
                            {
                                "example_id": "e37cfde3-55d1-45b1-8765-3b990b09d4c8",
                                "sense_id": "44253b44-678e-3be1-a73e-26c744607da5",
                                "text": "Fedja stelde voor dat ik vijf frank zou inzetten. Ik koos op zijn advies impair. Het werd pair, en ik verloor."
                            }
                        ]
                    },
                    {
                        "sense_id": "f32a8bbe-8046-39d4-8963-9a97f7f5adf7",
                        "entry_id": "8686589e-664f-34f4-b0e9-29dc849a9d74",
                        "glosses": [
                            "benaming voor de hoogste leden van de adel in een land, die voor het adellijk recht als gelijken van de koning worden beschouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a733977a-1ee2-43a2-bb1c-119ce4861917",
                                "sense_id": "f32a8bbe-8046-39d4-8963-9a97f7f5adf7",
                                "text": "Koning Pepijn wordt in deze roman bijgestaan door zijn \"douze pers\", de \"Twaelf Genooten\". Wie dat allemaal zijn, wordt ons niet verteld, alleen de belangrijksten worden enkele keren genoemd. De eerste pair lijkt Milioen d'Angler te zijn, een schoonzoon van Pepijn, maar nergens wordt ons verteld met welke dochter van Pepijn deze Milioen gehuwd is. Na Milioen d'Angler volgen als tweede en derde pair hertog Sampson van Orliens (…) en diens zoon Garnier, graaf van Vendomme (…)."
                            },
                            {
                                "example_id": "de945be8-711e-4154-ade1-73bc7491c432",
                                "sense_id": "f32a8bbe-8046-39d4-8963-9a97f7f5adf7",
                                "text": "Opmerkelijk is de opera Holger Danske van F.L.A. Kunzen, die in 1789 te Kopenhagen in première ging, op tekst van I. Baggesen naar Christoph Martin Wielands Oberon. De librettist verving echter Huon door Holger Danske als pair van Karel de Grote; verder hanteerde hij de gebruikelijke Oberon-Titania-stof."
                            },
                            {
                                "example_id": "c2904efa-dc6d-4bb5-89a2-e82eef53764f",
                                "sense_id": "f32a8bbe-8046-39d4-8963-9a97f7f5adf7",
                                "text": "Maar wat moest Nobel doen? Hij heeft zijn machtigste en hoogste pair als eerste gestuurd en daarmee de gedaagde extra eer bewezen."
                            }
                        ]
                    }
