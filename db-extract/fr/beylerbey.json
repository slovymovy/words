                        "glosses": [
                            "Haute distinction des pays musulmans du Proche-Orient (et leurs dépendances) utilisée durant le Moyen Âge et l’époque moderne."
                        ],
                        "tags": [
                            "Distinction"
                        ],
                        "examples": [
                            {
                                "example_id": "6c18c1da-e028-4867-a61f-26a080c9027c",
                                "sense_id": "fe6abf9d-e6f5-3a6b-93a2-8268780df5e9",
                                "text": "Ayaz-Pacha, Moustapha-Pacha, le premier, grand-vizir, le second, membre aussi du divan, l’agha des janissaires, l’agha des akindjis, le beylerbey de Roumélie, reçurent l’ordre de conduire au séraskier 25,000 hommes encore."
                            },
                            {
                                "example_id": "db9a0f22-bd0f-492d-b7b4-9209a18e4ebd",
                                "sense_id": "fe6abf9d-e6f5-3a6b-93a2-8268780df5e9",
                                "text": "Le beylerbey lui rendit son regard en silence, puis, impassible, lui adressa un bref signe de tête."
                            }
                        ]
                    }
