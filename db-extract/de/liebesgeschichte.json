                ],
                "senses": [
                    {
                        "sense_id": "8f6918ce-fb17-3286-b36b-6b94c3698442",
                        "entry_id": "89bbfe3f-7b7e-31bc-a96d-9039d4c20009",
                        "glosses": [
                            "Erzählung, die von einer Liebesbeziehung handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897fb04c-de4b-4aa7-9064-1958ac7aae59",
                                "sense_id": "8f6918ce-fb17-3286-b36b-6b94c3698442",
                                "text": "Die Liebesgeschichte handelt von der schönen Mona und dem schüchternen Maximilian."
                            },
                            {
                                "example_id": "de20d15c-a3e2-487a-8a32-b86b79f7cfef",
                                "sense_id": "8f6918ce-fb17-3286-b36b-6b94c3698442",
                                "text": "Abends lese ich gerne Liebesgeschichten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "923a5e5e-2b92-3fad-b54f-635af5367892",
                        "entry_id": "89bbfe3f-7b7e-31bc-a96d-9039d4c20009",
                        "glosses": [
                            "vorübergehende Liebesbeziehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da178ada-66ce-4cbe-a75c-def9c75840bd",
                                "sense_id": "923a5e5e-2b92-3fad-b54f-635af5367892",
                                "text": "In seiner Jugend hatte mein Bruder viele Liebesgeschichten."
                            },
                            {
                                "example_id": "9cbfb443-c91c-4ca6-beb0-9d7a818fe542",
                                "sense_id": "923a5e5e-2b92-3fad-b54f-635af5367892",
                                "text": "„In all dem Chaos gelang mir eine Liebesgeschichte, sagen wir, eine Liebelei.“"
                            },
                            {
                                "example_id": "242a2f1a-f683-4d73-a056-2c6e33264271",
                                "sense_id": "923a5e5e-2b92-3fad-b54f-635af5367892",
                                "text": "„Wie viele Liebesgeschichten in diesem Buch diente auch diese Beziehung einem einfachen Zweck.“"
                            },
                            {
                                "example_id": "252db001-3587-481a-848c-e170fb05878e",
                                "sense_id": "923a5e5e-2b92-3fad-b54f-635af5367892",
                                "text": "„Natascha schwieg, wie Marja Dmitrijewna glaubte, aus Verschämtheit; tatsächlich aber war es Natascha unangenehm, wenn andere Menschen sich in ihre und des Fürsten Andrej Liebesgeschichte mengten.“"
                            },
                            {
                                "example_id": "7e40929c-6c87-4efa-a8d2-46635e039e74",
                                "sense_id": "923a5e5e-2b92-3fad-b54f-635af5367892",
                                "text": "„Als ich mit ihm allein war, erzählte ich ihm getreulich die ganze Liebesgeschichte Barbaruccias, ohne ihm die geringste Einzelheit zu verschweigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
