                ],
                "senses": [
                    {
                        "sense_id": "55e618ba-6237-3b08-a8e4-a173568ed9ac",
                        "entry_id": "af6fc227-f5b1-356b-9d4a-bfa784a7ddcc",
                        "glosses": [
                            "истор. монета, имевшая хождение в ряде германских государств до конца XIX века"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f52ff3-9a19-42bb-8537-925282b7c5b6",
                                "sense_id": "55e618ba-6237-3b08-a8e4-a173568ed9ac",
                                "text": "[Мартын:] Как минуло мне четырнадцать лет, покойный отец дал мне два крейцера в руку, да два пинка в гузно, да примолвил: ступай-ка, Мартын, сам кормиться, а мне и без тебя тяжело."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a71100fe-9f87-49c4-8508-b24049eca537",
                        "source_entry_id": "af6fc227-f5b1-356b-9d4a-bfa784a7ddcc",
                        "source_sense_id": "55e618ba-6237-3b08-a8e4-a173568ed9ac",
                        "target_lang_word": "Kreuzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreuzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                        "entry_id": "7c3af31c-774e-3cd9-8a99-e81fea99f1b7",
                                        "glosses": [
                                            "schnelles, mittelgroßes, leicht gepanzertes Kriegsschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ac86b1-15ea-4733-b41d-e0a74624704d",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "Die SMS Scharnhorst war ein großer Kreuzer der kaiserlichen Marine."
                                            },
                                            {
                                                "example_id": "b7dd551b-0a02-4c0a-ac6f-9f9f55e45527",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Gleich zu Beginn meiner zweiten Wache begegneten wir einem japanischen Kreuzer und einem Zerstörer auf Gegenkurs.“"
                                            },
                                            {
                                                "example_id": "da0995c6-9356-45ac-9166-65661c08d002",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Am 30. Juli 1945 wurde der amerikanische Kreuzer Indianapolis mit fast 1200 Mann Besatzung von einem japanischen Unterseeboot torpediert.“"
                                            },
                                            {
                                                "example_id": "1fa789a4-6329-4b22-a7df-c5d184804903",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Ein britischer Flottenverband, der im März aus Europa eingetroffen war, beteiligte sich mit zwei Schlachtschiffen, vier Flugzeugträgern, sechs Kreuzern und fünfzehn Zerstörern an dem Unternehmen.“"
                                            },
                                            {
                                                "example_id": "e788244c-b286-4b9b-8afb-784c8f235df3",
                                                "sense_id": "f1beaeb1-7fa4-30cd-b7dd-6b8ccbfa7486",
                                                "text": "„Zu jener Zeit schickten die englischen Kreuzer viele gekaperte amerikanische Schiffe in den Hafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a8c7f97-4f7b-3f6b-a237-17cb32410782",
                                        "entry_id": "7c3af31c-774e-3cd9-8a99-e81fea99f1b7",
                                        "glosses": [
                                            "kleine Münze, früher in Deutschland und Österreich-Ungarn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db47c61d-b991-43df-9c0d-2ab589d3611b",
                                                "sense_id": "7a8c7f97-4f7b-3f6b-a237-17cb32410782",
                                                "text": "Ein Heller sind zehn Kreuzer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kreuzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                        "entry_id": "2fbc6bae-2807-3dc0-9fe5-f4cdae6c42fb",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1394054-bb4f-4848-a8bd-662c67ec703d",
                                                "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                                "text": "Herr Kreuzer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "64bddb24-d5e8-4206-a705-2cc1f353230e",
                                                "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                                "text": "Die Kreuzers fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "6769bedb-e09f-4623-981a-b899afd9285d",
                                                "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                                "text": "Der Kreuzer trägt nie die Pullover, die die Kreuzer ihm strickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
