                "translations": [
                    {
                        "translation_id": "e90b34a1-27f9-4385-8edc-e5427a2e5e4d",
                        "source_entry_id": "7e5dadb8-729c-3ee6-a8bf-f7d5d9d9166f",
                        "source_sense_id": "7772e4c6-b21b-3fcb-aa50-905a05603b20",
                        "source_sense_description": "griechische Mythologie: Trank der Götter, der sie unsterblich macht; Nektar",
                        "target_lang_word": "Nektar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nektar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65734afe-d7d7-3b82-ba2d-d5c81423e41c",
                                        "entry_id": "7ae0b18d-5961-37e1-9d8a-415121388b53",
                                        "glosses": [
                                            "Trank der Götter, der sie unsterblich macht"
                                        ],
                                        "tags": [
                                            "griechische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7baed3f-274f-4d88-be05-2e56f9979100",
                                                "sense_id": "65734afe-d7d7-3b82-ba2d-d5c81423e41c",
                                                "text": "„Ihr verlangt einfache Trachten, enthaltsame Sitten und ungewürzte Genüsse; wir hingegen verlangen Nektar und Ambrosia, Purpurmäntel, kostbare Wohlgerüche, Wollust und Pracht, lachenden Nymphentanz, Musik und Komödien – Seid deshalb nicht ungehalten, ihr tugendhaften Republikaner! Auf eure zensorische Vorwürfe entgegnen wir euch, was schon ein Narr des Shakespeare sagte: »Meinst du, weil du tugendhaft bist, solle es auf dieser Erde keine angenehmen Torten und keinen süßen Sekt mehr geben?«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1970118f-e7f0-305b-8a7e-978a2452ea0b",
                                        "entry_id": "7ae0b18d-5961-37e1-9d8a-415121388b53",
                                        "glosses": [
                                            "von Blüten abgesonderte zuckerhaltige Flüssigkeit mit Duftstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0384279-8309-4a5b-a3e5-f93cb02603cc",
                                                "sense_id": "1970118f-e7f0-305b-8a7e-978a2452ea0b",
                                                "text": "„Nehmen wir nun an, es werde ein wenig solchen süssen Saftes oder Nektars an der inneren Basis der Kronenblätter einer Blume ausgesondert. In diesem Falle werden die Insekten, welche den Nektar aufsuchen, mit Pollen bestäubt werden und denselben gewiss oft von einer Blume auf das Stigma der andern übertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d195b1cc-d5e4-3b39-a53f-03d2ab51e038",
                                        "entry_id": "7ae0b18d-5961-37e1-9d8a-415121388b53",
                                        "glosses": [
                                            "Fruchtnektar, mit Wasser verdünnter Fruchtsaft mit Zugabe von Zucker"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54a66802-a6ae-4ed7-9c92-ba7b48e3d72f",
                                                "sense_id": "d195b1cc-d5e4-3b39-a53f-03d2ab51e038",
                                                "text": "Ein Getränk mit der Bezeichnung Nektar muss je nach Fruchtart nur zwischen 25 und 50 Prozent Fruchtsaft enthalten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
