                "senses": [
                    {
                        "sense_id": "4036acea-1104-3332-9918-f80ad62f9141",
                        "entry_id": "38e9fe29-3669-38e5-a4a0-d6b4aae0e383",
                        "glosses": [
                            "Masse, die ein Körper in einem Bezugssystem hat, in welchem er sich in Ruhe befindet"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "b7624636-4cad-466a-99ca-9f5f2713438c",
                                "sense_id": "4036acea-1104-3332-9918-f80ad62f9141",
                                "text": "„Bei der Paarvernichtung wie in der Positronen-Emissions-Tomographie wird Ruhemasse in Strahlungsenergie umgewandelt.“"
                            },
                            {
                                "example_id": "aa102917-a70b-4ada-835c-06e2a06a7bd5",
                                "sense_id": "4036acea-1104-3332-9918-f80ad62f9141",
                                "text": "„Findet die Paarbildung im Feld eines Atomkerns statt, wird nahezu die gesamte Energie des Photons in die Ruhemasse der beiden entstehenden Teilchen und ihre kinetische Energie umgewandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
