                                "target_senses": [
                                    {
                                        "sense_id": "98dd3e70-5165-3104-993a-8811220678b0",
                                        "entry_id": "dd867e61-085a-3c6b-a0a9-6f5b448b7abb",
                                        "glosses": [
                                            "Leidenschaft, Begeisterung für irgendetwas besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721ef3e3-0774-4ab0-adb1-f157e5f80331",
                                                "sense_id": "98dd3e70-5165-3104-993a-8811220678b0",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
                                            },
                                            {
                                                "example_id": "5aa8e6c9-f368-418e-adc3-c8d21f601ab5",
                                                "sense_id": "98dd3e70-5165-3104-993a-8811220678b0",
                                                "text": "Er sammelt leidenschaftlich gerne Postkarten."
                                            },
                                            {
                                                "example_id": "d385dca1-14a8-41b8-bf39-aa7f41d43834",
                                                "sense_id": "98dd3e70-5165-3104-993a-8811220678b0",
                                                "text": "„Da aber drückten sich beide leidenschaftlich die Hand, und man hörte Ardan den Präsidenten duzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d2a1ce3-e7c2-3a79-825d-eebdae52062c",
                                        "entry_id": "dd867e61-085a-3c6b-a0a9-6f5b448b7abb",
                                        "glosses": [
                                            "Leidenschaft, Begeisterung für irgendetwas besitzend",
                                            "insbesondere auf die Liebe und/oder eine bestimmte Person bezogene Leidenschaft besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70755de1-a5fa-422f-9855-8982d83948d5",
                                                "sense_id": "2d2a1ce3-e7c2-3a79-825d-eebdae52062c",
                                                "text": "Sie küssten sich leidenschaftlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    },
