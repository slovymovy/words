                                        "entry_id": "e710ded9-6d19-386c-b3e3-a3e66d291360",
                                        "glosses": [
                                            "A rectangular cloak of linen or wool, worn in Ancient Greece, usually over a chiton."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d447a3ba-9cef-4df5-8771-26ba4b3f02b4",
                                                "sense_id": "4d9b06f3-c600-3119-8342-232025329ff1",
                                                "text": "She wears a chiton and himation, using both hands to hold the edge of the latter, in which she has gathered apples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
