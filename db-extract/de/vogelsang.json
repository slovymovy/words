                ],
                "senses": [
                    {
                        "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                        "entry_id": "56ecffbb-d453-3cb1-828f-19a4c6cde330",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe4bb17-ac00-47da-ae19-a7f566001d3b",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Frau Vogelsang ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dd5dde2f-5b1d-461b-85e7-fe4c17a6ac33",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Herr Vogelsang wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "97fc8462-437c-40d6-9a3f-d85eea867367",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Die Vogelsang fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8e6ed5cb-c692-41b6-b48c-7993b6c62f73",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Der Vogelsang trägt nie die Schals, die die Vogelsang ihm strickt."
                            },
                            {
                                "example_id": "a37e14d2-9bc0-430b-beb1-b96dca3b53ee",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vogelsang kommt, geht der Herr Voglgsangs.“"
                            },
                            {
                                "example_id": "835feee2-0083-4fb4-bf8c-623c1104be62",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Vogelsang kommt und geht."
                            },
                            {
                                "example_id": "f4d844ee-6787-475d-8367-44785de5b845",
                                "sense_id": "eb2bc51f-0ae6-3496-a211-09f6a9c8e6a0",
                                "text": "Vogelsangs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
