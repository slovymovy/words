                "senses": [
                    {
                        "sense_id": "5b981b5f-6c0f-3e6d-a7a5-b230e3ff1f27",
                        "entry_id": "cebac1d7-4d00-362c-96e5-880a13d98936",
                        "glosses": [
                            "aus Gold hergestellter Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77cced8b-d24d-44b0-a7fa-ac35b2907afb",
                                "sense_id": "5b981b5f-6c0f-3e6d-a7a5-b230e3ff1f27",
                                "text": "„Durch die höheren Temperaturen werden beim Bonden mit Golddraht die Oberflächen bereits vor dem eigentlichen Bondvorgang aktiviert, sodass allein der Materialfluss durch die Verformungen des Drahtes zur Bindungsbildung ausreicht.“"
                            },
                            {
                                "example_id": "89b85843-736e-4723-b6d7-6de00448642f",
                                "sense_id": "5b981b5f-6c0f-3e6d-a7a5-b230e3ff1f27",
                                "text": "„Auf rund 100 Quadratmetern und zwei Etagen werden die aus hauchdünnem Golddraht gewobenem Wellendorff-Stücke angeboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
