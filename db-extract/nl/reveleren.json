                        "target_lang_word": "admit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                                        "entry_id": "fcc80487-e009-3636-aedc-5c44b29542a1",
                                        "glosses": [
                                            "To allow to enter; to grant entrance (to), whether into a place, into the mind, or into consideration"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac55d5d2-0dda-405d-b520-8a2bbe403287",
                                                "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                                                "text": "to admit evidence in the trial of a cause"
                                            },
                                            {
                                                "example_id": "a23019d1-76d9-4d36-b475-398829af65f7",
                                                "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                                                "text": "A ticket admits one into a playhouse."
                                            },
                                            {
                                                "example_id": "a66cfafb-3594-4423-9677-4f52e91be18e",
                                                "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                                                "text": "They were admitted into his house."
                                            },
                                            {
                                                "example_id": "1714b3a6-b1da-4a89-8947-a4aa4cf39495",
                                                "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                                                "text": "to admit a serious thought into the mind"
                                            },
                                            {
                                                "example_id": "b7c1c7f4-e21e-40c7-a927-f834b0cd32b9",
                                                "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                                                "text": "Her eyes are homes of silent prayer,\n⁠Nor other thought her mind admits\n⁠But, he was dead, and there he sits,\nAnd he that brought him back is there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e356d8-5475-369c-8645-8fcf67eb367c",
                                        "entry_id": "fcc80487-e009-3636-aedc-5c44b29542a1",
                                        "glosses": [
                                            "To allow (someone) to enter a profession or to enjoy a privilege; to recognize as qualified for a franchise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb98941-3a01-45b6-b968-4bf3d552e973",
                                                "sense_id": "f7e356d8-5475-369c-8645-8fcf67eb367c",
                                                "text": "to admit an attorney to practice law"
                                            },
                                            {
                                                "example_id": "2dfc53fa-d426-4377-93ea-3694f6c34a6a",
                                                "sense_id": "f7e356d8-5475-369c-8645-8fcf67eb367c",
                                                "text": "The prisoner was admitted to bail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                        "entry_id": "fcc80487-e009-3636-aedc-5c44b29542a1",
                                        "glosses": [
                                            "To concede as true; to acknowledge or assent to, as an allegation which it is impossible to deny (+ to)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedc8dc6-f037-4a30-a4dd-dabda579237f",
                                                "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                                "text": "the argument or fact is admitted"
                                            },
                                            {
                                                "example_id": "44efbcfa-d3c5-42a0-b494-0d32aac96ab2",
                                                "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                                "text": "He admitted his guilt."
                                            },
                                            {
                                                "example_id": "843606a6-ba9c-4a33-93c2-5657e4a0a00d",
                                                "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                                "text": "She admitted taking drugs / she admitted to taking drugs."
                                            },
                                            {
                                                "example_id": "b8e67056-004e-4a01-bc45-750a735d71f5",
                                                "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                                "text": "However, a Carlisle newspaper got hold of the story, and at the half-yearly meeting of the Caledonian Railway Company, held on March 17, 1863, a shareholder, Mr. Meiklem, questioned the Chairman, Lt.-Col. Salkeld, regarding a \"Chase of Engines,\" described in the newspaper article. The Chairman admitted that the statements made in the article were perfectly true."
                                            },
                                            {
                                                "example_id": "2f37fcf1-5c95-4624-be72-82d4241861c9",
                                                "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                                "text": "His sister, Patti, also admitted taking drugs, […]"
                                            },
                                            {
                                                "example_id": "dc048fd6-79aa-45ac-acc8-c67cecd7f269",
                                                "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                                                "text": "Police officers at a checkpoint in Bangkok's Huay Kwang district admitted to extorting 27,000 baht from a Taiwanese actress […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06f4407-4367-32de-8bad-1c0dd9d9d327",
                                        "entry_id": "fcc80487-e009-3636-aedc-5c44b29542a1",
                                        "glosses": [
                                            "To be capable of; to permit. In this sense, \\\"of\\\" may be used after the verb, or may be omitted."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf312a1-94d4-4e1f-9772-01cb493c97ff",
                                                "sense_id": "f06f4407-4367-32de-8bad-1c0dd9d9d327",
                                                "text": "The words do not admit such a construction."
                                            },
                                            {
                                                "example_id": "9377e2fc-8159-4eb4-b0ac-a1a8e7dac0fc",
                                                "sense_id": "f06f4407-4367-32de-8bad-1c0dd9d9d327",
                                                "text": "Four bells admit twenty-four changes in ringing."
                                            },
                                            {
                                                "example_id": "20c7b7d7-ca04-49d9-8747-f7ae0c96fbdc",
                                                "sense_id": "f06f4407-4367-32de-8bad-1c0dd9d9d327",
                                                "text": "There is no tree admits of transplantation so well as the Elm, for a tree of twenty years growth will admit of a remove."
                                            },
                                            {
                                                "example_id": "4ac1d97c-8c9f-4e55-bda0-ec074b988e46",
                                                "sense_id": "f06f4407-4367-32de-8bad-1c0dd9d9d327",
                                                "text": "I received a phone call last Wednesday telling me Carl Wittman had died. We had heard that he had been diagnosed several weeks before as having AIDS, but that his prognosis admitted a possible 18 more months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e7d51ed-178f-3e1a-9dd8-1d7ce4980d21",
                                        "entry_id": "fcc80487-e009-3636-aedc-5c44b29542a1",
                                        "glosses": [
                                            "To give warrant or allowance, to grant opportunity or permission."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c1c3206-00f3-4a30-8c70-46e70b099e25",
                                                "sense_id": "4e7d51ed-178f-3e1a-9dd8-1d7ce4980d21",
                                                "text": "Circumstances do not admit of this."
                                            },
                                            {
                                                "example_id": "ade80259-34da-47ca-a9cd-bdcadf4fd7c2",
                                                "sense_id": "4e7d51ed-178f-3e1a-9dd8-1d7ce4980d21",
                                                "text": "The text does not admit of this interpretation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3db43b97-b8ed-3d29-9530-c625a35208dc",
                                        "entry_id": "fcc80487-e009-3636-aedc-5c44b29542a1",
                                        "glosses": [
                                            "To allow to enter a hospital or similar facility for treatment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d145b631-63cd-43f6-a112-b953fe08b5f2",
                                                "sense_id": "3db43b97-b8ed-3d29-9530-c625a35208dc",
                                                "text": "\"This shocking report proves once again that we urgently need a radical shake-up of hospital care,\" said Jeremy Hughes, chief executive of the Alzheimer's Society. \"Given that people with dementia occupy a quarter of hospital beds and that many leave in worse health than when they were admitted, it is unacceptable that training in dementia care is not the norm.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6bdaf3c-509b-4d0f-8491-8030a1547153",
                        "source_entry_id": "c30b07f9-669d-3f30-add2-91d6859e236f",
                        "source_sense_id": "c8a64ad6-2d43-3a9a-9ff2-7eda6dc68d32",
                        "source_sense_description": "bekend maken, zichtbaar worden",
                        "target_lang_word": "reveal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reveal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359844ec-32ad-3437-9575-a05fdee8fabb",
                                        "entry_id": "13606e5e-1fc0-3cb7-8c0d-8da7f3dc12b1",
                                        "glosses": [
                                            "The outer side of a window or door frame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48fd8511-97f8-445b-844b-df2c6224fadb",
                                                "sense_id": "359844ec-32ad-3437-9575-a05fdee8fabb",
                                                "text": "The building has a one-story rusticated limestone base and a canopied entrance with a doorman beneath an attractive, rusticated limestone window reveal on the second floor and a very impressive and ornate limestone window reveal on the third floor flanked by female figureshttps://www.cityrealty.com/nyc/carnegie-hill/1105-park-avenue/review/7216."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                        "entry_id": "13606e5e-1fc0-3cb7-8c0d-8da7f3dc12b1",
                                        "glosses": [
                                            "A revelation; an uncovering of what was hidden in the scene or story."
                                        ],
                                        "tags": [
                                            "informal",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8684ab57-908e-4057-bac9-d33d57304d28",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "The comedian had been telling us about his sleep being disturbed by noise. Then came the reveal: he was sleeping on a bed in a department store."
                                            },
                                            {
                                                "example_id": "e61aa7dc-00c4-410b-b3f9-991eef73aa17",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "A simple dolly or crane move can be used for an effective reveal. A subject fills the frame, then with a move, something else is revealed."
                                            },
                                            {
                                                "example_id": "50426bb6-a3a2-4ede-84ef-f31561c0240e",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "Once you find out what’s going on—the girl is a “hungry,” this film’s term for zombies—it’s still interesting enough, if not quite as powerful. That’s basically what you’re in for with this British postapocalyptic survival horror tale, which starts off strong but dilutes its impact with every consecutive reveal."
                                            },
                                            {
                                                "example_id": "73989ae8-6a43-499d-87a8-a714aa1a1722",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "Even Westworld—based on a science-fiction novel where robots run amok—ended its second season with the ultimate reveal: human beings are simpler and more predictable than the artificial intelligences we create."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reveal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28af3f68-070d-319d-b59c-5b2b21307118",
                                        "entry_id": "cf173fb1-4152-39fc-a489-070f76afd27c",
                                        "glosses": [
                                            "To uncover; to show and display that which was hidden."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b14ba4d-2c40-4bbd-9cd5-1f536178f67f",
                                                "sense_id": "28af3f68-070d-319d-b59c-5b2b21307118",
                                                "text": "c. 1625, Edmund Waller, Of the Danger His Majesty (being Prince) Escaped in the Road at St Andero\nLight was the wound, the prince's care unknown, / She might not, would not, yet reveal her own."
                                            },
                                            {
                                                "example_id": "6f6bd1cd-1c0e-4573-98c3-c49de08b722b",
                                                "sense_id": "28af3f68-070d-319d-b59c-5b2b21307118",
                                                "text": "The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ad2427-707b-35bc-8253-91128cfb2a6d",
