                    },
                    {
                        "translation_id": "2fb39b40-e5dd-4abb-a272-d1927a7e0fdb",
                        "source_entry_id": "c57690bd-b0db-3b67-83f4-bdfd349ce830",
                        "source_sense_id": "225d19ea-7974-3ee9-a7b1-d886ddb950e2",
                        "target_lang_word": "Politikwissenschaftler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Politikwissenschaftler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ab6d4c3-9785-3bc7-9cbf-860a4d705eb0",
                                        "entry_id": "2a7f8d66-f552-3fa0-93d7-3fb8771e5d7d",
                                        "glosses": [
                                            "Wissenschaftler mit dem Forschungsschwerpunkt Politik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7748e5-6fb8-4db8-81a5-3274e19e9b0d",
                                                "sense_id": "5ab6d4c3-9785-3bc7-9cbf-860a4d705eb0",
                                                "text": "„Ansprechpartner für die Forscher sind weltweit nicht nur Wissenschaftskollegen, sondern auch die Vertreter der politischen Praxis, ein Feld, auf dem die Potsdamer Politikwissenschaftler über umfangreiche Erfahrungen verfügen.“"
                                            },
                                            {
                                                "example_id": "a8a09a3b-6b8d-4b7f-8b6e-1f48ed91b53b",
                                                "sense_id": "5ab6d4c3-9785-3bc7-9cbf-860a4d705eb0",
                                                "text": "„Für den Politikwissenschaftler Jonathan Moyo hatte Mugabe «keine eigenen politischen Werte».“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51916099-cc3d-465a-8f39-cbdbde417b36",
                        "source_entry_id": "c57690bd-b0db-3b67-83f4-bdfd349ce830",
                        "source_sense_id": "225d19ea-7974-3ee9-a7b1-d886ddb950e2",
                        "target_lang_word": "Politologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Politologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07af6a45-1f21-3da4-867c-83f2f6bb3964",
                                        "entry_id": "fa233c23-88bb-30c0-bfdf-126a1aacf917",
                                        "glosses": [
                                            "jemand, der sich mit dem wissenschaftlichen Studium der Politik (Politologie) befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c7fc29-13e1-4638-8319-86db001a51b2",
                                                "sense_id": "07af6a45-1f21-3da4-867c-83f2f6bb3964",
                                                "text": "„Das Ergebnis der Nationalratswahlen hat den Politologen Emmerich Tálos nur zum Teil überrascht, sagt er im Interview mit derStandard.at.“"
                                            },
                                            {
                                                "example_id": "e3cacf4a-fa5b-4c17-b212-ec9e7d9b1fc6",
                                                "sense_id": "07af6a45-1f21-3da4-867c-83f2f6bb3964",
                                                "text": "„Der amerikanische Politologe, einer der meistzitierten seines Fachs, hat ein Gelehrtenleben lang Zeugnis abgelegt für all jene, die sich den Zwängen des Staates entziehen.“"
                                            },
                                            {
                                                "example_id": "e00e8373-caa5-482d-a469-9c09f8d8ba74",
                                                "sense_id": "07af6a45-1f21-3da4-867c-83f2f6bb3964",
                                                "text": "„Der Politologe Simon Hix stellt fest, dass die Euroskeptiker ihre Strategie verändern.“"
                                            },
                                            {
                                                "example_id": "056b0d76-5c61-4827-a260-cdd3b7658790",
                                                "sense_id": "07af6a45-1f21-3da4-867c-83f2f6bb3964",
                                                "text": "„Wer auf der internationalen Bühne ein wenig näher hinschaut, kann sogar eine Art Wettrennen der Nationen beobachten, und viele Journalisten, Politologen und Politiker spekulieren darüber, welche der großen Staaten es schaffen werden, neben Amerika die zweite, dritte oder gar vierte Supermacht zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b47183f-6e14-4ad8-abbd-bc17f70c130a",
                        "source_entry_id": "c57690bd-b0db-3b67-83f4-bdfd349ce830",
