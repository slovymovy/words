                    },
                    {
                        "translation_id": "feba8392-3440-44a7-91ae-c72085fb742b",
                        "source_entry_id": "e6e56a0f-ee79-33dd-8759-7ab7c993c4c6",
                        "target_lang_word": "Refrain",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Refrain",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85f540a5-eca9-3fce-8ce4-cb4c7cb78b4c",
                                        "entry_id": "0aa0500b-052c-3ca0-bfb7-e166b86e8a71",
                                        "glosses": [
                                            "sich wiederholender Teil von Musik oder Gedichten zwischen oder nach Strophen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "916c6846-c5d3-4721-9115-fe539501625f",
                                                "sense_id": "85f540a5-eca9-3fce-8ce4-cb4c7cb78b4c",
                                                "text": "Der Refrain geht mir mittlerweile schon auf die Nerven."
                                            },
                                            {
                                                "example_id": "29d808fc-510d-4523-a3ad-0aac684732ce",
                                                "sense_id": "85f540a5-eca9-3fce-8ce4-cb4c7cb78b4c",
                                                "text": "„Die Leute stimmten in den Refrain ein, schienen jedoch unterschiedlich viel von dem Lied zu können.“"
                                            },
                                            {
                                                "example_id": "1926bd28-f739-492c-bc59-4ba812772bbc",
                                                "sense_id": "85f540a5-eca9-3fce-8ce4-cb4c7cb78b4c",
                                                "text": "„Auf diesen Refrain gehen zumeist jene Vergleiche, mit denen populäre Wissenschaftsvermittler ihren Zuschauern die Welträtsel noch weiter verrätseln.“"
                                            },
                                            {
                                                "example_id": "96597e35-8bbf-4ba2-99c1-3df86b9e082d",
                                                "sense_id": "85f540a5-eca9-3fce-8ce4-cb4c7cb78b4c",
                                                "text": "„Die alte Liedzeile, dieser verdammte Refrain durchdringt alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65cd869b-b5d4-4663-909f-588b9787611a",
                        "source_entry_id": "e6e56a0f-ee79-33dd-8759-7ab7c993c4c6",
                        "target_lang_word": "refrain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d94cd6a-45fe-30b4-b3fc-4439a27c56e8",
                                        "entry_id": "5a792eaa-73b5-3ce4-8ac9-6f6692115553",
                                        "glosses": [
                                            "To hold back, to restrain (someone or something)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79cbb193-479e-4403-94c9-fd2a521aa5ce",
                                                "sense_id": "6d94cd6a-45fe-30b4-b3fc-4439a27c56e8",
                                                "text": "Refrain thy foot from their path."
                                            },
                                            {
                                                "example_id": "6bfa6c05-3d89-4cc3-99c3-b59fdd1025d6",
                                                "sense_id": "6d94cd6a-45fe-30b4-b3fc-4439a27c56e8",
                                                "text": "The presence even for a moment among a party of debauchees of a woman endued with every quality of modesty and not less severe than beautiful refrained the humorous sallies even of the most licentious but her departure was the signal for an outbreak of ribaldry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5226f8c4-f585-37f0-a0cf-a24a1b293f80",
                                        "entry_id": "5a792eaa-73b5-3ce4-8ac9-6f6692115553",
                                        "glosses": [
                                            "To show restraint; to hold oneself back."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a1cad6-cce8-4115-9980-77ee97b91db6",
                                                "sense_id": "5226f8c4-f585-37f0-a0cf-a24a1b293f80",
                                                "text": "And nowe I saye unto you: refrayne youreselves from these men, and let them alone [...]."
                                            },
                                            {
                                                "example_id": "f5153f41-aa92-49d5-8b7e-b86bf9763285",
                                                "sense_id": "5226f8c4-f585-37f0-a0cf-a24a1b293f80",
                                                "text": "As I went down the river, all dissatisfaction at my lot passed away, and by the time Dartmouth came in view I could no longer refrain myself, but threw my cap into the air, and barely caught it from falling overboard as I shouted, \"Hurrah for merry England![…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ac744d-fc48-39a0-9a8a-d005280d4c32",
                                        "entry_id": "5a792eaa-73b5-3ce4-8ac9-6f6692115553",
                                        "glosses": [
                                            "To repress (a desire, emotion etc.); to check or curb."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6689dbb-6fd3-3709-966e-86b16c06e664",
                                        "entry_id": "5a792eaa-73b5-3ce4-8ac9-6f6692115553",
                                        "glosses": [
                                            "To stop oneself from some action or interference; to abstain; to eschew"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f7e25e4-9149-477f-a306-b3185ab671c3",
                                                "sense_id": "b6689dbb-6fd3-3709-966e-86b16c06e664",
                                                "text": "Refrain from these men, and let them alone."
                                            },
                                            {
                                                "example_id": "25fbaa9d-3b51-41ee-824c-033f05105cee",
                                                "sense_id": "b6689dbb-6fd3-3709-966e-86b16c06e664",
                                                "text": "They refrained therefrom [eating flesh] some time after."
                                            },
                                            {
                                                "example_id": "3ca9050c-5cb5-4a88-b9f9-40f521affec8",
                                                "sense_id": "b6689dbb-6fd3-3709-966e-86b16c06e664",
                                                "text": "July 5, 1731, Jonathan Swift, letter to Vanessa\nIf you knew how I struggle for a little health, what uneasiness I am at in riding and walking, and refraining from every thing agreeable to my taste"
                                            },
                                            {
                                                "example_id": "3ed01357-9b6e-4de1-9547-68e44d680cb9",
                                                "sense_id": "b6689dbb-6fd3-3709-966e-86b16c06e664",
                                                "text": "I will [...] tell you the story of what has happened to me, if you like, but you must refrain from interruptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95ff6dac-cd0f-34c5-9b57-d6aa74aa980e",
                                        "entry_id": "5a792eaa-73b5-3ce4-8ac9-6f6692115553",
                                        "glosses": [
                                            "To abstain from (food or drink)."
                                        ],
                                        "tags": [
                                            "rare",
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65055810-cc6f-42ee-9e86-9a6fd55129e6",
                                                "sense_id": "95ff6dac-cd0f-34c5-9b57-d6aa74aa980e",
                                                "text": "Who, requiring a remedy for his gout, received no other counsel than to refrain cold drink."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "refrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "381ffa21-4460-3d00-9575-7a4eaec6341a",
                                        "entry_id": "7a64d5ea-6561-3856-9a9b-bd8e1bb19c6b",
                                        "glosses": [
                                            "The chorus or burden of a song repeated at the end of each verse or stanza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf43322-d9e8-47fa-aa7f-9dac13a8e914",
                                                "sense_id": "381ffa21-4460-3d00-9575-7a4eaec6341a",
                                                "text": "For perhaps as much as thirty seconds they kept it up. It was a refrain that was often heard in moments of overwhelming emotion. Partly it was a sort of hymn to the wisdom and majesty of Big Brother, but still more it was an act of self-hypnosis, a deliberate drowning of consciousness by means of rhythmic noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0799980-c545-37bc-9f7c-c3812a5b44a8",
                                        "entry_id": "7a64d5ea-6561-3856-9a9b-bd8e1bb19c6b",
                                        "glosses": [
                                            "A much repeated comment, complaint, or saying."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51e36b36-ec1b-4407-825b-7e875b09b254",
                        "source_entry_id": "e6e56a0f-ee79-33dd-8759-7ab7c993c4c6",
                        "target_lang_word": "refrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                                        "entry_id": "c9e0e28b-2530-3eff-ae71-dfa694f8cbde",
                                        "glosses": [
                                            "Un ou plusieurs mots qui se répètent à la fin de chaque couplet d’une chanson, d’une ballade, d’un rondeau, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62bc45b-cc3c-4f10-9e57-d2391f12756c",
                                                "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                                                "text": "Et, au moment où je sors, j’entends un refrain d’opérette s’échapper de la bouche en cœur de M. Caterna."
                                            },
                                            {
                                                "example_id": "56290091-f9e9-40d6-bafd-5ae24bd6d6a8",
                                                "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                                                "text": "S’accompagnant de son gimbri, il nous chante, d’une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            },
                                            {
                                                "example_id": "a913a34a-b973-439c-97f4-54d36484d362",
                                                "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                                                "text": "Heureux comme un prince, il s’engagea dans le bois par le sentier de la Côte se tenant à quatre pour ne pas entonner son refrain favori ."
                                            },
                                            {
                                                "example_id": "afd013bf-5b2c-45c7-9529-840685f634c3",
                                                "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                                                "text": "Depuis l’Argonne de 1914, le chant d’abeilles des balles s’est inscrit dans mes circonvolutions cérébrales comme, dans la cire d’un disque, un refrain prêt à jouer dès le premier tour de manivelle […]."
                                            },
                                            {
                                                "example_id": "9a57e332-c609-42bd-b0fb-e1f2b8f259b7",
                                                "sense_id": "349213f0-ef61-32bf-a128-46979ea350dd",
                                                "text": "Il avait fait considérablement pire avec un 45 tours dont le refrain était : « Ah ce qu’il est joli le petit Rocheteau », un nanar de niveau olympique, mais tout marchait, tout se vendait, même n’importe quoi, surtout n’importe quoi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff139e1d-f8b4-35fc-93ad-1b82faec39d2",
                                        "entry_id": "c9e0e28b-2530-3eff-ae71-dfa694f8cbde",
                                        "glosses": [
                                            "Ce qu’une personne ramène sans cesse, à toute occasion, dans ses propos."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31aef30a-bc70-48ad-a10b-e415f7c6b255",
                                                "sense_id": "ff139e1d-f8b4-35fc-93ad-1b82faec39d2",
                                                "text": "« Tu devrais te marier », me disait mon père.\nPendant les dernières semaines de mes vacances à Villeneuve, c’était devenu son refrain."
                                            },
                                            {
                                                "example_id": "f90fdb43-4d91-4b22-a27f-1cd95f1f5c97",
                                                "sense_id": "ff139e1d-f8b4-35fc-93ad-1b82faec39d2",
                                                "text": "Qu’il suffise de dire que c’était le moment où « la paix négociée » était le refrain rabâché par les ennemis de l’Angleterre."
                                            },
                                            {
                                                "example_id": "9891b93e-045a-4201-9a5a-7ea265f6cd9b",
                                                "sense_id": "ff139e1d-f8b4-35fc-93ad-1b82faec39d2",
                                                "text": "Oui, oui, on connaît bien ce discours. C’est le vieux refrain de l’éducation progressiste. Mais on a déjà essayé de l’appliquer et ça n’a pas marché."
                                            },
                                            {
                                                "example_id": "c6ab96a8-64cf-43b1-9e0c-c654b55d6997",
                                                "sense_id": "ff139e1d-f8b4-35fc-93ad-1b82faec39d2",
                                                "text": "Je passai les heures qui suivirent à rédiger des missives à ce joueur de golf. Monsieur Saito rythmait ma production en la déchirant, sans autre commentaire que ce cri qui devait être un refrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2859452c-6705-3e11-89a0-ed8e2d9dba08",
                                        "entry_id": "c9e0e28b-2530-3eff-ae71-dfa694f8cbde",
                                        "glosses": [
                                            "Retour des houles ou grosses vagues qui viennent se briser contre les rochers."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
