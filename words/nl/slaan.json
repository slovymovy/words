                    "sense_definition": "Iemand of iets met kracht raken, meestal met de hand of een voorwerp.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>sloeg</w> met zijn vuist hard op de tafel.",
                            "target_lang_translations": {
                                "ru": "Он сильно <w>ударил</w> кулаком по столу.",
                                "en": "He <w>hit</w> the table hard with his fist.",
                                "it": "Ha <w>battuto</w> con forza il pugno sul tavolo.",
                                "fr": "Il a fort <w>frappé</w> le poing sur la table."
                            }
                        },
                        {
                            "text": "Je mag je kleine broertje nooit zomaar <w>slaan</w>.",
                            "target_lang_translations": {
                                "ru": "Нельзя просто так <w>бить</w> своего младшего братика.",
                                "en": "You must never just <w>hit</w> your little brother.",
                                "it": "Non devi mai <w>picchiare</w> il tuo fratellino senza motivo.",
                                "fr": "Tu ne dois jamais <w>frapper</w> ton petit frère comme ça."
                            }
                        }
                    ],
                    "synonyms": [
                        "meppen"
                    ],
                    "common_phrases": [
                        "iemand slaan",
                        "hard slaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять кого-то или что-то с силой, обычно рукой или предметом.",
                        "en": "To touch someone or something with force, usually with the hand or an object.",
                        "it": "Colpire qualcuno o qualcosa con forza, di solito con la mano o con un oggetto.",
                        "fr": "Frapper quelqu'un ou quelque chose avec force, généralement avec la main ou un objet."
