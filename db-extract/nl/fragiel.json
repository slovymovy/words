                ],
                "senses": [
                    {
                        "sense_id": "de5be6da-99c1-3dd5-888f-95bea784d3c8",
                        "entry_id": "49042013-799c-31e6-b5dd-52fec85300ce",
                        "glosses": [
                            "kwetsbaar, breekbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcedb81c-5214-486e-9690-b553c7c9f943",
                                "sense_id": "de5be6da-99c1-3dd5-888f-95bea784d3c8",
                                "text": "Het slanke meisje leek zeer fragiel maar toen het erop aankwam bleek ze toch heel sterk te zijn."
                            },
                            {
                                "example_id": "f712a45e-2cd2-4653-a49c-59d700fc4e40",
                                "sense_id": "de5be6da-99c1-3dd5-888f-95bea784d3c8",
                                "text": "Vaticaancorrespondent Andrea Vreede: \"Op deze tweede paasdag had werkelijk niemand verwacht dat opeens dit bericht zou komen over het overlijden van de paus. Gisteren leek het immers alsof hij terug was. Ook al was hij ontzettend kwetsbaar en fragiel, de paus was aanwezig. Hij was zelfs in staat om een beetje te spreken, al leek hij vermoeid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "923c6af1-8b9d-46c7-8b0c-9d46266fb517",
                        "source_entry_id": "49042013-799c-31e6-b5dd-52fec85300ce",
                        "source_sense_id": "de5be6da-99c1-3dd5-888f-95bea784d3c8",
                        "source_sense_description": "kwetsbaar, breekbaar",
                        "target_lang_word": "fragile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1495066c-fb0d-31f2-aeb1-94279ddb1ba8",
                                        "entry_id": "f9d84a7b-1e20-35b4-a05b-ac8cf17914af",
                                        "glosses": [
                                            "Easily broken, not sturdy; of delicate material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb317c8-a517-479b-9eea-4e0feddee877",
                                                "sense_id": "1495066c-fb0d-31f2-aeb1-94279ddb1ba8",
                                                "text": "She caught the fragile vase before it could shatter on the floor."
                                            },
                                            {
                                                "example_id": "5c03f5c4-040e-4668-a2b3-35dee89cc65b",
                                                "sense_id": "1495066c-fb0d-31f2-aeb1-94279ddb1ba8",
                                                "text": "The chemist synthesizes a fragile molecule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f1677d5-0cb2-3daa-ba00-870d5d25c821",
                                        "entry_id": "f9d84a7b-1e20-35b4-a05b-ac8cf17914af",
                                        "glosses": [
                                            "Readily disrupted or destroyed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2277d64-61d4-4301-8417-ebf782bb73ee",
                                                "sense_id": "7f1677d5-0cb2-3daa-ba00-870d5d25c821",
                                                "text": "The UN tries to maintain the fragile peace process in the region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c7cf58a-dfe8-3918-8d10-754c98472c8d",
                                        "entry_id": "f9d84a7b-1e20-35b4-a05b-ac8cf17914af",
                                        "glosses": [
                                            "Feeling weak or easily disturbed as a result of illness."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "511488ba-9bf4-3df3-8a57-9f945578c6c9",
                                        "entry_id": "f9d84a7b-1e20-35b4-a05b-ac8cf17914af",
                                        "glosses": [
                                            "Thin-skinned or oversensitive."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31c1b11-21b3-4070-b27d-1f4d069dc5d6",
                                                "sense_id": "511488ba-9bf4-3df3-8a57-9f945578c6c9",
                                                "text": "He is a very fragile person and gets easily depressed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fragile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aad88ae5-d34e-3221-afc1-554808df2346",
                                        "entry_id": "8070e33c-3243-33c0-bc75-bea9c2eb07b9",
                                        "glosses": [
                                            "Something that is fragile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f4442ac-bdda-45a8-af4b-d6823caa9cb0",
                        "source_entry_id": "49042013-799c-31e6-b5dd-52fec85300ce",
                        "source_sense_id": "de5be6da-99c1-3dd5-888f-95bea784d3c8",
                        "source_sense_description": "kwetsbaar, breekbaar",
                        "target_lang_word": "fragile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui se rompt ou se brise facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359a154d-582c-4490-8a87-22402ae9e962",
                                                "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                                "text": "Le verre est une structure rigide, fragile en raison de tensions internes; des vibrations, un léger choc, un échauffement ponctuel peuvent suffire à provoquer une rupture."
                                            },
                                            {
                                                "example_id": "101b6f25-10df-4f9c-b4a1-c7251ecdc5ef",
                                                "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                                "text": "Il faut noter qu'à l'issue de l'opération de dégourdi, la céramique est très fragile et difficile à manipuler, car formée uniquement d'un agglomérat de grains pas ou peu liés entre eux."
                                            },
                                            {
                                                "example_id": "c4f0833b-8fd0-4011-b2fb-26128640e5b5",
                                                "sense_id": "7eaa5e03-4ea3-3c2b-8338-15617635c91d",
                                                "text": "Elle sursauta, voulut pivoter dans sa direction, et son coude heurta la fragile pyramide de gâteaux à la broche qui s’effondra dans un bruit sourd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui manque de robustesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab4118b-1842-43e8-9cd6-720a836b8873",
                                                "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                                "text": "Un froid mouillé touchait sa paume, le mince corps se tordait au béement de la gueule translucide, si fragile que l'hameçon dont elle était percée semblait un croc de bronze monstrueux."
                                            },
                                            {
                                                "example_id": "3294b016-6371-4b28-85aa-ca2fb9b3c28a",
                                                "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                                "text": "Mais c’était une jeune fille d’environ vingt-deux, vingt-quatre ans, fine, svelte, de taille moyenne, d’une apparence un peu fragile, peut-être, dans ce ciré noir et luisant au col relevé et à la ceinture serrée sur une taille de guêpe."
                                            },
                                            {
                                                "example_id": "9d6c55db-128a-43b5-8603-4423f6d4c343",
                                                "sense_id": "6e119a6c-a4de-3dc7-a062-f51376b4f4d0",
                                                "text": "Tout incitait donc un auteur de romans, à l'époque où Jane Austen commençait à écrire les siens, à dépeindre une héroïne à la santé fragile et à la beauté délicate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui n’est pas solidement établi, qui peut aisément être détruit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce43bba8-0c35-4bdf-847d-4f80e0983ab7",
                                                "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                                "text": "Le développement de la société occidentale était le triomphe de l’indépendance de l’homme et de sa puissance. Et voilà que soudain, au XXᵉ siècle, on a vu — avec quelle netteté ! — que cette société était fragile et bâtie sur des précipices."
                                            },
                                            {
                                                "example_id": "a5bc35a9-91aa-4f26-8bf2-1d96561a1d39",
                                                "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                                "text": "La mémoire est fragile, car elle est sujette à des troubles, notamment dans le cadre des maladies de la mémoire ; mais la mémoire normale est aussi fragile par essence, car la représentation de l'événement est destinée à être modifiée, au fil du temps, […]."
                                            },
                                            {
                                                "example_id": "fc6038f4-de06-4d28-ba43-c919e68f0df4",
                                                "sense_id": "ba28abbb-1112-331a-83c5-75caf9f850ba",
                                                "text": "La définition de l’OCDE est particulièrement topique, […]. Dans son rapport de 2011, il est écrit qu’un État fragile est celui qui « n’a qu’une faible capacité à effectuer les fonctions essentielles qui consistent à gouverner une population et son territoire et n’a pas la capacité de développer des relations constructives et mutuellement avantageuses avec la société. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                        "entry_id": "3c1ab167-be1d-3076-a086-8fcf5b7d9eb8",
                                        "glosses": [
                                            "Qui est sujet à tomber en faute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccf7d86-43c5-4181-8ba5-86f8fb75c598",
                                                "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                                "text": "Aujourd'hui, on voit apparaître la notion d'enfant fragile, une notion très large et pouvant englober beaucoup de choses en rapport avec un enfant qui découvre le monde et qui a besoin d'être soutenu et accompagné."
                                            },
                                            {
                                                "example_id": "e9f13948-0118-4e01-84e3-9963ad9d6818",
                                                "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                                "text": "On a voulu distinguer hors les villes une gamme continue de types d'espaces de la banlieue aux espaces fragiles en passant par les campagnes dynamiques et les campagnes profondes."
                                            },
                                            {
                                                "example_id": "05eca8ff-dd74-4867-a526-f5809ab9cba2",
                                                "sense_id": "cfae2472-9227-3aad-a673-a80ce5b711e9",
                                                "text": "Esprit fragile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fragile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                        "entry_id": "3b039500-d196-3fef-b529-9884884a7408",
                                        "glosses": [
                                            "Personne considérée comme émotive à l’excès."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e22236-1359-4dd1-bd60-92a5e70e356d",
                                                "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                                "text": "Azzedine est un jeune homme sensible et émotif. Largué par sa copine alors même qu’il la demandait en mariage, il est effondré malgré les tentatives de ses copains de lui remonter le moral. \"Toi t’es un fragile\", lui répètent-ils."
                                            },
                                            {
                                                "example_id": "b2557307-d82c-4d59-b491-4107d67ebc4d",
                                                "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                                "text": "T’es qu’un, t’es qu’un, t’es qu’un fragile\nT’es pas un mec, t’es pas viril"
                                            },
                                            {
                                                "example_id": "a3bbad1a-dbc5-438a-a376-4c48187534ac",
                                                "sense_id": "8f87bfb4-1d64-34bb-91cb-e2f9c64d9a14",
                                                "text": "Tous les films où j’ai pleuré comme un fragile (ou plus sérieusement, eu une bonne larme à l’œil), mais j’assume totalement !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c958c51-c59d-4b49-884f-af7d12c05984",
                        "source_entry_id": "49042013-799c-31e6-b5dd-52fec85300ce",
                        "source_sense_id": "de5be6da-99c1-3dd5-888f-95bea784d3c8",
                        "source_sense_description": "kwetsbaar, breekbaar",
                        "target_lang_word": "frêle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frêle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                        "entry_id": "65f3f60f-81a5-36ab-9496-f48432def2ab",
                                        "glosses": [
                                            "Qui a peu de solidité, de résistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c65ef17-60d4-4782-a0b0-944174f87c5c",
                                                "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                                "text": "[…]; elle est bien frêle et sèche, mais à peine nerveuse et, en dépit du laconisme de ses repas, elle se porte très bien, n’est même jamais souffrante ; […]."
                                            },
                                            {
                                                "example_id": "180ad57d-3eae-439c-8f2a-6525b0ff8d49",
                                                "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                                "text": "Le fils aîné de Mariette est à la guerre. Avec elle est restée sa bru, la frêle, taciturne et héroïque Anne-Marie, […]."
                                            },
                                            {
                                                "example_id": "fc572403-9cc0-4522-aa5f-5523eb76c80f",
                                                "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                                "text": "Nous n’étions pas nous-mêmes à l’abri des plus grandes frayeurs ; un de ces débris pouvait nous atteindre et engloutir notre frêle nacelle."
                                            },
                                            {
                                                "example_id": "77b5ef98-3131-404c-9d76-1bce02000e43",
                                                "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                                "text": "Je ne vous réponds pas que ma vieille et frêle machine puisse durer jusqu'au printemps."
                                            },
                                            {
                                                "example_id": "7dbdf6de-855f-4cd5-9c45-de1b09928216",
                                                "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                                "text": "Toujours prêt à sortir de ma frêle prison [mourir],\nJ’en veux du moins sortir en sage."
                                            },
                                            {
                                                "example_id": "4401fc80-7c62-4585-919d-0664e5c05856",
                                                "sense_id": "eefb3674-4577-3c51-8ef9-c31086e8c0d7",
                                                "text": "Un frêle appui guide ses pas pesants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998503db-7469-314a-901e-324028dc4c22",
                                        "entry_id": "65f3f60f-81a5-36ab-9496-f48432def2ab",
                                        "glosses": [
                                            "Fragile, instable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570860f6-64c3-445f-a702-899842793908",
                                                "sense_id": "998503db-7469-314a-901e-324028dc4c22",
                                                "text": "Mettant toujours ma frêle existence à l’ombre de vos ailes."
                                            },
                                            {
                                                "example_id": "1c7ce769-7e48-40cc-a5a5-a3cb777e2431",
                                                "sense_id": "998503db-7469-314a-901e-324028dc4c22",
                                                "text": "Délicate et frêle, elle avait besoin de cet homme énergique, […], pour la soutenir dans la vie et la sauvegarder de sa toute puissante protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc9bc22-9c95-3e9b-8420-57e0425eeb8c",
                                        "entry_id": "65f3f60f-81a5-36ab-9496-f48432def2ab",
                                        "glosses": [
                                            "De peu d’importance ; menu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c70b5b-966e-4627-85d6-828ef3344d30",
                                                "sense_id": "dbc9bc22-9c95-3e9b-8420-57e0425eeb8c",
                                                "text": "La beauté du visage est un frêle ornement."
                                            },
                                            {
                                                "example_id": "6e3f9105-6a8c-47f7-b1c5-7d450f11a5d8",
                                                "sense_id": "dbc9bc22-9c95-3e9b-8420-57e0425eeb8c",
                                                "text": "Tandis que l’ennemi, par ma fuite trompé,\nTenait après son char un vain peuple occupé,\nEt, gravant en airain ses frêles avantages,\nDe mes États conquis enchaînait les images."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
