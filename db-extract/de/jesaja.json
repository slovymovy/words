                            {
                                "example_id": "f7f9a58b-8312-4ba8-9b53-be4635c54815",
                                "sense_id": "cd003d04-db50-3e3f-bae1-87bb8f377dc7",
                                "text": "„Das Buch Jesaja […] ist mit seinen 66 Kap. das umfangreichste Buch der hinteren bzw. späteren Propheten […]“"
