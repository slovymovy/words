                        "glosses": [
                            "A proposition adopted by a majority of votes, especially by the vote of the Athenian people; a statute."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5f4f6f52-9d72-4e35-bee5-67fe5c853ed6",
                                "sense_id": "2795c904-2246-301d-b7de-fae1f967147e",
                                "text": "No psephism shall pass to the commons before the senate's supervisal. The tablets on which the psephisms are engraved are by no means to be removed."
                            },
                            {
                                "example_id": "8e22a7b7-9d1e-402c-9ce7-c588c8492887",
                                "sense_id": "2795c904-2246-301d-b7de-fae1f967147e",
                                "text": "The well-known story of the Spartan psephism quoted by Boethius de musica, via. that the Spartans ordered him to cut off four of his eleven strings […] is contradicted by the present text"
                            }
                        ]
                    }
