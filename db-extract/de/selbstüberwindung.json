                "senses": [
                    {
                        "sense_id": "7d55352e-d6cd-3aae-9ac7-be1209ea8e23",
                        "entry_id": "ce67e1b3-e492-3f92-922b-a21a567a097f",
                        "glosses": [
                            "Besiegen der eigenen Hemmungen (zum Beispiel Ängste)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "397f4930-b0f7-42f4-92bd-f0965ea12a6e",
                                "sense_id": "7d55352e-d6cd-3aae-9ac7-be1209ea8e23",
                                "text": "„Die benediktinische Art der Selbstüberwindung geschieht vornehmlich im geduldigen Ertragen der kleinen Unannehmlichkeiten des täglichen Lebens.“"
                            },
                            {
                                "example_id": "3d938591-97f6-4fd8-ae9a-e09f8e5e89a3",
                                "sense_id": "7d55352e-d6cd-3aae-9ac7-be1209ea8e23",
                                "text": "„Bildung bedeutet in diesem Sinn den Versuch einer Selbstüberwindung, gerade auch da, wo sich Schwächen zeigen.“"
                            },
                            {
                                "example_id": "1889b9ca-42a1-4e47-a972-4558de9178ab",
                                "sense_id": "7d55352e-d6cd-3aae-9ac7-be1209ea8e23",
                                "text": "„Selbstüberwindung bedeutet, den Schmerz der Aufgabe in Kauf zu nehmen und es trotzdem zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
