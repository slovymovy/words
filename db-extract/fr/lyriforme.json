                        "glosses": [
                            "Qui a une forme de lyre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "291841bb-e9c2-4347-b9cd-25d05e405030",
                                "sense_id": "8a19f5c0-b9b4-32bd-b98b-bad478bcff0a",
                                "text": "Huit signes lyriformes incisés sont disposés côte à côte sous une large rainure horizontale."
                            },
                            {
                                "example_id": "8478a1a9-d5d5-453b-98af-d4025f8d9135",
                                "sense_id": "8a19f5c0-b9b4-32bd-b98b-bad478bcff0a",
                                "text": "Dans les écureuils l’estomac est en général lyriforme, le grand cul-de-sac très-profond."
                            },
                            {
                                "example_id": "2d1fe86b-4d27-443d-8f11-c57ef7f2dec9",
                                "sense_id": "8a19f5c0-b9b4-32bd-b98b-bad478bcff0a",
                                "text": "LYRIFORME, adj., lyriformis (lyra, lyre, forma, forme) ; qui a la forme d’une lyre, comme les feuilles de l’Arabis lyrafolia."
                            },
                            {
                                "example_id": "9636fce1-5c33-4849-adc1-41548d24201f",
                                "sense_id": "8a19f5c0-b9b4-32bd-b98b-bad478bcff0a",
                                "text": "Après deux semaines, l’embryon humain, comme celui des autres mammifères, a la forme d’un simple disque lyriforme, se continuant, sur le côté abdominal, avec la paroi de la vésicule blastodermique."
                            }
                        ]
                    }
