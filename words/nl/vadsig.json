{
    "word_family": [
        "vadsigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cad7818c-b679-370f-993e-194db2afa064",
                    "sense_definition": "Zwaarlijvig en traag of lui; papperig en dik.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van weinig beweging en ongezond eten had hij een <w>vadsig</w> postuur gekregen.",
                            "target_lang_translations": {
                                "en": "After years of little exercise and unhealthy eating, he had developed a <w>flabby</w> physique."
                            }
                        },
                        {
                            "text": "De striptekenaar tekende de corrupte politicus als een <w>vadsige</w> kat die op een berg geld lag.",
                            "target_lang_translations": {
                                "en": "The cartoonist drew the corrupt politician as a <w>bloated</w> cat lying on a pile of money."
                            }
                        }
                    ],
                    "synonyms": [
                        "papperig",
                        "zwaarlijvig",
                        "moddervet"
                    ],
                    "antonyms": [
                        "slank",
                        "atletisch"
                    ],
                    "common_phrases": [
                        "vadsig postuur",
                        "vadsige kat"
                    ],
                    "target_lang_definitions": {
                        "en": "Flabby, obese, and sluggish; bloated and fat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flabby",
                                "target_lang_sense_clarification": "soft, loose, and fleshy"
                            },
                            {
                                "target_lang_word": "bloated",
                                "target_lang_sense_clarification": "swollen and fat"
                            },
                            {
                                "target_lang_word": "sluggish and obese",
                                "target_lang_sense_clarification": "heavy, slow, and overweight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebe7f3c2-3c3c-3023-affe-94756ab4ca88",
                    "sense_definition": "Traag, lui en futloos; weinig actief of energiek.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het warme en benauwde weer voelde iedereen zich loom en <w>vadsig</w>.",
                            "target_lang_translations": {
                                "en": "Because of the hot and humid weather, everyone felt languid and <w>sluggish</w>."
                            }
                        },
                        {
                            "text": "Hij lag de hele zondag in een <w>vadsige</w> toestand op de bank te slapen.",
                            "target_lang_translations": {
                                "en": "He spent the entire Sunday sleeping on the couch in a <w>lethargic</w> state."
                            }
                        }
                    ],
                    "synonyms": [
                        "loom",
                        "lui",
                        "traag",
                        "slaperig",
                        "apathisch"
                    ],
                    "antonyms": [
                        "actief",
                        "energiek",
                        "vlijtig"
                    ],
                    "common_phrases": [
                        "vadsige toestand"
                    ],
                    "target_lang_definitions": {
                        "en": "Sluggish, lazy, and listless; lacking activity or energy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sluggish",
                                "target_lang_sense_clarification": "slow-moving and lacking energy"
                            },
                            {
                                "target_lang_word": "lazy",
                                "target_lang_sense_clarification": "unwilling to work or use energy"
                            },
                            {
                                "target_lang_word": "listless",
                                "target_lang_sense_clarification": "lacking energy or enthusiasm"
                            },
                            {
                                "target_lang_word": "lethargic",
                                "target_lang_sense_clarification": "affected by lethargy; sluggish and apathetic"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}