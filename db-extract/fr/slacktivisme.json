                "senses": [
                    {
                        "sense_id": "ec4aad49-f965-3d81-bbfa-83b690ede1d0",
                        "entry_id": "e4fae703-0a8b-30dd-b363-29246056fd43",
                        "glosses": [
                            "Forme de militantisme sur Internet qui consiste par exemple à cliquer pour participer à un mouvement collectif virtuel, ou à signer une pétition en ligne, etc. sans s’engager plus activement et concrètement."
                        ],
                        "tags": [
                            "Anglicism",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "d97f8952-9c9a-40ba-942c-35ac075c830f",
                                "sense_id": "ec4aad49-f965-3d81-bbfa-83b690ede1d0",
                                "text": "Fusion des termes activisme et slacker (paresseux en anglais), le slacktivisme désigne une forme de militantisme allégé, pour ne pas dire moins."
                            },
                            {
                                "example_id": "a7bfc874-6daf-4e51-82f8-1653caba9cb3",
                                "sense_id": "ec4aad49-f965-3d81-bbfa-83b690ede1d0",
                                "text": "En clair, plus les “slacktivistes” sont nombreux, plus le \"slacktivisme\" aide la cause qu’il supporte."
                            }
                        ]
                    }
                ],
                "translations": [
