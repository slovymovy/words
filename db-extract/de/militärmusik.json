                "senses": [
                    {
                        "sense_id": "132f9ac6-480d-39f4-ba8b-a5bd6558dc51",
                        "entry_id": "7a3b67a2-d2e4-369f-a2ff-f8f0c17c087e",
                        "glosses": [
                            "Musik, die vom Militär und vor allem für militärische Zwecke gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24aca97c-3508-447c-96c1-b7084626d87e",
                                "sense_id": "132f9ac6-480d-39f4-ba8b-a5bd6558dc51",
                                "text": "„Militärmusik quoll aus den Lautsprechern und machte unserem Gespräch ein Ende, es war ja auch alles gesagt.“"
                            },
                            {
                                "example_id": "2d91751f-393b-4a71-942e-6af9ff94a3c0",
                                "sense_id": "132f9ac6-480d-39f4-ba8b-a5bd6558dc51",
                                "text": "„Er war noch mitten darin, als wieder von den Feldern her Hurrageschrei kam, das jetzt noch disharmonischer klang als zuvor und mit den Klängen von Militärmusik und Soldatenliedern verschmolz.“"
                            },
                            {
                                "example_id": "1385333c-9dab-4bcf-956a-f6ebfed9d310",
                                "sense_id": "132f9ac6-480d-39f4-ba8b-a5bd6558dc51",
                                "text": "„Man berichtet, daß Einstein schon als kleiner Junge in München der Militärmusik und den nach ihr marschierenden Soldaten aus dem Wege gegangen sein soll.“"
                            },
                            {
                                "example_id": "b8f93d67-2891-4c8b-bdb6-d600111f3b41",
                                "sense_id": "132f9ac6-480d-39f4-ba8b-a5bd6558dc51",
                                "text": "„Aus den Lautsprechern ergoß sich Militärmusik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e46adca-1204-41e3-b206-04590e54adc7",
                        "source_entry_id": "7a3b67a2-d2e4-369f-a2ff-f8f0c17c087e",
                        "source_sense_id": "132f9ac6-480d-39f4-ba8b-a5bd6558dc51",
                        "source_sense_description": "Musik, die vom Militär und vor allem für militärische Zwecke gemacht wird",
                        "target_lang_word": "musique militaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musique militaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                        "entry_id": "15f9bb6d-19ef-37a4-b48b-a891651e9c5b",
                                        "glosses": [
                                            "Ensemble des musiques composées pour une utilisation au cours des cérémoniaux militaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be99b33-9a3b-4542-877c-339194d0f4fa",
                                                "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                                "text": "T’sais pas qu’la musique militaire c’est c’qu’il y a de plus triste ? Eux, les musiciens, i sont là exprès pour faire passer la pilule aux soldats. I les aident à marcher, à grands coups de cymbales et d’grosse caisse."
                                            },
                                            {
                                                "example_id": "308f3980-67ed-4f64-a4fb-2880ca902534",
                                                "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                                "text": "Goethe, âgé de soixante-quinze ans, a écrit : « La musique militaire me déplie comme un poing qu’on ouvre. »"
                                            },
                                            {
                                                "example_id": "2d3f5d5b-b36b-41b4-a248-fc8a95d1dee7",
                                                "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                                "text": "La médecine militaire est à la médecine ce que la musique militaire est à la musique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
