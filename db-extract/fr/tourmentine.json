                        "glosses": [
                            "Sorte de plante aux vertus magiques."
                        ],
                        "tags": [
                            "Forez"
                        ],
                        "examples": [
                            {
                                "example_id": "54877435-62e1-4657-af50-95f2fd96fdd2",
                                "sense_id": "2d80f0e9-0fad-322c-bb1a-b2aafdcefd85",
                                "text": "Dans le Forez, si on met le pied sur une herbe, la tourmentine, on marche pendant douze heures par monts et par vaux, tant qu'on n'a pas trouvé la parisette, herbe dont les graines marquent le chemin par la direction où elles tombent."
                            },
                            {
                                "example_id": "9b14382c-59b6-43d6-a3f5-0d1a14d9dcb7",
                                "sense_id": "2d80f0e9-0fad-322c-bb1a-b2aafdcefd85",
                                "text": "HABITAT : La Tourmentine existe toujours dans toutes les forêts sauf dans les sapinières et autres endroits plantés de conifères."
                            }
                        ]
                    },
                    {
                        "sense_id": "a536f31b-b489-331b-8979-cf7731736fcb",
                        "entry_id": "7a329bf0-4815-33ac-b6b4-7bd6c2ebe9fa",
                        "glosses": [
                            "Tormentille."
