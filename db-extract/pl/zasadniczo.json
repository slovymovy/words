                        "examples": [
                            {
                                "example_id": "fa5ef6c5-ca60-4e96-b1ae-1e8e6c3ea9a4",
                                "sense_id": "31096d5d-9095-3cf5-ba82-8efb86a2604e",
                                "text": "Założenie kancelarii doradcy prawnego nie różni się zasadniczo od rejestracji firmy działającej w innej branży."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d6df2c3d-65e3-3fdd-a2ac-4eecd383e8de",
                        "entry_id": "7be44020-ac63-308d-b0b6-c084c50a2eb7",
                        "glosses": [
