                                "target_senses": [
                                    {
                                        "sense_id": "b6614a4c-c7d6-37c0-82a5-b6f4ef0bcfa0",
                                        "entry_id": "5dad28f1-0228-3573-9a46-99dc7d17ac7d",
                                        "glosses": [
                                            "die Bedeutsamkeit/Brisanz/Relevanz einer Sache mit Absicht weniger wichtig erscheinen lassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c965e18e-4310-4796-aa5c-44dbd91cf6e0",
                                                "sense_id": "b6614a4c-c7d6-37c0-82a5-b6f4ef0bcfa0",
                                                "text": "Klar kannst du das Problem verniedlichen, aber dadurch verschwindet es ja nicht. Es wird auch nicht weniger relevant."
                                            },
                                            {
                                                "example_id": "992c3ecb-21ff-46e8-abf2-7b9ee6ce9c8c",
                                                "sense_id": "b6614a4c-c7d6-37c0-82a5-b6f4ef0bcfa0",
                                                "text": "Das ist die Realität, ich beschönige und verniedliche hier nichts."
                                            },
                                            {
                                                "example_id": "ec1681e9-e0d1-4d6b-b06f-f9bd728a9c64",
                                                "sense_id": "b6614a4c-c7d6-37c0-82a5-b6f4ef0bcfa0",
                                                "text": "Der US-Präsident verniedlicht die rasant steigende Anzahl der Corona-Opfer in den USA und muss einen Tweet mit rassistischem Inhalt löschen."
                                            },
                                            {
                                                "example_id": "a07a6340-64be-40d5-ba65-faa758e1ad2c",
                                                "sense_id": "b6614a4c-c7d6-37c0-82a5-b6f4ef0bcfa0",
                                                "text": "Reinhard Kendlbacher, Vorsitzender des Bürgervereins Freising, ließ bei der Versammlung kein gutes Haar an der Flughafen GmbH, die „verniedlicht und vertuscht“ und in Hochglanzbroschüren den Eindruck vermitteln wolle, als sei die Luft rund um den Flughafen sauber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
