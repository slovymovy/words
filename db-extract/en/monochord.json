                                        "entry_id": "f86bdc2f-71c4-3217-acd4-9212b63af985",
                                        "glosses": [
                                            "Instrument de bois, de cuivre, etc., sur lequel il y a une seule corde tendue et divisée selon certaines proportions pour donner les différents intervalles des sons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e488a145-86a9-4eb9-ab94-02f6cd2df9f1",
                                                "sense_id": "85e724d2-d617-3c8d-a0cc-6a3c93051753",
                                                "text": "Diviser un monocorde."
                                            },
                                            {
                                                "example_id": "eb9c5faf-5dc2-47ee-8d85-79b64b398cec",
                                                "sense_id": "85e724d2-d617-3c8d-a0cc-6a3c93051753",
                                                "text": "Utilisant un monocorde - instrument composé d’une corde de métal ou de boyau tendu sur une règle entre deux chevalets fixes - il mesura la variété et la proportion des sons produits en faisant varier la longueur de la partie vibrante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "123b9726-2d68-34a3-963c-d7f4fb4004f2",
                                        "entry_id": "f86bdc2f-71c4-3217-acd4-9212b63af985",
                                        "glosses": [
                                            "Cithare vietnamienne à une seule corde, sans touche et munie d'un manche flexible."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
