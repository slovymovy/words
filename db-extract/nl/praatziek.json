                                    {
                                        "sense_id": "deb4a843-3d90-3a8a-9b63-20e440553455",
                                        "entry_id": "47b3ca01-1e2f-3013-8b56-71fc0dd07cfe",
                                        "glosses": [
                                            "Of a person, chatting a lot or fond of chatting."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ace82a-5d97-404d-b0d8-a83f5f8775f5",
                                                "sense_id": "deb4a843-3d90-3a8a-9b63-20e440553455",
                                                "text": "When a typically chatty employee who often participates in meetings and is engaged and enthusiastic suddenly becomes unmotivated and quieter, that person could be at risk for burnout."
                                            },
                                            {
                                                "example_id": "2525a02a-7706-4f8b-85bf-13cb2d028986",
                                                "sense_id": "deb4a843-3d90-3a8a-9b63-20e440553455",
                                                "text": "Our ticket is checked after departure by a chatty guard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cb60d2-8cea-390b-838f-b7ed42e28e40",
