                                                "example_id": "509c8710-4260-46af-be24-7a602d43605a",
                                                "sense_id": "757f6f17-7c84-3ab5-a37b-7e283bbe17e3",
                                                "text": "Man, look at that cat straining that kitty."
                                            },
                                            {
