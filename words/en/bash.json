                            },
                            {
                                "target_lang_word": "zahanbit",
                                "target_lang_sense_clarification": "vyvolat v někom pocit studu"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "avergonzar",
                                "target_lang_sense_clarification": "hacer que alguien sienta vergüenza"
                            },
                            {
                                "target_lang_word": "humillar",
                                "target_lang_sense_clarification": "herir el orgullo o la dignidad de alguien"
                            }
                        ]
                    }
