{
    "word_family": [
        "befuddlement",
        "fuddle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef86793b-0b3e-378c-a9f5-f39bf7a928b1",
                    "sense_definition": "To confuse or perplex someone thoroughly, making it difficult to think clearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex legal jargon served only to <w>befuddle</w> the jury rather than clarify the facts.",
                            "target_lang_translations": {
                                "es": "La compleja jerga legal solo sirvió para <w>confundir</w> al jurado en lugar de aclarar los hechos."
                            }
                        },
                        {
                            "text": "His unexpected answer seemed to <w>befuddle</w> the interviewer for several seconds.",
                            "target_lang_translations": {
                                "es": "Su respuesta inesperada pareció <w>desconcertar</w> al entrevistador durante varios segundos."
                            }
                        }
                    ],
                    "synonyms": [
                        "baffle",
                        "bamboozle",
                        "bemuse",
                        "bewilder",
                        "confound",
                        "confuse",
                        "flummox",
                        "perplex"
                    ],
                    "antonyms": [
                        "clarify",
                        "enlighten"
                    ],
                    "common_phrases": [
                        "befuddle the mind",
                        "befuddle the senses"
                    ],
                    "target_lang_definitions": {
                        "es": "Confundir o desconcertar a alguien por completo, dificultándole pensar con claridad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "confundir",
                                "target_lang_sense_clarification": "hacer que alguien pierda la claridad mental"
                            },
                            {
                                "target_lang_word": "desconcertar",
                                "target_lang_sense_clarification": "desorientar o dejar sin respuesta"
                            },
                            {
                                "target_lang_word": "aturdir",
                                "target_lang_sense_clarification": "nublar la capacidad de razonar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79654895-bba3-307d-b16a-79e25d5bceff",
                    "sense_definition": "To stupefy, dull, or cloud someone's mind, especially with alcohol or drugs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Too many glasses of wine had begun to <w>befuddle</w> his senses by midnight.",
                            "target_lang_translations": {
                                "es": "Demasiadas copas de vino habían empezado a <w>embotar</w> sus sentidos para la medianoche."
                            }
                        },
                        {
                            "text": "The strong medication tends to <w>befuddle</w> patients during the first few days of treatment.",
                            "target_lang_translations": {
                                "es": "La fuerte medicación tiende a <w>atontar</w> a los pacientes durante los primeros días de tratamiento."
                            }
                        }
                    ],
                    "synonyms": [
                        "addle",
                        "fuddle",
                        "stupefy"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "befuddle the brain"
                    ],
                    "target_lang_definitions": {
                        "es": "Entorpecer, atontar o nublar la mente de alguien, en especial por efecto del alcohol o las drogas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "atontar",
                                "target_lang_sense_clarification": "entorpecer los sentidos o la mente"
                            },
                            {
                                "target_lang_word": "embotar",
                                "target_lang_sense_clarification": "debilitar o entorpecer los sentidos o el entendimiento"
                            },
                            {
                                "target_lang_word": "aturdir",
                                "target_lang_sense_clarification": "causar confusión o aturdimiento físico o mental"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}