                                        "glosses": [
                                            "Terrain qui borde un fleuve, une rivière, un étang ou un lac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3df77df-5888-423a-bad5-38a988f0879d",
                                                "sense_id": "314a7512-4b2f-3621-ab69-aab0968a43d6",
                                                "text": "La rive droite d’une rivière, d’un fleuve, est la rive qui est à droite d’une personne qui descend le cours de l’eau."
                                            },
                                            {
                                                "example_id": "d5b3ac2e-c202-4d05-98e4-9c40ed09d3ff",
                                                "sense_id": "314a7512-4b2f-3621-ab69-aab0968a43d6",
                                                "text": "Démocrite aurait trouvé aux rives du Jourdain et aux grèves de la mer Morte un aspect enchanteur."
                                            },
                                            {
                                                "example_id": "86e67baa-7410-4368-a659-af3ebfababa9",
                                                "sense_id": "314a7512-4b2f-3621-ab69-aab0968a43d6",
                                                "text": "L’artillerie américaine établie sur la rive ouest de chaque côté de nos positions bat le fleuve entièrement et interdit tout trafic."
                                            },
                                            {
                                                "example_id": "59baaca8-600b-46a4-8beb-aa7e1f099e3d",
                                                "sense_id": "314a7512-4b2f-3621-ab69-aab0968a43d6",
                                                "text": "Discussion technique sur la confusion fréquente entre rive et berge : la berge est le talus incliné en contact direct avec la rivière ; la rive est la bande de terre qui commence au faîte de la berge."
                                            }
                                        ]
                                    },
