                        "sense_id": "e9f05f5e-6981-344e-ae18-5f6a7722e0b6",
                        "entry_id": "9dddb439-db3a-3a8a-9db7-c9b59198be94",
                        "glosses": [
                            "A polysaccharide that is the main form of carbohydrate storage in animals; converted to glucose as needed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6cad596f-bbf8-44a2-b1a3-9a4294b5e9c5",
                                "sense_id": "e9f05f5e-6981-344e-ae18-5f6a7722e0b6",
                                "text": "Specifically the liver converts glucose into glycogen — a more compact chemical. It is a little bit like shrink-wrapping food so you can pack more of it into your freezer."
                            }
                        ]
                    }
                ],
                "translations": [
