                                "target_senses": [
                                    {
                                        "sense_id": "1ea80904-942d-3936-9483-11bf3d1572b2",
                                        "entry_id": "bbd85099-1419-3957-aa5d-ff375a0a65cc",
                                        "glosses": [
                                            "zřícenina, rozvalina"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db72e173-efaf-423f-8833-a2cc30e01302",
                                                "sense_id": "1ea80904-942d-3936-9483-11bf3d1572b2",
                                                "text": "Družina rozložila se po zbořených síních a výklencích ruiny, toliko náčelník zůstal schýlen nad plamenem ohniště."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf2c8077-5bff-3cde-bbc7-42c4e29bc3ad",
                                        "entry_id": "bbd85099-1419-3957-aa5d-ff375a0a65cc",
                                        "glosses": [
                                            "zchátralý tvor, troska"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8ff389-5bcc-4343-95ad-cef0acfe3eed",
                                                "sense_id": "cf2c8077-5bff-3cde-bbc7-42c4e29bc3ad",
                                                "text": "Nebyla to ovšem ta strašná ruina, kterou v divadle Michodière vytvořila Marguerite Moréno, téměř tragická ošklivostí a chtivostí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feb7478f-46c1-4d39-8441-dc488ad9dc6d",
                        "source_entry_id": "826f9fb9-d664-3693-8ce5-201c2d328b8d",
                        "source_sense_id": "8dea086e-b6ce-3f29-a977-3e1cfc3e93ef",
                        "target_lang_word": "décombres",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décombres",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                        "entry_id": "c9b2fe81-6332-3d39-b045-65c351e82887",
                                        "glosses": [
                                            "Amas de matériaux inutiles qui restent sur le terrain après la démolition d’un bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29b12453-2254-48c1-b99c-2d7360fdf80c",
                                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                                "text": "[…], et tantôt louvoyant, tantôt escaladant, car le chemin était parsemé d’entassements de décombres, ils arrivèrent non sans peine à la muraille indiquée par le Cornouaillais."
                                            },
                                            {
                                                "example_id": "c7cd1739-fea7-480c-af1e-462372200f34",
                                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                                "text": "Son enfance s’était écoulée là, dans les ruines grises, parmi les décombres et la poussière d’un passé dont elle ignorait tout."
                                            },
                                            {
                                                "example_id": "372471ac-7ceb-4c7e-a5b3-09c83aaf81eb",
                                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                                "text": "Une affreuse paix régna sur ces décombres que tous avaient abandonnés."
                                            },
                                            {
                                                "example_id": "9ad320b2-395e-46d6-a0c9-f41bbaf5cfc3",
                                                "sense_id": "819c86e2-525b-3f40-a2fb-1499fa9c117e",
                                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
