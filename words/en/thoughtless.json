{
    "word_family": [
        "think",
        "thought",
        "thoughtful",
        "thoughtfully",
        "thoughtfulness",
        "thoughtlessly",
        "thoughtlessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c665d640-0d3b-31c6-8dbd-ae92ab5b325f",
                    "sense_definition": "Not showing consideration or care for the feelings and needs of other people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inconsiderate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>thoughtless</w> of you to play loud music while your sister was sleeping.",
                            "target_lang_translations": {
                                "es": "Fue muy <w>desconsiderado</w> de tu parte poner música fuerte mientras tu hermana dormía."
                            }
                        },
                        {
                            "text": "His <w>thoughtless</w> comment hurt her feelings, even though he had not meant to be rude.",
                            "target_lang_translations": {
                                "es": "Su comentario <w>inconsiderado</w> hirió sus sentimientos, aunque no había tenido la intención de ser grosero."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless"
                    ],
                    "antonyms": [
                        "thoughtful",
                        "considerate"
                    ],
                    "common_phrases": [
                        "thoughtless remark",
                        "thoughtless comment",
                        "thoughtless behavior"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no muestra consideración o cuidado por los sentimientos y necesidades de los demás."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "inconsiderado",
                                "target_lang_sense_clarification": "falto de consideración hacia los demás"
                            },
                            {
                                "target_lang_word": "desconsiderado",
                                "target_lang_sense_clarification": "que no tiene en cuenta a otras personas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b890917-1c6b-3937-9fbc-d554411f7a3e",
                    "sense_definition": "Characterized by a lack of proper thought, reflection, or care; done without thinking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "careless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>thoughtless</w> decision made in a rush could ruin all our hard work.",
                            "target_lang_translations": {
                                "es": "Una decisión <w>irreflexiva</w> tomada con prisa podría arruinar todo nuestro arduo trabajo."
                            }
                        },
                        {
                            "text": "The meeting quickly turned into <w>thoughtless</w> bickering that solved none of our problems.",
                            "target_lang_translations": {
                                "es": "La reunión se convirtió rápidamente en una disputa <w>sin sentido</w> que no resolvió ninguno de nuestros problemas."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless",
                        "mindless"
                    ],
                    "antonyms": [
                        "thoughtful",
                        "deliberate"
                    ],
                    "common_phrases": [
                        "thoughtless action",
                        "thoughtless decision"
                    ],
                    "target_lang_definitions": {
                        "es": "Caracterizado por la falta de reflexión o cuidado adecuado; hecho sin pensar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "irreflexivo",
                                "target_lang_sense_clarification": "hecho o dicho sin meditar"
                            },
                            {
                                "target_lang_word": "descuidado",
                                "target_lang_sense_clarification": "falto de atención o cautela"
                            },
                            {
                                "target_lang_word": "imprudente",
                                "target_lang_sense_clarification": "sin pensar en las consecuencias"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}