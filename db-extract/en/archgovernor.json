                        "glosses": [
                            "A chief governor."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b5543c43-29aa-4bf7-93ad-c4941b8a49b6",
                                "sense_id": "935caed5-0f2a-3801-93a3-31929d8f9e52",
                                "text": "What then shall I say here, O ye principal posts of religion, O ye archgovernors of Christ’s church?"
                            },
                            {
                                "example_id": "5ac86a77-06da-42a9-8ff1-e999fcf34b92",
                                "sense_id": "935caed5-0f2a-3801-93a3-31929d8f9e52",
                                "text": "“Your ladyship,” answered the page, “is the most worthy wife of a thrice worthy archgovernor, and as proof of this truth, take this letter and this present.”"
                            },
                            {
                                "example_id": "5fe508b8-ea21-42ae-83cb-2ca2923e0049",
                                "sense_id": "935caed5-0f2a-3801-93a3-31929d8f9e52",
                                "text": "Imagine the reaction, then, when New Yorkers learned in 1688 that their colony (as well as New Jersey) had been annexed, by royal fiat, to the Dominion of New England (a megacolony created by James II two years before). Imagine the anxiety in August 1688 when Edmund Andros returned to New York as archgovernor of the dominion, thereby supplanting Dongan, who had been recalled."
                            }
                        ]
                    }
