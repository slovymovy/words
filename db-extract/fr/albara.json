                        "glosses": [
                            "Une des villes mortes du Jebel Riha au nord-ouest de la Syrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099686b9-d7ff-4a66-a0e7-5a3a303c442f",
                                "sense_id": "5524e73c-b946-336a-974d-7dc9b3d9dcae",
                                "text": "Après avoir soumis celte ville, et tous les environs, qu'il unit à son domaine , il assembla ses chapelains et les principaux de son conseil, et nomma de leur avis un évoque Latin à Albara, choisit pour cela un ecclésiastique de son armée nommé Pierre, natif de Narbonne, qui se fit sacrer à Antioche."
                            }
                        ]
