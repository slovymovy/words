                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guideline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e60e0ec8-233a-3c4d-9287-a3f6913fe66f",
                                        "entry_id": "93908121-9142-3379-99d0-5edb995eaa87",
                                        "glosses": [
