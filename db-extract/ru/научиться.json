                        "entry_id": "6d2c70c9-b114-3301-8cfb-8162bed781d7",
                        "glosses": [
                            "to learn (often not in an academic setting)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161476dc-e969-4c8b-8030-74718213a7cd",
                                "sense_id": "f008c047-bbac-3712-9f90-5059f4be4599",
                                "text": "Я научи́лся печь.",
                                "translation": "I learnt how to bake.",
                                "english": "I learnt how to bake."
                            },
                            {
                                "example_id": "1e70fff4-811b-4174-a70a-41dbd1aa0406",
                                "sense_id": "f008c047-bbac-3712-9f90-5059f4be4599",
                                "text": "Он научи́лся поли́тике.",
                                "translation": "He learnt politics.",
                                "english": "He learnt politics."
                            },
                            {
                                "example_id": "17946b6d-822b-44cf-bef4-fe075c785842",
                                "sense_id": "f008c047-bbac-3712-9f90-5059f4be4599",
                                "text": "Ей на́до научи́ться защища́ться.",
                                "translation": "She needs to learn to protect herself.",
                                "english": "She needs to learn to protect herself."
                            }
                        ]
                    }
