                                            {
                                                "example_id": "2bcf34b8-6f0d-4312-baba-9e8680bfb7e6",
                                                "sense_id": "49eacd12-3e32-3833-9928-40bec74a00a6",
                                                "text": "“‘What are the gaieties of the Rich, the splendours of the Powerful, what is the pride of the Great, what are the gaudy pleasures of High Society?’”"
                                            },
                                            {
                                                "example_id": "41f58ed4-ee1c-48b8-9d7f-9a20ac5af6c7",
                                                "sense_id": "49eacd12-3e32-3833-9928-40bec74a00a6",
                                                "text": "Exclusive nightclubs are out of style with me / 'Cause I don't associate with high society"
