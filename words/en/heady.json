{
    "word_family": [
        "head"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a9f1cd19-70e9-3df8-a669-f7181e428140",
                    "sense_definition": "Causing intoxication or a feeling of being lightheaded.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cocktail was a <w>heady</w> mixture of strong spirits.",
                            "target_lang_translations": {
                                "nl": "De cocktail was een <w>bedwelmend</w> mengsel van sterke drank."
                            }
                        },
                        {
                            "text": "The <w>heady</w> scent of the flowers filled the warm summer air.",
                            "target_lang_translations": {
                                "nl": "De <w>bedwelmende</w> geur van de bloemen vulde de warme zomerlucht."
                            }
                        }
                    ],
                    "synonyms": [
                        "intoxicating",
                        "potent"
                    ],
                    "common_phrases": [
                        "heady mixture",
                        "heady scent"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat bedwelmend werkt of een licht gevoel in het hoofd veroorzaakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bedwelmend",
                                "target_lang_sense_clarification": "verwijzend naar een sterke, roesopwekkende geur of drank"
                            },
                            {
                                "target_lang_word": "sterk",
                                "target_lang_sense_clarification": "verwijzend naar de krachtige werking van een drank"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0edcb99-7f0a-37e1-a52a-7a9c17f3dedb",
                    "sense_definition": "Causing great excitement or exhilaration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team enjoyed the <w>heady</w> success of winning the championship.",
                            "target_lang_translations": {
                                "nl": "Het team genoot van het <w>opwindende</w> succes van het winnen van het kampioenschap."
                            }
                        },
                        {
                            "text": "They lived through the <w>heady</w> days of the revolution.",
                            "target_lang_translations": {
                                "nl": "Zij maakten de <w>opwindende</w> dagen van de revolutie mee."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhilarating",
                        "thrilling"
                    ],
                    "common_phrases": [
                        "heady success",
                        "heady days"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat grote opwinding of euforie veroorzaakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opwindend",
                                "target_lang_sense_clarification": "verwijzend naar een gevoel van grote vreugde of succes"
                            },
                            {
                                "target_lang_word": "euforisch",
                                "target_lang_sense_clarification": "verwijzend naar een staat van grote opwinding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542f9ff4-1d14-3b59-9225-33fff14b7f29",
                    "sense_definition": "Requiring significant intellectual effort or deep thought.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor assigned some <w>heady</w> reading for the philosophy seminar.",
                            "target_lang_translations": {
                                "nl": "De professor gaf wat <w>intellectueel</w> leesvoer op voor het filosofieseminarie."
                            }
                        },
                        {
                            "text": "The debate became quite <w>heady</w> as they discussed complex economic theories.",
                            "target_lang_translations": {
                                "nl": "Het debat werd nogal <w>cerebraal</w> toen ze complexe economische theorieën bespraken."
                            }
                        }
                    ],
                    "synonyms": [
                        "intellectual",
                        "cerebral"
                    ],
                    "common_phrases": [
                        "heady reading"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat veel intellectuele inspanning of diep nadenken vereist."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "intellectueel",
                                "target_lang_sense_clarification": "verwijzend naar complexe of diepzinnige materie"
                            },
                            {
                                "target_lang_word": "cerebraal",
                                "target_lang_sense_clarification": "verwijzend naar een puur verstandelijke benadering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dec357b-ff74-3b20-a15b-aa414c7ea8ec",
                    "sense_definition": "Acting without thinking; impulsive or reckless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made such <w>heady</w> promises that he could not possibly keep them.",
                            "target_lang_translations": {
                                "nl": "Hij deed zulke <w>overhaaste</w> beloftes dat hij ze onmogelijk kon nakomen."
                            }
                        },
                        {
                            "text": "The young leader made a <w>heady</w> decision that cost the company dearly.",
                            "target_lang_translations": {
                                "nl": "De jonge leider nam een <w>roekeloos</w> besluit dat het bedrijf duur kwam te staan."
                            }
                        }
                    ],
                    "synonyms": [
                        "rash",
                        "impetuous",
                        "reckless"
                    ],
                    "antonyms": [
                        "cautious"
                    ],
                    "target_lang_definitions": {
                        "nl": "Handelen zonder na te denken; impulsief of roekeloos."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overhaast",
                                "target_lang_sense_clarification": "verwijzend naar beslissingen zonder reflectie"
                            },
                            {
                                "target_lang_word": "roekeloos",
                                "target_lang_sense_clarification": "verwijzend naar onbezonnen gedrag"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af8f7496-bead-3cc0-bb50-04d6df270838",
                    "sense_definition": "Causing a feeling of dizziness or vertigo.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We looked down from the <w>heady</w> height of the mountain cliff.",
                            "target_lang_translations": {
                                "nl": "We keken naar beneden vanaf de <w>duizelingwekkende</w> hoogte van de bergklif."
                            }
                        },
                        {
                            "text": "The view from the skyscraper was <w>heady</w> and slightly frightening.",
                            "target_lang_translations": {
                                "nl": "Het uitzicht vanaf de wolkenkrabber was <w>duizelingwekkend</w> en een beetje beangstigend."
                            }
                        }
                    ],
                    "synonyms": [
                        "dizzying"
                    ],
                    "common_phrases": [
                        "heady height"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gevoel van duizeligheid of hoogtevrees veroorzakend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "duizelingwekkend",
                                "target_lang_sense_clarification": "verwijzend naar grote hoogtes of intense ervaringen"
                            }
                        ]
                    }
                }
            ]
        },
        {
