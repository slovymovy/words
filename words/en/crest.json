        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56f9551a-ea09-3c22-ae4e-a839778fbd53",
                    "sense_definition": "To reach the top of a hill or mountain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reach_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers cheered as they <w>crested</w> the mountain peak.",
                            "target_lang_translations": {
                                "ru": "Туристы закричали от радости, когда <w>взобрались на</w> горную вершину.",
                                "de": "Die Wanderer jubelten, als sie den Berggipfel <w>erklommen</w>."
                            }
                        },
                        {
                            "text": "We <w>crested</w> the hill and saw the beautiful valley below.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поднялись на гребень</w> холма и увидели внизу прекрасную долину.",
                                "de": "Wir <w>erreichten die Kuppe</w> des Hügels und sahen das wunderschöne Tal unter uns."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crest the hill",
                        "crest the ridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь вершины холма или горы.",
                        "de": "Die Spitze oder den Kamm eines Hügels oder Berges erreichen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выйти на гребень",
                                "target_lang_sense_clarification": "подняться наверх"
                            },
                            {
                                "target_lang_word": "достичь вершины",
                                "target_lang_sense_clarification": "горы или холма"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erklimmen",
                                "target_lang_sense_clarification": "den Gipfel oder Kamm erreichen"
                            },
                            {
                                "target_lang_word": "erreichen",
                                "target_lang_sense_clarification": "die Kuppe oder den Kamm erreichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6ac4800-590e-3ddf-97e1-13aaba18adbd",
                    "sense_definition": "To rise to a peak or highest level, especially regarding waves or floodwaters.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reach_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is expected to <w>crest</w> at midnight before the water level drops.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что уровень реки <w>достигнет пика</w> в полночь, прежде чем вода спадёт.",
                                "de": "Es wird erwartet, dass der Fluss um Mitternacht seinen <w>Höchststand erreicht</w>, bevor der Wasserpegel sinkt."
                            }
                        },
                        {
                            "text": "The wave <w>crested</w> and crashed onto the sandy beach.",
                            "target_lang_translations": {
                                "ru": "Волна <w>вздыбилась</w> и обрушилась на песчаный пляж.",
                                "de": "Die Welle <w>türmte sich auf</w> und brach sich am Sandstrand."
                            }
                        }
