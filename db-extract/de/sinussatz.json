                "senses": [
                    {
                        "sense_id": "03c4cf45-680c-3518-8a27-066e4b8fd096",
                        "entry_id": "2547e8c5-9099-3042-8f38-016a20eb8e05",
                        "glosses": [
                            "Lehrsatz der Trigonometrie, der die Beziehung zwischen den Winkeln eines allgemeinen Dreiecks und den jeweils gegenüberliegenden Seiten beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a6f4c6-2da9-46f2-af82-6b2cb0d1cdf6",
                                "sense_id": "03c4cf45-680c-3518-8a27-066e4b8fd096",
                                "text": "„In der Astronomie wird insbesondere die sphärische Trigonometrie -hier gelten entsprechende Varianten von Cosinussatz und Sinussatz im Kugeldreieck - gebraucht.“"
                            },
                            {
                                "example_id": "f5ddd044-fe9e-4254-9ee1-2a3ea704473b",
                                "sense_id": "03c4cf45-680c-3518-8a27-066e4b8fd096",
                                "text": "„Auf einer Hügelfestung beim heutigen Islamabad entwickelte er eine Technik, mit einem Astrolabium, sphärischer Geometrie und dem Sinussatz den Umfang der Erde zu bestimmen.“"
                            }
                        ],
