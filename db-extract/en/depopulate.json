                    {
                        "translation_id": "3216c5e4-e546-47dd-a30b-f416deadb219",
                        "source_entry_id": "8ced28ee-e663-3d5b-8b27-9532e57f0519",
                        "source_sense_description": "to reduce the population of a region by disease, war, forced relocation etc.",
                        "target_lang_word": "dépeupler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépeupler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a9be74-d3dd-38b2-9414-f193fd5f4244",
                                        "entry_id": "33f5a8a6-d678-3c8c-8ab8-e535e02ffa2f",
                                        "glosses": [
                                            "Dégarnir d’habitants une ville, un pays, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1eef18-d15a-4be3-a692-5c44d38e7feb",
                                                "sense_id": "a6a9be74-d3dd-38b2-9414-f193fd5f4244",
                                                "text": "Puis, peu à peu, la place se dépeupla, et l’angelus sonnant midi, ceux qui demeuraient trop loin se répandirent dans les auberges."
                                            },
                                            {
                                                "example_id": "7f6b8b59-41d6-4a72-8404-c508a1e366cb",
                                                "sense_id": "a6a9be74-d3dd-38b2-9414-f193fd5f4244",
                                                "text": "Tout le monde dit que la France se dépeuple, qu'il naît de moins en moins d'enfants, et que l’Allemagne, dont la population augmente toujours, finira par avoir deux fois autant de soldats que nous."
                                            },
                                            {
                                                "example_id": "ffd22156-1006-43ed-a279-6107249e5b65",
                                                "sense_id": "a6a9be74-d3dd-38b2-9414-f193fd5f4244",
                                                "text": "L'usine Michelin s'installa de 1890 à 1892. Et c'est durant ces années qu'on vit Clermont-Ferrand grossir subitement, tandis que les campagnes se dépeuplaient, périclitaient."
                                            },
                                            {
                                                "example_id": "3f08b4c8-6911-4de6-a0e0-ccf67064dd49",
                                                "sense_id": "a6a9be74-d3dd-38b2-9414-f193fd5f4244",
                                                "text": "Les deux frères roulaient à travers des rues que la guerre et la nuit dépeuplaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf718ea-6eda-3c96-bce7-b5791b2c0649",
                                        "entry_id": "33f5a8a6-d678-3c8c-8ab8-e535e02ffa2f",
                                        "glosses": [
                                            "Dégarnir d'animaux un élevage, un territoire de chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c6d748-d835-4e44-aa8a-fb5eab169aa9",
                                                "sense_id": "5cf718ea-6eda-3c96-bce7-b5791b2c0649",
                                                "text": "Dépeupler un pays de gibier."
                                            },
                                            {
                                                "example_id": "98ad30b8-02c3-478d-b368-39ddfd058636",
                                                "sense_id": "5cf718ea-6eda-3c96-bce7-b5791b2c0649",
                                                "text": "Dépeupler un colombier de pigeons, un étang de poissons."
                                            },
                                            {
                                                "example_id": "b9075fb1-2ed6-4cf0-a923-df9eba14ee45",
                                                "sense_id": "5cf718ea-6eda-3c96-bce7-b5791b2c0649",
                                                "text": "Cette garenne commence à se dépeupler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34795d6-d532-3013-8ee7-365dd6b221e0",
                                        "entry_id": "33f5a8a6-d678-3c8c-8ab8-e535e02ffa2f",
                                        "glosses": [
                                            "Abattre tous les animaux d'un troupeau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c843663-5c49-4595-9e45-e1f4962dbdba",
                                                "sense_id": "f34795d6-d532-3013-8ee7-365dd6b221e0",
                                                "text": "Dépeupler des élevages contaminés par la fièvre catarrhale ovine n’a donc aucun sens, il y a trop de bêtes contaminées autour, souligne François Schelcher, professeur de pathologie du bétail à l’Ecole nationale vétérinaire de Toulouse. La dermatose nodulaire contagieuse, elle, a justement été classée en catégorie A, car il est possible de viser l’éradication immédiate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baddae63-55de-38ac-86e0-faba3313b871",
                                        "entry_id": "33f5a8a6-d678-3c8c-8ab8-e535e02ffa2f",
                                        "glosses": [
                                            "Dégarnir une forêt, une pépinière, en en tirant une trop grande quantité d’arbres ou de plants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
