                    {
                        "sense_id": "f74ca7f1-58fe-353c-90c6-31557f3a799c",
                        "entry_id": "2a7882f1-e159-363b-8402-2d543a6d045a",
                        "glosses": [
                            "Se transformer par une réaction chimique d’autocondensation."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "f7a90b32-a310-4e7f-bc90-dd6a6a3a7ffd",
                                "sense_id": "f74ca7f1-58fe-353c-90c6-31557f3a799c",
                                "text": "En outre, si on envisage de réaliser une condensation mixte, l’un des partenaires de la réaction (l’ester, s’il n'y en a qu’un seul) doit être dans l’impossibilité de s’autocondenser (par ex., il doit être dépourvu d’hydrogène en a)."
                            },
                            {
                                "example_id": "ba43eddf-6b7d-4f41-b437-452febf38288",
                                "sense_id": "f74ca7f1-58fe-353c-90c6-31557f3a799c",
                                "text": "L'oxyde de mésityle peut s’autocondenser de la même manière (71)."
                            }
                        ]
                    }
