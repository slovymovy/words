                                                "example_id": "a541edc1-33ed-4763-983d-42ddb6336c80",
                                                "sense_id": "7d6de8ef-7434-33af-a83a-e76b5e9cdb82",
                                                "text": "Do Sejmu niedawno strażnik służbista nie chciał go wpuścić, bo nie miał wejściówki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47d01626-bb6e-44c6-9212-0097a1add185",
                        "source_entry_id": "9599b579-9829-3d72-97e7-b6fd6bccc69b",
                        "source_sense_description": "военный",
                        "target_lang_word": "soudard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soudard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                        "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                                        "glosses": [
                                            "Homme qui a longtemps servi à la guerre et qui est brutal, grossier."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45a5b768-c368-478c-a813-aba825310daf",
                                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                                "text": "Peu s’en fallut que ne pleurassent\nLes soudards et les écoliers\nEnfants, voici les bœufs qui passent,\nCachez vos rouges tabliers ;"
                                            },
                                            {
                                                "example_id": "890f7683-7095-4fde-bfc8-4f24831be490",
                                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                                "text": "— D’ailleurs, cette petite, hé ! bien, nous la verrons, dit le colonel d’un air goguenard et profondément scélérat qui montrait à un homme de la trempe de Vinet combien une petite fille était peu de chose aux yeux de ce soudard."
                                            },
                                            {
                                                "example_id": "dbcd617b-9a7f-4973-966f-5005df8df921",
                                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                                "text": "Ce qu’il voit encore, ce sont des soudards qui, […], criblent de coups d’arquebuse un oiseau de bois fiché à la pointe d’un mai."
                                            },
                                            {
                                                "example_id": "7b9c273d-5c3f-42ea-bb90-3dc0c81589a1",
                                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                                "text": "Gnassingbé Eyadema : champion de lutte, puis soudard de la coloniale en Algérie (où il mania la gégène)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6951c8a-058f-32d3-837a-e02d808327c7",
                                        "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                                        "glosses": [
                                            "Soldat, mercenaire, homme de troupe rémunéré."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fc14a1d-3c40-487e-8cfd-f9762e2d1b10",
                                                "sense_id": "b6951c8a-058f-32d3-837a-e02d808327c7",
                                                "text": "Et puis donna à chasque bende force moutons pour sacrifier, et cinquante drachmes d'argent à chaque soudard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soudard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dda96d0-f568-3776-939a-2944d348f9a5",
                                        "entry_id": "88210ac6-61ba-3715-986b-0b8c7376590e",
                                        "glosses": [
                                            "Qui a le comportement d’un homme de guerre brutal et grossier."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "882e164a-312b-46f7-b1e1-7d93998c60bc",
                                                "sense_id": "5dda96d0-f568-3776-939a-2944d348f9a5",
                                                "text": "Leurs franchises soudardes cachaient un délicieux trouble de cœur ; et c’était, en même temps qu’un regret, une espérance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
