                        "sense_id": "380d69c1-7e77-31f8-ae59-63da52527e9b",
                        "entry_id": "ae94fee9-1c8e-3e0e-9d1c-f3fbd77c52e0",
                        "glosses": [
                            "Celle qui sale."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "a22675ad-7d62-4fe2-8ae0-0f96e1f3ff13",
                                "sense_id": "380d69c1-7e77-31f8-ae59-63da52527e9b",
                                "text": "Les lots choisis et achetés sont aussitôt saupoudrés de sel par des saleuses qui représentent là une industrie spéciale. Quand le sel gagné par la femme ne suffit pas, on en achète d’autre, et la voiture part, chargée de 10 000 sardines pour un voyage de huit jours […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "04c5ed62-3bf6-3471-9767-566989875127",
                        "entry_id": "ae94fee9-1c8e-3e0e-9d1c-f3fbd77c52e0",
                        "glosses": [
                            "Véhicule utilisé pour faire fondre la neige ou le verglas sur les routes en y répandant du sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad65611b-4f27-472c-a7bb-f48683a1ae2f",
                                "sense_id": "04c5ed62-3bf6-3471-9767-566989875127",
                                "text": "Il était bien difficile de faire passer la saleuse sur toutes ces petites routes et ces chemins presque agricoles."
                            },
                            {
                                "example_id": "b9713799-9432-44a7-a4b4-0fd0cd463e93",
                                "sense_id": "04c5ed62-3bf6-3471-9767-566989875127",
                                "text": "C’est toute une richesse d’avoir des déneigeuses, des saleuses, des pneus d’hiver, des maisons isolées, des systèmes de chauffage et pour plusieurs, des foyers."
                            }
                        ]
                    }
