                        ],
                        "examples": [
                            {
                                "example_id": "b83d08a6-1d93-4ad9-87e3-39b173df53d6",
                                "sense_id": "de6e9d21-0222-3502-9a9d-e0f2788a6066",
                                "text": "Onder welken de naarstige en kundige Beeldhouwer ZIESENIS, door het konstig beitelen van twee deftige Standbeelden, op de Hofstede van den Heer Raadpensionaris STEIN, zig reeds een regtmaatigen lof verworven heft."
                            }
                        ]
                    }
