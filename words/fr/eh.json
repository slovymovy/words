                    "sense_definition": "Exclamation marquant la surprise, l'admiration, l'étonnement ou introduisant une réaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Eh</w> bien, je ne m'attendais vraiment pas à vous voir ici ce matin !"
                        },
                        {
                            "text": "<w>Eh</w> ! Qui aurait pu imaginer un résultat aussi spectaculaire après tant d'efforts ?"
                        }
                    ],
                    "synonyms": [
                        "ah",
                        "oh"
                    ],
                    "common_phrases": [
                        "eh bien",
                        "eh oui",
                        "eh non"
