{
    "word_family": [
        "shelf",
        "shelving"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8b261a70-a951-3e49-9df8-7aa1b9237d91",
                    "sense_definition": "Having shelves installed or attached.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shelved</w> wall unit provides plenty of space for all our books.",
                            "target_lang_translations": {
                                "nl": "De <w>van planken voorziene</w> wandkast biedt voldoende ruimte voor al onze boeken."
                            }
                        },
                        {
                            "text": "We need a <w>shelved</w> cabinet to organize the kitchen supplies properly.",
                            "target_lang_translations": {
                                "nl": "We hebben een <w>kast met schappen</w> nodig om de keukenspullen goed te organiseren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fully shelved"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van planken of schappen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorzien van planken",
                                "target_lang_sense_clarification": "Beschrijft een meubelstuk of muur met aangebrachte schappen."
                            },
                            {
                                "target_lang_word": "met schappen",
                                "target_lang_sense_clarification": "Eenvoudige aanduiding voor een object dat planken bevat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a10dd6d-35cf-3d4d-915f-45c0455f8910",
                    "sense_definition": "Postponed or put aside indefinitely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postponement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was <w>shelved</w> due to a lack of funding.",
                            "target_lang_translations": {
                                "nl": "Het project werd <w>in de ijskast gezet</w> vanwege een gebrek aan financiering."
                            }
                        },
                        {
                            "text": "Plans for the new park were <w>shelved</w> until next year.",
                            "target_lang_translations": {
                                "nl": "Plannen voor het nieuwe park werden <w>op de lange baan geschoven</w> tot volgend jaar."
                            }
                        }
                    ],
                    "synonyms": [
                        "on ice"
                    ],
                    "common_phrases": [
                        "permanently shelved"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voor onbepaalde tijd uitgesteld of in de ijskast gezet."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "op de lange baan geschoven",
                                "target_lang_sense_clarification": "Idiomatische uitdrukking voor het uitstellen van plannen."
                            },
                            {
                                "target_lang_word": "in de ijskast gezet",
                                "target_lang_sense_clarification": "Figuurlijk voor het tijdelijk stopzetten van een project."
                            },
                            {
                                "target_lang_word": "opgeschort",
                                "target_lang_sense_clarification": "Formeler woord voor het tijdelijk staken van activiteiten."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b4a7d0b-f23e-3e71-a4be-6c421edfd38e",
                    "sense_definition": "Simple past and past participle of <w>shelve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>shelved</w> the heavy boxes in the storage room.",
                            "target_lang_translations": {
                                "nl": "Ze <w>zette</w> de zware dozen <w>op de planken</w> in de opslagruimte."
                            }
                        },
                        {
                            "text": "The committee has <w>shelved</w> the proposal for further discussion.",
                            "target_lang_translations": {
                                "nl": "De commissie heeft het voorstel <w>uitgesteld</w> voor verdere discussie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb shelve."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van 'op planken zetten' of 'uitstellen'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "op planken gezet",
                                "target_lang_sense_clarification": "Fysieke handeling van het plaatsen van objecten op een plank."
                            },
                            {
                                "target_lang_word": "uitgesteld",
                                "target_lang_sense_clarification": "De handeling van het stopzetten van een plan of voorstel."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}