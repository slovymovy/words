                        "glosses": [
                            "A former Hebrew liquid measure of volume (about 3.8 L)."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "44fb5d4a-cdbf-4347-9449-fba9c5dbe866",
                                "sense_id": "62f26ef7-6b77-39fc-b5b8-48768a83e236",
                                "text": "500 shekels of cassia — all according to the sanctuary shekel — and a hin of olive oil."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9933d9a-eb86-3c11-8371-ca7d9f4a9ca3",
                        "entry_id": "a459e18f-56fa-32fc-98ca-8c43e2070f7b",
                        "glosses": [
                            "An Ancient Egyptian liquid measure of volume (about 0.48 L)."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2d25d933-84bb-4a08-b9ee-634f73921e35",
                                "sense_id": "f9933d9a-eb86-3c11-8371-ca7d9f4a9ca3",
                                "text": "The hin for liquids was subdivided dimidially down to ¹⁄₃₂ = 1 ro."
                            }
                        ]
                    }
                ],
