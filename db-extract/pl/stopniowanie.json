                                    {
                                        "sense_id": "679d50d5-f281-31b4-bbad-dbec2e515f37",
                                        "entry_id": "f9130bde-40d5-37f0-ad99-0261720df690",
                                        "glosses": [
                                            "A sequence of gradual, successive stages; a systematic progression."
                                        ],
                                        "tags": [
