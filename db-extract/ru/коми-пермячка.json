                                "example_id": "23217460-cead-40ec-88ed-82f47d03ac92",
                                "sense_id": "73069155-2133-3f89-b7c3-53574b3ae327",
                                "text": "Северные коми-пермячки носили однорогие кокошники, а южные — шамшуры (самшуры)."
                            }
                        ]
                    }
