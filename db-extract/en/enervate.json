                        "target_lang_word": "verzwakken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzwakken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                                        "entry_id": "01f8c6b9-d361-3bdc-be47-f8d03f19f532",
                                        "glosses": [
                                            "zwakker maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "222ce236-1333-464c-a3a6-3b64cc8c459c",
                                                "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                                                "text": "Het weinige slapen zal hun weerstand verzwakken."
                                            },
                                            {
                                                "example_id": "3a6c1319-397b-4e22-91d0-fb0ba66a9825",
                                                "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                                                "text": "Volgens hem heeft het stadsleven veel van onze zintuigen verzwakt en door ze te reactiveren en een met de natuur te worden, zou ik voor een groot deel op mezelf moeten kunnen vertrouwen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d42d133a-dec8-3e7b-bee2-7cace37c9321",
                                        "entry_id": "01f8c6b9-d361-3bdc-be47-f8d03f19f532",
                                        "glosses": [
                                            "zwakker worden"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e2df0f4-22c3-4bcb-a5f8-3590e1282527",
                                                "sense_id": "d42d133a-dec8-3e7b-bee2-7cace37c9321",
                                                "text": "Zij verzwakken door een tekort aan slaap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3cd4a43-5e0b-40e8-87b8-8a355d6d9d2b",
                        "source_entry_id": "7ac49e3f-15b0-334c-b27e-6e1ae0ad7fe9",
                        "source_sense_description": "to reduce strength or energy",
                        "target_lang_word": "affaiblir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affaiblir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                        "entry_id": "af70c5dd-16f3-3a3a-991a-8595459412e0",
                                        "glosses": [
                                            "Rendre faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7530c776-79e4-494c-8cef-e310f9a81fb7",
                                                "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                                "text": "les réformes de Henry II, en affaiblissant les nobles, les avaient rapprochés de leurs tenants. Entre le manoir et le village, les conflits devenaient plus rares."
                                            },
                                            {
                                                "example_id": "f118ed32-0667-4491-aaaa-3498423e6c6d",
                                                "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                                "text": "Et semblablement ce sera affaiblir les monnaies, si leur cours demeure invariable, que de diminuer leur poids ou d’abaisser leur titre."
                                            },
                                            {
                                                "example_id": "1a067e3d-3d1a-4165-999b-fad66c9b49c9",
                                                "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                                "text": "L'essentiel pour les jésuites, c'était d’affaiblir, d'amoindrir, de rendre les âmes faibles et fausses, de faire des petits très-petits, et les simples idiots ; une âme nourrie de minuties, amusées de brimborions, devait être facile à conduire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                        "entry_id": "af70c5dd-16f3-3a3a-991a-8595459412e0",
                                        "glosses": [
                                            "Devenir plus faible."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9de5e0-3567-477d-89c8-0c99ee6657dd",
                                                "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                                "text": "Il s’affaiblit."
                                            },
                                            {
                                                "example_id": "021728b9-abf9-4a75-85de-918b75b501e2",
                                                "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                                "text": "Son esprit, sa tête s’affaiblit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae787682-5d2f-495e-8dab-bf3626ac7511",
                        "source_entry_id": "7ac49e3f-15b0-334c-b27e-6e1ae0ad7fe9",
                        "source_sense_description": "to reduce strength or energy",
                        "target_lang_word": "schwächen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwächen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1ded37-9a95-3882-87cc-69c3f7a85087",
                                        "entry_id": "bf1e0a16-18c4-3152-92f5-c4d8102d9795",
                                        "glosses": [
                                            "schwach machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113aefdf-1ad3-452e-8b90-e05d4ad0f228",
                                                "sense_id": "4e1ded37-9a95-3882-87cc-69c3f7a85087",
                                                "text": "„Von den Nationalsozialisten wurde dieser Begriff missbräuchlich entlehnt mit der Absicht, das Bewusstsein für Österreich als selbständiges Territorium und politisches Gefüge zu schwächen und über die Betonung der historischen Bedeutung im alten Reich ein Zugehörigkeitsgefühl zum Deutschen Reich herauszubilden.“"
                                            },
                                            {
                                                "example_id": "b7d73c70-b858-4848-8665-fda6ea93e852",
                                                "sense_id": "4e1ded37-9a95-3882-87cc-69c3f7a85087",
                                                "text": "„Der EU-Zentralismus schwächt die Demokratie: Je weiter entfernt von den Betroffenen Entscheidungen fallen, um so geringer die Möglichkeit, auf diese Einfluss zu nehmen, um so schwächer die demokratische Legitimation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
