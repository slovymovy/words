{
    "word_family": [
        "access",
        "accessible",
        "inaccessible",
        "inaccessibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b6c06e0-618b-371c-aced-47ed1812b8b4",
                    "sense_definition": "The quality of being easy to approach, reach, enter, or use.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "approachability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new ramp significantly improves the <w>accessibility</w> of the building for wheelchair users.",
                            "target_lang_translations": {
                                "ru": "Новый пандус значительно улучшает <w>доступность</w> здания для людей на инвалидных колясках."
                            }
                        },
                        {
                            "text": "The city is working on improving public transport <w>accessibility</w> for all residents.",
                            "target_lang_translations": {
                                "ru": "Город работает над улучшением <w>доступности</w> общественного транспорта для всех жителей."
                            }
                        }
                    ],
                    "antonyms": [
                        "inaccessibility"
                    ],
                    "common_phrases": [
                        "improve accessibility",
                        "public transport accessibility",
                        "easy accessibility",
                        "ensure accessibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, характеризующее легкость подхода, достижения, входа или использования чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доступность",
                                "target_lang_sense_clarification": "возможность доступа или использования"
                            },
                            {
                                "target_lang_word": "досягаемость",
                                "target_lang_sense_clarification": "физическая возможность добраться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3baecd88-7aad-36c7-b091-c9d02b632b78",
                    "sense_definition": "Design features that make technology or environments usable by people with disabilities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inclusive_design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer focused on web <w>accessibility</w> to ensure the site was screen-reader friendly.",
                            "target_lang_translations": {
                                "ru": "Разработчик сосредоточился на <w>веб-доступности</w>, чтобы сайт корректно работал с программами чтения с экрана."
                            }
                        },
                        {
                            "text": "Modern operating systems include various <w>accessibility</w> features like voice control and high contrast modes.",
                            "target_lang_translations": {
                                "ru": "Современные операционные системы включают различные <w>специальные</w> <w>возможности</w>, такие как голосовое управление и режимы высокой контрастности."
                            }
                        }
                    ],
                    "synonyms": [
                        "a11y"
                    ],
                    "common_phrases": [
                        "web accessibility",
                        "accessibility features",
                        "accessibility standards",
                        "digital accessibility"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in technical or design contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особенности проектирования, делающие технологии или окружающую среду удобными для людей с ограниченными возможностями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специальные возможности",
                                "target_lang_sense_clarification": "функции ПО для людей с инвалидностью"
                            },
                            {
                                "target_lang_word": "доступность",
                                "target_lang_sense_clarification": "инклюзивность среды или интерфейса"
                            },
                            {
                                "target_lang_word": "универсальный дизайн",
                                "target_lang_sense_clarification": "проектирование для всех категорий граждан"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}