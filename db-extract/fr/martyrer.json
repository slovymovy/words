                "senses": [
                    {
                        "sense_id": "80122944-cd77-3889-8afc-5e45beb8ec7a",
                        "entry_id": "66b5727c-c0f3-34ab-9235-695a819cf1f5",
                        "glosses": [
                            "Faire souffrir le martyre ; martyriser."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bde18377-bf48-4c93-86fe-ff3e5b4e655c",
                                "sense_id": "80122944-cd77-3889-8afc-5e45beb8ec7a",
                                "text": "Le malade que brûle et cuit\nUne fièvre qui le martyre,\nAutant le jour comme la nuit,\nSans cesse la santé désire."
                            },
                            {
                                "example_id": "3b92bb42-2b4d-4f48-b023-7e68b680f4b3",
                                "sense_id": "80122944-cd77-3889-8afc-5e45beb8ec7a",
                                "text": "Cette âme si lasse le matin me martyre d'une ardeur en flamme."
                            }
                        ]
                    }
                ],
