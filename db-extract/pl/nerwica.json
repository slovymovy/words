                                    {
                                        "sense_id": "15809732-ebca-39b4-84cf-8ff9e4c7645a",
                                        "entry_id": "cf0514f7-0724-3778-bc1e-582d91f632f3",
                                        "glosses": [
                                            "A mental disorder, less severe than psychosis, marked by anxiety or fear which differ from normal measures by their intensity, which disorder results from a failure to compromise or properly adjust during the developmental stages of life, between normal human instinctual impulses and the demands of human society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6de07b1-9663-4ebf-b6ad-0f6d7584eb24",
                                                "sense_id": "15809732-ebca-39b4-84cf-8ff9e4c7645a",
                                                "text": "On inquiry it was found that this neurosis corresponded in time with the oncome of the catamenia."
                                            },
                                            {
                                                "example_id": "c4470df9-1c0c-4d23-b44b-7bffe3a1c832",
                                                "sense_id": "15809732-ebca-39b4-84cf-8ff9e4c7645a",
                                                "text": "In the period from Spinoza to the end of the 19th century, the reading of design into nature received such devastating attacks from naturalists to non-naturalists alike that there developed an epistemological neurosis which Von Baer aptly termed “teleophobia.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
