                "senses": [
                    {
                        "sense_id": "d1a739a1-f858-3cd7-b9d1-e0f270033a1a",
                        "entry_id": "27b4c911-dfc6-3d07-82e8-e71231a827c4",
                        "glosses": [
                            "Gebäude, in dem zwei verschiedene Parteien wohnen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9171e9-d0e9-4f45-8726-9400a6867f1b",
                                "sense_id": "d1a739a1-f858-3cd7-b9d1-e0f270033a1a",
                                "text": "„Auffällig ist auch, dass der Aspekt einer intakten Umwelt am Wohnort signifikant häufiger von Befragten, die in einem freistehenden Ein- oder Zweifamilienhaus leben, genannt wird.“"
                            },
                            {
                                "example_id": "de43e045-24f8-48b0-b8ed-c0128d8cc1ff",
                                "sense_id": "d1a739a1-f858-3cd7-b9d1-e0f270033a1a",
                                "text": "„Die Heizkosten in Zwei- und Mehrfamilienhäusern sind im vergangenen Jahr im Schnitt um gut 31 Prozent gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
