                "senses": [
                    {
                        "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                        "entry_id": "208704e8-af52-3e60-ae37-db6e065db599",
                        "glosses": [
                            "etwas Bitteres / Kritisches / Nachteiliges (zu einem Gegenstand / einer Person), die ein insgesamt positives Bild nachteilig beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792f942c-6f3f-4ff7-b831-6751e1ce2ef3",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Die Feier war sehr schön. Viele nette Leute waren dort und auch das Essen war hervorragend. Einziger Wermutstropfen: Es waren nicht hinreichend viele Getränke vorhanden."
                            },
                            {
                                "example_id": "59965712-2002-4c3f-959e-23143c75904e",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "„Einziger Wermutstropfen ist die trotz zahlreicher Anfragen beim Roten Kreuz vergebliche Suche nach den verschollenen Schwestern.“"
                            },
                            {
                                "example_id": "926af39b-39ca-4c71-a12e-10ae0ecc67b1",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Frauenfußball-Olympiasieger Deutschland beendet das Länderspiel-Jahr in einer intensiven Partie gegen Norwegen mit einem Teilerfolg. Ein kleiner Wermutstropfen ist die Verletzung von DFB-Kapitänin Dzsenifer Marozsan."
                            },
                            {
                                "example_id": "95caa048-f12a-4484-b0b7-593f8036071d",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Und so ist ein gut zu lesendes und spannendes Buch herausgekommen. Allerdings gibt es auch einen Wermutstropfen: Er ist halt „nur“ Physikprofessor. Wenn er sich auf fremde Fachgebiete Gebiete begibt, schwächelt sein Wissen."
                            },
                            {
                                "example_id": "473ce50b-3e62-4c9e-b453-f6965e4a59e2",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Lobenswert: Hunderte von schönen Fotos, die die Songs illustrieren. Einen Wermutstropfen gibt es: Gerade weil das Thema Beatles so gut erforscht ist, erscheinen die Texte manchmal ziemlich knapp."
                            },
                            {
                                "example_id": "2a7bc146-06f9-412c-9f66-21f879d592cd",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Entstanden ist der Bildband „Drawing Fashion“ anlässlich der gleichnamigen Ausstellung im Londoner Design Museum. Kleiner Wermutstropfen für deutsche Leser: Die einführenden Texte sind auf Englisch."
                            },
                            {
                                "example_id": "f4f56ac3-46e4-4769-9c62-4c5933ed25dd",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "[…] die Inspektion der Hornhaut mittels der neuen Lebendmikroskopie [ist] empfindlicher als eine Analyse zuvor entnommener Hautbiopsien. Ein Wermutstropfen ist, dass bisher keine Medikamente auf dem Markt sind, die im Ernstfall helfen."
                            },
                            {
                                "example_id": "9c223f5f-71a7-43a5-b2fe-fc13c1077711",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Trotz allgemeiner Skepsis wegen der momentan flauen Konjunktur gab es [auf dem Nürnberger Christkindlesmarkt] wieder zufriedene Gesichter [bei den Händlern]. […] Einen Wermutstropfen gibt es dennoch: Rechnet man in die Erträge der Händler die Inflation mit ein, ergibt sich ein leichter Umsatzrückgang."
                            },
                            {
                                "example_id": "b6c473b6-025b-412c-8461-59a1daeb2be2",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Bei BMW, der dritten Kraft der Konstrukteure, durfte man zufrieden mit dem vierten Platz von Nick Heidfeld sein; ein kleiner Wermutstropfen ist das vorzeitige Ausscheiden von Robert Kubica, dessen Getriebe im fünften Gang stecken blieb."
                            },
                            {
                                "example_id": "4fd50554-7b62-4025-b0b7-6f09cf594627",
                                "sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                                "text": "Die neue Linie, für die fast 20 km neue Gleise verlegt wurden, hält sowohl an Terminal 2 als auch an Terminal 1. Einen Wermutstropfen gibt es allerdings: Die beiden Flughafenstationen (und nur die) können nicht mehr mit der normalen T10-Zehnerkarte angefahren werden, sondern nur mit einem teuren Aeroport-Einzelticket, womit sich Barcelona in die unrühmliche Reihe der Städte wie Frankfurt am Main, Madrid und Brüssel einreiht, die Fahrten zum Flughafen künstlich verteuern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5513b4b-f1a1-42ca-824c-635b6937be30",
                        "source_entry_id": "208704e8-af52-3e60-ae37-db6e065db599",
                        "source_sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                        "target_lang_word": "disadvantage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A weakness or undesirable characteristic; con; drawback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171e49af-66f9-4007-aeb8-db815217f4d8",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "The disadvantage to owning a food processor is that you have to store it somewhere."
                                            },
                                            {
                                                "example_id": "eebef41c-d113-4c2d-b2e5-09afb7799834",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "One of the disadvantages of increasing intermediate stops is that, as we have pointed out already, certain prestige trains have to suffer, notably the \"Cornish Riviera Express\", slowed 15min to Plymouth by stops at Taunton and Exeter; the \"Torbay Express\", decelerated 18min by stops at Reading, Westbury, Taunton and Newton Abbot; and the \"Bristolian\", which adds 14min in order to allow for a Bath stop and an increased load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A setback or handicap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80eaba6-79c3-48bd-af4f-0628699f5abd",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "My height is a disadvantage for reaching high shelves."
                                            },
                                            {
                                                "example_id": "255f5862-20f3-48ab-b649-4c60190babe6",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "I was brought hither under the disadvantage of being unknown, even by sight, to any of you."
                                            },
                                            {
                                                "example_id": "4791ad39-9313-4b2a-9134-5ec9f7196d70",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "1859-1890, John G. Palfrey, History of New England to the Revolutionary War\nAbandoned by their great patron, the faction henceforward acted at disadvantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "Loss; detriment; hindrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fabbf53-3c78-404a-abcd-399d5e41e0cd",
                                                "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                                "text": "They would throw a construction on his conduct, to his disadvantage before the public."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                        "entry_id": "c2d49292-1d65-3a95-ab29-e8252a746359",
                                        "glosses": [
                                            "To place at a disadvantage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338fa432-fad7-438e-aafa-40f7007c4420",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "They fear it might disadvantage honest participants to allow automated entries."
                                            },
                                            {
                                                "example_id": "d5053aeb-1a50-4186-8e81-e831caa3049b",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "For London to have its own exclusive immigration policy would exacerbate the sense that immigration benefits only certain groups and disadvantages the rest. It would entrench the gap between London and the rest of the nation. And it would widen the breach between the public and the elite that has helped fuel anti-immigrant hostility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f343ea1-27b0-4612-8ee5-ca40e214d6b4",
                        "source_entry_id": "208704e8-af52-3e60-ae37-db6e065db599",
                        "source_sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                        "target_lang_word": "downer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39ceb4a0-4475-3f68-b25d-f026fe305b22",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A negative drug trip."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded3a653-477d-4821-ad61-d331efd74de7",
                                                "sense_id": "39ceb4a0-4475-3f68-b25d-f026fe305b22",
                                                "text": "Normally those pills give me a boost, but last night they gave me a downer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079e5dab-0fd2-3233-8f66-91b9f0d3f35f",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A drug that has depressant qualities."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f35105-c6e6-499e-a970-21eb4ed49efd",
                                                "sense_id": "079e5dab-0fd2-3233-8f66-91b9f0d3f35f",
                                                "text": "Say, for example, a person starts with the use of a downer that reduces any anxiety and produces a sense of relaxation. When their energy levels drop, they take a stimulant in order to continue participating in the party or another event. This creates a cycle that could lead to significant drug use and drastically increases the risk of overdose or death. It is critical to know which drugs are uppers and downers to avoid this combination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "274e63df-98dd-36ed-8274-f4f792f18cdd",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "Something or someone disagreeable, dispiriting or depressing; a killjoy."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8125738-230a-4fb4-99db-68bb2023f56a",
                                                "sense_id": "274e63df-98dd-36ed-8274-f4f792f18cdd",
                                                "text": "You don't really need to know me. I'm kind of a downer."
                                            },
                                            {
                                                "example_id": "2c4bcca4-8009-49c2-99d6-006e3ddd5cd1",
                                                "sense_id": "274e63df-98dd-36ed-8274-f4f792f18cdd",
                                                "text": "Geffen had never understood why such a downer of a film was being released over the holidays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A livestock animal that has collapsed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a7156fd-e6fb-41e3-97ae-cdab34abf9a5",
                                                "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                                "text": "The ten-dollar bill was for eating money and the prod pole to be used when the train stopped for water in getting \"downers\" back on their feet."
                                            },
                                            {
                                                "example_id": "6fd6a573-09bb-403b-83df-501b487e7e94",
                                                "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                                "text": "In 1993, Farm Sanctuary produced undercover footage of downers being lifted by forklift at Hallmark, prompting introduction of a California downer cattle law the next year. Either management provided instructions to get the downers moving or was asleep at the wheel and let employees run wild — in either case, it's an indictment of management."
                                            },
                                            {
                                                "example_id": "fbf3f1d5-4397-493a-a7b5-e1d8b638c66d",
                                                "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                                "text": "The two plants where I saw great reductions in downers have reduced, but not eliminated Paylean use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083fb389-b1ed-3285-9634-5abe65cd9464",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A form of industrial action in which workers down tools and refuse to work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa60377-b41d-4743-b9b8-05f767014ea0",
                                                "sense_id": "083fb389-b1ed-3285-9634-5abe65cd9464",
                                                "text": "In the Workplace Industrial Relations Survey, a strike may be a downer or a stoppage as defined by the Department."
                                            },
                                            {
                                                "example_id": "36c414cb-acc7-4c1f-81af-cc718f874a8d",
                                                "sense_id": "083fb389-b1ed-3285-9634-5abe65cd9464",
                                                "text": "Cowley experienced a rash of 'downers' — short, sharp, unofficial strikes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ffec4b5-6b6a-3af1-adef-96e27c81f955",
                                        "entry_id": "fd2f7c51-07a1-3a15-a776-c84b60c3925e",
                                        "glosses": [
                                            "A sixpence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d07ca8-735d-4676-b6d5-05fc4e0bb0e9",
                                                "sense_id": "5ffec4b5-6b6a-3af1-adef-96e27c81f955",
                                                "text": "The price of a case (five shillings piece bad) from the smasher is about one shilling; an alderman (two and sixpence) about sixpence; a peg (shilling) about threepence; a downer or sprat (sixpence) about twopence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7a9aaa4-9f95-4739-ac54-0cc15d7175b0",
                        "source_entry_id": "208704e8-af52-3e60-ae37-db6e065db599",
                        "source_sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                        "target_lang_word": "wormwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wormwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                        "entry_id": "64d298af-fcfd-3e70-9a42-9b3e8100189d",
                                        "glosses": [
                                            "An intensely bitter herb (Artemisia absinthium and similar plants in genus Artemisia) used in medicine, in the production of absinthe and vermouth, and as a tonic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b45e8bcd-2a35-4862-9377-b91b8cc9ed7e",
                                                "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                                "text": "But as I said, / When it did taste the wormwood on the nipple / Of my dug and felt it bitter, pretty fool, / To see it tetchy and fall out with the dug!"
                                            },
                                            {
                                                "example_id": "35b189b2-2e0a-47bb-a97e-3b2e0c99c5b0",
                                                "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                                "text": "Therefore thus saith the Lord of hosts, the God of Israel; Behold, I will feed them, even this people, with wormwood, and give them water of gall to drink."
                                            },
                                            {
                                                "example_id": "28b2ddd4-3520-4f56-93ec-a75b750ce509",
                                                "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                                "text": "Blue skippers in sunny hours ope and shut\nWhere wormwood and grunsel flowers by the cart ruts […]"
                                            },
                                            {
                                                "example_id": "f51eb0f2-2c43-400d-ac72-50a1225a2c74",
                                                "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                                "text": "Cliff took two glasses and filled one with wine\nAnd one with wormwood."
                                            },
                                            {
                                                "example_id": "13a44e72-31ed-44b3-871f-1437bde7caf8",
                                                "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                                "text": "Amongst the herbs to be administered when the charm was sung over him were a yew-berry, lupin, helenium, marsh mallow, dock, elder, wormwood and strawberry leaves."
                                            },
                                            {
                                                "example_id": "96c87a38-7de6-4c5e-86ea-8f8bf3a760bc",
                                                "sense_id": "71e35fcc-2b0e-308a-a9d3-9af6c9cf4d56",
                                                "text": "Tradition credits John the Baptist with wearing a girdle fashioned of wormwood, while he was in the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff660978-1408-3bb7-a54e-cd4b926e4375",
                                        "entry_id": "64d298af-fcfd-3e70-9a42-9b3e8100189d",
                                        "glosses": [
                                            "Something that causes bitterness or affliction; a cause of mortification or vexation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f613c597-aff6-45e4-b175-2784d5abab83",
                                                "sense_id": "ff660978-1408-3bb7-a54e-cd4b926e4375",
                                                "text": "The irony of this reply was wormwood to Zeluco; he fell into a gloomy fit of musing, and made no farther inquiry […]."
                                            },
                                            {
                                                "example_id": "971968ea-73cb-426a-a30e-a856f65f74cf",
                                                "sense_id": "ff660978-1408-3bb7-a54e-cd4b926e4375",
                                                "text": "Yet I think the Archdeacon, a \"new man,\" to whom the aristocratic Canon's popularity was wormwood, did dislike him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e36233b5-4464-492d-9779-216824c3e0da",
                        "source_entry_id": "208704e8-af52-3e60-ae37-db6e065db599",
                        "source_sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                        "target_lang_word": "ombre au tableau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ombre au tableau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77e868e7-76b1-3a72-b26b-a76fde733023",
                                        "entry_id": "15aed6a1-2721-33a1-ad5a-721b6450071d",
                                        "glosses": [
                                            "Défaut qui accompagne parfois les beautés d’un ouvrage, les bonnes qualités d’une personne, les avantages d’une affaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31c14ea-bb59-4d2b-9f05-e779ab5c48f0",
                                                "sense_id": "77e868e7-76b1-3a72-b26b-a76fde733023",
                                                "text": "Aujourd’hui, je vais bientôt me marier. Je suis heureuse, mais il y a tout de même une ombre au tableau."
                                            },
                                            {
                                                "example_id": "d220f633-66d8-44ad-a1b7-e171408160f1",
                                                "sense_id": "77e868e7-76b1-3a72-b26b-a76fde733023",
                                                "text": "Seule ombre au tableau, quand il confesse, gêné aux entournures, qu’il ne connaît pas le DJ Martin Solveig, chargé d’animer la soirée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b185a86-5e17-4f48-8363-50d97dedca95",
                        "source_entry_id": "208704e8-af52-3e60-ae37-db6e065db599",
                        "source_sense_id": "9807a3ef-b6b7-337b-8d58-859ba33baf55",
                        "target_lang_word": "ложка дёгтя в бочке мёда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ложка дёгтя в бочке мёда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b80d4e2d-5d3a-35d7-9968-70a2f8cdd608",
                                        "entry_id": "95dd0e9b-85bc-3c72-8acc-80b1eccd52b3",
                                        "glosses": [
                                            "о неприятной мелочи, способной испортить что-то большое и хорошее"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc8de828-baf1-4112-8fac-15fdc5539816",
                                                "sense_id": "b80d4e2d-5d3a-35d7-9968-70a2f8cdd608",
                                                "text": "Истины несомненные; но вознаграждать ли аромат розы за царапины, наносимые её шипами, а ложка дёгтя в бочке мёда не уничтожает ли всю его сладость?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
