                                                "example_id": "146b0725-0b5f-4ab6-a03f-8d067c4a8a6c",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Aber sie folgen besseren Jägern, um aus deren Jagdglück Nutzen zu ziehen, und schädigen den Trapper, indem sie ihm den Köder aus den Fallen stehlen.“"
                                            },
                                            {
                                                "example_id": "5aa2bc8c-8582-4143-b525-695f46b9fadf",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Vor wilden Thieren fürchtet der Trapper sich nicht, aber die Indianer, welchen er als ein unwillkommener Eindringling erscheint, sind seine geschworenen Feinde, und vor diesen muß er immer auf der Hut sein.“"
                                            },
                                            {
                                                "example_id": "419567ec-e679-4ba7-8827-1887b589015c",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Die Berichte der Siedler, Missionare und Trapper schließlich sind oft von Vorurteilen »den Indianern« gegenüber geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
