                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The shooting forth of anything from a point or surface, like diverging rays of light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bbeb5c-0248-457e-817c-e41d816d83e5",
                                                "sense_id": "8b88abb9-3f15-3e21-b70e-23b586325b92",
                                                "text": "The radiation of love from the crowd was addictive to the young singer-songwriters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecdbd55-d88d-3a5e-8dd6-7dc1d26622cf",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The shooting forth of anything from a point or surface, like diverging rays of light.",
                                            "Ellipsis of electromagnetic radiation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e12352-df03-4212-84c7-5b10dd0f5278",
                                                "sense_id": "3ecdbd55-d88d-3a5e-8dd6-7dc1d26622cf",
                                                "text": "heat radiation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e814ae26-7188-3a28-ac48-677385a35010",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The process of radiating waves or particles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0920265-3f0b-3ecc-a4af-6a72eb80bc45",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The transfer of energy via radiation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43a3eb62-a7b1-3957-9f3e-ff2779d304ec",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "Radioactive energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de53d77a-0063-40e5-90e6-ea9201871212",
                                                "sense_id": "43a3eb62-a7b1-3957-9f3e-ff2779d304ec",
                                                "text": "It's Christmas at ground zero / And if the radiation level's OK / I'll go out with you / To see all the new / Mutations on New Year's Day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e5710ff-a8d9-3e3d-b2de-679a48f6c76f",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "A rapid diversification of an ancestral species into many new forms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6737478-75bf-4572-942e-df9abb573a08",
                                                "sense_id": "8e5710ff-a8d9-3e3d-b2de-679a48f6c76f",
                                                "text": "So the question is: have plants and animals retained over this huge amount of time—whole radiations of mammals have come and gone in this period—have they retained these potentially costly characteristics?"
                                            },
                                            {
                                                "example_id": "c79b0437-8d61-4ec8-8640-04d372c46d4f",
                                                "sense_id": "8e5710ff-a8d9-3e3d-b2de-679a48f6c76f",
                                                "text": "The second [canid group] is the radiation of dogs in South America that began when the first canids arrived about 3 Ma, after crossing the Panama land bridge (Fig. 5.4)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
