                "senses": [
                    {
                        "sense_id": "f5a0eeae-d5ea-32b4-a6f1-a17a2a3641d4",
                        "entry_id": "680c3508-6338-3126-834a-6b832adf41d2",
                        "glosses": [
                            "Bildung von Molekülen/Proteinen anhand der Informationen, die in einem Gen festgelegt sind"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "6bb0146b-280f-449e-970c-47f8793036fc",
                                "sense_id": "f5a0eeae-d5ea-32b4-a6f1-a17a2a3641d4",
                                "text": "„Genexpression bedeutet, dass anhand der Information der Virus-DNS (Gensequenz) die Eiweiß-Bestandteile für den Aufbau neuer Viren hergestellt werden (Proteinbiosynthese).“"
                            },
                            {
                                "example_id": "e342feee-3327-4e52-9e76-d44b2ce815f0",
                                "sense_id": "f5a0eeae-d5ea-32b4-a6f1-a17a2a3641d4",
                                "text": "„Diesen Vorgang, also Transkription und Translation eines Gens, fasst man unter dem Begriff Genexpression zusammen.“"
                            },
                            {
                                "example_id": "2315fb63-7dd0-404f-a63a-dd22265bfc27",
                                "sense_id": "f5a0eeae-d5ea-32b4-a6f1-a17a2a3641d4",
                                "text": "„Die Genexpression der Cyp1B1 sowie der Cyp2E1 mRNA kann daher nicht als Biomarker für Raucher dienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
