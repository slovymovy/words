                            "text": "De wasmachine is <w>deftig</w> kapot en moet worden vervangen.",
                            "target_lang_translations": {
                                "en": "The washing machine is <w>properly</w> broken and needs to be replaced.",
                                "fr": "Le lave-linge est <w>sacrément</w> bousillé et doit être remplacé."
                            }
                        },
                        {
                            "text": "Het heeft vannacht <w>deftig</w> gevroren op het platteland.",
                            "target_lang_translations": {
