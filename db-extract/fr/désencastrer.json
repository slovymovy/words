                "senses": [
                    {
                        "sense_id": "2ccbf19e-7504-3aa5-b868-ba7fa304b9b5",
                        "entry_id": "08a9a2c0-2a53-3914-ac22-a77f850a432c",
                        "glosses": [
                            "Défaire (ce qui était encastré)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977c20d5-7c25-4e09-9632-a9fb1dfad26b",
                                "sense_id": "2ccbf19e-7504-3aa5-b868-ba7fa304b9b5",
                                "text": "Il a opportunément proposé de « désencastrer » le politique par rapport au social, entendu au sens large d'appareils économiques et culturels."
                            },
                            {
                                "example_id": "e2b60e94-92b9-4b23-bc1e-737971a0a8ea",
                                "sense_id": "2ccbf19e-7504-3aa5-b868-ba7fa304b9b5",
                                "text": "L'enjeu est extrême : un intrapreneur qui a investi toutes ses forces dans la bataille peut avoir perdu jusqu'à la volonté de se désencastrer de l'organisation qui l'accueille."
                            }
                        ]
                    }
