                        "glosses": [
                            "Disposition à désobliger, à ne pas rendre service."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "4c4a71fb-d048-4dce-9e25-e95a4082b9fd",
                                "sense_id": "20c1fab4-96c9-3163-8355-a753beda4260",
                                "text": "Il est d’une extrême désobligeance."
                            },
                            {
                                "example_id": "6de42ae1-1261-4279-b0dd-9b1b03fa7d10",
                                "sense_id": "20c1fab4-96c9-3163-8355-a753beda4260",
                                "text": "Blessés et réfugiés meurent à pelletées, victimes de la pénurie de médicaments, du typhus, de la dysenterie, de la famine, de la désobligeance ou de l’inimitié des contrées qu’ils sillonnent, désobligeance ou inimitié qu’engendrent plus la crainte des répressions patriotes qu’une adhésion sincère aux principes de la République."
                            }
                        ]
                    }
