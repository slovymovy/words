    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea0433a3-e081-3707-889f-061e12ab5fc9",
                    "sense_definition": "iemand die zich misdadig gedraagt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "misdadiger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>boeven</w> werden op heterdaad betrapt door de politie.",
                            "target_lang_translations": {
                                "en": "The <w>crooks</w> were caught red-handed by the police.",
                                "fr": "Les <w>bandits</w> ont été pris en flagrant délit par la police."
                            }
                        },
                        {
                            "text": "De gevaarlijke <w>boef</w> ontsnapte uit de gevangenis.",
                            "target_lang_translations": {
                                "en": "The dangerous <w>criminal</w> escaped from prison.",
                                "fr": "Le dangereux <w>bandit</w> s'est évadé de prison."
                            }
                        }
                    ],
                    "synonyms": [
                        "zware jongen",
                        "schurk",
                        "misdadiger",
                        "crimineel"
                    ],
                    "common_phrases": [
                        "gevaarlijke boef"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who behaves in a criminal or dishonest manner.",
                        "fr": "Personne qui commet des actes criminels ou malhonnêtes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crook",
                                "target_lang_sense_clarification": "A common, informal term for a criminal or dishonest person."
                            },
                            {
                                "target_lang_word": "scoundrel",
                                "target_lang_sense_clarification": "A person, typically a man, who behaves in a dishonest or dishonorable way."
                            },
                            {
                                "target_lang_word": "villain",
                                "target_lang_sense_clarification": "A person responsible for specified harmful or criminal behavior."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "bandit",
                                "target_lang_sense_clarification": "Malfaiteur, criminel"
                            },
                            {
                                "target_lang_word": "voyou",
                                "target_lang_sense_clarification": "Individu malhonnête ou violent"
                            },
                            {
                                "target_lang_word": "truand",
                                "target_lang_sense_clarification": "Personne liée au milieu criminel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76e7088a-1847-3d1b-8258-5a061845e979",
                    "sense_definition": "ondeugend kind",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ondeugend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij kleine <w>boef</w>, wat heb je nu weer gedaan?",
                            "target_lang_translations": {
                                "en": "You little <w>rascal</w>, what have you done now?",
                                "fr": "Espèce de petit <w>coquin</w>, qu'est-ce que tu as encore fait ?"
                            }
                        },
                        {
                            "text": "Het kleine <w>boefje</w> had stiekem alle koekjes opgegeten.",
                            "target_lang_translations": {
                                "en": "The little <w>scamp</w> had secretly eaten all the cookies.",
                                "fr": "Le petit <w>filou</w> avait mangé tous les biscuits en cachette."
                            }
                        }
                    ],
                    "synonyms": [
                        "deugniet",
                        "rakker"
                    ],
                    "common_phrases": [
                        "kleine boef"
                    ],
                    "target_lang_definitions": {
                        "en": "A mischievous or naughty child.",
                        "fr": "Enfant espiègle ou coquin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rascal",
                                "target_lang_sense_clarification": "Used affectionately to describe a mischievous or cheeky child."
                            },
                            {
                                "target_lang_word": "scamp",
                                "target_lang_sense_clarification": "A person, especially a child, who is mischievous in a playful way."
                            },
                            {
                                "target_lang_word": "little devil",
                                "target_lang_sense_clarification": "An informal, often affectionate way to refer to a naughty child."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "coquin",
                                "target_lang_sense_clarification": "Enfant espiègle ou malicieux"
                            },
                            {
                                "target_lang_word": "petit filou",
                                "target_lang_sense_clarification": "Terme affectueux pour un enfant espiègle"
                            },
                            {
                                "target_lang_word": "fripon",
                                "target_lang_sense_clarification": "Enfant espiègle ou taquin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
