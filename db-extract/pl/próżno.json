                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e65c5ff-f139-435b-9c1c-d714f91597f7",
                        "source_entry_id": "56ca1451-55e6-3c12-ba23-eacd9034213b",
                        "source_sense_id": "1cc3508e-dbb3-3efb-94f6-002d33ae1bf0",
                        "target_lang_word": "in vain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in vain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                        "entry_id": "25767d49-4bdb-3543-a32f-dd7083cbaf89",
                                        "glosses": [
                                            "Without success or a result; ending in failure."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8835c1b-e36b-4a92-bd36-91742ccb3046",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "[…]that we here highly resolve that these dead shall not have died in vain[…]"
                                            },
                                            {
                                                "example_id": "914f9f67-dd48-425b-84f1-73b8c075fd17",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "19th c., Friedrich Nietzsche\nOn the mountains of truth you can never climb in vain."
                                            },
                                            {
                                                "example_id": "43d9dffa-32be-419a-b238-12a6f7fae397",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "For some time Grannie tried in vain to comfort her."
                                            },
                                            {
                                                "example_id": "8a1332eb-f9a4-4262-a10d-5a8697f48f7a",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "All these great plans were in vain, however, for in the cold dawn following the \"Mania\" years of 1845–46 the M.B.M. & M.J.R. project was truncated to an 11+¹⁄₂-mile line from Ambergate to Rowsley."
                                            },
                                            {
                                                "example_id": "d7974aa1-62dd-4107-ad89-2f2e88396e54",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "Knock me down, it's all in vain\nI get right back on my feet again"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                        "entry_id": "25767d49-4bdb-3543-a32f-dd7083cbaf89",
                                        "glosses": [
                                            "In a disrespectful manner, without honoring the proper meaning; insincerely or without proper respect."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e4af38-bb01-433a-a283-01783957c510",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "Thou ſhalt not take the Name of the Lord thy God in vaine:[…]"
                                            },
                                            {
                                                "example_id": "ae7ef1b2-ef63-493b-9120-775ca25b376f",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "Methinks I see him even now in my mind's eye;— the firm and upright figure,— the step, quick and determined, — the eye, which shot so keen and so penetrating a glance,— the features on which care had already planted wrinkles, and hear his language, in which he never wasted word in vain, expressed in a voice which had sometimes an occasional harshness, far from the intention of the speaker."
                                            },
                                            {
                                                "example_id": "ddefe81b-fc3e-4971-82f4-c052bafd7ca2",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "A fetishist regime attempts to annul the separation of image and spectator, to reinstall an immediate relation that promises (in vain) to provide satisfaction to desire itself."
                                            },
                                            {
                                                "example_id": "75b6f7bb-b80b-412a-9520-eb380db30a61",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "This petition is the reverse side of the commandment against taking God's name in vain."
                                            },
                                            {
                                                "example_id": "edea780f-3f5d-4be6-8ba4-4cc562603979",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "McLaren's task, it seems, is to set Jesus in a more appropriate and biblical context so that we won't use his name “in vain.”"
                                            },
                                            {
                                                "example_id": "c91aec32-9ce9-4182-a1c1-452b1382de80",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "That's fine. I know you won't engage your word in vain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "in vain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe89158c-519c-3731-a93c-9c1abb089de6",
                                        "entry_id": "f297aee0-31fa-35ef-97ae-57bad9298d22",
                                        "glosses": [
                                            "Unsuccessful, failed."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff305a6-9987-47e0-97ec-8855614e153d",
                                                "sense_id": "fe89158c-519c-3731-a93c-9c1abb089de6",
                                                "text": "Their efforts were in vain and he succumbed to his injuries."
                                            },
                                            {
                                                "example_id": "cef5cd3a-ff46-498b-9046-c1bf45a79c0a",
                                                "sense_id": "fe89158c-519c-3731-a93c-9c1abb089de6",
                                                "text": "The problems concerning contrast induced hyperemia and the in vain efforts to search for a contrast agent not influencing flow […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "758aa5cb-3c3b-416a-a4c0-7e1f04945d57",
                        "source_entry_id": "56ca1451-55e6-3c12-ba23-eacd9034213b",
                        "source_sense_id": "1cc3508e-dbb3-3efb-94f6-002d33ae1bf0",
                        "target_lang_word": "vergeblich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergeblich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d9cde6-4efd-3f96-9d97-76e4b17841ab",
                                        "entry_id": "6654ba9f-20fe-394c-b7e5-3671d1ef312c",
                                        "glosses": [
                                            "in Scheitern resultierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39cd15a-cc4f-4e06-9053-2692c482085b",
                                                "sense_id": "f2d9cde6-4efd-3f96-9d97-76e4b17841ab",
                                                "text": "Sämtliche Versuche, unsere Beziehung zu retten, erwiesen sich als vergeblich."
                                            },
                                            {
                                                "example_id": "d960b626-30c3-44fa-bd2f-561dd5fc0ae8",
                                                "sense_id": "f2d9cde6-4efd-3f96-9d97-76e4b17841ab",
                                                "text": "„Im Bild des seinen Felsbrocken vergeblich bergauf wälzenden Sisyphos schließlich ist die Plage des mühsamen, der Schwerkraft unterworfenen Berganstiegs als eine von den Göttern mit Bedacht über die Sterblichen verhängte Strafe gedeutet.“"
                                            },
                                            {
                                                "example_id": "b0876aa4-afb9-433c-a2cc-1f5744626da4",
                                                "sense_id": "f2d9cde6-4efd-3f96-9d97-76e4b17841ab",
                                                "text": "„Aber die Anstrengungen blieben vergeblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c76e7c5e-0e02-495e-aa4c-6817429caa25",
                        "source_entry_id": "56ca1451-55e6-3c12-ba23-eacd9034213b",
                        "source_sense_id": "1cc3508e-dbb3-3efb-94f6-002d33ae1bf0",
                        "target_lang_word": "vergebens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergebens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8693f09e-21c0-3374-8fea-c24d046f5bbe",
                                        "entry_id": "0010e39b-92f5-31e6-9fcc-b891326f242e",
                                        "glosses": [
                                            "zu keinem Erfolg führend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e1b59e-6e0c-4104-8db3-3015ebd078cd",
                                                "sense_id": "8693f09e-21c0-3374-8fea-c24d046f5bbe",
                                                "text": "Alle Mühe war vergebens."
                                            },
                                            {
                                                "example_id": "744a66e7-ee73-4095-ba9b-ae23371da5dc",
                                                "sense_id": "8693f09e-21c0-3374-8fea-c24d046f5bbe",
                                                "text": "„Vergebens bemühten sich die Gastgeber, auch gleich die unerhörten Vorgänge in dessen Land von der Tagesordnung zu streichen.“"
                                            },
                                            {
                                                "example_id": "db2ad40c-c2fe-4499-ab1c-65ee7207d7a6",
                                                "sense_id": "8693f09e-21c0-3374-8fea-c24d046f5bbe",
                                                "text": "„Eine umfassende spezielle gesetzliche Regelung zum Umgang mit jugendlichen und heranwachsenden Straftätern sucht man im postkommunistischen Russland noch vergebens.“"
                                            },
                                            {
                                                "example_id": "15285b33-1eeb-4a61-a649-8300c0a24ad5",
                                                "sense_id": "8693f09e-21c0-3374-8fea-c24d046f5bbe",
                                                "text": "„Doch ihre Hoffnung, die Stadt durch einen Überraschungsangriff nehmen zu können, ist vergebens - und eine Belagerung scheint angesichts der gewaltigen Mauern Konstantinopels aussichtslos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b379fd8-f5f2-4ebf-9667-d36889895281",
                        "source_entry_id": "56ca1451-55e6-3c12-ba23-eacd9034213b",
                        "source_sense_id": "1cc3508e-dbb3-3efb-94f6-002d33ae1bf0",
                        "target_lang_word": "umsonst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umsonst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "927eecc9-7471-39ba-8d0f-96304ae6f36f",
                                        "entry_id": "48197108-f8f7-392b-aa09-4b3d06abfe20",
                                        "glosses": [
                                            "ohne Gegenleistung, ohne Geld bezahlen zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a5c1ff-5c87-4249-9a08-17b09267bacb",
                                                "sense_id": "927eecc9-7471-39ba-8d0f-96304ae6f36f",
                                                "text": "Kinder dürfen umsonst mitfahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c97df066-b259-39a4-8e73-a0eb63d6e4d6",
                                        "entry_id": "48197108-f8f7-392b-aa09-4b3d06abfe20",
                                        "glosses": [
                                            "ohne Erfolg, vergebens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c2c7f9-7545-448f-a7ed-cc39ff37eb7a",
                                                "sense_id": "c97df066-b259-39a4-8e73-a0eb63d6e4d6",
                                                "text": "Ich war umsonst beim Bäcker, denn die Brötchen waren schon ausverkauft."
                                            },
                                            {
                                                "example_id": "fb3c0929-c098-44d3-873d-bb7ed07c8c97",
                                                "sense_id": "c97df066-b259-39a4-8e73-a0eb63d6e4d6",
                                                "text": "„Die ganze Mühe war umsonst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "033a7125-0ec0-3eff-b952-15e2ea591a5d",
                                        "entry_id": "48197108-f8f7-392b-aa09-4b3d06abfe20",
                                        "glosses": [
                                            "nicht grundlos, nicht ohne einen Zweck"
                                        ],
                                        "tags": [
                                            "verneint"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e0355b-e8ea-4b73-ac1d-47915331f725",
                                                "sense_id": "033a7125-0ec0-3eff-b952-15e2ea591a5d",
                                                "text": "Ich habe dich nicht umsonst davor gewarnt ohne Regenschirm aus dem Haus zu gehen."
                                            }
                                        ],
