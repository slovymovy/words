                    {
                        "sense_id": "b732c1cf-fcd9-381d-830a-8a9fd1e1bcc9",
                        "entry_id": "4263478f-55f0-3174-9a5a-7187d1d64322",
                        "glosses": [
                            "Stein in Grüntönen, gemischt aus verschiedenen Mineralien"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "a19718c4-57fb-475f-8176-7dcece3a792f",
                                "sense_id": "b732c1cf-fcd9-381d-830a-8a9fd1e1bcc9",
                                "text": "„Um die Hüften schwang sich ein Frauengürtel aus grünem Nephrit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2072b04e-eab7-4d22-bb34-2541fc1ed483",
                        "source_entry_id": "4263478f-55f0-3174-9a5a-7187d1d64322",
                        "source_sense_id": "b732c1cf-fcd9-381d-830a-8a9fd1e1bcc9",
                        "source_sense_description": "Mineralogie: Stein in Grüntönen, gemischt aus verschiedenen Mineralien",
                        "target_lang_word": "nephrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nephrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "932a0b39-af50-39d3-a291-33d952e17e55",
                                        "entry_id": "9f1ee4cb-83e6-36ef-97ed-bd95bf132ec6",
                                        "glosses": [
                                            "A semi-precious stone, one of the two types of stone commonly referred to as jade (the other being jadeite)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c229d799-1f4c-4f80-b568-25d26822b6b3",
                                                "sense_id": "932a0b39-af50-39d3-a291-33d952e17e55",
                                                "text": "Occurrences of nephrite are more numerous. China’s most important source throughout its history has been the region of Khotan (Ho-t‘ien) and Yarkand in Central Asia. In more recent times the Chinese have also imported nephrite from the neighbourhood of Lake Baikal in Eastern Siberia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e782371b-c773-4a45-8e35-039a88fe851f",
                        "source_entry_id": "4263478f-55f0-3174-9a5a-7187d1d64322",
                        "source_sense_id": "b732c1cf-fcd9-381d-830a-8a9fd1e1bcc9",
                        "source_sense_description": "Mineralogie: Stein in Grüntönen, gemischt aus verschiedenen Mineralien",
                        "target_lang_word": "néphrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néphrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                        "entry_id": "7f0577a5-5fc2-313a-9833-60e9a5a41b26",
                                        "glosses": [
                                            "Inflammation du rein."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d6f003-d378-4ed3-803c-969be1c647ec",
                                                "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                                "text": "Dans certains cas, on observe en outre de la céphalalgie, de la dyspnée, du coma, symptômes qui sont presque toujours sous la dépendance de l’urémie occasionnée par la néphrite."
                                            },
                                            {
                                                "example_id": "b47168ac-426f-4b1d-93b5-f3d9cf9a78f9",
                                                "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                                "text": "Mon frère venait d’être pris d’une néphrite qui réclamait encore des soins et lui interdisait d’être interne."
                                            },
                                            {
                                                "example_id": "0f6e0bb0-ecba-4701-8a0a-1704c82aaa38",
                                                "sense_id": "a3221728-b6af-3ae5-be74-c876bd070321",
                                                "text": "Bien que souffrant d'une néphrite chronique avec complications cardiaques, il ne voulut pas consentir à prendre le moindre repos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6c59843-2bff-3ab4-8c28-a11dd5fe58e4",
                                        "entry_id": "7f0577a5-5fc2-313a-9833-60e9a5a41b26",
                                        "glosses": [
                                            "Variété verte de trémolite ou d’actinote qui est une des deux composantes du jade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6459bc-9ee5-42ef-851f-6ec90d48a6b4",
                                                "sense_id": "d6c59843-2bff-3ab4-8c28-a11dd5fe58e4",
                                                "text": "Leur industrie n’était pas complexe, encore qu’ils connussent le métier du potier et les éléments de ceux du menuisier et du charpentier. Ils n’usaient point de métaux, mais d’une sorte de néphrite fort dure, dont ils faisaient leurs harpons, leurs scies, leurs haches, leurs couteaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
