                    {
                        "translation_id": "68cc78fd-75ce-4699-a910-200fc1a7c759",
                        "source_entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                        "source_sense_description": "поклонник музыки в стиле метал",
                        "target_lang_word": "headbanger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headbanger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8780bd01-0e7f-3b4d-a1ac-9bd38e7ee9e1",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "One who dances by violently shaking the head in time to the music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ab0355e-3a7d-35a6-b664-86787f15da38",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "One who enjoys heavy metal (rock) music, to which this sort of dance is usually performed."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a307543-5e1e-34cc-867f-8b340f202ad0",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "A violently deranged, extreme or fanatical person; a nutcase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df072a4f-8271-3777-ac35-2d1d58f4021b",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "A silly or eccentric person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e004af1d-6ec4-386f-85a4-4988639a92de",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "A political hardliner, especially an obstructive one."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e4c7dd3-f1fa-407b-86fd-3a52a06fced3",
                                                "sense_id": "e004af1d-6ec4-386f-85a4-4988639a92de",
                                                "text": "We would therefore paralyse ourselves for no good reason other than the propagandistic appeasement of the Daily Mail, the Sun, my noble friend Lord Hamilton and a few other headbangers in the Commons on the Conservative side."
                                            },
                                            {
                                                "example_id": "0860c4b5-b359-4095-bfe2-29774c3e41fe",
                                                "sense_id": "e004af1d-6ec4-386f-85a4-4988639a92de",
                                                "text": "Corbyn's lack of ambition would turn out to be one of his great selling points. He was the man at the margin: a headbanger for most and a man of principles for a few."
                                            },
                                            {
                                                "example_id": "1eb7d2d2-d759-43b1-9ef2-6d6f2522c431",
                                                "sense_id": "e004af1d-6ec4-386f-85a4-4988639a92de",
                                                "text": "Even the Brexit headbangers of the European Research Group rolled over like pussycats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bc922e5-badb-3dad-8878-7c1f5d6d1691",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "A person who engages in street violence, especially in support of a political group."
                                        ],
                                        "tags": [
                                            "Northern-Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48336cb-882b-4aa2-8bed-3536a4d9d41a",
                                                "sense_id": "6bc922e5-badb-3dad-8878-7c1f5d6d1691",
                                                "text": "We also had a heavy crew of home-grown headbangers who were likely to get involved in any IRA - UVF battles. It would not have taken much to tip Scotland into the serial sectarian violence that was rife in Belfast and the surrounding areas."
                                            },
                                            {
                                                "example_id": "e5b588b3-fa47-4435-96ff-d7d0650cfccc",
                                                "sense_id": "6bc922e5-badb-3dad-8878-7c1f5d6d1691",
                                                "text": "John had a nasty side to him – he wanted to see the handiwork, if y'know what I mean. That sorta thing didn't interest me. He had a lot of headbangers around him but that was his style. He wanted to outdo the UDA – he hated them with a passion."
                                            },
                                            {
                                                "example_id": "2eafb2a5-fefe-4bd0-928b-bd4f1ad5d642",
                                                "sense_id": "6bc922e5-badb-3dad-8878-7c1f5d6d1691",
                                                "text": "In the Long Bar, you had 'Chuck' Berry and his mob. You had Lenny Murphy and his mob. And you had them in the Rex Bar, and you had them in the Windsor Bar. All different, separate groups of all headbangers. Now, from time to time, the leaders would have given them instructions to carry out certain murders or given approval for certain murders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ddfb0f9-65e0-3322-b7a3-9c7ed9a2950a",
                                        "entry_id": "b74c10ed-334d-3af3-b4e7-4b2945086d95",
                                        "glosses": [
                                            "A kind of chin-up or pull-up exercise where the head is kept in line with the bar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
