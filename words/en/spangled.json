{
    "word_family": [
        "spangle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e3fc6679-f41d-31d5-a2c1-2b9918da3eef",
                    "sense_definition": "Decorated or covered with small, sparkling objects or glittering spots.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer wore a heavily <w>spangled</w> jacket that caught every light on the stage.",
                            "target_lang_translations": {
                                "de": "Der Sänger trug eine stark <w>paillettenbesetzte</w> Jacke, die jedes Licht auf der Bühne einfing."
                            }
                        },
                        {
                            "text": "I cycled the three miles each morning between hedges draped with <w>spangled</w> cobwebs.",
                            "target_lang_translations": {
                                "de": "Ich radelte jeden Morgen die drei Meilen zwischen Hecken hindurch, die mit <w>glitzernden</w> Spinnweben behängt waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "glittering",
                        "sparkling",
                        "sequined"
                    ],
                    "antonyms": [
                        "unspangled"
                    ],
                    "common_phrases": [
                        "star-spangled banner"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit Pailletten, Glitzer oder funkelnden Elementen verziert oder bedeckt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "funkelnd",
                                "target_lang_sense_clarification": "allgemein glänzend oder schimmernd"
                            },
                            {
                                "target_lang_word": "glitzernd",
                                "target_lang_sense_clarification": "mit Glitzerpartikeln oder Lichtreflexen"
                            },
                            {
                                "target_lang_word": "paillettenbesetzt",
                                "target_lang_sense_clarification": "mit Pailletten bestickt oder besetzt (Kleidung)"
                            },
                            {
                                "target_lang_word": "sternübersät",
                                "target_lang_sense_clarification": "mit Sternen oder sternähnlichen Punkten bedeckt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45ff0e46-9875-3eed-ba9b-902e2b95cab9",
                    "sense_definition": "Intoxicated by alcohol or drugs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long night out at the festival, he was completely <w>spangled</w>.",
                            "target_lang_translations": {
                                "de": "Nach einer langen Nacht auf dem Festival war er völlig <w>zugedröhnt</w>."
                            }
                        },
                        {
                            "text": "Nobody could understand what he was saying because he was so <w>spangled</w>.",
                            "target_lang_translations": {
                                "de": "Niemand konnte verstehen, was er sagte, weil er so <w>zugeballert</w> war."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "high",
                        "wasted"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to describe intoxication."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachlich stark berauscht durch Alkohol oder Drogen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zugeballert",
                                "target_lang_sense_clarification": "Slang für stark berauscht von Drogen oder Alkohol"
                            },
                            {
                                "target_lang_word": "zugedröhnt",
                                "target_lang_sense_clarification": "Slang für extrem berauscht, insbesondere durch Drogen"
                            },
                            {
                                "target_lang_word": "breit",
                                "target_lang_sense_clarification": "umgangssprachlich für betrunken oder high"
                            },
                            {
                                "target_lang_word": "voll",
                                "target_lang_sense_clarification": "umgangssprachlich für stark betrunken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33f1bf70-db26-3a78-9f1e-8c5145e4f621",
                    "sense_definition": "simple past and past participle of <w>spangle</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tiny dewdrops <w>spangled</w> the grass in the early morning light.",
                            "target_lang_translations": {
                                "de": "Winzige Tautropfen <w>übersäten</w> das Gras im frühen Morgenlicht."
                            }
                        },
                        {
                            "text": "Countless stars <w>spangled</w> the clear midnight sky over the desert.",
                            "target_lang_translations": {
                                "de": "Zahllose Sterne <w>übersäten</w> den klaren Mitternachtshimmel über der Wüste."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einfache Vergangenheitsform (Präteritum) und Partizip Perfekt von 'spangle': mit funkelnden oder glitzernden Punkten übersäen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "übersäte",
                                "target_lang_sense_clarification": "Präteritum von 'übersäen'"
                            },
                            {
                                "target_lang_word": "übersät",
                                "target_lang_sense_clarification": "Partizip Perfekt von 'übersäen'"
                            },
                            {
                                "target_lang_word": "gespickt",
                                "target_lang_sense_clarification": "Partizip Perfekt von 'spicken', bildlich reichlich versehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}