                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                        "entry_id": "ad167be4-6fae-3791-8458-ef2616dd1956",
                        "glosses": [
                            "Celui, celle qui tache, qui salit ses vêtements, qui est malpropre."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "bc676744-581a-452d-82a6-78cf4a17d0c6",
                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                "text": "Un souillon."
                            },
                            {
                                "example_id": "8df9d2c6-e19a-4ab2-8982-27081f881bac",
                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                "text": "Une petite souillon."
                            },
                            {
                                "example_id": "761f7d4e-0161-45d9-998d-2192e72382f6",
                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                "text": "Cette petite Mathilde, un souillon d’ingénue, tenait sa loge très sale."
                            },
                            {
                                "example_id": "ed5c1a26-e175-4965-8a1a-57ce02aa1ed6",
                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                "text": "Et (on la buvait des yeux, vous comprenez) elle ne fut pas indifférente comme quelqu’un qui se serait forcé à l’indifférence ; elle ne fut pas non plus familière comme une qui serait restée souillon en dedans, non."
                            },
                            {
                                "example_id": "b018362f-56c0-4c51-bc64-75c3b237961f",
                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                "text": "Ma mère m’habillait mal et mon père me reprochait d’être mal habillée : je devins une souillon."
                            },
                            {
                                "example_id": "f9bf7cf6-4282-47ec-b7ec-c13cf3e2b8e2",
                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                "text": "Les circonstances avaient si profondément altéré leurs positions que lui aurait certainement semblé à un étranger un parfait gentleman, et sa femme tout à fait une petite souillon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "686ed3b0-56d0-4655-9c74-d3ad85fb03a6",
                        "source_entry_id": "ad167be4-6fae-3791-8458-ef2616dd1956",
                        "source_sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                        "target_lang_word": "Schmutzfink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmutzfink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83a157de-e725-3746-a3a1-695f1548dce5",
                                        "entry_id": "0d4c1397-4e6e-39bd-a51c-079db542e951",
                                        "glosses": [
                                            "Person, die wenig oder gar nicht auf Sauberkeit achtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ba4863-d324-4812-918b-33ed0e78d8a6",
                                                "sense_id": "83a157de-e725-3746-a3a1-695f1548dce5",
                                                "text": "Wer seine Essensreste nicht entfernt, ist ein Schmutzfink."
                                            },
                                            {
                                                "example_id": "7c02dd25-9f2a-4fbe-a5e0-248ee90508a0",
                                                "sense_id": "83a157de-e725-3746-a3a1-695f1548dce5",
                                                "text": "„Die Morphi hatte eine Schwester, einen kleinen Schmutzfinken von etwa dreizehn Jahren; diese sagte mir: wenn ich ihr einen kleinen Taler geben wollte, würde sie mir ihr Bett abtreten. Ich erklärte mich einverstanden, und sie führte mich in ein Kämmerchen, wo ich einen Strohsack auf vier Brettern fand.“"
                                            },
                                            {
                                                "example_id": "aa4f993c-2c71-4470-a92d-a8aa00f996dd",
                                                "sense_id": "83a157de-e725-3746-a3a1-695f1548dce5",
                                                "text": "„Der alte Arzt in der Nachbarschaft sei ein versoffener Schmutzfink, er sei vor zehn Jahren von der Marine hinausgeworfen worden und im korsischen Viertel gelandet.“"
                                            },
                                            {
                                                "example_id": "6fdcfeac-7a7f-4bed-81a6-e78bcfa5775e",
                                                "sense_id": "83a157de-e725-3746-a3a1-695f1548dce5",
                                                "text": "„‚Warum sind die Menschen solche Schmutzfinken?‘, frage ich mich, wenn ich die ebenden Laken von Testa’s of Bar Harbor in meine Maschinen füllte. ‚Warum sind die Menschen solche verdammten Schmutzfinken?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
