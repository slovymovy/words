                "senses": [
                    {
                        "sense_id": "fbdaa8c2-da45-3798-906f-1d9c6861bba8",
                        "entry_id": "47df6203-9514-3489-9edb-ef3afd225806",
                        "glosses": [
                            "vom Arbeitgeber zur Verfügung gestelltes zweispuriges (motorisiertes) Fahrzeug, das heute vor allem zum Personentransport bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ce99b1-f36d-4188-8fbe-42f966a2a09d",
                                "sense_id": "fbdaa8c2-da45-3798-906f-1d9c6861bba8",
                                "text": "„Weil Firmen ihre Geschäftswagen im Normalfall nach drei Jahren austauschen, existiert ein gutes Angebot an sogenannten jungen Gebrauchtwagen.“"
                            },
                            {
                                "example_id": "1bca1e8a-1855-4c7d-b0c0-444f199c9c8e",
                                "sense_id": "fbdaa8c2-da45-3798-906f-1d9c6861bba8",
                                "text": "„Ich wollte dasselbe sagen und beantrage, daß die Geschäftswägen der Geschäftsleute in Wien numerirt werden sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
