                    "sense_definition": "Decaffeinated coffee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverage_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually start my day with regular coffee but switch to <w>unleaded</w> in the afternoon.",
                            "target_lang_translations": {
                                "ru": "Обычно я начинаю день с обычного кофе, но после полудня перехожу на кофе <w>без кофеина</w>."
                            }
                        },
                        {
                            "text": "She poured herself a cup of <w>unleaded</w> before heading to bed.",
                            "target_lang_translations": {
                                "ru": "Она налила себе чашку <w>декафа</w> перед тем, как лечь спать."
                            }
                        }
                    ],
                    "synonyms": [
                        "decaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for decaf coffee"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кофе без кофеина (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кофе без кофеина",
                                "target_lang_sense_clarification": "напиток"
                            },
                            {
                                "target_lang_word": "декаф",
                                "target_lang_sense_clarification": "разговорное обозначение кофе без кофеина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c7f7f54-8fd8-3a68-abea-e71c96f669ad",
                    "sense_definition": "Low-alcohol or non-alcoholic beer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverage_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to have an <w>unleaded</w> since he had to drive home later.",
                            "target_lang_translations": {
                                "ru": "Он решил выпить <w>безалкогольного</w>, так как позже ему нужно было ехать домой."
                            }
                        },
                        {
                            "text": "The bar has a surprisingly good selection of <w>unleadeds</w> on tap.",
                            "target_lang_translations": {
                                "ru": "В баре на удивление хороший выбор <w>безалкогольного пива</w> на кранах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for low-alcohol beer"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабоалкогольное или безалкогольное пиво (разговорное)."
