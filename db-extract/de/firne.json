                    {
                        "sense_id": "6e7d8401-542d-3246-813f-10e33aebe8c1",
                        "entry_id": "de009161-d483-344a-ae47-52a3588e8112",
                        "glosses": [
                            "the state of wine to be old and thus dark and bitter"
                        ],
                        "tags": [
                            "feminine",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9a0eedb9-e486-4e08-84c1-918910288fc6",
                                "sense_id": "6e7d8401-542d-3246-813f-10e33aebe8c1",
                                "text": "Tolles Zeug in der grauen Tasche,\nSchwirrte, Mohntriefend, herzu der Traum,\nUnd da saß ich in gläserner Flasche,\nEingesperrt in den dämmernden Raum\nVoll Blume, voll Firne, voll dunstendem Schaum!"
                            }
                        ]
                    }
                ],
