                "senses": [
                    {
                        "sense_id": "3e9c336f-7535-3c21-83d2-330e8bdb2afb",
                        "entry_id": "33b5acc6-84f6-3416-8288-9285b90e6592",
                        "glosses": [
                            "eine Räumlichkeit, wo ausgeschenkt wird, wo Schankbetrieb stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9430dbab-252a-40c4-aad1-62f3b97af050",
                                "sense_id": "3e9c336f-7535-3c21-83d2-330e8bdb2afb",
                                "text": "„In einer ehemaligen Brauerei des 17. Jh.s ist eine Schenke des vorigen Jahrhunderts eingerichtet, und in der Ausschankstube im Keller kann man sich sämtliche niederländische Biersorten zum Probieren zapfen lassen.“"
                            },
                            {
                                "example_id": "03cb64c4-763c-4d18-ad07-c77654de9a8e",
                                "sense_id": "3e9c336f-7535-3c21-83d2-330e8bdb2afb",
                                "text": "„Ihm wurden die „Ausschankstuben einschließlich der Wohnung auf der Burg Hanstein […] unter der Maßgabe verpachtet, daß er für die innere Instandsetzung selbst zu sorgen hat […]“"
                            },
                            {
                                "example_id": "8d1889a4-6059-495c-a34b-6f0a02fd2c3d",
                                "sense_id": "3e9c336f-7535-3c21-83d2-330e8bdb2afb",
                                "text": "„lm Herzen der Mezcal-Agave zu Hause, landen die kleinen, fetten Würmer entweder als gebackene Knabberei in den cantinas, den Ausschankstuben des Mezcal oder in den Mezcal-Flaschen selbst.“"
                            },
                            {
                                "example_id": "73ae0f80-7bea-4207-965a-e35b13ae46b1",
                                "sense_id": "3e9c336f-7535-3c21-83d2-330e8bdb2afb",
                                "text": "Die Ausschankstube befand sich im Erdgeschoss."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
