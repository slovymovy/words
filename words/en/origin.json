                            }
                        ]
                    }
                },
                {
                    "sense_id": "73eceeee-a24b-37cd-9293-26d952eb53df",
                    "sense_definition": "The fixed attachment point of a muscle to a bone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The muscle has its <w>origin</w> on the shoulder blade.",
                            "target_lang_translations": {
                                "ru": "Эта мышца берет <w>начало</w> на лопатке.",
                                "zh": "这块肌肉的<w>起点</w>位于肩胛骨上。"
                            }
                        },
                        {
                            "text": "Pain was felt near the <w>origin</w> of the tendon during the examination.",
                            "target_lang_translations": {
                                "ru": "Во время осмотра боль ощущалась рядом с <w>местом прикрепления</w> сухожилия.",
                                "zh": "检查时，在肌腱的<w>起点</w>附近感到疼痛。"
                            }
