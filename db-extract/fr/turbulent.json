                                                "sense_id": "31344e2c-9c79-367d-a7a6-eecb412b0836",
                                                "text": "Am Flughafen spielten sich turbulente Szenen ab."
                                            },
                                            {
                                                "example_id": "e233aaf6-bbce-4a94-8e10-2209fdab717d",
                                                "sense_id": "31344e2c-9c79-367d-a7a6-eecb412b0836",
                                                "text": "„Siebenbürgen hatte nicht nur im 20. Jahrhundert eine turbulente Geschichte.“"
                                            },
                                            {
                                                "example_id": "1b62bf79-e4a9-4657-b478-4218bf629425",
                                                "sense_id": "31344e2c-9c79-367d-a7a6-eecb412b0836",
                                                "text": "„Juden und Muslime – gerade in den turbulenten Zeiten im Berlin der 1920er und 1930er Jahre waren sie einander derart nahe, entdeckten das Verbindende, kamen gut miteinander aus.“"
                                            }
