                "senses": [
                    {
                        "sense_id": "4ba3ba5c-0e87-39d0-b55d-431073e043ba",
                        "entry_id": "29fd62e8-b800-3c81-b75a-3242b4b412c2",
                        "glosses": [
                            "Se renforcer tout seul, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a279073-e17d-4ec2-be80-c2e76c6e27e8",
                                "sense_id": "4ba3ba5c-0e87-39d0-b55d-431073e043ba",
                                "text": "L'enfant lui-même peut apprendre l'autocontrôle, c'est-à-dire à noter ses résultats et à s'autorenforcer."
                            },
                            {
                                "example_id": "bb91a006-3ff6-4780-aa9f-5ce6692dfb36",
                                "sense_id": "4ba3ba5c-0e87-39d0-b55d-431073e043ba",
                                "text": "Les facteurs qui pérennisent cet état sont les mêmes qui sont à l'origine du trouble mais ont comme particularité de s'autorenforcer."
                            }
                        ]
                    }
