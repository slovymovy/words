                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44dba37f-a26c-45ab-ae27-017049fa9445",
                        "source_entry_id": "65e99245-f4df-3fa6-ab5e-acb2606a48ca",
                        "source_sense_id": "cbe58dce-a6ab-317a-8d16-e4d1f4e90b32",
                        "target_lang_word": "Jekatierina",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5bff61ad-cb6b-44a8-8dd3-2941f8b1b8dd",
                        "source_entry_id": "65e99245-f4df-3fa6-ab5e-acb2606a48ca",
                        "source_sense_id": "cbe58dce-a6ab-317a-8d16-e4d1f4e90b32",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Catherine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Catherine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43a82411-2470-3302-b532-4c36bb0faa71",
                                        "entry_id": "9aabcc7b-e198-3ade-99c8-d06a22be67ef",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a246e239-ecd5-454c-bd68-17ecc7ce8f44",
                                                "sense_id": "43a82411-2470-3302-b532-4c36bb0faa71",
                                                "text": "- - - despite of what you say of my fine name, I think my head is so obstinate and inflexible that the name Catherine was well chosen. It suits my character. I was given the name by the late Empress Elisabeth, to whom I owe much; she gave it to me out of affection and out of respect for her mother"
                                            },
                                            {
                                                "example_id": "0281b964-49db-409f-9fd0-8bbb963d75d5",
                                                "sense_id": "43a82411-2470-3302-b532-4c36bb0faa71",
                                                "text": "It was named Catherine, but he never called it the name in full, as he had never called the first Catherine short, probably because Heathcliff had a habit of doing so. The little one was always Cathy, it formed to him a distinction from the mother, and yet, a connection with her;"
                                            },
                                            {
                                                "example_id": "fab0f43d-3f6a-4f24-b625-9abed9bc0072",
                                                "sense_id": "43a82411-2470-3302-b532-4c36bb0faa71",
                                                "text": "\"Is that your given name?\" \"Not exactly. My father named me Catherine, and my mother nicknamed me Carrie. Nobody calls me Catherine.\" \"Oh, but you're much more a Catherine than a Carrie,\" observed Peter seriously. \"Carrie is simple and mundane; Catherine is complex and beautiful.\""
                                            },
                                            {
                                                "example_id": "90451b8c-90b5-4368-bd1e-228a7455f994",
                                                "sense_id": "43a82411-2470-3302-b532-4c36bb0faa71",
                                                "text": "\"Yes, Catherine sounds like a lovely name. I like it. My new name will be Catherine.\" She rolled the name Catherine silently again. The name had character a noble ring to it she really liked it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62b2bd18-b9a3-4024-8128-5451ca9b577a",
                        "source_entry_id": "65e99245-f4df-3fa6-ab5e-acb2606a48ca",
                        "source_sense_id": "cbe58dce-a6ab-317a-8d16-e4d1f4e90b32",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Kate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56a261c5-e0c6-3a88-864b-d3c3e69f1a3f",
                                        "entry_id": "93068be6-75a3-35ff-ac82-38d7220e7121",
                                        "glosses": [
                                            "A diminutive of the female given name Katherine and related names, also used as a formal given name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7665a4e-8bb9-44dd-8811-c3f8d471b844",
                                                "sense_id": "56a261c5-e0c6-3a88-864b-d3c3e69f1a3f",
                                                "text": "Pet[ruchio]. […] Enter Katerina. / Good morrow Kate, for thats your name I heare.\nKate. Well haue you heard, but ſomething hard of hearing: / They call me Katerine, that do talke of me.\nPet. You lye infaith, for you are call'd plaine Kate, / And bony Kate, and ſometimes Kate the curſt: / But Kate, the prettieſt Kate in Chriſtendome, / Kate of Kate-hall, my ſuper-daintie Kate, / For dainties are all Kates, and therefore Kate / Take this of me, Kate of my conſolation, / Hearing thy mildneſſe prais'd in euery Towne, / Thy vertues ſpoke of, and thy beautie ſounded, / Yet not ſo deepely as to thee belongs, / My ſelfe am moou'd to woo thee for my wife."
                                            },
                                            {
                                                "example_id": "10e5b13e-33da-4b52-99d7-3818f2fd544c",
                                                "sense_id": "56a261c5-e0c6-3a88-864b-d3c3e69f1a3f",
                                                "text": "A great number of children, amongst the lower classes, are Carolines. - - - A clergyman in my neighbourhood used to mistake the sound, and christen the babies Catharine; - a wise error, for Kate is a noble abbreviation."
                                            },
                                            {
                                                "example_id": "df287f1b-0a7f-45ec-b601-265847f6dba6",
                                                "sense_id": "56a261c5-e0c6-3a88-864b-d3c3e69f1a3f",
                                                "text": "\"And I have such a horrible name. Think of it... Kate. Who would take Kate on a Moonlight Cruise...or out to the Minstrels at the point. If you ever do find me in the company of a strange young man, call me Irene. Promise me.\""
                                            },
                                            {
                                                "example_id": "5f63ac63-8d71-44e5-b7ea-5f993702803e",
                                                "sense_id": "56a261c5-e0c6-3a88-864b-d3c3e69f1a3f",
                                                "text": "Ruth did know, but Kate was not named after Hecate or Auntie Catherine or Santa Caterina of Siena (suggested by a Catholic priest of Ruth's acquaintance). She was simply Kate because Ruth liked the name. It was attractive without being twee, strong without being hard. You could hear it prefaced by Doctor or followed by MP. At the same time it was cute enough for a baby."
                                            },
                                            {
                                                "example_id": "1960112d-1f73-42fb-ae89-2e3d2142f728",
                                                "sense_id": "56a261c5-e0c6-3a88-864b-d3c3e69f1a3f",
                                                "text": "Chili’s has also enlisted several actors from “The Office” to star in the ads, including Melora Hardin (Jan Levinson), Andy Buckley (David Wallace), Brian Baumgartner (Kevin Malone) and Kate Flannery (Meredith Palmer)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0765324d-3a85-4736-a04b-5ee9c569243f",
                        "source_entry_id": "65e99245-f4df-3fa6-ab5e-acb2606a48ca",
                        "source_sense_id": "cbe58dce-a6ab-317a-8d16-e4d1f4e90b32",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Katarzyna",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katarzyna",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                        "entry_id": "96b74c6e-c7d7-3849-b7d4-227ad49a6b6e",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61170b1-8d35-4d29-863c-39419fd44542",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "Mam na imię Katarzyna i jestem krawcową z Łodzi."
                                            },
                                            {
                                                "example_id": "0cc38bb0-6120-49b6-ac38-9a96cedad9a7",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "Katarzyna Figura jest polską aktorką, która z humorem i pasją kreuje postacie kobiet ekscentrycznych i nieobliczalnych żon."
                                            },
                                            {
                                                "example_id": "8d1baf34-a6aa-44e3-9a04-6e0824f1e5c0",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "W Kościele katolickim na 25 listopada przypada wspomnienie św. Katarzyny Aleksandryjskiej, patronki katarzynek, krawcowych, bieliźniarek, prządek, modystek, fryzjerów, dziewcząt, mężatek, kołodziejów, młynarzy, garncarzy, polskich kolejarzy, studentów i uczonych oraz chroniącej od bólu głowy."
                                            },
                                            {
