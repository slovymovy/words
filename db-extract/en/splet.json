                        "examples": [
                            {
                                "example_id": "3993feff-8d97-43cb-8888-0e600660f6d8",
                                "sense_id": "bf575d44-dad5-33a1-a813-09621872a5d7",
                                "text": "I Splette a fyſſhe a ſonder / as a pyke oꝛ lynge oꝛ ſuche lyke / Ie ouuers, coniugate in I open. Some ſplet their pyckes whan they bꝛoyle them / but I wolde bꝛoyle them hole: […]"
                            },
                            {
                                "example_id": "232755a1-9866-4ecc-b2f8-b3a9a5f39d2f",
                                "sense_id": "bf575d44-dad5-33a1-a813-09621872a5d7",
                                "text": "[T]he Ship will leake: nay / one bouncinge billowe will ſplet the Bark in peeces."
                            },
                            {
                                "example_id": "76f75277-f79e-4eea-8547-c1c5e6591571",
                                "sense_id": "bf575d44-dad5-33a1-a813-09621872a5d7",
                                "text": "Oh the Dowl ſplet tha! who told theckee Strammer?"
                            },
                            {
                                "example_id": "a7439198-c8c2-4533-87cf-21294a893ed4",
                                "sense_id": "bf575d44-dad5-33a1-a813-09621872a5d7",
                                "text": "“Splet the thing;” cried Hallibert; “talk ye o’ return, guid wife?[…]”"
                            },
                            {
                                "example_id": "d4beec79-f214-4266-b30f-362dfa0b6a61",
                                "sense_id": "bf575d44-dad5-33a1-a813-09621872a5d7",
                                "text": "e.Yks.¹ Ah laughed fit ta splet."
                            }
                        ]
                    }
