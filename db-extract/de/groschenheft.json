                                "example_id": "5cc0c384-cf4b-48ad-b76b-26a284bedc1b",
                                "sense_id": "b6303ca0-1e9f-3974-9dc9-75f8bc5acae6",
                                "text": "„Gelegentlich jedoch ragten vor dem Hintergrund jener Stereotypen, die in den Groschenheften gepflegt wurden, neue Ideale hervor.“.“"
                            },
                            {
                                "example_id": "d5b41fe4-612f-4090-a054-91d819834e7c",
                                "sense_id": "b6303ca0-1e9f-3974-9dc9-75f8bc5acae6",
                                "text": "„Es klang nach Groschenheft, nach schlecht sitzenden Anzügen und Achselschweiß.“"
                            }
                        ],
