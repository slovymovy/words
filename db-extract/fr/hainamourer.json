                "senses": [
                    {
                        "sense_id": "268cadfd-2a39-3478-a64f-62a1af92526f",
                        "entry_id": "41f10467-fefe-3645-9183-bc5337ee1757",
                        "glosses": [
                            "Haïr et aimer en même temps."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "be62227b-b684-4435-a125-7e19bcb5a41f",
                                "sense_id": "268cadfd-2a39-3478-a64f-62a1af92526f",
                                "text": "On peut rester sourd au lapsus, oublier ses rêves, répéter indéfiniment ses symptômes, et s’hainamourer de son psychanalyste."
                            },
                            {
                                "example_id": "9fb1c6e8-f120-4dc3-8239-2b32c8f660c9",
                                "sense_id": "268cadfd-2a39-3478-a64f-62a1af92526f",
                                "text": "Bien entendu puisqu’il n’y a pas que les croyants qui jouissent, c’est-à-dire qui souffrent d’hainamourer."
                            }
                        ]
                    }
                ],
