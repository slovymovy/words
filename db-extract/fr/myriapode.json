                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c01964f-c371-4382-bc20-48fd2a686f7d",
                                                "sense_id": "188680ea-a0e6-39ce-9f43-dd02f0420e7a",
                                                "text": "Einige Tausendfüßer sind giftig."
