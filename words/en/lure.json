{
    "word_family": [
        "allure",
        "alluring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                    "sense_definition": "To attract by temptation, appeal, or guile.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attract_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of fresh coffee <w>lured</w> him into the kitchen.",
                            "target_lang_translations": {
                                "ru": "Запах свежего кофе <w>заманил</w> его на кухню.",
                                "tr": "Taze kahve kokusu onu mutfağa <w>çekti</w>.",
                                "es": "El olor a café recién hecho lo <w>atrajo</w> a la cocina."
                            }
                        },
                        {
                            "text": "They tried to <w>lure</w> the animal out of its hiding place with food.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>выманить</w> животное из укрытия едой.",
                                "tr": "Hayvanı yiyecekle saklandığı yerden <w>çıkarmaya</w> çalıştılar.",
                                "es": "Intentaron <w>atraer</w> al animal fuera de su escondite con comida."
                            }
                        }
                    ],
                    "synonyms": [
                        "entice"
                    ],
                    "antonyms": [
                        "repel",
                        "deter"
                    ],
                    "common_phrases": [
                        "lure into",
                        "lure away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать искушением, призывом или хитростью.",
                        "tr": "Birini cazibe, vaat veya hile ile kendine çekmek.",
                        "es": "Atraer a alguien mediante la tentación, el encanto o el engaño."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завлекать",
                                "target_lang_sense_clarification": "хитростью или обещаниями"
                            },
                            {
                                "target_lang_word": "приманивать",
                                "target_lang_sense_clarification": "привлекать приманкой"
                            },
                            {
                                "target_lang_word": "манить",
                                "target_lang_sense_clarification": "звать, привлекать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cezbetmek",
                                "target_lang_sense_clarification": "kendine çekmek, bağlamak"
                            },
                            {
                                "target_lang_word": "ayartmak",
                                "target_lang_sense_clarification": "kandırmak veya baştan çıkarmak"
                            },
                            {
                                "target_lang_word": "yemlemek",
                                "target_lang_sense_clarification": "birini elde edecek şekilde davranmak"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atraer",
                                "target_lang_sense_clarification": "hacer que alguien o algo se acerque por interés o deseo"
                            },
                            {
                                "target_lang_word": "seducir",
                                "target_lang_sense_clarification": "persuadir o cautivar a alguien para que haga algo"
                            },
                            {
                                "target_lang_word": "tentar",
                                "target_lang_sense_clarification": "incitar a alguien a hacer algo, a menudo algo indebido"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "030f42eb-a859-3c3a-88b9-8c8e9370f4fc",
                    "sense_definition": "Something that tempts or attracts, especially one with a promise of reward or pleasure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attract_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not resist the <w>lure</w> of easy money.",
                            "target_lang_translations": {
                                "ru": "Он не мог устоять перед <w>соблазном</w> легких денег.",
                                "tr": "Kolay paranın <w>cazibesine</w> karşı koyamadı.",
                                "es": "No pudo resistirse a la <w>tentación</w> del dinero fácil."
                            }
                        },
                        {
                            "text": "The <w>lure</w> of the big city attracts many young people.",
                            "target_lang_translations": {
                                "ru": "<w>Соблазн</w> большого города привлекает многих молодых людей.",
                                "tr": "Büyük şehrin <w>cazibesi</w> birçok genci kendine çekiyor.",
                                "es": "El <w>atractivo</w> de la gran ciudad atrae a muchos jóvenes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the lure of",
                        "resist the lure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что искушает или привлекает, особенно обещанием награды или удовольствия.",
                        "tr": "Özellikle ödül veya zevk vaadiyle insanı cezbeden veya çeken şey.",
                        "es": "Algo que tienta o atrae, especialmente con la promesa de una recompensa o placer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазн",
                                "target_lang_sense_clarification": "искушение"
                            },
                            {
                                "target_lang_word": "приманка",
                                "target_lang_sense_clarification": "перен. средство привлечения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cazibe",
                                "target_lang_sense_clarification": "çekicilik"
                            },
                            {
                                "target_lang_word": "yem",
                                "target_lang_sense_clarification": "birini aldatmak için hazırlanan düzen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tentación",
                                "target_lang_sense_clarification": "deseo intenso de hacer o tener algo"
                            },
                            {
                                "target_lang_word": "aliciente",
                                "target_lang_sense_clarification": "estímulo o incentivo que empuja a actuar"
                            },
                            {
                                "target_lang_word": "atractivo",
                                "target_lang_sense_clarification": "cualidad que hace que algo sea deseable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66bd009f-f8fe-31f7-81d7-f4d61fb5a65b",
                    "sense_definition": "An artificial bait attached to a fishing line to attract fish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fishing_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached a bright green <w>lure</w> to his fishing line.",
                            "target_lang_translations": {
                                "ru": "Он прикрепил ярко-зеленую <w>блесну</w> к своей леске.",
                                "tr": "Oltasına parlak yeşil bir <w>yem</w> taktı.",
                                "es": "Ató un <w>señuelo</w> verde brillante a su sedal."
                            }
                        },
                        {
                            "text": "The fish ignored the worm but went for the shiny <w>lure</w>.",
                            "target_lang_translations": {
                                "ru": "Рыба проигнорировала червяка, но клюнула на блестящую <w>блесну</w>.",
                                "tr": "Balık solucanı görmezden geldi ama parlak <w>yeme</w> yöneldi.",
                                "es": "El pez ignoró el gusano pero fue directo al <w>señuelo</w> brillante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fishing lure",
                        "cast a lure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственная наживка, прикрепленная к леске для привлечения рыбы.",
                        "tr": "Balık tutmak için oltaya takılan yapay yem.",
                        "es": "Cebo artificial que se coloca en el anzuelo para atraer a los peces."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блесна",
                                "target_lang_sense_clarification": "искусственная наживка"
                            },
                            {
                                "target_lang_word": "приманка",
                                "target_lang_sense_clarification": "рыболовная"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yem",
                                "target_lang_sense_clarification": "oltaya takılan nesne"
                            },
                            {
                                "target_lang_word": "zoka",
                                "target_lang_sense_clarification": "özel bir tür balık iğnesi"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cebo",
                                "target_lang_sense_clarification": "carnaza o señuelo para pescar"
                            },
                            {
                                "target_lang_word": "señuelo",
                                "target_lang_sense_clarification": "objeto artificial usado para atraer peces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a97b51a0-6582-36c8-a918-fa43b593306a",
                    "sense_definition": "A bunch of feathers attached to a line, used in falconry to recall the hawk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "falconry_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falconer swung the <w>lure</w> to call the bird back.",
                            "target_lang_translations": {
                                "ru": "Сокольник размахивал <w>вабилом</w>, чтобы подозвать птицу обратно.",
                                "tr": "Doğancı, kuşu geri çağırmak için <w>yemi</w> salladı.",
                                "es": "El cetrero balanceó el <w>señuelo</w> para llamar al ave de vuelta."
                            }
                        },
                        {
                            "text": "Training a hawk requires patience and the proper use of a <w>lure</w>.",
                            "target_lang_translations": {
                                "ru": "Обучение ястреба требует терпения и правильного использования <w>вабила</w>.",
                                "tr": "Bir şahini eğitmek sabır ve <w>yemin</w> doğru kullanılmasını gerektirir.",
                                "es": "Entrenar a un halcón requiere paciencia y el uso adecuado de un <w>señuelo</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связка перьев на веревке, используемая в соколиной охоте для возвращения птицы.",
                        "tr": "Doğancıların av kuşunu geri çağırmak için kullandığı, ipe bağlı tüy demeti.",
                        "es": "Objeto, generalmente con plumas, usado en cetrería para llamar al ave de regreso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вабило",
                                "target_lang_sense_clarification": "для соколиной охоты"
                            }
                        ],
                        "tr": [],
                        "es": [
                            {
                                "target_lang_word": "señuelo",
                                "target_lang_sense_clarification": "objeto usado en cetrería para atraer al ave"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}