{
    "word_family": [
        "discover",
        "discoverer",
        "discovery",
        "discoverability",
        "undiscoverable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99b694b0-d540-30cf-94e7-51d4660a562b",
                    "sense_definition": "Able to be found, seen, or detected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using proper keywords makes your content much more <w>discoverable</w> online.",
                            "target_lang_translations": {
                                "ru": "Использование правильных ключевых слов делает ваш контент в сети гораздо более <w>легко находимым</w>."
                            }
                        },
                        {
                            "text": "The hidden camera was not easily <w>discoverable</w> by visitors.",
                            "target_lang_translations": {
                                "ru": "Скрытую камеру посетителям было не так-то просто <w>обнаружить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "findable",
                        "discernible",
                        "discernable"
                    ],
                    "antonyms": [
                        "undiscoverable"
                    ],
                    "common_phrases": [
                        "easily discoverable",
                        "more discoverable",
                        "discoverable online"
                    ],
                    "target_lang_definitions": {
                        "ru": "Который можно найти, обнаружить или заметить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находимый",
                                "target_lang_sense_clarification": "такой, который легко найти"
                            },
                            {
                                "target_lang_word": "легко находимый",
                                "target_lang_sense_clarification": "доступный для поиска"
                            },
                            {
                                "target_lang_word": "обнаруживаемый",
                                "target_lang_sense_clarification": "поддающийся обнаружению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a38ec06e-16d5-3e84-beb5-307a9f1e94d1",
                    "sense_definition": "Subject to legal discovery; required to be shared with an opposing party during a lawsuit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge ruled that the internal company emails were fully <w>discoverable</w>.",
                            "target_lang_translations": {
                                "ru": "Судья постановил, что внутренняя переписка компании полностью <w>подлежит раскрытию</w>."
                            }
                        },
                        {
                            "text": "Private notes may not be <w>discoverable</w> if they fall under attorney-client privilege.",
                            "target_lang_translations": {
                                "ru": "Личные записи могут не <w>подлежать раскрытию</w>, если они подпадают под адвокатскую тайну."
                            }
                        }
                    ],
                    "common_phrases": [
                        "discoverable documents",
                        "discoverable evidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлежащий раскрытию или предоставлению противоположной стороне в ходе судебного разбирательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлежащий раскрытию",
                                "target_lang_sense_clarification": "в юридическом контексте судебного процесса"
                            },
                            {
                                "target_lang_word": "подлежащий приобщению к делу",
                                "target_lang_sense_clarification": "о доказательствах и документах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}