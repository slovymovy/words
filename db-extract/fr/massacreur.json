                "senses": [
                    {
                        "sense_id": "2ffb2e50-5067-3a4a-9635-8cb18174b0f7",
                        "entry_id": "527398ec-ade2-34b6-b309-09b0da78e68b",
                        "glosses": [
                            "Celui qui prend part à un massacre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c9670b-a690-48df-baa8-e99aa07edc0d",
                                "sense_id": "2ffb2e50-5067-3a4a-9635-8cb18174b0f7",
                                "text": "J’étais un violeur et un massacreur : j’ai subi ma métamorphose."
                            },
                            {
                                "example_id": "d6706d1c-9a1a-47c4-ba68-ab5093171d39",
                                "sense_id": "2ffb2e50-5067-3a4a-9635-8cb18174b0f7",
                                "text": "Quelques uns, anciens massacreurs de la Saint-Barthélémy, ou bien descendants de ces bouchers qui avaient dominé Paris en 1413, ne voyaient d’autre voie pour arriver à cette solution que le système du duc d’Albe : les échafauds et les proscriptions."
                            }
                        ]
                    },
                    {
                        "sense_id": "e15cccd4-52c1-30ee-8b92-1219d1d8ef20",
                        "entry_id": "527398ec-ade2-34b6-b309-09b0da78e68b",
                        "glosses": [
                            "Celui qui gâche un ouvrage ou une œuvre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dde4f7f5-29d7-4cb7-a407-65b944376bbe",
                                "sense_id": "e15cccd4-52c1-30ee-8b92-1219d1d8ef20",
                                "text": "Massacreur de besogne. Massacreur de Mozart."
                            }
                        ]
                    }
                ],
