                                "sense_id": "b321eed5-2564-35af-b62f-3013220653fa",
                                "text": "De oude zeevaarder vertelde verhalen over zijn avonturen.",
                                "translation": "The old seafarer told stories of his adventures.",
                                "english": "The old seafarer told stories of his adventures."
                            },
