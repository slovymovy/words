                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "59123197-e672-348e-8738-3309aeec68f7",
                        "entry_id": "c6914061-4d6e-3d66-9d21-d77b8da74f5f",
                        "glosses": [
                            "Exciting action in the heart, through the medium of the stomach; cordial; stimulant."
