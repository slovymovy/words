                "senses": [
                    {
                        "sense_id": "595bb731-3327-3673-8dc9-30136e158d73",
                        "entry_id": "b64a39ca-88ba-3fd4-adf3-2c4c608d2538",
                        "glosses": [
                            "Cuire à très haute température calcaire et argile pour former du clinker."
                        ],
                        "tags": [
                            "Cimenterie"
                        ],
                        "examples": [
                            {
                                "example_id": "49759612-215a-4af8-b7b0-9340b437bd78",
                                "sense_id": "595bb731-3327-3673-8dc9-30136e158d73",
                                "text": "Un autre perfectionnement tout récent, et qui paraît d'un grand intérêt, consiste à effectuer la décarbonatation sur une grille mobile analogue aux grilles de chaudières, et de laquelle la matière passe dans un four rotatif très raccourci où elle se clinkérise."
                            },
                            {
                                "example_id": "896b25e4-2538-4900-837d-f7963d200499",
                                "sense_id": "595bb731-3327-3673-8dc9-30136e158d73",
                                "text": "Une autre raison, semble être à l'origine de la mauvaise aptitude des crus à haut degré de saturation en chaux; elle est liée à l'homogénéisation et la distribution fortuite des particules des crus à clinkériser : il est toujours possible de trouver."
                            }
                        ]
                    }
                ],
