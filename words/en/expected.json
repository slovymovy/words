                    "sense_definition": "Simple past and past participle of <w>expect</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>expected</w> the train to arrive on time, but it was delayed.",
