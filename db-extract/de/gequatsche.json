                ],
                "senses": [
                    {
                        "sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                        "entry_id": "28caf084-6f59-39ec-a472-e832f5404279",
                        "glosses": [
                            "anhaltendes, inhaltsarmes Reden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca7f6023-624a-4071-bf3e-9c5948ab2a10",
                                "sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                                "text": "Ich konnte das dumme Gequatsche auf der Party bald nicht mehr hören."
                            },
                            {
                                "example_id": "34d5eaac-ba14-4edb-85ca-9abc69607558",
                                "sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                                "text": "Niemand kann ihm mehr entkommen – dem Gequatsche am Mobiltelefon, neudeutsch \"Handy\". Liebeskummer, Sexprobleme, Ich-sitze-gerade-im-Zug: alles hört man mit – ob man will oder nicht."
                            },
                            {
                                "example_id": "16dc1d16-83ce-4a19-82a5-8afa57ab12f6",
                                "sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                                "text": "„Ich habe immer geglaubt und glaube jetzt noch mehr denn je, dass dieses ganze europäische Gequatsche über Frieden in Oslo, Berlin und Jerusalem nichts bringt.“"
                            },
                            {
                                "example_id": "9484d3c2-60ce-4573-bd50-cfe8e7d0c616",
                                "sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                                "text": "„Ludda-Kristjan wurde wütend und fragte, ob sie nicht mit ihrem gekünstelten Gequatsche aufhören und anständig Färöisch reden könne.“"
                            },
                            {
                                "example_id": "0dd78887-8fee-420e-ba1e-3a6767584398",
                                "sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                                "text": "„Schließlich fing Stefan wieder mit seinem blöden Gequatsche an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0d4433d-55aa-4ee3-9e92-1e56879218dd",
                        "source_entry_id": "28caf084-6f59-39ec-a472-e832f5404279",
                        "source_sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
                        "source_sense_description": "anhaltendes, inhaltsarmes Reden",
                        "target_lang_word": "claptrap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "claptrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6a216a-680e-302c-8b07-8f6004c54c32",
                                        "entry_id": "68f47bc1-727c-35e7-8fa0-e5f7e7a5f79d",
                                        "glosses": [
                                            "Empty verbiage or nonsense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34cadbf7-79d0-4379-a0c1-28520d7c152e",
                                                "sense_id": "dc6a216a-680e-302c-8b07-8f6004c54c32",
                                                "text": "Klein diagnoses impressively what hasn’t worked. No more claptrap about fracked gas as a bridge to renewables. Enough already of the international summit meetings that produce sirocco-quality hot air, and nonbinding agreements that bind us all to more emissions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccbbabd6-2592-3d04-a4be-ca86119a1df6",
                                        "entry_id": "68f47bc1-727c-35e7-8fa0-e5f7e7a5f79d",
                                        "glosses": [
                                            "A device for producing a clapping sound in theaters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcd3c320-5a2f-31c8-81a1-4826980b3711",
                                        "entry_id": "68f47bc1-727c-35e7-8fa0-e5f7e7a5f79d",
                                        "glosses": [
                                            "A device or trick to gain applause; a humbug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26f83c4-9d2a-40e9-97c3-e2c5c390107c",
                                                "sense_id": "bcd3c320-5a2f-31c8-81a1-4826980b3711",
                                                "text": "There had been a suggestion that the child should be with her [while she answers the door], but the mother herself had rejected this. \"It would be stagey,\" she had said, \"and clap-trap. There is nothing I hate so much as that.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75f4a25a-0327-44d9-8454-53b495b4eaf1",
                        "source_entry_id": "28caf084-6f59-39ec-a472-e832f5404279",
                        "source_sense_id": "bf20cd6d-52b0-3c2d-98a5-5879c2373adc",
