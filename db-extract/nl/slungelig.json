                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longiligne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8152b05b-ae1f-379d-ab88-b55947278ef1",
                                        "entry_id": "81df3fb5-7236-34b3-b74b-9ba3eef72d75",
                                        "glosses": [
                                            "De taille longue et mince, et avec des membres longs et minces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9f476c-ff41-4782-b1fe-061758bdda1e",
                                                "sense_id": "8152b05b-ae1f-379d-ab88-b55947278ef1",
                                                "text": "Leur morphologie longiligne s’accorde avec des origines méridionales de type savanes africaines."
                                            },
                                            {
                                                "example_id": "896008d8-8091-4733-bae5-2b378cb3ffb2",
                                                "sense_id": "8152b05b-ae1f-379d-ab88-b55947278ef1",
                                                "text": "Enfant, il est remuant et turbulent, il grandit beaucoup ‒ sa future constitution longiligne se profile ‒, devient frileux mais a besoin d’air, se fatigue vite et reste maigre malgré un appétit normal."
                                            },
                                            {
                                                "example_id": "6e98c0ce-d9d6-41f7-b000-0ad0727d06e3",
                                                "sense_id": "8152b05b-ae1f-379d-ab88-b55947278ef1",
                                                "text": "Nu, il regarde sa carcasse longiligne, ses muscles secs, tendus sur ses os saillants. Rassuré que ça tienne encore debout."
                                            },
                                            {
                                                "example_id": "0b8630b8-9ad5-418b-937b-0499e905a4fc",
                                                "sense_id": "8152b05b-ae1f-379d-ab88-b55947278ef1",
                                                "text": "Lorsque, du perron de Matignon où je l'attends, je vois sortir de son véhicule le nouveau Premier ministre, il m'apparaît immense, déraisonnablement grand et longiligne et comme dissimulé derrière sa barbe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "longiligne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d372b660-2030-3340-8ab3-020cb8c6c47c",
                                        "entry_id": "7397d4a3-398c-3d68-8976-3b2580089504",
                                        "glosses": [
                                            "Espèce de taille longue et mince, et avec des membres longs et minces par opposition à une autre espèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8782f03-41d8-49ab-ba29-b950cc566199",
                                                "sense_id": "d372b660-2030-3340-8ab3-020cb8c6c47c",
                                                "text": "C’est ainsi que le lévrier russe est le longiligne de l’épagneul, dont le pékinois est le bréviligne et que le lévrier écossais est le longiligne du mâtin, dont le bréviligne est le carlin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
