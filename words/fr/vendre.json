            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d5f9191-3260-392c-8c1b-5adafc878fbf",
                    "sense_definition": "Donner un bien à quelqu'un en échange d'une somme d'argent, lui en céder la propriété contre un prix.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils veulent <w>vendre</w> leur maison avant de déménager dans une autre ville."
                        },
                        {
                            "text": "Il <w>vend</w> sa vieille voiture à un voisin pour mille euros."
                        },
                        {
                            "text": "Elle a <w>vendu</w> ses livres d'occasion sur Internet."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "antonyms": [
                        "acheter"
                    ],
                    "common_phrases": [
                        "vendre une maison",
                        "vendre à bas prix",
                        "vendre aux enchères",
                        "vendre cher"
                    ]
                },
                {
                    "sense_id": "ee9c4147-4fc3-3ba8-be45-76430b2326ea",
                    "sense_definition": "Proposer des marchandises à la vente et en faire commerce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magasin <w>vend</w> des vêtements, des chaussures et des accessoires."
                        },
                        {
                            "text": "Mon oncle <w>vend</w> des fruits et des légumes sur le marché chaque samedi."
                        },
                        {
                            "text": "Cette boulangerie <w>vend</w> aussi du café et des sandwichs."
                        }
                    ],
                    "synonyms": [
                        "commercialiser"
                    ],
                    "antonyms": [
                        "acheter"
                    ],
                    "common_phrases": [
                        "vendre des produits",
                        "vendre en ligne",
                        "vendre au détail"
                    ]
                },
                {
                    "sense_id": "28fd1470-9807-3301-ac67-576ee5358bd3",
                    "sense_definition": "À la forme pronominale, trouver des acheteurs ; être vendu en une certaine quantité ou à un certain prix.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre s'est <w>vendu</w> à des millions d'exemplaires dans le monde entier."
                        },
                        {
                            "text": "Les glaces se <w>vendent</w> surtout en été, quand il fait chaud."
                        },
                        {
                            "text": "Ce roman se <w>vend</w> très bien depuis sa sortie en librairie."
                        }
                    ],
                    "common_phrases": [
                        "se vendre bien",
                        "se vendre cher",
                        "se vendre facilement"
                    ]
                },
                {
                    "sense_id": "c80b9683-c13b-3f83-a7a0-de75b29e88d6",
                    "sense_definition": "Trahir quelqu'un ou une cause, révéler un secret ou dénoncer quelqu'un par intérêt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>vendu</w> ses complices à la police pour réduire sa peine."
                        },
                        {
                            "text": "On l'accuse d'avoir <w>vendu</w> son pays à l'ennemi en échange d'argent."
                        },
                        {
                            "text": "C'est lui qui nous a <w>vendus</w> alors que nous lui faisions confiance."
                        }
                    ],
                    "synonyms": [
                        "trahir"
                    ],
                    "common_phrases": [
                        "vendre sa patrie",
                        "vendre un ami",
                        "vendre ses complices"
                    ]
                }
            ]
        }
