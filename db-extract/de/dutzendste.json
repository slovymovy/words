                        "sense_id": "4bf3b2f0-3db2-376f-b13d-b3437d618a35",
                        "entry_id": "c333fd5b-fba3-36e4-b951-d57aa2c250e5",
                        "glosses": [
                            "Ordnungszahl, in einer Reihenfolge an hoher (unbestimmter) Stelle"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4199dc04-be2d-41d1-b54d-f5e13d4cc627",
                                "sense_id": "4bf3b2f0-3db2-376f-b13d-b3437d618a35",
                                "text": "„Die Fülle erstickt bald das Interesse: Was soll die fünfte Sichel und das dutzendste Hufeisen noch zum weiteren Verständnis beitragen?“"
                            },
                            {
                                "example_id": "595b7bc5-f868-40bd-b466-aa0d3df8de70",
                                "sense_id": "4bf3b2f0-3db2-376f-b13d-b3437d618a35",
                                "text": "„Und nun, endlich, war ein Vertreter der Regierung erschienen, ein freundlich lächelnder rundlicher Mann, der sich nun schon das dutzendste Mal die angelaufenen Gläser der Sonnenbrille putzte.“"
                            },
                            {
                                "example_id": "d25eb57e-38e4-4bc3-a3c8-b3d994a5eb6d",
                                "sense_id": "4bf3b2f0-3db2-376f-b13d-b3437d618a35",
                                "text": "„Die Handlung von „Heat\" könnte nichts anderes als die dutzendste Variation kinoüblicher Action-Muster sein, wäre sie nicht konsequent in eine andere Richtung inszeniert.“"
                            },
                            {
                                "example_id": "5979a5fc-f295-41d5-80c2-484c4237dfcf",
                                "sense_id": "4bf3b2f0-3db2-376f-b13d-b3437d618a35",
                                "text": "„Ludwig Erhard erinnerte zum dutzendsten Mal an die nationale Verantwortung: \"Wenn ich, Vizekanzler in England wäre und dort an das nationale Interesse appellierte, würde ich durchdringen.\"“"
                            },
                            {
                                "example_id": "e4b99620-47d7-412f-a553-039676d83ae9",
                                "sense_id": "4bf3b2f0-3db2-376f-b13d-b3437d618a35",
                                "text": "„Das mag funktionieren, vor allem bei jüngeren Frauen, die das noch nicht zum dutzendsten Mal erlebt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
