                "senses": [
                    {
                        "sense_id": "153a3564-bdeb-3827-b220-500956545e7b",
                        "entry_id": "d143220f-b0b8-31b7-bfc5-856abc9b0263",
                        "glosses": [
                            "Agir comme un psychotique, de façon incorrecte et déraisonnable, paniquer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ec140e60-8dae-4c82-8f9f-0e61771e9300",
                                "sense_id": "153a3564-bdeb-3827-b220-500956545e7b",
                                "text": "Cette manœuvre était destinée à faire psychoter les soldats à l’intérieur de la pièce, et neuf fois sur dix, ils tiraient. Trop stressés : ils voyaient une arme et ils pressaient la détente."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f58cf15-a41f-3124-8da3-9b08366d5423",
                        "entry_id": "d143220f-b0b8-31b7-bfc5-856abc9b0263",
                        "glosses": [
                            "S’inquiéter inutilement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6b4705a8-3b47-4e30-b5c3-7298a476030e",
                                "sense_id": "2f58cf15-a41f-3124-8da3-9b08366d5423",
                                "text": "Arrête de psychoter."
                            },
                            {
                                "example_id": "f2f57005-dd50-48d1-841e-1547fae4abde",
                                "sense_id": "2f58cf15-a41f-3124-8da3-9b08366d5423",
                                "text": "À côté de moi, Pep psychote :\n– Tu crois que je vais supporter un vol aussi long ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9572d82e-28ec-3193-9e7b-6842dd0db5fa",
                        "entry_id": "d143220f-b0b8-31b7-bfc5-856abc9b0263",
                        "glosses": [
                            "Bercer son imagination, dans un instant angoissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668d330e-db1b-45db-8530-243349b06e2d",
                                "sense_id": "9572d82e-28ec-3193-9e7b-6842dd0db5fa",
                                "text": "Il psychotait moins sur leurs incapacités à rêver, que de leurs faiblesses à rejoindre le sien.."
                            }
                        ]
                    }
