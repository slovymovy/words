                        "cross_references": [
                            {
                                "target_word": "control tower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "365f9b98-86cc-3476-a8a3-a960578b2833",
                                        "entry_id": "0b2669c1-9642-3688-8e95-7b9731881915",
                                        "glosses": [
                                            "An airport building from which the air traffic control unit monitors and directs the movement of aircraft on and around the airport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6dadf4-006f-4710-9849-c15030afbf89",
                                                "sense_id": "365f9b98-86cc-3476-a8a3-a960578b2833",
                                                "text": "As he taxied out to the far side of the field, 38-year-old Captain Benton R. (\"Lucky\") Baldwin was cleared for takeoff. The control tower gave him his choice of two runways—No. 13 or No. 18."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e6ba881-9cdb-3d3e-a55f-c0921646556f",
                                        "entry_id": "0b2669c1-9642-3688-8e95-7b9731881915",
                                        "glosses": [
                                            "An enclosed, raised structure occupied by one or more persons who operate or exercise control over railway traffic, ship movement, a racetrack, machinery, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61376b58-25c6-4a8e-84cd-14be98111abe",
                                                "sense_id": "3e6ba881-9cdb-3d3e-a55f-c0921646556f",
                                                "text": "Ned Newton stood beside Tom in the control tower of the great tank as she started on her homeward way."
                                            },
                                            {
                                                "example_id": "1ff64a05-4064-401d-9fdf-f14a2b0e1daa",
                                                "sense_id": "3e6ba881-9cdb-3d3e-a55f-c0921646556f",
                                                "text": "In a railway control tower at Dunkirk, Ohio, Operator Cliff Schwartzkopf waited for the Pennsylvania's Pennsylvanian, eastbound from Chicago to New York."
                                            },
                                            {
                                                "example_id": "9f881807-c61c-4438-8104-b6bac6b674ef",
                                                "sense_id": "3e6ba881-9cdb-3d3e-a55f-c0921646556f",
                                                "text": "From the control tower high above the sprawling container port here, Danny Law helps manage the relentless loading and unloading of cargo, day and night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3cb4d68-fd3c-40ac-8ba4-83464a0509f9",
                        "source_entry_id": "a682e99d-3c39-3314-82bb-6559f0346d48",
                        "source_sense_id": "e46af810-cf52-30fb-a2d1-c949641e3ebb",
