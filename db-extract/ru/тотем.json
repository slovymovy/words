                "senses": [
                    {
                        "sense_id": "61924088-db43-3a6c-bc5c-019bda03fbd1",
                        "entry_id": "b9c06e0e-5eaf-3732-9c5f-e1daddbaa94a",
                        "glosses": [
                            "в верованиях некоторых примитивных народов — животное (реже растение и др.), обладающее магической силой, часто считающееся родоначальником племени и являющееся предметом религиозного культа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c9e8575-2fda-43ab-9e70-99cd4c48cc0d",
                                "sense_id": "61924088-db43-3a6c-bc5c-019bda03fbd1",
                                "text": "Культ тотемов."
                            }
                        ]
                    },
                    {
                        "sense_id": "53852e73-d376-35fb-86cd-10d991c93eb5",
                        "entry_id": "b9c06e0e-5eaf-3732-9c5f-e1daddbaa94a",
                        "glosses": [
                            "герб племени — изображение такого животного (или растения и др.)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28c0aa56-d3ea-4051-ba53-2d3056f42c1b",
                        "source_entry_id": "b9c06e0e-5eaf-3732-9c5f-e1daddbaa94a",
                        "target_lang_word": "totem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d74f3c8-a4fb-326a-9804-a376e393065e",
                                        "entry_id": "1ff9c7ab-2efd-35a1-bb32-dd23ef073ac9",
                                        "glosses": [
                                            "Any natural object or living creature that serves as an emblem of a tribe, clan or family; the representation of such an object or creature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d14dc651-7105-3e7c-bac2-167f83620328",
                                        "entry_id": "1ff9c7ab-2efd-35a1-bb32-dd23ef073ac9",
                                        "glosses": [
                                            "The clan whose kinship is defined in reference to such an object or creature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "859b0f10-7965-475a-9782-b10146192b08",
                                                "sense_id": "d14dc651-7105-3e7c-bac2-167f83620328",
                                                "text": "The totem members were forbidden to eat the flesh of the totem animal, or were allowed to do so only under specific conditions."
                                            },
                                            {
                                                "example_id": "83ec8b21-bebe-4348-9e8c-6db7d97f6abf",
                                                "sense_id": "d14dc651-7105-3e7c-bac2-167f83620328",
                                                "text": "These meanings flow from bear-like characteristics imprinted on totem members. Members of the bear clan may have dispositional, cognitive, and physical capabilities similar to those of bear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2fafe1a-d218-3298-84f4-7b0717ee933b",
                                        "entry_id": "1ff9c7ab-2efd-35a1-bb32-dd23ef073ac9",
                                        "glosses": [
                                            "A symbol or personification."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "303a0f26-b376-40f3-a0df-46d3e39ee72d",
                                                "sense_id": "c2fafe1a-d218-3298-84f4-7b0717ee933b",
                                                "text": "“She became a totem,” he added. “She became the personification of a particular response to the pandemic, which people in the far-flung margins of the internet and the not so far-flung margins used against her.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6477bf0-fa52-37b0-a3cd-e7b62ce9ea7b",
                                        "entry_id": "1ff9c7ab-2efd-35a1-bb32-dd23ef073ac9",
                                        "glosses": [
                                            "An arbitrarily chosen object serving as a reminder to check whether one is awake or not, to aid in having lucid dreams."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f922857-6468-427f-9717-c9e13700afca",
                                                "sense_id": "e6477bf0-fa52-37b0-a3cd-e7b62ce9ea7b",
                                                "text": "The best way to determine if you are dreaming or not is to have a totem in your lucid dreams that does not exist in reality. Inducing yourself is as easy as waking up during the night and practicing as you fall back asleep. Say, \"I will be aware I am dreaming while I am dreaming by seeing my totem.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8b168ef-9fd4-3d9d-8e8a-f26e8c9452b3",
                                        "entry_id": "1ff9c7ab-2efd-35a1-bb32-dd23ef073ac9",
                                        "glosses": [
                                            "A tall object resembling a totem pole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d82939f9-fa50-4c59-8235-7d08542c08ad",
                                                "sense_id": "a8b168ef-9fd4-3d9d-8e8a-f26e8c9452b3",
                                                "text": "Out the front of the Drive-in rose the town’s main tourist attraction, a totem of signs to bizarre places with impossible distances such as Sydney, Melbourne, Adelaide and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cf0548d-2b95-4324-83f4-062befa193ed",
                        "source_entry_id": "b9c06e0e-5eaf-3732-9c5f-e1daddbaa94a",
                        "target_lang_word": "tótem",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tótem",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b521f480-5301-3de5-85fe-7aa1b036c589",
                                        "entry_id": "ccee7a75-ed14-38a7-b837-8026a8e70f70",
                                        "glosses": [
                                            "Espíritu o ser sobrenatural que en algunas mitologías se considera ancestro y patrón de un linaje."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ce628f-8aec-4c29-893a-2b18d99c4748",
                                                "sense_id": "b521f480-5301-3de5-85fe-7aa1b036c589",
                                                "text": "Al bravo ritmo del candombe\ndespierta el tótem ancestral:\npantera, antílope, elefante,\nsierpe, hipopótamo, caimán.\nEn el silencio de la selva\nbate el tambor sacramental,\ny el negro baila poseído\nde la gran bestia original."
                                            },
                                            {
                                                "example_id": "cc053943-1f30-40fa-9a61-1629d72afdd4",
                                                "sense_id": "b521f480-5301-3de5-85fe-7aa1b036c589",
                                                "text": "Sin embargo, la palabra tzotzil significa hombre murciélago u hombre-vampiro, debido a que la tribu tiene por tótem un quiróptero de esa especie. Y aunque el tótem no suele poseer atributos precisamente divinos y es más bien una especie de genio protector o numen, para el caso y de acuerdo con las reflexiones del brujo se le concedió un poder de divinidad, pudiendo suponerse que era un gigantesco animal de esa naturaleza, un tenebroso vampiro, el que aprovechando sus hábitos noctívagos, bajaba volando en la oscuridad para abrevar su sed de sangre en los borregos de sus protegidos tzotziles, que algo malo debían haberle hecho para tenerle tan resentido."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c366918b-69a1-3bb4-a4b3-274aadec6d0a",
                                        "entry_id": "ccee7a75-ed14-38a7-b837-8026a8e70f70",
                                        "glosses": [
                                            "Linaje que desciende de un tótem₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc33f0ba-8d71-4a31-a834-ba16f46fc874",
                                                "sense_id": "c366918b-69a1-3bb4-a4b3-274aadec6d0a",
                                                "text": "Cuando totems y clanes forman parte de la organización social, el matrimonio se halla prohibido entre los miembros del mismo tótem o clan."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4e2cec64-da83-357b-9350-310cea3dce51",
                                        "entry_id": "ccee7a75-ed14-38a7-b837-8026a8e70f70",
                                        "glosses": [
                                            "Representación pictórica o escultórica de un tótem₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c2d176-c969-4f7c-96d3-377d23c520a2",
                                                "sense_id": "4e2cec64-da83-357b-9350-310cea3dce51",
                                                "text": "Con la mano izquierda sobre la empuñadura de plata de su bastón, semejaba un tótem indígena somnoliento, con los ojos semicerrados."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
