                        ],
                        "form": "die Enochs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                        "entry_id": "62f457b2-609e-3edc-b60c-196cb7cbd9e0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01665720-6911-4c10-9386-6356e8ac288a",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Frau Enoch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d1e866f1-f691-4c0a-83a0-11a9d1f095d6",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Herr Enoch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "818e9b94-72f2-44f2-97e2-7afad2a8833b",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Die Enochs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7a01c9f3-fc1d-492e-be10-e61a99369a4a",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Der Enoch trägt nie die Schals, die die Enoch ihm strickt."
                            },
                            {
                                "example_id": "fa007a39-de0d-42a3-9482-eff92aa4426f",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Enoch kommt, geht der Herr Enoch.“"
                            },
                            {
                                "example_id": "158caa85-0879-462e-960d-06d62ad7bdf0",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Enoch kommt und geht."
                            },
                            {
                                "example_id": "809dbb43-1b93-43ec-b156-5bd307922873",
                                "sense_id": "57957739-6e13-3c44-8eae-26ae93aa8fdb",
                                "text": "Enochs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
