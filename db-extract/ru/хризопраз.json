                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64250653-14e9-458b-b92a-5a8ea58e1796",
                        "source_entry_id": "3b488636-0020-3ed7-8fe2-9e3ab53c011a",
                        "source_sense_id": "479f81c1-b2b4-3842-ac27-7490fe8fb6c6",
                        "target_lang_word": "chrysoprase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chrysoprase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b78ab5d8-4d7f-3924-914d-4cb0354cb024",
                                        "entry_id": "ffc40219-907b-3b2a-8e2e-1d17568738d2",
                                        "glosses": [
                                            "Variété gemme de calcédoine nickélifère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c76354-d7f0-4137-92b7-6243b09dff52",
                                                "sense_id": "b78ab5d8-4d7f-3924-914d-4cb0354cb024",
                                                "text": "Ses prunelles se ravivèrent et brillèrent comme des chrysoprases."
                                            },
                                            {
                                                "example_id": "367aad7d-50b2-4623-b8b0-173f8aeb37f5",
                                                "sense_id": "b78ab5d8-4d7f-3924-914d-4cb0354cb024",
                                                "text": "― Ô ma chère Laura, lui dis-je avec effort en appuyant mes lèvres sur sa main, comment peux-tu appliquer le mot de travail ingrat à l’admirable voyage que nous avons fait ensemble dans le cristal ? Rends-moi cette resplendissante vision des océans d’opale et des îles de lapis ! Retournons aux verts bosquets de la chrysoprase et aux sublimes rivages de l’euclase et de la spinelle, ou aux fantastiques stalagmites des grottes d’albâtre qui nous invitaient à un si doux repos ! Pourquoi as-tu voulu me faire franchir les limites du monde sidéral et me faire voir des choses que l’œil humain ne peut supporter ?"
                                            },
                                            {
                                                "example_id": "336fec99-ae5a-4cea-8b0c-705b384952a9",
                                                "sense_id": "b78ab5d8-4d7f-3924-914d-4cb0354cb024",
                                                "text": "Je devrais maintenant énumérer les marchandises qu’on y achète avec bénéfice : agate, onyx, chrysoprase, et d’autres variétés de calcédoine ; louer la chair du faisan doré qu’on y cuisine sur la flamme du bois de cerisier sec et qu’on saupoudre de beaucoup d’origan ; parler des femmes que j’ai vues prendre leur bain dans le bassin d’un jardin et qui parfois — dit-on — invitent le passant à se dévêtir avec elles, et les pourchasser dans l’eau."
                                            },
                                            {
                                                "example_id": "3941c33f-334b-46fb-a8ea-8577c265346c",
                                                "sense_id": "b78ab5d8-4d7f-3924-914d-4cb0354cb024",
                                                "text": "C’est l’Inde, patrie des pierres, qui nous envoie la chrysoprase."
                                            },
                                            {
                                                "example_id": "7634cfe8-300a-41ac-bc1f-12921d98892c",
                                                "sense_id": "b78ab5d8-4d7f-3924-914d-4cb0354cb024",
                                                "text": "Seules la chrysolite et la chrysoprase peuvent présenter quelques discrètes nuances jaunâtres, mais leur coloration s’inscrit bien davantage dans la gamme des verts que dans celle des jaunes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
