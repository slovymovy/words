                "senses": [
                    {
                        "sense_id": "9a7a0e5c-f90e-32d5-b3f6-9d497ec05450",
                        "entry_id": "c7e31965-7801-342d-9717-18b64a979616",
                        "glosses": [
                            "Woche im Oktober"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22a61fc-33cd-4d5f-a725-dc63b4cb00fa",
                                "sense_id": "9a7a0e5c-f90e-32d5-b3f6-9d497ec05450",
                                "text": "„Zumindest in der ersten Oktoberwoche zeigt sich der Herbst – schuld ist ein Schwall polarer Kaltluft aus Russland – von seiner weniger hübschen Seite.“"
                            },
                            {
                                "example_id": "dc2294f7-d85c-429a-963b-3c0293bd808e",
                                "sense_id": "9a7a0e5c-f90e-32d5-b3f6-9d497ec05450",
                                "text": "Danella kam in der ersten Oktoberwoche und blieb bis zu meinem Geburtstag."
                            },
                            {
                                "example_id": "fbb418ae-e425-499b-b929-1bd45279bd0c",
                                "sense_id": "9a7a0e5c-f90e-32d5-b3f6-9d497ec05450",
                                "text": "„In Windeseile wurden Rahen, Bugspriet, Giekbaum, Tannensparre und Ruder montiert, so daß die Schaluppe bereits in der ersten Oktoberwoche segelfertig war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
