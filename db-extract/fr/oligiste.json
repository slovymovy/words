                        "examples": [
                            {
                                "example_id": "cb38cbbe-de2b-46fe-8312-229471c9a3e4",
                                "sense_id": "356e868d-671c-3e98-abb8-bfe0c4859e19",
                                "text": "Sur le territoire d’Aubrives, s'élève une montagne formée de poudingue de Burnot, qui se reconnait aussitôt par une couleur rougeâtre due à l’oligiste qu'il renferme. Cette montagne rocailleuse, en partie boisée, offre une flore assez variée."
                            },
                            {
                                "example_id": "4c20d93e-10f0-44c3-98d4-9efe7743fecf",
                                "sense_id": "356e868d-671c-3e98-abb8-bfe0c4859e19",
                                "text": "La couche d'oligiste, qui semble servir d'enveloppe au système carbonifère, est exploitée dans ta plupart des localités où elle a acquis un développement suffisant."
                            }
                        ]
                    }
