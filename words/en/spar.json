{
    "word_family": [
        "sparring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96c4a229-d81f-3736-8f52-f21503666370",
                    "sense_definition": "To fight, especially as practice for martial arts or hand-to-hand combat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxers <w>sparred</w> for three rounds to prepare for the upcoming championship match.",
                            "target_lang_translations": {
                                "ru": "Боксеры <w>спарринговали</w> три раунда, чтобы подготовиться к предстоящему чемпионскому матчу."
                            }
                        },
                        {
                            "text": "It is common for martial artists to <w>spar</w> with partners to improve their defensive techniques.",
                            "target_lang_translations": {
                                "ru": "Для мастеров боевых искусств обычно <w>спарринговать</w> с партнерами, чтобы улучшить свои защитные техники."
                            }
                        }
                    ],
                    "synonyms": [
                        "box",
                        "practice"
                    ],
                    "common_phrases": [
                        "sparring partner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сражаться, особенно в качестве тренировки в боевых искусствах или рукопашном бою."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спарринговать",
                                "target_lang_sense_clarification": "участвовать в тренировочном поединке"
                            },
                            {
                                "target_lang_word": "вести тренировочный бой",
                                "target_lang_sense_clarification": "проводить учебный спарринг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "925ff77e-896d-3c12-ae12-4aafe7dcb27b",
                    "sense_definition": "To contest in words; to wrangle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two politicians <w>sparred</w> over the new tax policy during the televised debate.",
                            "target_lang_translations": {
                                "ru": "Два политика <w>препирались</w> по поводу новой налоговой политики во время телевизионных дебатов."
                            }
                        },
                        {
                            "text": "They often <w>spar</w> verbally during meetings because they have very different management styles.",
                            "target_lang_translations": {
                                "ru": "Они часто <w>полемизируют</w> на собраниях, потому что у них очень разные стили управления."
                            }
                        }
                    ],
                    "synonyms": [
                        "argue",
                        "bicker",
                        "quarrel"
                    ],
                    "antonyms": [
                        "agree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Словесно спорить, препираться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препираться",
                                "target_lang_sense_clarification": "спорить по пустякам"
                            },
                            {
                                "target_lang_word": "полемизировать",
                                "target_lang_sense_clarification": "вести острый словесный спор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9613b363-9fbb-3ec0-ac27-45ca541ff3fe",
                    "sense_definition": "To strike with the feet or spurs, as cocks do.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aggressive roosters began to <w>spar</w> in the middle of the farmyard.",
                            "target_lang_translations": {
                                "ru": "Агрессивные петухи начали <w>драться</w> посреди двора."
                            }
                        },
                        {
                            "text": "The birds <w>sparred</w> fiercely until one finally retreated from the enclosure.",
                            "target_lang_translations": {
                                "ru": "Птицы яростно <w>дрались</w>, пока одна из них наконец не отступила из вольера."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить удары ногами или шпорами (о петухах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драться",
                                "target_lang_sense_clarification": "вступать в бой (о птицах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2543b65-7529-3dd5-be40-87039ca6c6dd",
                    "sense_definition": "To bolt or bar a door.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers <w>sparred</w> the heavy wooden gates to keep the intruders out.",
                            "target_lang_translations": {
                                "ru": "Жители деревни <w>заперли на засов</w> тяжелые деревянные ворота, чтобы не пустить незваных гостей."
                            }
                        },
                        {
                            "text": "They <w>sparred</w> the door shut before the storm reached the cabin.",
                            "target_lang_translations": {
                                "ru": "Они <w>заперли на засов</w> дверь, прежде чем шторм достиг хижины."
                            }
                        }
                    ],
                    "synonyms": [
                        "bar",
                        "bolt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запирать дверь на засов или задвижку (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запирать на засов",
                                "target_lang_sense_clarification": "закрывать дверь с помощью поперечной перекладины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "099a7748-8798-350f-b704-dae17395b573",
                    "sense_definition": "To supply or equip a vessel with spars.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwrights worked all week to <w>spar</w> the new sailing vessel.",
                            "target_lang_translations": {
                                "ru": "Корабелы работали всю неделю, чтобы <w>оснастить рангоутом</w> новое парусное судно."
                            }
                        },
                        {
                            "text": "It was necessary to <w>spar</w> the boat properly before it could be launched.",
                            "target_lang_translations": {
                                "ru": "Было необходимо правильно <w>оснастить рангоутом</w> лодку, прежде чем ее можно было спустить на воду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащать судно рангоутом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащать рангоутом",
                                "target_lang_sense_clarification": "устанавливать мачты и реи на корабле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f485f05-e046-3a36-a833-cdc04516319b",
                    "sense_definition": "A thick pole or piece of wood.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers used a heavy <w>spar</w> to prop up the collapsing ceiling.",
                            "target_lang_translations": {
                                "ru": "Рабочие использовали тяжелый <w>столб</w>, чтобы подпереть обрушивающийся потолок."
                            }
                        },
                        {
                            "text": "He carried a long wooden <w>spar</w> across his shoulders to the construction site.",
                            "target_lang_translations": {
                                "ru": "Он нес длинный деревянный <w>шест</w> на плечах к строительной площадке."
                            }
                        }
                    ],
                    "synonyms": [
                        "pole",
                        "beam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстый шест или кусок дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столб",
                                "target_lang_sense_clarification": "вертикально установленное бревно или брус"
                            },
                            {
                                "target_lang_word": "шест",
                                "target_lang_sense_clarification": "длинная деревянная палка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "685f4338-a920-3ed4-bdd9-370e4812e5fb",
                    "sense_definition": "Any linear object used as a mast, sprit, yard, boom, pole or gaff on a ship.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind snapped the main <w>spar</w> of the sailboat during the race.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер сломал главный <w>рангоут</w> парусника во время гонки."
                            }
                        },
                        {
                            "text": "Sailors must regularly inspect every <w>spar</w> to ensure the rigging remains secure.",
                            "target_lang_translations": {
                                "ru": "Моряки должны регулярно проверять каждый <w>элемент рангоута</w>, чтобы убедиться, что такелаж остается надежным."
                            }
                        }
                    ],
                    "synonyms": [
                        "mast",
                        "boom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой линейный объект, используемый как мачта, гик, рея или гафель на корабле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рангоут",
                                "target_lang_sense_clarification": "совокупность мачт, рей и других конструкций судна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c7f439f-1508-3b3f-9527-01276d56921a",
                    "sense_definition": "A beam-like structural member that supports ribs in an aircraft wing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers designed the wing <w>spar</w> to withstand extreme pressure during flight.",
                            "target_lang_translations": {
                                "ru": "Инженеры спроектировали <w>лонжерон</w> крыла так, чтобы он выдерживал экстремальное давление во время полета."
                            }
                        },
                        {
                            "text": "A crack in the main <w>spar</w> can compromise the entire structural integrity of the wing.",
                            "target_lang_translations": {
                                "ru": "Трещина в главном <w>лонжероне</w> может поставить под угрозу всю структурную целостность крыла."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несущий элемент конструкции крыла самолета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лонжерон",
                                "target_lang_sense_clarification": "основной силовой элемент крыла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "104c6513-061e-3e1c-80c2-22bf685f9814",
                    "sense_definition": "A rafter of a roof.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old barn roof was supported by a sturdy central <w>spar</w>.",
                            "target_lang_translations": {
                                "ru": "Крыша старого сарая поддерживалась прочным центральным <w>стропилом</w>."
                            }
                        },
                        {
                            "text": "They replaced the rotted <w>spar</w> to prevent the roof from sagging further.",
                            "target_lang_translations": {
                                "ru": "Они заменили сгнившее <w>стропило</w>, чтобы предотвратить дальнейшее провисание крыши."
                            }
                        }
                    ],
                    "synonyms": [
                        "rafter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стропило крыши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стропило",
                                "target_lang_sense_clarification": "несущая конструкция крыши"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "389fcd4a-5ae3-32fd-9a67-287939ce750e",
                    "sense_definition": "A sparring session; a preliminary fight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer finished his morning <w>spar</w> and headed to the showers.",
                            "target_lang_translations": {
                                "ru": "Боксер закончил свой утренний <w>спарринг</w> и направился в душ."
                            }
                        },
                        {
                            "text": "The coach scheduled a light <w>spar</w> to help the athlete warm up.",
                            "target_lang_translations": {
                                "ru": "Тренер назначил легкий <w>спарринг</w>, чтобы помочь спортсмену размяться."
                            }
                        }
                    ],
                    "synonyms": [
                        "bout",
                        "match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тренировочный поединок; предварительный бой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спарринг",
                                "target_lang_sense_clarification": "тренировочный бой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0184653e-939e-3e89-a66c-30f3bb41cef2",
                    "sense_definition": "Any of various microcrystalline minerals that are easily cleft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist identified the sample as a type of <w>spar</w> found in the local quarry.",
                            "target_lang_translations": {
                                "ru": "Геолог определил образец как разновидность <w>шпата</w>, найденного в местном карьере."
                            }
                        },
                        {
                            "text": "Many varieties of <w>spar</w> are used in industrial applications due to their cleavage properties.",
                            "target_lang_translations": {
                                "ru": "Многие разновидности <w>шпата</w> используются в промышленности благодаря своим свойствам спайности."
                            }
                        }
                    ],
                    "synonyms": [
                        "mineral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Минерал с легко различимыми гранями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпат",
                                "target_lang_sense_clarification": "группа минералов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1ccf35f-ffa3-3f82-a30f-6351acd3df54",
                    "sense_definition": "A friend, a mate, or a pal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went out for a drink with his old <w>spar</w> from school.",
                            "target_lang_translations": {
                                "ru": "Он пошел выпить со своим старым <w>приятелем</w> со школы."
                            }
                        },
                        {
                            "text": "I trust him completely because he has been a loyal <w>spar</w> for many years.",
                            "target_lang_translations": {
                                "ru": "Я полностью доверяю ему, потому что он был верным <w>другом</w> на протяжении многих лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "friend",
                        "mate",
                        "pal"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in certain British urban dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Друг, приятель (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "близкий друг"
                            },
                            {
                                "target_lang_word": "кореш",
                                "target_lang_sense_clarification": "разговорное обозначение друга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5cf30709-fd15-3eae-ac14-cdb877bd8f7e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is a researcher named Dr. <w>Spar</w>.",
                            "target_lang_translations": {
                                "ru": "Автор статьи — исследователь по фамилии д-р <w>Спар</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Spar</w> was elected to the city council last month.",
                            "target_lang_translations": {
                                "ru": "Г-н <w>Спар</w> был избран в городской совет в прошлом месяце."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спар",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}