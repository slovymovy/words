                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Claire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e85c6940-4b73-309f-b170-9f9f03ee2d5b",
                                        "entry_id": "3cd92e56-0ed6-354e-89ed-94f189a8f8df",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db5184b4-f8e9-4a44-a9d5-de111d0ed3b7",
                                                "sense_id": "e85c6940-4b73-309f-b170-9f9f03ee2d5b",
                                                "text": "D’abord tante Claire était la personne qui me gâtait le plus."
                                            },
                                            {
                                                "example_id": "acbd9a8c-6d19-44f1-90fb-b7dbec3c3f6b",
                                                "sense_id": "e85c6940-4b73-309f-b170-9f9f03ee2d5b",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            },
                                            {
                                                "example_id": "4a6f398e-115e-4cf1-a695-bd31ee7dae0d",
                                                "sense_id": "e85c6940-4b73-309f-b170-9f9f03ee2d5b",
                                                "text": "« La France a demandé des renforts. La commission européenne, qui finance les déplacements à 75 %, a ensuite diffusé l’appel », explique Claire Kowalewski, en charge de la coordination européenne en France."
                                            },
                                            {
                                                "example_id": "3792a200-673a-4c80-a626-81aa6555d365",
                                                "sense_id": "e85c6940-4b73-309f-b170-9f9f03ee2d5b",
                                                "text": "Malgré ces avancées, Claire Hédon, la Défenseure des droits, dénonce « le nombre grandissant d’enfants dont les besoins sont très largement non ou mal couverts »."
                                            },
                                            {
                                                "example_id": "3a59d019-cd44-47bc-90b8-17115eb68827",
                                                "sense_id": "e85c6940-4b73-309f-b170-9f9f03ee2d5b",
                                                "text": "le claire"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
