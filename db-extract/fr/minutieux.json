                                        "entry_id": "d297223e-c8b8-301e-8f2c-ecddd3a0b575",
                                        "glosses": [
                                            "Requiring precise accuracy, great care, effort, or attention."
                                        ],
                                        "tags": [
                                            "of an action"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac89f06-b2bd-424b-a20d-dbf48ed25896",
                                                "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                                "text": "Wolf's work, which, though not very exacting, had to be done single-handed, kept him to his post."
                                            },
                                            {
                                                "example_id": "5ecd4979-ec9c-442c-be6d-6d6a6154216e",
                                                "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                                "text": "Every photographer of experience has his own theories and methods of working, but for the last 14 years I have used a Leica exclusively, and have found it best adapted to the somewhat exacting demands of railway photography, which is by no means an easy branch of the art."
                                            },
                                            {
                                                "example_id": "00af05a8-57b0-4128-89fa-fc5b3c1b5192",
                                                "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                                "text": "Even if a GDF receives its first deposit in the 2040s, the waste has to be delivered and put away with such exacting caution that it can be filled and closed only by the middle of the 22nd century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304aaa58-807e-367b-a7b2-b956c3c90a66",
                                        "entry_id": "d297223e-c8b8-301e-8f2c-ecddd3a0b575",
                                        "glosses": [
                                            "Characterized by exaction."
                                        ],
                                        "tags": [
                                            "of a person or organization"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9b0fc71-395c-4c1d-9b4c-9d0b4ef00a39",
                                                "sense_id": "304aaa58-807e-367b-a7b2-b956c3c90a66",
                                                "text": "\"He is a hard, exacting, money-loving man,\" was my remark."
                                            }
                                        ]
                                    }
                                ]
                            },
