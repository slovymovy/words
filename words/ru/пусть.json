                {
                    "sense_id": "834a0a8b-f5d3-3d38-a7c2-dbb187f146d6",
                    "sense_definition": "Используется для введения предположения или условия, часто в математических или логических задачах.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пусть</w> икс будет равен десяти.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> x equal ten.",
                                "zh": "<w>设</w>x等于十。",
                                "nl": "<w>Stel</w> dat x gelijk is aan tien.",
                                "pl": "<w>Niech</w> x będzie równe dziesięć.",
                                "de": "<w>Sei</w> x gleich zehn.",
                                "fr": "<w>Soit</w> x égal à dix.",
                                "it": "<w>Sia</w> x uguale a dieci.",
                                "cs": "<w>Nechť</w> se x rovná deseti.",
                                "tr": "X on <w>olsun</w>.",
                                "es": "<w>Sea</w> x igual a diez."
                            }
                        },
                        {
                            "text": "<w>Пусть</w> мы опоздаем, но зато увидим красивый закат.",
                            "target_lang_translations": {
                                "en": "<w>Suppose</w> we are late, at least we will see a beautiful sunset.",
                                "zh": "<w>即使</w>我们会迟到，但至少能看到美丽的日落。",
                                "nl": "<w>Stel</w> dat we te laat komen, dan zien we tenminste wel een mooie zonsondergang.",
                                "pl": "<w>Nawet jeśli</w> się spóźnimy, to przynajmniej zobaczymy piękny zachód słońca.",
                                "de": "<w>Selbst wenn</w> wir uns verspäten, werden wir dafür einen schönen Sonnenuntergang sehen.",
                                "fr": "<w>Même si</w> nous sommes en retard, nous verrons au moins un beau coucher de soleil.",
                                "it": "<w>Anche se</w> faremo tardi, vedremo comunque un bellissimo tramonto.",
                                "cs": "<w>I když</w> přijdeme pozdě, uvidíme krásný západ slunce.",
                                "tr": "Geç kalsak <w>bile</w>, en azından güzel gün batımını göreceğiz.",
                                "es": "<w>Aunque</w> lleguemos tarde, al menos veremos una hermosa puesta de sol."
                            }
                        }
                    ],
                    "synonyms": [
                        "пускай"
