                {
                    "sense_id": "9e0a1687-ad41-380d-8f4b-0fa7ed7a9ac7",
                    "sense_definition": "Opstapelen of op een hoop gooien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer <w>hoopte</w> het hooi op de wagen.",
                            "target_lang_translations": {
                                "en": "The farmer <w>piled</w> the hay onto the wagon.",
                                "ru": "Фермер <w>сгребал</w> сено на повозку.",
                                "pl": "Rolnik <w>układał</w> siano na wozie.",
                                "de": "Der Bauer <w>häufte</w> das Heu auf den Wagen.",
                                "fr": "Le fermier <w>entassait</w> le foin sur la charrette.",
                                "it": "Il contadino <w>ammucchiava</w> il fieno sul carro.",
                                "cs": "Farmář <w>kupil</w> seno na vůz.",
                                "tr": "Çiftçi samanı arabaya <w>yığdı</w>.",
                                "es": "El granjero <w>amontonaba</w> el heno en el carro.",
                                "zh": "农夫把干草<w>堆</w>到了马车上。"
                            }
                        },
                        {
                            "text": "Ze <w>hopen</w> de stenen op elkaar om een muurtje te bouwen.",
                            "target_lang_translations": {
                                "en": "They <w>pile</w> the stones on top of each other to build a small wall.",
                                "ru": "Они <w>складывают</w> камни друг на друга, чтобы построить стену.",
                                "pl": "<w>Układają</w> kamienie jeden na drugim, aby zbudować murek.",
                                "de": "Sie <w>schichten</w> die Steine aufeinander, um eine kleine Mauer zu bauen.",
                                "fr": "Ils <w>empilent</w> les pierres les unes sur les autres pour construire un petit mur.",
                                "it": "Loro <w>ammucchiano</w> le pietre l'una sull'altra per costruire un muretto.",
                                "cs": "<w>Kupí</w> kameny na sebe, aby postavili zídku.",
                                "tr": "Küçük bir duvar örmek için taşları üst üste <w>yığıyorlar</w>.",
                                "es": "Ellos <w>apilan</w> las piedras una sobre otra para construir un pequeño muro.",
                                "zh": "他们把石头<w>堆</w>在一起盖了一堵小墙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opstapelen",
                        "ophopen"
                    ],
                    "antonyms": [
                        "verspreiden"
                    ],
                    "target_lang_definitions": {
