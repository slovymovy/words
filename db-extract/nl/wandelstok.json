                    },
                    {
                        "translation_id": "c53b5a53-ccf3-4a74-a9b7-4a2ac9a4247e",
                        "source_entry_id": "51b1eceb-4771-3637-91b2-d157119ee038",
                        "source_sense_id": "05113bde-4937-39f0-bb5a-59175a447b6f",
                        "source_sense_description": "stok die dient als steun bij het wandelen en beschermt tegen vallen",
                        "target_lang_word": "canne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90148534-fa6c-3c4a-9027-b700124c4285",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Espèce de roseau, telle que le roseau, la canne d’Inde, la canne à sucre, le bambou, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd592f4-fd7e-40f5-b5ba-8eb5c1d71f71",
                                                "sense_id": "90148534-fa6c-3c4a-9027-b700124c4285",
                                                "text": "Les cannes flèchent au mois d’août, c’est-à-dire, vers le dixième mois de leur plantation ; au moment de la floraison la canne est creuse; aussi se garde-t-on bien de la récolter à cette époque ; […]."
                                            },
                                            {
                                                "example_id": "2fabc972-c3cc-4a1c-87ca-242f2c293319",
                                                "sense_id": "90148534-fa6c-3c4a-9027-b700124c4285",
                                                "text": "Canne de Provence ou roseau à quenouilles : Graminée Arundo donax, L."
                                            },
                                            {
                                                "example_id": "0835efca-6738-43de-8b21-e9ab6e44b134",
                                                "sense_id": "90148534-fa6c-3c4a-9027-b700124c4285",
                                                "text": "Canne à sucre : Graminée Saccharum officinarum, L., espèce de roseau dont on extrait le sucre."
                                            },
                                            {
                                                "example_id": "171a7923-4b84-4e47-9a2a-1e2d4bbdd40a",
                                                "sense_id": "90148534-fa6c-3c4a-9027-b700124c4285",
                                                "text": "Canne d’Inde : Balisier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498126e6-0094-3e6f-8318-1117bad63d7e",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Tige ou racine qui ne se trouve plus aujourd’hui dans le commerce, et qui provenait du Calamus aromaticus."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Bâton léger sur lequel on s’appuie de la main en marchant, souvent fait de roseau, de jonc ou de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4f1e3a-bc4d-406d-a8bb-b3d940c2eb48",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Lever la canne sur quelqu’un. → voir lever la canne"
                                            },
                                            {
                                                "example_id": "f8939dff-b65a-4fa6-90f3-b1de96c07ce6",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Donner des coups de canne."
                                            },
                                            {
                                                "example_id": "b40a33cd-f1f2-4aa8-b8f1-06b6b31529cd",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "L’enfant retomba dans les plis de son manteau dont je l’enveloppai, et sa petite main ornée de grosses bagues laissa échapper une canne de jonc, qui tomba sur ma main comme s’il me l’eût donnée."
                                            },
                                            {
                                                "example_id": "1b555b9f-6152-4a8c-a06a-c167e0974f0f",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Mon oncle avait une longue canne, terminée par une brochette de fer, au moyen de laquelle il enfilait les limaces et les escargots, mangeurs de salades."
                                            },
                                            {
                                                "example_id": "f61baeff-a615-422d-8318-32b4c4c235e6",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "[…] mais Jimmy le faisait méchamment trébucher, en le happant du crochet de sa grosse canne blanche, et les deux hommes tombaient à terre, ensemble […]"
                                            },
                                            {
                                                "example_id": "aaabcbe9-338c-447d-a30f-6eb487075ea1",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Il s’appuyait sur une canne seulement et de telle manière que l’instrument de secours devenait un attribut de majesté."
                                            },
                                            {
                                                "example_id": "bf85b701-6a67-4cfd-a8da-fb81b267271d",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Puis, d’après nous [orangs-outangs], le genre humain marcha droit la canne à la main."
                                            },
                                            {
                                                "example_id": "6f745e32-ed33-451a-9bd0-cce1745dae7f",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Porter une canne à la main. — Marcher avec une canne. — Canne à épée."
                                            },
                                            {
                                                "example_id": "8c255d50-7b51-463c-9fb6-f6f89ebd3851",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Une canne à pomme d’or, à pomme d’argent, à pomme d’ivoire."
                                            },
                                            {
                                                "example_id": "02ed12f7-48c1-4d7c-bfa1-e60a3348a05a",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Petit, la mine chafouine, pareille à une pomme de canne curieusement taillée en tête de Polichinelle, Aristide furetait, fouillait partout, peu scrupuleux, pressé de jouir."
                                            },
                                            {
                                                "example_id": "dc438760-8ee3-4148-96f5-7a46c41febfa",
                                                "sense_id": "8545ad69-6a4a-3e6b-b037-4cf7cc9ec383",
                                                "text": "Canne plombée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27493fb7-2e69-3a6b-9e99-ecba89d466ee",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Instrument long et cylindrique dont les usages diffèrent."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5067e5c3-ed7e-4042-bf41-75c867b2928a",
                                                "sense_id": "27493fb7-2e69-3a6b-9e99-ecba89d466ee",
                                                "text": "L’écureuil s’abaisse et ne bouge plus. Prenez la canne en main et moulinez rapidement pour prendre contact avec le poisson et ferrez."
                                            },
                                            {
                                                "example_id": "5c3fef9b-80aa-4f06-8ae1-0178a9d3150d",
                                                "sense_id": "27493fb7-2e69-3a6b-9e99-ecba89d466ee",
                                                "text": "Sur le fond, et autour de l’aquarium, des présentoirs exhibaient les attirails, des plus simples aux plus compliqués : gaules en bambou, cannes en fibre de verre, grandes cannes télescopiques pour moulinet à tambour tournant, boîtes de mouches et de cuillères, d’hameçons et de plombs, devons, moulinets de tous calibres, montures pour poissons morts, dégorgeoirs, bourriches, épuisettes, appâts réputés fantastiques ! fabuleux ! ou, plus prosaïquement, épatants !"
                                            },
                                            {
                                                "example_id": "51450dba-a830-4702-884c-71e008669fef",
                                                "sense_id": "27493fb7-2e69-3a6b-9e99-ecba89d466ee",
                                                "text": "Canne à vent : Sorte de sarbacane du verrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6690b0b1-8862-366a-957c-b6561d36587f",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Mesure de longueur employée en divers pays, particulièrement en Italie, et dont la valeur n’est pas constante ; celle de Naples vaut deux mètres vingt-neuf centimètres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd81d33-70f1-4fd2-9caa-b9e9469641e3",
                                                "sense_id": "6690b0b1-8862-366a-957c-b6561d36587f",
                                                "text": "CANNE, en italien canna, en espagnol cana, en anglais cane. Mesure d’aunage et d’arpentage, employée surtout en Italie et dans le midi de la France. Cette mesure remplace souvent la toise ou la perche, servant à établir la superficie des terrains. En Italie on lui donne aussi, dans ce cas, le nom de pertica, ou perche, en France celui de toise. Voyez ces mots. Pour la canne des anciens Arabes, voyez Cassaba.\nAffrique (Sainte-) en France. La canne de 8 pans.\nAix en Provence. La canne = 8 pans ou palmes = 64 menus.\n[…]\nAlpes (Hautes-), département français. La canne ou toise ordinaire = 6 pieds = 8 pans.\n[…]\nApt en France. La canne = 8 pans = 72 pouces = 864 lignes.\n[…]\nBarcelonne. La cana = 2 varas ou medias canas = 8 palmos = 32 quartos, et vaut, d’après une mesure authentique, vérifiée à la préfecture de Marseille, en 1829\n[…]\nDauphiné, ancienne province française. La canne ou toise delphinale se divise en 6 pieds ou 8 pans, et vaut\n[…]\nToulouse. La canne = 8 empans = 64 pouces = 512 lignes = 4096 points"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61266a1-5d15-367c-8f54-3b63889befab",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Boîte de conserve (de l’anglais can)."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9fc2bd-0118-4127-9bf2-10afe80443ee",
                                                "sense_id": "b61266a1-5d15-367c-8f54-3b63889befab",
                                                "text": "M. Blanchet ne se fait pas d'illusions et admet s'attendre à une défaite lors du vote puisque le gouvernement fédéral ne veut surtout pas ouvrir la Constitution – un passage obligé pour rompre les liens avec la Couronne et qui nécessite l'approbation des 10 provinces, de la Chambre des communes et du Sénat – de peur que chacun dresse sa liste de demandes et que la canne soit ensuite difficile à refermer."
                                            },
                                            {
                                                "example_id": "80aa3712-0bcc-47f6-8cd0-39e693e63c29",
                                                "sense_id": "b61266a1-5d15-367c-8f54-3b63889befab",
                                                "text": "De la nourriture – dont des bananes et des produits en canne – se trouvait également dans les armoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd38e65-9603-30de-897a-5454119faf8b",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Bidon (pour le lait)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5cd4321-ea34-38cd-a123-d4ef36e0384d",
                                        "entry_id": "751d4cac-658f-34f7-81c0-10238af7e543",
                                        "glosses": [
                                            "Ellipse de canne de combat, sport de combat opposant deux adversaires équipés chacun d’une canne en bois de châtaignier longue de 95 cm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03cbe1e1-fc7f-481d-aed7-d64f6727e1b7",
                                                "sense_id": "e5cd4321-ea34-38cd-a123-d4ef36e0384d",
                                                "text": "Il s’adonnait à un sport presque aussi distingué que l’escrime, « la canne », et avait obtenu le titre de « prévost » dont il se montrait très fier."
                                            },
                                            {
                                                "example_id": "6e6bbf7c-b1a1-460f-8a2f-4c4c99d27f15",
