    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "664b06e3-79ee-3177-b98e-af38618639f7",
                    "sense_definition": "Happening once a week, or every week.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He's going for his <w>weekly</w> check-up at the hospital.",
                            "target_lang_translations": {
                                "ru": "Он идет в больницу на свой <w>еженедельный</w> осмотр.",
                                "zh": "他要去医院做<w>每周</w>一次的检查。"
                            }
                        },
                        {
                            "text": "In summer, we cut the grass on a <w>weekly</w> basis.",
                            "target_lang_translations": {
                                "ru": "Летом мы стрижем газон <w>еженедельно</w>.",
                                "zh": "夏天我们<w>每周</w>修剪一次草坪。"
                            }
                        }
                    ],
