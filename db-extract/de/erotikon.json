                "senses": [
                    {
                        "sense_id": "14ac22b8-d8fd-3920-8099-0597fb9706d7",
                        "entry_id": "c8fa134b-5e81-3352-a428-987eeedf9ef3",
                        "glosses": [
                            "Werk mit erotischem Hauptthema"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb51e69-c62a-4d62-84e1-510dc9e9ab18",
                                "sense_id": "14ac22b8-d8fd-3920-8099-0597fb9706d7",
                                "text": "Der Roman \"Emmanuelle\" ist ein bekanntes Erotikon."
                            },
                            {
                                "example_id": "69c53819-aba7-47c5-885c-111d609fdc3f",
                                "sense_id": "14ac22b8-d8fd-3920-8099-0597fb9706d7",
                                "text": "Der russische Dichter Mikhail Kuzmin schrieb Erotika über homosexuelle Liebe."
                            },
                            {
                                "example_id": "89805f21-8d6e-4663-b06f-ba561188881d",
                                "sense_id": "14ac22b8-d8fd-3920-8099-0597fb9706d7",
                                "text": "Bei Slash-Fanfiction handelt es sich häufig um Erotika."
                            },
                            {
                                "example_id": "5c6cbaa5-9f40-4ae6-b01c-6c8417cb6193",
                                "sense_id": "14ac22b8-d8fd-3920-8099-0597fb9706d7",
                                "text": "„Ein literarisches Werk, das durch das Verdikt der Behörden und einer pseudomoralischen Kritik als anstößig galt, konnte bedenkenlos ausgenutzt werden, um den Hunger eines nicht zu zählenden Publikums nach Erotika zufriedenzustellen.“"
                            },
                            {
                                "example_id": "33c6165a-1abe-415c-8abf-f19215b33180",
                                "sense_id": "14ac22b8-d8fd-3920-8099-0597fb9706d7",
                                "text": "„Cazin war der bekannteste Verleger für Erotika jener Zeit, seine Drucke sind begehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61f9a4b5-ccf9-38d9-834b-e2f6ca539f9e",
                        "entry_id": "c8fa134b-5e81-3352-a428-987eeedf9ef3",
                        "glosses": [
                            "Mittel zur sexuellen Anregung"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8d89fb-af19-4f45-93da-d0bf4680f0f6",
                                "sense_id": "61f9a4b5-ccf9-38d9-834b-e2f6ca539f9e",
                                "text": "Audiovisuelle Medien eröffnen viele Möglichkeiten, um an geeignete Erotika zu gelangen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
