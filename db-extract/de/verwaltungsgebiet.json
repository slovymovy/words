                ],
                "senses": [
                    {
                        "sense_id": "22881dc9-9d25-3dd0-992c-7eba390939fd",
                        "entry_id": "0bbe5f19-9753-3b5c-bf16-3c6eac6f9b9c",
                        "glosses": [
                            "Gebiet, das eine administrative Einheit eines Staates ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b998170e-ea6e-437b-a1e3-d29af7c59576",
                                "sense_id": "22881dc9-9d25-3dd0-992c-7eba390939fd",
                                "text": "„Mit dem Aufkommen von Nationalstaaten wurde über Grenzen zunehmend gestritten, denn die Staaten gaben vor, sie begrenzten gleichzeitig die Verwaltungsgebiete, Militärgebiete, Marktzentren und die jeweiligen kulturellen Eigenheiten.“"
                            },
                            {
                                "example_id": "80981c50-cd4d-4570-9a1f-189388486a2d",
                                "sense_id": "22881dc9-9d25-3dd0-992c-7eba390939fd",
                                "text": "„Die Verbindungen zum Oblast Leningrader, dem Verwaltungsgebiet rund um Sankt Petersburg, seien vorerst eingestellt worden.“"
                            },
                            {
                                "example_id": "78d706e0-e11b-4fa0-81c3-70c53f82406e",
                                "sense_id": "22881dc9-9d25-3dd0-992c-7eba390939fd",
                                "text": "„Die Separatisten erheben Anspruch auf das gesamte Territorium der Verwaltungsgebiete Donezk und Luhansk, das sie vor dem russischen Einmarsch Ende Februar nur etwa zu einem Drittel kontrollierten.“"
                            },
                            {
                                "example_id": "f6f125d3-8c76-4467-8f45-4745ce45fae6",
                                "sense_id": "22881dc9-9d25-3dd0-992c-7eba390939fd",
                                "text": "„Verteidigungsminister Luis Fernando López sagte, von der Dürre und den Bränden seien fünf der neun Verwaltungsgebiete des Landes betroffen: Santa Cruz, Beni im Nordosten des Landes, Pando im Norden, Chuquisaca im Südosten und Tarija im Süden.“"
                            },
                            {
                                "example_id": "78a5e78e-474f-4ce9-be1a-4f219cf145f9",
                                "sense_id": "22881dc9-9d25-3dd0-992c-7eba390939fd",
                                "text": "„Laut des chinesischen Staatsfernsehens wurden Einsatzkräfte der Feuerwehr in die Gebirgsregion im Verwaltungsgebiet Qiaojia geschickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
