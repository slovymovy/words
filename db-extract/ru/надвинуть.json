                "senses": [
                    {
                        "sense_id": "889d8bad-2523-3b37-a558-0c4aa0e01084",
                        "entry_id": "76fde80c-a407-337d-92f2-60ac120a1534",
                        "glosses": [
                            "сдвинув, передвинув, закрыть, заслонить кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e82cdd-7a66-42d6-b0d2-8734371ac228",
                                "sense_id": "889d8bad-2523-3b37-a558-0c4aa0e01084",
                                "text": "Костя не ответил, лишь заметно помрачнел с лица и глубже надвинул на голову кепку."
                            },
                            {
                                "example_id": "0cb0f92d-fc43-4ac1-8aae-abb0c30f4ad6",
                                "sense_id": "889d8bad-2523-3b37-a558-0c4aa0e01084",
                                "text": "Мария мельком взглянула в окно, а потом села в кресло спиной к нему, и тяжёлая, безысходная тоска навалилась на неё, как будто плиту надвинули."
                            }
                        ]
                    }
