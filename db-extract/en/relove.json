                "senses": [
                    {
                        "sense_id": "07c320fd-fc78-386f-85cc-f287cee630c0",
                        "entry_id": "9e2a5752-c9d6-3d28-a491-5d75b08946f5",
                        "glosses": [
                            "To love in return."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "58d0bdb4-447d-4960-9ec1-d622b9aca37c",
                                "sense_id": "07c320fd-fc78-386f-85cc-f287cee630c0",
                                "text": "To own for him so familiar and levelling an affection as love, much more to expect to be reloved by him, were not the least saucy presumption man could he guilty of, did not his own commandments make it a duty.",
                                "translation": "Seraphick Love",
                                "english": "Seraphick Love"
                            },
                            {
                                "example_id": "70fd62e7-fa4c-4524-a995-c9a6a047afbf",
                                "sense_id": "07c320fd-fc78-386f-85cc-f287cee630c0",
                                "text": "He therefore that begins to love, doth thereby render the person beloved his debtor, and acquires a just right to be beloved by him again, though he should have no other pretence to or interest in his affections; especially if he be one who is much our superior in all endearing perfections and accomplishments; because this must needs render his love more valuable, and consequently augment our obligation to relove him."
                            }
                        ]
                    }
                ],
