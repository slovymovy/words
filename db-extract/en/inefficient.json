                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4206495-9489-46c4-89b5-3e9a8951a177",
                                "sense_id": "9f83146b-a0a8-3928-96fb-fc4a051e9c21",
                                "text": "inefficient workers"
