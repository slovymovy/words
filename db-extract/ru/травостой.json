                                    },
                                    {
                                        "sense_id": "ba00348e-09b2-31fb-9691-e2e20cb4ed0e",
                                        "entry_id": "526c7b94-b3c4-3dd1-a0a8-b10522704dd2",
                                        "glosses": [
                                            "Herbaceous plant growth, especially grass."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c29e08-e19c-4497-9899-4f0ef9bc1098",
                                                "sense_id": "ba00348e-09b2-31fb-9691-e2e20cb4ed0e",
                                                "text": "I threw myself upon my face, and clung to the scant herbage in an excess of nervous agitation."
                                            },
                                            {
                                                "example_id": "b6ddcb4d-d927-4d67-84f9-a60857cb36a0",
                                                "sense_id": "ba00348e-09b2-31fb-9691-e2e20cb4ed0e",
                                                "text": "The dank breath of herbage, sodden with rain, came to her; the mists were barely visible, hovering above the dark ravines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f88d0712-4eb8-3fbd-ba84-2bb141ac9539",
                                        "entry_id": "526c7b94-b3c4-3dd1-a0a8-b10522704dd2",
                                        "glosses": [
                                            "The fleshy, often edible, parts of plants."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cec9ebb-bc39-39d9-8b93-d411e307dc92",
                                        "entry_id": "526c7b94-b3c4-3dd1-a0a8-b10522704dd2",
                                        "glosses": [
                                            "The natural pasture of a land, considered as distinct from the land itself; hence, right of pasture (on another man's land)."
                                        ],
