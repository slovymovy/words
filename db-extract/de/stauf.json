                "senses": [
                    {
                        "sense_id": "fba29070-ff7a-3f14-b5b3-11cf9f9d108e",
                        "entry_id": "88514ee0-0859-3cb8-88d4-113023c01a65",
                        "glosses": [
                            "Trinkgefäß, ursprünglich eher aus Metall gefertigt und prunkvoll"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d1eda09b-048d-4ebf-a93e-663706efebc1",
                                "sense_id": "fba29070-ff7a-3f14-b5b3-11cf9f9d108e",
                                "text": "„Zur Illustration dieses Textes finden sich in vier Medaillons die Darstellungen eines Onokentaurs mit Keule und Rundschild, einer mit Pfeil und Bogen bewehrten Sirene, dann einer gekrönten Sirene, welche einen kostbaren Stauf trägt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f6e7203d-cbc9-3bd6-988d-27f7ab128db9",
                        "entry_id": "88514ee0-0859-3cb8-88d4-113023c01a65",
                        "glosses": [
                            "Hohlmass, das in unterschiedlichen Regionen zu unterschiedlichen Zeiten einen unterschiedlichen Inhalt bezeichnete"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9a35819e-626e-4a3b-8360-f0aa8d26f29f",
                                "sense_id": "f6e7203d-cbc9-3bd6-988d-27f7ab128db9",
                                "text": "Der culmische Stauf in Königsberg entsprach einer meßingischen Kanne von 3 Staufen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
