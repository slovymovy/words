                "translations": [
                    {
                        "translation_id": "f648ec56-ce02-4591-b183-3d9db56cb503",
                        "source_entry_id": "0faba573-d3ac-36b4-ba34-2d4d3e6773c5",
                        "source_sense_id": "65c50b14-905a-37af-a2cf-9a9be3ec0969",
                        "target_lang_word": "messianic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "messianic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fd2289-826a-3b32-ae96-987e356f913e",
                                        "entry_id": "3c274ad8-add5-3863-a549-433597316f23",
                                        "glosses": [
                                            "Of, relating to, or resembling a messiah or the Messiah."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad386b87-3663-424c-a4cc-09faebf5fda7",
                                                "sense_id": "d3fd2289-826a-3b32-ae96-987e356f913e",
                                                "text": "There’s been a change in President Donald Trump. He used to say he had accomplished more than any other President, a debatable claim. But now he’s using messianic language about himself."
                                            },
                                            {
                                                "example_id": "d3a5cce2-b8b7-4522-94ab-54ba7852610a",
                                                "sense_id": "d3fd2289-826a-3b32-ae96-987e356f913e",
                                                "text": "Speaking this week, Pope Francis sent a thinly veiled warning about the dangers of “pied piper of Hamelin”-style populists and “messianic clowns”. “There is only one Messiah,” the pope said, without naming Milei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63011028-c8b8-3ea6-8aa4-9f003fabe527",
                                        "entry_id": "3c274ad8-add5-3863-a549-433597316f23",
                                        "glosses": [
                                            "Of, relating to, or resembling messianism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd6f0a87-c320-49a6-aea1-2cdb104c344d",
                        "source_entry_id": "0faba573-d3ac-36b4-ba34-2d4d3e6773c5",
                        "source_sense_id": "65c50b14-905a-37af-a2cf-9a9be3ec0969",
                        "target_lang_word": "mesiánico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesiánico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7c43561c-731e-3ff6-a43f-607a63d42315",
                                        "entry_id": "1a21b926-d2d5-382b-b6a6-d31c5e8def3a",
                                        "glosses": [
                                            "Que pertenece o concierne al mesías."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d7f409-3be8-40d4-b140-fdb93e46800c",
                                                "sense_id": "7c43561c-731e-3ff6-a43f-607a63d42315",
                                                "text": "¿Y el papa? Sobre el contenido, era la primera voz del coro. Más político y menos mesiánico, al choque frontal prefería la maniobra sobre los flancos, a costas de despertar dudas sobre su firmeza doctrinaria: mejor evitar cruzadas. ¿No había en el gobierno figuras políticas contrarias al aborto? ¡Mejor apostar por ellos!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
