            {
                "entry_id": "53d0a896-4e29-3adb-9f2e-59bf57457a61",
                "word": "lieuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6cd595f-9d02-42d5-8283-e4a6b16edb6d",
                        "entry_id": "53d0a896-4e29-3adb-9f2e-59bf57457a61",
                        "tags": [
                            "plural"
                        ],
                        "form": "lieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "900f43d8-c00d-3ea4-8b73-fc62c25b2004",
                        "entry_id": "53d0a896-4e29-3adb-9f2e-59bf57457a61",
                        "glosses": [
                            "Celle qui lie des bottes de foin, des gerbes de blé, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4e2f74f-bdc1-30a4-9ae3-c0cebfbf3a27",
                        "entry_id": "53d0a896-4e29-3adb-9f2e-59bf57457a61",
                        "glosses": [
                            "Machine qui, adaptée à une moissonneuse mécanique, liait en gerbes les épis à mesure qu’ils étaient coupés."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "637547ee-18d7-4d0b-9597-0410bd7c9188",
                                "sense_id": "d4e2f74f-bdc1-30a4-9ae3-c0cebfbf3a27",
                                "text": "Claude s’avouant de plus en plus faible et fatigué, on ne pouvait songer à moissonner à la faux ; même avec une moissonneuse ordinaire on n’en finirait jamais. La Misangère proposa d’acheter une lieuse."
                            },
                            {
                                "example_id": "4cad9509-835e-4e3f-b374-488acb56d101",
                                "sense_id": "d4e2f74f-bdc1-30a4-9ae3-c0cebfbf3a27",
                                "text": "Le ciel resta clément et nos voisins vinrent faucher notre Probus avec leur nouvelle acquisition : une lieuse, la machine la plus gracieuse jamais proposée aux paysans."
                            },
                            {
                                "example_id": "5d5712b3-c3b9-45d4-837c-d6ff2c5236e1",
                                "sense_id": "d4e2f74f-bdc1-30a4-9ae3-c0cebfbf3a27",
                                "text": "Le plus ennuyeux pour les agriculteurs fut sans aucun doute le défaut d’essence et de ficelle pour les lieuses."
                            },
                            {
                                "example_id": "efd10a40-b254-4294-9eca-b6e60dd9c29b",
                                "sense_id": "d4e2f74f-bdc1-30a4-9ae3-c0cebfbf3a27",
                                "text": "Le travail d’une vie lui avait fabriqué des muscles qu’on voyait encore sous la peau détendue de ses avant-bras barrés de veines grosses comme de la ficelle de lieuse."
                            }
                        ]
                    }
                ],
