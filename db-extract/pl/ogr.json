                "forms": [],
                "senses": [
                    {
                        "sense_id": "cc938bd1-7cc3-3016-9666-4ddf4a612532",
                        "entry_id": "251ea0db-639b-3da9-b292-e18ea641fab5",
                        "glosses": [
                            "legendarne stworzenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692d5753-6a97-48b3-abe7-a1d7b2706585",
                                "sense_id": "cc938bd1-7cc3-3016-9666-4ddf4a612532",
                                "text": "Ogry robią sobie rękawiczki z ludzkiej skóry i breloczki z wątroby."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb282ca9-ffae-400d-a5fb-a641b2d2a2cd",
                        "source_entry_id": "251ea0db-639b-3da9-b292-e18ea641fab5",
                        "source_sense_id": "cc938bd1-7cc3-3016-9666-4ddf4a612532",
                        "target_lang_word": "ogre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ogre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d44c5720-4709-3a8f-a73a-7dff7bbca5c8",
                                        "entry_id": "4a9cbed8-9a4b-3c3f-b747-04d6656fb633",
                                        "glosses": [
                                            "A type of brutish giant from folk tales that eats human flesh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c9a107-03c0-4a39-b286-1cb54ff007a3",
                                                "sense_id": "d44c5720-4709-3a8f-a73a-7dff7bbca5c8",
                                                "text": "And in the seventh tale of the third day of the same collection, when Corvetto had hidden himself under the Ogre's bed to steal his quilt, \"he began to pull quite gently, when the Ogre awoke, and bid his wife not to pull the clothes that way, or she'd strip him, and he would get his death of cold.\" \"Why, it's you that are stripping me,\" replied the Ogress, \"and you have not left a stitch on me.\" \"Where the devil is the quilt?\" says the Ogre[.]"
                                            },
                                            {
                                                "example_id": "1b36a7cb-69fd-4b3d-95c7-e10baa94458e",
                                                "sense_id": "d44c5720-4709-3a8f-a73a-7dff7bbca5c8",
                                                "text": "And the conquest of the ogres comes at the right moment: not in earliest youth, though the nicors are referred in Beowulf's geogoðfeore as a presage of the kind of hero we have to deal with[.]"
                                            },
                                            {
                                                "example_id": "d87b64cb-8d79-4488-8bdb-2b3945fcc0d6",
                                                "sense_id": "d44c5720-4709-3a8f-a73a-7dff7bbca5c8",
                                                "text": "From his end of the hall Beowulf watched the ogre, weighed his endowment, and waited to see how Grendel would strike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b84778c-661d-3cb2-b71e-6ccb59b53176",
                                        "entry_id": "4a9cbed8-9a4b-3c3f-b747-04d6656fb633",
                                        "glosses": [
                                            "A cruel person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ae69830-3afd-4cd1-86d0-44e90281f9a0",
                                                "sense_id": "6b84778c-661d-3cb2-b71e-6ccb59b53176",
                                                "text": "People are going to think I'm an ogre if I refuse to buy coffee for my little brother!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7c5ce81-ccb8-412e-b288-e3644d33818e",
                        "source_entry_id": "251ea0db-639b-3da9-b292-e18ea641fab5",
                        "source_sense_id": "cc938bd1-7cc3-3016-9666-4ddf4a612532",
                        "target_lang_word": "zlobr",
