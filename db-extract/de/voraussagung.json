                "senses": [
                    {
                        "sense_id": "dd33538d-b7e5-3ec3-ad50-0734331f9fb9",
                        "entry_id": "cd9e2115-ca27-3a23-aeb6-20211d8b20a6",
                        "glosses": [
                            "eine Aussage über etwas, das in Zukunft sein wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045e0c1d-3558-4d51-aea8-5a6821552eed",
                                "sense_id": "dd33538d-b7e5-3ec3-ad50-0734331f9fb9",
                                "text": "„Na jedenfalls führte ich mein erstes Gratisgespräch mit einer Astrologin, welche mit ihren Voraussagungen richtig lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca5ac033-52bc-4e7d-a667-a727ae677a2b",
                        "source_entry_id": "cd9e2115-ca27-3a23-aeb6-20211d8b20a6",
                        "source_sense_id": "dd33538d-b7e5-3ec3-ad50-0734331f9fb9",
                        "source_sense_description": "eine Aussage über etwas, das in Zukunft sein wird",
                        "target_lang_word": "prediction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prediction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                        "entry_id": "cbca37e4-30c1-39fd-b032-5455e8bb4069",
                                        "glosses": [
                                            "A statement of what will happen in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26eb2ab6-fc4b-417f-b261-77298a4dba64",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "make predictions about something"
                                            },
                                            {
                                                "example_id": "ef647445-d2e4-41a9-8dbd-577e5377d1b3",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "correct prediction"
                                            },
                                            {
                                                "example_id": "62d249dd-e84d-4f57-84ed-701aaa2759c8",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "offer up a prediction"
                                            },
                                            {
                                                "example_id": "67786423-d0a8-4019-a4fd-44a00cb36d76",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "incorrect prediction"
                                            },
                                            {
                                                "example_id": "7fae8364-62f9-4400-9a43-3816ae30479f",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "the prediction came true"
                                            },
                                            {
                                                "example_id": "9581b362-4611-42c2-b069-6bf452418fa4",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "The weather forecaster made a prediction of heavy rain tomorrow."
                                            },
                                            {
                                                "example_id": "3c7fe0c9-19a3-406d-8558-54c744af45c2",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "His prediction about the stock market proved correct."
                                            },
                                            {
                                                "example_id": "d93c9d4a-22a5-4625-b27a-79705569b906",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "It’s difficult to make an accurate prediction about the future."
                                            },
                                            {
                                                "example_id": "5e80fc47-ce7f-43cc-92a1-0c7b9d99b00a",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "The scientists issued a bold prediction of technological change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa70cb7-9893-3bd2-b5b1-95925f354fec",
                                        "entry_id": "cbca37e4-30c1-39fd-b032-5455e8bb4069",
                                        "glosses": [
                                            "A probability estimation based on statistical methods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "562b516c-5389-4baa-b463-77aa86dd7f4b",
                        "source_entry_id": "cd9e2115-ca27-3a23-aeb6-20211d8b20a6",
                        "source_sense_id": "dd33538d-b7e5-3ec3-ad50-0734331f9fb9",
                        "source_sense_description": "eine Aussage über etwas, das in Zukunft sein wird",
                        "target_lang_word": "divination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab87ff1-89cb-3e51-84e0-f23b5c9bbada",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Art de deviner, de prédire l’avenir."
                                        ],
                                        "tags": [
                                            "Pseudo-sciences"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab171a34-d062-4676-83df-126670748177",
                                                "sense_id": "0ab87ff1-89cb-3e51-84e0-f23b5c9bbada",
                                                "text": "Eh bien! c'est un homme d'Hoffmann. Toute la vie, il a cherché à appliquer les cartes et les nombres à la divination de l'avenir; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Ensemble des moyens employés pour deviner et prédire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68ad3f7-5542-477c-af68-d804bc9729c9",
                                                "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                                "text": "Précisément parce que la divination par les oiseaux était d'un usage universel et que chaque peuple la pratiquait pour son compte, l’auguration toscane n'a guère servi qu'aux Toscans eux-mêmes."
                                            },
                                            {
                                                "example_id": "def62cfd-c137-4383-a23b-a69130d87dfb",
                                                "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                                "text": "— Descartes, c'est le type qui a mis au point la divination par le tarot, non ? Je connais un gars, Jasper, qui est du genre à y croire dur comme fer mais, pour être franche, je doute un peu que le tarot permette d'accéder à la vérité éternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ffe9ee-125b-3066-ae53-0d761b06feb2",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Dans la recherche, sagacité permettant de retrouver des choses cachées pour lesquelles la logique seule ne suffit pas ; intuition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d3a91a-a51c-46e1-89ca-68536a10316b",
                                                "sense_id": "32ffe9ee-125b-3066-ae53-0d761b06feb2",
                                                "text": "C’est par une véritable divination qu’on a retrouvé le sens de plusieurs langues anciennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
