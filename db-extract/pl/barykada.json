                                    {
                                        "sense_id": "93ab460a-bd89-31ac-a120-2823c02ab1fb",
                                        "entry_id": "978993f1-24c0-351d-a5f1-d9f8cfc41092",
                                        "glosses": [
                                            "Something that blocks or obstructs a road."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a67acd4d-7e66-3b8f-8614-863e2608f4ce",
                                        "entry_id": "978993f1-24c0-351d-a5f1-d9f8cfc41092",
                                        "glosses": [
                                            "An obstacle or impediment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6498b434-a1c5-478f-ab80-b273f8ffcb83",
                                                "sense_id": "a67acd4d-7e66-3b8f-8614-863e2608f4ce",
                                                "text": "to hit roadblocks"
                                            },
                                            {
                                                "example_id": "04a17f04-a72c-48a2-9d48-4e1c90d2f200",
                                                "sense_id": "a67acd4d-7e66-3b8f-8614-863e2608f4ce",
                                                "text": "Transgender people face roadblocks in accessing healthcare, and it’s not going away even after archaic rules denying healthcare access to transgender people are lifted and more of us become insured."
                                            },
                                            {
                                                "example_id": "53440f62-eb38-4157-a3c4-678b48b088c5",
                                                "sense_id": "a67acd4d-7e66-3b8f-8614-863e2608f4ce",
                                                "text": "America’s jobs recovery hit a major roadblock in August as the Delta variant threatened the labor market recovery, and the US economy added far fewer jobs than expected."
                                            },
                                            {
                                                "example_id": "6c5104b4-654e-40c6-b276-fe666cf426d2",
                                                "sense_id": "a67acd4d-7e66-3b8f-8614-863e2608f4ce",
                                                "text": "Over the past decade, the products hit roadblocks. Siri ran into technological hurdles, including clunky code that took weeks to update with basic features, said John Burkey, a former Apple engineer who worked on the assistant."
                                            }
                                        ]
                                    }
                                ]
                            },
