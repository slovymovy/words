                ],
                "senses": [
                    {
                        "sense_id": "c9f699b2-987e-3b7f-b1e6-ced26474b688",
                        "entry_id": "a248c8b4-3189-36d7-b71c-a245d9f8beb0",
                        "glosses": [
                            "etwas, das genug Energie an ein brennbares Material abgeben kann, so dass dieses zu brennen beginnt oder explodiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf6ee1a7-a2cb-4843-bfdf-76b9f2fb7d1e",
                                "sense_id": "c9f699b2-987e-3b7f-b1e6-ced26474b688",
                                "text": "Als Zündquelle haben die Brandermittler eine Flamme oder einen Funken ausgemacht."
                            },
                            {
                                "example_id": "8d1b4cea-5792-48fe-b052-ea4649ccda72",
                                "sense_id": "c9f699b2-987e-3b7f-b1e6-ced26474b688",
                                "text": "„Auch in der Natur vorkommende Zündquellen wie Blitzschläge können einen Brand auslösen.“"
                            },
                            {
                                "example_id": "c4417336-b15f-4218-9c8e-6216aaac47f3",
                                "sense_id": "c9f699b2-987e-3b7f-b1e6-ced26474b688",
                                "text": "„Nicht ausreichend geschmierte bewegte Teile können überhitzen. Durch die Reibungshitze oder Funken entstehen ungewollt Zündquellen.“"
                            },
                            {
                                "example_id": "89b4720a-2759-43fa-a39a-e819304fafd6",
                                "sense_id": "c9f699b2-987e-3b7f-b1e6-ced26474b688",
                                "text": "„Als Zündquellen [für einen Grubenbrand] können Untertage verschiedene elektrische Geräte oder flammenerzeugende Werkzeuge wie z. B. Schneidbrenner fungieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
