                    {
                        "translation_id": "9aaf1830-3b36-4a6e-aa73-2555c95c5232",
                        "source_entry_id": "fe879022-bd84-3431-bd3b-df840947448b",
                        "source_sense_id": "fae16399-5885-396b-9884-95aeedf84806",
                        "source_sense_description": "grass of the genus Agrostis",
                        "target_lang_word": "traînasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traînasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9a71c1-1cc2-3a41-8056-edd118c3d397",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Galerie horizontale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99463165-ee23-31e6-ae0c-4d5bac8152bf",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Galerie horizontale.",
                                            "Galerie des taupes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b005fb8-d99d-4a8c-adf9-b563a91a40a9",
                                                "sense_id": "99463165-ee23-31e6-ae0c-4d5bac8152bf",
                                                "text": "On l’enfonce ordinairement d’un demi-pied dans les traînasses des taupes ; & afin qu’elles n’en puissent pas sortir, on met au bord par où elles entrent un petit crochet […]"
                                            },
                                            {
                                                "example_id": "7beca3ac-8ce6-4ceb-8d44-b72a98c762ff",
                                                "sense_id": "99463165-ee23-31e6-ae0c-4d5bac8152bf",
                                                "text": "Ces traînasses en zig-zag, ou taupinières informes, fig. 7, sont fraîches, elles appartiennent à une jeune taupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afcd01ae-7b51-332b-8f8d-d553758794bb",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Galerie horizontale.",
                                            "Conduit de fumée horizontal."
                                        ],
                                        "tags": [
                                            "Fumisterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc21ff96-e8e0-42d6-81a0-34be10b9820c",
                                                "sense_id": "afcd01ae-7b51-332b-8f8d-d553758794bb",
                                                "text": "traînasse : Gaine d’allure horizontale qui conduit l’air vicié vers un extracteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0145803-95aa-3901-b972-2bd85aacb7bb",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Galerie horizontale.",
                                            "Galerie d’évacuation des gaz."
                                        ],
                                        "tags": [
                                            "Charbonnage"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "291fb5c2-2a8a-3675-80f8-9e3532331dc0",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Long filet d’oiseleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edb70b0-d7f1-4f84-a7ed-eec9a7e437e2",
                                                "sense_id": "291fb5c2-2a8a-3675-80f8-9e3532331dc0",
                                                "text": "TRAÎNASSE : sorte de filet dont les oiseleurs se servent pour attraper des perdrix et d’autres oiseaux."
                                            },
                                            {
                                                "example_id": "64b1de19-0a9f-4567-9e9a-8dffd66b9b53",
                                                "sense_id": "291fb5c2-2a8a-3675-80f8-9e3532331dc0",
                                                "text": "Une autre définition de traînasse est filet d'oiseleur traîné la nuit dans les champs pour prendre des perdrix et d’autres oiseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67a47e0-b670-36f4-8a79-e4f0548dda66",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Partie rampante de plantes."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab05c9af-fcdd-4dcb-b66a-a83d3d5434c6",
                                                "sense_id": "f67a47e0-b670-36f4-8a79-e4f0548dda66",
                                                "text": "Alors qu’elle se penchait pour soulever le tourniquet, son pied s’accrocha dans une « traînasse ». Battant l’air de ses bras pour récupérer son équilibre, elle ne trouva rien à se raccrocher et se retrouva étendue dans l’herbe […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ac22e2-8b7b-36d4-858d-c891d9ebb11f",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Tige aérienne ou souterraine par laquelle la plante se reproduit (stolon ou rhizome)."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c58cba83-dc8b-444c-9942-b4ea377fbc36",
                                                "sense_id": "a7ac22e2-8b7b-36d4-858d-c891d9ebb11f",
                                                "text": "TRAÎNÉE ou TRAÎNASSE. Longs filets qui, dans quelques plantes, telles que le fraisier, rampent sur la terre, et qui, d’espace en espace, ont des articulations par lesquelles elles jettent en terre de petites racines qui produisent de nouvelles plantes. (D.)"
                                            },
                                            {
                                                "example_id": "f9da82cb-d80c-4293-8cd3-ee7ddfa24480",
                                                "sense_id": "a7ac22e2-8b7b-36d4-858d-c891d9ebb11f",
                                                "text": "Du haut de la terrasse, il vit des jardiniers occupés à enlever les traînasses des fraisiers afin de conserver les pieds les plus vigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d865a6c-967a-322f-8eac-2a8bf3627235",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Nom vernaculaire de nombreuses plantes adventices des cultures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "909feb10-cc4f-460b-8402-9071ec43e72b",
                                                "sense_id": "7d865a6c-967a-322f-8eac-2a8bf3627235",
                                                "text": "Ainsi, le nom de « traînasse » correspond, selon les régions, au nom français de « gaillet gratteron », de « liseron des champs », de « mouron des oiseaux », de « chiendent pied de poule », de « renouée persicaire »… autant de plantes appartenant à des genres et familles botaniques différents !"
                                            },
                                            {
                                                "example_id": "873f06cb-3edf-44fd-89b2-122d2e694b4a",
                                                "sense_id": "7d865a6c-967a-322f-8eac-2a8bf3627235",
                                                "text": "Les pluies abondantes du printemps avaient encouragé le chiendent et la traînasse. Une fois les rangs décavaillonnés, il fallait tirer l’herbe à la main, soigneusement, là où le bigot ne pouvait passer, au risque de blesser les ceps de vigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea80c43-a5d2-3016-85bc-e1c12bcaf6c8",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Renouée des oiseaux."
                                        ],
                                        "tags": [
                                            "France entière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f9fe5e-7892-4f7c-9871-3c1725475e0d",
                                                "sense_id": "dea80c43-a5d2-3016-85bc-e1c12bcaf6c8",
                                                "text": "Le nombre élevé de types herbacés où le plantain lancéolé et la traînasse (Polygonum aviculare) dominent."
                                            },
                                            {
                                                "example_id": "392ccb7b-262b-45b4-82df-e5c17ec4e5bf",
                                                "sense_id": "dea80c43-a5d2-3016-85bc-e1c12bcaf6c8",
                                                "text": "Il s’agit en général de « chiendent » ou de la « renouée des oiseaux » qui s’appelle aussi « traînasse, centinode, herniole, sanguinaire », ou d’autres mauvaises herbes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b3f1971-8754-37e2-b0e8-232d1699d512",
                                        "entry_id": "29429ccc-4cdb-35f2-b651-405781e1176c",
                                        "glosses": [
                                            "Agrostis stolonifère ou chiendent rampant, selon les localités."
                                        ],
                                        "tags": [
                                            "France entière"
                                        ],
                                        "examples": []
