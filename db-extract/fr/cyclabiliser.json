                "senses": [
                    {
                        "sense_id": "00f66b81-5b5f-33d3-9fa2-a28bd1135beb",
                        "entry_id": "ce54b89c-2ab3-30c4-a214-e03f4434ac4b",
                        "glosses": [
                            "Rendre cyclable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc810113-1dc6-4a12-ad6e-908385d766e0",
                                "sense_id": "00f66b81-5b5f-33d3-9fa2-a28bd1135beb",
                                "text": "Alors que cyclabiliser la digue couterait beaucoup moins cher que ce qu'à couté la réouverture du tunnel."
                            },
                            {
                                "example_id": "bf6fbe0c-91f4-4d87-9d02-8c8793270c34",
                                "sense_id": "00f66b81-5b5f-33d3-9fa2-a28bd1135beb",
                                "text": "Les recommandations générales sont applicables à cette voirie, notamment de la 'cyclabiliser' (piste cyclable sécurisée)."
                            },
                            {
                                "example_id": "9fc3d6a3-ec16-46cf-a6c5-2a52daed7cb0",
                                "sense_id": "00f66b81-5b5f-33d3-9fa2-a28bd1135beb",
                                "text": "Alors que le PDU vise une augmentation de plus de 200 % de l’usage du vélo... ...le PDU 2012 intègre une politique de modération des vitesses qui permet de « cyclabiliser » le territoire à large échelle et à coût maitrisé et qui vient compléter l’effet de la réalisation des linéaires cyclables permis par le tramway."
                            }
                        ]
                    }
