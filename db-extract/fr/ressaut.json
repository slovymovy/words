                                    },
                                    {
                                        "sense_id": "c8da7eff-100f-3fb0-b090-22be11d9702c",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The display of an image by devices such as movie projector, video projector, overhead projector or slide projector."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee9c9b18-43ce-3aaa-b71e-74cf94b3e873",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "A forecast or prognosis obtained by extrapolation"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbbf6e7a-bff7-3436-be31-19e2bb2acac9",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "A belief or assumption that others have similar thoughts and experiences to one's own, including making accusations that would more fittingly apply to the accuser."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ccba297-2ed5-439f-811a-82579a7ac5bb",
                                                "sense_id": "dbbf6e7a-bff7-3436-be31-19e2bb2acac9",
                                                "text": "Projection is another mechanism of defense and is one that is utilized almost universally to explain one's minor mistakes, and in many cases the minor failures as well. By projection we place the blame for our acts upon others...."
                                            },
                                            {
                                                "example_id": "ebe7c0c5-426e-4a20-bbe6-39da61ae1404",
                                                "sense_id": "dbbf6e7a-bff7-3436-be31-19e2bb2acac9",
                                                "text": "The morality of patriarchy, Mary Daly argues, is charactrized by \"a failure to lay claim to that part of the psyche that is then projected onto 'the Other.'\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f067f808-df1f-3ca9-b73b-fa78edc84482",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The image that a translucent object casts onto another object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34b8885b-c0cd-3771-8383-526418ed207d",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "Any of several systems of intersecting lines that allow the curved surface of the earth to be represented on a flat surface. The set of mathematics used to calculate coordinate positions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58deefb2-0fa9-39b0-8e39-d4ed7bf4e6f5",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "An image of an object on a surface of fewer dimensions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4bfbb1d-a6cb-3f33-bf46-6001236d9430",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "An idempotent linear transformation which maps vectors from a vector space onto a subspace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "897d1367-a982-3e9a-8e31-610e64e91bc4",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "A transformation which extracts a fragment of a mathematical object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9053e1b5-c9a2-3a49-934a-19eb34e57181",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "A morphism from a categorical product to one of its (two) components."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95e7ddc2-4527-3b9f-a6fd-9148ad5c7d55",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The preservation of the properties of lexical items while generating the phrase structure of a sentence. See Projection principle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "A supposed mechanism for the transmutation of large quantities of base metals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e448495-1967-4ed7-b17b-9cf1a4c7b5df",
                                                "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                                "text": "I speak not here of Projection, whereby one part of an Aurifick Powder is said to turn I know not how many 100 or 1000 parts of an ignobler metal into silver or gold […]"
                                            },
                                            {
                                                "example_id": "611750fc-2fdf-4a0d-9c4a-67dd0278d412",
                                                "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                                "text": "But yet I would that every one should understand me aright, and not count me so simple, as if I did liken or compare my Aurum Potabile with that great Stone of the Philosophers, which transmutes vast quantities of imperfect metals into most pure Gold by projection […]"
                                            },
                                            {
                                                "example_id": "99bdcde1-1085-4e93-a6c8-b1c99ab2a81b",
                                                "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                                "text": "[Helmont] says, on another occasion, that an adept, after a few days of acquaintance, presented him with half a grain of the powder of projection, with which he transmuted nine ounces of quicksilver into pure gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f479c9-1f25-31f0-acac-bf3b0cf09334",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The distance the scent of a perfume radiates off the skin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4062818b-fd96-4438-b561-4f31e81d93c5",
                                                "sense_id": "25f479c9-1f25-31f0-acac-bf3b0cf09334",
                                                "text": "SKIN SCENT¶ A fragrance with low projection. One which stays close to the skin because the materials used to make it are less volatile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
