                "senses": [
                    {
                        "sense_id": "c10322fb-16d9-308e-9f78-81daf2739581",
                        "entry_id": "459b0cdf-e34e-3424-87de-75b6f967ba14",
                        "glosses": [
                            "Kontrolle von Fahrzeugführern, ob sie nicht mehr Alkohol als zulässig im Blut haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b6f0f0-802c-4849-8dfc-d42705161429",
                                "sense_id": "c10322fb-16d9-308e-9f78-81daf2739581",
                                "text": "„In Hamburg müssen Polizeibeamte oft stundenlang auf die richterliche Genehmigung einer Blutprobe warten – und die Zahl der Alkoholkontrollen sinkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d11f31d-0a33-46e5-a6ff-69bac7fea286",
                        "source_entry_id": "459b0cdf-e34e-3424-87de-75b6f967ba14",
                        "source_sense_id": "c10322fb-16d9-308e-9f78-81daf2739581",
                        "source_sense_description": "Kontrolle von Fahrzeugführern, ob sie nicht mehr Alkohol als zulässig im Blut haben",
                        "target_lang_word": "éthylotest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éthylotest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c24086dc-dd0e-3604-9b38-17687aa3e584",
                                        "entry_id": "4443969b-ffba-3191-878d-ea8ce2de2b60",
                                        "glosses": [
                                            "Appareil de mesure de l’alcoolémie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47c34377-815d-4dff-bc95-a87a63003fd9",
                                                "sense_id": "c24086dc-dd0e-3604-9b38-17687aa3e584",
                                                "text": "Aussitôt dit, aussitôt fait : voilà les trois énergumènes soufflant dans le ballon. Le policier ramassa les éthylotests, comme s'il ramassait les copies après un contrôle."
                                            },
                                            {
                                                "example_id": "44a4e0db-d821-440c-9b29-95fa1052eb59",
                                                "sense_id": "c24086dc-dd0e-3604-9b38-17687aa3e584",
                                                "text": "Depuis le début de l’année 2012 où a été introduite l’obligation de posséder dans chaque véhicule un éthylotest (non périmé), les protestations véhémentes de nombreux automobilistes ne semblaient pas avoir ému le gouvernement qui persistait dans sa décision."
                                            },
                                            {
                                                "example_id": "0b41d3d5-f7b1-4c40-80f0-1416cd1e6873",
                                                "sense_id": "c24086dc-dd0e-3604-9b38-17687aa3e584",
                                                "text": "Depuis 2010, des éthylotests anti-démarrage (EAD), qui n’autorisent le démarrage d’un véhicule que si le taux d’alcool mesuré est inférieur au seuil fixé, équipent obligatoirement les bus neufs destinés au transport d’enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36693346-b9f5-3854-991f-9922a40346cb",
                                        "entry_id": "4443969b-ffba-3191-878d-ea8ce2de2b60",
                                        "glosses": [
                                            "Action d’appréciation de l’alcoolémie au moyen d’un appareil."
                                        ],
                                        "tags": [
                                            "Transport terrestre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c01be031-c22b-4a6c-896c-149c3511b601",
                                                "sense_id": "36693346-b9f5-3854-991f-9922a40346cb",
                                                "text": "Quels sont les résultats de l’éthylotest ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36163eae-8070-48a7-9fcd-c709da34b3ca",
                        "source_entry_id": "459b0cdf-e34e-3424-87de-75b6f967ba14",
                        "source_sense_id": "c10322fb-16d9-308e-9f78-81daf2739581",
                        "source_sense_description": "Kontrolle von Fahrzeugführern, ob sie nicht mehr Alkohol als zulässig im Blut haben",
                        "target_lang_word": "alcootest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcootest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                        "entry_id": "37288149-91f3-3cbd-ba8c-3b2ba40db0bb",
                                        "glosses": [
                                            "Éthylotest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e97fb185-3450-4329-be9d-a45fc96a20e5",
                                                "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                                "text": "Faire passer un alcootest."
                                            },
                                            {
                                                "example_id": "26daf735-9433-4da7-a9a8-f956a993f017",
                                                "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                                "text": "Et c’est ainsi que sur le coup de treize heures, un conducteur se soumettait à l’alcootest, au volant de son monospace qui transportait six facteurs rigolards…"
                                            },
                                            {
                                                "example_id": "106bdb5d-ce01-4193-9e04-fdc8cfd59fac",
                                                "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                                "text": "L’ « alcootest » a été reconnu extrêmement efficace, tant dans de nombreux pays étrangers (dans lesquels son utilisation a été rendue réglementaire) qu’au cours d’expériences faites en France dans divers départements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
