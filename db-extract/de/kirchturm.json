                        "target_lang_word": "steeple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steeple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43d35dbe-aa76-3dc7-898d-87884cb46146",
                                        "entry_id": "e77ca190-42a6-3a5a-8650-4c0dbe616cee",
                                        "glosses": [
                                            "A tall tower, often on a church, normally topped with a spire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec40971-31a5-43db-8cc0-082db4296e97",
                                                "sense_id": "43d35dbe-aa76-3dc7-898d-87884cb46146",
                                                "text": "Above the session-room of the Council is the steeple, and in the steeple is the belfry, where exists, and has existed time out of mind, the pride and wonder of the village—the great clock of the borough of Vondervotteimittiss."
                                            },
                                            {
                                                "example_id": "e16bac57-ddc1-4de7-82c2-4283045b18e5",
                                                "sense_id": "43d35dbe-aa76-3dc7-898d-87884cb46146",
                                                "text": "So, the woman and the child had gone by, and gone on, and five had sounded from the steeples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "390203e5-f6ee-3fa1-910a-e69d7fe82e74",
                                        "entry_id": "e77ca190-42a6-3a5a-8650-4c0dbe616cee",
                                        "glosses": [
                                            "A spire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0185adc1-5c26-37df-974f-a9e3de0e3e0f",
                                        "entry_id": "e77ca190-42a6-3a5a-8650-4c0dbe616cee",
                                        "glosses": [
                                            "A high headdress of the 14th century."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "steeple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d78244ed-9d89-3f27-9b74-62bdbface627",
                                        "entry_id": "1b29515f-49a8-3e84-9a12-4218b41e9baf",
                                        "glosses": [
                                            "To form something into the shape of a steeple."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00ed7074-29e1-4005-8fa7-50cff0fce77c",
                                                "sense_id": "d78244ed-9d89-3f27-9b74-62bdbface627",
                                                "text": "He steepled his fingers as he considered the question."
                                            },
                                            {
                                                "example_id": "b56d1787-14ad-41cc-8e75-ce51533d535b",
                                                "sense_id": "d78244ed-9d89-3f27-9b74-62bdbface627",
                                                "text": "Mr. Ziegler is now angled forward with his elbows on his knees and his fingers steepled just under his nose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a437e8e1-2c6d-4c56-a32a-b51307c64dfe",
                        "source_entry_id": "81e35b3e-3bdd-3881-8a86-16779d259af5",
                        "source_sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                        "source_sense_description": "Architektur: der Turm einer Kirche",
                        "target_lang_word": "clocher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                        "entry_id": "70418bd0-b8c9-3bf4-8428-0f1901e6e1e8",
                                        "glosses": [
                                            "Bâtiment de maçonnerie ou de charpente dans lequel sont suspendues les cloches et qui est ordinairement élevé au-dessus d’une église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ff8d86-f6d4-49f8-80a7-08f252dbe5b5",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Ah ! c'est Tours. Mais voyez le bel effet que produisent dans le lointain les clochers de la cathédrale."
                                            },
                                            {
                                                "example_id": "8a1b4d81-7cf7-4dfc-834c-8db50ebce1df",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "L'Angélus sonne, dans un village où notre armée n'est pas encore, car notre premier soin, dans chaque clocher, est de couper les cordes"
                                            },
                                            {
                                                "example_id": "0d7069c7-77c4-404f-b9cb-5112cd31a623",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Celles-ci, nouvelles amazones, placèrent des sentinelles sur le clocher et se barricadèrent dans le chœur de l'église."
                                            },
                                            {
                                                "example_id": "458e074f-d2cc-4c63-8c55-79459dfe31ff",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Et puis voici un populeux village, un village compact, ramassé, aux ruelles étroites et tortueuses, sans jardins, sans courtils, un village serré autour de son antique clocher."
                                            },
                                            {
                                                "example_id": "9c855864-80b9-414c-b5db-0b275088604e",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "Lorsque, par moments, près du clocher de Sainte-Gudule, les croassements des corneilles s'élevaient, vous eussiez juré que c'était juste au dessus de votre tête."
                                            },
                                            {
                                                "example_id": "67854487-96fa-4754-89b0-a606358129a2",
                                                "sense_id": "85eb1908-7abc-35ba-b903-3851f5ab76cc",
                                                "text": "À la veille de Noël, tous les clochers d’église de Québec résonneront au même moment pour rendre hommage à tous les travailleurs qui ne comptent pas les heures travaillées pour lutter contre la pandémie. À ce tintamarre se joindront les sirènes des pompiers et des policiers de la capitale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4acc130-e5da-3391-9678-e6ef59efeff9",
                                        "entry_id": "70418bd0-b8c9-3bf4-8428-0f1901e6e1e8",
                                        "glosses": [
                                            "Paroisse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a3c310-ca11-42f1-b823-be0d501bde92",
                                                "sense_id": "f4acc130-e5da-3391-9678-e6ef59efeff9",
                                                "text": "Querelles de clochers."
                                            }
                                        ]
                                    }
                                ]
                            },
