                        "examples": [
                            {
                                "example_id": "c4ff8b02-2240-4bc2-8325-e93edc283a03",
                                "sense_id": "531b0f41-42f0-39d7-b20c-22056a13fe76",
                                "text": "In Noordoost-Groningen zijn bij de handel in grond en het vergeven van windmolenrechten door de overheid onverklaarbare miljoenendeals gesloten. Met die transacties en geheime toezeggingen handelde havenschap Groningen Seaports (GSP) buiten haar bevoegdheden. Met name één familiebedrijf, Bakker Bierum, verdiende miljoenen dankzij die overheidsdeals. Maar er zijn ook gedupeerden. Daarnaast legde de vriendjespolitiek een basis voor juridische geschillen die nog steeds doorslepen."
                            },
                            {
                                "example_id": "055db07b-4e92-4893-bdd4-846f39d5460e",
                                "sense_id": "531b0f41-42f0-39d7-b20c-22056a13fe76",
                                "text": "\"Zoals dat alles tot in de kleinste details besproken moet worden en dat er een lichamelijk onderzoek bij zit dat heel ingrijpend is. Ook kan het strafrechtelijke proces maar doorslepen en doorslepen, als een dader in beroep gaat.\""
                            }
                        ]
                    }
