                        "glosses": [
                            "Pertaining to or characterized by a solfatara."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec151c4-dd63-455c-8e35-378737d15235",
                                "sense_id": "564b3b65-323e-329f-968e-a3a50278608a",
                                "text": "On the southern slope of the Sulpher Mountains, as observed immediately north of the Scott & Gillmore oil-wells, and as shown in Fig. 15, these slaty shales are bounded on the south by a line of decomposed and bleached shale, which at many points shows evidence of solfataric action."
                            },
                            {
                                "example_id": "75f40e72-f0bb-4e03-9b84-286b20cfccec",
                                "sense_id": "564b3b65-323e-329f-968e-a3a50278608a",
                                "text": "Besides the solfataric volcano Apo, the giant of the archipelago, there are some other volcanic cones lying in this region."
                            },
                            {
                                "example_id": "a1dcaf01-64aa-48fe-945a-d743823a2ee4",
                                "sense_id": "564b3b65-323e-329f-968e-a3a50278608a",
                                "text": "By the use of this relationship, the equilibrium temperature of natural solfataric gases with respect to the reaction may be estimated, provided the theoretical value of K, the chemical composition, and the pressure of natural solfataric gases are known."
                            },
                            {
                                "example_id": "5f4df2a7-7ec4-4502-9c9a-9ca81d287357",
                                "sense_id": "564b3b65-323e-329f-968e-a3a50278608a",
                                "text": "Solfataras are found within the solfataric fields. Solfataric fields consist of soils, mud pots, and surface waters (sulfur-rich springs), heated by volcanic exhalations from the magma chambers located below them."
                            }
                        ]
                    }
