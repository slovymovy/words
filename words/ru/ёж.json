    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf996932-c39f-3cec-b28b-28bd9b6a7362",
                    "sense_definition": "Небольшое млекопитающее, спина и бока которого покрыты острыми иглами.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "животное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький <w>ёж</w> тихо шуршал сухими листьями под кустом в саду.",
                            "target_lang_translations": {
                                "en": "A little <w>hedgehog</w> rustled quietly among the dry leaves under a bush in the garden."
                            }
                        },
                        {
                            "text": "Когда к нему подошла собака, <w>ёж</w> сразу свернулся в клубок.",
                            "target_lang_translations": {
                                "en": "When the dog approached, the <w>hedgehog</w> immediately rolled into a ball."
                            }
                        }
                    ],
                    "synonyms": [
                        "ёж обыкновенный"
                    ],
                    "common_phrases": [
                        "морской ёж",
                        "ушастый ёж"
                    ],
                    "target_lang_definitions": {
                        "en": "A small mammal whose back and sides are covered with sharp spines."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hedgehog",
                                "target_lang_sense_clarification": "small spiny mammal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "698f2221-995a-3c9d-afd0-633934434ca2",
                    "sense_definition": "Оборонительное заграждение из скреплённых балок или рельсов, служащее препятствием для танков и другой техники.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "заграждение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На въезде в город солдаты спешно установили стальные <w>ежи</w>.",
                            "target_lang_translations": {
                                "en": "At the entrance to the city, the soldiers hastily set up steel <w>hedgehogs</w>."
                            }
                        },
                        {
                            "text": "Тяжёлая колонна бронетехники не смогла преодолеть эти мощные <w>ежи</w>.",
                            "target_lang_translations": {
                                "en": "The heavy column of armored vehicles could not overcome these massive <w>Czech hedgehogs</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "противотанковый ёж"
                    ],
                    "common_phrases": [
                        "противотанковые ежи",
                        "стальные ежи"
                    ],
                    "target_lang_definitions": {
                        "en": "A defensive anti-tank obstacle made of fastened beams or steel rails."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Czech hedgehog",
                                "target_lang_sense_clarification": "anti-tank obstacle"
                            },
                            {
                                "target_lang_word": "hedgehog",
                                "target_lang_sense_clarification": "military barrier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd131911-6d46-3117-bfbe-b7a7cf17e4b1",
                    "sense_definition": "Короткая мужская стрижка с торчащими вверх густыми волосами.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "причёска",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мальчик ходил стриженный под колючий <w>ёж</w>.",
                            "target_lang_translations": {
                                "en": "In the summer, the boy wore his hair in a prickly <w>crew cut</w>."
                            }
                        },
                        {
                            "text": "Парикмахер быстро подровнял торчащий <w>ёж</w> на его голове.",
                            "target_lang_translations": {
                                "en": "The barber quickly trimmed the bristling <w>spiky hair</w> on his head."
                            }
                        }
                    ],
                    "synonyms": [
                        "ёжик",
                        "бобрик"
                    ],
                    "common_phrases": [
                        "стрижка под ёж"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A short men's haircut with thick hair standing upright; crew cut or buzz cut."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crew cut",
