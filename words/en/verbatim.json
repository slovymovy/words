{
    "word_family": [
        "verbiage",
        "verbose",
        "verbosity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "270fed1c-3982-395e-9824-a49b5d817daf",
                    "sense_definition": "In exactly the same words as were used originally; word for word.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "word-for-word",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student was accused of plagiarism because he copied several paragraphs <w>verbatim</w> from the website.",
                            "target_lang_translations": {
                                "ru": "Студента обвинили в плагиате, потому что он скопировал несколько абзацев с сайта <w>дословно</w>."
                            }
                        },
                        {
                            "text": "She tried to repeat <w>verbatim</w> what the witness had said during the trial.",
                            "target_lang_translations": {
                                "ru": "Она попыталась повторить <w>слово в слово</w> то, что свидетель сказал во время суда."
                            }
                        }
                    ],
                    "synonyms": [
                        "word for word"
                    ],
                    "common_phrases": [
                        "repeat verbatim",
                        "quoted verbatim",
                        "reproduced verbatim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точно теми же словами, которые использовались изначально; слово в слово."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дословно",
                                "target_lang_sense_clarification": "точно, без искажений"
                            },
                            {
                                "target_lang_word": "слово в слово",
                                "target_lang_sense_clarification": "без каких-либо изменений текста"
                            },
                            {
                                "target_lang_word": "буквально",
                                "target_lang_sense_clarification": "точно соответствуя оригиналу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8a606b5-b7b7-3dec-b6a9-4cff8f5b763f",
                    "sense_definition": "By word of mouth; orally or verbally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oral-communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient legends were passed down <w>verbatim</w> through generations before they were ever written down.",
                            "target_lang_translations": {
                                "ru": "Древние легенды передавались <w>устно</w> из поколения в поколение, прежде чем были записаны."
                            }
                        },
                        {
                            "text": "He was not able <w>verbatim</w> to rehearse the method of his pen in front of the audience.",
                            "target_lang_translations": {
                                "ru": "Он не смог <w>на словах</w> изложить свой метод письма перед аудиторией."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean orally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устно или на словах (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устно",
                                "target_lang_sense_clarification": "словесно, не письменно"
                            },
                            {
                                "target_lang_word": "на словах",
                                "target_lang_sense_clarification": "в устной форме"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7029a1b3-9576-313f-8593-b0815a699cb8",
                    "sense_definition": "Corresponding exactly with the original source word for word.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "word-for-word",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist provided a <w>verbatim</w> account of the interview to ensure total accuracy.",
                            "target_lang_translations": {
                                "ru": "Журналист предоставил <w>дословный</w> отчет об интервью, чтобы обеспечить полную точность."
                            }
                        },
                        {
                            "text": "A <w>verbatim</w> transcript of the meeting is available for anyone who wants to read it.",
                            "target_lang_translations": {
                                "ru": "<w>Дословная</w> стенограмма встречи доступна всем, кто хочет её прочитать."
                            }
                        }
                    ],
                    "synonyms": [
                        "word for word",
                        "to the letter"
                    ],
                    "common_phrases": [
                        "verbatim transcript",
                        "verbatim report",
                        "verbatim record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точно соответствующий первоисточнику слово в слово."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дословный",
                                "target_lang_sense_clarification": "о документе или тексте"
                            },
                            {
                                "target_lang_word": "буквальный",
                                "target_lang_sense_clarification": "точный, следующий букве оригинала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be2aea8-2f0b-3a2a-bdc9-39f1449923be",
                    "sense_definition": "Describing a person or method able to record speech exactly as it is spoken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recording-speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court is looking for a <w>verbatim</w> reporter who can keep up with fast-paced legal arguments.",
                            "target_lang_translations": {
                                "ru": "Суду требуется <w>стенографист</w>, способный поспевать за быстрым темпом юридических споров."
                            }
                        },
                        {
                            "text": "She is a certified <w>verbatim</w> reporter with years of experience in shorthand and voice writing.",
                            "target_lang_translations": {
                                "ru": "Она является сертифицированным <w>стенографистом</w> с многолетним опытом работы в области скорописи и голосовой записи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verbatim reporter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает человека или метод, способный записывать речь точно так, как она произносится."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стенографический",
                                "target_lang_sense_clarification": "относящийся к точной записи речи"
                            },
                            {
                                "target_lang_word": "дословный",
                                "target_lang_sense_clarification": "фиксирующий каждое слово"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d1522b2-38b3-39b3-b485-7af456ab3dfa",
                    "sense_definition": "A piece of writing or a report that records a speech or conversation word for word.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "word-for-word",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher analyzed the <w>verbatims</w> from the focus group to identify recurring themes.",
                            "target_lang_translations": {
                                "ru": "Исследователь проанализировал <w>дословные записи</w> фокус-группы, чтобы выявить повторяющиеся темы."
                            }
                        },
                        {
                            "text": "Please include the full <w>verbatim</w> in the appendix of the final report.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, включите полную <w>стенограмму</w> в приложение к финальному отчету."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменная работа или отчет, в котором речь или беседа записаны слово в слово."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дословная запись",
                                "target_lang_sense_clarification": "точный текст беседы"
                            },
                            {
                                "target_lang_word": "стенограмма",
                                "target_lang_sense_clarification": "полная запись выступления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}