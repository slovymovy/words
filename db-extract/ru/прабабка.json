                                "target_senses": [
                                    {
                                        "sense_id": "67599f9c-4d52-3c72-859e-5f89ae1ab8f7",
                                        "entry_id": "d7fce620-205b-3a8a-a90f-4fc61421fa0c",
                                        "glosses": [
                                            "A great-grandmother."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6614a4d6-3b72-4dec-be1a-fdf25051cdfb",
                                                "sense_id": "67599f9c-4d52-3c72-859e-5f89ae1ab8f7",
                                                "text": "Yet, according to recent research, the alleged grumpiness of great-grandma and great-grandpa is more myth than reality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6a57f36-ea70-45a8-8716-4abeb9261967",
