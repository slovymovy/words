                    {
                        "sense_id": "cef99fd9-0600-3919-a030-8d526a63f13c",
                        "entry_id": "1058315d-cf83-3b45-891d-23431d381eb8",
                        "glosses": [
                            "vodka, usually in a Ukrainian context."
                        ],
                        "tags": [
                            "Russia",
                            "Southern"
                        ],
                        "examples": [
                            {
                                "example_id": "b5dadac2-450c-4301-89fc-973b81b94b91",
                                "sense_id": "cef99fd9-0600-3919-a030-8d526a63f13c",
                                "text": "... да горе́лки побо́льше, не с вы́думками горе́лки, не с изю́мом и вся́кими вытребеньками, а чи́стой пенной горе́лки, чтоб игра́ла и шипе́ла, как бе́шеная.",
                                "translation": "... and more gorelka, not with fantasies of gorelka, not with raisins and all kinds of frippery, but clean foaming gorelka, to sparkle and hiss like crazy.",
                                "english": "... and more gorelka, not with fantasies of gorelka, not with raisins and all kinds of frippery, but clean foaming gorelka, to sparkle and hiss like crazy."
                            }
                        ]
                    }
