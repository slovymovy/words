                "senses": [
                    {
                        "sense_id": "6927d70d-25ac-3c9f-b6e4-6ca0a618d6e8",
                        "entry_id": "a3ba6e0a-ff13-39b1-a4ec-a63c738c8cff",
                        "glosses": [
                            "Marble or a marble made of agate, or one that looks as if it were made of agate."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d9a5d36-fffe-4054-905f-96ab7e75fee7",
                                "sense_id": "6927d70d-25ac-3c9f-b6e4-6ca0a618d6e8",
                                "text": "Mrs. Collins. Never seen so many children out. Snowmen in every yard this year.\nBilly. Look at mine, Mr Willis. Got a baseball for a nose and my best aggies for eyes.\nMr. Willis. Yeah, marbles are fine—but in my day we used coal."
                            },
                            {
                                "example_id": "1e05e608-9510-4533-8727-705d549d0691",
                                "sense_id": "6927d70d-25ac-3c9f-b6e4-6ca0a618d6e8",
                                "text": "Most of the time it went fine; some of his classmates had so many marbles they could have opened up their own shop in smurfs, pirates, purple aggies and pink panthers."
                            }
                        ]
                    }
                ],
