                "senses": [
                    {
                        "sense_id": "1321e163-8c1f-370e-b2a9-c2562fd6f783",
                        "entry_id": "2b651bb3-3174-3a07-85ce-0802182123ff",
                        "glosses": [
                            "астрон. круговая полоса небесной сферы шириной в 9°, по которой солнце совершает свой годичный оборот и которая заключает в себе двенадцать созвездий, называющихся преимущественно именами животных"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a2851fb-a8dd-326c-b90a-24436581a170",
                        "entry_id": "2b651bb3-3174-3a07-85ce-0802182123ff",
                        "glosses": [
                            "астрол. круг или пояс, простирающийся, как считали в древности, на 8° по широте по обе стороны от эклиптики"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90267414-f13a-4be1-97ed-073e527593f6",
                        "source_entry_id": "2b651bb3-3174-3a07-85ce-0802182123ff",
                        "target_lang_word": "zodiac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zodiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae36cb89-490d-3026-adaf-8ae2e8da2635",
                                        "entry_id": "6ebc1e7a-5cb9-32ae-9c53-b4f756bf6f70",
                                        "glosses": [
                                            "The belt-like region of the celestial sphere, approximately eight degrees north and south of the ecliptic, which includes the apparent path of the sun, moon, and visible planets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa377300-8acb-41c9-ac9b-9ff597d804be",
                                                "sense_id": "ae36cb89-490d-3026-adaf-8ae2e8da2635",
                                                "text": "Tremulous on the bladed graſs ſhone bright the pearly drops, like an aſſembly of ſparkling ſtars dancing on the plains of the zodiac; vocal was every bending ſpray, every reed was inſpired, each vvarbling throat ſeemed to emulate the melodious voice of the bird of a thouſand ſongs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b421ed4-fa11-39a1-b79b-9be9950a6673",
                                        "entry_id": "6ebc1e7a-5cb9-32ae-9c53-b4f756bf6f70",
                                        "glosses": [
                                            "The twelve equal divisions of the zodiacal region into signs or houses, each named for a prominent constellation in the region."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f35bf0d3-4a3f-338e-90d9-4526d3006856",
                                        "entry_id": "6ebc1e7a-5cb9-32ae-9c53-b4f756bf6f70",
                                        "glosses": [
                                            "The ecliptic: the belt-like region of the celestial sphere corresponding to the apparent path of the sun over the course of a year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d592807-1243-3f31-ae82-a7aafb6f7b7a",
                                        "entry_id": "6ebc1e7a-5cb9-32ae-9c53-b4f756bf6f70",
                                        "glosses": [
                                            "Any of various astrological systems considered similar to the above."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c924f6c-5410-45ab-8c79-eb1b0e279eea",
                                                "sense_id": "3d592807-1243-3f31-ae82-a7aafb6f7b7a",
                                                "text": "Discussing both Chinese and Western zodiacs might be a prewriting activity."
                                            },
                                            {
                                                "example_id": "39a9a963-fc70-4d17-9234-b09fdc492866",
                                                "sense_id": "3d592807-1243-3f31-ae82-a7aafb6f7b7a",
                                                "text": "So the Dendera Zodiac seems to be a complete copy of the Mesopotamian zodiac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8fdaee9-fad0-319c-9b68-d710dc71a5bf",
                                        "entry_id": "6ebc1e7a-5cb9-32ae-9c53-b4f756bf6f70",
                                        "glosses": [
                                            "A circle decorated with the signs of the zodiac."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
