                                "sense_id": "e15165c0-a167-3005-8639-b9f577a0e269",
                                "text": "„Der barrierefreie Niederflurbus der Hornsteiner Firma K-Bus wird als Ruftaxi für alle Bewohner bereitstehen.“"
                            },
                            {
                                "example_id": "0ee9bf10-4898-43a5-ba8c-586f6c0930ed",
                                "sense_id": "e15165c0-a167-3005-8639-b9f577a0e269",
                                "text": "„Ein neuer Mercedes-Benz Citaro Niederflurbus verstärkt die Busflotte der Stadtwerke Leoben.“"
                            },
                            {
                                "example_id": "4a397f33-8837-43c6-9110-0606d22add68",
                                "sense_id": "e15165c0-a167-3005-8639-b9f577a0e269",
                                "text": "„Auch in Dorfen soll demnächst ein Niederflurbus eingesetzt werden.“"
                            }
