                        "cross_references": [
                            {
                                "target_word": "sanctuary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "A place of safety, refuge, or protection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3ca2c1-fbb2-4770-a1c0-e9a9db4c85b1",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "My car is a sanctuary, where none can disturb me except for people who cut me off."
                                            },
                                            {
                                                "example_id": "3d61d001-c9ee-4dcd-bb6d-be12370270a8",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "She saw him, even as she had last gazed upon him, pale, cold, and awful; but still he was there. The coffin was to her like a shrine; all that she held most dear and most precious was within its dark and silent sanctuary."
                                            },
                                            {
                                                "example_id": "9ad6d4c9-7b01-450e-95af-b7ba9b47c6ef",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "‘I understand that the district was considered a sort of sanctuary,’ the Chief was saying. ‘An Alsatia like the ancient one behind the Strand, or the Saffron Hill before the First World War.[…]’"
                                            },
                                            {
                                                "example_id": "bf30e63b-7247-4a58-865b-cbc272f50f2b",
                                                "sense_id": "40df216e-31b2-3520-b0c6-f7305644a299",
                                                "text": "In January, federal agents indicted 16 sanctuary leaders from Texas and Arizona on charges of helping to harbor illegal immigrants from Central America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "428eab59-917c-3c51-894d-50b4cc06f47e",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "An area set aside for protection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9defc0-7b6c-4991-8ee2-52f53be57f67",
                                                "sense_id": "428eab59-917c-3c51-894d-50b4cc06f47e",
                                                "text": "The bird sanctuary has strict restrictions on visitors so the birds aren't disturbed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661767ec-9dab-3e56-a71c-e667319de03f",
                                        "entry_id": "e589cb8f-8cee-3f58-9300-717af9d8c610",
                                        "glosses": [
                                            "A state of being protected, asylum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd96ac0e-ccdb-4418-a377-4ed709e7e00a",
                                                "sense_id": "661767ec-9dab-3e56-a71c-e667319de03f",
                                                "text": "The government granted sanctuary to the defector, protecting him from his former government."
                                            }
                                        ]
                                    },
