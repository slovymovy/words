                                "target_senses": [
                                    {
                                        "sense_id": "92aa6847-b791-35c3-b34f-f763b612c8c4",
                                        "entry_id": "99d9d993-0969-3063-87df-8009c25bfb96",
                                        "glosses": [
                                            "een geslacht Ranunculus van een aantal meestal overblijvende, kruidachtig planten met helder gele of soms witte bloemen uit de familie Ranunculaceae. Het geslacht omvat onder andere de boterbloemen en de waterranonkels. Afhankelijk van de taxonomische opvatting telt het tussen de 250 tot 600 soorten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3f1d64-bf44-4edb-bf1e-5a48489b4734",
                                                "sense_id": "92aa6847-b791-35c3-b34f-f763b612c8c4",
                                                "text": "Koeien houden niet van boterbloemen omdat zij een slechte smaak hebben en giftig zijn, hoewel ze gedroogd in hooi wel eetbaar zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cf37fd4-a1b2-45a4-bf98-59a82a036522",
                        "source_entry_id": "dac722fd-9c4d-3341-b46c-5e3f3d55f263",
                        "source_sense_description": "herb of the genus Ranunculus",
                        "target_lang_word": "bouton-d'or",
