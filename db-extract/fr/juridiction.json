        "fr-extract.jsonl": [
            {
                "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                "word": "juridiction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "821702b0-3471-4b6d-b601-2d38132ac684",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "tags": [
                            "plural"
                        ],
                        "form": "juridictions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "glosses": [
                            "Pouvoir d'un juge de rendre la justice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78db505e-1d9a-408c-937c-73f298fee12e",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Juridiction ecclésiastique."
                            },
                            {
                                "example_id": "b48345fc-0289-4f7c-b9a5-fca3e363a6d2",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Juridiction laïque."
                            },
                            {
                                "example_id": "74273dd8-d3cc-4593-9450-a84fdd7a30f9",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Juridiction ordinaire."
                            },
                            {
                                "example_id": "b3a220d6-6056-46f6-b6ba-4c58d14f2ecf",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Juridiction contentieuse Ce cas est de votre juridiction, sous votre juridiction."
                            },
                            {
                                "example_id": "e5d4e1ec-50b0-4544-afaa-2df2eb45f355",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Exercer sa juridiction."
                            },
                            {
                                "example_id": "afb2b259-c4a9-4dcb-b0f9-3144e037520d",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "On lui a attribué la juridiction sur toute cette étendue de pays."
                            },
                            {
                                "example_id": "cc7e1c33-3f68-48a3-a65a-4643057c2657",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Conflit de juridiction."
                            },
                            {
                                "example_id": "c38b1cf1-4cc4-4130-8cbe-d25afd7844c6",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Reconnaître la juridiction."
                            },
                            {
                                "example_id": "b8354faa-2618-43bb-884b-4206a4baf59f",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Degré de juridiction : Chacun des tribunaux devant lesquels une même affaire peut être successivement portée."
                            },
                            {
                                "example_id": "9cc9fe8c-439b-4564-8c66-2fa9d8601dbc",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Cette affaire a passé par les deux degrés de juridiction."
                            },
                            {
                                "example_id": "76caee4d-c822-4983-addb-51a0df5252f3",
                                "sense_id": "7053c487-f039-3cf8-9600-d63db448e1a1",
                                "text": "Le premier, le second degré de juridiction."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d2cf9cd-8cbe-3ab6-adab-c87fdb23188b",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "glosses": [
                            "Ressort, étendue du lieu où le juge a le pouvoir de juger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3384e0bc-65b6-4a03-8ba8-245aec85d5a7",
                                "sense_id": "2d2cf9cd-8cbe-3ab6-adab-c87fdb23188b",
                                "text": "La juridiction de cette cour est fort étendue."
                            },
                            {
                                "example_id": "7b2f4323-8244-4dba-948a-3c757e0d9af9",
                                "sense_id": "2d2cf9cd-8cbe-3ab6-adab-c87fdb23188b",
                                "text": "Cette commune est dans votre juridiction, hors de votre juridiction."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1f1676e-875d-32f4-92c3-66e98ba7c954",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "glosses": [
                            "Tribunal, service public de l'État, ayant pour fonction de juger les différends qui lui sont déférés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "184d8ddb-ada7-4b3c-a28c-5aac0b90f6b2",
                                "sense_id": "f1f1676e-875d-32f4-92c3-66e98ba7c954",
                                "text": "Les juridictions baroniales avec tout leur cortège furent supprimées, ainsi que les corvées, les dimes, les chasses réservées, les titres de noblesse."
                            },
                            {
                                "example_id": "0c8acad6-8daf-4b93-9e5f-3132cfe3e450",
                                "sense_id": "f1f1676e-875d-32f4-92c3-66e98ba7c954",
                                "text": "Ces dépenses injustifiées et excessives sont communément appelées, reprenant ainsi le terme de la jurisprudence des juridictions du contentieux de la tarification, abusives."
                            }
                        ]
                    },
                    {
                        "sense_id": "50cfd377-93b7-3864-9c27-dc7a814e3a57",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "glosses": [
                            "Ensemble des tribunaux de même degré ou de même classe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fcfdeb79-cede-38be-b8e3-e025c18ca5d8",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "glosses": [
                            "Attribution de compétence conférée par la loi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b65813-1ebe-460d-ac68-66a1d8676fa5",
                                "sense_id": "fcfdeb79-cede-38be-b8e3-e025c18ca5d8",
                                "text": "Le droit de justice des seigneurs hauts justiciers était absolu. Il emportait la plénitude de la juridiction civile et criminelle, limitée seulement par les cas royaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8740726-2afd-3601-a816-0bc28d4f1c45",
                        "entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "glosses": [
                            "Se dit à quelqu’un qui se mêle d’une chose qu’il n’entend pas."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f6444412-1e87-4519-b7a3-7f2d1b867d37",
                                "sense_id": "a8740726-2afd-3601-a816-0bc28d4f1c45",
                                "text": "Cela n’est point de votre juridiction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8db0b51e-c34c-466e-a248-c17c016f9cfb",
                        "source_entry_id": "61e3640a-f566-30cb-a83a-37c511c84255",
                        "target_lang_word": "jurisdiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
