                    "sense_definition": "Довольно часто; много раз.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>нередко</w> гуляем в этом парке по выходным.",
                            "target_lang_translations": {
                                "en": "We <w>often</w> walk in this park on weekends.",
                                "nl": "Wij wandelen in het weekend <w>vaak</w> in dit park.",
                                "pl": "W weekendy <w>często</w> spacerujemy po tym parku.",
                                "de": "Wir gehen <w>nicht selten</w> am Wochenende in diesem Park spazieren.",
                                "fr": "Nous nous promenons <w>souvent</w> dans ce parc le week-end.",
                                "it": "Ci capita <w>spesso</w> di passeggiare in questo parco durante il fine settimana.",
                                "cs": "O víkendech <w>nezřídka</w> chodíme na procházky do tohoto parku.",
                                "tr": "Hafta sonları bu parkta <w>sık sık</w> yürüyüş yaparız.",
                                "es": "Nosotros <w>a menudo</w> paseamos por este parque los fines de semana.",
                                "zh": "周末我们<w>经常</w>去那个公园散步。"
                            }
                        },
                        {
                            "text": "Такие ошибки <w>нередко</w> случаются у начинающих студентов.",
                            "target_lang_translations": {
                                "en": "Such mistakes <w>frequently</w> happen to beginner students.",
                                "nl": "Dergelijke fouten komen bij beginnende studenten <w>dikwijls</w> voor.",
                                "pl": "Takie błędy <w>niejednokrotnie</w> zdarzają się początkującym studentom.",
                                "de": "Solche Fehler passieren bei Anfängern <w>häufig</w>.",
                                "fr": "De telles erreurs arrivent <w>fréquemment</w> chez les étudiants débutants.",
                                "it": "Errori del genere accadono <w>frequentemente</w> agli studenti principianti.",
                                "cs": "Takové chyby se u začínajících studentů <w>často</w> stávají.",
                                "tr": "Böyle hatalar yeni başlayan öğrencilerde <w>sıklıkla</w> görülür.",
                                "es": "Tales errores <w>frecuentemente</w> les ocurren a los estudiantes principiantes.",
                                "zh": "初学者<w>往往</w>会犯这类错误。"
                            }
                        }
                    ],
