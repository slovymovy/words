                    "sense_id": "25855069-a731-3b3a-a28b-bf726a2d0c13",
                    "sense_definition": "Donner l'impression d'être ou de posséder une qualité particulière.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue journée de marche, cet enfant <w>semble</w> particulièrement fatigué.",
                            "target_lang_translations": {
                                "en": "After this long day of walking, this child <w>seems</w> particularly tired.",
                                "ru": "После этого долгого дня ходьбы этот ребёнок <w>выглядит</w> особенно уставшим.",
                                "nl": "Na deze lange wandeltocht <w>lijkt</w> dit kind bijzonder moe.",
                                "de": "Nach diesem langen Wandertag <w>wirkt</w> dieses Kind besonders müde.",
                                "pl": "Po tym długim dniu marszu to dziecko <w>wydaje się</w> bardzo zmęczone.",
                                "it": "Dopo questa lunga giornata di cammino, questo bambino <w>sembra</w> particolarmente stanco.",
                                "cs": "Po tomto dlouhém dni chůze <w>vypadá</w> to dítě obzvlášť unaveně.",
                                "tr": "Bu uzun yürüyüşün ardından bu çocuk özellikle yorgun <w>görünüyor</w>.",
                                "es": "Después de esta larga jornada de caminata, este niño <w>parece</w> especialmente cansado.",
                                "zh": "走了这么久，这个孩子<w>好像</w>特别累。"
                            }
                        },
                        {
                            "text": "Cette proposition <w>semblait</w> avantageuse pour tout le monde au premier abord.",
                            "target_lang_translations": {
                                "en": "At first glance, this proposal <w>seemed</w> advantageous to everyone.",
                                "ru": "На первый взгляд это предложение <w>казалось</w> выгодным для всех.",
                                "nl": "Dit voorstel <w>leek</w> op het eerste gezicht voor iedereen voordelig.",
                                "de": "Dieser Vorschlag <w>schien</w> auf den ersten Blick für alle vorteilhaft.",
                                "pl": "Na pierwszy rzut oka ta propozycja <w>wydawała się</w> korzystna dla wszystkich.",
                                "it": "A prima vista, questa proposta <w>sembrava</w> vantaggiosa per tutti.",
                                "cs": "Na první pohled <w>se zdál</w> tento návrh výhodný pro všechny.",
                                "tr": "İlk bakışta bu teklif herkes için avantajlı <w>görünüyordu</w>.",
                                "es": "A primera vista, esta propuesta <w>parecía</w> ventajosa para todos.",
                                "zh": "乍一看，这个提议<w>好像</w>对所有人都有利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paraître",
                        "avoir l'air"
                    ],
                    "common_phrases": [
                        "sembler évident",
                        "sembler bizarre",
                        "sembler facile"
                    ],
                    "target_lang_definitions": {
                        "en": "To give the impression of being or having a particular quality.",
                        "ru": "Производить впечатление обладания каким-либо качеством или состоянием.",
                        "nl": "De indruk wekken een bepaalde eigenschap te hebben of te bezitten.",
                        "de": "Den Eindruck erwecken, eine bestimmte Eigenschaft zu haben oder zu besitzen.",
                        "pl": "Sprawiać wrażenie, że ktoś lub coś ma określoną cechę lub stan.",
                        "it": "Dare l'impressione di essere o di avere una determinata qualità.",
                        "cs": "Působit dojmem, že někdo nebo něco má určitou vlastnost nebo stav.",
                        "tr": "Bir kişi ya da şeyin belirli bir özelliğe sahip olduğu veya belirli bir durumda bulunduğu izlenimini vermek.",
                        "es": "Dar la impresión de ser o de tener una cualidad determinada.",
                        "zh": "给人一种具有某种特定性质或状态的印象。"
                    },
