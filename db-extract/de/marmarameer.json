                        "entry_id": "3360ba52-03f3-3154-9661-8c1fc8b072e8",
                        "glosses": [
                            "Binnenmeer im Mittelmeer, das mit dem Ägäischen Meer durch die Dardanellen und mit dem Schwarzen Meer durch den Bosporus verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc56401-0f33-4783-8f5b-5428dd2a2687",
                                "sense_id": "1a3343eb-fbfa-3451-92e2-c0cfa3d6d3fb",
                                "text": "Wir haben Urlaub am Marmarameer gemacht."
                            },
                            {
                                "example_id": "511b0668-70d3-4505-ac59-a4db2a18c8ad",
                                "sense_id": "1a3343eb-fbfa-3451-92e2-c0cfa3d6d3fb",
                                "text": "„Unweit des Flughafens soll ein weiteres Milliardenprojekt entstehen, der Istanbul-Kanal, eine künstliche Wasserstraße vom Schwarzen Meer zum Marmarameer.“"
                            }
                        ],
