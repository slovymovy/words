                                "target_senses": [
                                    {
                                        "sense_id": "f4038457-4459-35ab-8bc8-c2e0c3c7e12c",
                                        "entry_id": "2e642989-6d46-369f-8b0a-bbadb4e23286",
                                        "glosses": [
                                            "nach Art einer Komödie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626b6daf-7549-4f04-8692-95ed7cc197f8",
                                                "sense_id": "f4038457-4459-35ab-8bc8-c2e0c3c7e12c",
                                                "text": "Die „Hochzeit des Figaro“ ist eine komische Oper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "283338c3-7652-316c-adca-8ee8fbd40472",
                                        "entry_id": "2e642989-6d46-369f-8b0a-bbadb4e23286",
                                        "glosses": [
                                            "zum Lachen anregend (witzig); erheiternd, spaßig, lustig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c954b6f5-c473-4847-9f17-575f5009bfa8",
                                                "sense_id": "283338c3-7652-316c-adca-8ee8fbd40472",
                                                "text": "Am meisten hat der Clown die Kinder mit seinen komischen Bewegungen zum Lachen gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                        "entry_id": "2e642989-6d46-369f-8b0a-bbadb4e23286",
                                        "glosses": [
                                            "Verwunderung auslösend; sonderbar, seltsam, merkwürdig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d688c0-72ef-47d2-98c8-72e4b25a1efd",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "Erdbeeren mit Senf schmecken komisch."
                                            },
                                            {
                                                "example_id": "92bd3662-3d1c-4179-b597-9bb129101b7a",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "Das war schon ein komisches Zusammentreffen, wieso taucht sie gerade jetzt auf?"
                                            },
                                            {
                                                "example_id": "ce9bace8-d97b-4a61-808e-381d013aa26b",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "Die Praktikantin schlug sich den Kopf an der Befestigungsstange an, fing an zu bluten und reagierte komisch, anstatt vor Schmerzen zu jammern, fing sie an zu lachen."
                                            },
                                            {
                                                "example_id": "cb5b9983-ff6e-4bc9-8362-d474caba4205",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "„Für eine Landpomeranze wie mich war es irgendwie komisch, in Norditalien Deutsch zu unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41ea81e1-cc55-41a6-905f-b536c1cf93ac",
                        "source_entry_id": "8a1683f7-066b-36bf-b738-a45fe768d59f",
                        "source_sense_id": "cbc6cbd7-f567-353a-acda-66dd27f53c1e",
                        "source_sense_description": "umgangssprachlich: komisch, merkwürdig, sonderbar",
                        "target_lang_word": "merkwürdig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merkwürdig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a9c17c9-f464-336a-ac1d-63a616134ce4",
                                        "entry_id": "47fed981-197f-313d-bb0b-740ec8309ddf",
                                        "glosses": [
                                            "durch Abweichung vom Üblichen auffallend; Staunen, Verwunderung oder aber leises Misstrauen bewirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e70bba-f297-4eb8-b072-faf1467537a3",
                                                "sense_id": "6a9c17c9-f464-336a-ac1d-63a616134ce4",
                                                "text": "Heute verhält er sich merkwürdig."
                                            },
                                            {
                                                "example_id": "b3debc87-0cc6-492e-b0a3-0530426b3f29",
                                                "sense_id": "6a9c17c9-f464-336a-ac1d-63a616134ce4",
                                                "text": "Sie kamen unter merkwürdigen Umständen ums Leben."
                                            },
                                            {
                                                "example_id": "29b9a51c-8287-47da-a315-5df692c6c1ad",
                                                "sense_id": "6a9c17c9-f464-336a-ac1d-63a616134ce4",
                                                "text": "Heute war er merkwürdig still."
                                            },
                                            {
                                                "example_id": "e07f1535-abcd-45b0-8214-22428caba925",
                                                "sense_id": "6a9c17c9-f464-336a-ac1d-63a616134ce4",
                                                "text": "„Die Briten hatten nach dem Aufstand von 1857 die merkwürdige Doktrin von den «martial races» verkündet.“"
                                            },
                                            {
                                                "example_id": "a1d25faf-2de0-41d7-be95-f37118127df9",
                                                "sense_id": "6a9c17c9-f464-336a-ac1d-63a616134ce4",
                                                "text": "„Wir begegneten uns zum erstenmal in einem obskuren Buchladen in der Rue Montmartre, wo der Zufall, daß wir beide dasselbe, übrigens sehr seltene und merkwürdige Buch suchten, uns in nähere Beziehung zueinander brachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2eeea711-4035-338c-a7ba-89fe9c0944f9",
                                        "entry_id": "47fed981-197f-313d-bb0b-740ec8309ddf",
                                        "glosses": [
                                            "auffallend, des Merkens würdig, bedeutsam"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8d0365f-b00f-46a4-b79e-de89805c101c",
                                                "sense_id": "2eeea711-4035-338c-a7ba-89fe9c0944f9",
                                                "text": "„Noch in seinem [Joseph I.] Todesjahre, 1711, kam durch den k. k. Stuckgießer Johann Achamer die merkwürdige große Josephinische Glocke bei St. Stephan zu Stande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ab9fa0c-bec4-45d4-bd0f-1d8eb892e555",
                        "source_entry_id": "8a1683f7-066b-36bf-b738-a45fe768d59f",
                        "source_sense_id": "cbc6cbd7-f567-353a-acda-66dd27f53c1e",
