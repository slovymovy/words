                "senses": [
                    {
                        "sense_id": "2e44f990-df9f-3fa5-8a4e-96948c108e64",
                        "entry_id": "b9909223-c8ce-3ba5-a924-6db3beb40370",
                        "glosses": [
                            "osoba wykorzystywana w społeczności lub miejscu pracy"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ee3ea5d0-1bbe-45d7-ac02-cf61990f3018",
                                "sense_id": "2e44f990-df9f-3fa5-8a4e-96948c108e64",
                                "text": "Nie pozwalaj, by traktowali cię jak popychadło."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ed86b0c-9f0a-4ad3-b1e3-c87ca3d0b06f",
                        "source_entry_id": "b9909223-c8ce-3ba5-a924-6db3beb40370",
                        "source_sense_id": "2e44f990-df9f-3fa5-8a4e-96948c108e64",
                        "target_lang_word": "dogsbody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dogsbody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9df2730e-52db-3283-b9a9-86e890dcdd3f",
                                        "entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                                        "glosses": [
                                            "A person who does menial work, a servant."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c18e2ad3-54a8-4d66-a94c-342227fff49d",
                                                "sense_id": "9df2730e-52db-3283-b9a9-86e890dcdd3f",
                                                "text": "Who chose this face for me? This dogsbody to rid of vermin."
                                            },
                                            {
                                                "example_id": "f58d612d-bee2-41eb-bb0d-dd6f4d84867c",
                                                "sense_id": "9df2730e-52db-3283-b9a9-86e890dcdd3f",
                                                "text": "'Cause I, I wanna be anarchy! / No dogsbody!"
                                            },
                                            {
                                                "example_id": "19166c60-41e8-490c-ad78-3023d7cedc7f",
                                                "sense_id": "9df2730e-52db-3283-b9a9-86e890dcdd3f",
                                                "text": "That's just Baldrick, my dogsbody."
                                            },
                                            {
                                                "example_id": "329799ee-fffd-4f6c-b3e3-23a9fc6c1a67",
                                                "sense_id": "9df2730e-52db-3283-b9a9-86e890dcdd3f",
                                                "text": "Furthermore, there are still rather backward opinions in our society about the role of a translator. A translator is often regarded as a linguistic dogsbody."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb27c9bd-a4af-3d02-9b48-135f7daf3152",
                                        "entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                                        "glosses": [
                                            "Alternative form of dog's body (“pease pudding”)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dogsbody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b011d3-4bc2-3dd6-a099-0a8e6dafe7f0",
                                        "entry_id": "401dbdcd-47ac-3b75-8e69-839a7a881133",
                                        "glosses": [
                                            "To act as a dogsbody, to do menial work"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d520a1c6-4bcc-40b8-a21b-99b4479b7b26",
                                                "sense_id": "c3b011d3-4bc2-3dd6-a099-0a8e6dafe7f0",
                                                "text": "Perhaps because, having been brought up in all those different countries and languages, and then studying economics of all things for just a year, followed by four years dogsbodying for a haulage company, he had never got any serious reading done."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14ba9c1a-0f39-4f1e-9eca-699ca78df7af",
                        "source_entry_id": "b9909223-c8ce-3ba5-a924-6db3beb40370",
                        "source_sense_id": "2e44f990-df9f-3fa5-8a4e-96948c108e64",
                        "target_lang_word": "doormat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doormat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                        "entry_id": "89f51d9a-5a58-39d6-b5f2-f4fb78f6c76c",
                                        "glosses": [
                                            "A coarse mat at the entrance to a house, upon which one wipes one's shoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b30246c-3236-41ec-94e8-28c5802a77e8",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Wipe your shoes on the doormat before you start plodding around in the house."
                                            },
                                            {
                                                "example_id": "7b697b88-609a-4860-8240-e7f6f740d9b4",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Mr. Simpson adds that the station at Stanmore appears practically unchanged from the time of its opening, even to the L.N.W.R. rubber doormat, which \"shows no signs of wearing out.\""
                                            },
                                            {
                                                "example_id": "bb62fe51-48ee-4b6c-96b8-e04d526bf2b0",
                                                "sense_id": "77e710eb-b257-3302-8034-1026b852513a",
                                                "text": "Dimple glanced at an expensive-looking doormat with the words ‘LOSE THE SHOES’ woven into it and wondered why anyone would bother spending so much money on something people were going to wipe their feet on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                        "entry_id": "89f51d9a-5a58-39d6-b5f2-f4fb78f6c76c",
                                        "glosses": [
                                            "Someone who is overly submissive to others' wishes."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16889007-cf40-452f-a162-cefd2232b0c5",
                                                "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                                "text": "He's such a doormat, he lets everyone walk all over him."
                                            },
                                            {
                                                "example_id": "aa2834df-cc06-4629-a98c-58e817e45622",
                                                "sense_id": "969088b4-688a-3701-a350-197c50b49c00",
                                                "text": "If you flipped through certain magazines at this time you could be forgiven for thinking that there was no right way to be a woman, only wrong ones — bimbo or frump, slut or prude, shrew or doormat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a5dcb8-32c7-4522-bd86-ecf245466605",
                        "source_entry_id": "b9909223-c8ce-3ba5-a924-6db3beb40370",
                        "source_sense_id": "2e44f990-df9f-3fa5-8a4e-96948c108e64",
                        "target_lang_word": "pushover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pushover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "717d4d29-e11a-355b-b11e-7e257f542927",
                                        "entry_id": "649a5b25-99af-31dc-8f0b-89703db263ec",
                                        "glosses": [
                                            "Someone who is easily swayed or influenced to change their mind or comply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd190ba-d61c-41ec-90d7-1f357a4a202b",
                                                "sense_id": "717d4d29-e11a-355b-b11e-7e257f542927",
                                                "text": "I'm a pushover when it comes to buying new kitchen gadgets."
                                            },
                                            {
                                                "example_id": "3d02cb95-8baa-472c-b09b-2d63adba1b8d",
                                                "sense_id": "717d4d29-e11a-355b-b11e-7e257f542927",
                                                "text": "“His [Helmut Newton's] women are strong and powerful, definitely not pushovers,” he says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8166274b-3666-30ce-bdac-4074779aa3c0",
                                        "entry_id": "649a5b25-99af-31dc-8f0b-89703db263ec",
                                        "glosses": [
                                            "Someone who is easy to push around and to take advantage of; someone who lets themselves be picked on or bullied without defending or standing up for themselves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9614fba1-590b-3dac-9c01-edd116469546",
                                        "entry_id": "649a5b25-99af-31dc-8f0b-89703db263ec",
                                        "glosses": [
                                            "Something that is easy to do or accomplish; an easy task."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9a3b637-9ebf-4c9d-a89f-021476a8e769",
                        "source_entry_id": "b9909223-c8ce-3ba5-a924-6db3beb40370",
