                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c35a8f-cfab-44f1-a1fa-d89181fb78bb",
                                "sense_id": "dede7078-0131-38ad-a359-01a3ebf6f6d5",
                                "text": "A very superficial , ignorant , unweighing fellow"
                            },
                            {
                                "example_id": "206bcd66-829c-48c1-9bc5-7227f7183419",
                                "sense_id": "dede7078-0131-38ad-a359-01a3ebf6f6d5",
                                "text": "Still, from his youth, impetuous, as a storm, Blind, and unweighing confequence, he rufh'd, Headlong he rush'd, and acted every wish;"
                            },
                            {
                                "example_id": "dc808647-978c-4ea2-a47a-3e3f0628e80b",
                                "sense_id": "dede7078-0131-38ad-a359-01a3ebf6f6d5",
                                "text": "That mental indolence or languor—that habit of slurring over difficult propositions, is alluded to, which deters the mind from following and seizing upon the higher steps of ratiocination—which makes the man a careless listener—and unweighing reader, and an unsound thinker ."
                            }
                        ]
                    }
