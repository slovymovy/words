                        "glosses": [
                            "Producing darkness, obscuring; (loosely) gloomy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e96c1314-8f54-4a4e-86f9-c06956818e0a",
                                "sense_id": "c50e8da3-9635-304f-b4d7-ea16ad63afaf",
                                "text": "Tenebrific stars were once thought to be the source of darkness during the night."
                            },
                            {
                                "example_id": "fb502c49-cc34-42b3-980e-1f4db617b8d3",
                                "sense_id": "c50e8da3-9635-304f-b4d7-ea16ad63afaf",
                                "text": "It lightens, it brightens, / The tenebrific ſcene, / To meet with, and greet with / My Davie, or my Jean!"
                            }
                        ]
                    }
                ],
