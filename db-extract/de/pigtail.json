                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1745fd5-9407-4bda-96cc-7c9d0391dee0",
                                "sense_id": "e6c23fae-500c-3b6f-8e52-812c61e7262a",
                                "text": "„Die Pigtails passen erwartungsgemäß perfekt und nach leichtem Druck sind Kabel und Anschlüsse fest miteinander verbunden.“"
                            }
                        ],
