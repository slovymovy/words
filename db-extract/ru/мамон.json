                "senses": [
                    {
                        "sense_id": "35d3e164-5ca7-344c-9655-2f1fbf7efff6",
                        "entry_id": "8c5316fd-c6fe-35e1-8e26-d2397cbd0edf",
                        "glosses": [
                            "то же, что мамона; утроба, брюхо, желудок как символ алчности, обжорства, стяжательства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863ea815-3266-4a50-bd6c-7f7b12a18480",
                                "sense_id": "35d3e164-5ca7-344c-9655-2f1fbf7efff6",
                                "text": "Не можешь служить Богу и мамону."
                            },
                            {
                                "example_id": "b88ae377-f273-4a22-ad41-9853ef4ea0e7",
                                "sense_id": "35d3e164-5ca7-344c-9655-2f1fbf7efff6",
                                "text": "Нельзя работать на Бога и на мамона."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9eff29a-6a03-3a8a-b337-f19bd700d476",
                        "entry_id": "8c5316fd-c6fe-35e1-8e26-d2397cbd0edf",
                        "glosses": [
                            "живот, брюхо, желудок в буквальном значении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ac552e-e275-4263-a631-0ec915d9c6cb",
                                "sense_id": "a9eff29a-6a03-3a8a-b337-f19bd700d476",
                                "text": "Им, ракушкам, жить хочется, а ты, простофиля, ими мамон с утра до вечера набиваешь."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e0b117b-1b37-39bd-89bb-708c5befc788",
                        "entry_id": "8c5316fd-c6fe-35e1-8e26-d2397cbd0edf",
                        "glosses": [
                            "рег. (арх.) то же, что няндомец"
                        ],
                        "tags": [],
                        "examples": []
                    }
