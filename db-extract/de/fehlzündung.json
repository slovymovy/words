                        "sense_id": "e6709b03-4732-3330-99a8-72abb7acab80",
                        "entry_id": "621cbeb4-db3c-33ca-aca3-07e45413abbe",
                        "glosses": [
                            "die misslungene oder verspätete Zündung eines Motors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2540090-10a4-42a9-b457-32a3ed301523",
                                "sense_id": "e6709b03-4732-3330-99a8-72abb7acab80",
                                "text": "Eine Fehlzündung kann auftreten, „wenn unverbrannter Kraftstoff in die Auspuffanlage gelangt und erst dort entzündet wird.“"
                            },
                            {
                                "example_id": "921227bd-67e5-4770-ad9b-68cd30ac7819",
                                "sense_id": "e6709b03-4732-3330-99a8-72abb7acab80",
                                "text": "„Um diese Fehlzündungen absichtlich hervor zu rufen, wird in Showcars zu diesem Zweck ein Schalter für die Unterbrechung der Zündung eingebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
