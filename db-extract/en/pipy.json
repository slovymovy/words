                                "sense_id": "29145fe7-f7cc-3e6d-a426-55768ea6a9fa",
                                "text": "In desolate places where dank moisture breeds / The pipy Hemlock to strange overgrowth"
                            },
                            {
                                "example_id": "0459382c-2856-48a2-8151-10fa5737a482",
                                "sense_id": "29145fe7-f7cc-3e6d-a426-55768ea6a9fa",
                                "text": "The hook had fouled among a bunch of strawberries, red on one side and white on the other—perfect reproductions of the land fruit, except that there were no leaves, and the stem was all pipy and slimy."
                            }
                        ]
                    }
