                "senses": [
                    {
                        "sense_id": "74217e5a-4cec-3d93-824a-67c293852257",
                        "entry_id": "0589baa8-abf9-3ec2-8a5e-ac6a9200efd9",
                        "glosses": [
                            "viering halverwege de vastentijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ae8288-7f12-4f1e-ae7a-d6db4cd35f92",
                                "sense_id": "74217e5a-4cec-3d93-824a-67c293852257",
                                "text": "De verenigingen spreken met de gemeente af of op een later tijdstip de parade alsnog kan plaatsvinden. De verenigingen van Den Bosch en Breda noemen 6 maart, Halfvasten, als alternatief voor de parade."
                            },
                            {
                                "example_id": "9677b399-ac72-46fc-b5df-9a4fef06f324",
                                "sense_id": "74217e5a-4cec-3d93-824a-67c293852257",
                                "text": "Krabben wil de optocht verplaatsen naar Halfvasten op 6 maart, zoals ook in Breda gebeurt."
                            },
                            {
                                "example_id": "198f60cf-41fc-4311-b273-33ba4fd03bb9",
                                "sense_id": "74217e5a-4cec-3d93-824a-67c293852257",
                                "text": "Tijdens de carnavalsviering ruim een maand geleden mochten de praalwagens vanwege het slechte weer niet uitrijden. Veel optochten werden daarom uitgesteld tot halfvasten, het midden van de vastentijd."
                            },
                            {
                                "example_id": "0c5f8302-70b3-41e2-b453-002c3ad90f8d",
                                "sense_id": "74217e5a-4cec-3d93-824a-67c293852257",
                                "text": "Halvemaanvormige broodjes, zogenaamde krombroodjes, worden in Sittard vanaf 1923 van een helling in de Kollenberg te grabbel gegooid voor de kinderen van de stad. Deze traditie bestaat nog steeds. Ieder jaar halverwege de vastenperiode, halfvasten, worden zo'n 15.000 broodjes uitgegooid door het Sittardse Krombroodcomité en een jaarlijkse eregast."
                            }
                        ]
                    }
