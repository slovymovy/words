                "senses": [
                    {
                        "sense_id": "4c49d0b7-c8dc-3409-bb9b-31b28ce22b02",
                        "entry_id": "1ae5ccc5-6f91-34d5-a9a2-398c10ef8c0e",
                        "glosses": [
                            "Médiateur indépendant, représentant un contre-pouvoir, un recours contre l'État, ses abus, ses lourdeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc8213c-e463-4361-91ff-2f8c2c2987bb",
                                "sense_id": "4c49d0b7-c8dc-3409-bb9b-31b28ce22b02",
                                "text": "Mme Mulroney dit avoir pleinement confiance en la capacité de la commissaire aux services en français, un poste créé au sein du bureau de l'ombudsman de l’Ontario après l’abolition du Commissariat, d’enquêter sur les manquements à la LSF."
                            },
                            {
                                "example_id": "b1d43091-0b94-448e-b7de-c39f47df518d",
                                "sense_id": "4c49d0b7-c8dc-3409-bb9b-31b28ce22b02",
                                "text": "Les ombudsmans sont des porteurs de doléances des citoyens, des usagers ou des consommateurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b5928fd-935c-314f-8a1d-324f1f776ee9",
                        "entry_id": "1ae5ccc5-6f91-34d5-a9a2-398c10ef8c0e",
                        "glosses": [
                            "Tout médiateur indépendant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fed5900-3d8b-4c88-8b92-455f2f00ddb8",
                        "source_entry_id": "1ae5ccc5-6f91-34d5-a9a2-398c10ef8c0e",
