                    }
                ],
                "senses": [
                    {
                        "sense_id": "29168d76-d3f8-3e5b-971f-40be1eb60a94",
                        "entry_id": "72854425-35b8-39ef-88bc-32b73cf3e7a6",
                        "glosses": [
                            "To act as a shroff, especially (historical) to inspect coins to detect debasement, counterfeits, clipping, etc. for a commission."
                        ],
                        "tags": [
                            "India",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b99bf913-5f82-43a2-8731-b8eedf5dc9ec",
                                "sense_id": "29168d76-d3f8-3e5b-971f-40be1eb60a94",
                                "text": "The potential revenues of China are immense, but they are ‘shroffed’... by every hand through which they pass."
                            },
                            {
                                "example_id": "59a3a0ca-8891-437e-9d32-627e9255b259",
                                "sense_id": "29168d76-d3f8-3e5b-971f-40be1eb60a94",
                                "text": "I represented... that the money could not be divided till it was shroffed."
                            }
                        ]
                    }
