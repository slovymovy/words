                "translations": [
                    {
                        "translation_id": "665a0dee-4045-4def-8a90-42843a1553b8",
                        "source_entry_id": "0197b91d-255c-3f89-9dca-d3eafc562477",
                        "source_sense_id": "d4d4cf2f-29dd-3347-998f-8dd1527d9baa",
                        "target_lang_word": "melodrama",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melodrama",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92075aed-cdbf-3d0f-92fb-9a20cf13fa56",
                                        "entry_id": "3d382793-69c4-3e6f-8109-9c0525639670",
                                        "glosses": [
                                            "A kind of drama having a musical accompaniment to intensify the effect of certain scenes."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93c6f749-4914-332f-9bcd-16333bbb9640",
                                        "entry_id": "3d382793-69c4-3e6f-8109-9c0525639670",
                                        "glosses": [
                                            "A drama abounding in romantic sentiment and agonizing situations, with a musical accompaniment only in parts which are especially thrilling or pathetic."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82b150fd-6f60-39a0-975c-1a04c85aa929",
                                        "entry_id": "3d382793-69c4-3e6f-8109-9c0525639670",
                                        "glosses": [
                                            "A passage in which the orchestra plays a somewhat descriptive accompaniment, while the actor speaks."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e1b21be-4a90-4d41-aad3-d5c3ccbc1f39",
                                                "sense_id": "82b150fd-6f60-39a0-975c-1a04c85aa929",
                                                "text": "The grave-digging scene in Beethoven's “Fidelio” has much melodrama."
                                            },
                                            {
                                                "example_id": "3cbeec51-e3d4-48e9-a407-e9943c5cb896",
                                                "sense_id": "82b150fd-6f60-39a0-975c-1a04c85aa929",
                                                "text": "Rudolf was the bold, bad Baron of traditional melodrama. Irene was young, as pretty as a picture, fresh from a music academy in England. He was the scion of an ancient noble family; she an orphan without money or friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470aec31-1469-3a71-90e8-4613b311c116",
                                        "entry_id": "3d382793-69c4-3e6f-8109-9c0525639670",
                                        "glosses": [
                                            "Any situation or action which is blown out of proportion."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8b96d95-a90d-4055-991a-623144dbf237",
                        "source_entry_id": "0197b91d-255c-3f89-9dca-d3eafc562477",
                        "source_sense_id": "d4d4cf2f-29dd-3347-998f-8dd1527d9baa",
                        "target_lang_word": "mélodrame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mélodrame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c05a476b-34eb-36e7-95d0-64d4c2f28201",
                                        "entry_id": "305371c4-01ee-38bc-9dae-5f276029269f",
                                        "glosses": [
                                            "Sorte de drame populaire, mêlé de musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e90c05-f5d4-4aa4-bfd7-ef2d5c0a180e",
                                                "sense_id": "c05a476b-34eb-36e7-95d0-64d4c2f28201",
                                                "text": "Les anciens mélodrames où les niais étaient de première nécessité, firent la réputation de cet artiste, […]."
                                            },
                                            {
                                                "example_id": "d6138555-68ca-4383-ae19-35630e896206",
                                                "sense_id": "c05a476b-34eb-36e7-95d0-64d4c2f28201",
                                                "text": "Les enfants aiment les pommes vertes, et les pommes vertes leur font du mal. Il doit en être de même pour le mélodrame, qui indigestionne le public, quand il s'en gorge."
                                            },
                                            {
                                                "example_id": "c2258f06-c925-42eb-b141-da324771c6f2",
                                                "sense_id": "c05a476b-34eb-36e7-95d0-64d4c2f28201",
                                                "text": "Je me rappelle l'avoir rencontrée un jour, pour la première fois, dans un abominable foyer d'un théâtre du boulevard, mal éclairé et tout rempli de cette foule bourdonnante qui juge d'ordinaire les mélodrames à grand spectacle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8be0764-4308-3bf2-a300-7926e6f83f8c",
                                        "entry_id": "305371c4-01ee-38bc-9dae-5f276029269f",
                                        "glosses": [
                                            "Ouvrage dramatique dans lequel sont accumulées les situations violentes et les péripéties imprévues."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5d2155-3492-433d-ae02-6b01f2b6acde",
                                                "sense_id": "b8be0764-4308-3bf2-a300-7926e6f83f8c",
                                                "text": "Le 11 mai : soirée de gala donnée pour la reconstruction du village de Laffaux (Aisne), avec Les Dieux ont soif, mélodrame assez touffu, tiré du roman d’Anatole France par Pierre Chaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d6c6679-fe3f-3ee6-bdb8-bb1a306650fd",
                                        "entry_id": "305371c4-01ee-38bc-9dae-5f276029269f",
                                        "glosses": [
                                            "Ouvrage littéraire dont le langage est emphatique et exagéré."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3585edd6-e75c-4836-afe4-13e45f04f818",
                                                "sense_id": "4d6c6679-fe3f-3ee6-bdb8-bb1a306650fd",
                                                "text": "Personnage de mélodrame."
                                            },
                                            {
                                                "example_id": "7c3b2f28-95c8-4ac3-a4b4-2f54c4c305ab",
                                                "sense_id": "4d6c6679-fe3f-3ee6-bdb8-bb1a306650fd",
                                                "text": "Style de mélodrame."
                                            },
                                            {
                                                "example_id": "0374ccd7-0085-4264-b73d-87dbeb974cdf",
                                                "sense_id": "4d6c6679-fe3f-3ee6-bdb8-bb1a306650fd",
                                                "text": "À tour de rôle, messieurs les amateurs montaient sur une estrade improvisée au fond de la salle, et se posaient, déclamaient, se drapaient dans leurs couvertures avec des souvenirs de mélodrames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3fd9851-fe17-3436-a105-964c4b67a295",
                                        "entry_id": "305371c4-01ee-38bc-9dae-5f276029269f",
                                        "glosses": [
                                            "Ensemble de péripéties dans la vie d'une personne."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
