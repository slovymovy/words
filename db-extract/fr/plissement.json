                "senses": [
                    {
                        "sense_id": "678d61a0-f4df-39c8-831a-a9250cd26776",
                        "entry_id": "0600ca4f-7b74-3d4e-b381-04df22f2bd25",
                        "glosses": [
                            "Action de plisser ; état de ce qui est plissé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6318a1b-0642-423a-8d98-8314fe588519",
                                "sense_id": "678d61a0-f4df-39c8-831a-a9250cd26776",
                                "text": "Le soleil venait de disparaître, et des rayons divergents, semblables à de vastes plissements, partaient du point où il était tombé."
                            },
                            {
                                "example_id": "b849cf7a-fcc9-46f2-8432-8dc7bd67e335",
                                "sense_id": "678d61a0-f4df-39c8-831a-a9250cd26776",
                                "text": "On voit que les trois femmes ont disposé avec soin le drap fraîchement repassé en grands plissements parallèles, presque sculpturaux, étalés sur toute la largeur du lit, et fait bouffer l’oreiller de Madame."
                            },
                            {
                                "example_id": "a0637e5a-3b3b-4d45-9c04-b1a66df9ffce",
                                "sense_id": "678d61a0-f4df-39c8-831a-a9250cd26776",
                                "text": "Le plissement est de hauteur variable en fonction de l’importance du ptosis."
                            }
                        ]
                    },
                    {
                        "sense_id": "573eea4f-9aec-3469-8627-b556f2aea7b3",
                        "entry_id": "0600ca4f-7b74-3d4e-b381-04df22f2bd25",
