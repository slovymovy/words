                        ],
                        "examples": [
                            {
                                "example_id": "1109a3f0-a4c9-4575-b720-abac47c5a887",
                                "sense_id": "39f0d455-c395-37f2-b509-d775b0e52034",
                                "text": "Ma on tu kawał ziemi i lasu, barci swoich pilnuje, rzemiosło sprawia, człowiek spokojny…"
                            },
                            {
                                "example_id": "3fc8775e-5e3c-4cbf-8fe2-9f5671398d2b",
                                "sense_id": "39f0d455-c395-37f2-b509-d775b0e52034",
                                "text": "U góry w dębie spróchniałym widać było dziuplę ogromną, jakby stworzoną na to, aby w niej pszczoły dzikie barci założyły."
                            }
                        ],
