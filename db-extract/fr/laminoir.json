        "fr-extract.jsonl": [
            {
                "entry_id": "30883005-5178-365d-ae5f-3a1898831084",
                "word": "laminoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4080dea-f103-445c-9313-5ac20d4ca4d1",
                        "entry_id": "30883005-5178-365d-ae5f-3a1898831084",
                        "tags": [
                            "plural"
                        ],
                        "form": "laminoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17997231-0035-35fe-9df0-21a99e8eb896",
                        "entry_id": "30883005-5178-365d-ae5f-3a1898831084",
                        "glosses": [
                            "Machine composée de deux cylindres d’acier, entre lesquels on fait passer la matière (pâte ou métal), pour en réduire plus ou moins l’épaisseur, suivant qu’on rapproche plus ou moins les cylindres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8558c62-150d-47fe-87cc-552a34733573",
                                "sense_id": "17997231-0035-35fe-9df0-21a99e8eb896",
                                "text": "Des laminoirs sortaient des barres de fer rouge qui s’allongeaient et se tordaient sur le sol, comme des serpents de feu."
                            },
                            {
                                "example_id": "dfe17dc5-f391-4d75-99b5-9ff62f84036f",
                                "sense_id": "17997231-0035-35fe-9df0-21a99e8eb896",
                                "text": "Par ailleurs se concrétisait progressivement ce projet fou, imaginé à Colombus, de réaliser un laminoir à froid à bande étroite pouvant laminer dix kilomètres de bande à 20 m/s."
                            }
                        ]
                    },
                    {
                        "sense_id": "49de5339-e740-31b4-a5a6-bbb451eaab2e",
                        "entry_id": "30883005-5178-365d-ae5f-3a1898831084",
                        "glosses": [
                            "Atelier dans lequel se trouve cette machine."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "70175726-19b3-4d6b-bc2b-e2ac3da74808",
                                "sense_id": "49de5339-e740-31b4-a5a6-bbb451eaab2e",
                                "text": "L'éclairage électrique est généralement installé assez tard : à Sedan, en 1894, à Mouzon, en 1902 et à Givonne, en 1913 seulement.\nJusqu'à cette date, le laminoir de Givonne est éclairé à l'acétylène que produit un générateur comprenant deux cloches, placées dans un bâtiment séparé. Les 5 becs répandaient, semble-t-il, une clarté suffisante dans le laminoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "9935f86a-f68c-38ee-a1c9-ed6669a03498",
                        "entry_id": "30883005-5178-365d-ae5f-3a1898831084",
                        "glosses": [
                            "Passage de grande largeur, mais de faible hauteur."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "55fde33f-20ae-4add-a734-2d2fa49437c0",
                                "sense_id": "9935f86a-f68c-38ee-a1c9-ed6669a03498",
                                "text": "Une caractéristique essentielle de Hierges, d'ailleurs commune à la plupart des grottes de Karst couvert, est l'important remblayage argileux, réduisant de vastes galeries à l'état de laminoirs très bas où l'on avance à grand-peine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "574d98d8-6240-4b77-9394-b904097e6c84",
                        "source_entry_id": "30883005-5178-365d-ae5f-3a1898831084",
                        "source_sense_description": "Machine",
                        "target_lang_word": "rolling mill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rolling mill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51390e15-779c-343c-8492-65417baa6d04",
                                        "entry_id": "c8646dc9-cdd8-3c96-b4a1-0fc74d117b86",
                                        "glosses": [
                                            "A machine or group of machines for rolling metal (especially steel) into semifinished or finished shapes, such as beams, plate, or sheet; the entire associated plant (e.g., machinery, buildings, railyards)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1371a486-9396-41fe-bce4-feed16e30f9f",
                                                "sense_id": "51390e15-779c-343c-8492-65417baa6d04",
                                                "text": "Besides the usual run of machines, planers, millers, automatics, centre lathes, cranes, etc., there were several power stations, the rolling mills for strip material and for 60 ft. rails, and all the steel furnaces with their complicated systems of flues. If variety is the spice of life, then there was plenty here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eecec079-86f2-3edf-b8e7-984d424e4ccb",
                                        "entry_id": "c8646dc9-cdd8-3c96-b4a1-0fc74d117b86",
                                        "glosses": [
                                            "A roller mill (for grain)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
