                        "glosses": [
                            "Navet (légume) de taille nettement plus petite que les navets ordinaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c81f1fd-47d1-4e1a-83e4-35674b7e3860",
                                "sense_id": "c10f3c62-c73b-3643-8481-0752b57e6888",
                                "text": "Les mini-navets longs ont été les derniers produits à entrer dans la gamme, il y a trois ans."
                            },
                            {
                                "example_id": "fc390cd0-33b4-44ce-bf8a-48e128d37511",
                                "sense_id": "c10f3c62-c73b-3643-8481-0752b57e6888",
                                "text": "Mais la spécialité de l’Armorique maraîchère, une coopérative du Finistère, c’est avant tout le mini : tomate-cerise, artichaut-poivrade, mini-carotte, mini-navet, mini-chou-fleur."
                            },
                            {
                                "example_id": "294a729b-d578-48d0-9995-1e647e6b09c4",
                                "sense_id": "c10f3c62-c73b-3643-8481-0752b57e6888",
                                "text": "Taillez finement en copeaux à la mandoline les asperges, les mini-pâtissons, les mini-navets, les mini-fenouils, les mini-carottes, les fleurs de courgettes, les radis, les mini-betteraves et l’oignon rouge, puis réservez-les dans un saladier d’eau glacée."
                            }
                        ]
                    }
