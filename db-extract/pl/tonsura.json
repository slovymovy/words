                                    },
                                    {
                                        "sense_id": "49c54d12-6506-3bf7-9042-2139b2a89133",
                                        "entry_id": "2c900c0a-2a5b-34be-bbdf-b735d32f7d49",
                                        "glosses": [
                                            "Sección rasurada de la cabeza de un religioso católico, en especial la de forma circular."
                                        ],
                                        "tags": [],
