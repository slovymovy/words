                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3806f18e-72a1-43d9-a285-40f5ebdd82d4",
                                                "sense_id": "d24826df-f5e1-37a5-8e87-dc7c368ab77b",
                                                "text": "Naprawdę, jest mi ciebie szczerze żal z powodu zwolnienia z pracy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "a1afd7cd-f872-3bb4-ab47-435888682824",
