                ],
                "senses": [
                    {
                        "sense_id": "6dad2a86-7b9a-3cd1-b116-21e75e18abe6",
                        "entry_id": "7b4938e0-90fe-3d84-b6c9-8a41e305aa66",
                        "glosses": [
                            "Entwicklung des Embryos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3756a7ed-e4c3-4041-8561-fb636acd97d6",
                                "sense_id": "6dad2a86-7b9a-3cd1-b116-21e75e18abe6",
                                "text": "„Die Embryogenie ist ohne Zweifel von allen Zweigen der Physiologie derjenige, welcher den Arbeiten der neuesten Zeit am meisten verdankt und dessen Aufhellung auch das meiste Licht auf die andern Theile der Physiologie und selbst der Zoologie geworfen hat.“"
                            },
                            {
                                "example_id": "c91fcbd2-28bf-42dc-8df0-8bd2142ac030",
                                "sense_id": "6dad2a86-7b9a-3cd1-b116-21e75e18abe6",
                                "text": "„Alle die, welche über die Embryogenie die sorgfältigsten Untersuchungen angestellt haben, behaupten, dass zu dem Zeitpunkte, wo die einzelnen zum Nervensysteme gehörigen Theile deutlich unterschieden werden können, sich die Höhlen des Gehirnes und des Wirbeleanals mit gleichem Grundstoffe füllen, der aus einer graulich-weissen Flüssigkeit besteht, und woraus sich die verschiedenen Organe der Schädelhöhle sowohl, als die des Wirbelcanales entwickeln.“"
                            },
                            {
                                "example_id": "a229b72a-a10b-4856-bf07-486e02b6b635",
                                "sense_id": "6dad2a86-7b9a-3cd1-b116-21e75e18abe6",
                                "text": "„Die Akademie wünscht daher ein Memoire, in welchem bisherigen Beobachtungen zusammengestellt und neuere Untersuchungen die Embryogenie der Pflanzen angeführt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
