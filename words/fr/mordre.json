            "senses": [
                {
                    "sense_id": "0f83285f-6302-34e1-9a3c-88dee7dc905d",
                    "sense_definition": "Serrer avec les dents de manière à entamer, couper ou blesser.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mordre_dents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit chien aboie fort mais il ne va jamais <w>mordre</w> les invités."
                        },
                        {
                            "text": "Il a pris le fruit mûr et a <w>mordu</w> à pleines dents dedans."
                        }
                    ],
                    "synonyms": [
                        "gnaquer",
                        "niaquer"
                    ],
                    "common_phrases": [
                        "mordre à pleines dents"
                    ]
                },
                {
                    "sense_id": "68d602d5-0839-3d40-b6d6-6593bf235121",
                    "sense_definition": "Saisir l'appât avec la bouche en parlant d'un poisson.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mordre_peche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons passé la matinée au bord du lac sans qu'aucun poisson ne <w>morde</w>."
                        },
                        {
                            "text": "Quand l'eau est calme, les truites finissent toujours par <w>mordre</w> à l'hameçon."
