                        "entry_id": "763ef1e7-afdf-3ff1-be88-ac06b00090d3",
                        "glosses": [
                            "een grappige opmerking,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322f874c-5cb9-49b9-bd9b-4f7d59fc50d3",
                                "sense_id": "1bc64b87-a051-3b5c-87f1-b05a47ccfb7f",
                                "text": "Het antwoord onder zijn kin luidde: “nee, ben Morgan Freeman”. Een geestigheid die zeker op een glimlach mijnerzijds kon rekenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5625e01e-e521-389f-906a-e8c107e1e717",
                        "entry_id": "763ef1e7-afdf-3ff1-be88-ac06b00090d3",
