                        "sense_id": "5fd9c21f-491a-3c29-818b-93a4b8aa8ae6",
                        "entry_id": "50cbb0c3-c135-3abc-bf09-1bb09bfff0f8",
                        "glosses": [
                            "Celui qui hait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ba4ab0-f00a-46d1-8183-d418ab4e6170",
                                "sense_id": "5fd9c21f-491a-3c29-818b-93a4b8aa8ae6",
                                "text": "Donc, l’agitateur positif, rudement armé de réalisme, haïsseur de phrases et d’abstractions, commença à se battre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7ec1749-8d53-4bbf-8c43-1f073da835b5",
                        "source_entry_id": "50cbb0c3-c135-3abc-bf09-1bb09bfff0f8",
                        "source_sense_id": "5fd9c21f-491a-3c29-818b-93a4b8aa8ae6",
                        "target_lang_word": "Hasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd784744-eebf-35ca-908d-abe620d494db",
                                        "entry_id": "024d9c85-adaf-3ad0-be8d-d414497d112f",
                                        "glosses": [
                                            "Person, die eine starke Abneigung gegen etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49bd5b37-db45-4cbd-80fb-f90e863acc61",
                                                "sense_id": "cd784744-eebf-35ca-908d-abe620d494db",
                                                "text": "Lass die Hasser hassen."
                                            },
                                            {
                                                "example_id": "d6fa6514-4af0-4e70-824a-36f5c0f0b64c",
                                                "sense_id": "cd784744-eebf-35ca-908d-abe620d494db",
                                                "text": "Heutzutage gibt es so viel Hasser, seien es Bayern-Hasser, Euro-Hasser, Hunde-Hasser oder Islam-Hasser, einig sind sie sich einzig im Hass."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cce6973-addf-4010-aa5f-3d18d54eb0df",
                        "source_entry_id": "50cbb0c3-c135-3abc-bf09-1bb09bfff0f8",
                        "source_sense_id": "5fd9c21f-491a-3c29-818b-93a4b8aa8ae6",
                        "target_lang_word": "Hasserin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hasserin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9faa0d18-db7a-3701-b395-9c5a5407a1f1",
                                        "entry_id": "e0cb677a-1e99-37b4-87b0-eac2f9c1c813",
                                        "glosses": [
                                            "weibliche Person, die eine starke Abneigung gegen etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee915ea-c765-4591-a957-83c28649b08f",
                                                "sense_id": "9faa0d18-db7a-3701-b395-9c5a5407a1f1",
                                                "text": "Sie war ausgewiesene Hasserin aller Haustiere vom Hamster bis zum Hund."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7af8257-977e-486b-b35c-9303e662922a",
                        "source_entry_id": "50cbb0c3-c135-3abc-bf09-1bb09bfff0f8",
                        "source_sense_id": "5fd9c21f-491a-3c29-818b-93a4b8aa8ae6",
                        "target_lang_word": "hater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0526b284-da6a-3680-ac0e-1cd8a571d898",
                                        "entry_id": "2cd711dd-bc5d-33d1-9691-c8e3843d2e67",
                                        "glosses": [
                                            "One who hates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e79d63-f4e0-47bf-ab80-f22b2634008f",
                                                "sense_id": "0526b284-da6a-3680-ac0e-1cd8a571d898",
                                                "text": "In addition to the basic charge that Christians were atheists was the charge that they were also haters of mankind."
                                            },
                                            {
                                                "example_id": "f885bbdc-cb00-4e4f-b84a-5a6f11bf92c2",
                                                "sense_id": "0526b284-da6a-3680-ac0e-1cd8a571d898",
                                                "text": "My book is not to villainize the villainizers, hate the haters, or to demonize the demonizers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0711e0e-6f4e-3d77-9f4a-a53fd605907c",
                                        "entry_id": "2cd711dd-bc5d-33d1-9691-c8e3843d2e67",
                                        "glosses": [
                                            "One who expresses unfounded or inappropriate hatred or dislike, particularly if motivated by envy."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "732b4e89-fb6b-4332-9107-1ff7bc46730e",
                        "source_entry_id": "50cbb0c3-c135-3abc-bf09-1bb09bfff0f8",
                        "source_sense_id": "5fd9c21f-491a-3c29-818b-93a4b8aa8ae6",
                        "target_lang_word": "ненави́стник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ненави́стник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a19fc3a9-5abe-3944-86ff-e82f5920ef22",
                                        "entry_id": "bdf39e5d-5ba1-3426-883a-72d57603446c",
                                        "glosses": [
                                            "тот, кто преисполнен ненависти, злобы к кому-либо или к чему-либо, ненавидит кого-либо, что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c52b27f3-3af3-41a1-a7a9-4d051e919de3",
                                                "sense_id": "a19fc3a9-5abe-3944-86ff-e82f5920ef22",
                                                "text": "…чего никогда не бывает в ранние периоды экономического развития стран, когда часто встречаются ненавистники науки, знающие только её ветхие отбросы"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24460020-6281-3cf7-b5a3-9d001a66f1c2",
                                        "entry_id": "bdf39e5d-5ba1-3426-883a-72d57603446c",
                                        "glosses": [
                                            "тот, кого ненавидят"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16491245-d5cd-4695-9ccb-9b7701a815bf",
                                                "sense_id": "24460020-6281-3cf7-b5a3-9d001a66f1c2",
                                                "text": "Мало того: он ещё и на «вы» с ней говорит, Лапшин, этот злюка, этот ненавистник, этот задавака!"
                                            },
                                            {
                                                "example_id": "42f834e7-d3c3-496a-ba68-bb2d8c5835f6",
                                                "sense_id": "24460020-6281-3cf7-b5a3-9d001a66f1c2",
                                                "text": "И ни с кем не водился… Ни с кем не разговаривал… Так на конверте и был в одиночестве, вашескородие… Понимал, что ребята вовсе не терпели его и он как какой-нибудь ненавистник всем был…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c39e1926-d6a8-34f5-9793-5f15d3f665ca",
                                        "entry_id": "bdf39e5d-5ba1-3426-883a-72d57603446c",
                                        "glosses": [
                                            "то же, что враг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1513e825-783a-491d-84d5-782ab8fb4f58",
                                                "sense_id": "c39e1926-d6a8-34f5-9793-5f15d3f665ca",
                                                "text": "«Ранний» Рейган, выступавший как ненавистник, враг «империи зла», которой был объявлен Советский Союз, пришёл к власти ― это надо признать ― не без нашей помощи"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
