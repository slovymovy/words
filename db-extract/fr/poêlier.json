                        "entry_id": "967adf5b-aef8-3da7-a655-d370100dda49",
                        "glosses": [
                            "Celui qui fabrique, répare et vend des poêles à frire, des casseroles, etc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "764bb183-e3f2-4714-822e-04ab5eb33f21",
                                "sense_id": "efa58091-c4dd-3aaf-99d7-b175838284f7",
                                "text": "Lesquels objets consistent en établi, étau, enclume, bigorne, forge avec son soufflet, et différens [sic] outils à l'usage de poêlier; poêles en fonte , poêlon en cuivre , brûloires [sic] à café , casseroles , marmites à soupe , cloches à rôtir , cuillers à pot, …."
                            },
                            {
                                "example_id": "afd92c02-1a53-4a69-b11f-98d992089e84",
                                "sense_id": "efa58091-c4dd-3aaf-99d7-b175838284f7",
                                "text": "POÊLIER, s. m. Celui qui fait et vend les ustensiles de ménage compris sous la dénomination de poêlerie."
                            }
                        ]
                    }
