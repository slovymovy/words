                ],
                "senses": [
                    {
                        "sense_id": "acd3c568-4cb0-3203-a965-24f694e7f034",
                        "entry_id": "d69eea85-fddb-3673-9f97-e0c48c4333b6",
                        "glosses": [
                            "czarny z szarym odcieniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a6de5f-0a39-4371-82cd-aefc01a24dd0",
                                "sense_id": "acd3c568-4cb0-3203-a965-24f694e7f034",
                                "text": "Niebo zasnuło się gęstymi, szaroczarnymi chmurami, skrywającymi gwiazdy i księżyc"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "009a7f8c-f513-4fb3-94b9-faac36964e43",
                        "source_entry_id": "d69eea85-fddb-3673-9f97-e0c48c4333b6",
                        "source_sense_id": "acd3c568-4cb0-3203-a965-24f694e7f034",
                        "target_lang_word": "grauschwarz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grauschwarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f127007-6253-32e8-92dc-cfc49795847f",
                                        "entry_id": "283347a7-a984-3457-a873-6813c8a59ddf",
                                        "glosses": [
                                            "in einem gräulichen Schwarzton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bab7cd9-dcd1-4a8f-8217-500c4d5bf0aa",
                                                "sense_id": "5f127007-6253-32e8-92dc-cfc49795847f",
                                                "text": "„Ein feuriger Ball zeigte die Position der sinkenden Sonne an und über das grauschwarze Wasser erstreckte sich ein purpurner Pfad.“"
                                            },
                                            {
                                                "example_id": "9d32b4e7-838b-4d28-a3f5-988bfe7e57a3",
                                                "sense_id": "5f127007-6253-32e8-92dc-cfc49795847f",
                                                "text": "„Das steinerne Portal sah ähnlich aus wie jenes, durch das er in der Oberwelt den langen Gang betreten hatte, nur war es mit grauschwarzem Basalt anstatt mit rotem Sandstein eingefasst.“"
                                            },
                                            {
                                                "example_id": "52ade097-ef83-4917-b8db-d4516bac726c",
                                                "sense_id": "5f127007-6253-32e8-92dc-cfc49795847f",
                                                "text": "„Dann sah ich jedoch, wie sich groß und schwerfällig ein Karren über den Rand des Lochs schob, von seinen Seiten strömte eine grauschwarze Schuttmasse hinab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
