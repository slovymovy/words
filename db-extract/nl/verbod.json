                                "target_senses": [
                                    {
                                        "sense_id": "f52e1b5f-cb0c-3c55-9e40-4e5623441fc2",
                                        "entry_id": "7bfab461-6c07-32a6-8d0d-31ecd584b1ce",
                                        "glosses": [
                                            "strenge Aufforderung, eine Handlung oder Tätigkeit zu unterlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0171f382-b8a3-40e1-b8ae-e86177774853",
                                                "sense_id": "f52e1b5f-cb0c-3c55-9e40-4e5623441fc2",
                                                "text": "Während der Bauarbeiten gilt ein Verbot für Außenstehende, die Baustelle zu betreten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5386d49d-a0e3-3279-8da7-2e70a2138eb4",
                                        "entry_id": "7bfab461-6c07-32a6-8d0d-31ecd584b1ce",
                                        "glosses": [
                                            "Gesetz, das die Ausführung einer bestimmten Tätigkeit oder Handlung unter bestimmten Umständen verbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ac905a-1841-47ab-b248-b06bc903e1ed",
                                                "sense_id": "5386d49d-a0e3-3279-8da7-2e70a2138eb4",
                                                "text": "„Im März 1966 erließ das sowjetische Fischereiministerium ein zehnjähriges Verbot des gewerblichen Fangs von Delphinen im Schwarzen und im Asowschen Meer.“"
                                            },
                                            {
                                                "example_id": "2c5ae607-5912-4408-b55c-a653b88c574f",
                                                "sense_id": "5386d49d-a0e3-3279-8da7-2e70a2138eb4",
                                                "text": "„Litauen tritt als erster Staat weltweit aus dem Abkommen zum Verbot von Streumunition aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13bf80c6-57d9-40b0-93c8-7b4a18743be2",
