                    {
                        "translation_id": "211556a3-7cba-4f88-8eaa-43db4cdb9997",
                        "source_entry_id": "ca16e09c-9e60-37c3-af9a-d6e8122be739",
                        "source_sense_description": "Étiquette à laquelle sont astreints les personnages officiels",
                        "target_lang_word": "Etikette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Etikette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                        "entry_id": "d38e0300-994e-307d-8327-fcc4c947465c",
                                        "glosses": [
                                            "Verhaltensweisen, die bei bestimmten Anlässen beachtet werden sollen, die zwischenmenschliche Konflikte vermeiden helfen sollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b2dc6bc-4fe7-4c27-aed8-89447c5cf61b",
                                                "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                                "text": "Es gehört zur Etikette, zuerst die Frau zu grüßen."
                                            },
                                            {
                                                "example_id": "947013ec-bd6a-43cd-b8e8-c734b63e9a7c",
                                                "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                                "text": "Die Etikette wird im Internet auch Netiquette genannt."
                                            },
                                            {
                                                "example_id": "82bf294c-03b1-42a1-97f9-83898e1a6400",
                                                "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                                "text": "„Und dieser nimmt seinerseits immer weniger Rücksicht auf die diplomatische Etikette.“"
                                            },
                                            {
                                                "example_id": "75d74fd1-a686-4441-a2fe-ae9e0c7d3a7c",
                                                "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                                "text": "„Sogar die Annäherung der Geschlechter gehorcht in den USA einer festgefügten Etikette.“"
                                            },
                                            {
                                                "example_id": "7b487e1e-df87-41ec-9590-7cf2d4552b3c",
                                                "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                                "text": "„Mehr als Geschlechterrollen und Etikette zählt hier Pragmatismus.“"
                                            },
                                            {
                                                "example_id": "76446ab0-fa33-46b0-986b-c7f85e3cedc6",
                                                "sense_id": "4bdc23fc-0d94-35c0-a257-0f74b87b64f3",
                                                "text": "„Ihr gesamtes Werk ist als eine Absetzbewegung von jenen Verkrustungen gesellschaftlicher Etikette zu begreifen, die wie ein Korsett den Freiheitsspielraum von Personen, Frauen insbesondere, einengen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e242e819-c746-37ca-abfc-a1c935ca37f8",
                                        "entry_id": "d38e0300-994e-307d-8327-fcc4c947465c",
                                        "glosses": [
                                            "Nebenform von Etikett"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4c17fa-49bd-427f-9435-2b0ae1eca970",
                                                "sense_id": "e242e819-c746-37ca-abfc-a1c935ca37f8",
                                                "text": "„Deshalb habe ich die Etikette abgelöst, bevor ich die Flasche weggeworfen habe.“"
                                            },
                                            {
                                                "example_id": "c17af22b-7f82-442f-b4bc-3f911e215de8",
                                                "sense_id": "e242e819-c746-37ca-abfc-a1c935ca37f8",
                                                "text": "„Die offene Flasche in die Weinserviette einschlagen, die Etikette muss sichtbar sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
