                                                "example_id": "62106b62-56ff-4996-a9f0-b9d713230b26",
                                                "sense_id": "405f8f07-ac38-3179-9115-2a95e4d5444b",
                                                "text": "Хлеб белый — я такого больше и не видала никогда, гуляш из мяска самолучшего — ох, вкуснота!"
                                            }
