                    },
                    {
                        "translation_id": "b51ccec4-f8b7-45cf-ac6a-93a2c9c5d4ec",
                        "source_entry_id": "7c4edea5-63c2-36e2-97e0-46ea96a4e0b6",
                        "source_sense_id": "edc60e04-773f-3627-a29e-ad97bc3c7d50",
                        "source_sense_description": "Teilgebiet des Pferdesports, bei der die einzelnen Gangarten antrainiert werden",
                        "target_lang_word": "dressage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dressage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e180d8f-1597-36c5-9a6d-63262551034d",
                                        "entry_id": "3682c800-f710-34e4-b8ac-abeb11e43890",
                                        "glosses": [
                                            "Action de dresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc5ee49-16de-40e3-bb35-fc7e4e10d0a0",
                                                "sense_id": "3e180d8f-1597-36c5-9a6d-63262551034d",
                                                "text": "Le dressage d’un fil de fer, d’une barre de fer."
                                            },
                                            {
                                                "example_id": "1a5a2f45-653d-4eb8-ab8e-aac53fa007c8",
                                                "sense_id": "3e180d8f-1597-36c5-9a6d-63262551034d",
                                                "text": "Quand le dressage du fourneau vient à sa fin, il est arrondi avec le plus petit bois, afin que ni la feuille, ni la mousse, ni la terre, avec lesquelles il doit être couvert, & qui doivent faire croûte par-dessus, ne pénètrent point à travers."
                                            },
                                            {
                                                "example_id": "d137f543-1b98-4e25-8156-74c9042bbfdb",
                                                "sense_id": "3e180d8f-1597-36c5-9a6d-63262551034d",
                                                "text": "La cravache ou la gaule est aussi nécessaire pour le travail de la haute école que pour celui du dressage, car elle doit servir à exagérer la puissance de l’écuyer pour stimuler le cheval."
                                            },
                                            {
                                                "example_id": "836c7810-bd41-4eca-9aec-4d355208fbfc",
                                                "sense_id": "3e180d8f-1597-36c5-9a6d-63262551034d",
                                                "text": "Un renouveau de dressage se manifeste aujourd'hui avec la présentation d'animaux dans les zoos et les marinelands."
                                            },
                                            {
                                                "example_id": "3ad4aa19-49a5-44ac-b19a-26eebbd55349",
                                                "sense_id": "3e180d8f-1597-36c5-9a6d-63262551034d",
                                                "text": "Le dressage (des animaux de trait). C’est un ensemble d’apprentissages successifs, basé sur la répétition des ordres et des contraintes… De la qualité du dressage dépend l’efficacité et le rendement au travail des animaux durant toute leur carrière. Un bon dresseur doit être patient, calme et ferme…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d318413e-f2ca-3720-8713-6d42bded8b14",
                                        "entry_id": "3682c800-f710-34e4-b8ac-abeb11e43890",
                                        "glosses": [
                                            "Discipline olympique des sports équestres qui teste la qualité de la communication entre le cheval et son cavalier et recherche des mouvements gracieux du cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0fdf9c-a922-4675-a142-79c37c7e1582",
                                                "sense_id": "d318413e-f2ca-3720-8713-6d42bded8b14",
                                                "text": "Chaque cirque possède, en outre, un maître de manège, appelé chef de piste ou chef d’équitation, qui a la responsabilité de la cavalerie. Écuyer consommé, le dressage en liberté ou en haute école ne doit avoir pour lui aucun secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eecb558-773e-3a8c-b0ae-18538d286b10",
                                        "entry_id": "3682c800-f710-34e4-b8ac-abeb11e43890",
                                        "glosses": [
                                            "Positionnement des éléments d’un plat dans une assiette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca78e273-ad12-478b-8692-cbb676939912",
                                                "sense_id": "7eecb558-773e-3a8c-b0ae-18538d286b10",
                                                "text": "Ne jetez pas la carapace, elle servira pour le dressage."
                                            },
                                            {
                                                "example_id": "14b439c4-3d52-4df8-931b-afc6b2d53bdb",
                                                "sense_id": "7eecb558-773e-3a8c-b0ae-18538d286b10",
                                                "text": "Dressage : déposez une belle quenelle de mousse au chocolat, puis quelques épines-vinettes, les noix du Brésil caramélisées au miso, et le piment d’Espelette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
