                "senses": [
                    {
                        "sense_id": "e778d0f2-7167-3c30-94dc-e96d16c4114c",
                        "entry_id": "df49f8e4-63d3-3629-abfb-5a1d6723d764",
                        "glosses": [
                            "een reis door de lucht die men maakt als proef"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04409072-10a0-468b-944f-a9e0f13bdcd6",
                                "sense_id": "e778d0f2-7167-3c30-94dc-e96d16c4114c",
                                "text": "SpaceX, het ruimtebedrijf van Tesla-topman Elon Musk, lanceerde dinsdag met succes de raket Falcon Heavy, de krachtigste raket die momenteel in gebruik is. Voor de proefvlucht (en bij wijze van promostunt) had de raket de Tesla Roadster van Musk bij zich. De wagen werd de ruimte in gestuurd en moet in een baan rond Mars komen."
                            },
                            {
                                "example_id": "e558ab15-2134-4eda-b7b1-ad0b4648a934",
                                "sense_id": "e778d0f2-7167-3c30-94dc-e96d16c4114c",
                                "text": "De MD-11, vernoemd naar vliegtuigfabrikant McDonnell Douglas, kreeg van haar fans de bijnaam ’elfje’. Het is een driemotorig straalpassagiersvliegtuig voor de lange afstand. Op 10 januari 1990 werd de eerste proefvlucht ermee gemaakt."
                            }
                        ]
                    }
