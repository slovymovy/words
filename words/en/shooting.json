                                "target_lang_sense_clarification": "инцидент с применением оружия"
                            },
                            {
                                "target_lang_word": "перестрелка",
                                "target_lang_sense_clarification": "обмен выстрелами"
                            },
                            {
                                "target_lang_word": "шутинг",
                                "target_lang_sense_clarification": "массовый расстрел"
                            }
                        ]
                    }
                },
                {
