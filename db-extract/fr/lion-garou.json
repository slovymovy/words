                    {
                        "sense_id": "03500cb1-ba5a-36e9-938d-0fc70b63aae7",
                        "entry_id": "e2aafe03-f742-3aa9-ab62-e4c79883b2d3",
                        "glosses": [
                            "Celui qui se transforme d’un être humain en un lion et vice versa, de façon complète ou partielle."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "6453c4b4-2314-494b-b9fc-82c36c64cd90",
                                "sense_id": "03500cb1-ba5a-36e9-938d-0fc70b63aae7",
                                "text": "[…]; en Asie Mineure, dans la légende : le roi lydien Camblès est une sorte de « lion-garou », qui, dans le sommeil, a dévoré sa femme et s’est réveillé homme, mais une main sanglante dans la bouche."
                            },
                            {
                                "example_id": "5ff02469-e1a3-4bbd-99e2-0a7e6e701bda",
                                "sense_id": "03500cb1-ba5a-36e9-938d-0fc70b63aae7",
                                "text": "Yvain serait donc une sorte de lion-garou, qu’il faut prendre ici dans un sens presque figuré."
                            }
                        ]
                    }
                ],
