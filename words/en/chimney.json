{
    "word_family": [
        "chimneypiece",
        "chimneypot",
        "chimneysweep"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba27a2fb-679e-34ea-8790-a27eb02c2ef5",
                    "sense_definition": "A vertical pipe or structure that carries smoke or steam away from a fireplace, furnace, or engine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ventilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick black smoke was pouring out of the brick <w>chimney</w> of the old factory.",
                            "target_lang_translations": {
                                "ru": "Густой черный дым валил из кирпичной <w>трубы</w> старого завода."
                            }
                        },
                        {
                            "text": "They hired a professional to clean the <w>chimney</w> before starting a fire in the fireplace.",
                            "target_lang_translations": {
                                "ru": "Они наняли профессионала, чтобы почистить <w>дымоход</w> перед тем, как разжечь огонь в камине."
                            }
                        }
                    ],
                    "synonyms": [
                        "lum"
                    ],
                    "common_phrases": [
                        "brick chimney",
                        "clean the chimney",
                        "smoke from the chimney"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальная труба или конструкция для отвода дыма или пара от камина, печи или двигателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дымовая труба",
                                "target_lang_sense_clarification": "сооружение для отвода дыма"
                            },
                            {
                                "target_lang_word": "дымоход",
                                "target_lang_sense_clarification": "канал для выхода дыма"
                            },
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "печная или фабричная труба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e3eeff2-7988-3ef8-9922-dc70e9063167",
                    "sense_definition": "A narrow vertical cleft or crack in a rock face or cave passage, large enough for a person to climb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geological_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climber carefully wedged his body inside the steep rock <w>chimney</w> to reach the ledge.",
                            "target_lang_translations": {
                                "ru": "Альпинист осторожно протиснулся внутрь крутой скальной <w>расщелины</w>, чтобы добраться до выступа."
                            }
                        },
                        {
                            "text": "Exploring the deep cave required squeezing through a narrow <w>chimney</w> that led to the lower chamber.",
                            "target_lang_translations": {
                                "ru": "Исследование глубокой пещеры требовало протискивания через узкий <w>проход</w>, который вел в нижнюю камеру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock chimney",
                        "narrow chimney"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая вертикальная расщелина или трещина в скале или пещере, достаточно большая для того, чтобы в неё мог залезть человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщелина",
                                "target_lang_sense_clarification": "узкая вертикальная трещина в скале"
                            },
                            {
                                "target_lang_word": "камин",
                                "target_lang_sense_clarification": "альпинистский термин для вертикальной скальной щели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79555fa1-1dde-3253-9b97-1878b665b5d3",
                    "sense_definition": "The smokestack of a steam locomotive or steamship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ventilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steam locomotive puffed white clouds from its tall iron <w>chimney</w> as it pulled away.",
                            "target_lang_translations": {
                                "ru": "Паровоз выпускал белые клубы дыма из своей высокой железной <w>трубы</w>, трогаясь с места."
                            }
                        },
                        {
                            "text": "Passengers on the deck watched the soot rise from the ship's massive <w>chimney</w>.",
                            "target_lang_translations": {
                                "ru": "Пассажиры на палубе наблюдали, как сажа поднимается из массивной <w>трубы</w> корабля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "locomotive chimney"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дымовая труба паровоза или парохода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "паровозная или судовая труба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d21fd29a-1f9d-3094-901a-4c1d393307ca",
                    "sense_definition": "The glass tube or cylinder surrounding the flame of an oil or kerosene lamp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ventilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully wiped the soot off the glass <w>chimney</w> of the kerosene lamp so it would shine brighter.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно вытерла сажу со стеклянного <w>лампового стекла</w> керосиновой лампы, чтобы она светила ярче."
                            }
                        },
                        {
                            "text": "Be careful not to touch the hot lamp <w>chimney</w> right after blowing out the flame.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны и не трогайте горячее <w>стекло</w> лампы сразу после того, как задуете пламя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lamp chimney",
                        "glass chimney"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стеклянная трубка или цилиндр, окружающий пламя масляной или керосиновой лампы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ламповое стекло",
                                "target_lang_sense_clarification": "стекло для керосиновой лампы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec9d57d6-2888-30b0-a3c7-cd04a4a4cc8c",
                    "sense_definition": "A black eye; a shiner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "injuries",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked into the bar with a nasty <w>chimney</w> after getting into a fight the night before.",
                            "target_lang_translations": {
                                "ru": "Он зашел в бар с ужасным <w>фингалом</w> после драки, произошедшей накануне вечером."
                            }
                        },
                        {
                            "text": "She tried to cover up her swollen <w>chimney</w> with heavy makeup before going to work.",
                            "target_lang_translations": {
                                "ru": "Она попыталась скрыть свой опухший <w>синяк</w> плотным макияжем перед тем, как пойти на работу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slang term for a black eye"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Синяк под глазом (разговорный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синяк под глазом",
                                "target_lang_sense_clarification": "разговорное обозначение фингала"
                            },
                            {
                                "target_lang_word": "фингал",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c6fd38c-6811-322a-8687-cb33c7b0c6a4",
                    "sense_definition": "A slang term referring to the vagina.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crude joke made a vulgar reference to a woman's <w>chimney</w>.",
                            "target_lang_translations": {
                                "ru": "В грубой шутке содержался пошлый намек на женское <w>лоно</w>."
                            }
                        },
                        {
                            "text": "He used an old-fashioned slang term, referring to the female anatomy as a <w>chimney</w>.",
                            "target_lang_translations": {
                                "ru": "Он использовал старомодное сленговое выражение, назвав женскую анатомию <w>трубой</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вульгарное сленговое обозначение влагалища."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c582eb7-bb8e-381d-b3d1-6f2dc2d886b5",
                    "sense_definition": "To climb or negotiate a narrow vertical rock cleft by pressing one's back, feet, and hands against the opposing walls.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountaineers had to <w>chimney</w> up the narrow crevice to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Альпинистам пришлось <w>подниматься по расщелине</w>, чтобы достичь вершины."
                            }
                        },
                        {
                            "text": "It is exhausting to <w>chimney</w> through such a tight passage with a heavy backpack.",
                            "target_lang_translations": {
                                "ru": "Очень изнурительно <w>протискиваться</w> через такой узкий проход с тяжелым рюкзаком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chimney up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься по узкой вертикальной расщелине в скале, упираясь спиной, ногами и руками в противоположные стены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься по расщелине",
                                "target_lang_sense_clarification": "способ лазания в альпинизме"
                            },
                            {
                                "target_lang_word": "лезть камином",
                                "target_lang_sense_clarification": "альпинистский жаргон"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}