                                    {
                                        "sense_id": "ea6d7e19-bc08-3a3f-b12a-9f039fe32f50",
                                        "entry_id": "73c9cc27-1b8c-3a2b-8c93-1000572e1ffa",
                                        "glosses": [
                                            "een elementair deeltje dat niet uit quarks is samengesteld"
                                        ],
