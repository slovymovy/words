                        "glosses": [
                            "A certain form of song or dance popular in Elizabethan times."
                        ],
                        "tags": [
                            "historical",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6d7cbb09-fc77-4381-bfb9-8f7401680ed7",
                                "sense_id": "e25b9852-ed00-3ff4-8b87-19aa0818ca66",
                                "text": "At last Ferdinando taking into his hand a Lute that lay on his Mistresse bed, did vnto the note of the Venetian galliard apply the Italian dittie[…]but his Mistres could not be quiet vntill she heard hym repeat the Tinternell which he vsed ouer night[…]"
                            },
                            {
                                "example_id": "4d747352-5c5e-46a6-8b16-6547dceb1142",
                                "sense_id": "e25b9852-ed00-3ff4-8b87-19aa0818ca66",
                                "text": "And I, a loitering shadow,\nWith other shadows dwell,\nTwirling like string-tied puppet\nIn aimless tinternel."
                            },
                            {
                                "example_id": "8319ae6c-3e55-4c90-8b6a-eefdf1225ad6",
                                "sense_id": "e25b9852-ed00-3ff4-8b87-19aa0818ca66",
                                "text": "[…]herself, in a grown-up lady's dress at age 3, solemnly dancing the steps of a Tinternell[…]"
                            },
                            {
                                "example_id": "c41f412c-abe2-496e-9a7c-328dc99a22a1",
                                "sense_id": "e25b9852-ed00-3ff4-8b87-19aa0818ca66",
                                "text": "Whether it was the stately tinternell or the exuberant jig, dancing was considered a healthy recreation for the mind and exercise for the body during the Elizabethan era."
                            }
                        ]
                    }
