                        "sense_id": "9149ecfc-33f8-347f-be64-77284d813975",
                        "entry_id": "f556c1a2-4b81-311d-984a-c05aeca980b3",
                        "glosses": [
                            "niet langer; in het verleden geweest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f8b513-6c2c-4e2e-962b-8679c8baefdd",
                                "sense_id": "9149ecfc-33f8-347f-be64-77284d813975",
                                "text": "Hij had een vraaggesprek met de voormalige premier."
                            },
                            {
                                "example_id": "b994a29a-942c-47a9-b3a4-ff45c5cb0c39",
                                "sense_id": "9149ecfc-33f8-347f-be64-77284d813975",
                                "text": "Daar ligt hij dan, Boris Nikolajevitsj Jeltsin, opgebaard in een open kist, gewikkeld in het wit-rood-blauw van de Russische vlag. \"De Russische beer is dood\", zegt Michail Strigin, treurend over de voormalige leider van het land."
                            },
                            {
                                "example_id": "a209a013-6afd-45c7-a5ec-6aa79c58eab4",
                                "sense_id": "9149ecfc-33f8-347f-be64-77284d813975",
                                "text": "Hij pakte hem op en bekeek de man, ongetwijfeld haar voormalige."
                            }
                        ]
                    }
