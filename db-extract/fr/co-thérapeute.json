                        "glosses": [
                            "Thérapeute exerçant une thérapie avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "122a6b19-ad80-413a-947c-e21f4713a02b",
                                "sense_id": "4ac789cc-6cf6-3b0b-8b4e-4504eea07c5f",
                                "text": "Le choix des co-thérapeutes pour faire jouer la scène proposée par lui peut donner au patient l’impression d’être en position active de « metteur en scène »."
                            },
                            {
                                "example_id": "b60cf91e-f0fc-4c4b-98d9-10ec280bad2a",
                                "sense_id": "4ac789cc-6cf6-3b0b-8b4e-4504eea07c5f",
                                "text": "Les co-thérapeutes deviennent alors plus sensibles aux initiatives prises par les familles, ce qui permet à la thérapie familiale d’exercer la fonction structurante dont elle avait besoin."
                            },
                            {
                                "example_id": "4cda6e06-dd27-42ea-8f8b-f4d1d0d8fb1a",
                                "sense_id": "4ac789cc-6cf6-3b0b-8b4e-4504eea07c5f",
                                "text": "Les co-thérapeutes utilisent leurs expériences personnelles dans la relation thérapeutique."
                            }
                        ]
                    }
