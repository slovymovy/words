                                "example_id": "37edc6ed-6012-4691-b256-44f6a402e7b1",
                                "sense_id": "fb8c777a-d685-300a-b002-e3c63e161ac5",
                                "text": "L’asaret d’Europe."
                            },
                            {
                                "example_id": "5404a28b-024a-43fa-9323-7ca22b206509",
                                "sense_id": "fb8c777a-d685-300a-b002-e3c63e161ac5",
                                "text": "Aristolochiacées « Asaret » dérive d’asarum qui désignait en latin, et en grec asaron, une plante sauvage, peut-être notre espèce, l’asaret d’Europe (Asarum europaeum)."
                            },
                            {
                                "example_id": "1dfd6f6e-c9b8-49c1-9fa5-523c02b0c7f4",
                                "sense_id": "fb8c777a-d685-300a-b002-e3c63e161ac5",
                                "text": "Dans la forêt nouvelle a fleuri l’orchidée, Qui, çà et là, s’emmêle à l’asaret."
                            }
                        ]
                    }
