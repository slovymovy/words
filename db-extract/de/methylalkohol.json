                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf12dd29-0a81-4c67-b8a5-b8e6786f4d55",
                        "source_entry_id": "37068b6b-d858-3a36-aac9-012bc1d6eed3",
                        "source_sense_id": "35edc2ae-3544-33c5-9733-9473ca028c41",
                        "source_sense_description": "Chemie: Synonym von Methanol",
                        "target_lang_word": "alcool méthylique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcool méthylique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d00c249-72a2-3738-8cb4-980304732530",
                                        "entry_id": "15796587-c3b5-3677-af10-21312a90c5b6",
                                        "glosses": [
                                            "Méthanol."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "294d9f06-3058-482c-9b04-4ae51f1ba10f",
                                                "sense_id": "6d00c249-72a2-3738-8cb4-980304732530",
                                                "text": "L’action insecticide du mélange précédent devient beaucoup plus énergique lorsqu’on y ajoute, ainsi que M. Henneguy en a eu l’idée, une certaine quantité d’alcool méthylique ou esprit de bois qui dissout une partie de l’huile lourde."
                                            },
                                            {
                                                "example_id": "1cea2fb9-a59a-4154-a8f1-1ba0913b3b52",
                                                "sense_id": "6d00c249-72a2-3738-8cb4-980304732530",
                                                "text": "Nous en étions donc toujours réduit à cette triste nécessité : l’emploi du méthylène à dose massive qu’imposait là Régie s’en tenant aux vieux errements, c’est-à-dire que nous étions obligés d’ajouter 10 d’alcool méthylique à 100 d’alcool éthylique ordinaire pour arriver à en obtenir la dénaturation."
                                            },
                                            {
                                                "example_id": "db5efae7-7201-4945-bf78-6359903093c7",
                                                "sense_id": "6d00c249-72a2-3738-8cb4-980304732530",
                                                "text": "L’alcool méthylique, du fait de son indétonance, paraît devoir trouver un placement facile et rémunérateur."
                                            },
                                            {
                                                "example_id": "a2cdc6a3-ce21-46fe-aff0-be71b5ea71fc",
                                                "sense_id": "6d00c249-72a2-3738-8cb4-980304732530",
                                                "text": "Pour augmenter leurs marges, ces derniers remplacent, par exemple, l’éthanol par de l’alcool méthylique, un produit trois fois moins cher utilisé, entre autres, comme liquide de refroidissement dans l’industrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
