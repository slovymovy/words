                "senses": [
                    {
                        "sense_id": "a1fb0145-0b8b-3eca-a865-707608a9d45f",
                        "entry_id": "2675acff-40d0-3fd3-8bd8-f896fdc53615",
                        "glosses": [
                            "Veränderung einer Frau oder eines anderen weiblichen Lebewesens hin zu stärker männlichen Eigenschaften, sei es im Erscheinungsbild, im Verhalten oder in körperlicher Hinsicht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "481c355c-1e0b-3fec-bfc7-70f4f5a2877b",
                        "entry_id": "2675acff-40d0-3fd3-8bd8-f896fdc53615",
                        "glosses": [
                            "Zunahme der Zahl von Männern in einem Arbeits- oder sonstigen Lebensbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab150f0-692f-4494-900e-9f13bb8f49ea",
                                "sense_id": "481c355c-1e0b-3fec-bfc7-70f4f5a2877b",
                                "text": "„Wie Angelika Wetterer (2002) anhand der Medizin und Krankenpflege herausarbeitete, hängen wachsende Frauenanteile (Feminisierung) häufig mit De-Professionalisierung, Abwertung und Prekarisierung eines Berufsfeldes zusammen, während steigende Männeranteile (Maskulinisierung) zu einer gesellschaftlichen Aufwertung von Arbeitstätigkeiten und Professionalisierung des Berufsfeldes führt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
