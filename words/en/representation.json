{
    "word_family": [
        "represent",
        "representative",
        "misrepresentation",
        "representational",
        "underrepresentation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c36a627-18f1-3bdd-b642-b876da22b682",
                    "sense_definition": "A person, image, model, or object that stands for, symbolizes, or depicts something else.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "symbol_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue serves as a symbolic <w>representation</w> of freedom and justice.",
                            "target_lang_translations": {
                                "ru": "Статуя служит символическим <w>изображением</w> свободы и справедливости.",
                                "zh": "这座雕像象征着自由与正义，是其<w>表现</w>。"
                            }
                        },
                        {
                            "text": "This map is a visual <w>representation</w> of the city's subway system.",
                            "target_lang_translations": {
                                "ru": "Эта карта является визуальным <w>отображением</w> системы метро города.",
                                "zh": "这张地图是该市地铁系统的视觉<w>呈现</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "likeness"
                    ],
                    "common_phrases": [
                        "visual representation",
                        "symbolic representation",
                        "accurate representation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, изображение, модель или объект, который символизирует или изображает что-то другое.",
                        "zh": "指代、象征或描绘某事物的个人、图像、模型或对象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображение",
                                "target_lang_sense_clarification": "картина, образ или подобие"
                            },
                            {
                                "target_lang_word": "отображение",
                                "target_lang_sense_clarification": "визуализация данных или модели"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "символический образ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表现",
                                "target_lang_sense_clarification": "事物呈现出的形式或样子"
                            },
                            {
                                "target_lang_word": "描绘",
                                "target_lang_sense_clarification": "对某事物的具体刻画或描述"
                            },
                            {
                                "target_lang_word": "象征",
                                "target_lang_sense_clarification": "代表某种意义的符号或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72599b89-3a76-3088-a630-842edff46616",
                    "sense_definition": "The state of having someone to speak, vote, or act on your behalf, especially in a government or official organization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "acting_on_behalf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens demanded better <w>representation</w> in the local council.",
                            "target_lang_translations": {
                                "ru": "Граждане требовали лучшего <w>представительства</w> в местном совете.",
                                "zh": "市民们要求在地方议会中获得更好的<w>代表权</w>。"
                            }
                        },
                        {
                            "text": "The union ensures fair <w>representation</w> for all workers during contract negotiations.",
                            "target_lang_translations": {
                                "ru": "Профсоюз обеспечивает справедливое <w>представительство</w> всех работников во время переговоров по контракту.",
                                "zh": "工会在合同谈判期间确保所有工人都能得到公平的<w>代表</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "political representation",
                        "proportional representation",
                        "lack of representation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, когда кто-то говорит, голосует или действует от вашего имени, особенно в правительстве или официальной организации.",
                        "zh": "指在政府或官方组织中，有人员代表其发言、投票或行事的状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представительство",
                                "target_lang_sense_clarification": "наличие представителей в органах власти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代表权",
                                "target_lang_sense_clarification": "拥有被代表的权利或地位"
                            },
                            {
                                "target_lang_word": "代表性",
                                "target_lang_sense_clarification": "在群体中被代表的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b519251-c48d-320e-9e68-8de56c842767",
                    "sense_definition": "The way that a particular group of people is portrayed or described in media, such as films, books, or news.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_portrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film was praised for its positive <w>representation</w> of minority groups.",
                            "target_lang_translations": {
                                "ru": "Фильм хвалили за позитивное <w>изображение</w> меньшинств.",
                                "zh": "这部电影因其对少数群体的积极<w>刻画</w>而受到赞扬。"
                            }
                        },
                        {
                            "text": "Critics argued that the <w>representation</w> of women in the novel was outdated.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что <w>изображение</w> женщин в романе устарело.",
                                "zh": "评论家认为小说中对女性的<w>呈现</w>已经过时了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "media representation",
                        "diverse representation"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, как определенная группа людей изображается или описывается в медиа, фильмах или книгах.",
                        "zh": "在电影、书籍或新闻等媒体中，对特定人群的刻画或描述方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображение",
                                "target_lang_sense_clarification": "показ в средствах массовой информации"
                            },
                            {
                                "target_lang_word": "репрезентация",
                                "target_lang_sense_clarification": "социологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呈现",
                                "target_lang_sense_clarification": "媒体对某群体的展示方式"
                            },
                            {
                                "target_lang_word": "刻画",
                                "target_lang_sense_clarification": "对人物或群体形象的塑造"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2c09aa1-3a76-3f74-98da-4a54d92c6a6d",
                    "sense_definition": "The service provided by a lawyer or legal team acting for a client in a court case.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acting_on_behalf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not afford private legal <w>representation</w> for the trial.",
                            "target_lang_translations": {
                                "ru": "Он не мог позволить себе частное юридическое <w>представительство</w> на судебном процессе.",
                                "zh": "他负担不起审判所需的私人法律<w>代理</w>。"
                            }
                        },
                        {
                            "text": "Every defendant has the right to competent <w>representation</w> in court.",
                            "target_lang_translations": {
                                "ru": "Каждый обвиняемый имеет право на компетентное <w>представительство</w> в суде.",
                                "zh": "每位被告都有权在法庭上获得称职的法律<w>辩护</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal representation",
                        "afford representation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Услуга, предоставляемая юристом или юридической командой, действующей в интересах клиента в судебном деле.",
                        "zh": "律师或法律团队在法庭案件中为客户提供的代理服务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представительство",
                                "target_lang_sense_clarification": "юридическая защита интересов"
                            },
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "в суде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代理",
                                "target_lang_sense_clarification": "法律上的委托与代表"
                            },
                            {
                                "target_lang_word": "辩护",
                                "target_lang_sense_clarification": "在法庭上为当事人提供的法律支持"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc64e627-a345-36fb-bd2c-f1ec6a740f34",
                    "sense_definition": "A formal statement, complaint, or account of facts made to an authority to express an opinion or influence a decision.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "formal_statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassador made <w>representations</w> to the government regarding the new trade policy.",
                            "target_lang_translations": {
                                "ru": "Посол сделал <w>представления</w> правительству относительно новой торговой политики.",
                                "zh": "大使就新的贸易政策向政府提出了正式<w>交涉</w>。"
                            }
                        },
                        {
                            "text": "He was accused of making false <w>representations</w> on his application form.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в предоставлении ложных <w>сведений</w> в анкете.",
                                "zh": "他被指控在申请表上作了虚假<w>陈述</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make representations",
                        "false representation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление, жалоба или изложение фактов, сделанное властям для выражения мнения или влияния на решение.",
                        "zh": "向权威机构提交的正式声明、投诉或事实陈述，旨在表达意见或影响决策。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное сообщение фактов"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "дипломатический или официальный акт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陈述",
                                "target_lang_sense_clarification": "正式的事实说明"
                            },
                            {
                                "target_lang_word": "交涉",
                                "target_lang_sense_clarification": "为达成目的而进行的正式沟通"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10510c04-b3b3-3738-91a6-36be4fda6293",
                    "sense_definition": "A way of mapping abstract algebraic structures onto linear transformations of vector spaces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the theory of group <w>representation</w> to the advanced algebra class.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил теорию <w>представления</w> групп классу углубленной алгебры.",
                                "zh": "教授向高等代数班讲解了群<w>表示</w>理论。"
                            }
                        },
                        {
                            "text": "This matrix provides a faithful <w>representation</w> of the geometric rotation.",
                            "target_lang_translations": {
                                "ru": "Эта матрица обеспечивает точное <w>представление</w> геометрического вращения.",
                                "zh": "这个矩阵准确地<w>表示</w>了几何旋转。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ отображения абстрактных алгебраических структур в линейные преобразования векторных пространств.",
                        "zh": "将抽象代数结构映射到向量空间的线性变换的一种方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表示",
                                "target_lang_sense_clarification": "数学中的群表示论"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}