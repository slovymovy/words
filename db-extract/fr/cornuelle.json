                        "glosses": [
                            "Nom, dans la Nièvre, de la châtaigne d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70a522b-40c6-4711-b709-32988a886f47",
                                "sense_id": "cf4712bb-b33a-3524-98c1-1e978490b68e",
                                "text": "Je n’ai plus de nouvelles de St-Sauveur et je ne compte plus sur les cornuelles, d’ailleurs comme je te l’ai dit la saison est terminée et les plus belles cornuelles sont tombées au fond des étangs."
                            }
