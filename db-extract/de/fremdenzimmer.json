                        "examples": [
                            {
                                "example_id": "895c61c7-18d6-4c4e-96da-cf32be009800",
                                "sense_id": "9eb62557-a0a9-3790-880f-6e27fc943a0f",
                                "text": "Man hatte mir rasch erzählt, daß er viel gelitten habe: es war nichts davon zu sehen. Seine Züge waren aufgeräumt wie die Möbel in einem Fremdenzimmer, aus dem jemand abgereist war. Mir war zumute, als hätte ich ihn schon öfter tot gesehen: so gut kannte ich das alles.",
                                "translation": "The Notebooks of Malte Laurids Brigge",
                                "english": "The Notebooks of Malte Laurids Brigge"
                            }
                        ]
                    }
