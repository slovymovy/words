                                    {
                                        "sense_id": "b9d0925c-c000-32de-a25a-505933a32e39",
                                        "entry_id": "a98086f0-149d-3e80-a11f-a716fd1cd47e",
                                        "glosses": [
                                            "Ablation chirurgicale de la rate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940bbade-5495-41e3-bc96-88d61094fd24",
                                                "sense_id": "b9d0925c-c000-32de-a25a-505933a32e39",
                                                "text": "L’incision de la splénectomie mesurait près de trente centimètres, sur toute la hauteur de son ventre, maintenue par de larges agrafes en acier."
                                            },
                                            {
                                                "example_id": "cea9dba9-2e2e-40e1-b02d-10880ad21213",
                                                "sense_id": "b9d0925c-c000-32de-a25a-505933a32e39",
                                                "text": "— […] Vous avez souffert d’une rupture de la rate, probablement – et heureusement – retardée, parce que votre cavité abdominale présentait les signes d’un début d’hémorragie. Mes collègues ont dû procéder d’urgence à une splénectomie. Si la rupture s’était produite plus tôt, vous seriez mort."
                                            }
                                        ]
                                    }
                                ]
                            }
