                },
                {
                    "sense_id": "4d3342c4-15c3-3b8b-bbc8-0ebf3ef65aa9",
                    "sense_definition": "A single layer or sheet of a material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We upholstered the seat with three <w>thicknesses</w> of cloth to make it more comfortable.",
                            "target_lang_translations": {
