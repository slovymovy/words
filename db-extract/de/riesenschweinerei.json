                "senses": [
                    {
                        "sense_id": "9308a418-28ea-3d68-b13f-8893ce9651b2",
                        "entry_id": "11291517-87ce-3253-8fa2-041ff538d6d1",
                        "glosses": [
                            "etwas, das in sehr verdrecktem Zustand ist, extrem schmutzige Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da47c9d1-3f61-4d1c-8d1f-c3c5a2fd342f",
                                "sense_id": "9308a418-28ea-3d68-b13f-8893ce9651b2",
                                "text": "„Die Operation versprach eine Riesenschweinerei zu werden, weil es den ganzen Tag immer wieder geregnet hatte.“"
                            },
                            {
                                "example_id": "f6cf2260-3264-4f3c-a5fe-e206e17dea44",
                                "sense_id": "9308a418-28ea-3d68-b13f-8893ce9651b2",
                                "text": "„Sie drückt ein wenig fester zu, und diesmal muss ich meine Arschmuskeln zusammenkneifen, um eine Riesenschweinerei zu verhindern.“"
                            },
                            {
                                "example_id": "0639f1c5-ed3d-496d-a817-ae698ab23e3c",
                                "sense_id": "9308a418-28ea-3d68-b13f-8893ce9651b2",
                                "text": "„Court war es ein Rätsel, warum sie ihn bislang nicht zurückgerufen hatte, und insgeheim war er froh, nichts mit dem zu tun zu haben, was sie offenbar davon abgehalten hatte - es musste irgendeine Riesenschweinerei sein, wenn es für sie Vorrang hatte gegenüber einem Massaker an mehreren CIA-Agenten.“"
                            },
                            {
                                "example_id": "0f242704-4403-41cc-8eef-c24cce1bb3df",
                                "sense_id": "9308a418-28ea-3d68-b13f-8893ce9651b2",
                                "text": "„Niemand behauptet, welche von hier hätten die Schweinerei veranstaltet. Diese Riesenschweinerei.“"
                            }
                        ],
