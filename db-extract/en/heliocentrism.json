                    {
                        "translation_id": "562f0294-63fe-4116-baf0-6a042a9c9b38",
                        "source_entry_id": "5d0c13c6-21ba-3f53-96d8-cfc15d6b462d",
                        "source_sense_description": "the theory that the sun is the center of the universe",
                        "target_lang_word": "ηλιοκεντρισμός",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
