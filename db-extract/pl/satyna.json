                                    {
                                        "sense_id": "b49abd96-0144-3c70-a4ec-ad757b5e1945",
                                        "entry_id": "92a0d55f-1a33-3193-98fc-1538d86a18f4",
                                        "glosses": [
                                            "A type of cotton cloth with a shiny surface and dull back, woven using the technique that, when applied to silk or nylon, results in cloth called satin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3ffa5a-9bb5-486f-addf-43875e5fa121",
                                                "sense_id": "b49abd96-0144-3c70-a4ec-ad757b5e1945",
                                                "text": "The elaboration of her sateen costume (somewhat dirty and torn now) showed that she was an optimate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7b9637e-829a-4b95-974b-fc57d5a4ab45",
                        "source_entry_id": "13c56cb8-b5d9-3dbe-86fe-96a15f8c638d",
                        "source_sense_id": "850cf075-8558-3a14-b6e8-40f0dc3bd2b2",
                        "target_lang_word": "satin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc5d345-32ad-36a4-97e4-e749f9779699",
                                        "entry_id": "e9470530-fe64-3113-a975-7c67679efd96",
                                        "glosses": [
                                            "A cloth woven from silk, nylon or polyester with a glossy surface and a dull back. (The same weaving technique applied to cotton produces cloth termed sateen)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9623a1b-2887-4b0e-8263-0fbe1ddb1980",
                                                "sense_id": "8cc5d345-32ad-36a4-97e4-e749f9779699",
                                                "text": "Ibn Batuta informs us that a rich silk texture made here was called Zaitûniya; and there can be little doubt that this is the real origin of our word Satin,—Zettani in mediæval Italian, Aceytuni in Spanish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "208bfb82-d577-33c8-b680-61ddf9dc82c5",
                                        "entry_id": "e9470530-fe64-3113-a975-7c67679efd96",
                                        "glosses": [
                                            "Gin (the drink)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bcf2b34-d52f-4f77-b7f1-683881ddf206",
                                                "sense_id": "208bfb82-d577-33c8-b680-61ddf9dc82c5",
                                                "text": "'This poor gal was robbed, barely left a stitch, that and the drink... mind, I likes a drop of satin – wot you'd call gin – myself. I'll say nothing against it. She ended thrown out of an upstairs winder.'"
                                            }
                                        ]
                                    }
                                ]
                            },
