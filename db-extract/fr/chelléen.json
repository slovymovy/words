                "senses": [
                    {
                        "sense_id": "3a559968-ad87-307c-9475-39c5327398db",
                        "entry_id": "c98d686b-15c6-36f9-ad33-3470237bc3f3",
                        "glosses": [
                            "Relatif à la période du Chelléen (Paléolithique inférieur) ou à l’industrie lithique qui la caractérise."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5d35bac8-80ad-4c2b-9eda-18b2d113c9e6",
                                "sense_id": "3a559968-ad87-307c-9475-39c5327398db",
                                "text": "Une grande objection contre l’instrument chelléen, c'est qu’il est trop complexe pour être un instrument primitif ! C’est une illusion qui s’évanouit devant un peu de réflexion. Il est au contraire tout simple et tout naturel que l’instrument chelléen ait été le début de l’industrie humaine."
                            }
                        ]
                    }
                ],
                "translations": [],
