                "senses": [
                    {
                        "sense_id": "639aa610-a794-3d52-b365-4312e4c7e349",
                        "entry_id": "e955660a-1b5e-3fb4-8df7-c22a514aadf3",
                        "glosses": [
                            "Art, wie man im Alltag miteinander redet"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "cd5f600c-9b4a-46ff-96c4-398e36efa4e1",
                                "sense_id": "639aa610-a794-3d52-b365-4312e4c7e349",
                                "text": "Der Umgangston in der Bundestagsdebatte ließ den nötigen Respekt vermissen."
                            },
                            {
                                "example_id": "00e837ac-b5e9-4371-a04e-0421f4bed316",
                                "sense_id": "639aa610-a794-3d52-b365-4312e4c7e349",
                                "text": "„Er befleißigte sich ja einer gewissen generations-konformen Rüdheit des Umgangstons, aber wo es um eine Blessur, ein Halsweh, ein Kopfweh, ein Wehwehchen ging, nahm er, Krieger hin, Krieger her, solch ein Körper-Ereignis bitter ernst.“"
                            },
                            {
                                "example_id": "592c1fba-06b1-405b-9174-8355f82d5791",
                                "sense_id": "639aa610-a794-3d52-b365-4312e4c7e349",
                                "text": "„Das Essen war gut ohne Üppigkeit, der Umgangston gepflegt, das Gespräch anständig und gemessen unter Ausschluß doppeldeutiger Worte, die auf Liebschaften anspielten oder vielleicht daran denken ließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
