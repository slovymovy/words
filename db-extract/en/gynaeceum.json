    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                "word": "gynaeceum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e4f1278-3363-4887-b67d-ac12ed070c9a",
                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                        "tags": [
                            "plural"
                        ],
                        "form": "gynaeceums"
                    },
                    {
                        "form_id": "9e16b96b-0e19-499f-a224-1709184fd92a",
                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                        "tags": [
                            "plural"
                        ],
                        "form": "gynaecea"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                        "glosses": [
                            "The women's quarters in a household; (hence, loosely) any building or area for women."
                        ],
                        "tags": [
                            "Ancient-Rome"
                        ],
                        "examples": [
                            {
                                "example_id": "7f4057d0-33a2-4d3f-acbc-09d7dc655543",
                                "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                "text": "A master, however this may be, was very jealous of the inmates of his gyneceum, and he permitted no one to enter the place, which was protected as a sanctuary in the legislation of the Barbarians."
                            },
                            {
                                "example_id": "0307cbb5-a9bb-4586-a40f-56b6675b606c",
                                "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                "text": "It was agreeable to see men, after days in this gyneceum, bringing the place to life, to see waiters speeding to their command."
                            }
                        ]
                    },
                    {
                        "sense_id": "2951de84-1689-372a-9d23-dc3b1b31d36a",
                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                        "glosses": [
                            "An establishment in Rome where female workers made clothing and furniture for royalty."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b1c768cd-f901-37fe-b017-d400554b733f",
                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                        "glosses": [
                            "A gynoecium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df559b8d-2767-4465-be31-b6b874eaca1f",
                                "sense_id": "b1c768cd-f901-37fe-b017-d400554b733f",
                                "text": "The androecium functions by providing the pollen-grains which are necessary to bring about fertilisation of the ovules in the gynaeceum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1dbee27-7678-43f5-9f69-ba3c0b5ab282",
                        "source_entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                        "source_sense_description": "women's quarters in a household",
                        "target_lang_word": "gynécée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gynécée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "742fe3e2-b0f1-3d88-ba0d-068a931c32a4",
                                        "entry_id": "490d3523-1ff5-33ca-b95b-05c83a1191db",
                                        "glosses": [
                                            "Appartement réservé aux femmes chez les Grecs."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f3dfd72-88b8-4a9a-abcf-cc9e19581c22",
                                                "sense_id": "742fe3e2-b0f1-3d88-ba0d-068a931c32a4",
                                                "text": "[…] toujours et partout, la femme, subordonnée à l’homme, avait été enfermée dans la maison, dans le gynécée."
                                            },
                                            {
                                                "example_id": "a9ebb716-bb8e-4126-90ce-70f41d999405",
                                                "sense_id": "742fe3e2-b0f1-3d88-ba0d-068a931c32a4",
                                                "text": "À cet égard je serais presque tenté de recommander à nouveau les gynécées, si toutefois de son côté cette contrainte n’avait pas d’effet nuisible."
                                            },
                                            {
                                                "example_id": "b6630410-657d-477b-a2a3-bd6bb2d30b79",
                                                "sense_id": "742fe3e2-b0f1-3d88-ba0d-068a931c32a4",
                                                "text": "Enfermées dans le terem, gynécée tatar ou byzantin, les tsarines et les tsarevnas laissaient les tsars à la grossièreté de leur sexe."
                                            },
                                            {
                                                "example_id": "e256e2cd-1e1a-4cc7-9cb9-fe9be8c107b1",
                                                "sense_id": "742fe3e2-b0f1-3d88-ba0d-068a931c32a4",
                                                "text": "Pendant son bref séjour là-bas, il avait appris une dizaine de jurons russes et les éructait au milieu du gynécée où s’affairaient les ouvrières françaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44485d38-b93b-3c22-a126-3e1c90578168",
                                        "entry_id": "490d3523-1ff5-33ca-b95b-05c83a1191db",
                                        "glosses": [
                                            "Ensemble des organes reproducteurs femelles d’une fleur, formés par un ou plusieurs carpelles, souvent désignés sous le nom de pistil."
                                        ],
                                        "tags": [
                                            "Biologie végétale",
                                            "Anatomie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34ef6d4b-4a11-4ce3-9b9c-4f5473443fda",
                                                "sense_id": "44485d38-b93b-3c22-a126-3e1c90578168",
                                                "text": "Quant au gynécée, la position de l’ovaire par rapport aux pièces florales est importante. Il est dit supère, comme chez la tomate et l’oranger par exemple, s’il est au-dessus de l’insertion du périanthe et des étamines et infère si l’insertion est en dessous, cas du pommier ou du bégonia par exemple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
