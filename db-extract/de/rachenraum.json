                "senses": [
                    {
                        "sense_id": "c4d67ea0-55fa-36e6-9ba4-265661fd34dd",
                        "entry_id": "c642cf85-99b7-3420-9cbc-28c772d162f4",
                        "glosses": [
                            "sich an den Nasenraum/Nasenhöhle und Mundraum/Mundhöhle anschließender Bereich, der ungefähr bis zum Kehlkopf reicht und in die Speiseröhre übergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3051ea1e-459b-49a5-a0de-98f0eabea95c",
                                "sense_id": "c4d67ea0-55fa-36e6-9ba4-265661fd34dd",
                                "text": "Im oberern Rachenraum befinden sich die Rachenmandeln."
                            },
                            {
                                "example_id": "a77380dd-a45b-498a-83fc-e81520aefc2e",
                                "sense_id": "c4d67ea0-55fa-36e6-9ba4-265661fd34dd",
                                "text": "Der Kehlkopf, der im unteren Rachenraum liegt, verschließt den Luftweg beim Schlucken."
                            },
                            {
                                "example_id": "e7f2c290-902f-4d4d-a7cd-dd90634cc1b4",
                                "sense_id": "c4d67ea0-55fa-36e6-9ba4-265661fd34dd",
                                "text": "„In der ersten Erkrankungswoche sind in der Regel nur im Rachenraum Viren nachweisbar, in der zweiten Woche dagegen oft nur im Lungensekret.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
