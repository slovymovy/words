                                        "sense_id": "d8f6dc21-fab1-3958-8dde-74755f4fb0fd",
                                        "entry_id": "33ff8682-fd19-3c01-bf41-3765952cd102",
                                        "glosses": [
                                            "A small bun that sells for a penny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0c69a1-d4e4-4d00-982c-725c57598fc7",
                                                "sense_id": "d8f6dc21-fab1-3958-8dde-74755f4fb0fd",
                                                "text": "I told him of that Sunday evening in Ross when I went home to my dinner, and my mother had no dinner for me; I told him how I had one penny piece in my pocket; I told him how I went out and bought for it a penny bun, and how I stole to the back of the house and thievishly ate that penny bun without sharing it with my mother and my sister and my brothers. I am proud of my life, one way or another; but that penny bun is a thorn in my side; a thorn in the pride of my life; it was only four ouces of bread -- for bread was four pense (eight cents) a pound at the time -- but if I ever feel any pride in myself, that little loaf comes before me to humble me;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8015d6-0685-3ee5-b87f-5774fc939f9c",
                                        "entry_id": "33ff8682-fd19-3c01-bf41-3765952cd102",
                                        "glosses": [
                                            "An edible mushroom (Boletus edulis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
