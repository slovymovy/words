                    {
                        "sense_id": "801fda74-e668-3f9e-9ffd-69e8db6e00e3",
                        "entry_id": "841781af-ed8c-30e2-b1b5-d530e3ec96c1",
                        "glosses": [
                            "Ring als Zeichen einer Verlobung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26dc98f9-6500-4a24-9406-3212d19c07d3",
                                "sense_id": "801fda74-e668-3f9e-9ffd-69e8db6e00e3",
                                "text": "Vor der Hochzeit wird der Verlobungsring am Ringfinger der linken Hand getragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9bbcf7d-585d-4ac7-ad7c-77117d74225b",
                        "source_entry_id": "841781af-ed8c-30e2-b1b5-d530e3ec96c1",
                        "source_sense_id": "801fda74-e668-3f9e-9ffd-69e8db6e00e3",
                        "source_sense_description": "Ring als Zeichen einer Verlobung",
                        "target_lang_word": "engagement ring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engagement ring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e323e13-8490-38a2-bdc6-d2a080bf185e",
                                        "entry_id": "8adb2988-2c3f-3032-9ceb-fed048368478",
                                        "glosses": [
                                            "A ring given to one's fiancé(e) or intended fiancé(e), signifying a promise to wed, typically a gold band with one or more diamonds or other precious stones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f776e3cb-8ac8-4f66-9f49-88e5a9a7503e",
                                                "sense_id": "2e323e13-8490-38a2-bdc6-d2a080bf185e",
                                                "text": "Then, aroused to the sense of what was proper among mortals circumstanced as we were, I pointed out to Kitty that an engagement-ring was the outward and visible sign of her dignity as an engaged girl; and that she must forthwith come to Hamilton's to be measured for one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0658b0-8fe9-395c-a6a0-f224fd311219",
                                        "entry_id": "8adb2988-2c3f-3032-9ceb-fed048368478",
                                        "glosses": [
                                            "Any ring that has the appearance of a ring given as a promise to wed."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46dc0892-8f8a-4629-8265-5b0793430b82",
                                                "sense_id": "de0658b0-8fe9-395c-a6a0-f224fd311219",
                                                "text": "After about five minutes we dug up an old engagement ring."
                                            },
                                            {
                                                "example_id": "b2f3ad96-a195-413b-8ef2-90c259c0ec5e",
                                                "sense_id": "de0658b0-8fe9-395c-a6a0-f224fd311219",
                                                "text": "Wednesday: I found an engagement ring on the beach this morning, beautiful little thing, a diamond the shape of a teardrop and two clusters of tiny sapphires on either side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b42b4ca-d147-4dc6-a49c-235431173302",
                        "source_entry_id": "841781af-ed8c-30e2-b1b5-d530e3ec96c1",
                        "source_sense_id": "801fda74-e668-3f9e-9ffd-69e8db6e00e3",
