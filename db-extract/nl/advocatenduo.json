                            {
                                "example_id": "cc2da28d-cd0d-44f6-aab5-30e71d0dc231",
                                "sense_id": "57db199c-e82c-3482-8374-e59c3c4746c9",
                                "text": "Advocatenduo Anker en Anker stopt ermee: De gebroeders Anker stoppen met de advocatuur. De tweelingbroers Hans en Wim Anker zetten eind volgend jaar een punt achter hun carrière, bevestigen ze aan Omrop Fryslân. Ze zijn dan 69 jaar."
                            },
                            {
                                "example_id": "0e466ce7-54b7-439c-b4ad-403988c8c2a7",
                                "sense_id": "57db199c-e82c-3482-8374-e59c3c4746c9",
                                "text": "Advocatenduo Netflix-serie 'Making a Murderer' over wereldberoemde zaak: Dean Strang en Jerry Buting zijn de advocaten van autosloper Steven Avery, de man die eerst achttien jaar onschuldig vastzat voor verkrachting en vervolgens werd verdacht van een moord. Hij werd bekend door de Netflix-serie Making a Murderer."
                            }
