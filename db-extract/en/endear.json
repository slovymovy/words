                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aabae0bd-bcdf-3ea2-8f99-889e7641a1bf",
                        "entry_id": "b8be0a34-ac7b-38e4-9445-bd81b942a22d",
                        "glosses": [
                            "To make (something) more expensive; to increase the cost of."
