                        "sense_id": "f1d35633-5845-3e70-93b1-28e531ee04ac",
                        "entry_id": "a1ed599a-a806-3271-82ac-59522709c77d",
                        "glosses": [
                            "Linguistik, speziell Glossematik (ein theoretisches Konzept der Kopenhagener Schule): Untersuchung der Inhaltsform der Sprache, der Plereme als kleinsten Bedeutungsbestandteilen der Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd288135-925c-4b14-ac16-ea499d4076f8",
                                "sense_id": "f1d35633-5845-3e70-93b1-28e531ee04ac",
                                "text": "Entsprechend den beiden verschiedenen Bedeutungen von Plerem gibt es auch zwei Verwendungsweisen für Pleremik."
                            },
                            {
                                "example_id": "858ecaf9-e31e-4df9-a611-5fd57b0e24e3",
                                "sense_id": "f1d35633-5845-3e70-93b1-28e531ee04ac",
                                "text": "„Glossematiker im engeren Sinn waren neben Hjelmslev und Uldall vor allem Jens Holt, der das Studium der ‚Inhaltsform‘, die sog. Pleremik vorantrieb…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be31f541-91b5-35c2-92d5-0f2e6ad0db7c",
                        "entry_id": "a1ed599a-a806-3271-82ac-59522709c77d",
                        "glosses": [
                            "Untersuchung der kleinsten bedeutungstragenden Elemente der Sprache, der Morpheme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05da3002-86f8-4d7d-a3a0-f0ea2075b3db",
                                "sense_id": "be31f541-91b5-35c2-92d5-0f2e6ad0db7c",
                                "text": "Entsprechend den beiden verschiedenen Bedeutungen von Plerem gibt es auch zwei Verwendungsweisen für Pleremik."
                            },
                            {
                                "example_id": "41bf050a-5b9e-41fc-9df4-c26863220841",
                                "sense_id": "be31f541-91b5-35c2-92d5-0f2e6ad0db7c",
                                "text": "Die linguistischen Wörterbücher von Bußmann und Glück führen Pleremik lediglich als Verweisstichwort zu „Morphologie“."
