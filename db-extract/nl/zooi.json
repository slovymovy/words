                                        "glosses": [
                                            "To interfere."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "886563cf-79b4-436b-a507-ffc8bb363a9b",
                                                "sense_id": "1a3c02ee-7e4e-36ef-accc-e8f265efb9ed",
                                                "text": "This doesn't concern you. Don't mess."
                                            }
