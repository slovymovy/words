                "senses": [
                    {
                        "sense_id": "0a5e743f-96af-3500-8b78-2d0200b6a399",
                        "entry_id": "23d5357b-153f-36d1-89c1-a71f0d6fa9a4",
                        "glosses": [
                            "Luft, die beim Ausatmen dem Körper entweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1c95dc8-3ec7-453c-8e4f-8d867269257c",
                                "sense_id": "0a5e743f-96af-3500-8b78-2d0200b6a399",
                                "text": "„Die Ausatemluft ist mengenmäßig nicht gleich der Einatemluft, da im allgemeinen mehr O₂ aus der Atemluft entnommen wird, als CO₂ in sie abgegeben wird, selbst wenn vom Wasserdampf abgesehen wird.“"
                            },
                            {
                                "example_id": "2c56f955-0077-43cd-bc85-182c0c0f0b1f",
                                "sense_id": "0a5e743f-96af-3500-8b78-2d0200b6a399",
                                "text": "„Die Ausatemluft hat eine Sauerstoffkonzentration von 16%. Atmet ein gesunder Erwachsener in Körperruhe 6 l Luft pro Minute, so atmet er 1,26 l Sauerstoff ein und 0,96 l Sauerstoff aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
