                "senses": [
                    {
                        "sense_id": "fd08e714-d5fb-3bc6-bf5c-06ca6a3a90d8",
                        "entry_id": "a1e783eb-ae40-30bb-af05-bdf50fecf58e",
                        "glosses": [
                            "Eigenschaft einer Person, keine Nachsicht zu zeigen, ohne Mitleid, Erbarmen zu sein, nicht bereit zu sein, anderen zu verzeihen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "263e75ab-43ff-498d-9222-3f922be017fc",
                                "sense_id": "fd08e714-d5fb-3bc6-bf5c-06ca6a3a90d8",
                                "text": "„Mißtrauen, Härte, Nachsichtslosigkeit sind die Grundzüge der angeblich frommen Kindheitszeit ber Völker!“"
                            },
                            {
                                "example_id": "4a673365-afe4-4414-9cfe-ae29034378b7",
                                "sense_id": "fd08e714-d5fb-3bc6-bf5c-06ca6a3a90d8",
                                "text": "„Ist diese Nachsichtslosigkeit ein Zeichen des guten Tons? Durchaus nicht, denn zum guten Tone gehört auch das feine.“"
                            },
                            {
                                "example_id": "9fcb4659-ca30-4d34-ba44-ef33979a7bd9",
                                "sense_id": "fd08e714-d5fb-3bc6-bf5c-06ca6a3a90d8",
                                "text": "„Nachsichtslosigkeit und Unverständnis sind ein altes Erbe, wir alle haben es einst mitbekommen, um es später zu verlieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
