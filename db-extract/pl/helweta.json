                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45f8071d-1dc9-3375-b9a2-b0f6ce0dbd21",
                                        "entry_id": "eb5b072b-73bf-3caf-92eb-264ccfcbfb10",
                                        "glosses": [
                                            "Habitant d’Helvétie (nom de la région qui est devenue la Suisse), ou maintenant de Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf560e6c-3d77-4cb0-a7d4-bb1b6340e2cc",
                                                "sense_id": "45f8071d-1dc9-3375-b9a2-b0f6ce0dbd21",
                                                "text": "Les Helvètes n’ont rien lâché dans la fin de match pour arracher le nul sur une ultime parade de leur gardien, Nikola Portner (10 arrêts)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f791977-7c31-482f-b427-a60d71d8c3ba",
                        "source_entry_id": "300592cf-9eb3-3908-9a46-10a36622ab41",
                        "source_sense_id": "19df9a62-75e3-3619-8801-e40b9989a304",
                        "target_lang_word": "Helvetier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helvetier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3dc9c1-10d0-3a62-94a0-d47b49fd5482",
                                        "entry_id": "245b4af6-3b73-3b83-a7ed-6e0712983f48",
                                        "glosses": [
                                            "Angehöriger der gleichnamigen Bevölkerungsgruppe der Kelten, die anfangs in Südwestdeutschland ansässig war und später im Bereich der heutigen Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f974c5b2-0d86-43d3-85c0-24136053250d",
                                                "sense_id": "7a3dc9c1-10d0-3a62-94a0-d47b49fd5482",
                                                "text": "„Über das Schicksal der Helvetier sind wir durch Caesars Kriegsbericht verhältnismäßig gut informiert.“"
                                            },
                                            {
                                                "example_id": "3e03c2c2-99df-4b9e-92c5-33ebca93c641",
                                                "sense_id": "7a3dc9c1-10d0-3a62-94a0-d47b49fd5482",
                                                "text": "„Die Helvetier wollten nur friedlich die römische Provinz durchqueren.“"
                                            },
                                            {
                                                "example_id": "7c38f327-22a2-4d48-a6d3-d3f8d0742697",
                                                "sense_id": "7a3dc9c1-10d0-3a62-94a0-d47b49fd5482",
                                                "text": "„Aus der Zeit der Eroberung kennen wir nun auch die Selbstbezeichnungen der hier lebenden Nationen oder »Stämme« – der Treverer in der Eifel, im Hunsrück und an der Mosel, der Nemeter in der Pfalz, der Helvetier in Baden und Schwaben, der Vindeliker und Boier in Bayern.“"
                                            },
                                            {
                                                "example_id": "ab378ca9-041e-48ca-94f4-81ed84bb5b6c",
                                                "sense_id": "7a3dc9c1-10d0-3a62-94a0-d47b49fd5482",
                                                "text": "„Einen Versuch der Helvetier, bei Genf die Rhône zu überqueren, schlug Caesar zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
