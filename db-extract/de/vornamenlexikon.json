                "senses": [
                    {
                        "sense_id": "e3b932ef-0afb-318b-9c86-4446f56e4c41",
                        "entry_id": "42567692-76fe-3cad-b14f-b8cb53a34cb3",
                        "glosses": [
                            "Nachschlagewerk für Vornamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89366584-4834-4bbd-b382-2a681b19d810",
                                "sense_id": "e3b932ef-0afb-318b-9c86-4446f56e4c41",
                                "text": "„Entsprechend diesen Veränderungen in der Namenmode ist das Vornamenlexikon im Vergleich zu seiner Vorgängerauflage um mehr als 2000 neu aufgenommene Namen ergänzt worden, wozu noch viele Varianten kommen.“"
                            },
                            {
                                "example_id": "4dc255d1-3695-4ff6-8f7c-b0e5748432db",
                                "sense_id": "e3b932ef-0afb-318b-9c86-4446f56e4c41",
                                "text": "„Tabellen zu den 10 häufigsten Vornamen für Jungen und Mädchen in 22 Ländern in den Jahren 2004/05 findet man, allerdings ohne Daten, im Vornamenlexikon des Dudenverlags.“"
                            },
                            {
                                "example_id": "53140a6f-c9ea-47d5-b105-a5d9addbd7ea",
                                "sense_id": "e3b932ef-0afb-318b-9c86-4446f56e4c41",
                                "text": "„Das Vornamenlexikon liefert ausführliche Informationen zu Bedeutung, Herkunft, Kurzformen, Schreibweisen und Aussprache von über 6000 Mädchen- und Jungennamen.“"
                            },
                            {
                                "example_id": "c763fb36-e98e-46e4-ad1b-4d8b1d147998",
                                "sense_id": "e3b932ef-0afb-318b-9c86-4446f56e4c41",
                                "text": "„In unserem Vornamenlexikon findest du 6.000 beliebte, außergewöhnliche, klassische oder auch seltene Vornamen.“"
                            },
                            {
                                "example_id": "73a8cb1f-cb63-4513-8f84-9e77fb790098",
                                "sense_id": "e3b932ef-0afb-318b-9c86-4446f56e4c41",
                                "text": "„Seitdem zählen Vornamenlexika zu den Dauerbestsellern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
