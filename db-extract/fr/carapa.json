                                    {
                                        "sense_id": "d777fc1a-5881-3c7b-af99-826a72cfaf80",
                                        "entry_id": "1115bd14-d80e-3da8-b0c4-6ee324b3aaba",
                                        "glosses": [
                                            "To cudgel or beat, as with a crabstick"
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb5a679-b8e6-4628-8e11-9afaaa18eeeb",
                                                "sense_id": "d777fc1a-5881-3c7b-af99-826a72cfaf80",
                                                "text": "Get you to bed, drab, courage Or l'll so crab your shoulders!"
                                            },
                                            {
                                                "example_id": "fe6db2ca-10ed-4d7a-8fe8-218791fd69a2",
                                                "sense_id": "d777fc1a-5881-3c7b-af99-826a72cfaf80",
                                                "text": "I was on a horse named The Skipper, a perfect terror to ride when he was in a bad humour, which he invariably was; nevertheless he was a splendid hunter and I never crabbed him."
                                            },
                                            {
                                                "example_id": "05c2ce23-7f7a-4683-b92b-454e5b4a8582",
                                                "sense_id": "d777fc1a-5881-3c7b-af99-826a72cfaf80",
                                                "text": "The Shiremans had a down on him over stores he'd condemned as not fit for dogs, let alone able seamen, and they'd got wind he was a socialist, and they crabbed him all over the shipping companies' offices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1fd2c27-83ef-35d5-b016-99c636f04807",
                                        "entry_id": "1115bd14-d80e-3da8-b0c4-6ee324b3aaba",
                                        "glosses": [
                                            "To offend or insult."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "010840a1-dcf2-423b-90c7-ae4ec5ec2a0a",
                                                "sense_id": "d1fd2c27-83ef-35d5-b016-99c636f04807",
                                                "text": "If I think one thing and speak another, / I will both crab Christ and our Ladie His mother."
                                            }
                                        ]
                                    }
                                ]
