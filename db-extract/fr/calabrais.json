                "senses": [
                    {
                        "sense_id": "c3fec77a-a095-3c49-80da-61a265b1e36d",
                        "entry_id": "5f76a4fb-f180-36be-9c20-c9483ba89287",
                        "glosses": [
                            "Relatif à la Calabre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2a6bb7-b1f4-4f60-a8a5-8dd1bcd3f88e",
                                "sense_id": "c3fec77a-a095-3c49-80da-61a265b1e36d",
                                "text": "il [Quasimodo] était devenu en quelque façon singe et chamois, comme l'enfant calabrais qui nage avant de marcher, et joue, tout petit, avec la mer."
                            },
                            {
                                "example_id": "08747322-edce-40e1-a6d2-9df9dd82586f",
                                "sense_id": "c3fec77a-a095-3c49-80da-61a265b1e36d",
                                "text": "Devant moi, un grand gaillard, à figure toute blême enfouie dans une grosse barbe noire, des lunettes d’étudiant allemand, un chapeau de bandit calabrais."
                            },
                            {
                                "example_id": "c7961f96-8e98-4cfd-830c-86683542a33b",
                                "sense_id": "c3fec77a-a095-3c49-80da-61a265b1e36d",
                                "text": "La 'Ndrangheta calabraise a depuis longtemps dépassé la Cosa Nostra sicilienne en tant que plus grande organisation mafieuse d'Italie et elle est considérée comme l'un des syndicats du crime les plus puissants du monde en raison de son contrôle de la majeure partie de la cocaïne entrant en Europe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3d89888-4186-4ea3-8af0-27dc7ac3f78b",
                        "source_entry_id": "5f76a4fb-f180-36be-9c20-c9483ba89287",
