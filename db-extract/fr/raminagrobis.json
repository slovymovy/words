                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584ee048-41f0-4df0-8787-964f96c51d5f",
                                "sense_id": "de6838f3-b8c9-3e5e-986b-90175f00be45",
                                "text": "Il y avait des vaches, des moutons, des coqs, des canards, des oies, des poules, des chevaux de trait et puis des animaux domestiques, chiens de chasse ou raminagrobis, mais aucun n'avait le droit de cité dans la maison."
                            }
                        ]
                    }
