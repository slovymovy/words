                ],
                "senses": [
                    {
                        "sense_id": "f7a535cf-ca1f-30ef-83a3-c420fcaa03b4",
                        "entry_id": "3cb88c3b-ac96-3bef-a141-ecf2707d7740",
                        "glosses": [
                            "die Sprache, in der die Kommunikation tatsächlich geführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f91cc5c-270b-4d4d-a91f-be3aec974f1a",
                                "sense_id": "f7a535cf-ca1f-30ef-83a3-c420fcaa03b4",
                                "text": "„Die Amtssprachen und die Arbeitssprachen der Organe der Gemeinschaft sind Deutsch, Französisch, Italienisch und Niederländisch.“"
                            },
                            {
                                "example_id": "60ada79c-0569-4b8c-9879-e72be4c7a311",
                                "sense_id": "f7a535cf-ca1f-30ef-83a3-c420fcaa03b4",
                                "text": "„Deutsch ist selbstverständlich eine der 23 EU-Amtssprachen, die vor allem der Kommunikation zwischen den EU-Organen und den Mitgliedsstaaten dienen. Weniger gesichert ist dagegen die Stellung von Deutsch als eine der internen Arbeitssprachen der Organe, die diese sich laut Artikel 6 der „Verordnung Nr. 1 des Rates zur Regelung der Sprachenfrage“ aus den Amtssprachen auswählen dürfen.“"
                            },
                            {
                                "example_id": "877b1639-2965-4e9e-9077-f68b5bd6091e",
                                "sense_id": "f7a535cf-ca1f-30ef-83a3-c420fcaa03b4",
                                "text": "Nicht alle Amtssprachen in der EU sind auch Arbeitssprachen."
                            },
                            {
                                "example_id": "92ed3210-d96b-4a88-b242-4734e9660cdf",
                                "sense_id": "f7a535cf-ca1f-30ef-83a3-c420fcaa03b4",
                                "text": "„Auch in vielen nichtwissenschaftlichen Arbeitsbereichen, etwa in der Luftfahrt oder der ›high-tech‹-Industrie, hat das Deutsche als Arbeitssprache an Bedeutung verloren (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
