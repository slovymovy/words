{
    "word_family": [
        "clue",
        "cluelessness",
        "clueful"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e873cbc-f8c3-3b38-a0fc-b8375eedb69d",
                    "sense_definition": "Lacking knowledge or understanding about a particular situation; completely uninformed or oblivious.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack of knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was totally <w>clueless</w> about the surprise party his friends had been planning for weeks.",
                            "target_lang_translations": {
                                "ru": "Он совершенно <w>не догадывался</w> о вечеринке-сюрпризе, которую его друзья планировали неделями."
                            }
                        },
                        {
                            "text": "The new intern seemed <w>clueless</w> about how to use the office software on his first day.",
                            "target_lang_translations": {
                                "ru": "В свой первый день новый стажер казался совершенно <w>бестолковым</w> в том, как пользоваться офисным ПО."
                            }
                        }
                    ],
                    "synonyms": [
                        "oblivious",
                        "uninformed",
                        "ignorant",
                        "unaware"
                    ],
                    "antonyms": [
                        "clueful",
                        "informed"
                    ],
                    "common_phrases": [
                        "totally clueless",
                        "remain clueless",
                        "clueless about"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe someone's lack of awareness in a slightly critical way"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий знаний или понимания конкретной ситуации; совершенно неосведомленный или забывчивый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не имеющий представления",
                                "target_lang_sense_clarification": "о ситуации или предмете"
                            },
                            {
                                "target_lang_word": "невежественный",
                                "target_lang_sense_clarification": "в плане отсутствия знаний"
                            },
                            {
                                "target_lang_word": "бестолковый",
                                "target_lang_sense_clarification": "разговорное, о человеке, который ничего не понимает"
                            },
                            {
                                "target_lang_word": "не в курсе",
                                "target_lang_sense_clarification": "разговорное, о неосведомленности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "735ca266-9014-3d68-aa86-32630be0ed21",
                    "sense_definition": "Providing no clues, hints, or evidence to help solve a problem or mystery.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lack of evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were faced with a <w>clueless</w> mystery that left them with no leads to follow.",
                            "target_lang_translations": {
                                "ru": "Полиция столкнулась с <w>не имеющей зацепок</w> тайной, которая не оставила им никаких улик для расследования."
                            }
                        },
                        {
                            "text": "The shifting shapes mimicked the dilemma of the nearly <w>clueless</w> mystery of the Higgins Grove murders.",
                            "target_lang_translations": {
                                "ru": "Меняющиеся очертания имитировали дилемму почти <w>неразрешимой</w> тайны убийств в Хиггинс-Гроув."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsolvable",
                        "mysterious"
                    ],
                    "common_phrases": [
                        "clueless mystery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не дающий никаких зацепок, намеков или доказательств для решения проблемы или тайны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не имеющий зацепок",
                                "target_lang_sense_clarification": "о тайне или преступлении"
                            },
                            {
                                "target_lang_word": "загадочный",
                                "target_lang_sense_clarification": "не поддающийся объяснению из-за отсутствия улик"
                            },
                            {
                                "target_lang_word": "тупиковый",
                                "target_lang_sense_clarification": "о деле или ситуации без подсказок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}