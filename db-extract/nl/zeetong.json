                                                "text": "Die Seezunge ist rechtsäugig."
                                            },
                                            {
                                                "example_id": "a8f0fc81-3cb2-41f8-a3dd-bdb026787338",
                                                "sense_id": "9876884e-859c-3efb-99d9-316197d80712",
                                                "text": "Das äußerst delikate, zarte Fleisch der Seezunge gehört zu den kulinarischen Schätzen der Nordsee."
                                            },
                                            {
                                                "example_id": "c9c8c0a7-6b49-4935-9b74-ba854c347c56",
                                                "sense_id": "9876884e-859c-3efb-99d9-316197d80712",
                                                "text": "„Der Marabu brachte die Seezunge und den Salat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
