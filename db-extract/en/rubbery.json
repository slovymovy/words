                "senses": [
                    {
                        "sense_id": "17f80768-a7c4-3142-bd43-b25a6d40e8c1",
                        "entry_id": "434c733a-a749-3020-852f-172576022cf2",
                        "glosses": [
                            "Of, relating to, or resembling rubber, especially in consistency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ee92df-7066-495f-acb8-2ba3776ff14d",
                                "sense_id": "17f80768-a7c4-3142-bd43-b25a6d40e8c1",
                                "text": "What a bad restaurant! The beef was so rubbery I thought I'd never finish chewing it."
                            },
                            {
                                "example_id": "5f7e7c1e-1be7-44ea-bbb3-585e1c4325bb",
                                "sense_id": "17f80768-a7c4-3142-bd43-b25a6d40e8c1",
                                "text": "In this same temperature range, however, the leg is at its rubberiest."
                            },
                            {
                                "example_id": "6b769f77-f0fe-48aa-b72f-8d5e35b5b08c",
                                "sense_id": "17f80768-a7c4-3142-bd43-b25a6d40e8c1",
                                "text": "If you boil it for hours, it becomes rubbery and overcooked."
                            },
                            {
                                "example_id": "06c61347-8b50-42fb-bfe0-637e66ea641d",
                                "sense_id": "17f80768-a7c4-3142-bd43-b25a6d40e8c1",
                                "text": "CJ Biomaterials was the first company in the world to produce amorphous PHA, it says, which is a softer, rubberier version of PHA that offers fundamentally different performance characteristics than crystalline or semi-crystalline forms of the biopolymer."
                            }
                        ]
                    }
                ],
