                                        "sense_id": "2c4f2084-c0cf-386d-bb66-080f38bc50d0",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "The thin, horny plate at the ends of fingers and toes on humans and some other animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b144deb-47fc-485b-8b83-7ed96d1beae7",
                                                "sense_id": "2c4f2084-c0cf-386d-bb66-080f38bc50d0",
                                                "text": "When I'm nervous I bite my nails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e300136-948b-34b5-842c-f85c64d454d1",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "The basal thickened portion of the anterior wings of certain hemiptera."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de5fa129-de88-31a4-b7a0-dc66203f4f24",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "The terminal horny plate on the beak of ducks, and other allied birds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d249d36-ccde-3f54-9d72-597f5efa8285",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "The claw of a bird or other animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0b76c86-b4dd-3f63-a121-5b3bded71c71",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "A spike-shaped metal fastener used for joining wood or similar materials. The nail is generally driven through two or more layers of material by means of impacts from a hammer or other device. It is then held in place by friction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "834f003a-342f-4bbd-813d-a7a598b13106",
                                                "sense_id": "b0b76c86-b4dd-3f63-a121-5b3bded71c71",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out. Indeed, a nail filed sharp is not of much avail as an arrowhead; you must have it barbed, and that was a little beyond our skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd1a377-7f31-3006-bf32-efd814940c8a",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "A round pedestal on which merchants once carried out their business, such as the four nails outside The Exchange, Bristol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e36113e1-b693-3ca4-8001-b2bea675abf3",
                                        "entry_id": "37f1e1ac-d919-3a9d-8f69-92f3ccc8b6f4",
                                        "glosses": [
                                            "An archaic English unit of length equivalent to ¹⁄₂₀ of an ell or ¹⁄₁₆ of a yard (2+¹⁄₄ inches or 5.715 cm)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nail",
