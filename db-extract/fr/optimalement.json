                                            {
                                                "example_id": "6be631a4-e9e9-4b7b-89ef-7c4399f1d501",
                                                "sense_id": "448442ad-ecd0-3127-ab2c-030886f448bf",
                                                "text": "„Die Machbarkeitsstudie untersuchte sowohl die optimale Placierung der Solarpaneele, als auch den zu erwartenden Energieertrag auf einem typischen Streckenprofil der SOB.“"
                                            },
                                            {
                                                "example_id": "4be65e17-b308-4f77-9e50-82dbad60ae45",
                                                "sense_id": "448442ad-ecd0-3127-ab2c-030886f448bf",
                                                "text": "Jeder versucht, in Prüfungen optimale Ergebnisse zu erzielen."
                                            },
                                            {
                                                "example_id": "0c71fd8b-9207-4691-a6b1-4b272609ef02",
                                                "sense_id": "448442ad-ecd0-3127-ab2c-030886f448bf",
                                                "text": "Es stellt sich daher die Frage, welcher der optimalste von allen zulässigen Parametern ist."
                                            },
                                            {
                                                "example_id": "588d3ec6-4a77-421b-b32a-6531a2640a18",
                                                "sense_id": "448442ad-ecd0-3127-ab2c-030886f448bf",
                                                "text": "„Wenn es gelingt, […] die Auf- und Abwinde richtig einzuschätzen, den Drachen optimal zu steuern, fehlerfrei zu navigieren, dann stellen sich dem Flieger schon während seiner Tätigkeit positive Rückmeldungen ein, die in einen Flow-Zustand versetzen können.“"
                                            }
