                        "entry_id": "8a35186f-9193-34f8-8cf1-cf5c9a3769dd",
                        "glosses": [
                            "Celui qui relate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b8bd90-4e2e-4fc6-a86a-e93189639703",
                                "sense_id": "aec79e25-d6d3-35ea-a995-18913dd82bff",
                                "text": "Vos historiens nous sont inconnus ; on n'en a que des morceaux extraits et rapportés par des relateurs peu critiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "400fbd39-f828-3142-8f66-9f588611889b",
                        "entry_id": "8a35186f-9193-34f8-8cf1-cf5c9a3769dd",
                        "glosses": [
                            "Celui qui fait la relation d'un voyage, d'une aventure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcfcfb0c-3e9e-4835-83cb-cc1fe6d2360d",
                                "sense_id": "400fbd39-f828-3142-8f66-9f588611889b",
                                "text": "Les anciens relateurs ont écrit que l'urine des chameaux produit, sur les sables salés de l'Arabie et de la Libye, du sel ammoniac en grande quantité."
                            }
                        ]
                    }
                ],
