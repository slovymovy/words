                                    },
                                    {
                                        "sense_id": "c445cf72-fd41-350b-bed2-a1da7cd1bb16",
                                        "entry_id": "55eaca87-aa69-33dc-a7f3-0844be0085c0",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de piquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089dbd79-d134-4455-a65a-37f3f427f158",
                                                "sense_id": "c445cf72-fd41-350b-bed2-a1da7cd1bb16",
                                                "text": "L’avion revient vers nous, plane un moment sur nos têtes, glisse, remonte et, dans une dernière caracole, pique vers son hangar."
                                            },
                                            {
                                                "example_id": "cc573a1b-e44d-4ffa-a1df-34d78da3032b",
                                                "sense_id": "c445cf72-fd41-350b-bed2-a1da7cd1bb16",
                                                "text": "Gundermann a plus d’une ressemblance avec le financier originaire de Frankfürt am Mein ; comme lui il est le patriarche d’une prolifique tribu ; comme lui il se plaint, il gémit d’être accablé de besogne ; comme lui encore il bibelotte, se pique de connaissances artistiques."
                                            }
                                        ]
                                    },
