                "senses": [
                    {
                        "sense_id": "fb30053c-965f-3627-a9f0-4d75e9b46dd4",
                        "entry_id": "feb57682-5db2-32b1-bdef-69e315b471ee",
                        "glosses": [
                            "Ableitung von Niederschlagswasser von einem Flachdach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab63b54-1e5a-417d-bb48-e51e04aacd9d",
                                "sense_id": "fb30053c-965f-3627-a9f0-4d75e9b46dd4",
                                "text": "„Der Vorteil einer außenliegenden Flachdachentwässerung liegt natürlich darin, dass sie frei zugänglich ist.“"
                            },
                            {
                                "example_id": "3ec71b02-f551-4866-a13f-9f50af4c8e47",
                                "sense_id": "fb30053c-965f-3627-a9f0-4d75e9b46dd4",
                                "text": "„Die Flachdachentwässerung ist anspruchsvoll und aufwendig.“"
                            },
                            {
                                "example_id": "9cae0834-d5b7-46c3-bfcf-519b5ecae0a4",
                                "sense_id": "fb30053c-965f-3627-a9f0-4d75e9b46dd4",
                                "text": "„Sie sollten sich daher unbedingt durch einen Fachmann beraten lassen, welche Flachdachentwässerung in Ihrem Fall geeignet ist und mit welchen Kosten ein Einbau verbunden ist.“"
                            },
                            {
                                "example_id": "867f339c-2618-4c54-9caf-615bbf0ed864",
                                "sense_id": "fb30053c-965f-3627-a9f0-4d75e9b46dd4",
                                "text": "„Die Flachdachentwässerung erfolgt im Unterschied zur Steildachentwässerung nicht außen am Haus, sondern im Gebäudeinneren.“"
                            },
                            {
                                "example_id": "dfa93a88-0602-4c8f-b502-a5b8998b336d",
                                "sense_id": "fb30053c-965f-3627-a9f0-4d75e9b46dd4",
                                "text": "„Die Nachrüstung einer effektiven Wärmedämmung ist die ideale Gelegenheit, die Flachdachentwässerung und -lüftung gleich mit zu sanieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
