                "senses": [
                    {
                        "sense_id": "c01bb1f3-2141-39ed-ba12-642c1c5558e5",
                        "entry_id": "e8707656-c60f-322c-b66d-322ba0f9d700",
                        "glosses": [
                            "Person, die äußerst betrunken ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4f43ec02-81e0-4f8f-8d71-619352b77582",
                                "sense_id": "c01bb1f3-2141-39ed-ba12-642c1c5558e5",
                                "text": "Auf dem Oktoberfest kann man viele Schnapsleichen finden."
                            },
                            {
                                "example_id": "a7efa50a-b1c4-409e-93a7-0f3912615a49",
                                "sense_id": "c01bb1f3-2141-39ed-ba12-642c1c5558e5",
                                "text": "Wenn man nicht als Schnapsleiche enden möchte, sollte man auf seinen Alkoholkonsum achten."
                            },
                            {
                                "example_id": "5c2c098d-6e32-47b0-a40b-851f2f5c5506",
                                "sense_id": "c01bb1f3-2141-39ed-ba12-642c1c5558e5",
                                "text": "„Schon vor Sonnenuntergang lagen die ersten Schnapsleichen auf der Straße.“"
                            },
                            {
                                "example_id": "428cb270-0aa5-4480-b815-a97727c30add",
                                "sense_id": "c01bb1f3-2141-39ed-ba12-642c1c5558e5",
                                "text": "„Die Schnapsleichen vom Samstagabend liegen da in der frühen Sonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
