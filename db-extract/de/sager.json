                        ],
                        "examples": [
                            {
                                "example_id": "b9854150-2f44-4494-8519-0f9b921ae258",
                                "sense_id": "cf8d63ed-17ea-3137-883c-09fddac41d64",
                                "text": "Einer sagt ein Wort und die andern müssen es zeichnen, und der Sager wählt dann die beste Zeichnung aus.",
                                "translation": "Someone says a word and the others must draw it, and then the sayer chooses the best drawing.",
                                "english": "Someone says a word and the others must draw it, and then the sayer chooses the best drawing."
                            }
                        ]
                    },
                    {
