                            {
                                "example_id": "a671d674-8eef-4f4e-96f0-d97fceef517c",
                                "sense_id": "1fbbd6b0-8f60-3d27-861e-53ff829f267d",
                                "text": "„Der Mann nahm die Zigarette aus dem Mund, hielt sie über einen kleinen Glasaschenbecher, schnippte mit dem kleinen Finger die Asche davon ab und sah Moss ab.“"
                            },
                            {
                                "example_id": "5e8f4e99-d72e-4885-bd1b-54069525980e",
                                "sense_id": "1fbbd6b0-8f60-3d27-861e-53ff829f267d",
                                "text": "„Der Huissier wischte einen dicken Glasaschenbecher mit einem Tuch ab und stellte ihn daneben.“"
                            },
                            {
                                "example_id": "ad693e4f-5bd6-45d0-b393-9387d7a3dc38",
                                "sense_id": "1fbbd6b0-8f60-3d27-861e-53ff829f267d",
                                "text": "„Sie drückte ihre Zigarette in dem kleinen Glasaschenbecher aus.“"
                            }
                        ],
