                                "target_senses": [
                                    {
                                        "sense_id": "946625b6-e4aa-3ff2-be90-71605ec6a6cf",
                                        "entry_id": "6f219952-689a-3cac-9f6d-0f93638ba9e3",
                                        "glosses": [
                                            "der zur Zubereitung für Raclette, m. oder f. [1] verwendete Käse"
                                        ],
                                        "tags": [],
