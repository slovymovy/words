{
    "word_family": [
        "gelijk",
        "gelijken",
        "gelijkaardig"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "aa33e4b7-1f5f-37ad-bdf9-7412033e2250",
                    "sense_definition": "insgelijks (gezegd als antwoord op een wens of groet om hetzelfde terug te wensen)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wederkerige_wens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prettig weekend! Dank je wel, <w>insgelijks</w>!",
                            "target_lang_translations": {
                                "en": "Have a nice weekend! Thank you, <w>likewise</w>!"
                            }
                        },
                        {
                            "text": "Ik wens je een fijne vakantie en hoop dat jij <w>insgelijks</w> kunt genieten van de rust.",
                            "target_lang_translations": {
                                "en": "I wish you a nice holiday and hope that you <w>likewise</w> can enjoy the peace and quiet."
                            }
                        }
                    ],
                    "synonyms": [
                        "eveneens",
                        "hetzelfde",
                        "evenzo"
                    ],
                    "common_phrases": [
                        "dank je insgelijks"
                    ],
                    "target_lang_definitions": {
                        "en": "likewise, same to you (said in response to a wish or greeting to wish the same in return)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "likewise",
                                "target_lang_sense_clarification": "used as a response to return a wish"
                            },
                            {
                                "target_lang_word": "same to you",
                                "target_lang_sense_clarification": "used to return a greeting or wish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad05d05d-77a7-3ce7-8a3b-779904c3b9ad",
                    "sense_definition": "op dezelfde manier; ook, eveneens",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenstemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn collega's waren erg enthousiast en ik was <w>insgelijks</w> zeer tevreden met het resultaat.",
                            "target_lang_translations": {
                                "en": "My colleagues were very enthusiastic and I was <w>equally</w> very satisfied with the result."
                            }
                        },
                        {
                            "text": "Ik wens je <w>insgelijks</w> een gezegend kerstfeest en een gelukkig nieuwjaar.",
                            "target_lang_translations": {
                                "en": "I <w>likewise</w> wish you a blessed Christmas and a happy New Year."
                            }
                        }
                    ],
                    "synonyms": [
                        "eveneens",
                        "evenzo",
                        "ook"
                    ],
                    "target_lang_definitions": {
                        "en": "in the same way; also, likewise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "likewise",
                                "target_lang_sense_clarification": "in a similar manner or also"
                            },
                            {
                                "target_lang_word": "equally",
                                "target_lang_sense_clarification": "in an equal degree or manner"
                            },
                            {
                                "target_lang_word": "similarly",
                                "target_lang_sense_clarification": "in a similar way"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "49643041-14e5-342c-9ba9-d8d2f6b14c69",
                    "sense_definition": "uitroep gebruikt om iemand hetzelfde toe te wensen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wederkerige_wens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fijne feestdagen gewenst! <w>Insgelijks</w>!",
                            "target_lang_translations": {
                                "en": "Happy holidays! <w>Same to you</w>!"
                            }
                        },
                        {
                            "text": "Een goede reis gewenst! Ja, <w>insgelijks</w> en tot snel!",
                            "target_lang_translations": {
                                "en": "Have a safe trip! Yes, <w>likewise</w> and see you soon!"
                            }
                        }
                    ],
                    "synonyms": [
                        "hetzelfde",
                        "eveneens"
                    ],
                    "target_lang_definitions": {
                        "en": "exclamation used to wish someone the same thing in return"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "likewise",
                                "target_lang_sense_clarification": "the same to you"
                            },
                            {
                                "target_lang_word": "same to you",
                                "target_lang_sense_clarification": "used as a friendly response to a wish"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}