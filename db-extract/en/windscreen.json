                ],
                "translations": [
                    {
                        "translation_id": "6da32ede-57c2-4487-800c-e96c06352dc6",
                        "source_entry_id": "858d473f-42a4-38b0-8bc1-98c6a0b91684",
                        "source_sense_id": "e74bbbea-21c7-3b59-85f1-9f0a4802877b",
                        "source_sense_description": "Windschutzscheibe (britisch)",
                        "target_lang_word": "Windschutzscheibe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windschutzscheibe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                        "entry_id": "3b0eae5d-964d-37d9-8b70-18ba89cbcf80",
                                        "glosses": [
                                            "Flachglas, das dem Führer eines Fahrzeuges die Sicht nach vorne ermöglicht und ihn vor Wind, Wetter und Partikeln im Luftstrom schützt"
                                        ],
                                        "tags": [
                                            "Fahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d728acc3-85bb-4949-89a7-395745086423",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "Die Windschutzscheibe wird mit warmer Luft angeströmt, damit sie nicht beschlägt."
                                            },
                                            {
                                                "example_id": "5bd299e3-276b-407f-b92b-40a28c2fc99b",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "Weil ein Stein auf die Windschutzscheibe gefallen ist, hat sie jetzt ein kleines Loch."
                                            },
                                            {
                                                "example_id": "ca63a003-54cc-4f93-aea7-2de5c04077ba",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "Zum Glück können Windschutzscheiben nicht zerbrechen, sonst hätten wir jetzt ganz viele Scherben im Auto."
                                            },
                                            {
                                                "example_id": "2f3f13df-1efc-4c14-baa4-b039afdbc5dd",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Bald klebten an meiner Windschutzscheibe innen mehr Mücken als tote Insekten vorne an meinem Kühlergrill.“"
                                            },
                                            {
                                                "example_id": "3bb671b2-77a3-4cf3-808d-dbffe91a7958",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Schneeflocken strömen den Scheinwerfern entgegen, platzen auf dem Glas der Windschutzscheibe.“"
                                            },
                                            {
                                                "example_id": "055902a3-0d6a-478a-9b72-941f4d0c6f90",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Ich sprach den Satz aus – und hätte ihn am liebsten gleich wieder weggewischt, so wie das Kondenswasser, das die Windschutzscheibe von innen beschlug.“"
                                            },
                                            {
                                                "example_id": "2aad76e9-e923-41ee-b189-c5742d1ebb53",
                                                "sense_id": "ab15dc77-dd65-33d9-92d0-eacd993ae0c2",
                                                "text": "„Als er fertig war, blickte er durch die Windschutzscheibe zu Anse hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
