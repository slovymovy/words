                                        "entry_id": "51067bd3-a93b-3e5b-b9bc-cdbd8bf47b5f",
                                        "glosses": [
                                            "Gerät zum Nachweis elektrischer Ladungen und Spannungen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
