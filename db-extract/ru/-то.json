                    {
                        "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                        "entry_id": "13c33f84-3780-32eb-9201-6f00472abdf0",
                        "glosses": [
                            "Quelque, donne un caractère indéfini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a2c452-1f00-44db-8afe-fa78ffb36f0f",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "где-то : quelque part (sans déplacement)."
                            },
                            {
                                "example_id": "10c2fe0c-9e8b-46be-8c7d-31cdbea3daa8",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "зачем-то : on ne sait pas pourquoi."
                            },
                            {
                                "example_id": "ced72be4-d0ad-4aa0-9288-8d47a5fa272a",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "как-то : dans une certaine mesure, quelque peu."
                            },
                            {
                                "example_id": "6ee0ae52-d024-47e6-815e-897ddf468bd8",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "какой-то : un certain…, une sorte de, une espèce de."
                            },
                            {
                                "example_id": "952561a3-1fb2-42fc-91c5-d9e2c0561aef",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "когда-то : autrefois, jadis."
                            },
                            {
                                "example_id": "9983cbcc-d35b-4e68-8716-42d07a509b26",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "кто-то : quelqu’un."
                            },
                            {
                                "example_id": "18793d5c-2730-4ba4-b08f-2ba532e80ab5",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "куда-то : quelque part (avec déplacement)."
                            },
                            {
                                "example_id": "c8fdf136-9632-486e-a117-d0ac631dcc10",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "откуда-то : de quelque part."
                            },
                            {
                                "example_id": "033fbe3f-d10b-482a-8424-020bab3ef672",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "отчего-то : pour une raison quelconque."
                            },
                            {
                                "example_id": "4ab52fc1-2dd7-451f-97d0-dbd834537e97",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "почему-то : on ne sait pourquoi."
                            },
                            {
                                "example_id": "6c1d193f-ce9f-413c-a0cb-8a2e4da89535",
                                "sense_id": "5b9cbb84-e8ae-34a6-8326-3e9a7b4c9b5e",
                                "text": "что-то : quelque chose de, un je ne sais quoi, une espèce de ; quelque peu."
                            }
                        ]
                    }
