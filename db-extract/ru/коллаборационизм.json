                                        "entry_id": "d0c0498a-c49f-3991-9282-8b2f675241f8",
                                        "glosses": [
                                            "fenomeno sociale, politico e militare in cui uno stato, dopo averne occupato con le armi un altro, lo affida ad una forma di governo che permette la comunicazione tra il popolo vinto e la potenza occupante"
                                        ],
