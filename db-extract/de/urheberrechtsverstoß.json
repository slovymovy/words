                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea53fdd6-3d8c-4e48-8563-af5a5f1c1ded",
                                "sense_id": "557ccb72-0c5f-3bad-bd17-fcc5bf6c3983",
                                "text": "„Dies geschieht zum Beispiel bei Urheberrechtsverstößen oder - sicherlich der Prüderie des amerikanischen Konzerns geschuldet - bei der Darstellung unbekleideter weiblicher Brüste.“"
                            },
                            {
                                "example_id": "88607270-6cfb-419e-8e00-6b0b2a370550",
                                "sense_id": "557ccb72-0c5f-3bad-bd17-fcc5bf6c3983",
                                "text": "„Das Recht würde bedeuten, dass selbst Fotos oder Videoaufnahmen, die von Fans selbst im Rahmen eines Sportevents erstellt werden, einen Urheberrechtsverstoß bedeuten würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
