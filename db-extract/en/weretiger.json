                                        "entry_id": "a2e1fdc6-909d-35a7-8a17-e1b750d211b6",
                                        "glosses": [
                                            "Celui qui se transforme d’un être humain en un tigre et vice versa, de façon complète ou partielle."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
