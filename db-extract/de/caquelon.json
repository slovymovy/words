                                "target_senses": [
                                    {
                                        "sense_id": "854c1c48-7d45-3ca6-b2ba-a8a833407029",
                                        "entry_id": "cfc6745f-e7be-3463-9f37-63fb0a228277",
                                        "glosses": [
                                            "A Swiss cooking vessel used to serve fondue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b99f00-a3c8-4fca-aad2-7ec380dd9711",
                                                "sense_id": "854c1c48-7d45-3ca6-b2ba-a8a833407029",
                                                "text": "Friends and family often gather for hours to slowly stir their bread on long forks in the cauldron of cheese known as a caquelon, which is heated by a small flame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2712161-6b8d-40c1-ac2a-e3d63a905425",
                        "source_entry_id": "72f51248-80e4-3dc0-a6a3-be1343bb629f",
                        "source_sense_id": "29f8fdef-7eb2-30ab-84c1-409c4162698b",
                        "source_sense_description": "Schweiz: runder Topf mit Stiel für Käsefondue, gefertigt zumeist aus Steingut, Keramik, Gusseisen oder Porzellan",
                        "target_lang_word": "caquelon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caquelon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c718b12d-6464-3ea6-8db6-c10953c73d66",
                                        "entry_id": "4133dc6a-2478-326c-a5f5-37f08b823ddf",
                                        "glosses": [
                                            "Sorte de casserole en terre cuite ou en fonte, pourvue d’un manche, dans laquelle se prépare puis se sert la fondue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c54511b-0f3d-4e7c-96c9-6b302897034e",
                                                "sense_id": "c718b12d-6464-3ea6-8db6-c10953c73d66",
                                                "text": "Mon gars tu prends le méton\nQue tu verses dans le caquelon\nAvec de l’ail, avec du beurre\nAvec ton manche, avec ton cœur."
                                            },
                                            {
                                                "example_id": "3ec99744-2d81-49cf-a8ac-5147eba0674d",
                                                "sense_id": "c718b12d-6464-3ea6-8db6-c10953c73d66",
                                                "text": "[…] chic du céleri rémoulade, le bifteck saignant, les pommes de terre sautées fondantes dans le caquelon."
                                            },
                                            {
                                                "example_id": "00b5b79a-fe28-483b-b37a-e2da62cfa606",
                                                "sense_id": "c718b12d-6464-3ea6-8db6-c10953c73d66",
                                                "text": "Hier soir, dans une auberge d’Isola, pendant que du Lac s’acharnait sur un caquelon à fondue pour arracher au couteau un lambeau de beaufort, le docteur F..., du centre traumatologique de la station, nous avait abordés."
                                            }
                                        ]
                                    }
                                ]
