{
    "word_family": [
        "where",
        "ever",
        "whereabouts",
        "wherewithal",
        "whereupon"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "dd8bda4b-459d-3fa8-aa31-6e3056b0b916",
                    "sense_definition": "In, at, or to any place that a person chooses or prefers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "any_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can sit <w>wherever</w> you like in the theater.",
                            "target_lang_translations": {
                                "ru": "В театре вы можете сесть <w>где угодно</w>."
                            }
                        },
                        {
                            "text": "Please feel free to go <w>wherever</w> you want during your break.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не стесняйтесь идти <w>куда угодно</w> во время перерыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wherever you like",
                        "wherever you want"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любом месте, которое человек выбирает или предпочитает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "где угодно",
                                "target_lang_sense_clarification": "в любом месте по выбору"
                            },
                            {
                                "target_lang_word": "куда угодно",
                                "target_lang_sense_clarification": "в любое место по выбору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9ec93c2-a000-3b63-8e35-fbdc8f67f982",
                    "sense_definition": "Regardless of the specific place or destination.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "regardless_of_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wherever</w> you go, I will always find a way to reach you.",
                            "target_lang_translations": {
                                "ru": "<w>Куда бы</w> вы <w>ни</w> пошли, я всегда найду способ связаться с вами."
                            }
                        },
                        {
                            "text": "He carries his lucky charm <w>wherever</w> he travels in the world.",
                            "target_lang_translations": {
                                "ru": "Он возит с собой свой талисман, <w>где бы</w> он <w>ни</w> путешествовал по миру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wherever you go"
                    ],
                    "target_lang_definitions": {
                        "ru": "Независимо от конкретного места или пункта назначения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "где бы ни",
                                "target_lang_sense_clarification": "в каком бы месте ни"
                            },
                            {
                                "target_lang_word": "куда бы ни",
                                "target_lang_sense_clarification": "в какое бы место ни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bdc204a-fed4-328d-b908-a630125b9dd9",
                    "sense_definition": "In every place or situation where something is possible or necessary.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "everywhere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our charity has limited funds, but we help <w>wherever</w> we can.",
                            "target_lang_translations": {
                                "ru": "У нашей благотворительной организации ограниченные средства, но мы помогаем <w>везде</w>, где можем."
                            }
                        },
                        {
                            "text": "You should add quotations <w>wherever</w> they are needed in your essay.",
                            "target_lang_translations": {
                                "ru": "Вам следует добавлять цитаты <w>повсюду</w>, где они необходимы в вашем эссе."
                            }
                        }
                    ],
                    "synonyms": [
                        "everwhere"
                    ],
                    "common_phrases": [
                        "wherever possible",
                        "wherever necessary"
                    ],
                    "target_lang_definitions": {
                        "ru": "В каждом месте или ситуации, где это возможно или необходимо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "везде",
                                "target_lang_sense_clarification": "во всех возможных случаях"
                            },
                            {
                                "target_lang_word": "повсюду",
                                "target_lang_sense_clarification": "во всех местах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0302768d-0bab-3e35-a293-4c57d15908fd",
                    "sense_definition": "Used to indicate that the speaker does not know or care about the exact location of a place mentioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unknown_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She lives in a small village called Puddletown, <w>wherever</w> that is.",
                            "target_lang_translations": {
                                "ru": "Она живет в маленькой деревушке под названием Паддлтаун, <w>где бы это ни было</w>."
                            }
                        },
                        {
                            "text": "He moved to a town in the north, <w>wherever</w> that might be.",
                            "target_lang_translations": {
                                "ru": "Он переехал в город на севере, <w>где бы это ни было</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wherever that is"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to dismiss the importance of the location"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы показать, что говорящий не знает или его не волнует точное местоположение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "где бы это ни было",
                                "target_lang_sense_clarification": "безразличие к точному месту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "29a9f886-5a0f-3764-b955-676127fd9826",
                    "sense_definition": "In or to any place at all; used as a one-word answer or at the end of a sentence to show indifference.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "any_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Where do you want to have lunch? — <w>Wherever</w>; I do not mind.",
                            "target_lang_translations": {
                                "ru": "Где ты хочешь пообедать? — <w>Где угодно</w>, я не против."
                            }
                        },
                        {
                            "text": "I do not care what you do with the box; just put it <w>wherever</w>.",
                            "target_lang_translations": {
                                "ru": "Мне все равно, что ты сделаешь с коробкой; просто поставь ее <w>куда угодно</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "just put it wherever"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken English to show lack of preference"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В любое место вообще; используется как краткий ответ для выражения безразличия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куда угодно",
                                "target_lang_sense_clarification": "без разницы куда"
                            },
                            {
                                "target_lang_word": "где угодно",
                                "target_lang_sense_clarification": "без разницы где"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8063fff-4914-3d8b-9eef-5b7b0a32f75b",
                    "sense_definition": "The place, no matter where it is, in or to which something happens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regardless_of_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is finally back from <w>wherever</w> he has been hiding all week.",
                            "target_lang_translations": {
                                "ru": "Он наконец-то вернулся <w>оттуда, где</w> скрывался всю неделю."
                            }
                        },
                        {
                            "text": "You should go home to <w>wherever</w> you belong.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит вернуться домой, <w>туда, где</w> твое место."
                            }
                        }
                    ],
                    "common_phrases": [
                        "from wherever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, независимо от того, где оно находится, в котором что-то происходит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откуда бы ни",
                                "target_lang_sense_clarification": "из любого места"
                            },
                            {
                                "target_lang_word": "туда, где",
                                "target_lang_sense_clarification": "в то место, где"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2abd643e-85b2-32a2-ae90-79017f892a6b",
                    "sense_definition": "An emphatic form of the word <w>where</w>, used to express surprise or confusion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wherever</w> have you been all my life?",
                            "target_lang_translations": {
                                "ru": "<w>Где же</w> ты был всю мою жизнь?"
                            }
                        },
                        {
                            "text": "<w>Wherever</w> did you find such a beautiful antique vase?",
                            "target_lang_translations": {
                                "ru": "<w>Где же</w> ты нашел такую красивую антикварную вазу?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wherever have you been"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used for emphasis in questions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмфатическая форма слова «где», используемая для выражения удивления или замешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "где же",
                                "target_lang_sense_clarification": "усиленное вопросительное где"
                            },
                            {
                                "target_lang_word": "куда же",
                                "target_lang_sense_clarification": "усиленное вопросительное куда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}