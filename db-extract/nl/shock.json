                                                "sense_id": "96aaef9e-6f9b-3a9c-a805-6b73a65c8f5e",
                                                "text": "The train hit the buffers with a great shock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f1484dd-e0dc-39d4-a438-59fac10223dd",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "Something so surprising that it is stunning."
