                "senses": [
                    {
                        "sense_id": "c5955d9d-db0b-336f-8321-d8b5f949279b",
                        "entry_id": "698801fb-2948-3441-8616-c1a3eb3333b8",
                        "glosses": [
                            "die Zeit vor dem Erdzeitalter des Kambriums und damit eine zusammenfassende Bezeichnung für die erdgeschichtlichen Äonen Hadaikum, Archaikum und Proterozoikum (von circa 4600 bis etwa 542 Millionen Jahren vor heute)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7094110e-29eb-405f-83ad-5cd98b00cb3e",
                                "sense_id": "c5955d9d-db0b-336f-8321-d8b5f949279b",
                                "text": "„Das Präkambrium umfasst eine Zeitdauer von rund 4 Milliarden Jahren …, vom Zeitpunkt der Entstehung der Erde vor ca. 4,55 Milliarden Jahren … bis zum Beginn des Kambriums vor ca. 542 Millionen Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae3241be-8e75-4a2d-b51a-83f851555ae7",
                        "source_entry_id": "698801fb-2948-3441-8616-c1a3eb3333b8",
                        "source_sense_id": "c5955d9d-db0b-336f-8321-d8b5f949279b",
                        "target_lang_word": "Precambrian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Precambrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c09933c0-752c-3140-8deb-44604717463b",
                                        "entry_id": "2c168686-ece7-3a9b-9e2a-296bba71cabc",
                                        "glosses": [
                                            "Relating to the time and geology dated before the Phanerozoic"
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc7aa82c-db41-4cee-8f04-8ebaa594d66a",
                                                "sense_id": "c09933c0-752c-3140-8deb-44604717463b",
                                                "text": "When you look at a Precambrian trilobite in the lobby of a New York bank, it is difficult to speculate about its primeval environment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Precambrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e715ce-44ce-30b5-9bcf-ac374ad5ac3a",
                                        "entry_id": "6a7f6351-b825-30ef-a656-f908f832f423",
                                        "glosses": [
                                            "The Precambrian supereon; spanning from the formation of the Earth around 4.6 billion years ago to the emergence of hard-shelled creatures 541 million years ago."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
