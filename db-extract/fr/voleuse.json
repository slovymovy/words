                "senses": [
                    {
                        "sense_id": "0bd03961-c0f2-3c0c-9282-08e1c8f04dc6",
                        "entry_id": "7ecf18d4-00ba-34be-956e-7c64a93464d7",
                        "glosses": [
                            "Celle qui effectue un vol, qui dérobe, s'approprie le bien d’autrui, ou l’a déjà fait."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "414d2d8e-b9df-3c17-9b5d-b030a8e4c726",
                        "entry_id": "7ecf18d4-00ba-34be-956e-7c64a93464d7",
                        "glosses": [
                            "Personne morale effectuant un vol (des sociétés, des entreprises ou encore des gouvernements)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4e6f5e68-2321-3b8f-8d44-71a6960b6050",
                        "entry_id": "7ecf18d4-00ba-34be-956e-7c64a93464d7",
                        "glosses": [
                            "Celle qui exige plus qu’elle ne devrait demander."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "400b065a-0ad4-3a44-84dc-36705a52e0af",
                        "entry_id": "7ecf18d4-00ba-34be-956e-7c64a93464d7",
                        "glosses": [
                            "Être vivant dont les actes sont interprétés comme du vol."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ad5906e1-a039-457e-aa57-8b5c1df149f7",
                                "sense_id": "400b065a-0ad4-3a44-84dc-36705a52e0af",
                                "text": "La hyène est souvent considérée comme une voleuse, car elle tente parfois de s’accaparer des proies tuées par d’autres animaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0ee9ae8-9cbd-4e89-bcc8-28d8819c843a",
                        "source_entry_id": "7ecf18d4-00ba-34be-956e-7c64a93464d7",
                        "target_lang_word": "Taschendiebin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschendiebin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be5cde78-6e1c-3f1f-ad54-06f1bc414c35",
                                        "entry_id": "d835e601-879e-3b9e-9149-d7ea49ad56a3",
                                        "glosses": [
                                            "weibliche Person, die fremde bewegliche Sachen, die sich im unmittelbaren Einflussbereich einer anderen Person befinden, entwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6244143a-532b-4746-ab38-6d356d895fb2",
                                                "sense_id": "be5cde78-6e1c-3f1f-ad54-06f1bc414c35",
                                                "text": "Im Vorbeigehen stieß die Taschendiebin gegen den Passanten und entwendete ihm dabei seine Brieftasche."
                                            },
                                            {
                                                "example_id": "975770f3-9215-4108-ad85-2e4fafa0abab",
                                                "sense_id": "be5cde78-6e1c-3f1f-ad54-06f1bc414c35",
                                                "text": "„Dann waren die Magistrate an der Reihe, sich mit den Taschendiebinnen, Ladendiebinnen, Prostituierten und Handtaschenräuberinnen zu befassen, von denen jede eine tragische Geschichte von erlittener Not und dem Kampf ums nackte Überleben zu erzählen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9919d3ce-2c5f-4330-8950-2d54be9b3999",
                        "source_entry_id": "7ecf18d4-00ba-34be-956e-7c64a93464d7",
                        "target_lang_word": "pickpocket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pickpocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97786186-3d23-38cf-aa96-e8d80bd40fdb",
                                        "entry_id": "5702bfae-f19f-315e-b455-9eb57e9722f1",
                                        "glosses": [
                                            "One who steals from the pocket of a passerby, usually by sleight of hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab79c103-6a21-4238-8f38-37a08ead5532",
                                                "sense_id": "97786186-3d23-38cf-aa96-e8d80bd40fdb",
                                                "text": "Old men, young men, and boys, stalwart burglars and highway robbers, slept side by side with wizened pickpockets or cunning-featured area-sneaks."
                                            },
                                            {
                                                "example_id": "8d4c3f94-7d42-4bac-b874-f4bbc09f4067",
                                                "sense_id": "97786186-3d23-38cf-aa96-e8d80bd40fdb",
                                                "text": "For several days, Mr. Sammler returning on the customary bus late afternoons from the Forty-second Street Library had been watching a pickpocket at work […] Mr. Sammler if he had not been a tall straphanger would not with his one good eye have seen these things happening."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pickpocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1404c2a-c654-3926-922c-ef1eec6e26f4",
                                        "entry_id": "ab9df8f4-72ce-332e-a616-5cef0a339b3a",
                                        "glosses": [
                                            "To pick pockets; to steal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19e4b45-c7a2-42fa-857b-1bf03e7f2f1c",
                                                "sense_id": "d1404c2a-c654-3926-922c-ef1eec6e26f4",
                                                "text": "Vodafone has also dropped its claim against one of Rhys Edwards’s travelling companions – who had been at the same reunion and had his phone pickpocketed two hours later in almost identical circumstances to Rhys Edwards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
