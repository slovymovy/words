                    "sense_definition": "iemand of iets met zich meenemen, vaak door een fysieke kracht of tijdens een reis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meenemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke stroming van de rivier kon de kleine takjes gemakkelijk <w>meevoeren</w> naar de zee.",
                            "target_lang_translations": {
                                "en": "The strong current of the river could easily <w>carry</w> the small twigs <w>along</w> to the sea."
                            }
                        },
                        {
                            "text": "De soldaten besloten de gevangenen in ketenen <w>mee</w> te <w>voeren</w> naar het kamp.",
                            "target_lang_translations": {
                                "en": "The soldiers decided to <w>lead</w> the prisoners <w>away</w> to the camp in chains."
                            }
                        }
                    ],
                    "synonyms": [
                        "meenemen",
                        "meeslepen"
                    ],
                    "antonyms": [
                        "achterlaten"
                    ],
                    "common_phrases": [
                        "stroom meevoeren",
                        "gevangenen meevoeren",
                        "met zich meevoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To take someone or something along, often by physical force, a current, or during a journey."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carry along",
                                "target_lang_sense_clarification": "by a current or flow"
                            },
                            {
                                "target_lang_word": "take along",
                                "target_lang_sense_clarification": "on a journey or trip"
                            },
                            {
                                "target_lang_word": "sweep away",
                                "target_lang_sense_clarification": "by water or wind"
                            },
                            {
                                "target_lang_word": "lead away",
                                "target_lang_sense_clarification": "as prisoners or captives"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f21a6ef4-ed95-3068-b63c-b6fb3c32d905",
                    "sense_definition": "meervoud verleden tijd van <w>meevaren</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een prachtige ervaring toen wij die middag op de grote boot <w>meevoeren</w>.",
                            "target_lang_translations": {
                                "en": "It was a wonderful experience when we <w>sailed along</w> on the large boat that afternoon."
                            }
                        },
                        {
                            "text": "Zij vertelden dat zij vorig jaar met de plezierboot <w>meevoeren</w> over de grachten.",
                            "target_lang_translations": {
                                "en": "They said that they <w>traveled along</w> the canals by pleasure boat last year."
                            }
                        }
                    ],
