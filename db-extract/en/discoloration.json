                    {
                        "translation_id": "82f7cc13-45a4-47d9-9daf-7c832fff461b",
                        "source_entry_id": "38086a7d-1e67-3a70-9279-cfee78a98237",
                        "source_sense_description": "discoloured spot",
                        "target_lang_word": "Fleck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fleck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a880da5c-1135-35f7-99cf-3ed08e2fbe96",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "Stelle, die verschmutzt (und schlecht^([1])) ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70fc0702-504c-4c75-8397-5697959e71f0",
                                                "sense_id": "a880da5c-1135-35f7-99cf-3ed08e2fbe96",
                                                "text": "„Er konnte die Flecken erkennen, wo der Verputz abgefallen war.“"
                                            },
                                            {
                                                "example_id": "3ac92aaf-8c4f-4f2c-94e7-55eb560eb039",
                                                "sense_id": "a880da5c-1135-35f7-99cf-3ed08e2fbe96",
                                                "text": "Mein Kleid hat einen Fleck und muss zur Reinigung/gewaschen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5759bc8c-77de-3f68-bc8f-1aa6f10ed29a",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "Stelle, die andersfarbig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4b99db-a5d6-4a28-bf0a-33f9429024cd",
                                                "sense_id": "5759bc8c-77de-3f68-bc8f-1aa6f10ed29a",
                                                "text": "Sein neuestes Kunstwerk ist eine blau gestrichene Regentonne mit drei rosafarbenen Flecken."
                                            },
                                            {
                                                "example_id": "f9d343f3-5598-4640-aa65-9d116ea2eaac",
                                                "sense_id": "5759bc8c-77de-3f68-bc8f-1aa6f10ed29a",
                                                "text": "„Ihre Augen waren gerötet, und um die Augen herum hatte sich die Wimperntusche in schwarzen ungeordneten Flecken ausgebreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "794341d1-69a1-3f14-b340-5f1b04efc12c",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "bestimmter Ort oder Stelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a991a85c-4816-4473-a962-9ece66674cd2",
                                                "sense_id": "794341d1-69a1-3f14-b340-5f1b04efc12c",
                                                "text": "Seit Jahren treffen sie sich am selben Fleck."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cb864e71-caef-392e-928a-ef83828be104",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "zum Verzehr gedachte Streifen aus dem Vormagen von Wiederkäuern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4851a0d4-bcf3-4593-88af-daa7a6a45dab",
                                                "sense_id": "cb864e71-caef-392e-928a-ef83828be104",
                                                "text": "Die Flecken schmecken heute besonders gut."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1b09d69b-bd05-3c3c-a3b4-a1992464aa05",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "die Schulnote 5 (nicht genügend)"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43407ac4-12fa-442b-80c8-ab15280d24dd",
                                                "sense_id": "1b09d69b-bd05-3c3c-a3b4-a1992464aa05",
                                                "text": "Er hat schon wieder einen Fleck geschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "565e014d-b620-3716-a2b8-3a0b7dce7468",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "ein (rundes oder eckiges) Stück Material, oft auch für Verbesserungen/Reparaturen verwendet, oft auch auf Speisen anwendbar (siehe Wortbildungen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8849aa6-1717-4854-8f52-96aebfea17d1",
                                                "sense_id": "565e014d-b620-3716-a2b8-3a0b7dce7468",
                                                "text": "Sie näht ihm immer noch die Flecken über die Löcher in seiner Hose."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fleck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c410bbe4-8c6e-302e-9b83-780b36604929",
                                        "entry_id": "b22cad3a-26ca-303c-86b9-205d34edaa32",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2625c58e-c3bc-4387-b22e-c15174b893b5",
                                                "sense_id": "c410bbe4-8c6e-302e-9b83-780b36604929",
                                                "text": "Herr Fleck ist als Kaninchenzüchter erfolgreich."
                                            },
                                            {
                                                "example_id": "2315963b-86d8-42b1-b779-21c3dddcf065",
                                                "sense_id": "c410bbe4-8c6e-302e-9b83-780b36604929",
                                                "text": "Herr Fleck heiratet im September auf Hawaii."
                                            },
                                            {
                                                "example_id": "9c9e1157-af6a-4647-844e-80bf80550684",
                                                "sense_id": "c410bbe4-8c6e-302e-9b83-780b36604929",
                                                "text": "Frau Fleck liebt es, an Weihnachten Plätzchen zu backen."
                                            },
                                            {
                                                "example_id": "d463602b-ec31-41b2-8929-81e7b4204aeb",
                                                "sense_id": "c410bbe4-8c6e-302e-9b83-780b36604929",
                                                "text": "Die Flecks lieben die Natur und die Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b04bca0-ef4c-48d3-a885-379de673e054",
                        "source_entry_id": "38086a7d-1e67-3a70-9279-cfee78a98237",
                        "source_sense_description": "discoloured spot",
                        "target_lang_word": "Blutfleck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutfleck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                        "entry_id": "416d2da8-48c9-3d9d-a105-f43bcb4d5cb1",
                                        "glosses": [
                                            "sichtbarer Rückstand von Blut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b322d19-f263-43c9-bdcc-edc9ed39f0fb",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Und damit wir bloß nicht davon reden, zeigt sie uns noch mal die beiden Litewkas ihrer beiden Söhne, die hat sie extra mitgebracht, zeigt uns die Schußlöcher und die Blutflecke im Schein der Kerze, ganz nah, immer näher…“"
                                            },
                                            {
                                                "example_id": "2d77dda8-67e7-4304-bf73-d5747d7fdedc",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Ein großer Blutfleck auf der Brust sagte mir, daß es mit ihm zu Ende ging.“"
                                            },
                                            {
                                                "example_id": "546f0e01-3348-4800-86ab-c01aa47da0ea",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Als Hamid auf die Straße trat, waren die Blutflecke noch da.“"
                                            },
                                            {
                                                "example_id": "0e02e06f-21c2-4a03-94eb-e92c682e83d0",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Die kleine Welt unter dem Munitionswagen war nicht untergegangen, er konnte die Glieder bewegen, fand keine Blutflecken am Körper, keine Blutlachen im Gras.“"
                                            },
                                            {
                                                "example_id": "28023bec-c861-42c1-a1e3-4ddf0559b507",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Das Pflaster war abgespritzt worden, doch wo Moss angeschossen worden war, konnte man noch Blutflecken auf dem Beton des Bürgersteigs sehen.“"
                                            },
                                            {
                                                "example_id": "ae054a7b-cae9-4323-9bc9-3ba6cd3dd6b2",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Erst als er den Hörer wieder auflegte, bemerkte er die Blutflecken am Boden direkt vor der Arbeitsfläche.“"
                                            },
                                            {
                                                "example_id": "49e246c2-c222-4c2c-9c59-8654022eef62",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Ich pisse in meine schwarze Hose mit den eingetrockneten Blutflecken, die mein Chef nicht ertragen kann.“"
                                            },
                                            {
                                                "example_id": "d236e1dd-7be4-49b5-a1bd-711b62aa1b79",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Fragt mich doch mal, wie man Blutflecken aus einem Pelzmantel entfernt.“"
                                            },
                                            {
                                                "example_id": "7ed2adc4-278d-4597-8174-bfb719331c28",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Die Feuerwehr spült mit dem Schlauch die Blutflecken weg, die Labortechniker fahren zu ihrem nächsten Einsatzort, und das Viertel erobert sich das Stückchen Asphalt zurück.“"
                                            },
                                            {
                                                "example_id": "7fe0f18e-0699-426a-8f8b-f690756a7385",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Und er hat mir beigebracht, wie man Blutflecken beseitigt.“"
                                            },
                                            {
                                                "example_id": "d4440bfc-7732-44fd-ab00-3d1aea6f6699",
                                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                                "text": "„Für einen Vierteldollar konnte Randall sich beim Anblick der Blutflecke auf den Sitzen gruseln und seine Finger in die Einschusslöcher stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c68b2cc3-bae3-4e4f-a143-41f270341d45",
                        "source_entry_id": "38086a7d-1e67-3a70-9279-cfee78a98237",
                        "source_sense_description": "discoloured spot",
                        "target_lang_word": "Kaffeefleck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaffeefleck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26913997-c293-34a6-8730-f28cf76d0033",
                                        "entry_id": "b30bd588-8c6f-3740-8561-4caf2aa1a42f",
                                        "glosses": [
                                            "ungewollter, sichtbarer Rückstand/Fleck von Kaffee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac93c9a-a611-40be-8abc-35591de43f41",
                                                "sense_id": "26913997-c293-34a6-8730-f28cf76d0033",
                                                "text": "„Der Kaffeefleck auf dem Boden war schwarz wie getrocknetes Blut.“"
                                            },
                                            {
                                                "example_id": "38ba31e8-abea-41f8-a12f-a221504b455e",
                                                "sense_id": "26913997-c293-34a6-8730-f28cf76d0033",
                                                "text": "„Sie versuchte vergeblich, einen Kaffeefleck zu verdecken, den sie am Morgen übersehen hatte, den sie jetzt aber bemerkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
