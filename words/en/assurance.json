{
    "word_family": [
        "assure",
        "assured",
        "assuredly",
        "reassurance",
        "reassure"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40addcc9-d06b-3fc1-8051-c3101888e978",
                    "sense_definition": "A statement or promise intended to give confidence or remove doubt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave an <w>assurance</w> that the project would be finished on time.",
                            "target_lang_translations": {
                                "ru": "Менеджер дал <w>заверение</w>, что проект будет завершен вовремя.",
                                "de": "Der Manager gab die <w>Zusicherung</w>, dass das Projekt pünktlich fertiggestellt würde."
                            }
                        },
                        {
                            "text": "Despite his repeated <w>assurances</w>, I still felt worried about the outcome.",
                            "target_lang_translations": {
                                "ru": "Несмотря на его неоднократные <w>уверения</w>, я все еще беспокоился об исходе дела.",
                                "de": "Trotz seiner wiederholten <w>Versicherungen</w> war ich wegen des Ergebnisses immer noch besorgt."
                            }
                        }
                    ],
                    "synonyms": [
                        "promise",
                        "guarantee",
                        "pledge",
                        "vow",
                        "word"
                    ],
                    "common_phrases": [
                        "give an assurance",
                        "seek assurance",
                        "receive assurances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или обещание, призванное вселить уверенность или развеять сомнения.",
                        "de": "Eine Aussage oder ein Versprechen, das dazu dient, Vertrauen zu schaffen oder Zweifel auszuräumen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заверение",
                                "target_lang_sense_clarification": "обещание"
                            },
                            {
                                "target_lang_word": "уверение",
                                "target_lang_sense_clarification": "убеждение"
                            },
                            {
                                "target_lang_word": "гарантия",
                                "target_lang_sense_clarification": "твердое обещание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zusicherung",
                                "target_lang_sense_clarification": "verbindliches Versprechen"
                            },
                            {
                                "target_lang_word": "Versicherung",
                                "target_lang_sense_clarification": "nachdrückliche Bestätigung"
                            },
                            {
                                "target_lang_word": "Garantie",
                                "target_lang_sense_clarification": "Sicherheit oder Gewähr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0589d0f9-0141-3196-a25d-76432c20b5f2",
                    "sense_definition": "Confidence in one's own abilities, qualities, or manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confidence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She answered the difficult interview questions with calm <w>assurance</w>.",
                            "target_lang_translations": {
                                "ru": "Она отвечала на сложные вопросы интервью со спокойной <w>уверенностью</w>.",
                                "de": "Sie beantwortete die schwierigen Fragen im Vorstellungsgespräch mit ruhiger <w>Selbstsicherheit</w>."
                            }
                        },
                        {
                            "text": "The young musician played the piano with great <w>assurance</w> and skill.",
                            "target_lang_translations": {
                                "ru": "Молодой музыкант играл на пианино с большой <w>уверенностью</w> и мастерством.",
                                "de": "Der junge Musiker spielte das Klavier mit großer <w>Selbstsicherheit</w> und Geschick."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-confidence",
                        "poise",
                        "composure",
                        "aplomb"
                    ],
                    "antonyms": [
                        "insecurity",
                        "nervousness",
                        "doubt"
                    ],
                    "common_phrases": [
                        "with assurance",
                        "calm assurance",
                        "self-assurance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уверенность в своих силах, качествах или манере поведения.",
                        "de": "Vertrauen in die eigenen Fähigkeiten, Qualitäten oder das eigene Auftreten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенность",
                                "target_lang_sense_clarification": "в себе"
                            },
                            {
                                "target_lang_word": "самообладание",
                                "target_lang_sense_clarification": "спокойствие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Selbstsicherheit",
                                "target_lang_sense_clarification": "sich seiner Kräfte sicher sein"
                            },
                            {
                                "target_lang_word": "Selbstvertrauen",
                                "target_lang_sense_clarification": "Glaube an das eigene Können"
                            },
                            {
                                "target_lang_word": "Zuversicht",
                                "target_lang_sense_clarification": "fester Glaube an einen positiven Ausgang"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d2177c-59d6-3170-ac26-7fcbebca11fa",
                    "sense_definition": "The state of being certain that something is true or will happen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confidence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>assurance</w> that the weather will stay nice for the weekend.",
                            "target_lang_translations": {
                                "ru": "Нет никакой <w>гарантии</w>, что погода останется хорошей на выходные.",
                                "de": "Es gibt keine <w>Garantie</w>, dass das Wetter am Wochenende schön bleibt."
                            }
                        },
                        {
                            "text": "We have the <w>assurance</w> of knowing that we did everything we could.",
                            "target_lang_translations": {
                                "ru": "У нас есть <w>уверенность</w> от осознания того, что мы сделали все, что могли.",
                                "de": "Wir haben die <w>Gewissheit</w>, dass wir alles getan haben, was wir konnten."
                            }
                        }
                    ],
                    "synonyms": [
                        "certainty",
                        "conviction",
                        "guarantee"
                    ],
                    "antonyms": [
                        "uncertainty",
                        "doubt"
                    ],
                    "common_phrases": [
                        "no assurance",
                        "reasonable assurance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние уверенности в том, что что-то истинно или обязательно произойдет.",
                        "de": "Der Zustand der Gewissheit, dass etwas wahr ist oder eintreten wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарантия",
                                "target_lang_sense_clarification": "ручательство"
                            },
                            {
                                "target_lang_word": "уверенность",
                                "target_lang_sense_clarification": "отсутствие сомнений"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gewissheit",
                                "target_lang_sense_clarification": "gesichertes Wissen"
                            },
                            {
                                "target_lang_word": "Sicherheit",
                                "target_lang_sense_clarification": "Abwesenheit von Zweifeln"
                            },
                            {
                                "target_lang_word": "Garantie",
                                "target_lang_sense_clarification": "Rückversicherung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "101f1e39-a7c5-3687-9a30-1903967d8901",
                    "sense_definition": "Financial protection against events that are certain to happen, such as death; specifically life insurance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to take out a life <w>assurance</w> policy to protect his family.",
                            "target_lang_translations": {
                                "ru": "Он решил оформить полис <w>страхования</w> жизни, чтобы защитить свою семью.",
                                "de": "Er entschied sich für eine <w>Lebensversicherung</w>, um seine Familie abzusichern."
                            }
                        },
                        {
                            "text": "The <w>assurance</w> company will pay a lump sum when the policy matures.",
                            "target_lang_translations": {
                                "ru": "<w>Страховая</w> компания выплатит единовременную сумму по истечении срока действия полиса.",
                                "de": "Die <w>Versicherungsgesellschaft</w> zahlt bei Fälligkeit der Police eine Pauschalsumme aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "insurance"
                    ],
                    "common_phrases": [
                        "life assurance"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовая защита от событий, которые неизбежно произойдут (обычно о страховании жизни).",
                        "de": "Finanzielle Absicherung gegen Ereignisse, die sicher eintreten, wie z. B. der Tod; insbesondere Lebensversicherung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страхование",
                                "target_lang_sense_clarification": "жизни"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lebensversicherung",
                                "target_lang_sense_clarification": "Absicherung für den Todesfall"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33da99e4-e5b6-399c-8ef2-192b0d8aae2f",
                    "sense_definition": "Excessive boldness or rude behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was shocked that he had the <w>assurance</w> to ask for more money.",
                            "target_lang_translations": {
                                "ru": "Я был шокирован тем, что у него хватило <w>наглости</w> попросить больше денег.",
                                "de": "Ich war schockiert, dass er die <w>Dreistigkeit</w> besaß, nach mehr Geld zu fragen."
                            }
                        },
                        {
                            "text": "Her <w>assurance</w> in criticizing the boss surprised everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Её <w>самоуверенность</w> при критике начальника удивила всех в комнате.",
                                "de": "Ihre <w>Frechheit</w>, den Chef zu kritisieren, überraschte alle im Raum."
                            }
                        }
                    ],
                    "synonyms": [
                        "audacity",
                        "impudence",
                        "nerve",
                        "cheek"
                    ],
                    "antonyms": [
                        "modesty",
                        "timidity"
                    ],
                    "common_phrases": [
                        "have the assurance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерная смелость или грубое поведение.",
                        "de": "Übermäßige Kühnheit oder unverschämtes Verhalten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "дерзость"
                            },
                            {
                                "target_lang_word": "самоуверенность",
                                "target_lang_sense_clarification": "излишняя смелость"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Dreistigkeit",
                                "target_lang_sense_clarification": "unverschämte Art"
                            },
                            {
                                "target_lang_word": "Frechheit",
                                "target_lang_sense_clarification": "respektloses Verhalten"
                            },
                            {
                                "target_lang_word": "Anmaßung",
                                "target_lang_sense_clarification": "unberechtigte Überheblichkeit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}