                "senses": [
                    {
                        "sense_id": "bf3cf08a-4e03-3104-aa55-b12ce6fd83fb",
                        "entry_id": "97e5dc47-affe-347b-84bb-ee7384e406b0",
                        "glosses": [
                            "mit sehr vielen Geschäften umsäumte Straße einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8c2c13-2601-4b7c-b28c-df01e8ca4fe3",
                                "sense_id": "bf3cf08a-4e03-3104-aa55-b12ce6fd83fb",
                                "text": "„Denn die autofreie Shoppingmeile in der Altstadt ist nicht nur besonders schön, sondern auch besonders lang.“"
                            },
                            {
                                "example_id": "60b100c5-c6b6-4c88-b6d3-f5ef8c94fe4d",
                                "sense_id": "bf3cf08a-4e03-3104-aa55-b12ce6fd83fb",
                                "text": "„Sie sterben nicht aus, aber viele Innenstädte werden keine reinen Shoppingmeilen mehr sein.“"
                            },
                            {
                                "example_id": "d23a862d-ccf9-4ee7-b2b7-2d297f9148dc",
                                "sense_id": "bf3cf08a-4e03-3104-aa55-b12ce6fd83fb",
                                "text": "„Der Drewespark Wismar, benannt in Anlehnung an das angrenzende Dreweswäldchen, soll die größte Shoppingmeile der Stadt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
