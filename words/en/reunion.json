{
    "word_family": [
        "reunite",
        "reunition"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f8d1e0d-73cc-38da-b1bf-472d887bf321",
                    "sense_definition": "A planned social event where people who have been separated or belong to a specific group meet again.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am really looking forward to attending my high-school <w>reunion</w> next month.",
                            "target_lang_translations": {
                                "ru": "Я очень жду возможности сходить на <w>встречу</w> выпускников моей школы в следующем месяце.",
                                "zh": "我非常期待下个月参加高中的同学<w>聚会</w>。"
                            }
                        },
                        {
                            "text": "The family <w>reunion</w> was held at a large park so everyone could bring their children.",
                            "target_lang_translations": {
                                "ru": "Семейная <w>встреча</w> прошла в большом парке, чтобы все могли взять с собой детей.",
                                "zh": "家庭<w>聚会</w>在一个大公园举行，这样每个人都可以带上自己的孩子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "family reunion",
                        "high-school reunion",
                        "class reunion",
                        "annual reunion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированное общественное мероприятие, на котором снова встречаются люди, которые были разлучены или принадлежат к определенной группе.",
                        "zh": "一种有计划的社交活动，让曾经分开或属于特定群体的人们再次相聚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "выпускников, родственников или друзей"
                            },
                            {
                                "target_lang_word": "вечер встречи",
                                "target_lang_sense_clarification": "традиционное мероприятие выпускников"
                            },
                            {
                                "target_lang_word": "слёт",
                                "target_lang_sense_clarification": "собрание членов организации или единомышленников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聚会",
                                "target_lang_sense_clarification": "指亲友、同学或同事的聚会"
                            },
                            {
                                "target_lang_word": "重聚",
                                "target_lang_sense_clarification": "指再次相聚的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d487e215-9a5d-322f-933b-3a3df35f5764",
                    "sense_definition": "The act or process of coming together again after being separated for a long time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a tearful and heartfelt <w>reunion</w> as the trapped miners finally saw their dear loved ones again.",
                            "target_lang_translations": {
                                "ru": "Это было слезное и искреннее <w>воссоединение</w>, когда заблокированные шахтеры наконец снова увидели своих близких.",
                                "zh": "当被困的矿工们终于再次见到他们亲爱的家人时，那是一场令人热泪盈眶的深情<w>团聚</w>。"
                            }
                        },
                        {
                            "text": "The emotional <w>reunion</w> between the mother and her long-lost son was captured on video.",
                            "target_lang_translations": {
                                "ru": "Эмоциональное <w>воссоединение</w> матери и ее давно потерянного сына было запечатлено на видео.",
                                "zh": "母亲与失散多年的儿子之间感人的<w>重逢</w>被录像记录了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reunition"
                    ],
                    "antonyms": [
                        "separation",
                        "parting"
                    ],
                    "common_phrases": [
                        "emotional reunion",
                        "tearful reunion",
                        "joyful reunion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс воссоединения после долгой разлуки.",
                        "zh": "长期分离后再次团聚的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воссоединение",
                                "target_lang_sense_clarification": "процесс или результат объединения"
                            },
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "момент свидания после разлуки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "团聚",
                                "target_lang_sense_clarification": "指亲人或长期分离的人重新聚在一起"
                            },
                            {
                                "target_lang_word": "重逢",
                                "target_lang_sense_clarification": "指再次相见"
                            }
                        ]
                    }
                }
            ]
        },
        {
