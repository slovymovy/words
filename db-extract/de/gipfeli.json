                "senses": [
                    {
                        "sense_id": "f515e94d-3d16-3207-8298-999739f30f5c",
                        "entry_id": "57cb155d-f017-3cc3-a114-ad64358c20ed",
                        "glosses": [
                            "synonym of Croissant"
                        ],
                        "tags": [
