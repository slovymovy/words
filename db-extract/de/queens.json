                "senses": [
                    {
                        "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                        "entry_id": "019eb14e-b704-3851-b8b8-c23d5a8f5aa7",
                        "glosses": [
                            "Stadtbezirk von New York City"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cb7d42c-278c-4135-b3f7-733b93be5ea8",
                                "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                                "text": "„Während Algernon und Dr. Imbert mit der U-Bahn zu Roger Littles Residenz im Stadtteil Queens fuhren, wurde der Welt der Schrecken kundgetan.“"
                            },
                            {
                                "example_id": "046dc0ff-65db-4d24-8ff1-f70969c499ba",
                                "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                                "text": "„Costello sowie Vincent Rao und ein weiterer Spitzbube hatten in einem Park in Queens jemanden um hundert Dollar erleichtert... ... direkt vor der Nase eines Streifenpolizisten.“"
                            },
                            {
                                "example_id": "8a665584-e61f-4315-b23a-e59d7f38b97a",
                                "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                                "text": "„Walter hatte dem Taxifahrer eine Adresse in Queens genannt, einige Blocks von der Stelle entfernt, wo er seinen Mietwagen abgestellt hatte.“"
                            },
                            {
                                "example_id": "a743495e-e875-437a-b327-00576b84c405",
                                "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                                "text": "„Mein Vater arbeitete im fünfunddreißigsten Stock des UN-Hauptquartiers in einem Büro mit Panoramablick auf den East River und Queens.“"
                            },
                            {
                                "example_id": "b29a3c5c-f8cd-418b-a6e7-23f30a607a58",
                                "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                                "text": "„Ich bin in Brooklyn, New York, geboren, nahe der Grenze zu Queens.“"
                            },
                            {
                                "example_id": "2e18c9d2-ae61-4501-b5da-ce7ba2d6c81e",
                                "sense_id": "cc47f2c1-45b4-31b9-a41a-a535ec99275b",
                                "text": "„Dabei hatte er übersehen, dass die Iren längst nach Queens abgewandert waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
