                "senses": [
                    {
                        "sense_id": "69b67fab-143e-3eab-bc1c-12ca9cbd30ec",
                        "entry_id": "8823387a-08ec-3dca-929e-8ae74b11e407",
                        "glosses": [
                            "Donner un caractère de trinité à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6443c177-2ee8-495f-a458-0f86d54b29d8",
                                "sense_id": "69b67fab-143e-3eab-bc1c-12ca9cbd30ec",
                                "text": "Senghor a autant d’admirateurs que de détracteurs et seul le souci panafricain de « trinitiser » nos politiciens a réduit ceux-ci au silence et permis à ceux-là de multiplier des bilans monocordes et dépourvus de passif."
                            },
                            {
                                "example_id": "f41b8bcc-9336-4b27-9124-f041c83f9189",
                                "sense_id": "69b67fab-143e-3eab-bc1c-12ca9cbd30ec",
                                "text": "Mais la face elle-même est faite de deux profils, ce qui fait que tous les traits se trinitisent et il y a un impressionnisme qui joue et où l’expressionnisme est donné dans le baptême de l’expression."
                            }
                        ]
                    }
