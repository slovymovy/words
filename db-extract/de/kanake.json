                "senses": [
                    {
                        "sense_id": "30c17cf8-cd4c-3675-8c5c-955cf9be2cb2",
                        "entry_id": "57830533-ffb4-31d7-a616-8a39078ad5f3",
                        "glosses": [
                            "A kanaka; a South Sea Islander."
                        ],
                        "tags": [
                            "masculine",
                            "weak"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "051dc10a-f249-3848-acd6-827fcc0027e0",
                        "entry_id": "57830533-ffb4-31d7-a616-8a39078ad5f3",
                        "glosses": [
                            "Any dark-skinned foreigner."
                        ],
                        "tags": [
                            "derogatory",
                            "ethnic",
                            "masculine",
                            "often",
                            "slur",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "c7cf7e9f-2594-4f74-bd9c-6eac82248c9c",
                                "sense_id": "051dc10a-f249-3848-acd6-827fcc0027e0",
                                "text": "Wie lebt es sich als Kanake in Deutschland, war die Frage, die ich mir und anderen gestellt habe. Kanake, ein Etikett, das nach mehr als 30 Jahren Immigrationsgeschichte von Türken nicht nur Schimpfwort ist, sondern auch ein Name, den »Gastarbeiterkinder« der zweiten und vor allem der dritten Generation mit stolzem Trotz führen.",
                                "translation": "How does it feel to be a Kanake in Germany, was the question I asked myself and others. Kanake, a label that, after more than 30 years of Turkish immigration history, is not only a swearword but also a name that children of “Gastarbeiter” of the second and particularly the third generation carry with proud defiance.",
                                "english": "How does it feel to be a Kanake in Germany, was the question I asked myself and others. Kanake, a label that, after more than 30 years of Turkish immigration history, is not only a swearword but also a name that children of “Gastarbeiter” of the second and particularly the third generation carry with proud defiance."
                            },
                            {
                                "example_id": "21924422-2a30-4df2-9d5a-ec5358831ef6",
                                "sense_id": "051dc10a-f249-3848-acd6-827fcc0027e0",
                                "text": "Da kommt also der gute Kanake, stellt sich mitten rein, und während er sich fragt, warum die Leute so Spalier stehen, wird er im nächsten Moment auf seinen Platz verwiesen. Schließlich gehört jeder irgendwohin und der Kanake am besten[…]",
                                "translation": "So here comes the good Kanake, standing right in the middle, and while wondering why people are standing in line, he is soon pointed to his seat. After all, everyone belongs somewhere, and the Kanake belongs best […]",
                                "english": "So here comes the good Kanake, standing right in the middle, and while wondering why people are standing in line, he is soon pointed to his seat. After all, everyone belongs somewhere, and the Kanake belongs best […]"
                            }
                        ]
                    }
                ],
