                        "glosses": [
                            "bez przerwy, ciągle, przez cały czas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d22662f-a30b-4f0d-a57d-c8a356a27f4e",
                                "sense_id": "8248f242-83b8-384e-a72a-fd1dbba14875",
                                "text": "Wentylator gwałtownie grzechocze gdzieś na głównym pokładzie, a teraz nieprzerwanie grzmi bełkotliwym, żwirowatym odgłosem."
                            },
                            {
                                "example_id": "cb6c2623-96c8-445c-b765-e4e2e3fefb42",
                                "sense_id": "8248f242-83b8-384e-a72a-fd1dbba14875",
                                "text": "Arbela to jedno z najstarszych miast na świecie, zamieszkiwane nieprzerwanie od ponad 8000 lat."
                            },
                            {
                                "example_id": "8ca5d4fb-ba7c-49ff-9ca8-fb63e9e831db",
                                "sense_id": "8248f242-83b8-384e-a72a-fd1dbba14875",
                                "text": "Transplantacja włosów polega na pobraniu zespołów mieszków włosowych z obszaru głowy, gdzie włosy rosną nieprzerwanie (okolica dawcza), i wszczepieniu ich w obszary dotknięte łysieniem (okolica biorcza)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
