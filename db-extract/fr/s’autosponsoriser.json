                        "glosses": [
                            "Se sponsoriser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f2c3cb-ef05-461a-b2da-0ac65410d690",
                                "sense_id": "948f9a2b-9186-3b4d-bd17-1c2e30e4eba7",
                                "text": "Mais attention, encore là, le sponsor doit payer la majorité (50%+1). Peut-on s'autosponsoriser ?"
                            },
                            {
                                "example_id": "0c365b32-2a73-4e9d-b7ac-ee0b27feeb9f",
                                "sense_id": "948f9a2b-9186-3b4d-bd17-1c2e30e4eba7",
                                "text": "Maintenant, qu'est ce qui retient un passionné de poker de s'autosponsoriser par le biais de son entreprise et donc de gagner sur les deux tableaux?"
                            },
                            {
                                "example_id": "64fb60cc-0061-4c22-b5ae-153e5f040eb4",
                                "sense_id": "948f9a2b-9186-3b4d-bd17-1c2e30e4eba7",
                                "text": "Je vais aussi tenter de racheter ma colonne pour la revendre par après, mais de sorte que je puisse m'autosponsoriser et exposer !"
                            }
                        ]
                    }
