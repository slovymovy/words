                            {
                                "example_id": "7784a8d9-5edb-4c2d-9c7e-b5231090f6e0",
                                "sense_id": "99f31ed0-5b9f-32f4-a459-fcc70cf1e9c7",
                                "text": "Meer dan twintig jaar speelde tafeltennisser Trinko Keen met hetzelfde batje, maar nu is hij 'm kwijt. Keen is een van de weinige Nederlandse prof-tafeltennissers. Met dit batje speelde hij meerdere keren op de Olympische Spelen."
                            },
                            {
                                "example_id": "80d00785-a534-4222-b1ca-9108d306ff77",
                                "sense_id": "99f31ed0-5b9f-32f4-a459-fcc70cf1e9c7",
                                "text": "Tafeltennissers Rajko Gommers en Kim Vermaas wonnen zaterdag de nationale titel in het gemengd dubbelspel en nu zijn ze in Zwolle allebei ook in het enkelspel Nederlands kampioen geworden."
                            }
