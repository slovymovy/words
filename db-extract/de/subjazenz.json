                "senses": [
                    {
                        "sense_id": "98bef56f-173f-3727-b4ec-be32ccac0e0f",
                        "entry_id": "f134b356-9ff2-3d96-bc66-c25a2f5cb1c7",
                        "glosses": [
                            "Beschränkung für den Anwendungsbereich bestimmter grammatischer Regeln, der Transformationsregeln; Einhaltung gewisser Grenzen der Satzstellung, um die Grammatikalität zu bewahren, v.a. die \\\"Bewegung\\\" betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45378b7-07a5-477d-bb9d-a03f94a1bb84",
                                "sense_id": "98bef56f-173f-3727-b4ec-be32ccac0e0f",
                                "text": "Die Subjazenz unterbindet Sätze wie: \"Den Schrank würde Maren das Kleid in legen\"."
                            },
                            {
                                "example_id": "35487089-0525-4fc4-abc8-8f43d5bd18db",
                                "sense_id": "98bef56f-173f-3727-b4ec-be32ccac0e0f",
                                "text": "Der Terminus Subjazenz spielt in generativen Grammatiken eine Rolle."
                            },
                            {
                                "example_id": "9b00d3b2-3e98-4a04-b199-665435545b78",
                                "sense_id": "98bef56f-173f-3727-b4ec-be32ccac0e0f",
                                "text": "„Beschränkungen, die den Weg sowie die Weite der Bewegung, die Distanz zwischen Grund- und Zielposition betreffen…Man nennt diese Beschränkung Subjazenz(…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
