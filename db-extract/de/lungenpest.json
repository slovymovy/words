                        "sense_id": "219793ee-2b64-3e63-b71a-9b4fb3dd3101",
                        "entry_id": "bed42069-c36c-3624-a897-79ad50d35661",
                        "glosses": [
                            "durch Tröpfcheninfektion übertragene Form der Pest, welche die Lunge angreift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9baf69d2-d455-4f54-bb47-da7bd626474c",
                                "sense_id": "219793ee-2b64-3e63-b71a-9b4fb3dd3101",
                                "text": "„Ihr Spezialgebiet waren die Erreger der Lungenpest und des hämorrhagischen Fiebers, und heute Nacht begann für sie die Mission, auf die der nordkoreanische Geheimdienst sie sieben Jahre lang vorbereitet hatte, indem er sie westliche Sprachen lernen ließ und südkoreanische Lebensgewohnheiten und indem er ihr die göttliche Überlegenheit des geliebten Führers von Nordkorea sowie die Gewissheit eintrichterte, der Westen plane die Vernichtung ihres Vaterlands.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
