                        "entry_id": "c1cfb602-8b65-331b-bfb9-6e391fe144c0",
                        "glosses": [
                            "Offiziersdienstgrad des Führers einer Zenturie (Hundertschaft)"
                        ],
                        "tags": [
                            "Römisches Reich"
                        ],
                        "examples": [
                            {
                                "example_id": "18f01a1e-81ef-41ea-935d-cc0d184f7978",
                                "sense_id": "1a194a0d-769d-3625-b591-48b8d8b1243d",
                                "text": "Der Zenturio ist mit dem römischen Reich untergegangen."
                            },
                            {
                                "example_id": "a82b2cd0-39c4-4067-97ca-765448d38af1",
                                "sense_id": "1a194a0d-769d-3625-b591-48b8d8b1243d",
                                "text": "„Aufgrund von Gutachten und Empfehlungen besetzte er alle Offiziersstellen bis hinab zu den Zenturionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5c9e0aef-7af4-32a5-8dca-552f1db08564",
                        "entry_id": "c1cfb602-8b65-331b-bfb9-6e391fe144c0",
                        "glosses": [
                            "Offizier im Range eines Zenturios"
                        ],
                        "tags": [
                            "Römisches Reich"
                        ],
                        "examples": [
                            {
                                "example_id": "f92ba61b-6d66-4179-a308-d35e336a432c",
                                "sense_id": "5c9e0aef-7af4-32a5-8dca-552f1db08564",
                                "text": "Er war einer der Zenturionen, die bei Cannae fielen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
