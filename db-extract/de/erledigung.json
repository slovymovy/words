                ],
                "senses": [
                    {
                        "sense_id": "e5c70b7a-0115-3cf1-a48f-51861690f234",
                        "entry_id": "60d73018-b825-36c5-9c9c-d6d4c28cce12",
                        "glosses": [
                            "Vorgang, bei dem eine Arbeit oder Aufgabe zu Ende gebracht wird; Fertigstellung von etwas"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "aea4d1e0-3e91-479b-af45-a13d4733f189",
                                "sense_id": "e5c70b7a-0115-3cf1-a48f-51861690f234",
                                "text": "„Ob in der Weltraumstation, im Flugzeug, im Zug, oder im U-Boot, überall braucht der Mensch seine Toilette für eine ordnungsgemäße Erledigung seiner Grundbedürfnisse.“"
                            },
                            {
                                "example_id": "5e2c4bfa-6d36-4f7b-ac89-7845ef2c464e",
                                "sense_id": "e5c70b7a-0115-3cf1-a48f-51861690f234",
                                "text": "„Eine allzu große und gesuchte Schnelligkeit in Erledigung von Geschäften ist meistentheils zum Schaden und Verderb der Sache.“"
                            },
                            {
                                "example_id": "17f2a238-8b1c-452e-86fa-4cc2f6662b45",
                                "sense_id": "e5c70b7a-0115-3cf1-a48f-51861690f234",
                                "text": "„Über die Erledigung seines Auftrags berichtet er dort im Zusammenhang mit den übrigen Verrichtungen seines Tages.“"
                            },
                            {
                                "example_id": "11bb1882-597c-4ab5-9333-1bd7802200ca",
                                "sense_id": "e5c70b7a-0115-3cf1-a48f-51861690f234",
                                "text": "„Nach rechtskräftiger Erledigung des Strafverfahrens in Österreich könnten die Angeklagten sogar bis zum Europäischen Gerichtshof für Menschenrechte gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f202512-8cf3-3985-a77e-6e73b69c8e2f",
                        "entry_id": "60d73018-b825-36c5-9c9c-d6d4c28cce12",
                        "glosses": [
                            "Arbeit oder Aufgabe, die ausgeführt werden muss"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "577acc44-cbb9-413d-a925-16d74c73c08a",
                                "sense_id": "1f202512-8cf3-3985-a77e-6e73b69c8e2f",
                                "text": "„Ich bekam zwar jetzt ein bisschen Taschengeld für meine Erledigungen, aber die Atmosphäre zu Hause wurde noch viel frostiger für mich.“"
                            },
                            {
                                "example_id": "0768fcbe-27a6-4468-ab21-6bc9404d6809",
                                "sense_id": "1f202512-8cf3-3985-a77e-6e73b69c8e2f",
                                "text": "„Notieren Sie am Abend Ihre Erledigungen für den nächsten Tag und verknüpfen Sie diese mit den Zahlensymbolen.“"
                            },
                            {
                                "example_id": "6ba4553d-fd58-4579-9cf9-c0b826aca9df",
                                "sense_id": "1f202512-8cf3-3985-a77e-6e73b69c8e2f",
                                "text": "„Die Bewohner dürfen nur noch für essentielle Erledigungen das Haus verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
