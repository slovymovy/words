                "senses": [
                    {
                        "sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                        "entry_id": "57f33f44-2974-33f7-8483-5fcc5f42bcba",
                        "glosses": [
                            "intensiv gelbroter, lipophiler (fettlöslicher), hitze- und lichtempfindlicher, pflanzlicher Farbstoff, der besonders in Tomaten, Paprika und Hagebutten vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00fa16ec-7948-4a16-81fe-799259a4f5e0",
                                "sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                                "text": "Lykopin soll aufgrund seiner antioxidativen Eigenschaften zellprotektive Wirkung haben und wird daher mit dem Schutz von Herz, Augen und Prostata beworben."
                            },
                            {
                                "example_id": "1a8960ec-b3d7-4bac-b5cd-8dc5f232e5a5",
                                "sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                                "text": "Allerdings weisen die Forscher explizit darauf hin, dass die Wirkung-Dosis-Beziehung nicht für isoliertes Lykopin, wie es in Nahrungsergänzungsmittel eingesetzt wird, gilt."
                            },
                            {
                                "example_id": "e57947db-f989-438e-8c4f-d4b073871f3e",
                                "sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                                "text": "Besonders reich an Lykopin sind Guaven, Hagebutten, rosa Grapefruits und Tomaten."
                            },
                            {
                                "example_id": "b3e90c45-23a8-4fd1-b647-21565911da26",
                                "sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                                "text": "Lykopin senkt das Krebsrisiko, und zwar besonders bei Krebsarten des Verdauungstrakts."
                            },
                            {
                                "example_id": "dcede202-5733-4fbc-9f30-9c968293c8df",
                                "sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                                "text": "Auf Grund welcher Prozesse der Schutz durch Lykopin besteht, ist noch nicht erforscht, doch ist bekannt, dass es das Karotinoid mit der größten antioxidativen Wirkung ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5b988d3-b709-4f23-a391-3aa3bc446250",
                        "source_entry_id": "57f33f44-2974-33f7-8483-5fcc5f42bcba",
                        "source_sense_id": "607fee2e-49b2-35ea-9b42-22d494cb38ff",
                        "source_sense_description": "lipophiler, pflanzlicher Farbstoff, der besonders in Tomaten, Paprika und Hagebutten vorkommt",
                        "target_lang_word": "Lycopin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lycopin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f52959e-feba-3dc3-81aa-85e031238dbe",
                                        "entry_id": "357c4305-9efc-32be-8b35-b4c7b2d75d56",
                                        "glosses": [
                                            "intensiv gelbroter, lipophiler (fettlöslicher), hitze- und lichtempfindlicher, pflanzlicher Farbstoff, der besonders in Tomaten, Paprika und Hagebutten vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e548790-ebad-4ba5-8864-1f1f787fbd22",
                                                "sense_id": "6f52959e-feba-3dc3-81aa-85e031238dbe",
                                                "text": "Lycopin wird als einer von der EU zugelassener Lebensmittelfarbstoff eingesetzt."
                                            },
                                            {
                                                "example_id": "6d04db2d-e869-4e93-b1da-7e4909c9dc5a",
                                                "sense_id": "6f52959e-feba-3dc3-81aa-85e031238dbe",
                                                "text": "Wenngleich die Tomate weniger Karotine als in Aprikose, Sanddorn, Honigmelone oder Möhren enthält, so ist sie doch am reichsten an Lycopin (ca. 0,2 g/100 mg Tomatenmark)."
                                            },
                                            {
                                                "example_id": "796337ba-7239-437a-b05d-ede94e53d751",
                                                "sense_id": "6f52959e-feba-3dc3-81aa-85e031238dbe",
                                                "text": "Lycopin zeigt biologische Aktivität als Antioxidants, beeinflußt das Zellwachstum und moduliert sowohl die Genexpression wie die Immunität."
                                            },
                                            {
                                                "example_id": "b82e5d1c-6b23-4432-952b-d4dc36e8294a",
                                                "sense_id": "6f52959e-feba-3dc3-81aa-85e031238dbe",
                                                "text": "Heute weiß man: Diese Frucht mit Migrationshintergrund ist außerordentlich gesundheitsfördernd, voller Vitamin C, bei einem Wassergehalt von mehr als 90 Prozent kalorienarm, der sekundäre Pflanzenstoff Lycopin ein Radikalenfänger und, was medizinische Studien der letzten 20 Jahre zeigten, für die Krebsvorsorge zu empfehlen."
                                            },
                                            {
                                                "example_id": "975633ac-7311-4e16-b6d9-9fd97e55fe81",
                                                "sense_id": "6f52959e-feba-3dc3-81aa-85e031238dbe",
                                                "text": "Lycopin wird am besten vom menschlichen Körper aufgenommen, wenn man Tomaten in Öl erhitzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
