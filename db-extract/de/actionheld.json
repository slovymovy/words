                "senses": [
                    {
                        "sense_id": "807ff996-e526-3f49-a8fe-f99237c1c3ab",
                        "entry_id": "53a3de8f-2f54-3aca-81a0-6128c3e98661",
                        "glosses": [
                            "Protagonist (Hauptfigur) in einem Actionfilm"
                        ],
                        "tags": [
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "1deb8e16-e70c-4cdd-84e2-e69c9bf75c27",
                                "sense_id": "807ff996-e526-3f49-a8fe-f99237c1c3ab",
                                "text": "„Der erste Schocker lässt dabei nicht lang auf sich warten: Mit bloßen Fäusten prügelt der Actionheld auf den wildgewordenen Spielautomaten ein, der sich mit Münzen aus der Parkuhr am Leben hält.“"
                            },
                            {
                                "example_id": "75cf61e1-e5ec-4054-916b-4edcbae74da3",
                                "sense_id": "807ff996-e526-3f49-a8fe-f99237c1c3ab",
                                "text": "„Und nun, pünktlich zu Weihnachten, zeigt Chuck Norris, was ein echter Tannenbaum ist: In einem Youtube-Video steht der Actionheld ruhig und ausbalanciert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
