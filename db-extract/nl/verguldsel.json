                        "examples": [
                            {
                                "example_id": "62b21a80-74f8-4ce7-aed0-4abbd1503e41",
                                "sense_id": "b5ee953e-98fd-31e6-b48e-905571c946c8",
                                "text": "De hemel dompelde zich in hun kinderkamer als het ware onder in de kom met verguldsel, en na in vuur en goud gebaad te hebben veranderde hij in een vroege of late dienst in het kleine kerkje aan de steeg waar zijn kindermeid hem mee naartoe nam."
                            },
                            {
                                "example_id": "6b5615c0-6ded-4cb8-a2c8-a8e538465282",
                                "sense_id": "b5ee953e-98fd-31e6-b48e-905571c946c8",
                                "text": "De Gouden Koets was een geschenk van Amsterdam aan koningin Wilhelmina, ter ere van haar inhuldiging. Voor het eerst sinds de bouw is de koets helemaal uit elkaar gehaald en grondig onderzocht. Op sommige plekken is het hout- en leerwerk, het textiel, de wielen en het verguldsel gerestaureerd door specialisten uit binnen- en buitenland. De kosten van de restauratie, zo'n 1,2 miljoen euro, zijn voor rekening van de koning."
                            }
                        ]
                    }
