                    {
                        "sense_id": "7cf6b4c8-cb14-3040-9f26-0c06f4bd77b8",
                        "entry_id": "6e6fae06-611f-30d3-aac4-7144eba050e2",
                        "glosses": [
                            "auf Arbeitshöhe waagrecht angebrachte Platte in der Küche, die die Arbeitsfläche für die Essenszubereitung bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d89713-9717-4979-bc49-8269e68230f3",
                                "sense_id": "7cf6b4c8-cb14-3040-9f26-0c06f4bd77b8",
                                "text": "Unter der Arbeitsplatte sind meistens Schränke und große Küchengeräte untergebracht."
                            },
                            {
                                "example_id": "80e274eb-3419-4774-8759-cdedff275a3d",
                                "sense_id": "7cf6b4c8-cb14-3040-9f26-0c06f4bd77b8",
                                "text": "„Kant beugt sich über die Arbeitsplatte und schnippt mit seinem Mittelfinger gegen eines der Gläser, nickt zufrieden, greift zur Feder und notiert eine kleine Theorie des Schalls, schaut allerdings häufig verärgert aus dem Fenster, weil nicht der Gefangenenchor, sondern Lampe theorieverhindernden Lärm macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
