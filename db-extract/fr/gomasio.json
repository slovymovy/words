                        "entry_id": "965d55fe-6787-3b79-86b6-4f7a5659b627",
                        "glosses": [
                            "Condiment à base de sésame et de sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe297094-ea10-43a6-8e03-a33673d7c3d3",
                                "sense_id": "6a3223de-19a0-32b9-9659-1864f7d768e5",
                                "text": "Si vous n’avez pas d’amis intimes, alors suivez mon conseil et prenez une petite cuillerée de gomasio (3/4 de graines de sésame avec 1/4 de gros sel) afin de neutraliser l’acidité de votre sang."
                            },
                            {
                                "example_id": "309fd765-7611-49a9-9501-e43f23d8fcf6",
                                "sense_id": "6a3223de-19a0-32b9-9659-1864f7d768e5",
                                "text": "En plus de ses nombreuses propriétés nutritionnelles, le gomasio, condiment japonais à base de sésame, peut aider à réduire sa consommation de sel."
                            }
                        ]
                    }
