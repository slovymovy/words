                ],
                "senses": [
                    {
                        "sense_id": "e2d247dc-3b30-3b52-89b1-4e42f0acb7d8",
                        "entry_id": "ce249519-8915-307e-841c-2019cf743cc8",
                        "glosses": [
                            "Verein, der sich der Pflege von Kultur und Geselligkeit widmet; viele dieser Vereine bemühen sich darum, gute Lektüre unter die Leute zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5b4563-e921-4dcc-97b8-fd29f728c7e6",
                                "sense_id": "e2d247dc-3b30-3b52-89b1-4e42f0acb7d8",
                                "text": "„Mit solchen Stars des internationalen Literaturbetriebs hat der 1871 gegründete Leseverein Kilchberg in den ersten Jahrzehnten allerdings herzlich wenig zu tun, wie das Neujahrsblatt der Gemeinde Kilchberg auf das Jahr 2011 ausführt.“"
                            },
                            {
                                "example_id": "09dd46c3-88fe-4c54-9eda-fa1748b1ee16",
                                "sense_id": "e2d247dc-3b30-3b52-89b1-4e42f0acb7d8",
                                "text": "„In den Städten wurden Bildungsvereine, Lesevereine und ähnliche gegründet;…“"
                            },
                            {
                                "example_id": "08b87465-6b61-4773-86a7-252ac39d43d1",
                                "sense_id": "e2d247dc-3b30-3b52-89b1-4e42f0acb7d8",
                                "text": "„Ziele des Katholischen Lesevereins waren: »Wahrung und Bekundung des Glaubens in einer sich ändernden Welt“ und »Gemeinsame Benutzung guter Lektüre und gesellige Erholung«."
                            },
                            {
                                "example_id": "46510580-a333-4079-a56a-cdb6b1001f70",
                                "sense_id": "e2d247dc-3b30-3b52-89b1-4e42f0acb7d8",
                                "text": "„Der Neuwieder Leseverein sollte darüber hinaus aber auch einen anderen Zweck erfüllen: “Die Benutzung guten Lesestoffes anzuregen, den Gemeinsinn zu pflegen und zur gesellschaftlichen Erholung beizutragen“, waren seine Kernaufgaben so in § 1 der ersten Satzung.“"
                            },
                            {
                                "example_id": "77a31e5b-82b5-41f8-baf8-4fc62b70caa8",
                                "sense_id": "e2d247dc-3b30-3b52-89b1-4e42f0acb7d8",
                                "text": "„Auf Æsustadir, auf der Südseite des Tals, befand sich der Leseverein des Lágafellkirchspiels bei Thódur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
