                        "translation_id": "23188394-78ab-4ba1-bd7f-8c84d4ae4a55",
                        "source_entry_id": "e431df12-c290-3f12-b45c-1c07146ef65f",
                        "source_sense_description": "underground heating system for a bath",
                        "target_lang_word": "hypocauste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocauste",
