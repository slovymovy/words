                ],
                "senses": [
                    {
                        "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                        "entry_id": "7e62eacc-0434-37a8-ae0c-118b0d51feee",
                        "glosses": [
                            "Politik, die der Unterstützung oder auch der Unterdrückung bestimmter Sprachen in einem bestimmten Raum oder in bestimmten Institutionen dient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11a96a2d-dbb5-437d-9b98-ea1b8de08116",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "Sprachenpolitik legt fest, welche Sprachen wo als Amtssprachen gelten."
                            },
                            {
                                "example_id": "6d891c8e-d9d2-4c77-b514-9cb4658948b8",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "Die Sprachenpolitik in der EU dient der Förderung der Minderheitensprachen in den Mitgliedsländern."
                            },
                            {
                                "example_id": "2d34716e-49f6-4bd0-906f-8c5b0e450e91",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "Das, was hier als Sprachenpolitik dargestellt wird, wird manchmal auch unter dem Begriff Sprachpolitik angesprochen. Man sollte beide Begriffe mit Metzler Lexikon Sprache auseinanderhalten."
                            },
                            {
                                "example_id": "323ae0a0-744f-4776-8027-3bdd631773ab",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "„Obwohl die Unterscheidung zwischen ‚Sprache‘ und ‚Varietät einer Sprache‘ schwierig ist…, muß (…) grundsätzlich unterschieden werden zwischen Sprachenpolitik als »exoglossischem/interethnischem« Prozeß (zwischen zwei Sprachen/ Volksgruppen) und Sprachpolitik als »endoglossischem/intraethnischem« Prozeß innerhalb einer Sprache/Volksgruppe…“"
                            },
                            {
                                "example_id": "5114183b-0bd9-495a-9ad3-18d3401288ad",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "„Nachdem der Zweigvorsitzende die Gäste und den Gastredner begrüßt und ein paar Worte zum Thema »Sprachenpolitik« gesagt hatte, begann Professor Ammon seinen Vortrag mit der treffenden Feststellung: Vorherrschaft des Englischen, Schwäche des Deutschen.“"
                            },
                            {
                                "example_id": "8f6ee8bd-0229-4497-8bd9-6870884073bc",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "„Es wurde 2003 in Stockholm unter maßgeblicher Beteiligung des IDS gegründet und befasst sich seitdem unter anderem in jährlichen Tagungen mit linguistischen und sprachenpolitischen Themen von besonderem Interesse für seine Mitglieder und die europäische Sprachenpolitik.“"
                            },
                            {
                                "example_id": "05a28e1d-66be-4424-b5d2-05be536da7ed",
                                "sense_id": "00b64234-114d-3b86-97e0-3fd27f139495",
                                "text": "„Die Masse der Zuwanderer und auch viele alteingesessene Juden waren mit dieser Sprachenpolitik mehrheitlich einverstanden oder stellten sie zumindest nicht in Frage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
