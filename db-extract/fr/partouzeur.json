                        ],
                        "examples": [
                            {
                                "example_id": "dd66fd96-6f9f-4c68-8122-db3ac251868b",
                                "sense_id": "5913c3e4-b10c-3fe2-b8fb-74d28ee12f56",
                                "text": "Pr Hammond — Je déteste les animaux préhistoriques partouzeurs de droite, bordel ! C’est de la merde. Mélanger comme ça partouze et politique… C’est mieux de faire les choses dans l’ordre !\nGeorge — Va te faire branler, trotskard."
                            }
                        ]
                    }
