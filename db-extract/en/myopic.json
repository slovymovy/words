                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d533c1-ffb4-46e6-8f5d-ebe1cfee4399",
                                                "sense_id": "ac6e97f3-ef3e-3648-879e-cd2f95b44d46",
