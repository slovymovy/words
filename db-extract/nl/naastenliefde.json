                    {
                        "sense_id": "9ed76656-2fcd-358c-b28d-c6afec013071",
                        "entry_id": "6a2042d6-e3d7-3b16-ba75-962892cd453b",
                        "glosses": [
                            "liefde jegens de medemens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212c7cf6-090c-4382-ad83-3306999a6f7d",
                                "sense_id": "9ed76656-2fcd-358c-b28d-c6afec013071",
                                "text": "Hij had veel naastenliefde in zich."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6e97309-1196-4348-83a7-bb214e659d66",
                        "source_entry_id": "6a2042d6-e3d7-3b16-ba75-962892cd453b",
                        "source_sense_id": "9ed76656-2fcd-358c-b28d-c6afec013071",
                        "source_sense_description": "liefde jegens de medemens",
                        "target_lang_word": "Nächstenliebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nächstenliebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b34167bb-4f14-3bde-862b-f992eef753d0",
                                        "entry_id": "206c4353-4eb1-3d6f-b74b-17566337c93e",
                                        "glosses": [
                                            "unbedingte Rücksicht, Achtung und Hilfsbereitschaft gegenüber den Mitmenschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9782a7cc-d175-4785-90d6-2af37effe76c",
                                                "sense_id": "b34167bb-4f14-3bde-862b-f992eef753d0",
                                                "text": "Das Gebot der Nächstenliebe ist für einen Christenmenschen das höchste Gebot."
                                            },
                                            {
                                                "example_id": "3cd329b9-1f55-41f4-b908-80b65657edc9",
                                                "sense_id": "b34167bb-4f14-3bde-862b-f992eef753d0",
                                                "text": "„Das Interesse der anderen an seiner Person würde rasch verfliegen, und auf die allgemeine Nächstenliebe sollte man sich besser nicht verlassen.“"
                                            },
                                            {
                                                "example_id": "80e4d83b-f81e-4a82-9635-aa1a5a98332c",
                                                "sense_id": "b34167bb-4f14-3bde-862b-f992eef753d0",
                                                "text": "„Die Tante meiner Mutter hatte sie nicht aus Nächstenliebe aufgenommen.“"
                                            },
                                            {
                                                "example_id": "735af8aa-3278-44bb-8543-44c416f12232",
                                                "sense_id": "b34167bb-4f14-3bde-862b-f992eef753d0",
                                                "text": "„Nächstenliebe war für ihn nicht nur Hilfe für die Benachteiligten, sondern auch und vor allem Revolution gegen die strukturelle Ungerechtigkeit einer ausbeuterischen Gesellschaft, wie er formulierte.“"
                                            },
                                            {
                                                "example_id": "91a7c85c-e22d-41b5-ae02-cb384f13a429",
                                                "sense_id": "b34167bb-4f14-3bde-862b-f992eef753d0",
                                                "text": "„Er tröstete sich damit, dass er daür die zweite Pflicht, nämlich die Arbeit an der Veredelung des Menchengeschlechts, erfüllte und andere Tugenden hatte: Nächstenliebe und namentlich freigebige Mildtätigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1629f1c-830b-41c4-a1cf-e7db55520906",
                        "source_entry_id": "6a2042d6-e3d7-3b16-ba75-962892cd453b",
                        "source_sense_id": "9ed76656-2fcd-358c-b28d-c6afec013071",
                        "source_sense_description": "liefde jegens de medemens",
                        "target_lang_word": "charity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "An organization, the objective of which is to carry out a charitable purpose."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5ccefa-a475-470c-b7b5-8dd67ca42b9d",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            },
                                            {
                                                "example_id": "aeda157c-09b7-4541-9cea-77597fc9f0d7",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "The event raised money for local charities."
                                            },
                                            {
                                                "example_id": "50803e8c-aaf0-4468-8310-8a4d2930a2d0",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "He donated half his earnings to charity."
                                            },
                                            {
                                                "example_id": "c8d9f69c-b9df-4e85-904d-5976c7a225aa",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "give to charity"
                                            },
                                            {
                                                "example_id": "bf1fa6d2-8964-4bc7-b6ea-83b430aeab71",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "registered charity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8709b991-44cd-32c3-b8a5-d3a7ea856996",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "The goods or money given to those in need."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "Benevolence to others less fortunate than ourselves; the providing of goods or money to those in need."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf5942e-6beb-4ed5-b760-cf7396d67b1b",
                                                "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                                                "text": "act of charity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "In general, an attitude of kindness and understanding towards others, now especially suggesting generosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8816b4-70e7-43a8-9beb-0b75b2e187e1",
                                                "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                                                "text": "July 20, 1677, John Mitchell Mason, letter to a friend\nJudge thyself with the judgment of sincerity, and thou witl judge others with the judgment of charity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "Christian love; representing God's love of man, man's love of God, or man's love of his fellow-men."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144e0bd8-87d7-4c72-bc89-02b4fe30b991",
                                                "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                                                "text": "Charity suffereth long, and is kind; charity envieth not; charity vaunteth not itself, is not puffed up, Doth not behave itself unseemly, seeketh not her own, is not easily provoked, thinketh no evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d762dd50-7fbf-3d32-ae2c-4072936cbac8",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "A free throw."
                                        ],
