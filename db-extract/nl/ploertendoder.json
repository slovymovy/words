                "senses": [
                    {
                        "sense_id": "b46ffc1b-811a-377d-9221-d8b28d447195",
                        "entry_id": "1ca6947b-7e0f-397b-b4c6-acccd2450b3d",
                        "glosses": [
                            "verboden wapen lijkend op een gummistok maar dan met een verzwaarde loden kop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a958d5-c52d-4659-b5ae-6f03e05cef4c",
                                "sense_id": "b46ffc1b-811a-377d-9221-d8b28d447195",
                                "text": "Het gaat om zo’n zestig vuurwapens, waaronder automatische wapens, revolvers, pistolen, geweren, geluiddempers en een pistoolmitrailleur met geluiddemper. Daarnaast vond de politie duizenden stuks munitie geschikt voor een Kalasjnikov, patroonmagazijnen voor dit automatische wapen, geluiddempers, handgranaten, schietpennen, stroomstootwapens en ploertendoders. Rechercheurs stuitten ook op een koffer en een grote doos vol xtc-pillen."
                            },
                            {
                                "example_id": "0ce36d59-35cc-4070-bfff-36c0e04c6b8c",
                                "sense_id": "b46ffc1b-811a-377d-9221-d8b28d447195",
                                "text": "De Koninklijke Marechaussee heeft maandag bij een mobiele controle op de A1 bij Oldenzaal een 45-jarige man gepakt. De man had een balletjespistool en ploertendoder op zak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb7ec0a6-2919-4d2c-93c1-f4cb0f479177",
                        "source_entry_id": "1ca6947b-7e0f-397b-b4c6-acccd2450b3d",
                        "source_sense_id": "b46ffc1b-811a-377d-9221-d8b28d447195",
                        "source_sense_description": "verboden wapen lijkend op een gummistok maar dan met een verzwaarde loden kop",
                        "target_lang_word": "life-preserver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life-preserver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51f56f8-975f-306f-9d64-020bf83d136e",
                                        "entry_id": "d59169a7-9099-3684-90ce-596dedcfa968",
                                        "glosses": [
                                            "Alternative form of life preserver."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a153aa-0160-425c-bd6d-1396a80c3142",
                                                "sense_id": "d51f56f8-975f-306f-9d64-020bf83d136e",
                                                "text": "Here is a life-preserver, meant to be thrown into the sea when a sailor falls overboard."
                                            },
                                            {
                                                "example_id": "0eae58a4-eff7-4e8f-b43d-329ddf3cc906",
                                                "sense_id": "d51f56f8-975f-306f-9d64-020bf83d136e",
                                                "text": "Here's your crowbar / And your centre-bit; / Your life-preserver— / You may want to hit!"
                                            },
                                            {
                                                "example_id": "133901e1-7e53-4388-a695-639153676c2b",
                                                "sense_id": "d51f56f8-975f-306f-9d64-020bf83d136e",
                                                "text": "But when I gave him every particular that had occurred, he tried to bluster, and took down a life-preserver from the wall. I knew my man, however, and I clapped a pistol to his head before he could strike."
                                            },
                                            {
                                                "example_id": "6ddf3186-04a3-4688-8b3f-8d672f39b4cc",
                                                "sense_id": "d51f56f8-975f-306f-9d64-020bf83d136e",
                                                "text": "Swimming frantically, each with one arm, we waited for the boat to turn and rescue us. About five minutes passed. Shorty, on the drifting boat, sixty yards away now, was futilely throwing life-preservers toward us."
                                            },
                                            {
                                                "example_id": "dda607bb-fd53-46ca-9bbb-a95be76a49d6",
                                                "sense_id": "d51f56f8-975f-306f-9d64-020bf83d136e",
                                                "text": "I was so happy to see them! It was like being thrown a life-preserver in the middle of the ocean."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
