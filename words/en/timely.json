                        {
                            "text": "He marched with <w>timely</w> steps to the beat of the drum.",
                            "target_lang_translations": {
                                "ru": "Он маршировал <w>размеренными</w> шагами под бой барабана.",
                                "de": "Er marschierte mit <w>taktgerechten</w> Schritten zum Rhythmus der Trommel."
                            }
                        }
