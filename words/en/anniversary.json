    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93ad141b-8092-3835-a92e-4642294c746e",
                    "sense_definition": "A day that commemorates the yearly recurrence of a wedding.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are celebrating our tenth <w>anniversary</w> today.",
                            "target_lang_translations": {
                                "ru": "Сегодня мы празднуем нашу десятую <w>годовщину</w>.",
                                "zh": "我们今天正在庆祝我们的第十个结婚<w>纪念日</w>。"
                            }
                        },
                        {
                            "text": "My parents went to a nice restaurant for their wedding <w>anniversary</w>.",
                            "target_lang_translations": {
                                "ru": "Мои родители пошли в хороший ресторан на <w>годовщину</w> своей свадьбы.",
                                "zh": "我父母去了一家不错的餐厅庆祝他们的结婚<w>纪念日</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedding anniversary",
                        "happy anniversary",
                        "silver anniversary"
                    ],
                    "target_lang_definitions": {
                        "ru": "День, в который отмечается ежегодная дата свадьбы.",
                        "zh": "纪念结婚周年纪念日的日子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "годовщи́на",
                                "target_lang_sense_clarification": "ежегодный праздник"
                            },
                            {
                                "target_lang_word": "юбиле́й",
                                "target_lang_sense_clarification": "круглая дата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结婚纪念日",
                                "target_lang_sense_clarification": "特指结婚周年纪念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26bb1f99-46cb-3f0e-aeb0-7a87680151cb",
                    "sense_definition": "A day that is an exact number of years since a significant event occurred.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Today is the fiftieth <w>anniversary</w> of the end of the war.",
                            "target_lang_translations": {
                                "ru": "Сегодня пятидесятая <w>годовщина</w> окончания войны.",
                                "zh": "今天是战争结束五十<w>周年</w>。"
                            }
                        },
                        {
                            "text": "The city held a parade to mark the <w>anniversary</w> of its founding.",
                            "target_lang_translations": {
                                "ru": "В городе прошел парад в честь <w>годовщины</w> его основания.",
                                "zh": "这座城市举行了游行来纪念建城<w>周年</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "death anniversary",
                        "mark the anniversary",
                        "first anniversary"
                    ],
                    "target_lang_definitions": {
                        "ru": "День, в который прошло точное количество лет с момента значимого события.",
                        "zh": "某重大事件发生后经过整整若干年的那一天。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "годовщи́на",
                                "target_lang_sense_clarification": "памятная дата"
                            },
                            {
                                "target_lang_word": "юбиле́й",
                                "target_lang_sense_clarification": "торжество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "周年纪念日",
                                "target_lang_sense_clarification": "纪念某事件发生后的周年"
                            },
                            {
                                "target_lang_word": "周年",
                                "target_lang_sense_clarification": "指事件发生后的整年"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d583f23-76d8-31ca-809a-c17cebfa071e",
                    "sense_definition": "A day marking a specific period of time other than a year since an event.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They celebrated the six-month <w>anniversary</w> of the project launch.",
                            "target_lang_translations": {
                                "ru": "Они отметили полугодовой <w>юбилей</w> запуска проекта.",
                                "zh": "他们庆祝了项目启动六个月<w>纪念日</w>。"
                            }
                        },
                        {
                            "text": "It is the three-month <w>anniversary</w> of the day we met.",
                            "target_lang_translations": {
                                "ru": "Сегодня маленький <w>юбилей</w> — три месяца со дня нашей встречи.",
                                "zh": "今天是我们要好的三个月<w>纪念日</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "six-month anniversary",
                        "one-month anniversary"
                    ],
                    "target_lang_definitions": {
                        "ru": "День, знаменующий определенный период времени (не обязательно год) с момента события.",
                        "zh": "纪念某事件发生后经过特定时间段（非一年）的日子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "годовщина",
                                "target_lang_sense_clarification": "по истечении определённого срока (не обязательно года)"
                            },
                            {
                                "target_lang_word": "юбилей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪念日",
                                "target_lang_sense_clarification": "用于非整年的纪念时刻"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}