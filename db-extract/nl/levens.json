                                "sense_id": "fa2fa8d8-cc5f-33a9-bfc6-17651acab157",
                                "text": "Want alleen de hand des levens kan je harten bevatten."
                            },
                            {
                                "example_id": "fe045518-8cc5-48f2-9f2b-fc5598003e5f",
                                "sense_id": "fa2fa8d8-cc5f-33a9-bfc6-17651acab157",
                                "text": "Een vak waarin je niet één maar wel honderd levens kunt leiden."
                            },
