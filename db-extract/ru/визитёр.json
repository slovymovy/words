                    }
                ],
                "senses": [
                    {
                        "sense_id": "52a5ff77-ed0e-3f12-b748-4dd34f0087af",
                        "entry_id": "c0f5ce9d-9f10-331f-b619-50b7662dfce3",
                        "glosses": [
                            "тот, кто осуществляет визит, посещает кого-либо или какое-либо место"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c69fc6e-fb04-450b-b467-a67d0336e07b",
                        "source_entry_id": "c0f5ce9d-9f10-331f-b619-50b7662dfce3",
                        "source_sense_id": "52a5ff77-ed0e-3f12-b748-4dd34f0087af",
                        "target_lang_word": "visitor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b784b340-8e3b-33d8-b094-25bdbbc5bb34",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "Someone who visits someone else; someone staying as a guest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a3f929-d564-46a4-b001-756d05cb2c9b",
                                                "sense_id": "b784b340-8e3b-33d8-b094-25bdbbc5bb34",
                                                "text": "He ventured to raise his eyes again, and found his supernatural visitor confronting him in an erect attitude, with its chain wound over and about its arm."
                                            },
                                            {
                                                "example_id": "5d1f787c-0a71-4b3d-9db2-6b023bf6372c",
                                                "sense_id": "b784b340-8e3b-33d8-b094-25bdbbc5bb34",
                                                "text": "\"'Tis some visiter,\" I muttered, \"tapping at my chamber door— / Only this, and nothing more.\""
                                            },
                                            {
                                                "example_id": "eb7af1ee-b8f2-4329-b619-cb2c5514d9c4",
                                                "sense_id": "b784b340-8e3b-33d8-b094-25bdbbc5bb34",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "e304e864-3e2b-4f34-9423-f9f60f665e16",
                                                "sense_id": "b784b340-8e3b-33d8-b094-25bdbbc5bb34",
                                                "text": "The Riley Packaging plant in Uganda is quite a sight. From wall to wall and floor to ceiling, it is crammed with vast rolls of paper. A visitor feels like an ant gazing at stacks of toilet rolls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5b85df7-18e7-3126-ad4a-432c742492d4",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "Someone who pays a visit to a specific place or event; a sightseer or tourist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acad819e-1d6f-4894-8b3d-5528e92d49a5",
                                                "sense_id": "f5b85df7-18e7-3126-ad4a-432c742492d4",
                                                "text": "Warwick observed, as they passed through the respectable quarter, that few people who met the girl greeted her, and that some others whom she passed at gates or doorways gave her no sign of recognition; from which he inferred that she was possibly a visitor in the town and not well acquainted."
                                            },
                                            {
                                                "example_id": "781a1620-df89-42a5-b43a-6fb305396702",
                                                "sense_id": "f5b85df7-18e7-3126-ad4a-432c742492d4",
                                                "text": "Belgrade knew how to show visitors a good time, thanks to its fashionable, somewhat raucous nightclub and bar scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e55a95-aa24-301a-8e9f-049f7e079c7b",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "Someone, or a team, that is playing away from home."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8302f21-b7af-4bc9-9ecb-e45e0078f4e7",
                                                "sense_id": "e4e55a95-aa24-301a-8e9f-049f7e079c7b",
                                                "text": "But, somewhat against the run of play, Craddock fired the visitors ahead, volleying a low effort beyond Simon Mignolet after Sunderland twice failed to clear attempted crosses from Stephen Hunt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7418cea-d6bc-335f-88f4-b31d67afd49e",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "A person authorized to visit an institution to see that it is being managed properly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a48bcb8-81e3-421e-a136-37aacdbd388c",
                                                "sense_id": "b7418cea-d6bc-335f-88f4-b31d67afd49e",
                                                "text": "As to eleemoſynary corporations, by the dotation the founder and his heirs are of common right the legal viſitors, to ſee that that property is rightly employed, which would otherwiſe have deſcended to the viſitor himſelf: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3121924c-a58c-3e45-8d20-26fa068d20c0",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "An extraterrestrial being on Earth."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b45ab1-55e4-4f06-a842-e80ba6cf2204",
                                                "sense_id": "3121924c-a58c-3e45-8d20-26fa068d20c0",
                                                "text": "5: Of course there is always the remote (I hope) possibility that instant panic will prompt us to send a hailstorm of nuclear warheads out upon the visitor."
                                            },
                                            {
                                                "example_id": "b70865d1-1cd9-456e-8377-af5ff1729799",
                                                "sense_id": "3121924c-a58c-3e45-8d20-26fa068d20c0",
                                                "text": "When we ask what evidence does in fact exist of extraterrestrial sojourns on our planet, we can start with what would surely be the best evidence of all: an actual visitor, or group of visitors, visible to crowds of people and ready for photo opportunities, television interviews, handshakes, polite conversation, and dancing."
                                            },
                                            {
                                                "example_id": "d461c77d-ba75-44a2-815f-6c7ed2bc0116",
                                                "sense_id": "3121924c-a58c-3e45-8d20-26fa068d20c0",
                                                "text": "The visitor in Man Facing South-east claims pure altruism; Rantes (Hugo Soto) wants to alleviate the suffering of the poor and helpless."
                                            },
                                            {
                                                "example_id": "d062c8cc-f100-4b48-a2e2-8581c8ca2bba",
                                                "sense_id": "3121924c-a58c-3e45-8d20-26fa068d20c0",
                                                "text": "The tower radioed the flight leader, Captain Thomas F. Mantell, Jr., and requested that he engage and attempt to identify the strange visitor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78572705-8dc3-3513-9353-f253edf86137",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "An object which lands or passes by Earth or its orbit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433d96d3-968c-4324-9742-e166a7f4f268",
                                                "sense_id": "78572705-8dc3-3513-9353-f253edf86137",
                                                "text": "Within a few months, another small meteoric mass has been added to the list of those extra-terrestrial bodies which have fallen within the limits of Tennessee. This recent visitor is a stone, weighing, when first obtained, three pounds."
                                            },
                                            {
                                                "example_id": "a30ca4e3-2b97-48f8-aeec-4747526d0c21",
                                                "sense_id": "78572705-8dc3-3513-9353-f253edf86137",
                                                "text": "This satellite, they suspect, is a visitor sent by the “superior beings” of a community of other stars within our Milky Way galaxy."
                                            },
                                            {
                                                "example_id": "8ca75ae3-235a-4f4b-8b84-e245275407f5",
                                                "sense_id": "78572705-8dc3-3513-9353-f253edf86137",
                                                "text": "Though Clube and Napier’s cometary visitor was not a planet, the story is surprisingly close to that of Worlds in Collision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a90285e-e872-366c-85cb-0b44db87074f",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "A head or overseer of an institution such as a college (in which case, equivalent to the university's chancellor) or cathedral or hospital, who resolves disputes, gives ceremonial speeches, etc."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3a6fcc9-4de4-354f-85f1-e665edef737f",
                                        "entry_id": "a88fd3a3-245d-3fb9-8465-584270e0aaa4",
                                        "glosses": [
                                            "The object in the visitor pattern that performs an operation on the elements of a structure one by one."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d85b845-29ca-4d35-956e-9b31e45dec85",
                        "source_entry_id": "c0f5ce9d-9f10-331f-b619-50b7662dfce3",
                        "source_sense_id": "52a5ff77-ed0e-3f12-b748-4dd34f0087af",
                        "target_lang_word": "visiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d43ef65-763f-3d51-8447-abc8ad3fb020",
                                        "entry_id": "0b1354a0-aab4-3a88-a05f-2798d96344fc",
                                        "glosses": [
                                            "Celui qui va voir quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9bf80bc-4a4f-493a-80bd-7887584a1852",
                                                "sense_id": "8d43ef65-763f-3d51-8447-abc8ad3fb020",
                                                "text": "Il n'avait pas de chemise quand les visiteurs entrèrent. Il tenait une bible à la main. Il nous reçut poliment, dit l'auteur, et nous exposa avec tristesse, mais avec calme, l’horreur de sa condition."
                                            },
                                            {
                                                "example_id": "6503db5c-570c-44a4-8ff2-aa5abf290be1",
                                                "sense_id": "8d43ef65-763f-3d51-8447-abc8ad3fb020",
                                                "text": "Un peu de houle agitait le Firecrest sur son ancre, et mes visiteurs furent heureux de regagner la terre ferme."
                                            },
                                            {
                                                "example_id": "81875892-4df8-4cf1-bfc6-76d0b8c87695",
                                                "sense_id": "8d43ef65-763f-3d51-8447-abc8ad3fb020",
                                                "text": "Environ 6 000 visiteurs sur les trois jours, 350 convives au dîner du vendredi soir et presque 600 le samedi soir, le tout autour des traditionnelles moules-frites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "458fe90b-a568-3e1e-b794-2dd998bfd866",
                                        "entry_id": "0b1354a0-aab4-3a88-a05f-2798d96344fc",
                                        "glosses": [
                                            "Celui qui est commis, celle qui est commise pour visiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16efcb22-a7c2-45bd-88dd-3f56727a8ff9",
                                                "sense_id": "458fe90b-a568-3e1e-b794-2dd998bfd866",
                                                "text": "Visiteur des douanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ebf3e7-6648-3431-bd7e-91b6d4c45b9b",
                                        "entry_id": "0b1354a0-aab4-3a88-a05f-2798d96344fc",
                                        "glosses": [
                                            "Ouvrier qui procède au visitage."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
