                "translations": [
                    {
                        "translation_id": "1c1b9b5f-c6a7-4458-a16a-6925738b0b7a",
                        "source_entry_id": "d0e9607f-5428-3d44-8df8-071baf09b01f",
                        "source_sense_description": "person who jogs",
