                        "entry_id": "2bb3db94-98b1-3abf-a6a3-3ea31110b3bf",
                        "glosses": [
                            "gwałtowny wyrzut treści pokarmowej na zewnątrz z żołądka poprzez przełyk i jamę ustną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1730fbc-311c-4420-9af2-825c44975c6a",
                                "sense_id": "4e9a146c-a252-37c8-8ab8-ac209a7710f7",
                                "text": "Bulimia jest chorobą psychosomatyczną, w której chory wywołuje wymioty, by zwrócić jedzenie, które zjadł."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
