                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8a0504-0aa7-496e-a601-5c88bbaaf6e5",
                                "sense_id": "1ab638f5-0c98-3182-838b-b481c7ffb900",
                                "text": "As we proceeded southwardly, the temperature grew milder, and the day closed with a calm and pleasant sunset."
                            },
                            {
                                "example_id": "83345ceb-4791-42ef-ab62-ef33bdba2298",
                                "sense_id": "1ab638f5-0c98-3182-838b-b481c7ffb900",
                                "text": "The Scandinavian peoples have developed a tendency to an extra-European outlook, to look west and east rather than southwardly, to be pacifist and progressive in a manner essentially American."
                            },
                            {
                                "example_id": "2efd18dc-42a6-442c-92b2-e443718ba44f",
                                "sense_id": "1ab638f5-0c98-3182-838b-b481c7ffb900",
                                "text": "Dungey (7 ) first sketched the consequences for an interplanetary (solar wind) magnetic field (IMF) that was oppositely directed (southwardly) from the generally northward terrestrial field."
                            }
                        ]
                    }
