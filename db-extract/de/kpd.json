                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4069e082-da57-459c-800f-3627e962c723",
                                "sense_id": "e2f010bd-830f-3222-a5ec-dfe08da8771d",
                                "text": "„Nach 1968 wurde die Deutsche Kommunistische Partei (DKP) stillschweigend zugelassen. Obwohl ihre Ähnlichkeit mit der verbotenen KPD nicht zu übersehen war, wurde sie nicht zur Ersatzorganisation erklärt.“"
                            },
                            {
                                "example_id": "bec1e50c-29f7-42fe-97a8-2f419c5abf67",
                                "sense_id": "e2f010bd-830f-3222-a5ec-dfe08da8771d",
                                "text": "„Das von der KPD erwirkte Volksbegehren hatte dieses Thema popularisiert und das politische Klima vergiftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
