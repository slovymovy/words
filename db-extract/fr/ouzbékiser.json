                ],
                "senses": [
                    {
                        "sense_id": "7dbc9174-b6d9-392f-aae8-6ead1de09330",
                        "entry_id": "a4c499ef-8045-3911-9eab-9fcd1fa387a0",
                        "glosses": [
                            "Donner un caractère ouzbek à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e962f720-a213-4d52-8446-a51cb45023a1",
                                "sense_id": "7dbc9174-b6d9-392f-aae8-6ead1de09330",
                                "text": "Ce choix s’inscrit dans la volonté d’ouzbékiser le pays et de marginaliser politiquement les autres composantes de la société."
                            },
                            {
                                "example_id": "20d53781-48c1-4566-9a0a-2108d0227b29",
                                "sense_id": "7dbc9174-b6d9-392f-aae8-6ead1de09330",
                                "text": "Pour enraciner la nation dans l'histoire, les historiens préfèrent « ouzbékiser » Tamerlan et Babour, les deux fameux souverains ayant régné sur tout ou partie de l’Asie centrale du XIVe au XVIe siècle, même si ni l’un ni l’autre ne sont des « Ouzbeks »."
                            }
                        ]
                    }
