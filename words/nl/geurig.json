    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e8de6de-8985-3551-a26d-29a461400659",
                    "sense_definition": "met een prettige geur, een prettige geur verspreidend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aangename_geur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tegen de muur van het oude huis groeiden <w>geurige</w> klimrozen.",
                            "target_lang_translations": {
                                "en": "Against the wall of the old house grew <w>fragrant</w> climbing roses.",
                                "ru": "У стены старого дома росли <w>душистые</w> плетистые розы."
                            }
                        },
                        {
                            "text": "In de ochtend geniet ik altijd van een kop <w>geurige</w> koffie.",
                            "target_lang_translations": {
                                "en": "In the morning I always enjoy a cup of <w>aromatic</w> coffee.",
                                "ru": "По утрам я всегда наслаждаюсь чашечкой <w>ароматного</w> кофе."
                            }
                        }
                    ],
                    "synonyms": [
                        "welriekend",
                        "aromatisch"
                    ],
                    "antonyms": [
                        "geurloos"
                    ],
                    "common_phrases": [
                        "geurige koffie",
                        "geurige bloemen"
                    ],
                    "target_lang_definitions": {
                        "en": "having a pleasant smell, spreading a pleasant scent",
                        "ru": "с приятным запахом, распространяющий приятный аромат"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fragrant",
                                "target_lang_sense_clarification": "sweet-smelling, having a pleasant scent"
                            },
                            {
                                "target_lang_word": "aromatic",
                                "target_lang_sense_clarification": "having a pleasant, distinctive, or spicy smell"
                            },
                            {
                                "target_lang_word": "sweet-smelling",
                                "target_lang_sense_clarification": "having a pleasant fragrance"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ароматный",
                                "target_lang_sense_clarification": "приятно пахнущий"
                            },
                            {
                                "target_lang_word": "душистый",
                                "target_lang_sense_clarification": "о цветах, травах, кофе"
                            },
                            {
                                "target_lang_word": "благоухающий",
                                "target_lang_sense_clarification": "книжное, приятно пахнущий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc13f30b-fe84-3adb-bcda-7f7c734b9308",
                    "sense_definition": "een sterke of duidelijke geur hebbend (niet noodzakelijk aangenaam)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sterke_geur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De keuken hing vol met de <w>geurige</w> dampen van gekookte kool en kruiden.",
                            "target_lang_translations": {
                                "en": "The kitchen was filled with the <w>strong-smelling</w> vapors of boiled cabbage and herbs.",
                                "ru": "Кухня была наполнена <w>пахучими</w> испарениями вареной капусты и специй."
                            }
                        },
                        {
                            "text": "Sommige kazen zijn erg <w>geurig</w> en niet iedereen houdt daarvan.",
                            "target_lang_translations": {
                                "en": "Some cheeses are very <w>pungent</w> and not everyone likes that.",
                                "ru": "Некоторые сыры очень <w>пахучие</w>, и это не всем нравится."
                            }
                        }
                    ],
                    "synonyms": [
                        "aromatisch"
                    ],
                    "antonyms": [
                        "geurloos"
                    ],
                    "common_phrases": [
                        "geurige kruiden"
                    ],
                    "target_lang_definitions": {
                        "en": "having a strong or distinct smell (not necessarily pleasant)",
                        "ru": "имеющий сильный или отчетливый запах (не обязательно приятный)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aromatic",
                                "target_lang_sense_clarification": "having a strong, distinctive smell"
                            },
                            {
                                "target_lang_word": "strong-smelling",
                                "target_lang_sense_clarification": "having a powerful odor"
                            },
                            {
                                "target_lang_word": "pungent",
                                "target_lang_sense_clarification": "having a sharp, strong, or biting smell"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пахучий",
