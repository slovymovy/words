                ],
                "senses": [
                    {
                        "sense_id": "f7993007-fba2-3df3-8494-1081e06433ff",
                        "entry_id": "d2533532-a449-3320-8d0f-e3c7e079e801",
                        "glosses": [
                            "Kugel, auf deren Oberfläche sich alle Ecken eines Polyeders befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3704c17c-235c-4f5d-b190-3a69ca801392",
                                "sense_id": "f7993007-fba2-3df3-8494-1081e06433ff",
                                "text": "Alle fünf platonischen Körper besitzen aufgrund ihrer besonderen Symmetrieeigenschaften eine Umkugel."
                            },
                            {
                                "example_id": "258e1374-66ce-4196-9114-77750994122b",
                                "sense_id": "f7993007-fba2-3df3-8494-1081e06433ff",
                                "text": "Alle Ecken des Polyeders besitzen den gleichen Abstand zum Mittelpunkt einer Umkugel."
                            },
                            {
                                "example_id": "f0ee5e71-0ffc-4115-87eb-5b4d77364587",
                                "sense_id": "f7993007-fba2-3df3-8494-1081e06433ff",
                                "text": "„Fuller verwendete u. a. das Ikosaeder als Ausgangsform, um eine Kugel anzunähern […]. Dabei werden die dreieckigen Seitenflächen in kleinere Dreiecke unterteilt und die neuen Ecken vom Mittelpunkt der Umkugel aus auf die Umkugel projiziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
