                    },
                    {
                        "form_id": "854b8d82-b908-47c1-9807-9159f5d537c1",
                        "entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "ophidienne"
                    },
                    {
                        "form_id": "bfc84d11-a2f2-4717-9a27-6f3191374cf3",
                        "entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "ophidiennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                        "entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "glosses": [
                            "Qui est de la nature du serpent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce4f5e0-cc88-40e4-88e1-9f4d0703749d",
                                "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                "text": "Les êtres du château restaient figés, de la surprise dans leurs yeux ophidiens."
                            },
                            {
                                "example_id": "162fd474-cefd-456f-9f28-21f67ec42ce1",
                                "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                "text": "Puis il se retourna. Il était temps. La meute entière, quadrupèdes, bipèdes, oiseaux, ophidiens, se ruait sur lui avec ensemble."
                            },
                            {
                                "example_id": "3ef62c61-d444-4580-9a56-753fdcd52d9b",
                                "sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                                "text": "Le silence que j'affectais quand j'étais irrité, ou, plus exactement, la froideur ophidienne de mon silence irrité, plongeait Valeria dans une frayeur insane autrefois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d1e0ba1-f3f5-4c29-ae79-2287b2f80c8d",
                        "source_entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "source_sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                        "target_lang_word": "ophidian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ophidian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                        "entry_id": "d3bb0c7e-38ba-3bd0-8a8c-b20fa66ad011",
                                        "glosses": [
                                            "Any species of the suborder Serpentes; a snake or serpent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be1a24b4-18f1-48ff-8667-ea68fc80d649",
                                                "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                                "text": "Vertebral structure is critical for the identification of fossil snakes, because vertebrae are among the most easily fossilized parts of ophidians."
                                            },
                                            {
                                                "example_id": "b06c3219-3730-4043-bb2b-54be59e664cc",
                                                "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                                "text": "It has long been known that ophidians have lost not only their front legs but also every embryonic trace of these limbs and their associated shoulder girdle (to such a degree that we cannot determine how many cervical vertebrae they have)."
                                            },
                                            {
                                                "example_id": "50f91877-3a36-44b0-b9b6-1d937db11948",
                                                "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                                "text": "Siamese or double monsters are well known in saurians, chelonians, and ophidians, as are bicephalic, two-tailed and conjoined bodies (thoracodymus, ischiodymus, etc.)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ophidian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                        "entry_id": "d010b73d-9c7f-3bae-bb0a-fb744665fd23",
                                        "glosses": [
                                            "Of or pertaining to the suborder Serpentes; of, related to, or characteristic of a snake or serpent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302b77fa-cd31-4fb2-9161-3f39d9485cd0",
                                                "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                                "text": "The ophidian beast began to glow eerily, and Aaron could discern a fine webwork of veins and capillaries running throughout the creature's body."
                                            },
                                            {
                                                "example_id": "f8707b22-2b3b-454f-809d-f391f9b56e14",
                                                "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                                "text": "A less obvious asset of snakes is their very light and supple jaws, which arose in the course of ophidian evolution to permit the ingestion of extraordinarily large meals (at maximum, more than 100% of their body mass)."
                                            },
                                            {
                                                "example_id": "19a7a373-a627-4c6d-b836-8b74abf7a2b1",
                                                "sense_id": "69ab7e48-3b88-3232-a855-ed87dc479536",
                                                "text": "Another ophidian deity recognizable in Classic reliefs is the Feathered Serpent, known to the Maya as Kukulcán (and to the Toltecs and Aztecs as Quetzalcóatl)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0348937-406d-4a6e-89e3-0d3723edd479",
                        "source_entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "source_sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                        "target_lang_word": "ophidia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb93cab4-221d-4827-a1ac-a923a8ae7823",
                        "source_entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "source_sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
                        "target_lang_word": "змеевидный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "змеевидный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "655c1ea3-35f9-32cd-adaf-cfad581815be",
                                        "entry_id": "ed89a55f-88cc-3299-a107-3b4b1a94e5a1",
                                        "glosses": [
                                            "похожий на змею; имеющий вид змеи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1fc2b2-266e-44aa-bb85-5d8d25df210a",
                                                "sense_id": "655c1ea3-35f9-32cd-adaf-cfad581815be",
                                                "text": "Эти серые хищные глаза, эти ямочки на щеках, эти змеевидные косы — да неужели же это всё словно прилипло к нему, и он стряхнуть, отбросить прочь всё это не в силах, не может?"
                                            },
                                            {
                                                "example_id": "a34f5080-e321-478c-b13e-1b95c62f3de7",
                                                "sense_id": "655c1ea3-35f9-32cd-adaf-cfad581815be",
                                                "text": "Рабочий стол загромождали сложные приборы: кубы, перегонные шлемы, химические приёмники, реторты, воронки, ступы, колбы со стеклянными пузырями, длинными горлами, змеевидные трубки, громадные бутыли и крошечные баночки."
                                            },
                                            {
                                                "example_id": "81dcdb07-9c1e-440a-a3a5-c442318e97cc",
                                                "sense_id": "655c1ea3-35f9-32cd-adaf-cfad581815be",
                                                "text": "Многотысячные скопища крокодилообразных земноводных, копошившихся в липком иле в болотах и лагунах; озерки, переполненные саламандрами, змеевидными и ящеровидными тварями, погибавшими миллионами в бессмысленной борьбе за существование."
                                            },
                                            {
                                                "example_id": "6e5c0493-43fc-418f-879d-917f2a0af1d5",
                                                "sense_id": "655c1ea3-35f9-32cd-adaf-cfad581815be",
                                                "text": "В переводе «серпентайн» — это «змеиный» или «змеевидный», ведь озеро и впрямь похоже на широкую ленту, эдакой змеевидной, «серпантинной» формы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34130169-2a93-4fff-89cc-6f7ccc4fd7f8",
                        "source_entry_id": "232e5f5c-7c09-3c86-8b38-8e212626ff67",
                        "source_sense_id": "3ddf9eb5-75d9-34a2-85f2-21adc735b63c",
