                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5394cd61-ee80-4c6f-99a3-772b8bbbc602",
                                "sense_id": "a75ee444-386b-3106-95db-617cafae7d63",
                                "text": "Les dirigeants travaillent à la diminution de la masse salariale, indispensable à l’homologation des contrats de Yoan Barbet et Vital Nsimba - déjà « cadres » du vestiaire sans pouvoir jouer - et de Jonas Lössl."
                            },
                            {
                                "example_id": "94756c33-3e2b-4896-bcda-19a63267aaca",
                                "sense_id": "a75ee444-386b-3106-95db-617cafae7d63",
                                "text": "Hugo Barbet, lui aussi, a fait sa première en pro la saison dernière."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                "word": "barbet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e8578243-b647-47be-ab30-8725fc8c798a",
                        "entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                        "tags": [
                            "plural"
                        ],
                        "form": "barbets"
                    },
                    {
                        "form_id": "a70ce295-8c72-4620-b517-0d912d1176c1",
                        "entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                        "tags": [
                            "feminine"
                        ],
                        "form": "barbette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44096e28-9140-3432-bce9-47fe3db88bb0",
                        "entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                        "glosses": [
                            "Race de chien d’eau, originaire de France, à poil long, laineux et frisé, à robe unicolore."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4d93d52c-ff67-44f6-8b13-7e68dcb89663",
                                "sense_id": "44096e28-9140-3432-bce9-47fe3db88bb0",
                                "text": "Le barbet est l’ancêtre du caniche et de griffons."
                            },
                            {
                                "example_id": "a461e25b-4530-4ec4-9fd9-3e079239ec57",
                                "sense_id": "44096e28-9140-3432-bce9-47fe3db88bb0",
                                "text": "S’il lui fallait un peu de volaille, c’était pour en donner les os à un barbet noir, son compagnon fidèle."
                            },
                            {
                                "example_id": "479546d1-f2ca-4ac9-9936-1b068375f4a5",
                                "sense_id": "44096e28-9140-3432-bce9-47fe3db88bb0",
                                "text": "Il m’est arrivé, madame, répondit Long, en se secouant comme un barbet mouillé, que ce sol de glace a cédé sous moi et que j’ai pris un bain forcé."
                            },
                            {
                                "example_id": "8f18582c-5278-4b5e-9e74-fee618b934cc",
                                "sense_id": "44096e28-9140-3432-bce9-47fe3db88bb0",
                                "text": "On avait sorti des armoires d’antiques chapeaux, hérissés comme des barbets qui ont couru dans les broussailles, des gibus au ruban large comme la main."
                            },
                            {
                                "example_id": "a9719502-7e12-49ca-9fec-9b47b1e83f1f",
                                "sense_id": "44096e28-9140-3432-bce9-47fe3db88bb0",
                                "text": "« Et je lève ma coupe… »\nMais il la leva d’un geste si incertain que tout le Saint-Péray mousseux coula sur la tête de Lesueur, lequel s’ébroua en éternuant comme un barbet sous un seau d’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "739d54a6-060c-3a68-a618-7496a77b6c3a",
                        "entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                        "glosses": [
                            "Rouget de vase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef66e020-2415-470a-88b4-37bd3299ec6c",
                                "sense_id": "739d54a6-060c-3a68-a618-7496a77b6c3a",
                                "text": "C'est lorsque la lumière décline que la pêche au rougets de roche s'avère la plus fructueuse. L'Empereur par excellence de la Méditerranée est un trésor incomparable. Tellement plus noble que les autres variétés comme la galinette, le barbet ou encore le grondin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1de742a-62b5-465e-9f3b-6158212f6ebb",
                        "source_entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                        "source_sense_description": "chien",
                        "target_lang_word": "Barbet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "14cfc89b-2b22-4dff-b316-feb7c0d3db84",
                        "source_entry_id": "8a53f55d-f583-353f-8065-1f3ab00aa024",
                        "source_sense_description": "chien",
                        "target_lang_word": "Pudel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "eine mittelgroße Hunderasse mit häufig lockigem Fell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ea2905-1927-459d-8971-9eb16fcf7cff",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "Die Jacob Sisters haben immer ihre weißen Pudel bei sich, die zu ihrem Markenzeichen geworden sind."
                                            },
                                            {
                                                "example_id": "4e128a7d-1808-4a69-b224-58176c1ada8b",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "Er sah aus wie ein begossener Pudel."
                                            },
                                            {
                                                "example_id": "c4281a62-a878-49ec-b33a-e551e10aa5d8",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Sie kommt immer mit ihrem Pudel und bindet ihn an einen Fuß ihrer Staffelei.“"
                                            },
                                            {
                                                "example_id": "c6f5aad7-accf-4fdc-9c5a-a5cedcc0e1d9",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Es kam ihm vor, als reisten in der U-Bahn genauso viele Menschen wie Pudel.“"
                                            },
                                            {
                                                "example_id": "b7b8a6dd-3b4c-40ee-888c-bf0c5cf24fa1",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Weiter konnten wir uns nicht bekannt machen, denn sie hatte zwei Hunde dabei, einen braunen und einen schwarzen Pudel, die um uns herumtollten und vor Freude über die Rückkehr meines Vaters fast den Leiterwagen umrissen.“"
                                            },
                                            {
                                                "example_id": "6b859e18-0d67-468d-b1b1-9c51309629b2",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Bundschuhs Pudel war sehr kräftig und auf einem Auge blind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51eac3c1-9f11-3823-925c-3f1821cf7ff2",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "ein Fehlwurf beim Kegeln, der gar keinen Kegel umwirft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d286bd-2e3a-4f16-98e5-a79aa633cb71",
                                                "sense_id": "51eac3c1-9f11-3823-925c-3f1821cf7ff2",
                                                "text": "Verlässt die Kugel die Bahn beim Kegeln und fällt in die Rinne, dann nennt man das einen Pudel, Pumpe, Gosse oder anders."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3c1ec17-518a-352c-bb6a-31b33352801c",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "der Woll-Rindeneule, einem Nachtfalter aus der Familie der Eulenfalter"
                                        ],
                                        "tags": [
                                            "Trivialname"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0a386b-ec92-4b79-85ea-426215904dc5",
                                                "sense_id": "e3c1ec17-518a-352c-bb6a-31b33352801c",
                                                "text": "Die Raupen des Pudels haben lange weiße bis gelbe Haare."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "Kurzform für Pudelmütze: eine gestrickte Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "410a6b56-a4ed-460f-b7f4-92bb2050bbeb",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Du setzt Deinen Pudel auf, heute morgen ist es saukalt!"
                                            },
                                            {
                                                "example_id": "47c05193-ebf6-4d6b-ba76-4406d3b12077",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Weißt Du, wo mein roter Pudel geblieben ist?."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54d91560-3070-3838-93ad-11369f8ccffc",
                                        "entry_id": "2eb23533-0ddb-3916-a751-e8b44a93e80b",
                                        "glosses": [
