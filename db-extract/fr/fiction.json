        "fr-extract.jsonl": [
            {
                "entry_id": "cfe9c8be-c58c-3355-bfbb-911a10029a75",
                "word": "fiction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "665d812c-a837-4db5-bf20-3f6b9e560ddb",
                        "entry_id": "cfe9c8be-c58c-3355-bfbb-911a10029a75",
                        "tags": [
                            "plural"
                        ],
                        "form": "fictions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b90ab37-66ef-3432-aa6a-6e37c95a89ad",
                        "entry_id": "cfe9c8be-c58c-3355-bfbb-911a10029a75",
                        "glosses": [
                            "Invention fabuleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7149ed6-b8ed-43f5-84e7-c8163ac0ef6a",
                                "sense_id": "7b90ab37-66ef-3432-aa6a-6e37c95a89ad",
                                "text": "Fiction poétique."
                            },
                            {
                                "example_id": "48ce3161-f646-4869-879e-0b67d64d1fa1",
                                "sense_id": "7b90ab37-66ef-3432-aa6a-6e37c95a89ad",
                                "text": "Les fictions de la mythologie."
                            },
                            {
                                "example_id": "ba35bcd5-ac6a-4e7d-ac96-300e3f9fbf14",
                                "sense_id": "7b90ab37-66ef-3432-aa6a-6e37c95a89ad",
                                "text": "La vérité est toujours étrange, plus étrange que la fiction."
                            },
                            {
                                "example_id": "08c02405-9e60-4d11-b929-4aae83c23d4a",
                                "sense_id": "7b90ab37-66ef-3432-aa6a-6e37c95a89ad",
                                "text": "La Bible tient largement de la fiction, mais elle peut encore procurer de la joie à des milliards de gens et encourager les humains à la compassion, au courage et à la créativité - à l’instar d’autres grands œuvres de fiction comme « Don Quichotte », « Guerre et Paix » et « Harry Potter »."
                            }
                        ]
                    },
                    {
                        "sense_id": "e533f22c-88b8-3665-9886-3516b658acdc",
                        "entry_id": "cfe9c8be-c58c-3355-bfbb-911a10029a75",
                        "glosses": [
                            "Narration de faits fictifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5ce1cd-8c3e-4999-8119-baf60fe71100",
                                "sense_id": "e533f22c-88b8-3665-9886-3516b658acdc",
                                "text": "Il n’est pas question d’entamer ici une enquête anthropologique sur la question de l’universalité des fictions ni de prendre parti en leur faveur ou en leur défaveur."
                            },
                            {
                                "example_id": "38bd8a2e-63e2-4e97-964c-368e47ed8fe1",
                                "sense_id": "e533f22c-88b8-3665-9886-3516b658acdc",
                                "text": "De la même façon que les médias et le Net créent un nouveau territoire entre info et fiction, la sondagite aiguë dont est frappée la France y ajoute le risque de confusion entre opinion réelle et opinion imaginaire."
                            },
                            {
                                "example_id": "d91b084e-7895-480a-a29b-232c91652df5",
                                "sense_id": "e533f22c-88b8-3665-9886-3516b658acdc",
                                "text": "Ce long métrage n’est donc ni un biopic, ni une fiction, mais un « biopic fiction » comme le propose le magazine Première: mélangeant volontairement faits et imaginaire, il s’intéresse moins à la vérité biographique qu’à « l’esprit » de cette dernière, des mots mêmes de la réalisatrice, ainsi qu’aux racines profondes de la vocation de la pédagogue."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dc511fb-0fdc-3def-a3c1-d92653eaa0e1",
                        "entry_id": "cfe9c8be-c58c-3355-bfbb-911a10029a75",
                        "glosses": [
                            "Supposition introduite ou autorisée par la loi en faveur de quelqu’un."
                        ],
                        "tags": [
                            "Jurisprudence"
                        ],
                        "examples": [
                            {
                                "example_id": "a8239839-15d1-4bed-b0e6-b3063c866615",
                                "sense_id": "5dc511fb-0fdc-3def-a3c1-d92653eaa0e1",
                                "text": "En droit des personnes les fictions sont tout autant nombreuses, à commencer par la technique des lettres de naturalité et des lettres de déclaration, par lesquelles le Français devenu aubain est réintégré dans sa qualité de citoyen, dont l’effet est comparé par d’Aguesseau au post liminum romain. De même, c’est en vertu d’une fiction que l’absent est réputé mort, que les enfants qui sont encore dans le sein de leur mère sont regardés « comme s’ils étaient déjà nés », que les époux sont réputés majeurs « quant à la puissance et autorité paternelle » ou que certains condamnés ou les religieux profès sont tenus pour civilement morts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f16f6ada-6a12-414f-814b-c6fd92d8bfd3",
                        "source_entry_id": "cfe9c8be-c58c-3355-bfbb-911a10029a75",
                        "source_sense_description": "Invention fabuleuse.",
                        "target_lang_word": "Fiktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fiktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "874bc39f-8b16-3bd8-b4b2-11b55f57d2aa",
                                        "entry_id": "6e72c3af-5333-3ef1-b893-626fc098d50f",
                                        "glosses": [
                                            "etwas Ausgedachtes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ed28b1-c756-416e-aeb3-a198bd28b8bd",
                                                "sense_id": "874bc39f-8b16-3bd8-b4b2-11b55f57d2aa",
                                                "text": "Der Angriff der Marsmenschen wurde nicht von allen als Fiktion erkannt."
                                            },
                                            {
                                                "example_id": "422ea152-f95e-44d5-b4a9-853c4aaca75d",
                                                "sense_id": "874bc39f-8b16-3bd8-b4b2-11b55f57d2aa",
                                                "text": "„Umso wichtiger ist es, zu entschlüsseln, wie die Fiktion entsteht - bleibt sie unbemerkt, kann sie großen Schaden anrichten.“"
                                            },
                                            {
                                                "example_id": "169401aa-bd64-410c-9385-76896e410651",
                                                "sense_id": "874bc39f-8b16-3bd8-b4b2-11b55f57d2aa",
                                                "text": "„Etliche Übereinstimmungen von Fiktion und Realität scheinen auf einen Schlüsselroman zu deuten.“"
                                            },
                                            {
                                                "example_id": "e29c8c64-4c2c-447f-b56f-fdb9e0241563",
                                                "sense_id": "874bc39f-8b16-3bd8-b4b2-11b55f57d2aa",
                                                "text": "„Sie konzentrierten ihre ganze Anstrengung darauf, sich zu beherrschen und die Fiktion eines normalen Tagesablaufs aufrechtzuerhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d575fef3-5c3e-3c4f-8735-9161471e0082",
                                        "entry_id": "6e72c3af-5333-3ef1-b893-626fc098d50f",
                                        "glosses": [
                                            "eine Annahme"
                                        ],
                                        "tags": [],
