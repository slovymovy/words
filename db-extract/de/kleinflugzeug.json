                "senses": [
                    {
                        "sense_id": "5f495bb4-5701-300b-bb7e-f7c3e9ccc482",
                        "entry_id": "2bce5105-e1e8-3bca-863f-bf6d67a46bf1",
                        "glosses": [
                            "Flugzeug geringen Gewichts (weniger als 5,7 Tonnen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f0b425-44e0-4dd3-ae25-470e36dcbf88",
                                "sense_id": "5f495bb4-5701-300b-bb7e-f7c3e9ccc482",
                                "text": "„Wir werden der Welt verkünden, dass es ein schrecklicher Unfall war, der Absturz eines Kleinflugzeugs.“"
                            },
                            {
                                "example_id": "645d1065-7dba-4630-bd98-204ae61d0abb",
                                "sense_id": "5f495bb4-5701-300b-bb7e-f7c3e9ccc482",
                                "text": "„Das ist nicht schwer, wenn vor der Küste ein Archipel aus achtundachtzig Inseln liegt, auf denen mit Drogen beladene Kleinflugzeuge landen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
