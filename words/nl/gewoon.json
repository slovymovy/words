                {
                    "sense_id": "dd120848-8488-3a87-aa1b-f7c05798e4ca",
                    "sense_definition": "Ermee vertrouwd zijn; het als een gewoonte ervaren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accustomed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is <gewoon> om iedere zaterdag vroeg op te staan.",
                            "target_lang_translations": {
                                "en": "She is <w>used</w> to getting up early every Saturday.",
                                "ru": "Она <привыкла> вставать рано каждую субботу.",
                                "pl": "Ona <w>ma w zwyczaju</w> wstawać wcześnie w każdą sobotę.",
                                "de": "Sie ist es <w>gewohnt</w>, jeden Samstag früh aufzustehen.",
                                "fr": "Elle a l'<w>habitude</w> de se lever tôt tous les samedis.",
                                "it": "Lei è <w>abituata</w> ad alzarsi presto ogni sabato.",
                                "cs": "Je <w>zvyklá</w> každou sobotu vstávat brzy.",
                                "tr": "O, her cumartesi erken kalkmaya <w>alışkındır</w>.",
                                "es": "Ella está <w>acostumbrada</w> a levantarse temprano todos los sábados."
                            }
                        },
                        {
                            "text": "Wij waren <gewoon> om elke zondag naar de kerk te gaan.",
                            "target_lang_translations": {
                                "en": "We were <w>accustomed</w> to going to church every Sunday.",
                                "ru": "Мы <привыкли> ходить в церковь каждое воскресенье.",
                                "pl": "Mieliśmy <w>w zwyczaju</w> chodzić do kościoła w każdą niedzielę.",
                                "de": "Wir waren es <w>gewohnt</w>, jeden Sonntag in die Kirche zu gehen.",
                                "fr": "Nous avions l'<w>habitude</w> d'aller à l'église tous les dimanches.",
                                "it": "Eravamo <w>soliti</w> andare in chiesa ogni domenica.",
                                "cs": "Byli jsme <w>zvyklí</w> chodit každou neděli do kostela.",
                                "tr": "Her pazar kiliseye gitmeye <w>alışmıştık</w>.",
                                "es": "<w>Solíamos</w> ir a la iglesia todos los domingos."
                            }
                        }
                    ],
                    "synonyms": [
                        "gewend"
                    ],
                    "common_phrases": [
                        "gewoon zijn te",
                        "gewoon zijn om",
                        "iets gewoon zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "To be familiar with something; to experience it as a habit.",
                        "ru": "Быть знакомым с чем-то; воспринимать как привычку.",
                        "pl": "Być z czymś oswojonym; doświadczać czegoś jako nawyku.",
                        "de": "Mit etwas vertraut sein; es als Gewohnheit empfinden.",
                        "fr": "Être familiarisé avec quelque chose ; en avoir l'habitude.",
                        "it": "Avere familiarità con qualcosa; viverlo come un'abitudine.",
                        "cs": "Být s něčím obeznámen; mít to jako zvyk.",
                        "tr": "Bir şeye aşina olmak; onu bir alışkanlık olarak yaşamak.",
                        "es": "Estar familiarizado con algo; experimentarlo como un hábito."
                    },
