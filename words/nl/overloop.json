    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e4fafa2-e93d-3432-979c-4f9efa937740",
                    "sense_definition": "Een gang of ruimte op een bovenverdieping waar de trap op uitkomt en die toegang geeft tot de kamers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen spelen vaak op de <w>overloop</w> voor hun slaapkamers.",
                            "target_lang_translations": {
                                "en": "The children often play on the <w>landing</w> in front of their bedrooms."
                            }
                        },
                        {
                            "text": "Op de <w>overloop</w> boven aan de trap stond een grote vaas met plastic bloemen.",
                            "target_lang_translations": {
                                "en": "On the <w>landing</w> at the top of the stairs stood a large vase with plastic flowers."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A hallway or space on an upper floor where the stairs lead to and which provides access to the rooms."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "landing",
                                "target_lang_sense_clarification": "area at the top of stairs"
                            },
                            {
                                "target_lang_word": "upper hallway",
                                "target_lang_sense_clarification": "corridor on a higher floor"
                            }
                        ]
                    },
                    "common_phrases": [
                        "op de overloop",
                        "de overloop schilderen"
                    ]
                },
                {
                    "sense_id": "bbb0fa8c-934e-3113-8ff7-f48b03c76b0b",
                    "sense_definition": "Een opening of buis die bedoeld is om overtollige vloeistof veilig af te voeren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wasbak heeft een kleine <w>overloop</w> om te voorkomen dat het water over de rand stroomt.",
                            "target_lang_translations": {
                                "en": "The sink has a small <w>overflow</w> to prevent the water from flowing over the edge."
                            }
                        },
                        {
                            "text": "Controleer of de <w>overloop</w> van de regenpijp niet verstopt is door bladeren.",
                            "target_lang_translations": {
                                "en": "Check if the <w>overflow</w> of the drainpipe is not blocked by leaves."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overloop van de wasbak"
                    ],
                    "target_lang_definitions": {
                        "en": "An opening or pipe intended to safely drain excess liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overflow",
                                "target_lang_sense_clarification": "drainage pipe or opening"
                            },
                            {
                                "target_lang_word": "overflow pipe",
                                "target_lang_sense_clarification": "technical drainage component"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e635a4-2c5c-3711-a6a4-6245d90aa040",
                    "sense_definition": "De geleidelijke overgang van de ene kleur, toestand of situatie naar de andere.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overgang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit schilderij zie je een prachtige <w>overloop</w> van blauw naar groen.",
                            "target_lang_translations": {
                                "en": "In this painting, you see a beautiful <w>gradient</w> from blue to green."
                            }
                        },
                        {
                            "text": "Er is een natuurlijke <w>overloop</w> tussen de verschillende seizoenen in dit klimaat.",
                            "target_lang_translations": {
                                "en": "There is a natural <w>transition</w> between the different seasons in this climate."
                            }
                        }
                    ],
                    "synonyms": [
                        "overgang"
                    ],
                    "common_phrases": [
                        "vloeiende overloop"
                    ],
                    "target_lang_definitions": {
                        "en": "The gradual transition from one color, state, or situation to another."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gradient",
                                "target_lang_sense_clarification": "visual color transition"
                            },
                            {
                                "target_lang_word": "transition",
                                "target_lang_sense_clarification": "gradual change between states"
                            },
                            {
                                "target_lang_word": "blend",
                                "target_lang_sense_clarification": "smooth merging of elements"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efbeee00-b2af-3f8b-9139-db89be422bdc",
                    "sense_definition": "De hoeveelheid vloeistof of materie die over de rand van een vat is gestroomd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>overloop</w> van de emmer maakte de hele keukenvloer nat.",
                            "target_lang_translations": {
                                "en": "The <w>overflow</w> from the bucket made the entire kitchen floor wet."
                            }
                        },
                        {
                            "text": "We moeten de <w>overloop</w> direct opruimen voordat het in het tapijt trekt.",
                            "target_lang_translations": {
                                "en": "We must clean up the <w>spillage</w> immediately before it soaks into the carpet."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The amount of liquid or matter that has flowed over the edge of a container."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overflow",
                                "target_lang_sense_clarification": "spilled liquid"
                            },
                            {
                                "target_lang_word": "spillage",
                                "target_lang_sense_clarification": "matter that has leaked out"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "776c6a36-c4f7-3a47-86a7-590477067f6f",
                    "sense_definition": "Het statistische verschil tussen het niveau aan het einde van een jaar en het gemiddelde van dat jaar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statistiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economische <w>overloop</w> naar het nieuwe jaar was groter dan de experts hadden verwacht.",
                            "target_lang_translations": {
                                "en": "The economic <w>carry-over</w> to the new year was larger than the experts had expected."
                            }
                        },
                        {
                            "text": "Door een hoge <w>overloop</w> begint de groei volgend jaar al op een gunstig punt.",
                            "target_lang_translations": {
                                "en": "Due to a high <w>overhang</w>, growth next year starts at a favorable point."
                            }
                        }
                    ],
                    "common_phrases": [
                        "economische overloop"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "economische term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The statistical difference between the level at the end of a year and the average of that year."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carry-over effect",
                                "target_lang_sense_clarification": "statistical/economic term"
                            },
                            {
                                "target_lang_word": "overhang",
                                "target_lang_sense_clarification": "economic growth from previous period"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d8e93fb-6bb2-3d7b-b9dc-ac3a0d3b7dd7",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>overlopen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>overloop</w> de lijst met boodschappen nog één keer voor ik vertrek.",
                            "target_lang_translations": {
                                "en": "I <w>go over</w> the grocery list one more time before I leave."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>overloop</w> ik mijn agenda om te zien welke afspraken ik heb.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>review</w> my schedule to see what appointments I have."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de lijst overloop"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'to go over' or 'to review'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go over",
                                "target_lang_sense_clarification": "reviewing a list or plan"
                            },
                            {
                                "target_lang_word": "review",
                                "target_lang_sense_clarification": "checking details"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1683e612-4b9a-38f8-83fc-f321472cbe0d",
                    "sense_definition": "De gebiedende wijs van <w>overlopen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Overloop</w> de tekst zorgvuldig op spelfouten voordat je hem inlevert.",
                            "target_lang_translations": {
                                "en": "<w>Go over</w> the text carefully for spelling errors before you hand it in."
                            }
                        },
                        {
                            "text": "<w>Overloop</w> de belangrijkste punten van de presentatie nog eenmaal.",
                            "target_lang_translations": {
                                "en": "<w>Review</w> the most important points of the presentation once more."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative mood of 'to go over' or 'to check'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go over",
                                "target_lang_sense_clarification": "command to check something"
                            },
                            {
                                "target_lang_word": "check",
                                "target_lang_sense_clarification": "command to verify"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeec5f4d-4323-3fc7-9bb2-7bce26531580",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>overlopen</w> in een bijzin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk dat ik de details nog eens <w>overloop</w> met mijn collega.",
                            "target_lang_translations": {
                                "en": "It is important that I <w>go over</w> the details once more with my colleague."
                            }
                        },
                        {
                            "text": "Ik zorg ervoor dat ik de planning <w>overloop</w> voordat de vergadering begint.",
                            "target_lang_translations": {
                                "en": "I make sure that I <w>review</w> the planning before the meeting starts."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "afhankelijke zin"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'to go over' in a subordinate clause."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go over",
                                "target_lang_sense_clarification": "reviewing in a dependent context"
                            }
                        ]
                    }
                }
            ]
        }
    ]
