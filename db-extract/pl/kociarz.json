                        ]
                    },
                    {
                        "translation_id": "f0da705c-cf89-4537-a572-a512771f3b13",
                        "source_entry_id": "5e1721b5-3412-346c-9b4e-404c22615314",
                        "source_sense_id": "f99720bd-4d85-3419-9068-dc08ff66bb06",
                        "target_lang_word": "ailurophile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailurophile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                        "entry_id": "40957673-4dbb-3a06-8398-a3ff5c155a9f",
                                        "glosses": [
                                            "A person with ailurophilia; a cat-lover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42815062-0e49-4316-a987-9fd40b1fd45e",
                                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                                "text": "He played the piano well, was an enthusiastic ailurophile, and persistently played solitaire while talking and writing."
                                            },
                                            {
                                                "example_id": "94c1ed4b-72d1-42cf-855a-cba53f75b9fb",
                                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                                "text": "When the archbishop would send Philip on an assignment, he would leave the cat in the care of the archbishop, who apparently was not an ailurophile."
                                            },
                                            {
                                                "example_id": "f0fa9d50-2973-4f7a-a083-c1cbd5e25cb4",
                                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                                "text": "Alicia is not a serious ailurophile, however; she neglects Chestnut, and Chestnut knows it."
                                            },
                                            {
                                                "example_id": "ade073bf-e00a-4e4c-8516-8e91c496e861",
                                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                                "text": "Your identity as an ailurophile (cat lover) is confirmed by cat hair on your clothes, but that is a distinction that most of us will gladly forfeit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
