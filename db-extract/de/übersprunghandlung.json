                "senses": [
                    {
                        "sense_id": "b75fdc74-e1c0-3065-9f2e-b2e720e9c4be",
                        "entry_id": "a89fd20a-fc81-3607-ae4f-7240aaab6461",
                        "glosses": [
                            "Verhaltensweise ohne sinnvollen Bezug zur aktuellen Situation, unerwartetes Verhalten in einer Konfliktsituation"
                        ],
                        "tags": [
                            "Ethologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0dfb800c-249b-4890-be1a-6c10a9e476ba",
                                "sense_id": "b75fdc74-e1c0-3065-9f2e-b2e720e9c4be",
                                "text": "Auslöser für eine Übersprunghandlung kann zum Beispiel Trennungsschmerz sein."
                            },
                            {
                                "example_id": "ed44528d-6299-4cc1-8c6a-dba3fc21581a",
                                "sense_id": "b75fdc74-e1c0-3065-9f2e-b2e720e9c4be",
                                "text": "Der kann sich beim Anfassen fremder Füße das Lachen nicht verkneifen: „Das kommt, weil ich verlegen bin. Das nennt man wohl eine klassische Übersprunghandlung.“"
                            },
                            {
                                "example_id": "b7a7f989-edb6-463f-aa13-df2766616d1e",
                                "sense_id": "b75fdc74-e1c0-3065-9f2e-b2e720e9c4be",
                                "text": "In einer Art hilfloser Übersprunghandlung räumt der Regisseur in seinem chaotischen Garten Geranien auf."
                            },
                            {
                                "example_id": "dd2c7d44-db3b-4cc1-a611-d365e73e2fef",
                                "sense_id": "b75fdc74-e1c0-3065-9f2e-b2e720e9c4be",
                                "text": "„Ein weiteres krasses Fallbeispiel für Trennung kompensierende Übersprunghandlungen kam mir in den Sinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
