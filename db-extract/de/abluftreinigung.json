                "senses": [
                    {
                        "sense_id": "11ae6dab-467a-3762-a2c3-301949f7d642",
                        "entry_id": "4081b448-d6f4-3d8c-9cf6-34cccc909373",
                        "glosses": [
                            "Reinigung der aus einem Raum abgesaugten Luft in lüftungstechnischen Anlagen mittels technischer Verfahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd3edb3b-575f-4953-8646-5a519116e8ad",
                                "sense_id": "11ae6dab-467a-3762-a2c3-301949f7d642",
                                "text": "„Bei der katalytischen Abluftreinigung werden Spuren organischer Verunreinigungen, die zum Beispiel im Entlüftungssystem einer Lackiererei anfallen, zu Wasser und Kohlendioxid oxidiert.“"
                            },
                            {
                                "example_id": "c964b90b-7c89-4c40-9ae6-802f2e8d88cc",
                                "sense_id": "11ae6dab-467a-3762-a2c3-301949f7d642",
                                "text": "„Wie bei der katalytischen ist auch bei der thermischen Abluftreinigung eine gute Vermischung von Brennstoff und Luft sowie eine ausreichende Luftmenge und Verweilzeit erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
