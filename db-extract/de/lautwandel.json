                ],
                "senses": [
                    {
                        "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                        "entry_id": "b3bee404-bd1b-377d-9d38-7e4ecf808098",
                        "glosses": [
                            "Veränderung von Lauten einer Sprache im Lauf der Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44942316-c981-4e7d-b11a-d994b2b75449",
                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                "text": "Die sog. Lautgesetze geben viele Beispiele von Lautwandel an. In der zweiten, hochdeutschen Lautverschiebung wurde z.B. germanisch [t] (germ. \"holta\" \"Holz\") zu althochdeutsch [ts] (ahd. \"holz\")."
                            },
                            {
                                "example_id": "2d778e5c-e2ef-4923-9a78-03ca07b65ab2",
                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                "text": "„Dieser Lautwandel sondert die süd- und mitteldeutschen Mundarten, zusammenfassend Hochdeutsch genannt.“"
                            },
                            {
                                "example_id": "8d7adc36-4cbd-4b2b-bc03-ddc4c0df7f3c",
                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                "text": "„Um die Erscheinung zu begreifen, die man als Lautwandel zu bezeichnen pflegt, muss man sich die physischen und psychischen Prozesse klar machen, welche immerfort bei der Hervorbringung der Lautkomplexe stattfinden.“"
                            },
                            {
                                "example_id": "d984283c-510f-41df-b6a7-5a5d348aae37",
                                "sense_id": "ea136053-91ad-32e3-92e2-3cff2044cfb7",
                                "text": "„Von vielen Vorgängen der Vereinfachung im grammatischen Gerüst wird vermutet, daß sie ursächlich mit Lautwandel in Verbindung stehen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
