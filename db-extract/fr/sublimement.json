        "fr-extract.jsonl": [
            {
                "entry_id": "b28050cd-c787-3367-abba-46dd39de9a17",
                "word": "sublimement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab3d9ae8-e984-301f-8b46-d20c630d14f8",
                        "entry_id": "b28050cd-c787-3367-abba-46dd39de9a17",
                        "glosses": [
                            "D’une manière sublime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef684c2e-c5f5-48c1-a418-f698f688408e",
                                "sense_id": "ab3d9ae8-e984-301f-8b46-d20c630d14f8",
                                "text": "Je pourrais faire un ouvrage qui prouvât que les choses les plus sublimement étranges qui nous frappent [dans les écrits du jour] sont un réchauffé des anciens temps,"
                            },
                            {
                                "example_id": "193793ce-12c1-4d7e-9860-86c374a78712",
                                "sense_id": "ab3d9ae8-e984-301f-8b46-d20c630d14f8",
                                "text": "C'est [une lettre de Diderot à Voltaire] une critique assez sensée de son Tancrède ; c’est un éloge de ses ouvrages, surtout de son Histoire universelle, dont ils [Damilaville et Thiriot] pensent que j'ai parlé sublimement,"
                            }
                        ]
                    }
                ],
