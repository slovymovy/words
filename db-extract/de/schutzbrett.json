                            {
                                "example_id": "4b56afb5-fffa-4418-8070-f7edf75129f6",
                                "sense_id": "6bb667f0-d02e-35b8-bd6a-605f409960a0",
                                "text": "„Gegen Regen oder starke Sonnenstrahlen muß der Stand durch Schutzbretter verwahrt werden.“"
                            },
                            {
                                "example_id": "7c8f31a8-1584-4a66-b3b4-e2d2f28cdb02",
                                "sense_id": "6bb667f0-d02e-35b8-bd6a-605f409960a0",
                                "text": "„Die Schutzbretter, welche vor den Rinnen stehen, wodurch das Wasser auf die Räder läuft, werden mit metallenen Schrauben aufgezogen.“"
                            }
                        ],
