        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45c47907-1c64-35b1-8b7c-0f78e857409d",
                    "sense_definition": "That which annoys; an annoyance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to ignore the daily <w>annoyings</w> of life in the crowded city.",
                            "target_lang_translations": {
                                "ru": "Он пытался игнорировать повседневные <w>неприятности</w> жизни в переполненном городе.",
                                "zh": "他试图忽略在这座拥挤城市中生活的日常<w>烦心事</w>。"
                            }
                        },
                        {
                            "text": "Their hearts are filled with uncharitableness and bitter <w>annoyings</w>.",
                            "target_lang_translations": {
                                "ru": "Их сердца наполнены нетерпимостью и горькими <w>досадами</w>.",
                                "zh": "他们的心中充满了刻薄和苦涩的<w>烦恼</w>。"
                            }
                        }
