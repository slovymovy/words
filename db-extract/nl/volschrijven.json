                "senses": [
                    {
                        "sense_id": "3bb22a9d-c8bd-3d8f-9623-52be83e817fc",
                        "entry_id": "2e1a84f2-65bf-33d2-91f3-6c7ed8853963",
                        "glosses": [
                            "to fill with writing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdbd709b-7b7c-48e1-84a2-8310dd0d7c60",
                                "sense_id": "3bb22a9d-c8bd-3d8f-9623-52be83e817fc",
                                "text": "Hij zal ruim tweeduizend vellen volschrijven, 1 liter inkt verbruiken en ruim 1 kilometer papier nodig hebben.",
                                "translation": "He will fill more than two thousand sheets with writing, use 1 liter of ink and need more than 1 kilometer of paper.",
                                "english": "He will fill more than two thousand sheets with writing, use 1 liter of ink and need more than 1 kilometer of paper."
                            }
                        ]
                    }
