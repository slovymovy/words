{
    "word_family": [
        "embracement",
        "embracer",
        "embracery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21246345-2962-3097-a315-3f9b5c017cfa",
                    "sense_definition": "To clasp someone in the arms with affection; to take in the arms; to hug.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two friends decided to <w>embrace</w> warmly after not seeing each other for many years.",
                            "target_lang_translations": {
                                "ru": "Двое друзей решили тепло <w>обняться</w> после того, как не виделись много лет."
                            }
                        },
                        {
                            "text": "She stood on tiptoe to <w>embrace</w> him before he boarded the train for his long journey.",
                            "target_lang_translations": {
                                "ru": "Она встала на цыпочки, чтобы <w>обнять</w> его перед тем, как он сел в поезд для долгого путешествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "hug",
                        "hold",
                        "squeeze",
                        "press",
                        "enfold"
                    ],
                    "antonyms": [
                        "push away",
                        "release"
                    ],
                    "common_phrases": [
                        "warmly embrace",
                        "tenderly embrace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обнимать кого-либо, выражая привязанность или любовь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнимать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "обнять",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7af95e60-d1ff-378b-889f-a9f3bcf24204",
                    "sense_definition": "To seize something eagerly; to accept or take up a new idea, belief, or opportunity with enthusiasm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>embrace</w> the opportunity to expand into international markets this year.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>воспользоваться</w> возможностью выйти на международные рынки в этом году."
                            }
                        },
                        {
                            "text": "Many people choose to <w>embrace</w> a new lifestyle when they move to a different country.",
                            "target_lang_translations": {
                                "ru": "Многие люди решают <w>принять</w> новый образ жизни при переезде в другую страну."
                            }
                        }
                    ],
                    "synonyms": [
                        "accept",
                        "welcome",
                        "adopt"
                    ],
                    "antonyms": [
                        "reject",
                        "refuse",
                        "spurn"
                    ],
                    "common_phrases": [
                        "embrace the opportunity",
                        "embrace a lifestyle",
                        "wholeheartedly embrace"
                    ],
                    "target_lang_definitions": {
                        "ru": "С энтузиазмом принимать новую идею, веру или возможность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "идею или образ жизни"
                            },
                            {
                                "target_lang_word": "воспользоваться",
                                "target_lang_sense_clarification": "возможностью"
                            },
                            {
                                "target_lang_word": "избрать",
                                "target_lang_sense_clarification": "путь или стиль жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a0b4d3-0f97-3980-ab11-87094cba08a5",
                    "sense_definition": "To enfold or include various ideas, principles, or subjects; to encompass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new curriculum will <w>embrace</w> many sciences, including biology, chemistry, and physics.",
                            "target_lang_translations": {
                                "ru": "Новая учебная программа будет <w>охватывать</w> многие науки, включая биологию, химию и физику."
                            }
                        },
                        {
                            "text": "His philosophical work aims to <w>embrace</w> a wide range of human experiences and emotions.",
                            "target_lang_translations": {
                                "ru": "Его философский труд стремится <w>включить</w> в себя широкий спектр человеческого опыта и эмоций."
                            }
                        }
                    ],
                    "synonyms": [
                        "enfold",
                        "surround",
                        "complect"
                    ],
                    "antonyms": [
                        "exclude",
                        "omit"
                    ],
                    "common_phrases": [
                        "fully embrace",
                        "embrace a range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать в себя или охватывать различные идеи, принципы или предметы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охватывать",
                                "target_lang_sense_clarification": "круг вопросов или тем"
                            },
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "в свой состав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eb43169-c151-3642-814d-b627bbe50600",
                    "sense_definition": "To submit to or undergo a situation, often with patience or resignation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>embrace</w> this fortune patiently, as there was no way to avoid the outcome.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось терпеливо <w>принять</w> эту участь, так как избежать исхода было невозможно."
                            }
                        },
                        {
                            "text": "The population has largely <w>embraced</w> the strict government instructions to protect public health.",
                            "target_lang_translations": {
                                "ru": "Население в значительной степени <w>приняло</w> строгие инструкции правительства по защите общественного здоровья."
                            }
                        }
                    ],
                    "synonyms": [
                        "accept",
                        "comply"
                    ],
                    "antonyms": [
                        "resist",
                        "rebel"
                    ],
                    "common_phrases": [
                        "embrace the challenge",
                        "embrace the change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смириться с ситуацией или принять её с терпением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "судьбу или вызов"
                            },
                            {
                                "target_lang_word": "смириться",
                                "target_lang_sense_clarification": "с неизбежным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f5f2e23-6893-31c4-8acb-bf609b89666b",
                    "sense_definition": "To encircle, enclose, or encompass physically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_surrounding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The valley was <w>embraced</w> by high mountains that provided shelter from the cold winds.",
                            "target_lang_translations": {
                                "ru": "Долина была <w>окружена</w> высокими горами, которые служили укрытием от холодных ветров."
                            }
                        },
                        {
                            "text": "The river seemed to <w>embrace</w> the small island as it flowed around both sides.",
                            "target_lang_translations": {
                                "ru": "Река словно <w>окаймляла</w> маленький остров, обтекая его с обеих сторон."
                            }
                        }
                    ],
                    "synonyms": [
                        "surround",
                        "enfold"
                    ],
                    "common_phrases": [
                        "embraced by mountains"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or descriptive contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически окружать или заключать в кольцо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "физически"
                            },
                            {
                                "target_lang_word": "окаймлять",
                                "target_lang_sense_clarification": "литературно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03d18933-afe9-30e3-bf46-64fff7942c16",
                    "sense_definition": "To accept someone as a friend or to accept their help gladly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community was quick to <w>embrace</w> him when he first arrived in the village.",
                            "target_lang_translations": {
                                "ru": "Община быстро <w>приняла</w> его, когда он впервые прибыл в деревню."
                            }
                        },
                        {
                            "text": "She was grateful that the team chose to <w>embrace</w> her as a new member so quickly.",
                            "target_lang_translations": {
                                "ru": "Она была благодарна за то, что команда так быстро решила <w>принять</w> её в качестве нового участника."
                            }
                        }
                    ],
                    "synonyms": [
                        "accept"
                    ],
                    "antonyms": [
                        "shun",
                        "reject"
                    ],
                    "common_phrases": [
                        "embrace as a friend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радушно принимать кого-либо в качестве друга или принимать чью-либо помощь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "в коллектив или круг друзей"
                            },
                            {
                                "target_lang_word": "радушно встретить",
                                "target_lang_sense_clarification": "нового человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04f0ad84-3af3-32f9-aece-7eae2112c4ec",
                    "sense_definition": "To fasten on, specifically referring to putting on armor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight began to <w>embrace</w> his warlike arms before heading into the battlefield.",
                            "target_lang_translations": {
                                "ru": "Рыцарь начал <w>облачаться</w> в свои боевые доспехи перед тем, как отправиться на поле битвы."
                            }
                        },
                        {
                            "text": "He had to <w>embrace</w> his shield tightly as the enemy approached the castle gates.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось крепко <w>сжать</w> свой щит, когда враг приблизился к воротам замка."
                            }
                        }
                    ],
                    "synonyms": [],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or poetic contexts regarding armor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Надевать или закреплять доспехи (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачаться",
                                "target_lang_sense_clarification": "в доспехи"
                            },
                            {
                                "target_lang_word": "надевать",
                                "target_lang_sense_clarification": "вооружение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4e1dca8-0d5c-3694-81be-442b30fb15ee",
                    "sense_definition": "To attempt to influence a court or jury corruptly; to practice embracery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was accused of trying to <w>embrace</w> the jury to secure a favorable verdict.",
                            "target_lang_translations": {
                                "ru": "Адвоката обвинили в попытке <w>подкупить</w> присяжных, чтобы добиться благоприятного вердикта."
                            }
                        },
                        {
                            "text": "The punishment for <w>embracing</w> a juror includes heavy fines and potential imprisonment.",
                            "target_lang_translations": {
                                "ru": "Наказание за <w>давление</w> на присяжного включает крупные штрафы и возможное тюремное заключение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "embrace a jury"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться незаконно повлиять на суд или присяжных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкупать",
                                "target_lang_sense_clarification": "присяжных"
                            },
                            {
                                "target_lang_word": "оказывать давление",
                                "target_lang_sense_clarification": "на суд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9fa97cf-72a1-3fff-a7d3-f5812ae731f3",
                    "sense_definition": "An act of putting arms around someone and bringing them close; a hug.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They shared a long and affectionate <w>embrace</w> before saying goodbye at the airport.",
                            "target_lang_translations": {
                                "ru": "Они обменялись долгим и нежным <w>объятием</w> перед прощанием в аэропорту."
                            }
                        },
                        {
                            "text": "The child ran to his mother and held her in a tight <w>embrace</w> after school.",
                            "target_lang_translations": {
                                "ru": "Ребенок подбежал к матери и заключил ее в крепкие <w>объятия</w> после школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "hug"
                    ],
                    "common_phrases": [
                        "affectionate embrace",
                        "warm embrace",
                        "tight embrace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, при котором человека обхватывают руками; объятие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объятие",
                                "target_lang_sense_clarification": "ед. число"
                            },
                            {
                                "target_lang_word": "объятия",
                                "target_lang_sense_clarification": "мн. число"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "882fd959-4496-3052-8f3e-3bddecc474e7",
                    "sense_definition": "The full acceptance of an idea, belief, or faith.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her eager <w>embrace</w> of the new religion surprised many of her old friends.",
                            "target_lang_translations": {
                                "ru": "Ее ревностное <w>принятие</w> новой религии удивило многих ее старых друзей."
                            }
                        },
                        {
                            "text": "The public's <w>embrace</w> of the new technology happened much faster than experts predicted.",
                            "target_lang_translations": {
                                "ru": "Пользовательское <w>принятие</w> новой технологии произошло гораздо быстрее, чем предсказывали эксперты."
                            }
                        }
                    ],
                    "synonyms": [
                        "accept"
                    ],
                    "antonyms": [
                        "rejection",
                        "denial"
                    ],
                    "common_phrases": [
                        "eager embrace",
                        "total embrace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное принятие идеи, веры или убеждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принятие",
                                "target_lang_sense_clarification": "идеи или веры"
                            },
                            {
                                "target_lang_word": "приверженность",
                                "target_lang_sense_clarification": "новому курсу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46e3035f-c9b9-3f4a-b2c1-a540ae53d233",
                    "sense_definition": "An enclosure that partially or fully surrounds someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_surrounding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was now within the <w>embrace</w> of a broad bay flanked by promontories.",
                            "target_lang_translations": {
                                "ru": "Корабль теперь находился в <w>кольце</w> широкого залива, окруженного мысами."
                            }
                        },
                        {
                            "text": "The thick fog caught him in its <w>embrace</w> and hid him from view.",
                            "target_lang_translations": {
                                "ru": "Густой туман заключил его в свои <w>объятия</w> и скрыл из виду."
                            }
                        }
                    ],
                    "synonyms": [
                        "surround"
                    ],
                    "common_phrases": [
                        "within the embrace"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство, которое частично или полностью окружает что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кольцо",
                                "target_lang_sense_clarification": "окружающее пространство"
                            },
                            {
                                "target_lang_word": "объятия",
                                "target_lang_sense_clarification": "переносно о природе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1f8fd30-6823-3b0d-8782-fc8f77b86360",
                    "sense_definition": "An act of enfolding or including various elements together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The living truth holds all things, body and soul, in its <w>embrace</w>.",
                            "target_lang_translations": {
                                "ru": "Живая истина держит всё сущее, тело и душу, в своем <w>охвате</w>."
                            }
                        },
                        {
                            "text": "The philosopher spoke of the <w>embrace</w> of all humanity within a single moral framework.",
                            "target_lang_translations": {
                                "ru": "Философ говорил об <w>объединении</w> всего человечества в рамках единой моральной системы."
                            }
                        }
                    ],
                    "synonyms": [
                        "enfold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт объединения или включения различных элементов вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охват",
                                "target_lang_sense_clarification": "совокупность элементов"
                            },
                            {
                                "target_lang_word": "единство",
                                "target_lang_sense_clarification": "включение всех частей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}