    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20f6d176-f374-35e4-9cb4-db06cd125d3a",
                    "sense_definition": "de handeling van het ondersteunen of bijstaan van iemand in een moeilijke situatie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ondersteuning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik bedankte hem hartelijk voor zijn <w>hulp</w> bij het dragen van de tassen.",
                            "target_lang_translations": {
                                "en": "I thanked him warmly for his <w>help</w> with carrying the bags."
                            }
                        },
                        {
                            "text": "Zij hebben dringend <w>hulp</w> nodig om dit project op tijd af te ronden.",
                            "target_lang_translations": {
                                "en": "They urgently need <w>assistance</w> to finish this project on time."
                            }
                        },
                        {
                            "text": "De buren boden hun <w>hulp</w> aan toen onze auto niet wilde starten.",
                            "target_lang_translations": {
                                "en": "The neighbors offered their <w>help</w> when our car wouldn't start."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijstand"
                    ],
                    "common_phrases": [
                        "hulp aanbieden",
                        "hulp vragen",
                        "om hulp roepen"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of supporting or assisting someone in a difficult situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "general assistance or aid"
                            },
                            {
                                "target_lang_word": "assistance",
                                "target_lang_sense_clarification": "formal support or help"
                            },
                            {
                                "target_lang_word": "aid",
                                "target_lang_sense_clarification": "relief or support, often in a crisis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8f4de60-7ab3-367d-9b9f-a42f301c48a5",
                    "sense_definition": "een persoon die iemand anders assisteert of ondersteunt bij het uitvoeren van een taak",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "assistentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bakker heeft een nieuwe <w>hulp</w> aangenomen voor de vroege ochtenduren.",
                            "target_lang_translations": {
                                "en": "The baker has hired a new <w>assistant</w> for the early morning hours."
                            }
                        },
                        {
                            "text": "Als <w>hulp</w> in de huishouding komt zij twee keer per week bij ons langs.",
                            "target_lang_translations": {
                                "en": "As a domestic <w>helper</w>, she visits us twice a week."
                            }
                        }
                    ],
                    "synonyms": [
                        "assistent",
                        "helper",
                        "assistente",
                        "helpster"
                    ],
                    "common_phrases": [
                        "hulp in de huishouding"
                    ],
                    "target_lang_definitions": {
                        "en": "a person who assists or supports someone else in performing a task"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assistant",
                                "target_lang_sense_clarification": "a person in a subordinate position who helps"
                            },
                            {
                                "target_lang_word": "helper",
                                "target_lang_sense_clarification": "someone who provides help with a task"
                            },
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "domestic staff or hired assistance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4843786-7c9a-33f3-9aa9-f004bd8acaa0",
                    "sense_definition": "iets dat dient als ondersteuning of als extra middel om een doel te bereiken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "middelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze kleine motor dient als <w>hulp</w> wanneer er te weinig wind is om te zeilen.",
                            "target_lang_translations": {
                                "en": "This small motor serves as an <w>aid</w> when there is too little wind for sailing."
                            }
                        },
                        {
                            "text": "Het woordenboek is een onmisbare <w>hulp</w> bij het vertalen van deze tekst.",
                            "target_lang_translations": {
                                "en": "The dictionary is an indispensable <w>help</w> when translating this text."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "something that serves as support or as an extra means to achieve a goal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aid",
                                "target_lang_sense_clarification": "a material source of help or a tool"
                            },
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "something that provides assistance"
                            },
                            {
                                "target_lang_word": "resource",
                                "target_lang_sense_clarification": "a useful means or tool"
                            }
                        ]
                    }
                }
            ]
        }
    ]
