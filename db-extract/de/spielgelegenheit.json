                ],
                "senses": [
                    {
                        "sense_id": "5738b0b8-b069-31bd-9875-809aba3d4ef4",
                        "entry_id": "b6ceb8c7-b8ec-3d2b-9da3-b0e968a408ac",
                        "glosses": [
                            "situativ gegebene Möglichkeit zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9738584-c848-4068-9810-2550f7b01bd1",
                                "sense_id": "5738b0b8-b069-31bd-9875-809aba3d4ef4",
                                "text": "„Wissen wir überhaupt noch genug darüber, was Spielen eigentlich heißt, was Spielen für einen Sinn macht, wie man Spielgelegenheiten entdeckt und erschließt, wie man sich selbst und andere ins Spiel bringt und wie werterfülltes Spielen beglücken kann?“"
                            },
                            {
                                "example_id": "09e75c0a-fac0-4d4f-8626-34b20cb3d9ed",
                                "sense_id": "5738b0b8-b069-31bd-9875-809aba3d4ef4",
                                "text": "„Dazu brauchen sie die Geduld der Erwachsenen und eine kinderfreundliche Politik, die ihnen ihre Spielgelegenheiten schützt.“"
                            },
                            {
                                "example_id": "96d39dae-88b9-48e2-a072-3ec9f9b39cde",
                                "sense_id": "5738b0b8-b069-31bd-9875-809aba3d4ef4",
                                "text": "„Aber gerade bei der so wichtigen Frage, wie die Revierparks ausgestattet werden sollen, diese neu zu schaffenden Parkanlagen mit Sport- und Spielgelegenheiten für jedermann, Bädern mit erwärmtem Wasser, Restaurants, wird das Gutachten dem Auftrag kaum gerecht.“"
                            },
                            {
                                "example_id": "2f3b81c6-6d1b-45b0-a0a0-914af4dab251",
                                "sense_id": "5738b0b8-b069-31bd-9875-809aba3d4ef4",
                                "text": "„Als man zu jener Zeit kaum größere Erfolge hatte, argumentierte man, daß die Spieler im Vergleich zur internationalen Konkurrenz zu wenig Spielgelegenheiten hätten.“"
                            },
                            {
                                "example_id": "f73182cb-6320-470a-95e2-b76d701f7f49",
                                "sense_id": "5738b0b8-b069-31bd-9875-809aba3d4ef4",
                                "text": "„Beide Hotels sind behaglich eingerichtete Häuser in parkähnlichen Gärten, mit allen erdenklichen Spielgelegenheiten und erfahrenem Personal ausgestattet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
