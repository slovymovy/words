                                    {
                                        "sense_id": "03c5af8c-5f44-3290-bc4e-37281520d46f",
                                        "entry_id": "5f82d3b1-edbe-3534-96c3-1b5ca83c1770",
                                        "glosses": [
                                            "Mot général utilisé pour désigner une notion ou un objet qu’on ne veut pas ou qu’on ne sait pas nommer plus précisément (pour une personne on dit : Machin)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85803831-6207-4873-98b1-3b4d88597180",
                                                "sense_id": "03c5af8c-5f44-3290-bc4e-37281520d46f",
                                                "text": "Je n’allais donc pas me joindre à un homme qui voulait livrer l’âme de son peuple en pâture aux haut-parleurs et aux machins totalitaires, pour qu’elle fût brassée et broyée jusqu’à devenir cette pulpe méconnaissable : les masses."
                                            },
                                            {
                                                "example_id": "383f860d-79c3-4daf-8bea-a69d4568f66d",
                                                "sense_id": "03c5af8c-5f44-3290-bc4e-37281520d46f",
                                                "text": "C’est sans doute un machin qui m'a piqué, j’ai un gros bouton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b74a6ec-fc09-30d1-b165-b8b18b3c8c78",
                                        "entry_id": "5f82d3b1-edbe-3534-96c3-1b5ca83c1770",
                                        "glosses": [
                                            "S'emploie également quand le contexte permet de préciser le sens."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b204ef9-c9bc-40ec-a85e-5d1c8818a300",
                                                "sense_id": "7b74a6ec-fc09-30d1-b165-b8b18b3c8c78",
                                                "text": "Il me faudrait le machin qui est sur la table devant toi."
                                            },
                                            {
                                                "example_id": "22a043c2-dee6-464a-9706-0a04fa4aa2ec",
                                                "sense_id": "7b74a6ec-fc09-30d1-b165-b8b18b3c8c78",
                                                "text": "Débarrasse-moi tous ces machins de là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d87ac7c3-7711-3004-bfaa-f98ced9f78da",
                                        "entry_id": "5f82d3b1-edbe-3534-96c3-1b5ca83c1770",
                                        "glosses": [
                                            "Pour remplacer certains mots tabous."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ba1fc0-f3e0-4b89-bc3e-4ca41ccc34d6",
                                                "sense_id": "d87ac7c3-7711-3004-bfaa-f98ced9f78da",
                                                "text": "Il a été arrêté pour exhibitionnisme, il se baladait avec son machin à l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a0139a-5319-3421-95fe-e6692af245cd",
                                        "entry_id": "5f82d3b1-edbe-3534-96c3-1b5ca83c1770",
                                        "glosses": [
                                            "Pour désigner une chose incongrue."
