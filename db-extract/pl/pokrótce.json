                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abréviativement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40efb5c7-e93b-3c1f-8fee-0933f53c1e19",
                                        "entry_id": "ba6e63a8-6d9b-3c23-926c-65b58278f837",
                                        "glosses": [
                                            "Par abréviation."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e22d00-1bc7-48e6-b905-448abed51e3e",
                                                "sense_id": "40efb5c7-e93b-3c1f-8fee-0933f53c1e19",
                                                "text": "Mater aurait été mis là abréviativement pour mater sacrorum."
                                            },
                                            {
                                                "example_id": "6cdc253c-5009-4bb3-96e1-3951d6ce58ae",
                                                "sense_id": "40efb5c7-e93b-3c1f-8fee-0933f53c1e19",
                                                "text": "– Gomme ?… Curaçao ?… Quoi ?… me demanda abréviativement le glorieux soldat."
                                            },
                                            {
                                                "example_id": "bbb531e4-9f1a-4f95-bcd2-4243edfc8b94",
                                                "sense_id": "40efb5c7-e93b-3c1f-8fee-0933f53c1e19",
                                                "text": "En dehors du culte de Mars qui y conserva son principal sanctuaire, le Champ, comme on l'appelait abréviativement , fut le lieu des exercices ou divertissements qui exigeaient plus d'espace que n'en offraient les bâtiments couverts, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be76004b-04be-4058-a7c0-b2fd7f2f3056",
                        "source_entry_id": "8bb56f22-d92d-36f8-8863-440499dc8ac5",
                        "source_sense_id": "a6deb703-f602-3710-8c61-42cfe09116c1",
                        "target_lang_word": "вкратце",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вкратце",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                        "entry_id": "4bacf3bd-fafd-3ee1-8847-12926ba4adb7",
                                        "glosses": [
                                            "кратко, сжато"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "becb5b8f-8d8c-459b-a1fe-fe09f983d2a3",
                                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                                "text": "Итак, вот вкратце мое мнение по сему предмету."
                                            },
                                            {
                                                "example_id": "4df4150d-1335-41b7-9152-c4519354213c",
                                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                                "text": "В дневнике отца Фоки отмечены две визитации этого владыки (тоже уже скончавшегося) ― одна вкратце и вскользь, а другая поспокойнее и попросторнее."
                                            },
                                            {
                                                "example_id": "51c0a688-ca48-44fb-9546-d41b024244be",
                                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                                "text": "И он с свойственною ему ясностью рассказал вкратце эти новые, очень важные и интересные открытия."
                                            },
                                            {
                                                "example_id": "9c97395a-0897-4ec3-b937-48ba74c1d9a8",
                                                "sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                                                "text": "Скажи мне вкратце, кто они, а им ― кто я, и будем наслаждаться жизнью!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
