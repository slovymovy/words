                            }
                        ]
                    },
                    {
                        "translation_id": "c9ddc408-b5fc-4cdd-af37-29bd4f0a239b",
                        "source_entry_id": "6cff4ebb-a84c-342e-bc76-a66674debd7b",
                        "source_sense_description": "exceptionally great",
                        "target_lang_word": "sensationnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensationnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65016041-8f87-3c74-a924-81fc024e0df0",
                                        "entry_id": "0b5212b5-678a-36b1-ad5b-007e5c5e74d6",
                                        "glosses": [
                                            "Qui fait sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f195da-6b90-4790-b12d-a85070731c53",
                                                "sense_id": "65016041-8f87-3c74-a924-81fc024e0df0",
                                                "text": "N’empêche que quelques-unes des phrases les plus sensationnelles de ce livre me sont venues ainsi, dans des cafés ou dans des promenoirs, pendant que je flânais ou bavardais, en regardant, quelquefois sans les voir, des visages de femmes pénétrants et fatigués."
                                            },
                                            {
                                                "example_id": "d6d9c290-7bcb-435c-a3f0-5256c4692ea0",
                                                "sense_id": "65016041-8f87-3c74-a924-81fc024e0df0",
                                                "text": "La nature humaine n'est point stationnaire et, chaque jour, elle apporte un contingent nouveau de découvertes plus ou moins sensationnelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sensationnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77edc557-2dc7-3192-a9d8-b6b18e939ec7",
                                        "entry_id": "3fa00b75-5470-3b20-8284-4e0c23aa31af",
                                        "glosses": [
                                            "Ce qui fait sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6952d005-7ffe-4cf0-a332-a1584ec66a89",
                                                "sense_id": "77edc557-2dc7-3192-a9d8-b6b18e939ec7",
                                                "text": "Ils peuvent se réjouir, tous ces journalistes qui annoncent de fausses nouvelles. […]. Ils font la course au sensationnel et pissent de la ligne pour remplir du papier. C'est tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f38fa561-b680-45b1-850c-3336165bed7d",
                        "source_entry_id": "6cff4ebb-a84c-342e-bc76-a66674debd7b",
                        "source_sense_description": "exceptionally great",
                        "target_lang_word": "aufsehenerregend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufsehenerregend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                        "entry_id": "33a0814c-ef25-3fd3-8a21-1de89f0763bb",
                                        "glosses": [
                                            "starke Aufmerksamkeit auf sich ziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b9d65fd-1d6c-487a-b4ea-33e9fcf63bad",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Mit einer aufsehenerregenden Ballonflucht gelang am 16. September 1979 den Familien Strelzyk und Wetzel aus Pößneck (Thüringen) die Flucht über die innerdeutsche Grenze aus der DDR nach Westdeutschland mit einem selbstgebauten Heißluftballon.“"
                                            },
                                            {
                                                "example_id": "d23b233c-5504-4f2b-837d-c33d315bf189",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Berühmtheit erlangte der damals 22-Jährige im Jahr 1955 mit einer aufsehenerregenden Einspielung der Goldberg-Variationen.“"
                                            },
                                            {
                                                "example_id": "df40b914-49a6-45b2-a2de-b50bcf3b6645",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Nach der aufsehenerregenden Durchsuchung seines Grundstücks in Florida bleibt der ehemalige US-Präsident im Visier der Justiz.“"
                                            },
                                            {
                                                "example_id": "49736226-bea1-422d-8510-5b35a6088646",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„RA Frey hat vor kurzem eine aufsehenerregende Verfassungsbeschwerde gegen den Pflegenotstand eingereicht.“"
                                            },
                                            {
                                                "example_id": "eaadbe20-0cfe-43a6-aea1-13d943d01977",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Besonders in den ersten Wochen nach der Entscheidung des Supreme Court berichten US-Medien über die aufsehenerregenden Folgen der neuen Abtreibungsregelungen in den einzelnen Bundesstaaten.“"
                                            },
                                            {
                                                "example_id": "6b25450d-b9ba-415d-9347-21175f9d6b99",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "[Klimaaktivisten \"Die letzte Generation\":] „Außerdem nehmen sie aufsehenerregende Aktionen wie etwa im Potsdamer Museum Barberini vor. Dort wurde ein mehr als 100 Millionen Euro teures Gemälde von Claude Monet mit Kartoffelbrei beworfen.“"
                                            },
                                            {
                                                "example_id": "818cf782-800f-4706-8af9-6abd85fe8516",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Es ist nicht das erste Mal, dass sich Banksy mit aufsehenerregenden Aktionen gegen die Vermarktung seiner Kunst wehrt.“"
                                            },
                                            {
                                                "example_id": "dc2c50b5-9745-4447-a996-b1baaac5e7b9",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Er begleitete als Insolvenzverwalter mehrere aufsehenerregende Insolvenzen, z. B. WCM (2006), Lehman Brothers Deutschland (2008), Neckermann (2012), der Maple Bank (2016) und Greensill Bank (2021).“"
                                            },
                                            {
                                                "example_id": "bae0ccce-58a5-456b-bfd6-594bbdf1c2d9",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Anfang 2021 hatten Meghan und Harry in einem aufsehenerregenden Fernsehinterview mit US-Talkmasterin Oprah Winfrey kein Blatt vor den Mund genommen und dem Palast Rassismus und seelische Grausamkeit vorgeworfen.“"
                                            },
                                            {
                                                "example_id": "197e3d4f-ec78-42c2-9c65-8afdc012ed8c",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Mit Chor und Orchester des NDR gab Jahrhundertkomponist Igor Strawinsky ab 1958 aufsehenerregende Konzerte in Hamburg - aber auch in der Schweiz und in Venedig.“"
                                            },
                                            {
                                                "example_id": "80b3464f-9dc4-4e3b-855d-b21fffdd9d8d",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Von 1675 bis 81 lehrt Pierre Bayle an der protestantischen Akademie in Sedan Philosophie. Im Jahr darauf erscheint seine aufsehenerregende, anonym veröffentlichte Streitschrift gegen die Vorurteile und das Autoritätsdenken der Katholiken.“"
                                            },
                                            {
                                                "example_id": "8d101ad4-f092-49b1-8063-455e279cb8e8",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Ernest Rutherford entdeckte 1912 in einem aufsehenerregenden Experiment, dass das Atom aus einem Kern aus Protonen besteht, um den Elektronen herumkreisen; dies ist aber nach den Gesetzen der klassischen Physik gar nicht möglich.“"
                                            },
                                            {
                                                "example_id": "2de19c52-8933-4541-bc32-b78aa907d81c",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„Schweineniere erfolgreich an Menschen angeschlossen“ – „Die aufsehenerregende Operation nährt die Hoffnung für Menschen, die auf Spenderorgane angewiesen sind.“"
                                            },
                                            {
                                                "example_id": "01ab7839-e086-41e1-b85b-bb7ccf04571f",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„In einem aufsehenerregenden Kleid feierte Kendall Jenner die Hochzeit einer ihrer besten Freundinnen.“"
                                            },
                                            {
                                                "example_id": "77428e5b-45e1-46bd-ac7c-b9efb82d6b30",
                                                "sense_id": "172e21a4-0aae-3811-811e-8fbb7e23e646",
                                                "text": "„20. Januar 1953 - großer Ball im Weißen Haus, die Amtseinführung von \"Ike\" Eisenhower. Doch aufsehenerregend war an diesem Abend vor allem der Schmuck, den die neue First Lady, trug: Modeschmuck! Strass!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
