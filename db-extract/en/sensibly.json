                "word": "sensibly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "da4008df-66fe-4e0f-85ea-f9f9738868fd",
                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more sensibly"
                    },
                    {
                        "form_id": "afa392d1-0b65-452e-a9ef-3b8b2c4d452e",
                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most sensibly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f03c9ca5-ce1f-3bc0-bba4-751b1717a2ff",
                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                        "glosses": [
                            "In a sensible manner; in a way that shows good sense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16041be3-e7f3-40d0-bd68-3bbc7a55fc70",
                                "sense_id": "f03c9ca5-ce1f-3bc0-bba4-751b1717a2ff",
                                "text": "[...] but in the damp conditions prevailing the driver sensibly was unwilling to attempt the climb up through Combe Down tunnel without help, for fear of slipping to a standstill in the unventilated bore, [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                        "glosses": [
                            "In a way that can be sensed or noticed; perceptibly."
                        ],
                        "tags": [
                            "dated",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "e0535de8-566a-4ef8-9507-513557676fae",
                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                "text": "Time sensibly all things impairs."
                            },
                            {
                                "example_id": "5d683efa-603e-400f-8e0d-c073cdabf9a6",
                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                "text": "This four months' lastingness would doubtless be sensibly reduced if the tent were subject to numerous transportations and repitchings."
                            },
                            {
                                "example_id": "2c04e4d6-15fa-4162-83e6-4fd4e2b6752a",
                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                "text": "4. P. californicum n. sp.\nVery similar in color and sculpture to seriatum. The form is, however, sensibly narrower, averaging very nearly two and one half times as long as wide, while in seriatum the length is ahout two and three- tenths times the width."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32d7bd38-6248-4094-a83c-f69fadfaa1be",
                        "source_entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                        "source_sense_description": "in a sensible manner; in a way that shows good sense",
                        "target_lang_word": "raisonnablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raisonnablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3cd9c61-892e-34a6-9c0b-4a7c2346a8b6",
                                        "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                                        "glosses": [
                                            "Avec raison, conformément à la raison, à l’équité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2aa1d2e-7bd1-444e-95fc-75579e0e2244",
                                                "sense_id": "f3cd9c61-892e-34a6-9c0b-4a7c2346a8b6",
                                                "text": "Parler raisonnablement."
                                            },
                                            {
                                                "example_id": "8bc37d2a-f30a-451a-b60a-8be209be9632",
                                                "sense_id": "f3cd9c61-892e-34a6-9c0b-4a7c2346a8b6",
                                                "text": "Toutes ces choses [les mouvements instinctifs] se font si raisonnablement, que la raison en excède notre pouvoir et en surpasse notre industrie,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                        "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                                        "glosses": [
                                            "Suffisamment, convenablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e021b756-994c-466d-8922-7dbc5036f18f",
                                                "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                                "text": "J'espère qu’elle se trouvera assez raisonnablement logée,"
                                            },
                                            {
                                                "example_id": "301ca7ce-346c-4253-896e-873f0552e8cd",
                                                "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                                "text": "Karpos le jardinier : J'aime Dieu de tout mon cœur, et je vends mes légumes fort raisonnablement,"
                                            },
                                            {
                                                "example_id": "3b4757e5-0856-4dc8-93ce-4b3de5abc8d1",
                                                "sense_id": "2e7b4146-4f94-3109-9892-bcc408bf61ac",
                                                "text": "Ce poulet nous fit dire mille choses très spirituelles que j’ai oubliées et je fus enchanté qu’on ne l’eût pas raisonnablement rôti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                        "entry_id": "1f297a88-1ae1-38aa-b7a5-02a0e98e99e3",
                                        "glosses": [
                                            "Passablement, ou d’une manière au-dessus du médiocre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563c82fa-af91-4c84-a284-b0fe42dbb9a7",
                                                "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                                "text": "Il y avait une maison assez commode, un beau jardin et une cour raisonnablement grande, dans laquelle était une citerne profonde dont on ne se servait plus."
                                            },
                                            {
                                                "example_id": "00d449ba-50ed-4535-ba7d-9fa5355b1512",
                                                "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                                "text": "Comblé de trésors dont il ne savait que faire, et raisonnablement chargé de la haine publique,"
                                            },
                                            {
                                                "example_id": "251fde83-a4c9-4f58-a90e-6f637681375a",
                                                "sense_id": "8d2daae3-48db-333b-ae7b-b59e2950fd0a",
                                                "text": "Comme la correspondance était très étendue et qu’on était en temps de guerre, je ne laissais pas que d’être occupé raisonnablement,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
