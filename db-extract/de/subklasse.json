                    {
                        "sense_id": "384e50e9-7397-314c-b89c-a18d110f9c78",
                        "entry_id": "39db2410-29e8-3f9b-bfde-f35a90847a1b",
                        "glosses": [
                            "Unterklasse"
                        ],
                        "tags": [
                            "objektorientierte Programmierung"
                        ],
                        "examples": [
                            {
                                "example_id": "bf1fce4a-7008-4f3b-a28b-2e57bbf9134e",
                                "sense_id": "384e50e9-7397-314c-b89c-a18d110f9c78",
                                "text": "Es ist nicht immer gut, Subklassen durch Vererbung zu erzeugen, da man lieber von Schnittstellen ableiten sollte, damit keine größeren Abhängigkeiten zwischen interagierenden Klassen entstehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
