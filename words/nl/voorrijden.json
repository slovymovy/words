{
    "word_family": [
        "rijder",
        "rijden",
        "voorrijder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97e4fb67-eee9-3273-8c27-a28c84e107bb",
                    "sense_definition": "Een voertuig voor de deur of ingang laten komen om iemand op te halen of iets in te laden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De taxi zal om acht uur netjes <w>voorrijden</w>. ",
                            "target_lang_translations": {
                                "en": "The taxi will <w>pull up</w> promptly at eight o'clock."
                            }
                        },
                        {
                            "text": "Hij liet zijn auto <w>voorrijden</w> bij de hoofdingang van het hotel.",
                            "target_lang_translations": {
                                "en": "He had his car <w>brought round</w> to the main entrance of the hotel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de auto voorrijden",
                        "een taxi voorrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To have a vehicle pull up to the door or entrance to pick someone up or load something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull up",
                                "target_lang_sense_clarification": "of a vehicle, stopping at a door/entrance"
                            },
                            {
                                "target_lang_word": "drive up",
                                "target_lang_sense_clarification": "arriving in front of a building"
                            },
                            {
                                "target_lang_word": "bring round",
                                "target_lang_sense_clarification": "bringing a car around to the entrance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e90e7c3e-3fbc-3f5d-996f-1ff860ba499f",
                    "sense_definition": "Aan de leiding of vooraan een groep of ander voertuig rijden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de wielrenwedstrijd mocht hij het grootste deel van de race <w>voorrijden</w>.",
                            "target_lang_translations": {
                                "en": "During the cycling race, he got to <w>ride ahead</w> for most of the race."
                            }
                        },
                        {
                            "text": "Als je de weg niet kent, zal ik wel even <w>voorrijden</w>.",
                            "target_lang_translations": {
                                "en": "If you don't know the way, I'll <w>drive ahead</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voorop rijden",
                        "voor iemand voorrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To ride or drive ahead, leading a group or another vehicle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ride ahead",
                                "target_lang_sense_clarification": "riding in front of others"
                            },
                            {
                                "target_lang_word": "drive ahead",
                                "target_lang_sense_clarification": "driving in front to lead the way"
                            },
                            {
                                "target_lang_word": "lead the way",
                                "target_lang_sense_clarification": "guiding someone by driving in front"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}