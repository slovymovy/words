                "senses": [
                    {
                        "sense_id": "554b6ec2-ee8e-32ca-b3bb-fa6cf8a169a4",
                        "entry_id": "40a66518-9367-3e16-9108-f5316fb9f564",
                        "glosses": [
                            "die Verzierung des Buchschnittes durch Auftragen von echtem oder unechtem Blattgold und anschließendem Glätten mit Achat"
                        ],
                        "tags": [
                            "Kunsthandwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "fcfd46c2-05cf-4bc9-acc2-f6785f825879",
                                "sense_id": "554b6ec2-ee8e-32ca-b3bb-fa6cf8a169a4",
                                "text": "Unser Brockhaus ist mit einem richtigen Goldschnitt versehen."
                            },
                            {
                                "example_id": "6a4c2338-94ca-4151-996b-939c1801150c",
                                "sense_id": "554b6ec2-ee8e-32ca-b3bb-fa6cf8a169a4",
                                "text": "„Nach dem Trocknen wird der Goldschnitt mit einem Glättzahn (rundes Werkzeug aus poliertem Achat) auf Hochglanz poliert.“"
                            },
                            {
                                "example_id": "bfef9bc1-29ee-4702-bd96-b9dfbcac5be0",
                                "sense_id": "554b6ec2-ee8e-32ca-b3bb-fa6cf8a169a4",
                                "text": "„Eine Frau mit grauem Pagenkopf machte sich in ein Büchlein mit Goldschnitt Notizen.“"
                            },
                            {
                                "example_id": "900683f5-a252-420f-a94f-96e25e303811",
                                "sense_id": "554b6ec2-ee8e-32ca-b3bb-fa6cf8a169a4",
                                "text": "„Arthur verkauft die Geschenkausgabe in Leder mit Goldschnitt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
