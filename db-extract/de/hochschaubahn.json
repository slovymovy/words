                    {
                        "sense_id": "51822940-44b6-3951-ba83-184e384adfe9",
                        "entry_id": "95a3a0b4-48a5-3773-b197-5dcd7ab497a2",
                        "glosses": [
                            "Attraktion in Vergnügungsparks, bei der kleine Wägelchen auf Schienen hinaufgezogen werden, auf dass sie mit großer Geschwindigkeit aufgrund der Schwerkraft wieder nach unten sausen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "89211af2-be0d-42ec-a925-3659d8dda88f",
                                "sense_id": "51822940-44b6-3951-ba83-184e384adfe9",
                                "text": "„Die Hochschaubahn brannte am 16. September 1944 ab (wahrscheinlich Kurzschluss) und steckte dadurch auch das Riesenrad in Brand, dessen Waggons dabei eingebüßt wurden.“"
                            },
                            {
                                "example_id": "8db80c5a-25ff-4918-9458-49816861c735",
                                "sense_id": "51822940-44b6-3951-ba83-184e384adfe9",
                                "text": "übertragen: „Die dritte Komposition lockte schließlich auf eine Hochschaubahn einander widerstrebender Gefühle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c69f4567-3cae-4964-9b98-682d4149ea0e",
