                "senses": [
                    {
                        "sense_id": "00fa779a-9bd7-3aab-97cc-202a8dd701e4",
                        "entry_id": "558486c1-0856-3384-98d4-d9c23ff34bc7",
                        "glosses": [
                            "zewnętrzna, nieziarnista warstwa cytoplazmy położona bezpośrednio pod błoną komórkową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5300928e-5b16-4ed4-9e8d-9acb80b2ff31",
                                "sense_id": "00fa779a-9bd7-3aab-97cc-202a8dd701e4",
                                "text": "Paramecium bursaria, wyd. Wydawnictwo Naukowe Akademii Pedagogicznej, Kraków 2005.."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "793fe78d-6af0-3221-89a5-4c413bf4ca29",
                        "entry_id": "558486c1-0856-3384-98d4-d9c23ff34bc7",
                        "glosses": [
                            "substancja rzekomo wydobywająca się z ciała medium spirytystycznego podczas transu"
                        ],
                        "tags": [
                            "esoteric"
                        ],
                        "examples": [
                            {
                                "example_id": "ea97ce64-0a43-4821-815f-b75d8994d771",
                                "sense_id": "793fe78d-6af0-3221-89a5-4c413bf4ca29",
                                "text": "Mediumiczne zdolności posiada pewnie rzadko który agent, a gdyby nawet, to ektoplazma mogłaby poplamić wniosek o ubezpieczenie i nie przyjęliby tego w centrali."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ab5c4ae-7ed0-483d-9ebd-24d26e83aeb8",
                        "source_entry_id": "558486c1-0856-3384-98d4-d9c23ff34bc7",
                        "source_sense_id": "00fa779a-9bd7-3aab-97cc-202a8dd701e4",
                        "target_lang_word": "ectoplasm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ectoplasm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "037bba25-1b6a-3bde-8f34-683726ef0a9f",
                                        "entry_id": "d2813e76-445b-38c5-91dc-296b10e60cb1",
                                        "glosses": [
                                            "A visible substance believed to emanate from the body of a spiritualistic medium during communication with the dead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b5745d-2fb1-4be3-bfbc-5e8a18a39681",
                                                "sense_id": "037bba25-1b6a-3bde-8f34-683726ef0a9f",
                                                "text": "He saw again clearly enough[…]the doctor’s consulting room in the Avenida de la Revolución, visited for some drunken reason in the early hours of the morning, macabre with its pictures of ancient Spanish surgeons, their goat faces rising queerly from ruffs resembling ectoplasm, roaring with laughter as they performed inquisitorial operations; […]"
                                            },
                                            {
                                                "example_id": "fe947a28-6b37-4789-9aa1-5b6e49e03a8c",
                                                "sense_id": "037bba25-1b6a-3bde-8f34-683726ef0a9f",
                                                "text": "Watching as the woman lifted her skirts and flung out ectoplasm, expelled it into a bowl, then brandished it around at her audience wildly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcfda941-31de-3b14-9a76-3b1ce0346fef",
                                        "entry_id": "d2813e76-445b-38c5-91dc-296b10e60cb1",
                                        "glosses": [
                                            "An immaterial or ethereal substance, especially the transparent corporeal presence of a spirit or ghost."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fe625c-86d2-4b24-83e9-36953960521d",
                                                "sense_id": "bcfda941-31de-3b14-9a76-3b1ce0346fef",
                                                "text": "Then came some hollow groanings from inside the cabinet. The Spiritualists sat up expectantly. \"That's ectoplasm,\" said Ogilvy. \"It always causes pain on emission.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d065ac26-d32b-3c12-a1f9-766e5b7e4475",
                                        "entry_id": "d2813e76-445b-38c5-91dc-296b10e60cb1",
                                        "glosses": [
                                            "The outer granule-free layer of cytoplasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1ec7e03-38d4-471e-ac0b-f4b34ec5e96d",
                        "source_entry_id": "558486c1-0856-3384-98d4-d9c23ff34bc7",
                        "source_sense_id": "00fa779a-9bd7-3aab-97cc-202a8dd701e4",
                        "target_lang_word": "ectoplasme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ectoplasme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e303f4-1ada-3d64-9408-8b51eb3693ab",
                                        "entry_id": "e0f46090-dc93-3200-8b3c-5d4342ee91f7",
                                        "glosses": [
                                            "Couche superficielle du protoplasme d’une cellule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84a5f104-2075-3689-9392-90366bbfa875",
                                        "entry_id": "e0f46090-dc93-3200-8b3c-5d4342ee91f7",
                                        "glosses": [
                                            "Émanation immatérielle produite par un médium en état de transe."
                                        ],
                                        "tags": [
                                            "Sciences occultes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6383a84-7739-4220-a1af-9e9f625d5c1e",
                                                "sense_id": "84a5f104-2075-3689-9392-90366bbfa875",
                                                "text": "A chaque nouvel enchantement, elle prenait la même expression que la petite Soubirous devant son ectoplasme cavernicole."
                                            },
                                            {
                                                "example_id": "e2cf4c39-a620-4733-b7ae-bffbfcfe3d17",
                                                "sense_id": "84a5f104-2075-3689-9392-90366bbfa875",
                                                "text": "Bizarrement, la mode des séances de spiritisme avec déplacements de lourdes tables et apparitions et matérialisations « d’ectoplasmes » perdit beaucoup de sa popularité à peu près à la même époque où la compagnie Kodak mis sur le marché son premier film sensible aux rayons infrarouges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9408cd3-b61a-37cd-97d7-4450e9704d65",
                                        "entry_id": "e0f46090-dc93-3200-8b3c-5d4342ee91f7",
                                        "glosses": [
                                            "Personne inconsistante, sans personnalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec5b3e4-542e-4512-9f94-50eaf74245da",
                                                "sense_id": "c9408cd3-b61a-37cd-97d7-4450e9704d65",
                                                "text": "Imagine que tu t’endors bercé par une histoire de La Fontaine, et qu’à ton réveil tout le monde cause comme Cyril Hanouna !\n— Qui ça ?\n— Ce gus qui riait comme une hyène épileptique à la moindre vanne débile, dans ces émissions de télé-poubelle que surkiffaient tant de nos petits camarades.\n— Oh, putain ! Y’a plus que toi pour te souvenir de ce vieil ectoplasme du PAF !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765fb40d-1f50-4651-9809-29c2a45f9376",
                        "source_entry_id": "558486c1-0856-3384-98d4-d9c23ff34bc7",
                        "source_sense_id": "00fa779a-9bd7-3aab-97cc-202a8dd701e4",
