                    },
                    {
                        "form_id": "ec1ae3fd-639b-444e-8147-e40776d8bb30",
                        "entry_id": "41e2a1ee-608d-3433-88c5-3793ceefd97f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Untergewichte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                        "entry_id": "41e2a1ee-608d-3433-88c5-3793ceefd97f",
                        "glosses": [
                            "Körpergewicht, das einem Body-Mass-Index (BMI) unter 18,5 entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3324fa58-1294-42c3-8105-c39fb614e6f3",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Die WHO hat einen BMI von 18,5 als Grenze von Normalgewicht zu Untergewicht bei Erwachsenen festgelegt.“"
                            },
                            {
                                "example_id": "3aa07e86-52d4-481c-9cb9-1fd509a8a213",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "Untergewicht ist für ca. 800 Millionen Menschen ein echtes Problem."
                            },
                            {
                                "example_id": "e9a98d50-4547-46af-820c-35f4247abb6c",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Viele Menschen, vor allem in Entwicklungsländern, leiden an Untergewicht, weil sie zu wenig zu essen haben.“"
                            },
                            {
                                "example_id": "2f2fb38c-7cf0-44a5-b868-9b274edba6a2",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Tatsächlich kommen 30 Prozent aller Kinder in Bangladesch mit Untergewicht zur Welt […].“"
                            },
                            {
                                "example_id": "8f5c10bd-b2e4-4405-91f9-1a33560b3187",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Bei starkem Untergewicht und Mangelernährung erhöhen sich […] das Infektionsrisiko und die Sterblichkeit - da wird es also bedrohlich.“"
                            },
                            {
                                "example_id": "d5e6c74d-9db1-4834-8645-569801bcea0a",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Der 37-Jährige hat bereits mehrere Drogenentzüge hinter sich. Er ist sehr dünn: »Ich habe 21 Kilo Untergewicht gehabt, jetzt bin ich bei 17.«“"
                            },
                            {
                                "example_id": "3a671965-3396-4672-8961-d20a02b1af27",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„[…] es bleibt unerfindlich, warum in vielen Kliniken, Pflege- und Altersheimen keine Zeit bleibt, Untergewicht zu erkennen und zu vermeiden.“"
                            },
                            {
                                "example_id": "150cf137-e202-4cdf-98f8-b0147624eaf2",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„[…] Fasten [ist] nichts für […] Menschen mit Untergewicht, […].“"
                            },
                            {
                                "example_id": "329cb0f1-6646-4f82-b05b-48c7c1fba7d9",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„[…] wir sind bestens gegen Untergewicht gerüstet: Körper und Hirn stehen im ständigen Dialog und sorgen dafür, dass wir immer genug Fettreserven haben.“"
                            },
                            {
                                "example_id": "bd93adfb-5f61-445a-99b0-abae2c68b761",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Viele Jugendliche […] hungern sich ins lebensgefährliche Untergewicht, weil Film und Fernsehen seit Jahrzehnten das Schlankheits-Ideal propagieren.“"
                            },
                            {
                                "example_id": "7210ed71-c952-4da5-a0b6-3c80a6629b21",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Die Gedanken kreisen den ganzen Tag um Essen und Hungern, und anstelle eingefallener Wangen und hervorstehender Knochen sehen die Magersüchtigen beim Blick in den Spiegel trotz starkem Untergewicht noch immer vermeintlich unerträgliche Fettpolster.“"
                            },
                            {
                                "example_id": "401ab48f-176c-4dc7-a013-50318bc834b3",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Das Flaggschiff zur Anbetung von Untergewicht ist sicherlich „Germany's next Topmodel“.“"
                            },
                            {
                                "example_id": "52d159a7-c72d-4ec0-835c-b0f75a573181",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Die Eltern geraten indessen heftig in Streit: Während ihr Vater Markus Linas Untergewicht mit ihrem schnellen Wachstum erklärt, ist ihre Mutter Sabrina davon überzeugt, dass ihre Tochter eine Essstörung verheimlicht.“"
                            },
                            {
                                "example_id": "70f57663-10a8-4639-b1a0-fc1cb0e7aaf8",
                                "sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                                "text": "„Ab einem gewissen Untergewicht kommt es zum Aussetzen der Menstruation und zu weiteren biochemischen Veränderungen, die das Denken, Fühlen und Handeln beeinflussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0202ef91-92d6-34f0-8aa7-2e1118626762",
                        "entry_id": "41e2a1ee-608d-3433-88c5-3793ceefd97f",
                        "glosses": [
                            "Gewicht einer Ware oder eines Gegenstandes, das im Vergleich zum Sollgewicht zu niedrig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcee68ae-abb0-4124-989e-051e00a68447",
                                "sense_id": "0202ef91-92d6-34f0-8aa7-2e1118626762",
                                "text": "„Für den am Ende auf Platz acht gewerteten Ferrari-Fahrer gab es noch einen WM-Punkt, nachdem der zuvor siebtplatzierte BMW-Sauber-Pilot Robert Kubica wegen Untergewicht seines Wagens aus der Wertung genommen worden war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d477e4b-239f-4db2-becb-3f11c3fb6b08",
                        "source_entry_id": "41e2a1ee-608d-3433-88c5-3793ceefd97f",
                        "source_sense_id": "5065732d-55c4-3300-bf95-0d485049676d",
                        "source_sense_description": "Körpergewicht, das einem Body-Mass-Index (BMI) unter 18,5 entspricht",
                        "target_lang_word": "underweight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underweight",
