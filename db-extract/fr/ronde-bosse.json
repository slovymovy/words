                    {
                        "sense_id": "c61ae583-d8d1-3234-89c1-752e83fcf988",
                        "entry_id": "514a1507-d9d2-398b-847c-a5c8764d4416",
                        "glosses": [
                            "Ouvrage exécuté en plein relief se détachant devant un fond."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "b64ec489-ea86-4035-9a2d-328cf00377c3",
                                "sense_id": "c61ae583-d8d1-3234-89c1-752e83fcf988",
                                "text": "Je le suis jusqu’à un morceau de talus où la bêche a entaillé une porte impeccable : un artiste a même sculpté au-dessus, en ronde-bosse, une grenade de terre rouge."
                            },
                            {
                                "example_id": "a82e7e9e-339c-41fe-b5ca-ea2f99868f87",
                                "sense_id": "c61ae583-d8d1-3234-89c1-752e83fcf988",
                                "text": "Ces effigies en ronde-bosse portaient des hardes de villageoises et avaient des proportions plus qu’humaines."
                            },
                            {
                                "example_id": "dc861e80-5e3f-417f-a85d-bd0cfb03282f",
                                "sense_id": "c61ae583-d8d1-3234-89c1-752e83fcf988",
                                "text": "Des figures en ronde-bosse ont été introduites dans les vides de la zone des accoudoirs et du dossier, […]."
                            },
                            {
                                "example_id": "28d75714-30a3-46db-b9a8-814b6c709194",
                                "sense_id": "c61ae583-d8d1-3234-89c1-752e83fcf988",
                                "text": "C’est une sculpture en ronde-bosse, un mètre soixante-seize de haut, un quatre-vingt-quinze de large, quatre-vingts centimètres de profondeur."
                            }
                        ]
                    }
                ],
