                        "examples": [
                            {
                                "example_id": "2f18978b-8a83-4673-beb6-081ab0b853af",
                                "sense_id": "45f8fe88-b354-325a-886f-f5156aaa8bc9",
                                "text": "„Aber von den Empfindungen des Tages bleibt mir vor allem Papinis Zitronenduft, den er wenige Meter entfernt verströmt, als er Ledesma die Zettel aus der Hand reißt und weiter vorliest.“"
                            },
                            {
                                "example_id": "1bba8254-f99e-484a-bcb0-c0de702bcda0",
                                "sense_id": "45f8fe88-b354-325a-886f-f5156aaa8bc9",
                                "text": "„Wie bringe ich ihr bei, dass tatsächlich was nicht stimmt. Nämlich dieses Spülmittel mit Zitronenduft, das sie neuerdings verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
