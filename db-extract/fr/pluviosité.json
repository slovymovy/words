                "senses": [
                    {
                        "sense_id": "f1d7c638-4989-34e4-82e6-36ac7578b72a",
                        "entry_id": "cd529c6e-ddfa-3075-a39d-1cb83dd0eb15",
                        "glosses": [
                            "Quantité d’eau météorique qui tombe à un endroit déterminé, au cours d’une période donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d37fcd-b7e7-4589-86c2-900d42b57d02",
                                "sense_id": "f1d7c638-4989-34e4-82e6-36ac7578b72a",
                                "text": "Dans toute la vallée moyenne on observe généralement deux périodes de grande pluviosité : l’une hivernale (novembre-décembre), l’autre vernale (février-avril) […]"
                            },
                            {
                                "example_id": "e40ecd67-7c21-4054-b7f8-164c1c80836c",
                                "sense_id": "f1d7c638-4989-34e4-82e6-36ac7578b72a",
                                "text": "Le long des rivières, des colonies ont pourtant pu descendre des montagnes et, quand le sol est humide, des holarctiques peuvent braver la faible pluviosité du climat méditerranéen."
                            },
                            {
                                "example_id": "72dc4832-7864-40c4-9ed4-6b166ef36665",
                                "sense_id": "f1d7c638-4989-34e4-82e6-36ac7578b72a",
                                "text": "Les extrêmes de pluviosité vont de l'absence quasi totale de pluies au Sahara jusqu'à plus de 4 m sur le littoral libérien et aux alentours du Mont Cameroun (près de la frontière avec le Nigeria)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c45e4ee3-a326-3b75-ac5f-d3d227b9c500",
                        "entry_id": "cd529c6e-ddfa-3075-a39d-1cb83dd0eb15",
                        "glosses": [
                            "Tendance à pleuvoir."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
