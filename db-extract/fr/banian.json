            {
                "entry_id": "a611d0d9-095b-3d97-829c-56c09d8af4f8",
                "word": "banian",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ff03360-b29d-4650-940b-07316db3c5f8",
                        "entry_id": "a611d0d9-095b-3d97-829c-56c09d8af4f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "banians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                        "entry_id": "a611d0d9-095b-3d97-829c-56c09d8af4f8",
                        "glosses": [
                            "Arbre appartenant au genre Ficus de la famille des Moraceae, espèce voisine du figuier qui peut se développer en arbres géants pouvant couvrir plusieurs hectares."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337dd317-2ffb-4b5b-b22a-0c848c3fd67b",
                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                "text": "J’ai appris un jour de février 1962, par une lettre d’un de mes frères, que le vieux banian de notre hameau natal vient d’être abattu, sacrifié pour élargir la route d’accès au village."
                            },
                            {
                                "example_id": "187e64e8-7814-4936-badb-f0ea93cf3371",
                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                "text": "Je regarde le grand banian devant nous, arbre majestueux et sacré qui étale ses branches comme une immense araignée."
                            },
                            {
                                "example_id": "47420b50-2a09-4e00-a9d2-1c9a1bb285ff",
                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                "text": "Il désigna un banian haut comme une cathédrale, non loin du village, dont les énormes racines s’insinuaient dans le sol, pareilles aux doigts fouineurs d’un géant."
                            },
                            {
                                "example_id": "e9d6ea5d-668f-4132-9bae-7e251148b74a",
                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                "text": "Un figuier des Banians, développé dans des proportions gigantesques, étend son ombre triste sur la case royale."
                            }
                        ]
                    }
                ],
