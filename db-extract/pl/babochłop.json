                        "entry_id": "1db77466-52a8-3265-a1ce-44c32347ecab",
                        "glosses": [
                            "kobieta, która wygląda i zachowuje się jak mężczyzna"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "66c3639f-f6d9-40b9-b53a-98029df012c2",
                                "sense_id": "9a8db95e-a1ea-3fd2-99b7-d61c5b4316e9",
                                "text": "Powiedz temu babochłopowi, że ja w szpilkach i kostiumie po strychu latać nie zamierzam."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4384bfaa-9f5e-4a0c-833f-a97c7470bcc8",
                        "source_entry_id": "1db77466-52a8-3265-a1ce-44c32347ecab",
                        "source_sense_id": "9a8db95e-a1ea-3fd2-99b7-d61c5b4316e9",
                        "target_lang_word": "marimacho",
