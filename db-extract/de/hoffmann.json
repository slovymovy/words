                        "examples": [
                            {
                                "example_id": "925f9e3f-e16b-4f75-b9d1-acdc716772e1",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Herr Hoffmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4b8dc25d-66f2-45d4-945b-ae7f7124957b",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Die Hoffmanns fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "4f2e02ea-ade4-4baa-898b-f8064b244b6f",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Der Hoffmann trägt nie die Pullover, die die Hoffmann ihm strickt."
                            },
                            {
                                "example_id": "af2f1124-f728-4853-8f28-7f4cae1555a7",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Frau Hoffmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8c47809d-3be6-48c0-bf33-65d567669a40",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hoffmann kommt, geht der Herr Hoffmann.“"
                            },
                            {
                                "example_id": "5e9b9eb5-f265-41eb-b887-d42317889c1d",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Hoffmann kommt und geht."
                            },
                            {
                                "example_id": "e597ef18-3413-4cee-8da3-eb407839f267",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "Hoffmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "7e4d0fd4-6366-4e95-a29f-74a508ad0def",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "An verregneten Herbsttagen ist Familie Hoffmanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "c913503e-705e-4da3-8b08-137bafd3e5f1",
                                "sense_id": "a29ab2c9-95ea-32e1-bab5-783526f8eb8c",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hoffmann das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
