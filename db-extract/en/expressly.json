    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "50fe6aae-244f-3c3d-8b98-b48c6a5985f0",
                "word": "expressly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "03788ea7-54ed-3bd1-9251-3bad9ff7b09f",
                        "entry_id": "50fe6aae-244f-3c3d-8b98-b48c6a5985f0",
                        "glosses": [
                            "In an express or explicit manner; in a clear or specific manner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b260f444-1adc-405b-a240-31f195915930",
                                "sense_id": "03788ea7-54ed-3bd1-9251-3bad9ff7b09f",
                                "text": "We were expressly permitted to use the building. See – here is the note from the manager clearly stating that we have permission to use the building."
                            },
                            {
                                "example_id": "61d7e911-5d78-486f-ad8b-1c8a58aa0b50",
                                "sense_id": "03788ea7-54ed-3bd1-9251-3bad9ff7b09f",
                                "text": "\"What do you think of this sentence, my dear Lizzy?\" said Jane as she finished it. \"Is it not clear enough? Does it not expressly declare that Caroline neither expects nor wishes me to be her sister; […]\""
                            },
                            {
                                "example_id": "4946449c-fb2b-492c-8d5f-b7a9b2d9f8a9",
                                "sense_id": "03788ea7-54ed-3bd1-9251-3bad9ff7b09f",
                                "text": "\"No term or condition of this Public License will be waived and no failure to comply consented to unless expressly agreed to by the Licensor.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5c8ef246-c06b-3e24-8144-cd6bf2912418",
                        "entry_id": "50fe6aae-244f-3c3d-8b98-b48c6a5985f0",
                        "glosses": [
                            "Exclusively or specifically."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bcfeaa1-83c2-42fb-a64c-41e1eb30b172",
                                "sense_id": "5c8ef246-c06b-3e24-8144-cd6bf2912418",
                                "text": "No round of beef or tongue or ham is expressly cooked for me, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be363a52-c1ea-432f-a222-ab5b29f9e07d",
