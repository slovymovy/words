                        "sense_id": "69d8dacb-678a-3b1b-8cca-5bda98dc1b40",
                        "entry_id": "45ecb94a-6e7d-3777-9841-698a2e459de7",
                        "glosses": [
                            "diejenige Silbe im Wort, die den Hauptakzent trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6499c455-55fb-4c97-963c-f81cdf8c2347",
                                "sense_id": "69d8dacb-678a-3b1b-8cca-5bda98dc1b40",
                                "text": "In dem Wort \"Tonsilbe\" (['toːnˌzɪlbə]) ist \"Ton-\" (['toːn]) die Tonsilbe, da hier der Hauptakzent des Wortes liegt."
                            },
                            {
                                "example_id": "e4459041-934c-4874-a888-a45b9c1b3b40",
                                "sense_id": "69d8dacb-678a-3b1b-8cca-5bda98dc1b40",
                                "text": "„Die Dehnung kurzer Vokale in offener Tonsilbe beginnt im 12. Jahrhundert im Mitteldeutschen und dehnt sich im 14. Jahrhundert auch auf das Oberdeutsche aus.“"
                            }
                        ],
