                        ],
                        "examples": [
                            {
                                "example_id": "9e35a899-632c-4088-8507-dfe353e33a0e",
                                "sense_id": "3ea0217a-3f62-3d99-96b6-1a85feff3cfe",
                                "text": "After yet another mid-court volley error, Serena got so upset that she smashed her racquet deep into the clay court. The racquet was unusable after that, and when she went to her bag to grab another, she found that all her other racquets had broken strings."
                            }
                        ]
                    }
