                "senses": [
                    {
                        "sense_id": "1dd9330a-dc63-3b05-baec-cbd36e6a2ce5",
                        "entry_id": "13d97714-9dfe-3a7c-b206-336fefef38dd",
                        "glosses": [
                            "kleverig maken door besmeren met een geconcentreerde zetmeeloplossing"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5b759f0d-f7e7-40cc-a1bb-7c63d7e0aa60",
                                "sense_id": "1dd9330a-dc63-3b05-baec-cbd36e6a2ce5",
                                "text": "Noland schrijft kleine komische scènes, waarin veel mis gaat en die soms het \"de Dikke en de Dunne'-gevoel oproepen. Tijdens verwoede behangselwerkzaamheden stijfselen Vos en Konijn Kips feestjurk aan de muur."
                            }
                        ]
                    },
                    {
                        "sense_id": "664d2f02-0962-336f-9fea-3cd411408a55",
                        "entry_id": "13d97714-9dfe-3a7c-b206-336fefef38dd",
                        "glosses": [
                            "steviger maken door inweken met een geconcentreerde zetmeeloplossing"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "79010fbc-1052-45a7-9107-0868693ef8a6",
                                "sense_id": "664d2f02-0962-336f-9fea-3cd411408a55",
                                "text": "Hij liet zijn nek weer roodkloppen en zijn boezeroen stijfselen, en nu en dan zong hij uit zijn armoehokje het hoogste lied."
                            }
                        ]
                    }
