                "senses": [
                    {
                        "sense_id": "51269910-e088-3f72-aa08-ab867b4676d6",
                        "entry_id": "146cfc7f-2338-389a-8712-23f9df557d75",
                        "glosses": [
                            "Schlag mit einem Säbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f0e26c3-e920-45b3-bc89-f0df08ce72c7",
                                "sense_id": "51269910-e088-3f72-aa08-ab867b4676d6",
                                "text": "„Wegen eines Säbelhiebes trug er über dem Bauch eine Silberplatte, um einen Bruch zu halten.“"
                            },
                            {
                                "example_id": "bfa96a4f-1209-4e68-8d25-d96e7e4a0896",
                                "sense_id": "51269910-e088-3f72-aa08-ab867b4676d6",
                                "text": "„Wie lautlose Säbelhiebe fallen die Blitze.“"
                            },
                            {
                                "example_id": "bd6fca85-d95d-4f48-aa9d-f7ce0c354f7e",
                                "sense_id": "51269910-e088-3f72-aa08-ab867b4676d6",
                                "text": "„Als Kind war er von französischer Soldateska mißhandelt, zum Krüppel geschlagen und durch fünf Säbelhiebe lebensgefährlich verletzt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
