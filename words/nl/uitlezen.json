            "senses": [
                {
                    "sense_id": "8f262a0c-81b9-3b8f-9816-dcc07b246fdd",
                    "sense_definition": "een boek of tekst volledig tot het einde toe lezen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil dit boek graag <w>uitlezen</w> voordat ik aan een nieuw verhaal begin.",
                            "target_lang_translations": {
                                "en": "I would like to <w>finish</w> this book before I start a new story."
                            }
                        },
                        {
                            "text": "Hij <w>las</w> de spannende roman in één ruk <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "He <w>read</w> the exciting novel <w>to the end</w> in one go."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflezen"
                    ],
                    "common_phrases": [
                        "een boek uitlezen",
                        "in één ruk uitlezen"
                    ],
                    "target_lang_definitions": {
                        "en": "to finish reading a book or text completely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "a book or text"
                            },
                            {
                                "target_lang_word": "read to the end",
                                "target_lang_sense_clarification": "completely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d118a26-afa0-3f0e-a2c0-0d99e7527ec2",
                    "sense_definition": "digitale gegevens of informatie van een apparaat of sensor verzamelen en bekijken",
