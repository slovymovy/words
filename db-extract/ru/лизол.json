                "senses": [
                    {
                        "sense_id": "a0e385c8-bc4b-34f9-9009-f4cfb0e4f484",
                        "entry_id": "6bcef97f-85fb-3fd7-aeb6-5f26a6490fc1",
                        "glosses": [
                            "раствор очищенных фенолов в калийном мыле; буро-коричневая прозрачная маслянистая жидкость с резким запахом, используемая как дезинфицирующее и дезинсицирующее средство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306632f3-2c86-40d4-9ce6-385bcf6cfee8",
                                "sense_id": "a0e385c8-bc4b-34f9-9009-f4cfb0e4f484",
                                "text": "Для дезинфекции в теплое время года необходимо не реже одного раза в месяц будку, щит и лежанку собаки обмывать хотя бы трехпроцентным раствором лизола или креолина."
                            }
                        ]
                    }
                ],
