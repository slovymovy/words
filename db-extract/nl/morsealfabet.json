                        "glosses": [
                            "coderingssysteem voor teksten die men wil verzenden bestaande uit langere en kortere signalen; in eerste instantie gebruikt voor de telegrafie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc25977e-17dd-46fe-8826-8b54b3a50a01",
                                "sense_id": "c0518248-209c-3731-a87f-3d8137efb2d0",
                                "text": "Wang zag dat de pagina enkel een morsealfabet bevatte."
                            },
                            {
                                "example_id": "43b4c8bc-8e98-4f5d-a20e-690d9d685d6a",
                                "sense_id": "c0518248-209c-3731-a87f-3d8137efb2d0",
                                "text": "Woodland beschikte al over ingenieursdiploma en werkte voor zijn universiteitsjaren mee aan het Manhattan Project, het Amerikaanse atoomprogramma. Zijn kennis van het morsealfabet stelde hem in staat een nieuwe code te ontwikkelen. Het eureka-moment zou hebben plaatsgevonden toen hij op het strand dromerig met zijn vingers strepen in het zand trok. Hij en Silver werkten het idee daarna verder uit."
                            }
                        ]
                    }
