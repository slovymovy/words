                    {
                        "form_id": "606d05fe-00b5-4d87-a3ea-55e4cdd2b402",
                        "entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "éhontées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                        "entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                        "glosses": [
                            "Qui est sans honte, sans pudeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57fd7b4-f9be-469a-8c3d-dc74758a1737",
                                "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                "text": "Dès lors, Antoine et Ursule furent pour lui des parasites éhontés, des bouches qui dévoraient son bien."
                            },
                            {
                                "example_id": "c8541b8d-4cf7-4704-8a79-3426208e054b",
                                "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                "text": "— Est-ce lui qui aime notre voisine ?\n— Quelle voisine ?— Cette éhontée !\n— Quelle éhontée ?\n— La Pharmacienne !"
                            },
                            {
                                "example_id": "a7996ddc-9816-4bd2-9019-a6a3c86c1b27",
                                "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                "text": "Poutine a violé de manière éhontée les principes des Nations unies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8380a7f2-6abf-4f70-a9fe-5833c55dcee3",
                        "source_entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                        "source_sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                        "target_lang_word": "shameless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shameless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c083930a-baf6-3bb3-88fb-e180b7a9b595",
                                        "entry_id": "bf56cb2a-7e09-3591-97c0-ff7c3ea505e3",
                                        "glosses": [
                                            "Having no shame, no guilt nor remorse over something considered wrong; immodest, brazen; unable to feel disgrace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90afda82-76b2-3c3e-9843-3da5a42b8b79",
                                        "entry_id": "bf56cb2a-7e09-3591-97c0-ff7c3ea505e3",
                                        "glosses": [
                                            "Not subject to other people’s shaming or reproach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6deb1f09-f539-4c5a-b9aa-417b17fd3bd9",
                                                "sense_id": "90afda82-76b2-3c3e-9843-3da5a42b8b79",
                                                "text": "Near-synonyms: blameless, unblameable"
                                            },
                                            {
                                                "example_id": "faffcb70-0a80-4e6b-bad3-164d2c272aed",
                                                "sense_id": "90afda82-76b2-3c3e-9843-3da5a42b8b79",
                                                "text": "He shall be as now nameles,\nBut he shall not be blameles,\nNor he shall not be shameles;\nFor sure he wrought amys, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c0866d2-8e2d-4f5b-a0aa-6e72deab740a",
                        "source_entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                        "source_sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                        "target_lang_word": "brazen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brazen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad28c38-697c-3529-9c3b-54e2b2d287ef",
                                        "entry_id": "0bd856d8-5138-382a-b55c-6e31b8bef0d6",
                                        "glosses": [
                                            "Made of brass."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b5199b-dd7a-418b-9255-002b9593db33",
                                                "sense_id": "1ad28c38-697c-3529-9c3b-54e2b2d287ef",
                                                "text": "Brazen or rather copper swords seem to have been next introduced; these in process of time, workmen learned to harden by the addition of some other metal or mineral, which rendered them almost equal in temper to iron."
                                            },
                                            {
                                                "example_id": "ea9365d8-958e-4bfe-8cdd-d9f7faf2ad15",
                                                "sense_id": "1ad28c38-697c-3529-9c3b-54e2b2d287ef",
                                                "text": "And Moses made a brass image of the fiery serpents, and put it up on a pole, where all the people could see it; and when any one was bitten, he could look upon the brazen serpent, and was cured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04b0baec-cb53-3156-baed-944b6bc86548",
                                        "entry_id": "0bd856d8-5138-382a-b55c-6e31b8bef0d6",
                                        "glosses": [
                                            "Brass-like in appearance or character; bright, ruddy, hard."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc372dd4-bb1b-4206-91f3-433b84ce185f",
                                                "sense_id": "04b0baec-cb53-3156-baed-944b6bc86548",
                                                "text": "The women, stout, strong, brazen-faced creatures, in most cases looked able to thrash any of the partners with whom they consorted."
                                            },
                                            {
                                                "example_id": "d78e5728-ed05-4961-a7d3-ad0a744687a3",
                                                "sense_id": "04b0baec-cb53-3156-baed-944b6bc86548",
                                                "text": "The vegetation was similar to that which covers the lawns of the red Martians of the great waterways, but the trees and birds were unlike anything that I had ever seen upon Mars, and then through the further trees I could see that most un-Martian of all sights—an open sea, its blue waters shimmering beneath the brazen sun."
                                            },
                                            {
                                                "example_id": "265c6b2e-cac5-4499-a765-97605572f098",
                                                "sense_id": "04b0baec-cb53-3156-baed-944b6bc86548",
                                                "text": "Through the brazen hours that followed high noon, we crept onwards through a tunnel of glittering verdure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ab1f6b-9f92-38c4-afb3-f66019ba7b0a",
                                        "entry_id": "0bd856d8-5138-382a-b55c-6e31b8bef0d6",
                                        "glosses": [
                                            "Sounding harsh and loud, like brass cymbals or brass instruments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3013ca05-4ba8-4188-be4f-87cb9f277d96",
                                                "sense_id": "26ab1f6b-9f92-38c4-afb3-f66019ba7b0a",
                                                "text": "And now the Trumpets terribly from far, / With rattling Clangor, rouze the sleepy War. / The Souldiers Shouts succeed the Brazen Sounds, / And Heav'n, from Pole to Pole, the Noise rebounds."
                                            },
                                            {
                                                "example_id": "58b167ea-e0f7-46b3-aa33-8f777621b67f",
                                                "sense_id": "26ab1f6b-9f92-38c4-afb3-f66019ba7b0a",
                                                "text": "Often a traveller, when the air is quiet, / Will make the night reverberate with this riot / Of brazen sounds, whose singing cadence swells / The harmony of bleating and lambs' bells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946a5a9f-1b59-3f85-9f08-d89134410db7",
                                        "entry_id": "0bd856d8-5138-382a-b55c-6e31b8bef0d6",
                                        "glosses": [
                                            "Extremely strong; impenetrable; resolute."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fedb3b-cb97-40c2-8e3a-fccba944e14f",
                                                "sense_id": "946a5a9f-1b59-3f85-9f08-d89134410db7",
                                                "text": "The giant [Goliath] was thus conquered by the youth [David]; the man-at-arms by the unarmed; the stone of the shepherd pierced the brazen defences of the warrior."
                                            },
                                            {
                                                "example_id": "d88ce1ac-e834-40b4-bbeb-59e7020cc9d6",
                                                "sense_id": "946a5a9f-1b59-3f85-9f08-d89134410db7",
                                                "text": "In the autumn, when a small group of us heard him [Frank Wedekind] read from Heracles, his last work, I was amazed at his brazen energy. For two and a half hours without stopping, without once lowering his voice (and what a strong, brazen voice it was), barely pausing for breath for even a moment between acts, bent motionless over the table, he read – half from memory – those verses wrought in brass, looking deep into the eyes of each of his listeners in turn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "389b8459-dc4f-3180-8ded-348cf022c082",
                                        "entry_id": "0bd856d8-5138-382a-b55c-6e31b8bef0d6",
                                        "glosses": [
                                            "Shameless or impudent; shocking or audacious; brash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c4c71d9-a844-49ec-af74-0087a4a7130b",
                                                "sense_id": "389b8459-dc4f-3180-8ded-348cf022c082",
                                                "text": "She was brazen enough to deny stealing the handbag even though she was caught on camera doing so."
                                            },
                                            {
                                                "example_id": "0de91100-3d2e-4b18-af93-526c06f34735",
                                                "sense_id": "389b8459-dc4f-3180-8ded-348cf022c082",
                                                "text": "He looked at her for a long moment. Slowly, a smile lit in his eyes. \"Never a shrew. A fighter and a brazen hussy.\" / Placing a finger beneath her chin, he tilted her face up. \"And, I'd say, you're the only brazen hussy who blushes.\" / A brazen hussy. She should be offended. But the smile in his eyes, the touch of his finger moving slowly and feather-light from chin to throat and along the sensitive skin of her neck made it impossible to concentrate on rebuke."
                                            },
                                            {
                                                "example_id": "f06ebea3-54b4-4911-ab4a-b6c6c5cd27f1",
                                                "sense_id": "389b8459-dc4f-3180-8ded-348cf022c082",
                                                "text": "If one had to lie at all, the brazen lie was better because brazen lies were so outrageous many people failed to question them."
                                            },
                                            {
                                                "example_id": "1c983a4b-d9fc-419b-98f1-c6a94045a505",
                                                "sense_id": "389b8459-dc4f-3180-8ded-348cf022c082",
                                                "text": "This brazen action further helps convince Kurita that the Johnston is actually a cruiser, since, obviously, no mere destroyer would dare risk this kind of charge, nor achieve this kind of damage!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brazen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac09dada-f2f1-3fe8-8a23-abeb5594319c",
                                        "entry_id": "0320783a-1bb9-3ffc-a603-cb14a063050c",
                                        "glosses": [
                                            "To turn a brass color."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "214b59ec-336c-4a1a-b220-6caf2b372a53",
                                                "sense_id": "ac09dada-f2f1-3fe8-8a23-abeb5594319c",
                                                "text": "[...] the meadows roughen, grow gutteral / with goldenrod, milkweed's late-summer lilac, / cat-tails, the wild lily brazening, / dooryards overflowing in late, rough-headed bloom: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                        "entry_id": "0320783a-1bb9-3ffc-a603-cb14a063050c",
                                        "glosses": [
                                            "Generally followed by out or through: to carry through in a brazen manner; to act boldly despite embarrassment, risk, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "675c0c14-e3d3-4cdc-b2d2-7b3346178f33",
                                                "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                                "text": "And though the word doth eat up all they can ſay, as Moſes rod did: yet they harden their hearts with Pharaoh, they brazen their brows with him in the text, that ſaid I will not: Nay ſaid the Iſraelites, but we will have a King. [Commentary on Matthew 21:29.]"
                                            },
                                            {
                                                "example_id": "b45feab0-abac-48e4-a5ee-d7918ef35887",
                                                "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                                "text": "His impudence is only less than his ignorance, in referring his questioner to [John] Milton, in proof of the scriptural angels being celestial women. That gentleman mildly remarks, \"Milton's angels are not Ladies.\" Instead of blushing, he brazens it out, and replies, \"No—but some scriptural angels are Ladies—I believe\"—shewing that he is as ignorant of his Bible as of Milton."
                                            },
                                            {
                                                "example_id": "f5f9c0be-a821-4806-9872-8af9ba5b168e",
                                                "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                                "text": "Sabina brazened it out before Mrs. Wygram; but inwardly she was resolved to be a good deal more circumspect."
                                            },
                                            {
                                                "example_id": "7a9066fa-098f-4bcd-8a27-bba00a583da3",
                                                "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                                "text": "[T]he historically minded modernist poet is uncertain whether there is any excuse at all for the existence of poets. He brazens out the dilemma by making cruel jokes at his own expense—jokes which he expects no one to see or to laugh at if seen."
                                            },
                                            {
                                                "example_id": "3de3d5aa-c256-4dcf-b73a-7d33c2c207b8",
                                                "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                                "text": "[...] I've come to rely on a mental technique that I call powering through. [...] It's equivalent to brazening out an awkward social situation—accidentally squeezing the butt of a stranger wearing the same costume as your boyfriend at a Halloween party, say. Powering through or brazening out is almost always what I end up doing, but only after stifling my initial impulse to surrender or sink through the floor."
                                            },
                                            {
                                                "example_id": "66c6ce84-3651-4644-88e1-1647ef186431",
                                                "sense_id": "121a90c3-4589-39f6-98b1-029afdad34cb",
                                                "text": "The drivers of the 507s Lost Convoy knew they were in a world of deep fecal matter. Could they brazen a path through the city once more and pick up Route Blue on the other side? Or would this morning's chain of unfortunate events finally catch up with them?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12839d29-8eb5-434a-8ff3-05c835d4c943",
                        "source_entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                        "source_sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                        "target_lang_word": "unashamed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unashamed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                        "entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                                        "glosses": [
                                            "feeling or showing no shame, embarrassment or remorse"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940a5f56-adab-4e11-aacb-20937f77f267",
                                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                                "text": "And smiling as a Master smiles at one / That is not of his school, nor any school / But that where blind and naked Ignorance / Delivers brawling judgments, unashamed, / On all things all day long ; he answer’d her."
                                            },
                                            {
                                                "example_id": "30b96d1c-4d1b-49dc-a8ac-16b7ded8b17b",
                                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                                "text": "\"How else shall we go back unashamed to our women?\""
                                            },
                                            {
                                                "example_id": "43fed825-4a0e-4e9d-af6c-7956effe6606",
                                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                                "text": "There is a similarity between the dynamics of the streets of New York and the dynamics of a Latin American plaza. Menendez suggests that they both capture a fascination with fashion, the appreciation for that which is done merely for effect, its unashamed desire to squander it all."
                                            },
                                            {
                                                "example_id": "4cf3e83e-1911-4eda-b00e-d079dee572e2",
                                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                                "text": "Critics suggest that Fernández, an unashamed populist and nationalist, is seeking to deflect attention from social disharmony at home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ca736fb-a0e5-4e71-8e4d-b8d8581de8cf",
                        "source_entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                        "source_sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                        "target_lang_word": "sinvergüenza",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinvergüenza",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5ff5602c-5349-3c52-8d81-6e3e8cab2c41",
                                        "entry_id": "6b105069-795d-38a0-9f09-20ca8e291ebe",
                                        "glosses": [
                                            "Persona que no muestra vergüenza por cometer acciones que se reputan inmorales, en especial las relativas al pudor."
