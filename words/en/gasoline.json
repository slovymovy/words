                    "sense_definition": "Relating to, consisting of, or powered by gasoline.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people are switching from <w>gasoline</w> cars to electric vehicles.",
                            "target_lang_translations": {
                                "ru": "Многие люди пересаживаются с <w>бензиновых</w> автомобилей на электромобили.",
                                "zh": "许多人正在从<w>汽油</w>车转向电动汽车。"
                            }
                        },
                        {
                            "text": "The old <w>gasoline</w> generator was loud but reliable during the storm.",
                            "target_lang_translations": {
