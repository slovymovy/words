                    {
                        "translation_id": "6b415706-ad34-43f7-a4c9-a8a8fade4785",
                        "source_entry_id": "1d500e0c-9360-3be4-95cc-1a19d9e6becc",
                        "source_sense_id": "723e9cd6-64d2-3a0d-a384-6b320e9d2855",
                        "target_lang_word": "Abigail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abigail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a15f06f-89cf-3c09-9731-abaeb73e2806",
                                        "entry_id": "c510146d-231c-3a7f-b2f1-3b47caae667d",
                                        "glosses": [
                                            "The wife of Nabal and later of David in the Old Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a62739-bfc3-410d-ac73-a18e35cf6f90",
                                                "sense_id": "2a15f06f-89cf-3c09-9731-abaeb73e2806",
                                                "text": "Now the name of the man was Nabal; and the name of his wife Abigail: and she was a woman of good understanding, and of beautiful countenance; but the man was churlish and evil in his doings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc07b3d2-0c44-328f-945f-5be583030d14",
                                        "entry_id": "c510146d-231c-3a7f-b2f1-3b47caae667d",
                                        "glosses": [
                                            "A female given name from Hebrew, used since the 16th century, and currently quite popular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6910354f-5a76-4719-8398-0807efe7f676",
                                                "sense_id": "dc07b3d2-0c44-328f-945f-5be583030d14",
                                                "text": "The name of Abigail Adams is naturally closely associated with those of her illustrious father and mother, - - - Born in 1765, the mother's quaint Christian name was given to the little girl"
                                            },
                                            {
                                                "example_id": "8ece10fd-97db-412d-93eb-192b58c1e054",
                                                "sense_id": "dc07b3d2-0c44-328f-945f-5be583030d14",
                                                "text": "Representative Abigail Spanberger, a prominent Virginia Democrat who was repeatedly able to win in a conservative-leaning district, announced on Monday that she would run for governor in 2025, leaving open a competitive seat that could be crucial to her party’s efforts to win back control of the House next year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
