                ],
                "senses": [
                    {
                        "sense_id": "88251a07-381b-3fdc-94a9-33a00929aef2",
                        "entry_id": "d56519d1-2850-37e6-810f-1904585058f6",
                        "glosses": [
                            "capacity (ability to hold); capacity (a measure of such ability), volume"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ec4ed847-f112-4016-afcc-49104ca16a0b",
                                "sense_id": "88251a07-381b-3fdc-94a9-33a00929aef2",
                                "text": "Одним из основных претензий к старому Х3 была его небольшая вместительность.",
                                "translation": "The main reproof of the old X3 was its small boot capacity",
                                "english": "The main reproof of the old X3 was its small boot capacity"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2d2061f-d5b9-36ef-836f-336518d04c38",
                        "entry_id": "d56519d1-2850-37e6-810f-1904585058f6",
                        "glosses": [
                            "capaciousness, spaciousness, roominess (ability to hold a lot)"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f5182f5-ac21-4f06-b212-0d68054b58dc",
                                "sense_id": "e2d2061f-d5b9-36ef-836f-336518d04c38",
                                "text": "В «Архипелаге» поража́ет изоби́лие фа́ктов, мы́слей ― и вмести́тельность слова.",
                                "translation": "The Archipelago is striking with the abundance of facts, thoughts and the capaciousness of its words.",
                                "english": "The Archipelago is striking with the abundance of facts, thoughts and the capaciousness of its words."
                            },
                            {
                                "example_id": "cf338f18-e5c3-4d5d-8fe6-c38a077b54a3",
                                "sense_id": "e2d2061f-d5b9-36ef-836f-336518d04c38",
                                "text": "Жолудев гото́вился к встре́че, сло́вно к свида́нию, ― он приоделся, сбегал на ры́нок, напо́лнил до́верху сластя́ми с фру́ктами чёрную су́мку, кото́рую цени́л за вмести́тельность.",
                                "translation": "Zholudev prepared himself for the meeting like for a date - he spruced up, ran to the market, filled the black bag he appreciated for its volume with sweets and fruit.",
                                "english": "Zholudev prepared himself for the meeting like for a date - he spruced up, ran to the market, filled the black bag he appreciated for its volume with sweets and fruit."
                            }
                        ]
                    }
                ],
