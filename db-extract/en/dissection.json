                                            {
                                                "example_id": "a1b4ccf3-aa0c-431e-be32-b4a23f8eb722",
                                                "sense_id": "68ddcbc9-ed8d-3031-ada6-3a21bf8a5476",
                                                "text": "Přístupnou laiku je jenom pitva. Tato jediná nepředpokládá zvláštních obsáhlých vědomostí, za to však nemůže připoutati, jsouc ve vědeckém spisu uložena, nižádného čtenáře neodborného."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a9f307-642b-301d-89c3-3517f21ce1b3",
