                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbb6a4f-0ebb-4ed8-94c4-bb0ec7f99834",
                                                "sense_id": "13b6d1f1-28d0-3963-889f-7b2ea049577d",
                                                "text": "Il a passé toute sa vie dans le banditisme."
                                            },
                                            {
                                                "example_id": "3e0eb595-b54a-4b4a-80d5-f2e84d2439da",
                                                "sense_id": "13b6d1f1-28d0-3963-889f-7b2ea049577d",
                                                "text": "Cette région est ravagée par le banditisme."
