                "senses": [
                    {
                        "sense_id": "774657ac-9089-3010-8704-08498e8aca78",
                        "entry_id": "8bb72ef2-4840-31ff-973c-9659ebc32880",
                        "glosses": [
                            "sprężysty materiał rozpięty na ramie, służący do skakania i wykonywania akrobacji"
                        ],
                        "tags": [],
                        "examples": [],
