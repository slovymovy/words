                        "glosses": [
                            "Synonym of necroposting."
                        ],
                        "tags": [
                            "Internet",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b197723f-c76b-4c22-9be7-6514ae7de0ad",
