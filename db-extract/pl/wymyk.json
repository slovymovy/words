                        "source_sense_id": "68b9256c-704d-3a87-a2ee-88675d472262",
                        "target_lang_word": "escapement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escapement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89a5a4a7-e8f1-3d41-a20e-4a633264711d",
                                        "entry_id": "e6d1be32-61e0-37cb-b6a8-ab34530943e5",
                                        "glosses": [
                                            "The linkage in a (watch) that gives impulses to the timekeeping element and periodically releases the gear train to move forward, advancing the clock's hands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b2509e-7cec-471e-9c5e-0e34210de663",
                                                "sense_id": "89a5a4a7-e8f1-3d41-a20e-4a633264711d",
                                                "text": "The escapement is the reason why clocks tick."
                                            },
                                            {
                                                "example_id": "d857b511-cbd5-4749-8bff-996bb3e1d354",
                                                "sense_id": "89a5a4a7-e8f1-3d41-a20e-4a633264711d",
                                                "text": "For some reason, adjusting the 400-day clock escapement strikes fear into the hearts of many clock repairers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c5dcb39-10fc-31d9-9d5f-623dbc87074a",
                                        "entry_id": "e6d1be32-61e0-37cb-b6a8-ab34530943e5",
                                        "glosses": [
                                            "A mechanism found in devices such as a typewriter or printer which controls lateral motion of the carriage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "406a7177-09d4-33b1-baaf-0cf3c3779ff3",
                                        "entry_id": "e6d1be32-61e0-37cb-b6a8-ab34530943e5",
                                        "glosses": [
                                            "An escape or a means of escape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f8940c0-e6fd-3052-940c-1e0e93c2e771",
                                        "entry_id": "e6d1be32-61e0-37cb-b6a8-ab34530943e5",
                                        "glosses": [
                                            "The number of fish that escape commercial fishing operations and travel upstream to spawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83bef1ed-caa5-4d3f-8404-ee05c91b2c64",
                                                "sense_id": "4f8940c0-e6fd-3052-940c-1e0e93c2e771",
                                                "text": "Importantly, there are also extensive practical difficulties associated with gathering and interpreting accurate escapement and run-size information and applying it to population management."
                                            },
                                            {
                                                "example_id": "72aac003-22bd-4f8d-9eac-18cc89b418d5",
                                                "sense_id": "4f8940c0-e6fd-3052-940c-1e0e93c2e771",
                                                "text": "They obtained migration information from a mark– recapture experiment, daily escapement information from aerial surveys, and daily catch information from fish tickets."
                                            },
                                            {
                                                "example_id": "91523faa-7f8d-4ed7-9cab-351279c80fd9",
                                                "sense_id": "4f8940c0-e6fd-3052-940c-1e0e93c2e771",
                                                "text": "Who actually listens to us when we tell him we need to cut back on escapement in the Kanuyaq because too many salmon are getting past the dip netters and it's messing with the spawning beds?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
