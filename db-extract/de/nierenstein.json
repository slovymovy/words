                        "entry_id": "441cf050-5fb1-3511-8a3c-df21a456a844",
                        "glosses": [
                            "steinartige Ablagerungen in der Niere, die aus Bestandteilen des Harns bestehen (Vergleiche auch Nierengrieß)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01a18c7-2621-4837-89d3-24290bc70d59",
                                "sense_id": "94fb7397-ab8c-3a1b-a30a-80d448adde3e",
                                "text": "Kleine Nierensteine werden mit dem Urin ausgeschieden."
                            },
                            {
                                "example_id": "073db0c9-201d-4f72-859f-c6f415dd13d3",
                                "sense_id": "94fb7397-ab8c-3a1b-a30a-80d448adde3e",
                                "text": "„Nierensteine entstehen, wenn Substanzen auskristallisieren, die normalerweise im Harn gelöst sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
