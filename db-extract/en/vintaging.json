                        "examples": [
                            {
                                "example_id": "1a258fcd-7019-4282-afa7-dd9f91e003fc",
                                "sense_id": "49e3465b-7bf6-3a47-9329-a97581359223",
                                "text": "I stalked his vintagings, And here, to Bacchus vowed, alive he swings."
                            },
                            {
                                "example_id": "173e3567-4566-4a9b-bcea-7f48c4b846a2",
                                "sense_id": "49e3465b-7bf6-3a47-9329-a97581359223",
                                "text": "When I lifted mine eyes, far, far away, Thou it was turning the new-mown hay, Thou it was in the new vintagings, And it was thy step, all a shiver of wings."
                            },
                            {
                                "example_id": "acd2d13f-40a4-40ee-9ba9-e7c72602dced",
                                "sense_id": "49e3465b-7bf6-3a47-9329-a97581359223",
                                "text": "\"And in the days of Noah,\" the rector added, pausing in the act of choosing a cigar, \"if not in salons, then at their marryings and feastings, their vintagings and gossipings round fountains while the pitchers ran over.\""
                            }
                        ]
