                    },
                    {
                        "translation_id": "759d9f1f-2c1e-4a2e-b679-9447bb072e02",
                        "source_entry_id": "16fe8fff-997e-36ad-9ce6-767bda1ad9c0",
                        "source_sense_description": "(literally) covered by a veil",
                        "target_lang_word": "verschleiert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschleiert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2f049a-35b2-3400-a506-afaf54f2a2fb",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "einen Schleier tragend; sein Gesicht oder Körper verhüllend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6600124a-da1f-4c60-a57c-5f576603740e",
                                                "sense_id": "5e2f049a-35b2-3400-a506-afaf54f2a2fb",
                                                "text": "Seit einem Monat gibt es in Ägypten den ultraorthodoxen Fernsehkanal Maria TV. Hier geben verschleierte Frauen Kosmetik- und Ehetipps."
                                            },
                                            {
                                                "example_id": "7cb55bde-37a4-4550-a3fc-840a533251cf",
                                                "sense_id": "5e2f049a-35b2-3400-a506-afaf54f2a2fb",
                                                "text": "Irgendwann muss Sandra noch verschleierter leben, nur die Augen bleiben frei. Als sie die Trennung will, eskaliert die Situation."
                                            },
                                            {
                                                "example_id": "16ae5fbc-3439-488b-a54e-24d80391388f",
                                                "sense_id": "5e2f049a-35b2-3400-a506-afaf54f2a2fb",
                                                "text": "Wird eine Frau [auf der Straße] voll verschleiert angetroffen, muss sie nach dem Gesetzentwurf [in Belgien] mit einer Geldstrafe von bis zu 25 Euro sowie Haft bis zu sieben Tagen rechnen."
                                            },
                                            {
                                                "example_id": "98f9f635-a279-441c-9af5-89eca485bac5",
                                                "sense_id": "5e2f049a-35b2-3400-a506-afaf54f2a2fb",
                                                "text": "Die Frau saß bis auf die Augen verschleiert in der ersten Reihe der Pariser Oper an der Bastille, direkt hinter dem Dirigenten und verfolgte die Aufführung der Oper \"La Traviata\". Einige Sänger reagierten irritiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77aa42b4-7e69-370e-a4a3-58c50d13c438",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "etwas zu Verbergendes; im Geheimen; (möglichst) unauffällig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d64f7b64-d423-406d-95d5-e92b5ae4ef57",
                                                "sense_id": "77aa42b4-7e69-370e-a4a3-58c50d13c438",
                                                "text": "Doch wenn er [der Maler Max Beckmann] alle Masken fallen lässt, dann geht es um die nackte Vorführung des unverstellten Ichs. Das sei für ihn, so sagte er einmal, \"das größte und verschleiertste Geheimnis der Welt\"."
                                            },
                                            {
                                                "example_id": "b506e2b8-9b29-4d16-b0b7-5c2358f512ed",
                                                "sense_id": "77aa42b4-7e69-370e-a4a3-58c50d13c438",
                                                "text": "§850 Zivilprozessordnung: Verschleiertes Arbeitseinkommen"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d1ebe602-91aa-3bea-b316-6a2e8412c353",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "schwach bewölkt mit sehr hohen nicht geschlossenen Wolken; man erkennt im Hintergrund das Blau des Himmels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e45528-c2c5-4435-b854-4066d68c74f5",
                                                "sense_id": "d1ebe602-91aa-3bea-b316-6a2e8412c353",
                                                "text": "„Bei verschleiertem Himmel läuft man Marathon schneller, als bei knalliger Sonne.“"
                                            },
                                            {
                                                "example_id": "c5aae402-f471-41ba-9e86-e9e2cbb8d7a7",
                                                "sense_id": "d1ebe602-91aa-3bea-b316-6a2e8412c353",
                                                "text": "Ein verschleierter Himmel hat den Menschen in NRW bei der Sonnenfinsternis am Freitag vielerorts buchstäblich den Blick vernebelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "eine durch Alkohol, Tränenflüssigkeit oder Nässe verschwommene oder getrübte Sicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241fa015-4d69-43cb-a726-6998da9f9f30",
                                                "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                                "text": "Mit Tränen in den Augen und verschleiertem Blick gestand sie ihm ihre Liebe."
                                            },
                                            {
                                                "example_id": "11c90401-7fac-421d-9f03-a511ada7c02a",
                                                "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                                "text": "Von den Wänden im Treppenhaus grüßen mit verschleiertem Blick Künstler, die mit Drogen seelische Höhlenforschung betrieben haben: Edgar Allan Poe und Trakl, Goya und Cocteau."
                                            },
                                            {
                                                "example_id": "e1f6c3c7-15b9-44af-a433-45645e590e4e",
                                                "sense_id": "b191818f-5101-304d-9aeb-aafdb6b5869a",
                                                "text": "[…] Elvis 1973 auf Hawaii: Zuschauer an den Fernsehern weltweit sahen den King mit verschleiertem Blick und unsicherem Schritt […]"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "430ec3cb-f9ca-3688-807c-b7b04de2c5f1",
                                        "entry_id": "b3a79884-d285-3c8f-a0e0-83beb596612a",
                                        "glosses": [
                                            "eine durch Krankheit oder belegte Stimmbänder veränderte Stimme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f219339-68bd-48c4-b35e-ee1f56113d5f",
                                                "sense_id": "430ec3cb-f9ca-3688-807c-b7b04de2c5f1",
                                                "text": "»Ja, Jenny,« hob er mit immer noch verschleierter Stimme an, »was versäumt ist, ist versäumt.[…]«"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "verschleiert",
                                "target_lang_code": "de",
