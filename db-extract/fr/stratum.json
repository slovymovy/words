                "senses": [
                    {
                        "sense_id": "26a5356f-efeb-37a6-9cdd-f3778241df23",
                        "entry_id": "ba2cfa29-1346-3baf-b847-49944f2f9027",
                        "glosses": [
                            "Matière organique en couche continue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6de5737e-2f51-3fb2-b79c-862a588ff0bc",
                        "entry_id": "ba2cfa29-1346-3baf-b847-49944f2f9027",
                        "glosses": [
                            "Couche de terrain continue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a12ac26-dc23-42d9-b168-073933ee979b",
                                "sense_id": "6de5737e-2f51-3fb2-b79c-862a588ff0bc",
                                "text": "Dans l'échantillonnage systématique l'unité apparait à la même position relative dans le stratum ; alors que dans l'échantillonnage stratifié aléatoire, la position de l'échantillon est déterminée par casualisation dans chaque stratum."
                            }
                        ]
                    },
                    {
                        "sense_id": "9025d80b-e45d-3df7-99a6-a804e0ae4c38",
                        "entry_id": "ba2cfa29-1346-3baf-b847-49944f2f9027",
                        "glosses": [
                            "Strate dans les expressions médicales ci-dessous."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f37545a2-3b47-432a-a779-59678359ddb1",
                        "source_entry_id": "ba2cfa29-1346-3baf-b847-49944f2f9027",
                        "target_lang_word": "stratum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "One of several parallel horizontal layers of material arranged one on top of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7ca724-2743-45a2-a2e4-de8c78237809",
                                                "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                                                "text": "It is built of alternate strata of brick and clay, and the sides correspond to the direction of the meridians and parallels."
                                            },
                                            {
                                                "example_id": "d01e2362-de87-400f-bc3f-01fc32206676",
                                                "sense_id": "7b3fb95e-9b9d-3509-91db-30e4c025f22c",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d8e5342-2812-31df-b56c-024140fac72d",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "A layer of sedimentary rock having approximately the same composition throughout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825a6295-4017-4d43-b0be-a5f68bc560d0",
                                                "sense_id": "4d8e5342-2812-31df-b56c-024140fac72d",
                                                "text": "An illuminating article in a recent issue of the Eastern Region's Civil Engineering News points out that where coal is worked over a reasonably large area, it is not only the whole of the strata above the workings, but also an area beyond which is liable to subside at varying rates after the coal has been removed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065582c9-4255-3f9c-870c-84da1c8d1b48",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "Any of the regions of the atmosphere, such as the stratosphere, that occur as layers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03e6aea4-930e-3acb-be26-d8bd5a7f3260",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "A layer of tissue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f55a1c3-2867-3e34-9b6c-90915f0d1420",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "A class of society composed of people with similar social, cultural, or economic status."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ac4be85-b02c-3a58-91c5-a5044c42a8bd",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "A layer of vegetation, usually of similar height."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1d828ab-109c-3481-b2a0-0730fd810055",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "The level of accuracy of a computer's clock, relative to others on the network."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84961090-da9e-49d6-9c84-d7c468dceb58",
                                                "sense_id": "b1d828ab-109c-3481-b2a0-0730fd810055",
                                                "text": "Computers that synchronize themselves to the stratum 1 time servers are known as stratum 2 time servers if they allow others to synchronize to them, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f532ea9d-d75b-3988-a0f4-da94e662938f",
                                        "entry_id": "9b2d6b89-adc4-3c0d-890f-d7d06fb43a27",
                                        "glosses": [
                                            "A historical layer of a language."
                                        ],
                                        "tags": [],
