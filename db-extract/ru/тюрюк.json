                        "glosses": [
                            "диал. мешок, сумка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f987f9ec-7556-498f-84a2-f8062101f89d",
                                "sense_id": "452ac80b-4f81-3a9b-b4bc-0eb92063afe4",
                                "text": "Каждый раз приносит ей в подарок или полфунта винных ягод, или тюрюк кедровых орехов."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b8165ec-45b4-3423-90ff-3f89f387a2af",
                        "entry_id": "f152b2ea-f1f9-324e-adf3-e0505cb04bcf",
                        "glosses": [
                            "человек, которого нужно было подымать пинко́м на что-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1020892f-caf4-483a-aaba-970f841a26eb",
                                "sense_id": "8b8165ec-45b4-3423-90ff-3f89f387a2af",
                                "text": "Кто был то, что называют тюрюк, то есть человек, которого нужно было подымать пинко́м на что-нибудь; кто был просто байба́к, лежавший, как говорится, весь век на боку, которого даже напра́сно было подымать: не встанет ни в каком случае."
                            }
                        ]
                    }
