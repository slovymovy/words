                "senses": [
                    {
                        "sense_id": "0b9c241d-c0f6-35c2-a0c0-5529a8cdf0b3",
                        "entry_id": "34921f46-352e-3303-943f-a63646ca9932",
                        "glosses": [
                            "Art und Weise zu lachen, mit der signalisiert wird, dass jemand oder etwas mit Hohn abgelehnt/verlacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ffa4a2-6358-4fab-8205-863d0b689927",
                                "sense_id": "0b9c241d-c0f6-35c2-a0c0-5529a8cdf0b3",
                                "text": "„Er verglich den Spott, der die Pioniere der Parapsychologie traf, mit dem Hohngelächter, das in der Geschichte der Wissenschaften immer dann erscholl, wenn ein Ketzer zu neuen Ufern vorzustoßen versuchte.“"
                            },
                            {
                                "example_id": "17c1b9c1-63c8-4afe-8e7d-b4add0a40284",
                                "sense_id": "0b9c241d-c0f6-35c2-a0c0-5529a8cdf0b3",
                                "text": "„Der arme Benito fuhr schaudernd zusammen und zog sich ächzend zurück und durch die Türe hinaus, aus der ihm ein höllisches Hohngelächter nachhallte.“"
                            },
                            {
                                "example_id": "f009be88-0f8f-46ff-bcbf-69de6bb35bb8",
                                "sense_id": "0b9c241d-c0f6-35c2-a0c0-5529a8cdf0b3",
                                "text": "„Rosenfeld brach in ein Hohngelächter aus.“"
                            },
                            {
                                "example_id": "9bb1c445-a975-4eeb-a37b-c75f396b34ac",
                                "sense_id": "0b9c241d-c0f6-35c2-a0c0-5529a8cdf0b3",
                                "text": "„Zwei kleine Amerikaner hatten gleich beim Start versagt; ihr Team arbeitete verzweifelt und unter allgemeinem Hohngelächter an ihnen herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
