                    {
                        "translation_id": "f3e5862e-35bc-4980-87a1-fc0b56768fe5",
                        "source_entry_id": "3825d9ff-f270-3245-a496-4443180eb203",
                        "source_sense_id": "862a562b-3958-37a9-8d05-f67ab45a0317",
                        "target_lang_word": "минет",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "минет",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5300687-6097-3e96-ae0d-d0ae0fd1b1b3",
                                        "entry_id": "1c874bc6-e434-3164-8fe3-80a317ef840d",
                                        "glosses": [
                                            "сексол. разновидность орального секса, при котором половой член возбуждается ртом, языком, зубами или горлом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4caa814a-be7c-4cde-bf85-85490ab842f1",
                                                "sense_id": "f5300687-6097-3e96-ae0d-d0ae0fd1b1b3",
                                                "text": "Я вопрос конкретный ставлю, // Но не жду ответа: // «До каких же пор сосанье // Будут звать минетом?»"
                                            },
                                            {
                                                "example_id": "62029457-11ad-44db-85ff-46da6ef62327",
                                                "sense_id": "f5300687-6097-3e96-ae0d-d0ae0fd1b1b3",
                                                "text": "Мы прошлись по белу свету, — // Всех видали на хую! // Для нормального минету // Вернусь на родину свою!"
                                            },
                                            {
                                                "example_id": "2b470ff6-c648-4dc9-9757-0a4813534ee3",
                                                "sense_id": "f5300687-6097-3e96-ae0d-d0ae0fd1b1b3",
                                                "text": "Вздор какой! Делают минет, а гордятся девственностью."
                                            },
                                            {
                                                "example_id": "d9eaff64-6314-4996-a853-7f97bf357ecf",
                                                "sense_id": "f5300687-6097-3e96-ae0d-d0ae0fd1b1b3",
                                                "text": "Берёт хуй в рот и сосёт. Это называется минет. Эди знает, ему Славка Цыган рассказывал о минете. Славка большой любитель минета. Лучше всего минет делают прибалтийские девушки, знает Эди от Славки, потому что они очень западные, а не такие деревенские, как наши русские или украинки."
                                            },
                                            {
                                                "example_id": "b893c46c-b3aa-4538-8ae1-a710e7da4d5e",
