                        "target_lang_word": "gefeiert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gefeiert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a375ddc7-0559-3279-b284-70da9438e4ef",
                                        "entry_id": "e4c6bb98-38b2-3038-b2bf-d47acbd7405c",
                                        "glosses": [
                                            "durch besondere Eigenschaften oder Leistungen geschätzt und verehrt"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "844b0f32-5131-48a1-aa40-cc9947ad45f5",
                                                "sense_id": "a375ddc7-0559-3279-b284-70da9438e4ef",
                                                "text": "Der international gefeierte Filmemacher und Künstler hat sich mit kühn konstruierten, elliptisch erzählten, aber durch ihre atmosphärische Dichte und zugängliche Metaphorik fesselnden Kinoarbeiten einen Namen gemacht."
                                            },
                                            {
                                                "example_id": "5018a2a8-3ee3-436c-8e26-469e60464732",
                                                "sense_id": "a375ddc7-0559-3279-b284-70da9438e4ef",
                                                "text": "Dem bislang zu Recht gefeierten US-Autor schlägt nun also erstmals ordentlich Kritikergegenwind entgegen."
                                            },
                                            {
                                                "example_id": "ab7c3c56-6f08-4060-94d8-a77ba1f28351",
                                                "sense_id": "a375ddc7-0559-3279-b284-70da9438e4ef",
                                                "text": "1985, 1986 (gegen Ivan Lendl) und 1989 (gegen Stefan Edberg) zeigte der im deutschen Boulevard gefeierte Star seine Becker-Faust."
                                            },
                                            {
                                                "example_id": "26b48107-2726-4c16-9815-64c599900722",
                                                "sense_id": "a375ddc7-0559-3279-b284-70da9438e4ef",
                                                "text": "\"Ich war überrascht, von Anfang an zu spielen. Das ist das Vertrauen, das mir der Verein gibt\", meinte der von den Fans gefeierte Hoffnungsträger."
                                            },
                                            {
                                                "example_id": "461b6606-96fc-4a7b-b868-d836647d82cf",
                                                "sense_id": "a375ddc7-0559-3279-b284-70da9438e4ef",
                                                "text": "Frauen mögen Salons führen wie Rahel Varnhagen von Ense, sie mögen gefeierte Virtuosinnen sein wie Clara Schumann oder Maria Malibran; schöpferisch arbeiten aber dürfen sie nicht, jedenfalls nicht öffentlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
