                                "target_senses": [
                                    {
                                        "sense_id": "b444b27e-5bc2-393f-9407-d0ca31a37dae",
                                        "entry_id": "55175181-9cb2-3edc-896c-c9ddbab33478",
                                        "glosses": [
                                            "Speicher, in dem Daten zwischengespeichert werden, um ein zeitaufwändiges Wiederbeschaffen der Daten von einem langsameren Speichermedium zu vermeiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9388d52-e886-48ee-8af5-e129a50574bd",
                                                "sense_id": "b444b27e-5bc2-393f-9407-d0ca31a37dae",
                                                "text": "Der L2-Cache meines Prozessors hat eine Größe von 512 KB."
                                            },
                                            {
                                                "example_id": "e60f65d1-1a84-43c8-ba5d-a91ad8cc8709",
                                                "sense_id": "b444b27e-5bc2-393f-9407-d0ca31a37dae",
                                                "text": "Der Browser speichert die Bilder einer Seite im Cache, um sie nicht bei jedem Aufruf neu herunterladen zu müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
