                        "examples": [
                            {
                                "example_id": "08d64d10-8cde-4ec9-bbff-f6fd5c68b232",
                                "sense_id": "63d040a7-c51c-3b8b-a3e2-309800da8398",
                                "text": "Hij moest eigenlijk gewoon zichzelf zijn in de serie, legt Drenthe uit. Niet dat hij een gangsterbaas is, maar als jongen die opgegroeid is op de Rotterdamse straten, weet hij hoe de wereld er buiten het voetbal ook uit kan zien."
                            },
                            {
                                "example_id": "6f066fbc-3ce5-4be4-b1d0-9fb1f3d3bd52",
                                "sense_id": "63d040a7-c51c-3b8b-a3e2-309800da8398",
                                "text": "Een revolver van gangsterbaas Al Capone wordt binnenkort geveild. Veilinghuis Christie's verkoopt het wapen eind deze maand aan de hoogste bieder."
                            },
                            {
                                "example_id": "11d5eb70-1cf5-464e-a407-0bab945e528e",
                                "sense_id": "63d040a7-c51c-3b8b-a3e2-309800da8398",
                                "text": "Maar eigenlijk is dat nog niks in Haïti. De bekende gangsterbaas Yvon Zab Zab, met verschillende veroordelingen en gevangenisstraffen op z'n naam, heeft zich openlijk tot het kamp van Celestin bekend."
                            }
                        ]
