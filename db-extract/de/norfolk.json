                    {
                        "sense_id": "f16ece80-ec17-38d3-aae5-7d550aedabd8",
                        "entry_id": "f9d11418-0386-33ed-9ad7-d434ed7bf9ea",
                        "glosses": [
                            "Stadt im US-Bundesstaat Virginia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9114f699-5259-41bc-9b11-a33b0129f7c4",
                                "sense_id": "f16ece80-ec17-38d3-aae5-7d550aedabd8",
                                "text": "„Zacks Einheit von Ground-Branch-Agenten hatte ein eigenes Hauptquartier zur Verfügung, ein unauffälliges Gebäude in Norfolk, Virginia.“"
                            },
                            {
                                "example_id": "565172a4-b868-403e-a6d5-e3b74c0a9ec0",
                                "sense_id": "f16ece80-ec17-38d3-aae5-7d550aedabd8",
                                "text": "„In den autobiographischen Passagen des Textes schildert Uris die antisemitischen Schikanen, denen er als Kind in Norfolk im Bundesstaat Virginia ausgesetzt war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b7bfda82-d95b-3a66-84b2-ad406e69f7d1",
                        "entry_id": "f9d11418-0386-33ed-9ad7-d434ed7bf9ea",
                        "glosses": [
                            "Stadt im US-Bundesstaat Nebraska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30e84f44-da14-4c06-8fe7-16385eec7797",
                                "sense_id": "b7bfda82-d95b-3a66-84b2-ad406e69f7d1",
                                "text": "„Auf der Straße, die aus Norfolk herausführte, stieß er auf ein Scheinwerferpaar, das den Graben am Straßenrand entlangleuchtete.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
