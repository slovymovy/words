                        "examples": [
                            {
                                "example_id": "023d2cb8-80ba-45fa-891f-f4e8a83fc91d",
                                "sense_id": "5e6fa341-0139-3ce2-b7ce-ec29ccee3e31",
                                "text": "Мы поехали вчетвером ― тётка, Лиза, двухмесячная Наташа и я."
                            },
                            {
                                "example_id": "bb36b8a4-344f-4209-9ab3-45ed933bbff9",
                                "sense_id": "5e6fa341-0139-3ce2-b7ce-ec29ccee3e31",
                                "text": "Мы вчетвером (она, обе сестры и я) шли в театр."
                            },
                            {
                                "example_id": "c92b7399-7e04-4a24-bfbc-942d0f377725",
                                "sense_id": "5e6fa341-0139-3ce2-b7ce-ec29ccee3e31",
                                "text": "За обеденный стол садились вчетвером ― Георгий Владимирович с женой и два старца, один из них бывший предводитель дворянства."
                            }
                        ]
                    }
