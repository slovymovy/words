                        "examples": [
                            {
                                "example_id": "28a19970-2bea-4da0-9fb5-39b0b1843049",
                                "sense_id": "d7b2b52a-8d3b-37ab-a028-908fda8d08c2",
                                "text": "A l'intérieur, il y avait de quoi rouler quelques pets. Une herbe très parfumée, toute violette. Ça devait être une variété comme de la “Sweet Purple”. […]. Elle montra la beuze à Bob et entreprit de se rouler un pet, et il fit de même. Ils fumèrent tranquillement."
                            },
                            {
                                "example_id": "ef95dbda-69e5-46b0-8979-e8afd761da78",
                                "sense_id": "d7b2b52a-8d3b-37ab-a028-908fda8d08c2",
                                "text": "Bellek me fait des bases d'enfer, j’fume de la beuze et de l’abs’, frère\nTon équipe par terre, au coup par coup, je n'ai plus d’cœur"
                            }
                        ]
                    }
