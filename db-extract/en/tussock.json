                        "cross_references": [
                            {
                                "target_word": "Grasbüschel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e86775-56a7-37d2-95ac-fdd231fd527e",
                                        "entry_id": "c27177cb-eebf-3b13-9404-3e1a3f9585e0",
                                        "glosses": [
                                            "gebündelte oder miteinander verwachsene, relativ kleine Menge von Grashalmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a22905-a4bd-4303-a446-0e984101fe1b",
                                                "sense_id": "e8e86775-56a7-37d2-95ac-fdd231fd527e",
                                                "text": "„Er riß weiter an den Grasbüscheln herum und blickte uns so an, daß wir merkten, eigentlich nahm er uns gar nicht wahr.“"
                                            },
                                            {
                                                "example_id": "25cdff91-73b2-4513-a166-0637a0e2847f",
                                                "sense_id": "e8e86775-56a7-37d2-95ac-fdd231fd527e",
                                                "text": "„Auf einem Grasbüschel saßen der Blöde und der Hund.“"
                                            },
                                            {
                                                "example_id": "b3af5ca5-9c18-4191-ad84-2b99c2eb9fd4",
                                                "sense_id": "e8e86775-56a7-37d2-95ac-fdd231fd527e",
                                                "text": "„Mit beiden Händen zupfte ich an einem Grasbüschel, das ich langsam, aber unaufhaltsam massakrierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
