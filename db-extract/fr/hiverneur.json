                        "glosses": [
                            "Nom amérindien du faucon moucheté."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dd5aa2c6-dc19-413b-9734-f31f9112ffdb",
                                "sense_id": "83d7264b-06ac-3a14-bd7a-4e06855483c5",
                                "text": "Il ne restait plus que quelques couples de ces faucons mouchetés, auxquels les Indiens donnent précisément le nom d' «hiverneurs», parce qu'ils s'attardent dans les régions glacées jusqu'au commencement de la nuit polaire, et bientôt ils allaient eux-mêmes disparaître."
                            }
                        ]
                    }
