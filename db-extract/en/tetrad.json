    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                "word": "tetrad",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ea543f8a-04d7-44c1-9030-9f039c52f6af",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "tags": [
                            "plural"
                        ],
                        "form": "tetrads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d427dda3-1dea-3089-9806-b5bfe05805d6",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "A group of four things."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50a3bbe-e4e2-485f-af7a-2564011468c4",
                                "sense_id": "d427dda3-1dea-3089-9806-b5bfe05805d6",
                                "text": "Religious movements and cults are often founded on a tetrad of elements: a prophet, a prophecy, a book, and a revelation."
                            }
                        ]
                    },
                    {
                        "sense_id": "29e8e579-e476-3641-b8f5-6eaddc9aa5ea",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "Two pairs of sister chromatids (a dyad pair) aligned in a certain way and often on the equatorial plane during the meiosis process."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b37938b0-c756-31c6-9e53-12dd49004158",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "A group of four haploid and immature pollen grains in tetrahedral fashion produced by meiotic microsporogenesis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a5052312-21a4-3847-ae81-f34172da2b04",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "A unit of land area of two by two (that is, four) square kilometres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95aa506-50bc-4beb-ae74-34c8c13da64c",
                                "sense_id": "a5052312-21a4-3847-ae81-f34172da2b04",
                                "text": "They took figures for the abundance of invasive weeds mapped according to the normal grid unit of the 'hectad', or 10 × 10 km square, and then looked at how abundant these species were mapped at a much finer scale – in 'tetrads', or 2 × 2 km squares, inside these hectads."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd18b1a7-03d0-3d4a-8f31-64d33d7bfceb",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "A tetravalent atom or radical."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0921e57d-c7e6-3cb2-adb1-c47eb906cdaf",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "A group of four basis vectors for a four-dimensional manifold in differential geometry."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71af5cfd-5f6d-31f2-a5ae-a31e6c54e4e7",
                        "entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "glosses": [
                            "A chord comprised of four notes; a tetrachord."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d97d621-8b19-4e1e-a498-a423f0d1f953",
                        "source_entry_id": "2414dcaf-6000-367a-a0cc-aa8e0d8b1674",
                        "source_sense_description": "Translations",
                        "target_lang_word": "tétrade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tétrade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e6fc02-b7cb-345f-bb56-cd5094e60c83",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Groupe de quatre éléments solidaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e71a1e9-3b46-3b3b-b924-41454a9fd5ac",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Nombre quatre, symbole de justice chez Pythagore ; série ou somme des quatre premiers nombres, combinaison numérique dans laquelle interviennent quatre nombres ou quatre opérations particulières."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ae4294-8635-49fe-86e7-b75281cea1a0",
                                                "sense_id": "9e71a1e9-3b46-3b3b-b924-41454a9fd5ac",
                                                "text": "Tu t’appelleras Hermès, et tes disciples, quand tu les auras trouvés s’appelleront Tat, Asclèpios et Ammon. Puisse se compléter bientôt la tétrade hiératique qui doit transmettre, d’une génération à l’autre, le dépôt de la science sacrée."
                                            },
                                            {
                                                "example_id": "c1653427-0c24-4545-8591-55e66f5f73aa",
                                                "sense_id": "9e71a1e9-3b46-3b3b-b924-41454a9fd5ac",
                                                "text": "L’homme, dans l’antique doctrine, comme dans la vérité, est une tétrade, un quaternaire : il est sensation, sentiment, connaissance ; et il est ces trois choses unies, et formant par leur réunion une unité, une monade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f557128-b854-3e11-8a92-312247d0a8e7",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Nombre quatre, symbole de justice chez Pythagore ; série ou somme des quatre premiers nombres, combinaison numérique dans laquelle interviennent quatre nombres ou quatre opérations particulières.",
                                            "Ensemble de quatre éléments tels que ceux qui forment ou qui définissent l’âme, l’Homme ou la Divinité."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "759fedde-8620-3df4-b025-88a7b07dbd60",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Ensemble des quatre chromatides associées au sein d’un bivalent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19dd4f49-3ed2-38f9-a2af-9d505adac302",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Groupe de quatre spores ou de quatre grains de pollen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "915d02b7-d548-3e0d-bdd5-055e2cf9c5db",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Suite de quatre bits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28176f41-9b31-344f-b0f9-7a9002cc6ce2",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Assemblage des quatre premiers nombres naturels, 1, 2, 3, 4."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85190a6c-3c79-358a-ac64-13fec23799ca",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7273a8d3-31c0-368b-bd66-278b8ad58102",
