                        "glosses": [
                            "jeden z szerzej używanych w Indiach języków, język urzędowy stanu Maharasztra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed180502-8820-46b2-9477-a02e1fa41b2b",
                                "sense_id": "9d302dc6-979f-3455-ab5f-bfd51370be03",
                                "text": "Jego wiersze tłumaczono na języki: angielski, francuski, niemiecki, rosyjski, hiszpański, węgierski, norweski, arabski, gudźarati, marathi, bengali, polski"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
