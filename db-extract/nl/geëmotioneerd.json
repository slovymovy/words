                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Readily displaying emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474b4760-5a32-417a-81b2-801f9a6c04a4",
