                                "sense_id": "4df5ff5d-6805-3d93-b338-9ad4e77e54c7",
                                "text": "Het wijnjaar 2005 staat bekend om zijn uitstekende rode wijnen.",
                                "translation": "The vintage of 2005 is known for its excellent red wines.",
                                "english": "The vintage of 2005 is known for its excellent red wines."
                            },
