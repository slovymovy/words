                                "ru": "Ты не можешь пойти на вечеринку в такой <w>неопрятной</w> одежде.",
                                "pl": "Nie możesz iść na przyjęcie w tak <w>niechlujnym</w> ubraniu.",
                                "de": "Du kannst nicht in solch <w>schlampiger</w> Kleidung zur Party gehen.",
                                "fr": "Tu ne peux pas aller à la fête avec une tenue aussi <w>négligée</w>.",
                                "it": "Non puoi andare alla festa con dei vestiti così <w>trasandati</w>.",
                                "cs": "Nemůžeš jít na večírek v tak <w>neupraveném</w> oblečení.",
                                "tr": "Partiye bu kadar <w>pasaklı</w> kıyafetlerle gidemezsin.",
                                "es": "No puedes ir a la fiesta con una ropa tan <w>desaliñada</w>.",
                                "zh": "你不能穿着这么<w>邋遢</w>的衣服去参加聚会。"
                            }
