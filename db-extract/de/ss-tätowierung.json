                "senses": [
                    {
                        "sense_id": "fada6c33-c5fb-3422-9f93-67b37568f84d",
                        "entry_id": "ba6d0668-15fa-38f4-977d-4dbe2d8fbf75",
                        "glosses": [
                            "Tätowierung der Blutgruppe, die viele SS-Männer erhielten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc5bdb6-243d-40c5-9f2f-f375e4934b40",
                                "sense_id": "fada6c33-c5fb-3422-9f93-67b37568f84d",
                                "text": "„Doktor Hugo Weber entfernte zuerst meine SS-Tätowierung unter dem linken Oberarm – eigentlich eine unansehnliche Tätowierung, ein kleiner Buchstabe, mein Blutgruppenzeichen – entfernte dann auch das Vorhäutchen an meinem Geschlechtsglied, operierte mit zittrigen, runzeligen Händen, ein letzter Liebesdienst für Führer und Vaterland.“"
                            },
                            {
                                "example_id": "f3b59dec-a0c0-4b9c-909a-083f04269732",
                                "sense_id": "fada6c33-c5fb-3422-9f93-67b37568f84d",
                                "text": "„Dort ließ er sich auch von einer Krankenschwester die SS-Tätowierung der Blutgruppe entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
