                ],
                "senses": [
                    {
                        "sense_id": "263bd966-1fcf-3311-8a22-b143bd3b6808",
                        "entry_id": "ad9472ed-611c-32f8-92fa-37fef0932e2f",
                        "glosses": [
                            "Fenêtre qui s’avance sur la façade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f53d56-ef06-46a7-8957-ef2eb9b35632",
                                "sense_id": "263bd966-1fcf-3311-8a22-b143bd3b6808",
                                "text": "Cet étrange personnage languissant passait ses heures dans une bow-window d’un club de St. James’ Street, […]"
                            },
                            {
                                "example_id": "210f1f39-c54e-40b4-8e57-0b16608c6fe7",
                                "sense_id": "263bd966-1fcf-3311-8a22-b143bd3b6808",
                                "text": "Au 44 de la Belle-Alliance Platz, je trouvai une maison bourgeoise boursouflée de bow-windows de brique peinte, comme on en voit des milliers à Berlin."
                            },
                            {
                                "example_id": "288898aa-b6c3-4738-9def-929769a2aaf8",
                                "sense_id": "263bd966-1fcf-3311-8a22-b143bd3b6808",
                                "text": "Oui, la pluie sur la pelouse au-delà des bow-windows, le chintz à ramages vert canard des doubles rideaux, ces fauteuils aux courbes si moelleuses déferlant jusqu’au sol, où sont-ils ?"
                            },
                            {
                                "example_id": "dff5feaf-7a95-4c6d-8b50-0c27b7a0c6c7",
                                "sense_id": "263bd966-1fcf-3311-8a22-b143bd3b6808",
                                "text": "En face, protégée par une grille, une maison d'un étage avec un bow-window, et à la façade recouverte de lierre."
                            },
                            {
                                "example_id": "2d2f37ab-79ef-4362-99a2-8e10b7e11190",
                                "sense_id": "263bd966-1fcf-3311-8a22-b143bd3b6808",
                                "text": "Il le guida dans un salon où brûlait un feu de cheminée et lui désigna un fauteuil face au bow-window."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7523cfc-51fe-4d82-842d-7e96940cdeeb",
                        "source_entry_id": "ad9472ed-611c-32f8-92fa-37fef0932e2f",
