                "senses": [
                    {
                        "sense_id": "1b307712-ff2c-3342-bb66-93455a72e0ac",
                        "entry_id": "7128ffce-644f-3dab-9007-962c2bd709a3",
                        "glosses": [
                            "fontänenartig hochwirbelndes und niederfallendes Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51b695e-9b23-4abc-952c-871b20968fb3",
                                "sense_id": "1b307712-ff2c-3342-bb66-93455a72e0ac",
                                "text": "„Mein Schlachtruf erschütterte den Tunnel, ich sprang auf die Meute zu und mein schweres Schwert sang, als es den grinsenden Kopf einer Bestie von den Schultern trennte und eine Blutfontäne in hohem Bogen über mir aufstieg.“"
                            },
                            {
                                "example_id": "0eea3807-2e7b-41fb-99cf-5f2dee5879ae",
                                "sense_id": "1b307712-ff2c-3342-bb66-93455a72e0ac",
                                "text": "„Der Kopf des Mannes flog von seinen Schultern, und eine Blutfontäne spritzte auf den Boden.“"
                            },
                            {
                                "example_id": "71142d76-131f-4dc7-b1c3-b389cb900aeb",
                                "sense_id": "1b307712-ff2c-3342-bb66-93455a72e0ac",
                                "text": "„Sie blickte hoch zu Buddy Matlows Augen und sah, dass er über das Lenkrad des Plymouth starrte, mit totenbleichem Gesicht, während seine Lippen irgendetwas zu sagen versuchten und aus seinem Schoß jetzt eine Blutfontäne in die Höhe schoss und über seine Beine lief und auf den Innenboden des Wagens tropfte.“"
                            },
                            {
                                "example_id": "3867210f-2118-4976-8b77-8e07e25ef0f5",
                                "sense_id": "1b307712-ff2c-3342-bb66-93455a72e0ac",
                                "text": "„Mit einem Ruck riss er den Arm in einer Blutfontäne ab.“"
                            },
                            {
                                "example_id": "145085dc-8236-45f7-a88d-266eaaa701c9",
                                "sense_id": "1b307712-ff2c-3342-bb66-93455a72e0ac",
                                "text": "„Rotes Blut spritzt senkrecht hervor wie Wasser aus dem Blasloch eines Wals. Eine Blutfontäne: Die Zuschauer kreischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
