                ],
                "senses": [
                    {
                        "sense_id": "8d5cad15-5e8f-36fa-98ac-1c20abe89cf2",
                        "entry_id": "c26273aa-6d6f-3863-a631-1e9509599a76",
                        "glosses": [
                            "Agiter de nouveau. Ce verbe s’employait à la place de remuer."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8bb940b9-3029-4496-b872-eb376a9b9c41",
                                "sense_id": "8d5cad15-5e8f-36fa-98ac-1c20abe89cf2",
                                "text": "La fièvre l’a tout remouvé."
                            },
                            {
                                "example_id": "6866f1b8-b9fb-4948-b3aa-daaa746b8158",
                                "sense_id": "8d5cad15-5e8f-36fa-98ac-1c20abe89cf2",
                                "text": "L’ognon se seme à la volée, c'est-à-dire à plein champ sans rayons : on le marche ensuite, non en allant devant soi, comme font quelque-suns ; mais de côté, traînant un pié l’un après l’autre : on y passe ensuite le grand rateau, pour rompre & retirer les mottes, s’il en reste, & remouver un peu la terre."
                            }
                        ]
                    }
