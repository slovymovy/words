                "senses": [
                    {
                        "sense_id": "6808fdaa-f1f9-3e80-8e59-23b5fc45e035",
                        "entry_id": "94f8bcbf-cbf6-3db9-94c5-672da7572637",
                        "glosses": [
                            "therapeutische Maßnahme, bei der ionisierende Strahlung eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ade1866-dc04-4bda-9f68-6653e662a4f6",
                                "sense_id": "6808fdaa-f1f9-3e80-8e59-23b5fc45e035",
                                "text": "„Strahlentherapie kann alleine oder in Verbindung mit Operation und/oder Chemotherapie durchgeführt werden.“"
                            },
                            {
                                "example_id": "9c50186a-f629-449c-b218-3c5d5f1b5c82",
                                "sense_id": "6808fdaa-f1f9-3e80-8e59-23b5fc45e035",
                                "text": "„1983 wurde bei Illich eine bösartige Geschwulst der Ohrspeicheldrüse diagnostiziert; die Ärzte empfahlen eine OP mit anschließender Strahlentherapie und stellten dem 57-Jährigen noch sechs bis sieben Jahre Lebenszeit in Aussicht.“"
                            },
                            {
                                "example_id": "04a7c148-b542-460b-98fb-24ef8ed8fcf1",
                                "sense_id": "6808fdaa-f1f9-3e80-8e59-23b5fc45e035",
                                "text": "„Die Initiatoren der Studie kommen klar und unmissverständlich zu dem Schluss, dass die Behandlungsergebnisse deutlich besser sind, wenn man nach der chirurgischen Entfernung der Geschwulst eine Chemotherapie anstelle der bisher üblichen Strahlentherapie durchführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
