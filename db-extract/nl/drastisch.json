                                    {
                                        "sense_id": "ab82cfb2-bf75-3d24-b07d-0f8b2cd22826",
                                        "entry_id": "0ef9b605-590b-357c-879e-8b0b908f053a",
                                        "glosses": [
                                            "Having a strong or far-reaching effect; extreme, severe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4197bb29-3c79-476e-a269-01ec4c33fd0a",
                                                "sense_id": "ab82cfb2-bf75-3d24-b07d-0f8b2cd22826",
                                                "text": "If our third attempt fails, we may need drastic ideas."
                                            },
                                            {
                                                "example_id": "fb99411f-72d1-4ae8-a906-47f5551db727",
                                                "sense_id": "ab82cfb2-bf75-3d24-b07d-0f8b2cd22826",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed947dd-15de-39da-8ab8-15535542547b",
                                        "entry_id": "0ef9b605-590b-357c-879e-8b0b908f053a",
                                        "glosses": [
                                            "Acting rapidly or violently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f45a87f6-8140-46a3-a5c9-a576c0eae6e9",
                                                "sense_id": "fed947dd-15de-39da-8ab8-15535542547b",
                                                "text": "Great statesmen err, and why not small medical men? Mr. Wrench did not neglect sending the usual white parcels, which this time had black and drastic contents. Their effect was not alleviating to poor Fred [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
