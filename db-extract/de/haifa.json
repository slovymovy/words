                "senses": [
                    {
                        "sense_id": "88b965ad-ba08-34fe-bc37-a8a468e99f54",
                        "entry_id": "a25504c0-fe76-3a22-bfd8-9f12f5edb78d",
                        "glosses": [
                            "Großstadt in Israel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7b0085-581b-4646-bebc-45a1458620ba",
                                "sense_id": "88b965ad-ba08-34fe-bc37-a8a468e99f54",
                                "text": "„Ähnlich erging es dem Theater von Haifa und dem Israel-Museum in Jerusalem.“"
                            },
                            {
                                "example_id": "4d516f23-1d98-4805-88cf-72b7238cfdb4",
                                "sense_id": "88b965ad-ba08-34fe-bc37-a8a468e99f54",
                                "text": "„Er war in Haifa geboren und in Europa erzogen worden - und er war ein Sympathisant der Fatah.“"
                            },
                            {
                                "example_id": "8d628318-bb1f-4dce-9e02-7bceee380a21",
                                "sense_id": "88b965ad-ba08-34fe-bc37-a8a468e99f54",
                                "text": "„Am 16. Juli feuerte sie zum ersten Mal Raketen auf die nordisraelische Hafenstadt Haifa, die acht Menschen töteten und mehr als ein Dutzend verletzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
