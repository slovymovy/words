                "senses": [
                    {
                        "sense_id": "ef4490fd-843a-3f73-9095-0e03a81229c0",
                        "entry_id": "1d311c30-f1f3-3e5b-814a-eacf51d0b6cb",
                        "glosses": [
                            "Embringuer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4242d65a-a9a7-46ae-b085-1447db19058e",
                                "sense_id": "ef4490fd-843a-3f73-9095-0e03a81229c0",
                                "text": "Quatrième... réembringué... empaqueté... repris... comme un gars qui a voulu s'évader et qui se sent d'abord touché à l'épaule, puis pris par le bras."
                            },
                            {
                                "example_id": "f4ebb8bc-cc8c-4f4e-8f6d-5d21bbf7cccb",
                                "sense_id": "ef4490fd-843a-3f73-9095-0e03a81229c0",
                                "text": "On eu droit à un nouveau dépaysement exotique, mais tout ce petit monde va se repointer en Amérique pour se réembringuer dans un nouveau complot."
                            },
                            {
                                "example_id": "319d776d-d623-4c6f-adbe-74b21de94b16",
                                "sense_id": "ef4490fd-843a-3f73-9095-0e03a81229c0",
                                "text": "Un p'tit nouveau fraîchement réembringué !"
                            }
                        ]
                    }
