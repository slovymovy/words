                    {
                        "form_id": "76581a25-5f55-45c3-a54d-c6486d024b36",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "tags": [
                            "past"
                        ],
                        "form": "sickened"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e1f3920-8872-320d-bf13-9876d58d230c",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To make ill."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c10e0c2d-0162-4a01-8eee-aa5a1c90a63a",
                                "sense_id": "3e1f3920-8872-320d-bf13-9876d58d230c",
                                "text": "The infection will sicken him until amputation is needed."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8c1b5e0-80bb-3e12-b5c8-f753ccc3af64",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To become ill."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c07c9b55-b923-43ff-b2bd-3734a7f63647",
                                "sense_id": "e8c1b5e0-80bb-3e12-b5c8-f753ccc3af64",
                                "text": "I will sicken if I don’t get some more exercise."
                            },
                            {
                                "example_id": "bf02cd27-f01d-4ec5-a69d-9f0f7c335895",
                                "sense_id": "e8c1b5e0-80bb-3e12-b5c8-f753ccc3af64",
                                "text": "The judges that sat upon the jail, and numbers of those that attended,[…] sickened upon it and died."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c4293ef-c02f-3906-ba64-95e96db69bc5",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To fill with disgust or abhorrence."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "59406af0-c8df-4a66-993c-b56e2f2f8f75",
                                "sense_id": "8c4293ef-c02f-3906-ba64-95e96db69bc5",
                                "text": "His arrogant behaviour sickens me."
                            },
                            {
                                "example_id": "71a961d2-bcf0-4ba0-a092-182c0fa9e56c",
                                "sense_id": "8c4293ef-c02f-3906-ba64-95e96db69bc5",
                                "text": "In announcing the review, Robert F. Kennedy Jr., the new health secretary, said in a statement that “antisemitism — like racism — is a spiritual and moral malady that sickens societies and kills people with lethalities comparable to history’s most deadly plagues.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "31775933-5e34-3cdf-b0f5-ddef5b69706e",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To lower the standing of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "800d4f60-6fb4-44e8-87fd-b8a74097313f",
                                "sense_id": "31775933-5e34-3cdf-b0f5-ddef5b69706e",
                                "text": "Whenever I get booed by opposition fans it only makes me more determined to sicken them."
                            },
                            {
                                "example_id": "81db5c0c-b0d2-4124-b51f-fd9f07c7bb53",
                                "sense_id": "31775933-5e34-3cdf-b0f5-ddef5b69706e",
                                "text": "But instead of giving up, the Rangers team managed to grab a dramatic later winner from Kenny Miller to sicken St Mirren and lift the cup"
                            },
                            {
                                "example_id": "30e00346-7a24-4425-999b-886272075a2d",
                                "sense_id": "31775933-5e34-3cdf-b0f5-ddef5b69706e",
                                "text": "City took control, pinning a tiring Celtic back and threatening to sicken them with a winner."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c686777-3bd9-33de-9504-0b2ccc55c87b",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To be filled with disgust or abhorrence."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ab87103c-379e-4578-936d-8f74c0dce1b2",
                                "sense_id": "8c686777-3bd9-33de-9504-0b2ccc55c87b",
                                "text": "Mine eyes did sicken at the sight."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfd3e650-55e9-381d-bd11-836b33ff926f",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To become disgusting or tedious."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2122eed3-75c5-450f-b29c-00bad421c863",
                                "sense_id": "cfd3e650-55e9-381d-bd11-836b33ff926f",
                                "text": "The toiling pleasure sickens into pain."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4064162-643c-3855-92f1-b1572418b3d1",
                        "entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
                        "glosses": [
                            "To become weak; to decay; to languish."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cd768849-f537-4664-a4af-40c443410b41",
                                "sense_id": "d4064162-643c-3855-92f1-b1572418b3d1",
                                "text": "All pleasures sicken, and all glories sink."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8650bed3-3abb-435b-a595-ac16784d30ce",
                        "source_entry_id": "eaa58f4c-4c7e-3e22-8a9d-96d617ed0acb",
