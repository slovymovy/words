                "translations": [
                    {
                        "translation_id": "63a9f850-dc3b-444c-b987-de4afdbcfb69",
                        "source_entry_id": "27ba9407-fc6d-3f99-a748-4d0b8d56986c",
                        "source_sense_id": "2c3a6521-5274-3770-ab25-01556d580d5c",
