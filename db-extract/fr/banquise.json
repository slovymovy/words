        "fr-extract.jsonl": [
            {
                "entry_id": "19b913bc-3568-3ea6-a370-ad36b8b7ffa0",
                "word": "banquise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c65d618a-51a5-4373-b4d7-a35cf9b0c17d",
                        "entry_id": "19b913bc-3568-3ea6-a370-ad36b8b7ffa0",
                        "tags": [
                            "plural"
                        ],
                        "form": "banquises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                        "entry_id": "19b913bc-3568-3ea6-a370-ad36b8b7ffa0",
                        "glosses": [
                            "Amas considérable de glaces flottantes qui forment une sorte de banc et empêchent ou gênent la navigation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2c11b0-ac9b-4aea-ade6-b4d45f2e7618",
                                "sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                                "text": "Au sud, rien jusqu’à la banquise éternellement glacée du pôle austral.."
                            },
                            {
                                "example_id": "c050befe-ccea-4ef5-8f4a-da7956df2049",
                                "sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                                "text": "Cette banquise, qui couvrait plusieurs milliers de lieues carrées, stationna pendant quatre cents ans à la même place, suivant la tradition, et se rompit tout à coup en 1817; ce fut cette rupture qui détermina la fameuse expédition du capitaine Ross pour la découverte du passage du Nord-Ouest."
                            },
                            {
                                "example_id": "4d45429e-ad47-4587-b391-2ccb04da66d3",
                                "sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                                "text": "La lisière de la masse principale de la banquise […] est sinueuse et découpée par de plus ou moins vastes indentations, constituant un danger pour les navires; […]."
                            },
                            {
                                "example_id": "a83b8caf-5827-4455-bfcb-a779fb568ab6",
                                "sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                                "text": "Le 20 février 1895 à Sully-sur-Loire, l'embâcle recouvrit soixante-dix kilomètres. Des trains spéciaux furent affrétés, on vint en foule pour se promener sur la banquise ainsi formée, une buvette fut même installée malgré le danger au milieu du fleuve."
                            },
                            {
                                "example_id": "093ef217-88e0-45c3-80e6-9c85e3c0c48d",
                                "sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                                "text": "Deux scientifiques canadiens demandent au gouvernement fédéral d'accélérer ses efforts de conservation dans la partie est de l’Arctique canadien afin de sauver une partie d’une des dernières banquises qui subsistent toute l'année et les organismes qui y vivent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db88efd8-069c-4b55-942b-27e7e3e82b3c",
                        "source_entry_id": "19b913bc-3568-3ea6-a370-ad36b8b7ffa0",
                        "source_sense_id": "37258ae1-286d-366f-8cd2-4ef16477360e",
                        "target_lang_word": "Packeis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
