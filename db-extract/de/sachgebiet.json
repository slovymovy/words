                        "glosses": [
                            "Strukturelement einer formalen Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63307004-2b0d-4fde-b6ad-2f7b06297f1b",
                                "sense_id": "80ee5a55-79e0-32c6-89a3-690ce0f22f05",
                                "text": "Die Referate der Behörde gliedern sich in mehrere Sachgebiete mit jeweils klar abgegrenzter Zuständigkeit."
