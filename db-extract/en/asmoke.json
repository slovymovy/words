                        "glosses": [
                            "Smoking; giving off steam or fog."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "05738aa4-3e48-40ae-a46f-a71cfb61f3ea",
                                "sense_id": "324337c5-eed4-3419-bf73-5b9496fa0b2e",
                                "text": "It appeareth to me that even to praise one’s-self, although it be shameful, is less shameful than to throw a burning coal into the incense-box that another doth hold to waft before us, and then to snift and simper over it, with maidenly coyness, as if forsooth one had no hand in setting it asmoke."
                            },
                            {
                                "example_id": "c59569de-6f8e-46fa-8b20-be332bcd3b6e",
                                "sense_id": "324337c5-eed4-3419-bf73-5b9496fa0b2e",
                                "text": "[…] there was a smooth and shining lake, the chill waters whereof were all asmoke in the gentle warmth of the newly risen sun."
                            },
                            {
                                "example_id": "dc25e9bd-7e16-424a-b68f-4389a7c02f09",
                                "sense_id": "324337c5-eed4-3419-bf73-5b9496fa0b2e",
                                "text": "With the fall of dark the woman left him sitting gloomily asmoke on his soap-box before the fire, and went up into the van."
                            },
                            {
                                "example_id": "eb90392b-fa28-445a-acdb-d9c813b8eb66",
                                "sense_id": "324337c5-eed4-3419-bf73-5b9496fa0b2e",
                                "text": "The shrines of its gods and heroes, their altars asmoke with incense offerings, had watched over commerce and statecraft, lords and ladies, workmen and peasant farmers alike, in long and pleasant prosperity."
                            }
                        ]
                    }
