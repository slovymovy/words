                                "target_senses": [
                                    {
                                        "sense_id": "1a8822d0-b06e-3d1b-adc2-57f035cc95e9",
                                        "entry_id": "addea3ae-aac5-3f8f-8009-cb78d8090c68",
                                        "glosses": [
                                            "At fault; failing to fulfill responsibility, duty, or obligations."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d241e5c-74bc-4f0f-9794-52f5f159aa97",
                                                "sense_id": "1a8822d0-b06e-3d1b-adc2-57f035cc95e9",
                                                "text": "It would be remiss of me, in my duties, if I did not give credit where credit was due."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c583355f-3a71-3e1b-9347-9a303dcd73d8",
                                        "entry_id": "addea3ae-aac5-3f8f-8009-cb78d8090c68",
                                        "glosses": [
                                            "Not energetic or exact in duty or business; careless; tardy; slack; hence, lacking earnestness or activity; languid; slow."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2215e9e7-154f-4169-b555-1bc44ebb1875",
                                                "sense_id": "c583355f-3a71-3e1b-9347-9a303dcd73d8",
                                                "text": "Thou never waſt remiſs, I bear thee witneſs:"
                                            },
                                            {
                                                "example_id": "05ce3ea4-cbf1-4a7a-b4b6-8d0253ca7c84",
                                                "sense_id": "c583355f-3a71-3e1b-9347-9a303dcd73d8",
                                                "text": "Its motion becomes more languid and remiss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
