                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adenauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d35f858-0270-33f9-82ba-1d172be1a394",
                                        "entry_id": "5acef6b7-d95f-3ab6-a808-3e899ca3045f",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699601f7-a099-4fbb-8738-d179c52254df",
                                                "sense_id": "7d35f858-0270-33f9-82ba-1d172be1a394",
                                                "text": "Herr Adenauer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2fb9abd2-9e45-448c-a426-182544cf1fdd",
                                                "sense_id": "7d35f858-0270-33f9-82ba-1d172be1a394",
                                                "text": "Morgen sind wir bei Adenauers eingeladen."
                                            },
                                            {
                                                "example_id": "4436ee34-3be4-4d86-bd96-344b80de3ff0",
                                                "sense_id": "7d35f858-0270-33f9-82ba-1d172be1a394",
                                                "text": "Die Adenauers fliegen heute nach Südafrika."
                                            },
                                            {
                                                "example_id": "01fba6f9-7c6a-40e9-bd2f-13fa2f4fabda",
                                                "sense_id": "7d35f858-0270-33f9-82ba-1d172be1a394",
                                                "text": "Der Adenauer trägt nie die Pullover, die die Adenauer ihm strickt."
                                            },
                                            {
                                                "example_id": "f3459f8f-ce36-4c71-8f5d-f9554eeede95",
                                                "sense_id": "7d35f858-0270-33f9-82ba-1d172be1a394",
                                                "text": "„Bereits Konrad Adenauer kritisierte in seiner Weihnachtsansprache 1955 die Kommerzialisierung des Weihnachtsfests.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
