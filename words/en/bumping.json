        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60fa4584-0b05-38e1-a2ae-3300c27eb515",
                    "sense_definition": "The action or sound of hitting or colliding against something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>bumping</w> of the car woke everyone up during the road trip.",
                            "target_lang_translations": {
                                "tr": "Araba yolculuğu sırasında arabanın ani <w>sarsılması</w> herkesi uyandırdı."
                            }
                        },
                        {
                            "text": "We heard strange noises and loud <w>bumping</w> upstairs late at night.",
                            "target_lang_translations": {
                                "tr": "Gece geç saatlerde üst katta garip sesler ve yüksek bir <w>gümleme</w> duyduk."
                            }
                        }
                    ],
                    "synonyms": [
                        "thumping",
                        "knocking",
                        "banging"
                    ],
                    "common_phrases": [
                        "loud bumping",
                        "constant bumping"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye çarpma veya çarpışma eylemi ya da sesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sarsıntı",
                                "target_lang_sense_clarification": "çarpmadan kaynaklanan sallantı"
                            },
                            {
                                "target_lang_word": "gümleme",
                                "target_lang_sense_clarification": "tok çarpma sesi"
                            },
                            {
                                "target_lang_word": "tıkırtı",
                                "target_lang_sense_clarification": "sürekli çarpma veya vurma sesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "201a8d7c-b66b-3560-a028-6ccb308f6174",
                    "sense_definition": "A traditional form of rowing race where boats start at set intervals and try to catch up and touch the boat ahead.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon watching the student crews participate in <w>bumping</w>.",
                            "target_lang_translations": {
                                "tr": "Öğleden sonrasını öğrenci ekiplerinin <w>temaslı kürek yarışına</w> katılmasını izleyerek geçirdi."
                            }
                        },
                        {
                            "text": "The rules of <w>bumping</w> require quick reactions from the coxswain to avoid collisions.",
                            "target_lang_translations": {
                                "tr": "<w>Temaslı kürek yarışının</w> kuralları, çarpışmaları önlemek için dümencinin hızlı tepki vermesini gerektirir."
                            }
                        }
                    ],
                    "synonyms": [
                        "bumps race"
                    ],
                    "target_lang_definitions": {
                        "tr": "Teknelerin belirli aralıklarla başlayıp öndeki tekneye yetişip ona dokunmaya çalıştığı geleneksel bir kürek yarışı türü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kürek yarışı türü",
                                "target_lang_sense_clarification": "öndeki tekneye dokunma hedefli kürek yarışı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "626ff46d-d75a-3ba4-88bb-93742b4a45da",
                    "sense_definition": "The irregular or violent boiling of a superheated liquid causing sudden ejection of steam or liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding boiling stones to the flask prevents sudden <w>bumping</w> during distillation.",
                            "target_lang_translations": {
                                "tr": "Balona kaynama taşları eklemek, damıtma sırasında ani <w>sıçramaları</w> önler."
                            }
                        },
                        {
                            "text": "Dangerous <w>bumping</w> can occur if liquid is heated unevenly without agitation.",
                            "target_lang_translations": {
                                "tr": "Sıvı karıştırılmadan eşit olmayan şekilde ısıtılırsa tehlikeli <w>patlamalı kaynamalar</w> meydana gelebilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prevent bumping"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı ısınmış bir sıvının aniden buhar veya sıvı püskürtmesine neden olan düzensiz veya şiddetli kaynaması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ani kaynama",
                                "target_lang_sense_clarification": "kimyada sıvının patlamalı kaynaması"
                            },
                            {
                                "target_lang_word": "sıçrama",
                                "target_lang_sense_clarification": "kaynayan sıvının püskürmesi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7635f043-7f80-352f-8562-5d8998a3a178",
                    "sense_definition": "Lively, energetic, or excellent, often describing music or a social event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played a <w>bumping</w> beat that got everyone onto the dance floor immediately.",
                            "target_lang_translations": {
                                "tr": "DJ, herkesi anında dans pistine döken <w>hareketli</w> bir ritim çaldı."
                            }
                        },
                        {
                            "text": "They went to a <w>bumping</w> party downtown last Friday night.",
                            "target_lang_translations": {
                                "tr": "Geçen Cuma gecesi şehir merkezinde <w>çok canlı</w> bir partiye gittiler."
                            }
                        }
