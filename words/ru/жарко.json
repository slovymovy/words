            "senses": [
                {
                    "sense_id": "309dca4b-1883-3b3f-bbf1-48e29e159a27",
                    "sense_definition": "О высокой температуре воздуха; когда очень тепло.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом в этом регионе всегда очень <w>жарко</w>.",
                            "target_lang_translations": {
                                "en": "It is always very <w>hot</w> in this region in the summer.",
                                "de": "Im Sommer ist es in dieser Region immer sehr <w>heiß</w>."
                            }
                        },
                        {
                            "text": "Сегодня на улице так <w>жарко</w>, что хочется купаться.",
                            "target_lang_translations": {
                                "en": "It is so <w>hot</w> outside today that I want to go swimming.",
                                "de": "Heute ist es draußen so <w>heiß</w>, dass man schwimmen gehen möchte."
                            }
                        }
