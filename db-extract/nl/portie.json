                "senses": [
                    {
                        "sense_id": "929c2774-fbe2-3b06-bd27-532d4ffff0b3",
                        "entry_id": "4bad50be-c40d-3e26-9446-b0c791ef03b7",
                        "glosses": [
                            "een deel van een voorraad toebedeeld aan een bepaald persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c30cf3c-8f53-426c-a306-d5af81acec3c",
                                "sense_id": "929c2774-fbe2-3b06-bd27-532d4ffff0b3",
                                "text": "Ieder kreeg zijn portie hutspot en de hele hongerige groep begon gretig te eten."
                            },
                            {
                                "example_id": "a313fbb2-90e3-4fbd-b9aa-aee9132c0d8c",
                                "sense_id": "929c2774-fbe2-3b06-bd27-532d4ffff0b3",
                                "text": "Deze kleine porties klokten we in een noodvaart naar binnen en ik bestelde meteen een aantal nieuwe planken proefglazen voor de hele tafel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4d56638-ec71-494f-9d60-5284d91af909",
                        "source_entry_id": "4bad50be-c40d-3e26-9446-b0c791ef03b7",
                        "source_sense_id": "929c2774-fbe2-3b06-bd27-532d4ffff0b3",
                        "source_sense_description": "een deel van een voorraad toebedeeld aan een bepaald persoon",
                        "target_lang_word": "Portion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b001c97-5c7a-3385-abc5-bdfabdeaaa33",
                                        "entry_id": "b2fa07c0-cd3c-3e18-b8bc-0ad6340297f9",
                                        "glosses": [
                                            "bestimmte Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2c0421-920e-4af5-9a3a-356b5c8a1eb5",
                                                "sense_id": "8b001c97-5c7a-3385-abc5-bdfabdeaaa33",
                                                "text": "Wir geben ihnen große Portionen mit."
                                            },
                                            {
                                                "example_id": "d224b632-6e5b-48d9-a60c-afd70626dae5",
                                                "sense_id": "8b001c97-5c7a-3385-abc5-bdfabdeaaa33",
                                                "text": "„Ich kenne sehr viele krankenschwestern und krankenpfleger die in ihrem beruf mit sehr viel herzblut, geduld und einer großen portion empathie für patienten und deren angehörige arbeiten, oder es jeden tag aufs neue versuchen.“"
                                            },
                                            {
                                                "example_id": "c5108439-30c3-4db9-80e6-28836229f638",
                                                "sense_id": "8b001c97-5c7a-3385-abc5-bdfabdeaaa33",
                                                "text": "„Ich griff nach dem Vorleglöffel, um eine zweite Portion zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5281493c-2fb2-3b81-aa36-80c31239b151",
                                        "entry_id": "b2fa07c0-cd3c-3e18-b8bc-0ad6340297f9",
                                        "glosses": [
                                            "Anteil, abgemessene Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225ce2c6-ae20-488e-b257-afc1c77ee069",
                                                "sense_id": "5281493c-2fb2-3b81-aa36-80c31239b151",
                                                "text": "„Möchten Sie eine Portion Plutonium?“"
                                            },
                                            {
                                                "example_id": "546e9d19-60c9-41cd-a966-de3c52463416",
                                                "sense_id": "5281493c-2fb2-3b81-aa36-80c31239b151",
                                                "text": "„Als wir beim dritten Glas und der zweiten Portion Käse waren, winkte der Patron von der Bar her mit dem Kopf zur Tür hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42e45df3-fd14-4e68-adeb-dab0b2b68251",
                        "source_entry_id": "4bad50be-c40d-3e26-9446-b0c791ef03b7",
                        "source_sense_id": "929c2774-fbe2-3b06-bd27-532d4ffff0b3",
                        "source_sense_description": "een deel van een voorraad toebedeeld aan een bepaald persoon",
                        "target_lang_word": "portion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b89f60fa-cf2f-395f-aeaf-d1a9f6bfc3ca",
                                        "entry_id": "2b96d240-6392-3d08-bb60-c71324caa79f",
                                        "glosses": [
                                            "An allocated amount."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a254db5-30df-3762-8ba7-b44045517bb7",
                                        "entry_id": "2b96d240-6392-3d08-bb60-c71324caa79f",
                                        "glosses": [
                                            "That which is divided off or separated, as a part from a whole; a separated part of anything."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a724775a-5aa0-3007-9954-52afb2826a07",
                                        "entry_id": "2b96d240-6392-3d08-bb60-c71324caa79f",
                                        "glosses": [
                                            "One's fate; lot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "718748ef-3bcd-4128-b902-41f3d44cee9c",
                                                "sense_id": "a724775a-5aa0-3007-9954-52afb2826a07",
                                                "text": "The Lord of that ſeruant […] will appoint him his portion with the vnbeleeuers."
                                            },
                                            {
                                                "example_id": "929e76a8-709b-40bd-8ec3-396c26c7746c",
                                                "sense_id": "a724775a-5aa0-3007-9954-52afb2826a07",
                                                "text": "Man's portion is to die and rise again."
                                            },
                                            {
                                                "example_id": "675925a8-f700-4c80-a4ca-8669605ce395",
                                                "sense_id": "a724775a-5aa0-3007-9954-52afb2826a07",
                                                "text": "\"Everywhere the same!\" exclaimed Francesca, as she resumed her seat—\"the same human misery—the same human portion!..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ee0309-e912-35a1-8a8f-215e2218deca",
                                        "entry_id": "2b96d240-6392-3d08-bb60-c71324caa79f",
                                        "glosses": [
                                            "The part of an estate given or falling to a child or heir; an inheritance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd525f85-670b-4a86-8f85-c6f97d05db97",
                                                "sense_id": "50ee0309-e912-35a1-8a8f-215e2218deca",
                                                "text": "Father, giue me the portion of goods that falleth to me."
                                            },
                                            {
                                                "example_id": "9515778a-00f2-4143-b850-588e80476d54",
                                                "sense_id": "50ee0309-e912-35a1-8a8f-215e2218deca",
                                                "text": "O! yearning heart! I did inherit\nThy withering portion with the fame,\nThe searing glory which hath shone\nAmid the jewels of my throne,\nHalo of Hell!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32bd2a52-5c24-3a82-9c45-b55028af21e3",
                                        "entry_id": "2b96d240-6392-3d08-bb60-c71324caa79f",
                                        "glosses": [
                                            "A wife's fortune; a dowry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b24cd1d-0eaf-4635-bfee-bb38e7575ee8",
                                                "sense_id": "32bd2a52-5c24-3a82-9c45-b55028af21e3",
                                                "text": "Commend me to her, and to piece her portion / Tender her this."
                                            },
                                            {
                                                "example_id": "12f66655-4074-4156-9f9b-ad0c42c7b04a",
                                                "sense_id": "32bd2a52-5c24-3a82-9c45-b55028af21e3",
                                                "text": "I took part of a small house in the Old Jewry; and being advised to alter my condition, I married Mrs. Mary Burton, second daughter to Mr. Edmund Burton, hosier, in Newgate-street, with whom I received four hundred pounds for a portion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "portion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49d8aab2-8e46-3fe7-ac41-83a878d4a27e",
                                        "entry_id": "1807fa21-e736-3cf8-99f2-3197af3a8f1a",
                                        "glosses": [
                                            "To divide into amounts, as for allocation to specific purposes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b03f0bb-5245-3a10-b161-7c33c9d320a4",
                                        "entry_id": "1807fa21-e736-3cf8-99f2-3197af3a8f1a",
                                        "glosses": [
                                            "To endow with a portion or inheritance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b1e206-3501-4992-8afe-bcef52b4b3fa",
                                                "sense_id": "1b03f0bb-5245-3a10-b161-7c33c9d320a4",
                                                "text": "Him portioned maids, apprenticed orphans, blest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f9e488e-178a-41c7-b167-8ee11c167ba3",
                        "source_entry_id": "4bad50be-c40d-3e26-9446-b0c791ef03b7",
                        "source_sense_id": "929c2774-fbe2-3b06-bd27-532d4ffff0b3",
                        "source_sense_description": "een deel van een voorraad toebedeeld aan een bepaald persoon",
                        "target_lang_word": "portion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9183573-63b2-3f27-a2ad-db5aabb6a918",
                                        "entry_id": "14566af3-ee9d-399b-86e4-b48c4a1a80ca",
                                        "glosses": [
                                            "Partie d’un tout divisé, ou considéré comme tel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a83a85-725d-4c15-ad17-82f7585bedd9",
                                                "sense_id": "a9183573-63b2-3f27-a2ad-db5aabb6a918",
                                                "text": "[…], j'ai eu l'honneur de communiquer à l'Institut royal de France une note, ayant pour objet de prouver, contrairement à l'opinion généralement reçue, que le seigle ergoté perd une portion de ses propriétés toxiques par la fermentation et la cuisson panaire."
                                            },
                                            {
                                                "example_id": "50b23aab-527b-4a8d-a16c-1105ec6a51e3",
                                                "sense_id": "a9183573-63b2-3f27-a2ad-db5aabb6a918",
                                                "text": "Le conseil persiste dans l'avis qu'il a déjà émis l'année dernière, pour la réunion à la ville de Réthel d'une portion de la commune de Sault-lès-Réthel."
                                            },
                                            {
                                                "example_id": "c5ed8cab-faa3-4769-aa6e-f00baca821b7",
                                                "sense_id": "a9183573-63b2-3f27-a2ad-db5aabb6a918",
                                                "text": "Elle s’approcha sans bruit de Charles IX, qui donnait à ses chiens des fragments de gâteaux coupés en portions pareilles."
                                            },
                                            {
                                                "example_id": "a927e5d9-7123-4b86-ab03-735d87fa4411",
                                                "sense_id": "a9183573-63b2-3f27-a2ad-db5aabb6a918",
                                                "text": "Dans sa boite en carton de 12 portions, La Vache qui rit a toujours ce goût délicieux des quatre-heures qui s’écrasent dans le fond du cartable, pile sur le carnet de notes."
                                            },
                                            {
                                                "example_id": "d9135abd-d674-4417-bb1b-eed3935a13a7",
                                                "sense_id": "a9183573-63b2-3f27-a2ad-db5aabb6a918",
                                                "text": "Un mur de pierres blanches jointées en losange protégeait cette portion de trottoir des regards et servait de crottoir aux clébards du quartier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b65913d7-6b2e-3720-bb80-298b3832134d",
                                        "entry_id": "14566af3-ee9d-399b-86e4-b48c4a1a80ca",
                                        "glosses": [
                                            "Partie d’une succession attribuée à chaque héritier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7807e7a-2431-4d89-8dfd-cd03b5f00725",
                                                "sense_id": "b65913d7-6b2e-3720-bb80-298b3832134d",
                                                "text": "Les héritiers ont partagé tout le bien du défunt en quatre portions."
                                            },
                                            {
                                                "example_id": "b482e652-e0f8-4e3b-a0d1-ef017f6ddadf",
                                                "sense_id": "b65913d7-6b2e-3720-bb80-298b3832134d",
                                                "text": "Pour sa part et portion ; portion disponible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb2e5a4-9ce1-3049-b78f-0364d525c6d4",
                                        "entry_id": "14566af3-ee9d-399b-86e4-b48c4a1a80ca",
                                        "glosses": [
                                            "Quantité de pain, de viande, etc., qu’on donne, dans le repas, à chacun en particulier; surtout en parlant des collèges, des communautés religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852ea276-708c-495b-a9e7-b6e38f71f0d5",
                                                "sense_id": "dfb2e5a4-9ce1-3049-b78f-0364d525c6d4",
                                                "text": "Les petites gens du quartier venaient dîner dans cette friterie d'une portion d’anguilles à une peseta, ou de percebes, et de calmars frits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
