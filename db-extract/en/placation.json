                    {
                        "sense_id": "5393a319-1741-3fc6-8a36-17b969659a80",
                        "entry_id": "35c43260-2bee-3c01-9e2d-2d93008d287e",
                        "glosses": [
                            "A process or act of placating; appeasement or an expression of appeasement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9fa9d64d-e49c-4e51-868f-fb9aaef1ab4f",
                                "sense_id": "5393a319-1741-3fc6-8a36-17b969659a80",
                                "text": "The refusal, at certain times and seasons, of food that in itself is hygienically good and palatable, in placation of a deity, or, without further explanation, to avoid bad luck, is well known among the lower tribes of men."
                            },
                            {
                                "example_id": "a81e7186-3559-442a-85b8-f0ccc59b0a5e",
                                "sense_id": "5393a319-1741-3fc6-8a36-17b969659a80",
                                "text": "Instead, Jerry [a dog] was all placation and appeal, all softness of pleading in a body denied speech that nevertheless was articulate, from wagging tail and wriggling sides to flat-laid ears and eyes that almost spoke, to any human sensitive of understanding."
                            },
                            {
                                "example_id": "cf9da04d-9b74-4c97-af95-52d888ef6dbe",
                                "sense_id": "5393a319-1741-3fc6-8a36-17b969659a80",
                                "text": "While these political sellout artists have been intoning their mind numbing placations, citizens across the nation have been speaking and acting."
                            }
                        ]
                    }
                ],
