                "senses": [
                    {
                        "sense_id": "1a4cd54e-20c3-3a3c-b7f2-5e84f1579e7e",
                        "entry_id": "68e4ca12-6c8d-305f-a6e9-7f48fa4e88f2",
                        "glosses": [
                            "Tübinger Weingärtner"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a5c9c31f-a942-41cf-8f8b-8e28bd099134",
                                "sense_id": "1a4cd54e-20c3-3a3c-b7f2-5e84f1579e7e",
                                "text": "Nach dem Grund für die Benennung \"Raup\" gefragt gibt ein Wengerter seinem Sprössling eine ausweichende Antwort und schließt mit der Ermahnung: \"Dass Du mir aber fei nia Raup saist, Bua!\" Einige Tage später - Vater und Sohn arbeiten im Wengert - kriecht eine Schmetterlingsraupe am Ärmel des Vaters hinauf. Da ruft der Bub: \"Vater, luag au, an dir lauft e Wengerter nuf!\""
                            },
                            {
                                "example_id": "ba706f70-8e8e-4d9b-99ac-7d01843771aa",
                                "sense_id": "1a4cd54e-20c3-3a3c-b7f2-5e84f1579e7e",
                                "text": "Als Raupen werden alle Tübinger Weingärtner bezeichnet, auch wenn diese nicht in der Tübinger Unterstadt wohnen, während der Ausdruck Gôgen in der Regel untrennbar mit den Bewohnern der Unterstadt verbunden ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75434f25-aed3-4047-b8a0-ed074ccd87ed",
                        "source_entry_id": "68e4ca12-6c8d-305f-a6e9-7f48fa4e88f2",
                        "source_sense_id": "1a4cd54e-20c3-3a3c-b7f2-5e84f1579e7e",
                        "source_sense_description": "umgangssprachlich: Tübinger Weingärtner",
                        "target_lang_word": "Weingärtner",
