                        "sense_id": "06059718-7e89-38fc-80ea-08726256f9d0",
                        "entry_id": "27600c78-5a93-3e42-b137-9b30d33cf63d",
                        "glosses": [
                            "Zusammenschluss von privaten Computern, die durch ein lokales Netzwerk verbunden werden, meist zum Zweck des gemeinsamen Spielen von Computerspielen"
                        ],
                        "tags": [
                            "EDV",
                            "Netzjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "2a8e7888-6d5a-4a80-b226-eecdfe20e59d",
                                "sense_id": "06059718-7e89-38fc-80ea-08726256f9d0",
                                "text": "Wir organisieren über das Wochenende eine LAN mit verschiedenen Spielen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
