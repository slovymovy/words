                                    },
                                    {
                                        "sense_id": "10ffe8c0-d2a7-3030-9e85-707c63654547",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A ten-pence piece. So named because it is the coin most often sharpened by prison inmates to use as a weapon."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbd2accb-7070-3c3a-8d38-be1f0c630704",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A person who practices self-injury by making cuts in the flesh."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed003ae-6062-4e38-9cf7-7b3607d07b37",
                                                "sense_id": "cbd2accb-7070-3c3a-8d38-be1f0c630704",
                                                "text": "After I got out of the mental institution I was looking at t.v. show I was looking it a teenage girl who was a cutter her arm look just like my arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256f5028-38ee-35a1-bb64-f296fbd4ef2d",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A surgeon."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc82296b-961b-3c17-a530-40db743b16d1",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "An animal yielding inferior meat, with little or no external fat and marbling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71bda1e5-96ad-4c61-a71e-dfde0b9bc799",
                                                "sense_id": "fc82296b-961b-3c17-a530-40db743b16d1",
                                                "text": "Bulls and cows used for breeding, when finally sent to market, are inferior for dressed-beef production. Bulls are demanded especially for sausage and similar products. Cows are largely used as cutters and canners […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19609cdf-0242-3f65-8935-37a795ed5959",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "An officer in the exchequer who notes by cutting on the tallies the sums paid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d77280b9-e8b5-3847-abd2-575f5288a18a",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A ruffian; a bravo; a destroyer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d148ad4c-0d87-4b14-ad76-01f6ce956c52",
                                                "sense_id": "d77280b9-e8b5-3847-abd2-575f5288a18a",
                                                "text": "Martin Parker, A True Tale of Robin Hood\nSo being outlaw'd (as 'tis told), / He with a crew went forth / Of lusty cutters, bold and strong, / And robbed in the north."
                                            },
                                            {
                                                "example_id": "ed9aa5d0-2125-4589-acee-3edb51848ec8",
                                                "sense_id": "d77280b9-e8b5-3847-abd2-575f5288a18a",
                                                "text": "He's out of cash, and thou know'st by cutter's law, / We are bound to relieve one another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb1b0ef-a4c2-3a16-913c-641c883d696c",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A kind of soft yellow brick, easily cut, and used for facework."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c1e0b74-5ab8-3452-9564-0b18b1582b28",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A light sleigh drawn by one horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c51acc-1270-4314-82bd-0ee43d7ffb25",
                                                "sense_id": "8c1e0b74-5ab8-3452-9564-0b18b1582b28",
                                                "text": "Throughout much of the winter, the sled or the cutter was the vehicle of choice. Emily and Joseph had a cutter, for traveling in style in snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9391b43b-373d-367c-a157-cf00a01933e8",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A flag or similar instrument for blocking light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df94b87-c228-489a-a16c-6e7803e18899",
                                                "sense_id": "9391b43b-373d-367c-a157-cf00a01933e8",
                                                "text": "Flags and other cutters allow the DP or gaffer to throw large controlled shadows on parts of the scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d32aab-ccd2-328c-8e3f-b7ef26911db9",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A knife."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbb0a2b0-877a-3ff6-b97b-8c4d7bbe5974",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "An active child."
                                        ],
                                        "tags": [
                                            "Maine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81ad177-50a9-4d9c-bc7c-91206a83130f",
                                                "sense_id": "bbb0a2b0-877a-3ff6-b97b-8c4d7bbe5974",
                                                "text": "Late night, take a flow, tryna find the rats\nTwelve inch cutter in and out, then Imma ride them back"
                                            },
                                            {
                                                "example_id": "fedc8f0b-5cf1-4a40-a971-253f677cca31",
                                                "sense_id": "bbb0a2b0-877a-3ff6-b97b-8c4d7bbe5974",
                                                "text": "Hop out the ride with things and stuff\nBack the longest cutter, watch him cut him, [grate their neek trips?] up"
                                            },
                                            {
                                                "example_id": "3dd07c4e-46c3-44fc-85a1-ffda7b727b6f",
                                                "sense_id": "bbb0a2b0-877a-3ff6-b97b-8c4d7bbe5974",
                                                "text": "[…] swing my cutter\nGet man down if he is on my brother"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eecdba49-2edc-387e-87f0-1de7954b1bff",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A supporter of infant circumcision or female genital mutilation; pro-circumcisionist."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "146d5fe9-7bd9-355b-a912-9e7f62cf16c6",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A three-quarters facelock bulldog move in which the attacker drives the opponent's head into the mat while falling onto their back."
                                        ],
