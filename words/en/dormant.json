                    "sense_definition": "A large horizontal beam or joist used in construction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old barn was supported by a massive oak <w>dormant</w> across the ceiling.",
                            "target_lang_translations": {
                                "ru": "Старый сарай поддерживался массивным дубовым <w>лежнем</w>, проходящим через весь потолок."
