                "senses": [
                    {
                        "sense_id": "5e0d0e88-7177-379f-aec0-a9b33c3f5d53",
                        "entry_id": "b3d48228-54a5-375c-9eaf-343bc1c322f2",
                        "glosses": [
                            "прост. то же, что чуять; распознавать вкусом или обоняньем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7aea72-4b6b-496b-a274-69422c979a68",
                                "sense_id": "5e0d0e88-7177-379f-aec0-a9b33c3f5d53",
                                "text": "Теперь надоть быть погнил в углу-то, смердит, а они-то не видят, не чухают."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8a4227c-5c13-3cab-947f-2483ed075587",
                        "entry_id": "b3d48228-54a5-375c-9eaf-343bc1c322f2",
                        "glosses": [
                            "рег. выслеживать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74353759-dfb6-458b-8277-d31aaa3c111c",
                                "sense_id": "e8a4227c-5c13-3cab-947f-2483ed075587",
                                "text": "Первым делом Покровский мужик замешан вот на чем: как значит, утро забрезжилось, заря еще не занималась, ни росинки во рту нет, глаз путем не прочистил, а уж чухает: как бы дерябнуть где да как бы объегорить кого!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4da84709-7997-30cd-bf1a-fb625e75c573",
                        "entry_id": "b3d48228-54a5-375c-9eaf-343bc1c322f2",
                        "glosses": [
                            "рег. втягивать носом воздух"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d8aacc-1236-4c32-b59a-e69b4aaa64f1",
                                "sense_id": "4da84709-7997-30cd-bf1a-fb625e75c573",
                                "text": "Сидят это солдатики под скалами, притихли, как жуки в сене. Не чухнут."
                            }
                        ]
                    }
                ],
