                "senses": [
                    {
                        "sense_id": "e15cad4e-4a6c-3f66-b435-7c438767c2ab",
                        "entry_id": "97a4585c-721d-3b41-8c81-88bedc212285",
                        "glosses": [
                            "Rendre bichrome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6c7df3-cb44-4db3-8cff-41d1d456cc43",
                                "sense_id": "e15cad4e-4a6c-3f66-b435-7c438767c2ab",
                                "text": "C'est pas souvent que je fais une colo sans bichromiser et tout...(je me comprends...)"
                            },
                            {
                                "example_id": "b33e11bd-077e-457c-9f0a-2e37284c3db4",
                                "sense_id": "e15cad4e-4a6c-3f66-b435-7c438767c2ab",
                                "text": "Donc j'ai utilisée photophiltre comme je le fait souvent, soit pour bichromiser ou postériser, j'ai utilisé ce dernier outil d'où la sensation de saturation."
                            },
                            {
                                "example_id": "5803fdd4-63fb-4533-9d2c-de0d017d6883",
                                "sense_id": "e15cad4e-4a6c-3f66-b435-7c438767c2ab",
                                "text": "J'ai essayé en plus de la bichromiser légèrement."
                            }
                        ]
                    }
