                                    },
                                    {
                                        "sense_id": "0a83bdd3-1026-3e33-8f53-e61028fbb5f6",
                                        "entry_id": "1d32c8a4-8f4b-3d1e-a29e-c93722ce28c3",
                                        "glosses": [
