                ],
                "senses": [
                    {
                        "sense_id": "6fe2c211-288f-311c-96a0-f732ebceb318",
                        "entry_id": "9605c654-c022-3f72-98e3-d82783e29e8c",
                        "glosses": [
                            "Celui qui dirige une entreprise théâtrale ; celui qui s’occupe de la vie professionnelle d’un artiste ou d’un groupe d’artistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9230b26e-810c-4e61-a56a-04b5b8c948ab",
                                "sense_id": "6fe2c211-288f-311c-96a0-f732ebceb318",
                                "text": "Jamais imprésario qui veut réussir coûte que coûte ne déploya plus d’activité."
                            },
                            {
                                "example_id": "0cbb8db6-f8de-45b7-abad-5a05899cc21b",
                                "sense_id": "6fe2c211-288f-311c-96a0-f732ebceb318",
                                "text": "C’est ainsi que le seul conseil que l’on put me donner à Rabat pour me rendre à Meknès en passant par les Zemmour était de me mettre sous la protection d’un chérif qui servait d’imprésario à une troupe de musiciens et de danseuses avec laquelle il parcourait les pays berbères."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1ac988e-44e4-4d70-8a10-15d9b5f2dd6f",
                        "source_entry_id": "9605c654-c022-3f72-98e3-d82783e29e8c",
                        "source_sense_id": "6fe2c211-288f-311c-96a0-f732ebceb318",
                        "source_sense_description": "Celui qui dirige une entreprise théâtrale",
                        "target_lang_word": "Manager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d480134d-fc73-3b0f-820a-98b647bcb6e6",
                                        "entry_id": "87f89a7c-0253-3edf-9501-d6406e2d692e",
                                        "glosses": [
                                            "Person, (meist angestellte) Führungskraft, in einem Unternehmen"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f797dd1-086f-47e0-a904-0e21036d20ec",
                                                "sense_id": "d480134d-fc73-3b0f-820a-98b647bcb6e6",
                                                "text": "Zurzeit wird über die Gehälter der Manager heftig diskutiert."
                                            },
                                            {
                                                "example_id": "0917073f-dfe0-46b3-8d05-912d6ea2807c",
                                                "sense_id": "d480134d-fc73-3b0f-820a-98b647bcb6e6",
                                                "text": "„In Paris bugsierte ihn jemand in die Hände eines Managers namens Anastasie, der einen Boxstall betrieb, und dieser Manager kündigte ihn sogleich als den kanadischen Schwergewichts-Champion an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b814ce7e-92b9-3e88-ad05-201e3c77518a",
                                        "entry_id": "87f89a7c-0253-3edf-9501-d6406e2d692e",
                                        "glosses": [
                                            "Verwaltungsprogramm oder -software in der Datenverarbeitung und Informationstechnik"
                                        ],
                                        "tags": [
                                            "Software"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d77d88e1-1f4e-4efe-9733-a87ba9b896dd",
                        "source_entry_id": "9605c654-c022-3f72-98e3-d82783e29e8c",
                        "source_sense_id": "6fe2c211-288f-311c-96a0-f732ebceb318",
                        "source_sense_description": "Celui qui dirige une entreprise théâtrale",
                        "target_lang_word": "Impresario",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Impresario",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                        "entry_id": "71c46602-0ba5-31b6-a3bc-b3e7a8e0c96d",
                                        "glosses": [
                                            "Leiter einer Oper/eines Theaters et cetera"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a434ebf-416a-4f4a-80b7-2b5595c0f136",
                                                "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                                "text": "„Im Falle von Völkerschauen fängt die Werbung mit dem Renommee des Impresarios an.“"
                                            },
                                            {
                                                "example_id": "1dc587b3-5ab5-4a68-8c44-aae4c97bfb48",
                                                "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                                "text": "„Seit mehr als elf Jahren ist der 53-Jährige der Impresario der Show.“"
                                            },
                                            {
                                                "example_id": "78d375fc-b093-4d44-b419-42cf2c5da55a",
                                                "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                                "text": "„Teresa führte mich in ihr Zimmer und erzählte mir, daß sie noch vor ihrer Ankunft in Rimini den Impresario der Oper getroffen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ae709b0-56b2-3000-8eff-0bddec9e4ad1",
                                        "entry_id": "71c46602-0ba5-31b6-a3bc-b3e7a8e0c96d",
                                        "glosses": [
                                            "Agent für Musiker oder Schauspieler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce630914-3efc-4fa7-891c-3b514aa44f8e",
                                                "sense_id": "1ae709b0-56b2-3000-8eff-0bddec9e4ad1",
                                                "text": "„Als ein zugereister Impresario ihn ahnungslos engagieren wollte, drohten die anderen bei Alfs Erscheinen mit Kündigung.“"
                                            },
                                            {
                                                "example_id": "d9d03ad6-0616-482c-bcc8-94b30a6803cc",
                                                "sense_id": "1ae709b0-56b2-3000-8eff-0bddec9e4ad1",
                                                "text": "„Man hat das Gefühl, daß es noch jemanden gibt, einen Impresario, einen unsichtbaren Mann, dem alle gehorchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
