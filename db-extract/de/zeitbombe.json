                "senses": [
                    {
                        "sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                        "entry_id": "737709f8-b9ba-3f23-ab22-3d088918fcc0",
                        "glosses": [
                            "Bombe, die mit einem Zeitzünder versehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e36e4e-d1d8-42e1-8fea-361b138735a3",
                                "sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                                "text": "„Da Hitler bekanntlich abends vor jedem Jahrestag seines gescheiterten Putschversuchs vom 9. November 1923 im Münchner Bürgerbräukeller eine Rede hielt, beschloss Elser, in die Säule direkt hinter dem Rednerpult eine Zeitbombe einzubauen.“"
                            },
                            {
                                "example_id": "0ef75ef6-cf37-4a98-801c-f6f2ddbc5d40",
                                "sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                                "text": "„Weniger bekannt ist ein am 8. Dezember 1920 im rumänischen Senat verübtes Attentat mit einer Zeitbombe.“"
                            },
                            {
                                "example_id": "f583539f-5f83-4de4-add9-0c84b7bc5795",
                                "sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                                "text": "Das Attentat wurde mit einer Zeitbombe durchgeführt."
                            },
                            {
                                "example_id": "9cb67591-17a2-4321-996b-0c6c385fc4e4",
                                "sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                                "text": "„Sie legten ihnen Zeitbomben in die Autos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c64eb418-9d74-448b-912e-c91009cde6b0",
                        "source_entry_id": "737709f8-b9ba-3f23-ab22-3d088918fcc0",
                        "source_sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                        "source_sense_description": "Bombe, die mit einem Zeitzünder versehen ist",
                        "target_lang_word": "time bomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "time bomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4882140c-1dcc-35c2-973c-77a90f175eb4",
                                        "entry_id": "6a661088-1a22-324c-be0b-e77f0495d3bb",
                                        "glosses": [
                                            "A bomb that has a mechanism such that detonation can be preset to a particular time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b877982e-6d3e-45c5-8d0a-7c0e2cdf2927",
                                                "sense_id": "4882140c-1dcc-35c2-973c-77a90f175eb4",
                                                "text": "At 9.40 a.m. on Bank Holiday Monday, August 5, a ganger found what was thought to be a time bomb at a level crossing at Tempsford, near Biggleswade, Bedfordshire, […] Inside one box was a brick; the other contained the works of an old alarm clock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a87106-779e-3e24-88e5-72f8ea71aee8",
                                        "entry_id": "6a661088-1a22-324c-be0b-e77f0495d3bb",
                                        "glosses": [
                                            "A malicious program designed to perform a destructive action at a certain date or time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f01a98-ee81-4e1f-b4ef-c2501d7873d9",
                                                "sense_id": "23a87106-779e-3e24-88e5-72f8ea71aee8",
                                                "text": "Donald Gene Burleson was prosecuted on felony charges for planting a time bomb that, shortly after he was fired, deleted more than 168,000 brokerage records of USPA & IRA in Fort Worth, Texas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3285a23-7e15-368a-9d9d-7129eb47528f",
                                        "entry_id": "6a661088-1a22-324c-be0b-e77f0495d3bb",
                                        "glosses": [
                                            "A situation that threatens to have disastrous consequences at some future time."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6f2495-31ce-40c3-9260-3e588568c4e2",
                                                "sense_id": "b3285a23-7e15-368a-9d9d-7129eb47528f",
                                                "text": "The pandemic preparation timebomb detonated to devastating effect; a number of other timebombs are on the shortest of fuses. The government has now reached a state of perfect vicious cycle, when the only thing worse than the things it does are all the things it didn’t get round to doing."
                                            },
                                            {
                                                "example_id": "8893fa83-c486-4a2f-b26b-97a5129929bc",
                                                "sense_id": "b3285a23-7e15-368a-9d9d-7129eb47528f",
                                                "text": "Even so, they managed to morph the recent European parliamentary elections into a time bomb and plant it under their country’s own future."
                                            },
                                            {
                                                "example_id": "4171ac81-1ea0-4371-b4ea-dcdbdd2769df",
                                                "sense_id": "b3285a23-7e15-368a-9d9d-7129eb47528f",
                                                "text": "Someone must explain to Sunak about the time bomb ticking beneath his £1,000 loafers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88c5a436-87b5-4060-ae66-3ca5a4a15e9c",
                        "source_entry_id": "737709f8-b9ba-3f23-ab22-3d088918fcc0",
                        "source_sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                        "source_sense_description": "Bombe, die mit einem Zeitzünder versehen ist",
                        "target_lang_word": "clockwork bomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "960b84b0-c606-4791-8797-3d1e7b2984a7",
                        "source_entry_id": "737709f8-b9ba-3f23-ab22-3d088918fcc0",
                        "source_sense_id": "4b018dfb-99ed-3150-8845-5613373774d1",
                        "source_sense_description": "Bombe, die mit einem Zeitzünder versehen ist",
                        "target_lang_word": "bombe à retardement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bombe à retardement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e36144c5-e683-3367-8636-c1338701d8da",
                                        "entry_id": "9374cefe-6359-3ef0-8ea0-bd25305d4e72",
                                        "glosses": [
                                            "Engin explosif équipé d’une minuterie permettant d’en retarder le déclenchement."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db80c99e-64cf-3715-940e-53ec812ff1bb",
                                        "entry_id": "9374cefe-6359-3ef0-8ea0-bd25305d4e72",
                                        "glosses": [
                                            "Risque ou danger qui peut se déclarer à long terme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ae893f-5b9e-4a6a-87a8-2b0c02d33309",
                                                "sense_id": "db80c99e-64cf-3715-940e-53ec812ff1bb",
                                                "text": "Le déclenchement d’un incendie dans les galeries, qui mit trois jours à être maîtrisé, a précipité la fin de l’exploitation du site. Depuis, Stocamine est considéré comme une bombe à retardement : dégradation des fûts et des sacs contenant les substances dangereuses, risque d’infiltration, nature inconnue de certaines substances stockées…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67edd36e-4f31-33ac-bb48-3dda732abb97",
                                        "entry_id": "9374cefe-6359-3ef0-8ea0-bd25305d4e72",
                                        "glosses": [
                                            "Situation instable qui semble tranquille mais qui recouvre de multiples tensions qui peuvent éclater à tout moment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c2012f-7d8d-44f0-be45-e7a6303d40ff",
                                                "sense_id": "67edd36e-4f31-33ac-bb48-3dda732abb97",
                                                "text": "Le vieillard que je suis devenu a peine à se représenter le furieux malade que j’étais naguère et qui passait des nuits, non plus à combiner sa vengeance (cette bombe à retardement était déjà montée avec une minutie dont j’étais fier), mais à chercher le moyen de pouvoir en jouir."
                                            },
                                            {
                                                "example_id": "d2f4a0e2-cd91-4046-acac-cebb0fde3b9c",
                                                "sense_id": "67edd36e-4f31-33ac-bb48-3dda732abb97",
                                                "text": "Pour un responsable de centre, cité dans le rapport, la situation est une « bombe à retardement ». Plusieurs incidents ont déjà eu lieu entre les détenus."
                                            },
                                            {
                                                "example_id": "c12e487b-264f-4069-88c2-7ff170c5ccb2",
                                                "sense_id": "67edd36e-4f31-33ac-bb48-3dda732abb97",
                                                "text": "L’administration sortante laisse derrière elle, avant de partir, toute une série de bombes à retardement à l’interne bien sûr, mais aussi – on le voit mieux maintenant – à l’international."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
