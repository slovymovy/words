                                "example_id": "e9d64231-a57e-4d11-9d92-144961113cdc",
                                "sense_id": "de3a0336-6fe0-3018-968f-988d54b73462",
                                "text": "„Tscherper un Gelächttasch haar, valteri valta,",
                                "translation": "habe schon noch ein Körnlein Unschlitt, valteri valta;"
                            },
                            {
                                "example_id": "577adc10-8cf9-4b12-9344-e3c048199a34",
                                "sense_id": "de3a0336-6fe0-3018-968f-988d54b73462",
                                "text": "„Mit dem Tscherper wurde Holzeinbaue in der Grube auf Brauchbarkeit untersucht. Jeder Bergmann hatte die Pflicht, gebrochene oder beschädigte Sprossen in den hölzernen Fahrten umgehend zu reparieren.“"
                            }
                        ],
