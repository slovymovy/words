                                        "sense_id": "fcf9d7ca-9951-3bf8-9199-9a58fe4a0f3b",
                                        "entry_id": "7b35156d-dd9d-3bd7-bec1-b7c181bccbc9",
                                        "glosses": [
                                            "Qui dénote un manque de bonne foi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88961548-c406-4025-b9a3-b804a0228e11",
                                                "sense_id": "fcf9d7ca-9951-3bf8-9199-9a58fe4a0f3b",
                                                "text": "Ces derniers jugent déloyales les importations de tomates iraniennes."
