                ],
                "senses": [
                    {
                        "sense_id": "7eb20500-c0c8-3178-95c1-8c711da55b65",
                        "entry_id": "b9fa03a5-28fb-3ec7-a2be-89ccd1e5c951",
                        "glosses": [
                            "ein Klecks Schlagsahne, beispielsweise auf einem (meist heißen) Getränk oder einem Stück Kuchen"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "adaf2b90-a53f-43bb-956e-0a7d2c861492",
                                "sense_id": "7eb20500-c0c8-3178-95c1-8c711da55b65",
                                "text": "„Tipp: Die Kuchenstücke mit kleinen Sahnehäubchen und Kirschen garnieren.“"
                            },
                            {
                                "example_id": "a00d28fd-8f0e-41b4-81ea-7064757b22a7",
                                "sense_id": "7eb20500-c0c8-3178-95c1-8c711da55b65",
                                "text": "„Apfelweintörtchen sind ein Klassiker im Herbst. Unsere Törtchen sind unwiderstehlich lecker. Auf eine Schicht aus saftigen Äpfeln folgt ein leckeres Sahnehäubchen mit Tonkabohne und Kakaopulver.“"
                            },
                            {
                                "example_id": "8fe959a3-9f1d-49d7-9b82-bc45a088edde",
                                "sense_id": "7eb20500-c0c8-3178-95c1-8c711da55b65",
                                "text": "„Geschlagener Rahm zu Früchten oder auf Desserts schmeckt ausgezeichnet. Doch was passiert eigentlich genau, wenn aus flüssigem Rahm ein Sahnehäubchen entsteht?“"
                            },
                            {
                                "example_id": "42b9e02d-bfa0-44ab-87c0-e591dba32a75",
                                "sense_id": "7eb20500-c0c8-3178-95c1-8c711da55b65",
                                "text": "„Der Pharisäer ist ein Kaffeegetränk mit Rum mit einem Sahnehäubchen.“"
                            },
                            {
                                "example_id": "f73494be-8328-4e92-98f8-8ccf6592ff81",
                                "sense_id": "7eb20500-c0c8-3178-95c1-8c711da55b65",
                                "text": "„Krabbensuppe hat sich vom früheren „Arme-Leute-Essen“ zu einer beliebten Vorspeise nach Art einer Bisque entwickelt, die heute meist heiß in einer Suppentasse und mit einem Sahnehäubchen serviert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                        "entry_id": "b9fa03a5-28fb-3ec7-a2be-89ccd1e5c951",
                        "glosses": [
                            "etwas besonders Positives, was zu etwas schon existierendem Gutem noch hinzukommt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "86871fb0-ccaf-43c0-9a5d-d63598c3e37c",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "Das Sahnehäubchen bei meiner Paddeltour durch den Spreewald war der Biber in freier Wildbahn. Erst putzte er sich am Ufer und dann schwamm er direkt vor mir ins Wasser. Das hatte ich vorher noch nie gesehen."
                            },
                            {
                                "example_id": "aa262d5e-1aa0-428f-91ff-d9cb89ce90d6",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "„»Wir sind das erste Museum, das den Preis zum zweiten Mal bekommen hat. Das ist das Sahnehäubchen«, freute sich Loewy.“"
                            },
                            {
                                "example_id": "41536d9e-4cb3-4d34-8457-77cab1463930",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "[Skirennen:] „In der Stunde des ersehnten ersten Weltcup-Triumphes dachte der 28-Jährige aus Bozen jedoch auch an die schwierigen letzten Jahre zurück. «Ich habe lange auf diesen Moment gewartet. Das ist nun das Sahnehäubchen auf der Torte», erklärte Gross.“"
                            },
                            {
                                "example_id": "63c98100-83d4-44ea-8280-88823accb20d",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "[Tennis:] „Siegemund strahlte nach ihrem Erfolg. »Viertelfinale - das hört sich bombig und genial an. Alles was jetzt noch kommt, ist ein Sahnehäubchen. Was nicht heißt, dass ich keine Sahnehäubchen mag«,“ […]."
                            },
                            {
                                "example_id": "f7e1fc30-4ffd-4abf-b453-b229183772c5",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "[Fußball:] „»Es wäre großartig, wenn wir Pep mit dem Gewinn der Champions League verabschieden könnten. Das wäre das Sahnehäubchen nach der tollen Zeit, die wir gemeinsam hatten«, sagte Torjäger Robert Lewandowski.“"
                            },
                            {
                                "example_id": "2c1171e9-3e9c-432a-af23-a0c5b9dfc91e",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "„Ein Look ist immer nur das Sahnehäubchen auf dem fertig entwickelten Foto.“"
                            },
                            {
                                "example_id": "cb8495bf-0996-428e-9819-f7304bdca732",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "[Kawasaki W800:] „Als Sahnehäubchen hat ihr Motor tatsächlich eine Königswelle und ist damit der letzte Motorradmotor, der damit gebaut wird.“"
                            },
                            {
                                "example_id": "9e1362fa-e95c-4216-adf2-009584b8247a",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "„»Am Ende meiner beruflichen Tätigkeit so ein filmisches Dokument über meinen wahrscheinlich größten Fall zu bekommen, ist ein Sahnehäubchen obendrauf.«“"
                            },
                            {
                                "example_id": "44230c36-4c80-44c4-b6f7-75d3a726501b",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "„»Wir zogen die Sache wie in einem richtigen Nachtclub auf«. Als Sahnehäubchen trat zu Beginn, auf Vorschlag von Herb Cohen, die Stripperin Dewanna auf, während die Band Night Train oder das Pink Panther Theme spielte.“"
                            },
                            {
                                "example_id": "602ef04b-a153-409e-911d-4c0d77fed8e4",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "[Energiepflanze Miscanthus:] „»Ich vermute mal, dass aufgrund der Bodengüte und alles, was wir hier haben, wir so die 100 bis 120 Tonnen erreichen werden, bei den sieben Hektar. Alles andere wäre noch mal ein Sahnehäubchen.«“"
                            },
                            {
                                "example_id": "3decd97a-47e5-4491-a182-1241a6705f33",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "„Über Ostern sind die Hotels gut gebucht, auch die Gaststätten haben viele Reservierungen an den Feiertagen, sagt Hauptgeschäftsführer des Hotel- und Gaststättenverbandes, Axel Klein. »Schönes Wetter wäre da noch das Sahnehäubchen. Dann wäre Ostern perfekt«“ […]."
                            },
                            {
                                "example_id": "0708dd8b-d9fc-4f2f-898f-d816ac977926",
                                "sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                                "text": "„Was ich außerdem gerne und dankbar feststelle: Als Musiker ist man eigentlich letztlich immer \"das Sahnehäubchen\" eines Projekts. Nachdem Planung, Organisation, Aufbauten etc. schon stattgefunden haben und für alles vorgesorgt ist, kommen wir als Musiker erst am Ende (im Konzert sogar in feierlichem Rahmen) dazu und gestalten den eigentlichen Moment des Musikerlebens! Das ist ein echtes Privileg“ […]."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b2d05a9-4dd0-48fc-8d6c-f767482731b4",
                        "source_entry_id": "b9fa03a5-28fb-3ec7-a2be-89ccd1e5c951",
                        "source_sense_id": "e19573ba-ecc9-3b3f-9f53-63e6ed8f77e9",
                        "source_sense_description": "übertragen: etwas besonders Positives, was zu etwas schon existierendem Gutem noch hinzukommt",
                        "target_lang_word": "icing on the cake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icing on the cake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74ed4534-acd6-3673-a6c7-4d07f9db2515",
                                        "entry_id": "dd511445-4ee7-3f92-8ac2-2921e704c5d5",
                                        "glosses": [
                                            "Something that intensifies the appreciation of something already good (or bad in an ironic sense depending on the context)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a1dc11-5348-4f71-b9d0-3b2ab33688bd",
                                                "sense_id": "74ed4534-acd6-3673-a6c7-4d07f9db2515",
                                                "text": "We went out for dinner and dancing and the icing on the cake was when my boyfriend proposed to me as we danced."
                                            },
                                            {
                                                "example_id": "d1267de0-8d50-4f88-b759-a6ce3bba85f0",
                                                "sense_id": "74ed4534-acd6-3673-a6c7-4d07f9db2515",
                                                "text": "With such advantages as these, the superior thermal efficiency of the diesel becomes no more than the icing on the cake."
                                            },
                                            {
                                                "example_id": "31f4289e-b952-4fee-b913-15ae43408cc2",
                                                "sense_id": "74ed4534-acd6-3673-a6c7-4d07f9db2515",
                                                "text": "“I'm happy right now. I don't need to test-drive a bunch of lemons to get me there. But happily ever after? That's a trip worth taking. The pièce de résistance. The crème de la crème. The—” “The icing on the cake,” Dana said. Michelle raised her glass in a toast. “Exactly.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
