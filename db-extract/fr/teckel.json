        "fr-extract.jsonl": [
            {
                "entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                "word": "teckel",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "539acb79-f719-493a-8c71-df351747838a",
                        "entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                        "tags": [
                            "plural"
                        ],
                        "form": "teckels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                        "entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                        "glosses": [
                            "Race de chien originaire d’Allemagne, basset (chien long et court sur pattes), à poil long, ras ou dur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1788554c-db93-4a84-8ad6-71bd9378808d",
                                "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                "text": "Elle en a élevé une trentaine sur des générations, avec une préférence pour la race Pembroke, mais a aussi créé le « dorgi », croisement du corgi et du teckel."
                            },
                            {
                                "example_id": "694f7d01-4f96-44ce-9e28-ad3d25da02ef",
                                "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                "text": "Les teckels forment le groupe 4 du classement des races de chien par la société centrale canine ou SCC."
                            },
                            {
                                "example_id": "3f7c468c-d985-415d-8fb0-7bb79d9887f9",
                                "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                "text": "Votre service de table peut être accompagné des porte-couteaux aux modèles variés : cerfs, teckels ou canards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32ac4662-e2ae-448c-b694-2054ea4b7ef1",
                        "source_entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                        "source_sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                        "target_lang_word": "Dackel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dackel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                        "entry_id": "090ad0cc-cffa-32b3-82a9-21eb7043a611",
                                        "glosses": [
                                            "kleiner Hund, der traditionell zur Jagd eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393587f1-d850-4f5f-bb02-6bbeed48deee",
                                                "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                                "text": "Dackel sind beliebte Jagdhunde, weil sie wegen ihrer kurzen Beine gut in Fuchs- und Dachsbaue kriechen können."
                                            },
                                            {
                                                "example_id": "bdc64dba-f276-4702-b0f6-ce65fcc2f5d2",
                                                "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                                "text": "„Ich wollte auch einen Dackel haben, aber Mama sagte, vier Kinder seien ihr genug, da brauche sie nicht auch noch einen Köter im Haus.“"
                                            },
                                            {
                                                "example_id": "ebd446f2-54aa-46d3-b744-74de194ed556",
                                                "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                                "text": "„Mutter Helene züchtete Schäferhunde und Dackel, die in Ostpreußen Teckel genannt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a570499-6059-3226-94b4-071838e15cdb",
                                        "entry_id": "090ad0cc-cffa-32b3-82a9-21eb7043a611",
                                        "glosses": [
                                            "ein dummer, blöder Kerl"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eede2120-add5-49f8-90fc-587f5f2664dd",
                                                "sense_id": "4a570499-6059-3226-94b4-071838e15cdb",
                                                "text": "Ach, du bist eben ein Dackel!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26e2d2cb-a17d-420f-94bf-18664068a3e5",
                        "source_entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                        "source_sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                        "target_lang_word": "Dachshund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dachshund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6978f6-2108-317a-953f-3b56b53836ea",
                                        "entry_id": "f0386bb2-18f2-3f66-9595-e76536d04e9f",
                                        "glosses": [
                                            "Hunderasse mit einer niederen Statur und einem langen, schmalen Leib, der traditionell zur Jagd eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e5d6e07-d7af-4e39-85ae-b45fa377f5ae",
                                                "sense_id": "2c6978f6-2108-317a-953f-3b56b53836ea",
                                                "text": "Ich beschäftige mich seit zwei Tagen viel mit der Erziehung zweier Dachshunde, die ich Waldmann und Waldine nenne."
                                            },
                                            {
                                                "example_id": "daa3afa4-25b8-41d4-9084-b12c244a13b9",
                                                "sense_id": "2c6978f6-2108-317a-953f-3b56b53836ea",
                                                "text": "„Von irgendwoher tauchte ein Dachshund auf und schnupperte herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "efc73fb2-befe-3d4a-91d1-53f483cce8f5",
                                        "entry_id": "f0386bb2-18f2-3f66-9595-e76536d04e9f",
                                        "glosses": [
                                            "Plural: Dachshunde: die Gruppe der Dachshunde; Gruppe 4 in der Rassesystematik der FCI"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e93bb7bd-0b2a-3647-9eab-17d8becd1a94",
                                        "entry_id": "f0386bb2-18f2-3f66-9595-e76536d04e9f",
                                        "glosses": [
                                            "historische Nutzungsgruppe von Jagdhunden zur Jagd auf Dachse, Füchse, Kaninchen, möglicherweise auch Biber und Fischotter"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5feeb295-fc31-41e7-8300-85d5fc26c039",
                                                "sense_id": "e93bb7bd-0b2a-3647-9eab-17d8becd1a94",
                                                "text": "Dachshunde hatten vorzugsweise eine niedere Statur und einen langen, schmalen Leib, um in die Bauten kriechen zu können. Oder sie waren große Hunde und konnten den Bau aufgraben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf8ef20a-ff87-4bfe-a395-9836ac3eea3f",
                        "source_entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                        "source_sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                        "target_lang_word": "dachshund",
