            {
                "entry_id": "78693248-bab6-3007-ade5-6163c2894bee",
                "word": "pilotage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ffa70c2-8f40-4c82-9cdd-e27443a94997",
                        "entry_id": "78693248-bab6-3007-ade5-6163c2894bee",
                        "tags": [
                            "plural"
                        ],
                        "form": "pilotages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fea7c06-a34e-3731-a3a4-14b11d589620",
                        "entry_id": "78693248-bab6-3007-ade5-6163c2894bee",
                        "glosses": [
                            "Art de conduire un vaisseau, un avion ou un dirigeable; connaissance en mathématique suffisante pour relever et tracer la marche d’un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7fdc538-8b24-452b-a6d1-118dde7fb569",
                                "sense_id": "0fea7c06-a34e-3731-a3a4-14b11d589620",
                                "text": "Il y a des écoles où l’on enseigne le pilotage."
                            },
                            {
                                "example_id": "3034380d-e7f7-4885-988d-107a4fd36a7e",
                                "sense_id": "0fea7c06-a34e-3731-a3a4-14b11d589620",
                                "text": "Cours de pilotage."
                            }
                        ]
                    },
                    {
                        "sense_id": "44b89fbf-e3a2-3fe8-848f-07c05911158c",
                        "entry_id": "78693248-bab6-3007-ade5-6163c2894bee",
                        "glosses": [
                            "Action de conduire un vaisseau à l’entrée ou à la sortie d’un port."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e25754-1d31-400c-a837-d6c405abc18b",
                                "sense_id": "44b89fbf-e3a2-3fe8-848f-07c05911158c",
                                "text": "Payer tant pour le pilotage d’un bâtiment."
                            },
                            {
                                "example_id": "dd45b5ec-9167-4bb9-aa41-65445f7d4f75",
                                "sense_id": "44b89fbf-e3a2-3fe8-848f-07c05911158c",
                                "text": "Droit de pilotage."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ef75e88-49ae-3233-9a7a-a5fa7acb30a9",
                        "entry_id": "78693248-bab6-3007-ade5-6163c2894bee",
                        "glosses": [
                            "Action de diriger, d’administrer, une collectivité, une entreprise, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cea4de3d-0d1b-4544-a789-05fae50f7226",
                                "sense_id": "6ef75e88-49ae-3233-9a7a-a5fa7acb30a9",
                                "text": "Le pilotage des entreprises dépend de l’intégration de leurs stratégies et des technologies de l’information et de la communication."
                            },
                            {
                                "example_id": "03a820b3-4758-4153-9c0f-5f466ddb32fb",
                                "sense_id": "6ef75e88-49ae-3233-9a7a-a5fa7acb30a9",
                                "text": "Le financement d’un agent en charge du suivi et du pilotage du contrat est aussi proposé, à hauteur de 30 % de son salaire brut."
                            }
                        ]
                    },
                    {
                        "sense_id": "21b04a30-002e-3d2d-a355-00404bf5e3fa",
                        "entry_id": "78693248-bab6-3007-ade5-6163c2894bee",
                        "glosses": [
                            "Ensemble des opérations de commande et de contrôle d’un réacteur nucléaire."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": []
                    }
                ],
