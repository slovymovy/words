{
    "word_family": [
        "tooter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c912b321-0ec1-3098-80c4-d383405a2df9",
                    "sense_definition": "The short, sharp sound made by a horn or whistle.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver gave a quick <w>toot</w> of the horn to warn the pedestrian.",
                            "target_lang_translations": {
                                "cs": "Řidič krátce <w>zatroubil</w>, aby varoval chodce."
                            }
                        },
                        {
                            "text": "I heard a loud <w>toot</w> from the train whistle as it left the station.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem hlasité <w>zahoukání</w> vlakové píšťalky, když vlak opouštěl stanici."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horn toot"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátký, ostrý zvuk vydávaný klaksonem nebo píšťalkou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zatroubení",
                                "target_lang_sense_clarification": "zvuk klaksonu"
                            },
                            {
                                "target_lang_word": "zahoukání",
                                "target_lang_sense_clarification": "zvuk píšťalky nebo sirény"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efce8a78-782a-3798-86c1-545ed7efb061",
                    "sense_definition": "Worthless items or rubbish.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rubbish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent all his money on a pile of old <w>toot</w> at the flea market.",
                            "target_lang_translations": {
                                "cs": "Utratil všechny své peníze za hromadu starého <w>harampádí</w> na bleším trhu."
                            }
                        },
                        {
                            "text": "Don't buy that cheap <w>toot</w> because it will break within a week.",
                            "target_lang_translations": {
                                "cs": "Nekupuj ty levné <w>krámy</w>, protože se do týdne rozbijí."
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "junk",
                        "trash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal British English usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Bezcenné věci nebo harampádí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "harampádí",
                                "target_lang_sense_clarification": "staré, nepotřebné věci"
                            },
                            {
                                "target_lang_word": "krámy",
                                "target_lang_sense_clarification": "nekvalitní nebo nepotřebné předměty"
                            },
                            {
                                "target_lang_word": "odpad",
                                "target_lang_sense_clarification": "věci bez hodnoty"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17e1e09c-91a6-3b41-b403-805ac3ef1d0d",
                    "sense_definition": "To make a short, sharp sound using a horn or whistle.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>toot</w> the horn when you arrive at the house.",
                            "target_lang_translations": {
                                "cs": "Prosím, <w>zatrub</w>, až přijedeš k domu."
                            }
                        },
                        {
                            "text": "The train <w>tooted</w> as it approached the busy crossing.",
                            "target_lang_translations": {
                                "cs": "Vlak <w>zahoukal</w>, když se blížil k rušnému přejezdu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toot the horn"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydat krátký, ostrý zvuk pomocí klaksonu nebo píšťalky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zatroubit",
                                "target_lang_sense_clarification": "použít klakson"
                            },
                            {
                                "target_lang_word": "zahoukat",
                                "target_lang_sense_clarification": "použít píšťalku nebo sirénu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}