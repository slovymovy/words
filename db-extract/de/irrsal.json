                                        "sense_id": "614d27a2-e572-3cc5-856a-66c1dfb1da38",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "Il se prend quelquefois, au pluriel, pour dérèglement dans les mœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "480dfe44-3769-4f1b-aae9-0e09b3906128",
                                                "sense_id": "614d27a2-e572-3cc5-856a-66c1dfb1da38",
                                                "text": "Les folles erreurs de la jeunesse."
                                            },
                                            {
                                                "example_id": "983e8c07-a722-4627-9759-ae73574a4aa6",
                                                "sense_id": "614d27a2-e572-3cc5-856a-66c1dfb1da38",
                                                "text": "Il est bien revenu de ses erreurs."
                                            },
                                            {
                                                "example_id": "1f1d7d2a-3b63-45c5-aae0-9a9b63e2e175",
                                                "sense_id": "614d27a2-e572-3cc5-856a-66c1dfb1da38",
                                                "text": "Il est honteux de ses erreurs passées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94b9e78-442c-32f9-8912-5d2e61359769",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "Différence entre la valeur exacte et la valeur mesurée, calculée ou estimée."
