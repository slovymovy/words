                "senses": [
                    {
                        "sense_id": "720e19c8-f580-3e5e-8f41-9f2b44d9f27d",
                        "entry_id": "78cc7255-e340-3137-9743-39830fae922c",
                        "glosses": [
                            "Schiff, das für einen speziellen Zweck gebaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73fc3947-1596-48ba-9365-3562b99d5acd",
                                "sense_id": "720e19c8-f580-3e5e-8f41-9f2b44d9f27d",
                                "text": "„Ankerlieger, manövrierunfähige Schiffe, Schlepper und Spezialschiffe müssen besondere Lichter zeigen.“"
                            },
                            {
                                "example_id": "33cc9859-2487-433d-8cf0-e0438c765096",
                                "sense_id": "720e19c8-f580-3e5e-8f41-9f2b44d9f27d",
                                "text": "„Bis 1989, von Großbritannien bis 1992, wurden Dünnsäuren von den Nordseeanrainerstaaten mit Spezialschiffen in den Nordostatlantik eingebracht.“"
                            },
                            {
                                "example_id": "64c2b1a8-d4aa-4856-adf1-955edd3be109",
                                "sense_id": "720e19c8-f580-3e5e-8f41-9f2b44d9f27d",
                                "text": "„Containerverkehr erfolgt durch Eisenbahn, Sattelschlepper-LKWs und Spezialschiffe.“"
                            },
                            {
                                "example_id": "0b695476-2e58-4de8-a048-c93312521a03",
                                "sense_id": "720e19c8-f580-3e5e-8f41-9f2b44d9f27d",
                                "text": "„Heute werden im Allgemeinen zwei Haupttypen unterschieden: 1. die mit Waffen bestückten Kampfschiffe; 2. Spezialschiffe, zu denen Landungsschiffe, Werkstattschiffe u. a. zählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
