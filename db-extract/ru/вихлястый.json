                "senses": [
                    {
                        "sense_id": "305d07dc-ccd9-33c4-b478-b058767e5031",
                        "entry_id": "4030d932-b438-3d7d-bac5-ed2bbc7b3773",
                        "glosses": [
                            "прост. такой, который вихляет, двигается нетвёрдой походкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ab9f4f-5f20-490b-950d-e0d175c6b817",
                                "sense_id": "305d07dc-ccd9-33c4-b478-b058767e5031",
                                "text": "Со стороны прииска к балагану Зайца с песнями валила пьяная ватага, между которыми издали выделялась вихлястая фигура беспутного Никитки…"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a52a980-7c7c-3841-8990-7a6ba99e3965",
                        "entry_id": "4030d932-b438-3d7d-bac5-ed2bbc7b3773",
                        "glosses": [
                            "прост. извилистый (о тропе, дороге)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad41a906-6f4c-48d8-afa7-d314e91a7ae7",
                                "sense_id": "5a52a980-7c7c-3841-8990-7a6ba99e3965",
                                "text": "Вихлястая дорога пересекла берёзовую заросль и вынесла казаков на усыпанную полевыми цветами луговину."
                            }
                        ]
                    }
