                            },
                            {
                                "target_lang_word": "slammer",
                                "target_lang_sense_clarification": "slang for prison"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b2cc737-1ce4-36e4-b68a-7650a5f61029",
                    "sense_definition": "Korpus aparatu fotograficznego, do którego mocuje się wymienny obiektyw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "camera_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem nową <w>puszkę</w>, ale nadal używam moich starych obiektywów.",
                            "target_lang_translations": {
                                "ru": "Я купил новую <w>тушку</w>, но по-прежнему использую свои старые объективы.",
                                "en": "I bought a new camera <w>body</w>, but I'm still using my old lenses."
                            }
                        },
                        {
                            "text": "Ta profesjonalna <w>puszka</w> jest uszczelniona i odporna na deszcz.",
                            "target_lang_translations": {
                                "ru": "Эта профессиональная <w>тушка</w> герметична и устойчива к дождю.",
                                "en": "This professional camera <w>body</w> is weather-sealed and rain-resistant."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pełnoklatkowa puszka",
                        "puszka i obiektyw"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "fotograficzny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корпус фотоаппарата, к которому крепится сменный объектив.",
                        "en": "The body of a camera to which an interchangeable lens is attached."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тушка",
                                "target_lang_sense_clarification": "фотосленг"
                            },
                            {
                                "target_lang_word": "боди",
                                "target_lang_sense_clarification": "профессиональный сленг"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "camera body",
                                "target_lang_sense_clarification": "camera without lens"
                            },
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "photography shorthand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca5ac4f-979b-3a4b-a137-4eb0f7fd4258",
                    "sense_definition": "Naczynie liturgiczne w kościele katolickim służące do przechowywania konsekrowanych hostii.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liturgical_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ksiądz wyjął z tabernakulum złotą <w>puszkę</w> z komunikantami.",
                            "target_lang_translations": {
                                "ru": "Священник достал из дарохранительницы золотой <w>циборий</w> с гостиями.",
                                "en": "The priest took the golden <w>ciborium</w> containing the communion hosts out of the tabernacle."
                            }
                        },
                        {
                            "text": "Po komunii świętej pusta <w>puszka</w> została schowana do zakrystii.",
                            "target_lang_translations": {
                                "ru": "После причастия пустая <w>чаша</w> была убрана в ризницу.",
                                "en": "After Holy Communion, the empty <w>ciborium</w> was put away into the sacristy."
                            }
                        }
                    ],
                    "synonyms": [
                        "cyborium"
                    ],
                    "common_phrases": [
                        "złota puszka",
                        "puszka z hostiami"
                    ],
                    "target_lang_definitions": {
                        "ru": "Литургический сосуд в католической церкви, служащий для хранения освященных гостий.",
                        "en": "A liturgical vessel in the Catholic Church used for holding consecrated hosts."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "циборий",
                                "target_lang_sense_clarification": "церковное"
                            },
                            {
                                "target_lang_word": "дароносица",
                                "target_lang_sense_clarification": "переносной сосуд"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ciborium",
                                "target_lang_sense_clarification": "vessel for consecrated hosts"
                            },
                            {
                                "target_lang_word": "pyx",
                                "target_lang_sense_clarification": "small container for consecrated host"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "488e13e6-e587-3545-ae08-cd53131d62e8",
                    "sense_definition": "Część sporofitu mszaków (zarodnia), w której powstają zarodniki.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na szczycie cienkiej łodyżki mchu znajduje się <w>puszka</w> z zarodnikami.",
                            "target_lang_translations": {
                                "ru": "На верхушке тонкого стебелька мха находится <w>коробочка</w> со спорами.",
                                "en": "At the top of the moss's thin stalk sits a spore <w>capsule</w>."
                            }
                        },
                        {
                            "text": "Dojrzała <w>puszka</w> pęka, uwalniając zarodniki na wiatr.",
                            "target_lang_translations": {
                                "ru": "Зрелая <w>коробочка</w> лопается, высвобождая споры на ветер.",
                                "en": "The ripe <w>capsule</w> bursts open, releasing spores into the wind."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puszka mchu",
                        "zarodniki w puszce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть спорофита мхов (спорангий), в которой образуются споры.",
                        "en": "The part of a bryophyte sporophyte (sporangium) where spores develop."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коробочка",
                                "target_lang_sense_clarification": "ботаника"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "capsule",
                                "target_lang_sense_clarification": "botany, sporangium of mosses"
                            },
                            {
                                "target_lang_word": "sporangium",
                                "target_lang_sense_clarification": "botanical structure producing spores"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4ebc286-0092-317f-8423-c26a668a5da5",
                    "sense_definition": "Dawne określenie działa, armaty lub innej broni palnej.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Huk wystrzałów ze starej <w>puszki</w> przestraszył konie rycerzy.",
                            "target_lang_translations": {
                                "ru": "Грохот выстрелов из старой <w>пушки</w> напугал рыцарских коней.",
                                "en": "The roar of gunfire from the old <w>cannon</w> frightened the knights' horses."
                            }
                        },
                        {
                            "text": "Na murach obronnych zamku ustawiono ciężkie <w>puszki</w>.",
                            "target_lang_translations": {
                                "ru": "На крепостных стенах установили тяжелые <w>пушки</w>.",
                                "en": "Heavy <w>cannons</w> were positioned along the castle's defensive walls."
                            }
                        }
                    ],
