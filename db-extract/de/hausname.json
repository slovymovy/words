                        ],
                        "form": "die Hausnamen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e1b8a3a-754f-3d69-b6e8-977d77e01cde",
                        "entry_id": "75e24e7b-ba55-3813-bafa-84af2ebade5c",
                        "glosses": [
                            "Bezeichnung des Ortes der kleinsten Siedlungseinheit vor allem im ländlichen Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3092f152-d09c-4900-9283-f71b2c564047",
                                "sense_id": "1e1b8a3a-754f-3d69-b6e8-977d77e01cde",
                                "text": "Dann kam die Zeit, wo der beliebteste Hausname zum Familien-, zum Geschlechtsnamen ward, etwa in der Mitte des 13. Jahrhunderts."
                            },
                            {
                                "example_id": "39fe8a6e-5135-4109-a47c-7ce3d2875e2d",
                                "sense_id": "1e1b8a3a-754f-3d69-b6e8-977d77e01cde",
                                "text": "Die Hausnamen ihrerseits wirkten auf die Ausformung der Familien- und der mittelalterlichen Straßennamen ein."
                            },
                            {
                                "example_id": "a5b20f76-d310-4980-8c83-e097143434d0",
                                "sense_id": "1e1b8a3a-754f-3d69-b6e8-977d77e01cde",
                                "text": "„Stattdessen werden verschiedene Personen, die den gleichen Namen tragen, durch Beinamen, Hausnamen und andere Bezeichnungen voneinander unterschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bed8ccf5-d063-3718-bb19-efa1976ed45a",
                        "entry_id": "75e24e7b-ba55-3813-bafa-84af2ebade5c",
                        "glosses": [
                            "von [1] auf die Bewohner des Anwesens übergegangener Wohnstättenname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b2547e-3395-4b48-a15b-30ab28f92751",
                                "sense_id": "bed8ccf5-d063-3718-bb19-efa1976ed45a",
                                "text": "Die Mosers, die jeder nur unter ihrem Hausnamen Bichler kannte, waren auch beim Dorffest."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "13b09e62-a874-30a7-af6f-160638baa7b4",
                        "entry_id": "75e24e7b-ba55-3813-bafa-84af2ebade5c",
                        "glosses": [
                            "Name eines öffentlichen oder privaten Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f544fb6f-5937-4f83-9df6-f25282b4df0e",
                                "sense_id": "13b09e62-a874-30a7-af6f-160638baa7b4",
                                "text": "Amerikahaus ist ein bekannter Hausname in München."
                            },
                            {
                                "example_id": "1d4a9075-2375-44eb-9dd0-2c4569b1bbc0",
                                "sense_id": "13b09e62-a874-30a7-af6f-160638baa7b4",
                                "text": "„Wie sehr die exotischen Tiere die Phantasie unserer Bürger erregten, zeigen folgende Hausnamen: «Elephant» (Kirchgasse 3, 1425), «Leopard» (Strehlgasse 12/14, 1357), «Panther» (Schoffelgasse 6, 1401), «Meerkatze» (Untere Zäune 3, 1408) und schließlich das Kamel oder «Kämbel» (Niederdorfstraße 1, 1357, und Münsterhof 18, 1455).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
