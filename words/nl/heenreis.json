                    "frequency": "Middle",
                    "semantic_group_id": "reizen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de <w>heenreis</w> naar Frankrijk hebben we een nacht in een hotel in België geslapen.",
                            "target_lang_translations": {
                                "en": "During the <w>outward journey</w> to France, we spent a night in a hotel in Belgium.",
                                "ru": "Во время <w>пути туда</w>, во Францию, мы переночевали в отеле в Бельгии."
                            }
                        },
                        {
                            "text": "De <w>heenreis</w> verliep voorspoedig, maar op de weg terug hadden we veel last van files.",
                            "target_lang_translations": {
                                "en": "The <w>trip there</w> went smoothly, but on the way back we suffered a lot from traffic jams.",
                                "ru": "<w>Поездка туда</w> прошла успешно, но на обратном пути мы сильно страдали от пробок."
                            }
                        }
                    ],
