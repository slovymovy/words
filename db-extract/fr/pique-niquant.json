                "senses": [
                    {
                        "sense_id": "d9d118b0-b990-3762-b4a0-ca9cfeb2b7c8",
                        "entry_id": "9361d723-cd4a-33c8-a91a-40151189af31",
                        "glosses": [
                            "Qui pique-nique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b4367f-377d-4cfb-8a32-1253e2714075",
                                "sense_id": "d9d118b0-b990-3762-b4a0-ca9cfeb2b7c8",
                                "text": "Les paysans qui moissonnaient se retrouvaient le dimanche transformés en acteurs pour des familles pique-niquantes, étonnées du spectacle."
                            },
                            {
                                "example_id": "331870ce-e0ea-4df9-9a42-6c7768315c9d",
                                "sense_id": "d9d118b0-b990-3762-b4a0-ca9cfeb2b7c8",
                                "text": "Le lieu de drague qu’a déjà pratiqué Philippe, un grand carré défriché, à droite en entrant dans le bois, et qui paraît-il est très actif pendant la semaine, entre midi et deux heures, très visité à ces heures-là par les lycéens et les jeunes cadres des environs, se trouve en fait, quand nous y arrivons, envahi de familles pique-niquantes, malgré la présence résistante de deux ou trois groupes de pédés vieillissants et désemparés, comiques, touchants mais assez peu réjouissants pour l’œil, pour l’âme et pour les reins."
                            },
                            {
                                "example_id": "1c11445f-a6ac-4c78-a09e-f1ce60dc85f2",
                                "sense_id": "d9d118b0-b990-3762-b4a0-ca9cfeb2b7c8",
                                "text": "Bientôt, les grands anthropoïdes campants et pique-niquants pourraient déambuler dans les campagnes avec leurs images chantantes et gigotantes."
                            }
                        ]
                    }
