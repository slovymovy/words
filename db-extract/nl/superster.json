                "senses": [
                    {
                        "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                        "entry_id": "54ace890-4ccc-3cac-b2db-23677b34a950",
                        "glosses": [
                            "iemand die buitengewoon beroemd en populair is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "500560a9-d181-4f47-8ca6-cd1910736bc4",
                                "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                "text": "Voetballers en artiesten voelen zich soms eerder een superster dan ze in werkelijk zijn."
                            },
                            {
                                "example_id": "3cd4f435-bb0f-499b-ad37-898c6f0b393c",
                                "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                "text": "Als er supersterren bestaan, dan is Johan Cruijff er zeker één van."
                            },
                            {
                                "example_id": "ddfb86ec-6ad3-4384-8b9b-f44e85f5d3c2",
                                "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                "text": "In het begin van het jaar werd een zangeres in de tienerleeftijd die Carola heette van de ene dag op de andere een superster toen ze het Nationale Songfestival won. Het was een doorbraak die exceptioneel veel aandacht trok. Vanzelfsprekend werd ze daarmee ook een van de vaste gespreksonderwerpen van het land. Dat was ook zo onder de strafpleiters, deze jonge Carola was werkelijk onweerstaanbaar."
                            }
                        ]
                    }
