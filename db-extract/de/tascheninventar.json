                ],
                "senses": [
                    {
                        "sense_id": "5b935fd0-15a1-31db-90d1-87042dc7ee9f",
                        "entry_id": "872a3e72-3031-3ac1-9e34-3767ed1d4488",
                        "glosses": [
                            "Gesamtheit der Gegenstände, die sich in einer Tasche befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84aeec0c-4e42-443e-ba63-3cf1f00719ae",
                                "sense_id": "5b935fd0-15a1-31db-90d1-87042dc7ee9f",
                                "text": "„Außerdem lag eine Bonbondose in ihrer Tasche, Pole lachte immer darüber und behauptete, das sei das typische Tascheninventar eines alternden Adelsfräuleins.“"
                            },
                            {
                                "example_id": "964e65ac-dc30-4557-903e-9a3c5b829b5c",
                                "sense_id": "5b935fd0-15a1-31db-90d1-87042dc7ee9f",
                                "text": "„Diese Prozedur war für mich schon recht peinlich, da zum Tascheninventar grundsätzlich auch noch ein Schnuller gehörte, den ich natürlich als Letztes ans Tageslicht brachte.“"
                            },
                            {
                                "example_id": "88db23ea-b3a1-45ab-960f-031f8b9469a1",
                                "sense_id": "5b935fd0-15a1-31db-90d1-87042dc7ee9f",
                                "text": "„Kurz vor 23 Uhr schießt die Meldung auf das Digitaldisplay, das für die Männer der Freiwilligen Feuerwehr um Kommandant Edgar Schiesel zum Tascheninventar gehört.“"
                            },
                            {
                                "example_id": "8339a2c9-3923-473d-8d83-4af7412a9cc3",
                                "sense_id": "5b935fd0-15a1-31db-90d1-87042dc7ee9f",
                                "text": "„Bälle, „Sharpies“, Feuchttücher: Nützliches und sinnloses Tascheninventar auf der Runde. Eine humorige Bestandsaufnahme.“"
                            },
                            {
                                "example_id": "ff801ce6-f878-4f77-86bf-60d6211708e2",
                                "sense_id": "5b935fd0-15a1-31db-90d1-87042dc7ee9f",
                                "text": "„Ziemlich erschöpft, bis auf die Haut durchnäßt und unter Verlust fast meines ganzen Tascheninventars, des Hutes und des Riesenprügels, der bei der letzten Abfahrt in den Schnee schoß und verschwand,erreichte ich abends spät den Feldberger Hof.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
