                "translations": [
                    {
                        "translation_id": "0012a5a7-c2a6-4c2c-83be-909f598a713d",
                        "source_entry_id": "137c57cd-5ddb-35f4-adb8-12639e0f90ea",
                        "source_sense_id": "c841409c-04c8-3aa5-8278-e91cee803b0d",
                        "source_sense_description": "Literatur, Film: nichterzählender Charakter, Handlungslosigkeit",
                        "target_lang_word": "nichterzählender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64e4ddbd-d521-4e70-8db2-d85bf2c42c2a",
                        "source_entry_id": "137c57cd-5ddb-35f4-adb8-12639e0f90ea",
                        "source_sense_id": "c841409c-04c8-3aa5-8278-e91cee803b0d",
                        "source_sense_description": "Literatur, Film: nichterzählender Charakter, Handlungslosigkeit",
                        "target_lang_word": "Charakter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charakter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "227f8484-a21a-3f12-900b-72e427216c66",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "Gesamtheit der angeborenen und anerzogenen, geistig-seelischen Eigenschaften eines Menschen (Charaktereigenschaften)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76eaa5c-a627-4b01-aa3c-82f30b0658f3",
                                                "sense_id": "227f8484-a21a-3f12-900b-72e427216c66",
                                                "text": "„Wird der Charakter von der Umwelt geprägt?“"
                                            },
                                            {
                                                "example_id": "02f58788-11ba-469f-8365-9d34391b10d3",
                                                "sense_id": "227f8484-a21a-3f12-900b-72e427216c66",
                                                "text": "„Oft verraten ja die kleinen Dinge sehr viel über das Wesen, den Charakter und alles.“"
                                            },
                                            {
                                                "example_id": "3d030199-4103-4ef8-b32b-67b096a1682f",
                                                "sense_id": "227f8484-a21a-3f12-900b-72e427216c66",
                                                "text": "„Ziel von Challenges ist Aufmerksamkeit, die von Mutproben Überwindung. Damit bilden Challenges anders als Mutproben nicht den Charakter, sondern höchstens Verletzungen und Fan-Community.“"
                                            },
                                            {
                                                "example_id": "11b1cb9c-c3ae-46ae-940a-8333b1d03fd6",
                                                "sense_id": "227f8484-a21a-3f12-900b-72e427216c66",
                                                "text": "[Über die Kanzlerkandidatin Annalena Baerbock 2021:] „Über Baerbocks Charakter zu diskutieren ist einfacher als über das deutsche CO2-Budget.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e5a1e25c-307b-3d19-8b6b-6fa5e2a4352d",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "Merkmal, charakteristische Eigenart"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f251fc-5df1-4085-a6c2-2762b6f3aa96",
                                                "sense_id": "e5a1e25c-307b-3d19-8b6b-6fa5e2a4352d",
                                                "text": "„Auch eine Messerspitze Curry bekommt ihm gut. Es sollte einen süßsäuerlichen Charakter haben und zum Pur-Essen viel zu scharf sein. Aber, das merkt der kundige Koch sehr schnell, es passt nicht nur zur Gemüseplatte.“"
                                            },
                                            {
                                                "example_id": "8ca16f2c-5818-419a-85ab-8dea94a28887",
                                                "sense_id": "e5a1e25c-307b-3d19-8b6b-6fa5e2a4352d",
                                                "text": "„Das Meer war Karthagos Element und die Flotte seine Lebensader. Der maritime Charakter der Stadt hatte ihre Öffnung nach allen Seiten hin begünstigt.“"
                                            },
                                            {
                                                "example_id": "26be20d6-ee5b-412f-a742-54af2213dbca",
                                                "sense_id": "e5a1e25c-307b-3d19-8b6b-6fa5e2a4352d",
                                                "text": "„Dieser Neubau war das Haus, das jetzt noch stand. Es hatte denselben nüchternen Charakter wie fast alles, was unter dem Soldatenkönig entstand, und war nichts weiter als ein einfaches Corps de logis, dessen zwei vorspringende, bis dicht an den Graben reichende Seitenflügel ein Hufeisen und innerhalb desselben einen kahlen Vorhof bildeten, auf dem, als einziges Schmuckstück, eine große blanke Glaskugel sich präsentierte.“"
                                            },
                                            {
                                                "example_id": "a31610a2-d7b3-48a8-a831-6c303aeaefe9",
                                                "sense_id": "e5a1e25c-307b-3d19-8b6b-6fa5e2a4352d",
                                                "text": "„Es muss noch der Charakter der wechselseitigen Korrespondenz bestimmt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4f6f7022-af20-3f17-be23-4419318dd4f6",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "eine Zahl als Homomorphismus in den Grundkörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c8a571-c7ea-4e14-ab50-4323f5db40d4",
                                                "sense_id": "4f6f7022-af20-3f17-be23-4419318dd4f6",
                                                "text": "„Charaktere, die konstant sind, deren Bilder also immer 1 sind, heißen trivial, alle anderen nichttrivial.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eba047dc-d6e5-3358-842e-08263e37e0d7",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "Rolle, die einen besonders ausgeprägten Charakter ^([2]) aufweist"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e4a849-58d8-4edc-b709-f51586a25e84",
                                                "sense_id": "eba047dc-d6e5-3358-842e-08263e37e0d7",
                                                "text": "Die Charaktere werden von den Schauspielern in diesem Stück sehr gut getroffen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "adad6ed7-b453-3bbf-9b80-b76acb1b7e41",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "Schriftzeichen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a4c042a8-9345-36cf-b03f-958b99e79f0d",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "Titel, Rang"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4d2eb3ea-dec7-3226-963f-88fc1bfec071",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "fiktive Person oder Figur in einem Buch, Film, Rollenspiel, Videospiel oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e24763c-aafe-496a-bb39-8f90af4c77bf",
                                                "sense_id": "4d2eb3ea-dec7-3226-963f-88fc1bfec071",
                                                "text": "Sein Charakter zieht sein Schwert und bereitet sich auf einen Angriff vor."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "dbbb8493-0841-3370-ad59-119b9af52baa",
                                        "entry_id": "c5120006-2f43-3f39-bb9e-ec2e718447ee",
                                        "glosses": [
                                            "Person mit einer bestimmten, prägenden Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f833efd3-251c-43cf-86c0-cbe8c6e44af8",
                                                "sense_id": "dbbb8493-0841-3370-ad59-119b9af52baa",
                                                "text": "„Der Kokainhandel zieht die windigsten und gewalttätigsten Charaktere an.“"
                                            },
                                            {
                                                "example_id": "0c18feeb-9951-4fbb-a058-686aa47713b3",
                                                "sense_id": "dbbb8493-0841-3370-ad59-119b9af52baa",
                                                "text": "„Schauplatz ist Dublin, aber einige Charaktere stammen ohne Zweifel aus Triest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
