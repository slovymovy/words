                                "target_senses": [
                                    {
                                        "sense_id": "cdd8b5c8-9fe0-3943-973d-8e932cb0ec3e",
                                        "entry_id": "3b823cb8-1783-3bc0-918f-0425814d508e",
                                        "glosses": [
                                            "A chaplet of rue, as used as a charge on the arms of Saxony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a572f2b8-5304-4b8d-8e13-13023b5613a4",
                                                "sense_id": "cdd8b5c8-9fe0-3943-973d-8e932cb0ec3e",
                                                "text": "A chaplet of rue, sometimes called a crancelin, is blazoned bend-wise in the shield of Saxony – Barry often or and sa., over all a chaplet of rue vert."
                                            },
                                            {
                                                "example_id": "f588719e-e52a-479f-87d0-0d03e4a3a7da",
                                                "sense_id": "cdd8b5c8-9fe0-3943-973d-8e932cb0ec3e",
                                                "text": "His arms show the crancelin of Saxony impaled with the crossed swords of the Marshalcy of the Empire which went with the Saxon Electorate."
                                            },
                                            {
                                                "example_id": "0d50ad24-b302-4244-ba31-e92bc1ee03a7",
                                                "sense_id": "cdd8b5c8-9fe0-3943-973d-8e932cb0ec3e",
                                                "text": "The crancelin, running from upper left to bottom right, took the form of a crenellated garland in deep green."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
