                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhythmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97044f40-13c1-3b7b-9177-56c0f280f581",
                                        "entry_id": "acb9b183-3708-3942-b293-171abddc4e76",
                                        "glosses": [
                                            "regelmäßige Abfolgen von Mustern als Folge unterschiedlicher Tondauer"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb5069b-bf18-4785-9e96-fa1678503aad",
                                                "sense_id": "97044f40-13c1-3b7b-9177-56c0f280f581",
                                                "text": "Wir müssen den Rhythmus noch ein wenig verbessern."
                                            },
                                            {
                                                "example_id": "069e95e0-675b-40c0-bda4-635ca02b93d1",
                                                "sense_id": "97044f40-13c1-3b7b-9177-56c0f280f581",
                                                "text": "„Um im Rhythmus miteinander arbeiten zu können, sangen die Männer ein Shanty, das von einem legendären Kapitän namens Marchero handelte.“"
                                            },
                                            {
                                                "example_id": "221da9d8-84c6-47f9-be42-b22ffbb391a9",
                                                "sense_id": "97044f40-13c1-3b7b-9177-56c0f280f581",
                                                "text": "„Sie nahm ihren Mann bei beiden Händen und schob ihn im Rhythmus der Musik hin und her.“"
                                            },
                                            {
                                                "example_id": "77ea7378-29eb-43d7-99f4-4ea83b03dec1",
                                                "sense_id": "97044f40-13c1-3b7b-9177-56c0f280f581",
                                                "text": "Er hat einen sehr guten Rhythmus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f4db504-5cf3-3471-b7b9-ecb629d13717",
                                        "entry_id": "acb9b183-3708-3942-b293-171abddc4e76",
                                        "glosses": [
                                            "regelmäßige Abfolgen von Mustern als zeitliche Gliederung der sprachlichen Rede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b369978e-7b07-403d-a9c2-872ce9d685e0",
                                                "sense_id": "6f4db504-5cf3-3471-b7b9-ecb629d13717",
                                                "text": "„Stimmklang, Rhythmus und Melodie der Rede sind einerseits mit den gesamten Bewegungen und Muskeleinstellungen des ganzen Körpers aufs engste verbunden und von ihnen abhängig, sie drücken aber andrerseits gedankliche Zusammenhänge mit einer Feinheit und Schärfe aus, die kein anderes Mittel sprachlicher Darstellung erreicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a525b036-7ca1-3cd1-b533-457e70f93799",
                                        "entry_id": "acb9b183-3708-3942-b293-171abddc4e76",
                                        "glosses": [
                                            "regelmäßige Abfolgen von verschiedenen Akzentmustern"
                                        ],
                                        "tags": [
                                            "Poesie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df7833e-cf0c-431f-ae3f-9982eb4a3e81",
                                                "sense_id": "a525b036-7ca1-3cd1-b533-457e70f93799",
                                                "text": "„An einem Ende dieser Skala stünden Gedichte mit deterministischem Rhythmus, am anderen Ende solche mit völlig freiem Rhythmus.“"
                                            },
                                            {
                                                "example_id": "e75d6521-8a8a-40f2-9811-81a140a0d6f3",
                                                "sense_id": "a525b036-7ca1-3cd1-b533-457e70f93799",
                                                "text": "Er hat einen sehr guten Rhythmus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "46aabc71-dd6b-3bd2-bc69-4a8775693947",
                                        "entry_id": "acb9b183-3708-3942-b293-171abddc4e76",
