{
    "word_family": [
        "finish",
        "finisher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f3bfef0-a415-3b94-8e57-6c868d483b56",
                    "sense_definition": "Simple past and past participle of <w>finish</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>finished</w> the cabinet with two more layers of polyurethane.",
                            "target_lang_translations": {
                                "ru": "Он <w>отделал</w> шкафчик ещё двумя слоями полиуретана.",
                                "zh": "他给柜子又刷了两层聚氨酯漆，完成了<w>修饰</w>。"
                            }
                        },
                        {
                            "text": "She <w>finished</w> her homework before going out to play.",
                            "target_lang_translations": {
                                "ru": "Она <w>закончила</w> домашнюю работу, прежде чем пойти гулять.",
                                "zh": "她出去玩之前<w>完成</w>了作业。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола finish.",
                        "zh": "动词 finish 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закончил",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "завершил",
                                "target_lang_sense_clarification": "прошедшее время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完成",
                                "target_lang_sense_clarification": "做完某事"
                            },
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "终止某事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b113f68e-2dc0-3d96-9f8c-65f73000e2ad",
                    "sense_definition": "Completed; concluded; done.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I won't be <w>finished</w> until just before lunch.",
                            "target_lang_translations": {
                                "ru": "Я не <w>закончу</w> до самого обеда.",
                                "zh": "我快到午饭时间才能<w>做完</w>。"
                            }
                        },
                        {
                            "text": "The program was finally <w>finished</w> after three hours.",
                            "target_lang_translations": {
                                "ru": "Программа была наконец <w>завершена</w> спустя три часа.",
                                "zh": "这个程序在三小时后终于<w>完成</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "done",
                        "completed",
                        "concluded",
                        "ended",
                        "over",
                        "complete"
                    ],
                    "antonyms": [
                        "unfinished",
                        "ongoing",
                        "half-finished"
                    ],
                    "common_phrases": [
                        "almost finished",
                        "nearly finished",
                        "not finished yet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершённый, сделанный до конца; готовый.",
                        "zh": "已完成的；结束的；做好的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовый",
                                "target_lang_sense_clarification": "сделанный"
                            },
                            {
                                "target_lang_word": "законченный",
                                "target_lang_sense_clarification": "доведённый до конца"
                            },
                            {
                                "target_lang_word": "завершённый",
                                "target_lang_sense_clarification": "полный, оконченный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完成",
                                "target_lang_sense_clarification": "已做完"
                            },
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "已终止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10ba3ba-01ec-3c98-bd23-7512ad231d12",
                    "sense_definition": "In a state of ruin, failure, or having no future prospects; done for.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If he loses this job, he is <w>finished</w> in this town.",
                            "target_lang_translations": {
                                "ru": "Если он потеряет эту работу, ему <w>конец</w> в этом городе.",
                                "zh": "如果他丢了这份工作，他在这个镇上就<w>完蛋</w>了。"
                            }
                        },
                        {
                            "text": "The scandal meant his political career was <w>finished</w>.",
                            "target_lang_translations": {
                                "ru": "Скандал означал, что его политической карьере <w>конец</w>.",
                                "zh": "这桩丑闻意味着他的政治生涯<w>结束</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doomed",
                        "wrecked",
                        "sunk",
                        "done for",
                        "ruined"
                    ],
                    "common_phrases": [
                        "completely finished",
                        "finished with"
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии краха, провала или безнадёжности; обречённый.",
                        "zh": "处于毁灭、失败或没有前途的状态；完蛋了。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "в значении «всё кончено»"
                            },
                            {
                                "target_lang_word": "конченый",
                                "target_lang_sense_clarification": "безнадёжный, пропащий"
                            },
                            {
                                "target_lang_word": "обречённый",
                                "target_lang_sense_clarification": "не имеющий будущего"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完蛋",
                                "target_lang_sense_clarification": "彻底失败或没希望"
                            },
                            {
                                "target_lang_word": "完了",
                                "target_lang_sense_clarification": "指某人的前途或事业终结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a8e9b31-2042-3863-b7cd-17ed2c7ffe4c",
                    "sense_definition": "Processed or perfected to a high degree of skill.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a very <w>finished</w>, but uninspired performance.",
                            "target_lang_translations": {
                                "ru": "Он выдал очень <w>отточенное</w>, но лишённое вдохновения представление.",
                                "zh": "他的表演非常<w>精湛</w>，但缺乏灵感。"
                            }
                        },
                        {
                            "text": "The artist presented a highly <w>finished</w> portrait to the client.",
                            "target_lang_translations": {
                                "ru": "Художник представил клиенту тщательно <w>отделанный</w> портрет.",
                                "zh": "艺术家向客户展示了一幅高度<w>完善</w>的肖像画。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polished",
                        "refined",
                        "flawless"
                    ],
                    "common_phrases": [
                        "finished product",
                        "finished look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обработанный или доведённый до высокого уровня мастерства.",
                        "zh": "经过加工或达到高超技艺水平的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделанный",
                                "target_lang_sense_clarification": "обработанный"
                            },
                            {
                                "target_lang_word": "отточенный",
                                "target_lang_sense_clarification": "доведённый до совершенства"
                            },
                            {
                                "target_lang_word": "законченный",
                                "target_lang_sense_clarification": "целостный, совершенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精湛",
                                "target_lang_sense_clarification": "技艺高超"
                            },
                            {
                                "target_lang_word": "完善",
                                "target_lang_sense_clarification": "经过打磨达到完美"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}