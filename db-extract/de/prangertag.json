                "senses": [
                    {
                        "sense_id": "7ae36c60-0c5d-3cdb-a5c8-bd0043286ed4",
                        "entry_id": "86ed4e79-fb01-3e40-90cf-736db639625d",
                        "glosses": [
                            "Hochfest, das am 2. Donnerstag nach Pfingsten begangen wird; gefeiert wird die leibliche Gegenwart Jesu Christi im Sakrament der Eucharistie"
                        ],
                        "tags": [
                            "Süddeutschland",
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "2141007d-1e06-4f0b-b02f-2da0bcc33b3a",
                                "sense_id": "7ae36c60-0c5d-3cdb-a5c8-bd0043286ed4",
                                "text": "„‚Corpus Christi‘ ist der lateinische Name für das Hochfest der katholischen Kirche, das wir Fronleichnam nennen. […] In der Liturgie heißt das Fest 'Hochfest des Leibes und Blutes Christi'. In einigen Regionen wird es auch ‚Prangertag‘ oder ‚Bluttag‘ genannt.“"
                            },
                            {
                                "example_id": "3a4e7180-d730-444d-bd69-35a60cafa8b5",
                                "sense_id": "7ae36c60-0c5d-3cdb-a5c8-bd0043286ed4",
                                "text": "„Eine der spektakulärsten Prozessionen am ‚Prangertag‘, wie Fronleichnam auch genannt wird, findet auf dem Staffelsee bei Murnau statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
