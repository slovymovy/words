                                    },
                                    {
                                        "sense_id": "d6bc35ed-c78c-3700-b06b-5b41cf81ad3b",
                                        "entry_id": "57dce76d-caf1-3a2e-8c95-c736c20cb2c2",
                                        "glosses": [
                                            "A condition of existence without predictability or security, affecting material or psychological welfare."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b768d8ca-cfb3-464c-aded-dbdcea5d0bca",
                                                "sense_id": "d6bc35ed-c78c-3700-b06b-5b41cf81ad3b",
                                                "text": "A phenomenon that catches a general tendency towards obscurity is what Standing calls \"uptitling\" - to give a job a high-sounding epithet to conceal its precarity and, I would say, its substance."
                                            },
                                            {
                                                "example_id": "97536a11-bfd3-4986-9f84-cf163fc95240",
                                                "sense_id": "d6bc35ed-c78c-3700-b06b-5b41cf81ad3b",
                                                "text": "Does the boy sense, already, the precarity of all this?"
                                            }
                                        ]
                                    }
                                ]
                            }
