                                        "glosses": [
                                            "organismus, který není možné pozorovat pouhým okem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c4db17-73c1-4288-8489-469519a5cb2d",
                                                "sense_id": "ab5d2813-68fa-31ad-b487-809db8bbfbe3",
                                                "text": "Panophthalmitis (řec.) jest povšechný hnisavý zánět blan očních, za spolupůsobení mikroorganismů, které obyčejně hnisání vzbuzují, zvláště staphylokokků a streptokokků..."
                                            }
                                        ]
