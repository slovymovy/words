{
    "word_family": [
        "blatant"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                    "sense_definition": "In a way that is very obvious and intentional, often in a way that is offensive or lacks shame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obviousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician <w>blatantly</w> lied to the public about his involvement in the scandal.",
                            "target_lang_translations": {
                                "ru": "Политик <w>нагло</w> солгал общественности о своей причастности к скандалу.",
                                "es": "El político mintió <w>descaradamente</w> al público sobre su implicación en el escándalo."
                            }
                        },
                        {
                            "text": "She <w>blatantly</w> ignored the rules despite being warned several times by her supervisor.",
                            "target_lang_translations": {
                                "ru": "Она <w>открыто</w> игнорировала правила, несмотря на неоднократные предупреждения со стороны руководителя.",
                                "es": "Ella ignoró las reglas <w>abiertamente</w> a pesar de que su supervisor le advirtió varias veces."
                            }
                        }
                    ],
                    "synonyms": [
                        "glaringly",
                        "plainly",
                        "obviously",
                        "openly",
                        "overtly"
                    ],
                    "common_phrases": [
                        "blatantly ignore",
                        "blatantly lie",
                        "blatantly unfair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым что-то делается очень явно и намеренно, часто вызывающе или без тени смущения.",
                        "es": "De una manera muy obvia e intencional, a menudo ofensiva o sin vergüenza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открыто",
                                "target_lang_sense_clarification": "подчеркивает отсутствие скрытности"
                            },
                            {
                                "target_lang_word": "нагло",
                                "target_lang_sense_clarification": "подчеркивает бесстыдство и дерзость"
                            },
                            {
                                "target_lang_word": "вопиюще",
                                "target_lang_sense_clarification": "подчеркивает крайнюю степень очевидности и неприемлемости"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "descaradamente",
                                "target_lang_sense_clarification": "con descaro y sin vergüenza"
                            },
                            {
                                "target_lang_word": "descarada y abiertamente",
                                "target_lang_sense_clarification": "de forma flagrante y visible"
                            },
                            {
                                "target_lang_word": "flagrantemente",
                                "target_lang_sense_clarification": "de manera escandalosa y evidente"
                            },
                            {
                                "target_lang_word": "abiertamente",
                                "target_lang_sense_clarification": "a la vista de todos, sin disimulo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
