                        "glosses": [
                            "Action d’aplatir ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7509126f-6337-4d9d-b3b3-a4421d328b3e",
                                "sense_id": "4d056032-f422-391c-9cb4-4d0dd85071df",
                                "text": "C’était un « melon » qui naturellement, subissait toutes les phases du cabossage et de l’aplatissement. Son possesseur avait beau le retaper, l’épousseter, le placer à distance, une fatalité sournoise voulait que, tout à coup, tantôt l’un, tantôt l’autre des acrobates s’élançât à pieds joints sur lui."
                            },
                            {
                                "example_id": "207534f7-d376-48c7-ae02-c31c6f5795b1",
                                "sense_id": "4d056032-f422-391c-9cb4-4d0dd85071df",
                                "text": "Le tube digestif présente à l’emplacement du pharynx un aplatissement de sa lumière interne dans le sens dorso-ventral."
                            }
                        ]
                    }
                ],
