                        "sense_id": "1bb44afb-73b5-39df-b1f2-18fde3ee8aba",
                        "entry_id": "f135a06d-dce0-3ae9-bc3c-e4c3bc52248a",
                        "glosses": [
                            "Faire en sorte que quelque chose ou quelqu’un ne soit plus surchargé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61bea084-b6aa-4b45-aa4b-cf2c06a6a080",
                                "sense_id": "1bb44afb-73b5-39df-b1f2-18fde3ee8aba",
                                "text": "Est-ce que l'ajout d'une interface audio va permettre de désurcharger l'uc ?"
                            },
                            {
                                "example_id": "0e93eef3-0cb9-4de8-ab64-745d6aa7f59c",
                                "sense_id": "1bb44afb-73b5-39df-b1f2-18fde3ee8aba",
                                "text": "Et l'Horion de lave ne m'aide pas, il sert à me désurcharger lorsque je dois jouer genre marteau/tempête sur le même tour."
                            },
                            {
                                "example_id": "31d23c70-eb8f-4bb2-9118-886d244c86e4",
                                "sense_id": "1bb44afb-73b5-39df-b1f2-18fde3ee8aba",
                                "text": "J'ai également retouché en utilisant un modèle existant pour \"désurcharger\" la section des portails connexes."
                            }
                        ]
