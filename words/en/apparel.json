                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать или облачать кого-либо, часто формально, изысканно или великолепно.",
                        "de": "Jemanden bekleiden oder einkleiden, oft feierlich, aufwendig oder prachtvoll."
