                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2942bd-5441-4ebc-a8c7-662638c8c8da",
                                "sense_id": "4ef7f658-6196-3c3a-987d-4ca5ac33f8f1",
                                "text": "Ah oui effectivement Aarmediann, la plupart de ces groupes ne vont pas rerévolutionner le métal français"
                            },
                            {
                                "example_id": "6fde0901-3185-46a9-8a44-3b7a5370fbb7",
                                "sense_id": "4ef7f658-6196-3c3a-987d-4ca5ac33f8f1",
                                "text": "La révolution est prétentieuse, démagogique, elle entretient l'idée que chacun pourrait révolutionner, se révolutionner, pour rerévolutionner, à l'infini."
                            },
                            {
                                "example_id": "0e7887fa-cb1e-48cc-8e97-a8742e208684",
                                "sense_id": "4ef7f658-6196-3c3a-987d-4ca5ac33f8f1",
                                "text": "(...) mais qui a le mérite d'avoir toutes les qualités requises pour rerévolutionner l'univers Hardcore."
                            }
                        ]
                    }
