                        "sense_id": "e03e9e6b-e432-3a09-bd6e-95053d6dfaa6",
                        "entry_id": "9971adce-4593-33c8-b142-c47921fab529",
                        "glosses": [
                            "rozkład wielkości fizycznej w funkcji energii lub częstotliwości, długości fali, itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e5220d-d774-45c9-b51e-a1736a84cc88",
                                "sense_id": "e03e9e6b-e432-3a09-bd6e-95053d6dfaa6",
                                "text": "Ostatnio zmierzone spektrum było bardzo zaszumione i nie użyliśmy go do analizy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2a7cbde7-3579-3d65-bed2-755a2efa1188",
                        "entry_id": "9971adce-4593-33c8-b142-c47921fab529",
                        "glosses": [
                            "zbiór wszystkich wartości własnych danej macierzy kwadratowej lub, ogólniej, operatora liniowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb55eadf-fa95-4603-afc5-326796386037",
                                "sense_id": "2a7cbde7-3579-3d65-bed2-755a2efa1188",
                                "text": "Znaleźć spektrum macierzy diagonalnej jest trywialnie – to elementy stojące na przekątnej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
