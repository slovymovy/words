    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5213f6d0-f87e-3fe4-adcc-fa7d780688d0",
                    "sense_definition": "Extreme physical or mental pain and suffering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pain_and_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the heavy weight fell on her foot, she cried out in <w>agony</w>.",
                            "target_lang_translations": {
                                "pl": "Kiedy ciężki przedmiot spadł jej na stopę, krzyknęła z <w>bólu</w>.",
                                "ru": "Когда тяжелый груз упал ей на ногу, она закричала от <w>муки</w>."
                            }
                        },
                        {
                            "text": "The patient was in extreme <w>agony</w> while waiting for the ambulance to arrive.",
                            "target_lang_translations": {
                                "pl": "Pacjent cierpiał straszne <w>męki</w>, czekając na przyjazd karetki.",
                                "ru": "Пациент испытывал невыносимые <w>страдания</w>, ожидая приезда скорой помощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "anguish",
                        "torment",
                        "suffering",
                        "torture",
                        "distress"
                    ],
                    "antonyms": [
                        "ecstasy",
                        "bliss",
                        "pleasure"
                    ],
                    "common_phrases": [
                        "extreme agony",
                        "scream in agony",
                        "prolonged agony",
                        "mental agony"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ekstremalny ból fizyczny lub psychiczny oraz cierpienie.",
                        "ru": "Сильная физическая или душевная боль и страдание."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "męka",
                                "target_lang_sense_clarification": "silne cierpienie fizyczne lub psychiczne"
                            },
                            {
                                "target_lang_word": "katusze",
                                "target_lang_sense_clarification": "bardzo silne cierpienia, często fizyczne"
                            },
                            {
                                "target_lang_word": "cierpienie",
                                "target_lang_sense_clarification": "ogólne określenie bólu i udręki"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мучение",
                                "target_lang_sense_clarification": "сильная физическая или душевная боль"
                            },
                            {
                                "target_lang_word": "страдание",
                                "target_lang_sense_clarification": "состояние боли или горя"
                            },
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "сильное физическое или нравственное страдание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e0056f2-4aca-33c6-a04a-5427511a8306",
                    "sense_definition": "The final struggle or suffering of a person before death.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pain_and_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor stayed by the bedside to ease the patient's death <w>agony</w>.",
                            "target_lang_translations": {
                                "pl": "Lekarz pozostał przy łóżku, aby złagodzić <w>agonię</w> pacjenta.",
                                "ru": "Врач оставался у постели, чтобы облегчить предсмертную <w>агонию</w> пациента."
                            }
                        },
                        {
                            "text": "He watched the <w>agony</w> of the dying soldier with a heavy heart.",
                            "target_lang_translations": {
                                "pl": "Z ciężkim sercem obserwował <w>konanie</w> umierającego żołnierza.",
                                "ru": "С тяжелым сердцем он наблюдал за <w>агонией</w> умирающего солдата."
                            }
                        }
                    ],
                    "synonyms": [
                        "throe"
                    ],
                    "common_phrases": [
                        "death agony",
                        "final agony"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in the phrase 'death agony'"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ostatnie zmagania lub cierpienie osoby bezpośrednio przed śmiercią.",
                        "ru": "Последняя борьба или страдания человека перед смертью."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "agonia",
                                "target_lang_sense_clarification": "stan bezpośrednio poprzedzający zgon"
                            },
                            {
                                "target_lang_word": "konanie",
                                "target_lang_sense_clarification": "proces umierania"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "агония",
                                "target_lang_sense_clarification": "предсмертные мучения"
                            },
                            {
                                "target_lang_word": "предсмертные мучения",
                                "target_lang_sense_clarification": "физические страдания перед кончиной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f060095-9c25-3e1e-af79-ddddd73be450",
                    "sense_definition": "A violent struggle or intense contest between opposing forces.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The world is convulsed by the <w>agonies</w> of great nations during the revolution.",
                            "target_lang_translations": {
                                "pl": "Świat jest wstrząsany <w>mękami</w> wielkich narodów podczas rewolucji.",
                                "ru": "Мир сотрясается от <w>агонии</w> великих наций во время революции."
                            }
                        },
                        {
                            "text": "The <w>agony</w> of the political campaign left both candidates exhausted.",
                            "target_lang_translations": {
                                "pl": "Ciężka <w>walka</w> podczas kampanii politycznej wyczerpała obu kandydatów.",
                                "ru": "Мучительная <w>борьба</w> в ходе политической кампании измотала обоих кандидатов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agonies of nations"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Gwałtowna walka lub intensywny spór między przeciwstawnymi siłami.",
                        "ru": "Ожесточенная борьба или интенсивное противостояние противоборствующих сил."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "męki",
                                "target_lang_sense_clarification": "metaforycznie o trudnym procesie lub walce"
                            },
                            {
                                "target_lang_word": "konwulsje",
                                "target_lang_sense_clarification": "gwałtowne wstrząsy lub zmiany, np. polityczne"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "агония",
                                "target_lang_sense_clarification": "переносное значение: мучительное умирание или упадок чего-либо"
                            },
                            {
                                "target_lang_word": "мучительная борьба",
                                "target_lang_sense_clarification": "интенсивное противостояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1fdbf37-1206-3099-a371-7df1eb01601b",
                    "sense_definition": "An intense paroxysm or outburst of emotion, such as joy or delight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd reacted with cries and <w>agonies</w> of wild delight when the goal was scored.",
                            "target_lang_translations": {
                                "pl": "Tłum zareagował okrzykami i <w>wybuchami</w> dzikiej radości, gdy padł gol.",
                                "ru": "Толпа отреагировала криками и <w>всплесками</w> дикого восторга, когда был забит гол."
                            }
                        },
                        {
                            "text": "She experienced an <w>agony</w> of suspense while waiting for the results.",
                            "target_lang_translations": {
                                "pl": "Przeżywała <w>męki</w> niepewności, czekając na wyniki.",
                                "ru": "Она переживала <w>мучительное</w> ожидание в предвкушении результатов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agony of delight",
                        "agony of suspense"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Intensywny napad lub wybuch emocji, takich jak radość lub zachwyt.",
                        "ru": "Интенсивный порыв или всплеск эмоций, таких как радость или восторг."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "męka",
                                "target_lang_sense_clarification": "w kontekście emocjonalnym, np. męka niepewności"
                            },
                            {
                                "target_lang_word": "szczyt",
                                "target_lang_sense_clarification": "najwyższy stopień emocji, np. szczyt zachwytu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выплеск эмоций",
