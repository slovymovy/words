                "senses": [
                    {
                        "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                        "entry_id": "0126da8f-9295-32fa-b36c-6c20627420c2",
                        "glosses": [
                            "Uncertain; risky; hazardous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68219396-25eb-41bf-bd4f-0f330f17f1fb",
                                "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                                "text": "In winter steam contributes a fairly high proportion of its tractive effort, say 15 per cent, to heating the train. Diesels have at the moment separate oil-fired boilers which are somewhat chancy affairs, and only electric locomotives grab unlimited power for heating which does not affect their punctuality."
                            },
                            {
                                "example_id": "4e1c6580-b607-49ed-9dc5-b6359c77236a",
                                "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                                "text": "You might think it's foolish\n This chancy rendezvous\n (You might think) You might think I'm crazy\n (All I want) All I want is you"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3a7761f-42e4-34b8-ac8a-81d7986b0a9b",
                        "entry_id": "0126da8f-9295-32fa-b36c-6c20627420c2",
                        "glosses": [
                            "Subject to chance; random."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "76f51fda-9f4b-34b4-9706-7f7d2d1e6230",
                        "entry_id": "0126da8f-9295-32fa-b36c-6c20627420c2",
                        "glosses": [
                            "Lucky; bringing good luck."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f5b10355-00c2-4ff3-addd-c8f4b6685beb",
                                "sense_id": "76f51fda-9f4b-34b4-9706-7f7d2d1e6230",
                                "text": "His haggard gaze swept this way and that, seeking possible succour where reason told him there could be no succour; and then as his vision pieced together this outjutting architectural feature and that into a coherent picture of his immediate surroundings he knew where he was. The one bit of chancy luck in a sequence of direful catastrophes had brought him here[Pg 49] to this very spot. Why, this must be West Ninth Street; it had to be, it was—oh joy, it was!."
                            }
                        ]
                    }
                ],
