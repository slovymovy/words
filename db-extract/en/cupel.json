                        "entry_id": "b179729d-91e0-38e2-92b6-e42d38b4dcbb",
                        "glosses": [
                            "A small circular receptacle used in assaying gold or silver with lead."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "111638eb-8a90-4b32-98de-77ae9b687fec",
                        "source_entry_id": "b179729d-91e0-38e2-92b6-e42d38b4dcbb",
                        "source_sense_id": "b63dc48f-c74c-312b-8a36-e9a21b449dd8",
                        "source_sense_description": "a small circular receptacle used in assaying gold or silver with lead",
                        "target_lang_word": "coupelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coupelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a34a36c-91b4-36d7-aa14-b87d877cca04",
                                        "entry_id": "3889f20e-2f8b-36d4-91cd-2520b7a22c25",
                                        "glosses": [
                                            "Petit vase en forme de tasse, fait avec des cendres lavées ou des os calcinés, dont on se sert pour séparer, par l’action du feu, l’or et l’argent des autres métaux avec lesquels ils sont unis, et particulièrement du cuivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ad7c4f-6d42-45f3-b370-cb302ecd3ede",
                                                "sense_id": "6a34a36c-91b4-36d7-aa14-b87d877cca04",
                                                "text": "Les apprentis courent d’un endroit à l’autre, apportent sur des coupelles les poudres de couleurs vives, les délayent, mitonnent les préparations d’or dont ils ont le secret."
                                            },
                                            {
                                                "example_id": "75d98fba-5a37-446c-a89a-23f33ec46c03",
                                                "sense_id": "6a34a36c-91b4-36d7-aa14-b87d877cca04",
                                                "text": "Fourneau de coupelle. — Cet or a passé par la coupelle. — Cet argent a été mis à la coupelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48bd96a9-ee01-3516-8cb6-97162b0029f4",
                                        "entry_id": "3889f20e-2f8b-36d4-91cd-2520b7a22c25",
                                        "glosses": [
                                            "Petit récipient utilisé pour cuisiner ou pour le service à table."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5aa794d-7e67-4200-b333-ceb239dfef9b",
                                                "sense_id": "48bd96a9-ee01-3516-8cb6-97162b0029f4",
                                                "text": "Pourquoi tu ramènerais de quoi béqueter dans un bar ? À moins d’être germophobe et de ne pas vouloir mettre les doigts dans la coupelle, on t’offre toujours de quoi manger, au pire, tu commandes."
                                            },
                                            {
                                                "example_id": "33154906-708e-47b6-827d-617ebe1f621c",
                                                "sense_id": "48bd96a9-ee01-3516-8cb6-97162b0029f4",
                                                "text": "En début de soirée, il commanda une assiette de pastels à une marchande assise à même la rue. Elle faisait frire ces petits beignets de poisson dans un chaudron d’huile bouillante et les servait dans une coupelle en plastique bleue et rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1117db20-5bd4-3103-8e35-54b463cfd9ea",
                                        "entry_id": "3889f20e-2f8b-36d4-91cd-2520b7a22c25",
                                        "glosses": [
                                            "Petit récipient évasé décoratif utilisé dans les foyers au quotidien pour y déposer de petits objets."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "064b9e07-d541-451c-ba20-3472db353e2f",
                                                "sense_id": "1117db20-5bd4-3103-8e35-54b463cfd9ea",
                                                "text": "Dans chaque maison, il y a au moins un attrapeur de rêves, une paire de mocassins ou une coupelle avec de la sauge, parfois un ragoût d’orignal sur le feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641b1f31-f5b2-3dad-814c-6483bae72f08",
                                        "entry_id": "3889f20e-2f8b-36d4-91cd-2520b7a22c25",
                                        "glosses": [
                                            "Petit récipient évasé et concave, en verre ou en plastique, utilisé en chimie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d889b4-2cf2-468d-a7ef-3d7b6c825bfb",
                                                "sense_id": "641b1f31-f5b2-3dad-814c-6483bae72f08",
                                                "text": "Une coupelle sert à peser de petites quantités de solides (en poudre ou petits morceaux). Elle est généralement tarée au préalable, avant d’être mise sur la balance pour peser ensuite le solide déposé sur la coupelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6cc7c0e-ca70-323f-86cf-ad7e4410f88e",
                                        "entry_id": "3889f20e-2f8b-36d4-91cd-2520b7a22c25",
                                        "glosses": [
                                            "Ce qui a la forme d’une petite coupe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95eaee4c-3996-4b35-bd95-002e096e3d33",
                                                "sense_id": "b6cc7c0e-ca70-323f-86cf-ad7e4410f88e",
                                                "text": "La coupelle des fleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
