                                "sense_id": "44a24329-d2e7-30fc-bd76-06bce77c6229",
                                "text": "Rincer et rerincer et rerincer, tant et plus."
                            },
                            {
                                "example_id": "db04bebd-13bc-4e8e-a029-0ba3303df21e",
                                "sense_id": "44a24329-d2e7-30fc-bd76-06bce77c6229",
                                "text": "Le soir même, rerincer et retremper dans de l'eau salée. Répéter l'opération 2 fois (3 jours en tout)."
                            },
                            {
                                "example_id": "2f4b016b-bb95-4cf1-bf06-515fc5287e65",
                                "sense_id": "44a24329-d2e7-30fc-bd76-06bce77c6229",
                                "text": "Le temps consacré aux chevaux est aussi important : panser, soigner les petits bobos, seller, doucher, rincer le shampooing et rerincer."
                            }
                        ]
                    }
