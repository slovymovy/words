                            }
                        ]
                    },
                    {
                        "translation_id": "c8c900ea-c643-4184-8637-92856bb7ce61",
                        "source_entry_id": "35effe58-6ec4-30fc-83cc-4e88b04cf988",
                        "source_sense_description": "confident",
                        "target_lang_word": "zelfverzekerd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zelfverzekerd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a5edc51a-7040-334e-bbb5-76f0fa38dab5",
                                        "entry_id": "a0f274f8-cc0a-3ef2-8316-0aecda2bdd4d",
                                        "glosses": [
                                            "vol zelfvertrouwen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d33a6b-0f12-4325-bffc-189244caf457",
                                                "sense_id": "a5edc51a-7040-334e-bbb5-76f0fa38dab5",
                                                "text": "Hij nam zelfverzekerd het woord."
                                            },
                                            {
                                                "example_id": "6f96e499-a52b-48f0-8ca0-428cd61589b0",
                                                "sense_id": "a5edc51a-7040-334e-bbb5-76f0fa38dab5",
                                                "text": "Als hij zelfverzekerd door de loopgraven beende en zich tot de mannen richtte, kon hij net zo veel enthousiasme als hij wilde in zijn woorden leggen als hij refereerde aan de verpletterende nederlaag van de vijand die met een laatste salvo de genadeslag zou krijgen, maar de mannen gaven hem alleen wat vaag gemopper ten antwoord en stemden voorzichtigheidshalve zwijgend toe door naar hun kistjes te kijken."
                                            },
                                            {
                                                "example_id": "51a27dd5-4f7a-499b-b516-8bbfc4bd7717",
                                                "sense_id": "a5edc51a-7040-334e-bbb5-76f0fa38dab5",
                                                "text": "Je zelfverzekerd te voelen zonder constant samen met anderen op te trekken."
                                            },
                                            {
                                                "example_id": "be175462-f106-4d88-8f9b-f1c2756c7860",
                                                "sense_id": "a5edc51a-7040-334e-bbb5-76f0fa38dab5",
                                                "text": "Zoals hij zichzelf herinnerde uit die tijd, iets wat hij niet graag deed, moest hij ondraaglijk zelfverzekerd zijn geweest, verbaal sterk, gewend om alle discussies te winnen, kortom onuitstaanbaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
