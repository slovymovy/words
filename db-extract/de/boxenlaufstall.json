                "senses": [
                    {
                        "sense_id": "d31def36-cff5-3ea7-8740-0cc683198f18",
                        "entry_id": "2764b0fc-24f3-37c4-8a10-98a656fbd303",
                        "glosses": [
                            "Stall, in dem sich Kühe frei bewegen können statt angebunden zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344124b2-c5aa-49a3-9935-fb1c492ec4bb",
                                "sense_id": "d31def36-cff5-3ea7-8740-0cc683198f18",
                                "text": "„„Die Tiere dürfen im Stall nicht angebunden sein und es muss Boxenlaufställe oder Flächen für den Weidegang geben“, sagt der Werksleiter.“"
                            },
                            {
                                "example_id": "4a3dd8a8-4484-4cc4-bcf3-8fb90a3e49b9",
                                "sense_id": "d31def36-cff5-3ea7-8740-0cc683198f18",
                                "text": "„Auch wenn ein Boxenlaufstall grundsätzlich dem Tierwohl entgegenkommt, entscheidet letztlich die konkrete Ausgestaltung der Funktionsbereiche darüber, inwieweit ein Stall den Ansprüchen einer Herde gerecht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
