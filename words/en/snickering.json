{
    "word_family": [
        "snicker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f0c86a1-1536-3378-8cc6-3f3f34b1615e",
                    "sense_definition": "present participle and gerund of <w>snicker</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were <w>snickering</w> during the teacher's serious lecture.",
                            "target_lang_translations": {
                                "cs": "Studenti se během učitelovy vážné přednášky <w>chichotali</w>."
                            }
                        },
                        {
                            "text": "I heard them <w>snickering</w> behind my back after I made a mistake.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem, jak se mi za zády <w>uchechtávají</w>, když jsem udělal chybu."
                            }
                        }
                    ],
                    "synonyms": [
                        "giggling",
                        "tittering"
                    ],
                    "common_phrases": [
                        "heard snickering",
                        "stopped snickering"
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa chichotat se"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chichotající se",
                                "target_lang_sense_clarification": "vyjadřující činnost tichého, často neuctivého smíchu"
                            },
                            {
                                "target_lang_word": "uchechtávající se",
                                "target_lang_sense_clarification": "vyjadřující potlačovaný nebo posměšný smích"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0f29ca6-6ef3-36f7-8471-350311b7319d",
                    "sense_definition": "The act of laughing in a quiet, partly suppressed, or disrespectful way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A soft <w>snickering</w> filled the room when the clown tripped over his own feet.",
                            "target_lang_translations": {
                                "cs": "Když klaun zakopl o vlastní nohy, místností se rozlehlo tiché <w>chichotání</w>."
                            }
                        },
                        {
                            "text": "The <w>snickering</w> from the back of the classroom was very distracting.",
                            "target_lang_translations": {
                                "cs": "<w>Chichotání</w> ze zadní části třídy bylo velmi rušivé."
                            }
                        }
                    ],
                    "synonyms": [
                        "giggle",
                        "titter"
                    ],
                    "common_phrases": [
                        "suppressed snickering",
                        "audible snickering"
                    ],
                    "target_lang_definitions": {
                        "cs": "akt tichého, částečně potlačeného nebo neuctivého smíchu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chichotání",
                                "target_lang_sense_clarification": "obecné označení pro tichý, často potlačovaný smích"
                            },
                            {
                                "target_lang_word": "uchechtávání",
                                "target_lang_sense_clarification": "označení pro posměšný nebo nesmělý tichý smích"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}