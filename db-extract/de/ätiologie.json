                "senses": [
                    {
                        "sense_id": "262fd04a-6ed0-3c6a-b39e-4502657a1a49",
                        "entry_id": "c9255f2b-04f8-3866-92ea-89db6c74a39f",
                        "glosses": [
                            "Lehre von den Ursachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98269ad1-a49d-4057-ba9b-103909170c33",
                                "sense_id": "262fd04a-6ed0-3c6a-b39e-4502657a1a49",
                                "text": "Die Ätiologie wird vor allem in der Medizin angewandt."
                            },
                            {
                                "example_id": "f159c66d-b259-49a5-b4b3-db383b3d0cd3",
                                "sense_id": "262fd04a-6ed0-3c6a-b39e-4502657a1a49",
                                "text": "„Heute ist der Krebs an der Reihe, die Krankheit zu sein, die nicht anklopft, bevor sie eintritt, ist es der Krebs, der die Rolle einer als erbarmungslose, geheime Invasion erfahrenen Krankheit übernimmt – eine Rolle, die er solange behalten wird, bis seine Ätiologie eines Tages so klar und seine Behandlung so wirksam sein werden, wie es die der Tb geworden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "993033c3-c172-4bbf-8712-208cd3b4f553",
                        "source_entry_id": "c9255f2b-04f8-3866-92ea-89db6c74a39f",
                        "source_sense_id": "262fd04a-6ed0-3c6a-b39e-4502657a1a49",
                        "source_sense_description": "Lehre von den Ursachen",
                        "target_lang_word": "aetiology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aetiology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e407956d-4b2a-3334-a311-008b3ebd48be",
                                        "entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                                        "glosses": [
                                            "The establishment of a cause, origin, or reason for something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "345e3d62-c441-40f3-853f-30beeeaae50a",
                                                "sense_id": "e407956d-4b2a-3334-a311-008b3ebd48be",
                                                "text": "I do not know where the idea first arose of enlisting internal (subjective) excitations of the sensory organs as well as external sensory stimuli; but it is in fact done in all the more recent accounts of the aetiology of dreams [translating Traumätiologie]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858200df-f7d2-3d2c-b3d8-8f55314af129",
                                        "entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                                        "glosses": [
                                            "The study of causes or causation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a271197-e1e2-3a18-a818-2f1a97f63b56",
                                        "entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                                        "glosses": [
                                            "The study or investigation of the causes of disease; a scientific explanation for the origin of a disease."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0053693-fa4d-37ca-8b3f-ef951492b88a",
                                        "entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                                        "glosses": [
                                            "A cause of disease or of any particular case of a disease (but see pathology § Usage notes)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
