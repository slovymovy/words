                        "glosses": [
                            "Architekt, der sich auf das Entwerfen und Gestalten von Golfplätzen spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f285ae0b-54dd-4503-8872-0b4a244a97af",
                                "sense_id": "a666e1ff-601b-3ab4-83e1-5835cff811c3",
                                "text": "„Wie baut man 18 Golfplätze - Golfplätze - in den Regenwald von Guangdong? Ganz einfach. Man bezahlt den besten Golfplatzarchitekten der Welt jeden Preis, den sie verlangen, und dann schafft man eine Armee von Arbeitern und einen Haufen Dynamit heran und formt die Landschaft nach seinen Vorstellungen um.“"
                            }
                        ],
