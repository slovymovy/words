                    {
                        "sense_id": "4cfc20a9-8984-3473-8ea8-34c803555763",
                        "entry_id": "fc2039c4-9875-3a96-8828-6d6577dfb2f5",
                        "glosses": [
                            "Action de débrider, de contourner les limitations imposées par le fabricant d’un appareil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa3ca7c-2bd8-4a39-b4ce-23da1b2bebe0",
                                "sense_id": "4cfc20a9-8984-3473-8ea8-34c803555763",
                                "text": "La loi prévoit des pénalités et ce même pour le motard de bonne foi qui aurait ignoré le débridage de sa moto."
                            },
                            {
                                "example_id": "9b535112-374f-4eb9-9b7b-1b47c563442e",
                                "sense_id": "4cfc20a9-8984-3473-8ea8-34c803555763",
                                "text": "À première vue le débridage des périphériques tournant sous iOS 5.0 ne pose pas vraiment de problème, Apple n’ayant pas modifié les mesures de protection."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0e5eabb-dd24-3b95-bdd2-8bde7c2145fc",
                        "entry_id": "fc2039c4-9875-3a96-8828-6d6577dfb2f5",
                        "glosses": [
                            "Action de conférer les droits du superutilisateur au système d’exploitation d'un téléphone intelligent."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
