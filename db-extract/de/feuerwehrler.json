                "senses": [
                    {
                        "sense_id": "b17af1b2-9f0b-3db3-b357-1185463a84dd",
                        "entry_id": "d1306c27-d6e0-3aaf-8aa7-e50ca4ba95dc",
                        "glosses": [
                            "Mitglied einer Feuerwehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ba9f480-9499-49cb-b255-ede7d4d2443e",
                                "sense_id": "b17af1b2-9f0b-3db3-b357-1185463a84dd",
                                "text": "„Es soll ja Menschen geben, die gerne mal über Feuerwehrler und Wasserwachtler frotzeln: In einigen Dörfern haftet den Aktiven der Ruf von Gschaftlhubern an, die vom Gemeinderat mit sündteurer Ausrüstung versorgt werden.“"
                            },
                            {
                                "example_id": "a8aaa482-2447-4b28-8bc3-f2a715b5f1d1",
                                "sense_id": "b17af1b2-9f0b-3db3-b357-1185463a84dd",
                                "text": "„Er beobachtete die Feuerwehrler, wie sie all ihre Kräfte einsetzten, um das Anwesen vor dem Schlimmsten zu bewahren.“"
                            },
                            {
                                "example_id": "dd46ab0d-5bc6-4705-b58b-8c74d1970d41",
                                "sense_id": "b17af1b2-9f0b-3db3-b357-1185463a84dd",
                                "text": "„Eggstetten hat 500 Einwohner, fast jeder Dritte ist Feuerwehrler.“"
                            },
                            {
                                "example_id": "2cba50da-cc19-4576-b14b-985089f0b48c",
                                "sense_id": "b17af1b2-9f0b-3db3-b357-1185463a84dd",
                                "text": "„In Piringsdorf waren die Feuerwehrler mit drei Fahrzeugen und 24 Einsatzkräften ausgerückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
