                        "entry_id": "39e51f1f-8e68-3c1a-a1fd-d9e64dfa98ef",
                        "glosses": [
                            "kritische Auseinandersetzung mit Form und/oder Inhalt eines (in der Regel neu erschienenen) Buches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aacda222-427c-4099-8c4f-39fe4a46fc1b",
                                "sense_id": "35f7f992-426f-3d55-a323-f3f197f85738",
                                "text": "„Für Münchner Zeitungen schrieb er Buchrezensionen, ohne die Bücher gelesen zu haben, nur um sich finanziell über Wasser zu halten.“"
                            },
                            {
                                "example_id": "f3934bce-3c73-4bb7-8d0c-2bfce15c0e07",
                                "sense_id": "35f7f992-426f-3d55-a323-f3f197f85738",
                                "text": "„Seine Buchrezensionen sind Muster an Sorgfalt, Kenntnis und Gespür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
