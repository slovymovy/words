                "senses": [
                    {
                        "sense_id": "d8417175-8c4a-38ad-a9a5-76ee21af800e",
                        "entry_id": "94698ce9-451d-32da-925b-2aaee25fa43d",
                        "glosses": [
                            "Débarrasser du burn-out."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493d7bd5-70f9-4585-b10a-c17087ae8c9e",
                                "sense_id": "d8417175-8c4a-38ad-a9a5-76ee21af800e",
                                "text": "Il aide aussi les sociétés à \"déburnouter\" leurs locaux."
                            },
                            {
                                "example_id": "40883e95-e74a-4a01-8446-6f690aef112c",
                                "sense_id": "d8417175-8c4a-38ad-a9a5-76ee21af800e",
                                "text": "Cet homme est une sorte de ghostbuster du burn-out, qui rentre dans les grosses sociétés et essaye de déburnouter des systèmes."
                            },
                            {
                                "example_id": "0bb162e2-befc-4483-b4aa-2e0c044bd263",
                                "sense_id": "d8417175-8c4a-38ad-a9a5-76ee21af800e",
                                "text": "Des directeurs d'hôpitaux condamnés pour des dépenses d'agréments somptuaires, des repos compensateurs inimaginables pour le moindre libéral qui court après ses charges, des périodes rémunérées pour réfléchir, se déburnouter en congrès lointains tout en étant rémunéré(s)…"
                            }
                        ]
                    }
