                "senses": [
                    {
                        "sense_id": "27e493c8-1abd-3e65-9847-63ebed93c566",
                        "entry_id": "fe6ee245-147d-34c2-858b-b5fb1f61e5bd",
                        "glosses": [
                            "Qui est déplorable ; à propos de quoi on se lamente ou on aurait sujet de se lamenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3677e80a-e2f9-44f3-ba84-a5299c1dfa70",
                                "sense_id": "27e493c8-1abd-3e65-9847-63ebed93c566",
                                "text": "Katana ne se trouve pas si loin de Bukavu, mais vu l’état lamentable des routes, c’est quand même une mini-aventure que de s’y rendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c54364eb-c8a5-35f8-a4c6-8db647df5fc4",
                        "entry_id": "fe6ee245-147d-34c2-858b-b5fb1f61e5bd",
                        "glosses": [
                            "Qui inspire la pitié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e175d3-30ef-4da2-8afb-36cb8b486787",
                                "sense_id": "c54364eb-c8a5-35f8-a4c6-8db647df5fc4",
                                "text": "Et il ajusta le chien, le pauvre chien, le lamentable chien qui avait délaissé son os, […] ; les femmes se bouchaient les oreilles pour ne pas entendre la détonation ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f425832a-82a0-33c2-9588-18b8ee8b7a71",
                        "entry_id": "fe6ee245-147d-34c2-858b-b5fb1f61e5bd",
                        "glosses": [
                            "Qui est très médiocre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "11e88c27-acd7-4846-850a-8d65f9856d6e",
                                "sense_id": "f425832a-82a0-33c2-9588-18b8ee8b7a71",
                                "text": "Un discours, une attitude lamentable."
                            }
                        ]
                    },
                    {
                        "sense_id": "d965c19f-5fe4-3e94-8ce0-d4baaa0c720f",
                        "entry_id": "fe6ee245-147d-34c2-858b-b5fb1f61e5bd",
                        "glosses": [
                            "Qui tient de la lamentation."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "da6dea1e-22a3-4803-a0b9-9228e133f5e8",
                                "sense_id": "d965c19f-5fe4-3e94-8ce0-d4baaa0c720f",
                                "text": "Un accent, un ton de voix lamentable. — Des cris lamentables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bdacefc-0935-4816-ad7d-efc40b914e9a",
                        "source_entry_id": "fe6ee245-147d-34c2-858b-b5fb1f61e5bd",
                        "target_lang_word": "dismal",
