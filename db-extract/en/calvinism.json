    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
                "word": "Calvinism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cf4d6969-2384-4643-86d2-26ff12f6b0e1",
                        "entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
                        "tags": [
                            "plural"
                        ],
                        "form": "Calvinisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f139a929-46d2-3b26-ab4e-db87c1abb99b",
                        "entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
                        "glosses": [
                            "The Christian religious tradition based upon the doctrines and forms of Christian practice of several Protestant reformers, especially John Calvin, in contrast to Catholicism, Lutheranism, Anabaptism, and Arminianism. One distinctive trait of the system is its Augustinian doctrine of predestination, which teaches that God has elected some for salvation, apart from anything they do or believe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caab84d4-9999-4bc6-bf0e-2c98ec50bb86",
                        "source_entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
                        "source_sense_id": "f139a929-46d2-3b26-ab4e-db87c1abb99b",
                        "source_sense_description": "Christian religious tradition",
                        "target_lang_word": "kalvinismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9c318d6a-15dc-46c8-a424-bacfc1ec9419",
                        "source_entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
                        "source_sense_id": "f139a929-46d2-3b26-ab4e-db87c1abb99b",
                        "source_sense_description": "Christian religious tradition",
                        "target_lang_word": "calvinisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calvinisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c22fbc6-e65c-35a2-bbf6-c03d5c6eb4f1",
                                        "entry_id": "7cd059e6-4eb6-3c22-9454-6c9cdb5ea6ce",
                                        "glosses": [
                                            "gereformeerde substroming binnen het Christendom waarin o.a. het voorbestemd zijn centraal staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8abd00bc-62cb-4b4d-b564-3e54468c7d5c",
                                                "sense_id": "7c22fbc6-e65c-35a2-bbf6-c03d5c6eb4f1",
                                                "text": "Calvinisme staat inhoudelijk gelijk aan gereformeerd."
                                            },
                                            {
                                                "example_id": "f0ebd58f-f007-432b-a29b-654e98bc1af7",
                                                "sense_id": "7c22fbc6-e65c-35a2-bbf6-c03d5c6eb4f1",
                                                "text": "Een van de belangrijkste eigenschappen van het calvinisme is dat belijders van dit geloof niet van feesten houden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aeed92b-1976-4089-af47-307a696386a8",
                        "source_entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
                        "source_sense_id": "f139a929-46d2-3b26-ab4e-db87c1abb99b",
                        "source_sense_description": "Christian religious tradition",
                        "target_lang_word": "calvinisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calvinisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c034beec-b553-3a6c-bd39-0d8a356277d2",
                                        "entry_id": "01c00f37-d960-39a1-bf6e-b4a10f294ea4",
                                        "glosses": [
                                            "Doctrine de Jean Calvin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69898cfb-398e-40e3-941d-c1a7a727e91c",
                                                "sense_id": "c034beec-b553-3a6c-bd39-0d8a356277d2",
                                                "text": "Cette porte, assez souvent répétée dans les petites églises du moyen âge que le hasard a préservées des ravages du calvinisme, est couronnée par un triglyphe au-dessus duquel s’élève une Vierge sculptée tenant l’Enfant Jésus."
                                            },
                                            {
                                                "example_id": "4d93dea9-e471-4906-a1ee-f08fda8ffa7e",
                                                "sense_id": "c034beec-b553-3a6c-bd39-0d8a356277d2",
                                                "text": "Ils se sentirent au contraire, fort peu d’estime pour les quarante ou cinquante systèmes qui n’étaient bons, comme le jansénisme ou le calvinisme, qu’à troubler l’obéissance et la soumission des esprits."
                                            },
                                            {
                                                "example_id": "ffd80cb9-f6e1-4d5f-ba7d-87ca5ad1c3f6",
                                                "sense_id": "c034beec-b553-3a6c-bd39-0d8a356277d2",
                                                "text": "Ainsi, ceux qui s’étaient séparés de l’Église romaine appartenaient déjà à deux sectes très distinctes : les uns au luthéranisme, les autres au zwinglianisme, précurseur du calvinisme."
                                            },
                                            {
                                                "example_id": "c092b5aa-4cf6-43dd-b52e-42b18bf9d741",
                                                "sense_id": "c034beec-b553-3a6c-bd39-0d8a356277d2",
                                                "text": "Hobbes utilise à de nombreuses reprises les thèmes du calvinisme. Mais c’est un calvinisme d’opportunisme, qui n’hésite pas à se transformer si nécessaire, prenant à l’occasion des accents franchement anti-puritains (qui révèlent sa vraie pensée)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0db2093-3329-3705-a7df-67a523938ece",
                                        "entry_id": "01c00f37-d960-39a1-bf6e-b4a10f294ea4",
                                        "glosses": [
                                            "Église réformée qui suit cette doctrine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "398c30ef-550c-46ca-92b5-45a55e282f8d",
                        "source_entry_id": "75ef51d7-7b64-373f-b9a0-ec0c394d413c",
