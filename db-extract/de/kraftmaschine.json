                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c0c7308-30d1-32f7-82be-2404e9bf8d1b",
                        "entry_id": "98f3730a-dc45-3251-9a3f-562cb2551d29",
                        "glosses": [
                            "Maschine, die verschiedene Energieformen wie Wasserenergie, Windenergie oder Wärmeenergie, in Antriebskraft (mechanische Energie) umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8877a8-fc1a-4260-801c-a3c2c5199974",
                                "sense_id": "5c0c7308-30d1-32f7-82be-2404e9bf8d1b",
                                "text": "„Die Kraftmaschinen haben die Aufgabe, die auf der Erde vorhandenen Naturkräfte, in welcher Form sie sich auch darbieten mögen, in mechanische Energie umzuwandeln, denn nur in dieser Form sind sie geeignet, dem Menschen die Arbeit abzunehmen, die er mit seiner eigenen Kraft leisten müßte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7b025a4-3887-49ba-bb2b-9a664b48afef",
                        "source_entry_id": "98f3730a-dc45-3251-9a3f-562cb2551d29",
                        "source_sense_id": "5c0c7308-30d1-32f7-82be-2404e9bf8d1b",
                        "source_sense_description": "Maschine, die verschiedene Energieformen in Antriebskraft umwandelt",
                        "target_lang_word": "machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f41f8529-b5e4-395c-8aab-e7c5095cbb91",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "A device that directs and controls energy, often in the form of movement or electricity, to produce a certain effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dfe7fbf-1db3-44ff-bec5-d8fb2628dfa0",
                                                "sense_id": "f41f8529-b5e4-395c-8aab-e7c5095cbb91",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16050ec1-4479-312f-99c5-851a91fc7091",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "A vehicle operated mechanically, such as an automobile or an airplane."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5de09a1-226e-4378-8f48-285767b9f755",
                                                "sense_id": "16050ec1-4479-312f-99c5-851a91fc7091",
                                                "text": "As he stood directly beneath a brilliant arc light, waiting for a limousine that was approaching to pass him, he heard his name called in a sweet feminine voice. Looking up, he met the smiling eyes of Olga de Coude as she leaned forward upon the back seat of the machine. He bowed very low in response to her friendly greeting. When he straightened up the machine had borne her away."
                                            },
                                            {
                                                "example_id": "5a03b3f8-28be-43dc-858b-c79d74c2810e",
                                                "sense_id": "16050ec1-4479-312f-99c5-851a91fc7091",
                                                "text": "As the aviator turned his machine to reconnoitre in the new direction, he was surprised to see the hostile aeroplane between him and his objective."
                                            },
                                            {
                                                "example_id": "1f127df9-a189-49d8-8bb4-39388b89cdf5",
                                                "sense_id": "16050ec1-4479-312f-99c5-851a91fc7091",
                                                "text": "\"Joe, how soon will you be ready to roll?\" Frank Hardy burst into the garage where his brother was working on a sleek, black-and-silver motorcycle. \"Right now, if this machine kicks over,\" Joe replied, putting down a wrench."
                                            },
                                            {
                                                "example_id": "e6cfb87e-8ca2-4bbd-abf8-7fd173c4b22f",
                                                "sense_id": "16050ec1-4479-312f-99c5-851a91fc7091",
                                                "text": "Now, here, he is a Racer. He throws his leg over the machine and settles onto the narrow rubber seat. He pushes it through its revolution twice with his hand, slowly, to force the fuel into the carburetor. Then he stands with his left foot on the peg and jumps down on the lever with his right. The engine starts immediately; he takes very good care of his machine. He sits down, waiting for it to warm up. He caresses the top of the tank, understanding that the machine cannot feel the gesture but content that he can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b641ce0-7fe0-363a-a191-ca6b37ab4d7a",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "An answering machine or, by extension, voice mail."
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9831b2d1-0b00-4e96-b7da-71bf379499d2",
                                                "sense_id": "0b641ce0-7fe0-363a-a191-ca6b37ab4d7a",
                                                "text": "I called you earlier, but all I got was the machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5827e8d7-77be-3bfa-a1a9-1aac473b62ba",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "A computer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd95c1a0-0d54-48d0-abd5-2e89fdae9026",
                                                "sense_id": "5827e8d7-77be-3bfa-a1a9-1aac473b62ba",
                                                "text": "Game developers assume they're pushing the limits of the machine."
                                            },
                                            {
                                                "example_id": "741abd15-1da2-4c7d-b1a9-75f48c8954e1",
                                                "sense_id": "5827e8d7-77be-3bfa-a1a9-1aac473b62ba",
                                                "text": "He refuses to turn off his Linux machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2853f8f9-af45-3208-8ea7-729db1ebc7aa",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "A person or organisation that seemingly acts like a machine, being particularly efficient, single-minded, or unemotional."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1b220f-24bd-4d89-9363-187fbdf27267",
                                                "sense_id": "2853f8f9-af45-3208-8ea7-729db1ebc7aa",
                                                "text": "The government has become a money-making machine."
                                            },
                                            {
                                                "example_id": "cce66267-6ca9-4fcb-87d6-5401ce968cf3",
                                                "sense_id": "2853f8f9-af45-3208-8ea7-729db1ebc7aa",
                                                "text": "Bruce Campbell was a \"demon-killing machine\" because he made quick work of killing demons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90086ce2-13ed-3708-aab2-057a6ac453fe",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "Especially, the group that controls a political or similar organization; a combination of persons acting together for a common purpose, with the agencies which they use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504ec57a-a8e2-4d36-9f62-89035fe7485f",
                                                "sense_id": "90086ce2-13ed-3708-aab2-057a6ac453fe",
                                                "text": "The whole machine of government, civil and religious, ought never to bear upon the people with a weight so oppressive"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8868fd54-0666-3d9e-b302-f026cf079366",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "Supernatural agency in a poem, or a superhuman being introduced to perform some exploit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df1c1dab-4cab-4e95-88af-65f7247bc24b",
                                                "sense_id": "8868fd54-0666-3d9e-b302-f026cf079366",
                                                "text": "I am apt to think, that the changing of the Trojan fleet into water-nymphs, which is the most violent machine in the whole Æneid[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa9bc3b-cb6a-3a67-a922-c945e588e26b",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "The system of special interest groups that supports a political party, especially in urban areas."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f26274c-2478-492c-aaf1-aac701d23d5e",
                                                "sense_id": "5fa9bc3b-cb6a-3a67-a922-c945e588e26b",
                                                "text": "A machine politician cannot see why the straight ticket (as he and his clique of party bosses prepare it) should not be voted by every citizen belonging to that party."
                                            },
                                            {
                                                "example_id": "3fe2ce3d-787f-4538-a387-2603d34b601a",
                                                "sense_id": "5fa9bc3b-cb6a-3a67-a922-c945e588e26b",
                                                "text": "In essence, therefore, the right-fork strategy of the Democrats meant an alliance of the South with the political machines built on the non-Protestant immigrants in key Northeastern states."
                                            },
                                            {
                                                "example_id": "37d26a46-c2ef-48ad-8181-bb3dada3b166",
                                                "sense_id": "5fa9bc3b-cb6a-3a67-a922-c945e588e26b",
                                                "text": "He was thrust into a political maelstrom for which he was ill-prepared, and yet he was, most notably, the Chicago machine's political savior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0bb6579-f3ab-3a2b-a2ac-cc3f6969c7c4",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "Penis."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48848845-efb1-48e9-99a8-1355294a6eaa",
                                                "sense_id": "b0bb6579-f3ab-3a2b-a2ac-cc3f6969c7c4",
                                                "text": "He now reſumes his attempts in more form: firſt he put one of the pillows under me, to give the blank of his aim a more favourable elevation, and another under my head, in eaſe of it: then ſpreading my thighs, and placing himſelf ſtanding between them, made them reſt upon his hips: applying then the point of his machine to the ſlit, into which he ſought entrance;",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08b11f16-241f-31c7-8919-3d95b3e0c0b0",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "A contrivance in the Ancient Greek theatre for indicating a change of scene, by means of which a god might cross the stage or deliver a divine message; the deus ex machina."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d11f4de-1334-324b-8410-521e28d19218",
                                        "entry_id": "6169104b-9a1c-3d3a-bee6-0828fb4f01cf",
                                        "glosses": [
                                            "A bathing machine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b898aca-ba19-49c0-b953-080d335c585c",
                                                "sense_id": "3d11f4de-1334-324b-8410-521e28d19218",
                                                "text": "One Machine only was provided for Bathers, the Limitted smoothness of the sands not extending widely enough to admit another."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "014ac45c-ed58-3734-8a98-c5757c24a098",
                                        "entry_id": "e356e740-1d8c-3a81-a8f3-904349dbdf61",
                                        "glosses": [
                                            "To make by machinery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1afb9cbd-b470-3612-a69d-970e79a8b743",
                                        "entry_id": "e356e740-1d8c-3a81-a8f3-904349dbdf61",
                                        "glosses": [
                                            "To shape or finish by machinery; (usually, more specifically) to shape subtractively by metal-cutting with machine-controlled toolpaths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e31df54-f5d4-4bc5-9536-691c9c69a818",
                                                "sense_id": "1afb9cbd-b470-3612-a69d-970e79a8b743",
                                                "text": "Engineering materials have been recently developed whose hardness and strength are considerably increased, such that the cutting speed and the MRR tend to fall when machining such materials using traditional methods like turning, milling, grinding, and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
