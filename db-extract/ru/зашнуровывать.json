                    {
                        "translation_id": "04ea512f-b6db-4468-a92e-63583e3b593c",
                        "source_entry_id": "55ebd642-16c0-38e0-aef8-dd38fa183696",
                        "source_sense_id": "24c2c5d6-01c5-32ca-8cc6-585cdbddbc74",
                        "target_lang_word": "zuschnüren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zuschnüren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "144a0b56-94ca-3185-b7ae-a043238760a1",
                                        "entry_id": "f72205b2-173a-3c37-b25b-950ffcb6e4b6",
                                        "glosses": [
                                            "eine Kordel (Schnur) zusammenziehen und verknoten, so dass etwas dadurch zusammengebunden ist, (durch starke Gefühle) eng machen/werden, so dass Luft oder Nahrung nur schwer passieren können"
                                        ],
                                        "tags": [
                                            "auch übertragen auf den Hals",
                                            "die Kehle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b3f38c-9f7b-48fa-b6a7-791635f15c7d",
                                                "sense_id": "144a0b56-94ca-3185-b7ae-a043238760a1",
                                                "text": "„»Ist noch mehr gekommen?«, fragte er, als er seinen Mantel ausgezogen hatte und Lundmark sich die Stiefel zuschnürte.“"
                                            },
                                            {
                                                "example_id": "82e44713-86d5-4344-9307-18e112363f7e",
                                                "sense_id": "144a0b56-94ca-3185-b7ae-a043238760a1",
                                                "text": "Es schnürt mir die Kehle zu, wenn ich nur daran denke!"
                                            },
                                            {
                                                "example_id": "c1ca533e-5b20-44d6-9225-75b0de6eea82",
                                                "sense_id": "144a0b56-94ca-3185-b7ae-a043238760a1",
                                                "text": "„Eben diese Gedanken waren es, die dem Wikinger vor Rührung die Kehle zuschnürten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
