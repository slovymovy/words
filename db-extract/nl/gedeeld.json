        "nl-extract.jsonl": [
            {
                "entry_id": "42880dfa-e44b-3817-8e0c-fef143c1dc98",
                "word": "gedeeld",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f25c027-88fb-3162-bac3-6e3bd45d59dc",
                        "entry_id": "42880dfa-e44b-3817-8e0c-fef143c1dc98",
                        "glosses": [
                            "in stukken gescheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b123b1d-e8c2-4e95-90c8-b227c60ded0a",
                                "sense_id": "7f25c027-88fb-3162-bac3-6e3bd45d59dc",
                                "text": "Europa kende na de Tweede Wereldoorlog een gedeeld Duitsland."
                            },
                            {
                                "example_id": "73879aa7-d0ab-438f-b25f-12ade2857faa",
                                "sense_id": "7f25c027-88fb-3162-bac3-6e3bd45d59dc",
                                "text": "Dat zegt ook kennisinstituut Deltares, dat in Nederland een grote rol heeft in het onderzoek naar de bodem en water. \"Deltares heeft een sterke relatie met de VU. We delen kennis, studenten studeren bij ons af of lopen bij ons stage. En een aantal van onze medewerkers komt daar ook vandaan, heeft daar een gedeelde aanstelling of is gedetacheerd\", zegt wetenschappelijk directeur Bart van den Hurk, zelf ook gedetacheerd aan de VU."
                            }
                        ]
                    },
                    {
                        "sense_id": "d150b1c0-a04d-3d4c-a7e3-13519faf2afb",
                        "entry_id": "42880dfa-e44b-3817-8e0c-fef143c1dc98",
                        "glosses": [
                            "met een linker- en een rechterhelft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e238134-74cd-4e14-a104-a70ff22de3fe",
                                "sense_id": "d150b1c0-a04d-3d4c-a7e3-13519faf2afb",
                                "text": "Hij voerde een wapen gedeeld van keel en zilver."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d09f9b0-da39-323b-b9d9-90ece8a48e6e",
                        "entry_id": "42880dfa-e44b-3817-8e0c-fef143c1dc98",
                        "glosses": [
                            "wat men samen met anderen heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e7109e-60b5-4e67-aa76-b6f6d78cf094",
                                "sense_id": "9d09f9b0-da39-323b-b9d9-90ece8a48e6e",
                                "text": "Omdat ze precies gelijk eindigden, behaalden ze een gedeelde tweede plaats."
                            }
                        ]
                    }
