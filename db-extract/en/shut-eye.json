    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "88bedaa6-5fe4-37ce-a969-a2681f5609a3",
                "word": "shut-eye",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4d4505c4-53fa-3e7b-87c6-dc3dffedca4d",
                        "entry_id": "88bedaa6-5fe4-37ce-a969-a2681f5609a3",
                        "glosses": [
                            "Sleep."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dbf4ab96-f6ab-4a34-aac3-a0b2ffe30e0d",
                                "sense_id": "4d4505c4-53fa-3e7b-87c6-dc3dffedca4d",
                                "text": "With the night so quiet and peaceful, though, there was nothing he could do except return to camp and try to get a little shut-eye himself."
                            },
                            {
                                "example_id": "5908e87c-fa07-4f19-b4d8-9a43547d205d",
                                "sense_id": "4d4505c4-53fa-3e7b-87c6-dc3dffedca4d",
                                "text": "To make matters worse, he sorely needs some shut-eye. “Not to get into it, but I’m not a great sleeper,” he says, reaching out of frame for his coffee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9a310c5-cdaf-4d6e-8420-9f42f83b4dab",
                        "source_entry_id": "88bedaa6-5fe4-37ce-a969-a2681f5609a3",
                        "source_sense_id": "4d4505c4-53fa-3e7b-87c6-dc3dffedca4d",
                        "source_sense_description": "sleep",
                        "target_lang_word": "Schlaf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlaf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5706cedf-ffe9-3d7c-b373-7d23ba31e1f5",
                                        "entry_id": "91529c29-b4c9-3163-8f2a-89a10cc6e1e3",
                                        "glosses": [
                                            "Zustand der Ruhe eines Lebewesens (meistens höhere Tiere und Menschen, selten auch Pflanzen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78b2e7d-cbc6-4a6a-ac8d-d4739e7e35a9",
                                                "sense_id": "5706cedf-ffe9-3d7c-b373-7d23ba31e1f5",
                                                "text": "Er versank in einem tiefen Schlaf."
                                            },
                                            {
                                                "example_id": "f1ffeeb8-9e0e-4223-a425-544c2b10a5c2",
                                                "sense_id": "5706cedf-ffe9-3d7c-b373-7d23ba31e1f5",
                                                "text": "„Bald umfing ihn der Tröster der Müden und Traurigen, ein tiefer Schlaf!“"
                                            },
                                            {
                                                "example_id": "7e2b5e59-0933-4e09-83c6-909afe8c7176",
                                                "sense_id": "5706cedf-ffe9-3d7c-b373-7d23ba31e1f5",
                                                "text": "„Er fühlte den Schlaf langsam in sich eintreten, die Beine wurden schwer, das Denken lief sacht in das Unbewußte ein, breitete sich aus und sank dahin.“"
                                            },
                                            {
                                                "example_id": "04a92ebd-462f-4fc8-8a9f-4f15310e4410",
                                                "sense_id": "5706cedf-ffe9-3d7c-b373-7d23ba31e1f5",
                                                "text": "„10 Prozent der Erwachsenen leiden an einer Schlafapnoe – einer Erkrankung, bei der die Atmung während des Schlafs wiederholt aussetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af52c51e-b841-3a8c-93fb-937006ed18d3",
                                        "entry_id": "91529c29-b4c9-3163-8f2a-89a10cc6e1e3",
                                        "glosses": [
                                            "verkrustete Tränenflüssigkeit, die sich oftmals am Morgen auf den carunculis lacrimalis, den Tränenwärzchen, findet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea1ffaa-70c7-4b3a-a33c-930b7e524560",
                                                "sense_id": "af52c51e-b841-3a8c-93fb-937006ed18d3",
                                                "text": "Mariella rieb sich den Schlaf aus den Augen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schlaf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57484b11-0989-3fae-9413-4e2cd9440eaa",
                                        "entry_id": "2dbc64f3-b790-327a-ad0c-268353ac7178",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16fa58ea-e692-4b47-8485-458cf0385d20",
                                                "sense_id": "57484b11-0989-3fae-9413-4e2cd9440eaa",
                                                "text": "Darf ich bekannt machen? Dies ist Herr Schlaf."
                                            },
                                            {
                                                "example_id": "724063e9-a566-411b-8b8f-809a04e46470",
                                                "sense_id": "57484b11-0989-3fae-9413-4e2cd9440eaa",
                                                "text": "Welch eine Freude, die Schlafs kommen."
                                            },
                                            {
                                                "example_id": "b6c37797-0e7d-4736-a567-944c4bbb81ca",
                                                "sense_id": "57484b11-0989-3fae-9413-4e2cd9440eaa",
                                                "text": "Das ist Frau Schlafs Tasche."
                                            },
                                            {
                                                "example_id": "7b404877-e915-4c1f-8749-1f9ac5fecc16",
                                                "sense_id": "57484b11-0989-3fae-9413-4e2cd9440eaa",
                                                "text": "Das ist die Tasche von Frau Schlaf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
