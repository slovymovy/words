{
    "word_family": [
        "shammer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35b4d9e7-17f4-3b2e-a987-0721aefcf2d9",
                    "sense_definition": "A fake or an imitation that is presented as being genuine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire business deal turned out to be a complete <w>sham</w>.",
                            "target_lang_translations": {
                                "ru": "Вся эта деловая сделка оказалась полным <w>обманом</w>."
                            }
                        },
                        {
                            "text": "Everyone realized the <w>sham</w> after the fake painting was examined by experts.",
                            "target_lang_translations": {
                                "ru": "Все поняли, что это <w>подделка</w>, после того как картину изучили эксперты."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock"
                    ],
                    "antonyms": [
                        "genuine",
                        "sincere",
                        "real"
                    ],
                    "common_phrases": [
                        "total sham",
                        "complete sham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подделка или имитация, выдаваемая за нечто подлинное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подделка",
                                "target_lang_sense_clarification": "результат имитации чего-либо"
                            },
                            {
                                "target_lang_word": "обман",
                                "target_lang_sense_clarification": "ситуация, основанная на лжи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a807cbf-4da8-36ef-8587-cad0e97290b9",
                    "sense_definition": "A decorative cover for a pillow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a new set of bedding that included two matching pillow <w>shams</w>.",
                            "target_lang_translations": {
                                "ru": "Она купила новый комплект постельного белья, в который входили две подходящие <w>декоративные наволочки</w>."
                            }
                        },
                        {
                            "text": "The bed looked elegant with the decorative <w>shams</w> placed over the pillows.",
                            "target_lang_translations": {
                                "ru": "Кровать выглядела элегантно с <w>декоративными наволочками</w>, надетыми поверх подушек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pillow sham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративная наволочка для подушки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декоративная наволочка",
                                "target_lang_sense_clarification": "чехол для подушки, используемый для украшения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a5bf892-b988-36f8-a2c4-aaf182a5131c",
                    "sense_definition": "The act of using trickery or deceit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The con-man was highly skilled in the arts of <w>sham</w> and deceit.",
                            "target_lang_translations": {
                                "ru": "Мошенник был весьма искусен в искусстве <w>обмана</w> и плутовства."
                            }
                        },
                        {
                            "text": "He felt guilty about the <w>sham</w> he was practicing on his unsuspecting friends.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал вину за <w>обман</w>, который практиковал в отношении своих ничего не подозревающих друзей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, связанное с использованием хитрости или обмана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мошенничество",
                                "target_lang_sense_clarification": "корыстный обман"
                            },
                            {
                                "target_lang_word": "притворство",
                                "target_lang_sense_clarification": "поведение с целью ввести в заблуждение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74c03a9d-51ab-3478-b6e9-49560224e0b1",
                    "sense_definition": "Intended to deceive; false.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They held a <w>sham</w> wedding just to stop their parents from asking questions.",
                            "target_lang_translations": {
                                "ru": "Они устроили <w>фиктивную</w> свадьбу, чтобы родители перестали задавать вопросы."
                            }
                        },
                        {
                            "text": "The politician was accused of funding a <w>sham</w> candidate to steal votes.",
                            "target_lang_translations": {
                                "ru": "Политика обвинили в финансировании <w>фиктивного</w> кандидата с целью кражи голосов."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock"
                    ],
                    "antonyms": [
                        "genuine",
                        "sincere",
                        "real"
                    ],
                    "common_phrases": [
                        "sham marriage",
                        "sham candidate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для обмана; ложный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиктивный",
                                "target_lang_sense_clarification": "несуществующий на самом деле, поддельный"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "неискренний или поддельный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44f7d062-a9bf-36e8-a04f-cae0f4d32fd6",
                    "sense_definition": "To assume the manner or character of someone else; to feign.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>sham</w> illness to avoid going to work on Monday.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>притвориться</w> больным, чтобы не идти на работу в понедельник."
                            }
                        },
                        {
                            "text": "The actor could <w>sham</w> any emotion required for the dramatic scene.",
                            "target_lang_translations": {
                                "ru": "Актер мог <w>изобразить</w> любую эмоцию, необходимую для драматической сцены."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать манеру или характер другого человека; притворяться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "принимать какой-либо вид с целью обмана"
                            },
                            {
                                "target_lang_word": "симулировать",
                                "target_lang_sense_clarification": "притворяться больным или изображать состояние"
                            }
                        ]
                    }
                }
            ]
        },
        {
