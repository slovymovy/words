                "senses": [
                    {
                        "sense_id": "11d9e266-64d5-3ea7-9577-fc30fff10720",
                        "entry_id": "b53e6f4d-f6bb-3546-9d82-644bb1cb5638",
                        "glosses": [
                            "Kampfflugzeug mit Düsentriebwerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a5dd63-fbe5-4cbf-ad4b-049992761291",
                                "sense_id": "11d9e266-64d5-3ea7-9577-fc30fff10720",
                                "text": "Mit lautem Getöse flogen drei Kampfjets über die Militärparade."
                            },
                            {
                                "example_id": "7e096533-58d6-4231-94c9-0417b69ac8dc",
                                "sense_id": "11d9e266-64d5-3ea7-9577-fc30fff10720",
                                "text": "„Beim Trainingsflug eines israelischen Kampfjets ist in einer Höhe von rund neun Kilometern plötzlich die Glashaube abgerissen.“"
                            },
                            {
                                "example_id": "eb7bd67b-f376-4052-8055-9558cbce2b60",
                                "sense_id": "11d9e266-64d5-3ea7-9577-fc30fff10720",
                                "text": "„Estlands Verteidigungsminister Hanno Pevkur hatte am Donnerstag der Agentur Postimees gesagt, sein Land sei im Bedarfsfall auch bereit, atomwaffenfähige Kampfjets aufzunehmen.“"
                            }
                        ],
