                "senses": [
                    {
                        "sense_id": "228ed4b8-e7eb-36ab-8626-bef43e033cd2",
                        "entry_id": "b51de306-bbab-3f3a-914e-06cdcb56519b",
                        "glosses": [
                            "eine iranische Sprache, genauer kurdische Sprache, die von etwa 10 Millionen Kurden im Iran und Irak gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9684a739-82e3-4b59-86d4-2ffeffeb8db9",
                                "sense_id": "228ed4b8-e7eb-36ab-8626-bef43e033cd2",
                                "text": "„Das Sorani verwendet eine aus dem persisch-arabischen Alphabet abgeleitete Schrift.“"
                            },
                            {
                                "example_id": "4cc57fb6-4377-438a-a447-fa02f9d8a1f4",
                                "sense_id": "228ed4b8-e7eb-36ab-8626-bef43e033cd2",
                                "text": "„Grammatikalisch gesehen sind die Unterschiede zwischen Kurmandschi und Sorani nicht geringer als etwa jene zwischen dem Deutschen und dem Holländischen; z.B. kennt Sorani im Gegensatz zum Kurmandschi kein grammatikalisches Geschlecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
