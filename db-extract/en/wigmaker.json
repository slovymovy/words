                                    {
                                        "sense_id": "4e75e6b3-3a23-321c-b50f-41b2c7098385",
                                        "entry_id": "2ff8ecca-24df-3fa3-925e-a51c943a9791",
                                        "glosses": [
                                            "osoba wytwarzająca peruki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7370273-8415-42bb-afb2-1e5b3e37b46b",
                                                "sense_id": "4e75e6b3-3a23-321c-b50f-41b2c7098385",
                                                "text": "Wkrótce mała, wygodna karetka niosła ich do perukarza, a stamtąd, wyświeżonych i uczesanych według ostatniego wzoru - do klubu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "37644ded-4551-32a0-b11e-c2bfb0a1a983",
                                        "entry_id": "2ff8ecca-24df-3fa3-925e-a51c943a9791",
                                        "glosses": [
                                            "osoba nosząca perukę"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba24fe9b-1b47-4f77-a62f-4e28f3a03853",
                                                "sense_id": "37644ded-4551-32a0-b11e-c2bfb0a1a983",
                                                "text": "Chodził w peruce. A ty lubisz perukarzy. Kręci cię osiemnasty wiek. Mnie zresztą też"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "perukarz",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "704f64a0-5be8-3078-ac18-12c1c52f5f6b",
                                        "entry_id": "f0cfb070-5e4e-3e74-9288-558176032de6",
                                        "glosses": [
                                            "gołąb o przyszyjnym upierzeniu przypominającym kołnierz"
                                        ],
                                        "tags": [
                                            "zootechn."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a79722be-1f95-4197-964b-a9701ff65a1e",
                                                "sense_id": "704f64a0-5be8-3078-ac18-12c1c52f5f6b",
                                                "text": "Po przyparafialnym podwórku latają gołębie. Jednak nie są one ulubieńcami księdza. Mimo to pogruchują tu garłacze, perukarze, pawiki i gołębie zielonoskrzydłe"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "bf5eec1a-b635-3d38-858c-d6c443752839",
                                        "entry_id": "f0cfb070-5e4e-3e74-9288-558176032de6",
                                        "glosses": [
                                            "samiec sarny lub jelenia, którego poroże jest zdeformowane przez narośl kostną pokrytą scypułem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8afafc89-c616-4d3f-9b4e-0c3de445cd41",
                                                "sense_id": "bf5eec1a-b635-3d38-858c-d6c443752839",
                                                "text": "Perukarz nie zrzuca parostków, a nieustannie budowane poroże zalewa masą kostną czaszkę prowadząc do ślepoty kozła, który przestaje mieć możliwości normalnego funkcjonowania"
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
                                    }
                                ]
                            }
                        ]
