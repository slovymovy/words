                ],
                "senses": [
                    {
                        "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                        "entry_id": "9466739f-9011-323e-b20f-246b1623c8a8",
                        "glosses": [
                            "Sortir du coma."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b2045b8-54a1-41b9-b179-1eab59ad2ce6",
                                "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                                "text": "A minuit je me rappelle que j'essayais de décomater un pote pour lui souhaiter la bonne année, il m'a répondu \"gneuuuh\""
                            },
                            {
                                "example_id": "4e41cb3d-934e-4500-aa5c-e91f1ab8e1a5",
                                "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                                "text": "Il n'y a pas d'histoire, le Louis, faut pas qu'il décomate."
                            },
                            {
                                "example_id": "1deb88c1-9288-4f28-9391-570394a0aa4e",
                                "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                                "text": "Je me réveille à 4h du matin, le temps de décomater et de me rendre propret il est déjà 5 Heures."
                            },
                            {
                                "example_id": "339f4b23-da20-4e4c-937c-a92f184d2e7c",
                                "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                                "text": "Ce dispositif aidera également à un retour de la diversité écologique dans une zone minérale peu accueillante et à décomater le fond."
                            },
                            {
                                "example_id": "24cb8c97-ce04-47b4-83f6-00443cf244d7",
                                "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                                "text": "Et puis il y a en effet les vacances de la Toussaint pour décomater derrière."
                            },
                            {
                                "example_id": "8c75a796-7871-4399-8cb8-9233c57d6bba",
                                "sense_id": "4897e375-cd46-37d3-b876-27f02c24cdce",
                                "text": "Il se décomate à vue d'œil, notre camarade."
                            }
                        ]
                    }
                ],
