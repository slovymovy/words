                                        "entry_id": "ed51b719-74ad-310e-bc01-c1c2117d6dba",
                                        "glosses": [
                                            "Strips of an outer rind or surface that has been removed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
