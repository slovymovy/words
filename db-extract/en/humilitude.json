                        "examples": [
                            {
                                "example_id": "94adce72-59df-4102-a06e-3b2f8aa516cc",
                                "sense_id": "3a9ce65e-d71f-32bf-af85-a2b55ca3af50",
                                "text": "\"[H]enceforth I shall come into your exalted presence with bare-headed humilitude.\""
                            },
                            {
                                "example_id": "37fd3bbe-5520-4b58-8e35-d59bd61076cc",
                                "sense_id": "3a9ce65e-d71f-32bf-af85-a2b55ca3af50",
                                "text": "[S]hew much humility, and some familiarity. . . . for high humilitudes take such deep root in the minds of the multitude (who are more easily won by unprofitable courtesies, than curious benefits) that I advise thee not to affect nor neglect popularities."
                            },
                            {
                                "example_id": "0e689b53-1df5-4242-94ed-f733ed09e99c",
                                "sense_id": "3a9ce65e-d71f-32bf-af85-a2b55ca3af50",
                                "text": "[A] pretended Invaſion made upon the Liberties of the People vvas complained of the Deputy-Governour, vvas moſt Irregularly call'd forth unto an Ignominous Hearing before them in a vaſt Aſſembly; vvhereto vvith a Sagacious Humilitude he conſented, although he ſhevv'd them hovv he might have Refuſed it."
                            },
                            {
                                "example_id": "5497b8fa-14f5-410a-81a0-cbfe6a84c73c",
                                "sense_id": "3a9ce65e-d71f-32bf-af85-a2b55ca3af50",
                                "text": "The attending spirits that waited the voice of justice fell prostrate down, but Robin, as by superior force impelled, raised his awe-inspired eyes in deep humilitude to the centre of this bright concave."
                            }
                        ]
                    }
