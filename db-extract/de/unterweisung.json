                "senses": [
                    {
                        "sense_id": "9a30d692-d8b9-3f87-ac03-035daba3e590",
                        "entry_id": "a43d2ef5-6fb6-3168-b644-81661df914a9",
                        "glosses": [
                            "Handlung, jemand mit etwas ihm Unbekanntem vertraut zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70428848-757c-4c88-aba1-20445a78be18",
                                "sense_id": "9a30d692-d8b9-3f87-ac03-035daba3e590",
                                "text": "„Die Nörgler bekamen kein Echo ihrer aufgeblasenen Ansprüche, sondern eine Unterweisung in ziviler Unaufgeregtheit.“"
                            },
                            {
                                "example_id": "76c29ed4-eebc-4224-95a2-4c1ce5756b53",
                                "sense_id": "9a30d692-d8b9-3f87-ac03-035daba3e590",
                                "text": "„Lehrhafte Unterweisung wechselt mit praktischer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
