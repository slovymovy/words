                "senses": [
                    {
                        "sense_id": "01e1bd95-8cb4-382e-aa79-84d9f5085ece",
                        "entry_id": "bb1f80df-6939-39e5-af9a-e1dfd528c02a",
                        "glosses": [
                            "действие по значению гл. разбирать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f67c0d3-ac6d-41c4-84cf-e7a69267120b",
                                "sense_id": "01e1bd95-8cb4-382e-aa79-84d9f5085ece",
                                "text": "Лётный день завершается разбором полётов, в котором деятельное участие принимает вся группа наземного обеспечения."
                            }
                        ]
                    },
                    {
                        "sense_id": "41d3e244-e8a4-33a2-83cc-4c8f9d95927c",
                        "entry_id": "bb1f80df-6939-39e5-af9a-e1dfd528c02a",
                        "glosses": [
                            "обычно в сочетании «без разбора» — выбор, основанный на оценке"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f8896d9-2d56-37dd-b9d2-ed21cba79fb5",
                        "entry_id": "bb1f80df-6939-39e5-af9a-e1dfd528c02a",
                        "glosses": [
                            "устар. или спец., обычно об оружии качество, категория, сорт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7acd8c-2113-40a3-8fa8-3d6798b4a22f",
                                "sense_id": "8f8896d9-2d56-37dd-b9d2-ed21cba79fb5",
                                "text": "Получается, что оружие высшего разбора отличается совокупностью качества изготовления всех своих составных частей."
                            }
                        ]
                    },
                    {
                        "sense_id": "36bbcbbd-bd00-3652-a4fc-b648c5726be2",
                        "entry_id": "bb1f80df-6939-39e5-af9a-e1dfd528c02a",
                        "glosses": [
                            "жарг. выяснение отношений между кем-либо (обычно в грубой форме)"
