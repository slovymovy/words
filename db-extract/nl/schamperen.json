        "nl-extract.jsonl": [
            {
                "entry_id": "b120c080-b268-3c85-87cd-7cac609050c1",
                "word": "schamperen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c3a5f7b-5961-3739-9934-3ee2c67042f8",
                        "entry_id": "b120c080-b268-3c85-87cd-7cac609050c1",
                        "glosses": [
                            "op een spottende en minachtende manier spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432ed8a1-1171-4318-ad22-968667e27dd8",
                                "sense_id": "9c3a5f7b-5961-3739-9934-3ee2c67042f8",
                                "text": "Buurtbewoners die het begin van de bouw willen volgen, schamperen al dat de bouwer zijn zaakjes niet voor elkaar heeft. „De stoppen zijn al doorgeslagen,” zoemt het langs het hek."
                            },
                            {
                                "example_id": "9c4c720b-323a-48ca-a1d9-e8c66123b967",
                                "sense_id": "9c3a5f7b-5961-3739-9934-3ee2c67042f8",
                                "text": "Tijdens het Statendebat noemde Krabbendam GroenLinks hoeder van de integriteit, 'maar de heer Krabbendam heeft zich daar in zijn bijdrage aan dit debat niet aan gehouden, verre van dat', schamperen de onderzoekers. Zij noemen Krabbendams intenties 'onwaarachtig en leugenachtig'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1a7148-3545-4997-a3c9-18e17a6069dd",
                        "source_entry_id": "b120c080-b268-3c85-87cd-7cac609050c1",
                        "source_sense_id": "9c3a5f7b-5961-3739-9934-3ee2c67042f8",
                        "target_lang_word": "scoff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scoff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5877dea-d46f-3e64-880e-28d0123f1ee1",
                                        "entry_id": "d6edc2be-c32f-3c6f-9180-5f8eff1ff5a1",
                                        "glosses": [
                                            "A derisive or mocking expression of scorn, contempt, or reproach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97705e3b-b94a-4a90-89ce-acfabf88aacf",
                                                "sense_id": "c5877dea-d46f-3e64-880e-28d0123f1ee1",
                                                "text": "VVith ſcoffes and ſcornes, and contumelious taunts, / In open Market-place produc't they me, / To be a publique ſpectacle to all: / Here, ſayd they, is the Terror of the French, / The Scar-Crovv that affrights our Children ſo."
                                            },
                                            {
                                                "example_id": "3d40f3de-dfc2-44f7-ba9c-2718448ef22c",
                                                "sense_id": "c5877dea-d46f-3e64-880e-28d0123f1ee1",
                                                "text": "\"I believe you've killed that constable in the exercise of his duty, sir; the man's dead;\" said Lowe, sternly. / \"Another gloss on my text; why invade me like house-breakers?\" said Dangerfield, with a grim scoff."
                                            },
                                            {
                                                "example_id": "c1036b33-0305-44bc-9062-fbe80f68733d",
                                                "sense_id": "c5877dea-d46f-3e64-880e-28d0123f1ee1",
                                                "text": "There were sneers, and scoffs, and inuendoes of some; prophecies of failure in a hundred ways […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a26de8b-f351-30b0-96d7-8b07a197d41c",
                                        "entry_id": "d6edc2be-c32f-3c6f-9180-5f8eff1ff5a1",
                                        "glosses": [
                                            "An object of scorn, mockery, or derision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c6d133-21ba-4b70-ab61-43d1a26b2e47",
                                                "sense_id": "9a26de8b-f351-30b0-96d7-8b07a197d41c",
                                                "text": "[T]he scoff of wither'd age and beardless youth […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scoff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "748d9a63-eee0-3cb3-91d7-efcfc78c4eba",
                                        "entry_id": "24974772-79f8-3b1b-972c-d7403df06293",
                                        "glosses": [
                                            "To jeer; to laugh with contempt and derision."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83af0d8f-b416-4ae9-bed6-95688f2eee93",
                                                "sense_id": "748d9a63-eee0-3cb3-91d7-efcfc78c4eba",
                                                "text": "Truth from his lips prevailed with double sway, / And fools who came to scoff, remained to pray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04aff466-1a9b-34b3-ac04-5f22bb789a3d",
                                        "entry_id": "24974772-79f8-3b1b-972c-d7403df06293",
                                        "glosses": [
                                            "To mock; to treat with scorn."
                                        ],
