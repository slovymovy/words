                ],
                "senses": [
                    {
                        "sense_id": "a7911e33-d9a9-31c9-9eaa-0f9745e497a7",
                        "entry_id": "3924da02-ae84-3091-ac82-b5ab2e4e8fdf",
                        "glosses": [
                            "Person, die als Darsteller in Fernsehfilmen bekannt und berühmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a39844c-de2f-4afd-8184-14393a97d764",
                                "sense_id": "a7911e33-d9a9-31c9-9eaa-0f9745e497a7",
                                "text": "„Die Ehefrau des unter Missbrauchsvorwürfen stehenden US-Fernsehstars Bill Cosby hat ihren Mann in Schutz genommen und die Medien scharf kritisiert.“"
                            },
                            {
                                "example_id": "c48672a0-78b9-445e-8a07-aed0b63b8205",
                                "sense_id": "a7911e33-d9a9-31c9-9eaa-0f9745e497a7",
                                "text": "„Die arabischstämmige Fernsehmoderatorin Lucy Aharish und der israelische Fernsehstar und Sänger Zachi Halevi haben am Mittwoch in aller Heimlichkeit geheiratet.“"
                            },
                            {
                                "example_id": "45a1e9fa-b39b-48e2-adca-28e64fb307f5",
                                "sense_id": "a7911e33-d9a9-31c9-9eaa-0f9745e497a7",
                                "text": "„Der Schauspieler und Kabarettist Wolfgang Stumph war der erste gesamtdeutsche Fernsehstar - diesen Samstag kehrt einer seiner sächselnden Jedermänner auf den Bildschirm zurück.“"
                            },
                            {
                                "example_id": "92510bc4-6f6f-4fcd-8859-02598108ba33",
                                "sense_id": "a7911e33-d9a9-31c9-9eaa-0f9745e497a7",
                                "text": "„Er strahlt Güte aus, Vernunft, und ist inzwischen als Fernsehstar berühmter, als er als Braunkohlenschnier je hätte werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
