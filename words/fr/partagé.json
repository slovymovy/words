                        "avis partagés"
                    ]
                },
                {
                    "sense_id": "e6ad6bc9-0e15-39c2-857a-71f5a8175d74",
                    "sense_definition": "Favorisé ou défavorisé par la nature, le sort ou la fortune.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur le plan des talents artistiques, il a été particulièrement bien <w>partagé</w> par la nature."
                        },
                        {
                            "text": "Malgré les nombreuses difficultés rencontrées au début, ils n'étaient pas si mal <w>partagés</w> au final."
