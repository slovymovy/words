                {
                    "sense_id": "d18a1ec5-bd2c-3cc4-8bd6-26eeeb0fe1b6",
                    "sense_definition": "A person who secretly tells the police or authorities about someone else's criminal activities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody trusts him because they suspect he is a <w>grass</w>.",
