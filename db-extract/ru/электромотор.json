                    {
                        "translation_id": "e39e1f9b-8e02-4061-b3e0-f5835ab4e058",
                        "source_entry_id": "56496bf7-5b9f-32fd-abdb-85b478ae7e5c",
                        "source_sense_id": "481a708f-b083-3b4f-b47e-38acf819e0cd",
                        "target_lang_word": "Elektromotor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektromotor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dabc05ed-16d6-3b18-a4ac-0424a8adcbef",
                                        "entry_id": "ffe158ee-a846-3465-a38a-d5bdee5194b6",
                                        "glosses": [
                                            "eine Maschine, die elektrische in mechanische Energie umwandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6799f18-f3e4-433f-9f08-015a0795947e",
                                                "sense_id": "dabc05ed-16d6-3b18-a4ac-0424a8adcbef",
                                                "text": "Der Motorroller hat einen leistungsstarken Elektromotor."
                                            },
                                            {
                                                "example_id": "4e6a1a8d-cec0-4204-8260-04139ae9dbc9",
                                                "sense_id": "dabc05ed-16d6-3b18-a4ac-0424a8adcbef",
                                                "text": "Nicht nur Kleinwagen oder Sportmodelle werden neuerdings mit einem Elektromotor ausgestattet, auch in Kleintransportern kommen die Motoren jetzt zum Einsatz."
                                            },
                                            {
                                                "example_id": "626f1347-184c-49fe-8a76-bee0ec0e5101",
                                                "sense_id": "dabc05ed-16d6-3b18-a4ac-0424a8adcbef",
                                                "text": "Hintergrund der Entwicklung von Elektromotoren für Kraftfahrzeuge ist das Ziel, die Abhängigkeit vom Erdöl zu verringern und durch die umweltschonende Nutzung von elektrischem Strom die Emission von Treibhausgasen zu verringern."
                                            },
                                            {
                                                "example_id": "1e18cd19-f571-4253-8322-6ebdf4c7261f",
                                                "sense_id": "dabc05ed-16d6-3b18-a4ac-0424a8adcbef",
                                                "text": "„Für die Unterwasserfahrt setzte man auf ebenso starke Elektromotoren.“"
                                            },
                                            {
                                                "example_id": "d20dfa51-8a57-413c-9e6d-421ce021c755",
                                                "sense_id": "dabc05ed-16d6-3b18-a4ac-0424a8adcbef",
                                                "text": "„Mithilfe der Elektromotoren schlich sich das U-Boot nun davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45e340db-25d4-4e68-a1a5-6c7ba3612000",
                        "source_entry_id": "56496bf7-5b9f-32fd-abdb-85b478ae7e5c",
                        "source_sense_id": "481a708f-b083-3b4f-b47e-38acf819e0cd",
                        "target_lang_word": "E-Motor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "E-Motor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ae7b64e-9534-379c-95ae-d2c92937e0ee",
                                        "entry_id": "d828ba6e-b7d5-30be-b189-d611c92b190b",
                                        "glosses": [
                                            "Kurzwort für Elektromotor; eine Maschine, die elektrische in mechanische Energie umwandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5daac2ca-194e-4571-b6d7-4e388dd8e4bd",
                                                "sense_id": "5ae7b64e-9534-379c-95ae-d2c92937e0ee",
                                                "text": "„Das Auto erkennt den Abstand zum vorausfahrenden Wagen und wechselt dann automatisch zwischen dem stromsparenden Rollen im Leerlauf (Segeln) und dem Verzögern, und zwar durch den Wechsel des E-Motors in die Energierückgewinnung.“"
                                            },
                                            {
                                                "example_id": "6ce18fdd-8440-478f-a4be-5ec9786a12ef",
                                                "sense_id": "5ae7b64e-9534-379c-95ae-d2c92937e0ee",
                                                "text": "„Die meisten Autohersteller haben inzwischen auch Serienfahrzeuge mit E-Motor vorgestellt.“"
                                            },
                                            {
                                                "example_id": "d19973a2-ca99-4a85-b9cd-2790727c1e85",
                                                "sense_id": "5ae7b64e-9534-379c-95ae-d2c92937e0ee",
                                                "text": "„Endlich springt der E-Motor an.“"
                                            },
                                            {
                                                "example_id": "a605f22a-b56a-4f88-88ca-d61e00d932bc",
                                                "sense_id": "5ae7b64e-9534-379c-95ae-d2c92937e0ee",
                                                "text": "„Zwei Männer stehen über die summenden E-Motoren gebeugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
