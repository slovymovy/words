                                    },
                                    {
                                        "sense_id": "a9b8d735-264f-366c-9697-deb8fcea8279",
                                        "entry_id": "20707cf2-8ead-31e1-85a1-a0185b4f8691",
                                        "glosses": [
                                            "A slice of bread or toast topped with cheese and then grilled or microwaved."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffcfbb7c-92af-31a7-b4ef-001d389e98c9",
                                        "entry_id": "20707cf2-8ead-31e1-85a1-a0185b4f8691",
                                        "glosses": [
                                            "An antisubmarine rocket used mainly during World War II by the US Navy and US Coast Guard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b917084-6101-46ce-a8f6-b3a38587ed62",
                                                "sense_id": "ffcfbb7c-92af-31a7-b4ef-001d389e98c9",
                                                "text": "Besides depth charges, they were armed with smaller forward firing antisubmarine rocket launchers called mousetraps. Fired in groups, these rockets detonated when they contacted a submarine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mousetrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53a0d592-e990-37a6-98b5-55c8eee5f4f5",
                                        "entry_id": "12a1e577-7f76-3f15-a405-c2dc5f53d0c9",
                                        "glosses": [
                                            "To trap; to trick or fool (someone) into a bad situation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a094844-4bed-4b0a-8ad0-2d6ec86b5392",
                                                "sense_id": "53a0d592-e990-37a6-98b5-55c8eee5f4f5",
                                                "text": "He hoped to bring the rebels out of their trenches for a showdown battle somewhere south of the Wilderness, that gloomy expanse of scrub oaks and pines where Lee had mousetrapped Joe Hooker exactly a year earlier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4aed1a-4ed7-35ec-b0fb-4aa6badd554f",
                                        "entry_id": "12a1e577-7f76-3f15-a405-c2dc5f53d0c9",
                                        "glosses": [
                                            "To prevent (the user) from leaving a website by opening another copy when it is closed."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dda50eb-306f-41e8-8951-058518181afe",
                                                "sense_id": "7d4aed1a-4ed7-35ec-b0fb-4aa6badd554f",
                                                "text": "The scammer is paid for each new visitor directed to his site. There is nothing wrong except that the user finds it impossible to leave the site because he is mousetrapped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4553e45-428d-44f5-8a37-8db31cec05ef",
                        "source_entry_id": "1522f86a-cdab-33c4-859b-0cbbed35dd12",
                        "source_sense_id": "e8d3fc68-5362-3580-8a8c-57fe0d7ca10d",
