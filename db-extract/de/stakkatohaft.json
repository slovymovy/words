                "senses": [
                    {
                        "sense_id": "26c26ec7-e7be-358a-9810-70bfc9c77d16",
                        "entry_id": "ba57900c-47a5-34f1-948f-6c8291dd6c97",
                        "glosses": [
                            "in einer abgehackten, an ein Stakkato erinnernden Art und Weise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb459cd-39eb-47ec-9350-2bdba362168e",
                                "sense_id": "26c26ec7-e7be-358a-9810-70bfc9c77d16",
                                "text": "„Hastig nahm er den Hörer ab, drückte ihn ans Ohr und blubberte ein stakkatohaftes »Was gibt es?« in die Sprechmuschel.“"
                            },
                            {
                                "example_id": "bbcdc196-b34a-4038-b89b-82cc05977412",
                                "sense_id": "26c26ec7-e7be-358a-9810-70bfc9c77d16",
                                "text": "„Das Öffnen und Schließen des Mundes und das stakkatohafte Rauschen passten sich den Silben an, die über das grüne Band liefen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
