                        "examples": [
                            {
                                "example_id": "64a273c7-c03a-4d9d-b6b4-3c281bf3ae5b",
                                "sense_id": "f41ff24b-93c9-38f6-a6be-23ba378fbf24",
                                "text": "Auch bei BMW starten die Produktion in Shenyang sowie die Büroarbeit im Vertrieb voraussichtlich am Montag wieder.",
                                "translation": "Chez BMW aussi, la production à Shenyang ainsi que le travail de bureau dans la distribution devraient reprendre lundi."
                            },
                            {
                                "example_id": "b869138b-7681-44b9-883e-ae997d36d594",
                                "sense_id": "f41ff24b-93c9-38f6-a6be-23ba378fbf24",
                                "text": "Detlef schuftet ohne zu murren von früh bis spät in der Werkstatt, aber Büroarbeit verabscheut er.",
                                "translation": "Detlef travaille sans se plaindre du matin au soir à l’atelier, mais il déteste le travail de bureau."
                            }
                        ]
