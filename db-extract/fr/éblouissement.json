                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dazzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b6b3f04-d110-3486-a018-592fadafb8be",
                                        "entry_id": "06ca2883-f170-3311-a274-06a43f424ea9",
                                        "glosses": [
                                            "To confuse or overpower the sight of (someone or something, such as a sensor) by means of excessive brightness."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf0a7c8d-c2d0-40ed-a766-51b964a45df8",
                                                "sense_id": "9b6b3f04-d110-3486-a018-592fadafb8be",
                                                "text": "Dazzled by the headlights of the lorry, the deer stopped in the middle of the street."
                                            },
                                            {
                                                "example_id": "24c28bad-3ff7-472a-80ee-5c2e9784f01f",
                                                "sense_id": "9b6b3f04-d110-3486-a018-592fadafb8be",
                                                "text": "Antidrone lasers can burn or dazzle a drone's sensors."
                                            },
                                            {
                                                "example_id": "220682e9-6a2a-4378-ac12-3e1e8c3e4713",
                                                "sense_id": "9b6b3f04-d110-3486-a018-592fadafb8be",
                                                "text": "Those heavenly shapes / Will dazzle now the earthly, with their blaze / Insufferably bright."
                                            },
                                            {
                                                "example_id": "0613018d-24a1-43b5-9e6d-5e2fa6e43d31",
                                                "sense_id": "9b6b3f04-d110-3486-a018-592fadafb8be",
                                                "text": "An unreflected light did never yet / Dazzle the vision feminine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bfe9fbe-41b2-3bb1-8f4c-d7cbf841ff26",
                                        "entry_id": "06ca2883-f170-3311-a274-06a43f424ea9",
                                        "glosses": [
                                            "To render incapable of thinking clearly; to overwhelm with showiness or brilliance."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bed00f6-f841-4435-a9ff-d359ca8b876d",
                                                "sense_id": "5bfe9fbe-41b2-3bb1-8f4c-d7cbf841ff26",
                                                "text": "The delegates were dazzled by the originality of his arguments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f74fe7b-fd44-3253-85a2-deb4ecd9050f",
                                        "entry_id": "06ca2883-f170-3311-a274-06a43f424ea9",
                                        "glosses": [
                                            "To be overpowered by light; to be confused by excess of brightness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "997ec439-f279-4d04-9937-93149eb6490d",
                                                "sense_id": "1f74fe7b-fd44-3253-85a2-deb4ecd9050f",
                                                "text": "For we see, that an over-light maketh the Eyes dazel, insomuch as perpetual looking against the Sun, would cause blindness."
                                            },
                                            {
                                                "example_id": "2512be80-989d-4a41-9fae-806687b53f05",
                                                "sense_id": "1f74fe7b-fd44-3253-85a2-deb4ecd9050f",
                                                "text": "[…] I dare not trust these Eyes; / They Dance in Mists, and dazle with surprize."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dazzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c208782-5057-35f3-9cc0-552c59bd8ff6",
