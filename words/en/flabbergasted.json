                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected announcement <w>flabbergasted</w> everyone in the room.",
                            "target_lang_translations": {
