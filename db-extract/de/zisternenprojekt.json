                "senses": [
                    {
                        "sense_id": "fd7283f2-c2f8-31bf-9870-1c65c8fd3791",
                        "entry_id": "3f2a6ae3-055d-3f0f-8b63-85587df017bf",
                        "glosses": [
                            "Projekt zum Bau einer Zisterne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae694f58-71b9-4fa3-8062-233b67773e06",
                                "sense_id": "fd7283f2-c2f8-31bf-9870-1c65c8fd3791",
                                "text": "„Die Spenden kommen dem von der Kolpingsfamilie geförderten Zisternenprojekt in Tansania zu gute, das die Versorgung mit sauberem Wasser gewährleisten soll.“"
                            },
                            {
                                "example_id": "e4ace59d-76ed-4526-a907-7cab5d40a083",
                                "sense_id": "fd7283f2-c2f8-31bf-9870-1c65c8fd3791",
                                "text": "Die für Zisternenprojekte tätige Schwester Karin schreitet hier eine geeignete Baufläche ab."
                            },
                            {
                                "example_id": "4064bfb6-8af6-4a5e-ab2a-738f4f0a0511",
                                "sense_id": "fd7283f2-c2f8-31bf-9870-1c65c8fd3791",
                                "text": "„Eine beschäftigte sich mit einem Inklusionsprojekt, eine zweite zeigte Eindrücke aus einem Zisternenprojekt in Brasilien, und die dritte Ausstellung trug den Titel \" Gegen das Vergessen!\"“"
                            },
                            {
                                "example_id": "77614337-d370-46cd-8b9a-6c58b1ab243b",
                                "sense_id": "fd7283f2-c2f8-31bf-9870-1c65c8fd3791",
                                "text": "„Während das Zisternenprojekt jedem, der es nutzte, einen Kostenvorteil brachte, sorgte der Computerchip, mit dem die Müllmenge exakt für die genaue Abrechnung erfasste wurde, für deutlich mehr Gebührengerechtigkeit und trug zur Abfallvermeidung bei.“"
                            },
                            {
                                "example_id": "8ae64b1f-1fd6-48c8-b725-47168fe4d479",
                                "sense_id": "fd7283f2-c2f8-31bf-9870-1c65c8fd3791",
                                "text": "„Im Rahmen der Siegerehrung der Bundesjugendspiele konnte Schulleiter Heinz Josef Haben dem Unesco-Beauftragen der Schule, Alois Wiszniewsky, einen Scheck über 350 Euro für das Zisternenprojekt in Brasilien überreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
