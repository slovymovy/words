                    {
                        "translation_id": "8f94c1f7-ba79-43b9-b18a-87567321d51c",
                        "source_entry_id": "a5a3fb05-76a2-3b79-8199-59f164ceb414",
                        "source_sense_id": "cbb93a96-d327-3fbc-a2aa-7964223277f3",
