                "senses": [
                    {
                        "sense_id": "00f752b3-938d-3171-91e7-2017d9e1a886",
                        "entry_id": "5ec9d7fd-e696-368f-b640-74782ac8aeab",
                        "glosses": [
                            "Débarrasser de la boucane (de la fumée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a40825-14d6-4fe5-b730-ae255b4f1dda",
                                "sense_id": "00f752b3-938d-3171-91e7-2017d9e1a886",
                                "text": "Aussitôt le Diable « déboucané », on vit le feu des enfers se glacer, la grande queue rouge se bleuir et tout le démon se congeler sur place."
                            },
                            {
                                "example_id": "39ea1951-0010-4384-8396-55a39057dfac",
                                "sense_id": "00f752b3-938d-3171-91e7-2017d9e1a886",
                                "text": "«Déboucané», le Savoy s'avère un endroit agréable pour terminer, assis par terre devant la scène si l'on veut, une soirée au festival."
                            },
                            {
                                "example_id": "0bf6e0e2-9807-4a9a-a415-ca6d1bbefd2d",
                                "sense_id": "00f752b3-938d-3171-91e7-2017d9e1a886",
                                "text": "Quand le vent déboucane le ciel."
                            }
                        ]
                    }
