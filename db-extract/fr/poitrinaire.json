                "senses": [
                    {
                        "sense_id": "45c8f10d-5f94-3bd6-b30a-d6c4285da350",
                        "entry_id": "a09c97b3-d636-3ce7-bb36-ecbebf093061",
                        "glosses": [
                            "Celui, celle qui a la poitrine atteinte de quelque mal."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d1adda0f-2db9-4718-b7b3-339778bc1bb2",
                                "sense_id": "45c8f10d-5f94-3bd6-b30a-d6c4285da350",
                                "text": "Apollon, celui du Belvédère du moins, est un élégant poitrinaire qui doit se ménager."
                            },
                            {
                                "example_id": "745425de-47a1-415b-a08a-0c149c589ec1",
                                "sense_id": "45c8f10d-5f94-3bd6-b30a-d6c4285da350",
                                "text": "Allons regarder la dame de Chirkino, on dit qu’on l’emmène à l’étranger pour guérir son mal de poitrine. Je n’ai jamais vu de poitrinaire !."
                            },
                            {
                                "example_id": "e257419d-54ee-4dc7-8e19-0cde7e91b99e",
                                "sense_id": "45c8f10d-5f94-3bd6-b30a-d6c4285da350",
                                "text": "Elle avait eu une passion chaste, une passion en Dieu ; elle avait aimé ingénument un pauvre poitrinaire, le comte de Moras, un homme expirant tous les matins."
                            },
                            {
                                "example_id": "a83b0690-4853-4a37-a7b9-b0e10beddc37",
                                "sense_id": "45c8f10d-5f94-3bd6-b30a-d6c4285da350",
                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d’un poitrinaire devenu cent kilos, d’un bilieux devenu poupin."
                            }
                        ]
                    }
                ],
