                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d7f1d10-b222-4e5e-a3e3-19171e7dfa20",
                                "sense_id": "12663df2-3837-33df-bb78-d414bb473129",
                                "text": "„Joe versteckte sich hinter dem Zaun und wartete, bis der Bäcker seine Zigarettenpause beendet hatte.“"
                            },
                            {
                                "example_id": "381503e8-2b72-4f54-8ed4-7109b82bf709",
                                "sense_id": "12663df2-3837-33df-bb78-d414bb473129",
                                "text": "„Ich muss einen Moment warten, bis die Aufsicht ihre unerlaubte Zigarettenpause macht.“"
                            },
                            {
                                "example_id": "4a5371e3-fc14-4c53-be7b-76db1a363d15",
                                "sense_id": "12663df2-3837-33df-bb78-d414bb473129",
                                "text": "„Der Kleinbus hält alle zwei Stunden für eine Zigarettenpause.“"
                            }
                        ],
