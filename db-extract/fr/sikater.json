                "senses": [
                    {
                        "sense_id": "9354f769-41cd-3930-8205-965ef6572a68",
                        "entry_id": "610f35e4-c7ef-345d-8fb9-a012b6a66614",
                        "glosses": [
                            "Coller avec de la colle Sika."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f353a83-bc89-439d-8110-6aedf4324994",
                                "sense_id": "9354f769-41cd-3930-8205-965ef6572a68",
                                "text": "Pourquoi ne pas prendre un tuyau plus gros et siliconer ou sikater ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c19468b4-a411-3951-a26b-ca6d0b46aca2",
                        "entry_id": "610f35e4-c7ef-345d-8fb9-a012b6a66614",
                        "glosses": [
                            "Utiliser de la colle pour aménager des prises."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4aecc742-7244-466f-921c-0ac2d93e9f11",
                                "sense_id": "c19468b4-a411-3951-a26b-ca6d0b46aca2",
                                "text": "Il ne faut pas tailler, sikater, boucher, car c'est mal."
                            },
                            {
                                "example_id": "63e24046-afde-4db9-9898-ed14964481cb",
                                "sense_id": "c19468b4-a411-3951-a26b-ca6d0b46aca2",
                                "text": "Merci de ne pas tailler ni sikater !"
                            },
                            {
                                "example_id": "d1702988-7aa9-47fd-b0ef-8e22558c1460",
                                "sense_id": "c19468b4-a411-3951-a26b-ca6d0b46aca2",
                                "text": "Sikater une prise, en coller une autre, faire tomber une belle colo' qui menace de partir au premier passage d'un grimpeur."
                            }
                        ]
                    }
