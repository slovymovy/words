{
    "word_family": [
        "pegging",
        "pegged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57c6c156-5523-3ae9-89e5-60b2d727d9a6",
                    "sense_definition": "A small cylindrical object used to fasten things together or hold them in place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a wooden <w>peg</w> to join the two pieces of wood.",
                            "target_lang_translations": {
                                "cs": "Truhlář použil dřevěný <w>kolík</w> ke spojení dvou kusů dřeva."
                            }
                        },
                        {
                            "text": "Make sure to secure the tent with a metal <w>peg</w> so it does not blow away.",
                            "target_lang_translations": {
                                "cs": "Ujistěte se, že stan zajistíte kovovým <w>kolíkem</w>, aby ho neodnesl vítr."
                            }
                        }
                    ],
                    "synonyms": [
                        "pin",
                        "fastener"
                    ],
                    "common_phrases": [
                        "tent peg"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý válcovitý předmět používaný ke spojování věcí nebo k jejich upevnění na místě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kolík",
                                "target_lang_sense_clarification": "obecný výraz pro upevňovací předmět"
                            },
                            {
                                "target_lang_word": "kolíček",
                                "target_lang_sense_clarification": "zdrobnělina pro menší upevňovací předmět"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf93521d-ca2a-32b4-95a0-778fdc223185",
                    "sense_definition": "A hook or protrusion on a wall used for hanging items like coats or hats.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please hang your coat on the <w>peg</w> by the front door.",
                            "target_lang_translations": {
                                "cs": "Prosím, pověste si kabát na <w>věšák</w> u vchodových dveří."
                            }
                        },
                        {
                            "text": "She took her hat off and placed it on a wall <w>peg</w>.",
                            "target_lang_translations": {
                                "cs": "Sundala si klobouk a položila ho na <w>háček</w> na zdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "hook"
                    ],
                    "common_phrases": [
                        "coat peg"
                    ],
                    "target_lang_definitions": {
                        "cs": "Háček nebo výstupek na zdi sloužící k zavěšení předmětů, jako jsou kabáty nebo klobouky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "věšák",
                                "target_lang_sense_clarification": "zařízení nebo háček na zdi pro odkládání oděvů"
                            },
                            {
                                "target_lang_word": "háček",
                                "target_lang_sense_clarification": "obecný výraz pro zahnutý prvek k zavěšení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c879b6c-8915-3390-9679-021a7bfd0edf",
                    "sense_definition": "A device used to hold wet clothes onto a washing line.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>peg</w> to keep the shirt from falling off the line.",
                            "target_lang_translations": {
                                "cs": "Použila <w>kolíček</w>, aby košile nespadla ze šňůry."
                            }
                        },
                        {
                            "text": "The wind was so strong that it blew the <w>peg</w> off the laundry.",
                            "target_lang_translations": {
                                "cs": "Vítr byl tak silný, že <w>kolíček</w> z prádla odfoukl."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothespin"
                    ],
                    "common_phrases": [
                        "clothes peg"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pomůcka používaná k přichycení mokrého prádla na šňůru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kolíček na prádlo",
                                "target_lang_sense_clarification": "specifická pomůcka pro sušení prádla"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf6dbdd3-d69c-3815-9747-b233239b9f2a",
                    "sense_definition": "To fasten or secure something using a peg.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>peg</w> the fabric down before you start sewing.",
                            "target_lang_translations": {
                                "cs": "Před šitím byste měli látku <w>připevnit</w> kolíky."
                            }
                        },
                        {
                            "text": "They <w>pegged</w> the rug to the floor to keep it from sliding.",
                            "target_lang_translations": {
                                "cs": "Koberec k podlaze <w>připevnili</w> kolíky, aby neklouzal."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "secure"
                    ],
                    "target_lang_definitions": {
                        "cs": "Upevnit nebo zajistit něco pomocí kolíku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "připevnit",
                                "target_lang_sense_clarification": "obecné upevnění"
                            },
                            {
                                "target_lang_word": "kolíkovat",
                                "target_lang_sense_clarification": "upevňovat pomocí kolíků"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d46bad0-fad0-3437-8400-96660b1557e0",
                    "sense_definition": "To fix a price, value, or rate at a specific level.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fix_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>peg</w> the currency to the dollar to stabilize trade.",
                            "target_lang_translations": {
                                "cs": "Vláda se rozhodla <w>navázat</w> měnu na dolar, aby stabilizovala obchod."
                            }
                        },
                        {
                            "text": "Interest rates were <w>pegged</w> by the central bank to control inflation.",
                            "target_lang_translations": {
                                "cs": "Úrokové sazby byly centrální bankou <w>zafixovány</w> pro kontrolu inflace."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "stabilize"
                    ],
                    "common_phrases": [
                        "pegged to"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stanovit cenu, hodnotu nebo sazbu na určité úrovni."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "fixovat",
                                "target_lang_sense_clarification": "ustálit hodnotu na určité úrovni"
                            },
                            {
                                "target_lang_word": "navázat",
                                "target_lang_sense_clarification": "v ekonomickém smyslu, např. měnu na jinou měnu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be8406b9-0d81-39f5-9642-79bd2efc5213",
                    "sense_definition": "To throw an object, typically with force.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pegged</w> the ball across the field to his teammate.",
                            "target_lang_translations": {
                                "cs": "Hodil míč přes celé hřiště svému spoluhráči, <w>mrštil</w> jím."
                            }
                        },
                        {
                            "text": "The children were <w>pegging</w> snowballs at each other in the park.",
                            "target_lang_translations": {
                                "cs": "Děti po sobě v parku <w>házely</w> sněhové koule."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss",
                        "pitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hodit předmět, obvykle silou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hodit",
                                "target_lang_sense_clarification": "obecný výraz pro vrhání"
                            },
                            {
                                "target_lang_word": "mrštit",
                                "target_lang_sense_clarification": "hodit prudce nebo silou"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7aa13264-4b81-3b35-8b8f-bf9d57dc4c84",
                    "sense_definition": "A female given name, often a short form of Margaret.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Peg</w> is coming over for dinner this evening.",
                            "target_lang_translations": {
                                "cs": "<w>Peg</w> dnes večer přijde na večeři."
                            }
                        },
                        {
                            "text": "My grandmother's name is <w>Peg</w>.",
                            "target_lang_translations": {
                                "cs": "Moje babička se jmenuje <w>Peg</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ženské křestní jméno, často zkrácená podoba jména Margaret."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Peg",
                                "target_lang_sense_clarification": "vlastní jméno, v češtině se nepřekládá"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}