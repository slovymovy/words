                    {
                        "sense_id": "b3197620-f888-34e1-a301-82dc306dc64f",
                        "entry_id": "4c1f6832-41b6-3318-9252-2c46ded543f0",
                        "glosses": [
                            "To write a letter of comment to a periodical."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e6d7bb1c-b11c-498b-a8c4-69b17069edc4",
                                "sense_id": "b3197620-f888-34e1-a301-82dc306dc64f",
                                "text": "But what happens, since you have spent a couple of weeks with this firm intention to LoC them all in mind, and in many instances you've even check-marked the particular things you want to comment on and thought about just what you want to say, as future issues of fanzines come into your mailbox, you break your fingernails on the staples in your haste to get to them opened so you can turn to the lettercolumn to see if they printed your LoC."
                            }
                        ]
                    }
