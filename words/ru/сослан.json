    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcf34a1a-e64a-3eba-984d-dc720144c432",
                    "sense_definition": "Краткая форма мужского рода единственного числа причастия <w>сосланный</w> (подвергнутый ссылке, отправленный в изгнание)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ссылка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За участие в восстании молодой офицер был <w>сослан</w> в отдалённую сибирскую деревню.",
                            "target_lang_translations": {
                                "en": "For participating in the uprising, the young officer was <w>exiled</w> to a remote Siberian village."
                            }
                        },
                        {
                            "text": "Поэт был <w>сослан</w> на юг страны за свои вольнодумные стихи.",
                            "target_lang_translations": {
                                "en": "The poet was <w>banished</w> to the south of the country for his free-thinking poems."
                            }
                        }
                    ],
                    "synonyms": [
                        "изгнан",
                        "выслан"
                    ],
                    "antonyms": [
                        "помилован",
                        "возвращён"
                    ],
                    "common_phrases": [
                        "был сослан в Сибирь",
                        "пожизненно сослан"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткое причастие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short-form past passive participle of сослать: exiled, banished, or sent away as punishment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exiled",
                                "target_lang_sense_clarification": "sent away as punishment"
                            },
                            {
                                "target_lang_word": "banished",
                                "target_lang_sense_clarification": "expelled or sent into exile"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "38883ac3-9ca3-3b01-925c-83187528fca1",
                    "sense_definition": "Мужское личное имя осетинского происхождения",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "имя собственное",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего лучшего друга зовут <w>Сослан</w>, и он родом из Владикавказа.",
                            "target_lang_translations": {
                                "en": "My best friend's name is <w>Soslan</w>, and he is originally from Vladikavkaz."
                            }
                        },
                        {
                            "text": "Вчера <w>Сослан</w> помог мне перевезти тяжёлые вещи на новую квартиру.",
                            "target_lang_translations": {
                                "en": "Yesterday, <w>Soslan</w> helped me move heavy things to my new apartment."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male given name of Ossetian origin."
                    },
                    "translations": {
