                "senses": [
                    {
                        "sense_id": "f1cecf8a-6530-3276-802c-ae49dccfb3fc",
                        "entry_id": "d57347f3-998c-343a-8dac-361f4da228c8",
                        "glosses": [
                            "een TV-programma dat heel veel kijkers trekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37eec132-fb99-45bc-8142-b30b0247526c",
                                "sense_id": "f1cecf8a-6530-3276-802c-ae49dccfb3fc",
                                "text": "The Voice of Holland blijft hét kijkcijferkanon van de vrijdagavond. Iets meer dan 2 miljoen Nederlanders keken naar de eerste liveshow van de talentenjacht gisteravond, zo blijkt uit de cijfers van Stichting KijkOnderzoek."
                            },
                            {
                                "example_id": "fae227a4-3379-4d24-965b-7c82f5aa8181",
                                "sense_id": "f1cecf8a-6530-3276-802c-ae49dccfb3fc",
                                "text": "Zomer in Zeeland heeft het in zich om net zo populair te worden als kijkcijferkanon Dokter Tinus, vindt hoofdrolspeler Daniël Boissevain. SBS 6 zendt de nieuwe komische dramaserie uit op de maandagavond, op het tijdstip waarop voorheen Dokter Tinus te zien was."
                            }
                        ]
                    },
                    {
                        "sense_id": "558c9f91-205a-3625-bd7b-37dc62f270a5",
                        "entry_id": "d57347f3-998c-343a-8dac-361f4da228c8",
                        "glosses": [
                            "een persoon die veel kijkers trekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7a6569-5ffa-46f2-90a1-01362f4952a7",
                                "sense_id": "558c9f91-205a-3625-bd7b-37dc62f270a5",
                                "text": "Een van de namen die worden genoemd, is die van De Mols eigen zus Linda. De televisiediva, nog altijd een kijkcijferkanon bij RTL 4, beschikt over een contract dat nog slechts een dik jaar doorloopt."
                            },
                            {
                                "example_id": "5f14d7f9-babb-4664-b843-09d3bb77aac1",
                                "sense_id": "558c9f91-205a-3625-bd7b-37dc62f270a5",
                                "text": "Stijlvol doch onopvallend gekleed, net een uitgelopen vergadering doorstaan, ontspannen gezeten op een leren stoeltje in de lobby van het AvroTros-gebouw. Kijkcijferkanon in een waas van aangename eenvoud."
                            }
                        ]
                    }
                ],
