                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6602a6f6-dc9c-40f9-b1c5-fa0571e63321",
                                                "sense_id": "27e0e138-b469-3875-b8a3-bbdb99a7b441",
                                                "text": "Ich habe was dagegen, gut das du fragst, ich hab da wirklich was gegen."
                                            }
                                        ],
