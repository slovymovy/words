                    }
                ],
                "senses": [
                    {
                        "sense_id": "203b5b54-05c7-37ba-9fd2-43b75ab2a085",
                        "entry_id": "291325f9-9cc1-374a-9989-703dfd44d012",
                        "glosses": [
                            "Celui qui conquiert par nature."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c70d8ff1-5c64-44b9-a5b2-87c38a437054",
                                "sense_id": "203b5b54-05c7-37ba-9fd2-43b75ab2a085",
                                "text": "Quand j’ai quitté l’Amérique, peu de temps après, il me semblait que j’étais la toison d’or et que je partais à la recherche d’un conquéreur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cb3736d-a0ae-4758-a4ce-21a6f88c3053",
                        "source_entry_id": "291325f9-9cc1-374a-9989-703dfd44d012",
                        "source_sense_id": "203b5b54-05c7-37ba-9fd2-43b75ab2a085",
                        "target_lang_word": "Eroberer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eroberer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                        "entry_id": "da8ab03d-fb9b-3807-a11e-e3f8e5b8c699",
                                        "glosses": [
                                            "Person, die ein Gebiet, das ihr nicht gehört, in eigene Gewalt bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00a63e5-39d1-4578-8add-5f7c0c623df2",
                                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                                "text": "„Vor allem aber wunderte sich der Eroberer, dass die Gesellschaft der Mexica von Kultur und Ordnung durchdrungen war, obwohl sie nicht von Christen geleitet wurde.“"
                                            },
                                            {
                                                "example_id": "65fd4bd4-0bd9-4f52-a45d-ffbf0d333ff3",
                                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                                "text": "„Die Eroberer verkünden eine neue Religion, den Islam, und verbreiten mit dem Koran eine neue Gesellschaftsordnung.“"
                                            },
                                            {
                                                "example_id": "86f0542e-17c6-45fb-b469-6d36f7dbc151",
                                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                                "text": "„Aber mit seinem neuen Heer konnte Augustus das Imperium Romanum an vielen Stellen erweitern, ja sogar zu Roms größtem Eroberer werden und gleichzeitig den Frieden auch der gefährdeten Grenzgebiete schützen.“"
                                            },
                                            {
                                                "example_id": "efd35ad0-2c47-45f1-a743-cca2a470ddf6",
                                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                                "text": "„Die Tabakpflanze, die in Süd- und Mittelamerika bereits vor unserer Zeitrechnung angepflanzt und zu religiösen sowie medizinischen Zwecken verwendet wurde, kam durch die spanischen Eroberer nach Europa.“"
                                            },
                                            {
                                                "example_id": "3325f6f8-3fa4-48fa-8cc5-84c6490dff0c",
                                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                                "text": "„Auch in Nordamerika, so Smithers, bestraften die Eroberer Two-Spirits mit drakonischen Mitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a8ebd0d-8b16-43ac-8925-28f555823cbf",
                        "source_entry_id": "291325f9-9cc1-374a-9989-703dfd44d012",
                        "source_sense_id": "203b5b54-05c7-37ba-9fd2-43b75ab2a085",
                        "target_lang_word": "conqueror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conqueror",
