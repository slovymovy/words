                "forms": [],
                "senses": [
                    {
                        "sense_id": "7dc31760-f2ae-3344-ad70-bd68abca9741",
                        "entry_id": "2d673837-1004-3551-83b3-f8f82e307ee4",
                        "glosses": [
                            "Initialism of General Motors, an American multinational automotive manufacturing company headquartered in Detroit, Michigan."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "177d7a2f-c845-49ff-99db-d686243e5421",
                                "sense_id": "7dc31760-f2ae-3344-ad70-bd68abca9741",
                                "text": "G.M., of course, is on board, as is Ford Motor, which has made a major investment with the electric truck maker Rivian, […]"
                            },
                            {
                                "example_id": "2baf74f9-6c22-4a27-ade6-8794d2b369bd",
                                "sense_id": "7dc31760-f2ae-3344-ad70-bd68abca9741",
                                "text": "“There were golden years for GM in China, but those are over, and they’ll never have a comeback story,” said Michael Dunne, an auto industry consultant who has been involved in Western automakers’ efforts in China since the 1990s, including GM’s entry into the market."
                            }
                        ]
                    }
                ],
