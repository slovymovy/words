                                "target_senses": [
                                    {
                                        "sense_id": "142fe5f9-4657-32ec-8e93-f7805bface36",
                                        "entry_id": "0c60fa46-a966-379d-9972-f46fd2d5247a",
                                        "glosses": [
                                            "De la couleur marine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5341e2a6-4715-4994-90d8-7703d9b871b2",
                                                "sense_id": "142fe5f9-4657-32ec-8e93-f7805bface36",
                                                "text": "J’ai touché le fond de la piscine\nDans le petit pull marine\nTout déchiré aux coudes\nQu’j’ai pas voulu recoudre\nQue tu m’avais donné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07d7ec28-2ccd-38df-b45f-fc87772e5c2a",
                                        "entry_id": "d4af2d0e-559f-380f-88d8-283934be7efb",
                                        "glosses": [
