                "senses": [
                    {
                        "sense_id": "c61b0b98-6564-360a-9e75-f96d25352fc5",
                        "entry_id": "2e3fd7c0-4203-3cbd-bdb7-641528606853",
                        "glosses": [
                            "kleine Kapelle für die Andacht der Weinbauern im Weinberg, oder Reisenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c0006f-5056-4ef2-bac4-e35167487e74",
                                "sense_id": "c61b0b98-6564-360a-9e75-f96d25352fc5",
                                "text": "„Besucher und Spaziergänger gelangen zunächst zur Weinbergkapelle St. Josef von 1689.“"
                            },
                            {
                                "example_id": "409f15f3-1a16-4d8e-a81d-c89125ad8373",
                                "sense_id": "c61b0b98-6564-360a-9e75-f96d25352fc5",
                                "text": "„Rund 50 Menschen sind an der Schlierseer Weinbergkapelle zu einer Lichteraktion zusammengekommen.“"
                            },
                            {
                                "example_id": "8cbcc2ae-a793-46e3-ae3d-a1dd61925c84",
                                "sense_id": "c61b0b98-6564-360a-9e75-f96d25352fc5",
                                "text": "„Zu den herausragenden Sehenswürdigkeiten Beverungens und Kreises Höxter gehört die Weinbergkapelle, die auch Josephs - Kapelle genannt wird.“"
                            },
                            {
                                "example_id": "fd84df82-d088-45a0-a97a-7aa96fdd0191",
                                "sense_id": "c61b0b98-6564-360a-9e75-f96d25352fc5",
                                "text": "„Der rund drei Kilometer lange Rundwanderweg beginnt bei einem barocken Schatz, nämlich der Weinbergkapelle, dem letzten steinernen Denkmal der fürstabtlichen Weingeschichte aus dem 17. Jahrhundert.“"
                            },
                            {
                                "example_id": "f794a8a2-80ad-41e7-8724-6ee48b8f6aa7",
                                "sense_id": "c61b0b98-6564-360a-9e75-f96d25352fc5",
                                "text": "„Auf der Westseite von Glaubendorf, in der Riede Zwischengraben an der Güterwegabzweigung zu den Rieden Langen und Auflangeln wurd für die 1968 abgerissene Kapelle an der ehemaligen Reichsstraße, die Weinbergkapelle 1972 aus Ziegelmauerwerk mit Satteldach und begehbarer Nische mit gemauerten Altartisch aufgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
