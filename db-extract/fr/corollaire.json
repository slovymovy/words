                "senses": [
                    {
                        "sense_id": "59a6c110-e9fd-3b1e-b4e9-af271d917460",
                        "entry_id": "1b7fe039-0304-3828-81f7-63c6ca8a04af",
                        "glosses": [
                            "Qui est la suite logique et directe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0601c900-8669-4be4-8789-90731ca3bfa8",
                                "sense_id": "59a6c110-e9fd-3b1e-b4e9-af271d917460",
                                "text": "Les problèmes corollaires à ta solution sont difficiles à résoudre."
                            },
                            {
                                "example_id": "52d8a8e1-676d-443f-920d-c6ec6b89e6c9",
                                "sense_id": "59a6c110-e9fd-3b1e-b4e9-af271d917460",
                                "text": "L’obsession du voyage, pour un cœur jeune, est presque toujours corollaire de celle de l’amour."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "91f97af7-3fca-369a-9475-a2ecf402104d",
