                "senses": [
                    {
                        "sense_id": "706ba806-4e35-32de-b96a-8c54cb487770",
                        "entry_id": "6488d89b-7d89-3b67-b30b-d3f220fb31f3",
                        "glosses": [
                            "weibliche Person, die eine Linotype bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b02954-d607-4bdc-8e95-759772d4e8ba",
                                "sense_id": "706ba806-4e35-32de-b96a-8c54cb487770",
                                "text": "„Ihre Mutter, die sich als Linotypistin durchschlug, hatte das uneheliche Kind vorzeitig aus der Schule genommen, damit es zum Lebensunterhalt beitrage.“"
                            },
                            {
                                "example_id": "ef0a0062-8403-434a-867e-4b06b6d8d814",
                                "sense_id": "706ba806-4e35-32de-b96a-8c54cb487770",
                                "text": "„Eine Linotypistin war verreist, die andere auf Urlaub.“"
                            },
                            {
                                "example_id": "6cd5b891-bc12-406c-bf7e-4d91c01a5a86",
                                "sense_id": "706ba806-4e35-32de-b96a-8c54cb487770",
                                "text": "„Unsere Bilder zeigen eine Linotypistin und eine Offsetdruckerin.“"
                            },
                            {
                                "example_id": "8fcd0490-cc86-4213-936f-cdfd5af9b92c",
                                "sense_id": "706ba806-4e35-32de-b96a-8c54cb487770",
                                "text": "„Linotypistinnen sind immer Frauen, also die Frauen, die den Text per Maschine tippen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
