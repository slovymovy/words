                "senses": [
                    {
                        "sense_id": "0621185e-85be-3c0f-baf2-75cac0e278d1",
                        "entry_id": "6b6f802c-6b1b-3d23-b916-94b1ffc9d3b8",
                        "glosses": [
                            "An internal battle; a fight with allies or other members of the same group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e16f425-99d0-4936-80dd-d3b9ca23bff5",
                                "sense_id": "0621185e-85be-3c0f-baf2-75cac0e278d1",
                                "text": "The power struggle to establish Kim Il Sung as the sole leader in North Korea took almost a decade, entailing a series of bitter factional infights."
                            },
                            {
                                "example_id": "df9feac5-4036-4b37-8fbf-5d40df962e22",
                                "sense_id": "0621185e-85be-3c0f-baf2-75cac0e278d1",
                                "text": "In political terms, the subject of the play is the infight between ultraradical and moderate leftist factions, an infight which has haunted the European leftist movements since the days of the French Revolution."
                            },
                            {
                                "example_id": "8cbfd5fb-f9dd-4232-bc94-76f877513bc3",
                                "sense_id": "0621185e-85be-3c0f-baf2-75cac0e278d1",
                                "text": "The German officer, however, made in his new function as Inspector of Army Motorization an enemy who proved equally ruthless on the battlefield as in the arena of bureaucratic infights—Heinz Guderian."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7eb0a6a5-0ab8-3e55-a040-2df3b25ef3f3",
