                    {
                        "sense_id": "899c6116-766d-3da9-b415-84e7c036d29f",
                        "entry_id": "1091f91f-b775-398e-ad4b-6a27316c3344",
                        "glosses": [
                            "Qui est conforme à la tradition classique et bourgeoise, qui respecte les convenances."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e63fc456-b4e0-42ae-8166-17d2c5d8260e",
                                "sense_id": "899c6116-766d-3da9-b415-84e7c036d29f",
                                "text": "Kate et William forment un couple on ne peut plus preppy."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ce6abc5-2d73-38ff-ba54-c0517adb8aa4",
                        "entry_id": "1091f91f-b775-398e-ad4b-6a27316c3344",
                        "glosses": [
                            "D'un style sobre et soigné, souvent très coûteux."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cd6e9c9a-e2eb-4f80-a8cc-b2ac14f57f72",
                                "sense_id": "9ce6abc5-2d73-38ff-ba54-c0517adb8aa4",
                                "text": "Ce look très preppy te va à ravir !"
                            }
                        ]
                    },
                    {
                        "sense_id": "821900f0-37ca-37ff-8367-792a051c2571",
                        "entry_id": "1091f91f-b775-398e-ad4b-6a27316c3344",
                        "glosses": [
                            "Qui détonne par une forme de préciosité, un sentiment de supériorité."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c7fb53f9-5ae9-480b-9423-a543d0d3811c",
                                "sense_id": "821900f0-37ca-37ff-8367-792a051c2571",
                                "text": "Je ne supporte pas son accent si preppy !"
                            }
                        ]
                    }
                ],
