                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "почта́мтах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93c55cf7-321e-3932-a0b2-0cfb099f6cd4",
                        "entry_id": "1ec6bebf-c0ea-3bfd-8c8d-95abc9801998",
                        "glosses": [
                            "центральное почтовое учреждение в городе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c59cda-d204-456b-9e60-e9bf652c26cd",
                                "sense_id": "93c55cf7-321e-3932-a0b2-0cfb099f6cd4",
                                "text": "Не без основания, должно быть, эта почтенная дама просила отвечать ей: «Петербург, Почтамт, до востребования», — 4000 руб. на расходы, это ведь взятка, да и вообще всё дело сдирания тёмное; кто-нибудь мог бы узнать об этом замысле, а ведь это не принято в петербургском большом свете, чтобы просто-напросто «содрать» шкуру и поехать в оперу, как ни в чём не бывало."
                            }
                        ]
                    },
                    {
                        "sense_id": "426a3471-97bf-3cc1-b8ba-ba54c55794b2",
                        "entry_id": "1ec6bebf-c0ea-3bfd-8c8d-95abc9801998",
                        "glosses": [
                            "здание, где помещается такое учреждение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f5f00f-8342-4956-909e-f2d2ee177009",
                                "sense_id": "426a3471-97bf-3cc1-b8ba-ba54c55794b2",
                                "text": "Окончив письмо, она послала служителя взять себе карету, и, когда та приведена была, она сейчас же села и велела себя везти в почтамт; там она прошла в отделение, где принимают письма, и отдала чиновнику написанное ею письмо."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d009f313-ef81-46cf-9d7a-71a35178b535",
                        "source_entry_id": "1ec6bebf-c0ea-3bfd-8c8d-95abc9801998",
                        "target_lang_word": "head post office",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d4e390e4-b0f3-48da-9cb3-2f2b6b1703bd",
                        "source_entry_id": "1ec6bebf-c0ea-3bfd-8c8d-95abc9801998",
                        "target_lang_word": "posta centrale",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "149c349c-5aab-4bdd-bcca-533a6b77eb31",
                        "source_entry_id": "1ec6bebf-c0ea-3bfd-8c8d-95abc9801998",
                        "target_lang_word": "Postamt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postamt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                        "entry_id": "30585712-0102-32be-9d1b-3c01f214c88b",
                                        "glosses": [
                                            "einzelne Geschäftsstelle bzw. Dienststelle der Post"
                                        ],
                                        "tags": [
                                            "früher"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b6ad32d-6bf6-4dbc-9740-3b011c33baaa",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "Ich muss das Paket heute noch zum Postamt bringen."
                                            },
                                            {
                                                "example_id": "6682349e-178b-4c67-8910-f3beb6cb5460",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„In einer Ecke des Postamtes stand ein kleiner Kiosk mit der Aufschrift »Volksapotheke«.“"
                                            },
                                            {
                                                "example_id": "fad05087-909f-44d2-9cfd-ac636f618aa3",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„Und immer wenn ich einen von ihnen treffe, wenn sie auf dem Postamt vor oder hinter mir in der Schlange stehen, dann quatsche ich sie an.“"
                                            },
                                            {
                                                "example_id": "c1234235-d23b-4808-8f59-c6f21fbd54b8",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„Die Postverwaltung der Regierung weigerte sich, dieses Unternehmen anzuerkennen, und Franklin ließ es durch ein eigenes Postamt ersetzen.“"
                                            },
                                            {
                                                "example_id": "dedf89e7-0861-461b-b726-2ef7b7bfb219",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„In Frankfurt befand sich außer dem hessen-casselschen Postamt um 1705 ein darmstädtisches Postamt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eb29d26-0b08-43f8-bdb7-097f8210c4d7",
                        "source_entry_id": "1ec6bebf-c0ea-3bfd-8c8d-95abc9801998",
                        "target_lang_word": "bureau des postes",
