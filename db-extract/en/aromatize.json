                                        "glosses": [
                                            "Parfumer avec une substance aromatique un remède, un aliment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7983b8f2-e431-48fb-893f-41be9855df75",
                                                "sense_id": "d093995d-c5cb-3277-8392-874d4b7dd89e",
                                                "text": "Aromatiser du vinaigre avec de l’estragon."
                                            },
                                            {
                                                "example_id": "d1d3c81f-c687-4f7f-8044-1418d2459d06",
                                                "sense_id": "d093995d-c5cb-3277-8392-874d4b7dd89e",
                                                "text": "Aromatiser une sauce avec de la muscade."
                                            },
                                            {
                                                "example_id": "19f1c1ac-f462-4c26-baf8-3045d88fdad6",
                                                "sense_id": "d093995d-c5cb-3277-8392-874d4b7dd89e",
                                                "text": "Boisson aromatisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d4a33cb-7980-4be4-aa7d-49ec6f8c8bdd",
                        "source_entry_id": "f4587ad6-59d7-35bb-ab4e-893752d245e0",
                        "source_sense_description": "to make aromatic",
                        "target_lang_word": "aromatisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aromatisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebcb984f-4abb-3800-89a2-ed99c66f38cd",
                                        "entry_id": "ba3a23fc-bf06-37e5-8189-30f93f3eeb28",
                                        "glosses": [
                                            "mit Aroma versehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63efb748-864b-4db6-be19-d9611abcdcda",
                                                "sense_id": "ebcb984f-4abb-3800-89a2-ed99c66f38cd",
                                                "text": "Zwischendurch aromatisieren wir Essig mit den wuchernden Kräutern und Blüten vom Balkon und süßen Früchtchen der Saison."
                                            },
                                            {
                                                "example_id": "45108afc-ed0d-4a67-8955-f1570452c957",
                                                "sense_id": "ebcb984f-4abb-3800-89a2-ed99c66f38cd",
                                                "text": "Die Bezeichnung „aromatisiert“ dagegen erlaubt den Einsatz synthetisch produzierter Aromen. Sie werden regelmäßig aus Rohöl hergestellt und haben mit der Frucht, die dem Tee den Namen gibt, nichts zu tun."
                                            },
                                            {
                                                "example_id": "23f96698-0c7d-45e2-88c9-e12484e8cdcd",
                                                "sense_id": "ebcb984f-4abb-3800-89a2-ed99c66f38cd",
                                                "text": "Mit flüssigem Kaffee bzw. Espresso oder Mokka lassen sich Cremes, Mousses, Eis, Sorbets, Sabayons und andere Desserts, wie das klassische Tiramisu, aromatisieren."
                                            },
                                            {
                                                "example_id": "700f0bb5-f0d6-4a69-8d48-96a51d50de21",
                                                "sense_id": "ebcb984f-4abb-3800-89a2-ed99c66f38cd",
                                                "text": "Auch Desserts wie Pudding und Eis lassen sich damit aromatisieren, sie bekommen eine an Bittermandel erinnernde Note."
                                            },
                                            {
                                                "example_id": "ec435fd7-5c6a-41d5-8722-f726e3cf384e",
                                                "sense_id": "ebcb984f-4abb-3800-89a2-ed99c66f38cd",
                                                "text": "Die Cremes sind in zwei verschiedenen Varianten erhätlich: Kakao oder Karamell. Mit diesen Produkten können Sie ebenfalls Cremes und Puddings aromatisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
