                    {
                        "sense_id": "6079fe82-39f9-3180-b814-63b912126e79",
                        "entry_id": "65623002-322b-3d74-a695-ab1ba0815a0f",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b15ca97-5b03-4888-8b67-24a9034f63d5",
                                "sense_id": "6079fe82-39f9-3180-b814-63b912126e79",
                                "text": "Meine Adoptivschwester musste Oliver jüngst darüber aufklären, dass er einen Sohn hat."
                            }
