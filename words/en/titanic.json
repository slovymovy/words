{
    "word_family": [
        "titan",
        "titanium",
        "titanate",
        "titanite",
        "titaniferous"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f02ec954-16a6-377f-b4f0-c538b8062f50",
                    "sense_definition": "Having colossal size, exceptional force, power, or strength.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers made a <w>titanic</w> effort to complete the bridge before winter.",
                            "target_lang_translations": {
                                "zh": "工人们付出了<w>巨大</w>的努力，以便在入冬前建成这座大桥。"
                            }
                        },
                        {
                            "text": "The explosion sent up a <w>titanic</w> cloud of smoke visible for miles.",
                            "target_lang_translations": {
                                "zh": "爆炸升起了一团<w>巨大</w>的浓烟，几英里外都清晰可见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colossal",
                        "enormous",
                        "gigantic",
                        "immense",
                        "mammoth",
                        "massive"
                    ],
                    "common_phrases": [
                        "titanic effort",
                        "titanic struggle"
                    ],
                    "target_lang_definitions": {
                        "zh": "巨大的；力量或规模极其庞大的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "指规模、力量或体积极大"
                            },
                            {
                                "target_lang_word": "无比巨大的",
                                "target_lang_sense_clarification": "强调非凡的程度或力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af3df5fe-061a-3770-ae32-3914089e5cb7",
                    "sense_definition": "Of a contest, conflict, or struggle: involving monumental scale or equally formidable opponents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The championship match was a <w>titanic</w> battle that lasted over five hours.",
                            "target_lang_translations": {
                                "zh": "这场冠军争夺战是一场持续了五个多小时的<w>激烈鏖战</w>。"
                            }
                        },
                        {
                            "text": "Both companies were locked in a <w>titanic</w> clash for control of the market.",
                            "target_lang_translations": {
                                "zh": "两家公司为了争夺市场控制权陷入了一场<w>规模巨大的</w>激烈较量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "epic",
                        "monumental"
                    ],
                    "common_phrases": [
                        "titanic battle",
                        "titanic clash"
                    ],
                    "target_lang_definitions": {
                        "zh": "（斗争、比赛等）规模宏大的，势均力敌且异常激烈的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "激烈宏大的",
                                "target_lang_sense_clarification": "用于斗争或对抗"
                            },
                            {
                                "target_lang_word": "惊心动魄的",
                                "target_lang_sense_clarification": "指场面壮烈、规模巨大的较量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91c30ad1-3f27-30b7-9e74-bb19a1010248",
                    "sense_definition": "Of or relating to the Titans of Greek mythology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient poet recounted the <w>titanic</w> rebellion against the Olympian gods.",
                            "target_lang_translations": {
                                "zh": "这位古代诗人讲述了反抗奥林匹斯诸神的<w>泰坦神族</w>叛乱。"
                            }
                        },
                        {
                            "text": "Several classical myths depict the defeat of the <w>titanic</w> deities by Zeus.",
                            "target_lang_translations": {
                                "zh": "有几则经典神话描绘了宙斯击败<w>提坦</w>神祇的故事。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "希腊神话中泰坦神族的；提坦神的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泰坦神族的",
                                "target_lang_sense_clarification": "与古希腊神话中的提坦神相关"
                            },
                            {
                                "target_lang_word": "提坦的",
                                "target_lang_sense_clarification": "神话名词修饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0743c20a-7bab-3222-9c1f-184e08b7e057",
                    "sense_definition": "Of or relating to titanium, especially containing tetravalent titanium.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist prepared a sample of <w>titanic</w> acid for the experiment.",
                            "target_lang_translations": {
                                "zh": "化学家为实验配制了一份<w>钛</w>酸样品。"
                            }
                        },
                        {
                            "text": "White pigment often relies on <w>titanic</w> oxide for opacity.",
                            "target_lang_translations": {
                                "zh": "白色颜料通常依靠二氧<w>化钛</w>来提供遮盖力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "titanic acid",
                        "titanic oxide"
                    ],
                    "target_lang_definitions": {
                        "zh": "（化学）四价钛的；含钛的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钛的",
                                "target_lang_sense_clarification": "特指四价钛化合物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f66a5f01-7ea1-3093-89e9-9e3adb72e29f",
                    "sense_definition": "Containing titanium or from which titanium may be extracted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mining company discovered large deposits of <w>titanic</w> iron ore.",
                            "target_lang_translations": {
                                "zh": "矿业公司发现了大量的<w>含钛</w>铁矿床。"
                            }
                        },
                        {
                            "text": "Extracting metals from <w>titanic</w> sand requires specialized industrial processes.",
                            "target_lang_translations": {
                                "zh": "从<w>含钛</w>沙矿中提取金属需要专门的工业工艺。"
                            }
                        }
                    ],
                    "synonyms": [
                        "titaniferous"
                    ],
                    "common_phrases": [
                        "titanic iron ore"
                    ],
                    "target_lang_definitions": {
                        "zh": "（矿物或地质）含钛的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "含钛的",
                                "target_lang_sense_clarification": "指含有钛元素的矿石或沙等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da169955-6e66-344d-aa5f-777d56cd8b5e",
                    "sense_definition": "A project or venture that fails spectacularly, especially one doomed by hubris or overconfidence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper financial planning, the ambitious merger could turn into another <w>Titanic</w>.",
                            "target_lang_translations": {
                                "zh": "如果没有妥善的财务规划，这场野心勃勃的并购可能会演变成又一场<w>泰坦尼克般的惨败</w>。"
                            }
                        },
                        {
                            "text": "Critics warned that the expensive tech startup was a <w>Titanic</w> destined for disaster.",
                            "target_lang_translations": {
                                "zh": "批评人士警告称，这家耗资巨大的科技初创公司注定会像<w>泰坦尼克号</w>一样走向毁灭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "debacle",
                        "fiasco"
                    ],
                    "common_phrases": [
                        "another Titanic"
                    ],
                    "target_lang_definitions": {
                        "zh": "注定惨败的庞大计划或事业；灾难性的溃败"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泰坦尼克般的惨败",
                                "target_lang_sense_clarification": "喻指因盲目自大而注定失败的庞大项目"
                            },
                            {
                                "target_lang_word": "灾难性的惨剧",
                                "target_lang_sense_clarification": "比喻彻底崩溃的庞大事业"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d987cead-dd5f-3e7f-87e9-1ab53c3d3a7c",
                    "sense_definition": "The RMS Titanic, a British passenger ocean liner that sank in 1912 after striking an iceberg.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "The <w>Titanic</w> sank on its maiden voyage across the Atlantic Ocean.",
                            "target_lang_translations": {
                                "zh": "<w>泰坦尼克号</w>在横渡大西洋的处女航中沉没。"
                            }
                        },
                        {
                            "text": "Many historical artifacts were recovered from the wreckage of the <w>Titanic</w>.",
                            "target_lang_translations": {
                                "zh": "人们从<w>泰坦尼克号</w>的残骸中打捞出了许多历史文物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sinking of the Titanic"
                    ],
                    "target_lang_definitions": {
                        "zh": "泰坦尼克号（1912年撞冰山沉没的英国远洋客轮）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泰坦尼克号",
                                "target_lang_sense_clarification": "著名客轮名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}