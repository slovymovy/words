        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28947dd6-0a30-3bfe-9113-9f3e91f4f51b",
                    "sense_definition": "To lay straw around plants to protect them from frost.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener <w>strawed</w> the delicate plants before the winter freeze began.",
                            "target_lang_translations": {
                                "ru": "Садовник <w>укрыл соломой</w> нежные растения до начала зимних заморозков.",
                                "tr": "Bahçıvan kış donları başlamadan önce hassas bitkileri <w>samanla</w> örttü.",
                                "zh": "园丁在寒冬来临前给娇嫩的植物<w>覆盖</w>了稻草。"
                            }
                        },
                        {
                            "text": "We need to <w>straw</w> the strawberry patch to keep the fruit clean.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>обложить соломой</w> грядку с клубникой, чтобы ягоды оставались чистыми.",
                                "tr": "Meyveleri temiz tutmak için çilek tarlasını <w>samanla</w> kaplamamız gerekiyor.",
                                "zh": "我们需要在草莓地里<w>铺上</w>稻草，以保持果实清洁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "agricultural context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обкладывать растения соломой для защиты от мороза.",
                        "tr": "Bitkileri dondan korumak için etraflarına saman sermek.",
                        "zh": "在植物周围铺上稻草以防霜冻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрывать соломой",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
