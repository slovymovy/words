                "senses": [
                    {
                        "sense_id": "11d3422c-8b6e-328a-9cab-651171a2a00d",
                        "entry_id": "fbd1c61d-3674-39a6-8363-44b117d504e9",
                        "glosses": [
                            "seltsamer, stark fremdartiger Geschmack bei Weinen von amerikanischen Wildreben einschließlich deren Kreuzungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc0b2fe4-5c7e-4b96-bcd2-14343fbcb16e",
                                "sense_id": "11d3422c-8b6e-328a-9cab-651171a2a00d",
                                "text": "„Der Geschmack ähnelt dem der Isabellentraube, manche nennen ihn Wanzengeschmack. Wer jedoch einen drei bis vier Jahre alten Wein von der schwarzen Johannisbeere getrunken, wird die Frucht mit anderen Augen betrachten […].“"
                            },
                            {
                                "example_id": "295c2774-6812-4efd-a296-93c0328226ad",
                                "sense_id": "11d3422c-8b6e-328a-9cab-651171a2a00d",
                                "text": "„Das strenge Aroma (Erdbeer-, Himbeer-, Muskatsller- und Wanzen-Geschmack) kann durch das Filter soweit beseitigt werden, dass nur ein höchst feines Aroma bleibt, und auch dieses mildert sich mit dem Alter des Weines.“"
                            }
                        ],
