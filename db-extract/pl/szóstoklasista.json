                                "target_senses": [
                                    {
                                        "sense_id": "a2ce52e8-ff93-31df-b766-56f674d37db5",
                                        "entry_id": "cb3bf3e5-0e68-34cf-ab90-f30a55c632a1",
                                        "glosses": [
                                            "ученик шестого класса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f57b59b9-cdea-4910-980e-bb55b729bd70",
                                                "sense_id": "a2ce52e8-ff93-31df-b766-56f674d37db5",
                                                "text": "…весной он вообразил, что влюбился в худенькую, маленькую, начитанную и серьёзную гимназистку Юшкову, подружился с шестиклассником в очках Симашко и решил посвятить все каникулы самообразованию."
                                            }
