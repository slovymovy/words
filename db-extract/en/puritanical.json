                ],
                "senses": [
                    {
                        "sense_id": "31ad2c91-cb04-32ce-b2f2-db0850990894",
                        "entry_id": "09343d34-fbea-33de-818a-2e382e8ef373",
                        "glosses": [
                            "Of or pertaining to the Puritans, or to their doctrines and practice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287e0a13-ce8b-4291-8823-4ac133c2cb29",
                                "sense_id": "31ad2c91-cb04-32ce-b2f2-db0850990894",
                                "text": "The host proposed divers puritanical fancies—nay, once hinted at a head of Cromwell himself; but the hostess overruled all these proposals, and stood firm by the Sun."
                            }
                        ]
                    },
                    {
                        "sense_id": "941a80c4-456a-3c6c-9b16-552c943ec51f",
                        "entry_id": "09343d34-fbea-33de-818a-2e382e8ef373",
                        "glosses": [
                            "Precise in observance of legal or religious requirements; strict; overscrupulous; rigid (often used by way of reproach or contempt)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2182d22-c157-46c9-a165-15b76ae54d21",
                                "sense_id": "941a80c4-456a-3c6c-9b16-552c943ec51f",
                                "text": "Exogamy […] has few or none of the quaint superstitions which lend a certain picturesque charm to totemism. It is, so to say, a stern Puritanical institution. Its rigid logic, its complex rules, its elaborate terminology, its labyrinthine systems of relationship, it presents an aspect somewhat hard and repellant."
                            },
                            {
                                "example_id": "dcf296a9-5707-46b3-a34b-113e73127d2c",
                                "sense_id": "941a80c4-456a-3c6c-9b16-552c943ec51f",
                                "text": "American society has a double standard when it comes to sexuality. We have a puritanical taboo against talking about sexuality directly, yet we are fine with the sexual images that pervade television and glossy magazines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7919733d-1060-4ff8-aafa-3cd509db3338",
                        "source_entry_id": "09343d34-fbea-33de-818a-2e382e8ef373",
                        "source_sense_description": "of or pertaining to the Puritans",
                        "target_lang_word": "puritanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puritanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef264fc-6e9f-31d5-b46c-497be63c870f",
                                        "entry_id": "a9599e4c-03e9-33f5-a999-a34cb2c8b2ac",
                                        "glosses": [
                                            "den Puritanismus betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed3c05f-60d2-4363-ad94-bd5319279d3f",
                                                "sense_id": "3ef264fc-6e9f-31d5-b46c-497be63c870f",
                                                "text": "„Die Familie nahm in der puritanischen Gesellschaftsordnung Neuenglands eine hohe Stellung ein, sie wurde als »Kirche im Kleinen« bezeichnet.“"
                                            },
                                            {
                                                "example_id": "e51c578a-9db9-44f3-85f7-bc83d05d0006",
                                                "sense_id": "3ef264fc-6e9f-31d5-b46c-497be63c870f",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ae71ce3-f696-3b8a-9f71-c56ce9d21a88",
                                        "entry_id": "a9599e4c-03e9-33f5-a999-a34cb2c8b2ac",
                                        "glosses": [
                                            "auf das Wesentliche beschränkt, einfach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36045079-fa8b-455c-9b17-6e113cd78dd6",
                                                "sense_id": "2ae71ce3-f696-3b8a-9f71-c56ce9d21a88",
                                                "text": "„Das neogotische Wohnhaus im Hintergrund sowie die aus der Mimik sprechende puritanische Lebensweise und strenge Gläubigkeit werden durch den Titel ausdrücklich betont: «Amerikanische Gotik».“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "984d982b-c19d-3368-9481-8ad419f4c0e8",
                                        "entry_id": "a9599e4c-03e9-33f5-a999-a34cb2c8b2ac",
                                        "glosses": [
                                            "sittenstreng, sehr tugendhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8f6ce6-3d42-447c-ba8f-4883229f2b7b",
                                                "sense_id": "984d982b-c19d-3368-9481-8ad419f4c0e8",
                                                "text": "„Nur das puritanisch enge Korsett der Hofgesellschaft schnürt ihr die Luft ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
