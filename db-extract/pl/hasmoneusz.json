                "senses": [
                    {
                        "sense_id": "b9e91295-6856-3c73-8c16-0c8c750ddc2a",
                        "entry_id": "8d51038f-fbf2-3ccb-a7a7-87603a099a49",
                        "glosses": [
                            "przedstawiciel dynastii Hasmoneuszy (1.1)"
                        ],
                        "tags": [],
