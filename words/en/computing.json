                {
                    "sense_id": "7a569eaf-69a4-3e92-8093-8d1d0f8dcfd7",
                    "sense_definition": "The process or act of calculation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex <w>computing</w> required for the simulation took several hours.",
                            "target_lang_translations": {
                                "ru": "Сложные <w>вычисления</w>, необходимые для симуляции, заняли несколько часов.",
                                "pl": "Skomplikowane <w>obliczenia</w> wymagane do symulacji zajęły kilka godzin."
                            }
                        },
                        {
                            "text": "Errors in <w>computing</w> can lead to incorrect financial results.",
                            "target_lang_translations": {
                                "ru": "Ошибки в <w>расчётах</w> могут привести к неверным финансовым результатам.",
                                "pl": "Błędy w <w>obliczeniach</w> mogą prowadzić do nieprawidłowych wyników finansowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "calculation",
                        "computation",
                        "reckoning"
                    ],
                    "target_lang_definitions": {
