                                "target_senses": [
                                    {
                                        "sense_id": "1c1f03f9-6a72-3176-93ce-272b27ae6acc",
                                        "entry_id": "05b0ccd5-5154-3972-85e0-782b602e1af3",
                                        "glosses": [
                                            "Not helpful to users; difficult for an untrained person to use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa66068-8456-40b7-af37-ff64448159b4",
                                                "sense_id": "1c1f03f9-6a72-3176-93ce-272b27ae6acc",
                                                "text": "Does the [rail] industry really want customers? If so, why does it make the whole ticketing experience so user-unfriendly?"
                                            }
