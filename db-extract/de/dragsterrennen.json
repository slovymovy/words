                        "sense_id": "ed7b4f5d-58e7-33b2-8c83-677495ccb468",
                        "entry_id": "9f92a863-0252-3db9-89a1-ee21f88801df",
                        "glosses": [
                            "Wettrennen, das mit Dragstern ausgetragen wird"
