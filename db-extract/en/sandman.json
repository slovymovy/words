                    {
                        "translation_id": "7c08089a-1c94-4da5-ac48-596a953380a7",
                        "source_entry_id": "3294b01e-d4b5-3be8-8b79-3f335e82e260",
                        "source_sense_description": "figure who brings good sleep and dreams",
                        "target_lang_word": "marchand de sable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marchand de sable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                        "entry_id": "51976778-3775-37eb-a07d-118febeba3d8",
                                        "glosses": [
                                            "Personnage mythique versant du sable sur les yeux des enfants pour les endormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b746e11-a9b6-4279-b130-59bec760abba",
                                                "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                                "text": "Le marchand de sable venait de m’en lancer une bonne poignée."
                                            },
                                            {
                                                "example_id": "610f57b4-a480-4ac6-ba8d-6abe87c17caa",
                                                "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                                "text": "« Merci Niquedouille.\n— Fermez vos mignons petits yeux ensommeillés. Le marchand de sable va passer. »"
                                            },
                                            {
                                                "example_id": "96182132-aa92-46c1-b7e5-80286858f036",
                                                "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                                "text": "Nous apportons joie et rêve… Nous sommes le marchand de sable et la Fée des dents. Nous sommes le lapin de Pâques et le père Noël."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98cd905a-1e9d-4074-a491-24470b5945d2",
                        "source_entry_id": "3294b01e-d4b5-3be8-8b79-3f335e82e260",
                        "source_sense_description": "figure who brings good sleep and dreams",
                        "target_lang_word": "Sandmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f937df0d-35a6-339b-8ccd-ba905b822b4e",
                                        "entry_id": "5b0a17e7-abdc-374f-a8c6-326a47bafb8a",
                                        "glosses": [
                                            "Figur des westlichen Volksmythos, die kleine Kinder besucht und zum Einschlafen bringt, indem sie ihnen Sand in die Augen streut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63bfd9f0-c1db-43f6-97f1-51cc6aa84fd0",
                                                "sense_id": "f937df0d-35a6-339b-8ccd-ba905b822b4e",
                                                "text": "Der Sandmann ist auch eine Figur des westdeutschen Rundfunks, die dem „Sandmännchen“ im DDR-Rundfunk entspricht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bb050d5-a470-34b7-84b5-83af0f2d2f05",
                                        "entry_id": "5b0a17e7-abdc-374f-a8c6-326a47bafb8a",
                                        "glosses": [
                                            "im Herzogtum Schleswig verwendete Bezeichnung für einen Titel von Gerichtsbeisitzern im Dänischen Königreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88162b6-a154-4de9-8822-5cfc4b6bed0c",
                                                "sense_id": "7bb050d5-a470-34b7-84b5-83af0f2d2f05",
                                                "text": "„Vom königlichen Vogt wurden jeweils acht Sandmänner für jede Harde als Richter ernannt, deren Rechtsprechung bei Totschlag, Verstümmelung, Heerwerk, Notzucht und Streitigkeiten um Feldscheiden erforderlich wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sandmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0515fb7e-564f-35cb-b9e2-5d857df21679",
                                        "entry_id": "6506454b-2f21-3cb9-9c8b-d1be61afa0f7",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
