                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla początkującego śpiewaka duża <w>odległość</w> między kolejnymi dźwiękami melodii bywa trudna do czystego zaśpiewania.",
                            "target_lang_translations": {
