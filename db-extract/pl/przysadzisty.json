                "senses": [
                    {
                        "sense_id": "0cc95667-4247-35cb-bcef-ed2511888708",
                        "entry_id": "64449277-1b92-30e6-9636-d3a5e3fa51e7",
                        "glosses": [
                            "nieproporcjonalnie gruby w stosunku do wysokości lub wzrostu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c13f53e-0edb-4d5a-b4ae-6d64c7272dc7",
                                "sense_id": "0cc95667-4247-35cb-bcef-ed2511888708",
                                "text": "… przysadziste jak jamniki Amilkary …"
                            },
                            {
                                "example_id": "be48fa44-b355-4e26-9adb-508ee6c6990d",
                                "sense_id": "0cc95667-4247-35cb-bcef-ed2511888708",
                                "text": "Przysadzista, o dziwacznie poskręcanych konarach wierzba rzucała na ziemię trochę cienia"
                            },
                            {
                                "example_id": "c529579a-6826-4473-89c4-95b7598b3a08",
                                "sense_id": "0cc95667-4247-35cb-bcef-ed2511888708",
                                "text": "Nad przysadzistymi domostwami snują się dymy"
                            },
                            {
                                "example_id": "20c5fa3f-4d2d-4ab4-8f8c-863b24ec26a5",
                                "sense_id": "0cc95667-4247-35cb-bcef-ed2511888708",
                                "text": "Pszczoły ułożyły się już do snu w błękitnym tłumie przysadzistych ulów, za którymi w migotliwych światłach zachodu cicho stały rozłożyste wieczorniki i wysokie malwy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "282ea1bf-165c-3753-bb09-da806e89b3eb",
                        "entry_id": "64449277-1b92-30e6-9636-d3a5e3fa51e7",
                        "glosses": [
                            "o ludziach: niskiego wzrostu i grubokościstej budowy, przy znacznych rozmiarach swej postawy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a56a0f8b-bd4c-4c0e-8e6f-8c831b90df15",
                                "sense_id": "282ea1bf-165c-3753-bb09-da806e89b3eb",
                                "text": "Baby z makutrą, wiadrem, dzbanem. Przysadziste, ubrane w kolorowe stroje"
                            },
                            {
                                "example_id": "5fcb8515-e4b6-4f46-91e5-4cc25bd119a4",
                                "sense_id": "282ea1bf-165c-3753-bb09-da806e89b3eb",
                                "text": "Na zakręcie alei ukazał się pan[,] przysadzisty, krępy, w jasnym wiosennym palcie, w kapeluszu na bakier, pośpieszał, kiwając się na obie strony"
                            },
                            {
                                "example_id": "61c23501-9b78-4d6c-80c1-086a66eaccfd",
                                "sense_id": "282ea1bf-165c-3753-bb09-da806e89b3eb",
                                "text": "Twarz jej była czerwona i piegowata nieco, postać cała przysadzista i krępa"
                            },
                            {
                                "example_id": "8b5f5d8b-b10f-4687-b74e-c4c1ed49255c",
                                "sense_id": "282ea1bf-165c-3753-bb09-da806e89b3eb",
                                "text": "Miejsce za lepkim kontuarem zajęła przysadzista kobieta, zapewne żona muskularnego właściciela, który gdzieś zniknął"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
