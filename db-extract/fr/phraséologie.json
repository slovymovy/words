                                "target_senses": [
                                    {
                                        "sense_id": "10c75d38-0402-37fd-a681-e0aee67a52a1",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "Study of set or fixed expressions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1574c467-9315-3430-b706-67f4a0735e10",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "The style in which words and phrases are used in writing or speech."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf2e738-da27-450b-a7aa-ba2be9b24464",
                                                "sense_id": "1574c467-9315-3430-b706-67f4a0735e10",
                                                "text": "I was riding through the forest, when suddenly (pray correct my phraseology if too worldly—you know I am not well read in these epics of the heart) I saw a knight and his lady traversing one of the glades; the golden sunshine fell athwart the green leaves, and showed their white steeds and whiter plumes, while the air around grew musical with their gentle words and laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "A group of specialized words and expressions used by a particular group."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024ce262-63bb-4ca9-8ffe-078c128e67d2",
                                                "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                                "text": "Fortunately, two servants she had brought with her, were devotedly attached to their mistress; and the others only entering her apartments at rare intervals, did not understand her mystic allusions; and she now, more than ever, affected to veil her meaning under the mysterious phraseology so much adopted by the Jacobites."
                                            },
                                            {
                                                "example_id": "7cae9367-80ee-4878-858f-a0981e7a7a1c",
                                                "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                                "text": "Railway grouping had caused some peculiarly Scottish phraseology to disappear, though the note \"Stops on timous notice to the guard\" survived until comparatively recently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30186e8d-c8e4-3375-8503-03754d112f78",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "A collection of phrases; a phrasebook."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
