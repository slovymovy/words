                            },
                            {
                                "target_lang_word": "обыск",
                                "target_lang_sense_clarification": "тщательный поиск, часто сопровождающийся беспорядком"
                            },
                            {
                                "target_lang_word": "погром",
                                "target_lang_sense_clarification": "насильственные действия, приводящие к разрушению и беспорядку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
