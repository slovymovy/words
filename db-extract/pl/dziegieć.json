                    {
                        "translation_id": "28c1048c-62e0-4b22-b9af-2265fa5b5159",
                        "source_entry_id": "88a8880e-7192-39a5-b75c-c0cf98a9720e",
                        "source_sense_id": "cadd1a7f-c69f-3615-8b1a-1a44d6f5c438",
                        "source_sense_description": "Chemie, Pharmazie: Birkenpech, Pech, Teer",
                        "target_lang_word": "Birkenpech",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birkenpech",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da27debe-cd5a-34a0-b1be-32c861d0d8c4",
                                        "entry_id": "edc600a7-8f96-3989-bf4e-6d148548a23d",
                                        "glosses": [
                                            "teerartiges Destillat, das aus der Birkenrinde gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77914efc-4a67-4307-8026-f03c9dbd682e",
                                                "sense_id": "da27debe-cd5a-34a0-b1be-32c861d0d8c4",
                                                "text": "„Die Trockendestillation von Birkenrinde lieferte Birkenpech, den ersten Klebstoff der Menschheitsgeschichte, der dem Frühmenschen zur Herstellung von Werkzeugen diente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fc8dca7-14f7-4173-ba6c-2b3799f2a7b6",
                        "source_entry_id": "88a8880e-7192-39a5-b75c-c0cf98a9720e",
                        "source_sense_id": "cadd1a7f-c69f-3615-8b1a-1a44d6f5c438",
                        "source_sense_description": "Chemie, Pharmazie: Birkenpech, Pech, Teer",
                        "target_lang_word": "Pech",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pech",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                        "entry_id": "8face483-b5d1-3f77-a152-0663b742bd65",
                                        "glosses": [
                                            "Rückstand bei der Teerherstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafabc1b-3221-471a-9d71-6989ab229f4c",
                                                "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                                "text": "Pech ist eine schwarze klebrige Masse."
                                            },
                                            {
                                                "example_id": "d8690f06-9c21-4209-882f-f05f0b4bedb3",
                                                "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                                "text": "„Der Kapitän hatte Cooper befohlen, etwas Pech in der Kombüse zu kochen.“"
                                            },
                                            {
                                                "example_id": "bc35b1cb-a3f7-4ce0-ab45-63a879d4eb15",
                                                "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                                "text": "„Für den Fisch brauchte man Fässer, für die Fässer Dauben, für die Dauben Holz und gegen die Luft dazwischen Pech.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                        "entry_id": "8face483-b5d1-3f77-a152-0663b742bd65",
                                        "glosses": [
                                            "Harz"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09d8d3b-f540-4ceb-8c28-f9950eea5c5d",
                                                "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                                "text": "Als er den Ast abgebrochen hatte, drang Pech aus dem Baum."
                                            },
                                            {
                                                "example_id": "dd7732ca-6926-4636-924a-7194e39e6ced",
                                                "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                                "text": "„Holzfässer sind innen mit Pech (einem Produkt aus Kiefernharz) ausgekleidet.“"
                                            },
                                            {
                                                "example_id": "d180268d-e85a-4ce2-be6e-cae8bbb80078",
                                                "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                                "text": "„Dann setzte er sich auf einen Stock, aus dessen Poren just kein Pech floß, und schaute den Holzhauern zu bei ihrer Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0792a5a5-7cda-3b85-b44e-81777cc45a83",
                                        "entry_id": "8face483-b5d1-3f77-a152-0663b742bd65",
                                        "glosses": [
                                            "Misserfolg, unglücklicher Zufall"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0393e5c1-9168-408a-8ccc-3b60c02931e0",
                                                "sense_id": "0792a5a5-7cda-3b85-b44e-81777cc45a83",
                                                "text": "Er hatte viel Pech in seinem Leben; vieles, was er anpackte, missglückte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c729c265-7df3-472e-ae67-113dd85e80a6",
                        "source_entry_id": "88a8880e-7192-39a5-b75c-c0cf98a9720e",
                        "source_sense_id": "cadd1a7f-c69f-3615-8b1a-1a44d6f5c438",
                        "source_sense_description": "Chemie, Pharmazie: Birkenpech, Pech, Teer",
                        "target_lang_word": "Teer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                        "entry_id": "298bc57a-dab6-31bd-919b-2bc8db0f3718",
                                        "glosses": [
                                            "braunschwarze, dicke, fette, klumpige, ölig-klebrige Flüssigkeit von scharfem Geruch, die durch trockenes Erhitzen organischer Stoffe (zum Beispiel Kohle) unter Luftabschluss entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de0a413-da82-4071-83f0-8b15c71df015",
                                                "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                                "text": "Teer aus Steinkohle ist eins der wichtigsten Ausgangsprodukte für die Großindustrie."
                                            },
                                            {
                                                "example_id": "84a8d550-d07b-4c1d-b2f5-038cbd11f931",
                                                "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                                "text": "„Das Teer wird, nachdem es dicker oder dünner, dunkler oder heller ist, unter den Namen: Wagenteer, Radteer, Schiffteer, in Tonnen verkauft.“"
                                            },
                                            {
                                                "example_id": "5e676ab4-bc50-44e5-886e-04a6a5fbf124",
                                                "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                                "text": "„Demnach ist sowohl das Kondensat als auch das Teer wesentlich giftiger als der inhalierte Rauch.“"
                                            },
                                            {
                                                "example_id": "76ef9609-c80a-4d64-b0fa-8ea9aa074a18",
                                                "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                                "text": "„Wenn das Fahrzeug weiterfährt und das Teer aus den Behältern auf die Straße gelangt, so dreht sich der Reißwolf weiter.“"
                                            },
                                            {
                                                "example_id": "4fd91dac-f5f8-4f09-bfc9-90c06eafd5c3",
                                                "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                                "text": "„Ein Mob rottete sich zusammen, er baute ein Feuerfloß, kam längsseits unseres Schiffs und verlangte Teer.“"
                                            },
                                            {
                                                "example_id": "3273af23-53ab-4c79-8050-05ca23a3628f",
                                                "sense_id": "5c5e3bd0-c33b-3b33-8687-58414e364477",
                                                "text": "„Egal, sie hatte gefunden, wonach sie gesucht hatte: eine mit Teer versiegelte Flasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
