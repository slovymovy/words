                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6b56bc3-1be2-3cce-88fb-b1e39fb83604",
                        "entry_id": "a4d0b846-bfcc-3db9-b048-61f7cf307831",
                        "glosses": [
                            "разг. произвести выстрел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13bb25c0-957c-49d9-aab2-13e708faeaaf",
                                "sense_id": "d6b56bc3-1be2-3cce-88fb-b1e39fb83604",
                                "text": "Я раза три стрельнул ему вслед, но не попал."
                            },
                            {
                                "example_id": "3442fa70-5ac6-484a-8b1b-ca30ae1825ee",
                                "sense_id": "d6b56bc3-1be2-3cce-88fb-b1e39fb83604",
                                "text": "Стрельнуть из пушки."
                            },
                            {
                                "example_id": "ab264bc4-e39f-493d-a19d-4011ee46a4fc",
                                "sense_id": "d6b56bc3-1be2-3cce-88fb-b1e39fb83604",
                                "text": "Стрельнуть порохом."
                            },
                            {
                                "example_id": "324c43ee-2039-4e35-bfe0-8ba95d886023",
                                "sense_id": "d6b56bc3-1be2-3cce-88fb-b1e39fb83604",
                                "text": "Стрельнуть из лука."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a071d90-43b8-3ae2-843f-84619f62945c",
                        "entry_id": "a4d0b846-bfcc-3db9-b048-61f7cf307831",
                        "glosses": [
                            "издать громкий резкий отрывистый звук, похожий на выстрел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "215977ab-0b4b-4c48-8878-4e7e71553fab",
                                "sense_id": "6a071d90-43b8-3ae2-843f-84619f62945c",
                                "text": "Стрельнуть искрами, дымом."
                            },
                            {
                                "example_id": "81c82819-a15f-40ae-a9de-2482682c110b",
                                "sense_id": "6a071d90-43b8-3ae2-843f-84619f62945c",
                                "text": "В печке стрельнуло."
                            },
                            {
                                "example_id": "f8843502-222f-4280-9322-84d9c22e02f0",
                                "sense_id": "6a071d90-43b8-3ae2-843f-84619f62945c",
                                "text": "Под ногами стрельнула половица."
                            }
                        ]
                    },
                    {
                        "sense_id": "57f05eae-5d64-3c8e-b833-5ecf2024d6ab",
                        "entry_id": "a4d0b846-bfcc-3db9-b048-61f7cf307831",
                        "glosses": [
                            "разг. проявиться, почувствоваться (о резком болевом ощущении, о колотье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ce06e7-9c03-42ac-baac-10015990191f",
                                "sense_id": "57f05eae-5d64-3c8e-b833-5ecf2024d6ab",
                                "text": "В ухе стрельнуло!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5befb155-832a-3f46-9e28-cefa6b322d43",
                        "entry_id": "a4d0b846-bfcc-3db9-b048-61f7cf307831",
                        "glosses": [
                            "прост. быстро, стремительно пробежать, промелькнуть или убежать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cc37818-dc33-4bb3-9468-c94144adf7aa",
                                "sense_id": "5befb155-832a-3f46-9e28-cefa6b322d43",
                                "text": "Я отыскал дядю в саду… Он был с Настенькой. Увидя меня, Настенька стрельну́ла в кусты, как будто виноватая."
                            },
                            {
                                "example_id": "e9773344-1f4c-4102-a11c-68e30ba522a2",
                                "sense_id": "5befb155-832a-3f46-9e28-cefa6b322d43",
                                "text": "— За оврагом лиса как стрельнёт из-под самых ног, я ружья не взял! Хоть плачь с досады!"
                            }
                        ]
                    },
                    {
                        "sense_id": "227e9e89-560e-3fec-9f7e-e041f6fd2c91",
                        "entry_id": "a4d0b846-bfcc-3db9-b048-61f7cf307831",
                        "glosses": [
                            "быстро и на очень короткое время изменить направление взгляда или направить взгляд на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4217bc18-f03b-4e92-ab4f-8edeb94e8068",
                                "sense_id": "227e9e89-560e-3fec-9f7e-e041f6fd2c91",
                                "text": "Иван привычно стрельнул глазами вслед девушке."
                            }
                        ]
                    }
                ],
