                    "frequency": "High",
                    "semantic_group_id": "cosmos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes étudient l'origine et l'évolution de notre <w>univers</w> depuis des décennies."
                        },
                        {
                            "text": "Selon les scientifiques, l'<w>univers</w> est né il y a environ quatorze milliards d'années."
                        }
                    ],
                    "synonyms": [
