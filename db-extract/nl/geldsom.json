                                        "entry_id": "3079e00b-b239-38bb-90d8-34b059d8e0d8",
                                        "glosses": [
                                            "A quantity or volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedf877f-e66d-4721-a3d0-6b0443b2396f",
                                                "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                                "text": "Pour a small amount of water into the dish."
                                            },
                                            {
                                                "example_id": "24130b9b-d7aa-42c6-8afa-4a4179a58178",
                                                "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                                "text": "The dogs need different amounts of food."
                                            },
                                            {
                                                "example_id": "276af064-3b0e-46ad-a140-739669ce8c93",
                                                "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives.[…]who, if anyone, is policing their use[?] Such concerns were sharpened further by the continuing revelations about how the US National Security Agency (NSA) has been using algorithms to help it interpret the colossal amounts of data it has collected from its covert dragnet of international telecommunications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0776ab34-46ea-3f11-b923-8d11b931a873",
                                        "entry_id": "3079e00b-b239-38bb-90d8-34b059d8e0d8",
                                        "glosses": [
                                            "The number (the sum) of elements in a set."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3f6330-2ef7-472d-821e-7dc112e95e21",
                                                "sense_id": "0776ab34-46ea-3f11-b923-8d11b931a873",
                                                "text": "The final amount of students who have participated to mobility for the period 1995-1999 is held to be around 460 000."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
