{
    "word_family": [
        "rapper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69a46808-6f83-3f60-8ea7-89f64eaa67bd",
                    "sense_definition": "A style of popular music where words are spoken or chanted rapidly and rhythmically over an instrumental beat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother listens to <w>rap</w> every day on his way to school.",
                            "target_lang_translations": {
                                "ru": "Мой брат слушает <w>рэп</w> каждый день по дороге в школу.",
                                "zh": "我弟弟每天上学的路上都会听<w>说唱</w>。"
                            }
                        },
                        {
                            "text": "The radio station plays a mix of pop and <w>rap</w>.",
                            "target_lang_translations": {
                                "ru": "Радиостанция играет смесь поп-музыки и <w>рэпа</w>.",
                                "zh": "这家电台播放流行音乐和<w>说唱</w>的混合曲目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rap music",
                        "rap artist",
                        "gangsta rap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль популярной музыки, в котором слова произносятся речитативом под ритмичный бит.",
                        "zh": "一种流行音乐风格，通过节奏感强的伴奏以快速、有节奏的口语或吟唱方式表现歌词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рэп",
                                "target_lang_sense_clarification": "музыкальный стиль"
                            },
                            {
                                "target_lang_word": "хип-хоп",
                                "target_lang_sense_clarification": "жанр музыки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说唱",
                                "target_lang_sense_clarification": "音乐风格"
                            },
                            {
                                "target_lang_word": "嘻哈",
                                "target_lang_sense_clarification": "音乐流派"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f2a9e0-ee3b-3845-9e9f-cd10a5405baf",
                    "sense_definition": "A quick, sharp blow or knock, often producing a sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strike_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a loud <w>rap</w> on the door late at night.",
                            "target_lang_translations": {
                                "ru": "Поздно ночью в дверь раздался громкий <w>стук</w>.",
                                "zh": "深夜时分，门上响起了巨大的<w>敲击</w>声。"
                            }
                        },
                        {
                            "text": "The teacher gave the student a <w>rap</w> on the knuckles for misbehaving.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>ударил</w> ученика по костяшкам пальцев за плохое поведение.",
                                "zh": "老师因为学生表现不好，<w>敲</w>了他的指关节以示惩戒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knock"
                    ],
                    "common_phrases": [
                        "rap on the door",
                        "rap on the knuckles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, резкий удар или стук, часто издающий звук.",
                        "zh": "快速而尖锐的敲击或打击，通常会发出声响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "звук удара"
                            },
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "резкое физическое воздействие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲击",
                                "target_lang_sense_clarification": "发出声音的动作"
                            },
                            {
                                "target_lang_word": "重击",
                                "target_lang_sense_clarification": "猛烈的打击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efb0bfdd-8493-38c8-b4ad-a25c3f9d93d2",
                    "sense_definition": "A criminal charge or the blame for a mistake or crime.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "blame_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to take the <w>rap</w> for his friend's mistake.",
                            "target_lang_translations": {
                                "ru": "Он решил взять <w>вину</w> на себя за ошибку друга.",
                                "zh": "他决定为朋友的错误<w>背黑锅</w>。"
                            }
                        },
                        {
                            "text": "The police pinned a robbery <w>rap</w> on the suspect.",
                            "target_lang_translations": {
                                "ru": "Полиция повесила <w>обвинение</w> в ограблении на подозреваемого.",
                                "zh": "警方将抢劫的<w>罪名</w>扣在了嫌疑人头上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blame",
                        "rapsheet"
                    ],
                    "common_phrases": [
                        "take the rap",
                        "beat the rap",
                        "bum rap"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in crime contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уголовное обвинение или вина за ошибку или преступление.",
                        "zh": "刑事指控或对错误、罪行承担的责任。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвинение",
                                "target_lang_sense_clarification": "юридическое"
                            },
                            {
                                "target_lang_word": "вина",
                                "target_lang_sense_clarification": "ответственность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指控",
                                "target_lang_sense_clarification": "法律上的控告"
                            },
                            {
                                "target_lang_word": "罪责",
                                "target_lang_sense_clarification": "承担的责任"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "407f887e-44d8-3f11-9bb1-649009d6614c",
                    "sense_definition": "A reputation or appraisal, often used to describe how someone or something is perceived.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reputation_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That restaurant has a bad <w>rap</w> for poor service.",
                            "target_lang_translations": {
                                "ru": "У этого ресторана дурная <w>слава</w> из-за плохого обслуживания.",
                                "zh": "那家餐厅因为服务差而<w>名声</w>不好。"
                            }
                        },
                        {
                            "text": "Despite his tough <w>rap</w>, he is actually very kind.",
                            "target_lang_translations": {
                                "ru": "Несмотря на его суровую <w>репутацию</w>, он на самом деле очень добрый.",
                                "zh": "尽管他给人一种强硬的<w>印象</w>，但他其实非常善良。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bad rap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Репутация или оценка, часто используемая для описания того, как кто-то или что-то воспринимается.",
                        "zh": "名声或评价，常用于描述某人或某事被外界感知的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репутация",
                                "target_lang_sense_clarification": "мнение окружающих"
                            },
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "известность (часто дурная)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名声",
                                "target_lang_sense_clarification": "外界的评价"
                            },
                            {
                                "target_lang_word": "口碑",
                                "target_lang_sense_clarification": "公众评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "784a5b7c-6675-353a-bf67-0099dfc3feeb",
                    "sense_definition": "A casual conversation or discussion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "talk_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat down for a long <w>rap</w> about politics and life.",
                            "target_lang_translations": {
                                "ru": "Мы сели за долгий <w>разговор</w> о политике и жизни.",
                                "zh": "我们坐下来就政治和生活进行了一次长谈，<w>聊</w>了很久。"
                            }
                        },
                        {
                            "text": "The community center hosted a <w>rap</w> session for teenagers.",
                            "target_lang_translations": {
                                "ru": "В общественном центре прошла <w>дискуссия</w> для подростков.",
                                "zh": "社区中心为青少年举办了一场<w>座谈会</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rap session"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "associated with 1960s-70s slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непринужденная беседа или дискуссия.",
                        "zh": "随意的交谈或讨论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "общение"
                            },
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲聊",
                                "target_lang_sense_clarification": "非正式谈话"
                            },
                            {
                                "target_lang_word": "畅谈",
                                "target_lang_sense_clarification": "深入的交谈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ccac8b8-3e4b-345f-b893-7dcc32056006",
                    "sense_definition": "The smallest amount or bit; usually used in negative expressions to show lack of care or value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "idiom_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not care a <w>rap</w> what the neighbors think.",
                            "target_lang_translations": {
                                "ru": "Мне совершенно <w>наплевать</w> на то, что думают соседи.",
                                "zh": "我根本不<w>在乎</w>邻居们怎么想。"
                            }
                        },
                        {
                            "text": "His opinion is not worth a <w>rap</w> to me.",
                            "target_lang_translations": {
                                "ru": "Его мнение для меня и <w>гроша</w> ломаного не стоит.",
                                "zh": "他的意见对我来说<w>一文不值</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not worth a rap",
                        "care a rap"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "idiomatic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мельчайшая частица или ничтожное количество; обычно используется в отрицаниях для выражения безразличия.",
                        "zh": "极小的数量或一点点；通常用于否定句中，表示毫不在乎或毫无价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "в значении 'ничего не стоит'"
                            },
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "малое количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分文",
                                "target_lang_sense_clarification": "用于表示毫无价值"
                            },
                            {
                                "target_lang_word": "半点",
                                "target_lang_sense_clarification": "极小的程度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97d4b0ea-480c-39d6-9081-689598900e4c",
                    "sense_definition": "To perform a song by speaking lyrics rhythmically over a beat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He learned to <w>rap</w> by listening to his favorite artists.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>читать рэп</w>, слушая своих любимых исполнителей.",
                                "zh": "他通过听自己最喜欢的歌手的歌学会了<w>说唱</w>。"
                            }
                        },
                        {
                            "text": "The singer <w>rapped</w> a verse in the middle of the song.",
                            "target_lang_translations": {
                                "ru": "Певец <w>зачитал</w> куплет в середине песни.",
                                "zh": "歌手在歌曲中间<w>说唱</w>了一段歌词。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rap a song",
                        "freestyle rap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять песню, ритмично проговаривая текст под бит.",
                        "zh": "通过在节拍上节奏性地念出歌词来表演歌曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читать рэп",
                                "target_lang_sense_clarification": "исполнять речитатив"
                            },
                            {
                                "target_lang_word": "рэповать",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说唱",
                                "target_lang_sense_clarification": "表演形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b566055d-ed97-30cb-a338-4201de3569c2",
                    "sense_definition": "To hit something quickly and sharply, often to attract attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strike_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>rap</w> on the door before you enter the room.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>постучите</w> в дверь, прежде чем войти в комнату.",
                                "zh": "进房间前请先<w>敲</w>门。"
                            }
                        },
                        {
                            "text": "The judge <w>rapped</w> his gavel to restore order in the court.",
                            "target_lang_translations": {
                                "ru": "Судья <w>стукнул</w> молотком, чтобы восстановить порядок в суде.",
                                "zh": "法官<w>敲击</w>法槌以恢复法庭秩序。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knock"
                    ],
                    "common_phrases": [
                        "rap on the door",
                        "rap out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и резко ударить по чему-либо, часто чтобы привлечь внимание.",
                        "zh": "快速而尖锐地敲击某物，通常是为了引起注意。"
                    },
                    "translations": {
                        "ru": [
