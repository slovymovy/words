                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Harbor</w> is waiting for you in the lobby.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Харбор</w> ждет вас в вестибюле.",
                                "zh": "<w>哈伯</w>先生正在大厅等您。",
                                "fr": "M. <w>Harbor</w> vous attend dans le hall."
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Harbor</w>.",
                            "target_lang_translations": {
