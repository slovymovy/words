                "senses": [
                    {
                        "sense_id": "da79840b-6aa2-39f0-81f4-94317b56c01c",
                        "entry_id": "9f5e0f91-d071-3a95-a713-3c9c0d931f1e",
                        "glosses": [
                            "État de ce qui est défectueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8420a01-3711-4518-bddc-24759be16a3c",
                                "sense_id": "da79840b-6aa2-39f0-81f4-94317b56c01c",
                                "text": "Si le vin disparaissait de la production humaine, je crois qu’il se ferait dans la santé et dans l’intellect de la planète un vide, une absence, une défectuosité beaucoup plus affreuse que tous les excès et les déviations dont on rend le vin responsable."
                            },
                            {
                                "example_id": "23c8b2cf-41d5-4783-991a-99870d649d6c",
                                "sense_id": "da79840b-6aa2-39f0-81f4-94317b56c01c",
                                "text": "Dans mon demi-sommeil je pense à ces défectuosités du gréement […] et à tout ce qu'il faudra réparer aux îles Bermudes, avant de continuer ma croisière."
                            },
                            {
                                "example_id": "6471cc1e-ef5c-4544-9338-0e0deda20467",
                                "sense_id": "da79840b-6aa2-39f0-81f4-94317b56c01c",
                                "text": "Nous avons eu entre les mains des sextants japonais, construits en métal léger, pendant la guerre, qui étaient notablement rongés par les embruns. De telles défectuosités ne se produisent plus maintenant, grâce à des parkérisations ou à des traitements très soignés du métal."
                            }
                        ]
                    }
                ],
