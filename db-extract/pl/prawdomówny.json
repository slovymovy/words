                "translations": [
                    {
                        "translation_id": "bb99c169-05de-4581-99cc-42a2ab81c3bf",
                        "source_entry_id": "293acea6-806f-3d0d-ab80-c89bc33ac65a",
                        "source_sense_id": "d1502e20-b6d2-32d5-9ace-c4d6fb0ce5aa",
                        "target_lang_word": "truthful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truthful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6462b9-966d-3811-b82a-da28798ecaad",
                                        "entry_id": "12b0172e-0c3b-3339-a87f-55ed787967ee",
                                        "glosses": [
                                            "Honest, and always telling the truth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8085a3f-2bb4-4aaf-bbf9-6e3315e96326",
                                                "sense_id": "3a6462b9-966d-3811-b82a-da28798ecaad",
                                                "text": "someone's truthful nature"
                                            },
                                            {
                                                "example_id": "9f36becb-ab31-45ff-95a2-f52d9f5eb9ec",
                                                "sense_id": "3a6462b9-966d-3811-b82a-da28798ecaad",
                                                "text": "Mr. Musk was not being truthful, Mr. Rubio said. What about the more than 1,500 State Department officials who took early retirement in buyouts?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0b61b7-641a-332c-a35d-d2a718a3e092",
                                        "entry_id": "12b0172e-0c3b-3339-a87f-55ed787967ee",
                                        "glosses": [
                                            "Accurately depicting what is real."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19277add-f6fa-4c11-ac9f-54aa8195f035",
                                                "sense_id": "fa0b61b7-641a-332c-a35d-d2a718a3e092",
                                                "text": "He drew a truthful portrait of the prince."
                                            },
                                            {
                                                "example_id": "b16724c1-b40c-4a27-b390-d95c9cf74cbb",
                                                "sense_id": "fa0b61b7-641a-332c-a35d-d2a718a3e092",
                                                "text": "He must be blind indeed who does not perceive the radical and chasmal difference between the truthful and the poetical modes of inculcation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eef0d924-596f-4189-a662-5141b5893209",
                        "source_entry_id": "293acea6-806f-3d0d-ab80-c89bc33ac65a",
                        "source_sense_id": "d1502e20-b6d2-32d5-9ace-c4d6fb0ce5aa",
                        "target_lang_word": "vérace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vérace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd73ef4b-bbd8-3227-bd84-3f0ed80062d9",
                                        "entry_id": "83a568ab-a978-396b-8b44-13a10b4c5ee5",
                                        "glosses": [
                                            "Qui dit la vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5287a5ae-cd5d-4660-8e1e-23a15ea57379",
                                                "sense_id": "bd73ef4b-bbd8-3227-bd84-3f0ed80062d9",
                                                "text": "Maine de Biran est, avec Jouffroy, le plus sérieux et le plus vérace des théoriciens psychologues."
                                            },
                                            {
                                                "example_id": "ef7e6489-107a-4846-9cde-319d686831b2",
                                                "sense_id": "bd73ef4b-bbd8-3227-bd84-3f0ed80062d9",
                                                "text": "Imagine-t-on qu’à la fin des Méditations ou de la Critique de la Raison pure, Descartes ou Kant aient proposé des dispositifs qui permettraient d’expérimenter l’efficacité vérace de leurs dires ? — (Michel Authier, Pays de connaissances, préf. de Michel Serres, Éditions du Rocher, Monaco, 1998, page X)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ff48543-1d8f-4b52-8fab-76d6d6facf9c",
                        "source_entry_id": "293acea6-806f-3d0d-ab80-c89bc33ac65a",
                        "source_sense_id": "d1502e20-b6d2-32d5-9ace-c4d6fb0ce5aa",
                        "target_lang_word": "véridique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "véridique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b56fc302-fcc0-3f3f-9056-17ee424fa7b9",
                                        "entry_id": "6c5cdead-a7c8-334d-bc3b-01221479f74c",
                                        "glosses": [
                                            "Qui aime à dire la vérité ; qui a l’habitude de la dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a301b3-8313-48e7-9b49-d7233865b221",
                                                "sense_id": "b56fc302-fcc0-3f3f-9056-17ee424fa7b9",
                                                "text": "C'est une race […] peu scrupuleuse dans le choix de ses moyens, peu véridique et volontiers voleuse, pillarde et homicide."
                                            },
                                            {
                                                "example_id": "19980442-8939-47bc-9e3f-7174587c66f1",
                                                "sense_id": "b56fc302-fcc0-3f3f-9056-17ee424fa7b9",
                                                "text": "Puisqu’il ne faut jamais mentir, alors il faut mentir de temps en temps : l’obligation d’être véridique à tout prix contraint à mentir quand la vérité elle-même est plus fallacieuse que le mensonge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d49c8c5-8a11-3257-b21e-e52dffd4ed0b",
                                        "entry_id": "6c5cdead-a7c8-334d-bc3b-01221479f74c",
                                        "glosses": [
                                            "Qui exprime la vérité, qui est conforme à la vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141c28ab-11e9-435f-91fd-2daff8c4f6e6",
                                                "sense_id": "4d49c8c5-8a11-3257-b21e-e52dffd4ed0b",
                                                "text": "Un témoignage véridique."
                                            },
                                            {
                                                "example_id": "346cd10f-ae46-43d6-a759-f6d4e6242703",
                                                "sense_id": "4d49c8c5-8a11-3257-b21e-e52dffd4ed0b",
                                                "text": "Un récit véridique."
                                            },
                                            {
                                                "example_id": "6ad7db81-849e-4d36-b351-d37593605534",
                                                "sense_id": "4d49c8c5-8a11-3257-b21e-e52dffd4ed0b",
                                                "text": "Rejeter toute affabulation et n’admettre pour matériaux que des faits véridiques (et non pas seulement des faits vraisemblables, comme dans le roman classique), rien que ces faits et tous ces faits, était la règle que je m’étais choisie."
                                            },
                                            {
                                                "example_id": "e2b20cef-79d7-4954-968b-40475aaee14b",
                                                "sense_id": "4d49c8c5-8a11-3257-b21e-e52dffd4ed0b",
                                                "text": "L’histoire que nous allons avoir l’honneur et le plaisir de vous conter est une histoire absolument vé-ri-dique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
