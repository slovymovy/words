                                            {
                                                "example_id": "557f8db0-835c-4324-aabc-05c2450ed666",
                                                "sense_id": "e2886288-45e6-39ad-bc43-e6485a75e643",
                                                "text": "Die Gastronomie in unserem Betrieb haben wir an eine externe Firma vergeben."
                                            },
                                            {
                                                "example_id": "d7dad232-6f3d-4082-9687-f62da94f45b4",
                                                "sense_id": "e2886288-45e6-39ad-bc43-e6485a75e643",
                                                "text": "„Doch seine Schwärmerei für die Gastronomie hat eigentlich einen recht handfesten Hintergrund.“"
                                            },
                                            {
                                                "example_id": "75383354-b430-4da8-b4a2-d11d7ca39a99",
                                                "sense_id": "e2886288-45e6-39ad-bc43-e6485a75e643",
                                                "text": "„Michalis nutzt die Sommersaison, um in der Gastronomie Geld zu verdienen.“"
                                            }
                                        ],
