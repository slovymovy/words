                "translations": [
                    {
                        "translation_id": "b8f12e5c-4f06-4ea6-9569-71c3feb28f6c",
                        "source_entry_id": "3d1384c2-e40a-3c27-8c29-c853f34a4d20",
                        "source_sense_id": "5d922d17-4018-39bc-a886-bb2d2bb94edc",
                        "target_lang_word": "Geizhals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geizhals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                        "entry_id": "f0115770-e4cc-38df-a492-9d420a10d5d7",
                                        "glosses": [
                                            "sehr geizige Person; jemand, der sehr wenig Neigung hat, anderen etwas zu geben oder überhaupt etwas auszugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c71237f-fb21-4ec1-abb2-66ad11217301",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "Dieser Geizhals hat uns in unserer Notlage nicht mal 50 Cent zum Telefonieren gegeben!"
                                            },
                                            {
                                                "example_id": "4b5e09e8-e354-4715-aa58-d97aad856730",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Beinahe wöchentlich stand der Gerichtsvollzieher vor der Tür, um etwas zu pfänden, immer wieder drohte der Rauswurf aus den Wohnungen – vielleicht mit ein Grund, warum mein Vater zeitlebens so erpicht darauf war, Reichtümer anzuhäufen und dennoch lebte wie ein Geizhals, der sich nur das Nötigste gönnte.“"
                                            },
                                            {
                                                "example_id": "4bd5820d-b94f-4edc-82e9-86637af32d68",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Alles ist hier schön an seinem Ort, Hoffmann führt Regie, und wir spüren, daß es ihm sehr viel leichter fällt, einen Maler einen alten Geizhals prellen zu lassen, als einer vornehmen französischen Dame eine Moralpredigt in den Mund zu legen.“"
                                            },
                                            {
                                                "example_id": "d6625696-6dbe-4bf1-8516-ad4165a1de90",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Der Sohn eines Geizhalses ist verschwenderisch, der Sohn eines Verschwenders ist geizig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bb0f37d-f092-4c7e-acf7-68e41b818aaa",
                        "source_entry_id": "3d1384c2-e40a-3c27-8c29-c853f34a4d20",
                        "source_sense_id": "5d922d17-4018-39bc-a886-bb2d2bb94edc",
                        "target_lang_word": "miser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A person who hoards money rather than spending it; one who is cheap or extremely parsimonious."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822ca7c1-2233-43c6-b926-ba32d3eb82e0",
                                                "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                                "text": "Scrooge was a typical miser: spending nothing he could save, nor enjoying his wealth."
                                            },
                                            {
                                                "example_id": "c8cef956-1b71-4309-9b58-15d22c55db0e",
                                                "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                                "text": "[…] foꝛ it was many times notoꝛious vnto al mẽ, yͭ he did eate in his houſe no other fleſh by the ſpace of iii. dayes, but on Hare, whiche was ſent him. He was ſuch a miſer to ſpend, ⁊ ſo deſirous to hooꝛd and lay vp money, yͭ had it not béene foꝛ ſome dayes of ſacrifices, oꝛ his bidden gueſts, not a moꝛsel of fleſh was eaten in his houſe: but only fed of his pꝛouiſion from his garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A person who is wretched or despicable; a wretch."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea836c9-a3a7-4657-988d-934f44bcb219",
                                                "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                                                "text": "[…] a poore virgin ſir, an il-fauor’d thing ſir, but mine owne, a poore humour of mine ſir, to take that that no man elſe will: rich honeſtie dwels like a miſer ſir, in a poore houſe, as your Pearle in your foule oyſter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e32750-4847-395e-aa4a-abf1e8921556",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A kind of earth auger, typically large-bored and often hand-operated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49b95d42-5dfc-4224-9d7c-5c032e17c1a3",
                        "source_entry_id": "3d1384c2-e40a-3c27-8c29-c853f34a4d20",
                        "source_sense_id": "5d922d17-4018-39bc-a886-bb2d2bb94edc",
                        "target_lang_word": "avare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                                        "entry_id": "a3350903-752e-3090-a0e2-3e32fe264934",
                                        "glosses": [
                                            "Qui a un désir excessif d’accumuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4f8a43-831f-4c79-837f-f54392cabfda",
                                                "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                                                "text": "Ma femme […] m’invectivait, réclamant toujours quelque argent, que je ne pouvais lui donner. Et elle me traitait d’avare, de grippe-sous, de sans-cœur."
                                            },
                                            {
                                                "example_id": "034d4534-398f-454c-896a-4ffadf7f3919",
                                                "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                                                "text": "Et quand il n’y aurait qu’un vers heureux à se voler à soi-même, il ne faut rien négliger : les vieillards sont un peu avares."
                                            },
                                            {
                                                "example_id": "406ef6ec-dfa0-447d-a45d-40d7292fc265",
                                                "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                                                "text": "Il ne faut ni vigueur, ni jeunesse, ni santé pour être avare."
                                            },
                                            {
                                                "example_id": "1f8fc359-37d4-425e-a8f5-670f95b7119f",
                                                "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                                                "text": "Tu céderas, ou tu tomberas sous ce vainqueur, Alger, riche des dépouilles de la chrétienté. Tu disais en ton cœur avare : Je tiens la mer sous mes lois, et les nations sont ma proie."
                                            },
                                            {
                                                "example_id": "099c3498-01c7-4dd5-8894-62a2584b3162",
                                                "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                                                "text": "Son naturel… Le fit, dans une avare et sordide famille,\nChercher un monstre affreux sous le nom d’une fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c68da07-34e9-3cc6-9c53-c2e1ce40a8ca",
                                        "entry_id": "a3350903-752e-3090-a0e2-3e32fe264934",
                                        "glosses": [
                                            "Qui ne donne pas facilement une chose, qui en est très économe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab71d7b9-f41f-4281-8a32-4df5613a980f",
                                                "sense_id": "0c68da07-34e9-3cc6-9c53-c2e1ce40a8ca",
                                                "text": "Quoi que le sort te donne, il t’est encore avare,\nS’il pèse ton mérite et mon affection."
                                            },
                                            {
                                                "example_id": "5e449375-df83-4a7b-84d8-5becbc45586a",
                                                "sense_id": "0c68da07-34e9-3cc6-9c53-c2e1ce40a8ca",
                                                "text": "En vain vous espérez qu’un dieu vous le renvoie ; Et l’avare Enquérons ne lâche pas sa proie. Ainsi il continue le mouvement."
                                            },
                                            {
                                                "example_id": "33b4afa5-d2f8-4395-9f56-0de00f866912",
                                                "sense_id": "0c68da07-34e9-3cc6-9c53-c2e1ce40a8ca",
                                                "text": "C’était un voyage qu’une petite troupe eût eu assez de peine à faire quand même elle n’eût point eu d’attirail, car il y a grande disette d’eau par toute cette contrée, et le ciel lui en est aussi avare que la terre."
                                            },
                                            {
                                                "example_id": "578ddc88-677c-4390-afbd-366eeee43254",
                                                "sense_id": "0c68da07-34e9-3cc6-9c53-c2e1ce40a8ca",
                                                "text": "Et tout ce que des mains de cette reine avare Vous avez pu sauver et de riche et de rare."
                                            },
                                            {
                                                "example_id": "f6060282-c45c-4da6-a2ce-8af0507d7254",
                                                "sense_id": "0c68da07-34e9-3cc6-9c53-c2e1ce40a8ca",
                                                "text": "Le nôtre [notre cœur] s’endurcit, la repouſſe, l’égare : Le bras qui la verſait [la grâce] en devient plus avare ; Et cette sainte ardeur qui doit porter au bien, Tombe plus rarement, ou n’opère plus rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                        "entry_id": "a3350903-752e-3090-a0e2-3e32fe264934",
                                        "glosses": [
                                            "Qui n’accorde pas, qui ne prodigue pas."
                                        ],
                                        "tags": [
                                            "Suivi de la préposition de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a7d011-2c56-4e75-a82e-8c8b811f555a",
                                                "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                                "text": "Il est avare de son temps."
                                            },
                                            {
                                                "example_id": "13752006-4c29-46e3-835e-8fc685876888",
                                                "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                                "text": "Marius de leur sang eût été moins avare ; Sylla les eût punis."
                                            },
                                            {
                                                "example_id": "8dfc1e6d-4f62-4a33-8cb4-d2afcaac3639",
                                                "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                                "text": "Je me plains seulement de ce pays barbare\nQui de six pieds de terre à son prince est avare."
                                            },
                                            {
                                                "example_id": "6792bcf7-c7bc-4360-abbb-f2215af72dff",
                                                "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                                "text": "Avare du secours que j’attends de tes soins."
                                            },
                                            {
                                                "example_id": "02b432c9-b651-4be5-bafc-b2169d6091ba",
                                                "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                                "text": "La première [fille d’honneur de la duchesse], que son mari n’avait pas assurément épousée pour ses beaux yeux, était faite comme la plupart des riches héritières, pour qui l’équitable nature semble avare de ses richesses à mesure qu’elles sont comblées de celles de la fortune."
                                            },
                                            {
                                                "example_id": "f9c5bfb5-0730-4ae4-8a41-5f743e84acc9",
                                                "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                                                "text": "Alors, grave dans sa démarche, réservé dans ses politesses, avare de mots, chiche de pensées, on l’expédie en pays étranger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                                        "entry_id": "e53bd592-10e2-3ae2-82a3-8d298cd855c7",
                                        "glosses": [
                                            "Personne avare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639417e3-29c0-4acf-a9ce-431f9fdb21d6",
                                                "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                                                "text": "C’est un avare."
                                            },
                                            {
                                                "example_id": "9c22a062-1be9-47a3-9312-739908ea1712",
                                                "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                                                "text": "Une vieille avare."
                                            },
                                            {
                                                "example_id": "fe56d8c7-f7a2-4e6d-9d4d-3b881660a503",
                                                "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                                                "text": "Je n’ai pu rien tirer de cet avare."
                                            },
                                            {
                                                "example_id": "1d19f483-0eae-44c6-8aac-503e76b35c29",
                                                "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                                                "text": "L’Harpagon de Molière, le père Grandet de Balzac, l’Ebenezer Scrooge de Charles Dickens sont trois types de l’avare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
