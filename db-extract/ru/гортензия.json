                    },
                    {
                        "translation_id": "23d9ca3e-7d59-4610-8e12-96425cb094e8",
                        "source_entry_id": "779b56e5-dd06-3d93-9afc-2456df4f2cbd",
                        "source_sense_id": "8cd15fce-39d3-3d9d-9169-9c77c97992da",
                        "target_lang_word": "Hortensie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hortensie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                        "entry_id": "31242a87-86f9-3c68-9e9d-4a2888afb442",
                                        "glosses": [
                                            "strauchartige Pflanze mit doldigem Blütenstand, von der mehrere Arten als Zierpflanze genutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a274f3-6d86-48c6-9f82-4c1fb5c46370",
                                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                                "text": "„Die Hortensie braucht gut wasserdurchlässige, humose Erde.“"
                                            },
                                            {
                                                "example_id": "c4a51b5a-c0bc-4866-a2e1-adf51d38e112",
                                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                                "text": "„Ursprünglich war die Hortensie im asiatischen Raum zu Hause.“"
                                            },
                                            {
                                                "example_id": "b0ebe52a-8038-457f-86cc-07e16608aaea",
                                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                                "text": "„Der Wurzelballen der Hortensie kann nach der Blüte in den eigenen Garten gepflanzt werden.“"
                                            },
                                            {
                                                "example_id": "d4e3cbee-8836-4277-8789-1b787e687003",
                                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                                "text": "„Die Hortensien sind inzwischen bis zu zwei Meter hoch und setzen mit ihren Blütenwolken in Rosatönen ein farbiges Gegengewicht zu den imposanten Bruchsteinmauern.“"
                                            },
                                            {
                                                "example_id": "73ec73aa-b07e-4e71-b85b-0d4876d7f7b1",
                                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                                "text": "„Die getrockneten Blütendolden der Hortensien sehen besonders im Winter schön aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1d047dc-b62a-4a30-9b0e-5029d3b88fec",
                        "source_entry_id": "779b56e5-dd06-3d93-9afc-2456df4f2cbd",
                        "source_sense_id": "8cd15fce-39d3-3d9d-9169-9c77c97992da",
                        "target_lang_word": "hortensia",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hortensia",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "382c0fa7-be98-31ae-9c08-4870d48e7fac",
                                        "entry_id": "40ce0026-8b62-3b16-9d80-968f904374cb",
                                        "glosses": [
                                            "plant met grote bolvormige bloemen (die eigenlijk een verzameling zijn van veel afzonderlijke bloemen) uit het geslacht Hydrangea"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9bc5d0-bda3-4703-8fbb-120ce004bc4b",
                                                "sense_id": "382c0fa7-be98-31ae-9c08-4870d48e7fac",
                                                "text": "Het gras groeide bijna tot in de dakgoot. De moestuin was overwoekerd met onkruid. Het land had gehooid moeten worden. De hortensia's in de voortuin waren verdord. En in plaats van me daar schuldig over te voelen was ik bezig met het plannen van mijn volgende zeilreis. Dit boerenleven paste niet meer bij me."
                                            },
                                            {
                                                "example_id": "7db20013-d3b7-4f22-9ca8-d34962dc60e1",
                                                "sense_id": "382c0fa7-be98-31ae-9c08-4870d48e7fac",
                                                "text": "Zijn moeder reserveerde in haar schrift minder ruimte voor groenten. Ze waren nu met z'n tweeën. De lege plekken werden ingevuld met namen van bloemen: asters, lelies, hortensia's, gladiolen, klaprozen, korenbloemen, kraaienbloemen, zonnebloemen. Ze werden in maart met kippenmest gezaaid. Twee maanden later liep zijn moeder met het eerste boeket uit de tuin naar de begraafplaats, elke week legde ze andere bloemen op het graf van haar man en dat van haar zoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b59996e-3a06-4846-9add-f0176682fb01",
                        "source_entry_id": "779b56e5-dd06-3d93-9afc-2456df4f2cbd",
                        "source_sense_id": "8cd15fce-39d3-3d9d-9169-9c77c97992da",
