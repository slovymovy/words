{
    "word_family": [
        "landlord",
        "lordly",
        "lordship",
        "overlord",
        "warlord"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a6cd674b-aa62-3ecf-ab3f-491a1ba04a58",
                    "sense_definition": "The Supreme Being and Creator in Judaism, Christianity, and Islam.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deity",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Many people pray to the <w>Lord</w> for guidance and strength.",
                            "target_lang_translations": {
                                "ru": "Многие люди молятся <w>Господу</w> о наставлении и силе.",
                                "zh": "许多人向<w>主</w>祈求指引和力量。"
                            }
                        },
                        {
                            "text": "The choir sang a beautiful hymn to praise the <w>Lord</w>.",
                            "target_lang_translations": {
                                "ru": "Хор пел прекрасный гимн, восхваляя <w>Господа</w>.",
                                "zh": "唱诗班唱了一首优美的赞美诗来赞美<w>主</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Allah",
                        "Jehovah",
                        "God"
                    ],
                    "common_phrases": [
                        "praise the Lord",
                        "fear the Lord",
                        "Lord God"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верховное Существо и Творец в иудаизме, христианстве и исламе.",
                        "zh": "在犹太教、基督教和伊斯兰教中，指代至高无上的造物主。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Господь",
                                "target_lang_sense_clarification": "имя Бога"
                            },
                            {
                                "target_lang_word": "Владыка",
                                "target_lang_sense_clarification": "возвышенное обращение к Богу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上帝",
                                "target_lang_sense_clarification": "基督教中的至高神"
                            },
                            {
                                "target_lang_word": "主",
                                "target_lang_sense_clarification": "宗教中对神的尊称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b39afa13-784e-354a-a446-ab8d326431c7",
                    "sense_definition": "A title used to refer to Jesus Christ.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deity",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "The disciples followed their <w>Lord</w> throughout the land.",
                            "target_lang_translations": {
                                "ru": "Ученики следовали за своим <w>Господом</w> по всей земле.",
                                "zh": "门徒们跟随他们的<w>主</w>走遍了各地。"
                            }
                        },
                        {
                            "text": "Christians believe that the <w>Lord</w> Jesus rose from the dead.",
                            "target_lang_translations": {
                                "ru": "Христиане верят, что <w>Господь</w> Иисус восстал из мертвых.",
                                "zh": "基督徒相信<w>主</w>耶稣从死里复活了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "our Lord",
                        "Lord Jesus"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый для обращения к Иисусу Христу.",
                        "zh": "用于称呼耶稣基督的头衔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Господь",
                                "target_lang_sense_clarification": "титул Иисуса Христа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主",
                                "target_lang_sense_clarification": "基督教中对耶稣的尊称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1b07b9d-003c-3ede-9d32-5255668b2915",
                    "sense_definition": "A man of high social rank or noble birth, particularly a member of the nobility in the United Kingdom.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nobility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lord</w> addressed the members of the parliament.",
                            "target_lang_translations": {
                                "ru": "<w>Лорд</w> обратился к членам парламента.",
                                "zh": "那位<w>勋爵</w>向议会成员发表了讲话。"
                            }
                        },
                        {
                            "text": "Every <w>lord</w> and lady in the county was invited to the royal ball.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>лорд</w> и леди в графстве были приглашены на королевский бал.",
                                "zh": "郡里的每一位<w>勋爵</w>和夫人都受邀参加了皇家舞会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "House of Lords",
                        "my lord"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "especially United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек высокого социального ранга или благородного происхождения, особенно член пэрства в Великобритании.",
                        "zh": "具有高社会地位或贵族血统的人，尤指英国的贵族成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лорд",
                                "target_lang_sense_clarification": "дворянский титул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勋爵",
                                "target_lang_sense_clarification": "英国贵族头衔"
                            },
                            {
                                "target_lang_word": "贵族",
                                "target_lang_sense_clarification": "指代有爵位的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa0a7182-d528-3e40-8daf-fabaa8906360",
                    "sense_definition": "A person who has power, authority, or ownership over others or a property.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mastery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted like the <w>lord</w> of the manor, giving orders to everyone.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как <w>господин</w> поместья, раздавая всем приказы.",
                                "zh": "他表现得像庄园的<w>主人</w>一样，对每个人发号施令。"
                            }
                        },
                        {
                            "text": "The dog walked around as if he were <w>lord</w> of the house.",
                            "target_lang_translations": {
                                "ru": "Собака расхаживала так, словно была <w>хозяином</w> в доме.",
                                "zh": "那只狗走来走去，仿佛它是这个家的<w>主人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proprietor",
                        "possessor",
                        "sovereign"
                    ],
                    "common_phrases": [
                        "lord of the manor",
                        "lord and master"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий властью, авторитетом или правом собственности над другими людьми или имуществом.",
                        "zh": "对他人或财产拥有权力、权威或所有权的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господин",
                                "target_lang_sense_clarification": "владелец, повелитель"
                            },
                            {
                                "target_lang_word": "властелин",
                                "target_lang_sense_clarification": "обладающий высшей властью"
                            },
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "владелец дома или имущества"
                            },
                            {
                                "target_lang_word": "повелитель",
                                "target_lang_sense_clarification": "тот, кто приказывает"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主人",
                                "target_lang_sense_clarification": "财产或房屋的所有者"
                            },
                            {
                                "target_lang_word": "统治者",
                                "target_lang_sense_clarification": "拥有最高权力的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4033144a-9e9d-380e-bb5f-1ba3c242a32c",
                    "sense_definition": "An exclamation used to express surprise, shock, or worry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good <w>Lord</w>, I completely forgot about our meeting!",
                            "target_lang_translations": {
                                "ru": "<w>Господи</w>, я совершенно забыл о нашей встрече!",
                                "zh": "<w>天哪</w>，我完全忘了我们的会议！"
                            }
                        },
                        {
                            "text": "Oh <w>Lord</w>, look at the mess they made in the kitchen.",
                            "target_lang_translations": {
                                "ru": "О <w>Господи</w>, посмотри, какой беспорядок они устроили на кухне.",
                                "zh": "<w>天哪</w>，看看他们在厨房里弄得一团糟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "good Lord",
                        "oh Lord"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для выражения удивления, шока или беспокойства.",
                        "zh": "用于表达惊讶、震惊或担忧的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Господи",
                                "target_lang_sense_clarification": "восклицание"
                            },
                            {
                                "target_lang_word": "Боже",
                                "target_lang_sense_clarification": "восклицание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天哪",
                                "target_lang_sense_clarification": "表示惊讶的感叹词"
                            },
                            {
                                "target_lang_word": "老天",
                                "target_lang_sense_clarification": "表示震惊的感叹词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b9c9350-db69-3a7e-b102-277c140f7e91",
                    "sense_definition": "To act in a superior or domineering manner toward others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>lord</w> it over his younger brothers whenever he wins a game.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>помыкать</w> своими младшими братьями, когда он выигрывает в игру.",
                                "zh": "他每次赢了比赛，就喜欢对弟弟们<w>作威作福</w>。"
                            }
                        },
                        {
                            "text": "A good manager does not <w>lord</w> her authority over the staff.",
                            "target_lang_translations": {
                                "ru": "Хороший менеджер не <w>кичится</w> своей властью перед персоналом.",
                                "zh": "好的经理不会对员工<w>颐指气使</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lord it over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя высокомерно или властно по отношению к другим.",
                        "zh": "以傲慢或专横的态度对待他人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помыкать",
                                "target_lang_sense_clarification": "командовать свысока"
                            },
                            {
                                "target_lang_word": "командовать",
                                "target_lang_sense_clarification": "распоряжаться"
                            },
                            {
                                "target_lang_word": "кичиться властью",
                                "target_lang_sense_clarification": "демонстрировать превосходство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作威作福",
                                "target_lang_sense_clarification": "形容仗势欺人"
                            },
                            {
                                "target_lang_word": "颐指气使",
                                "target_lang_sense_clarification": "形容傲慢地指挥别人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}