{
    "word_family": [
        "пленник",
        "пленение",
        "пленять",
        "пленный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2c96c08-860b-340b-8afe-81c98d173583",
                    "sense_definition": "Состояние неволи, захват в плен.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "captivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие солдаты оказались в <w>полон</w> после тяжелого сражения.",
                            "target_lang_translations": {
                                "en": "Many soldiers were taken <w>captive</w> after the heavy battle."
                            }
                        },
                        {
                            "text": "Враги увели всех жителей деревни в <w>полон</w>.",
                            "target_lang_translations": {
                                "en": "The enemies took all the villagers into <w>captivity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "плен"
                    ],
                    "common_phrases": [
                        "взять в полон",
                        "увести в полон"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее или высокое слово."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being held captive or imprisoned, typically in a historical or literary context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "captivity",
                                "target_lang_sense_clarification": "The general state of being held prisoner."
                            },
                            {
                                "target_lang_word": "imprisonment",
                                "target_lang_sense_clarification": "The act of being confined in a prison or similar state."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "791496de-5eae-3e8e-be8e-fc6f59579c42",
                    "sense_definition": "Военная добыча, захваченная силой оружия.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "booty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Войско вернулось домой, везя с собой богатый <w>полон</w>.",
                            "target_lang_translations": {
                                "en": "The army returned home, bringing with them rich <w>spoils</w>."
                            }
                        },
                        {
                            "text": "Весь <w>полон</w> был справедливо разделен между победителями.",
                            "target_lang_translations": {
                                "en": "All the <w>booty</w> was fairly divided among the victors."
                            }
                        }
                    ],
                    "synonyms": [
                        "добыча",
                        "трофей"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее слово."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Spoils of war or captives taken by force during a military conflict."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spoils of war",
                                "target_lang_sense_clarification": "Goods or captives seized from a defeated enemy."
                            },
                            {
                                "target_lang_word": "booty",
                                "target_lang_sense_clarification": "Valuable goods taken in war or robbery."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd5e58c7-91c6-3ab3-8fd7-41ea17026b80",
                    "sense_definition": "Краткая форма мужского рода единственного числа прилагательного <w>полный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стакан был <w>полон</w> свежей воды.",
                            "target_lang_translations": {
                                "en": "The glass was <w>full</w> of fresh water."
                            }
                        },
                        {
                            "text": "Зал был <w>полон</w> людей, ожидающих начала концерта.",
                            "target_lang_translations": {
                                "en": "The hall was <w>full</w> of people waiting for the concert to begin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "полон сил",
                        "полон надежд"
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'full', meaning containing as much as possible or filled with something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "full",
                                "target_lang_sense_clarification": "Containing or holding as much as possible."
                            },
                            {
                                "target_lang_word": "filled with",
                                "target_lang_sense_clarification": "Used to describe being occupied or occupied by a specific content."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
