                        "source_entry_id": "dae09542-79d1-3b9f-9646-4b43c055ca8c",
                        "source_sense_id": "3b2d83e7-2ddc-38fa-948a-fb97a3c679d2",
                        "source_sense_description": "flaches, meist rundes Brot",
                        "target_lang_word": "placka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "58af12bb-0578-3dd6-a750-cbc8b2c3f9a4",
                                        "entry_id": "f2e6ebe1-329d-3870-9bb0-806b588d5b9e",
                                        "glosses": [
                                            "(většinou bezmasý) kompaktní pokrm plochého tvaru z těsta na základě obilnin či okopanin připravený zpravidla na otevřeném ohni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3150100-5563-4a18-9d6d-2d45f4a3d060",
                                                "sense_id": "58af12bb-0578-3dd6-a750-cbc8b2c3f9a4",
                                                "text": "musela se vytopit pec a pohrablem vyčistit – pak se s chlebem nebo po něm napekly placky z chlebového těsta, pekanče, nebo jak vy říkáte, poplamenice – panečku, to byla s oškvarky dobrota!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f4848e-783f-3bf0-aca4-e2b84da65cb6",
                                        "entry_id": "f2e6ebe1-329d-3870-9bb0-806b588d5b9e",
                                        "glosses": [
                                            "placatý předmět"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc9af0e-ca81-4eff-a4cc-db74fe38ea25",
                                                "sense_id": "e9f4848e-783f-3bf0-aca4-e2b84da65cb6",
                                                "text": "Neskutečné štěstí měla tříčlenná rodina, na kterou v Číně spadl jeřáb. Bohužel tak nešikovně, že v podélném směru rozmázl střechu auta na placku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7caa28-9796-3fd5-ba17-0bdefe63bb55",
                                        "entry_id": "f2e6ebe1-329d-3870-9bb0-806b588d5b9e",
                                        "glosses": [
                                            "kulatý plochý odznak s nějakým poselstvím"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69afb83f-4575-4705-9ec7-d93f8a6e4946",
                                                "sense_id": "fb7caa28-9796-3fd5-ba17-0bdefe63bb55",
                                                "text": "legendární placky s nápisem „Havel na Hrad!“"
                                            },
                                            {
                                                "example_id": "8da78721-2f3a-4e2e-8046-9983b279fac8",
                                                "sense_id": "fb7caa28-9796-3fd5-ba17-0bdefe63bb55",
                                                "text": "V devadesátých letech se objevily placky s vtipnými nebo rádobyvtipnými nápisy jako „Všichni jsou blázni, jenom já jsem letadlo!“ a podobně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "316b19fd-ebb4-30e4-88b5-fc456c2cc968",
                                        "entry_id": "f2e6ebe1-329d-3870-9bb0-806b588d5b9e",
                                        "glosses": [
                                            "medaile"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "758b4fab-8bdc-4674-bb8e-21e103165587",
                                                "sense_id": "316b19fd-ebb4-30e4-88b5-fc456c2cc968",
                                                "text": "Před svými fanoušky si dojel pro dvě medaile. Získal stříbrnou placku ve sprintu a pak také dokázal zužitkovat druhé startovní číslo ve stíhacím závodě, neboť z ní má bronz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bcb556e-6daa-35eb-a6cf-87d6ab884720",
                                        "entry_id": "f2e6ebe1-329d-3870-9bb0-806b588d5b9e",
                                        "glosses": [
                                            "smartphone, chytrý telefon"
                                        ],
                                        "tags": [
                                            "neologism",
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8beb6ff-b838-4601-96c5-195618822a53",
                                                "sense_id": "0bcb556e-6daa-35eb-a6cf-87d6ab884720",
                                                "text": "Co máš za telefon? Taky nějakou placku?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7552d46-e4d2-3725-a0d4-2023dc79a92c",
                                        "entry_id": "f2e6ebe1-329d-3870-9bb0-806b588d5b9e",
                                        "glosses": [
                                            "plochá krajina"
                                        ],
                                        "tags": [
                                            "colloquially",
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0390959e-3b9c-4b5b-aaf9-2c7cc0b99182",
                                                "sense_id": "e7552d46-e4d2-3725-a0d4-2023dc79a92c",
                                                "text": "Celé Polsko je taková placka, něco jako Haná. Ne nadarmo spolu slova „Polsko“ a „pole“ etymologicky souvisejí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
