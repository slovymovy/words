                        "entry_id": "c6da2c56-5229-392e-905e-18716b4380f8",
                        "glosses": [
                            "Romaanse taal die wordt gesproken door 10 miljoen mensen op Sicilië, in Zuid-Calabrië en Salento\\nSiciliaans (taal)"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b6b4f379-194c-49e9-bfe6-258e22d06b52",
                                "sense_id": "9e08699f-149e-3699-8813-96d8a6f5c0e8",
                                "text": "\"Sardi a beccaficu\", zoals dit gerecht oorspronkelijk in het Siciliaans wordt genoemd, is een typisch Zuid-Italiaans gerecht en zo klassiek, dat het op de lijst van traditionele Italiaanse gerechten van het Italiaanse ministerie van Landbouw, Voedsel en Bosbouw staat."
                            }
                        ]
                    },
                    {
                        "sense_id": "c676c99b-5c9e-31f6-92cf-c4b14551cd1b",
                        "entry_id": "c6da2c56-5229-392e-905e-18716b4380f8",
                        "glosses": [
                            "bepaalde openingsvariant, waarbij wit en zwart beginnen met het verplaatsen van een pion naar e4, respectievelijk c5\\nSiciliaans (schaakopening)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976b11d3-bdef-4c5e-8acf-90a7aecbf7d7",
                                "sense_id": "c676c99b-5c9e-31f6-92cf-c4b14551cd1b",
                                "text": "Daarna leer je gratis verder op YouTube, over openingen als het Siciliaans of het Konings-Indisch, en met analyses van partijen tussen grootmeesters."
                            }
                        ]
                    }
                ],
