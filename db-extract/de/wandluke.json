                "senses": [
                    {
                        "sense_id": "e4bf2b16-98c6-36c9-88cd-f940b3a05011",
                        "entry_id": "f12a87b8-f9f9-38a8-8717-126869717063",
                        "glosses": [
                            "kleines Fenster in einer Wand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c144e4b6-93f3-41c3-9e1f-f5d2fc335842",
                                "sense_id": "e4bf2b16-98c6-36c9-88cd-f940b3a05011",
                                "text": "„Immerhin ergatterten sie einen klitzekleinen Raum, eine Art Besenkammer mit Wandluke und einem handtuchschmalen Bett, weshalb sie beschlossen, abwechselnd auf und unter ihm zu schlafen.“"
                            },
                            {
                                "example_id": "e5da22e9-6fb4-4711-b76e-cdfbdb2b8110",
                                "sense_id": "e4bf2b16-98c6-36c9-88cd-f940b3a05011",
                                "text": "„Felzmann steigt auf den Dachboden des Wirtschaftsgebäudes und postiert sich vor einer Wandluke.“"
                            },
                            {
                                "example_id": "8fc015ee-0744-4d8c-9885-cb64abce415a",
                                "sense_id": "e4bf2b16-98c6-36c9-88cd-f940b3a05011",
                                "text": "„Überraschung heuchelnd, wandte er seinen Blick vom Fächer empor in Richtung auf die Wandluke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
