                                "sense_id": "9393dce7-b7f6-331b-89cd-bd79a94a3179",
                                "text": "„Es werden zwei Arten von echten Spitzen unterschieden: Die Nadelspitze und die Klöppelspitze.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
