                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3124ed80-609a-4e35-8a51-9920d846b9a8",
                        "source_entry_id": "eb52e73f-4374-3c40-b096-152341592e95",
                        "source_sense_id": "5d67f989-eead-3b2c-bc10-bbd90cbc0c75",
                        "source_sense_description": "magnetische onregelmatigheid aan de oppervlakte van de zon die vanaf de aarde te zien is als een wat donkere vlek",
                        "target_lang_word": "Sonnenfleck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenfleck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47899934-a137-3727-9750-2949c33bee5c",
                                        "entry_id": "349db0ff-21ab-3f7b-af75-51fc41336d31",
                                        "glosses": [
                                            "meist Plural:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "152303c2-7538-3404-9f2b-368d39d80835",
                                        "entry_id": "349db0ff-21ab-3f7b-af75-51fc41336d31",
                                        "glosses": [
                                            "dunkle Stelle auf der Oberfläche der Sonne, die von der Aktivität ihrer Magnetfelder herrührt"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a7f856f-6b40-4c04-a75e-eee1be68fe34",
                                                "sense_id": "152303c2-7538-3404-9f2b-368d39d80835",
                                                "text": "Mit einem speziellen Teleskop sind Sonnenflecken gut zu beobachten."
                                            },
                                            {
                                                "example_id": "a7611bac-236f-4369-9bad-c3adcd47459e",
                                                "sense_id": "152303c2-7538-3404-9f2b-368d39d80835",
                                                "text": "„Es handelt sich um einen Sonnenfleck, der fünf Mal so groß ist wie die Erde. Sonnenflecken sind kühle Regionen auf der Oberfläche unseres Zentralgestirns. […] Zwar leuchten auch die Sonnenflecken immer noch sehr hell, doch vor dem grellen Hintergrund der Sonnenscheibe erscheinen sie dem irdischen Beobachter als schwarze Flecken. Die Anzahl der Sonnenflecken schwankt in einem elfjährigen Rhythmus.“"
                                            },
                                            {
                                                "example_id": "4c993b11-84ed-4ae9-bb89-d5cb212693e3",
                                                "sense_id": "152303c2-7538-3404-9f2b-368d39d80835",
                                                "text": "„Für die Zeit davor werden die solaren Schwankungen aus Beobachtungen der Änderungen der Sonnenflecken oder aus Konzentrationsänderungen kosmogener Isotope abgeschätzt.“"
                                            },
                                            {
                                                "example_id": "8689d198-661e-4d09-817a-081d498a4f35",
                                                "sense_id": "152303c2-7538-3404-9f2b-368d39d80835",
                                                "text": "„Mit ihrer Hilfe entdeckt er Mondkrater und Sonnenflecken sowie die Trabanten des Jupiter.“"
                                            },
                                            {
                                                "example_id": "ddc72a30-789e-40ee-a9f8-8fac2f0b23d3",
                                                "sense_id": "152303c2-7538-3404-9f2b-368d39d80835",
                                                "text": "„Die Oberfläche ist mit Sonnenflecken gesprenkelt, die auf Fotografien nur deshalb dunkel aussehen, weil sie etwas kühler sind als ihre Umgebung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "045ef355-8df2-30d1-aed3-2413dafdb181",
                                        "entry_id": "349db0ff-21ab-3f7b-af75-51fc41336d31",
                                        "glosses": [
                                            "(sommers deutlicher sichtbar werdender) kleiner, bräunlicher Pigmentfleck auf der Haut"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4346fd6f-fdaa-449f-8182-b0052c2276ac",
                                                "sense_id": "045ef355-8df2-30d1-aed3-2413dafdb181",
                                                "text": "Besonders in der hellen Jahreszeit treten bei manchen Menschen Sonnenflecken auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                        "entry_id": "349db0ff-21ab-3f7b-af75-51fc41336d31",
                                        "glosses": [
                                            "auf einer schattigen Fläche liegende Stelle, die von Sonnenlicht beschienen ist"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abfdafc1-973f-4245-8152-876e3876ea20",
                                                "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                                "text": "„Auf dem Abhang eines Hügels flammte ein greller Sonnenfleck auf, als hätte irgendein Spaßvogel hinter den Wolken mit einer Spiegelscherbe gespielt. Der Sonnenfleck bewegte sich über den Hügel und erreichte den Feuerwehrturm, der hell aufflammte und wieder erlosch.“"
                                            },
                                            {
                                                "example_id": "aceb16cf-a932-40f1-bd1d-9793d0da1a85",
                                                "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                                "text": "„Einmal, da war es schon Mai geworden, und man konnte in einem warmen Sonnenfleck auf der Straßenböschung sitzen – es war gerade nicht die schönste Ecke, die da vor ihnen lag, eher eines der dürftigen Stücke, nur daß es unter der Beleuchtung dieses Tages sich verschönte –, auf einmal merkten sie beide, daß sie hier nicht mehr weg wollten.“"
                                            },
                                            {
                                                "example_id": "82acb445-2e52-45ce-8ceb-e9d5a3b1c6f7",
                                                "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                                "text": "„Wieder, wie schon vor einigen Stunden beim Anblick des Weberknechts im Sonnenfleck, überkam Aurich die nun schon bekannte Erregung und begann sein Herz in unmäßigem Tempo zu schlagen.“"
                                            },
                                            {
                                                "example_id": "e27cd0dd-0dd4-4500-ae98-6f1fb8ebd5a1",
                                                "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                                "text": "„Ich ging durch den Sonnenfleck im Flur, und ich wußte mit mir nicht wohin.“"
                                            },
                                            {
                                                "example_id": "11599376-1235-4746-a268-27bb6bff9ad0",
                                                "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                                "text": "„Vögel zwitscherten und flatterten in dem von Sonnenflecken durchbrochenen Halbdunkel.“"
                                            },
                                            {
                                                "example_id": "366064ad-ff50-41c4-bc3b-3de5ad6798a5",
                                                "sense_id": "ad368af5-0442-3f16-9bfc-03e3abc3e3d8",
                                                "text": "„Es ist hell im Zimmer, ein paar Sonnenflecken liegen auf dem gebohnerten Boden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
