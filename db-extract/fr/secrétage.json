                                "target_senses": [
                                    {
                                        "sense_id": "31819672-01e9-3301-bc71-61bae96d2221",
                                        "entry_id": "0f4c32d9-802c-3ee2-b72e-5d75e05dbce3",
                                        "glosses": [
                                            "A process in which mercury, or some of its salts, is employed to impart the property of felting to certain kinds of furs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c9cd20-e9bf-4038-8971-5f24cf37de38",
                                                "sense_id": "31819672-01e9-3301-bc71-61bae96d2221",
                                                "text": "This defect in the straight filaments he supposed to be removed by secretage, or the application of a solution of nitrate of mercury to the tips of the fur on the skin , which caused these to curl"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7420bf1-043e-4813-9e61-1c08afe8334f",
                        "source_entry_id": "70085c0d-9242-3ad8-b002-acacb3f448ed",
                        "source_sense_description": "Procédé",
                        "target_lang_word": "carroting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carroting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86658062-8b63-3fc2-9b10-72884725cd96",
                                        "entry_id": "a6f96766-5e17-3aa4-9f1b-80e94b3a2b55",
                                        "glosses": [
                                            "A process in the manufacture of felt in which the animal pelt is treated with a solution of mercury salts, such as mercuric nitrate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5227d56d-ab19-45a8-a9d7-0b7cd7cdafef",
                                                "sense_id": "86658062-8b63-3fc2-9b10-72884725cd96",
                                                "text": "The present commonly used method for application of the carroting solution to the furs is, as indicated above, the brushing of the fur with the solution while the fur is on the pelt, with subsequent drying usually performed at an elevated temperature."
                                            },
                                            {
                                                "example_id": "7f4a2fed-b4cf-4b6a-93e5-8748a852c098",
                                                "sense_id": "86658062-8b63-3fc2-9b10-72884725cd96",
                                                "text": "In a now-classic 2002 article, they warn museum professionals that the remnants of mercury from the carroting process still remain a threat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
