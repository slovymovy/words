                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d203fa-9ebc-4276-a7c4-b2f3159c7d69",
                                "sense_id": "5ca0d69d-b310-33aa-8d64-450ce8199915",
                                "text": "Syndrome caractérisé par une augmentation excessive de la boisson et de l’élimination urinaire, la polyuro-polydipsie est observée dans des circonstances pathologiques très variées qui n’impliquent pas nécessairement l’appareil urinaire."
                            },
                            {
                                "example_id": "db65d4c2-d3cd-4f78-9710-a514b9ca91d8",
                                "sense_id": "5ca0d69d-b310-33aa-8d64-450ce8199915",
                                "text": "La polyurie et la polydipsie sont des symptômes (comme la fièvre), elles incitent à rechercher un diabète…."
                            }
                        ]
                    }
