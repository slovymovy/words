                                        "entry_id": "81a89f7d-0d4c-3ce6-ba42-6d526ed937ba",
                                        "glosses": [
                                            "der Fährmann, der Schiffer"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d02858fa-e667-4e60-82a8-f8ea26cf6944",
                                                "sense_id": "fef370b0-0b3f-316e-b82c-240d719908e6",
                                                "text": "Der Ferge setze uns über den Fluss."
                                            },
                                            {
                                                "example_id": "b6c21fcd-b8ce-4e09-9b45-64fc153b97f0",
                                                "sense_id": "fef370b0-0b3f-316e-b82c-240d719908e6",
                                                "text": "„Der Ferge stöhnt: ‚In Seegesträuch / Reißt nieder uns der blanke Leib! […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
