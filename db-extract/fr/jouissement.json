                "senses": [
                    {
                        "sense_id": "566b9659-7459-3ca1-9aac-f70b51cb6f87",
                        "entry_id": "f0b4b7de-eda0-3443-a185-a7d28c7ee343",
                        "glosses": [
                            "Action de jouir ; état de celui ou de celle qui jouit ; jouissance."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d26a5902-c22f-46f3-8e45-dead5464c9f3",
                                "sense_id": "566b9659-7459-3ca1-9aac-f70b51cb6f87",
                                "text": "Ma douce main de maîtresse et d'amant\nPasse et rit sur ta chère chair en fête,\nRit et jouit de ton jouissement."
                            },
                            {
                                "example_id": "17950132-3246-4f34-ae34-09cf7cff5207",
                                "sense_id": "566b9659-7459-3ca1-9aac-f70b51cb6f87",
                                "text": "Quand on n’a pas de château où prolonger ses vacances dans le doux jouissement des soirées de septembre, on va faire un petit voyage avant de reprendre la vie de la capitale."
                            },
                            {
                                "example_id": "51837290-d32a-41e6-8614-60fe09e8b44e",
                                "sense_id": "566b9659-7459-3ca1-9aac-f70b51cb6f87",
                                "text": "Dans la salle on trépigne, on ricane. C'est un délassement joyeux, un jouissement de bêtes qui s’étirent devant la pâture qu’on leur apprête."
                            },
                            {
                                "example_id": "8c698ea1-a805-4c1a-b534-0c38ed1a8d28",
                                "sense_id": "566b9659-7459-3ca1-9aac-f70b51cb6f87",
                                "text": "Et j'imaginai le spectacle ; je vis, avec une netteté déchirante, étinceler des pierres et des plastrons ; rayonner des yeux et des lèvres. Je vis, entre des glaces, un jouissement de chairs blanches, entre quoi, légers et jaunes, oscillaient des mimosas."
                            }
                        ]
                    }
                ],
