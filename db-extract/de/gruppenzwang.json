                                                "example_id": "367b8306-9130-475b-9aa7-16a2f6b7cf53",
                                                "sense_id": "988e3c33-8177-3e7b-897b-539195ca3271",
                                                "text": "He was peer-pressured into taking drugs."
                                            }
