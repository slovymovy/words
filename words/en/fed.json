                {
                    "sense_id": "fdd9a05d-c54e-3296-bfc5-85b568797d6f",
                    "sense_definition": "A police officer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone scattered when they saw the <w>feds</w> turn the corner.",
                            "target_lang_translations": {
                                "ru": "Все разбежались, когда увидели, что из-за угла вышли <w>легавые</w>.",
                                "tr": "<w>Polislerin</w> köşeyi döndüğünü görünce herkes dağıldı.",
                                "nl": "Iedereen stoof uiteen toen ze de <w>politie</w> de hoek om zagen komen.",
                                "fr": "Tout le monde s'est dispersé quand ils ont vu les <w>flics</w> tourner au coin de la rue."
                            }
                        },
                        {
                            "text": "He got arrested by the <w>feds</w> for causing a disturbance downtown.",
                            "target_lang_translations": {
                                "ru": "Его арестовали <w>копы</w> за нарушение порядка в центре города.",
                                "tr": "Şehir merkezinde huzursuzluk çıkardığı için <w>polisler</w> tarafından tutuklandı.",
                                "nl": "Hij werd door de <w>politie</w> gearresteerd voor het veroorzaken van overlast in het centrum.",
                                "fr": "Il a été arrêté par les <w>flics</w> pour avoir causé des troubles au centre-ville."
                            }
                        }
                    ],
