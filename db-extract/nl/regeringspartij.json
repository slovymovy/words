                "senses": [
                    {
                        "sense_id": "bc985200-9c3a-32b4-9c8a-5951ffe1e851",
                        "entry_id": "6ff15a7b-b607-3f47-910a-6881e1c28a34",
                        "glosses": [
                            "een politieke partij waarvan een of meer ministers lid van de ministerraad zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5130b6-ad28-42d4-8ace-13d8a99c0189",
                                "sense_id": "bc985200-9c3a-32b4-9c8a-5951ffe1e851",
                                "text": "Winkeliers moeten extra tijd krijgen om sigaretten en tabakswaar uit het zicht te laten verdwijnen. Regeringspartij VVD wil dat staatssecretaris Blokhuis van Volksgezondheid meer tijd neemt voor dit deel van zijn anti-rookplannen."
                            },
                            {
                                "example_id": "16d3f821-d901-444f-9dca-795bf00616f2",
                                "sense_id": "bc985200-9c3a-32b4-9c8a-5951ffe1e851",
                                "text": "Abe werd doodgeschoten toen hij vrijdag in de stad Nara kiezers toesprak namens regeringspartij LDP, in de aanloop naar de senaatsverkiezingen van zondag. Yamagami heeft bekend en volgens Kyodo ook toegegeven dat hij meerdere plekken had bezocht waar Abe verkiezingstoespraken hield."
                            }
                        ]
                    }
