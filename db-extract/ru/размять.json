                                        "examples": [
                                            {
                                                "example_id": "0a2c16ee-7f49-4aea-84b4-37dfbd034d23",
                                                "sense_id": "03bfa35c-869b-3ebd-989d-0efda182179e",
                                                "text": "Sie zerdrückte die Blaubeeren mit der Gabel."
                                            },
                                            {
                                                "example_id": "60bfeea4-4085-4a43-bcf5-9173dc9cb781",
                                                "sense_id": "03bfa35c-869b-3ebd-989d-0efda182179e",
                                                "text": "Sei vorsichtig, sonst zerdrückst du noch das Ei!"
                                            },
                                            {
                                                "example_id": "2bfdccfe-86fb-43fc-83c3-efe62add69a3",
                                                "sense_id": "03bfa35c-869b-3ebd-989d-0efda182179e",
                                                "text": "Ich zerdrück dich gleich wie eine Laus zwischen meinen Fingern!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e5d209d1-2c1a-33f1-9a3b-5ac97a86b1e2",
