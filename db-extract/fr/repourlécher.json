                        ],
                        "examples": [
                            {
                                "example_id": "d14c612b-8865-4c76-85a2-edf3af570c86",
                                "sense_id": "f33b2a8b-d535-3006-9898-1df04050c77b",
                                "text": "miamiamiamiamiam... je me lèche, pourlèche, repourlèche les babines !"
                            },
                            {
                                "example_id": "d02e37e4-8056-4859-86ab-a027716e1177",
                                "sense_id": "f33b2a8b-d535-3006-9898-1df04050c77b",
                                "text": "je me pourlèche et repourlèche les babinettes !! ça m'a l'air drôlement bon !!"
                            },
                            {
                                "example_id": "f21c4de3-83db-4a1b-8dce-eaa34e2ee255",
                                "sense_id": "f33b2a8b-d535-3006-9898-1df04050c77b",
                                "text": "Marie (regardant Roxalía qui se repourlèche avec le reste de son Mars) : Mais c’est pas vrai ! Elle veut pas comprendre ce qu’on dit ! Regarde comme elle le fait exprès !!"
                            }
                        ]
                    }
