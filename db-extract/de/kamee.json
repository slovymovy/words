                        "source_entry_id": "e24f18d9-b482-3f36-8ab3-e2c3afd47b85",
                        "source_sense_id": "554f93e8-f9ad-3eac-8882-75c1350c8776",
                        "source_sense_description": "Edelstein oder Schmuckstein mit erhabener figürlicher Darstellung",
                        "target_lang_word": "камея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "камея",
