                "senses": [
                    {
                        "sense_id": "a29f52d4-d133-3ccd-8359-d49c5a19162d",
                        "entry_id": "ad3f9d50-0db3-3f4e-b19c-4ecbefab0d10",
                        "glosses": [
                            "In a manner befitting a gentlewoman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e864bf09-06ce-4ed3-8f1a-d35c6eade160",
                                "sense_id": "a29f52d4-d133-3ccd-8359-d49c5a19162d",
                                "text": "For you shall have some, yea many thousands, that live uppon nothing els, and yet go clothed gentlewomanlike both in their silks, and otherwyse, with their fingers clogged with rings, their wrists with bracelets and jewels, and their purses full of gold and silver."
                            },
                            {
                                "example_id": "f7e45a92-66c8-45e6-a84a-7c63883de60f",
                                "sense_id": "a29f52d4-d133-3ccd-8359-d49c5a19162d",
                                "text": "To clarify the spirit in which he undertakes the repayment of his loan, Mountford dresses himself \"gentlemanlike\" and requires Susan to dress \"gentlewomanlike.\""
                            },
                            {
                                "example_id": "4bb62f65-b4c6-4a68-b251-ce9d5a590dcc",
                                "sense_id": "a29f52d4-d133-3ccd-8359-d49c5a19162d",
                                "text": "It is this contamination of the outward appearance of gentility by actual “unchaste” behaviour that helps to work Stubbes into puritan fury and fuels his vituperative attack on those women who maintain themselves in high style by whoredom, “and yet go clothed Gentlewomanlike.\""
                            }
                        ]
                    }
