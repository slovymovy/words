                                "target_senses": [
                                    {
                                        "sense_id": "e5d29d16-7695-346d-9d5e-a49fcb25625d",
                                        "entry_id": "cfa5bb35-e05b-391b-b7b9-7f233152f70b",
                                        "glosses": [
                                            "Someone who institutes a legal suit; a plaintiff or complainant."
                                        ],
                                        "tags": [
