                        "examples": [
                            {
                                "example_id": "7f2fa9de-ca10-4030-b388-62a886b78f9d",
                                "sense_id": "4568cb0a-3f0c-3a93-a2e6-3e2c0b5b31c0",
                                "text": "\"We gaan meer projectleiding, nog meer ingenieurs, buitenlandteams (met Duitse partners), inkopers en planners inzetten,\" zegt de directeur. Hij schat dat het in eerste instantie om tientallen nieuwe banen gaat, mogelijk oplopend tot meer dan honderd. Volgens Keulen zijn de banen tot twaalf jaar gewaarborgd."
                            },
                            {
                                "example_id": "6c1e5085-5fc7-4f66-aef7-ec24344076bf",
                                "sense_id": "4568cb0a-3f0c-3a93-a2e6-3e2c0b5b31c0",
                                "text": "De projectleiding voerde prominente deskundigen op bij de subsidieaanvraag van 100.000 euro bij de gemeente Amsterdam, terwijl deze geen lid waren van het onderzoeksteam."
                            },
                            {
                                "example_id": "9f3a8dc6-367c-4e3b-9f05-4b640186ad87",
                                "sense_id": "4568cb0a-3f0c-3a93-a2e6-3e2c0b5b31c0",
                                "text": "Het initiatief tegen medicijnverspilling begon met vier ziekenhuizen en ongeveer duizend kankerpatiënten. Vorig jaar oktober hadden die ziekenhuizen gezamenlijk 600.000 euro bespaard en daarnaast is volgens de projectleiding gebleken dat heruitgifte van dure medicijnen \"haalbaar en veilig\" is."
                            }
                        ]
                    }
