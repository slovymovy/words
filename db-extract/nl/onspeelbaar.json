                    {
                        "sense_id": "89bf1392-a58f-3480-9109-18f7b7e81271",
                        "entry_id": "c8144235-40e9-3ba4-9635-c63eb4cd32a7",
                        "glosses": [
                            "van een compositie dat deze niet te vertolken is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df75ab15-4439-4439-a52d-6d45668364f8",
                                "sense_id": "89bf1392-a58f-3480-9109-18f7b7e81271",
                                "text": "Een componist moet, bij voorbeeld bij het schrijven van een vioolconcert, denken aan de beste onder de bestaande violisten. Misschien beter nog aan de ideale violist? Nee, want dan wordt het een onspeelbaar stuk."
                            }
                        ]
                    },
                    {
