{
    "word_family": [
        "key"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e3f03a87-cef6-30f8-8a7f-5a0c977816fe",
                    "sense_definition": "Restrained, subtle, and not trying to attract attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restrained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>low-key</w> performance that was still very impressive.",
                            "target_lang_translations": {
                                "ru": "Она выступила <w>скромно</w>, но это все равно произвело большое впечатление."
                            }
                        },
                        {
                            "text": "They decided to have a <w>low-key</w> wedding with only close family.",
                            "target_lang_translations": {
                                "ru": "Они решили устроить <w>скромную</w> свадьбу только для самых близких."
                            }
                        }
                    ],
                    "antonyms": [
                        "high-key"
                    ],
                    "common_phrases": [
                        "low-key event",
                        "low-key approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдержанный, неброский, не привлекающий лишнего внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скромный",
                                "target_lang_sense_clarification": "о поведении или мероприятии, не претендующем на пышность"
                            },
                            {
                                "target_lang_word": "неброский",
                                "target_lang_sense_clarification": "о чем-то, что не выделяется и не бросается в глаза"
                            },
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "о стиле или манере поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dc0c2c7-ff25-32cf-9e61-621aed8c3bf6",
                    "sense_definition": "Characterized by dark tones and muted colors in art or photography.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "artistic_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer used <w>low-key</w> lighting to create a dramatic mood.",
                            "target_lang_translations": {
                                "ru": "Фотограф использовал освещение в <w>низком ключе</w>, чтобы создать драматическое настроение."
                            }
                        },
                        {
                            "text": "This <w>low-key</w> painting uses shadows to hide most of the subject.",
                            "target_lang_translations": {
                                "ru": "Эта картина в <w>низком ключе</w> использует тени, чтобы скрыть большую часть объекта."
                            }
                        }
                    ],
                    "antonyms": [
                        "unadorned"
                    ],
                    "common_phrases": [
                        "low-key lighting",
                        "low-key photography"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся темными тонами и приглушенными цветами в искусстве или фотографии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низкий ключ",
                                "target_lang_sense_clarification": "специальный термин в фотографии и живописи, основанный на преобладании темных тонов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4a42ea0a-544b-3a59-8226-6ede3474d3b3",
                    "sense_definition": "In a quiet, secret, or understated manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restrained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>low-key</w> left the party without saying goodbye to anyone.",
                            "target_lang_translations": {
                                "ru": "Он <w>незаметно</w> ушел с вечеринки, ни с кем не попрощавшись."
                            }
                        },
                        {
                            "text": "They are <w>low-key</w> planning a surprise trip for their parents.",
                            "target_lang_translations": {
                                "ru": "Они <w>тихо</w> планируют поездку-сюрприз для своих родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "furtively"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихо, скрытно или без лишнего шума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаметно",
                                "target_lang_sense_clarification": "не привлекая внимания окружающих"
                            },
                            {
                                "target_lang_word": "тихо",
                                "target_lang_sense_clarification": "без огласки или лишних действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf154473-730e-3464-a2e3-253a524faece",
                    "sense_definition": "To a slight degree; somewhat or secretly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>low-key</w> think that movie was better than the first one.",
                            "target_lang_translations": {
                                "ru": "Я <w>пожалуй</w> считаю, что этот фильм был лучше первого."
                            }
                        },
                        {
                            "text": "She is <w>low-key</w> excited about the new job offer.",
                            "target_lang_translations": {
                                "ru": "Она <w>немного</w> взволнована предложением о новой работе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in modern informal digital communication."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В некоторой степени; слегка или тайком (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "в значении 'слегка', 'отчасти'"
                            },
                            {
                                "target_lang_word": "пожалуй",
                                "target_lang_sense_clarification": "выражает скрытое или не до конца высказанное мнение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}