                "senses": [
                    {
                        "sense_id": "e8b40982-8d20-3ed3-9a0b-04feda1af9c0",
                        "entry_id": "06c0621f-5beb-389e-9dc2-9a048cd09c11",
                        "glosses": [
                            "Erinnerung an Erlebnisse in der Jugendzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947a23a0-9e92-4eba-96fc-d641652e100b",
                                "sense_id": "e8b40982-8d20-3ed3-9a0b-04feda1af9c0",
                                "text": "Julius hat seine Jugenderinnerungen aufgeschrieben und veröffentlicht."
                            },
                            {
                                "example_id": "7759639c-8b07-424c-bfa9-f53ec409597b",
                                "sense_id": "e8b40982-8d20-3ed3-9a0b-04feda1af9c0",
                                "text": "Marie-Louise und Ingo saßen stundenlang im Wintergarten und schwelgten in Jugenderinnerungen."
                            },
                            {
                                "example_id": "d2e3160a-fb67-480d-a38a-ec89a6fce5fd",
                                "sense_id": "e8b40982-8d20-3ed3-9a0b-04feda1af9c0",
                                "text": "Der erste Besuch der Auswanderer in ihrer Heimatstadt nach vielen Jahrzehnten rief eine Fülle von Jugenderinnerungen wach."
                            },
                            {
                                "example_id": "a4bf6351-b49c-4c37-866a-7afcecee56d0",
                                "sense_id": "e8b40982-8d20-3ed3-9a0b-04feda1af9c0",
                                "text": "„Ähnlich wie bei meiner Exkursion nach Struth befielen mich schon während dieser Anfahrt dermaßen viele Jugenderinnerungen, dass ich sogar versäumte, einen Blick auf das imposante Wildgatter zu werfen, das seit vielen Jahren den aus dem nahen Mühlhausen herausführenden Weidenseeweg säumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
