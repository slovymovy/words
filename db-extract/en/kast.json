                        "entry_id": "a3f29530-c215-3642-ba19-1f020881b061",
                        "glosses": [
                            "A type of traditional cupboard produced by Dutch settlers in New York and New Jersey in the 18th and 19th centuries"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f824028-6c69-4ecd-bda0-4a30c94f1edd",
                                "sense_id": "28f9af80-e377-3aef-9392-58d8ffb39da7",
                                "text": "At Clifford A. Wallach tramp art rules absolutely, most unusually in a large cupboard that has the mass of a Dutch kast armoire and is painted light green."
                            },
                            {
                                "example_id": "de839887-9182-4fc6-b7c5-bfdf81c14ac4",
                                "sense_id": "28f9af80-e377-3aef-9392-58d8ffb39da7",
                                "text": "The exhibition includes the kinds of Dutch furnishings that might have been found in 17th- century estates: pewter plates, silver bowls, brass candlesticks, Dutch tiles, Bible boxes, Delft jars and Dutch cupboards, called kasts."
                            }
                        ]
                    }
