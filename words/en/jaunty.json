                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jaunty</w> inspected the crew quarters this morning.",
                            "target_lang_translations": {
                                "es": "El <w>maestre de armas</w> inspeccionó los alojamientos de la tripulación esta mañana."
                            }
                        },
                        {
                            "text": "Every sailor knows to respect the <w>jaunty</w> on board.",
                            "target_lang_translations": {
                                "es": "Todo marinero sabe que hay que respetar al <w>maestre de armas</w> a bordo."
                            }
