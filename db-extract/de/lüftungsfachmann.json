                "senses": [
                    {
                        "sense_id": "745e9f44-889e-3463-9f62-c1b29beef363",
                        "entry_id": "4501025d-019a-399d-a5c4-9b21d3683462",
                        "glosses": [
                            "männliche Person, die in Lüftungstechnik ausgebildet ist und entsprechende Fachkenntnisse hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede76f59-3205-4579-9d37-51e9ef191531",
                                "sense_id": "745e9f44-889e-3463-9f62-c1b29beef363",
                                "text": "„Im Gespräch mit dem Lüftungsfachmann informiert sich ein Hausbesitzer über die Funktionsweise einer kontrollierten Wohnungslüftung.“"
                            },
                            {
                                "example_id": "d7b4df7a-877f-41ae-8ce8-db3104932f9b",
                                "sense_id": "745e9f44-889e-3463-9f62-c1b29beef363",
                                "text": "„Was im Einzelnen an Anlagentechnik dazu gehört und was für den Lüftungsfachmann zu beachten ist, hat der ZVSHK in seiner neuen Fachinformation zusammengetragen.“"
                            },
                            {
                                "example_id": "49dca09b-0b2b-4e0d-83ad-9ab4059dce9d",
                                "sense_id": "745e9f44-889e-3463-9f62-c1b29beef363",
                                "text": "„Mit der Aktion „Die bessere Lüftung in Auto-Einstellhallen\" sollen die Betreibenden von Einstellhallen auf Basel-Städtischem Boden dazu motiviert werden, ihre Lüftungsanlagen gratis von einem Lüftungsfachmann checken zu lassen.“"
                            },
                            {
                                "example_id": "eec8fc9e-d1d7-49c4-a0e5-34db686217a4",
                                "sense_id": "745e9f44-889e-3463-9f62-c1b29beef363",
                                "text": "„Um diesem Problem entgegenzuwirken plädiert der Lüftungsfachmann Peter Anesini von der Zehnder Comfosystems AG in seinem Referat bei Neu- und Umbauten auf den frühzeitigen Einbezug von Lüftungsfachleuten.“"
                            },
                            {
                                "example_id": "96785d5f-e0f9-4c44-aa12-33aa939644ae",
                                "sense_id": "745e9f44-889e-3463-9f62-c1b29beef363",
                                "text": "„ Der Lüftungsfachmann der Kammer rechnet bei 1.500 Plätzen mit 82.000 bis 117.000 Euro, bei 3.000 Mastplätzen mit 138.000 bis 183.000 Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
