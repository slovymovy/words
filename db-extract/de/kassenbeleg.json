                "senses": [
                    {
                        "sense_id": "a36555d5-16d3-3e7d-a9af-e02b3a9d29d9",
                        "entry_id": "63b80ed5-7498-3c42-a5a6-00e74b3211e6",
                        "glosses": [
                            "von einer Registrierkasse ausgedruckte kleine Quittung für den Käufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1758fea3-db11-4670-8928-65e285fd9582",
                                "sense_id": "a36555d5-16d3-3e7d-a9af-e02b3a9d29d9",
                                "text": "In meiner Hosentasche fand ich einen alten Kassenbeleg."
                            },
                            {
                                "example_id": "7da643e9-4f40-4b32-ad7d-e5515dd3443a",
                                "sense_id": "a36555d5-16d3-3e7d-a9af-e02b3a9d29d9",
                                "text": "„In Deutschland gibt es bisher keine Pflicht, einen Kassenbeleg auch anzunehmen.“"
                            },
                            {
                                "example_id": "a8004a3c-6b25-4ef8-a0f3-3a49b0eeb4e0",
                                "sense_id": "a36555d5-16d3-3e7d-a9af-e02b3a9d29d9",
                                "text": "„Epap hat eine App entwickelt, die den Kassenbeleg digital versendet und speichert, ein Ausdruck ist nicht nötig.“"
                            },
                            {
                                "example_id": "64d19667-adf4-4df7-bb75-6487aa99d976",
                                "sense_id": "a36555d5-16d3-3e7d-a9af-e02b3a9d29d9",
                                "text": "„Denn für eine Angabe auf dem Kassenbeleg müsste der Kassenmitarbeiter warten, bis klar ist, mit welchem Betrag der Kunde zahlen möchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
