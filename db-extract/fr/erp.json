                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671f1499-0c12-4eb3-9172-01e0e18d9aba",
                                                "sense_id": "7360cf58-e027-3ab4-b4d4-f16e5d0b8385",
                                                "text": "Businesses of all sizes depend on software to operate. Two of the most important operations of any business are managing its internal resources and staying in close contact with customers. Enterprise resource planning (ERP) products help companies keep their internal operations running smoothly, while customer relationship management (CRM) software maintains and maximizes their interactions with existing and potential customers."
                                            }
                                        ]
