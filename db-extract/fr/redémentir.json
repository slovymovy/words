                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b85d06-efcf-452f-994d-5be41bc007ee",
                                "sense_id": "e36eb97a-8ada-3349-b395-0643c9e6a07a",
                                "text": "Des rumeurs qui deviennent des informations quand les pouvoirs politiques en place agacés se mettent à démentir et à redémentir."
                            },
                            {
                                "example_id": "e8590545-71b8-43dc-ac26-37a9e6382052",
                                "sense_id": "e36eb97a-8ada-3349-b395-0643c9e6a07a",
                                "text": "Le jeune homme devait trouver une réponse assez rapide pour démentir, plutôt redémentir, ce qu'avait dit Bérangère."
                            }
                        ]
                    }
