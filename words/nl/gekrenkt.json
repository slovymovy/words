                        {
                            "text": "De kritiek heeft hem persoonlijk enorm <w>gekrenkt</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "pl": "Krytyka podczas zebrania ogromnie go osobiście <w>dotknęła</w>."
                            }
                        }
                    ],
