                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26fc7568-169a-4e5f-85b8-5d239ad1cc0c",
                                                "sense_id": "8118e52d-ee81-35a3-a5b2-b0d730d04c87",
                                                "text": "Ministerstva se ve veškeré své činnosti řídí ústavními a ostatními zákony a usneseními vlády."
                                            },
                                            {
                                                "example_id": "4a487d1b-3f17-41a4-acd6-0a53e191a903",
                                                "sense_id": "8118e52d-ee81-35a3-a5b2-b0d730d04c87",
                                                "text": "Kdepak se mám dovolat zastání a spravedlnosti? Na ministerstvu? Vždyť je to takový jalový, nanicovatý úřad, dobrý tak akorát na obstarávání inkoustu, hajzpapíru a Husákových obrazů pro úřady krajských a okresních soudů."
                                            }
                                        ]
                                    },
