                    {
                        "sense_id": "687e364c-de4d-3cb6-8023-4adc6a6884e9",
                        "entry_id": "cb4800ff-d3bf-309f-87e6-063715e14c02",
                        "glosses": [
                            "działalność strony trzeciej, która ma na celu porozumienie się między stronami lub załatwienie jakiejś sprawy dotyczącej obu stron"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fae1ffc-496c-4f9f-8887-a98216b1712b",
                                "sense_id": "687e364c-de4d-3cb6-8023-4adc6a6884e9",
                                "text": "Ireneusz miał prawo pisać o tradycji, bo będąc uczniem św. Polikarpa, który słuchał nauk św. Jana apostoła, przyswoił sobie za jego pośrednictwem tradycję apostolską."
                            }
