                        ],
                        "zh": [
                            {
                                "target_lang_word": "皇后",
                                "target_lang_sense_clarification": "活动中的荣誉称号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc1f9dd-ddf5-3a47-bb36-b7bfbdae1a51",
                    "sense_definition": "A woman who is pre-eminent or highly successful in a particular field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is widely considered the <w>queen</w> of pop music.",
                            "target_lang_translations": {
                                "ru": "Ее повсеместно считают <w>королевой</w> поп-музыки.",
                                "zh": "她被公认为流行音乐的<w>天后</w>。"
                            }
                        },
                        {
                            "text": "The actress was the reigning <w>queen</w> of Hollywood for over a decade.",
                            "target_lang_translations": {
                                "ru": "Актриса была правящей <w>королевой</w> Голливуда более десяти лет.",
                                "zh": "这位女演员统治好莱坞超过十年，是当之无愧的<w>天后</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goddess"
                    ],
                    "common_phrases": [
                        "queen of pop",
                        "reigning queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, занимающая выдающееся положение или добившаяся больших успехов в определенной области.",
                        "zh": "在某一领域中处于领先地位或极具影响力的女性。"
