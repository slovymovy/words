                        "examples": [
                            {
                                "example_id": "5a093144-d9aa-4d13-a5c6-31d942d68b37",
                                "sense_id": "279b12af-2273-34e8-b0d6-2ffd9805251f",
                                "text": "„Die Männer trugen Masken aus Knochenkohle, die sie sich um die Augen geschmiert hatten; einige hatten auch die Augen ihrer Pferde geschwärzt.“"
                            }
