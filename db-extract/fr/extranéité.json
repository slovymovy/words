                "senses": [
                    {
                        "sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
                        "entry_id": "e0c577f0-ba03-37dd-a628-8d0e56568bd1",
                        "glosses": [
                            "Qualité d’étranger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc3b9ed-f7c1-40fe-a544-51abe6c0ec53",
                                "sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
                                "text": "Les forces surnaturelles, magiques, se révèlent être des forces étonnamment moïques. Les forces du colon sont infiniment rapetissées, frappées d’extranéité. On n’a plus vraiment à lutter contre elles puisque aussi bien ce qui compte c’est l’effrayante adversité des structures mythiques. Tout se résout, on le voit, en affrontement permanent sur le plan phantasmatique."
                            },
                            {
                                "example_id": "6e963169-1f51-4e0a-bd17-a989d1492ab8",
                                "sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
                                "text": "Vu du côté des colonisés, l’extranéité de l’État se traduisait par une gouvernance arbitraire et aliénante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99138db7-3063-43f7-a9ea-7d84046709d3",
                        "source_entry_id": "e0c577f0-ba03-37dd-a628-8d0e56568bd1",
                        "source_sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
