                "senses": [
                    {
                        "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                        "entry_id": "ad4b89aa-58fa-3768-a157-0a67385e839e",
                        "glosses": [
                            "Dienstleistungen zur Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c78a6d-faae-40d6-ae40-1286012f880e",
                                "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                                "text": "\"Die Lüftungsreiniger\" sind Ihr kompetenter Partner in Bad Kissingen, Hammelburg, Bad Brückenau und Bad Neustadt wenn es um Lüftungsservice wie z.B. Lüftungsreinigung geht."
                            },
                            {
                                "example_id": "17c4f6c1-f96c-428f-ac54-9ee92eb0f87e",
                                "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                                "text": "Lüftungsservice umfasst verschiedene Dienstleistungen und Massnahmen, die dazu dienen, die Funktionsfähigkeit und Effizienz von Lüftungsanlagen in Gebäuden zu gewährleisten."
                            },
                            {
                                "example_id": "48f21e0e-c515-4a22-b9c4-bb6503c9d09b",
                                "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                                "text": "Der Lüftungsservice umfasst die regelmäßige Inspektion, Wartung und Reinigung von Lüftungsanlagen in Gebäuden."
                            },
                            {
                                "example_id": "f682ce38-1edc-436a-a094-ce6ee07935a0",
                                "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                                "text": "Der Lüftungsservice ist ein wachsender Markt mit immer komplexeren Anforderungen."
                            },
                            {
                                "example_id": "9e718d26-904b-485b-83d4-4e26816fadc8",
                                "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                                "text": "Ausgebildete Spezialisten für die privaten und gewerblichen Bereiche der Schädlingsbekämpfung, des Bautenschutzes und Lüftungsservices, wir arbeiten diskret, zuverlässig und innovativ im fachlich schnellstmöglichen Zeitfenster."
                            },
                            {
                                "example_id": "a37b71ce-c95a-4a0b-92ff-e0c9d985e83d",
                                "sense_id": "763d90f2-9757-3f34-9d9e-d83cdecd48b5",
                                "text": "In unregelmäßigen Abständen informieren wir Sie über Neuigkeiten der Lüftungsservice Liebetrau GmbH, über aktuelle Projekte, Jobangebote und Entwicklungen in der Branche Lüftungs- und Klimatechnik."
                            }
                        ],
