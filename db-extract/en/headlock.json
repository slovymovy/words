                    },
                    {
                        "translation_id": "537f87a9-92b4-4408-8d3c-1fd1fd869f68",
                        "source_entry_id": "431fe0c0-59ef-34f9-abcd-ea36ef7362eb",
                        "source_sense_id": "ddaabcfd-5a90-3add-ab88-17badb7f7d1c",
                        "source_sense_description": "wrestling move",
                        "target_lang_word": "Schwitzkasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwitzkasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                                        "entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                                        "glosses": [
                                            "Kasten für Schwitzbäder, bei dem während der Benutzung nur der Kopf aus einer Öffnung schaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e64c78f-eb4d-4ddf-a30a-afa637a15ec8",
                                                "sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                                                "text": "Er saß eine Stunde lang im Schwitzkasten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                        "entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                                        "glosses": [
                                            "Griff, bei dem jemand den Kopf eines anderen unter den Arm klemmt, so dass dieser in seiner Bewegungsfreiheit stark eingeschränkt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80948093-bd5e-4dcd-aa95-d56e5b8d0f97",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "Der Rowdy nahm seinen Mitschüler in den Schwitzkasten und gab ihm Kopfnüsse."
                                            },
                                            {
                                                "example_id": "31b12ecb-fa6d-4592-ab87-e5d3cd580396",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„Das nahm er in den Schwitzkasten und zerrte es zentaurenähnlich über den Flur.“"
                                            },
                                            {
                                                "example_id": "33d66371-b8fd-457d-b43f-dd8346ee1b52",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„Er konzentriert sich darauf, sich aus dem Schwitzkasten des Gladiators zu befreien.“"
                                            },
                                            {
                                                "example_id": "129fc5eb-d9ef-4a26-a58b-5db4304f1f1a",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„Bevor sie sich auch nur in Positur gestellt hätten, hätte ich schon drei Purzelbäume geschlagen, mich von hinten an sie herangemacht, sie aufs Kreuz gelegt und in den Schwitzkasten genommen.“"
                                            },
                                            {
                                                "example_id": "0139cd13-fb79-4333-9215-36fb6a29ffa3",
                                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                                "text": "„In keuchenden Kämpfen, bei Schwitzkasten und Schweiß kommt es leicht abhanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
