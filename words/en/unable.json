{
    "word_family": [
        "ability",
        "able",
        "disable",
        "enable",
        "inability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b1b5117-e5eb-3f96-885e-b7ae47f7f5c1",
                    "sense_definition": "Lacking the power, means, or skill to do something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "incapacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team was <w>unable</w> to reach the mountain climbers because of the heavy snow.",
                            "target_lang_translations": {
                                "ru": "Спасательная команда <w>не смогла</w> добраться до альпинистов из-за сильного снегопада."
                            }
                        },
                        {
                            "text": "He felt <w>unable</w> to help his friend during the difficult situation.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>неспособным</w> помочь другу в этой трудной ситуации."
                            }
                        }
                    ],
                    "synonyms": [
                        "helpless"
                    ],
                    "antonyms": [
                        "able"
                    ],
                    "common_phrases": [
                        "unable to help",
                        "unable to attend",
                        "unable to cope",
                        "unable to move"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий возможности, средств или навыков для совершения какого-либо действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспособный",
                                "target_lang_sense_clarification": "не обладающий способностями или силами"
                            },
                            {
                                "target_lang_word": "не в состоянии",
                                "target_lang_sense_clarification": "не имеющий возможности в данный момент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "02123bc9-9bdb-3e07-bacf-4a2ebb7ff4f5",
                    "sense_definition": "A standard response used to indicate that a requested action or instruction cannot be performed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "refusal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot replied <w>unable</w> when the tower asked him to climb to a higher altitude.",
                            "target_lang_translations": {
                                "ru": "Пилот ответил «<w>не имею возможности</w>», когда диспетчерская вышка попросила его подняться на большую высоту."
                            }
                        },
                        {
                            "text": "We have engine trouble and are <w>unable</w> to comply with your request.",
                            "target_lang_translations": {
                                "ru": "У нас проблемы с двигателем, и мы <w>не можем</w> выполнить ваш запрос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unable to comply"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used primarily in aviation and radio communications"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартный ответ, используемый для указания на то, что запрошенное действие или инструкция не могут быть выполнены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не имею возможности",
                                "target_lang_sense_clarification": "официальный отказ в радиообмене"
                            },
                            {
                                "target_lang_word": "выполнить не могу",
                                "target_lang_sense_clarification": "стандартная фраза в авиации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65dc7c7c-02ef-3b92-a789-ee0da3e9de5f",
                    "sense_definition": "To make someone or something <w>unable</w> to function or act.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disablement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injury <w>unabled</w> him for several months, preventing him from returning to work.",
                            "target_lang_translations": {
                                "ru": "Травма <w>вывела его из строя</w> на несколько месяцев, не давая вернуться к работе."
                            }
                        },
                        {
                            "text": "The virus <w>unabled</w> the entire computer network within minutes.",
                            "target_lang_translations": {
                                "ru": "Вирус <w>парализовал</w> всю компьютерную сеть за считанные минуты."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English; 'disable' is preferred"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо или что-либо неспособным функционировать или действовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить из строя",
                                "target_lang_sense_clarification": "лишать возможности работать"
                            },
                            {
                                "target_lang_word": "делать неспособным",
                                "target_lang_sense_clarification": "лишать сил или функций"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}