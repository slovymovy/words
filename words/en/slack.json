        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c108d251-beee-3d40-b1c3-c130423020c9",
                    "sense_definition": "To refuse to work as hard as one is supposed to.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>slack</w> on your responsibilities, the whole team suffers.",
                            "target_lang_translations": {
                                "ru": "Если вы будете <w>сачковать</w> при выполнении своих обязанностей, пострадает вся команда.",
                                "cs": "Pokud se budete <w>flákat</w> při plnění svých povinností, utrpí tím celý tým."
                            }
                        },
                        {
                            "text": "He decided not to <w>slack</w> because he wanted a promotion.",
                            "target_lang_translations": {
                                "ru": "Он решил не <w>бездельничать</w>, потому что хотел получить повышение.",
                                "cs": "Rozhodl se <w>nepolevovat</w>, protože usiloval o povýšení."
                            }
                        }
                    ],
                    "target_lang_definitions": {
