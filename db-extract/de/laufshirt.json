                "senses": [
                    {
                        "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                        "entry_id": "d1d0854c-cbae-3faf-a44b-9580bae9aa6f",
                        "glosses": [
                            "Oberteil (Sportshirt) mit kurzen oder langen Ärmeln, das speziell für das Laufen konzipiert ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "dc8c7815-6457-47e8-be8e-871fda01ac87",
                                "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                                "text": "„Während einige Läufer heute mit Mütze (!) und Handschuhen (!!!) unterwegs gewesen sind, habe ich mich für kurze Hose und kurzes Laufshirt entschieden.“"
                            },
                            {
                                "example_id": "24fb1928-8801-41f6-9b22-09844a764f6c",
                                "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                                "text": "„Nach dem erfolgreichen Start mit dem Laufschuh, folgt nun eine ganz Kollektion aus Laufshirts in Lang und Kurz, Tank-Tops, Laufhosen und Socken.“"
                            },
                            {
                                "example_id": "0aee9289-c15d-4937-9071-d41c7fe864ac",
                                "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                                "text": "„Katrin hingegen ist für die Bestellung der Laufshirts und die Organisation am Event Tag zuständig.“"
                            },
                            {
                                "example_id": "c83ab1af-ed95-4f32-a355-def5f4174e5a",
                                "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                                "text": "„Das Laufshirt ist schmal geschnitten, ultraleicht und besteht aus schnell trocknenden High-Tech-Materialien.“"
                            },
                            {
                                "example_id": "1af789fc-37af-4731-bfdd-a69ed81926cd",
                                "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                                "text": "„Und das Beste: Dein neues Laufshirt kannst Du ruhigen Gewissens tragen, denn es wurde unter fairen & sicheren Arbeitsbedingungen in Europa gefertigt.“"
                            },
                            {
                                "example_id": "24fd1848-c7ef-4867-8ded-9fa6508e4ae0",
                                "sense_id": "6997070e-f76d-3545-a4cb-6819d407e23b",
                                "text": "„Dank dem losen Schnitt bietet das Laufshirt absoluten Tragekomfort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
