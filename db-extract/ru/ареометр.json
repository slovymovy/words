                "senses": [
                    {
                        "sense_id": "c8fe0a9c-53e8-39b9-8c6f-2744b0f62c10",
                        "entry_id": "0af72ef7-66cd-3c0b-8d48-cc43bdb5314f",
                        "glosses": [
                            "прибор для измерения плотности жидкостей и твердых тел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e886f2-38ea-42ad-93e1-9d2937fc8c32",
                                "sense_id": "c8fe0a9c-53e8-39b9-8c6f-2744b0f62c10",
                                "text": "Вместе с тем батометром (также самодельным) он доставал пробы воды с разных глубин и измерял их плотность, температуру и соленость весьма точными термометрами и ареометрами (единственными покупными приборами)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccb176e2-29bf-4a68-9e6e-673d1eb9979b",
                        "source_entry_id": "0af72ef7-66cd-3c0b-8d48-cc43bdb5314f",
                        "source_sense_id": "c8fe0a9c-53e8-39b9-8c6f-2744b0f62c10",
                        "target_lang_word": "hydrometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrometer",
