                "senses": [
                    {
                        "sense_id": "53dd6a79-727e-3405-99ce-5fc141f5adab",
                        "entry_id": "48b5069b-dd69-3a52-991e-2e7bfe4f0adc",
                        "glosses": [
                            "binge, booze-up (drunken celebration)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "b5694893-3e3b-417c-bc26-00a5f0efd5d2",
                                "sense_id": "53dd6a79-727e-3405-99ce-5fc141f5adab",
                                "text": "On a fait la bringue toute la nuit.",
                                "translation": "We drank all night long.",
                                "english": "We drank all night long."
                            },
                            {
                                "example_id": "7a790c4f-57c5-40c2-bead-ebc673ab926d",
                                "sense_id": "53dd6a79-727e-3405-99ce-5fc141f5adab",
                                "text": "J'ai habité dans une chambre dans le 17e, rue des Acacias. Je me suis fait virer parce que j'avais fait un maximum de bringue."
                            },
                            {
                                "example_id": "76bfd454-1d85-4541-b692-044c3477076b",
                                "sense_id": "53dd6a79-727e-3405-99ce-5fc141f5adab",
                                "text": "Personellement, je trouve qu'une bringue est chiante si elle se veut hygiénique.",
                                "translation": "Personally, I think a booze-up is boring if it's meant to be healthy.",
                                "english": "Personally, I think a booze-up is boring if it's meant to be healthy."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
