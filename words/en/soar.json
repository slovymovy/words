{
    "word_family": [
        "soaring",
        "soarer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bef91c8-611b-36d1-a0f9-6fab55a09a6f",
                    "sense_definition": "To rise, especially rapidly or unusually high, such as in price, value, or amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pump prices <w>soared</w> into new heights as the strike continued.",
                            "target_lang_translations": {
                                "ru": "Цены на бензин <w>взлетели</w> до новых высот, пока продолжалась забастовка."
                            }
                        },
                        {
                            "text": "Economists expect that <w>soaring</w> inflation will affect the cost of living next year.",
                            "target_lang_translations": {
                                "ru": "Экономисты ожидают, что <w>стремительно растущая</w> инфляция повлияет на стоимость жизни в следующем году."
                            }
                        }
                    ],
                    "synonyms": [
                        "rocket",
                        "surge",
                        "skyrocket"
                    ],
                    "antonyms": [
                        "plummet",
                        "plunge",
                        "drop"
                    ],
                    "common_phrases": [
                        "soaring",
                        "inflation",
                        "prices",
                        "soar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремительно расти или подниматься до необычайно высокого уровня (о ценах, показателях и т. д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взлетать",
                                "target_lang_sense_clarification": "о ценах или показателях"
                            },
                            {
                                "target_lang_word": "резко расти",
                                "target_lang_sense_clarification": "о стоимости или количестве"
                            },
                            {
                                "target_lang_word": "взмывать",
                                "target_lang_sense_clarification": "о графиках или цифрах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f1e39f5-bed3-3c29-bba9-7687d7d7c689",
                    "sense_definition": "To fly high in the air with little effort, often by using air currents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the eagle <w>soar</w> high above the mountain peaks.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как орел <w>парит</w> высоко над горными вершинами."
                            }
                        },
                        {
                            "text": "The birds <w>soar</w> effortlessly through the sky on a warm afternoon.",
                            "target_lang_translations": {
                                "ru": "Птицы без усилий <w>парят</w> в небе теплым днем."
                            }
                        }
                    ],
                    "synonyms": [
                        "glide",
                        "ascend"
                    ],
                    "antonyms": [
                        "descend",
                        "fall"
                    ],
                    "common_phrases": [
                        "soar",
                        "high",
                        "above",
                        "soar",
                        "through",
                        "the",
                        "sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Парить высоко в воздухе без видимых усилий, используя воздушные потоки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "о птицах в небе"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "плавно лететь в потоке воздуха"
                            },
                            {
                                "target_lang_word": "взмывать",
                                "target_lang_sense_clarification": "подниматься высоко в небо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79cc6912-9c39-3c74-a9bd-7d38ed33dcc9",
                    "sense_definition": "To rise in thought, spirits, or imagination; to feel very happy or inspired.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her spirits <w>soared</w> when she heard the wonderful news about her promotion.",
                            "target_lang_translations": {
                                "ru": "Ее настроение <w>поднялось</w>, когда она услышала чудесную новость о своем повышении."
                            }
                        },
                        {
                            "text": "The music was so beautiful that it made my imagination <w>soar</w>.",
                            "target_lang_translations": {
                                "ru": "Музыка была настолько прекрасной, что заставила мое воображение <w>воспарить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "exult",
                        "uplift"
                    ],
                    "antonyms": [
                        "sink"
                    ],
                    "common_phrases": [
                        "spirits",
                        "soared",
                        "imagination",
                        "soars"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used figuratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься (о настроении, духе) или уноситься (о воображении); чувствовать сильное вдохновение или радость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспарять",
                                "target_lang_sense_clarification": "духом или мыслями"
                            },
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "о настроении"
                            },
                            {
                                "target_lang_word": "витать",
                                "target_lang_sense_clarification": "в облаках или мечтах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cb8fdb0-0d92-35d7-a131-61bfd56f34a7",
                    "sense_definition": "To remain aloft by means of a glider or other unpowered aircraft.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot managed to <w>soar</w> for hours using only the rising thermal currents.",
                            "target_lang_translations": {
                                "ru": "Пилоту удавалось <w>парить</w> часами, используя только восходящие тепловые потоки."
                            }
                        },
                        {
                            "text": "Learning how to <w>soar</w> in a glider requires a deep understanding of wind patterns.",
                            "target_lang_translations": {
                                "ru": "Обучение тому, как <w>планировать</w> на планере, требует глубокого понимания направления ветров."
                            }
                        }
                    ],
                    "synonyms": [
                        "glide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Держаться в воздухе на планере или другом безмоторном летательном аппарате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "на планере"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "используя восходящие потоки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f2242c5-892f-357b-af61-8c5d9dd113a8",
                    "sense_definition": "An upward flight or the act of rising high in the air.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The majestic <w>soar</w> of the hawk was a beautiful sight to behold.",
                            "target_lang_translations": {
                                "ru": "Величественное <w>парение</w> ястреба было прекрасным зрелищем."
                            }
                        },
                        {
                            "text": "With one powerful <w>soar</w>, the plane reached its cruising altitude.",
                            "target_lang_translations": {
                                "ru": "Одним мощным <w>взлетом</w> самолет достиг своей крейсерской высоты."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascent",
                        "climb"
                    ],
                    "antonyms": [
                        "descent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полет ввысь или акт стремительного подъема в воздух."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парение",
                                "target_lang_sense_clarification": "процесс нахождения в воздухе"
                            },
                            {
                                "target_lang_word": "взлет",
                                "target_lang_sense_clarification": "движение вверх"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "набор высоты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "aa9310f5-dca8-362f-ae52-74062976397b",
                    "sense_definition": "A river in Leicestershire, England, which is a tributary to the River Trent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "river",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Soar</w> flows through the city of Leicester.",
                            "target_lang_translations": {
                                "ru": "Река <w>Сор</w> протекает через город Лестер."
                            }
                        },
                        {
                            "text": "Many people enjoy walking along the banks of the <w>Soar</w> during the summer.",
                            "target_lang_translations": {
                                "ru": "Многим людям нравится гулять по берегам <w>Сора</w> в летнее время."
                            }
                        }
                    ],
                    "common_phrases": [
                        "River",
                        "Soar"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Лестершире, Англия, приток реки Трент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сор",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
