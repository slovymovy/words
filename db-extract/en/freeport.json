                        "examples": [
                            {
                                "example_id": "1eec9061-8566-4d12-b053-b49c2c04e6fb",
                                "sense_id": "55ed10f1-5005-33f5-91bd-b4d437c671ef",
                                "text": "Freeports, which can be airports and maritime ports, are a special kind of port where normal tax and customs regulations do not apply. [...] Businesses operating inside the designated areas in and around the port can manufacture goods using these imports and add value, before exporting again without ever facing full tariffs or procedures. Should the goods move out of the freeport into another part of the country, then they must go through the full import process - including paying any tariffs."
                            }
                        ]
                    }
