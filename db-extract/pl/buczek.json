                        "cross_references": [
                            {
                                "target_word": "hooter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03ba1545-dccc-3948-a4ea-9db6b4a32c1d",
                                        "entry_id": "1aaf5a6d-251a-33a3-b9c9-e8589ee27836",
                                        "glosses": [
                                            "A person who hoots."
                                        ],
