                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e609d07-a756-4df0-8ccc-37da16fdbcef",
                                "sense_id": "71cca9ba-954e-386b-98ab-56685a66b9a7",
                                "text": "„Flächen im mittleren Flutgebiet werden von den Kleinfluten nicht mehr betroffen und erfahren also auch durch solche keinen Schaden.“"
                            },
                            {
                                "example_id": "993daa5e-3955-4668-982d-2112856cf840",
                                "sense_id": "71cca9ba-954e-386b-98ab-56685a66b9a7",
                                "text": "„Ein Dockhafen wird nur im Flutgebiete, und auch hier nur unter gewissen Bedingungen, erforderlich. Im Flutgebiete heißt ein offener Hafen Tidehafen.“"
                            }
                        ],
