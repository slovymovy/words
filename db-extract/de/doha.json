                        "source_entry_id": "1d7a0d4c-c3b7-3f30-a0bd-b0d7ce36dc56",
                        "source_sense_id": "937d812d-4f0e-3b05-9bde-592ac0e197b9",
                        "source_sense_description": "Hauptstadt von Katar",
                        "target_lang_word": "Doha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doha",
