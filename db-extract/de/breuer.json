                    }
                ],
                "senses": [
                    {
                        "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                        "entry_id": "dbf0753b-a8ea-3b7f-9d6a-3afa376f9e88",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d76bac26-5d39-4c0e-831b-00557012b6ca",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Frau Breuer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c04118f5-6d71-4eb7-b790-52d4838512ce",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Herr Breuer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c1e407f7-5f58-440f-8821-3975b493355f",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Die Breuers kommen heute vom Zürichsee."
                            },
                            {
                                "example_id": "cebe6f2e-07c7-4861-88a6-bc69a8855dca",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Der Breuer trägt nie die Schals, die die Breuer ihm strickt."
                            },
                            {
                                "example_id": "dad3f643-e0f6-4591-80a8-4b103f89a93f",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breuer kommt, geht der Herr Breuer.“"
                            },
                            {
                                "example_id": "5d89a59e-606e-485a-b6af-686fe55e344f",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Breuer kommt und geht."
                            },
                            {
                                "example_id": "8d6b4a1c-b8e7-490a-bda0-c81cb046f1a5",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "Breuers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "1c8b49b7-16b9-4bda-b90d-9f1211e8463b",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "An verregneten Herbsttagen ist Familie Breuers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "b35984bf-bf9c-4bf7-96f9-609f5df634ac",
                                "sense_id": "c46ced11-c52b-3395-b745-aadd8a24fa29",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Breuer das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
