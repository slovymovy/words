                        "glosses": [
                            "twee mensen die samen een dans uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517d55df-033f-478c-9c4e-9a8cd46811ff",
                                "sense_id": "21633a54-92f5-3338-9d17-b99fa3f8d2f7",
                                "text": "Bijna 200 mensen hebben bij de BBC geklaagd omdat het programma Strictly Come Dancing een ballroomdans uitzond van twee mannen. Niet eerder in de 17 jaar dat het populaire tv-programma bestaat, werd een danspaar gevormd door twee mensen van hetzelfde geslacht."
                            },
                            {
                                "example_id": "10d6b042-f3a9-4784-8de3-43c8c6fa8714",
                                "sense_id": "21633a54-92f5-3338-9d17-b99fa3f8d2f7",
                                "text": "De Dongenaar geeft op dit moment nog steeds les in een cultureel centrum in zijn woonplaats. Ook de danstrainer uit Hoorn, Kurt F., geeft nog steeds les en coacht dansparen op hoog niveau. Hij moet voor de rechter verschijnen vanwege twee beschuldigingen van seksuele intimidatie van destijds minderjarige meisjes."
                            }
                        ]
                    }
