{
    "word_family": [
        "dictator",
        "dictate",
        "dictatorial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb4d125d-1d5a-3738-ac00-6ad52f01f106",
                    "sense_definition": "A form of government where absolute power is held by one person or a small group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "government_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country transitioned from a <w>dictatorship</w> to a democracy after the revolution.",
                            "target_lang_translations": {
                                "zh": "革命之后，该国从<w>独裁政体</w>转变为民主体制。"
                            }
                        },
                        {
                            "text": "Many citizens suffered under the harsh <w>dictatorship</w> for several decades.",
                            "target_lang_translations": {
                                "zh": "数十年间，许多民众在严酷的<w>独裁统治</w>下饱受苦难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "autocracy",
                        "despotism",
                        "tyranny"
                    ],
                    "common_phrases": [
                        "military dictatorship",
                        "under a dictatorship"
                    ],
                    "target_lang_definitions": {
                        "zh": "权力完全由一人或少数人掌握的政体或统治形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "专政",
                                "target_lang_sense_clarification": "指政治上的独裁体制或政治统治"
                            },
                            {
                                "target_lang_word": "独裁政体",
                                "target_lang_sense_clarification": "指绝对权力由一人或集团垄断的国家体制"
                            },
                            {
                                "target_lang_word": "独裁统治",
                                "target_lang_sense_clarification": "指专横专制的统治制度或状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1685caa4-5db9-3a7c-86e1-7638295d159a",
                    "sense_definition": "A government that exercises absolute and autocratic rule over its people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "government_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were no free elections during the long <w>dictatorship</w>.",
                            "target_lang_translations": {
                                "zh": "在漫长的<w>独裁统治</w>期间，根本没有自由选举。"
                            }
                        },
                        {
                            "text": "The <w>dictatorship</w> strictly controlled all media outlets in the nation.",
                            "target_lang_translations": {
                                "zh": "该<w>独裁政权</w>严格控制了国内的所有媒体机构。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absolutism",
                        "autocracy"
                    ],
                    "common_phrases": [
                        "overthrow the dictatorship"
                    ],
                    "target_lang_definitions": {
                        "zh": "实行绝对权力与专制统治的独裁政府或国家。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "独裁政权",
                                "target_lang_sense_clarification": "指专制独裁的统治当局或政权"
                            },
                            {
                                "target_lang_word": "独裁政府",
                                "target_lang_sense_clarification": "实行专制暴政的行政当局"
                            },
                            {
                                "target_lang_word": "专制国家",
                                "target_lang_sense_clarification": "指由独裁者掌控的国家"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ecabfc7-a93f-3a83-bdc7-7702e9816290",
                    "sense_definition": "An organization or household where one person has total control over all decisions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office felt like a <w>dictatorship</w> because the manager made every single decision alone.",
                            "target_lang_translations": {
                                "zh": "办公室感觉就像个<w>一言堂</w>，因为经理一个人包揽了所有决定。"
                            }
                        },
                        {
                            "text": "She jokingly called her strict household a <w>dictatorship</w> because of all the house rules.",
                            "target_lang_translations": {
                                "zh": "因为家规森严，她开玩笑地把自己的家称为<w>独裁王国</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个人对所有决定拥有完全控制权的组织、家庭或环境（比喻用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一言堂",
                                "target_lang_sense_clarification": "比喻一人说了算、缺乏民主的环境或机构"
                            },
                            {
                                "target_lang_word": "独裁",
                                "target_lang_sense_clarification": "指完全由个人独断专行"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}