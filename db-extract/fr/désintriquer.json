                "senses": [
                    {
                        "sense_id": "aba78ba7-6bc9-3fb6-83c3-2552ca87fe6a",
                        "entry_id": "d35b8dc0-429b-31e0-aa26-25d79b43452c",
                        "glosses": [
                            "Faire perdre son caractère intriqué à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a08ee4a-70ed-486a-bb01-de4c1b1895fa",
                                "sense_id": "aba78ba7-6bc9-3fb6-83c3-2552ca87fe6a",
                                "text": "Certes, désintriquer le Moi – s’en désintriquer ne voudrait rien dire – est projet inachevable, parce que, aussitôt une ouverture faite sur le texte de l’Ego, il se referme en se déplaçant."
                            },
                            {
                                "example_id": "c76258e6-1707-4266-a684-bf0e3983155f",
                                "sense_id": "aba78ba7-6bc9-3fb6-83c3-2552ca87fe6a",
                                "text": "La méthode consistera à désintriquer les facteurs en cause et à procéder par hiérarchisation et par comparaison, à solliciter des jugements relatifs pour des classes de contextes déterminées."
                            }
                        ]
                    }
