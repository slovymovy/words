                "senses": [
                    {
                        "sense_id": "21778303-dc4d-3ea4-aa7b-b3707234d4f4",
                        "entry_id": "58015884-181b-34f7-883c-c7451585f3e3",
                        "glosses": [
                            "Verser des larmes."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "34389c87-69a6-4fc0-a615-1c4936b60a88",
                                "sense_id": "21778303-dc4d-3ea4-aa7b-b3707234d4f4",
                                "text": "Si tu savais toutes les bonnes choses que N[otre] S[eigneur] m’a écrites à ton avantage tu ne serais pas triste, car ses trois lettres me font larmer de joie et de bonheur ; je ne puis te dire combien le bon Dieu t’aime ; jamais tu ne pourras l’apprécier."
                            },
                            {
                                "example_id": "d54d7096-9e8d-4a8b-95ba-595b712cb2a7",
                                "sense_id": "21778303-dc4d-3ea4-aa7b-b3707234d4f4",
                                "text": "Ouais ! Il peut toujours larmer, le gniard !"
                            }
                        ]
                    }
                ],
