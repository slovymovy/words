                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caec4da5-2a4e-4183-a6d3-f70f00241486",
                                "sense_id": "330f49e7-0431-37f6-a14c-1fd2fd2f6e98",
                                "text": "Wspomnienie św. Cecylii, patronki muzyki kościelnej, obchodzone jest 22 listopada."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d35524aa-96ea-31ce-93ae-ce8f26c229a2",
