                "senses": [
                    {
                        "sense_id": "3aad1757-1c52-3e9b-b0f4-d83876aefef1",
                        "entry_id": "bcdf9493-c3e5-33b9-a4a9-bcf7d1c996e2",
                        "glosses": [
                            "Abbreviation of Source Filmmaker, a software tool for video capture and editing, often used to create animations."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b57fda-b2f6-4feb-8df6-f39daffcc9a8",
                                "sense_id": "3aad1757-1c52-3e9b-b0f4-d83876aefef1",
                                "text": "According to Valve’s SFM website, users “can think of the SFM as a virtual movie set with lights, actors, props and cameras.”"
                            },
                            {
                                "example_id": "344a3f48-9c5d-4720-b1ef-f510ecb55493",
                                "sense_id": "3aad1757-1c52-3e9b-b0f4-d83876aefef1",
                                "text": "Easily one of the best directed SFM movies out there, mixing Team Fortress, Left 4 Dead and a fine sense of timing."
                            },
                            {
                                "example_id": "3a261bce-b1d1-46ef-9d74-3057a680b26d",
                                "sense_id": "3aad1757-1c52-3e9b-b0f4-d83876aefef1",
                                "text": "The barrier to entry in game development and design is now lower than ever before, and with Fuse having Garry's Mod and SFM compatibility, it now means that gamers can mess around and create their own characters for their favorite Valve properties easier than ever before."
                            }
                        ]
                    },
