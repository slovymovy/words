                    {
                        "translation_id": "3de6d704-74f5-416a-8f60-40b2d0ea3b25",
                        "source_entry_id": "70e73828-0b2b-358d-8d4b-30120d60ff8c",
                        "source_sense_id": "880b69e8-960b-318e-86bf-f1e0db67639c",
                        "source_sense_description": "nonsens, geleuter",
                        "target_lang_word": "Quatsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quatsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05a069cf-f1b5-3e1b-b6a2-be9b9bebfde5",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "unkluge, ungereimte Aussage oder Aussagen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b29e4fb3-1a68-41d4-9271-632aa0837b04",
                                                "sense_id": "05a069cf-f1b5-3e1b-b6a2-be9b9bebfde5",
                                                "text": "Red nicht solchen Quatsch, natürlich kommt er wieder nach Hause!"
                                            },
                                            {
                                                "example_id": "3c73a0b2-c92f-4e6d-a132-838ceafcbeb2",
                                                "sense_id": "05a069cf-f1b5-3e1b-b6a2-be9b9bebfde5",
                                                "text": "Das ist doch Quatsch, so kann es gar nicht gewesen sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b9dab70-8b4f-3d7b-846b-c17a40ba49e0",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "Torheit; falsche, unüberlegte, unkluge Handlung"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3c53ea-85ab-4678-809b-f21b99f0f55c",
                                                "sense_id": "2b9dab70-8b4f-3d7b-846b-c17a40ba49e0",
                                                "text": "Was hast du jetzt wieder für einen Quatsch verzapft? Das kriegt doch keiner wieder richtig zusammengebaut!"
                                            },
                                            {
                                                "example_id": "088c0c4c-564f-4c14-94b6-cd894ff41e1f",
                                                "sense_id": "2b9dab70-8b4f-3d7b-846b-c17a40ba49e0",
                                                "text": "„Jeder Quatsch, den man mit einem Manne erlebte, erklärte sich dadurch, daß er verheiratet war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7d89bdf9-36a7-3412-8c25-03723657a78b",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "Alberei; kindisches Benehmen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3530d5-1674-4acd-8299-5fc4f1c19665",
                                                "sense_id": "7d89bdf9-36a7-3412-8c25-03723657a78b",
                                                "text": "Lasst den Quatsch, jetzt wird aufgeräumt und Abendbrot gegessen!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e2f215a-63e7-3a38-b9df-6662b26f2dd2",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "etwas Unsinniges"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e92066a-8a3e-4890-a4d8-81cb0eb33742",
                                                "sense_id": "8e2f215a-63e7-3a38-b9df-6662b26f2dd2",
                                                "text": "Reiserücktrittsversicherungen sind Quatsch, im Ernstfall zahlen sie sowieso nicht."
                                            },
                                            {
                                                "example_id": "2689ed1f-690c-4b89-a585-faa1df18b16d",
                                                "sense_id": "8e2f215a-63e7-3a38-b9df-6662b26f2dd2",
                                                "text": "Es ist Quatsch, jetzt noch etwas an dem Entwurf ändern zu wollen; in einer Stunde ist Abgabetermin."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "44cef6b0-e08a-3b33-bb8b-20fd2eb734b9",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "breiiger Matsch"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c28b43a9-cc4e-431e-8039-641649486968",
                        "source_entry_id": "70e73828-0b2b-358d-8d4b-30120d60ff8c",
                        "source_sense_id": "880b69e8-960b-318e-86bf-f1e0db67639c",
                        "source_sense_description": "nonsens, geleuter",
                        "target_lang_word": "nonsense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "Letters or words, in writing or speech, that have no meaning or pattern or seem to have no meaning."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e51733b-4103-42bf-bb36-3547b6a7227f",
                                                "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                                                "text": "After my father had a stroke, every time he tried to talk, it sounded like nonsense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "An untrue statement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ba7ff3-5f3c-4588-8048-aadc33b3146a",
                                                "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                                "text": "You have seen it for yourselves in the play by Aristophanes, where Socrates goes whirling round, proclaiming that he is walking on air, and uttering a great deal of other nonsense about things of which I know nothing whatsoever."
                                            },
                                            {
                                                "example_id": "70321e25-9766-460f-9e19-4a9cdb85423a",
                                                "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                                "text": "While at the hospital, David kept screaming and yelling nonsense, stating Vladimir Putin bailed him out of jail and is a god."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b006da-574e-35bc-9704-c3c6d074e1d4",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "That which is silly, illogical and lacks any meaning, reason or value; that which does not make sense."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbbaf6b9-d8e8-3056-a480-62a2e0e247ae",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "Something foolish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abecf1f0-d1b1-4309-8ee7-a787fcd58f55",
                                                "sense_id": "bbbaf6b9-d8e8-3056-a480-62a2e0e247ae",
                                                "text": "and central banks lend vast sums against marshmallow backed securities, or other nonsenses creative bankers dreamed up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e20a78c8-6ba3-3318-9f81-e82255fd1ba6",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "A type of poetry that contains strange or surreal ideas, as, for example, that written by Edward Lear."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afd1081c-defe-32bb-a6d9-b28232b02999",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "A damaged DNA sequence whose products are not biologically active, that is, that does nothing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "575c28a7-86cf-3d1e-a117-ddab3e634247",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To make nonsense of;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d682a32c-9f26-4cae-a7c6-6a5a3e78aa0c",
                                                "sense_id": "575c28a7-86cf-3d1e-a117-ddab3e634247",
                                                "text": "At the Haymarket all this is nonsensed by an endeavor to steer between Mr. Stanley Weyman's rights as author of the story and the prescriptive right of the leading actor to fight popularly and heroically against heavy odds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To attempt to dismiss as nonsense; to ignore or belittle the significance of something; to render unimportant or puny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7625b9a0-d083-4f8e-a596-ba1af24f1af0",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "\"They haven't nonsensed these workouts. They've taken them and used them very well. I didn't know how they'd respond, but they've responded.\""
                                            },
                                            {
                                                "example_id": "c0dfef1f-f82a-4fbd-b24e-337f3ebcea30",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "Very commanding: very much 'end of this nonsensing'. Mister Fared spread his hands and shook his thin head imperceptibly, as if to say he understood."
                                            },
                                            {
                                                "example_id": "e5c5ab8f-9847-4078-9d3a-f3877511fcb1",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "He further nonsensed press suggestions that the Petroleum Unit was set up to assist in the administration of sporting activities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To joke around, to waste time"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7969aa5-2c12-4376-991f-3ef3c240d263",
                                                "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                                                "text": "When he meant \"go and get one\" he said to go and get one, with no nonsensing around about \"liking\" to get one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d34fd531-2868-35c7-829b-12b5d9fbd955",
                                        "entry_id": "016e1720-503a-3e09-bb5f-d125013d42c6",
                                        "glosses": [
                                            "Nonsensical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82662a12-c222-37d6-87a9-dbf97b143fb2",
                                        "entry_id": "016e1720-503a-3e09-bb5f-d125013d42c6",
                                        "glosses": [
                                            "Resulting from the substitution of a nucleotide in a sense codon, causing it to become a stop codon (not coding for an amino-acid)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "460cb0e6-7876-38cb-a118-8ae0fd414c86",
                                        "entry_id": "8d4ac082-5c59-3125-ae7d-34d0ff75433b",
                                        "glosses": [
                                            "An emphatic rejection of something one has just heard and does not believe or agree with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe5a0b6-1513-4c30-b61f-7e761ed4e03e",
                                                "sense_id": "460cb0e6-7876-38cb-a118-8ae0fd414c86",
                                                "text": "The operators present this as a passenger benefit by claiming it provides early notice. Nonsense! This just means that passengers can't find any information about the train they thought they were catching. It simply disappears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd8c0a18-cc2a-4e83-8792-834eb006495b",
                        "source_entry_id": "70e73828-0b2b-358d-8d4b-30120d60ff8c",
                        "source_sense_id": "880b69e8-960b-318e-86bf-f1e0db67639c",
                        "source_sense_description": "nonsens, geleuter",
                        "target_lang_word": "twaddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "Empty or silly idle talk or writing; nonsense, rubbish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c6d97c-9ef2-4685-aad9-136266240963",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "You're talking a load of twaddle. Get your facts straight, man!"
                                            },
                                            {
                                                "example_id": "ca87bb01-20fb-41b1-8a3e-77539214a92c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "\"What ineffable twaddle!\" I cried, slapping the magazine down on the table; \"I never read such rubbish in my life.\""
                                            },
                                            {
                                                "example_id": "e6dd98eb-0953-479f-9298-ae517b816273",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I would rather be rude than to listen to twaddle from a man I’ve known."
                                            },
                                            {
                                                "example_id": "f834bbe0-13d3-489d-bef1-0d2aba51677f",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "It was her other self who had written that letter. It not only bored, it rather disgusted her real self. \"Flippant and silly,\" said her real self. Yet she knew that she'd send it and she'd always write that kind of twaddle to Nan Pym."
                                            },
                                            {
                                                "example_id": "12949f06-1ab1-4bc4-87c1-99fcf75c6a8c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I improvised for three or four minutes, speaking complete twaddle in character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ca7b9f-92b1-38c8-bfbc-df1bbe47b3aa",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "One who twaddles; a twaddler."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                        "entry_id": "8b75e73d-354c-3d2b-b86b-71cae2344415",
                                        "glosses": [
                                            "To talk or write nonsense; to prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ff4a32-5ae8-425a-bfef-b30f4fed617e",
                                                "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
