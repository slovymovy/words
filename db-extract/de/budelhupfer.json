                "senses": [
                    {
                        "sense_id": "b3458960-4cf1-36ec-9cb8-17e7396f1c7b",
                        "entry_id": "1019fe10-4de2-332e-b787-67ad41e421fb",
                        "glosses": [
                            "im Einzelhandelsverkauf tätiger Angestellter"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "61049c38-a616-41fb-880f-a0bbbac2c6a4",
                                "sense_id": "b3458960-4cf1-36ec-9cb8-17e7396f1c7b",
                                "text": "„Das exklusiv Abgehobene des Salons, die in dieser Firma noch dünkelhaft gesehene k. & k. Hoflieferanten-Tradition in einer Zeit, in der es ‚Hof‘ nur noch den Hinterhof gibt, lässt mich fürwahr in der gefährlichen Einbildung leben, ich sei nicht irgendein Budelhupfer (ein hinter dem Ladentisch Springender) unter Millionen, sondern DER Modeberater von Gottes Gnaden.“"
                            },
                            {
                                "example_id": "91a2727c-3d2c-4afd-8706-88925b7ce376",
                                "sense_id": "b3458960-4cf1-36ec-9cb8-17e7396f1c7b",
                                "text": "„[Efgani Dönmez:] Am 14. Mai 2008 hat der höchste Vertreter der Ärztekammer, Herr Präsident Dorner, im ‚Morgenjournal‘ auf Ö1 die ApothekerInnen [sic] pauschal als ‚Budelhupfer‘ bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
