                "translations": [
                    {
                        "translation_id": "85a01621-3ca9-4b7e-b871-2e91d0ef8e66",
                        "source_entry_id": "06b329b7-8212-39e9-8fbe-a0d252329120",
                        "source_sense_id": "31ddc151-02cd-3430-90ff-e985d1872ecb",
                        "target_lang_word": "prequel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prequel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                                        "entry_id": "65cb6880-3d14-3fb9-8938-14491df69128",
                                        "glosses": [
                                            "In a series of works, an installment that is set chronologically before its predecessor, especially the original narrative or (perhaps improper usage) any narrative work with at least one sequel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc388390-981d-4807-b1e1-ee255ddbba18",
                                                "sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                                                "text": "'Prequels' are sequels that relate the story that preceded the original film."
                                            },
                                            {
                                                "example_id": "3ec96dd7-7a1d-414e-857f-f9635c65c2d4",
                                                "sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                                                "text": "2008, 26 February, Andrew Pierce, \"JRR Tolkien's estate to sue Lord of the Rings filmmakers New Line Cinema over profits, in The Daily Telegraph\nThey are also threatening to block the production of the long-awaited prequel, The Hobbit, which may now be cancelled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1c80df7-6cec-41fc-a2bc-c5a1f0dfdc44",
                        "source_entry_id": "06b329b7-8212-39e9-8fbe-a0d252329120",
                        "source_sense_id": "31ddc151-02cd-3430-90ff-e985d1872ecb",
                        "target_lang_word": "prequel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prequel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                        "entry_id": "5bcfe200-c806-340d-b61a-10b2d9332654",
                                        "glosses": [
                                            "Antépisode, œuvre contant l’histoire de ce qui est arrivé avant l’histoire contée dans une autre œuvre."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ec21b0-5240-481f-8191-04600ac31316",
                                                "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                                "text": "Par rapport à Star Wars, épisode IV, les épisodes 5 et 6 sont des suites, et les épisodes 1, 2 et 3 sont des prequels."
                                            },
                                            {
                                                "example_id": "cd7d632b-913f-4687-8453-d21950cb9717",
                                                "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                                "text": "Le premier prequel du film de Kubrick, Doctor Sleep, de Mike Flanagan avec Ewan McGregor sorti en 2019, a tellement floppé que Warner a renoncé à en faire un deuxième."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81624e11-1d65-4be6-a700-7c141864ea97",
                        "source_entry_id": "06b329b7-8212-39e9-8fbe-a0d252329120",
                        "source_sense_id": "31ddc151-02cd-3430-90ff-e985d1872ecb",
                        "target_lang_word": "préquel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préquel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1ac4bd7-a172-3b35-9edf-871e3a325e17",
                                        "entry_id": "c7388fe8-6ffb-3649-892c-de4096bee922",
                                        "glosses": [
                                            "Variante orthographique de prequel."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b28332-6586-485e-9aa1-f018fbb66c2b",
                                                "sense_id": "b1ac4bd7-a172-3b35-9edf-871e3a325e17",
                                                "text": "« Autant en emporte le vent » aura aussi son préquel. 80 ans après la publication du roman de Margaret Mitchelle, une « suite » racontant l’histoire de Mamma, la nounou de Scarlett O’Hara sera publiée en octobre 2014 par les éditions Simon & Schuster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6edc4e11-da60-485c-be8f-3b5346a11758",
                        "source_entry_id": "06b329b7-8212-39e9-8fbe-a0d252329120",
