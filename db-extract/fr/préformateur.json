                                        "glosses": [
                                            "iemand die het werk van de informateur voortzet en het werk van de formateur voorbereidt om een coalitieregering te vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a5c8ef7-3931-4909-92a5-b4eaedbf502d",
                                                "sense_id": "878d45fa-e1c4-3554-aae6-32dcd7097d7b",
                                                "text": "Di Rupo diende twee weken geleden zijn ontslag in als preformateur. Een ultiem voorstel over financiële compensatie voor de Walen in ruil voor opsplitsing van het kiesdistrict Brussel-Halle-Vilvoorde werd toen door de Vlaamse Nationalisten afgewezen. Opsplitsing van dat district is het grootste struikelblok in de Belgische formatie."
                                            },
                                            {
                                                "example_id": "580a9b27-ca59-4293-a7b5-641735140939",
                                                "sense_id": "878d45fa-e1c4-3554-aae6-32dcd7097d7b",
                                                "text": "De Waal Di Rupo werd half mei door de koning benoemd tot formateur. Vorig jaar was Di Rupo een kleine twee maanden preformateur, maar zonder succes."
                                            }
                                        ]
