                ],
                "senses": [
                    {
                        "sense_id": "9bf585da-8c48-30b3-9bc5-0cc2b743f1d3",
                        "entry_id": "5b98aee7-cf64-31b2-b5db-bc02d11f1b9f",
                        "glosses": [
                            "een groot aantal projectielen door iets heen schieten"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "42b98e3d-b1f2-425e-a733-e68f2524f90a",
                                "sense_id": "9bf585da-8c48-30b3-9bc5-0cc2b743f1d3",
                                "text": "De auto werd in de schietpartij doorzeefd."
                            },
                            {
                                "example_id": "371adf9f-a8c3-48a6-a7db-49905d670904",
                                "sense_id": "9bf585da-8c48-30b3-9bc5-0cc2b743f1d3",
                                "text": "Spieren en zenuwen staan zichtbaar op scherp om de schutter te raken, die op zijn beurt tot het uiterste getergd wordt om zijn tegenstander met een kogelregen te doorzeven."
                            }
                        ]
                    }
                ],
