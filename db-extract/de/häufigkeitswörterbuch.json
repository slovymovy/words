                "senses": [
                    {
                        "sense_id": "9236ce27-b61d-316e-9734-ab6db5e427d8",
                        "entry_id": "ebf19d21-2fc1-355d-9569-aac55b35752c",
                        "glosses": [
                            "Wörterbuch, in dem die Frequenz, die Häufigkeit, mit der Wörter in einem Textkorpus vorkommen, angegeben wird"
                        ],
                        "tags": [
                            "Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "202442f1-623d-4391-9e95-879ee2fd63d5",
                                "sense_id": "9236ce27-b61d-316e-9734-ab6db5e427d8",
                                "text": "In einem Häufigkeitswörterbuch kann man nachschlagen, welche Wörter besonders häufig oder besonders selten verwendet werden."
                            },
                            {
                                "example_id": "1f6711df-b90b-440d-8d2f-938b3645d3b4",
                                "sense_id": "9236ce27-b61d-316e-9734-ab6db5e427d8",
                                "text": "„Als Desiderat der Forschung hatte demnach bisher ein Häufigkeitswörterbuch gesprochener Sprache zu gelten.“"
                            },
                            {
                                "example_id": "0ca72ddc-5558-4f5c-a7cf-f3468330e2bd",
                                "sense_id": "9236ce27-b61d-316e-9734-ab6db5e427d8",
                                "text": "„In anderen Wörterbüchern wiederum gibt es Darstellungen nach Formativstruktur und Häufigkeit, wie in rückläufigen und Häufigkeitswörterbüchern...“"
                            },
                            {
                                "example_id": "e2373534-02e9-4c49-832c-ed9ad4df2355",
                                "sense_id": "9236ce27-b61d-316e-9734-ab6db5e427d8",
                                "text": "„Dieses Häufigkeitswörterbuch wurde erstellt, um eine vollständige Beschreibung eines literarischen Textes zu liefern…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
