                "senses": [
                    {
                        "sense_id": "33bf7c10-9fb9-37f0-83c2-fd751bf857c8",
                        "entry_id": "a65a221a-4ff7-3299-955c-a1f701acda68",
                        "glosses": [
                            "besonders gelungenes architektonisches Werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10899f79-5218-437e-a429-a248204dc07f",
                                "sense_id": "33bf7c10-9fb9-37f0-83c2-fd751bf857c8",
                                "text": "„Das alte Rathaus von Amritsar ist ein palastartiger roter Sandsteinbau aus dem späten 19. Jahrhundert, eines der Architekturschmuckstücke, die von den britischen Kolonialherren in Indien hinterlassen wurden.“"
                            },
                            {
                                "example_id": "78424418-1293-4ebd-98d3-d51855fd4a22",
                                "sense_id": "33bf7c10-9fb9-37f0-83c2-fd751bf857c8",
                                "text": "„40 Meilen westlich, und gut im Rahmen eines Tagesausflugs ab Madison zu erreichen, befinden sich zwei Architekturschmuckstücke: Frank Lloyd Wrights Meisterwerk Taliesin und das wirklich schräge House on the Rock.“"
                            },
                            {
                                "example_id": "530054db-11db-4a8c-844b-19fc849fcc13",
                                "sense_id": "33bf7c10-9fb9-37f0-83c2-fd751bf857c8",
                                "text": "„Darüber hinaus warten an jeder Ecke Überraschungen: ein hinreißendes Architekturschmuckstück hier, ein unvergessliches Essen dort, und eine überall spürbare avantgardistische Atmosphäre.“"
                            },
                            {
                                "example_id": "b6d541ea-42ba-41c1-865d-927b1a97dc0e",
                                "sense_id": "33bf7c10-9fb9-37f0-83c2-fd751bf857c8",
                                "text": "„Teilweise sind ihre Darstellungen regionaler Architekturschmuckstücke mit Rastern kubistischen Charakters überlegt.“"
                            },
                            {
                                "example_id": "961efa31-9c7d-4ba7-a078-0b1203c7e5b5",
                                "sense_id": "33bf7c10-9fb9-37f0-83c2-fd751bf857c8",
                                "text": "„Zu unserer großen Verwunderung sehen wir aber nur mehr wenige Gebäude aus jener Epoche. Wohl deuten an vielen Giebelhäusern der Renaissance und Barockzeit, sowie bei einigen Gebäuden der Empireperiode, Profile, Architekturschmuckstücke oder die Gewölbe im Inneren auf ihren Ursprung aus mittelalterlicher Zeit zurück, aber außer dem Dome haben sich bloß mehr wenige mittelalterliche Privatgebäude in unverstümmelter Weise erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
