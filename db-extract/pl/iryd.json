                                        "sense_id": "f7d638d0-facf-308d-8987-dc771ed52719",
                                        "entry_id": "8b9c8ff1-da61-3555-a75f-691cda43c031",
                                        "glosses": [
                                            "Elemento químico de número atómico 77 que se sitúa en el grupo 9 de la tabla periódica de los elementos. Su símbolo es Ir. Fue descubierto en 1803 por el químico Smithson Tennant. Se trata de un metal de transición, del grupo del platino, duro, frágil, pesado, de color blanco plateado."
                                        ],
                                        "tags": [
                                            "Elementos químicos"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca0aff4f-646a-45c6-88a5-975c1a4437fe",
                        "source_entry_id": "b9ffc440-e14b-3818-b919-2c678283835a",
                        "source_sense_id": "f82aff64-7dbc-38ff-8e3f-dd605180498f",
