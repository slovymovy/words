                                "target_senses": [
                                    {
                                        "sense_id": "9944e7a0-230f-3cff-95e2-0ca7dc7a2c92",
                                        "entry_id": "a012810f-90e0-3e98-bb14-3ec092e4695f",
                                        "glosses": [
                                            "Alternative spelling of leukocyte."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582a1422-7b08-4747-894a-1f043e626745",
                                                "sense_id": "9944e7a0-230f-3cff-95e2-0ca7dc7a2c92",
                                                "text": "The outer chamber contains the supratympanal organ together with leucocytes and adipose cells."
                                            }
