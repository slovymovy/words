                "senses": [
                    {
                        "sense_id": "17bee3b0-02ed-326e-9268-c8c823f5537e",
                        "entry_id": "019113cb-ad84-3107-a0df-092fc2c68a94",
                        "glosses": [
                            "Brotscheibe, die mit Konfitüre bestrichen ist"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f1cc741b-15c0-4e05-aebe-912bf8b7ad39",
                                "sense_id": "17bee3b0-02ed-326e-9268-c8c823f5537e",
                                "text": "„Konfibrote, Birchermüsli und Kaffee wurden an den Platz gebracht.“"
                            },
                            {
                                "example_id": "e94fa3b3-96ef-48ec-bb59-8a41d4101cee",
                                "sense_id": "17bee3b0-02ed-326e-9268-c8c823f5537e",
                                "text": "„Auch ihre Kinder mögen grüne Lebensmittel grundsätzlich nicht und essen ihr Konfibrot manchmal nur, wenn sie es ihnen längs schneidet.“"
                            },
                            {
                                "example_id": "9a3143e3-e212-4b06-849a-0f0a4f01a9db",
                                "sense_id": "17bee3b0-02ed-326e-9268-c8c823f5537e",
                                "text": "„Ich schmiere mir ein Konfibrot und trinke eine Schoggimilch.“"
                            },
                            {
                                "example_id": "bf0920cd-07bb-4dc7-8774-fbbee06db4a5",
                                "sense_id": "17bee3b0-02ed-326e-9268-c8c823f5537e",
                                "text": "„Auch sie sollten sich jedoch überlegen, wie sie ihr Frühstücksmenü gestalten, denn das klassische «Konfibrot» stammt noch aus einer Zeit, als man vor dem «Zmorge» schon das erste Mal körperliche Arbeit verrichtet hatte.“"
                            },
                            {
                                "example_id": "c60ddbed-a6c4-4ab8-94b7-11001a845453",
                                "sense_id": "17bee3b0-02ed-326e-9268-c8c823f5537e",
                                "text": "„Als ich ein kleines Kind war, fiel mir ein von meiner Grossmutter akkurat geschmiertes Konfibrot auf den Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
