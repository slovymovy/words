                                        "sense_id": "0e537a02-515e-3dd8-a23e-bb7841d2d90f",
                                        "entry_id": "c8aad2fa-9ec6-3f3c-81b0-0aa6a93363b0",
                                        "glosses": [
                                            "A tool for boring a hole wider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f762b224-fbce-440d-9420-2716bb13d47e",
                                                "sense_id": "0e537a02-515e-3dd8-a23e-bb7841d2d90f",
                                                "text": "allowance at the bottom of blind bores for the chamfered tip of the reamer will obviate additional operations with shouldering or bottoming reamers to completely finish the entire length of a hole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e4c5f0-a2c5-3828-acef-c32773aa9e17",
                                        "entry_id": "c8aad2fa-9ec6-3f3c-81b0-0aa6a93363b0",
                                        "glosses": [
                                            "A device for rendering citrus juice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afa78dbb-fda8-33cf-b53c-2cefe74e28a8",
                                        "entry_id": "c8aad2fa-9ec6-3f3c-81b0-0aa6a93363b0",
                                        "glosses": [
                                            "A tool used to scrape carbon deposit from the bowl of a pipe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26a9b98c-2350-353c-ae4b-cbb0448bd909",
                                        "entry_id": "c8aad2fa-9ec6-3f3c-81b0-0aa6a93363b0",
                                        "glosses": [
                                            "A Stone Age prehistoric lithic stone tool, used in archeology nomenclature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e12c0d43-0f8a-3e04-9e4b-bf9439addf75",
                                        "entry_id": "c8aad2fa-9ec6-3f3c-81b0-0aa6a93363b0",
                                        "glosses": [
                                            "One who reams."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e50010-3d30-4300-8f86-a5193daa7bb5",
                                                "sense_id": "e12c0d43-0f8a-3e04-9e4b-bf9439addf75",
                                                "text": "“Just to be clear, old-timer, I'm not always the sucker, and he's not always the reamer.” “Though, he does ream me nightly.” “Adolfo, you dirty dog.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3140c9d0-4e75-4b13-b0f9-471f237302bd",
                        "source_entry_id": "301944e8-56c0-3f0a-b6b1-96dd4fe7ab3a",
                        "source_sense_id": "044a143e-ad36-3bc0-b9d0-484bc50e8aa9",
                        "target_lang_word": "broach",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20ec05f8-f73f-3d1a-a00f-c5f1d0d463d6",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "A series of chisel points mounted on one piece of steel. For example, the toothed stone chisel shown here."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4f5ed6f-cdf1-364d-9944-8d7fcc006ee7",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "A broad chisel for stone-cutting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c4ebc80-80fd-3d89-b8ce-665d15652828",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "Alternative spelling of brooch."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0274857d-feda-4ef8-9021-b91b48f493b1",
                                                "sense_id": "9c4ebc80-80fd-3d89-b8ce-665d15652828",
                                                "text": "Mr. S. had a large straw hat, and striped jacket and trousers, and his shirt fastened at the throat by a broach with Carry's hair, for he was always quite above wearing a neckcloth."
                                            },
                                            {
                                                "example_id": "c7dffe41-635b-4eb4-95ec-bd52f83b6f53",
                                                "sense_id": "9c4ebc80-80fd-3d89-b8ce-665d15652828",
                                                "text": "She pinned a broach on her jacket.\nWhen Viv saw it, she laughed. “Is that the best you can do? A flower broach?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9466a0-52c7-3e5a-a817-01cb91a759e0",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "A spit for cooking food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b2ddbb-1c4a-4405-ad4c-ca9a57805dd8",
                                                "sense_id": "bd9466a0-52c7-3e5a-a817-01cb91a759e0",
                                                "text": "He turned a broach that had worn a crown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9f26e4-41f6-37f2-8aa6-b1f88edd500f",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "An awl; a bodkin; also, a wooden rod or pin, sharpened at each end, used by thatchers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6422807-1060-4d76-81df-d23ee4b52294",
                                                "sense_id": "4a9f26e4-41f6-37f2-8aa6-b1f88edd500f",
                                                "text": "It [the straw] is laid on to a considerable thickness and firmly secured by ropes or twisted straw, and pinned down by sharpened sticks called 'broaches'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f0c8b2-f812-335d-9bac-419e8fd56ed1",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "A spire rising from a tower."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c382fca8-f018-3cdf-82d6-fb9807a1e304",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "A spit-like start on the head of a young stag."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5c614cd-96d6-3b72-961f-4a9453741b06",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "The stick from which candle wicks are suspended for dipping."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2fe4f2f-954e-35c0-896d-0be1d79eb28b",
                                        "entry_id": "eb28b379-1605-37df-b8b6-2eab4d8ec267",
                                        "glosses": [
                                            "The pin in a lock which enters the barrel of the key."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "broach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63563ab2-7287-342d-b2f4-f6bd9291bbb1",
                                        "entry_id": "4a95cfc4-d8e2-3222-80fa-c508e958bba2",
                                        "glosses": [
                                            "To make a hole in, especially a cask of liquor, and put in a tap in order to draw the liquid."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7154e918-e251-473e-a1d7-ffb7c1611871",
                                                "sense_id": "63563ab2-7287-342d-b2f4-f6bd9291bbb1",
                                                "text": "How often has the broached barrel proved not to be for joy and heart effusion, but for duel and head-breakage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7ec2e7-df2c-35ef-9b8e-42798825fbd0",
                                        "entry_id": "4a95cfc4-d8e2-3222-80fa-c508e958bba2",
                                        "glosses": [
                                            "To open, to make an opening into; to pierce."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb20bdd-53a3-4d70-ae91-bd2b01820e9a",
                                                "sense_id": "2b7ec2e7-df2c-35ef-9b8e-42798825fbd0",
                                                "text": "French knights at Agincourt were unable to broach the English line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                                        "entry_id": "4a95cfc4-d8e2-3222-80fa-c508e958bba2",
                                        "glosses": [
                                            "To begin discussion about (something)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db22c55d-47a2-4c01-a4c2-865179ca139c",
                                                "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                                                "text": "I broached the subject of contraceptives carefully when the teenager mentioned his promiscuity."
                                            },
                                            {
                                                "example_id": "4f1f61bb-c1ab-438c-b3d0-c1b6522c84e3",
                                                "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                                                "text": "Yet he was much too much scared of broaching any man, let alone one in a peaked cap, to dare to ask."
                                            },
                                            {
                                                "example_id": "4acfd8b6-6f08-400b-a80b-9372fba28d9c",
                                                "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                                                "text": "I have tried on several occasions to broach the subject of my love to Lys; but she will not listen."
                                            },
                                            {
                                                "example_id": "fe34962f-3adb-42f5-9326-461548aef61c",
                                                "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                                                "text": "THE POCKET ENCYCLOPAEDIA OF BRITISH STEAM LOCOMOTIVES. By O. S. Nock. Blandford Press. 18s.\nMr. Nock, he remarks in his preface, was \"incredulous\" when the idea of this book of 192 colour gravure illustrations of a representative collection of British steam locomotives from Locomotion to BR's Evening Star was broached to him."
                                            },
                                            {
                                                "example_id": "6e0becdc-f8f8-4da0-8ad5-4be5b3f79f90",
                                                "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                                                "text": "Still, both [Kate] Spicer and [Anka] Radakovich think there are some subjects, even as the outrider of sexual openness, they can't broach."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "broach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49f942be-f97a-33c7-80ea-474d9b678aec",
                                        "entry_id": "bf00a765-b7d6-3da8-ab1d-588cf1145bc2",
                                        "glosses": [
                                            "To be turned sideways to oncoming waves, especially large or breaking waves."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6b58c90-6a03-4c9a-b3b2-d44f3b9a5848",
                                                "sense_id": "49f942be-f97a-33c7-80ea-474d9b678aec",
                                                "text": "The small boat broached and nearly sank, because of the large waves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79bbcdff-a7fa-3d9c-9756-928175c07ebd",
                                        "entry_id": "bf00a765-b7d6-3da8-ab1d-588cf1145bc2",
                                        "glosses": [
                                            "To cause to turn sideways to oncoming waves, especially large or breaking waves (usually followed by to; also figurative)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "234a725c-acbb-4fda-a3c2-a974614f40da",
                                                "sense_id": "79bbcdff-a7fa-3d9c-9756-928175c07ebd",
                                                "text": "18th C, Thomas Dibdin, Tom Bowling\nHere a sheer hulk lies poor Tom Bowling ... for death hath broached him to."
                                            },
                                            {
                                                "example_id": "34ea97de-3b42-4a08-a8b1-f3695aa9de08",
                                                "sense_id": "79bbcdff-a7fa-3d9c-9756-928175c07ebd",
                                                "text": "Each time we came around into the wind, the sea broached our bow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2643e63-11b8-3538-97de-0128623e53fa",
                                        "entry_id": "bf00a765-b7d6-3da8-ab1d-588cf1145bc2",
                                        "glosses": [
                                            "To break the surface of the water."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5389b765-2007-4f17-b1e7-6e061a27bff8",
                                                "sense_id": "a2643e63-11b8-3538-97de-0128623e53fa",
                                                "text": "The Politovskiy soared through the surface of the Atlantic like a broaching whale, coming three quarters of her length out of the water before crashing back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
