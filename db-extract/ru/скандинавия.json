                                "target_senses": [
                                    {
                                        "sense_id": "dda1b4bc-844e-34d2-9457-ecf9401a0c96",
                                        "entry_id": "ea81fbd0-2592-3c78-a227-81c75e6c2fa5",
                                        "glosses": [
                                            "A geographic region of Northern Europe, consisting of Denmark, Norway, and Sweden collectively and sometimes Finland, Iceland, Åland and the Faroe Islands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7e9dbc-5d09-4c77-a869-2695a09a40ce",
                                                "sense_id": "dda1b4bc-844e-34d2-9457-ecf9401a0c96",
                                                "text": "The Faroes are an obscure corner of Scandinavia and, apart from Lapland, Scandinavia is perhaps the most obscure corner of the world, ethnographically speaking."
                                            },
                                            {
                                                "example_id": "71f146e2-32b9-41cd-b936-110643ee3343",
                                                "sense_id": "dda1b4bc-844e-34d2-9457-ecf9401a0c96",
                                                "text": "Internet banking has become popular in Finland and other parts of Scandinavia, for a variety of reasons."
                                            },
                                            {
                                                "example_id": "f679d7b4-1447-4cc4-a7db-fc848885a9f2",
                                                "sense_id": "dda1b4bc-844e-34d2-9457-ecf9401a0c96",
                                                "text": "And within Scandinavia, Iceland faces an epidemic of sexual violence, with twice as many reported rapes per capita as other Nordic countries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bd2869-e312-30c7-8132-5c7348cbcf80",
                                        "entry_id": "ea81fbd0-2592-3c78-a227-81c75e6c2fa5",
                                        "glosses": [
                                            "A peninsula in Northern Europe, consisting of Norway, Sweden and most of northern Finland; in full, Scandinavian Peninsula."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c3e1da5-ee03-4cb6-a1c2-f16b6bd873b2",
                        "source_entry_id": "c51d9ddb-b4bd-303f-a83f-2afa3aac2172",
                        "source_sense_description": "полуостров, расположенный в северо-западной части Европы",
