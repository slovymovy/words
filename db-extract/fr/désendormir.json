                "senses": [
                    {
                        "sense_id": "aa5ff927-ee10-376f-8d39-e2c844c523af",
                        "entry_id": "b061cd9d-0bde-366e-b3e3-3df862dbecfc",
                        "glosses": [
                            "Réveiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dec28ec-1bc9-4489-bcde-25456a80965c",
                                "sense_id": "aa5ff927-ee10-376f-8d39-e2c844c523af",
                                "text": "À trois heures dix, les clairons et les tambours de notre compagnie sonnèrent et battirent l’air connu de « la Casquette au père Bugeaud » qui désendort si bien les jambes."
                            },
                            {
                                "example_id": "e5bfac32-be3c-49c9-bd6d-26d230505d4b",
                                "sense_id": "aa5ff927-ee10-376f-8d39-e2c844c523af",
                                "text": "L’haridelle, que nos trois compères ont cru, du fouet, désendormir, ne s’est pas encore éveillée ; elle rêve qu’elle a le feu au cul !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8a574ab-5f76-3a8b-b9d9-bf51a8f07c55",
                        "entry_id": "b061cd9d-0bde-366e-b3e3-3df862dbecfc",
                        "glosses": [
                            "Ôter l’air endormi, apathique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1a29e257-0991-45bc-b596-93fc55b9f969",
                                "sense_id": "f8a574ab-5f76-3a8b-b9d9-bf51a8f07c55",
                                "text": "Vis-à-vis est une montagne sur laquelle on voit les vestiges d’un fort, qu'on suppose avoir été bâti par les Danois, & qui désendort l’entrée de la baye."
                            }
                        ]
                    }
                ],
