                    {
                        "translation_id": "f11788c0-c1da-434b-8fbe-6b92ec87263c",
                        "source_entry_id": "374c9e43-14cf-3bdd-a0cf-09db300b75f6",
                        "source_sense_id": "05a65f7b-e0c0-3692-88eb-47fe342795d0",
                        "target_lang_word": "ratchet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23e6cb58-f518-36eb-b031-50df8cf64fb3",
                                        "entry_id": "d69caa7c-0826-308d-aff9-3ded12384240",
