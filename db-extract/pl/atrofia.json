                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e764c5f-80c7-3886-aa14-ffd8fc2ecdcc",
                                        "entry_id": "107e91a5-3125-3bf7-8cb4-c7c43c97e050",
                                        "glosses": [
                                            "Schwund von Geweben, Knochen, Organen, Muskeln oder Zellen, der durch Mangelernährung oder endogene Erkrankungen ausgelöst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0149ae3-d9d5-4c72-b18d-f7053741ebb9",
                                                "sense_id": "8e764c5f-80c7-3886-aa14-ffd8fc2ecdcc",
                                                "text": "Ärzte stellten „nicht nur einen restlosen Schwund der Fettdepots, sondern auch eine starke Atrophie der inneren Organe\" fest."
                                            },
                                            {
                                                "example_id": "171a0190-cfa1-4ddf-9705-bb94477d2858",
                                                "sense_id": "8e764c5f-80c7-3886-aa14-ffd8fc2ecdcc",
                                                "text": "Der dauernde Alkoholmißbrauch wirkt auch unmittelbar toxisch auf das Gehirn. Er führt zu einer Atrophie besonders bei den synapsenreichen sogenannten Purkinjezellen des Kleinhirns, das vor allem für die Koordination der Muskelbewegungen und das Gleichgewicht zuständig ist, aber wohl auch zu erheblichen Zellenverlusten im Bereich der Hirnrinde und des Zwischenhirns."
                                            },
                                            {
                                                "example_id": "19b0324b-bac3-4761-99e7-b7d2fa203811",
                                                "sense_id": "8e764c5f-80c7-3886-aa14-ffd8fc2ecdcc",
                                                "text": "„Der Schwanz läuft beinahe immer nach dem Ende hin spitz zu, mag er nun kurz oder lang sein, und ich vermuthe, daß dies ein Resultat der durch Nichtgebrauch eintretenden Atrophie der terminalen Muskeln in Verbindung mit der der Arterien und Nerven ist, welche zuletzt zu einer Atrophie der endständigen Knochen führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
