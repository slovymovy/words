                "senses": [
                    {
                        "sense_id": "12b87900-c658-3a37-bbeb-5714cba4a55e",
                        "entry_id": "7d64261d-9bd9-38a1-bfbf-0776f376bfb5",
                        "glosses": [
                            "To remember incorrectly."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9d12bf28-b43b-4633-8c29-8dfd32e368a8",
                                "sense_id": "12b87900-c658-3a37-bbeb-5714cba4a55e",
                                "text": ". . . that he, who twice upon oath, with time of recollection, could not remember anything of such a business, might well, a third time, misremember somewhat."
                            },
                            {
                                "example_id": "3315f104-6f14-4c0f-b50f-cb0c547d4e7d",
                                "sense_id": "12b87900-c658-3a37-bbeb-5714cba4a55e",
                                "text": "His name, if I do not misremember, was Peter Otsequot."
                            },
                            {
                                "example_id": "017b22db-a67c-4c7c-8f6e-e04aa6a427fe",
                                "sense_id": "12b87900-c658-3a37-bbeb-5714cba4a55e",
                                "text": "I have been assured […] if I misremember not."
                            },
                            {
                                "example_id": "2e6c7d2a-e5dd-4d09-84c3-a64a155fb8fd",
                                "sense_id": "12b87900-c658-3a37-bbeb-5714cba4a55e",
                                "text": "Did the military screw things up, or did you simply misremember?"
                            }
                        ]
                    }
                ],
