            "senses": [
                {
                    "sense_id": "f8403795-f0aa-3838-af6f-b0d17f72f14e",
                    "sense_definition": "Être submergé, débordé ou accablé par une très grande quantité de choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deborde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le début de la semaine, les employés de ce bureau <w>croulent</w> sous le travail et les dossiers urgents."
                        },
                        {
                            "text": "Cette entreprise mal gérée <w>croulait</w> sous les dettes avant d'être finalement rachetée par un groupe étranger."
                        }
                    ],
                    "common_phrases": [
