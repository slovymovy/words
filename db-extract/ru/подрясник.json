                "senses": [
                    {
                        "sense_id": "5992e3fa-b5a6-37ba-8a05-cdf7728fc55e",
                        "entry_id": "e5a8eb03-a35a-358e-a0cf-86e61548e2ab",
                        "glosses": [
                            "A monastic robe worn by Russian Orthodox nuns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d276faa1-d730-461d-8ca5-63a96c30aad4",
                                "sense_id": "5992e3fa-b5a6-37ba-8a05-cdf7728fc55e",
                                "text": "Катя сшила себе на заказ два черных подрясника, купила черный платок, всюду ходила с четками, опустив глаза.”",
                                "translation": "“ Katya sewed herself her own two black podrasniks, bought a black handkerchief, walked everywhere with rosary beads, kept her eyes low.”",
                                "english": "“ Katya sewed herself her own two black podrasniks, bought a black handkerchief, walked everywhere with rosary beads, kept her eyes low.”"
                            }
                        ]
                    }
                ],
