                        "cross_references": [
                            {
                                "target_word": "Philomène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26bbf614-5885-30d9-a1e5-06850514b112",
                                        "entry_id": "fe82eecc-7e82-3255-a8c0-dbc59e21dd34",
                                        "glosses": [
                                            "Rossignol personnifié."
                                        ],
                                        "tags": [
                                            "dated",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eef9050-34d3-44ef-a61a-40711eb89bad",
                                                "sense_id": "26bbf614-5885-30d9-a1e5-06850514b112",
                                                "text": "Là, parmi les lilas, Philomène amoureuse\n Mêle aux voix des oiseaux sa voix mélodieuse."
                                            },
                                            {
                                                "example_id": "87b1c574-0b10-42d7-83bd-7d0777e916dd",
                                                "sense_id": "26bbf614-5885-30d9-a1e5-06850514b112",
                                                "text": "Déjà l’aimable Philomène,\nSensible aux maux du tendre amant,\nPréludoit un air languissant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Philomène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd222ea-c280-3350-94b6-598b26375f3a",
                                        "entry_id": "62e3cb23-ce43-3935-a014-f7b259bcc75d",
                                        "glosses": [
                                            "Prénom féminin (exceptionnellement masculin)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b76f82e9-6f34-4051-a69a-6f71705a039d",
                                                "sense_id": "bcd222ea-c280-3350-94b6-598b26375f3a",
                                                "text": "Trois ans après la naissance d’une fille qui fut nommée Philomène, tous les grands parents de madame de Watteville étaient morts et leurs successions liquidées."
                                            },
                                            {
                                                "example_id": "4cf601f5-5d91-4b77-b34a-63d8645fc589",
                                                "sense_id": "bcd222ea-c280-3350-94b6-598b26375f3a",
                                                "text": "La maîtresse – on l’appelait Philomène – allait, sans dire un mot, les dents serrées, de l’âtre à la table, avec sa grande louche qui charriait chaque fois une pleine écuellée de soupe aux choux."
                                            },
                                            {
                                                "example_id": "3294d98c-f940-4273-9670-1388d786f49b",
                                                "sense_id": "bcd222ea-c280-3350-94b6-598b26375f3a",
                                                "text": "Philomène sa femme, s’emporte, ”pas moyen d’la décrinquer”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
