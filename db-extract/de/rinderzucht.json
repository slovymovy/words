                "senses": [
                    {
                        "sense_id": "d1a09e59-65a1-3dde-88bf-89010908c7dc",
                        "entry_id": "45c85713-81af-349e-bd36-ed463a3fac7d",
                        "glosses": [
                            "die kontrollierte Vermehrung und Aufzucht von Rindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e1c5768-fd5b-4e6d-909e-34770ad2f45b",
                                "sense_id": "d1a09e59-65a1-3dde-88bf-89010908c7dc",
                                "text": "„Vor allem Umweltschutzverbände kritisieren die Rinderzucht vermehrt, denn für die Aufzucht von Rindern werden andere Nahrungsmittel verbraucht.“"
                            },
                            {
                                "example_id": "32a99020-ada5-49cc-acf6-48646d8a3255",
                                "sense_id": "d1a09e59-65a1-3dde-88bf-89010908c7dc",
                                "text": "„Die Rinderzucht soll sukzessive, aber so schnell wie möglich abgewickelt, der Hof auf Pferdezucht umgestellt werden.“"
                            },
                            {
                                "example_id": "513056cd-5809-4c2d-9873-1e07b8a7fe0d",
                                "sense_id": "d1a09e59-65a1-3dde-88bf-89010908c7dc",
                                "text": "„Während die Männer für alles zuständig waren, was die Rinderzucht betraf, oblag den Frauen der größte Teil des Anbaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
