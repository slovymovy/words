                        "glosses": [
                            "Volerie, extorsion, action de piller."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "80ca7584-5de3-4af7-955b-827594fa0d83",
                                "sense_id": "26c5e113-23cd-3065-87ef-be37adc8b861",
                                "text": "« Je n’ay receu vostre despesche des six mille escus ; il fault qu’elle aye esté prise par les chemins ; mais j’ay sceu les pilleries et butins que font les soldats. »"
                            },
                            {
                                "example_id": "70c00e4e-5a6c-43cb-be3c-ad326c330008",
                                "sense_id": "26c5e113-23cd-3065-87ef-be37adc8b861",
                                "text": "« Il faut croire qu’il y a eu un peu de pillerie dans son affaire, comme c’était la coutume du temps et comme c’est le droit de la guerre de partisans. »"
                            },
                            {
                                "example_id": "55b4558e-dcf0-40d9-a02a-2e5ca28c59d7",
                                "sense_id": "26c5e113-23cd-3065-87ef-be37adc8b861",
                                "text": "Si c'est pas malheureux de voir détériorer du matériel, et une pillerie pareille?"
                            }
                        ]
                    }
                ],
