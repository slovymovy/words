                        "examples": [
                            {
                                "example_id": "ee577a79-9a2e-4f59-bdb3-654567951c1f",
                                "sense_id": "148524bc-eab9-39c1-8bf2-6e12edc5f883",
                                "text": "FNV Bouw zou de tegenstanders aan een meerderheid kunnen helpen. Het is in omvang de vierde bond van de FNV en is goed voor 10 procent van de stemmen. De bouwbond zal vandaag ook een standpunt bekend maken. Deze bond heeft geen referendum gehouden, maar de achterban om reacties gevraagd."
                            },
                            {
                                "example_id": "667bc14c-76d4-417d-8323-c68f1f1b5647",
                                "sense_id": "148524bc-eab9-39c1-8bf2-6e12edc5f883",
                                "text": "Larsson vertelde me dat de bouwbond, een van de grootste vakbonden van het land, er zelfs van beschuldigd werd zich racistisch te gedragen. De bond controleerde op de bouwplaatsen of daar werkende allochtonen een werkvergunning hebben. Zo niet dan werden ze aangeven en werd ervoor gezorgd dat ze ontslagen werden."
                            }
                        ]
                    }
