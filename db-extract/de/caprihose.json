                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "60be2364-bf55-423b-9345-b8cbb15fd888",
                                "sense_id": "7e7be6bd-1f00-3b7b-b8f1-fbd5f221eb62",
                                "text": "„Im Sommer darauf entwarf Pucci, aus demselben Beweggrund, eine bis zum Knöchel reichende Damenhose: die Caprihose.“"
                            },
                            {
                                "example_id": "86cc5678-8233-4d7b-a487-89025402c791",
                                "sense_id": "7e7be6bd-1f00-3b7b-b8f1-fbd5f221eb62",
                                "text": "„Sie trägt Sandalen mit hoher Korksohle und eine crèmefarbene Caprihose."
                            }
                        ],
