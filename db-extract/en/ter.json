                        "examples": [
                            {
                                "example_id": "caaeab49-4ea1-4a01-bf37-16483d62c568",
                                "sense_id": "93c82122-cb5c-359b-bf8d-fd244bf2fe69",
                                "text": "\"But he never speaks ter anybody, child—he hain't for years, I guess, except when he just has to, for business, and all that.\""
                            },
                            {
                                "example_id": "6e9958ca-2d05-4991-bb6b-54c3589b7437",
                                "sense_id": "93c82122-cb5c-359b-bf8d-fd244bf2fe69",
                                "text": "‘What about that tea then, eh?’ he said, rubbing his hands together. ‘I’d not say no ter summat stronger if yeh’ve got it, mind.’"
                            }
                        ]
                    }
