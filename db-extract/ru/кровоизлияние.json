                    },
                    {
                        "form_id": "84538efd-88e3-4732-b662-e83b5d9618d8",
                        "entry_id": "7e2f7be0-6d48-355e-b296-5f24efd2dc98",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "кровоизлия́ниях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a44525e-7a29-31f8-bcc0-6901e8d63d3e",
                        "entry_id": "7e2f7be0-6d48-355e-b296-5f24efd2dc98",
                        "glosses": [
                            "мед. истечение крови из кровеносных сосудов в ткани или полости организма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e6283a-0059-4796-b9f5-1bed963f47ac",
                                "sense_id": "6a44525e-7a29-31f8-bcc0-6901e8d63d3e",
                                "text": "Внутренний осмотр показал поранение правых лёгкого и плевры, воспаление лёгкого и кровоизлияние в полость плевры."
                            },
                            {
                                "example_id": "e4f618fd-8346-4763-a3e8-357f8e4f4b7f",
                                "sense_id": "6a44525e-7a29-31f8-bcc0-6901e8d63d3e",
                                "text": "Подозеров остался жить, но тем не менее он остановился на самом краю гроба: легкие его были поранены, и за этим последовали и кровоизлияние в полость груди, и удушающая легочная опухоль, и травматическая лихорадка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef00f639-c788-4631-8aef-bf24efd3d601",
                        "source_entry_id": "7e2f7be0-6d48-355e-b296-5f24efd2dc98",
                        "source_sense_id": "6a44525e-7a29-31f8-bcc0-6901e8d63d3e",
                        "target_lang_word": "haemorrhage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haemorrhage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                        "entry_id": "def3b0d5-932b-3833-a509-4e84153e521b",
                                        "glosses": [
                                            "British standard spelling of hemorrhage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c05893-ed9d-49de-98b0-c2da703814ad",
                                                "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                                "text": "It’s haemorrhaging now!"
                                            },
                                            {
                                                "example_id": "ee93facd-78cc-472b-9f58-903d7b685309",
                                                "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                                "text": "The company haemorrhaged money until eventually it went bankrupt."
                                            },
                                            {
                                                "example_id": "fad0ab49-0bd2-4cab-bcf4-adb4bc245521",
                                                "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                                "text": "In the early 1980s, the UK was gripped by a recession. A newly elected Conservative government was never going to let BR haemorrhage money if it could help it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haemorrhage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                        "entry_id": "99decab1-c94b-3e56-b193-d7b18571028d",
                                        "glosses": [
                                            "British standard spelling of hemorrhage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4825c894-5055-4fe4-9350-4ea5971e5f02",
                                                "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                                "text": "We got news that he died of a haemorrhage!"
                                            },
                                            {
                                                "example_id": "3c1da454-b760-405c-92a5-ea56533d1c9b",
                                                "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                                "text": "Lan Chengzhang, who worked for the China Trade News, died of an apparent brain haemorrhage after over 20 thugs set upon him and his taxi driver on January 10 at a mine in Hunyuan county, in the northern province of Shanxi."
                                            },
                                            {
                                                "example_id": "6943b771-3866-4abe-a9a4-1ac7e48f7fdc",
                                                "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                                "text": "Relics of the British empire now mostly survive in the interstices of the global economy. They are the major winners from the fiscal haemorrhage that has resulted from financial globalisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
