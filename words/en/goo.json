{
    "word_family": [
        "gooey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16752707-5524-3776-9cfc-a2a6cc4fabe6",
                    "sense_definition": "A sticky or slippery substance of unknown or unpleasant composition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stepped in some <w>goo</w> and had a hard time cleaning my shoes.",
                            "target_lang_translations": {
                                "cs": "Šlápl jsem do nějakého <w>slizu</w> a bylo těžké si boty vyčistit."
                            }
                        },
                        {
                            "text": "The machine was covered in a thick, black <w>goo</w> that smelled terrible.",
                            "target_lang_translations": {
                                "cs": "Stroj byl pokrytý hustou, černou <w>patlaninou</w>, která strašně páchla."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloop",
                        "glop",
                        "gunge",
                        "gunk",
                        "muck",
                        "ooze",
                        "sludge",
                        "slime"
                    ],
                    "common_phrases": [
                        "sticky goo"
                    ],
                    "target_lang_definitions": {
                        "cs": "Lepkavá nebo kluzká látka neznámého či nepříjemného složení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sliz",
                                "target_lang_sense_clarification": "obecné označení pro lepkavou, mazlavou hmotu"
                            },
                            {
                                "target_lang_word": "patlanina",
                                "target_lang_sense_clarification": "neformální označení pro nevábnou směs"
                            },
                            {
                                "target_lang_word": "mazlavá hmota",
                                "target_lang_sense_clarification": "popisný výraz pro hustou, lepkavou látku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeda64ab-0329-37e8-92f2-6c954d0fbc5a",
                    "sense_definition": "A sound made by a baby that is not yet real speech.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The happy baby made soft <w>goos</w> while playing with his toys.",
                            "target_lang_translations": {
                                "cs": "Šťastné miminko při hraní s hračkami tiše <w>žvatlalo</w>."
                            }
                        },
                        {
                            "text": "We listened to the baby's cute <w>goos</w> as she sat in her crib.",
                            "target_lang_translations": {
                                "cs": "Poslouchali jsme roztomilé <w>broukání</w> miminka, když sedělo v postýlce."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk vydávaný miminkem, který ještě není skutečnou řečí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žvatlání",
                                "target_lang_sense_clarification": "dětské nesrozumitelné zvuky"
                            },
                            {
                                "target_lang_word": "broukání",
                                "target_lang_sense_clarification": "spokojené hrdelní zvuky miminka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41b1aefe-5f9b-3ad0-aeac-8c634a5a0431",
                    "sense_definition": "Excessive and insincere emotional display.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was filled with so much <w>goo</w> that it felt completely fake.",
                            "target_lang_translations": {
                                "cs": "Ten film byl plný takové <w>přeslazenosti</w>, že působil úplně falešně."
                            }
                        },
                        {
                            "text": "I cannot stand the <w>goo</w> in those romantic novels.",
                            "target_lang_translations": {
                                "cs": "Nemůžu vystát ten <w>patos</w> v těch romantických románech."
                            }
                        }
                    ],
                    "synonyms": [
                        "mawkishness",
                        "saccharinity",
                        "sugariness"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přehnaný a neupřímný citový projev."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přeslazenost",
                                "target_lang_sense_clarification": "přehnaná sentimentalita"
                            },
                            {
                                "target_lang_word": "patos",
                                "target_lang_sense_clarification": "uměle vyvolaný, neupřímný citový náboj"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b45a5d-4e44-3df7-a87f-22cf58f8d913",
                    "sense_definition": "A medical condition where the stomach outlet is blocked.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was diagnosed with <w>goo</w> after experiencing persistent vomiting.",
                            "target_lang_translations": {
                                "cs": "Pacientovi byla diagnostikována <w>žaludeční obstrukce</w> poté, co trpěl přetrvávajícím zvracením."
                            }
                        },
                        {
                            "text": "Surgery is often required to treat severe cases of <w>goo</w>.",
                            "target_lang_translations": {
                                "cs": "K léčbě závažných případů <w>žaludeční obstrukce</w> je často nutná operace."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zdravotní stav, při kterém je zablokován vývod žaludku."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fd382df-e1df-39e8-a36d-da353b24e82b",
                    "sense_definition": "To make baby-like sounds.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby <w>gooed</w> happily when his mother entered the room.",
                            "target_lang_translations": {
                                "cs": "Miminko spokojeně <w>žvatlalo</w>, když jeho matka vstoupila do místnosti."
                            }
                        },
                        {
                            "text": "She <w>gooed</w> at the infant to make him laugh.",
                            "target_lang_translations": {
                                "cs": "Na miminko <w>broukala</w>, aby ho rozesmála."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat zvuky podobné miminku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žvatlat",
                                "target_lang_sense_clarification": "vydávat dětské zvuky"
                            },
                            {
                                "target_lang_word": "broukat si",
                                "target_lang_sense_clarification": "vydávat spokojené zvuky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "675ec60f-1571-3a29-bb3b-8bd411e519b2",
                    "sense_definition": "To cover something with a sticky substance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>gooed</w> his hair with too much styling gel.",
                            "target_lang_translations": {
                                "cs": "Vlasy si <w>upatlal</w> příliš velkým množstvím gelu."
                            }
                        },
                        {
                            "text": "The children <w>gooed</w> the table with glue during art class.",
                            "target_lang_translations": {
                                "cs": "Děti během výtvarné výchovy <w>zamazaly</w> stůl lepidlem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrýt něco lepkavou látkou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "upatlat",
                                "target_lang_sense_clarification": "zašpinit něco lepkavou látkou"
                            },
                            {
                                "target_lang_word": "zamazat",
                                "target_lang_sense_clarification": "pokrýt povrch něčím mazlavým"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96d0cd0d-25eb-3169-b3cc-335e3ae37bc2",
                    "sense_definition": "An emphatic or slang way to say go.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans shouted let's <w>goo</w> as the team entered the stadium.",
                            "target_lang_translations": {
                                "cs": "Fanoušci křičeli <w>jdem na to</w>, když tým vstoupil na stadion."
                            }
                        },
                        {
                            "text": "He posted a message saying let's <w>goo</w> to celebrate the win.",
                            "target_lang_translations": {
                                "cs": "Zveřejnil zprávu s textem <w>jdem na to</w>, aby oslavil vítězství."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lets goo"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in informal digital communication."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Důrazný nebo slangový způsob, jak říci jít (go)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jdem na to",
                                "target_lang_sense_clarification": "slangové vyjádření nadšení nebo akce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa35d47e-708a-3244-b73d-1abe209584a5",
                    "sense_definition": "A non-standard pronunciation spelling of the verb go.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character in the old novel said I must <w>goo</w> home now.",
                            "target_lang_translations": {
                                "cs": "Postava ve starém románu řekla: Musím teď <w>jít</w> domů."
                            }
                        },
                        {
                            "text": "He decided to <w>goo</w> to the market despite the rain.",
                            "target_lang_translations": {
                                "cs": "Rozhodl se <w>jít</w> na trh navzdory dešti."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used to represent specific regional accents in literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nestandardní pravopisná varianta slovesa jít (go)."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "21229ce3-2aeb-39fa-ba45-58951e1c056b",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Goo</w> is our new neighbor from Korea.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Koo</w> je náš nový soused z Koreje."
                            }
                        },
                        {
                            "text": "The research paper was written by Dr. <w>Goo</w>.",
                            "target_lang_translations": {
                                "cs": "Výzkumnou práci napsal Dr. <w>Koo</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Common Korean surname."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Koo",
                                "target_lang_sense_clarification": "korejské příjmení (často přepisováno jako Goo)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}