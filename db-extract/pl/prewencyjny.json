                                                "example_id": "b8d56172-28f6-4395-89f3-7f43e0bec6a0",
                                                "sense_id": "0bb51c3c-deeb-3900-9b41-84b2aacab951",
                                                "text": "Eaten with sugar yaourt is very palatable and refreshing in warm weather and is said to be a preventive of fever."
                                            }
