{
    "word_family": [
        "expansion",
        "expansive",
        "expandable",
        "expander",
        "expansively"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bf00538-bc87-3df2-bdd0-65841f54d983",
                    "sense_definition": "To become larger in size, volume, or quantity, or to make something larger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most metals <w>expand</w> when they get hot.",
                            "target_lang_translations": {
                                "ru": "Большинство металлов <w>расширяются</w> при нагревании.",
                                "de": "Die meisten Metalle <w>dehnen</w> sich bei Hitze aus.",
                                "zh": "大多数金属受热时会<w>膨胀</w>。"
                            }
                        },
                        {
                            "text": "The bird <w>expanded</w> its wings to dry them in the sun.",
                            "target_lang_translations": {
                                "ru": "Птица <w>расправила</w> крылья, чтобы просушить их на солнце.",
                                "de": "Der Vogel <w>breitete</w> seine Flügel aus, um sie in der Sonne zu trocknen.",
                                "zh": "那只鸟<w>张开</w>翅膀，让阳光把它们晒干。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enlarge",
                        "spread out",
                        "open out",
                        "unfold",
                        "spread",
                        "grow",
                        "increase"
                    ],
                    "antonyms": [
                        "contract",
                        "collapse"
                    ],
                    "common_phrases": [
                        "expand rapidly",
                        "expand and contract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться или делать больше по размеру, объему или количеству.",
                        "de": "Größer werden oder etwas größer machen, sei es in Bezug auf Größe, Volumen oder Menge.",
                        "zh": "指物体在尺寸、体积或数量上变得更大，或使某物变大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширяться",
                                "target_lang_sense_clarification": "становиться шире или больше (о предметах, веществах)"
                            },
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "делать шире или больше"
                            },
                            {
                                "target_lang_word": "увеличиваться",
                                "target_lang_sense_clarification": "расти в размере или объеме"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich ausdehnen",
                                "target_lang_sense_clarification": "sich räumlich vergrößern (z. B. bei Hitze)"
                            },
                            {
                                "target_lang_word": "vergrößern",
                                "target_lang_sense_clarification": "etwas in seiner Ausdehnung oder seinem Umfang größer machen"
                            },
                            {
                                "target_lang_word": "ausbreiten",
                                "target_lang_sense_clarification": "etwas entfalten oder räumlich ausdehnen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膨胀",
                                "target_lang_sense_clarification": "指物体受热或受压后体积增大"
                            },
                            {
                                "target_lang_word": "扩大",
                                "target_lang_sense_clarification": "指使范围或规模变大"
                            },
                            {
                                "target_lang_word": "张开",
                                "target_lang_sense_clarification": "指身体部位或物体向外伸展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b87f93ba-4616-3209-a398-94997796e0b5",
                    "sense_definition": "To increase the scope, extent, or importance of something, such as a business or activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>expand</w> its operations into Europe next year.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>расширить</w> свою деятельность в Европе в следующем году.",
                                "de": "Das Unternehmen plant, seine Geschäftstätigkeit im nächsten Jahr nach Europa zu <w>erweitern</w>.",
                                "zh": "公司计划明年将业务<w>扩展</w>到欧洲。"
                            }
                        },
                        {
                            "text": "Reading books helps to <w>expand</w> your vocabulary.",
                            "target_lang_translations": {
                                "ru": "Чтение книг помогает <w>расширить</w> ваш словарный запас.",
                                "de": "Bücher zu lesen hilft dabei, den eigenen Wortschatz zu <w>erweitern</w>.",
                                "zh": "阅读书籍有助于<w>扩充</w>你的词汇量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enlarge"
                    ],
                    "antonyms": [
                        "limit"
                    ],
                    "common_phrases": [
                        "expand the business",
                        "expand the range",
                        "expand operations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать масштаб, охват или значимость чего-либо (например, бизнеса или деятельности).",
                        "de": "Den Umfang, die Reichweite oder die Bedeutung von etwas vergrößern, wie etwa bei einem Unternehmen oder einer Aktivität.",
                        "zh": "增加某事物的范围、程度或重要性，例如业务或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "увеличивать охват (бизнеса, знаний)"
                            },
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "улучшать и увеличивать масштаб деятельности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erweitern",
                                "target_lang_sense_clarification": "den Umfang oder das Angebot vergrößern"
                            },
                            {
                                "target_lang_word": "expandieren",
                                "target_lang_sense_clarification": "geschäftlich wachsen oder den Wirkungskreis vergrößern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扩展",
                                "target_lang_sense_clarification": "指业务、规模或影响力的扩大"
                            },
                            {
                                "target_lang_word": "扩充",
                                "target_lang_sense_clarification": "指在原有基础上增加内容或数量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20f0169b-87f3-3c70-9977-1dcf86f5882a",
                    "sense_definition": "To show the hidden subentries of a list or folder in a graphical user interface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click the arrow to <w>expand</w> the menu and see more options.",
                            "target_lang_translations": {
                                "ru": "Нажмите на стрелку, чтобы <w>развернуть</w> меню и увидеть больше опций.",
                                "de": "Klicken Sie auf den Pfeil, um das Menü zu <w>erweitern</w> und weitere Optionen zu sehen.",
                                "zh": "点击箭头以<w>展开</w>菜单，查看更多选项。"
                            }
                        },
                        {
                            "text": "You need to <w>expand</w> the file tree to find the document.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>раскрыть</w> дерево файлов, чтобы найти документ.",
                                "de": "Sie müssen den Dateibaum <w>ausklappen</w>, um das Dokument zu finden.",
                                "zh": "你需要<w>展开</w>文件树才能找到该文档。"
                            }
                        }
                    ],
                    "antonyms": [
                        "collapse"
                    ],
                    "common_phrases": [
                        "click to expand",
                        "expand the folder"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать скрытые элементы списка или папки в компьютерном интерфейсе.",
                        "de": "In einer grafischen Benutzeroberfläche versteckte Unterelemente einer Liste oder eines Ordners anzeigen.",
                        "zh": "在图形用户界面中显示列表或文件夹的隐藏子项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развернуть",
                                "target_lang_sense_clarification": "открыть содержимое папки или меню"
                            },
                            {
                                "target_lang_word": "раскрыть",
                                "target_lang_sense_clarification": "сделать видимым скрытый список"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ausklappen",
                                "target_lang_sense_clarification": "ein Menü oder eine Liste öffnen"
                            },
                            {
                                "target_lang_word": "erweitern",
                                "target_lang_sense_clarification": "die Ansicht eines Ordners oder Baums vergrößern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "指在电脑界面中显示隐藏的菜单或文件夹内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741e6027-7538-3d9a-92f9-2613eaf5677f",
                    "sense_definition": "To speak or write about something in greater detail.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you please <w>expand</w> on your earlier statement?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы <w>раскрыть</w> подробнее ваше предыдущее утверждение?",
                                "de": "Könnten Sie bitte Ihre frühere Aussage etwas <w>ausführen</w>?",
                                "zh": "你能就你之前的陈述再<w>详述</w>一下吗？"
                            }
                        },
                        {
                            "text": "The author <w>expands</w> the simple plot into a complex novel.",
                            "target_lang_translations": {
                                "ru": "Автор <w>развивает</w> простой сюжет в сложный роман.",
                                "de": "Der Autor <w>entwickelt</w> die einfache Handlung zu einem komplexen Roman.",
                                "zh": "作者将简单的故事情节<w>展开</w>成了一部复杂的小说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elaborate",
                        "expand on"
                    ],
                    "common_phrases": [
                        "expand on the idea",
                        "expand on a topic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать о чем-либо более подробно и обстоятельно.",
                        "de": "Über ein Thema ausführlicher oder detaillierter sprechen oder schreiben.",
                        "zh": "更详细地谈论或书写某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "подробно описывать тему или мысль"
                            },
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "дополнять сказанное новыми деталями"
                            },
                            {
                                "target_lang_word": "подробно излагать",
                                "target_lang_sense_clarification": "описывать в деталях"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ausführen",
                                "target_lang_sense_clarification": "etwas detaillierter erklären"
                            },
                            {
                                "target_lang_word": "näher eingehen auf",
                                "target_lang_sense_clarification": "ein Thema vertiefen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "详述",
                                "target_lang_sense_clarification": "指对某事进行详细的说明"
                            },
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "指对观点或话题进行深入阐述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8146b222-dc74-3d50-9c12-35a2d9a2f874",
                    "sense_definition": "To rewrite a mathematical expression as a longer sum of terms.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learned how to <w>expand</w> binomial expressions in algebra class.",
                            "target_lang_translations": {
                                "ru": "Ученики учились <w>раскрывать</w> биномиальные выражения на уроке алгебры.",
                                "de": "Die Schüler lernten im Algebraunterricht, wie man binomische Ausdrücke <w>ausmultipliziert</w>.",
                                "zh": "学生们在代数课上学习了如何<w>展开</w>二项式表达式。"
                            }
                        },
                        {
                            "text": "If you <w>expand</w> this bracket, you get a quadratic equation.",
                            "target_lang_translations": {
                                "ru": "Если <w>раскрыть</w> эту скобку, получится квадратное уравнение.",
                                "de": "Wenn man diese Klammer <w>auflöst</w>, erhält man eine quadratische Gleichung.",
                                "zh": "如果你把这个括号<w>展开</w>，就会得到一个二次方程。"
                            }
                        }
                    ],
                    "antonyms": [
                        "factor"
                    ],
                    "common_phrases": [
                        "expand the equation",
                        "expand the brackets"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать математическое выражение, раскрывая скобки.",
                        "de": "Einen mathematischen Ausdruck durch Auflösen von Klammern in eine längere Summe von Termen umwandeln.",
                        "zh": "将数学表达式重写为更长的项之和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "математическое действие со скобками"
                            },
                            {
                                "target_lang_word": "раскладывать",
                                "target_lang_sense_clarification": "представлять в виде суммы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ausmultiplizieren",
                                "target_lang_sense_clarification": "Klammern in einem mathematischen Ausdruck auflösen"
                            },
                            {
                                "target_lang_word": "auflösen",
                                "target_lang_sense_clarification": "Klammern mathematisch entfernen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "指数学中通过去括号将表达式化为多项式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}