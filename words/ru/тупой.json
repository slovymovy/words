    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d790a38d-b283-3e6f-b424-ab98634eadcb",
                    "sense_definition": "Неспособный хорошо резать или колоть; незаострённый (о режущих и колющих предметах).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_bluntness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этим <тупым> ножом совершенно невозможно порезать свежий хлеб.",
                            "target_lang_translations": {
                                "en": "It is absolutely impossible to cut fresh bread with this <blunt> knife.",
                                "de": "Mit diesem <w>stumpfen</w> Messer ist es absolut unmöglich, frisches Brot zu schneiden."
                            }
                        },
                        {
                            "text": "Парикмахер пожаловался, что его ножницы стали <тупыми>.",
                            "target_lang_translations": {
                                "en": "The hairdresser complained that his scissors had become <blunt>.",
                                "de": "Der Friseur beschwerte sich, dass seine Schere <w>stumpf</w> geworden war."
                            }
                        }
                    ],
                    "synonyms": [
                        "незаострённый",
                        "неострый"
                    ],
                    "antonyms": [
                        "острый",
                        "заострённый"
                    ],
                    "common_phrases": [
                        "тупой нож",
                        "тупые ножницы",
                        "тупая игла",
                        "тупая бритва"
                    ],
                    "target_lang_definitions": {
                        "en": "Not sharp; having a thick or rounded edge or point (of cutting instruments).",
                        "de": "Nicht scharf; mit einer dicken oder abgerundeten Schneide oder Spitze (von Schneidewerkzeugen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blunt",
                                "target_lang_sense_clarification": "not sharp"
                            },
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "lacking sharpness"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stumpf",
                                "target_lang_sense_clarification": "nicht scharf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34fc9a87-966d-3cd2-bf2b-8b94766bc9fb",
                    "sense_definition": "Глупый, плохо соображающий, бестолковый (о человеке или его действиях).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mental_dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не задавай мне таких <тупых> вопросов, подумай сам.",
                            "target_lang_translations": {
                                "en": "Don't ask me such <stupid> questions, think for yourself.",
                                "de": "Stell mir nicht so <w>dumme</w> Fragen, denk selbst nach."
                            }
                        },
                        {
                            "text": "Он оказался слишком <тупым>, чтобы понять эту простую шутку.",
                            "target_lang_translations": {
                                "en": "He turned out to be too <stupid> to understand this simple joke.",
                                "de": "Er erwies sich als zu <w>dumm</w>, um diesen einfachen Witz zu verstehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "глупый",
                        "бестолковый",
                        "неумный",
                        "ограниченный"
                    ],
                    "antonyms": [
                        "умный",
                        "остроумный"
                    ],
                    "common_phrases": [
                        "тупой человек",
                        "тупой вопрос",
                        "тупая шутка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
