                    {
                        "sense_id": "f2023654-278d-332e-bc37-8f1061a0901a",
                        "entry_id": "f3a5a1df-b04d-3df2-9309-ca2e1f0c8f32",
                        "glosses": [
                            "Tranquillement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "27900827-2ffd-4e6c-8812-a4c29852a0fa",
                                "sense_id": "f2023654-278d-332e-bc37-8f1061a0901a",
                                "text": "On n’en a cure et l’on n’en prépare pas moins les championnats du monde en Suède, tranquillou."
                            },
                            {
                                "example_id": "afc52a89-028b-4ba3-a9ca-9499da8d3692",
                                "sense_id": "f2023654-278d-332e-bc37-8f1061a0901a",
                                "text": "Décernée tranquillou à Aurélie Filippetti."
                            },
                            {
                                "example_id": "8800e96b-3d3a-48b9-a4e7-695ebfc74e6a",
                                "sense_id": "f2023654-278d-332e-bc37-8f1061a0901a",
                                "text": "Certaines années l’épidémie de grippe, c’est tranquillou. Mais d’autres années sans que l’on puisse le prévoir, c’est la cata."
                            },
                            {
                                "example_id": "a3cfa7f8-3e46-4251-bc6f-288831efbc39",
                                "sense_id": "f2023654-278d-332e-bc37-8f1061a0901a",
                                "text": "« C'est quand un homme se sent fragilisé dans sa virilité qu'il devient violent », explique-t-il tranquillou dans sa vidéo d'introduction."
                            }
                        ]
                    }
                ],
