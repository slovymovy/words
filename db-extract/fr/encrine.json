                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a97a61b6-4515-4d92-9167-e03d836007a8",
                                "sense_id": "6ffa901c-dffd-31d9-9f93-685e9e3ba784",
                                "text": "L’encrine était fixée au fond de la mer par une longue tige, composée d’articles en entroques, rappelant l’empilement des vertèbres de la colonne vertébrale."
                            },
                            {
                                "example_id": "bd950d1d-d29e-409d-9542-d99c517e6bcc",
                                "sense_id": "6ffa901c-dffd-31d9-9f93-685e9e3ba784",
                                "text": "Cependant elle n’est pas trace au même titre que l’empreinte de l'astérie ou de l’encrine."
                            }
                        ]
                    }
