                    {
                        "sense_id": "922fd99d-810b-30e2-946a-9c1c27da54cc",
                        "entry_id": "1a58a852-0edb-3991-af00-557e471048d4",
                        "glosses": [
                            "gekozen volksvertegenwoordiger in het Europees Parlement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3df2db5-96d8-4e80-b397-436cfdcfbf5c",
                                "sense_id": "922fd99d-810b-30e2-946a-9c1c27da54cc",
                                "text": "Na afloop van het debat riepen verontwaardigde Europarlementariërs op tot een onderzoek naar de verspreiding van Russische propaganda in het Europees Parlement."
                            },
                            {
                                "example_id": "2e6b7d31-20c3-4f30-8e59-7a409b372682",
                                "sense_id": "922fd99d-810b-30e2-946a-9c1c27da54cc",
                                "text": "Zo verbleef PVV-Europarlementariër André Elissen in 2017 op kosten van het Kremlin als ‘verkiezingswaarnemer’ in Moskou."
                            },
                            {
                                "example_id": "81da5c4e-48c7-4584-a312-68f797fcc3fe",
                                "sense_id": "922fd99d-810b-30e2-946a-9c1c27da54cc",
                                "text": "Vorige week riep een groep Europarlementariërs de Europese Commissie op om niet langer geld uit Europese fondsen naar Hongarije over te maken vanwege rechtsstaatsschendingen. De Commissie heeft de afgelopen jaren om die reden al 18 miljard euro aan geld voor Hongarije bevroren."
                            }
                        ]
                    }
