                "translations": [
                    {
                        "translation_id": "734e1223-e001-48f8-a43c-edec3645d935",
                        "source_entry_id": "b5dc60a2-2073-3050-a74a-22bcb8d62dbb",
                        "source_sense_description": "парламент",
                        "target_lang_word": "Reichstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reichstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3e48a7-0290-30fa-a3b4-a34a929fe389",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdfe160-9f60-4d6e-a8e3-e4b80c50d129",
                                                "sense_id": "fa3e48a7-0290-30fa-a3b4-a34a929fe389",
                                                "text": "Der schwedische Reichstag bestand 2010 aus 349 Abgeordneten."
                                            },
                                            {
                                                "example_id": "a724535b-6f33-4b84-9bcd-0a6c726ac2d0",
                                                "sense_id": "fa3e48a7-0290-30fa-a3b4-a34a929fe389",
                                                "text": "Im dritten Reich hatte der Reichstag keine gesetzgeberische Kompetenz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "wechselnde Tagungsorte in dem von 754 bis 1806 bestehenden Heiligen Römischen Reich Deutscher Nation"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873f526a-a1a0-4f38-aabc-73269c9c5970",
                                                "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                                "text": "Die Reichstage waren ursprünglich eine Art Heerschau, bei der der König seine Adligen und deren Gefolgsleute musterte."
                                            },
                                            {
                                                "example_id": "600123cc-3f24-48b6-85f2-9d278d1a462c",
                                                "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                                "text": "„In Versammlungen wie dem Reichstag nutzten die katholischen Fürsten zudem das Mehrheitswahlrecht, um die Protestanten kaltzustellen.“"
                                            },
                                            {
                                                "example_id": "39dbb0a8-fb0b-467d-91df-916375a7ccee",
                                                "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                                "text": "„Das »Hailig Reych und Teutsch Nation« selbst war erst auf dem Reichstag in Frankfurt 1486 in der Landfriedensordnung offiziell auf diese Formel gebracht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "027c3559-69e5-3733-a557-7ee74455a5aa",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Übergangskonstrukt von 1848/49 in Österreich"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958a1b39-29cf-4ca9-8d56-13db72712916",
                                                "sense_id": "027c3559-69e5-3733-a557-7ee74455a5aa",
                                                "text": "Der Reichstag bestand aus 383 Abgeordneten aus den deutschsprachigen und slawischen Kronländern des Kaisertums Österreich, das heißt ohne Vertreter des Königreichs Ungarn."
                                            }
                                        ],
