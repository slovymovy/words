                ],
                "senses": [
                    {
                        "sense_id": "ff07a384-da33-3a43-bf55-3326ed3f8e46",
                        "entry_id": "ee78ede7-3757-3dba-ad22-31d614b8a730",
                        "glosses": [
                            "истор. жительница или уроженка Абиссинии; эфиопка [2]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa99067-57f9-48d5-bc0f-4110d7078ae3",
                                "sense_id": "ff07a384-da33-3a43-bf55-3326ed3f8e46",
                                "text": "Насколько свободна жизнь простых абиссинок, настолько замкнута жизнь знатных особ."
                            }
                        ]
                    },
                    {
                        "sense_id": "a725541a-721a-34ed-8ff0-388d36f95c0d",
                        "entry_id": "ee78ede7-3757-3dba-ad22-31d614b8a730",
                        "glosses": [
                            "зоол., разг. кошка абиссинской породы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d13744-97f8-4a0d-9163-0e1673c53fcf",
                                "sense_id": "a725541a-721a-34ed-8ff0-388d36f95c0d",
                                "text": "В 1964 году американка Вирджиния Дейл решила вывести новую цветовую вариацию сиамских кошек — с отметинами (на лапках, ушах, голове и хвосте) по цвету такими же, как окрас абиссинок, то есть «дикими»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e472ce2-c8a7-49c0-a56f-c2bbbfb7d7a8",
                        "source_entry_id": "ee78ede7-3757-3dba-ad22-31d614b8a730",
                        "target_lang_word": "Abyssinian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abyssinian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3305e48-70be-3085-a73f-3c04177d97b8",
                                        "entry_id": "c7e853d6-9d56-3295-9695-ec16ab64b0dd",
                                        "glosses": [
                                            "Of or pertaining to Ethiopia or its inhabitants; Ethiopian."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c871fb8-6a0e-4383-9d30-cbc6bf43bb9e",
                                                "sense_id": "b3305e48-70be-3085-a73f-3c04177d97b8",
                                                "text": "Our men are frightened of these Abyssinian women."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d75925-703f-3ac6-ae61-cd9dcd41caa6",
                                        "entry_id": "c7e853d6-9d56-3295-9695-ec16ab64b0dd",
                                        "glosses": [
                                            "Of or pertaining to the Abyssinian Church."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b612f0df-4901-42bc-b463-e4e2440d74ac",
                                                "sense_id": "38d75925-703f-3ac6-ae61-cd9dcd41caa6",
                                                "text": "This king [Fasilides] immediately restored the Abyssinian doctrines, and hunted out the Jesuit missionaries."
                                            },
                                            {
                                                "example_id": "6f8aed51-d8f0-45c7-9a2c-b34f5827bc0e",
                                                "sense_id": "38d75925-703f-3ac6-ae61-cd9dcd41caa6",
                                                "text": "The Abyssinian rite has fourteen different eucharistic prayers for use on different liturgical days; […]"
                                            },
                                            {
                                                "example_id": "a593f457-36b9-49d8-a257-a3a3f6e58eec",
                                                "sense_id": "38d75925-703f-3ac6-ae61-cd9dcd41caa6",
                                                "text": "Among the documents, according to the chronicler [João de] Barros, was information brought to Lisbon by an Abyssinian priest, one Lucas Marcos, in 1490."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Abyssinian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33641749-b5d8-39a6-bb6a-4a561f8af333",
                                        "entry_id": "3c3d224e-e049-3545-8fe9-c3863f6a8a56",
                                        "glosses": [
                                            "A short-haired domestic cat descended from cats of ancient Egypt, making it one of the oldest breeds in the world."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dd13311-e108-37df-a3f7-dcd5230684c6",
                                        "entry_id": "3c3d224e-e049-3545-8fe9-c3863f6a8a56",
                                        "glosses": [
                                            "A member of the Abyssinian Church."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18e48186-724d-3704-898b-af0133dc4d30",
                                        "entry_id": "3c3d224e-e049-3545-8fe9-c3863f6a8a56",
                                        "glosses": [
                                            "A native of Ethiopia."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c629236f-e6ee-4366-8356-5f8699b4e638",
                                                "sense_id": "18e48186-724d-3704-898b-af0133dc4d30",
                                                "text": "A group of Abyssinians are astride horses in brightly colored saddles at the top of the hill across the valley."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Abyssinian",
                                "target_lang_code": "en",
                                "target_senses": [
