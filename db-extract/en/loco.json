            {
                "entry_id": "24f57078-5fa8-3f8b-849d-630fe1c9f072",
                "word": "loco",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "24f09f12-3933-4037-825a-2b5d475f6d25",
                        "entry_id": "24f57078-5fa8-3f8b-849d-630fe1c9f072",
                        "tags": [
                            "plural"
                        ],
