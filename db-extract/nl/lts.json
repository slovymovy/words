                        "examples": [
                            {
                                "example_id": "323f5fc9-fc21-4257-9e7e-70c044d1831f",
                                "sense_id": "5ef8120d-85d6-324f-91e3-7516cedca837",
                                "text": "Vier scholen voor voortgezet onderwijs uit Nijverdal (College Noetsele en Nieuwland) en Rijssen (Chr. Mavo en Chr. LTS) fuseerden in 1994 tot één brede, open christelijke scholengemeenschap. Die kreeg de naam Reggesteyn, om de verbinding tussen Rijssen en Nijverdal aan te geven. De school wil ook een goede band hebben met de lokale samenleving."
                            },
                            {
                                "example_id": "cd384f16-9dff-4936-b6ff-00fdc49e6cc6",
                                "sense_id": "5ef8120d-85d6-324f-91e3-7516cedca837",
                                "text": "„Vroeger was er de lts waar leerlingen werden opgeleid tot vakman. Nu komen ze van het vmbo in een baan waar de baas hun het vak nog moet leren.”"
                            }
                        ]
