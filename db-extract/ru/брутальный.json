                        "form": "брута́льно"
                    },
                    {
                        "form_id": "6ef80986-afda-4c24-abcb-5d1c9a4413b2",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "tags": [
                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "брута́льна"
                    },
                    {
                        "form_id": "62e03068-72c5-41b5-925c-ef5997867756",
                        "entry_id": "5222ed57-07d4-3075-8fbc-4ceda2adbb4f",
                        "tags": [
