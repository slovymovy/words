                    "frequency": "Low",
                    "semantic_group_id": "argot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelqu'un a lâché un <w>silencieux</w> dans l'ascenseur bondé."
                        },
                        {
                            "text": "Il a souri d'un air innocent après avoir laissé échapper un <w>silencieux</w>."
