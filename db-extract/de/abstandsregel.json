                ],
                "senses": [
                    {
                        "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                        "entry_id": "77e008d5-aa32-3707-b449-6e1cc93e595e",
                        "glosses": [
                            "Vorschrift/Anweisung, die die Einhaltung eine Untergrenze einer räumlichen Entfernung (= Mindestabstand) zwischen zwei Personen oder Objekten fordert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "433629e2-3990-4533-805b-6a1dffa1659b",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[COVID-19-Pandemie:] „Für die Nichteinhaltung der Abstandsregel von 1,5 Meter können 150 Euro Bußgeld drohen […]“"
                            },
                            {
                                "example_id": "c1a5b85e-43d2-43f2-ba3d-d4162390ba6a",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[COVID-19-Pandemie:] „Warum hamstern viele in der Corona-Krise? Warum halten sich nicht alle die Abstandsregel?“"
                            },
                            {
                                "example_id": "9e652540-fa51-40a9-8abc-a6a91caba0c1",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[COVID-19-Pandemie:] „In Supermärkten ist es manchmal schwer, die Abstandsregel einzuhalten.“"
                            },
                            {
                                "example_id": "51fee694-b9b5-4d4b-a01d-7a25904ed358",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[COVID-19-Pandemie:] „[…] Betriebe [werden] geschlossen, in denen die Abstandsregel nicht eingehalten werden kann, wie Coiffeursalons oder Kosmetikstudios.“"
                            },
                            {
                                "example_id": "468fdf95-9f2d-4d3e-a4a1-c7bf5befffa2",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[COVID-19-Pandemie:] „Die Hygiene- und Abstandsregeln sind für eine Institution wie die Luzerner Gassenküche, die Drogenabhängige und Obdachlose betreut, eine besondere Herausforderung.“"
                            },
                            {
                                "example_id": "35271790-c562-4e47-a6f7-6b99a209ab19",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[COVID-19-Pandemie:] „Für ein Mannschaftstraining sind eine Lockerung oder eine Ausnahmegenehmigung für die Abstandsregeln nötig.“"
                            },
                            {
                                "example_id": "6280afad-14cc-4c2e-9877-813f9724071c",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[Windkrafträder:] „Bei der umstrittenen Abstandsregel zu Wohnhäusern betonte der Umweltminister erneut, Niedersachsen werde sich nicht an eine starre 1.000-Meter-Regel halten.“"
                            },
                            {
                                "example_id": "faaff81f-1956-4475-ac2b-59d757bb431e",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "[Windkrafträder:] „Vor allem die Abstandsregel für Windkraftanlagen war den Teilnehmern ein Dorn im Auge.“"
                            },
                            {
                                "example_id": "345c8fa7-533d-442a-a8c9-8f8e90153325",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "„[…] ob die Rad- und E-Rollerfahrer […] durch mehr Abstand beim Überholen besser geschützt sind, bleibt fraglich. Denn schon jetzt halten sich zu wenig Autofahrer an diese Abstandsregel.“"
                            },
                            {
                                "example_id": "d6e28a9e-3e42-4e5e-b904-b00e92e3b7bf",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "Beim Fahren von PKWs außerhalb geschlossener Ortschaften gilt als einfache Abstandregel: Mindestabstand zum vorausfahrenden Fahrzeug = halber Tacho."
                            },
                            {
                                "example_id": "fcb98f6d-4772-46e3-8cfb-91ff45c86a11",
                                "sense_id": "c1dbfce5-33e7-39a1-b3d8-f4d05b88980d",
                                "text": "„Weil sie eine tödliche Gefahr für Autofahrer sind, müssen Bäume immer öfter weichen. Eine neue Abstandsregel erschwert Neupflanzungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
