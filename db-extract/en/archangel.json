                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d08e3eb8-cb2d-4faf-8178-a6e27f7c4c54",
                        "source_entry_id": "bf25daf5-8a72-3fc8-b6f3-91d65d9eeb41",
                        "source_sense_description": "angel who leads other angels",
                        "target_lang_word": "aartsengel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aartsengel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4e05c105-feef-3229-af05-7868fdd31816",
                                        "entry_id": "f6166f83-c536-37be-8a28-7395be11b17e",
                                        "glosses": [
                                            "een hemelgeest in een rang boven een engel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd552178-7c00-4469-aed1-ce2552de0389",
                                                "sense_id": "4e05c105-feef-3229-af05-7868fdd31816",
                                                "text": "Weet jij wat een aartsengel is?"
                                            },
                                            {
                                                "example_id": "91d22793-f213-4331-b2ed-23ffcf36a96a",
                                                "sense_id": "4e05c105-feef-3229-af05-7868fdd31816",
                                                "text": "Toen hoorde hij tot zijn angst en vreugde de stem van de aartsengel Gabriel als een lied van binnen uit de klif komen, een stil lied dat hem aanmaande zijn landsheer te halen want die had een nog grotere zorg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "074bb420-8fd5-415d-ac3d-72bf17a493d4",
                        "source_entry_id": "bf25daf5-8a72-3fc8-b6f3-91d65d9eeb41",
                        "source_sense_description": "angel who leads other angels",
                        "target_lang_word": "archange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bb5133-aab8-34e6-8e63-917aa86ef95e",
                                        "entry_id": "2d9b36bd-09ac-3994-882e-04942a3a9793",
                                        "glosses": [
                                            "Dans la hiérarchie angélique, être d’un rang supérieur à l’ange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8d62d8-aa2b-4cc9-9523-2d75098da81f",
                                                "sense_id": "b2bb5133-aab8-34e6-8e63-917aa86ef95e",
                                                "text": "Et la trompette de l’archange sonna d’abîme en abîme, tandis que tout croulait avec un fracas et une ruine immense."
                                            },
                                            {
                                                "example_id": "1fa9b229-fcc6-42ed-badb-ef5e6faa6791",
                                                "sense_id": "b2bb5133-aab8-34e6-8e63-917aa86ef95e",
                                                "text": "Voici comment s’exprime saint Grégoire le Biglosse : « Nous reconnaissons neuf degrés ou ordres d’Anges, parce que la Parole de Dieu rend témoignage des Anges, des Archanges, des Vertus, des Puissances, des Principautés, des Dominations, des Trônes, des Chérubins et des Séraphins."
                                            },
                                            {
                                                "example_id": "1919696d-62c7-44fd-a273-1cc27b39d6ed",
                                                "sense_id": "b2bb5133-aab8-34e6-8e63-917aa86ef95e",
                                                "text": "Afin d’en finir avec cette orfèvrerie symbolique, disons encore que […] la sarde évoque les Séraphins, la topaze les Chérubins, le jaspe les Trônes, la chrysolithe les Dominations, le saphir les Vertus, l’onyx les Puissances, le béryl les Principautés, le rubis les Archanges et l’émeraude les Anges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3730699-ca9a-3015-b5e3-3d66f54cddce",
                                        "entry_id": "2d9b36bd-09ac-3994-882e-04942a3a9793",
                                        "glosses": [
                                            "Être ou chose surnaturelle, d’une puissance hors du commun, qui tend vers la transcendance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd65240-38c1-4394-b354-09e783aa4c93",
                                                "sense_id": "d3730699-ca9a-3015-b5e3-3d66f54cddce",
                                                "text": "Les hommes devenaient plus beaux, plus robustes, plus sains, depuis que le sport endurcissait leur corps, on voyait de moins en moins d’estropiés, de goitreux, de mutilés dans les rues et tous ces miracles étaient l’œuvre de la science, cet archange du progrès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5cb10e8-e637-32b8-a352-644aeba207b2",
                                        "entry_id": "2d9b36bd-09ac-3994-882e-04942a3a9793",
                                        "glosses": [
                                            "Meuble représentant l’être du même nom dans les armoiries. Il est généralement représenté de front, les ailes abaissées contrairement aux anges, les mains jointes ou tenant quelque autre meuble. On doit préciser le nom de l’archange représenté (Saint Gabriel, Saint Raphaël ou Saint Michel, ce dernier étant représenté terrassant un dragon, un démon voire le diable). À rapprocher de ange, angelot, chérubin et saint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e9ef24-426d-4eb2-b26b-a00a6c310014",
                                                "sense_id": "d5cb10e8-e637-32b8-a352-644aeba207b2",
                                                "text": "D’azur, à l’archange Raphaël conduisant le jeune Tobie, le tout d’or sur une terrasse du même, qui est de la commune de Saint-Raphaël du Var → voir illustration « armoiries avec un archange »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e121d8b6-ddfd-4631-bc84-43ca8e110a81",
                        "source_entry_id": "bf25daf5-8a72-3fc8-b6f3-91d65d9eeb41",
                        "source_sense_description": "angel who leads other angels",
                        "target_lang_word": "Erzengel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzengel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                        "entry_id": "d6f7fb91-63b4-3bf4-a2c7-79916b52ed20",
                                        "glosses": [
                                            "Engel mit einer wichtigen, herausragenden Rolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b429b1-ec48-409e-9d44-60e9af9c39da",
                                                "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                                "text": "In der Bibel gibt es einen Erzengel namens Michael."
                                            },
                                            {
                                                "example_id": "663c9c25-f05b-4137-96a3-9e14191e616e",
                                                "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                                "text": "„So sauber und gut erhalten war alles, als werde der Erzengel jeden Moment in seiner Kirche erwartet.“"
                                            },
                                            {
                                                "example_id": "c0306a0d-04a4-4166-a59f-979a50fc5162",
                                                "sense_id": "84e204ca-da92-33b5-8016-b449c296273f",
                                                "text": "„Aber am Lager der Wöchnerin mit dem Kind im Arm halten Erzengel Wache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
