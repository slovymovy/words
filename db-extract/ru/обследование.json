                                        "sense_id": "95e18cc8-3f01-3e17-933a-48688fe95ba0",
                                        "entry_id": "0c889129-e084-345f-91ec-26c8a6c2ae79",
                                        "glosses": [
                                            "The act of examining something, often closely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b19d26ae-696e-43df-867b-814a841fc8a4",
                                                "sense_id": "95e18cc8-3f01-3e17-933a-48688fe95ba0",
                                                "text": "Upon closer inspection, the animal turned out to be a dolphin, not a shark!"
                                            },
                                            {
                                                "example_id": "5e2104df-19ea-4bc9-bb84-72e488d64540",
                                                "sense_id": "95e18cc8-3f01-3e17-933a-48688fe95ba0",
                                                "text": "Trap doors are provided at various places in the floor to facilitate inspection and maintenance of the diesel equipment."
                                            },
                                            {
                                                "example_id": "d26450cd-2485-4c82-9531-2a4d6c642039",
                                                "sense_id": "95e18cc8-3f01-3e17-933a-48688fe95ba0",
                                                "text": "The NHRC conducted onsite inspections of Chienchen and Suao Fishing Harbors and held numerous seminars with industry, government, and academia representatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8e2135-36bd-3594-addc-873dd09cc4cf",
                                        "entry_id": "0c889129-e084-345f-91ec-26c8a6c2ae79",
                                        "glosses": [
                                            "An organization that checks that certain laws or rules are obeyed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23eb44d2-261d-4b4c-a765-4402c538363c",
                                                "sense_id": "0c8e2135-36bd-3594-addc-873dd09cc4cf",
                                                "text": "The inspection fined the restaurant's owner because the kitchen was dirty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d809e660-8c85-4d5d-8455-397de55cafb1",
                        "source_entry_id": "95cf0f96-7a61-3c56-a5f0-5f0fbffe0a81",
