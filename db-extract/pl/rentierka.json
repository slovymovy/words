                        "examples": [
                            {
                                "example_id": "e1687747-5222-4e8d-8e4e-a054387abdf5",
                                "sense_id": "79369875-cdf7-3ad5-a96f-44abc67b668e",
                                "text": "...objaśnić, że z 77 letnim mężem jest 84ro frankowa rentierka.",
                                "translation": "...to explain that a rentier worth 84 francs a year is with a 77-year-old husband.",
                                "english": "...to explain that a rentier worth 84 francs a year is with a 77-year-old husband."
                            },
                            {
                                "example_id": "155b45f2-0213-4f3f-a58a-4d85bf3456cf",
                                "sense_id": "79369875-cdf7-3ad5-a96f-44abc67b668e",
                                "text": "Pani Rivolet żyła lat 59 i zmarła jako rentierka w roku 1849 w stanie owdowiałym",
                                "translation": "Ms. Rivolet lived 59 years and died as a rentier in 1849 in a widowed state.",
                                "english": "Ms. Rivolet lived 59 years and died as a rentier in 1849 in a widowed state."
                            },
                            {
