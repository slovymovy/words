                "senses": [
                    {
                        "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                        "entry_id": "14128257-bab5-3db1-a8ed-182ad9a2867e",
                        "glosses": [
                            "A barn, especially one used for keeping cattle in."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "3ef6e365-561b-47b8-8a02-2b708e5e7665",
                                "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                "text": "It was here in the kitchen, in the passage,\nIn the mews in the harn in the byre in the market-place [...]"
                            },
                            {
                                "example_id": "1e354f65-3959-4fac-b6ed-953d190f261b",
                                "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                "text": "’Children crawled over each other like little grey worms in the gutters,’ he said. ‘The only red things about them were their buttocks and they were raw. Their faces looked as if snails had slimed on them and their mothers were like great sick beasts whose byres had never been cleared.[…]’"
                            },
                            {
                                "example_id": "2814b532-a937-4fd9-b881-ef812a39da2c",
                                "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                "text": "The visitors came up the narrow road through the forest from the south; they filled the spare-rooms, they bunked out in cow byres and barns."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f7b7226-f3f8-4efa-81fd-51f8f24dedc9",
                        "source_entry_id": "14128257-bab5-3db1-a8ed-182ad9a2867e",
                        "source_sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
