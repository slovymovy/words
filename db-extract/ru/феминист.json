                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feminist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                        "entry_id": "b13f43d7-2188-3563-9af0-dec82a4c53f7",
                                        "glosses": [
                                            "Person, die sich für den Feminismus (unter anderem Frauenrechte) einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72a0006-4e8d-4d83-a6a8-8ea9243c21b3",
                                                "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                                "text": "Manfred ist ein Feminist."
                                            },
                                            {
                                                "example_id": "85cd867a-813a-43dd-8855-0dd2038b8b8e",
                                                "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                                "text": "Martin mag die Feministen nicht."
                                            },
                                            {
                                                "example_id": "2820e051-e664-4cca-9b8c-75154555b0b6",
                                                "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                                "text": "«Ich war genau genommen schon ein Feminist, bevor es das Wort überhaupt gab!», sagte er der «Frankfurter Rundschau»."
                                            },
                                            {
                                                "example_id": "68b78c77-4db2-4670-8fa1-3df034431c01",
                                                "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                                "text": "„So gut Ezra auch über viele Dinge Bescheid wusste, er war kein Feminist, aber ihr war nicht danach, mit ihm eine Diskussion anzufangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c15ab9d1-9021-4966-ab0c-cf95945da2ff",
