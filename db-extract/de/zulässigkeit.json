                "senses": [
                    {
                        "sense_id": "b2df3286-d1c7-3eed-8d5c-19bb7645ef85",
                        "entry_id": "4dad2227-d30b-344a-8d7c-317eff0d952f",
                        "glosses": [
                            "Caractère de ce qui est admissible, permis, autorisé ; licéité, légalité, conformité aux règles."
                        ],
                        "tags": [],
                        "note": "Le pluriel est rare, et désigne des cas ou des degrés",
                        "examples": [
                            {
                                "example_id": "107020eb-2f0a-40b7-8280-230ec8274d63",
                                "sense_id": "b2df3286-d1c7-3eed-8d5c-19bb7645ef85",
                                "text": "Neue Untersuchungen sollen die Zulässigkeit des Projektes bestätigen.",
                                "translation": "De nouvelles études devraient confirmer la conformité du projet aux normes."
                            },
                            {
                                "example_id": "c869c211-1d62-4533-a48f-077d59f9e7fd",
                                "sense_id": "b2df3286-d1c7-3eed-8d5c-19bb7645ef85",
                                "text": "Im Oktober 2015 hat das kantonale Amt für Umwelt das neue Merkblatt für die Zulässigkeiten von Erdwärme veröffentlicht.",
                                "translation": "En octobre 2015, l'Office cantonal de l'environnement a publié la nouvelle fiche sur les cas d'admissibilité de la géothermie."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf874a51-1122-35c3-a0bd-48f68a6a2b3b",
                        "entry_id": "4dad2227-d30b-344a-8d7c-317eff0d952f",
                        "glosses": [
                            "Recevabilité, admissibilité d'une plainte, d'un recours ou de toute autre démarche / action."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f0c8eab6-9a26-4c3c-8d13-285332455bb2",
                                "sense_id": "cf874a51-1122-35c3-a0bd-48f68a6a2b3b",
                                "text": "Die Zulässigkeit einer Klage hängt von verschiedenen formellen Aspekten ab.",
                                "translation": "La recevabilité d'une plainte dépend de plusieurs aspects formels."
                            }
                        ]
                    }
