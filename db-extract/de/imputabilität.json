                "senses": [
                    {
                        "sense_id": "e619025c-c625-3dd8-bd65-cd3ab0ee6cae",
                        "entry_id": "ab42b8e9-348e-3630-83ba-22c23421ff52",
                        "glosses": [
                            "Eigenschaft/Zustand, wach, bei klarem Verstand und verantwortlich so wie zurechnungsfähig (imputabel) zu sein"
                        ],
                        "tags": [
                            "Jurisdiktion"
                        ],
                        "examples": [
                            {
                                "example_id": "85988595-587f-40a2-b40a-7bc1e3fbde00",
                                "sense_id": "e619025c-c625-3dd8-bd65-cd3ab0ee6cae",
                                "text": "„Die beschränkte Imputabilität wird, wie auch die Unzurechnungsfähigkeit, mit Hilfe medizinischer und rechtlicher Kriterien festgestellt.“"
                            },
                            {
                                "example_id": "692820dc-17da-4bd9-9f25-c2fb3daee3ac",
                                "sense_id": "e619025c-c625-3dd8-bd65-cd3ab0ee6cae",
                                "text": "„Kant geht davon aus, daß der eigentliche Grund der moralischen Imputabilität der Handlungen in der transzendentalen Freiheit als absoluter Spontaneität liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
