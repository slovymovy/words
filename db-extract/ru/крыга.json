                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb71b7e-8159-4955-b163-ec2c60975306",
                                "sense_id": "ab56672c-df78-37db-b8c8-c7e79d5b20c4",
                                "text": "На Дону с немолчным скрежетом ходили на дыбах саженные крыги."
                            },
                            {
                                "example_id": "4592eea9-ce5c-48d5-8204-4252303c6b43",
                                "sense_id": "ab56672c-df78-37db-b8c8-c7e79d5b20c4",
                                "text": "На Дону, уже в сумерках, с протяжным, перекатистым стоном хрястнул лед, и первая с шорохом вылезла из воды, сжатая массивом поломанного льда, крыга."
                            }
                        ]
                    }
