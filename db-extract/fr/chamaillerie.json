                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5837e476-3f07-4a3d-9a6a-30f94fafcd54",
                        "entry_id": "6104feab-8858-39e8-a645-d54acff3043d",
                        "tags": [
                            "plural"
                        ],
                        "form": "chamailleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                        "entry_id": "6104feab-8858-39e8-a645-d54acff3043d",
                        "glosses": [
                            "Action de se chamailler, querelle peu importante souvent accompagnée de cris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c939fe44-7c8e-4cc1-a1cb-18ba4f7e94dd",
                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                "text": "Les enfants, cessez vos chamailleries !"
                            },
                            {
                                "example_id": "34527af1-8a4d-49e1-8551-c2260fde073b",
                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                "text": "Ce n’était qu’une chamaillerie, ils se sont vite réconciliés."
                            },
                            {
                                "example_id": "6ac414a5-1c09-46fb-aa70-b8ea5cb6a8e8",
                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                "text": "Vous êtes moins bouillant, et je suis sûr que maintenant il nous serait beaucoup plus facile de vivre ensemble en bonne intelligence et sans chamaillerie."
                            },
                            {
                                "example_id": "8be91bc0-7944-43be-a226-1d7bc6006b04",
                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                "text": "Ils abritaient des oiseaux qui nous égayaient de leurs chamailleries et de leurs chants et parfois, le soir, explosait un immense piaillement de moineaux."
                            },
                            {
                                "example_id": "65c68928-ebe5-4188-9c61-ac6b20c69c31",
                                "sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                                "text": "Si j’ai des trucs à leur dire, et j’ai des trucs à leur dire, évidemment, je vais le faire entre quatre-z-yeux, discrètement, sans étaler désaccords et chamailleries dans ces colonnes, ou sur la place publique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "252d7d99-3b50-4414-a8e7-cca4f735fdfd",
                        "source_entry_id": "6104feab-8858-39e8-a645-d54acff3043d",
                        "source_sense_id": "7386a773-5e90-340d-8231-7a52045c8f31",
                        "target_lang_word": "Gezänk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gezänk",
