                ],
                "senses": [
                    {
                        "sense_id": "cae9fc80-7bf6-3845-b8e4-379b08e97f94",
                        "entry_id": "f6523f51-6eec-3173-836d-0335572b893b",
                        "glosses": [
                            "Ventouser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23450e35-27fb-4ae9-a077-2be7fa9f1fb6",
                                "sense_id": "cae9fc80-7bf6-3845-b8e4-379b08e97f94",
                                "text": "Mais j'ai essayé de reventouser sans pomper mais elle ne tient pas, je dois trouver un autre système d'accroche..."
                            },
                            {
                                "example_id": "a174180e-4018-4d49-b86c-5124761d0cec",
                                "sense_id": "cae9fc80-7bf6-3845-b8e4-379b08e97f94",
                                "text": "Par contre, dés que de l'eau va pousser dessus (trop plein d'un chavirage), elle va s'écarter et laisser passer l'eau avant de se reventouser au bateau."
                            },
                            {
                                "example_id": "cf11e7cc-6bba-4b8a-827c-3176b2b8b062",
                                "sense_id": "cae9fc80-7bf6-3845-b8e4-379b08e97f94",
                                "text": "Aliénor eut juste le temps de répondre à sa proposition avant de se reventouser à lui, ce qui eut pour effet de resserrer encore leur étreinte."
                            }
                        ]
                    }
                ],
