                        "source_entry_id": "6d171a33-3bbf-3266-b27a-7ee05ee242a3",
                        "source_sense_description": "Felis silvestris",
                        "target_lang_word": "chat sauvage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chat sauvage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "567b3320-db34-3796-9145-5e08bd0f6c52",
                                        "entry_id": "5085cfc8-766b-3867-88b6-3db108b0a561",
                                        "glosses": [
                                            "Représentant de plusieurs espèces de félins du genre Felis de taille moyenne à petite, habitant en Europe, en Asie de l’Ouest et en Afrique, notamment le chat forestier européen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdc45116-fc73-4076-b980-27d6f86e8800",
                                                "sense_id": "567b3320-db34-3796-9145-5e08bd0f6c52",
                                                "text": "L’origine du chat domestique ne pose réellement plus de problème depuis que l’on sait qu’une même espèce de chat sauvage, […]"
                                            },
                                            {
                                                "example_id": "baffee67-4497-4be7-85a5-f3a232bfcb65",
                                                "sense_id": "567b3320-db34-3796-9145-5e08bd0f6c52",
                                                "text": "– Quelqu’un avait dit, tu te rappelles, qu’elle avait parfois les yeux d’une chatte sauvage…\n– Et sur quel ton !... comme si c’était une de ses qualités les plus charmantes. Mais moi en ce temps-là, je n’avais jamais vu de chats sauvages, je n’avais observé au jardin d’acclimatation que les yeux des panthères ou des tigres. C’est eux que Véra me rappelait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f41bc09-c54b-38c3-bef6-0435e2ec42a8",
                                        "entry_id": "5085cfc8-766b-3867-88b6-3db108b0a561",
                                        "glosses": [
                                            "Chat haret ; chat domestique sans maître, ou chat issu de la descendance de chats domestiques et retourné à l’état sauvage."
                                        ],
                                        "tags": [
                                            "Usage critiqué"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf365e17-b00c-462d-9eb5-156d08bc8ebe",
                                                "sense_id": "4f41bc09-c54b-38c3-bef6-0435e2ec42a8",
                                                "text": "Nous dormîmes en bordure de départementale, seulement dérangés, vers trois heures du matin, par une bataille acharnée entre deux chats sauvages, qui devaient probablement se partager les restes de notre repas du soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37dd74a3-a78a-30e2-ab55-b003502ba14c",
                                        "entry_id": "5085cfc8-766b-3867-88b6-3db108b0a561",
                                        "glosses": [
                                            "Raton laveur."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "964c6421-c893-3e69-98f6-c6284e8f9905",
                                        "entry_id": "5085cfc8-766b-3867-88b6-3db108b0a561",
                                        "glosses": [
                                            "Lynx roux."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
