                ],
                "senses": [
                    {
                        "sense_id": "fd843918-c586-3c3d-96f8-b69e53fb4e9c",
                        "entry_id": "984082d3-94e9-3eb9-9739-ef96f7218db7",
                        "glosses": [
                            "zeer belangrijke verbinding; verbinding die van levensbelang is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2ddfd97c-e537-41b2-9394-7d8a6928a03e",
                                "sense_id": "fd843918-c586-3c3d-96f8-b69e53fb4e9c",
                                "text": "De weg die Mozambique met Zimbabwe verbindt, in de woorden van correspondent Bram Vermeulen \"de levensader van zuidelijk Afrika\", is op veel plaatsen vernield en wordt omringd door ondergelopen gebied. Mensen die voor de modder op de vlucht zijn geslagen, kamperen nu langs de weg."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1126adb-7cd9-3677-affa-5be4e4da8ce4",
                        "entry_id": "984082d3-94e9-3eb9-9739-ef96f7218db7",
                        "glosses": [
                            "iets dat van zeer groot belang is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "42118e54-fe12-4cf8-86a4-ca6b69e1280a",
                                "sense_id": "a1126adb-7cd9-3677-affa-5be4e4da8ce4",
                                "text": "En dan is er nog de jeugdopleiding, de belangrijkste levensader van de club. Liefst 33 spelers nam Stam mee naar het Oostenrijkse Scheffau Am Wilden Kaiser, onder wie veel talenten van Varkenoord. Ze zullen nodig zijn tijdens dit seizoen om, zoals het er nu naar uitziet, vooral aanvallen van AZ, Vitesse en FC Utrecht op de derde plaats af te schudden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef4c8f1b-2761-41e2-bac8-db007761b41b",
                        "source_entry_id": "984082d3-94e9-3eb9-9739-ef96f7218db7",
                        "source_sense_id": "fd843918-c586-3c3d-96f8-b69e53fb4e9c",
                        "source_sense_description": "zeer belangrijke verbinding; verbinding die van levensbelang is",
                        "target_lang_word": "lifeblood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifeblood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36633865-2115-3a11-99b3-3b45e5d8476a",
                                        "entry_id": "fed9db75-0cd7-3292-a60d-a54e49be2594",
                                        "glosses": [
                                            "Blood that is needed for continued life; blood regarded as the seat of life."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f103567-11a6-42b4-aebf-5aa515365409",
                                                "sense_id": "36633865-2115-3a11-99b3-3b45e5d8476a",
                                                "text": "[Y]ou desire his mana, yet you respect his tabu, for in you and him alike runs the common life-blood."
                                            },
                                            {
                                                "example_id": "44f88e19-08e3-4fe3-a719-a73cebe6432e",
                                                "sense_id": "36633865-2115-3a11-99b3-3b45e5d8476a",
                                                "text": "You didn't come to me in time. And by the time you came to me that fool of a doctor had bled and leeched the lifeblood out of Timmy."
                                            },
                                            {
                                                "example_id": "418e1688-f3d2-484a-928f-4ac0a3cc61ce",
                                                "sense_id": "36633865-2115-3a11-99b3-3b45e5d8476a",
                                                "text": "Beowulf's body\nwas wet with his life-blood: it came welling out."
                                            },
                                            {
                                                "example_id": "b18c84f0-8f08-4c21-8164-df5a2047db9f",
                                                "sense_id": "36633865-2115-3a11-99b3-3b45e5d8476a",
                                                "text": "It was she who stopped the lifeblood flow when Karl misswung an axe until Herta could come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                        "entry_id": "fed9db75-0cd7-3292-a60d-a54e49be2594",
                                        "glosses": [
                                            "That which is required for continued existence or function."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e29ca2-3286-41cf-8471-b7c33805c1a5",
                                                "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                                "text": "Gasoline is the lifeblood of the modern city."
                                            },
                                            {
                                                "example_id": "c2c10a43-feee-42e7-92f2-36f49ec102b9",
                                                "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                                "text": "Information is the lifeblood of the United States and the world."
                                            },
                                            {
                                                "example_id": "b2dc9fa0-89aa-489c-98b4-df65d81d79a0",
                                                "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                                "text": "The road brought invaders who left them hungry and dug up the dead. The road took living children away and made them dead to home. It was as if the roads were veins that bled off lifeblood but never pumped it back in."
                                            },
                                            {
                                                "example_id": "1aede917-c24c-4774-8059-44e4df623ee6",
                                                "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                                "text": "'We want to be able to market some of these small stations and the lifeblood lines where we currently have short trains in service.'"
                                            },
                                            {
                                                "example_id": "95a45e64-3c80-49b1-8551-1805c96e4e8f",
                                                "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                                "text": "Like most Victorian Railways, freight was the line's lifeblood."
                                            },
                                            {
                                                "example_id": "0721b8b7-b3bb-45ca-9a70-ada8fdaf0b5c",
                                                "sense_id": "c7b1a11d-b09d-3a19-a3d5-2d8c9e6b18da",
                                                "text": "The companies’ actions illustrate how online information — news stories, fictional works, message board posts, Wikipedia articles, computer programs, photos, podcasts and movie clips — has increasingly become the lifeblood of the booming A.I. industry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "835f6014-643a-4a3b-ac5e-cd28bb674239",
                        "source_entry_id": "984082d3-94e9-3eb9-9739-ef96f7218db7",
                        "source_sense_id": "fd843918-c586-3c3d-96f8-b69e53fb4e9c",
