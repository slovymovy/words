        "nl-extract.jsonl": [
            {
                "entry_id": "6efe6330-1315-3fb9-b830-7d90e09439f7",
                "word": "schimmenrijk",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a59e3072-4886-40bc-813e-1e8711f33caa",
                        "entry_id": "6efe6330-1315-3fb9-b830-7d90e09439f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "schimmenrijken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0dc49c4-7b05-3d44-b8f6-64932440533e",
                        "entry_id": "6efe6330-1315-3fb9-b830-7d90e09439f7",
                        "glosses": [
                            "het bovennatuurlijke rijk waar de doden zouden vertoeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28df859-8be2-4415-9c9f-de0c0ee5c1c7",
                                "sense_id": "d0dc49c4-7b05-3d44-b8f6-64932440533e",
                                "text": "Er moeten dingen worden besproken voor Yusuke zijn definitieve reis naar het schimmenrijk kan maken. Hij neemt Mizuki mee langs mensen die hem hebben geholpen na zijn overlijden om die verloren tijd en ervaringen te delen."
                            },
                            {
                                "example_id": "d66b18fb-30e3-41f4-a8ef-01cea153371b",
                                "sense_id": "d0dc49c4-7b05-3d44-b8f6-64932440533e",
                                "text": "We moeten de Bijbel volgens hem niet mooier maken dan die is. Van een hemelse vergoeding is in het Oude Testament niet of nauwelijks sprake. „Wie de adem uitblaast, verdwijnt in een schimmenrijk, waar niemand nog de lof van de Allerhoogste zingt. Het is een en al vergankelijkheid. De duurzaamheid is ver te zoeken.”"
                            },
                            {
                                "example_id": "a8eb0177-c44a-48c9-b36d-3e8859d2a4ca",
                                "sense_id": "d0dc49c4-7b05-3d44-b8f6-64932440533e",
                                "text": "Ik ben heel gevoelig voor zulke berichten uit het schimmenrijk. Plotseling komen al lang overleden helden alsnog tot leven en dragen bij aan ons besef deel uit te maken van een continuum. Het lijkt wel of we ze alsnog kunnen aanraken."
                            }
                        ]
                    }
                ],
