                                        "entry_id": "16bb47b7-4de2-3d5d-bf04-d7671ee9a783",
                                        "glosses": [
                                            "Vorgang, die Länge eines Gegenstandes/einer Zeiteinheit durch geeignete Maßnahmen zu verringern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f859e0cf-8931-49ad-9349-d1b719c20385",
                                                "sense_id": "f0256243-c829-310b-99ca-36f2a7027db9",
                                                "text": "Die Verkürzung der Autobahn ruft eine längere Fahrtzeit hervor."
                                            },
                                            {
                                                "example_id": "4bdae516-a769-4f74-96bf-da91b93881b2",
                                                "sense_id": "f0256243-c829-310b-99ca-36f2a7027db9",
                                                "text": "Bei Ihrer Berufserfahrung kommt auch eine Verkürzung der Ausbildungszeit in Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9522b29e-9be1-3408-90d5-e63b876a378a",
                                        "entry_id": "16bb47b7-4de2-3d5d-bf04-d7671ee9a783",
                                        "glosses": [
                                            "Benachteiligung, insbesondere in Zusammenhang mit Verträgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881d54b2-8527-4aa7-a8cf-43fa6b39d4fc",
                                                "sense_id": "9522b29e-9be1-3408-90d5-e63b876a378a",
                                                "text": "Eine Verkürzung oder Verletzung über die Hälfte liegt vor, wenn bei einem Rechtsgeschäft ein Vertragsteil weniger als die Hälfte von dem bekommt, was der andere Vertragsteil erhält."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f255dd4-a193-4e23-80f8-04f0afcf71c9",
                        "source_entry_id": "c6ef67a9-9134-3449-8d86-6f156ae61ddd",
                        "source_sense_description": "1. Fait d’abréger, de raccourcir quelque chose.",
                        "target_lang_word": "Abkürzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abkürzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                        "entry_id": "c7b09fbd-b6e8-3a03-a7af-2673d8428b25",
                                        "glosses": [
                                            "kürzerer Weg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf09644-c76f-4ee1-9b1c-132f5eab7689",
                                                "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                                "text": "Weil er eine Abkürzung nahm, war er schneller am Ziel."
                                            },
                                            {
                                                "example_id": "171aeecb-fae5-4e63-a800-f9bf11e8a918",
                                                "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                                "text": "„Als Kind war ich den Hang zu Fuß hochgekraxelt, hatte manchmal die Abkürzung über das Feld genommen, den kleinen Trampelpfad, der bei Regen zu einer Schlammpiste wurde.“"
                                            },
                                            {
                                                "example_id": "82daa2ea-6e91-45d1-a58d-61cc57bf5af5",
                                                "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                                "text": "„Beide Güter grenzten an die Alle, aber in Götzlack war der Fluss zu einem See aufgestaut, und über diesen ließ sich eine Abkürzung nehmen, mit der die überfüllten Hauptstraßen umgangen werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                        "entry_id": "c7b09fbd-b6e8-3a03-a7af-2673d8428b25",
                                        "glosses": [
                                            "verkürzte Form eines Wortes oder eines Ausdrucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4bbcc2c-3ac6-440b-a884-5d6a27d66681",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "In der englischen Sprache gibt es viele Abkürzungen."
                                            },
                                            {
                                                "example_id": "9ce06fc5-83a4-4843-86f7-0f128bd45483",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Bus“ ist eine Abkürzung für (seltener: von) „Autobus“."
                                            },
                                            {
                                                "example_id": "fdeb45ab-9fb4-4b7f-8feb-427e4d9dcdba",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Man hat in angelsächsischen Ländern einen besonderen Sinn für Wortspiele, sogenannte ‚puns‘, und macht sich seit jeher einen Spaß daraus, immer neue Abkürzungen zu erfinden…“"
                                            },
                                            {
                                                "example_id": "eb5a3c1c-9e3f-4f89-80ea-4b2fba548730",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Die Nachrichten, die wir gegenseitig verfassen, sind zumeist kurz, oft sehr kurz, und missverständlich, oft in falscher Interpunktion und mit kruden Abkürzungen, ohne Kommata und Bindestriche, ohne Frage- und Ausrufezeichen.“"
                                            },
                                            {
                                                "example_id": "be4928a6-a096-4c04-a704-1054981a7385",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Das nimmt die Abkürzungen der Kurzschrift, der Stenographie teilweise vorweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                        "entry_id": "c7b09fbd-b6e8-3a03-a7af-2673d8428b25",
                                        "glosses": [
                                            "nur schriftsprachliche Verkürzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c1ca5b-d195-405d-82ba-b46d62cbfa91",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "Rein schriftsprachliche Abkürzungen sind Formen wie „ca.“, „etc.“, „usw.“, die nicht auch als solche gesprochen werden."
                                            },
                                            {
                                                "example_id": "7402bf87-41ed-42bd-aa8d-aedb408fd142",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "„Bis auf Feuilleton und Wochenendbeilage gibt es keinen Ressortteil, in dem nicht mit Abkürzungen gearbeitet wird.“"
                                            },
                                            {
                                                "example_id": "cb1aa4d0-f09a-4be9-9e80-ee444681b459",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "„Aufgelistet sind hier auch die Abkürzungen, die wir im Wörterbuch verwenden, und die wichtigsten grammatischen Fachausdrücke mit einer kurzen Erklärung.“"
                                            },
                                            {
                                                "example_id": "59744a91-8698-4e8d-9488-24f3643a0c40",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "„Er war auf bläuliches Papier geschrieben und zeigte die grossen, länglichen Buchstaben des alten Fürsten und die charakteristischen Abkürzungen, deren er sich zu bedienen pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
