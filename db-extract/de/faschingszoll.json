                "senses": [
                    {
                        "sense_id": "7efe935a-90b5-3471-9813-d2d71043956e",
                        "entry_id": "1a55b327-f769-33fb-864c-24e7f6b37c64",
                        "glosses": [
                            "meist an Faschingsdienstag durch Kinder ausgeführter Schabernack mithilfe einer von Holzlatten oder Seilen abgesperrte Straße, um Autofahrern zur Abgabe von Süßigkeiten oder Münzgeld zu bewegen"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "00a4acc1-812b-4864-a7b1-9caddc8e46fb",
                                "sense_id": "7efe935a-90b5-3471-9813-d2d71043956e",
                                "text": "„Sie verlangen sodann einen Faschingszoll, womit sie häufig auch Erfolg haben und oftmals beachtliche Einnahmen erzielen.“"
                            },
                            {
                                "example_id": "e517a985-a32a-45dd-a193-b54f01aaaea7",
                                "sense_id": "7efe935a-90b5-3471-9813-d2d71043956e",
                                "text": "„Mancherorts hat sich zu Fasching bei Kindern der sogenannte Faschingszoll eingebürgert.“"
                            },
                            {
                                "example_id": "e8ae1fc0-d9b8-43ac-b341-3552e034fd7b",
                                "sense_id": "7efe935a-90b5-3471-9813-d2d71043956e",
                                "text": "„Immer mehr Kids verlangen von Autofahrern jedoch „Faschingszoll“.“"
                            },
                            {
                                "example_id": "e6ea0c4a-fb85-4571-8ec1-6421602436f8",
                                "sense_id": "7efe935a-90b5-3471-9813-d2d71043956e",
                                "text": "„\"Faschingszoll!\" steht auf den Schildern der Kinder, die die Autofahrer dazu bewegen sollen, sich mit Bonbons oder Geld die Weiterfahrt zu erkaufen.“"
                            },
                            {
                                "example_id": "9f10f8ec-9402-4ff4-98e4-efca7e31624c",
                                "sense_id": "7efe935a-90b5-3471-9813-d2d71043956e",
                                "text": "„Das Beitreiben von „Faschingszoll“ durch Kinder in der Faschingswoche ist als Phänomen seit einigen Jahren zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
