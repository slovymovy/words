                "senses": [
                    {
                        "sense_id": "70c82e40-a642-3837-8bfa-2c0c27e30c2f",
                        "entry_id": "aae80d5a-9a22-3be6-b1db-d9aaf3af9d1c",
                        "glosses": [
                            "weibliche Person, die für sexuelle Zwecke missbraucht wird (entweder im Rollenspiel oder gegen ihren Willen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c90d1aa-1f52-488c-90f7-32d2b1fa5d61",
                                "sense_id": "70c82e40-a642-3837-8bfa-2c0c27e30c2f",
                                "text": "„Sechs Männer und Frauen sollen eine 20 Jahre alte Französin mehr als einen Monat lang als Sexsklavin eingesperrt und misshandelt haben.“"
                            },
                            {
                                "example_id": "363aed7e-33a7-47ff-adb1-bd607e05cd01",
                                "sense_id": "70c82e40-a642-3837-8bfa-2c0c27e30c2f",
                                "text": "„Nach Angaben der Menschenrechtsorganisation Amnesty International wurden hunderte, wenn nicht tausende jesidische Frauen als Ehefrauen an Dschihadisten verkauft oder als Sexsklavinnen unterjocht.“"
                            },
                            {
                                "example_id": "56c04841-dfdc-4474-930c-0fec09b3ae11",
                                "sense_id": "70c82e40-a642-3837-8bfa-2c0c27e30c2f",
                                "text": "„Eine Frau hat vor einem US-Gericht ausgesagt, sie wäre als minderjährige Sexsklavin mehrfach zum Verkehr mit Prinz Andrew gezwungen worden, berichten englische Medien übereinstimmend.“"
                            },
                            {
                                "example_id": "03da7d49-6b05-427d-a196-b782d1123487",
                                "sense_id": "70c82e40-a642-3837-8bfa-2c0c27e30c2f",
                                "text": "„Sie machten die Mädchen zu Sexsklavinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
