                        "examples": [
                            {
                                "example_id": "533ff677-3396-4154-8c1e-800ebfb3233b",
                                "sense_id": "a600615d-2e44-392c-abb5-ad460fd1d0f1",
                                "text": "Gemeinsamkeiten bestehen in der Aufwertung von Mahlzeiten, Unterschiede in der gesellschaftlichen Funktion sowie bei introspektiven und oenophilen Motiven."
                            },
                            {
                                "example_id": "dc6779f6-0424-4580-b09b-25a373b2fc3d",
                                "sense_id": "a600615d-2e44-392c-abb5-ad460fd1d0f1",
                                "text": "Er hatte dem anspruchsvollen Gaumen Jack Coakleys genügen sollen, der in den letzten Jahren zum Weinkenner geworden war und sich als oenophil bezeichnete, ein Begriff, den sie noch nie gehört hatte."
                            },
                            {
                                "example_id": "0fdde924-9b6c-4fd4-b9af-68d5c09fae5e",
                                "sense_id": "a600615d-2e44-392c-abb5-ad460fd1d0f1",
                                "text": "Ist das Leben auch mal schlecht oder mal mieser,\nretten wird dich, bist du oenophil, der Portugieser.\nRotes Gold in der Flasche, aber auch schon in der Kelter\nÜberall spürst du die Macht vom Dornfelder."
                            }
                        ]
                    }
