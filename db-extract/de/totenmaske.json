                                        "entry_id": "a5821680-4e43-3b51-940f-d9806f933475",
                                        "glosses": [
                                            "een afgietsel van het gelaat van een dood persoon, gewoonlijk gemaakt van was of gips"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e5214d-0cc3-4a82-b1c8-5760a1201daf",
                                                "sense_id": "65f90dd7-6dcb-32c0-9dde-1eabe72a85c7",
                                                "text": "Weintraub met zijn doodse gezicht, een dodenmasker, wasachtig, zo grauw en uitdrukkingsloos dat de andere aanwezigen er naar van worden en/of beginnen te twijfelen of ze misschien de timmerman moeten roepen voor kist nummer twee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8829fc8c-318f-3a46-9e8e-47c2e5f85660",
                                        "entry_id": "a5821680-4e43-3b51-940f-d9806f933475",
                                        "glosses": [
                                            "een (kunst)voorwerp dat het gelaat van een dode bedekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a31d87c-7312-4824-9147-aba87a3f7061",
                                                "sense_id": "8829fc8c-318f-3a46-9e8e-47c2e5f85660",
                                                "text": "Het gouden dodenmasker van de Egyptische farao Toetanchamon is weer te zien voor het publiek. Bij een schoonmaakbeurt was de sik van het masker afgebroken"
                                            }
                                        ]
                                    }
                                ]
                            }
