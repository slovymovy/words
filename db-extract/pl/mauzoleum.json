                        "entry_id": "04b40d04-82e9-312c-99c7-3bea7907a3f2",
                        "glosses": [
                            "monumentalny grobowiec, przeważnie osobna budowla pełniąca taką funkcję"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec39280-7079-493a-a0ff-e655e0208579",
                                "sense_id": "ea07ca38-ac07-38e0-91bc-1a757af28710",
                                "text": "Atrakcją wycieczki była wizyta w mauzoleum Lenina."
                            },
                            {
                                "example_id": "bea72225-fe70-4d95-9ac0-293c91a10b91",
                                "sense_id": "ea07ca38-ac07-38e0-91bc-1a757af28710",
                                "text": "Göring kazał przenieść ją do ocynkowanej trumny i pochować w lesie, a mauzoleum wysadzić w powietrze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
