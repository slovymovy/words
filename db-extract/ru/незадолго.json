                    {
                        "translation_id": "e458a211-44e8-453a-a334-32ce90742ff1",
                        "source_entry_id": "d15db417-9e5b-3b86-896d-89f05fb87e6a",
                        "source_sense_id": "e925375e-0c95-3f60-9e58-00285f3f5c61",
                        "target_lang_word": "kürzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kürzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                        "entry_id": "fe806816-7fde-380b-9df3-c55e26610838",
                                        "glosses": [
                                            "vor kurzem, vor Kurzem, vor nicht langer Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9798e141-4e52-483a-a88e-615373b72961",
                                                "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                                "text": "Das Buch ist kürzlich erschienen."
                                            },
                                            {
                                                "example_id": "db967591-cdf4-4dc4-b95f-a38c05b24275",
                                                "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                                "text": "„Vor dem Hintergrund des kürzlich großangelegten Konzernumbaus sollen 11.600 Stellen gestrichen werden, um die Kosten um eine Milliarde zu senken.\""
                                            },
                                            {
                                                "example_id": "80265ff5-63bd-4210-9555-fff05b4e8265",
                                                "sense_id": "5c0e8afb-771f-31b8-8be5-d3bb64ef3d00",
                                                "text": "„Zudem wird ihn Extremkletterer Stefan Glowacz, kürzlich Gast beim Nationalteam, gewarnt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "kürzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                        "entry_id": "5887f37c-e711-3070-b629-d4e83dd4828f",
                                        "glosses": [
                                            "vor Kurzem, vor nicht langer Zeit erfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43484b4-d4f8-4824-b7b0-d8934af3ea75",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Als Ursache für diese IgM-Antikörper bei klinisch unauffälligen schwangeren Frauen kommen uncharakteristische kürzliche akute bzw. länger zurückliegende Infektionen, kürzliche bzw. länger zurückliegende Impfungen, Reinfektionen nach früherer Impfung und langpersistierende IgM-Antikörper nach früherer Infektion oder Impfung bzw. kreuzreagierende IgM-Antikörper in Betracht.“"
                                            },
                                            {
                                                "example_id": "4aeba35d-2e63-4184-b495-3b62d561b386",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„In anderen Fächergruppen, wie Pädagogik, Gesundheit und Sozialwesen sowie Geisteswissenschaften und Künste, nimmt der Anteil der Frauen zwischen Master- und Promotionsbildungsgängen zwar ab, dennoch bilden Frauen immer noch die Mehrzahl der kürzlichen Absolventen von Promotionsbildungsgängen.“"
                                            },
                                            {
                                                "example_id": "7d6f2811-2479-432f-8db6-590616d780f2",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Falls kürzlicher Krankheitsbeginn, sollte zur Verlaufskontrolle eine weitere Blutprobe untersucht werden.“"
                                            },
                                            {
                                                "example_id": "69475a3b-3ccb-4839-a247-3cdbbd0b6e02",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Nun ist aber das Trennungs-Gesetz für die Kirche unannehmbar, und es ist klar, daß Herrn Briand’s kürzliches Rundschreiben ebenso wie seine beiden früheren Zirkulare sich nicht auf öffentlichen Gottesdienst beziehen können; […]“"
                                            },
                                            {
                                                "example_id": "bac9249d-fe08-4f4a-8221-17f476f62f60",
                                                "sense_id": "287a2ed8-2874-3c7e-9da1-0166a2f3d6bb",
                                                "text": "„Man warf ihm vor, er schlage Kapital aus Landrys kürzlichem Tod, und lachte nur über die Versicherungen tiefster Zuneigung zu Landry, die Somés Sprecher an seiner statt abgab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
