                    "sense_id": "b6209be0-f90c-3331-96da-ab4387829440",
                    "sense_definition": "Se dit d'une route ou d'un chemin très abîmé, raviné ou plein de trous.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "detruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les violentes pluies, la voiture avançait très lentement sur cette route <w>défoncée</w>.",
                            "target_lang_translations": {
                                "en": "After the heavy rain, the car was creeping along this <w>potholed</w> road.",
                                "ru": "После сильных дождей машина очень медленно ползла по этой <w>разбитой</w> дороге.",
                                "de": "Nach den heftigen Regenfällen kam das Auto auf dieser <w>ausgefahrenen</w> Straße nur sehr langsam voran.",
                                "es": "Tras las fuertes lluvias, el coche avanzaba muy despacio por esta carretera <w>bacheada</w>.",
                                "zh": "暴雨过后，汽车在这条<w>坑洼</w>的路上行驶得非常缓慢。"
                            }
                        },
                        {
                            "text": "Les cyclistes ont dû faire demi-tour à cause d'un chemin <w>défoncé</w> par les engins.",
                            "target_lang_translations": {
                                "en": "The cyclists had to turn back because of a <w>rutted</w> track damaged by heavy machinery.",
                                "ru": "Велосипедистам пришлось повернуть назад из-за дороги, <w>разбитой</w> тяжёлой техникой.",
                                "de": "Die Radfahrer mussten wegen eines von schweren Maschinen <w>ausgefahrenen</w> Weges umkehren.",
                                "es": "Los ciclistas tuvieron que dar media vuelta a causa de un camino <w>destrozado</w> por la maquinaria pesada.",
                                "zh": "骑车的人因为一条被重型机械碾得<w>破损</w>的小路，不得不掉头返回。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "route défoncée",
                        "chemin défoncé"
                    ],
                    "target_lang_definitions": {
