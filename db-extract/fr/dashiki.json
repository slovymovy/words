                "senses": [
                    {
                        "sense_id": "a86c7799-3740-307c-b46e-8cd19437e2b2",
                        "entry_id": "6a654b59-ae57-38db-8a88-f175c23014e3",
                        "glosses": [
                            "Chemise ample, colorée et ornementée, traditionnellement portée en Afrique de l’Ouest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d17cbae0-3bc1-405d-a77f-9d6bd79e199a",
                                "sense_id": "a86c7799-3740-307c-b46e-8cd19437e2b2",
                                "text": "Les boubous, les dashikis, les bonnets en kente sont présents à toutes les réunions afrocentristes (familiales, amicales ou professionnelles)."
                            },
                            {
                                "example_id": "4b7494cd-3b03-4b5a-86ec-54204607d48b",
                                "sense_id": "a86c7799-3740-307c-b46e-8cd19437e2b2",
                                "text": "Les symboles ostentatoires « africains » tels le kente (tissu en provenance du Ghana) ou le dashiki n’ont guère leur place dans le discours bien pensant de la bourgeoisie noire."
                            },
                            {
                                "example_id": "47ca15c8-6039-488d-94cb-96ed98e42918",
                                "sense_id": "a86c7799-3740-307c-b46e-8cd19437e2b2",
                                "text": "Au cours des années 1970, dans le domaine vestimentaire, par exemple, la mode du « natural look » s’est emparée de la communauté noire (amulettes, dashikis, coupe « afro »)."
                            }
                        ]
                    }
                ],
