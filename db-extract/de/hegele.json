                ],
                "senses": [
                    {
                        "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                        "entry_id": "dae77840-d758-3e89-9e6a-f5651d9846ae",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c42553-9546-4294-9c43-b71d737b53b0",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Frau Hegele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b7727ed3-b6ce-4225-83b9-f2a67fe58754",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Herr Hegele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3bbfd355-62e0-4b4a-ba47-2c5a7d7b003b",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Die Hegeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "334fd372-07fe-48cf-aca5-e8cd5f599e65",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Der Hegele trägt nie die Pullover, die die Hegele ihm strickt."
                            },
                            {
                                "example_id": "3fa58515-071c-40ed-9113-561e639add2e",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hegele kommt, geht der Herr Hegele.“"
                            },
                            {
                                "example_id": "333e3187-ab28-4383-b752-56a17a508170",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Hegele kommt und geht."
                            },
                            {
                                "example_id": "b86f1f57-b6a1-4170-a633-0b27b61f136d",
                                "sense_id": "9bc30e37-6fdf-3f4e-9f63-d69c48378502",
                                "text": "Hegeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
