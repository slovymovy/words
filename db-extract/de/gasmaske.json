                        ],
                        "form": "die Gasmaske"
                    },
                    {
                        "form_id": "997dbcbe-c0a6-41fe-8951-258054ca6563",
                        "entry_id": "3df33d73-e08b-3ee9-9e1b-0ca41a5986d4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gasmasken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                        "entry_id": "3df33d73-e08b-3ee9-9e1b-0ca41a5986d4",
                        "glosses": [
                            "Maske, die vor dem Gesicht getragen wird und vor giftigen Gasen schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f975fd7-94f4-4a03-8c6e-842eb946f9a3",
                                "sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                                "text": "Im Krieg spielen Gasmasken eine große Rolle."
                            },
                            {
                                "example_id": "caf0f0ea-a4dc-4c1d-bf71-3df151cf1b7d",
                                "sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                                "text": "„Mein Kopf brummt und dröhnt in der Gasmaske, er ist nahe am Platzen.“"
                            },
                            {
                                "example_id": "27741b72-5a2d-4374-ad7f-5553bf59cd76",
                                "sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                                "text": "„Er hängte sich die Gasmaske um, und wir liefen hinaus.“"
                            },
                            {
                                "example_id": "29c9c48d-3be1-4522-918e-6239a6c87af6",
                                "sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                                "text": "„Bei allen Beförderungen von Stoffen der Rn. 2601 Ziffer 31a) ADR muß das Fahrzeug oder der Tank an jeder Seite den Hinweis tragen, daß beim Auslaufen der Flüssigkeit größte Vorsicht geboten ist und sich niemand dem Fahrzeug ohne Gasmaske, Handschuhe und Stiefel aus Gummi oder geeignetem Kunststoff nähern darf.“"
                            },
                            {
                                "example_id": "e1cfaf95-41fb-4183-96e7-1e6c2d281eb9",
                                "sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                                "text": "„Auf dem Weg sehen wir einen Winzer auf einem kleinen Traktor, der mit einer Gasmaske über dem Gesicht durch die Fläche zwischen den Rebstöcken fährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae165ef5-8308-43a3-89c2-d11ce92d736e",
                        "source_entry_id": "3df33d73-e08b-3ee9-9e1b-0ca41a5986d4",
                        "source_sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                        "source_sense_description": "Maske, die vor dem Gesicht getragen wird und vor giftigen Gasen schützen soll",
                        "target_lang_word": "gas mask",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gas mask",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0f9f147-2f37-3122-a77b-876b2ee646eb",
                                        "entry_id": "536a6a18-1e7f-3654-80b4-7a17ab76a823",
                                        "glosses": [
                                            "A covering for the face with a filter to protect the user from poison gas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ebb6dc-9ace-4d6c-b774-effd3d667349",
                                                "sense_id": "e0f9f147-2f37-3122-a77b-876b2ee646eb",
                                                "text": "If we bang or scream they will spray us with some pepper or something else that's in an aeresol ^([sic]) can, and they wear gas masks, while the rest of us have to breathe the fumes in, and it makes us very sick and they refuse us medical treatment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f45c47c1-4866-40f2-a1ed-c485ea2f61ac",
                        "source_entry_id": "3df33d73-e08b-3ee9-9e1b-0ca41a5986d4",
                        "source_sense_id": "4b755c4e-b0c5-32e2-a65d-15ad02f9bde9",
                        "source_sense_description": "Maske, die vor dem Gesicht getragen wird und vor giftigen Gasen schützen soll",
                        "target_lang_word": "masque à gaz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masque à gaz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d26c5d50-3f35-3273-a75a-5bb5a4d3981c",
                                        "entry_id": "0f36e09c-9ee2-3fca-afe8-b44ce3ee3398",
                                        "glosses": [
                                            "Protection qui recouvre le visage permettant de se protéger de certaines armes chimiques et armes biologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103dc7da-ed78-42a6-9fee-646b71819362",
                                                "sense_id": "d26c5d50-3f35-3273-a75a-5bb5a4d3981c",
                                                "text": "Il est intégralement nu. Il porte simplement une baïonnette à une ceinture et un masque à gaz. Rien d’autre. Le masque à gaz dissimule ses traits mais pas ses yeux. Et son regard brûle mes rétines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
