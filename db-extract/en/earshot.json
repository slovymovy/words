                "senses": [
                    {
                        "sense_id": "22b56d0a-1cf5-35ea-a2f0-919b794a9c14",
                        "entry_id": "fe2dbd69-5155-36b4-854c-98e58c69469b",
                        "glosses": [
                            "A distance from which sound is still audible."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fadb9c2d-2a5b-457b-ae2b-c493936e37e3",
                                "sense_id": "22b56d0a-1cf5-35ea-a2f0-919b794a9c14",
                                "text": "I'll row out on the lake but stay within earshot."
                            },
                            {
                                "example_id": "b1258bd5-6270-43a0-9ada-58c94507ed3b",
                                "sense_id": "22b56d0a-1cf5-35ea-a2f0-919b794a9c14",
                                "text": "Loola glances about her to make sure that nobody is within earshot, then speaks at last almost in a whisper."
                            },
                            {
                                "example_id": "7df624dd-4f3d-47e9-a40b-8e0af33e60f2",
                                "sense_id": "22b56d0a-1cf5-35ea-a2f0-919b794a9c14",
                                "text": "Ananda hit the target, an iron drum, from a distance of two earshots. Devadatta, from a distance of four earshots, Sundarananda from a distance of six earshots, and Dandapani [found his target] from one league."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb352393-2521-483d-9566-34a87518ed1f",
                        "source_entry_id": "fe2dbd69-5155-36b4-854c-98e58c69469b",
                        "source_sense_id": "22b56d0a-1cf5-35ea-a2f0-919b794a9c14",
