                        ],
                        "form": "die Kuscheldecke"
                    },
                    {
                        "form_id": "06a1bc05-b208-4c57-88ae-a2fea38732ee",
                        "entry_id": "5e4ceb47-787f-3546-9196-efa6cafd9541",
                        "tags": [
                            "accusative",
