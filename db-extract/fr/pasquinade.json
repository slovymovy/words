                                    {
                                        "sense_id": "fe2a7830-27d2-3653-8919-26228604a30b",
                                        "entry_id": "3231576a-3ecb-3af1-8185-b1cb0dd81f39",
                                        "glosses": [
                                            "anonyme/pseudonyme Schmäh-, Spottschrift"
                                        ],
