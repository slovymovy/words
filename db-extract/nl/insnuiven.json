                "senses": [
                    {
                        "sense_id": "ecac4662-3e39-3fad-a634-b6f0c13d9302",
                        "entry_id": "03136d69-02b7-322f-adeb-69677ef74d40",
                        "glosses": [
                            "luidruchtig met kracht via de neus ademen en ruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4814b280-d9f8-436f-ad03-f1b8ed11b4eb",
                                "sense_id": "ecac4662-3e39-3fad-a634-b6f0c13d9302",
                                "text": "Er zijn Amsterdammers die dagelijks tweemaal 't IJ over moeten en daarvoor vreselijke ontberingen moeten doorstaan. Op een bootje stappen líjkt leuk, maar als verloederd slachtvee ingeladen worden en dan elkaars ochtendadem insnuiven terwijl je een plekje probeert te bemachtigen is misère van mythische proporties."
                            },
                            {
                                "example_id": "bb4baa51-1433-4c91-b497-ea0a9c23f408",
                                "sense_id": "ecac4662-3e39-3fad-a634-b6f0c13d9302",
                                "text": "Snot terug insnuiven is A-okay. Zakdoeken are for wussies."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c4e4ce0-82cd-3b14-b6c5-fdf339edbd73",
                        "entry_id": "03136d69-02b7-322f-adeb-69677ef74d40",
                        "glosses": [
                            "ergens heel uitdrukkelijk mee in contact komen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a66ad596-8857-4b45-b2f4-06918b571570",
                                "sense_id": "4c4e4ce0-82cd-3b14-b6c5-fdf339edbd73",
                                "text": "Wie zelf nog redelijk beschermd leeft in de biblebelt, eigenlijk alleen maar familie en kennissen heeft die min of meer gelijk denken en dan ook nog een werkkring binnen de reformatorische sfeer heeft, die denkt veelal nog in de context van de verzuilde samenleving en heeft zelfs vanuit een dorpssituatie nogal eens gestalten van een gereformeerde natie voor ogen. Maar voor onze leerlingen die dagelijks Rotterdam en veel wat daarbij hoort insnuiven, is dat niet meer de echte wereld. En zij willen horen hoe ze daar als christen hebben te leven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50610585-b69d-49d5-809b-c314c6f55aa5",
