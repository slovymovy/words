                                "target_senses": [
                                    {
                                        "sense_id": "e8e6feda-e78f-34f1-815a-d19a114b39dd",
                                        "entry_id": "902a7930-a80f-38a0-82e4-e4880c6e21cc",
                                        "glosses": [
                                            "A colourless crystalline compound, 2-hydroxy-1,2,3-propanetricarboxylic acid, C₆H₈O₇, found in citrus fruit; it is used as a food additive and in the manufacture of citrates."
                                        ],
                                        "tags": [
