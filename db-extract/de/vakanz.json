                ],
                "senses": [
                    {
                        "sense_id": "e2b010a6-cc4f-34bf-a41e-335502a7f883",
                        "entry_id": "b964b7c1-4b8e-3b9f-927c-2b7051a8b121",
                        "glosses": [
                            "Zustand des Nichtbesetztseins eines Amtes oder einer Arbeitsstelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc5103f-6368-4fa9-9e83-a194de242f83",
                                "sense_id": "e2b010a6-cc4f-34bf-a41e-335502a7f883",
                                "text": "Nach dreimonatiger Vakanz wurde der Posten des Personalleiters endlich wieder besetzt."
                            },
                            {
                                "example_id": "26b50451-4759-48fc-ae83-714ad2eb2336",
                                "sense_id": "e2b010a6-cc4f-34bf-a41e-335502a7f883",
                                "text": "„Da bei Vakanz einer Schulleiterstelle wohl erfahrungsgemäß Lehrer aus dieser Schule als Bewerber in Frage kommen, darunter auch der meist bestellte prov. Leiter, wird dieser regelmäßig befangen sein, einen Bewährungsbericht oder eine Leistungsfeststellung abzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05eff278-3cbf-3d8e-ba84-0ccdbb5457b5",
                        "entry_id": "b964b7c1-4b8e-3b9f-927c-2b7051a8b121",
                        "glosses": [
                            "unbesetztes Amt oder Arbeitsstelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5f2993-495d-4db4-b666-b6853f7caad5",
                                "sense_id": "05eff278-3cbf-3d8e-ba84-0ccdbb5457b5",
                                "text": "„Der betrachtete Arbeitslose hat bei gegebenen Vakanzen eine geringere Wahrscheinlichkeit, einen vakanten Arbeitsplatz zu besetzen und aus der Unterbeschäftigung auszutreten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c8bb539-4969-4f20-b371-eaeda2574766",
                        "source_entry_id": "b964b7c1-4b8e-3b9f-927c-2b7051a8b121",
                        "source_sense_id": "e2b010a6-cc4f-34bf-a41e-335502a7f883",
                        "source_sense_description": "Zustand des Nichtbesetztseins eines Amtes oder einer Arbeitsstelle",
                        "target_lang_word": "vacancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc52ac25-d43c-37bf-b3d2-cc82d6325cba",
                                        "entry_id": "814ae55a-cfb7-3587-bf5d-db673328df4a",
                                        "glosses": [
                                            "An unoccupied position or job."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1829fa31-f068-4913-9b4d-1954c4d06dc2",
                                                "sense_id": "bc52ac25-d43c-37bf-b3d2-cc82d6325cba",
                                                "text": "Whenever there is a vacancy in the office of the Vice President, the President shall nominate a Vice President who shall take office upon confirmation by a majority vote of both Houses of Congress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4385b27-2ee1-32a1-9baa-baa2c1b66374",
                                        "entry_id": "814ae55a-cfb7-3587-bf5d-db673328df4a",
                                        "glosses": [
                                            "An available room in a hotel; guest house, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ba3f90b-e2ce-3b23-9497-a65d41698879",
                                        "entry_id": "814ae55a-cfb7-3587-bf5d-db673328df4a",
                                        "glosses": [
                                            "Empty space."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c4d89a-a7e5-49dd-bd3d-71909793061e",
                                                "sense_id": "0ba3f90b-e2ce-3b23-9497-a65d41698879",
                                                "text": "Sky was set above earth, land ringed with sea, / Chaos retired to its own vacancy …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76a18cea-9271-3336-aad6-c605f10347f2",
                                        "entry_id": "814ae55a-cfb7-3587-bf5d-db673328df4a",
                                        "glosses": [
                                            "A blank mind, unoccupied with thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1cb4c8c-bf6f-4ef9-9df9-5bf91e381eed",
                                                "sense_id": "76a18cea-9271-3336-aad6-c605f10347f2",
                                                "text": "...—who has not looked back to the past with that passion of hopelessness, which deems that life can never more be what it has been,—with a consciousness that the dearer emotions are exhausted, while in their place have arisen but vacancy and weariness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b626cc-eb51-3249-ab16-880cd78d81dc",
                                        "entry_id": "814ae55a-cfb7-3587-bf5d-db673328df4a",
                                        "glosses": [
                                            "Lack of intelligence or understanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
