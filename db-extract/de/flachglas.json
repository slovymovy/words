                        ],
                        "examples": [
                            {
                                "example_id": "b65ed271-8eb7-4f83-926a-afd19530205f",
                                "sense_id": "a4aa9621-3617-391b-8370-2598f8bb7549",
                                "text": "Heute ist der Großteil des Flachglases im Floatprozess erzeugtes Floatglas."
                            },
                            {
                                "example_id": "f9b3c183-2d05-4d40-95cc-5f780a6c47da",
                                "sense_id": "a4aa9621-3617-391b-8370-2598f8bb7549",
                                "text": "In Bezug auf Solarglas nennt der Analyst nun erstaunliche Zahlen: Im vergangenen Jahr habe die Solarindustrie 31 Millionen Quadratmeter Flachglas und damit weniger als ein Prozent der weltweiten Produktion verbraucht."
                            }
                        ],
