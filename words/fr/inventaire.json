{
    "word_family": [
        "inventorier",
        "inventoriable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd544d60-a18e-3289-ab74-507ae29dbd5c",
                    "sense_definition": "Liste détaillée et méthodique d'objets, de biens ou de marchandises.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conservateur du musée a terminé l'<w>inventaire</w> des tableaux anciens."
                        },
                        {
                            "text": "Nous avons dressé un <w>inventaire</w> complet de tout le matériel avant le déménagement."
                        }
                    ],
                    "synonyms": [
                        "catalogue",
                        "dénombrement",
                        "liste",
                        "répertoire"
                    ],
                    "common_phrases": [
                        "faire un inventaire",
                        "dresser un inventaire",
                        "inventaire à la Prévert"
                    ]
                },
                {
                    "sense_id": "2f6ee133-1228-3771-87ac-fa7a35d5d1c6",
                    "sense_definition": "Opération périodique de comptage et de vérification des marchandises en réserve ou en magasin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comptage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le supermarché sera exceptionnellement fermé lundi en raison de l'<w>inventaire</w> annuel."
                        },
                        {
                            "text": "Toute l'équipe participe à l'<w>inventaire</w> pour vérifier les stocks disponibles."
                        }
                    ],
                    "synonyms": [
                        "pointage",
                        "recensement"
                    ],
                    "common_phrases": [
                        "faire l'inventaire",
                        "fermeture pour inventaire",
                        "inventaire de fin d'année"
                    ]
                },
                {
                    "sense_id": "7471782f-a0f0-34d7-a364-95ffd50a9dae",
                    "sense_definition": "Acte notarié ou juridique qui énumère et estime les biens d'une personne, notamment lors d'une succession.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire a procédé à l'<w>inventaire</w> des biens du défunt en présence des héritiers."
                        },
                        {
                            "text": "L'<w>inventaire</w> de la succession a permis de régler le litige familial sans conflit."
                        }
                    ],
                    "common_phrases": [
                        "inventaire après décès",
                        "bénéfice d'inventaire"
                    ]
                },
                {
                    "sense_id": "76f72847-0e1d-31b3-a64d-10e50b3b0aab",
                    "sense_definition": "Recensement méthodique et exhaustif d'éléments appartenant à un domaine particulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recensement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les biologistes réalisent un vaste <w>inventaire</w> des oiseaux migrateurs dans cette réserve naturelle."
                        },
                        {
                            "text": "Ce guide propose un <w>inventaire</w> des monuments historiques de toute la région."
                        }
                    ],
                    "synonyms": [
                        "recensement",
                        "relevé"
                    ],
                    "common_phrases": [
                        "inventaire des espèces",
                        "inventaire du patrimoine"
                    ]
                },
                {
                    "sense_id": "aa40802f-1777-3e19-8f02-ac6bb98081e0",
                    "sense_definition": "Examen critique et appréciation globale d'une situation morale, politique ou intellectuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bilan_critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la défaite électorale, le parti a engagé un <w>inventaire</w> critique de ses engagements passés."
                        },
                        {
                            "text": "L'historien dresse un <w>inventaire</w> lucide des réussites et des échecs de cette période."
                        }
                    ],
                    "synonyms": [
                        "bilan",
                        "état des lieux"
                    ],
                    "common_phrases": [
                        "droit d'inventaire",
                        "inventaire critique"
                    ]
                },
                {
                    "sense_id": "56ce209c-8dae-385a-9ce4-5561a34c11e3",
                    "sense_definition": "Recensement des biens des églises effectué par l'État français en 1906, provoquant de vives contestations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La crise des <w>inventaires</w> a suscité de vives tensions entre l'Église et la République."
                        },
                        {
                            "text": "Les agents chargés des <w>inventaires</w> ont souvent trouvé les portes des paroisses fermées."
                        }
                    ],
                    "common_phrases": [
                        "querelle des inventaires"
                    ]
                }
            ]
        }
    ]
}