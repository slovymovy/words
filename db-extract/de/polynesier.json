                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8f394b-a918-3bcb-aaed-322421b67917",
                                        "entry_id": "8ece3102-ad31-31a4-a06d-f75bb268ec5d",
                                        "glosses": [
                                            "A person from Polynesia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c353182e-fcbd-41dd-84c9-051851d29ad9",
                                                "sense_id": "7a8f394b-a918-3bcb-aaed-322421b67917",
                                                "text": "He felt having a Micronesian navigator meant he needed a pureblooded Polynesian, preferably a Hawaiian, as captain."
                                            },
                                            {
                                                "example_id": "f4b79f52-0c31-4571-a0bf-03224f987c8d",
                                                "sense_id": "7a8f394b-a918-3bcb-aaed-322421b67917",
                                                "text": "Blackbirding was the euphemism given to the slave-trading that occurred in the Pacific from the mid-1800s through to the early-1900s. According to one study, blackbirding, [as] “the practice of luring Melanesians and Polynesians to toil for next to nothing was called”, involved upwards of 60,000 people between 1863 and 1904 (Horne, 2007, p. 2)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Polynesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d58cd3ec-911a-35f1-9cf8-e6b61bc40517",
                                        "entry_id": "165d95e3-8013-30d7-879a-f3977a67744b",
                                        "glosses": [
                                            "A language group spoken by these people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
