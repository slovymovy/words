                "senses": [
                    {
                        "sense_id": "ddee5435-a08b-3fa4-9201-240d0ab0c2df",
                        "entry_id": "4298c79c-713a-33b1-a02d-579e569fbb4e",
                        "glosses": [
                            "Insecte coléoptère carnivore et nageur, de forme ovale et aplatie, vivant dans les eaux stagnantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a187dae-d26a-4246-8afc-23c6ab596b10",
                                "sense_id": "ddee5435-a08b-3fa4-9201-240d0ab0c2df",
                                "text": "Des insectes végétariens, tels que les Melonlonthiens n'ont pas de trace de lipase, alors que les Dytiques, les Carabes, ont une diastase lipasique très abondante."
                            },
                            {
                                "example_id": "058e12ee-a850-46a5-b406-70a9cab34e16",
                                "sense_id": "ddee5435-a08b-3fa4-9201-240d0ab0c2df",
                                "text": "Des Dytiques montaient des profondeurs de l’étang pour prendre un sou d’air sous leurs élytres, puis s’y renfonçaient verticalement."
                            },
                            {
                                "example_id": "0791a399-5dea-4f7c-a080-53e32a1f2b1d",
                                "sense_id": "ddee5435-a08b-3fa4-9201-240d0ab0c2df",
                                "text": "Des dytiques montaient prendre à la surface une bulle d'air dans la besace de leurs élytres et replongeaient verticalement, pareils à et des amandes pourvues de pattes-pagaies"
                            }
                        ]
                    }
                ],
