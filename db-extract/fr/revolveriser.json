                "senses": [
                    {
                        "sense_id": "bfabc801-b482-31cb-884d-bda7fc93e3af",
                        "entry_id": "dff9255e-0446-32bf-8817-d97a5adba77f",
                        "glosses": [
                            "Variante de révolvériser."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7329cf82-3c09-44b7-a731-514433691a67",
                                "sense_id": "bfabc801-b482-31cb-884d-bda7fc93e3af",
                                "text": "Pour policée qu’elle fut, l’époque n'avait pas ce culte des foies-blancs de nos temps soporifiques ; certes, on estait, mais cela n’empêchait pas de ferrailler d’importance, voire de revolveriser le contradicteur."
                            },
                            {
                                "example_id": "eee0494b-4104-47fb-ba26-2f91119780d4",
                                "sense_id": "bfabc801-b482-31cb-884d-bda7fc93e3af",
                                "text": "La psychanalyse n’a jamais été un métier de tout repos, mais de là à se faire revolveriser."
                            },
                            {
                                "example_id": "30f205b9-33c8-478b-aefb-3868ad9c6a1f",
                                "sense_id": "bfabc801-b482-31cb-884d-bda7fc93e3af",
                                "text": "Non, continua-t-il, nous vous garderons à bord pour éviter d’être revolverisées par votre petite amie…"
                            }
                        ]
                    }
                ],
