                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f1cbb2ca-bb00-4515-8c80-ea8f9d8476f1",
                                "sense_id": "8c9b5820-3cfb-3581-8e71-1076c55669e1",
                                "text": "пе́кло сраже́ния, би́твы, бо́я",
                                "translation": "the heat of the battle",
                                "english": "the heat of the battle"
                            }
                        ]
                    },
                    {
                        "sense_id": "bc9ed3a0-1f4c-37a1-97f0-0715923d827f",
                        "entry_id": "f1597179-011f-34c4-9af4-5fa87fb8b0d6",
