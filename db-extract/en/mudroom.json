                        "source_sense_id": "4d942d5f-d551-35eb-83d3-54edf23768e1",
                        "source_sense_description": "Room between outdoors and indoors",
                        "target_lang_word": "Windfang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
