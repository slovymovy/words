                "senses": [
                    {
                        "sense_id": "37c2f1a8-c42e-33c3-914c-2cdbe45cc4af",
                        "entry_id": "d523978a-26ec-33c3-9c0d-6fbd85fec182",
                        "glosses": [
                            "Ort im US-Bundesstaat Maryland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09afb70b-95f0-44cd-9e18-d62062320792",
                                "sense_id": "37c2f1a8-c42e-33c3-914c-2cdbe45cc4af",
                                "text": "„Sie trafen sich in einem weit vom Schuss gelegenen chinesischen Restaurant in der Nähe der Wisconsin Avenue in Bethesda.“"
                            },
                            {
                                "example_id": "e5238522-4931-48ee-a826-844bfebfcf2c",
                                "sense_id": "37c2f1a8-c42e-33c3-914c-2cdbe45cc4af",
                                "text": "„Und in weniger als 72 Stunden kippen wir uns in einer Hotelbar in Bethesda zwei Budweiser zum Preis von einem hinter die Binde.“"
                            },
                            {
                                "example_id": "e0ee2b19-8133-4f27-aacd-45d376479790",
                                "sense_id": "37c2f1a8-c42e-33c3-914c-2cdbe45cc4af",
                                "text": "„Ihre Schwester Dorion lebte in Bethesda, Maryland.“"
                            },
                            {
                                "example_id": "31838b63-48a9-441f-b465-cc2012695df9",
                                "sense_id": "37c2f1a8-c42e-33c3-914c-2cdbe45cc4af",
                                "text": "„Auf dem mehr als dreihundert Morgen großen NIH-Gelände in Bethesda, nur etwa fünfzehn Kilometer von der Kuppel des Kapitols entfernt, liegen vierundzwanzig getrennte Institute, Zentren und Abteilungen, die mehr als sechzehntausend Menschen beschäftigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
