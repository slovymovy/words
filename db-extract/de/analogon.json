                "senses": [
                    {
                        "sense_id": "1a3b0c16-9210-329a-b1ef-2fb953aca568",
                        "entry_id": "41ae2b7f-3906-32e6-8e06-9ab836051c15",
                        "glosses": [
                            "etwas, das einem anderen ähnlich/analog ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb310222-2c78-4d15-ad8a-08a17c11efa4",
                                "sense_id": "1a3b0c16-9210-329a-b1ef-2fb953aca568",
                                "text": "„Er stellt aber nur das individuelle, also ontogenetische Analogon zur Phylogenese, also der Entwicklungsgeschichte der gesamten Gattung dar.“"
                            },
                            {
                                "example_id": "3b65d93a-6c69-4b6e-b245-8b36e0b21e3d",
                                "sense_id": "1a3b0c16-9210-329a-b1ef-2fb953aca568",
                                "text": "„Worauf es ankommt, ist die Existenz eines Bildungsmusters der Kerngrammatik des Deutschen, die kein Analogon im Englischen hat.“"
                            },
                            {
                                "example_id": "12d2bafd-68d1-4143-a669-412fb3571d16",
                                "sense_id": "1a3b0c16-9210-329a-b1ef-2fb953aca568",
                                "text": "„Beide sehen im Bild der logisch-mathematischen Reihen ein Analogon zur Gesetzmäßigkeit der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "810c5401-3d4d-4345-bcb5-fdb8112e372b",
                        "source_entry_id": "41ae2b7f-3906-32e6-8e06-9ab836051c15",
                        "source_sense_id": "1a3b0c16-9210-329a-b1ef-2fb953aca568",
                        "source_sense_description": "etwas, das einem anderen ähnlich/analog ist",
                        "target_lang_word": "analogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0d7e56f-003a-35b6-9814-34feba7ccca8",
                                        "entry_id": "4d8c0198-172a-3bea-a68d-60e1a2429ad6",
                                        "glosses": [
                                            "Alternative spelling of analog."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38565ea8-4f60-4b32-b306-645c8ceb05b2",
                                                "sense_id": "d0d7e56f-003a-35b6-9814-34feba7ccca8",
                                                "text": "\"But if so, why do you see so many young children on steam trains - apart, that is, from being dragged along by their fathers, or grandfathers?\n\"I think they enjoy them because they are simply so different, so mechanical, so hot, oily and clanky, so dirty, so 'analogue' in a digital world. They are everything modern life tries to extirpate in favour of silence, smoothness and cleanness. Kids love that."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "analogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec02dff-78bc-3233-98a4-94f2617d0880",
                                        "entry_id": "ec1694ad-4e62-364c-b2b0-dfed441a0e8a",
                                        "glosses": [
                                            "Something that bears an analogy to something else."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63249d46-2e4a-32a9-a6c0-bd6661de446d",
                                        "entry_id": "ec1694ad-4e62-364c-b2b0-dfed441a0e8a",
                                        "glosses": [
                                            "An organ or structure that is similar in function to one in another kind of organism but is of dissimilar evolutionary origin."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffe5575b-f66d-4006-9b09-11e4fedaccfb",
                                                "sense_id": "63249d46-2e4a-32a9-a6c0-bd6661de446d",
                                                "text": "See also: convergent evolution"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4818c66-08f6-3018-99bc-e99f4b3cfb1d",
                                        "entry_id": "ec1694ad-4e62-364c-b2b0-dfed441a0e8a",
                                        "glosses": [
                                            "Alternative spelling of analog (“A structural derivative of a parent compound that differs from it by only one or a few atoms or substituent groups; (usually, especially) such a molecule that retains most of the same chemical properties.”)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24f391cd-6e2a-4f25-b7ec-620f252012f9",
                        "source_entry_id": "41ae2b7f-3906-32e6-8e06-9ab836051c15",
                        "source_sense_id": "1a3b0c16-9210-329a-b1ef-2fb953aca568",
                        "source_sense_description": "etwas, das einem anderen ähnlich/analog ist",
                        "target_lang_word": "analog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe248ff-0d9a-3678-b329-3cb32ba2ab8f",
                                        "entry_id": "7a0e9603-c14f-3843-8ec1-8874a32160c2",
                                        "glosses": [
                                            "In which the value of a data item (such as time) is represented by a continuous(ly) variable physical quantity that can be measured (such as the shadow of a sundial)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d954eb-0622-4626-b966-8d009c700859",
                                                "sense_id": "ffe248ff-0d9a-3678-b329-3cb32ba2ab8f",
                                                "text": "an analog watch"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a394d7f-ac36-3e32-9679-a694cd6bddab",
                                        "entry_id": "7a0e9603-c14f-3843-8ec1-8874a32160c2",
                                        "glosses": [
                                            "Not relating to, or pre-dating, digital technology such as computers and the Internet; relating to real life."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e205a0e6-691e-420a-8866-a78cfe4e0bdb",
                                                "sense_id": "6a394d7f-ac36-3e32-9679-a694cd6bddab",
                                                "text": "an analog (paper) map"
                                            },
                                            {
                                                "example_id": "af71f420-6e77-4267-b6ba-13277ece649d",
                                                "sense_id": "6a394d7f-ac36-3e32-9679-a694cd6bddab",
                                                "text": "But for these digital natives, the stubborn analog wonders of skin, handshakes, hugs, bread and wine, faces, names and spontaneous conversation is part of what intrigued them and kept them going to church."
                                            },
                                            {
                                                "example_id": "cfb08994-f40d-4e64-8af2-bc102e85d29c",
                                                "sense_id": "6a394d7f-ac36-3e32-9679-a694cd6bddab",
                                                "text": "Not that I expect my children’s generation to be shocked by it all. Unlike my analog upbringing, they were born into a digital world."
                                            },
                                            {
                                                "example_id": "1985859e-dbb9-46c4-a3f8-c4771b3a5032",
                                                "sense_id": "6a394d7f-ac36-3e32-9679-a694cd6bddab",
                                                "text": "But what, exactly, is a platform? In the analog world, a platform is where you catch a train or launch a rocket or give a speech — somewhere you go to do something else."
                                            },
                                            {
                                                "example_id": "b24612af-0b0d-45b3-ad89-5e9ce4966fe8",
                                                "sense_id": "6a394d7f-ac36-3e32-9679-a694cd6bddab",
                                                "text": "Effective analog dating demands a similar commitment to strategizing, she said, and “if you have your phone in your face, or earbuds in your ears, you’re not going to meet anyone.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "analog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f5920ed-ba60-3e52-8a66-498a97976ee8",
                                        "entry_id": "8c16091d-90c8-35b1-a5c7-6d86d9b6b067",
