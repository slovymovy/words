                ],
                "senses": [
                    {
                        "sense_id": "ed081871-7e51-3952-919b-cc45dc06b4c8",
                        "entry_id": "371314fe-ca5a-39b9-8821-4271619171e1",
                        "glosses": [
                            "Kreuzungsprodukt aus einer Hauspferdestute mit einem Hauseselhengst"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "35840f0f-dffa-4893-a645-c79169e00cc7",
                                "sense_id": "ed081871-7e51-3952-919b-cc45dc06b4c8",
                                "text": "„Ihr Muli stakste gehorsam auf dem Saumpfad hinter seinem Herrn her, der, wie er meinte, den einzig wahren Weg zur Quelle Tschemschem kenne: Der Geist, der dort wohne, sei nämlich ziemlich schreckhaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11bdc400-7881-3741-87be-359e7fb0b3a6",
                        "entry_id": "371314fe-ca5a-39b9-8821-4271619171e1",
                        "glosses": [
                            "Person, die im Auftrag Drogen transportiert"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a1d9ce3c-0c16-4a00-889c-6c424908472f",
                                "sense_id": "11bdc400-7881-3741-87be-359e7fb0b3a6",
                                "text": "„Aus reiner Verzweiflung habe ich sogar überlegt, mich als Muli anzubieten.“"
                            },
                            {
                                "example_id": "100c0acb-e838-4db8-b113-0be99b4917be",
                                "sense_id": "11bdc400-7881-3741-87be-359e7fb0b3a6",
                                "text": "„Im Jargon der Fahnder sind Mulis Menschen, die Drogen im Körper schmuggeln.“"
                            },
                            {
                                "example_id": "3a0ba620-bf56-493e-9970-80f27744601f",
                                "sense_id": "11bdc400-7881-3741-87be-359e7fb0b3a6",
                                "text": "„Nehmen wir mal an, sie haben Sheila als Muli benutzt, und Giggo wartete in Miami auf sie, um die Drogensendung in Empfang zu nehmen, die sie transportierte.“"
                            },
                            {
                                "example_id": "d45d3743-fd4e-44a9-b958-7d57304d52ea",
                                "sense_id": "11bdc400-7881-3741-87be-359e7fb0b3a6",
                                "text": "„Er hörte das letzte Muli in der Küche kotzen, sie kotzte das jetzt schon lange, sie war nicht daran gewöhnt, dazu waren etliche Reisen vonnöten.“"
                            },
                            {
                                "example_id": "7995561c-458b-46f4-b0ec-4c44f578dbb1",
                                "sense_id": "11bdc400-7881-3741-87be-359e7fb0b3a6",
                                "text": "„Falls Sie den Verdacht haben, dass sich in der Gruppe ein Muli befindet, der Drogen dabeihat, könnte ich allerdings aus Tucson einen Hubschrauber anfordern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
