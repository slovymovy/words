                "senses": [
                    {
                        "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                        "entry_id": "dc276dc8-5826-3b02-bfd1-7b58281ce440",
                        "glosses": [
                            "weibliche Person, die (meist als Sportlerin) Berge hinaufsteigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6143fd90-1fbc-4ad2-8c9f-22f53bb33a78",
                                "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                                "text": "Die Bergsteigerin geht nur mit Ausrüstung auf den Gipfel."
                            },
                            {
                                "example_id": "0bc0490c-cca9-4825-a697-f9e23d563cd7",
                                "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                                "text": "„Die Südkoreaner konnten Ende April live im Fernsehen verfolgen, wie die Bergsteigerin Oh Eun Sun die Landesflagge auf dem Gipfel des 8091 Meter hohen Annapurna in Nepal in den Schnee steckte.“"
                            },
                            {
                                "example_id": "766490b5-8c19-4b61-9770-2bab73203e5f",
                                "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                                "text": "„Unter schwierigen Bedingungen haben die Rettungsflugwacht und der Schweizer Alpen-Club (SAC) in der Nacht auf Sonntag eine Bergsteigerin im Brüniggebiet gerettet.“"
                            },
                            {
                                "example_id": "c3aab8d9-017a-4abd-9856-a65be24fd940",
                                "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                                "text": "„Sie hat es sich als eine der weltweit besten Bergsteigerinnen zum Ziel gemacht, alle Achttausender ohne Sauerstoff zu bezwingen.“"
                            },
                            {
                                "example_id": "82c52da2-f783-4b57-869a-f6c3bf3b7095",
                                "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                                "text": "„Die Leiche jener deutschen Bergsteigerin, die in der Nacht auf Dienstag auf der Wildspitze in den Ötztaler Alpen umgekommen war, wurde am Mittwoch von einem Hubschrauber geborgen und ins Tal geflogen.“"
                            },
                            {
                                "example_id": "193c3b4e-4065-45a1-abab-4f3570b9b3ca",
                                "sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                                "text": "„Mit routinierten Bergsteigerinnen, deren Können mindestens für den vierten Schwierigkeitsgrad ausreicht, will der Schweizerische Frauen-Alpenclub in schwindelnder Höhe den Bund ‚Rendez-vous Hautes Montagne‘ gründen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91669785-c520-4d74-9d3b-6538376b89d5",
                        "source_entry_id": "dc276dc8-5826-3b02-bfd1-7b58281ce440",
                        "source_sense_id": "022e8cf6-a355-356e-8fd5-c929c4579d17",
                        "source_sense_description": "weibliche Person, die (meist als Sportlerin) Berge hinaufsteigt",
                        "target_lang_word": "mountaineer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mountaineer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                        "entry_id": "21102bb9-4648-343c-b94b-14b70be30e73",
                                        "glosses": [
                                            "A person who lives in a mountainous area (often with the connotation that such people are outlaws or uncivilized)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef91580-65aa-49dd-9e46-f037610df756",
                                                "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                                "text": "(obsolete)"
                                            },
                                            {
                                                "example_id": "d44269f6-7401-4e83-b4b5-1bd4e21b09c2",
                                                "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                                "text": "This was my master,\nA very valiant Briton and a good,\nThat here by mountaineers lies slain."
                                            },
                                            {
                                                "example_id": "bc883fce-471c-47a4-b162-e0405884f5c1",
                                                "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                                "text": "No savage fierce, bandite, or mountaneer\nWill dare to soyle her virgin puritie",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "8ba09bb0-c4ff-4fd9-936b-c5ee9f3a8c71",
                                                "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                                "text": "A mountaineer can tread firm upon a precipice and walk erect without tottering along the path, that winds itself about the craggy cliff, on which he has his dwelling; whilst the inhabitant of the valley travels with affright and danger over the giddy pass […]"
                                            },
                                            {
                                                "example_id": "4c8a1514-095e-4fb3-a194-217974100c19",
                                                "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                                "text": "The mountaineer will not leave his rock, nor the savage his hut; neither are we willing to give up our present mode of life, with all its advantages and disadvantages, for any other that could be substituted for it."
                                            },
                                            {
                                                "example_id": "8358b53e-3f30-4285-a0fc-b8a92146b14d",
                                                "sense_id": "1c2f0bf6-2728-3f5a-8d02-7aed30fa180d",
                                                "text": "My formal Spanish must have sounded as pretentious to the ears of the paisano as “Whither goeth my sire?” would have sounded to a semi-literate Ozark mountaineer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd6abea-10e0-38d3-891d-93e923ef34fb",
                                        "entry_id": "21102bb9-4648-343c-b94b-14b70be30e73",
                                        "glosses": [
                                            "A person who climbs mountains for sport or pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b933dbb-2ca6-4d59-a13d-a46afc55aa84",
                                                "sense_id": "2bd6abea-10e0-38d3-891d-93e923ef34fb",
                                                "text": "He first took me into Switzerland, and had he kept me there till now, amidst the scenery with which his pen and pencil brought me acquainted, I should have looked on myself as a very happy mountaineer, and him as a delightful guide!"
                                            },
                                            {
                                                "example_id": "54cfaee6-8a11-4a3e-a9c7-7cffe522e1d7",
                                                "sense_id": "2bd6abea-10e0-38d3-891d-93e923ef34fb",
                                                "text": "These green and sweetly smelling crops\nThey led in waggons home;\nAnd they piled them here in mountain tops\nFor mountaineers to roam."
                                            },
                                            {
                                                "example_id": "72215109-6483-4c36-94b6-ae3c0c74a0c1",
                                                "sense_id": "2bd6abea-10e0-38d3-891d-93e923ef34fb",
                                                "text": "[…] zigzagging precipices with mountaineers ascending roped together […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cc71c8-bb41-3c1c-9acc-c729d03d42af",
                                        "entry_id": "21102bb9-4648-343c-b94b-14b70be30e73",
                                        "glosses": [
                                            "An animal or plant that is native to a mountainous area."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37001b1e-4945-4669-bbed-53b3fb27575b",
                                                "sense_id": "90cc71c8-bb41-3c1c-9acc-c729d03d42af",
                                                "text": "1786, George Culley, Observations on Live Stock, London: G. G. J. & J. Robinson, p. 92,\nThis hardy race [of sheep] differ from our other breeds, not only in their dark complection and horns, but principally in the long coarse shagged wool which grows upon these mountaineers."
                                            },
                                            {
                                                "example_id": "83b49f87-67b6-4c87-bc81-1930c8483c55",
                                                "sense_id": "90cc71c8-bb41-3c1c-9acc-c729d03d42af",
                                                "text": "[…] the Gibbons are true mountaineers, loving the slopes and edges of the hills, though they rarely ascend beyond the limit of the fig-trees."
                                            },
                                            {
                                                "example_id": "cef4d31d-e060-47b3-8428-5ff814ef82f5",
                                                "sense_id": "90cc71c8-bb41-3c1c-9acc-c729d03d42af",
                                                "text": "1892, Sutton and Sons, Reading, The Culture of Vegetables and Flowers, London: Simpkin, Marshall, Hamilton, Kent, 5th edition, p. 217,\nThere really is no need of artificial heat, for the Auricula is a mountaineer, and can endure both frost and snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5797928-1995-3103-b74f-b45a1dd5b631",
                                        "entry_id": "21102bb9-4648-343c-b94b-14b70be30e73",
                                        "glosses": [
                                            "A bird of the genus Oreonympha; also called the bearded mountaineer or eastern mountaineer"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mountaineer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7676b44-154e-33f3-860c-17bdb0315fc4",
                                        "entry_id": "f69cca6d-6fb6-3278-9c7e-b7d36808df69",
                                        "glosses": [
                                            "To climb mountains; to climb using the techniques of a mountaineer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcc94a3b-297b-4b45-833a-5f2b2972fd93",
                                                "sense_id": "f7676b44-154e-33f3-860c-17bdb0315fc4",
                                                "text": "[…] they had returned in safety to Europe, and were now in Switzerland, where they were mountaineering with great vigour."
                                            },
                                            {
                                                "example_id": "1e8b0402-351f-4d59-a2d7-19392c4c97f5",
                                                "sense_id": "f7676b44-154e-33f3-860c-17bdb0315fc4",
                                                "text": "[…] no one who has mountaineered or travelled much in uncharted ground with men of very divergent or very similar powers of sight or experience will be found to discredit [the] positive but entirely accidental possession [of a sense of direction]."
                                            },
                                            {
                                                "example_id": "60a476b6-fc65-456a-a4c4-d412549c1e1e",
                                                "sense_id": "f7676b44-154e-33f3-860c-17bdb0315fc4",
                                                "text": "At the open water we bore to the westerly shore and started to mountaineer over the hummocks piled on the land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b515fee-4db8-34d3-9d65-cbe0c13e4432",
                                        "entry_id": "f69cca6d-6fb6-3278-9c7e-b7d36808df69",
                                        "glosses": [
                                            "To climb as if on a mountain."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759059a1-50d8-4030-8fe5-a5f303c81b2e",
                                                "sense_id": "2b515fee-4db8-34d3-9d65-cbe0c13e4432",
                                                "text": "There is a well-made path, which makes a circuit over the mass [of ruins], and is amply sufficient for all rational tourists. Those who wish to see more have to go mountaineering over gigantic columns and pilasters, and squeeze their way through passes of cut stone."
                                            },
                                            {
                                                "example_id": "ffbe9127-f5e2-4fd7-b846-63660f3dd24b",
                                                "sense_id": "2b515fee-4db8-34d3-9d65-cbe0c13e4432",
                                                "text": "[…] he sat up and shook his ears once or twice, and then sprang lightly off the window-sill and began to mountaineer about the contents of the garret."
                                            },
                                            {
                                                "example_id": "1124ec2a-099e-4195-aa37-679fa5c91233",
                                                "sense_id": "2b515fee-4db8-34d3-9d65-cbe0c13e4432",
                                                "text": "Petro’s approach to fatherhood was pretty calm; he carried on with whatever he wanted to do while his rumbustious tots mountaineered all over him."
                                            },
                                            {
                                                "example_id": "fe883bd0-771a-4608-acf0-5fb829326896",
                                                "sense_id": "2b515fee-4db8-34d3-9d65-cbe0c13e4432",
                                                "text": "[…] when I got there it had started and there were no seats left. Secretly relieved, I walked or rather mountaineered back to the flat […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ee2960e-f28d-441d-9325-8f5ff0c326a2",
