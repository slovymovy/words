                                "target_senses": [
                                    {
                                        "sense_id": "19ad4606-8b2d-3206-85cd-9a18573649fe",
                                        "entry_id": "ba4a946c-871d-33bb-b1ff-f2f72c347fdb",
                                        "glosses": [
                                            "vnitrozemský stát ve střední Evropě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2e0c8e-5cde-4d64-a12c-64dab4e4235f",
                                                "sense_id": "19ad4606-8b2d-3206-85cd-9a18573649fe",
                                                "text": "Ale po pádu hlavního města Krakova ztraceny Čechům také všecky okolní krajiny, netoliko nynější Halič, ale i Morava i celé Slovensko v Uhřích."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "227780b1-7bd2-4c45-898f-91be342d558b",
                        "source_entry_id": "2100373d-546f-33b5-a31d-fa3b026c0d05",
                        "source_sense_id": "caadefae-e2d1-3b63-b87c-f7d0c59ab7f2",
                        "source_sense_description": "Slovakia",
                        "target_lang_word": "Slowakije",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slowakije",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "baf73d9e-8b95-3853-a8f8-724ddbf3620c",
                                        "entry_id": "632513bd-6233-30e0-84a1-3351d268ea9b",
                                        "glosses": [
                                            "een land in Midden-Europa, grenzend aan Oostenrijk en Tsjechië in het westen, aan Polen in het noorden, aan Oekraïne in het oosten en aan Hongarije in het zuiden; het oostelijke deel van het voormalige Tsjecho-Slowakije"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ac56ec-bd2b-4b52-83ca-354c7854f648",
                                                "sense_id": "baf73d9e-8b95-3853-a8f8-724ddbf3620c",
                                                "text": "Vrij onverwacht stemden negentig Slowaakse parlementariërs voor de grondwetswijziging waarmee het land nog slechts twee genders erkent. „Dit is een zwarte dag voor Slowakije.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79dafc94-64cc-4046-9950-3714989044b6",
                        "source_entry_id": "2100373d-546f-33b5-a31d-fa3b026c0d05",
