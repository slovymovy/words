            "senses": [
                {
                    "sense_id": "75c9a026-c77a-3dbf-b5dc-af721c0e26bd",
                    "sense_definition": "de manier waarop of de positie waarin iets of iemand geplaatst is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je de schakelaar s.v.p. in de <w>stand</w> 'midden' zetten?",
                            "target_lang_translations": {
                                "en": "Could you please put the switch in the 'middle' <w>position</w>?"
                            }
                        },
                        {
                            "text": "De hoek van de schaduw hangt af van de <w>stand</w> van de zon.",
                            "target_lang_translations": {
                                "en": "The angle of the shadow depends on the <w>position</w> of the sun."
                            }
                        }
                    ],
                    "synonyms": [
                        "positie",
                        "instelling"
                    ],
                    "common_phrases": [
                        "stand van de zon",
                        "in een bepaalde stand"
                    ],
                    "target_lang_definitions": {
                        "en": "the way in which or the position in which something or someone is placed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "position",
                                "target_lang_sense_clarification": "physical placement or orientation"
                            },
                            {
                                "target_lang_word": "setting",
                                "target_lang_sense_clarification": "a specific mode or adjustment on a device"
                            },
                            {
                                "target_lang_word": "posture",
                                "target_lang_sense_clarification": "the position of a person's body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79779b9-9fd2-3036-8aa2-bc39a1989f86",
                    "sense_definition": "de huidige score of tussenstand in een wedstrijd of competitie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "score",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>stand</w> is nu drie-nul voor de Belgische dames.",
                            "target_lang_translations": {
                                "en": "The <w>score</w> is now three-nil for the Belgian ladies."
                            }
                        },
                        {
                            "text": "Iedereen keek gespannen naar het bord om de actuele <w>stand</w> te zien.",
                            "target_lang_translations": {
                                "en": "Everyone looked tensely at the board to see the current <w>score</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "score"
                    ],
                    "common_phrases": [
                        "tussenstand van de wedstrijd",
                        "de stand bijhouden"
                    ],
                    "target_lang_definitions": {
                        "en": "the current score or intermediate standing in a match or competition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "score",
                                "target_lang_sense_clarification": "the number of points in a game"
                            },
                            {
                                "target_lang_word": "standing",
                                "target_lang_sense_clarification": "the position of a team in a league or tournament"
                            },
                            {
                                "target_lang_word": "state of play",
                                "target_lang_sense_clarification": "the current situation in a match"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a7faa2e-e807-3229-a8d4-77ce70aab4bc",
                    "sense_definition": "de maatschappelijke klasse of sociale positie waartoe iemand behoort",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sociale status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zulk gedrag past niet bij zijn <w>stand</w> als burgemeester.",
                            "target_lang_translations": {
                                "en": "Such behavior does not suit his <w>rank</w> as mayor."
                            }
                        },
                        {
                            "text": "Vroeger was het ongebruikelijk om te trouwen met iemand van een lagere <w>stand</w>.",
                            "target_lang_translations": {
                                "en": "In the past, it was unusual to marry someone from a lower <w>class</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rang",
                        "klasse",
                        "graad"
                    ],
                    "common_phrases": [
                        "burgerlijke stand",
                        "beneden zijn stand"
                    ],
                    "target_lang_definitions": {
                        "en": "the social class or social position to which someone belongs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "class",
                                "target_lang_sense_clarification": "social grouping based on wealth or status"
                            },
                            {
                                "target_lang_word": "rank",
                                "target_lang_sense_clarification": "social or professional level"
                            },
                            {
                                "target_lang_word": "station",
                                "target_lang_sense_clarification": "one's social position in life"
                            },
                            {
                                "target_lang_word": "status",
                                "target_lang_sense_clarification": "social standing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47c006fe-151e-3dae-b282-42a5ab2ac4b3",
                    "sense_definition": "een kraam of gereserveerde ruimte op een beurs of markt om producten te tonen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verkooppunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was vooral nieuwsgierig naar de <w>stand</w> van zijn concurrent op de beurs.",
                            "target_lang_translations": {
                                "en": "He was mainly curious about his competitor's <w>stand</w> at the fair."
                            }
                        },
                        {
                            "text": "We hebben een grote <w>stand</w> gehuurd om onze nieuwe boeken te presenteren.",
                            "target_lang_translations": {
                                "en": "We rented a large <w>booth</w> to present our new books."
                            }
                        }
                    ],
                    "synonyms": [
                        "kraam"
                    ],
                    "common_phrases": [
                        "een stand op de beurs",
                        "producten in de stand"
                    ],
                    "target_lang_definitions": {
                        "en": "a stall or reserved space at a fair or market to display products"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "a booth or stall at an exhibition"
                            },
                            {
                                "target_lang_word": "booth",
                                "target_lang_sense_clarification": "a small temporary structure for display"
                            },
                            {
                                "target_lang_word": "stall",
                                "target_lang_sense_clarification": "a place for selling goods at a market"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e12a8f4-a452-3cea-bf49-ac287cb1c29b",
                    "sense_definition": "gebruikt in de uitdrukking in <w>stand</w> houden: zorgen dat iets blijft bestaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om oude tradities in <w>stand</w> te houden voor de toekomst.",
                            "target_lang_translations": {
                                "en": "It is important to <w>maintain</w> old traditions for the future."
                            }
                        },
                        {
                            "text": "Zij wilde haar buitenlandse sprookje koste wat kost in <w>stand</w> houden.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>keep</w> her foreign fairytale alive at all costs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in stand houden"
                    ],
                    "target_lang_definitions": {
                        "en": "used in the expression 'in stand houden': to ensure that something continues to exist"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maintain",
                                "target_lang_sense_clarification": "to keep something in its existing state"
                            },
                            {
                                "target_lang_word": "preserve",
                                "target_lang_sense_clarification": "to keep alive or in existence"
                            },
                            {
                                "target_lang_word": "uphold",
                                "target_lang_sense_clarification": "to support or maintain a tradition or law"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a021eb15-7135-3835-b994-f2ceb0b34694",
                    "sense_definition": "de omvang of grootte van een populatie dieren of planten in een gebied",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "populatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>stand</w> van de zeehonden zal door die olieramp een geduchte knauw krijgen.",
                            "target_lang_translations": {
                                "en": "The seal <w>population</w> will take a major hit because of that oil spill."
                            }
                        },
                        {
                            "text": "De boswachter controleert jaarlijks de <w>stand</w> van de reeën in dit natuurgebied.",
                            "target_lang_translations": {
                                "en": "The ranger checks the <w>numbers</w> of roe deer in this nature reserve annually."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de stand van de populatie",
                        "wildstand beheren"
                    ],
                    "target_lang_definitions": {
                        "en": "the size or volume of a population of animals or plants in an area"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "population",
                                "target_lang_sense_clarification": "the number of individuals of a species"
                            },
                            {
                                "target_lang_word": "stock",
                                "target_lang_sense_clarification": "the total amount of a biological resource, like fish"
                            },
                            {
                                "target_lang_word": "numbers",
                                "target_lang_sense_clarification": "the quantity of animals in a group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2607cbec-f32e-30cc-aa0d-43d2a5f64793",
                    "sense_definition": "een vermaning of berisping, vrijwel uitsluitend gebruikt als verkleinwoord <w>standje</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "berisping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar gaf de leerling een flink <w>standje</w> omdat hij weer te laat was.",
                            "target_lang_translations": {
                                "en": "The teacher gave the student a good <w>scolding</w> because he was late again."
                            }
                        },
                        {
                            "text": "Na het breken van de vaas kreeg het kind een streng <w>standje</w> van zijn moeder.",
                            "target_lang_translations": {
                                "en": "After breaking the vase, the child got a stern <w>telling-off</w> from his mother."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand een standje geven"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Meestal gebruikt als verkleinwoord 'standje'."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an admonition or reprimand, almost exclusively used as the diminutive 'standje'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scolding",
                                "target_lang_sense_clarification": "a sharp reprimand"
                            },
                            {
                                "target_lang_word": "telling-off",
                                "target_lang_sense_clarification": "an informal verbal reprimand"
                            },
                            {
                                "target_lang_word": "reprimand",
                                "target_lang_sense_clarification": "a formal expression of disapproval"
                            }
                        ]
                    }
                }
            ]
        }
    ]
