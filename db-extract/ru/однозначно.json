                                        "entry_id": "c4db5bcb-98b8-35bd-b4d9-4fab0d03d33d",
                                        "glosses": [
                                            "gut zu verstehen und keine Missverständnisse zulassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03927e8a-9548-41e0-89a1-0d4c446ad7ee",
                                                "sense_id": "4418b04d-a7d5-363c-9f54-f757766fe3c5",
                                                "text": "Sie erhielt eine unzweideutige Antwort."
                                            },
                                            {
                                                "example_id": "41c07134-5b4b-4df8-84f2-ba592972c0b3",
                                                "sense_id": "4418b04d-a7d5-363c-9f54-f757766fe3c5",
                                                "text": "Er gab ihr unzweideutig zu verstehen, dass sie unerwünscht war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
