                ],
                "senses": [
                    {
                        "sense_id": "3f51c24c-fd8d-3f25-a1c9-008276992150",
                        "entry_id": "ab9496ef-ca92-336b-9335-7dfbb41a5bee",
                        "glosses": [
                            "zwei Fließgewässer/Wasserstraßen verbindender, künstlich angelegter (schiffbarer) Wasserlauf"
                        ],
                        "tags": [
                            "Wasserbau"
                        ],
                        "examples": [
                            {
                                "example_id": "000dd747-f631-4b70-8301-06e33699901b",
                                "sense_id": "3f51c24c-fd8d-3f25-a1c9-008276992150",
                                "text": "„Die Spandauer Havel vom Juliusturm bis zum Tegeler See ist mit ihren Industrieufern und den zu Verladekais führenden Stichkanälen wenig attraktiv.“"
                            },
                            {
                                "example_id": "064f585c-d7eb-4a52-aded-8d3440d0a2ed",
                                "sense_id": "3f51c24c-fd8d-3f25-a1c9-008276992150",
                                "text": "„Die Verbindung von den Längskanälen zur Schleusenkammer stellen Stichkanäle her, die auf beiden Seiten alle 15 m, also pro Block ein Stichkanal, angeordnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "71118341-aa33-3ec4-9927-cb10532d907e",
                        "entry_id": "ab9496ef-ca92-336b-9335-7dfbb41a5bee",
                        "glosses": [
                            "röhrenähnliche Vorrichtung (seltener entsprechende Bodenvertiefung), über die geschmolzenes Metall einen Schmelzofen nach dessen Öffnung verlassen kann"
                        ],
                        "tags": [
                            "Hüttenwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "840b9d61-658f-46f3-be98-79b1f1bb8888",
                                "sense_id": "71118341-aa33-3ec4-9927-cb10532d907e",
                                "text": "„[Der sogen. ‚Vorherd‘] enthält bei der Sumpfofenzustellung den Vorsumpf, die Abflußwege für die Schlacken, die sogen. Schlackentrift und den sogen. Stichkanal, durch welchen die abgestochenen metallischen Massen in den Stechherd bezw. in Formen oder auf die Hüttensohle fließen.“"
                            },
                            {
                                "example_id": "b41cfb16-eb59-4872-913e-0aaee79d96e9",
                                "sense_id": "71118341-aa33-3ec4-9927-cb10532d907e",
                                "text": "„Ist das Eisen gut, so wird der kleine Stichkanal aufgestochen und das Eisen auf einen von Gusseisenplatten gebildeten Boden abgelassen, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1aea0794-b66f-38ab-810c-96bd2bbf662d",
                        "entry_id": "ab9496ef-ca92-336b-9335-7dfbb41a5bee",
                        "glosses": [
                            "infolge des Eindringens eines schneidenden/spitzen Gegenstandes in einen Körper auftretende, tunnelähnlich verlaufende Verletzung des Gewebes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b27e6c6-5e73-4f22-98f7-3aef9099bcf6",
                                "sense_id": "1aea0794-b66f-38ab-810c-96bd2bbf662d",
                                "text": "„Im allgemeinen [sic!] entspricht der Stichkanal nicht dem Querschnitt des verletzenden Werkzeugs.“"
                            },
                            {
                                "example_id": "9bd0c11a-1ae5-4f1f-be44-e712164d7f20",
                                "sense_id": "1aea0794-b66f-38ab-810c-96bd2bbf662d",
                                "text": "„Wird mit einem Messer heftig bis zum Heft eingestochen, kann es durch Kompression der Weichteile […] zu einem Stichkanal kommen, der länger ist, [sic!] als die Messerklinge.“"
                            },
                            {
                                "example_id": "5fdbb3e7-2f40-421a-86d2-a3205b4b6eb4",
                                "sense_id": "1aea0794-b66f-38ab-810c-96bd2bbf662d",
                                "text": "„Kommt es zu Relativbewegungen zwischen Messer und durchstochenem Objekt, so dass die Lage des Messers im Stichkanal beim Herausziehen anders ist als beim Einstechen, resultiert an der Seite der Messerschneide ein sog. großer Schwalbenschwanz.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
