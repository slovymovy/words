                "senses": [
                    {
                        "sense_id": "1a13992c-67f6-3c01-8891-fe78a64ab551",
                        "entry_id": "8d78c4dc-9ba8-35bb-a59d-ad88809fb6c8",
                        "glosses": [
                            "Ort in Oberägypten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33c320d-bf48-40c3-bada-4d9d9b566cfd",
                                "sense_id": "1a13992c-67f6-3c01-8891-fe78a64ab551",
                                "text": "„Sie beharren darauf, dass Glaaki die Erde bereits wesentlich früher erreicht hat – und zwar durch ›die umgekehrten Winkel von TaghClatur‹, welche den Sobek-Priestern von Karnak vertraut waren.“"
                            },
                            {
                                "example_id": "8eca397d-5f27-4b8c-bf95-5a388ec60353",
                                "sense_id": "1a13992c-67f6-3c01-8891-fe78a64ab551",
                                "text": "„Die Wüste schien bar jeglichen Lebens zu sein, und die einzigen Menschen, die wir je zu sehen bekamen, tauchten kurz vor der Dämmerung des zweiten Tages auf: die Umrisse dreier zerlumpter Nomaden auf einer weit entfernten Sanddüne, die uns betrachteten, als seien wir in Stein gehauene Bilder aus dem antiken Karnak.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
