                {
                    "sense_id": "fdf131cb-07ec-3b88-9374-05f91faabb5b",
                    "sense_definition": "Lepka substancja używana do trwałego łączenia ze sobą różnych przedmiotów lub materiałów.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Idź do sklepu papierniczego po <klej> i nożyczki.",
                            "target_lang_translations": {
                                "ru": "Сходи в магазин канцтоваров за <w>клеем</w> и ножницами.",
                                "en": "Go to the stationery store for <w>glue</w> and scissors."
                            }
                        },
                        {
                            "text": "Ten <klej> jest bardzo mocny i błyskawicznie schnie.",
                            "target_lang_translations": {
                                "ru": "Этот <w>клей</w> очень сильный и моментально сохнет.",
                                "en": "This <w>glue</w> is very strong and dries instantly."
                            }
                        }
                    ],
                    "synonyms": [
                        "klajster",
                        "lepidło",
                        "lepiszcze"
                    ],
                    "common_phrases": [
                        "klej do papieru",
                        "klej w sztyfcie",
                        "klej błyskawiczny",
                        "wąchać klej"
                    ],
                    "target_lang_definitions": {
                        "ru": "Липкое вещество, используемое для прочного соединения различных предметов или материалов.",
                        "en": "A sticky substance used to permanently join different objects or materials together."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "вещество"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "glue",
                                "target_lang_sense_clarification": "general adhesive substance"
                            },
                            {
                                "target_lang_word": "adhesive",
                                "target_lang_sense_clarification": "technical or formal term for glue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "204b030c-33ca-3571-8c57-f877764b4794",
                    "sense_definition": "Specjalistyczna zaprawa budowlana służąca do mocowania płytek, styropianu lub innych elementów wykończeniowych.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy kupić worki z <klejem> do płytek ceramicznych.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить мешки с <w>клеем</w> для керамической плитки.",
                                "en": "We need to buy bags of tile <w>adhesive</w>."
                            }
                        },
                        {
                            "text": "Robotnicy nałożyli <klej> na ścianę przed położeniem glazury.",
                            "target_lang_translations": {
                                "ru": "Рабочие нанесли <w>клей</w> на стену перед укладкой плитки.",
                                "en": "The workers applied <w>adhesive</w> to the wall before laying the tiles."
                            }
                        }
                    ],
                    "common_phrases": [
                        "klej do płytek",
                        "klej do glazury",
                        "klej do styropianu",
                        "klej montażowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальный строительный раствор для крепления плитки, пенопласта или других отделочных элементов.",
                        "en": "A specialized construction mortar used for fixing tiles, polystyrene, or other finishing elements."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "строительный раствор"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "adhesive",
                                "target_lang_sense_clarification": "construction or tile bonding agent"
                            },
                            {
                                "target_lang_word": "mortar",
                                "target_lang_sense_clarification": "bonding substance for tiles"
                            }
                        ]
                    }
                }
            ]
        },
