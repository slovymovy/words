                                    {
                                        "sense_id": "eb90aed2-3d33-39bd-a6aa-29e867ec5991",
                                        "entry_id": "8fc603c5-0bbe-3b22-9cd0-c1579395de9c",
                                        "glosses": [
                                            "Réseau social de type microblog développé par Meta en 2023."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf765c9-8f42-4c9c-a432-8629f2a2fa1a",
                                                "sense_id": "eb90aed2-3d33-39bd-a6aa-29e867ec5991",
                                                "text": "Le groupe Meta (Facebook, Instagram) a lancé, jeudi dernier, dans l’UE, son réseau social Threads, rival direct de X. Au point de la supplanter ?"
                                            },
                                            {
                                                "example_id": "d8bcba25-4f32-416c-8fb6-42d8764fefca",
                                                "sense_id": "eb90aed2-3d33-39bd-a6aa-29e867ec5991",
                                                "text": "Le réseau social Threads est enfin disponible en France ce jeudi 14 décembre, près de six mois après son lancement dans 30 pays, dont les États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
