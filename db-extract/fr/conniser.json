                "senses": [
                    {
                        "sense_id": "3ed33c4c-9036-3400-93d4-0857a1cfd138",
                        "entry_id": "2f749aa4-7fdd-3da2-880c-32777ec6fbbe",
                        "glosses": [
                            "Donner un caractère con à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d9f79b-e060-4d96-bc5d-1c1bd2e0d24c",
                                "sense_id": "3ed33c4c-9036-3400-93d4-0857a1cfd138",
                                "text": "Pour être persuadé de cette Vérité, il suffit d'écouter Pasquier qui cherche tant à conniser cette Guerriere."
                            },
                            {
                                "example_id": "7de37908-ce96-43a6-9a19-caf3c4639adf",
                                "sense_id": "3ed33c4c-9036-3400-93d4-0857a1cfd138",
                                "text": "Quant à Joffrin… il est tombé dans l’erreur commune à toute l’église des bobos dont il est archevêque: diaboliser M. le Pen ou lieu de la ‘conniser’… ce qui est pourtant facile quand on lit le monceau de crétineries abyssales qui sont collectées dans le ‘programme’ du FN."
                            },
                            {
                                "example_id": "c8e66055-f2c8-45c1-a10a-886fca31c641",
                                "sense_id": "3ed33c4c-9036-3400-93d4-0857a1cfd138",
                                "text": "Si l'on considère que Sarkozy est à la France ce que Berlusconi est à l'Italie, oui, TF1 se berlusconise, et je dirais même se connise tout court."
                            }
                        ]
                    }
