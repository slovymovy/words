                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I spoke to Mr. <w>Went</w> about the condition of the garden.",
                            "target_lang_translations": {
