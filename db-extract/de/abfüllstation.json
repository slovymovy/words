                "senses": [
                    {
                        "sense_id": "666adb57-c120-33fe-adf9-6fb204b59dd7",
                        "entry_id": "574b1713-2081-39d6-93f7-7c80789d1432",
                        "glosses": [
                            "Station, an der Flüssigkeiten oder andere Stoffe in Behälter eingefüllt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91dd21a-cc11-4c7e-b17a-7a9aa4ca004f",
                                "sense_id": "666adb57-c120-33fe-adf9-6fb204b59dd7",
                                "text": "„Ein Beispiel aus der Lebensmittelindustrie sind Abfüllstationen für Joghurt in einer Molkerei; die Aufsichtsperson greift nur bei Störungen ein, ansonsten ist der Prozeßbereich durch Trennschürzen separiert (Bild 3).“"
                            },
                            {
                                "example_id": "7351ed71-28e4-43cc-9c53-76f42ce4fc30",
                                "sense_id": "666adb57-c120-33fe-adf9-6fb204b59dd7",
                                "text": "„In Brügge soll das Bier bald in Strömen fließen: Um den Lkw-Verkehr durch die Stadt zu verringern, baut die Brauerei Halve Maan eine drei Kilometer lange Pipeline vom Werk zur Abfüllstation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
