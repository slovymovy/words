                                "target_senses": [
                                    {
                                        "sense_id": "e35234dc-384d-35ee-b7a4-1eacf2852770",
                                        "entry_id": "65439220-2f1a-369c-a1f4-ca06a2eb0b9b",
                                        "glosses": [
                                            "свойство по значению прилагательного анормальный; наличие в ком-, чём-либо черт, особенностей, свидетельствующих об отступлении от общепринятой нормы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e7da3a-60a0-486c-b471-940ba8830745",
                                                "sense_id": "e35234dc-384d-35ee-b7a4-1eacf2852770",
                                                "text": "Только тот человек, у которого есть какая-нибудь анормальность."
                                            },
                                            {
                                                "example_id": "bfd71009-b77e-493d-9c3a-f39e9a5a0731",
                                                "sense_id": "e35234dc-384d-35ee-b7a4-1eacf2852770",
                                                "text": "Германии необходимо было устранить эту «анормальность» в провинциях, граничащих с Францией."
                                            }
                                        ]
                                    }
                                ]
