                "senses": [
                    {
                        "sense_id": "29ade3bd-8a7a-383e-b49a-93fcfdd84353",
                        "entry_id": "3de155fc-4859-3b58-88d8-1666f24e571c",
                        "glosses": [
                            "Qui dure, qui se prolonge indéfiniment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d92ef6e-dedf-4af1-915f-fb79e1b7ba4c",
                                "sense_id": "29ade3bd-8a7a-383e-b49a-93fcfdd84353",
                                "text": "Champion de l’ordre établi, j’avais placé ma raison d’être dans un désordre perpétué."
                            },
                            {
                                "example_id": "c6c70735-3dd9-4598-83f8-931bd4fb6811",
                                "sense_id": "29ade3bd-8a7a-383e-b49a-93fcfdd84353",
                                "text": "Leur vie les bercerait. Elle s’étendrait au fil des mois, tout au long des années, sans changer, presque, sans jamais les contraindre. Elle ne serait que la suite harmonieuse des journées et des nuits, une modulation presque imperceptible, la reprise incessante des mêmes thèmes, un bonheur continu, une saveur perpétuée que nul bouleversement, nul événement tragique, nulle péripétie ne remettraient en question."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
