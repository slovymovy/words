                "senses": [
                    {
                        "sense_id": "3f01b623-3ac7-31e4-ba24-ae13cf8be140",
                        "entry_id": "6243f925-9a1b-39e1-a92b-6d5955162969",
                        "glosses": [
                            "nicht bestehbares Übungsszenario aus dem Star-Trek-Science-Fiction-Universum, mit dem das Verhalten der Probanden in ausweglosen Situationen getestet werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f52cc96-c726-4668-88d5-b0d1d5942805",
                                "sense_id": "3f01b623-3ac7-31e4-ba24-ae13cf8be140",
                                "text": "„Schon als Kadett der Sternenflotte gelangt James Tiberius Kirk zu einer karrierebestimmenden Entscheidung: Er manipuliert den Kobayashi-Maru-Test, ein Übungsszenario, das den Ausbildern zeigen soll, wie ihre Zöglinge mit ausweglosen Situationen umgehen.“"
                            },
                            {
                                "example_id": "c2d1cc4e-9df5-4750-8d9b-46020fb86bc1",
                                "sense_id": "3f01b623-3ac7-31e4-ba24-ae13cf8be140",
                                "text": "„Der Kobayashi-Maru-Test stellt angehende Sternenflottenoffiziere vor eine unlösbare Aufgabe, damit sie lernen, mit solchen Situationen umzugehen. “"
                            },
                            {
                                "example_id": "437925af-d126-4473-86b0-934a467f1d9a",
                                "sense_id": "3f01b623-3ac7-31e4-ba24-ae13cf8be140",
                                "text": "„Der Kobayashi-Maru-Test ist im fiktiven Star-Trek-Universum Teil der Ausbildung an der Sternenflottenakademie – und nun auch als Browserspiel in der Art eines Retro-Adventures nachspielbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
