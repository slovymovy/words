                    {
                        "sense_id": "5dd45ea3-5dfd-33f3-a0f1-e77f7f8ccdfb",
                        "entry_id": "54ffe108-a556-3329-aea2-a3028efe08e2",
                        "glosses": [
                            "Animal fabuleux de la mythologie chinoise, ayant une tête de dragon, un corps de cerf, des sabots de cheval et une queue de bœuf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d9fc3c-bbe7-4eae-939b-5afeff01baa9",
                                "sense_id": "5dd45ea3-5dfd-33f3-a0f1-e77f7f8ccdfb",
                                "text": "Le policier balaya de nouveau le pont des yeux et quelque chose retint son attention. L’homme de tout à l’heure s’appuyait au socle des statues de qilin qui ornent le pont."
                            }
                        ]
                    }
                ],
