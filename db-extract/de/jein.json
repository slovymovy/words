                        ],
                        "examples": [
                            {
                                "example_id": "7d7a6bd4-dabe-4c17-92c8-69e2ca9d7c50",
                                "sense_id": "5480ccbd-8465-3887-a70e-f0a68624b782",
                                "text": "Und ob ihr's glaubt oder nicht, mir geht es echt beschissen / Und während sich der Teufel und der Engel anschreien / Entscheide ich mich für ja, nein, ich mein jein!"
                            },
                            {
                                "example_id": "840d082f-cc1e-4550-a87a-a47addbd2c34",
                                "sense_id": "5480ccbd-8465-3887-a70e-f0a68624b782",
                                "text": "Gibt es einen Gott? – Ja. Ist er tot? – Jein.",
                                "translation": "Is there a God? – Yes. – Is he dead? – Yes and no.",
                                "english": "Is there a God? – Yes. – Is he dead? – Yes and no."
                            }
                        ]
                    }
                ],
