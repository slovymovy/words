            "senses": [
                {
                    "sense_id": "2034f05f-5cd7-3264-93cc-8f2580218852",
                    "sense_definition": "Formule employée pour présenter poliment des excuses ou exprimer un regret.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Désolé</w>, je ne peux pas venir avec vous ce soir."
                        },
                        {
                            "text": "<w>Désolé</w>, je n'ai pas entendu votre question tout à l'heure."
                        }
                    ],
                    "synonyms": [
                        "navré"
                    ]
                }
            ]
        },
        {
