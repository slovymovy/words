                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cbfdd5b1-2ae4-3701-bf95-3aab14599ad4",
                    "sense_definition": "To agree with or support a proposition after it has already been supported by three others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the motion was seconded and thirded, another member <w>fourthed</w> it.",
                            "target_lang_translations": {
                                "ru": "После того как предложение поддержали второй и третий участники, еще один член комитета <w>поддержал его четвёртым</w>."
                            }
                        },
                        {
                            "text": "The resolution was quickly <w>fourthed</w> by the committee members.",
                            "target_lang_translations": {
                                "ru": "Резолюция была быстро <w>поддержана четвёртым</w> участником комитета."
                            }
