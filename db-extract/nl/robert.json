                        "examples": [
                            {
                                "example_id": "5a2c0081-a2cb-4248-bf79-b6d21175865f",
                                "sense_id": "5a95a664-ed07-3799-8fca-17b81f6d3de3",
                                "text": "Robert was helemaal chagrijnig dat jij het zo goed hebt gedaan."
                            },
                            {
                                "example_id": "b9982e90-20ad-48b9-89fc-4fc201415a52",
                                "sense_id": "5a95a664-ed07-3799-8fca-17b81f6d3de3",
                                "text": "Op een dag zag ik dat ik vijf gemiste oproepen van Robert had."
                            },
                            {
                                "example_id": "8fda4a2d-140b-4b34-abef-d01822488992",
                                "sense_id": "5a95a664-ed07-3799-8fca-17b81f6d3de3",
                                "text": "De gemeente Den Haag is tevreden. Wethouder Robert Barker (Partij voor de Dieren) noemt de uitspraak een duurzame mijlpaal. \"Deze uitspraak laat zien dat gemeenten niet machteloos zijn, maar wel degelijk instrumenten hebben om de klimaatcrisis aan te pakken.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d256682-af5e-4334-858f-c7f6afc17275",
                        "source_entry_id": "57a4f8db-de3d-3f91-b26c-52897ecc069c",
                        "source_sense_id": "5a95a664-ed07-3799-8fca-17b81f6d3de3",
                        "target_lang_word": "Robert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
