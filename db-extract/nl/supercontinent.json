                "senses": [
                    {
                        "sense_id": "2a62d385-6ccb-36db-b2f6-7cd2396b2ff4",
                        "entry_id": "ba01c8f1-65f7-3a33-a25e-42fcc6eba6d7",
                        "glosses": [
                            "zeer grote landmassa die bestond uit meerdere continenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db0af33-e666-44b1-9a1b-8b89fb85e324",
                                "sense_id": "2a62d385-6ccb-36db-b2f6-7cd2396b2ff4",
                                "text": "In het genoemde tijdperk brak het supercontinent Pangea in stukken, waardoor de huidige continenten ontstonden. Dat ging gepaard met massaal vulkanisme, waardoor de biodiversiteit enorm afnam en veel primitieve reptielen uitstierven. De vlinders en motten lijken er juist van te hebben geprofiteerd. Ze zijn veel diverser geworden."
                            },
                            {
                                "example_id": "182e68f2-9910-4f12-8de1-f9c5b861de47",
                                "sense_id": "2a62d385-6ccb-36db-b2f6-7cd2396b2ff4",
                                "text": "De wetenschappers bekeken hoe het supercontinent Gondwana 130 miljoen jaar geleden uiteenviel. De enorme landmassa werd in de loop der eeuwen opgedeeld in Afrika, Zuid-Amerika, Antarctica, Australië en het Indiase subcontinent."
                            },
                            {
                                "example_id": "8f6cf866-5e0b-4893-96bc-a76303f1dfe7",
                                "sense_id": "2a62d385-6ccb-36db-b2f6-7cd2396b2ff4",
                                "text": "Uiteindelijk kwamen de Noren erachter dat er in de oertijd een strook land moet hebben gelegen tussen India en Madagaskar. Zij schatten dat die strook 750 miljoen jaar geleden is losgekomen van het alomvattende supercontinent dat toen bestond en dat het microcontinent ongeveer 85 miljoen jaar geleden door de oceaan is verzwolgen."
                            }
                        ]
                    }
