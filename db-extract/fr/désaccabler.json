                "senses": [
                    {
                        "sense_id": "a48a5f91-32fa-32d3-94bf-c3d5800bb719",
                        "entry_id": "9f46bc2a-7569-3f64-9e24-be22959039d7",
                        "glosses": [
                            "Faire cesser d’être accablé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5427f24-1a10-4540-853f-abf5bb634354",
                                "sense_id": "a48a5f91-32fa-32d3-94bf-c3d5800bb719",
                                "text": "Ils ont pour l’essentiel été narrés originellement sous forme de feuilleton destiné à une joyeuse bande de lutins, en vue d’agrémenter les nuits d’hiver – et de désaccabler les matins d’hiver lorsqu’il faut partir avant le jour."
                            },
                            {
                                "example_id": "824fca77-e17d-43b6-8d8f-5c1b6bb1b3a5",
                                "sense_id": "a48a5f91-32fa-32d3-94bf-c3d5800bb719",
                                "text": "Tu t’en veux de ne pas arriver à te désaccabler et à faire comme d’autres, qui profitent au moins de leur arrêt maladie pour entreprendre quelque chose."
                            }
                        ]
                    }
                ],
