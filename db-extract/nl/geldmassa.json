                        "examples": [
                            {
                                "example_id": "fa68e16b-0419-4ddb-b96c-d54d3ea42918",
                                "sense_id": "85e61269-4b4c-3d98-8b2c-c54f5d23c668",
                                "text": "Van die enorme geldmassa sijpelt amper twee procent door naar het amateurvoetbal of de kleinere clubs. 'De huidige vergoeding voor de opleiding van jonge talenten volstaat niet om kleinere clubs in staat te stellen zich te ontwikkelen."
                            },
                            {
                                "example_id": "22294fd8-423e-4d9c-af00-413a340473dd",
                                "sense_id": "85e61269-4b4c-3d98-8b2c-c54f5d23c668",
                                "text": "Ook bestaat de verwachting dat, naar gelang meer mijnbouw ondernemingen hun verborgen activa te gelde zullen maken, een grote geldmassa vrij zal komen die zijn weg zal vinden naar de aandelenbeurs."
                            },
                            {
                                "example_id": "a8fd3b84-707e-497d-a614-6ca034865a13",
                                "sense_id": "85e61269-4b4c-3d98-8b2c-c54f5d23c668",
                                "text": "Alleen hier in de Verenigde Staten loopt de cocaïne-omzet in de miljarden dollars, en voor zoveel geld zijn er altijd mensen bereid om alles te doen. Hoeveel handelskanalen rol je met zo'n infiltratie op? Eén, twee? Die worden toch direct vervangen door een nieuw kartel? De druk van die geldmassa is veel te groot.”"
                            }
                        ]
                    }
