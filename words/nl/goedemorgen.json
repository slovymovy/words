                    "sense_id": "9f353f64-1380-3d25-ad05-ed74eb8d410b",
                    "sense_definition": "Een groet die men in de ochtend gebruikt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Goedemorgen</w>\", zei de bakker toen ik de winkel binnenkwam.",
                            "target_lang_translations": {
                                "en": "\"<w>Good morning</w>,\" said the baker when I entered the shop.",
                                "ru": "«<w>Доброе утро</w>», — сказал пекарь, когда я вошел в магазин.",
                                "es": "\"<w>Buenos días</w>\", dijo el panadero cuando entré en la tienda.",
                                "it": "\"<w>Buongiorno</w>\", disse il panettiere quando entrai nel negozio.",
                                "pl": "\"<w>Dzień dobry</w>\", powiedział piekarz, kiedy wszedłem do sklepu.",
                                "de": "\"<w>Guten Morgen</w>\", sagte der Bäcker, als ich den Laden betrat.",
                                "fr": "\"<w>Bonjour</w>\", a dit le boulanger quand je suis entré dans le magasin.",
                                "cs": "\"<w>Dobré ráno</w>\", řekl pekař, když jsem vešel do obchodu.",
                                "tr": "\"<w>Günaydın</w>\", dedi fırıncı dükkana girdiğimde.",
                                "zh": "我走进店里时，面包师说：“<w>早上好</w>。”"
                            }
                        },
                        {
                            "text": "<w>Goedemorgen</w> allemaal, laten we beginnen met de vergadering.",
                            "target_lang_translations": {
                                "en": "<w>Good morning</w> everyone, let's start the meeting.",
                                "ru": "<w>Доброе утро</w> всем, давайте начнем собрание.",
                                "es": "<w>Buenos días</w> a todos, empecemos con la reunión.",
                                "it": "<w>Buongiorno</w> a tutti, iniziamo la riunione.",
                                "pl": "<w>Dzień dobry</w> wszystkim, zacznijmy spotkanie.",
                                "de": "<w>Guten Morgen</w> zusammen, lassen Sie uns mit der Besprechung beginnen.",
                                "fr": "<w>Bonjour</w> à tous, commençons la réunion.",
                                "cs": "<w>Dobré ráno</w> všem, začněme schůzi.",
                                "tr": "<w>Günaydın</w> herkese, toplantıya başlayalım.",
                                "zh": "<w>大家早上好</w>，我们开始开会吧。"
                            }
                        }
                    ],
