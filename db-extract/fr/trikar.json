                    {
                        "sense_id": "a137288d-f20c-3798-931f-a5aa3e731531",
                        "entry_id": "cd88c812-6052-3be9-975d-59de28d6e6a9",
                        "glosses": [
                            "Percer à jour, repérer quelqu'un."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec96f3a-8852-4c44-bcf4-31254e711ec4",
                                "sense_id": "a137288d-f20c-3798-931f-a5aa3e731531",
                                "text": "J'ai trikar dès le début qu'elle était pas nette."
                            },
                            {
                                "example_id": "1defcf30-e862-4806-a1ab-ef55c2b00544",
                                "sense_id": "a137288d-f20c-3798-931f-a5aa3e731531",
                                "text": "Sa mère l'a trikar en train de faire le mur l'autre jour."
                            },
                            {
                                "example_id": "fd9d23a4-9f21-4988-90d2-8a6156bee501",
                                "sense_id": "a137288d-f20c-3798-931f-a5aa3e731531",
                                "text": "Il s'est fait trikar à force de zoner dans le quartier."
                            }
                        ]
                    },
                    {
                        "sense_id": "eab2fc07-3b85-3c7e-b14a-dcc6aba06606",
                        "entry_id": "cd88c812-6052-3be9-975d-59de28d6e6a9",
                        "glosses": [
                            "Remarquer quelque chose."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "51d8bebf-ce78-42e7-8df8-f48b1331150f",
                                "sense_id": "eab2fc07-3b85-3c7e-b14a-dcc6aba06606",
                                "text": "J'avais même pas trikar qu'il était parti de la soirée !"
                            },
                            {
                                "example_id": "a438f78d-0a72-4c4e-bf00-1ffa3a81b8e0",
                                "sense_id": "eab2fc07-3b85-3c7e-b14a-dcc6aba06606",
                                "text": "Toi aussi t'as trikar que ce gars est bizarre ?"
                            }
                        ]
                    }
