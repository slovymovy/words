                                "target_senses": [
                                    {
                                        "sense_id": "5e63d428-3d06-36b0-ac70-79f83ff6a58e",
                                        "entry_id": "f4c21f52-7df2-3f59-a0be-10b466ca0c62",
                                        "glosses": [
                                            "An alcoholic, often sparkling (carbonated) beverage made from fermented apples; hard cider; apple cider."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Canada",
                                            "Ireland",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b47dcb-334b-4f1f-bebc-aee5d4d323d3",
                                                "sense_id": "5e63d428-3d06-36b0-ac70-79f83ff6a58e",
                                                "text": "The procedures for cyser are identical to cider with a notable exception: honey is a much more complex sugar than cane or corn sugars, meaning honey takes a long time to clear and an even longer time (at least six months) to ferment out[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91e7221e-0af5-349e-9bdb-966eace2d3df",
                                        "entry_id": "f4c21f52-7df2-3f59-a0be-10b466ca0c62",
                                        "glosses": [
                                            "A non-alcoholic still beverage consisting of the juice of early-harvest apples, usually unfiltered and still containing pulp; apple cider; sweet cider (without pulp such a beverage is called apple juice)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e81e4af0-5f38-42c7-a635-eb401b98ca70",
                                                "sense_id": "91e7221e-0af5-349e-9bdb-966eace2d3df",
                                                "text": "She liked an aged cider. He liked a harder cider."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867731e5-af8c-3891-b3b6-190b1f5e806a",
                                        "entry_id": "f4c21f52-7df2-3f59-a0be-10b466ca0c62",
