                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf37498f-aa9b-489c-a5f4-bc8053d2b21b",
                        "entry_id": "3fbd72cb-a33d-338f-8487-d48f3afff05f",
