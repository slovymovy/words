                        "form": "ellébore"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c80af59-3297-31a0-bef3-e83ffb8bc960",
                        "entry_id": "f855f3a8-b875-3226-9906-b1a66e449530",
                        "glosses": [
                            "Nom usuel des plantes du genre Helleborus de la famille des des Ranunculaceae (Renonculacées), dont certaines espèces étaient employées autrefois en médecine comme purgatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34bd4314-4927-4990-9b06-5dbc5d2fb36c",
                                "sense_id": "1c80af59-3297-31a0-bef3-e83ffb8bc960",
                                "text": "Des mandragores, des ciguës, des hellébores, des belladones, montait un vertige à leurs tempes."
                            },
                            {
                                "example_id": "9964bfea-9b23-4453-b638-d63850fa1d7f",
                                "sense_id": "1c80af59-3297-31a0-bef3-e83ffb8bc960",
                                "text": "Selon Adanson, la plante ainsi nommée par cet ancien botaniste, est une Hellébore."
                            },
                            {
                                "example_id": "c2b03ecf-3719-42ad-8709-2d24f72d330e",
                                "sense_id": "1c80af59-3297-31a0-bef3-e83ffb8bc960",
                                "text": "Le charme de cette promenade réside aussi dans la variété de la flore, fougères, immortelles, hellébore, lis et doronic corses qui illuminent le sous bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "696dcfed-68a6-3002-a37b-f9c3d25316e1",
                        "entry_id": "f855f3a8-b875-3226-9906-b1a66e449530",
                        "glosses": [
                            "Nom usuel des plantes du genre Helleborus de la famille des des Ranunculaceae (Renonculacées), dont certaines espèces étaient employées autrefois en médecine comme purgatif.",
                            "Hellébore d'hiver : Nom usuel de Eranthis hyemalis, plante tubéreuse, herbacée, de la famille des Ranunculaceae (Renonculacées) ; on la nomme aussi éranthe d'hiver ou hellébore d'hiver."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce68ca0a-d49a-3523-ae45-4a63a887e69b",
                        "entry_id": "f855f3a8-b875-3226-9906-b1a66e449530",
                        "glosses": [
                            "Nom usuel des plantes du genre Helleborus de la famille des des Ranunculaceae (Renonculacées), dont certaines espèces étaient employées autrefois en médecine comme purgatif.",
                            "Hellébore blanc : Nom usuel de Veratrum album, plante de la famille des Melanthiaceae nommée aussi faux hellébore."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4fd75dc-a6fc-4682-8a32-d32d833e1563",
                        "source_entry_id": "f855f3a8-b875-3226-9906-b1a66e449530",
