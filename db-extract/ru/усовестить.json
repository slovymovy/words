                                                "sense_id": "b8867260-5941-31a5-b9aa-54653d8e2bf3",
                                                "text": "Exhorter quelqu'un à la patience."
                                            },
                                            {
                                                "example_id": "d6fceb03-503b-4597-b25e-53136f2823ac",
                                                "sense_id": "b8867260-5941-31a5-b9aa-54653d8e2bf3",
