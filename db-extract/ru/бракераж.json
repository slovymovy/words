                                            {
                                                "example_id": "beb16d2f-3b0d-4e6e-b1b9-41488d0a72da",
                                                "sense_id": "17e714e0-29f2-3693-98a2-66357f1cd215",
                                                "text": "la nuova società di distribuzione sta cercando addetti qualificati per lo smistamento della merce in arrivo"
