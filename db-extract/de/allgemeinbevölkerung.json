                        "entry_id": "98f75fbe-35cc-30cb-851d-21a224b2d83b",
                        "glosses": [
                            "normale, durchschnittliche Bevölkerung im Gegensatz zu einer untersuchten Gruppe (zum Beispiel Patienten mit Diabetes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "357fa008-a056-42ee-86bd-f1b66afbf0f2",
                                "sense_id": "05850296-2c0e-36d7-9244-49d0a360bd1b",
                                "text": "„Rückenschmerzen sind ein weit verbreitetes Schmerzerlebnis. Die Lebenszeitprävalenz in Deutschland von akuten Rückenschmerzen liegt bei etwa 70 bis 80 %. Die Prävalenz chronischer Rückenschmerzen in der Allgemeinbevölkerung wird mit etwa 10 bis 21 % angegeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
