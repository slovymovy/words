                                        "entry_id": "c31ced41-fad8-35e3-8e1e-448cf8543312",
                                        "glosses": [
                                            "Appellation honorifique qu’on donne aux ambassadeurs, aux archevêques et évêques, et à certains autres prélats."
                                        ],
                                        "tags": [],
                                        "examples": [
