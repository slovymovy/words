                                    },
                                    {
                                        "sense_id": "b48872f2-3b94-3dc5-a69f-92e43fc3e4ea",
                                        "entry_id": "5a9214db-1d17-3366-8e32-77b6846b3123",
                                        "glosses": [
                                            "A person who praises another person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a66a63d-644d-49a9-b9e7-19feacec5ca5",
                                                "sense_id": "b48872f2-3b94-3dc5-a69f-92e43fc3e4ea",
                                                "text": "I consider, that so far as what is called military renown is concerned, the American Navy needs no eulogist but History."
                                            },
                                            {
                                                "example_id": "07eef92e-7399-44b4-b702-8b120af486e9",
                                                "sense_id": "b48872f2-3b94-3dc5-a69f-92e43fc3e4ea",
                                                "text": "I am his eulogist; but I am not in love with him. If he were to ask me to be his wife to-morrow, I should be distressed, and should refuse him."
                                            }
                                        ]
                                    }
