                    {
                        "sense_id": "d46f7ceb-0925-3d9a-966e-beef890cb7ca",
                        "entry_id": "bfa04f7f-bdbf-3e40-ac2d-547230aecffe",
                        "glosses": [
                            "nerwica polegająca na pobudliwości, drażliwości i szybkim wyczerpywaniem się układu nerwowego"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "30eacd42-01fc-49ec-8b19-87f674e44ea1",
                                "sense_id": "d46f7ceb-0925-3d9a-966e-beef890cb7ca",
                                "text": "Świadomość tego – pisze, „powoduje, że boję się przyszłego życia, jak marynarz morza, w które wypływa\", obawiał się bowiem, czy uda mu się zatrzymać na obecnym stadium neurastenii, czy też jego aktualny stan przerodzi się w „szaleństwo\""
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "877627c8-bac8-4f42-96d6-c5a68087f476",
                        "source_entry_id": "bfa04f7f-bdbf-3e40-ac2d-547230aecffe",
