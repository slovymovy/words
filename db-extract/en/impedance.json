                                        "entry_id": "1a34b76c-2147-323e-8fdc-812661d5bfff",
                                        "glosses": [
                                            "de frequentieafhankelijke mate waarin een materiaal het passeren van elektrische lading bemoeilijkt (schijnbare weerstand)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c9844c-bd0d-42e2-93eb-6e3cd5319be3",
                                                "sense_id": "0ce0b982-a203-39da-8cfe-95521f7898df",
                                                "text": "De impedantie is een complexe grootheid waarvan het reële deel de weerstand in de stroomkring vertegenwoordigt en het imaginaire een capaciteit of zelfinductie"
                                            }
                                        ]
                                    }
                                ]
