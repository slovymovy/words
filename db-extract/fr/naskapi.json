                    {
                        "sense_id": "f01b60bc-ea8a-3119-98be-3a59f53599eb",
                        "entry_id": "32bccdf4-38f9-316c-b52d-20d58f1ad33e",
                        "glosses": [
                            "Membre du peuple amérindien des Naskapis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f628b3cd-613d-4af8-bc89-d8ee707b33cd",
                                "sense_id": "f01b60bc-ea8a-3119-98be-3a59f53599eb",
                                "text": "Leur père, un Québécois venu travailler dans les mines de Schefferville, s’est installé dans la communauté après avoir rencontré leur mère, une Naskapie."
                            },
                            {
                                "example_id": "4e25384d-319f-4652-9516-98a592309a31",
                                "sense_id": "f01b60bc-ea8a-3119-98be-3a59f53599eb",
                                "text": "Lorsque l’agence ou le Protecteur des usagers examine la plainte d’un Naskapi bénéficiaire de la Convention du Nord-est québécois et dont le domicile est situé sur le territoire mentionné à l'article 530.89, ils doivent être assistés par un Naskapi bénéficiaire de la Convention du Nord-est québécois, nommé par le gouvernement sur la recommandation du conseil de la Nation Naskapi de Kawawachikamach."
                            }
                        ]
                    }
