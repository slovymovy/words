                    },
                    {
                        "translation_id": "bff82844-b503-4deb-b7b4-35474ddc31dc",
                        "source_entry_id": "47f0ad18-5513-3c5b-93d6-8e23e031aa2a",
                        "target_lang_word": "Teilsatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilsatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e88940-9029-3407-83eb-90e06a17b92f",
                                        "entry_id": "8e32011f-792d-3c67-a11c-fbe51007cc96",
                                        "glosses": [
                                            "Satz, der Bestandteil eines komplexen Satzes ist"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b564915-5e7d-419b-9437-b8106e8bb827",
                                                "sense_id": "81e88940-9029-3407-83eb-90e06a17b92f",
                                                "text": "Der Satz \"Peter kam, obwohl er sich schlecht fühlte\" besteht aus zwei Teilsätzen."
                                            },
                                            {
                                                "example_id": "4467e554-c058-435e-b874-4eddfd678eee",
                                                "sense_id": "81e88940-9029-3407-83eb-90e06a17b92f",
                                                "text": "„»Satz« heißt also hier immer der gesamte Satz, während Haupt- und Nebensätze als Gliedsätze oder Teilsätze bezeichnet werden.“"
                                            },
                                            {
                                                "example_id": "96986757-e620-4250-845d-64ce6307e60e",
                                                "sense_id": "81e88940-9029-3407-83eb-90e06a17b92f",
                                                "text": "„Man verbindet Satzreihen und Satzgefüge miteinander, auch Teilsätze und Aufzählungen gehören zu einem gutgebauten Text.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c93f62a-fc59-40ee-8b1f-038afeb6bef0",
                        "source_entry_id": "47f0ad18-5513-3c5b-93d6-8e23e031aa2a",
                        "target_lang_word": "Teilmenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilmenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                        "entry_id": "b08705ee-be19-393d-a652-d3626a212d01",
                                        "glosses": [
                                            "eine Menge, die nur Elemente einer anderen Menge enthält"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169eefb2-9f30-4290-bada-4012bbc65a26",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "Jede Menge hat die leere Menge zur Teilmenge."
                                            },
                                            {
                                                "example_id": "d2a8e135-c3c5-479c-bca4-90733fd46654",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "Die Teilmenge der Schüler dieser Klasse, die ihre Mathematikaufgaben richtig gelöst haben, die kann ich an den Fingern einer Hand abzählen."
                                            },
                                            {
                                                "example_id": "c0c488cd-2792-41ac-b2dd-21e64b343118",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "„Teilmengen achronaler Mengen sind achronal.“"
                                            },
                                            {
                                                "example_id": "3ae997df-e6b1-428c-b49f-be70379db93e",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "„Bei unendlichen Mengen ist es aber möglich, dass eine echte Teilmenge dieselbe Mächtigkeit hat wie ihre Grundmenge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
