                        "examples": [
                            {
                                "example_id": "912bf6f5-1936-43df-ae2e-afd53c8beace",
                                "sense_id": "2a7555bd-d438-3936-9dac-6abc104b7142",
                                "text": "Ein Kinobetreiber sollte Filmvorführungen ohne Publikum vermeiden."
                            },
                            {
                                "example_id": "7d7c4394-8774-4319-b686-0d19c5dda682",
                                "sense_id": "2a7555bd-d438-3936-9dac-6abc104b7142",
                                "text": "„Wenn Elsa von Filmvorführungen, Tanzveranstaltungen oder ihrem Heinz erzählte, war da dieses feine Brennen der Sehnsucht, das immer öfter nach bitterem Neid schmeckte.“"
                            },
                            {
                                "example_id": "ba81c782-73ef-4c96-8d56-039cf45a13ed",
                                "sense_id": "2a7555bd-d438-3936-9dac-6abc104b7142",
                                "text": "„Die Filmvorführung an diesem Abend war nicht gerade ein Erfolg.“"
                            }
                        ],
