                    {
                        "form_id": "07ea028a-6e3d-47c9-bb15-ad3036e0fcf8",
                        "entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "го́лях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16c63aa5-63fe-33e1-8aff-8d02274e672f",
                        "entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "glosses": [
                            "собир. бедняки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b5c727-2b1b-40d0-a481-fc328d0abd88",
                                "sense_id": "16c63aa5-63fe-33e1-8aff-8d02274e672f",
                                "text": "Завод с высокой трубой стоял на самом берегу; в полугоре тесно жались лачуги всякой голи и бедноты; там во дворе снимали мы у кого-то комнату за три рубля."
                            },
                            {
                                "example_id": "28745e45-588e-48cc-a18c-9086e55c9e66",
                                "sense_id": "16c63aa5-63fe-33e1-8aff-8d02274e672f",
                                "text": "Это ж ещё богачи так жили; а посмотрели бы на нашу братью, на голь: вырытая в земле яма ― вот вам и хата!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1d716038-7e67-32c5-87bc-d3a6581a4fa9",
                        "entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "glosses": [
                            "устар. бедность, нищета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa2764d-6f47-457d-9b72-babb3dd8f8e4",
                                "sense_id": "1d716038-7e67-32c5-87bc-d3a6581a4fa9",
                                "text": "Я смотрю на их бедные лица, на их бедные постели, на всю эту непроходимую голь и нищету, ― всматриваюсь ― и точно мне хочется увериться, что всё это не продолжение безобразного сна, а действительная правда."
                            }
                        ]
                    },
                    {
                        "sense_id": "d09af338-a3a8-3eaf-bbfb-394ecfa2eb02",
                        "entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "glosses": [
                            "голое, лишённое деревьев и построек место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2484946-42f7-46c3-814e-dd0d58da1cbb",
                                "sense_id": "d09af338-a3a8-3eaf-bbfb-394ecfa2eb02",
                                "text": "…и эта свежая, степная, тучная голь и глушь, эта зелень, эти длинные холмы, овраги с приземистыми дубовыми кустами, серые деревеньки, жидкие берёзы ― вся эта, давно им невиданная, русская картина навевала на его душу сладкие и в то же время почти скорбные чувства, давила грудь его каким-то приятным давлением."
                            },
                            {
                                "example_id": "61ee6781-8945-4309-9906-213b58ec1c7c",
                                "sense_id": "d09af338-a3a8-3eaf-bbfb-394ecfa2eb02",
                                "text": "Зелень, то есть деревья, за исключением мелких кустов, только и видна вблизи ферм, а то всюду голь, всё обнажено и иссушено солнцем, убито неистовыми, дующими с моря и с гор ветрами."
                            }
                        ]
                    },
                    {
                        "sense_id": "29244c60-9b85-35e0-9d35-a2d9a19fbef1",
                        "entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "glosses": [
                            "устар. вид китайской шёлковой ткани"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43977543-4937-4677-8cc9-c60f9f817277",
                                "sense_id": "29244c60-9b85-35e0-9d35-a2d9a19fbef1",
                                "text": "Между шёлкового товара главная статья суть камки или голи, которых по цене выходит больше половины всего шёлкового товара."
                            },
                            {
                                "example_id": "10daedce-d261-4901-a20c-5e06ebbe48c5",
                                "sense_id": "29244c60-9b85-35e0-9d35-a2d9a19fbef1",
                                "text": "― Да ещё государь наказывал голи разных цветов купить, да шёлку, да галуна."
                            }
                        ]
                    },
                    {
                        "sense_id": "c49a591b-4acc-389b-9ccc-b17f9f10a14e",
                        "entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "glosses": [
                            "устар. спорт. гол"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b43f014-899e-41b8-8207-8ed7965bf250",
                        "source_entry_id": "5285a32b-739a-3c9b-a262-e377c846a3eb",
                        "target_lang_word": "poverty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poverty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                                        "entry_id": "ae5c370d-636f-3c82-81dc-4ad5c3294dbf",
                                        "glosses": [
                                            "The quality or state of being poor; lack of money"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5033854a-56f0-4791-a0c0-98b9b2a25846",
                                                "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                                                "text": "get into poverty"
                                            },
                                            {
                                                "example_id": "3f21df34-c7bf-40d3-9e73-6c3bb86f1191",
                                                "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                                                "text": "get out of poverty"
                                            },
                                            {
                                                "example_id": "b8425f39-1287-43cd-a238-f74b466de2fe",
                                                "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                                                "text": "escape from poverty"
                                            },
                                            {
                                                "example_id": "8a8a714e-aeab-4985-8fcb-775059f5d13a",
                                                "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                                                "text": "From there Prince Rupert, the Royalist general and nephew of Charles I, demanded over £2,000 from the mayor of Leicester to pay the king's forces who were camped around Queniborough. The mayor, however, pleaded poverty and sent only £500."
                                            },
                                            {
                                                "example_id": "237e291f-50cb-4c4b-84d2-22de70f31b3b",
                                                "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                                                "text": "America’s poverty line is $63 a day for a family of four. In the richer parts of the emerging world $4 a day is the poverty barrier. But poverty’s scourge is fiercest below $1.25 (the average of the 15 poorest countries’ own poverty lines, measured in 2005 dollars and adjusted for differences in purchasing power): people below that level live lives that are poor, nasty, brutish and short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1c4f1b-b7b1-3641-a1fe-290ab23f97db",
                                        "entry_id": "ae5c370d-636f-3c82-81dc-4ad5c3294dbf",
                                        "glosses": [
                                            "A deficiency of something needed or desired"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfa897a1-089d-4dfa-b449-a1d236cf018c",
                                                "sense_id": "2e1c4f1b-b7b1-3641-a1fe-290ab23f97db",
                                                "text": "poverty of soil"
                                            },
                                            {
                                                "example_id": "6826e562-4b55-499d-992c-5fc2a15c426a",
                                                "sense_id": "2e1c4f1b-b7b1-3641-a1fe-290ab23f97db",
                                                "text": "poverty of the blood"
                                            },
                                            {
                                                "example_id": "c13566e4-aa5c-4415-93a9-704983e8cfeb",
                                                "sense_id": "2e1c4f1b-b7b1-3641-a1fe-290ab23f97db",
                                                "text": "poverty of spirit"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
