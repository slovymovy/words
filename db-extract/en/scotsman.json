                                            {
                                                "example_id": "cc4090a3-4ecd-475d-94e4-ddd3b4d5b461",
                                                "sense_id": "e0b98819-0ad9-3e6d-9dd3-f04fa23d4f4b",
                                                "text": "De Schotten wisten door Wallace en Robert de Bruce nog lang hun onafhankelijkheid te bewaren."
