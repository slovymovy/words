{
    "word_family": [
        "stamtąd",
        "stąd",
        "skądinąd"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "7577f140-3d30-3f92-b606-ca420121498e",
                    "sense_definition": "Zaimek pytający o miejsce początkowe ruchu lub pochodzenie.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "miejsce_pochodzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Skąd</w> jesteś i gdzie teraz mieszkasz?",
                            "target_lang_translations": {
                                "ru": "<w>Откуда</w> ты и где сейчас живешь?",
                                "en": "<w>Where</w> are you <w>from</w> and where do you live now?"
                            }
                        },
                        {
                            "text": "<w>Skąd</w> wracasz o tak późnej porze?",
                            "target_lang_translations": {
                                "ru": "<w>Откуда</w> ты возвращаешься в такое позднее время?",
                                "en": "<w>Where</w> are you coming back <w>from</w> at such a late hour?"
                            }
                        }
                    ],
                    "synonyms": [
                        "z jakiego miejsca"
                    ],
                    "antonyms": [
                        "dokąd"
                    ],
                    "common_phrases": [
                        "skąd jesteś",
                        "skąd wracasz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное местоимение, указывающее на исходный пункт движения или происхождение.",
                        "en": "An interrogative pronoun asking about the starting point of movement or origin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откуда",
                                "target_lang_sense_clarification": "из какого места, из какой страны"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "where from",
                                "target_lang_sense_clarification": "asking about origin or starting point"
                            },
                            {
                                "target_lang_word": "from where",
                                "target_lang_sense_clarification": "asking about origin or starting point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0c0670-bc13-3cc1-ac5b-c3df148a23cc",
                    "sense_definition": "Zaimek względny wprowadzający zdanie podrzędne określające miejsce początkowe ruchu lub pochodzenie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "miejsce_pochodzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wróciłem do miasta, <w>skąd</w> wyjechałem wiele lat temu.",
                            "target_lang_translations": {
                                "ru": "Я вернулся в город, <w>откуда</w> уехал много лет назад.",
                                "en": "I returned to the city <w>where</w> I had left from many years ago."
                            }
                        },
                        {
                            "text": "To jest kraj, <w>skąd</w> pochodzi moja rodzina.",
                            "target_lang_translations": {
                                "ru": "Это страна, <w>откуда</w> родом моя семья.",
                                "en": "This is the country <w>where</w> my family comes from."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tam skąd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относительное местоимение, вводящее придаточное предложение, определяющее исходный пункт движения или происхождение.",
                        "en": "A relative pronoun introducing a subordinate clause that specifies the starting point of movement or origin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откуда",
                                "target_lang_sense_clarification": "союзное слово в придаточном предложении"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "where",
                                "target_lang_sense_clarification": "relative pronoun indicating origin"
                            },
                            {
                                "target_lang_word": "from where",
                                "target_lang_sense_clarification": "relative pronoun indicating origin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b46098b-c05d-340f-8f91-551038f97060",
                    "sense_definition": "Zaimek pytający o przyczynę lub źródło informacji.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przyczyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Skąd</w> wiesz o naszych planach na weekend?",
                            "target_lang_translations": {
                                "ru": "<w>Откуда</w> ты знаешь о наших планах на выходные?",
                                "en": "<w>How</w> do you know about our plans for the weekend?"
                            }
                        },
                        {
                            "text": "<w>Skąd</w> u ciebie takie nagłe zainteresowanie historią?",
                            "target_lang_translations": {
                                "ru": "<w>Откуда</w> у тебя такой внезапный интерес к истории?",
                                "en": "<w>Where</w> does this sudden interest in history of yours come <w>from</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skąd wiesz",
                        "skąd to masz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное местоимение, указывающее на причину или источник информации.",
                        "en": "An interrogative pronoun asking about the cause or source of information."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откуда",
                                "target_lang_sense_clarification": "из какого источника, по какой причине"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "asking about the source of knowledge or reason"
                            },
                            {
                                "target_lang_word": "where from",
                                "target_lang_sense_clarification": "asking about the source of a state or information"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "ae4bde97-54fd-3f05-876d-28485699588e",
                    "sense_definition": "Partykuła służąca do wyrażenia zdecydowanego zaprzeczenia lub niezgody.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zaprzeczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Myślałem, że się spóźnisz, ale ależ <w>skąd</w>, byłeś przed czasem.",
                            "target_lang_translations": {
                                "ru": "Я думал, ты опоздаешь, но <w>вовсе нет</w>, ты пришел раньше времени.",
                                "en": "I thought you would be late, but <w>not at all</w>, you were early."
                            }
                        },
                        {
                            "text": "Czy gniewasz się na mnie? Ależ <w>skąd</w>, nic się nie stało!",
                            "target_lang_translations": {
                                "ru": "Ты сердишься на меня? <w>Да откуда там</w>, ничего не случилось!",
                                "en": "Are you angry with me? <w>Of course not</w>, nothing happened!"
                            }
                        }
                    ],
                    "synonyms": [
                        "skądże",
                        "skądże znowu",
                        "nic podobnego",
                        "gdzie tam"
                    ],
                    "common_phrases": [
                        "ależ skąd",
                        "skąd znowu"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w potocznych dialogach"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, служащая для выражения решительного отрицания или несогласия.",
                        "en": "A particle used to express strong denial or disagreement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да откуда там",
                                "target_lang_sense_clarification": "выражение несогласия"
                            },
                            {
                                "target_lang_word": "где там",
                                "target_lang_sense_clarification": "разговорное отрицание"
                            },
                            {
                                "target_lang_word": "вовсе нет",
                                "target_lang_sense_clarification": "решительное отрицание"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "not at all",
                                "target_lang_sense_clarification": "expressing strong denial"
                            },
                            {
                                "target_lang_word": "by no means",
                                "target_lang_sense_clarification": "expressing strong disagreement"
                            },
                            {
                                "target_lang_word": "of course not",
                                "target_lang_sense_clarification": "expressing strong denial"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}