                    "sense_id": "7fb0095d-7f39-3797-af39-610355f26a83",
                    "sense_definition": "Simple past and past participle of <w>treat</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor <w>treated</w> the patient for a minor infection.",
                            "target_lang_translations": {
                                "ru": "Врач <w>лечил</w> пациента от легкой инфекции.",
                                "cs": "Lékař <w>léčil</w> pacienta s lehkou infekcí."
                            }
                        },
                        {
                            "text": "She <w>treated</w> everyone with kindness and respect.",
                            "target_lang_translations": {
                                "ru": "Она <w>относилась</w> ко всем с добротой и уважением.",
                                "cs": "Ke všem se <w>chovala</w> s laskavostí a respektem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "treated with",
                        "treated for",
                        "treated as"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола treat.",
                        "cs": "Minulý čas a trpné příčestí od slovesa treat (léčit, jednat s někým, ošetřit)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечил",
