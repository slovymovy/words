                "senses": [
                    {
                        "sense_id": "aaf78897-5cf1-3857-8c51-67c68837cd27",
                        "entry_id": "2c57f9ef-0188-36e5-b7a6-1eb7d08575f5",
                        "glosses": [
                            "Liste, auf der Produkte mit besonders hohen Verkaufszahlen aufgeführt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1718dd-472a-44ec-8589-7acf2283bc84",
                                "sense_id": "aaf78897-5cf1-3857-8c51-67c68837cd27",
                                "text": "Die Bestsellerliste wird wöchentlich aktualisiert."
                            },
                            {
                                "example_id": "9b46e85e-6fe3-4957-895b-1ed4ef215754",
                                "sense_id": "aaf78897-5cf1-3857-8c51-67c68837cd27",
                                "text": "„Diese Vision, wenn auch weit von der Wahrheit über das Land entfernt, ließ »Polski Blues« lange Monate auf den Bestsellerlisten bleiben.“"
                            },
                            {
                                "example_id": "2fb27f30-f7ce-4203-b081-e0a70280061a",
                                "sense_id": "aaf78897-5cf1-3857-8c51-67c68837cd27",
                                "text": "„Sie würden eher irgendwelche Krimis oder die Sachbücher von der Bestsellerliste aus der Zelle holen, um zu erfahren, was hier in Deutschland Sache war, überlegte ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
