                        "sense_id": "281feb17-a35f-3277-8e3e-44150d6a298a",
                        "entry_id": "0e87106c-fc50-37ea-a7d3-a3b64c9db753",
                        "glosses": [
                            "To write or inscribe incorrectly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc8b066-1af8-4859-93f6-5698c47fbd3c",
                                "sense_id": "281feb17-a35f-3277-8e3e-44150d6a298a",
                                "text": "It seems reasonable to interpret this misscribing of common words as a fallout from improvement in other techniques, among them a greater concentration on content, a more automatic scribing of all words, a more rapid rate of production..."
                            },
                            {
                                "example_id": "d44f2bd3-97fd-41ce-9d89-44ac791768b5",
                                "sense_id": "281feb17-a35f-3277-8e3e-44150d6a298a",
                                "text": "The key was to speak the two correct words that had been misscribed in the inscription above."
                            },
                            {
                                "example_id": "cd69aaee-63ed-41e7-9537-0d2bb5a37dec",
                                "sense_id": "281feb17-a35f-3277-8e3e-44150d6a298a",
                                "text": "Or Andrea, who didn't even make it through a single night thanks to a teensy spot of docket misscribing that ..."
                            },
                            {
                                "example_id": "0359fd31-1a22-4a5b-82c4-45285424d15d",
                                "sense_id": "281feb17-a35f-3277-8e3e-44150d6a298a",
                                "text": "Others suggest it is a misscribed derivative of the Persian word for the river Indus or Sindhu."
                            }
                        ]
                    }
