            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2a3762e-8032-348f-84be-02d6b05cd884",
                    "sense_definition": "Extrémité du museau de certains grands mammifères comme les bovidés ou les fauves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vache approcha son grand <w>mufle</w> humide pour attraper une poignée d'herbe fraîche."
                        },
                        {
                            "text": "Le taureau soufflait bruyamment par les naseaux de son <w>mufle</w> en observant les passants."
                        }
                    ],
                    "common_phrases": [
                        "mufle humide"
                    ]
                },
                {
                    "sense_id": "72197ea7-03a3-3619-8299-f10397041c2e",
                    "sense_definition": "Homme indélicat, grossier et dépourvu de savoir-vivre envers les autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est comporté comme un parfait <w>mufle</w> en partant sans remercier ses hôtes."
                        },
                        {
                            "text": "Cet homme est un véritable <w>mufle</w> qui ne laisse jamais passer les gens."
                        }
                    ],
                    "synonyms": [
                        "goujat",
                        "malotru",
                        "rustre",
                        "butor",
                        "malappris"
                    ],
                    "common_phrases": [
