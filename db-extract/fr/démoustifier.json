                "senses": [
                    {
                        "sense_id": "fead4af9-7776-3f0a-9ab0-5909bd323fb8",
                        "entry_id": "98bd0f21-8388-37b5-8812-39904850ffd3",
                        "glosses": [
                            "Variante rare de démoustiquer (débarrasser des moustiques), qui est le terme standard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ed3a35-2b34-4f6f-b90a-ac3bf2337915",
                                "sense_id": "fead4af9-7776-3f0a-9ab0-5909bd323fb8",
                                "text": "A Alger, l'été a servi à désinfecter, démoustifier et dératiser certaines résidences et à s'assurer de l'étanchéité des sols dans d'autres."
                            },
                            {
                                "example_id": "d451c01a-a14b-401d-9693-262a8f03acee",
                                "sense_id": "fead4af9-7776-3f0a-9ab0-5909bd323fb8",
                                "text": "Des militaires pas gentils venus démoustifier chez un particulier ont sévèrement flytoxé le chien du propriétaire des lieux qui accourait vers eux en remuant la queue (le chien, pas le propriétaire)."
                            },
                            {
                                "example_id": "44e87dbf-4aff-4f24-9798-af6dd24fd5e9",
                                "sense_id": "fead4af9-7776-3f0a-9ab0-5909bd323fb8",
                                "text": "La zone est démoustifiée presque tous les jours, mais emportez quand même une protection efficace."
                            },
                            {
                                "example_id": "babecdd5-1fa3-4095-a985-f63d99f4742c",
                                "sense_id": "fead4af9-7776-3f0a-9ab0-5909bd323fb8",
                                "text": "Tu peux pas demander à la mairie qu'ils démoustifient la piscine ?"
                            }
                        ]
                    }
