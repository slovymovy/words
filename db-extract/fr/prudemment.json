                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorzichtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1dc9b0-dc14-34ac-b7a5-5adf9d95296c",
                                        "entry_id": "f78e5d97-edd3-371e-9d84-75fe9b42e255",
                                        "glosses": [
                                            "op een oplettende, rustige manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698f63e3-700d-47a9-97c2-83a5707dc617",
                                                "sense_id": "1a1dc9b0-dc14-34ac-b7a5-5adf9d95296c",
                                                "text": "Ben je voorzichtig met die glazen? Die kunnen beter niet stuk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voorzichtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f252079c-6c7e-38ec-8336-77d6ea28d715",
                                        "entry_id": "ff617ba2-0923-38ae-aad3-77f0fc8bfb48",
                                        "glosses": [
                                            "op een oplettende, rustige manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9525f07-b518-483e-bbd7-3880224e981c",
                                                "sense_id": "f252079c-6c7e-38ec-8336-77d6ea28d715",
                                                "text": "Eenmaal buiten wist ik me gelukkig nog net mijn roze fiets te herinneren en daarop reed ik voorzichtig richting de Best Western."
                                            },
                                            {
                                                "example_id": "76c0164b-3035-47a4-aea9-e2cc0a7ad432",
                                                "sense_id": "f252079c-6c7e-38ec-8336-77d6ea28d715",
                                                "text": "'Wat een geluk om zo'n fantastische man als jij te ontmoeten in dit kleine Brighton,'zei ze terwijl ze het half leeggedronken cognacglas voorzichtig uit zijn hand pakte, allebei hun glazen op het nachtkastje met de foto van haar man zette, zich snel over hem heen boog en hem kuste zodat hij buiten adem raakte."
                                            },
                                            {
                                                "example_id": "bfb5b507-017b-4b66-adc3-97b5182af08e",
                                                "sense_id": "f252079c-6c7e-38ec-8336-77d6ea28d715",
                                                "text": "De schietpartijen leidden tot angst onder bewoners van Rotterdam-IJsselmonde. Toen duidelijk was dat het mogelijk om willekeurige slachtoffers ging, riep de politie mensen op om extra voorzichtig te zijn en niet alleen naar buiten te gaan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voorzichtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "32633af5-0b9f-38e8-ab6e-b9893ab730e6",
                                        "entry_id": "4a710d56-4f8c-3290-8111-e6fbccb4067a",
                                        "glosses": [
                                            "op een zorgzame manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c30cc2-1c39-4bdc-9ef5-8e6538f3fc06",
                                                "sense_id": "32633af5-0b9f-38e8-ab6e-b9893ab730e6",
                                                "text": "Sinterklaas maakte de gesp van zijn mooie rode mantel los en legde die voorzichtig om de schouders van de heks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
