                "senses": [
                    {
                        "sense_id": "10a1880f-71d9-3897-8bc9-0fdb045db1f1",
                        "entry_id": "f6e03989-68c6-3696-ad39-2b3455e26a90",
                        "glosses": [
                            "ein Einwohner, Bewohner der Stadt Straubing, eine in Straubing geborene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15112ffb-9d6d-4102-98c0-c95861f6c12f",
                                "sense_id": "10a1880f-71d9-3897-8bc9-0fdb045db1f1",
                                "text": "Als Straubinger geht er regelmäßig auf's Gäubodenfest."
                            },
                            {
                                "example_id": "12392884-9767-4ca0-adae-31336f8a2035",
                                "sense_id": "10a1880f-71d9-3897-8bc9-0fdb045db1f1",
                                "text": "„Dieser gelehrte Mann ist vermutlich ein gebürtiger Straubinger gewesen, dort zur Schule gegangen und seit 1401 in St. Mang in Regensburg zu finden, wo er etwa 1438 starb.“"
                            },
                            {
                                "example_id": "46bc8b9c-f607-49f9-910f-436482fb4b3f",
                                "sense_id": "10a1880f-71d9-3897-8bc9-0fdb045db1f1",
                                "text": "„Trotzdem schaffen es die Straubinger, optimistisch in die Zukunft zu blicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
