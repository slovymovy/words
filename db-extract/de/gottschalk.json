                            },
                            {
                                "example_id": "941f0c57-b273-4aef-9803-5553e42515c4",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "Herr Gottschalk wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "404b1375-372d-4962-bbce-a2e5e83b004f",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "Die Gottschalks kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "f0f497ca-b014-4d9b-b396-0a388892e8c0",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "Der Gottschalk trägt nie die Schals, die die Gottschalk ihm strickt."
                            },
                            {
                                "example_id": "04cb821b-004f-4a30-926e-f74464fb3e46",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gottschalk kommt, geht der Herr Gottschalk.“"
                            },
                            {
                                "example_id": "8b8a646a-2b39-4a34-8ef7-44fd411aa604",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "Gottschalk kommt und geht."
                            },
                            {
                                "example_id": "ab455bbc-d3b1-4b24-845f-0dc43c32cd07",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "Gottschalks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "dab794eb-c449-4eeb-9377-763dbf1abf10",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "An verregneten Herbsttagen ist Familie Gottschalks liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "87fa3afb-4adc-414d-9e55-909a09edbceb",
                                "sense_id": "25b88384-be1b-3355-a423-80388c750355",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Gottschalk das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
