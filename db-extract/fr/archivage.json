                "senses": [
                    {
                        "sense_id": "95f6e5eb-185b-308a-a13a-247763371e8f",
                        "entry_id": "4c7d85e0-e539-3381-8ed7-b584cc6adb58",
                        "glosses": [
                            "Action d'archiver, de mettre en archives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9976682a-9dd0-46ac-9330-ead1342c9257",
                                "sense_id": "95f6e5eb-185b-308a-a13a-247763371e8f",
                                "text": "L’encombrement était la principale motivation de l’archivage : on ne pouvait pas pousser les murs des bureaux et administrations."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4452913-2206-339e-ad09-fbcde549b385",
                        "entry_id": "4c7d85e0-e539-3381-8ed7-b584cc6adb58",
                        "glosses": [
                            "Sauvegarde et stockage d'un document électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e44fdd-1803-484b-9c20-f4f0195a1825",
                                "sense_id": "b4452913-2206-339e-ad09-fbcde549b385",
                                "text": "L’archivage peut être simple ou combiné avec du compactage."
                            }
                        ]
                    },
                    {
                        "sense_id": "9acfc3d1-a00d-30e4-98d6-d5b6fa525d21",
                        "entry_id": "4c7d85e0-e539-3381-8ed7-b584cc6adb58",
                        "glosses": [
                            "Conservation de documents cartographiques disposés suivant un ordre systématique permettant leur consultation ultérieure."
                        ],
                        "tags": [
                            "Documentation"
                        ],
                        "examples": [
                            {
                                "example_id": "cff777a2-5959-4fe2-b217-b6e265119792",
                                "sense_id": "9acfc3d1-a00d-30e4-98d6-d5b6fa525d21",
                                "text": "Il semble que l’archivage des documents, pourtant fonction première du Dépôt des cartes et plans de la Marine, ne soit pas très efficace."
                            }
                        ]
                    }
