                        "target_lang_word": "При́пять",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "При́пять",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e6622e-323e-38cc-942d-049311d32334",
                                        "entry_id": "29b28947-aa94-3370-a847-d39ed9a38d82",
                                        "glosses": [
                                            "река в Белоруссии и в Украине, правый приток Днепра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8516513f-2cea-436d-a289-0d660ac32be1",
                                                "sense_id": "d6e6622e-323e-38cc-942d-049311d32334",
                                                "text": "Им удалось дойти до реки Припять и переправиться через нее на лодках."
                                            },
                                            {
                                                "example_id": "04ec2c5b-12c9-43b9-aff6-0ecc65104929",
                                                "sense_id": "d6e6622e-323e-38cc-942d-049311d32334",
                                                "text": "Исток Припяти на Украине, затем течет она по Белоруссии, снова возвращается на Украину и впадает в Днепр."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fd5b19-7789-3564-953a-60e97bfd38da",
                                        "entry_id": "29b28947-aa94-3370-a847-d39ed9a38d82",
                                        "glosses": [
                                            "покинутый город в Киевской области Украины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c05208a-c30b-4385-aa0b-8c0847f071a4",
                                                "sense_id": "46fd5b19-7789-3564-953a-60e97bfd38da",
                                                "text": "Жутко от вида пустых деревень и пустого города Припять с пустыми домами и детскими площадками."
                                            },
                                            {
                                                "example_id": "52bcab58-809f-4bfa-87c8-229f1c20cfbf",
                                                "sense_id": "46fd5b19-7789-3564-953a-60e97bfd38da",
                                                "text": "Осенью провалы окон заброшенных домов в Припяти скрывает листва, по стенам вьются, забираясь в пустые квартиры, лозы дикого винограда."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
