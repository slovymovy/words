                        {
                            "text": "The coach emphasized the importance of a heavy <w>sprawl</w> during defensive drills.",
                            "target_lang_translations": {
                                "ru": "Тренер подчеркнул важность жесткого <w>отброса ног</w> во время отработки защиты."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in wrestling and MMA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитный прием в борьбе для противодействия тейкдауну путем резкого опускания бедер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрол",
