    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a56f9fe-51e9-398d-829a-c18a013e7319",
                    "sense_definition": "Placer une personne, un animal ou une chose dans un endroit ou une position déterminée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il va <w>mettre</w> les livres sur l'étagère du salon."
                        },
                        {
                            "text": "Elle a <w>mis</w> les clés dans son sac avant de sortir."
                        }
                    ],
                    "synonyms": [
                        "placer",
                        "poser"
                    ],
                    "antonyms": [
                        "enlever"
                    ],
                    "common_phrases": [
                        "mettre de côté",
                        "mettre en place"
                    ]
                },
                {
                    "sense_id": "3360287f-8fcc-362f-8555-c8304eead002",
                    "sense_definition": "Revêtir un vêtement, porter une parure ou chausser un accessoire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu devrais <w>mettre</w> un manteau chaud car la température baisse rapidement."
                        },
                        {
                            "text": "Il <w>met</w> toujours ses lunettes pour lire le journal du matin."
                        }
                    ],
                    "antonyms": [
                        "enlever"
                    ],
                    "common_phrases": [
                        "mettre un manteau",
                        "mettre ses chaussures"
                    ]
                },
                {
                    "sense_id": "60d51e1c-8e9e-3f7e-9e11-e0de39c20d9f",
                    "sense_definition": "Disposer les assiettes, les verres et les couverts en vue d'un repas.",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aident régulièrement leurs parents à <w>mettre</w> la table."
                        },
                        {
                            "text": "Peux-tu <w>mettre</w> le couvert pendant que je prépare le dîner ?"
                        }
                    ],
                    "common_phrases": [
                        "mettre la table",
                        "mettre le couvert"
                    ]
                },
                {
                    "sense_id": "3a7b29d8-23e6-3076-b4b6-5e5559691663",
                    "sense_definition": "Consacrer ou nécessiter une certaine durée pour accomplir quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "duree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons <w>mis</w> deux heures pour arriver jusqu'au sommet de la colline."
                        },
                        {
                            "text": "Le train <w>met</w> beaucoup de temps pour traverser cette région montagneuse."
                        }
                    ],
                    "common_phrases": [
                        "mettre du temps",
                        "mettre deux heures"
                    ]
                },
                {
                    "sense_id": "8b741c71-f058-39b5-b84d-75353a6a43b2",
                    "sense_definition": "Commencer une action, entreprendre une activité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "debut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il rentre des cours, il se <w>met</w> au travail."
                        },
                        {
                            "text": "Le vent se lève et la pluie se <w>met</w> à tomber violemment."
                        }
                    ],
                    "common_phrases": [
                        "se mettre au travail",
                        "se mettre en route"
                    ]
                },
                {
                    "sense_id": "ddc6de31-0764-3c0c-bac6-a39062fa6cbf",
                    "sense_definition": "Inscrire, noter ou faire figurer par écrit sur un support.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>mettre</w> ton nom en haut de la page."
                        },
                        {
                            "text": "Il a préféré <w>mettre</w> toutes ses explications par écrit."
                        }
                    ],
                    "common_phrases": [
                        "mettre par écrit",
                        "mettre son nom"
                    ]
                },
                {
                    "sense_id": "76badee1-a7a1-3600-b7e9-03485fccbd41",
                    "sense_definition": "Faire passer une personne ou une chose d'un état à un autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "changement_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette initiative risquée pourrait bien <w>mettre</w> en danger toute notre entreprise."
                        },
                        {
                            "text": "Ces remarques injustes ont fini par <w>mettre</w> mon frère très en colère."
                        }
                    ],
                    "common_phrases": [
                        "mettre en danger",
                        "mettre en colère"
                    ]
                },
                {
                    "sense_id": "870abe43-ea4a-3490-9caf-1d8c0f7ab321",
                    "sense_definition": "Placer, dépenser ou investir une somme d'argent dans une opération.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de <w>mettre</w> toutes leurs économies dans ce projet immobilier."
                        },
                        {
                            "text": "Si tu veux du matériel fiable, il faut accepter d'y <w>mettre</w> le prix."
                        }
                    ],
                    "common_phrases": [
                        "mettre de l'argent",
                        "mettre le prix"
                    ]
                },
                {
                    "sense_id": "da18c148-5551-32ca-b995-b41a9540aa08",
                    "sense_definition": "Admettre ou supposer un fait à titre d'hypothèse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hypothese",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mettons</w> que le devis soit accepté aujourd'hui, quand pourrons-nous commencer ?"
                        },
                        {
                            "text": "<w>Mettez</w> que je n'aie rien dit et continuons normalement la séance."
                        }
                    ],
                    "common_phrases": [
                        "mettons que"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à l'impératif dans la conversation"
                        }
                    ]
                }
            ]
        }
    ]
