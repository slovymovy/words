                "senses": [
                    {
                        "sense_id": "b6e3d5dd-16e8-375a-b941-838acb21a549",
                        "entry_id": "ded3ce3f-58be-3282-9093-dd95a045cdf9",
                        "glosses": [
                            "Weg, der durch einen Garten führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d84367-f7bb-462f-9d36-ef6880c8bd6d",
                                "sense_id": "b6e3d5dd-16e8-375a-b941-838acb21a549",
                                "text": "„Er kam die Stufen herunter und betrat den Gartenweg, der direkt zu meinem Versteck führte.“"
                            },
                            {
                                "example_id": "9c94235a-d96a-4ec4-a9aa-33aa75895de5",
                                "sense_id": "b6e3d5dd-16e8-375a-b941-838acb21a549",
                                "text": "„Wir machten Wettrennen auf dem Gartenweg und waren mal Teilnehmer und mal Schiedsrichter.“"
                            },
                            {
                                "example_id": "d9b661e3-0f46-4bb0-bb54-298605dbbfb9",
                                "sense_id": "b6e3d5dd-16e8-375a-b941-838acb21a549",
                                "text": "„Es gibt jedoch eine Kostenteilung, wenn dem Nachbarn durch den Überhang ein Schaden droht oder entstanden ist, weil zum Beispiel die Wurzeln einen asphaltierten Gartenweg sprengen oder heruntertropfendes Harz das Auto beschädigt.“"
                            },
                            {
                                "example_id": "31108156-99d4-4764-9c0b-1ac4c0cf96ca",
                                "sense_id": "b6e3d5dd-16e8-375a-b941-838acb21a549",
                                "text": "„Sie liefen hinter das Haus über einen kiesbestreuten Gartenweg, der Franzose zupfte Pierre am Arm und zeigte auf ein Boskett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
