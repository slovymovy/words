                        "examples": [
                            {
                                "example_id": "de07d716-fa89-4824-9065-0016a901ef1e",
                                "sense_id": "069c206b-a1c7-338e-bbc9-855170529a3f",
                                "text": "Ik moet de grasmaaier van de schuur halen om het gazon te maaien.",
                                "translation": "I need to get the lawnmower out of the shed to mow the lawn.",
                                "english": "I need to get the lawnmower out of the shed to mow the lawn."
                            },
                            {
                                "example_id": "0c915b78-eee7-4b34-ba08-ed3d8219fbc0",
                                "sense_id": "069c206b-a1c7-338e-bbc9-855170529a3f",
                                "text": "Onze grasmaaier is stuk, dus we moeten een nieuwe kopen.",
                                "translation": "Our lawnmower is broken, so we need to buy a new one.",
                                "english": "Our lawnmower is broken, so we need to buy a new one."
                            },
                            {
                                "example_id": "975e7259-0335-4167-9078-46942bd49abf",
                                "sense_id": "069c206b-a1c7-338e-bbc9-855170529a3f",
                                "text": "Ze stootte per ongeluk tegen de grasmaaier in de garage.",
                                "translation": "She accidentally bumped into the lawnmower in the garage.",
                                "english": "She accidentally bumped into the lawnmower in the garage."
                            }
                        ]
                    }
