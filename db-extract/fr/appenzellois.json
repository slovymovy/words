                        "cross_references": [
                            {
                                "target_word": "Appenzeller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac036f1-d8fe-3119-b29f-47528c48c3fc",
                                        "entry_id": "10815007-a088-3f2e-b244-af2dcd1a42c8",
                                        "glosses": [
                                            "Bürger eines der beiden Schweizer Halbkantone Appenzell Ausserrhoden und Appenzell Innerrhoden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031232c0-f48b-4e21-9d0d-65eebb8b8a1d",
                                                "sense_id": "0ac036f1-d8fe-3119-b29f-47528c48c3fc",
                                                "text": "Pascal Zuberbühler ist Appenzeller."
                                            },
                                            {
                                                "example_id": "bd016b4c-5146-461b-9fb4-e8a07dbb7fe8",
                                                "sense_id": "0ac036f1-d8fe-3119-b29f-47528c48c3fc",
                                                "text": "„So ging das Heer den vorbereiteten Appenzellern und Schwyzern regelrecht in die Falle.“"
                                            },
                                            {
                                                "example_id": "83953b93-74e9-451f-a031-bd9d7172347e",
                                                "sense_id": "0ac036f1-d8fe-3119-b29f-47528c48c3fc",
                                                "text": "„\"Ohne sichtbare Emotionen\", so schreibt die Lokalpresse, nahm der regierende Landamman, also der höchste Appenzeller, Beat Graf, vom Verdikt Kenntnis.“"
                                            },
                                            {
                                                "example_id": "e9730519-014f-4661-aede-9867e79e8a52",
                                                "sense_id": "0ac036f1-d8fe-3119-b29f-47528c48c3fc",
                                                "text": "„Ins Zentrum des Platzes, in den sogenannten Ring, dürfen nur die Appenzeller. Dafür sorgen Feuerwehrleute, in deren goldenen Helmen sich die bunten Malereien der Fassaden spiegeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ceb1afd-86b5-3a93-a8fa-21b19ec49b0b",
                                        "entry_id": "10815007-a088-3f2e-b244-af2dcd1a42c8",
                                        "glosses": [
                                            "der Appenzeller Käse, eine Schweizer Käsesorte"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079f2292-eec3-4b55-8b41-7933ce628088",
                                                "sense_id": "8ceb1afd-86b5-3a93-a8fa-21b19ec49b0b",
                                                "text": "Appenzeller zählt nicht zu meinen Lieblingskäsesorten, aber mein Mann liebt ihn."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
