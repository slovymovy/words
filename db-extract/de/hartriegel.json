                "senses": [
                    {
                        "sense_id": "6b8a1528-cb41-3e86-98f8-9b5cb4a45718",
                        "entry_id": "95b47603-487a-38ee-9dd4-82a5ae4c070b",
                        "glosses": [
                            "Laubgehölz der Gattung Cornus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53ba76a-0868-4fb4-87b4-ade7aab6325d",
                                "sense_id": "6b8a1528-cb41-3e86-98f8-9b5cb4a45718",
                                "text": "Der Hartriegel ist auf der Nordhalbkugel weit verbreitet."
                            },
                            {
                                "example_id": "74391d83-efa1-437f-b942-769d47e1215b",
                                "sense_id": "6b8a1528-cb41-3e86-98f8-9b5cb4a45718",
                                "text": "Die Eigenschaft des Hartriegels, dass die Rinde beim Trocknen fest mit dem Holz verbunden bleibt, führt zu einer besonders guten und angenehmen Haptik."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
