                        "glosses": [
                            "Nuage de pollution recouvrant périodiquement Athènes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f17ef4b-026e-4938-b425-023aad3c7e24",
                                "sense_id": "11f7fe6e-0e2b-325d-b58c-4f95af0b60cc",
                                "text": "Cette pollution est redevenue visible, comme le « néfos » qui a pendant des années suffoqué la capitale grecque, entourée de montagnes, avant une modernisation de son parc automobile et de ses transports en commun."
                            },
                            {
                                "example_id": "5d9b6480-898f-4b98-bfad-5cc23400ed7f",
                                "sense_id": "11f7fe6e-0e2b-325d-b58c-4f95af0b60cc",
                                "text": "Le néfos, qui désigne le nuage brunâtre de pollution, est une véritable chape de dioxyde de souffre, de monoxyde de carbone, et d’ozone qui surplombe la ville, en hiver (en situation anticyclonique stable) ou en été, quand la température dépasse 34°C."
                            }
                        ]
                    }
