{
    "word_family": [
        "simple",
        "simplicity",
        "simplify",
        "simplification",
        "simplism",
        "simplist"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                    "sense_definition": "Used to emphasize that something is only what is stated, with nothing else added.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>simply</w> asking a question to understand the situation better.",
                            "target_lang_translations": {
                                "ru": "Я <w>просто</w> задавал вопрос, чтобы лучше понять ситуацию.",
                                "zh": "我<w>只是</w>问个问题，想更好地了解情况。"
                            }
                        },
                        {
                            "text": "You <w>simply</w> need to sign the document and return it to us.",
                            "target_lang_translations": {
                                "ru": "Вам <w>просто</w> нужно подписать документ и вернуть его нам.",
                                "zh": "你<w>只需</w>在文件上签字并交还给我们即可。"
                            }
                        }
                    ],
                    "synonyms": [
                        "just",
                        "merely",
                        "only"
                    ],
                    "common_phrases": [
                        "simply because",
                        "pure and simple",
                        "quite simply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы подчеркнуть, что речь идет только о сказанном, без каких-либо дополнений.",
                        "zh": "用于强调某事仅限于所陈述的内容，没有其他附加成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "всего лишь, не более того"
                            },
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "исключительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "只是",
                                "target_lang_sense_clarification": "仅仅，不过是"
                            },
                            {
                                "target_lang_word": "仅仅",
                                "target_lang_sense_clarification": "表示限于某个范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d47a07a-ad66-3934-90dd-1b9f73795e4a",
                    "sense_definition": "In a plain, uncomplicated, or natural manner; without decoration or difficulty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers to dress <w>simply</w> in jeans and a white shirt.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает одеваться <w>просто</w>, в джинсы и белую рубашку.",
                                "zh": "她喜欢穿得<w>朴素</w>些，通常是牛仔裤配白衬衫。"
                            }
                        },
                        {
                            "text": "The teacher explained the complex theory <w>simply</w> so the students could understand.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил сложную теорию <w>просто</w>, чтобы студенты могли понять.",
                                "zh": "老师把复杂的理论<w>简单地</w>解释了一遍，以便学生们能听懂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clearly",
                        "plainly",
                        "naturally",
                        "easily"
                    ],
                    "antonyms": [
                        "complexly"
                    ],
                    "common_phrases": [
                        "live simply",
                        "dress simply",
                        "explain simply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простым, несложным или естественным образом; без украшений или трудностей.",
                        "zh": "以平实、不复杂或自然的方式；没有装饰或困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "несложно, понятно"
                            },
                            {
                                "target_lang_word": "скромно",
                                "target_lang_sense_clarification": "без излишеств, небогато"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简单地",
                                "target_lang_sense_clarification": "不复杂地"
                            },
                            {
                                "target_lang_word": "朴素地",
                                "target_lang_sense_clarification": "不加修饰地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                    "sense_definition": "Used to emphasize a statement or description; absolutely or completely.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was <w>simply</w> breathtaking.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был <w>просто</w> захватывающим.",
                                "zh": "山顶的景色<w>简直</w>美得令人窒息。"
                            }
                        },
                        {
                            "text": "It is <w>simply</w> impossible to finish all this work in one hour.",
                            "target_lang_translations": {
                                "ru": "<w>Просто</w> невозможно закончить всю эту работу за один час.",
                                "zh": "在一小时内完成所有这些工作<w>简直</w>是不可能的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absolutely",
                        "completely",
                        "positively",
                        "really",
                        "truly",
                        "totally"
                    ],
                    "common_phrases": [
                        "simply wonderful",
                        "simply the best",
                        "simply beautiful"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления утверждения или описания; абсолютно или совершенно.",
                        "zh": "用于加强陈述或描述的语气；绝对地或完全地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "усилительная частица"
                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "абсолютно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简直",
                                "target_lang_sense_clarification": "用于加强语气，表示程度极深"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "彻底地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                    "sense_definition": "Used to introduce a summary or a direct statement of the truth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Simply</w>, we do not have enough money to buy the new car.",
                            "target_lang_translations": {
                                "ru": "<w>Попросту</w> говоря, у нас нет денег на покупку новой машины.",
                                "zh": "<w>简单来说</w>，我们没有足够的钱买那辆新车。"
                            }
                        },
                        {
                            "text": "To put it <w>simply</w>, the project has failed to meet its goals.",
                            "target_lang_translations": {
                                "ru": "Если говорить <w>просто</w>, проект не достиг своих целей.",
                                "zh": "<w>直白地说</w>，这个项目没能达到预定目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frankly",
                        "honestly",
                        "basically"
                    ],
                    "common_phrases": [
                        "put simply",
                        "stated simply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения краткого итога или прямого утверждения истины.",
                        "zh": "用于引出总结或对事实的直接陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попросту",
                                "target_lang_sense_clarification": "напрямик, без церемоний"
                            },
                            {
                                "target_lang_word": "проще говоря",
                                "target_lang_sense_clarification": "коротко и ясно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简单来说",
                                "target_lang_sense_clarification": "概括地讲"
                            },
                            {
                                "target_lang_word": "直白地说",
                                "target_lang_sense_clarification": "坦率地陈述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                    "sense_definition": "In a foolish, stupid, or naive manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>simply</w> believed the stranger's story without asking for any proof.",
                            "target_lang_translations": {
                                "ru": "Он <w>по наивности</w> поверил рассказу незнакомца, не потребовав никаких доказательств.",
                                "zh": "他<w>天真地</w>相信了那个陌生人的话，连证据都没要。"
                            }
                        },
                        {
                            "text": "The child <w>simply</w> wandered into the forest, unaware of the dangers.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>по глупости</w> забрел в лес, не подозревая об опасностях.",
                                "zh": "孩子<w>愚蠢地</w>走进了森林，完全没意识到危险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foolishly",
                        "stupidly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage is largely obsolete in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупым или наивным образом.",
                        "zh": "以愚蠢、笨拙或天真的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по наивности",
                                "target_lang_sense_clarification": "простодушно"
                            },
                            {
                                "target_lang_word": "по глупости",
                                "target_lang_sense_clarification": "необдуманно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天真地",
                                "target_lang_sense_clarification": "单纯地，缺乏经验地"
                            },
                            {
                                "target_lang_word": "愚蠢地",
                                "target_lang_sense_clarification": "不明智地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}