                        "sense_id": "9cd4e71e-0834-30f5-bace-398151bab07d",
                        "entry_id": "a296d7b1-7446-32bd-820c-59f65638b6fd",
                        "glosses": [
                            "Femme impliquée dans la propriété ou la gestion d’entreprise, cheffesse d’industrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650c6d29-9b98-4f13-b3cc-6d833776adf0",
                                "sense_id": "9cd4e71e-0834-30f5-bace-398151bab07d",
                                "text": "« Chez Natixis, je réagirai différemment des autres parce que je suis une industrielle, et non parce que je suis une femme », affirme-t-elle."
                            },
                            {
                                "example_id": "3ce589c8-266f-4259-bf4c-9f9c89d3a347",
                                "sense_id": "9cd4e71e-0834-30f5-bace-398151bab07d",
                                "text": "Un distributeur, un producteur de lait et une industrielle donnent leur vision de la crise que traverse le beurre."
                            },
                            {
                                "example_id": "de906e6c-b7d8-49bc-86ff-5db3a6f6d177",
                                "sense_id": "9cd4e71e-0834-30f5-bace-398151bab07d",
                                "text": "L'histoire se déroule dans un château qui appartient à une industrielle au bord de la faillite!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
