                "senses": [
                    {
                        "sense_id": "9bfabb8d-d897-34a3-a98e-d2392b01ad47",
                        "entry_id": "8aeaa5b9-6445-38e7-a5bd-c2957d799d64",
                        "glosses": [
                            "Vertreter der Ordnung der Aalfische (Anguilliformes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93685f96-5749-42b6-a195-689dfb92859e",
                                "sense_id": "9bfabb8d-d897-34a3-a98e-d2392b01ad47",
                                "text": "Die Aalfische wurden früher wegen des Fehlens von Bauchflossen auch Apodes genannt."
                            },
                            {
                                "example_id": "0e7b2c59-600a-4c7f-83f1-973e31d50369",
                                "sense_id": "9bfabb8d-d897-34a3-a98e-d2392b01ad47",
                                "text": "„Man pflegt nämlich diese Arbeit dort schon seit alter Zeit durch lebende Aalfische ausführen zu lassen, welche man bei den Reservoirs oder Brunnenstuben in die Röhren gleiten läßt, und welche alsdann geschunden und gequetscht beim Ausfluß wieder ans Tageslicht kommen.“"
                            },
                            {
                                "example_id": "92807409-1527-475e-97b6-2182fd7ba923",
                                "sense_id": "9bfabb8d-d897-34a3-a98e-d2392b01ad47",
                                "text": "Die meisten Aalfische leben weltweit in tropischen und subtropischen Meeren, sowohl in flachen Küstengewässern, Korallenriffen als auch in der Tiefsee."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
