                "senses": [
                    {
                        "sense_id": "b1613046-f193-3edd-ae7f-5a26c53674cc",
                        "entry_id": "d1ad269e-0efc-34e5-a358-b571beeb1c8e",
                        "glosses": [
                            "meist aus durchsichtigem Kunststoff bestehende, mit Farbe gefüllte Hülle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0e4647-03b6-48e2-8531-2c85aea626dd",
                                "sense_id": "b1613046-f193-3edd-ae7f-5a26c53674cc",
                                "text": "„Bei der Kundgebung waren aus der Menge Farbbeutel auf ein Gasthaus und das Palais Kaufmännischer Verein geschleudert wurden – von wem, war nicht mehr festzustellen. Die Geschädigten klagten.“"
                            },
                            {
                                "example_id": "d7b14e40-b3f2-4c4c-bf6d-31f882a5775a",
                                "sense_id": "b1613046-f193-3edd-ae7f-5a26c53674cc",
                                "text": "„Drinnen trifft den damaligen Aussenminister Joschka Fischer ein Farbbeutel am Ohr.“"
                            },
                            {
                                "example_id": "bbf27593-016c-4b02-9a88-0f1abc771ed3",
                                "sense_id": "b1613046-f193-3edd-ae7f-5a26c53674cc",
                                "text": "„Etwa zehn Sekunden später zerplatzt über dem Führungspanzer ein Farbbeutel und entläßt eine organgefarbene Wolke in die Luft; Abschuß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
