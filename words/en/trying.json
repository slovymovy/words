                        "trying conditions",
                        "trying day",
                        "trying circumstances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для вынесения; требующий больших усилий, терпения или выносливости.",
                        "pl": "Trudny do zniesienia; wymagający dużego wysiłku, cierpliwości lub wytrzymałości."
                    },
                    "translations": {
                        "ru": [
