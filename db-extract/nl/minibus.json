                    {
                        "sense_id": "aa21a473-bf1f-3358-89e6-2601af190b1f",
                        "entry_id": "6c3a4d50-79c5-30a6-86f0-8bef5b6f153f",
                        "glosses": [
                            "kleine bus, met name gebruikt in Azië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8baedf7c-9060-467c-9369-40026649a5b1",
                                "sense_id": "aa21a473-bf1f-3358-89e6-2601af190b1f",
                                "text": "Vrijwel iedereen reist per minibus of express-bus en boekt een 'open tour' van Ho Chi Minh City naar Hanoi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef5deb2-298d-4ea2-b655-f54f85963248",
                        "source_entry_id": "6c3a4d50-79c5-30a6-86f0-8bef5b6f153f",
                        "source_sense_id": "aa21a473-bf1f-3358-89e6-2601af190b1f",
                        "target_lang_word": "Minibus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minibus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                        "entry_id": "f50864d9-e3fe-3eac-9647-6dc02d4875c1",
                                        "glosses": [
                                            "kleiner Bus für den Transport relativ weniger Fahrgäste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6513302-08b8-40d5-9fd0-d9c5f452f689",
                                                "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                                "text": "„Während sie rastet, hält manchmal ein klimatisierter Minibus an, der eine Gruppe mit Kameras bewaffneter Touristen ausspuckt.“"
                                            },
                                            {
                                                "example_id": "7673ff77-6ed8-42e4-83a9-fd6cf2031c5c",
                                                "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                                "text": "„Die Arbeiter einer Stadt wohnen nie im Zentrum, sondern in den Außenbezirken, und pendeln mit Zug oder Minibus zur Arbeit.“"
                                            },
                                            {
                                                "example_id": "09fe469f-e889-4ab4-9b50-a24a20ab82b0",
                                                "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                                "text": "„Ich stieg wieder in den Minibus; als er nachkam, bot ich ihm den Fensterplatz an; er war begeistert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5e1e860-f97b-4185-a356-647e33b422b1",
                        "source_entry_id": "6c3a4d50-79c5-30a6-86f0-8bef5b6f153f",
                        "source_sense_id": "aa21a473-bf1f-3358-89e6-2601af190b1f",
                        "target_lang_word": "Kleinbus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinbus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7193ed9b-37d7-3f99-8496-1b264dfc1bf8",
                                        "entry_id": "528c5248-08b6-3261-b294-e9533bc60112",
                                        "glosses": [
                                            "Kleintransporter, der zum Transport von Personen mit bis zu neun Sitzen und Fenstern im Fond ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851c40d0-1b45-44fb-9084-84fdfd3a6bd0",
                                                "sense_id": "7193ed9b-37d7-3f99-8496-1b264dfc1bf8",
                                                "text": "Auf kleineren Dörfern werden die Schulkinder oft mit Kleinbussen abgeholt."
                                            },
                                            {
                                                "example_id": "ce94a23d-95fa-46cc-8722-b6dfb3da7024",
                                                "sense_id": "7193ed9b-37d7-3f99-8496-1b264dfc1bf8",
                                                "text": "„Ein Kerl in einem Kleinbus dachte, ich hätte ihn geschnitten.“"
                                            },
                                            {
                                                "example_id": "ea37d5bf-e6ab-45f9-b6dc-6270ba41437f",
                                                "sense_id": "7193ed9b-37d7-3f99-8496-1b264dfc1bf8",
                                                "text": "„Dann hält ein Kleinbus auf der gegenüberliegenden Seite und eine Horde regendurchweichter Engländer kommt herein.“"
                                            },
                                            {
                                                "example_id": "e0d5e5f0-45f1-4433-b2ff-090ab42233a0",
                                                "sense_id": "7193ed9b-37d7-3f99-8496-1b264dfc1bf8",
                                                "text": "„Der Kleinbus hält alle zwei Stunden für eine Zigarettenpause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
