    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "92ae1760-ef8e-38e4-905f-c9be61551c9b",
                "word": "charwoman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eb3f64f2-cd8d-4a3a-b502-6ff09e970633",
                        "entry_id": "92ae1760-ef8e-38e4-905f-c9be61551c9b",
                        "tags": [
                            "plural"
                        ],
                        "form": "charwomen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                        "entry_id": "92ae1760-ef8e-38e4-905f-c9be61551c9b",
                        "glosses": [
                            "A woman employed to do housework, traditionally coming and going on a daily basis and paid weekly wages."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "45b3ae57-daaa-4b8e-bae1-9b2dedf8cdff",
                                "sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                                "text": "The cloth was laid by an occasional charwoman, who officiated in the capacity of Mr. Bob Sawyer’s housekeeper; […]"
                            },
                            {
                                "example_id": "61a4b781-b1b7-459b-93a2-7f9a225f41b9",
                                "sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                                "text": "Through a partly-opened door the noise of a scrubbing-brush led up to the charwoman, Maryann Money, a person who for a face had a circular disc, furrowed less by age than by long gazes of perplexity at distant objects."
                            },
                            {
                                "example_id": "0785ce97-f280-4dfb-abab-cc5ea9ff2e03",
                                "sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything."
                            },
                            {
                                "example_id": "2a1c1aa1-60b1-41d3-8e91-49c4fbd0b344",
                                "sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                                "text": "But there was nobody at Kig and Kadgit's except the charwoman wiping over the “lino” in the passage."
                            },
                            {
                                "example_id": "210fc9de-da28-4f0a-830e-1c1be956b769",
                                "sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                                "text": "[H]e described the speech of the charwoman washing the hotel stairs and gave lists of words collected from the bathmen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c2e99bf-77d6-4cc9-b7ed-72524e123395",
                        "source_entry_id": "92ae1760-ef8e-38e4-905f-c9be61551c9b",
                        "source_sense_id": "1b9a764f-6247-333e-9fe5-92d1e434abdf",
                        "source_sense_description": "cleaning lady",
                        "target_lang_word": "meid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f84b4483-2b40-33b3-837e-9e7b40b47440",
                                        "entry_id": "5d92b050-1308-3ac6-bf01-2d8fe0482ac5",
                                        "glosses": [
                                            "jonge vrouw"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d845ad-bbab-4b89-9741-4cfe0d175fe5",
                                                "sense_id": "f84b4483-2b40-33b3-837e-9e7b40b47440",
                                                "text": "Die meiden hadden weer eens een hoop lol."
                                            },
                                            {
                                                "example_id": "4a537922-0f93-48cd-b84c-1abc90574415",
                                                "sense_id": "f84b4483-2b40-33b3-837e-9e7b40b47440",
                                                "text": "Ze hoopt bijna dat ze de ramen naar boven schuiven en haar roepen, dat ze naar buiten stormen, dat ze smekend op hun knieën vallen en haar hun excuses aanbieden, het spijt ons zo, lieve kleine meid van ons: we zullen je nooit meer tot zulke dingen dwingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bab274db-b567-35fa-9f8b-8123cefabe12",
                                        "entry_id": "5d92b050-1308-3ac6-bf01-2d8fe0482ac5",
                                        "glosses": [
                                            "werkster, dienstmeisje"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7158ad62-926d-4609-ba7d-d22cb3421ef4",
                                                "sense_id": "bab274db-b567-35fa-9f8b-8123cefabe12",
                                                "text": "Het is alsof de meid over haar dode meesteres wil praten of zelfs over haar wil roddelen, maar dat van niemand mag."
                                            },
                                            {
                                                "example_id": "17b1482f-3dda-4ca0-a993-43dfdd200a00",
                                                "sense_id": "bab274db-b567-35fa-9f8b-8123cefabe12",
                                                "text": "De meid is zichtbaar onder de indruk: er ligt geen stof, de ramen zijn schoon en het ruikt er naar citroen en rozenwater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
