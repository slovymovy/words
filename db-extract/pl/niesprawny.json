        "pl-extract.jsonl": [
            {
                "entry_id": "f96653d6-60a6-3646-b52b-4771a2de7cb7",
                "word": "niesprawny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ba63469f-b263-35ad-a807-232c06954024",
                        "entry_id": "f96653d6-60a6-3646-b52b-4771a2de7cb7",
                        "glosses": [
                            "o urządzeniu taki, który nie działa w ogóle lub działa nieprawidłowo (niezgodnie z przeznaczeniem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9487d6b3-3e95-4b93-9115-9d01c39497d4",
                                "sense_id": "ba63469f-b263-35ad-a807-232c06954024",
                                "text": "Technik naprawił niesprawną wentylację."
                            },
                            {
                                "example_id": "51ced724-633a-482a-bbab-3d1419679a61",
                                "sense_id": "ba63469f-b263-35ad-a807-232c06954024",
                                "text": "W domu okazało się, że telewizor jest niesprawny i musiałem drugi raz jechać do sklepu, żeby go zwrócić."
                            },
                            {
                                "example_id": "c25a655e-8f73-4359-8d09-0a0d9f3c6d4b",
                                "sense_id": "ba63469f-b263-35ad-a807-232c06954024",
                                "text": "Wiele szkół nauki jazdy uczy jeździć na niesprawnych autach."
                            },
                            {
                                "example_id": "1fb68a12-2790-41fb-a8b2-a05c4df3ff0d",
                                "sense_id": "ba63469f-b263-35ad-a807-232c06954024",
                                "text": "Poprosiłem znajomego o wycenę niesprawnego dysku twardego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7ea3def7-292a-30f9-b9d6-3367b71553f0",
                        "entry_id": "f96653d6-60a6-3646-b52b-4771a2de7cb7",
                        "glosses": [
                            "o człowieku lub części ciała o ograniczonej zdolności ruchowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7c9883-bb64-4abb-ab05-d7dc03272ee4",
                                "sense_id": "7ea3def7-292a-30f9-b9d6-3367b71553f0",
                                "text": "Ireneusz miał wypadek samochodowy i po operacji był niesprawny ponad miesiąc."
                            },
                            {
                                "example_id": "14ced0ef-3f60-465c-8742-637e0d4c6cdb",
                                "sense_id": "7ea3def7-292a-30f9-b9d6-3367b71553f0",
                                "text": "Pies pracujący to pies asystujący osobom niesprawnym ruchowo, niewidomym, głuchoniemym"
                            },
                            {
                                "example_id": "f0bf03a3-baf1-4937-a23c-aedd6f630417",
                                "sense_id": "7ea3def7-292a-30f9-b9d6-3367b71553f0",
                                "text": "Mam niesprawną nogę i poruszam się o kulach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d7968bf3-322b-37c8-8067-7119b3a0ae7c",
                        "entry_id": "f96653d6-60a6-3646-b52b-4771a2de7cb7",
                        "glosses": [
                            "o instytucji źle zorganizowany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016d1669-bedd-480a-8022-4f4ea7bc8a9b",
                                "sense_id": "d7968bf3-322b-37c8-8067-7119b3a0ae7c",
                                "text": "Zagraniczny polityk skrytykował niesprawny rząd."
                            },
                            {
                                "example_id": "e748ff01-1ed1-4c07-aa0e-911f1d4d4481",
                                "sense_id": "d7968bf3-322b-37c8-8067-7119b3a0ae7c",
                                "text": "Niesprawne urzędy hamują wzrost gospodarczy w Polsce"
                            },
                            {
                                "example_id": "10381642-b91d-4006-9656-8bbb269898f2",
                                "sense_id": "d7968bf3-322b-37c8-8067-7119b3a0ae7c",
                                "text": "Hiszpania cierpi, gnębiona przez kurczącą się gospodarkę i niesprawny rynek pracy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
