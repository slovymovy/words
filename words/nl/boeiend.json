                {
                    "sense_id": "12c05652-ed79-33ce-9693-beb193632300",
                    "sense_definition": "gezegd wanneer men iets totaal niet interessant vindt of het iemand niets kan schelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onverschilligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zei dat mijn hondje in zijn tuin had geplast. Nou, <w>boeiend</w>!",
                            "target_lang_translations": {
                                "en": "He said my little dog had peed in his garden. Well, <w>whatever</w>!",
                                "ru": "Он сказал, что моя собачка пописала в его саду. Ну, <w>подумаешь</w>!",
                                "fr": "Il a dit que mon petit chien avait pipé dans son jardin. Et bien, <w>on s'en fout</w> !",
                                "pl": "Powiedział, że mój piesek nasikał mu w ogrodzie. No, <w>wielkie mi rzeczy</w>!",
                                "de": "Er sagte, mein Hund hätte in seinen Garten gepinkelt. Na und, <w>wen interessiert's</w>!",
                                "it": "Ha detto che il mio cagnolino ha fatto la pipì nel suo giardino. Beh, <w>chissenefrega</w>!",
                                "cs": "Říkal, že se mi pes vyčůral na zahradě. No, <w>no a co</w>!",
                                "tr": "Köpeğimin bahçesine işediğini söyledi. Ee, <w>ne yani</w>!",
                                "es": "Dijo que mi perrito se había orinado en su jardín. ¡Pues, <w>y a mí qué</w>!",
                                "zh": "他说我的小狗在他的花园里撒尿了。切，<w>那又怎样</w>！"
                            }
                        },
                        {
                            "text": "Mijn broer klaagt weer over zijn werk, maar eerlijk gezegd: <w>boeiend</w>.",
                            "target_lang_translations": {
                                "en": "My brother is complaining about his work again, but honestly: <w>who cares</w>.",
                                "ru": "Мой брат снова жалуется на работу, но, честно говоря: <w>плевать</w>.",
                                "fr": "Mon frère se plaint encore de son travail, mais honnêtement : <w>super</w>.",
                                "pl": "Mój brat znowu narzeka na pracę, ale szczerze mówiąc: <w>i co z tego</w>.",
                                "de": "Mein Bruder beschwert sich wieder über seine Arbeit, aber ehrlich gesagt: <w>interessiert mich nicht</w>.",
                                "it": "Mio fratello si lamenta di nuovo del suo lavoro, ma onestamente: <w>e quindi</w>?",
                                "cs": "Můj bratr si zase stěžuje na práci, ale upřímně: <w>to mě nezajímá</w>.",
                                "tr": "Kardeşim yine işi hakkında şikayet ediyor ama dürüst olmak gerekirse: <w>çok da umurumda</w>.",
                                "es": "Mi hermano se queja de nuevo de su trabajo, pero honestamente: <w>qué interesante</w>.",
                                "zh": "我哥哥又在抱怨他的工作了，但老实说：<w>无聊</w>。"
                            }
                        }
                    ],
