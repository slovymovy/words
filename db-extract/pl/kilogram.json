                        "cross_references": [
                            {
                                "target_word": "kilogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a83b31e-5748-3077-8bb8-107c438f7be2",
                                        "entry_id": "4073d727-8150-393d-8672-57f1370fcca9",
                                        "glosses": [
                                            "Unité de masse dans le Système international d’unités (SI) qui a pour symbole kg. À l’origine le kilogramme représentait la masse d’un litre d’eau au maximum de sa densité, mais il a été défini comme la masse du prototype international du kilogramme sous la forme d'un cylindre de platine et d’iridium conservé au Bureau international des poids et mesures à Sèvres de 1889 à 2019. Il est désormais défini à partir de la constante de Planck (h) de la physique quantique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f151948f-b15b-48ce-bbbe-bce92b2af72b",
                                                "sense_id": "1a83b31e-5748-3077-8bb8-107c438f7be2",
                                                "text": "Les locomobiles de la force de 4 à 5 chevaux ont un poids qui atteint déjà 2000 kilogrammes."
                                            },
                                            {
                                                "example_id": "ab8ec1c0-8cf4-4876-8aa0-a15380085777",
                                                "sense_id": "1a83b31e-5748-3077-8bb8-107c438f7be2",
                                                "text": "Avec des schappes de soie, on peut filer jusqu’au 400 mm au kilogramme. Avec les déchets de tussah on ne peut filer plus de 140 mm au kilogramme."
                                            },
                                            {
                                                "example_id": "df84f4ca-e20c-4067-a1ac-c1cb2379454e",
                                                "sense_id": "1a83b31e-5748-3077-8bb8-107c438f7be2",
                                                "text": "Notre hydravion chargé de 2.600 litres d’essence accusait un poids de 5.500 kilogrammes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
