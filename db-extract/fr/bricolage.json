                                        "entry_id": "26f5cf3a-b9b9-3e8d-aac2-85819a7c837b",
                                        "glosses": [
                                            "Gegenstand, an dem jemand kleinere handwerkliche oder technische Arbeiten vornimmt, um ihn zu verbessern, zu reparieren oder umzugestalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b6ed12-a833-4a9a-b5b1-f5cad2e31a52",
                                                "sense_id": "bf829697-a1ff-3ff7-b962-29a007c0f531",
                                                "text": "„Himmeli ist eine aufwendige Bastelei aus Stroh, die in Finnland, Litauen, Lettland, Schweden und in der Ukraine eine beliebte Weihnachtsdekoration darstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86630b9c-f6f9-3c36-8326-4a8d3c7c48f2",
                                        "entry_id": "26f5cf3a-b9b9-3e8d-aac2-85819a7c837b",
                                        "glosses": [
                                            "permanentes und von anderen meist als lästig empfundenes Werkeln an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5ac0c4-db2f-4428-8f98-6ac95c56ae7f",
                                                "sense_id": "86630b9c-f6f9-3c36-8326-4a8d3c7c48f2",
                                                "text": "„Wo man es mit ‚armen‘ Baustoffen zu tun hatte, kamen meist architektonisch wenig ansprechende ökologische Experimente heraus – und das Selbstbauen, Reparieren und Umbauen wurde sowieso schnell als krude Bastelei von Aussteigern mit ideologisch eingeschränkter Weltsicht abgetan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
