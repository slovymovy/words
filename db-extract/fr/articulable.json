                                "sense_id": "ead339e8-52a0-369e-8ad9-6858e569f7dd",
                                "text": "Taille-haie articulable de 0 à 90° sur 9 positions de travail + 1 de stockage."
                            },
                            {
                                "example_id": "ef38e596-07be-4bc5-9762-dbebf74679d8",
                                "sense_id": "ead339e8-52a0-369e-8ad9-6858e569f7dd",
