                {
                    "sense_id": "413f235c-11ee-3e9f-b607-a9fe6f39b412",
                    "sense_definition": "Een auto van het model Citroën 2CV.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn grootvader reed vroeger in een rode <w>eend</w>.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка раньше ездил на красном <w>Ситроене 2CV</w>.",
                                "en": "My grandfather used to drive a red <w>2CV</w>.",
                                "pl": "Mój dziadek jeździł kiedyś czerwoną <w>kaczką</w>.",
                                "de": "Mein Großvater fuhr früher eine rote <w>Ente</w>.",
                                "fr": "Mon grand-père conduisait autrefois une <w>deuche</w> rouge.",
                                "it": "Mio nonno guidava una <w>Due Cavalli</w> rossa.",
                                "cs": "Můj dědeček dříve jezdil v červené <w>kachně</w>.",
                                "tr": "Büyükbabam eskiden kırmızı bir <w>Citroën 2CV</w> kullanırdı.",
                                "es": "Mi abuelo solía conducir un <w>Citroën 2CV</w> rojo."
                            }
                        },
                        {
                            "text": "Je ziet bijna nooit meer een <w>eend</w> op de snelweg rijden.",
                            "target_lang_translations": {
                                "ru": "Почти никогда больше не увидишь <w>Ситроен 2CV</w> на шоссе.",
                                "en": "You hardly ever see a <w>2CV</w> driving on the highway anymore.",
                                "pl": "Prawie nigdy nie widuje się już <w>kaczki</w> jadącej po autostradzie.",
                                "de": "Man sieht fast nie mehr eine <w>Ente</w> auf der Autobahn fahren.",
                                "fr": "On ne voit presque plus jamais de <w>deux-chevaux</w> rouler sur l'autoroute.",
                                "it": "Non si vede quasi più una <w>Due Cavalli</w> viaggiare in autostrada.",
                                "cs": "Na dálnici už dnes téměř neuvidíte jet <w>kachnu</w>.",
                                "tr": "Otoyolda artık neredeyse hiç <w>Citroën 2CV</w> görmüyorsunuz.",
                                "es": "Ya casi nunca se ve un <w>dos caballos</w> circulando por la autopista."
                            }
