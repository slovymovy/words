                    {
                        "sense_id": "19cc2086-31ee-3ba8-92f0-58331a89bdc5",
                        "entry_id": "58236ea4-1377-3a54-81ef-fdd18dc275df",
                        "glosses": [
                            "weibliche Person, die ihre eigenen Leistungen freiwillig und unaufgefordert in den Vordergrund stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7660a1-5e7d-4048-ac7a-a91e070f2742",
                                "sense_id": "19cc2086-31ee-3ba8-92f0-58331a89bdc5",
                                "text": "Meine Freundin ist eine richtige Angeberin."
                            },
                            {
                                "example_id": "c3425013-c9a5-4ce8-808a-a6e2a5488456",
                                "sense_id": "19cc2086-31ee-3ba8-92f0-58331a89bdc5",
                                "text": "„Damit ihre Freunde sie jedoch nicht für eine Angeberin halten, hat sie die Maserung des Holzes absichtlich so perfekt gewählt, dass jeder Nichteingeweihte glaubt, es sei Laminat.“"
                            }
                        ],
