            "senses": [
                {
                    "sense_id": "bb0a6afd-4066-36a7-a0e8-7860e5e76f80",
                    "sense_definition": "Completely bewildered, perplexed, or confused.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is good at routine tasks, but he becomes utterly <w>flummoxed</w> when novel challenges arise.",
                            "target_lang_translations": {
                                "tr": "Rutin görevlerde iyidir, ancak yeni zorluklar ortaya çıktığında tamamen <w>şaşkına döner</w>."
                            }
                        },
                        {
                            "text": "She looked completely <w>flummoxed</w> by the strange question from the audience.",
                            "target_lang_translations": {
                                "tr": "Dinleyicilerden gelen tuhaf soru karşısında tamamen <w>afallamış</w> görünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "baffled",
                        "bewildered",
                        "mystified",
                        "perplexed",
                        "stumped"
                    ],
                    "common_phrases": [
                        "completely flummoxed",
                        "utterly flummoxed",
                        "left flummoxed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used informally to describe deep confusion."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tamamen şaşkına dönmüş, aklı karışmış veya afallamış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şaşkına dönmüş",
                                "target_lang_sense_clarification": "ne yapacağını bilemeyecek kadar şaşırmış"
                            },
                            {
                                "target_lang_word": "afallamış",
                                "target_lang_sense_clarification": "şaşkınlıktan donakalmış, kafası karışmış"
                            },
                            {
                                "target_lang_word": "kafası karışmış",
                                "target_lang_sense_clarification": "durumu kavrayamamış, şaşırmış"
                            }
                        ]
                    }
                }
            ]
        },
        {
