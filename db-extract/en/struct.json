                                                "example_id": "b21d300b-10e2-464b-b3d5-7ac2122aff74",
                                                "sense_id": "a9e3c2bb-da23-3d18-8ddd-ade09f46da46",
                                                "text": "Der Verbund wurde nicht erst in den sechziger Jahren gegründet, sondern seine Wurzeln liegen bereits im Jahr 1905."
                                            }
