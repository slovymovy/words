                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "843d23da-5bfe-44ed-9384-6a3766d67c52",
                        "entry_id": "e1af0711-339d-34fe-924d-2778f5af55c2",
                        "tags": [
                            "possessive"
                        ],
                        "form": "Nieuw-Zeelands"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e4f79a2-e444-390d-a761-2bb01ac3e550",
                        "entry_id": "e1af0711-339d-34fe-924d-2778f5af55c2",
                        "glosses": [
                            "een land in het zuidwesten van de Grote Oceaan, gelegen naast Australië. Het bestaat uit een eilandengroep."
                        ],
                        "tags": [
                            "toponiem: eiland"
                        ],
                        "examples": [
                            {
                                "example_id": "d35d1b1a-dbd7-4bc2-95ee-83b88eb60da0",
                                "sense_id": "5e4f79a2-e444-390d-a761-2bb01ac3e550",
                                "text": "The long pathway is 3.041 kilometer lang en loopt kronkelend door de twee eilanden waaruit Nieuw Zeeland [sic!] bestaat en langs betoverende Lord of the Rings- landschappen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff97abd2-1fca-470a-883e-626ea1607243",
                        "source_entry_id": "e1af0711-339d-34fe-924d-2778f5af55c2",
                        "source_sense_id": "5e4f79a2-e444-390d-a761-2bb01ac3e550",
                        "source_sense_description": "een land in het zuidwesten van de Grote Oceaan, gelegen naast Australië",
                        "target_lang_word": "Neuseeland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuseeland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9adaac2-ab40-378f-9026-4327125dc7e2",
                                        "entry_id": "657f4d80-14e6-3815-bc44-f254aef7ed29",
                                        "glosses": [
                                            "Inselgruppe mit zwei großen Hauptinseln in Ozeanien (im Südpazifik)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c788822-f59e-443c-a6d7-739129b09e88",
                                                "sense_id": "f9adaac2-ab40-378f-9026-4327125dc7e2",
                                                "text": "Neuseeland ist berühmt für seine faszinierende Vogelwelt."
                                            },
                                            {
                                                "example_id": "cc4ca767-014e-47d8-b77b-ff15ed570492",
                                                "sense_id": "f9adaac2-ab40-378f-9026-4327125dc7e2",
                                                "text": "„Mit ihrem Sprung am Gummiseil war das Bungee-Jumping in Neuseeland geboren und verbreitete sich wie ein Lauffeuer auf der ganzen Welt.“"
                                            },
                                            {
                                                "example_id": "97cb9ae3-7a88-46ff-b497-03b87109cc41",
                                                "sense_id": "f9adaac2-ab40-378f-9026-4327125dc7e2",
                                                "text": "„Erste Standorte waren die Kawarau-Bridge und die Skippers Canyon Bridge. Seitdem entwickelte sich Neuseeland zum Mekka der Bungeespringer und des Abenteuer-Tourismus schlechthin.“"
                                            },
                                            {
                                                "example_id": "e3135fe1-396a-4631-a50a-9f308547b86d",
                                                "sense_id": "f9adaac2-ab40-378f-9026-4327125dc7e2",
                                                "text": "„Auf der Südhalbkugel zählen das südliche Chile, Südostaustralien und die Südinsel Neuseelands zu den kühlgemäßigten Breiten.“"
                                            },
                                            {
                                                "example_id": "2462a558-04a0-4e3a-b559-43ebd82f00bc",
                                                "sense_id": "f9adaac2-ab40-378f-9026-4327125dc7e2",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db6f139f-7f19-3a82-bf2b-8049cdcb4009",
                                        "entry_id": "657f4d80-14e6-3815-bc44-f254aef7ed29",
                                        "glosses": [
                                            "der diese Inselgruppe umfassende Staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51915c69-2466-4eb6-9679-cd7ef1e6d514",
                                                "sense_id": "db6f139f-7f19-3a82-bf2b-8049cdcb4009",
                                                "text": "„Auf der Südhalbkugel zählen das südliche Chile, Südostaustralien und die Südinsel Neuseelands zu den kühlgemäßigten Breiten.“"
                                            },
                                            {
                                                "example_id": "3686c6d5-415f-4fda-ad1f-fbca42211168",
                                                "sense_id": "db6f139f-7f19-3a82-bf2b-8049cdcb4009",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "36f9269b-b79c-4c4a-8626-2c6c662bf579",
                                                "sense_id": "db6f139f-7f19-3a82-bf2b-8049cdcb4009",
                                                "text": "Neuseeland protestierte gegen die Atombombentests."
                                            },
                                            {
                                                "example_id": "db412e0f-fa03-4eb5-b40e-9782a9a24fe0",
                                                "sense_id": "db6f139f-7f19-3a82-bf2b-8049cdcb4009",
                                                "text": "Wellington ist die Hauptstadt von Neuseeland."
                                            },
                                            {
                                                "example_id": "ce9b606e-b384-4f15-9fbb-d47f36afe8da",
                                                "sense_id": "db6f139f-7f19-3a82-bf2b-8049cdcb4009",
                                                "text": "„In einer Langzeitstudie in Neuseeland wollen Forscher beobachtet haben, dass geduldigere Schüler im Schnitt einen besseren Schulabschluss machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
