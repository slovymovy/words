                "senses": [
                    {
                        "sense_id": "6c60e22a-75e5-324e-ad59-c3fbee10a79d",
                        "entry_id": "e9791396-ba59-3635-b594-a1c3f42096d4",
                        "glosses": [
                            "Pencher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def4b8ae-063c-4080-a30d-18eca4f3bf7b",
                                "sense_id": "6c60e22a-75e5-324e-ad59-c3fbee10a79d",
                                "text": "Abel, mon compagnon quotidien, Abel à qui seul je pouvais parler et vers qui, dans ma solitude, me repenchaient sans cesse faiblesse, besoin plaintif de sympathie, défiance de moi, et, dans mon embarras, crédit que j’attachais à son conseil, malgré la différence de nos natures, ou à cause d’elle plutôt…"
                            },
                            {
                                "example_id": "8817c584-dd19-43a6-baf7-d32377525443",
                                "sense_id": "6c60e22a-75e5-324e-ad59-c3fbee10a79d",
                                "text": "Elle se repencha sur son tricot et se remit à marmonner en relevant parfois la tête devant l’être imaginaire auquel elle s’adressait."
                            }
                        ]
                    }
                ],
