                                        "sense_id": "19a935ae-95af-372f-bb2f-3022242be460",
                                        "entry_id": "376fc953-2c75-3a7f-9360-68f08ec62d82",
                                        "glosses": [
                                            "problematische Wirtschaftssituation, bei der Inflation (Geldentwertung) und Stagnation (fehlendes Wachstum) zugleich herrschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a31b913-f94e-4f98-8580-ec1fdb73a268",
                                                "sense_id": "19a935ae-95af-372f-bb2f-3022242be460",
                                                "text": "Eine Stagflation ist eine Wirtschaftssituation, die finanzpolitisch und wirtschaftlich nicht leicht zu überwinden ist."
                                            },
                                            {
                                                "example_id": "275e99ea-bc7d-411d-b46b-0a201ab35039",
                                                "sense_id": "19a935ae-95af-372f-bb2f-3022242be460",
                                                "text": "„Die Stagflation der 1970er Jahre hat die Regierungen und die öffentliche Meinung davon überzeugt, dass Zentralbanken vor allem unabhängig von der politischen Macht sein sollten, um sich dem einen Ziel der geringen Inflation zu widmen.“"
                                            }
                                        ],
