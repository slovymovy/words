                        "examples": [
                            {
                                "example_id": "52ee8f47-c12f-4817-a949-d4d32a2e9d3a",
                                "sense_id": "8b5d6c7f-92be-3a43-b650-faa2a63eba7f",
                                "text": "Hodgkinson eist ook het recht op de lunch en op een dutje weer op. ,,Bestuurders namen dat recht van ons af. Want tijdens de lunch vergeet je, even, zinnig, praktisch en efficiënt te zijn. ,,Gezellig, Bourgondisch, een traktatie: lunch is voor lanterfants. Ook een dutje doen is een natuurlijk deel van onze dagelijkse cyclus."
                            },
                            {
                                "example_id": "ffa4d099-b749-457c-be7a-277df74f73d6",
                                "sense_id": "8b5d6c7f-92be-3a43-b650-faa2a63eba7f",
                                "text": "De lanterfant van de Turkse auteur Yusuf Atilgan gaat over een personage genaamd C., dat zijn dagen vult met rusteloze en vreugdeloze omzwervingen door een grote stad waarin Istanboel te herkennen valt."
                            }
                        ]
                    }
