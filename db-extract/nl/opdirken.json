        "nl-extract.jsonl": [
            {
                "entry_id": "c132d4a0-8873-3a1d-9729-ffe0443f08ee",
                "word": "opdirken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b1aa7b4-65b8-3192-881f-61af80c1dfdd",
                        "entry_id": "c132d4a0-8873-3a1d-9729-ffe0443f08ee",
                        "glosses": [
                            "veel aandacht aan je uiterlijk besteden als je naar een feestelijke gebeurtenis gaat"
                        ],
                        "tags": [
                            "overdreven"
                        ],
                        "examples": [
                            {
                                "example_id": "973e31fd-114c-4d44-92bd-b640eb27e33b",
                                "sense_id": "0b1aa7b4-65b8-3192-881f-61af80c1dfdd",
                                "text": "Facebook heeft 1,6 miljard gebruikers, maar tieners vinden het sociale netwerk weinig opwindend. Zij zetten hun kiekjes liever op Snapchat, waar ze ze kunnen opdirken met speelse filters en waar ze vanzelf weer verdwijnen."
                            },
                            {
                                "example_id": "f491b4e6-4688-4e8e-be33-dd99a565d1ac",
                                "sense_id": "0b1aa7b4-65b8-3192-881f-61af80c1dfdd",
                                "text": "Fennema doet het voorkomen alsof vrouwelijke schrijvers zich opdirken en seksueel laten portretteren om meer boeken te verkopen. Ik stel dat ijdelheid geen gender kent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a4fde7b-6b9d-45a0-8081-24b822833a90",
                        "source_entry_id": "c132d4a0-8873-3a1d-9729-ffe0443f08ee",
                        "source_sense_id": "0b1aa7b4-65b8-3192-881f-61af80c1dfdd",
                        "source_sense_description": "(overdreven) veel aandacht aan je uiterlijk besteden als je naar een feestelijke gebeurtenis gaat",
                        "target_lang_word": "dress up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dress up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To put on special or fancy clothes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66baa17b-4bf6-4a27-8fa5-6af7477c3e92",
                                                "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                                "text": "Everyone dressed up for the graduation ball."
                                            },
                                            {
                                                "example_id": "5609b7da-d21e-46e2-9543-04b87ac28bad",
                                                "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                                "text": "I want a job where I don't have to dress up."
                                            },
                                            {
                                                "example_id": "2999cbf7-532f-48d0-80a6-b9cfaed28b35",
                                                "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                                "text": "Runners had a fun day out in Friday's HKLRRC Boxing Day Race at Wan Chai Gap with most of the participants dressed up in costumes and braving the chilly weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f582d20-ec0d-374a-9894-f259a9d6f4fb",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To put on a costume portraying oneself as a particular type of character or well-known person."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac06bf70-ddaf-46bd-b932-9bcfbf6a3c41",
                                                "sense_id": "4f582d20-ec0d-374a-9894-f259a9d6f4fb",
                                                "text": "We're having a party on Saturday, but you must dress up as a famous historical figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42191176-e1ec-34e1-86f1-cd36bc866d58",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To put a costume on (someone) portraying them as a particular type of character or well-known person."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c6c36c-4553-4270-a796-70b6c210326e",
                                                "sense_id": "42191176-e1ec-34e1-86f1-cd36bc866d58",
                                                "text": "The cat hated when they dressed him up for Halloween."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62585fb7-fd93-35c9-9cee-0bf5489bcd37",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To decorate; to prettify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d083d4-27ea-4615-a246-1a3197c06953",
                                                "sense_id": "62585fb7-fd93-35c9-9cee-0bf5489bcd37",
                                                "text": "Mistress, your father prays you leave your books,\nAnd help to dress your sister’s chamber up:\nYou know to-morrow is the wedding-day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d09ee4c-96ba-341f-a7d5-0812e68f9ea9",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To present in a favorable light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b55e6fb5-ff72-4d75-bcfe-14ed4619f42f",
                                                "sense_id": "2d09ee4c-96ba-341f-a7d5-0812e68f9ea9",
                                                "text": "You can dress up that proposal however you want; it's still going to go over like a lead balloon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
