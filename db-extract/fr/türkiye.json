                "senses": [
                    {
                        "sense_id": "69d8f8b7-114c-3f05-962b-1b59546be715",
                        "entry_id": "b2dd0450-17df-3527-9f26-f3270233e85e",
                        "glosses": [
                            "Türkiye, Turkey (a country located in Eastern Thrace in Southeastern Europe and Anatolia in West Asia)"
                        ],
                        "tags": [
                            "feminine",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "3020aec5-c5b5-4026-9f3e-9fa388b7b344",
                                "sense_id": "69d8f8b7-114c-3f05-962b-1b59546be715",
                                "text": "Grâce à la forte participation de l'ONU, de la Türkiye et d'autres partenaires, nous avons montré comment la coopération de quelques-uns peut rétablir la sécurité alimentaire pour beaucoup."
                            },
                            {
                                "example_id": "68b678ff-4df7-40ec-bdf1-20788ae96410",
                                "sense_id": "69d8f8b7-114c-3f05-962b-1b59546be715",
                                "text": "De même, dans les affaires administratives, les différences sont vastes, la Croatie et l’Italie ont déclaré que plus de la moitié des affaires pendantes avaient plus de deux ans, suivies par l’Ukraine (39,6%) et la Türkiye (30,6%)."
                            },
                            {
                                "example_id": "5dbd5871-9322-42ac-960d-4cde2d29e4a1",
                                "sense_id": "69d8f8b7-114c-3f05-962b-1b59546be715",
                                "text": "Le projet devrait être appliqué en Algérie, en Tunisie, en Palestine, en Égypte, en Jordanie et en Türkiye d'ici 2022."
                            },
                            {
                                "example_id": "38ad0c8f-d9cd-49dc-ad88-fc0ffa659a2e",
                                "sense_id": "69d8f8b7-114c-3f05-962b-1b59546be715",
                                "text": "Les ministres de la Türkiye, de l’Allemagne, des États-Unis et du Maroc au stand de ce dernier lors de la visite de l’exposition."
                            },
                            {
                                "example_id": "d43a48d9-b36b-4702-a81b-e74cb1b45383",
                                "sense_id": "69d8f8b7-114c-3f05-962b-1b59546be715",
                                "text": "Bien que les élèves du Luxembourg et de la Türkiye bénéficient de 15 semaines de vacances par an, celles-ci sont réparties en six périodes de vacances au Luxembourg, et en deux périodes en Türkiye (figure 17.6)."
                            }
                        ]
                    }
