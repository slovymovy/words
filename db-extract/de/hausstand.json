                ],
                "senses": [
                    {
                        "sense_id": "bb5c6ef3-9190-3f6b-9255-14da5edbdd50",
                        "entry_id": "2eef5963-2229-3e06-ae32-c02b90e04e7b",
                        "glosses": [
                            "Gesamtheit der Personen, die in einem Haushalt zusammenleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb82ca15-2f48-4de4-9160-9fe7f7496dac",
                                "sense_id": "bb5c6ef3-9190-3f6b-9255-14da5edbdd50",
                                "text": "„Jeder wird angehalten, die physischen und sozialen Kontakte zu anderen Menschen außerhalb der Angehörigen des eigenen Hausstands auf ein absolut nötiges Minimum zu reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a098daf-d426-35e0-8100-4b0ee1da59e2",
                        "entry_id": "2eef5963-2229-3e06-ae32-c02b90e04e7b",
                        "glosses": [
                            "Besitz, Einnahmen und Ausgaben einer zusammenlebenden Personengruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06249a73-7e06-4e8a-af57-c401cc2a3dc7",
                                "sense_id": "7a098daf-d426-35e0-8100-4b0ee1da59e2",
                                "text": "Das junge Ehepaar wollte schnellstmöglich einen eigenen Hausstand gründen."
                            },
                            {
                                "example_id": "46a6e87c-21d9-410b-8f7d-50d230e4bda7",
                                "sense_id": "7a098daf-d426-35e0-8100-4b0ee1da59e2",
                                "text": "„Die Anstellung auf der Festung sorgte in seinem Hausstand für das Essen auf dem Tisch.“"
                            },
                            {
                                "example_id": "b15aae3e-fd78-48a0-a1f4-c2c7dac4b62a",
                                "sense_id": "7a098daf-d426-35e0-8100-4b0ee1da59e2",
                                "text": "„1919 entschloß sich Einstein, ein zweites Mal einen Hausstand zu gründen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
