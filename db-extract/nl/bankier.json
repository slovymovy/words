                                        "glosses": [
                                            "der persönlich haftende Inhaber oder ein Vorstandsmitglied einer Bank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f64fd067-5166-4d80-aec9-80bfc14be80e",
                                                "sense_id": "670f1a6f-5b8d-3f14-af40-2fe6d2fc7386",
                                                "text": "Als bekannte Bankiers gelten die Rothschilds."
                                            },
                                            {
                                                "example_id": "7930b98e-4094-47ce-9ee1-32bda221186d",
                                                "sense_id": "670f1a6f-5b8d-3f14-af40-2fe6d2fc7386",
                                                "text": "„Er gehörte noch zu den Bankiers, nicht zu den Bankern: Guth, Neffe Ludwig Erhards, prägte über Jahrzehnte das Bild der Deutschen Bank.“"
                                            },
                                            {
                                                "example_id": "3973bd48-a2fa-433b-b73d-3252ea2edde9",
                                                "sense_id": "670f1a6f-5b8d-3f14-af40-2fe6d2fc7386",
                                                "text": "„Seine Beamten beraten dessen Regierung, seine Offiziere führen die Katanga-Gendarmen, seine Ingenieure kontrollieren den Bergbau, seine Bankiers bauen eine Zentralbank auf.“"
                                            },
                                            {
                                                "example_id": "4e44c3de-f395-47b0-8b56-53c505c08611",
                                                "sense_id": "670f1a6f-5b8d-3f14-af40-2fe6d2fc7386",
                                                "text": "„Ich hielte mich nur einen Tag in Ancona auf, um dem Bankier meinen Kreditbrief zu präsentieren und mir einen neuen für Bologna ausstellen zu lassen.“"
                                            },
                                            {
                                                "example_id": "f0a532dd-9e94-47d3-a76b-439ad4b1561c",
                                                "sense_id": "670f1a6f-5b8d-3f14-af40-2fe6d2fc7386",
                                                "text": "„Wenn Werners Sarg deswegen nicht fertig wird, so ist das kein Unglück – der Bankier hat Dutzende von kleinen Hausbesitzern mit Inflationsgeld um ihr bißchen Besitz gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
