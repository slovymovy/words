                    {
                        "translation_id": "58424323-11da-41f6-883f-cd217fe7e291",
                        "source_entry_id": "812b80c1-b8f7-396b-bbb0-db64eb6d7c07",
                        "source_sense_id": "84b2f95a-db05-398c-90b3-bb7cabd8e1ec",
                        "target_lang_word": "laque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "415d65f5-3559-38ab-a06c-18b161ec81c2",
                                        "entry_id": "4366ccd0-c076-3e33-8c85-2eec9ba2e580",
                                        "glosses": [
                                            "Gomme laque ; sorte de résine, d’un rouge jaunâtre, qui sort des branches de plusieurs espèces d’arbres des Indes orientales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d72001-c571-4ad2-8d78-4bab6e43e48b",
                                                "sense_id": "415d65f5-3559-38ab-a06c-18b161ec81c2",
                                                "text": "Assez loin d’elle, debout devant une table en véritable laque, une personne grassouillette surveillait le samovar de cuivre où chauffait l’eau qui allait servir à la confection du thé."
                                            },
                                            {
                                                "example_id": "6fdc2a57-05e2-4845-8781-28124521f2ad",
                                                "sense_id": "415d65f5-3559-38ab-a06c-18b161ec81c2",
                                                "text": "La résine laque, appelée aussi gomme laque ou simplement laque, est le produit d’un insecte de l’Inde, du groupe des Hémiptères et de la famille des Coccidés, le Carteria lacca Signoret, Commstock (Tachardialacca Signoret; Coccus lacca Kern), qui vit principalement sur des Ficus (F, indien, F. religiosa, F. hengalensis, F. laccifera. etc.), et aussi, mais plus rarement sur Vanona squamosa, le Butea frondosa, le Zizyphus jujuba, le Croton lacciferum, le Mimosa cinerea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9648479f-6b23-3528-b102-b41c027b526b",
                                        "entry_id": "4366ccd0-c076-3e33-8c85-2eec9ba2e580",
                                        "glosses": [
                                            "Terre alumineuse, teinte d’un suc colorant, qu’on emploie dans la peinture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e130bb-d358-4345-b1a6-5966561bc71c",
                                                "sense_id": "9648479f-6b23-3528-b102-b41c027b526b",
                                                "text": "Laque de Venise, de Florence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1e5ec2-8aac-319f-b518-bcfecd9e91ee",
                                        "entry_id": "4366ccd0-c076-3e33-8c85-2eec9ba2e580",
                                        "glosses": [
                                            "Enduit brillant, d’origine industrielle, appliqué sur divers objets."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b5bbd9-639a-4c07-8b66-38d38137333d",
                                                "sense_id": "1d1e5ec2-8aac-319f-b518-bcfecd9e91ee",
                                                "text": "Une couche de laque protège la face du CD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6a4b960-330b-3520-a163-21591975333c",
                                        "entry_id": "4366ccd0-c076-3e33-8c85-2eec9ba2e580",
                                        "glosses": [
                                            "Enduit brillant appliqué sur les mets."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66a9103-fc5c-41cf-8b9d-08558397c190",
                                                "sense_id": "e6a4b960-330b-3520-a163-21591975333c",
                                                "text": "…vous mêlez au sucre avec un peu de laque au carmin pour colorer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85e7774e-2f38-3c07-afab-b6375aade6cc",
                                        "entry_id": "347d7058-0101-3395-a608-ca1517dedf97",
                                        "glosses": [
                                            "Vernis de Chine, noir ou rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbfa2786-237a-415f-9407-6bb822d26977",
                                                "sense_id": "85e7774e-2f38-3c07-afab-b6375aade6cc",
                                                "text": "Joseph, le valet de chambre, entra, présenta à son maître un plateau de vieux laque japonais, au centre duquel une carte de visite se pavanait."
                                            },
                                            {
                                                "example_id": "d3d5d9dd-c939-4642-b8a6-d1fc4ce1fd23",
                                                "sense_id": "85e7774e-2f38-3c07-afab-b6375aade6cc",
                                                "text": "Les panneaux en laque burgauté importés de Chine et du Japon étaient largement employés en Europe au cours des siècles et notamment au XVIIIème siècle pour orner les meubles précieux de grand et de petit format."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f26eb49-6622-3135-be8a-b6853305f9ed",
                                        "entry_id": "347d7058-0101-3395-a608-ca1517dedf97",
                                        "glosses": [
                                            "Objet ou meuble qui en est revêtu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2d6238-2527-4773-b654-2d5ce48fcbb2",
                                                "sense_id": "6f26eb49-6622-3135-be8a-b6853305f9ed",
                                                "text": "Les laques de l’Extrême-Orient ont depuis fort longtemps une renommée universelle. Ce sont des objets ordinairement en bois recouverts d’un vernis à base de résine, qui est appliqué à plusieurs couches et poli après chaque application ; …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f54eaadd-6906-3e7c-95aa-869f53e28e0e",
                                        "entry_id": "cfaf3e17-cd37-32f9-8a5f-2c724f6f6e06",
                                        "glosses": [
                                            "Produit capillaire en bombe aérosol que l’on vaporise sur les cheveux pour les maintenir en forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd43df3a-5f16-4880-9fa4-793c73a43d94",
                                                "sense_id": "f54eaadd-6906-3e7c-95aa-869f53e28e0e",
                                                "text": "Une bonne laque doit fixer mais sans « bétonner » ni poisser. Elle doit s’éliminer facilement, être sans danger, n’être pas trop chère. Voyons si, en pratique, cette laque idéale se trouve."
                                            },
                                            {
                                                "example_id": "6d1b42d2-7f47-4eef-8cd6-00fd119c98ef",
                                                "sense_id": "f54eaadd-6906-3e7c-95aa-869f53e28e0e",
                                                "text": "Dans ce musée des horreurs chimiques, revoilà L’Oréal, avec près d’une vingtaine de références, de la laque au vernis à ongles en passant par l’autobronzant."
                                            }
                                        ]
                                    }
                                ]
                            },
