                "senses": [
                    {
                        "sense_id": "b6918af7-dd39-3e4c-bd1a-4de4a4ee3390",
                        "entry_id": "b2272bbc-4561-3477-8ba8-3f139bb38647",
                        "glosses": [
                            "service après-vente d’une entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c59178b-b46d-4aee-976f-97de3951e0b3",
                                "sense_id": "b6918af7-dd39-3e4c-bd1a-4de4a4ee3390",
                                "text": "Le cœur de métier et les savoir-faire de l’après-vente (réparation automobile) relevaient traditionnellement d'une discipline principale, la mécanique ; ils relèvent aujourd'hui du champ de l'électronique… . — (Mariane Fresnay, Benoît Raucent et Pascale Wouters, Questions de pédagogies dans l'enseignement supérieur: les pédagogies actives : enjeux et conditions, éditeur Presses universitaires de Louvain, 2006)"
                            },
                            {
                                "example_id": "fdb099b6-b808-40bc-8fd4-bb1fcf6bf79b",
                                "sense_id": "b6918af7-dd39-3e4c-bd1a-4de4a4ee3390",
                                "text": "Ensuite, les grands magasins veulent bien vendre mais pas assurer l’après-vente."
                            }
                        ]
                    },
                    {
                        "sense_id": "f16f6cf4-2689-3d61-96a8-6c2f34f488ed",
                        "entry_id": "b2272bbc-4561-3477-8ba8-3f139bb38647",
                        "glosses": [
                            "Branche du marketing qui recherche la fidélisation des clients par un suivi commercial après-vente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f6c232-0f1a-4e96-b44e-5be8f75c82f4",
                                "sense_id": "f16f6cf4-2689-3d61-96a8-6c2f34f488ed",
                                "text": "Le marketing s’étend de la conception du produit jusqu’à l’après-vente, et son champ d’application s’agrandit (services, biens industriels, partis politiques, régions, célébrités, événements, etc.). — (Ulrike Mayrhofer, Marketing, Éditions Bréal, 2006)"
                            },
                            {
                                "example_id": "9f6661d2-d29c-4f09-85fb-26d822aec666",
                                "sense_id": "f16f6cf4-2689-3d61-96a8-6c2f34f488ed",
                                "text": "Il peut intervenir sur l’avant-vente, ou sur l’après- vente, aussi appelé « suivi d’affaires »"
                            }
                        ]
                    }
