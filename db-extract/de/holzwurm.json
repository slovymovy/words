                "senses": [
                    {
                        "sense_id": "79f9dcb8-bfe8-328b-8d1a-6565d30cc768",
                        "entry_id": "c0d8594e-311c-397a-8cb4-69deb2980e55",
                        "glosses": [
                            "holzfressendes Insekt beziehungsweise Larve eines Insekts"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d99c8b-d5d3-42ba-b86d-e6c3566d5858",
                                "sense_id": "79f9dcb8-bfe8-328b-8d1a-6565d30cc768",
                                "text": "Holzwürmer mögen kühles Klima, was dazu führt, dass sie gerne in großen Kirchen oder Lagerräumen Möbel befallen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e6df587-3b3f-4948-a23b-4554ec6072b1",
                        "source_entry_id": "c0d8594e-311c-397a-8cb4-69deb2980e55",
                        "source_sense_id": "79f9dcb8-bfe8-328b-8d1a-6565d30cc768",
                        "source_sense_description": "umgangssprachlich: holzfressendes Insekt beziehungsweise Larve eines Insekts",
                        "target_lang_word": "woodworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woodworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d067d83-b724-3687-9bd0-8898317dd393",
                                        "entry_id": "4fb51634-cac7-30f2-8467-c84e58e114c7",
                                        "glosses": [
                                            "Any of many beetle larvae that bore into wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876d19c6-7277-4092-834c-78924e440575",
                                                "sense_id": "0d067d83-b724-3687-9bd0-8898317dd393",
                                                "text": "1599, Simon Harward, “A Displaying of the wilfull deuises of wicked and vaine worldlings” in Three Sermons, London: Richard Johns,\n[…] Chrisostome doth compaire enuie to the wood worm which though it doe breede in the tymber, yet it doth consume & waste the tymber, as enuie springing of the heart doth putrifie and vtterly eat vp the heart."
                                            },
                                            {
                                                "example_id": "be0972eb-98f5-488e-83e9-8b51a91e6b4a",
                                                "sense_id": "0d067d83-b724-3687-9bd0-8898317dd393",
                                                "text": "1872, Robert Louis Stevenson, letter to Mrs. Thomas Stevenson dated July 29, 1872, in Sidney Colvin (editor), The Letters of Robert Louis Stevenson, New York: Scribner, 1917, Volume I, p. 45,\nThere was only one contretemps during the whole interview—the arrival of another visitor, in the shape (surely) the last of God’s creatures, a wood-worm of the most unnatural and hideous appearance, with one great striped horn stucking out of his nose like a boltsprit. If there are many wood-worms in Germany, I shall come home."
                                            },
                                            {
                                                "example_id": "0619fa71-b813-4133-82df-9b0b0520e121",
                                                "sense_id": "0d067d83-b724-3687-9bd0-8898317dd393",
                                                "text": "New Alresford is constantly mispronounced, T-shaped, honeycombed with cellars, packed with antique shops, riddled with woodworm, surrounded by watercress. The name - which means 'ford by the alders' - is pronounced 'Allsford'; and no one ever uses 'New', though they do call the adjoining village Old Alresford."
                                            },
                                            {
                                                "example_id": "8d55f974-4f0e-4748-b90d-c3e2b5a9a133",
                                                "sense_id": "0d067d83-b724-3687-9bd0-8898317dd393",
                                                "text": "His father met a man who said that he had the figure from a ship which went aground near Blackwater Head. It would have to be treated for woodworm, he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b99652b-b64b-3e34-b12c-d95cda18d8cc",
                                        "entry_id": "4fb51634-cac7-30f2-8467-c84e58e114c7",
                                        "glosses": [
                                            "Any of many beetle larvae that bore into wood.",
                                            "Anobium punctatum (common furniture beetle)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bed82ba-1ef0-3fe8-aa4a-cfd43f39d537",
                                        "entry_id": "4fb51634-cac7-30f2-8467-c84e58e114c7",
                                        "glosses": [
                                            "A shipworm, a worm-like mollusk in the family Teredinidae that feeds on wood underwater in saltwater."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
