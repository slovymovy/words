    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8da18e39-7750-3b00-af30-34addee41bc8",
                    "sense_definition": "Attacher, fixer ou serrer avec une ou plusieurs sangles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier prend le temps de bien <w>sangler</w> sa selle avant de monter."
                        },
                        {
                            "text": "Il faut <w>sangler</w> les bagages sur la remorque pour sécuriser le trajet."
                        }
                    ],
                    "synonyms": [
                        "serrer",
                        "attacher"
                    ],
                    "antonyms": [
                        "dessangler",
                        "détacher"
                    ],
                    "common_phrases": [
                        "sangler un cheval",
                        "sangler les bagages"
                    ]
                },
                {
                    "sense_id": "b57d45d9-3cd5-3672-9ae5-2880fd215e11",
                    "sense_definition": "Serrer étroitement le corps ou la taille dans un vêtement ajusté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'officier se tenait bien droit, <w>sanglé</w> dans un uniforme très ajusté."
                        },
                        {
                            "text": "Elle refusait de se <w>sangler</w> dans un corset aussi inconfortable."
                        }
                    ],
                    "synonyms": [
                        "corseter",
                        "mouler"
                    ],
                    "common_phrases": [
                        "sangler dans un uniforme",
                        "sangler dans un corset"
                    ]
                },
                {
                    "sense_id": "5283b40d-0235-3973-a3f9-c4711b792449",
                    "sense_definition": "Frapper quelqu'un ou un animal avec une sangle, un fouet ou une courroie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "frapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le charretier menaçait de <w>sangler</w> quiconque tenterait d'approcher ses chevaux."
                        },
                        {
                            "text": "Dans sa fureur, l'homme a violemment <w>sanglé</w> son adversaire avec sa ceinture."
                        }
                    ],
                    "synonyms": [
                        "fouetter",
                        "cravacher"
                    ],
                    "common_phrases": [
                        "sangler d'un coup de fouet"
                    ]
                },
                {
                    "sense_id": "2d28d503-8089-396a-b887-b67b50de0625",
                    "sense_definition": "Réprimander ou admonester très vivement une personne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reprimander",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a copieusement <w>sanglé</w> l'élève qui perturbait le cours."
                        },
                        {
                            "text": "Après cette lourde erreur, il s'est fait vertement <w>sangler</w> par son supérieur."
                        }
                    ],
                    "synonyms": [
                        "tancer",
                        "réprimander",
                        "blâmer"
                    ],
                    "common_phrases": [
                        "sangler d'importance"
                    ]
                }
            ]
        }
    ]
}