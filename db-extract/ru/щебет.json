                "translations": [
                    {
                        "translation_id": "0f718388-c3ac-4a12-84d2-891489ef4177",
                        "source_entry_id": "72452e1a-363c-3f4d-85be-dd3fb617fbff",
                        "source_sense_id": "f7a97b90-a10a-38d7-8f55-b653f7580f31",
                        "target_lang_word": "gazouillis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazouillis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                        "entry_id": "8046d6f6-7605-3a30-a182-8da4dd80b4e6",
                                        "glosses": [
                                            "Petit message de 140 puis 280 caractères maximum diffusé publiquement sur Twitter ou sur un réseau similaire tel que Bluesky ou Truth Social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15844bd7-db2e-4bae-9c34-2ae57b94f27f",
                                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                                "text": "Huitième Journée du livre politique — Lise Bissonnette pourfend gazouillis et placotages."
                                            },
                                            {
                                                "example_id": "aa7ea637-c1d8-4fa9-8f9e-e646467c2ac8",
                                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                                "text": "Les gazouillis de Twitter sont-ils dignes des écrivains ?"
                                            },
                                            {
                                                "example_id": "f46f2c7a-40cc-4774-9531-710ab81a9b26",
                                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                                "text": "Le président du Conseil européen, Charles Michel, a « fermement » condamné dans un gazouillis le coup d'État perpétré."
                                            },
                                            {
                                                "example_id": "e988b190-bb01-4ac6-a4ae-2e69e51049f4",
                                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                                "text": "Non seulement le profil du 45ᵉ président est unique dans l’histoire, mais il ne s’est jamais soucié de parler au nom de tous. Au contraire, ses 26 000 gazouillis ont exploité ou révélé toutes les fissures de la société américaine."
                                            },
                                            {
                                                "example_id": "f9173f4e-e77f-4002-b8f7-1a9ee2b1494e",
                                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                                "text": "De simples gazouillis présidentiels ont suffi pour ébranler le vaste Canada, cet « Empire des Bois et des Blés », disait-on jadis, ravalé en simple possession à confisquer, voué à devenir un state, le cinquante et unième de l'Union américaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gazouillis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58101872-832c-39b9-b79d-93f2f17c5df9",
                                        "entry_id": "abf86504-fec0-3a70-8b86-249a9ed12edc",
                                        "glosses": [
                                            "Bruits d’oiseaux qui gazouillent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1825487d-92e8-4a7c-a7ff-203fe19f7f45",
                                                "sense_id": "58101872-832c-39b9-b79d-93f2f17c5df9",
                                                "text": "Dans un bois l'amateur d'oiseaux distingue aussitôt ces gazouillis particuliers à chaque oiseau, que le vulgaire confond."
                                            },
                                            {
                                                "example_id": "d5818912-7400-4933-a719-6f7a5e4eff2d",
                                                "sense_id": "58101872-832c-39b9-b79d-93f2f17c5df9",
                                                "text": "Vint un matin de grande beauté où le cœur est en fête sans d’autres raisons que le parfum de l’air, le gazouillis des oiseaux, la clarté déjà blonde sur les prés, entre des forêts sombres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b75d145-2670-3e2a-9d4b-3d20adee6815",
                                        "entry_id": "abf86504-fec0-3a70-8b86-249a9ed12edc",
                                        "glosses": [
                                            "Bruit léger et agréable produit par une personne, un animal ou une chose qui gazouille."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a13fc7e-7785-46ab-aabd-bfa29eb22886",
                                                "sense_id": "1b75d145-2670-3e2a-9d4b-3d20adee6815",
                                                "text": "Comme les enfants possèdent une glande dont la liqueur les aide à digérer le lait et qui n'existe plus chez les grandes personnes, il y avait dans le gazouillis de ces jeunes filles des notes que les femmes n'ont plus."
                                            },
                                            {
                                                "example_id": "bb6622c9-e72f-4792-9076-8ee0b6ba9e26",
                                                "sense_id": "1b75d145-2670-3e2a-9d4b-3d20adee6815",
                                                "text": "Vers 2 mois ou 2 mois et demi débute la magnifique phase du gazouillis, des « areuh » que le bébé va moduler de mille manières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
