                    {
                        "translation_id": "ff084eab-20df-468c-8824-02703ecf9c20",
                        "source_entry_id": "07b2d48a-506f-361c-8057-3e9dc2e708d3",
                        "source_sense_id": "7d836f3e-9d8f-34c4-b018-46589efe33a1",
                        "target_lang_word": "Separatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Separatismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                        "entry_id": "8df155cb-24be-3116-8433-6548ff9c0d95",
                                        "glosses": [
                                            "Streben nach Separation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49561914-8e7a-40c1-8b02-cb9fdb4b41a0",
                                                "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                                "text": "Den lebensbedrohlichen Zorn der Eta hat er sich auf Grund seiner kritischen Auseinandersetzung mit dem radikalen Separatismus zugezogen, der auch in seiner eigenen Partei anzutreffen ist."
                                            },
                                            {
                                                "example_id": "0af45e3f-746c-4d52-ac54-4c203a8c0513",
                                                "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                                "text": "Der Machtverfall der Moskauer Behörden hat die Konzentration wirtschaftlicher Macht praktisch nicht berührt. Sie tritt in destruktiven Tendenzen wie ungebremstem Separatismus und chaotischer Selbstversorgung von ganzen Regionen immer bedrohlicher zutage."
                                            },
                                            {
                                                "example_id": "51d075c6-16c4-473b-8f0d-23d301c14605",
                                                "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                                "text": "Den Kurden ist es untersagt, \"Q\", \"W\" und \"X\" zu verwenden. Kurdische Politiker werden häufig vor Gericht gestellt, weil sie die Buchstaben in offiziellen Schreiben verwenden. Der Buchstabe „W\" gilt überhaupt als Zeichen des kurdischen Separatismus."
                                            },
                                            {
                                                "example_id": "fe3233a0-5730-4396-b5bc-8d2a257defec",
                                                "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                                "text": "In der Ausübung seines Amtes kam er über die Versuchung zum Separatismus hinaus, indem er die Strenge des christlichen Lebens immer als die Aufgabe hochhielt, um deren willen er an der Kirche Zweifel gehegt hatte."
                                            },
                                            {
                                                "example_id": "11d46238-2f93-46e4-a9eb-86d10c074390",
                                                "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                                "text": "Indessen gibt es schon seit mehreren Menschenaltern auch im Vinschgau und in Ähren etliche widerborstige Berghöfe, welche von geistlicher und weltlicher Obrigkeit ungeschoren, sich eines stillen unbekannten Separatismus erfreuen."
                                            },
                                            {
                                                "example_id": "3875fa41-6098-49b9-8c60-eea6c5e8009d",
                                                "sense_id": "08f3cb99-7d85-3cf6-b6a7-86b5751f9a3e",
                                                "text": "Wenn das Volk noch nicht ganz frey von mancherley Aberglauben ist, so ist es dagegen desto freyer von Pietismus, Mysticismus und Separatismus, wovor es sein lebensfroher Sinn bewahrt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
