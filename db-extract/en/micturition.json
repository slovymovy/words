                "senses": [
                    {
                        "sense_id": "7b577fbe-c886-3b6c-bc1b-f27636373d56",
                        "entry_id": "a3924e75-4a31-3592-aa6e-8c56c216e99d",
                        "glosses": [
                            "Urination."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "adf1fb7e-6097-4805-a79b-a5a720172434",
                                "sense_id": "7b577fbe-c886-3b6c-bc1b-f27636373d56",
                                "text": "For those unlucky enough to be on a service without lavatory provision, we can only speculate as to how passengers improvised if caught short. For men, it might be possible to urinate, albeit at the risk of offending fellow passengers - there were reports of passengers being hauled up before the courts for 'micturition' in coaches during the 19th century."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c07f89e-9bf6-47e1-9b94-eb8ea5296f42",
                        "source_entry_id": "a3924e75-4a31-3592-aa6e-8c56c216e99d",
                        "source_sense_id": "7b577fbe-c886-3b6c-bc1b-f27636373d56",
