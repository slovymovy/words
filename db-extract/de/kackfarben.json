                "senses": [
                    {
                        "sense_id": "a4ac1d7c-815e-3da3-8883-9a47b9c8ab08",
                        "entry_id": "b22ec8b7-fb24-35e0-a4be-ae03a1b93184",
                        "glosses": [
                            "die Farbe von Kot habend, in einem an Kacke erinnernden Braunton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13839ff3-b5bb-4953-8f48-6863640bbe2c",
                                "sense_id": "a4ac1d7c-815e-3da3-8883-9a47b9c8ab08",
                                "text": "„Die Tapete in der Eingangshalle war kackfarben, der Anstrich ebenso.“"
                            },
                            {
                                "example_id": "69f5b1bb-3ec9-4b76-98ce-33216c62a5a7",
                                "sense_id": "a4ac1d7c-815e-3da3-8883-9a47b9c8ab08",
                                "text": "„Der Mann war dünn, der Hund war fett, aber sonst wirkten die beiden ziemlich gleich. Ein dunkelbrauner kackfarbener Hund, der aussah, als habe man ihn mit der Luftpumpe aufgeblasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
