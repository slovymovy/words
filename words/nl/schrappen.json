    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48810931-7ab4-3733-94fc-17cf31640791",
                    "sense_definition": "iets uit een tekst of van een lijst verwijderen door het door te halen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet die overbodige woorden uit de tekst <w>schrappen</w>.",
                            "target_lang_translations": {
                                "en": "You should <w>strike</w> those redundant words from the text.",
                                "ru": "Тебе нужно <w>вычеркнуть</w> эти лишние слова из текста."
                            }
                        },
                        {
                            "text": "De leraar besloot een paar namen van de lijst te <w>schrappen</w>.",
                            "target_lang_translations": {
                                "en": "The teacher decided to <w>remove</w> a few names from the list.",
                                "ru": "Учитель решил <w>удалить</w> несколько имен из списка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van de lijst schrappen",
                        "uit de tekst schrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove something from a text or a list by crossing it out or deleting it",
                        "ru": "удалить что-либо из текста или списка, вычеркнув или исключив это"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "to delete or cross out text"
                            },
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "to take something off a list"
                            },
                            {
                                "target_lang_word": "scrap",
                                "target_lang_sense_clarification": "to discard or get rid of an item"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to cease to include something on a list"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вычеркивать",
                                "target_lang_sense_clarification": "удалять текст или имя из списка"
                            },
                            {
                                "target_lang_word": "удалять",
                                "target_lang_sense_clarification": "убирать пункт из списка или документа"
                            },
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "перестать включать что-либо в перечень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72d5b844-29f0-384a-8e76-dc6b565eb25a",
                    "sense_definition": "een geplande activiteit of afspraak niet door laten gaan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanwege de storm moest de luchtvaartmaatschappij alle vluchten <w>schrappen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the storm, the airline had to <w>cancel</w> all flights.",
                                "ru": "Из-за шторма авиакомпании пришлось <w>отменить</w> все рейсы."
                            }
                        },
                        {
                            "text": "De organisatie besloot het evenement op het laatste moment te <w>schrappen</w>.",
                            "target_lang_translations": {
                                "en": "The organization decided to <w>scrap</w> the event at the last minute.",
                                "ru": "Организация решила <w>отменить</w> мероприятие в последний момент."
                            }
                        }
                    ],
                    "synonyms": [
                        "annuleren"
                    ],
                    "common_phrases": [
                        "vluchten schrappen",
                        "een afspraak schrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cancel a planned activity or appointment",
                        "ru": "отменить запланированное мероприятие или встречу"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "to call off a planned event"
                            },
                            {
                                "target_lang_word": "scrap",
                                "target_lang_sense_clarification": "to abandon a plan or project"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to stop participating in a scheduled event"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "прекращать запланированное событие"
                            },
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "официально отменять рейс или договоренность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca4b1602-5400-3dbb-b220-61896b63cabe",
                    "sense_definition": "met een mesje de dunne schil van groenten verwijderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou jij de worteltjes willen <w>schrappen</w> voor het avondeten?",
                            "target_lang_translations": {
                                "en": "Would you like to <w>scrape</w> the carrots for dinner?",
                                "ru": "Не мог бы ты <w>почистить</w> морковку к ужину?"
                            }
                        },
                        {
                            "text": "Vroeger moesten we altijd zelf de aardappels <w>schrappen</w>.",
                            "target_lang_translations": {
                                "en": "In the past, we always had to <w>peel</w> the potatoes ourselves.",
                                "ru": "Раньше нам всегда приходилось самим <w>чистить</w> картошку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worteltjes schrappen",
                        "aardappels schrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove the thin skin of vegetables using a knife or scraper",
                        "ru": "снимать ножом тонкую кожицу с овощей"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrape",
                                "target_lang_sense_clarification": "to remove a surface layer with a sharp object"
                            },
                            {
                                "target_lang_word": "peel",
                                "target_lang_sense_clarification": "to remove the outer skin of vegetables"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "снимать кожуру с овощей"
                            },
                            {
                                "target_lang_word": "соскабливать",
                                "target_lang_sense_clarification": "удалять верхний слой ножом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53be9187-7f31-3671-863a-f958577cf554",
                    "sense_definition": "bezuinigen door een budget of programma stop te zetten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bezuinigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid gaat flink <w>schrappen</w> in de subsidies voor cultuur.",
                            "target_lang_translations": {
                                "en": "The government is going to <w>cut</w> culture subsidies significantly.",
                                "ru": "Правительство собирается сильно <w>сократить</w> субсидии на культуру."
                            }
                        },
                        {
                            "text": "Door de crisis moest het bedrijf in de uitgaven <w>schrappen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the crisis, the company had to <w>slash</w> its expenses.",
                                "ru": "Из-за кризиса компании пришлось <w>урезать</w> расходы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de uitgaven schrappen",
                        "subsidies schrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make budget cuts by stopping a program or expenditure",
                        "ru": "сокращать расходы, прекращая финансирование программ или бюджета"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to reduce or delete budget items"
                            },
                            {
                                "target_lang_word": "slash",
                                "target_lang_sense_clarification": "to reduce a budget drastically"
                            },
                            {
                                "target_lang_word": "axe",
                                "target_lang_sense_clarification": "to end a program or budget completely"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "урезать бюджетные статьи"
                            },
                            {
                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "значительно уменьшать расходы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89824d47-87f7-3dc9-9f56-6c0b38549cbe",
                    "sense_definition": "iemand uit zijn functie ontheffen of een baan opheffen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ontslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de reorganisatie werden honderden arbeidsplaatsen <w>geschrapt</w>.",
                            "target_lang_translations": {
                                "en": "Hundreds of jobs were <w>cut</w> during the reorganization.",
                                "ru": "В ходе реорганизации были <w>сокращены</w> сотни рабочих мест."
                            }
                        },
                        {
                            "text": "Het is pijnlijk als je eigen functie wordt <w>geschrapt</w>.",
                            "target_lang_translations": {
                                "en": "It is painful when your own position is <w>eliminated</w>.",
                                "ru": "Больно, когда твою собственную должность <w>упраздняют</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "banen schrappen",
                        "arbeidsplaatsen schrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to dismiss someone from their position or to eliminate a job role",
                        "ru": "увольнять кого-либо с должности или ликвидировать рабочее место"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to eliminate jobs or positions"
                            },
                            {
                                "target_lang_word": "shed",
                                "target_lang_sense_clarification": "to get rid of jobs during a reorganization"
                            },
                            {
                                "target_lang_word": "axe",
                                "target_lang_sense_clarification": "to dismiss staff or eliminate roles"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "ликвидировать рабочие места"
                            },
                            {
                                "target_lang_word": "упразднять",
                                "target_lang_sense_clarification": "ликвидировать должность в штате"
                            }
                        ]
                    }
                }
            ]
        },
