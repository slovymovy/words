                "senses": [
                    {
                        "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                        "entry_id": "071b3eea-9f6b-3e33-978c-522b3022ae2c",
                        "glosses": [
                            "das Verbot einer politischen Partei"
                        ],
                        "tags": [
                            "rechtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "57e7b36a-493a-461f-9bea-b277fad338b8",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "„Durch das Parteiverbot der NSDAP infolge des Hitlerputsches am 9. November 1923 musste die Zeitung ihr Erscheinen einstellen, mit Neugründung der NSDAP am 26. Februar 1925 erschien sie wieder.“"
                            },
                            {
                                "example_id": "384d7278-cfd1-48d8-83ff-0d5f59fd29ca",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "„In Westdeutschland blieb die KPD eine Kleinpartei, ehe sie 1956 auf Antrag der Bundesregierung mit einem Parteiverbot belegt wurde.“"
                            },
                            {
                                "example_id": "d4676a98-db61-4bea-ab9f-971b8ad9b5fb",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "„Die Voraussetzungen für ein Parteiverbot hat das Bundesverfassungsgericht im NPD-Urteil 2017 grundlegend herausgearbeitet. Die Hürden sind hoch.“"
                            },
                            {
                                "example_id": "0129029b-05c5-45b5-875b-5c297d8ff55b",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "[…] „die Hürden für ein Parteiverbot sind hoch.“"
                            },
                            {
                                "example_id": "f752b9a1-9e98-478f-8971-195549c1e98c",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "„»Das Parteiverbot darf nicht benutzt werden, um unliebsame politische Konkurrenz auszuschalten.«“"
                            },
                            {
                                "example_id": "bd995b02-b307-438f-a3d9-6f99b860e643",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "„Über Parteiverbot und Parteifinanzierungsausschluss entscheidet das BVerfG nach Art. 21 Abs. 4 GG.“"
                            },
                            {
                                "example_id": "da254b0b-10c5-416d-b12c-526986beae14",
                                "sense_id": "8100c5ac-87ab-3ca2-a540-d8189c10eacd",
                                "text": "[Bundesverfassungsgericht:] „Für einige Beschlüsse wie Parteiverbote, den Entzug von Grundrechten oder Präsidentenanklagen sind Zweidrittelmehrheiten der Mitglieder des zuständigen Senats vorgeschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
