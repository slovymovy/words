                "senses": [
                    {
                        "sense_id": "c578b8f1-d224-3e79-bd24-97e64749f012",
                        "entry_id": "b2772205-ae8d-3b9c-9aba-c611d0c35cf9",
                        "glosses": [
                            "Twister à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e19bfb-3f40-4d56-a0ec-c81322b942af",
                                "sense_id": "c578b8f1-d224-3e79-bd24-97e64749f012",
                                "text": "On revalse, on refox-trotte, on retwiste en français, en anglais, en italien, en espagnol."
                            },
                            {
                                "example_id": "a5b4f9a9-795b-4bff-b74f-b4e9f5959eef",
                                "sense_id": "c578b8f1-d224-3e79-bd24-97e64749f012",
                                "text": "Si tu comptes faire du tir sur cible, je te déconseille les excalibur car tu sera tout le temps en train de retwister ta corde et ainsi n'obtiendra un GROUPING de la mort si tu veux !!"
                            },
                            {
                                "example_id": "4f965651-1366-49da-8675-42af91abd01c",
                                "sense_id": "c578b8f1-d224-3e79-bd24-97e64749f012",
                                "text": "Je galère un peu car je lave mes cheveux chaque semaine et suis obligée de retwister 2 fois par semaine."
                            }
                        ]
                    }
