{
    "word_family": [
        "deify",
        "deification",
        "deistic",
        "deism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                    "sense_definition": "A supernatural divine being; a god or goddess.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divine_beings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient Greek mythology, Zeus was considered the supreme <w>deity</w> who ruled over all other gods.",
                            "target_lang_translations": {
                                "ru": "В древнегреческой мифологии Зевс считался верховным <w>божеством</w>, правившим всеми остальными богами."
                            }
                        },
                        {
                            "text": "The tribe worshipped a powerful <w>deity</w> associated with the sun and the harvest.",
                            "target_lang_translations": {
                                "ru": "Племя поклонялось могущественному <w>божеству</w>, связанному с солнцем и урожаем."
                            }
                        }
                    ],
                    "synonyms": [
                        "god",
                        "divinity"
                    ],
                    "common_phrases": [
                        "supreme deity",
                        "worship a deity",
                        "ancient deity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверхъестественное божественное существо; бог или богиня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "божество",
                                "target_lang_sense_clarification": "сверхъестественное существо, бог или богиня"
                            },
                            {
                                "target_lang_word": "бог",
                                "target_lang_sense_clarification": "высшее существо в религии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2d532ec-02d0-3b06-9091-453ea7454590",
                    "sense_definition": "The state, position, or fact of being a god; <w>divinity</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "divine_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emperor claimed absolute <w>deity</w>, demanding that his subjects worship him as a living god.",
                            "target_lang_translations": {
                                "ru": "Император заявлял о своей абсолютной <w>божественности</w>, требуя, чтобы подданные поклонялись ему как живому богу."
                            }
                        },
                        {
                            "text": "Theologians debated the nature of Christ's <w>deity</w> for several centuries.",
                            "target_lang_translations": {
                                "ru": "Теологи спорили о природе <w>божественности</w> Христа на протяжении нескольких веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "divinity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is less common in modern usage and often found in older theological texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Статус, положение или факт бытия богом; божественность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "божественность",
                                "target_lang_sense_clarification": "божественная природа или статус"
                            },
                            {
                                "target_lang_word": "божество",
                                "target_lang_sense_clarification": "божественная сущность или природа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}