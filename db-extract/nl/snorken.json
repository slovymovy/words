        "nl-extract.jsonl": [
            {
                "entry_id": "bc938ca6-1042-3796-8b7b-2b6030d6275f",
                "word": "snorken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "abb326d6-9644-3c0d-af68-176d4a1f24b7",
                        "entry_id": "bc938ca6-1042-3796-8b7b-2b6030d6275f",
                        "glosses": [
                            "een keelgeluid maken dat lijkt op snurken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c29f4c0-7c1b-4cfa-9e45-eaa6fb83854e",
                                "sense_id": "abb326d6-9644-3c0d-af68-176d4a1f24b7",
                                "text": "Verdachte laat zien hoe hij met de vlakke linkerhand het T-shirt tegen het lichaam drukte. Het shirt was niet gevouwen of op een prop. “Ik heb een paar keer horen snorken, toen hield het op. Ik heb een paar seconden gewacht en wist niet meer wat ik moest doen”."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd888957-1f8b-36fe-93c1-ae954aebdb1d",
                        "entry_id": "bc938ca6-1042-3796-8b7b-2b6030d6275f",
                        "glosses": [
                            "pochen, opscheppen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c50f99c-37b0-4aed-b20a-0779a38ea621",
                        "source_entry_id": "bc938ca6-1042-3796-8b7b-2b6030d6275f",
                        "source_sense_id": "abb326d6-9644-3c0d-af68-176d4a1f24b7",
                        "source_sense_description": "een keelgeluid maken dat lijkt op snurken",
                        "target_lang_word": "snore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc66e94-1076-385f-b5c8-0c29c1a263b7",
                                        "entry_id": "56f87b0c-a71f-3ac6-aecc-62e5734f775d",
                                        "glosses": [
                                            "To breathe during sleep with harsh, snorting noises caused by vibration of the soft palate."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7318c3a-0192-4a5e-b560-1b1797900bd5",
                                                "sense_id": "3fc66e94-1076-385f-b5c8-0c29c1a263b7",
                                                "text": "While you here do ſnoaring lie, / Open-ey'd Conſpiracie / His time doth take: / If of Life you keepe a care, / Shake off ſlumber, and beware. / Awake, awake."
                                            },
                                            {
                                                "example_id": "cfc6833a-ac3c-4bf9-9884-d24dbce877c0",
                                                "sense_id": "3fc66e94-1076-385f-b5c8-0c29c1a263b7",
                                                "text": "The lumpiſh husband ſnoar'd avvay the night, / Till coughs avvak'd him near the morning light."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "772c4d37-1495-33c6-b3d2-6d63fe193aae",
                                        "entry_id": "c66bdb0c-c392-3016-8a53-5201f31e5c74",
                                        "glosses": [
                                            "The act of snoring, and the noise produced."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f291d42-d251-36c2-8e4d-4543386b1972",
                                        "entry_id": "c66bdb0c-c392-3016-8a53-5201f31e5c74",
                                        "glosses": [
                                            "An extremely boring person or event."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5c74f44-515f-4197-aa39-d5bb5cabc07a",
                        "source_entry_id": "bc938ca6-1042-3796-8b7b-2b6030d6275f",
                        "source_sense_id": "dd888957-1f8b-36fe-93c1-ae954aebdb1d",
                        "source_sense_description": "pochen, opscheppen",
                        "target_lang_word": "boast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f841bef3-8e63-35f2-865d-3d578f617ce5",
                                        "entry_id": "f09db8b2-b4b8-34ec-9049-c88cb33fd944",
                                        "glosses": [
                                            "A brag; ostentatious positive appraisal of oneself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3757ce1e-caae-3aaf-a7f7-6883488e6b3e",
                                        "entry_id": "f09db8b2-b4b8-34ec-9049-c88cb33fd944",
                                        "glosses": [
                                            "Something that one brags about."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9679de6-4f2f-4ae2-978a-fe817790e61f",
                                                "sense_id": "3757ce1e-caae-3aaf-a7f7-6883488e6b3e",
                                                "text": "It was his regular boast that he could eat two full English breakfasts in one sitting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d0eb274-7651-3104-a195-d9477a1e5773",
                                        "entry_id": "f09db8b2-b4b8-34ec-9049-c88cb33fd944",
                                        "glosses": [
                                            "A shot where the ball is driven off a side wall and then strikes the front wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "boast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5da4897a-1773-3740-a75a-251c7930ede1",
                                        "entry_id": "374ad0d3-a560-3a8e-9a09-5dc4b2826701",
                                        "glosses": [
                                            "To brag; to talk loudly in praise of oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ccb2d4c-953e-4828-ac7f-c63703f78a68",
                                                "sense_id": "5da4897a-1773-3740-a75a-251c7930ede1",
                                                "text": "On no account will he or any other kind be able to boast that he's escaped the pursuit of those who can follow so detailed and comprehensive a method of enquiry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bc9aa9e-2364-338e-8316-047f87fabcc1",
                                        "entry_id": "374ad0d3-a560-3a8e-9a09-5dc4b2826701",
                                        "glosses": [
                                            "(used with \\\"about\\\" or \\\"of\\\") To speak of with pride, vanity, or exultation, with a view to self-commendation; to extol."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef7421f2-b445-4d44-9606-25748931c567",
                                                "sense_id": "5bc9aa9e-2364-338e-8316-047f87fabcc1",
                                                "text": "Lest bad men should boast / Their specious deeds."
                                            },
                                            {
                                                "example_id": "b2d81846-9125-4ce3-a081-a88173e8492a",
                                                "sense_id": "5bc9aa9e-2364-338e-8316-047f87fabcc1",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\",[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244aba9f-d8f9-3753-9d3f-fba0e7b04b29",
                                        "entry_id": "374ad0d3-a560-3a8e-9a09-5dc4b2826701",
                                        "glosses": [
                                            "To speak in exulting language of another; to glory; to exult."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f81c3fc-80f3-49ff-82f1-63f2faf3614c",
                                                "sense_id": "244aba9f-d8f9-3753-9d3f-fba0e7b04b29",
                                                "text": "In God we boast all the day long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ace6dc-6197-341e-a747-67adb07abb80",
                                        "entry_id": "374ad0d3-a560-3a8e-9a09-5dc4b2826701",
                                        "glosses": [
                                            "To play a boast shot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dae672a8-3d3f-3d41-8d8f-6cd7557a8229",
                                        "entry_id": "374ad0d3-a560-3a8e-9a09-5dc4b2826701",
                                        "glosses": [
                                            "To possess (a special and desirable quality)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e278322-fda7-4059-a438-2e0bd257581c",
                                                "sense_id": "dae672a8-3d3f-3d41-8d8f-6cd7557a8229",
                                                "text": "The hotel boasts one of the best views of the sea."
                                            },
                                            {
                                                "example_id": "d189ebcb-b17f-453a-b25f-93efcb9c6e28",
                                                "sense_id": "dae672a8-3d3f-3d41-8d8f-6cd7557a8229",
                                                "text": "His family boasted a famous name."
                                            },
                                            {
                                                "example_id": "d2100205-1de0-4857-8d54-e736e577f5d1",
                                                "sense_id": "dae672a8-3d3f-3d41-8d8f-6cd7557a8229",
                                                "text": "Jinhua and others are spending big to get there. In Jinjiang, a city in Fujian Province once known as a shoe-manufacturing center, Jinhua’s new factory is almost finished. Rising five stories and stretching several football fields long, the structure boasts 100,000 square feet of new office space."
                                            },
                                            {
                                                "example_id": "4c833b7c-52e4-4e7c-bf8e-132ffd369d88",
                                                "sense_id": "dae672a8-3d3f-3d41-8d8f-6cd7557a8229",
                                                "text": "After dropping off travellers at Foregate Street, my train terminates at Shrub Hill - a station which boasts one of the best selection [sic] of semaphore signals left in the country."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boast",
                                "target_lang_code": "en",
                                "target_senses": [
