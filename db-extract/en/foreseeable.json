                                        "examples": [
                                            {
                                                "example_id": "4a370ce3-fc6d-4ad0-81cb-13223c81c315",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "Die Folgen seines Handelns sind noch nicht absehbar."
                                            },
                                            {
                                                "example_id": "8b5fad68-4c16-4a4a-b191-6647413d3d16",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "Es war absehbar, dass er absagen würde."
                                            },
                                            {
                                                "example_id": "3ae93fd3-7f85-4a11-a752-9c57a2b57078",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "Die ersten Veränderungen sollten in absehbarer Zeit eintreten."
                                            },
                                            {
                                                "example_id": "f4d4efca-eaa8-4356-a9f7-517d641ecc6b",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "„Diese grausame Trennung ohne absehbare Zukunft brachte uns aus der Fassung und lieferte uns wehrlos den Erinnerungen an jene noch so greifbar nahe und doch so ferne Gegenwart aus, die nun unsere Tage erfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
