                "senses": [
                    {
                        "sense_id": "837d7c07-29bf-3d92-b8c1-043f962d1259",
                        "entry_id": "0d03547f-59e8-3b87-952a-0d681ed22412",
                        "glosses": [
                            "Fähigkeit, mit der Sprache wirkungsvoll umgehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "520b875c-1663-4be3-adbc-dd7ae9950f99",
                                "sense_id": "837d7c07-29bf-3d92-b8c1-043f962d1259",
                                "text": "„Im legalen Rahmen der demokratischen Institutionen steigt Perikles durch seine Redebegabung zu einer führenden Persönlichkeit in Athen auf.“"
                            },
                            {
                                "example_id": "ee9f759f-1ddb-4fce-a816-aba73e52b1fb",
                                "sense_id": "837d7c07-29bf-3d92-b8c1-043f962d1259",
                                "text": "„Das siebte und achte Lebensalter fasst Ambrosius in Anlehnung an Solon zusammen, schreibt den somit entstandenen 14 Jahren eine gewisse Reife, sinnliche Kraft und Redebegabung zu.“"
                            },
                            {
                                "example_id": "97b6550c-8691-4bed-850a-2ec747aadbbf",
                                "sense_id": "837d7c07-29bf-3d92-b8c1-043f962d1259",
                                "text": "„Die Italiener lieben es, ihre Geschäftspartner zu schnellen Entscheidungen zu führen; sie überzeugen durch ihre Redebegabung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
