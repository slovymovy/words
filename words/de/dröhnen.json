                    "sense_definition": "wie ein starkes Rauschmittel wirken oder berauschend sein",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der selbstgemachte Schnaps <w>dröhnt</w> unerwartet stark und steigt sofort zu Kopf."
                        },
                        {
                            "text": "Trink nicht zu viel von dem warmen Glühwein, denn er <w>dröhnt</w> ganz gewaltig."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
