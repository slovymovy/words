                "senses": [
                    {
                        "sense_id": "70b7cdf9-a422-328d-94de-781e1c9ec607",
                        "entry_id": "e770782a-87ce-367f-a8f4-67f2713081dd",
                        "glosses": [
                            "Assurer la prémultiplication de plants ou de semences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9cec1d-8704-45a9-b5c2-91c5b1409900",
                                "sense_id": "70b7cdf9-a422-328d-94de-781e1c9ec607",
                                "text": "Les plus intéressantes font l'objet d'un agrément pas le CTPS, sont conservées à l'ENTAV pour y être pré-multipliées puis multipliées, dans un souci constant de maintenir la pureté génétique et sanitaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f993b7f-9ef8-366d-acf1-6cbf38e1caeb",
                        "entry_id": "e770782a-87ce-367f-a8f4-67f2713081dd",
                        "glosses": [
                            "Multiplier (une matrice A) par une autre en mettant A en deuxième dans la multiplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d6790b-2626-4bd6-8301-694741fa68d2",
                                "sense_id": "3f993b7f-9ef8-366d-acf1-6cbf38e1caeb",
                                "text": "Pré-multiplier la matrice par une autre matrice."
                            },
                            {
                                "example_id": "dd188e63-0ac5-4d17-9452-ec4485a3ce64",
                                "sense_id": "3f993b7f-9ef8-366d-acf1-6cbf38e1caeb",
                                "text": "Cette matrice est ensuite pré-multipliée par sa transposée de façon à obtenir une matrice [X’X] (p,p) de variance covariance (également matrice des corrélations si les variables sont centrées réduites)."
                            }
                        ]
                    }
