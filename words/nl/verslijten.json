    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d8e6bb4-4313-3fe3-b218-7d97abe32492",
                    "sense_definition": "door veelvuldig gebruik onbruikbaar maken of laten slijten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slijtage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>versleet</w> zijn schoenen tijdens de lange wandeling door de bergen.",
                            "target_lang_translations": {
                                "en": "He <w>wore out</w> his shoes during the long hike through the mountains."
                            }
                        },
                        {
                            "text": "Door het vele sporten <w>verslijt</w> hij zijn kleding erg snel.",
                            "target_lang_translations": {
                                "en": "Because of all the sports, he <w>wears out</w> his clothes very quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "afdragen",
                        "verbruiken"
                    ],
                    "common_phrases": [
                        "schoenen verslijten"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something unusable or worn out through frequent use."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wear out",
                                "target_lang_sense_clarification": "To make an object unusable through extensive use."
                            },
                            {
                                "target_lang_word": "use up",
                                "target_lang_sense_clarification": "To consume or exhaust the utility of an item."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44b6d9e7-2fbd-3aab-8bb6-0f42c9320c67",
                    "sense_definition": "iemand onterecht aanzien voor iets of iemand anders",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aanzien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verslijt</w> je mij nu echt voor een leugenaar?",
                            "target_lang_translations": {
                                "en": "Are you really <w>taking</w> me <w>for</w> a liar?"
                            }
                        },
                        {
                            "text": "Men <w>versleet</w> hem voor een oplichter vanwege zijn vreemde gedrag.",
                            "target_lang_translations": {
                                "en": "People <w>mistook</w> him <w>for</w> a con artist because of his strange behavior."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanzien",
                        "houden voor"
                    ],
                    "common_phrases": [
                        "verslijten voor"
                    ],
                    "target_lang_definitions": {
                        "en": "To mistakenly or unfairly take someone for someone else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mistake for",
                                "target_lang_sense_clarification": "To incorrectly identify someone as another person."
                            },
                            {
                                "target_lang_word": "take for",
                                "target_lang_sense_clarification": "To wrongly assume someone has a certain identity or character."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9ad546-9ca7-3ecb-bcdb-3a03d16d2226",
                    "sense_definition": "door veelvuldig gebruik onbruikbaar worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slijtage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude jas is na jarenlang dragen volledig <w>versleten</w>.",
                            "target_lang_translations": {
                                "en": "The old coat is completely <w>worn out</w> after years of wearing it."
                            }
                        },
                        {
                            "text": "De banden van de auto zijn <w>versleten</w> en moeten worden vervangen.",
                            "target_lang_translations": {
                                "en": "The car tires are <w>worn out</w> and need to be replaced."
                            }
                        }
                    ],
                    "synonyms": [
                        "slijten"
                    ],
                    "target_lang_definitions": {
                        "en": "To become unusable due to frequent use."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wear out",
                                "target_lang_sense_clarification": "To become damaged or useless from long-term use."
                            },
                            {
                                "target_lang_word": "become worn",
                                "target_lang_sense_clarification": "To show signs of damage or thinning due to friction or use."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}