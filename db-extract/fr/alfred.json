                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78ec95de-d8e4-4bf7-9cac-c5700c5813e6",
                        "entry_id": "df7f062b-185a-35ec-8ea0-b0d595d857a7",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Audrey"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                        "entry_id": "df7f062b-185a-35ec-8ea0-b0d595d857a7",
                        "glosses": [
                            "Prénom masculin français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d3887ca-43ce-4286-87d9-fffeef408aa6",
                                "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                "text": "« Alfred. Vous avez les coordonnées ?\n— Presque Monsieur. Il y a plus d’interférences que d’habitude. »"
                            },
                            {
                                "example_id": "185db95c-b077-4ded-aca2-2cf1524fc6c4",
                                "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                "text": "Attablé à une terrasse, cours de la République, un nom qui sonne toujours bien à l'oreille, Alfred expliqua qu'il était en phase de récupération."
                            },
                            {
                                "example_id": "6745d569-64ba-4485-8c58-8d89beae32f8",
                                "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                "text": "L’architecte choisi pour construire cette première gare à Saint-Cloud est Alfred Armand (1805-1888), ancien élève de l'école des beaux-arts, disciple des architectes Jean-Louis Provost et Achille Leclère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80a21ccc-543a-495c-9b6a-3b5eedffd715",
                        "source_entry_id": "df7f062b-185a-35ec-8ea0-b0d595d857a7",
                        "source_sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                        "target_lang_word": "Alfred",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alfred",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27799c98-cd3c-3dbf-935c-82cd668f52a2",
                                        "entry_id": "416c105f-d0e3-3a51-9bf2-c840c562cba3",
                                        "glosses": [
                                            "Alfred the Great, early king of England."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a6d82ac-c462-3a87-b186-71b32f451b75",
                                        "entry_id": "416c105f-d0e3-3a51-9bf2-c840c562cba3",
                                        "glosses": [
                                            "A male given name from Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "464b11bd-6346-4227-b5d3-50443f55c267",
                                                "sense_id": "0a6d82ac-c462-3a87-b186-71b32f451b75",
                                                "text": "Unfortunately for me my father had combined diplomacy with a study of Anglo-Saxon history and, of course with my mother's consent, he gave me the name of Alfred, one of his heroes ( I believe she had boggled at Aelfred ). This Christian name, for some inexplicable reason, had become corrupted in the eyes of our middle-class world; it belonged exclusively now to the working class and was usually abbreviated to Alf. Perhaps that was why Doctor Fisher, the inventor of Dentophil Bouquet, never called me anything but Jones, even after I married his daughter."
                                            },
                                            {
                                                "example_id": "1f85aa5e-e8d5-4c45-b896-f62f9d420a7e",
                                                "sense_id": "0a6d82ac-c462-3a87-b186-71b32f451b75",
                                                "text": "You give a kid a name like Cameron / or Alfred, or something like that, / and they end up wearing glasses / and looking at computers for the rest of their life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbd7b1a-f491-356c-aaba-ea6b6f2b5ae2",
                                        "entry_id": "416c105f-d0e3-3a51-9bf2-c840c562cba3",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [
