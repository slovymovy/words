                    ],
                    "target_lang_definitions": {
                        "fr": "Procurer à quelqu'un un sentiment sombre ou abattu ; attrister ou peser sur le moral"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "oppresser",
                                "target_lang_sense_clarification": "peser lourdement sur l'esprit ou le cœur"
                            },
                            {
                                "target_lang_word": "attrister",
                                "target_lang_sense_clarification": "rendre triste ou morose"
                            },
                            {
