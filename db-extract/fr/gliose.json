                        "entry_id": "e3049713-308e-3609-905a-1be6778efaca",
                        "glosses": [
                            "Prolifération du tissu de soutien du système nerveux central."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c176e81-cfe5-4b9f-9a02-57f4b5263bce",
                                "sense_id": "d3ed1ea8-93c3-326a-8dc0-7bef6f38b1ed",
                                "text": "La gliose d’une partie du cerveau est la prolifération excessive de cellules gliales qui, normalement, assurent des fonctions de soutien pour les neurones."
                            },
                            {
                                "example_id": "3a431f72-17c5-4265-a59f-84eebf97c967",
                                "sense_id": "d3ed1ea8-93c3-326a-8dc0-7bef6f38b1ed",
                                "text": "La coloration de Mallory et surtout la coloration de Holzer montrent en particulier aux niveaux cervicodorsaux que la gliose fibrillaire est en général modérée et isomorphe."
                            }
                        ]
                    }
                ],
