                    {
                        "sense_id": "95f508cc-1fd8-3791-92ca-fbd1ed8a3d7c",
                        "entry_id": "6676b5df-d3b6-36bb-8301-ab7d9514ad79",
                        "glosses": [
                            "bestimmter Bereich, in dem die Suche nach jemandem oder etwas durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6309c1e-d534-47e6-a8a4-228e6bebf442",
                                "sense_id": "95f508cc-1fd8-3791-92ca-fbd1ed8a3d7c",
                                "text": "„Nachdem zunächst der Suchbereich laufend ausgedehnt wurde, nahmen die Trupps ab Dienstagmittag wieder den Nahbereich der Fischteiche, wo Franca zuletzt von ihrem Großvater gesehen wurde, in den Fokus, besonders die Strecke bis zum rund zwei Kilometer entfernten Wohnhaus des Kindes.“"
                            },
                            {
                                "example_id": "8a513288-8309-4071-bd5e-5bb1038c7eed",
                                "sense_id": "95f508cc-1fd8-3791-92ca-fbd1ed8a3d7c",
                                "text": "„Werden die Bilder dagegen nach Farben sortiert, gelingt es Nutzern meistens besser, den Suchbereich zügig einzugrenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
