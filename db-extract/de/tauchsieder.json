                "senses": [
                    {
                        "sense_id": "c9046395-6b77-3296-b525-e4ff4b38d554",
                        "entry_id": "83e7b784-19bd-3bba-ada6-90929a30a7e3",
                        "glosses": [
                            "elektrisches Gerät, das in Wasser abgesenkt wird, um es zu erhitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0c8749-018d-4712-8c24-ef0d49da5429",
                                "sense_id": "c9046395-6b77-3296-b525-e4ff4b38d554",
                                "text": "Die Heizspirale des Tauchsieders sollte komplett mit Wasser bedeckt sein."
                            },
                            {
                                "example_id": "40dec050-3699-4e79-9a16-d94deae8768c",
                                "sense_id": "c9046395-6b77-3296-b525-e4ff4b38d554",
                                "text": "Um Unfälle zu vermeiden, sollte man nur Tauchsieder verwenden, die einen Überhitzungsschutz haben."
                            },
                            {
                                "example_id": "f40a46ee-496b-446b-8e29-cc3c723b0129",
                                "sense_id": "c9046395-6b77-3296-b525-e4ff4b38d554",
                                "text": "„Ich habe immer diesen kleinen Tauchsieder dabei, um mir morgens einen starken Tee zu kochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
