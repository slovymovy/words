                "senses": [
                    {
                        "sense_id": "77d849f2-6966-370a-90e6-6c712d9eec13",
                        "entry_id": "b43ee3d6-ed07-3ceb-9bd3-f71c4dcde390",
                        "glosses": [
                            "von einem Priester getragenes Gewand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "819c31e7-7399-4a50-bb68-eb6282ac456c",
                                "sense_id": "77d849f2-6966-370a-90e6-6c712d9eec13",
                                "text": "„Doch zum Teil fand diese Frage ihre Antwort, als er mir etwas zeigte: ein kleines Buch, das er in den unergründlichen Falten seines Priestergewandes mit sich führte.“"
                            },
                            {
                                "example_id": "859693a6-f439-46a6-a125-cbd54f6ae816",
                                "sense_id": "77d849f2-6966-370a-90e6-6c712d9eec13",
                                "text": "„Die jüngst der vielerlei Anklagen, die man gegen ihn erhebt, betrifft ein elfjähriges - jawohl elfjähriges - Mädchen, das vertrauensvoll zu ihm gekommen ist, und mit dem er ertappt wurde, als er es, noch im Priestergewand, zu schänden versucht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
