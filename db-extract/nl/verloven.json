                        "target_lang_word": "verloben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verloben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76b6a22f-6e06-3a36-b04a-aa2fe8405140",
                                        "entry_id": "19fa9c0e-d4c7-3396-a533-0e8689575940",
                                        "glosses": [
                                            "jemandem ein Eheversprechen geben"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808d8dab-cc31-4d42-ab5d-ae69924ed37d",
                                                "sense_id": "76b6a22f-6e06-3a36-b04a-aa2fe8405140",
                                                "text": "Sie haben sich gestern verlobt."
                                            },
                                            {
                                                "example_id": "e3b0c866-a8ad-4255-87a8-87a4c6dc5738",
                                                "sense_id": "76b6a22f-6e06-3a36-b04a-aa2fe8405140",
                                                "text": "Claudia weigert sich standhaft, sich mit Martin zu verloben, weil sie Verlobungen für albern hält."
                                            },
                                            {
                                                "example_id": "7ccc6093-2716-4779-99cf-459a034d1824",
                                                "sense_id": "76b6a22f-6e06-3a36-b04a-aa2fe8405140",
                                                "text": "Karla und Uwe sind seit über zwanzig Jahren verlobt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "648cef33-2b3f-3b00-9409-f1c60911b608",
                                        "entry_id": "19fa9c0e-d4c7-3396-a533-0e8689575940",
                                        "glosses": [
                                            "jemanden einem anderen für eine zu schließende Ehe versprechen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be2a1bb-227b-4fbb-b714-0fd2931e7f1e",
                                                "sense_id": "648cef33-2b3f-3b00-9409-f1c60911b608",
                                                "text": "Als Monas Vater ankündigte, sie mit einem reichen Bankierssohn zu verloben, floh sie außer Landes."
                                            },
                                            {
                                                "example_id": "cfe25cad-fa25-4884-99f4-9feb0ccdc4c7",
                                                "sense_id": "648cef33-2b3f-3b00-9409-f1c60911b608",
                                                "text": "Wir haben unseren Sohn äußerst vorteilhaft verlobt."
                                            },
                                            {
                                                "example_id": "f297e686-f829-4562-9be4-a0023094a74c",
                                                "sense_id": "648cef33-2b3f-3b00-9409-f1c60911b608",
                                                "text": "Es wird Zeit, dass die Prinzessin standesgemäß verlobt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1de5d74f-db62-38ab-9024-34527d1adbfe",
                                        "entry_id": "19fa9c0e-d4c7-3396-a533-0e8689575940",
                                        "glosses": [
                                            "geloben"
                                        ],
                                        "tags": [
                                            "dative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a22e471-db96-42b2-8225-b7210ac7e10d",
                                                "sense_id": "1de5d74f-db62-38ab-9024-34527d1adbfe",
                                                "text": "Ich verlobe dir ewige Treue."
                                            },
                                            {
                                                "example_id": "ecfa99c0-769d-4ea6-940b-730d5c6f04ee",
                                                "sense_id": "1de5d74f-db62-38ab-9024-34527d1adbfe",
                                                "text": "Ich habe verlobt, zu fasten."
                                            },
                                            {
                                                "example_id": "8e65e32e-0d8e-403b-b928-b1dbb5e40f3e",
                                                "sense_id": "1de5d74f-db62-38ab-9024-34527d1adbfe",
                                                "text": "Für dich verlobe ich, mir die Trunksucht abzugewöhnen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0426e900-8e44-30ee-bb83-05a7018c8e9a",
                                        "entry_id": "19fa9c0e-d4c7-3396-a533-0e8689575940",
                                        "glosses": [
                                            "loben"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51cc3de8-d22b-4139-8ab0-82a160a1fbdf",
                                                "sense_id": "0426e900-8e44-30ee-bb83-05a7018c8e9a",
                                                "text": "Ihre Tugend und Keuschheit können nicht genügend verlobt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0f3f7157-25f4-35c6-a5b7-8baa5dc35cb1",
                                        "entry_id": "19fa9c0e-d4c7-3396-a533-0e8689575940",
                                        "glosses": [
                                            "durch ein Gelöbnis abwehren, beseitigen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b76fdc-beb5-4009-b176-b8270ff344c3",
                                                "sense_id": "0f3f7157-25f4-35c6-a5b7-8baa5dc35cb1",
                                                "text": "Der Mensch ist sich zu mehren geschaffen und soll dies nicht verloben noch verhindern."
                                            },
                                            {
                                                "example_id": "fae2fff9-bace-45a0-b14e-a1e9545d1362",
                                                "sense_id": "0f3f7157-25f4-35c6-a5b7-8baa5dc35cb1",
                                                "text": "Ich habe verlobt, je wieder der Völlerei zu frönen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
