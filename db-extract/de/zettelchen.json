                        "glosses": [
                            "kleiner Zettel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5348e97f-dae7-42c7-a171-6580c93a485f",
                                "sense_id": "44453aaa-0508-3746-a939-1bbc813da0e6",
                                "text": "„Manche Vermieter sind vom Ukaswahn besessen und verständigen sich mit erzieherischen Zettelchen, andere erlassen Verordnungen in Blockschrift, die sie mit Reißnägeln im WC und in der Diele befestigen.“"
                            },
                            {
                                "example_id": "091b2f5c-c500-444f-955c-f266513ce7b9",
                                "sense_id": "44453aaa-0508-3746-a939-1bbc813da0e6",
                                "text": "„Sie las den Zettel dreimal und wollte ihn dann in die Schachtel stecken, die sie stets mit sich herumtrug und in der sie eine Menge ähnlicher Zettelchen, kleiner Botschaften und lustiger Mitteilungen aufbewahrte, die Eiríkur im Lauf der letzten Jahre hier und da hinterlassen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
