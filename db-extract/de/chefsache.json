                    {
                        "sense_id": "051b84e0-042a-313b-88a9-b4f84ed68dfd",
                        "entry_id": "8371a621-5edf-3a0c-bb93-502519603b68",
                        "glosses": [
                            "Angelegenheit höchster Wichtigkeit, die der Chef persönlich erledigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc3fb14-06e6-4a2c-93b2-29a9fc016eb2",
                                "sense_id": "051b84e0-042a-313b-88a9-b4f84ed68dfd",
                                "text": "Soll ich die Bestellung der Herbstkollektion vornehmen — Nein, das mache ich selber, das ist Chefsache."
                            },
                            {
                                "example_id": "47dec739-689a-45f0-b578-b3f5bc3fb5bf",
                                "sense_id": "051b84e0-042a-313b-88a9-b4f84ed68dfd",
                                "text": "Japans Regierungschef macht Finanzprobleme zur Chefsache."
                            },
                            {
                                "example_id": "3de4595c-b1c5-43ea-82a6-441ef5af66a0",
                                "sense_id": "051b84e0-042a-313b-88a9-b4f84ed68dfd",
                                "text": "„Er macht den Kampf gegen einige lange als unantastbar geltende Oligarchen zur Chefsache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
