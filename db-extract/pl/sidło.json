                    }
                ],
                "translations": [
                    {
                        "translation_id": "6908926f-db3b-41d7-9ec2-0fbb59a4066b",
                        "source_entry_id": "29a969ff-88d4-312e-b067-76d914da4f7a",
                        "source_sense_id": "fff2552f-3329-3683-81e4-469613ec8d8c",
                        "target_lang_word": "snare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bddd5a6d-da9a-3636-a248-2abc8e3b3234",
                                        "entry_id": "03f4c686-c487-3123-8f77-03c95384be1c",
                                        "glosses": [
                                            "A trap (especially one made from a loop of wire, string, or leather)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad41016-ed47-4e2e-ac1a-a3f52b917e54",
                                                "sense_id": "bddd5a6d-da9a-3636-a248-2abc8e3b3234",
                                                "text": "He […] watched Beavis’s long-toothed mouth open and clap to like a rabbit snare."
                                            },
                                            {
                                                "example_id": "0872b2ad-161b-4636-a35e-4a972e146520",
                                                "sense_id": "bddd5a6d-da9a-3636-a248-2abc8e3b3234",
                                                "text": "He felt a snare tightening around his throat; he gasped and threw a leg out of the bed, where it jerked for a second or two, thumping the steel frame, and died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7831433f-befe-3f51-9fce-f4cabb6500cd",
                                        "entry_id": "03f4c686-c487-3123-8f77-03c95384be1c",
                                        "glosses": [
                                            "A mental or psychological trap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ff4f69-bb58-4be5-8832-a9a881016402",
                                                "sense_id": "7831433f-befe-3f51-9fce-f4cabb6500cd",
                                                "text": "If thou retire, the Dauphin, well appointed,\nStands with the snares of war to tangle thee:"
                                            },
                                            {
                                                "example_id": "8fd8c655-c00f-4b7e-bb76-dea5830b316b",
                                                "sense_id": "7831433f-befe-3f51-9fce-f4cabb6500cd",
                                                "text": "[…] if thou serve their gods, it will surely be a snare unto thee."
                                            },
                                            {
                                                "example_id": "74d6929d-9690-4da9-97fb-4c0fd5da0fd5",
                                                "sense_id": "7831433f-befe-3f51-9fce-f4cabb6500cd",
                                                "text": "[…] and I had now liv’d two Years under these Uneasinesses, which indeed made my Life much less comfortable than it was before; as may well be imagin’d by any who know what it is to live in the constant Snare of the Fear of Man […]"
                                            },
                                            {
                                                "example_id": "82a4e6a4-bc6a-4e55-996a-dfdf65445c45",
                                                "sense_id": "7831433f-befe-3f51-9fce-f4cabb6500cd",
                                                "text": "“[…] riches are a great snare.”"
                                            },
                                            {
                                                "example_id": "fcbde0d4-3ecb-4998-a032-dff2b802cc2b",
                                                "sense_id": "7831433f-befe-3f51-9fce-f4cabb6500cd",
                                                "text": "They were devious war aims, and Allenby’s campaign was fought with a maximum of snare and subterfuge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "104a4ae5-4029-3c55-b063-bf530c8cfc37",
                                        "entry_id": "03f4c686-c487-3123-8f77-03c95384be1c",
                                        "glosses": [
                                            "A loop of cord used in obstetric cases, to hold or to pull a fetus from the mother animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38414d6c-b64c-36f1-9a73-a43e623af0f2",
                                        "entry_id": "03f4c686-c487-3123-8f77-03c95384be1c",
                                        "glosses": [
                                            "A similar looped instrument formerly used to remove tumours etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b87f6f3-cf37-3f19-ab47-1d38c5f64bc9",
                                        "entry_id": "03f4c686-c487-3123-8f77-03c95384be1c",
                                        "glosses": [
                                            "A set of stiff wires held under tension against the bottom head of a drum to create a rattling sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0f1341b-96b0-389d-aa44-1c520bc753cd",
                                        "entry_id": "03f4c686-c487-3123-8f77-03c95384be1c",
                                        "glosses": [
                                            "A snare drum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "snare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6498534b-ffd1-384f-a0d8-2c8c26b6062a",
                                        "entry_id": "6c686992-9c36-35a6-8a0a-aca71d90d7a6",
                                        "glosses": [
                                            "To catch or hold, especially with a loop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e34e7e2a-f054-4715-a538-c486cd676256",
                                                "sense_id": "6498534b-ffd1-384f-a0d8-2c8c26b6062a",
                                                "text": "The mournful crocodile / With sorrow snares relenting passengers."
                                            },
                                            {
                                                "example_id": "9c9aa80a-8e6f-4107-a93a-43da95179d00",
                                                "sense_id": "6498534b-ffd1-384f-a0d8-2c8c26b6062a",
                                                "text": "Lest that too heavenly form […] snare them."
                                            },
                                            {
                                                "example_id": "576caa7b-6cdc-4a4f-b120-9304bb8e8f54",
                                                "sense_id": "6498534b-ffd1-384f-a0d8-2c8c26b6062a",
                                                "text": "Instead, it aimed for a more important assurance: that if A.I. raises writers’ productivity or the quality of their output, guild members should snare an equitable share of the performance gains. And the W.G.A. got it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b485db0a-cd3f-3463-aeef-bf6b9ae8397e",
                                        "entry_id": "6c686992-9c36-35a6-8a0a-aca71d90d7a6",
                                        "glosses": [
                                            "To ensnare."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8841d001-8735-3d6d-88b3-677713e3425a",
                                        "entry_id": "6c686992-9c36-35a6-8a0a-aca71d90d7a6",
                                        "glosses": [
                                            "To play (a snare drum, or a beat on or as if on a snare drum)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aba3d91-0ed4-45fe-90aa-012e75185646",
                                                "sense_id": "8841d001-8735-3d6d-88b3-677713e3425a",
                                                "text": "[…] the slightest recollection of hearing the wind whistling through the cracks in the old house or the rain snaring its tat-a-tat on the rusty tin roof."
                                            },
                                            {
                                                "example_id": "db662552-a762-467f-ba80-806c7710b864",
                                                "sense_id": "8841d001-8735-3d6d-88b3-677713e3425a",
                                                "text": "[…] T-Ray snared the drum in the background."
                                            },
                                            {
                                                "example_id": "1e0bf3ad-9504-4c4c-aa28-db29660bfa3c",
                                                "sense_id": "8841d001-8735-3d6d-88b3-677713e3425a",
                                                "text": "[…] drummer snaring away on his little drum, tur-r-r-rump! tur-r-r-rump! tur-r-r-rump! r-r-rump, r-r-rump, r-r-rump! I love drums."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
