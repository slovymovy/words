{
    "word_family": [
        "évocateur",
        "évocation",
        "évocatoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b8bbd32-c120-3be4-b038-5d6c0964ea1f",
                    "sense_definition": "Mentionner brièvement, faire allusion à un sujet ou une situation au cours d'un échange.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a préféré <w>évoquer</w> ce problème délicat lors de la réunion générale."
                        },
                        {
                            "text": "Nous devons <w>évoquer</w> cette question essentielle avant de signer le contrat de vente."
                        }
                    ],
                    "synonyms": [
                        "aborder",
                        "mentionner"
                    ],
                    "antonyms": [
                        "taire"
                    ],
                    "common_phrases": [
                        "évoquer un sujet",
                        "évoquer une question",
                        "évoquer la possibilité"
                    ]
                },
                {
                    "sense_id": "6d0d9db8-4b5d-35d3-8a2a-2997d4141c91",
                    "sense_definition": "Faire naître une image, une idée ou un souvenir dans l'esprit de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille chanson continue d'<w>évoquer</w> de précieux souvenirs de nos vacances d'enfance."
                        },
                        {
                            "text": "Ces couleurs vives lui <w>évoquent</w> immédiatement les paysages ensoleillés de la Méditerranée."
                        }
                    ],
                    "synonyms": [
                        "rappeler",
                        "suggérer"
                    ],
                    "common_phrases": [
                        "évoquer des souvenirs",
                        "évoquer une image",
                        "évoquer le passé"
                    ]
                },
                {
                    "sense_id": "dc7b65d9-fb23-3cb0-a1c1-edcd3764aefe",
                    "sense_definition": "Faire apparaître des esprits, des âmes ou des puissances surnaturelles par des formules magiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte mystérieux, le magicien cherche à <w>évoquer</w> les esprits des défunts."
                        },
                        {
                            "text": "Le rituel nocturne consistait à <w>évoquer</w> les âmes perdues de la forêt."
                        }
                    ],
                    "synonyms": [
                        "conjurer",
                        "invoquer"
                    ],
                    "common_phrases": [
                        "évoquer les esprits",
                        "évoquer les morts",
                        "évoquer les âmes"
                    ]
                },
                {
                    "sense_id": "b3e00471-019c-3289-b092-1f2b240e2b91",
                    "sense_definition": "Pour une juridiction supérieure, attirer à soi la connaissance du fond d'une affaire portée devant un tribunal inférieur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cour d'appel a décidé d'<w>évoquer</w> le fond de l'affaire pour rendre une décision définitive."
                        },
                        {
                            "text": "Les magistrats peuvent <w>évoquer</w> un litige complexe lorsque les circonstances légales l'autorisent."
                        }
                    ],
                    "common_phrases": [
                        "évoquer une affaire",
                        "évoquer le fond"
                    ]
                }
            ]
        }
    ]
}