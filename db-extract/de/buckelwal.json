                "senses": [
                    {
                        "sense_id": "df59cddf-99ab-3986-a07c-28430d2b426f",
                        "entry_id": "4c0ae1e1-e663-30e1-8733-003be6a98de3",
                        "glosses": [
                            "ein Meeressäugetier, das in den Ozeanen lebt und unter weltweitem Artenschutz steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b577d26f-cb7f-47ac-984a-2623533f3c70",
                                "sense_id": "df59cddf-99ab-3986-a07c-28430d2b426f",
                                "text": "Der Buckelwal ist um die 15 Meter lang und wiegt etwa 30 Tonnen."
                            },
                            {
                                "example_id": "2943c4f6-eda3-4748-826f-fc0d09a37048",
                                "sense_id": "df59cddf-99ab-3986-a07c-28430d2b426f",
                                "text": "Im Meer bläst ein Buckelwal seine Fontäne in die Luft."
                            },
                            {
                                "example_id": "497458d7-9599-4a33-a305-625efd470e75",
                                "sense_id": "df59cddf-99ab-3986-a07c-28430d2b426f",
                                "text": "Die Brustflossen von Buckelwalen sind seltsam ausgebeult. Das hilft gegen den Strömungsabriss."
                            },
                            {
                                "example_id": "728ef63f-015a-42b6-a904-caea15113be9",
                                "sense_id": "df59cddf-99ab-3986-a07c-28430d2b426f",
                                "text": "Ein Forscherteam um Hannah Blair von der Syracuse University im US-Bundesstaat New York konnte durch den Einsatz von Sensortechnik nachweisen, dass Buckelwale sich anders verhalten, wenn in der Nähe Schiffe fahren."
                            },
                            {
                                "example_id": "199ccf74-321b-4398-8bc4-3a6852296099",
                                "sense_id": "df59cddf-99ab-3986-a07c-28430d2b426f",
                                "text": "„Der Buckelwal ist der Star unter den Walen, er ist bis zu 15 Meter groß, ziemlich verspielt und beständig singend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
