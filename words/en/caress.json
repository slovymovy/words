{
    "word_family": [
        "caressing",
        "caressive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82570f29-ee57-3310-b49c-0cd7369cfc39",
                    "sense_definition": "To touch, stroke, or kiss someone or something lovingly and gently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reached out to gently <w>caress</w> her cheek while she was sleeping.",
                            "target_lang_translations": {
                                "de": "Er streckte die Hand aus, um sanft ihre Wange zu <w>streicheln</w>, während sie schlief."
                            }
                        },
                        {
                            "text": "The mother smiled warmly as she <w>caressed</w> the newborn baby's head.",
                            "target_lang_translations": {
                                "de": "Die Mutter lächelte warmherzig, während sie das Köpfchen des Neugeborenen <w>liebkoste</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fondle",
                        "stroke"
                    ],
                    "common_phrases": [
                        "gently caress"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas liebevoll, sanft berühren oder streicheln."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "liebkosen",
                                "target_lang_sense_clarification": "zärtlich berühren oder Zuneigung zeigen"
                            },
                            {
                                "target_lang_word": "streicheln",
                                "target_lang_sense_clarification": "sanft über jemanden oder etwas streichen"
                            },
                            {
                                "target_lang_word": "kosen",
                                "target_lang_sense_clarification": "gehoben für zärtlich sein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b966c58-dc31-348f-92e6-2d4b8bb41570",
                    "sense_definition": "To touch or affect something lightly and pleasantly, as if with an affectionate touch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A warm breeze <w>caressed</w> our faces as we walked along the quiet beach.",
                            "target_lang_translations": {
                                "de": "Eine warme Brise <w>umspielte</w> unsere Gesichter, als wir am ruhigen Strand entlanggingen."
                            }
                        },
                        {
                            "text": "The soothing sound of the violin <w>caressed</w> the listeners throughout the evening.",
                            "target_lang_translations": {
                                "de": "Der beruhigende Klang der Geige <w>schmeichelte</w> den Zuhörern den ganzen Abend über."
                            }
                        }
                    ],
                    "common_phrases": [
                        "breeze caressed"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas sanft und angenehm berühren oder umspielen (oft von Wind, Klängen oder Licht)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umspielen",
                                "target_lang_sense_clarification": "sanft berühren, z. B. von einer Brise oder Licht"
                            },
                            {
                                "target_lang_word": "streicheln",
                                "target_lang_sense_clarification": "übertragen für sanft berühren"
                            },
                            {
                                "target_lang_word": "schmeicheln",
                                "target_lang_sense_clarification": "den Sinnen sanft und angenehm tun"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c023843a-35c2-33f9-b8fc-d6f909044234",
                    "sense_definition": "A gentle, affectionate stroke or light touch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She woke up to the soft <w>caress</w> of sunlight filtering through the window.",
                            "target_lang_translations": {
                                "de": "Sie erwachte durch die sanfte <w>Liebkosung</w> des Sonnenlichts, das durch das Fenster fiel."
                            }
                        },
                        {
                            "text": "He calmed the frightened dog with a gentle <w>caress</w> behind its ears.",
                            "target_lang_translations": {
                                "de": "Er beruhigte den verängstigten Hund mit einem sanften <w>Streicheln</w> hinter den Ohren."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroke"
                    ],
                    "common_phrases": [
                        "gentle caress",
                        "soft caress"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine sanfte, liebevolle Berührung oder ein leichtes Streicheln."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Liebkosung",
                                "target_lang_sense_clarification": "zärtliche Berührung"
                            },
                            {
                                "target_lang_word": "Streicheln",
                                "target_lang_sense_clarification": "das sanfte Streichen mit der Hand"
                            },
                            {
                                "target_lang_word": "Streicheleinheit",
                                "target_lang_sense_clarification": "liebevolle Geste oder Berührung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0d43c6-7e02-3649-b49b-fdfd657e1217",
                    "sense_definition": "An expression or act of affection and tenderness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem was full of tender words that felt like a loving <w>caress</w>.",
                            "target_lang_translations": {
                                "de": "Das Gedicht war voller zärtlicher Worte, die sich wie eine liebevolle <w>Liebkosung</w> anfühlten."
                            }
                        },
                        {
                            "text": "He responded to her kind words with warm and grateful <w>caresses</w>.",
                            "target_lang_translations": {
                                "de": "Er erwiderte ihre freundlichen Worte mit warmen und dankbaren <w>Zärtlichkeiten</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loving caress"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ausdruck oder eine Geste von Zuneigung und Zärtlichkeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Liebkosung",
                                "target_lang_sense_clarification": "Geste oder Äußerung von Zärtlichkeit"
                            },
                            {
                                "target_lang_word": "Zärtlichkeit",
                                "target_lang_sense_clarification": "liebevolle Zuwendung oder Geste"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}