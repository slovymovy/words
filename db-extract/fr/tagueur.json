            {
                "entry_id": "26b3f0ab-94f1-3279-a461-24e8cd8c6a06",
                "word": "tagueur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8f78f1e-9f7b-4af2-a4cf-382585af5405",
                        "entry_id": "26b3f0ab-94f1-3279-a461-24e8cd8c6a06",
