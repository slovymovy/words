            {
                "entry_id": "66998d69-403d-3e29-9a6d-65583d74d54d",
                "word": "felsic",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4a3cabc6-6e72-4df2-ad69-bd358a0f0d04",
                        "entry_id": "66998d69-403d-3e29-9a6d-65583d74d54d",
                        "tags": [
                            "plural"
                        ],
                        "form": "felsics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67091e49-046f-3921-86b4-0e027c9a68a0",
                        "entry_id": "66998d69-403d-3e29-9a6d-65583d74d54d",
                        "glosses": [
                            "A rock with such properties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4640cf-d828-4e65-a1b6-28f27a92464d",
                                "sense_id": "67091e49-046f-3921-86b4-0e027c9a68a0",
                                "text": "The central part of this nepheline syenite is very white felsics with black mafics in it. The entire area contains many nepheline-bearing dike rocks, but almost all are gray or pink or even red due to the color in the felsics."
                            },
                            {
                                "example_id": "0263d9b5-a35f-4169-8e44-f724424a268b",
                                "sense_id": "67091e49-046f-3921-86b4-0e027c9a68a0",
                                "text": "There are also calcalkaline felsics that have highly enriched LREE^([light rare-earth element]) patterns with lower overall abundances."
                            }
                        ]
                    }
                ],
