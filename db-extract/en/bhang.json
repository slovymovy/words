                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a72cad7-0dbc-49ad-b54b-97869e40f2b9",
                                "sense_id": "d4de6a02-cb68-360f-8202-d091a0676fdd",
                                "text": "Almost from the outset of her arrival in the town, soft-muted music, the strange, heart-rending, mournful music of the East - suggestive of apes, and pearls, and bhang, and the colour blue - was to be heard, surging from the Nook in monotonous improvisation."
                            },
                            {
                                "example_id": "f14b0380-89c3-4720-b44f-f64a42dbc567",
                                "sense_id": "d4de6a02-cb68-360f-8202-d091a0676fdd",
                                "text": "Stramonium seed, mixed with wine, produces, according to a seventeenth century erotologist, libidinous activity. The effects, the write asserts, are similar to those produced by bhang."
                            },
                            {
                                "example_id": "8546f9aa-ee0e-410a-99eb-0a6c5a142c4e",
                                "sense_id": "d4de6a02-cb68-360f-8202-d091a0676fdd",
                                "text": "He rolled out from under Zelikman, who looked surprised as if by the turn his bhang dream had taken."
                            },
                            {
                                "example_id": "bbc1c7c7-8f04-4302-b25d-cb2536820f08",
                                "sense_id": "d4de6a02-cb68-360f-8202-d091a0676fdd",
                                "text": "Government-approved bhang shops thrive next to sweet shops flaunting rows of local desserts inside brightly lit, glass-panelled counters."
                            }
                        ]
                    }
                ],
