                "senses": [
                    {
                        "sense_id": "f0eed122-730b-3ed6-94ff-f21c23fdc743",
                        "entry_id": "09e70d7b-dcb1-3e42-981e-577cca943f76",
                        "glosses": [
                            "Préserver, protéger."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9720c4b1-a19b-4ac6-84e6-9a08d4c510e6",
                                "sense_id": "f0eed122-730b-3ed6-94ff-f21c23fdc743",
                                "text": "Je vous prie donc de m’engarder du roussi en cette vie ; quant à l’autre, il sera temps d’y penser, s’il y a lieu."
                            },
                            {
                                "example_id": "e3944f2a-d2d7-4521-b6ac-4e1e427c409e",
                                "sense_id": "f0eed122-730b-3ed6-94ff-f21c23fdc743",
                                "text": "Ils se forcèrent toutefois de se tenir sur leurs pieds, s’entr’appelèrent, se donnèrent le bon jour, et se baisèrent, ce qui leur fut comme un étai et appui qui leur vint à point pour les engarder de tomber."
                            }
                        ]
                    }
                ],
