                                "example_id": "88ee68fc-cde8-41bd-9f6d-e87a25ae3043",
                                "sense_id": "28e3121f-bf7f-30d4-9811-da66fc6c48ec",
                                "text": "Names […] do make a surprisingly meaningful difference. The power of words is mystical, magical, incantational. The child learns \"dirty\" words because they have amazing properties — they can move adults to prompt and sometimes startling actions."
                            },
                            {
                                "example_id": "35991054-a045-4060-ba32-54d16c9f0f1f",
                                "sense_id": "28e3121f-bf7f-30d4-9811-da66fc6c48ec",
                                "text": "Some hint of the mantic/incantational subtext of Baal's speech to Anat may be found in a badly damaged and very difficult tablet, RS 92.2016 (Caquot and Dalix 2001:393–405)."
                            }
                        ]
                    }
