                "translations": [
                    {
                        "translation_id": "0c870680-0401-40cd-9155-0c15e997f694",
                        "source_entry_id": "e66780f2-fe91-3d72-82b8-1a3b94d3c0e3",
                        "source_sense_id": "5dba6187-6987-3fd8-a089-53bdbe707ee3",
                        "target_lang_word": "heckler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heckler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56382237-b950-3654-b77b-2b5c57e70407",
                                        "entry_id": "24b56e6f-2721-3a0f-8313-c64f62d82edd",
                                        "glosses": [
                                            "One who heckles; somebody who insults, makes fun of, or teases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5c1b58-48a4-46ea-8664-d86992e98585",
                                                "sense_id": "56382237-b950-3654-b77b-2b5c57e70407",
                                                "text": "The juggler always seemed to have a heckler or two in the crowd on Saturdays."
                                            },
                                            {
                                                "example_id": "aa038064-b10e-4c12-b831-914d1092c44c",
                                                "sense_id": "56382237-b950-3654-b77b-2b5c57e70407",
                                                "text": "Scott, who runs the Classic and promotes me here, said I was wrong about the heckler being the alpha male of the sport fan group. He said the alpha male would have money, cars, women and be silent. The heckler was a kind of delta male, the jester to the king alpha male. He would spend his life in the orbit of power, trailing it, circling it, but never achieving it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea22a550-3300-3395-92e2-fb93b2b01b6c",
                                        "entry_id": "24b56e6f-2721-3a0f-8313-c64f62d82edd",
                                        "glosses": [
                                            "An aircraft flying attack missions at night."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd74a4c-8e09-4f6a-8b31-89db118bbe3c",
                                                "sense_id": "ea22a550-3300-3395-92e2-fb93b2b01b6c",
                                                "text": "[…] the usual gap between the time the last strike of the day departed and the first night hecklers arrived was closed with \"zippers\" — night fighters who, using day fighter tactics, proceeded to the target in daylight in time to relieve the last day blanket patrol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea54520-8e83-3f7a-87a3-9bfc61078065",
                                        "entry_id": "24b56e6f-2721-3a0f-8313-c64f62d82edd",
                                        "glosses": [
                                            "Alternative form of hackler (“worker who separates flax”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
