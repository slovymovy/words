                        "cross_references": [
                            {
                                "target_word": "martinet noir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6cb0558-a6c1-366d-bab5-2c41b669718e",
                                        "entry_id": "ca781182-b989-3161-9440-f72eeb4ec334",
                                        "glosses": [
                                            "Espèce d’oiseau martinet de l’Ancien Monde, à longues ailes en boomerang, à queue fourchue courte, et au plumage brun-noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd25aa4-dfdd-438a-9f0d-ef1af3afaf7e",
                                                "sense_id": "c6cb0558-a6c1-366d-bab5-2c41b669718e",
                                                "text": "Faune : serin cini, pic vert, pigeon ramier, moineau domestique, rouge-gorge, fauvette à tête noire, martinet noir, pinson des arbres, tourterelle turque, merle noir, rougequeue noir, rougequeue à front blanc, abeille domestique"
                                            },
                                            {
                                                "example_id": "094b7c46-1eb9-435d-a0e5-130d03355443",
                                                "sense_id": "c6cb0558-a6c1-366d-bab5-2c41b669718e",
                                                "text": "Le martinet noir nichait autrefois dans les milieux rupestres, quelquefois dans les trous d’arbres; actuellement l’espèce est étroitement liée aux bâtiments."
                                            },
                                            {
                                                "example_id": "0a240340-1364-4fe7-93fd-10de81f85111",
                                                "sense_id": "c6cb0558-a6c1-366d-bab5-2c41b669718e",
                                                "text": "Dans les archives de la SOS il existe plus de 500 reprises de martinets noirs bagués."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
