                        "entry_id": "183ad9b6-9299-37f4-a9d6-4f849b01c215",
                        "glosses": [
                            "Véhicule gyroscopique à deux roues qui se conduit de face, les pieds sur une plateforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba690d58-ca08-4b0a-9fdf-eff3b088da22",
                                "sense_id": "858b56bd-02b8-3a86-ba9e-295b8dcd0a07",
                                "text": "Depuis quelques années, de nombreux autres types d’engins se sont fait une place dans les villes françaises, comme la trottinette ou l’hoverboard, cette planche électrique munie de deux roues."
                            },
                            {
                                "example_id": "c5eacd92-7270-4627-ab8f-5312c703a80a",
                                "sense_id": "858b56bd-02b8-3a86-ba9e-295b8dcd0a07",
                                "text": "Les Engins de Déplacement Personnel motorisés (EDPm) contiennent les trottinettes électriques, gyropodes, hoverboards, segways, etc... ; ils se déplacent comme des vélos."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcb1ef5c-44b5-30cf-8237-b929ab398751",
                        "entry_id": "183ad9b6-9299-37f4-a9d6-4f849b01c215",
                        "glosses": [
                            "Skateboard volant."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "3f90a667-9603-469b-acd9-250b57bc2c2c",
                                "sense_id": "fcb1ef5c-44b5-30cf-8237-b929ab398751",
                                "text": "Il saisit son hoverboard et décolla dans les airs à vive allure."
                            }
                        ]
                    }
