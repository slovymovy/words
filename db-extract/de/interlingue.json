                    {
                        "sense_id": "6583513d-234d-3268-a6ad-ba7d4fb2edbf",
                        "entry_id": "a3c9aecf-cfc3-386d-ae8c-1dfe53e4fe8a",
                        "glosses": [
                            "eine 1922 von Edgar von Wahl geschaffene Plansprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8c4b083-d2cb-4612-b816-54e34ca05e4c",
                                "sense_id": "6583513d-234d-3268-a6ad-ba7d4fb2edbf",
                                "text": "Interlingue ist eine ältere Plansprache aus 1922 und nicht identisch mit der Plansprache Interlingua aus dem Jahre 1951."
                            },
                            {
                                "example_id": "c4d0f426-3224-408d-ade3-31dfce1f657b",
                                "sense_id": "6583513d-234d-3268-a6ad-ba7d4fb2edbf",
                                "text": "„Wenn man jetzt ein wenig recherchiert, erfährt man, dass Occidental (oder Interlingue, wie sie heutzutage genannt wird) eine sogenannte Weltsprache ist, genauer, eine der Plansprachen, die primär erfunden worden sind, um Sprachbarrieren zu überwinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
