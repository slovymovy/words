                ],
                "senses": [
                    {
                        "sense_id": "22e67185-2f5e-3aa2-b20e-80706bc93e85",
                        "entry_id": "86a04680-6adb-3b30-98b8-d346e90e7c29",
                        "glosses": [
                            "Nouvel équilibrage, plus favorable, plus stable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5602861f-c1f5-4baf-bea6-2abe0c8b7dcb",
                                "sense_id": "22e67185-2f5e-3aa2-b20e-80706bc93e85",
                                "text": "D’une part, la volonté de déployer une planification urbaine plus stratégique et une politique de rééquilibrage régional invite à mieux tenir compte des spécificités locales."
                            },
                            {
                                "example_id": "bfe893e2-556f-4b96-a0c1-7f9f15ca6584",
                                "sense_id": "22e67185-2f5e-3aa2-b20e-80706bc93e85",
                                "text": "Le Comité de réflexion et de proposition sur la modernisation et le rééquilibrage des institutions est un groupe de réflexion lancé par le président de la République française Nicolas Sarkozy pour réformer les institutions de la Cinquième République."
                            }
                        ]
                    },
                    {
                        "sense_id": "0695d8f4-9556-3c97-a267-6a47575d7b51",
                        "entry_id": "86a04680-6adb-3b30-98b8-d346e90e7c29",
                        "glosses": [
                            "Nouvel équilibrage, plus favorable, plus stable.",
                            "Alliance politique destinée à faire contrepoids à un pouvoir hégémonique ou dominant."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": [
                            {
                                "example_id": "b0ccd450-2192-40d7-a046-e05b6e1c145b",
                                "sense_id": "0695d8f4-9556-3c97-a267-6a47575d7b51",
                                "text": "Côté républicain, la nouvelle donne devrait conduire à des rééquilibrages entre les faucons du parti, traditionnellement favorables à une politique extérieure interventionniste, et la nouvelle mouvance isolationniste soutenue par le Tea Party, qui, à l'image du sénateur Rand Paul, a plaidé contre les interventions militaires extérieures et le maintien des bases militaires américaines dans le monde."
                            }
                        ]
                    }
                ],
