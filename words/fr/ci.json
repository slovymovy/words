{
    "word_family": [
        "ceci",
        "ici"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c5aee2ee-c2a1-3603-ab7b-72a5acf5b554",
                    "sense_definition": "Particule adjointe par un trait d'union à un pronom ou à un nom précédé d'un démonstratif pour marquer la proximité dans l'espace ou le temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "demonstratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu devrais plutôt choisir ce modèle-<w>ci</w>, car il correspond exactement à tes attentes."
                        },
                        {
                            "text": "De tous les tableaux de la galerie, celui-<w>ci</w> reste mon préféré pour ses couleurs lumineuses."
                        }
                    ],
                    "antonyms": [
                        "là"
                    ],
                    "common_phrases": [
                        "celui-ci",
                        "celle-ci",
                        "cette fois-ci"
                    ]
                },
                {
                    "sense_id": "57699d99-8b9f-300b-b47f-0d95bedc2d63",
                    "sense_definition": "Élément joint par un trait d'union à un adjectif ou un participe pour signaler une annexion ou une présence immédiate.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous trouverez <w>ci</w>-joint la photocopie de votre pièce d'identité certifiée conforme."
                        },
                        {
                            "text": "Les personnes <w>ci</w>-présentes ont toutes accepté de signer la pétition pour le quartier."
                        }
                    ],
                    "common_phrases": [
                        "ci-joint",
                        "ci-inclus",
                        "ci-présent"
                    ]
                },
                {
                    "sense_id": "fee0f6c2-8ac9-351c-8625-2b65f71d2726",
                    "sense_definition": "Élément préfixé à des adverbes ou prépositions pour renvoyer à ce qui précède ou suit dans un texte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les détails du projet sont exposés dans le schéma <w>ci</w>-dessous."
                        },
                        {
                            "text": "Comme nous l'avons précisé <w>ci</w>-dessus, la date limite d'inscription ne sera pas prolongée."
                        }
                    ],
                    "common_phrases": [
                        "ci-dessus",
                        "ci-dessous",
                        "ci-après",
                        "ci-contre"
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "23726894-a6b3-39da-b763-aefef5140641",
                    "sense_definition": "Pronom familier désignant une chose indéterminée, principalement employé en corrélation avec « ça ».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a passé toute la soirée à raconter <w>ci</w> et ça à ses amies."
                        },
                        {
                            "text": "On a trouvé de <w>ci</w> de ça au marché pour préparer notre grand dîner."
                        }
                    ],
                    "common_phrases": [
                        "ci et ça",
                        "de ci de là"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        }
    ]
}