                        "examples": [
                            {
                                "example_id": "fe58d0a8-2d2b-43a0-92fd-4d63c273a96e",
                                "sense_id": "a75a5b82-e6d7-35f8-9196-58e0f1b1cfd4",
                                "text": "Een met militaire veldbedden, stoelen, kachels en tenten volgeladen legertruck is gestolen vanaf een legerbasis in Noord-Brabant. De wagen is maandag geplunderd teruggevonden in Maarsbergen op een afgelegen plek langs de Griftdijk."
                            },
                            {
                                "example_id": "ec2bf5f7-cf7f-4d25-9a2d-b433de6505d6",
                                "sense_id": "a75a5b82-e6d7-35f8-9196-58e0f1b1cfd4",
                                "text": "Rond tien uur vanochtend botste een vrachtwagen op een legertruck. Achterin het legervoertuig zaten militairen. Er waren ook drie personenauto's bij het ongeluk betrokken. Vijftien mensen raakten gewond. Drie van hen zijn er slecht aan toe."
                            }
                        ]
                    }
