                "senses": [
                    {
                        "sense_id": "976225da-0480-3abf-9454-6976caebaa6d",
                        "entry_id": "8378ec48-474a-3ab1-bcb7-6b74a078fde2",
                        "glosses": [
                            "Person, die möglichst große Eigenständigkeit im Denken und Handeln für sich beansprucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5da7110-f121-4fba-a6cb-d43f0a573700",
                                "sense_id": "976225da-0480-3abf-9454-6976caebaa6d",
                                "text": "„Individualisten haben es da wesentlich einfacher.“"
                            },
                            {
                                "example_id": "74b99512-fe38-464c-bdee-bbe8b594e954",
                                "sense_id": "976225da-0480-3abf-9454-6976caebaa6d",
                                "text": "„Die Finnen sind Individualisten, auch hier.“"
                            },
                            {
                                "example_id": "1e499f93-fae3-437b-a8cc-c638dd8eb9f4",
                                "sense_id": "976225da-0480-3abf-9454-6976caebaa6d",
                                "text": "„Er war ein radikaler Individualist und hielt an der Verachtung des einfachen Volkes bis zu seinem Lebensende fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "072e69d7-4a5f-4731-969e-2b3fbee4ad7d",
                        "source_entry_id": "8378ec48-474a-3ab1-bcb7-6b74a078fde2",
                        "source_sense_id": "976225da-0480-3abf-9454-6976caebaa6d",
                        "source_sense_description": "Person, die möglichst große Eigenständigkeit im Denken und Handeln für sich beansprucht",
                        "target_lang_word": "ατομιστής",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ατομιστής",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "e817eca5-e9f7-3e89-bba9-d49041894f63",
                                        "entry_id": "baafccc5-2f35-3a67-a1d0-f5a0d8731749",
                                        "glosses": [
                                            "ατομικός φιλόσοφος"
                                        ],
                                        "tags": [
                                            "ιστορία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c18f54c6-f732-49ad-b54f-cc741242e4ea",
                                                "sense_id": "e817eca5-e9f7-3e89-bba9-d49041894f63",
                                                "text": "Ήδη από την αρχαιότητα η προσωπικότητα του Δημόκριτου συνοδεύεται από διάφορες παραδόσεις, όχι πάντα κολακευτικές για τον μεγάλο ατομιστή φιλόσοφο: μία απ' αυτές, που τον θέλει να τρελαίνεται προς το τέλος της ζωής του, έχει καταγραφεί με λεπτομέρειες στα Ψευδεπίγραφα κείμενα του Ιπποκράτη, μια σειρά επιστολών με μυθιστορηματική πλοκή που συντάσσονται, σύμφωνα με τους ειδικούς, την εποχή του Τιβέριου. (*)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3d8468-45b2-3d4d-9c4c-35bb48f30373",
                                        "entry_id": "baafccc5-2f35-3a67-a1d0-f5a0d8731749",
                                        "glosses": [
                                            "που σκέφτεται και φέρεται προσέχοντας μόνο το προσωπικό του συμφέρον και επιδιώξεις"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3751dc0e-1960-4e2d-af3c-58e0d1301369",
                                                "sense_id": "2c3d8468-45b2-3d4d-9c4c-35bb48f30373",
                                                "text": "άλλες μορφές: ατομικιστής"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "417a9a9e-8ccc-4dc9-bb9e-7d24048b74fd",
                        "source_entry_id": "8378ec48-474a-3ab1-bcb7-6b74a078fde2",
                        "source_sense_id": "976225da-0480-3abf-9454-6976caebaa6d",
                        "source_sense_description": "Person, die möglichst große Eigenständigkeit im Denken und Handeln für sich beansprucht",
                        "target_lang_word": "ιδιαίτερος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ιδιαίτερος",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "dc2ead62-38ba-39bd-88c0-358d0f246662",
                                        "entry_id": "82362118-4bfa-3327-a3e9-b12a36c05ee2",
                                        "glosses": [
                                            "που ανήκει σε κάποιον, που είναι δικός του και τον χαρακτηρίζει"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715075fb-a27a-44e0-9ba1-7b31b46b64cc",
                                                "sense_id": "dc2ead62-38ba-39bd-88c0-358d0f246662",
                                                "text": "τα ιδιαίτερα χαρακτηριστικά ενός ατόμου"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364dd7a0-2e00-3d72-978c-4155f123f905",
                                        "entry_id": "82362118-4bfa-3327-a3e9-b12a36c05ee2",
                                        "glosses": [
                                            "ξεχωριστός"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19185f69-1175-42b3-b812-22df012f2e53",
                                                "sense_id": "364dd7a0-2e00-3d72-978c-4155f123f905",
                                                "text": "του έχω ιδιαίτερη αδυναμία"
                                            },
                                            {
                                                "example_id": "3413d4e5-19c7-48fa-af6c-bd1d061788eb",
                                                "sense_id": "364dd7a0-2e00-3d72-978c-4155f123f905",
                                                "text": "※ ποτέ οι πωλήσεις των βιβλίων μου δεν ξεπερνούσαν το φράγμα της πρώτης, άντε το πολύ της δεύτερης έκδοσης. «Μη στενοχωριέσαι. Είναι γιατί είσαι ιδιαίτερος συγγραφέας. Σε διαβάζουν λίγοι αλλά εκλεκτοί ... » Με τέτοια με παρηγορούσε ο μπαγάσας. Ήταν από τους δυο τρεις που έβγαινα για ποτό και που εμπιστευόμουν τα χειρόγραφα να ακούσω τη γνώμη τους. (Κώστας Ακριβός, Γάλα Μαγνησίας, εκδ. Μεταίχμιο, 2018)"
                                            }
                                        ]
                                    }
                                ]
