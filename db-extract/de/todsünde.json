                        "target_lang_word": "deadly sin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deadly sin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89f670d6-cb1c-3fab-becd-31608c3a1bbd",
                                        "entry_id": "ac8a765d-7b87-37bc-aba0-b77b3c738abc",
                                        "glosses": [
                                            "Any of the seven deadly sins: pride (or vanity, vainglory), envy, gluttony, greed (or avarice), lust, sloth (or acedia), and wrath (or anger)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85ce66a1-7291-4931-b328-382016677a3c",
                                                "sense_id": "89f670d6-cb1c-3fab-becd-31608c3a1bbd",
                                                "text": "There are deadly sins from which God's people may recover. A man may even communicate unworthily, and yet, so be it he sin not against the Holy Ghost, he may find forgiveness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
