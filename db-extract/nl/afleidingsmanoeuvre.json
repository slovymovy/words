                "senses": [
                    {
                        "sense_id": "7de63dbc-c00f-3431-9cc0-33e8b8add242",
                        "entry_id": "babcff09-d550-370c-a032-4114b2a5e56c",
                        "glosses": [
                            "een actie die erop gericht is de aandacht van iemand op iets anders te laten richten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c6dc9e-2e83-42a4-b63d-5ee2077050c7",
                                "sense_id": "7de63dbc-c00f-3431-9cc0-33e8b8add242",
                                "text": "Via een handige afleidingsmanoeuvre wist de arts het kind minder bang te laten zijn voor de prik die het zou moeten krijgen."
                            },
                            {
                                "example_id": "8c88a445-8a92-4231-a7b0-be0af065e77e",
                                "sense_id": "7de63dbc-c00f-3431-9cc0-33e8b8add242",
                                "text": "Het hoeft geen betoog dat de kritiek van Bouman onmiddellijk in Caraïbisch Nederland werd weggehoond, waarbij ‘afleidingsmanoeuvre’ de vriendelijkste kwalificatie was. Zelden heeft een onderzoeksrapport zo snel zijn gezag en bruikbaarheid verloren."
                            },
                            {
                                "example_id": "fbc21053-008b-43cf-af1c-16b0909b975a",
                                "sense_id": "7de63dbc-c00f-3431-9cc0-33e8b8add242",
                                "text": "De enige keer dat ik ooit iets nuttigs had gedaan was toen ik een Hutt had ondergekotst die Yantuh heette, wat een handige afleidingsmanoeuvre bleek te zijn die Chewie de kans gaf een blaster te grijpen en ons van een wisse dood te redden."
                            }
                        ]
                    }
                ],
