                    {
                        "sense_id": "9d5db190-8247-3a42-8bf0-54d645567083",
                        "entry_id": "5626ba7d-3a82-3481-bf71-077d84e47676",
                        "glosses": [
                            "a dreamworld, imaginary world, such as experienced while dreaming"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f092437e-e284-402a-80d6-72667b1c3841",
                                "sense_id": "9d5db190-8247-3a42-8bf0-54d645567083",
                                "text": "In mijn droomwereld vlieg ik door de lucht als een vogel.",
                                "translation": "In my dreamworld, I fly through the air like a bird.",
                                "english": "In my dreamworld, I fly through the air like a bird."
                            },
                            {
                                "example_id": "8e95be7e-9105-4143-a221-be28a9ab2f92",
                                "sense_id": "9d5db190-8247-3a42-8bf0-54d645567083",
                                "text": "Ze creëerde haar eigen droomwereld waarin alles mogelijk was.",
                                "translation": "She created her own dreamworld where everything was possible.",
                                "english": "She created her own dreamworld where everything was possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f197c2a-b40e-3800-95ad-9e0792e47cd3",
                        "entry_id": "5626ba7d-3a82-3481-bf71-077d84e47676",
                        "glosses": [
                            "an ideal world, utopia"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "5c0f1dde-fdf9-4730-a5e9-eda34694fcfe",
                                "sense_id": "2f197c2a-b40e-3800-95ad-9e0792e47cd3",
                                "text": "Hij verlangt naar een betere wereld, een soort droomwereld waar iedereen gelukkig is.",
                                "translation": "He longs for a better world, a kind of utopia where everyone is happy.",
                                "english": "He longs for a better world, a kind of utopia where everyone is happy."
                            },
                            {
                                "example_id": "66df73c6-ea03-4cf0-b104-8e13055cc7d4",
                                "sense_id": "2f197c2a-b40e-3800-95ad-9e0792e47cd3",
                                "text": "Voor sommigen lijkt een wereld zonder conflicten een onbereikbare droomwereld te zijn.",
                                "translation": "For some, a world without conflicts seems like an unattainable utopia.",
                                "english": "For some, a world without conflicts seems like an unattainable utopia."
                            }
                        ]
                    }
