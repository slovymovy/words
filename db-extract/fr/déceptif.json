                    {
                        "form_id": "8ef9e42f-d77b-4ec4-abc2-f31cf77e50d7",
                        "entry_id": "652856c1-266e-3291-b71e-4b35bb6dfb4c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "déceptives"
