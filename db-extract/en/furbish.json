                    },
                    {
                        "translation_id": "7cbf5fb6-944b-49f5-b383-24089c77b12f",
                        "source_entry_id": "6a700124-e1f6-3a3b-9fb0-ff1326e79e7c",
                        "source_sense_description": "To renovate or recondition",
                        "target_lang_word": "neu ausstatten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ad15e540-f29a-45d3-988a-31fb3caad85f",
                        "source_entry_id": "6a700124-e1f6-3a3b-9fb0-ff1326e79e7c",
                        "source_sense_description": "To renovate or recondition",
                        "target_lang_word": "instand setzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instand setzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                        "entry_id": "28f7b109-a817-3054-a702-ceff0532995b",
                                        "glosses": [
                                            "wieder in den Zustand bringen, in dem etwas entsprechend seiner Bestimmung eingesetzt/benutzt/verwendet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e29a08e-e989-4eeb-9869-e960271ed220",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Ich glaube, er hatte gar nicht vor, heute noch einen Zaun instand zu setzen.“"
                                            },
                                            {
                                                "example_id": "7cc5d291-7695-4a5b-b670-c67aff2b223f",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Im August setzte man die westliche Esskastanieallee instand und befestigte Wege. In den Monaten Juni bis September reinigte man alle Wallgräben.“"
                                            },
                                            {
                                                "example_id": "5410c82b-6aee-4e59-b0b7-2e19cdf4c881",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„An vielen Stellen war die untere Platte neben den 1970 instandgesetzten Bereichen und auch innerhalb dieser Bereiche von den Längsträgerstegen, den Randbalken und den Querträgern abgerissen.“"
                                            },
                                            {
                                                "example_id": "59bc13d8-212b-4f61-a5fa-b227ae763ed6",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Es gab Fälle, wo ein gerade eben instand gesetzter Abschnitt gleich wieder zerstört wurde.“"
                                            },
                                            {
                                                "example_id": "8902ef82-5e13-486f-b681-2f6f843ad8c0",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Auf einem wackeligen Gerüst aus knorrigen Stöcken waren ein Dutzend Maurer damit beschäftigt, ein kommunales Gebäude mit einem wolkenförmigen Loch in der Fassade instand zu setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c660f89-ee3f-4d6a-960f-33e3e9a955dc",
                        "source_entry_id": "6a700124-e1f6-3a3b-9fb0-ff1326e79e7c",
                        "source_sense_description": "To renovate or recondition",
                        "target_lang_word": "neu einrichten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "db64b7b1-76b3-47f3-ba5c-cd4694bde4b9",
                        "source_entry_id": "6a700124-e1f6-3a3b-9fb0-ff1326e79e7c",
                        "source_sense_description": "To renovate or recondition",
                        "target_lang_word": "renovieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renovieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4c75b5-1edb-32dc-b792-d75b876e26f8",
                                        "entry_id": "4095bb94-2265-3130-8cf5-ee922fb617d3",
                                        "glosses": [
                                            "Gebäude, Räumlichkeiten, Innenausstattungen oder Ähnliches wieder herrichten, erneuern, instand setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3cbae0-3533-45a2-ae03-61d676531fa3",
                                                "sense_id": "4b4c75b5-1edb-32dc-b792-d75b876e26f8",
                                                "text": "Das Nachbarhaus wird schon seit Monaten renoviert."
                                            },
                                            {
                                                "example_id": "26d98701-7adc-4dd7-9681-2e49e134ae55",
                                                "sense_id": "4b4c75b5-1edb-32dc-b792-d75b876e26f8",
                                                "text": "Wir müssen diesen Herbst dringend die Ferienwohnung renovieren."
                                            },
                                            {
                                                "example_id": "886f8ca0-bb4d-4549-88e3-1858cfa3f14f",
                                                "sense_id": "4b4c75b5-1edb-32dc-b792-d75b876e26f8",
                                                "text": "Peter renoviert seine Gartenlaube."
                                            },
                                            {
                                                "example_id": "5b6966f5-e7d7-4542-884b-32724d88cb0d",
                                                "sense_id": "4b4c75b5-1edb-32dc-b792-d75b876e26f8",
                                                "text": "Wenn das Wohnzimmer am Ende des Jahres renoviert sein soll, müssen wir das Material bald mal kaufen."
                                            },
                                            {
                                                "example_id": "a230e0d2-3783-494f-8919-830100d115c8",
                                                "sense_id": "4b4c75b5-1edb-32dc-b792-d75b876e26f8",
                                                "text": "„Ich teilte dem Verleger mit, dass das Projekt buchstäblich ins Wasser gefallen sei, und begann mein Zimmer zu renovieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
