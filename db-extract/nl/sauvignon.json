                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ffb3354-b18d-4b63-ac35-e403d1cc0bb9",
                                "sense_id": "e05ecd1f-0e5c-35d9-afb8-4b3a080bfa59",
                                "text": "Çabernet sauvignon bij biefstuk, gamay bij atletiek, helemaal mee eens."
                            },
                            {
                                "example_id": "a1792aa1-970c-4a63-81b0-e84127726310",
                                "sense_id": "e05ecd1f-0e5c-35d9-afb8-4b3a080bfa59",
                                "text": "De cursisten mochten raden of die wijn uit een koel of warm klimaat kwam en van welke druif hij gemaakt zou kunnen zijn. Koel, dachten de meesten. En dat het om sauvignon ging, maar het was chardonnay. In het Chablis-terroir – koel klimaat, gemengde bodem van kalksteen en klei – krijg je een heel verfijnde chardonnay die vaak niet als zodanig wordt herkend."
                            }
                        ]
