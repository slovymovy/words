                                                "example_id": "e757575e-4bbd-41d2-b863-f3adff3eb09c",
                                                "sense_id": "048faf19-3ee6-3997-a877-94f484a496ec",
                                                "text": "Die heilige Hildegard von Bingen nannte die Melisse „Bienenauge“."
