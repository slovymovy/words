                "senses": [
                    {
                        "sense_id": "4decbcf9-180a-3895-a512-21661b1d37c0",
                        "entry_id": "e91cb731-a017-35ba-8dcc-98c4ec193a0a",
                        "glosses": [
                            "Transformer en houille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27cea006-1a21-4142-9053-f07273cb8dc6",
                                "sense_id": "4decbcf9-180a-3895-a512-21661b1d37c0",
                                "text": "Je citerai d'abord le temps qui a été incapable de houillifier ou de consolider certaines matières végétales ou certaines roches ;"
                            },
                            {
                                "example_id": "10ff43e8-1a5e-4d7b-99d3-51a1d5a93263",
                                "sense_id": "4decbcf9-180a-3895-a512-21661b1d37c0",
                                "text": "Cette structure avait paru à tout le monde indiquer quatre dépôts successifs dans le même bassin, d’abord de débris végétaux capables de se houillifier, puis d’argile destinée à devenir du schiste, puis de sables propres à se cimenter en grès, enfin de galets qu’un lien ultérieur confondrait en un même poudingue."
                            }
                        ]
                    }
