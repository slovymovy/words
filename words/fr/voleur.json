                    "frequency": "VeryLow",
                    "semantic_group_id": "vol_aerien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce rapace migrateur est un puissant <w>voleur</w> capable de franchir de vastes mers."
