{
    "word_family": [
        "resource",
        "outsourcing",
        "insourcing",
        "crowdsourcing",
        "sourcer",
        "resourcing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "186e8f33-b3cb-3616-9465-e030e1a420f0",
                    "sense_definition": "The person, place, or thing from which something like information or goods comes or is acquired.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist refused to reveal the <w>source</w> of the confidential information.",
                            "target_lang_translations": {
                                "ru": "Журналист отказался раскрыть <w>источник</w> конфиденциальной информации."
                            }
                        },
                        {
                            "text": "The company is looking for a reliable <w>source</w> of raw materials for their new factory.",
                            "target_lang_translations": {
                                "ru": "Компания ищет надежный <w>источник</w> сырья для своего нового завода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reliable source",
                        "primary source",
                        "source of information",
                        "energy source"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, место или предмет, от которого что-либо (например, информация или товары) исходит или приобретается."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "общее значение: место или лицо, дающее начало чему-либо"
                            },
                            {
                                "target_lang_word": "первоисточник",
                                "target_lang_sense_clarification": "самый первый, оригинальный источник сведений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d54c30-8186-3bf3-a7ae-50e3e5443544",
                    "sense_definition": "The place where a stream or river begins, such as a spring or fountainhead.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers spent months searching for the <w>source</w> of the Nile river.",
                            "target_lang_translations": {
                                "ru": "Исследователи провели месяцы в поисках <w>истока</w> реки Нил."
                            }
                        },
                        {
                            "text": "The water at the river <w>source</w> is incredibly cold and clear.",
                            "target_lang_translations": {
                                "ru": "Вода в <w>истоке</w> реки невероятно холодная и прозрачная."
                            }
                        }
                    ],
                    "synonyms": [
                        "wellspring",
                        "origin",
                        "spring"
                    ],
                    "common_phrases": [
                        "river source",
                        "mountain source"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где начинается ручей или река, например, родник или ключ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исток",
                                "target_lang_sense_clarification": "географическое начало реки или ручья"
                            },
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "водный объект, выходящий на поверхность"
                            },
                            {
                                "target_lang_word": "родник",
                                "target_lang_sense_clarification": "естественный выход подземных вод"
                            },
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "бьющий из земли водный источник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23e0e107-f2af-33f5-9ac4-d0eec0144716",
                    "sense_definition": "A person who provides information to a reporter or investigator.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An anonymous <w>source</w> provided the documents that led to the investigation.",
                            "target_lang_translations": {
                                "ru": "Анонимный <w>источник</w> предоставил документы, которые привели к расследованию."
                            }
                        },
                        {
                            "text": "The police have a confidential <w>source</w> within the criminal organization.",
                            "target_lang_translations": {
                                "ru": "У полиции есть доверенный <w>источник</w> внутри преступной организации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "anonymous source",
                        "confidential source",
                        "unnamed source"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предоставляющий информацию репортеру или следователю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "лицо, сообщающее сведения"
                            },
                            {
                                "target_lang_word": "информатор",
                                "target_lang_sense_clarification": "человек, передающий секретные данные"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a790f9a9-3b0a-3ecb-899f-c31b337d62cf",
                    "sense_definition": "The human-readable version of a computer program before it is compiled; <w>source code</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer uploaded the <w>source</w> to a public repository for others to review.",
                            "target_lang_translations": {
                                "ru": "Разработчик загрузил <w>исходный код</w> в публичный репозиторий для ознакомления."
                            }
                        },
                        {
                            "text": "You need to compile the <w>source</w> before you can run the application.",
                            "target_lang_translations": {
                                "ru": "Вам нужно скомпилировать <w>исходник</w>, прежде чем вы сможете запустить приложение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "open source"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a shorthand for source code"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Версия компьютерной программы на языке программирования до её компиляции; исходный код."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исходный код",
                                "target_lang_sense_clarification": "полный термин в программировании"
                            },
                            {
                                "target_lang_word": "исходник",
                                "target_lang_sense_clarification": "разговорный сленг программистов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89100f93-a197-357d-b8dc-78b0a4bc78e5",
                    "sense_definition": "A node in a directed graph where all edges go out and none enter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this network flow diagram, the <w>source</w> is the starting point for all data.",
                            "target_lang_translations": {
                                "ru": "На этой диаграмме сетевого потока <w>исток</w> является отправной точкой для всех данных."
                            }
                        },
                        {
                            "text": "Identify the <w>source</w> and the sink in the directed graph provided.",
                            "target_lang_translations": {
                                "ru": "Определите <w>исток</w> и сток в представленном ориентированном графе."
                            }
                        }
                    ],
                    "antonyms": [
                        "sink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узел в ориентированном графе, из которого выходят все ребра и в который не входит ни одно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исток",
                                "target_lang_sense_clarification": "математический термин в теории графов"
                            },
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "начальная точка потока в сети"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293bde88-56a7-31cc-a56a-1edc312a9ab8",
                    "sense_definition": "The domain of a function or the object from which a morphism originates.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mapping connects every element in the <w>source</w> to a unique element in the target.",
                            "target_lang_translations": {
                                "ru": "Отображение связывает каждый элемент в <w>области определения</w> с уникальным элементом в целевом множестве."
                            }
                        },
                        {
                            "text": "In category theory, a morphism goes from a <w>source</w> object to a target object.",
                            "target_lang_translations": {
                                "ru": "В теории категорий морфизм идет от <w>объекта-источника</w> к целевому объекту."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Область определения функции или объект, из которого исходит морфизм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "область определения",
                                "target_lang_sense_clarification": "для функций"
                            },
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "в теории категорий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41f04fd7-61b7-3763-b268-957e88132ddc",
                    "sense_definition": "The name of one terminal of a field effect transistor (FET).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The current flows from the <w>source</w> to the drain in this type of transistor.",
                            "target_lang_translations": {
                                "ru": "В этом типе транзистора ток течет от <w>истока</w> к стоку."
                            }
                        },
                        {
                            "text": "Check the voltage at the <w>source</w> terminal to ensure the circuit is working.",
                            "target_lang_translations": {
                                "ru": "Проверьте напряжение на выводе <w>истока</w>, чтобы убедиться в исправности цепи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название одного из выводов полевого транзистора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исток",
                                "target_lang_sense_clarification": "электрод полевого транзистора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "442f7b34-c825-345a-8f4f-04a5e5adf4fe",
                    "sense_definition": "To obtain or procure something, especially a resource for a business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "procurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>source</w> materials from local suppliers to reduce costs.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>закупать</w> материалы у местных поставщиков, чтобы снизить расходы."
                            }
                        },
                        {
                            "text": "It is becoming harder to <w>source</w> high-quality components in the current market.",
                            "target_lang_translations": {
                                "ru": "На текущем рынке становится все труднее <w>находить</w> высококачественные компоненты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "locally sourced",
                        "ethically sourced"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать или закупать что-либо, особенно ресурсы для бизнеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закупать",
                                "target_lang_sense_clarification": "приобретать товары или сырье"
                            },
                            {
                                "target_lang_word": "находить поставщиков",
                                "target_lang_sense_clarification": "осуществлять поиск ресурсов"
                            },
                            {
                                "target_lang_word": "добывать",
                                "target_lang_sense_clarification": "получать необходимые материалы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ddccd3d-b7fc-30cb-afe6-dbda61fe35bc",
                    "sense_definition": "To find or provide the origin or citation for a piece of information or a quotation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor asked the author to <w>source</w> every quote used in the biography.",
                            "target_lang_translations": {
                                "ru": "Редактор попросил автора <w>указать источник</w> каждой цитаты, использованной в биографии."
                            }
                        },
                        {
                            "text": "The researcher managed to <w>source</w> the obscure reference to an 18th-century manuscript.",
                            "target_lang_translations": {
                                "ru": "Исследователю удалось <w>найти происхождение</w> малоизвестной ссылки в рукописи XVIII века."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находить или указывать происхождение или цитату для информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывать источник",
                                "target_lang_sense_clarification": "приводить ссылку на происхождение"
                            },
                            {
                                "target_lang_word": "документировать",
                                "target_lang_sense_clarification": "подтверждать данными об источнике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}