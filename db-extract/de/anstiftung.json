                ],
                "senses": [
                    {
                        "sense_id": "a62b57e4-034b-3f40-bd7f-3af05561d07f",
                        "entry_id": "adf788f1-068c-3c20-b4d9-8151059f6646",
                        "glosses": [
                            "Instigation, incitation, sollicitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba108580-7e59-48c5-a32e-443f54db6605",
                                "sense_id": "a62b57e4-034b-3f40-bd7f-3af05561d07f",
                                "text": "Unter Anstiftung versteht das deutsche Strafrecht die ernst gemeinte, vorsätzliche und erfolgreiche Aufforderung an einen anderen, eine Straftat zu begehen."
                            },
                            {
                                "example_id": "138c9dc3-2554-4ad4-a523-41113b80d883",
                                "sense_id": "a62b57e4-034b-3f40-bd7f-3af05561d07f",
                                "text": "Der Haftbefehl, auf Grund dessen Philipp Reemtsma am 3. Januar verhaftet wurde, ist aber »wegen Bestechung und Anstiftung zur Rechtsbeugung« erlassen."
                            }
                        ]
                    }
                ],
