    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "423afc93-4ae9-3737-80ea-de42128c812d",
                    "sense_definition": "Arriver au terme de son développement biologique, en parlant d'un fruit, d'un légume ou d'une plante.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maturation_vegetale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les tomates commencent enfin à <w>mûrir</w> sous le soleil de l'été."
                        },
                        {
                            "text": "Ces pommes ne sont pas prêtes, elles doivent encore <w>mûrir</w> quelques jours."
                        }
                    ],
                    "common_phrases": [
                        "mûrir sur l'arbre",
                        "laisser mûrir au soleil"
                    ]
                },
                {
                    "sense_id": "5767c8c0-ca41-3e7b-9eef-8ae1f02a5d7e",
                    "sense_definition": "Acquérir de l'expérience, de la sagesse ou de la maturité avec le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maturation_humaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a beaucoup <w>mûri</w> depuis qu'il a commencé ses études à l'université."
                        },
                        {
                            "text": "Les épreuves de la vie l'ont aidé à <w>mûrir</w> et à devenir responsable."
                        }
                    ],
                    "synonyms": [
                        "grandir"
                    ],
                    "common_phrases": [
                        "mûrir avec le temps",
                        "mûrir avec l'âge"
                    ]
                },
                {
                    "sense_id": "27c381fc-c2a8-369c-bafd-be8c5e2bb76f",
                    "sense_definition": "Se développer et progresser vers sa forme définitive, en parlant d'une idée, d'un projet ou d'une réflexion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maturation_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il vaut mieux laisser <w>mûrir</w> cette proposition avant de donner une réponse définitive."
                        },
                        {
                            "text": "Son projet de création d'entreprise a lentement <w>mûri</w> dans son esprit pendant des mois."
                        }
                    ],
                    "synonyms": [
                        "évoluer"
                    ],
                    "common_phrases": [
                        "laisser mûrir une idée",
                        "mûrir un projet"
                    ]
                },
                {
                    "sense_id": "281a5154-b8e1-3a61-b16e-1d8306a8d281",
                    "sense_definition": "Amener à maturité ; faire parvenir un végétal ou une récolte à son plein développement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "maturation_vegetale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil généreux de cette fin d'été a <w>mûri</w> le raisin beaucoup plus rapidement."
                        },
                        {
                            "text": "Les producteurs utilisent de la chaleur douce pour <w>mûrir</w> certains fruits avant la vente."
                        }
                    ],
                    "common_phrases": [
                        "faire mûrir des fruits"
                    ]
                },
                {
                    "sense_id": "ae4970d1-fdde-38f7-840b-e956cfc5492f",
                    "sense_definition": "Frapper violemment quelqu'un, lui donner des coups.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'homme en colère a menacé de le <w>mûrir</w> s'il refusait de partir immédiatement."
                        },
                        {
                            "text": "Arrête de m'insulter avant que je ne vienne te <w>mûrir</w> comme il faut."
                        }
                    ],
                    "synonyms": [
                        "frapper",
                        "rosser"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "populaire"
                        }
                    ]
                }
            ]
        }
    ]
