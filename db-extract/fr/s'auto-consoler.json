                "senses": [
                    {
                        "sense_id": "8b08a951-d5ca-338c-9e06-0baf8014cc47",
                        "entry_id": "029e2bb0-bff6-3a66-b5c8-e223f335427b",
                        "glosses": [
                            "Se consoler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191cd20d-aa73-4958-962c-da79026c22ad",
                                "sense_id": "8b08a951-d5ca-338c-9e06-0baf8014cc47",
                                "text": "Et pas facile de s’auto-consoler non plus."
                            },
                            {
                                "example_id": "1742211b-f3eb-411e-92a4-c917d472d397",
                                "sense_id": "8b08a951-d5ca-338c-9e06-0baf8014cc47",
                                "text": "Par exemple, la posture qu’on prend lorsqu’on est triste sert à s’auto-consoler."
                            },
                            {
                                "example_id": "b1862956-e2d3-4580-aa7c-ae66818203f8",
                                "sense_id": "8b08a951-d5ca-338c-9e06-0baf8014cc47",
                                "text": "Être un adulte se caractérise par une autonomie émotive, ce qui signifie que nous devenons notre propre parent pour s’auto-encourager, s’auto-rassurer, s’auto-aimer et s’auto-consoler."
                            }
                        ]
                    }
