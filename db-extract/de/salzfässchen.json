                ],
                "senses": [
                    {
                        "sense_id": "012e21a7-ee32-3b72-9b94-840fe4d48ae4",
                        "entry_id": "514fb39d-8952-3103-be1f-e1f6d4e32a71",
                        "glosses": [
                            "kleines Salzfass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97bebfc-664a-4ea8-9179-7d810950045d",
                                "sense_id": "012e21a7-ee32-3b72-9b94-840fe4d48ae4",
                                "text": "„… aber eines Tages stieß er, als er danach griff, das Salzfässchen um. Unter Tischnachbarn muss man gewisse Höflichkeitsregeln beachten, und so reichte ich ihm das meine, nicht ohne zu sagen, dass in manchen Ländern das Verstreuen von Salz als schlechtes Vorzeichen gilt, worauf er lachend erwiderte, er sei nicht abergläubisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1a9e556-6edb-3645-a5a3-92e8d2d298e3",
                        "entry_id": "514fb39d-8952-3103-be1f-e1f6d4e32a71",
                        "glosses": [
                            "markante Stelle am (menschlichen) Hals hinter den Schlüsselbeinen"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "a43f9583-bbbc-4e2d-afb1-310cd5a2b315",
                                "sense_id": "a1a9e556-6edb-3645-a5a3-92e8d2d298e3",
                                "text": "„Ich sah die Schulter, diesen langen Hals, den sie hat, das Schlüsselbein, wie es herausragte, das Salzfässchen, eine tiefe Mulde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
