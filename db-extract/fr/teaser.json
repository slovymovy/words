        "fr-extract.jsonl": [
            {
                "entry_id": "2f88d99c-5419-3e2e-b51e-185bddc0e99d",
                "word": "teaser",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8df733f3-8f08-4bad-9624-9b0141cd71ec",
                        "entry_id": "2f88d99c-5419-3e2e-b51e-185bddc0e99d",
                        "tags": [
                            "plural"
                        ],
                        "form": "teasers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "976b138e-1a1b-306c-8a3b-ff82dfde64fd",
                        "entry_id": "2f88d99c-5419-3e2e-b51e-185bddc0e99d",
                        "glosses": [
                            "Leurre sans hameçon créant une agitation dans l’eau, ressemblant à une proie en détresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2d0217-5731-4262-ab14-1b7b88d5ed87",
                                "sense_id": "976b138e-1a1b-306c-8a3b-ff82dfde64fd",
                                "text": "Issu du verbe to tease qui signifie taquiner, le teaser est un objet dont le but est de créer une agitation dans l’eau susceptible d’attirer les poissons chasseurs."
                            },
                            {
                                "example_id": "c8b5802a-f253-4a17-a06c-4b218713b15c",
                                "sense_id": "976b138e-1a1b-306c-8a3b-ff82dfde64fd",
                                "text": "Certains pêcheurs traînent d’abord le teaser et lorsqu’un poisson montre des signes d’intérêt, ils le remplacent rapidement par un leurre à hameçon."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb714b28-429c-3836-9276-1d8ddab74b25",
                        "entry_id": "2f88d99c-5419-3e2e-b51e-185bddc0e99d",
                        "glosses": [
                            "Aguiche, accroche"
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "428ecb59-107b-4e99-8fd5-999bb0d077f6",
                                "sense_id": "eb714b28-429c-3836-9276-1d8ddab74b25",
                                "text": "Les bande-annonces ou les teasers de Kubrick révèlent un talent peu commun de manipulateur."
                            },
                            {
                                "example_id": "08ee616c-b011-4b42-9ec6-03963be1cb1d",
                                "sense_id": "eb714b28-429c-3836-9276-1d8ddab74b25",
                                "text": "Les indépendants recherchent la provocation dès le début du film avec des teasers, des scènes d’accrochés qui fascinent le spectateur."
                            },
                            {
                                "example_id": "f2d3d28c-0502-4c57-9b43-408ab9e5ecfa",
                                "sense_id": "eb714b28-429c-3836-9276-1d8ddab74b25",
                                "text": "Il peuvent ainsi aujourd'hui utiliser le teaser - de l'anglais to tease = chatouiller — campagnes à rebondissment qui ne révèle d'abord qu'une partie du message pour exciter la curiosité'"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
