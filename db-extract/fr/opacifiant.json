                "senses": [
                    {
                        "sense_id": "e2d22e6f-95a7-3787-adf2-8359b5adc001",
                        "entry_id": "3c06084b-4e84-3c08-bc82-ffdb15dc1b5c",
                        "glosses": [
                            "Additif permettant d’opacifier un matériau (souvent une peinture) qui serait autrement transparent ou translucide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9eb52d5-20df-4d8f-b624-533e47dfc88a",
                                "sense_id": "e2d22e6f-95a7-3787-adf2-8359b5adc001",
                                "text": "L’oxyde de titane est un opacifiant largement utilisé dans les peintures blanches."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b2ca638-a08f-3e7d-9897-ac64ecb4ed46",
                        "entry_id": "3c06084b-4e84-3c08-bc82-ffdb15dc1b5c",
                        "glosses": [
                            "Produit qui opacifie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6e9f73-de40-4dc0-892e-7a6da4961442",
                                "sense_id": "7b2ca638-a08f-3e7d-9897-ac64ecb4ed46",
                                "text": "L’opacifiant est introduit par voie orale ou intraveineuse : il peut alors se concentrer sélectivement dans la rate (splénographie), le foie (hépatographie), avant d’être éliminé par la voie biliaire (cholangiographie), à travers la vésicule (cholécystographie), par la voie rénale (rénographie), par l’appareil urinaire (urographie descendante)."
                            }
                        ]
                    }
