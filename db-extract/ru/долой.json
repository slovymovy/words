                    },
                    {
                        "translation_id": "442993ac-cb2d-47a2-9fdd-8d54cd67219d",
                        "source_entry_id": "2930de93-8822-33af-b3ef-d6cfb5bebb0f",
                        "target_lang_word": "bas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b45f1e9f-f54d-36b6-8019-d8a0c1e224ea",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qui a peu de hauteur ou d’élévation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b341a158-f670-4813-9d22-eee87c83a21a",
                                                "sense_id": "b45f1e9f-f54d-36b6-8019-d8a0c1e224ea",
                                                "text": "Nous reçûmes l’ordre de côtoyer en le remontant le ruisseau de la Tourbe, qui arrose la plus triste vallée du monde, entre des collines basses, sans arbres et sans buissons."
                                            },
                                            {
                                                "example_id": "72758546-0696-4c2a-82b6-8a8578ef4dd2",
                                                "sense_id": "b45f1e9f-f54d-36b6-8019-d8a0c1e224ea",
                                                "text": "Des rochers bas, couverts de mousses et de varechs, émergent à marée basse."
                                            },
                                            {
                                                "example_id": "de06d94b-738b-4c4f-9b02-d044a8c21201",
                                                "sense_id": "b45f1e9f-f54d-36b6-8019-d8a0c1e224ea",
                                                "text": "Ainsi, le lit de l’Oued Bouskoura à Casablanca a vu s’établir de nombreuses populations à la suite de vagues d’exodes ruraux, ou le quartier Koulima à Tétouan, situé dans un point bas régulièrement touché par les inondations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ed71e70-d2e5-3751-b1c2-86f9112a1087",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qui est situé à un niveau inférieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d847c99d-1af1-4d43-bab5-f6fc72b0cfe3",
                                                "sense_id": "4ed71e70-d2e5-3751-b1c2-86f9112a1087",
                                                "text": "Les étages bas ont été loués à une société de commerce."
                                            },
                                            {
                                                "example_id": "9030f3fe-e35d-4187-8b16-434d4f006af2",
                                                "sense_id": "4ed71e70-d2e5-3751-b1c2-86f9112a1087",
                                                "text": "Il est resté au plus bas degré de la hiérarchie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a448ba-b3b8-3758-a4b8-86c64676bd25",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qualifie un lieu dont l’altitude est inférieure que celui d’où descendent les rivières qui les arrosent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f07133-c785-4143-9ec0-3e238395df8c",
                                                "sense_id": "41a448ba-b3b8-3758-a4b8-86c64676bd25",
                                                "text": "La basse Normandie. — La basse Égypte."
                                            },
                                            {
                                                "example_id": "ad0eba26-50c5-4486-9468-ff56a993b0c4",
                                                "sense_id": "41a448ba-b3b8-3758-a4b8-86c64676bd25",
                                                "text": "La basse-ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8a7ad1-36cb-3171-92d4-975b1398d17f",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Baissé, par opposition à levé, redressé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b7f945-0d44-4ad2-86ab-f2c76ec9335e",
                                                "sense_id": "ce8a7ad1-36cb-3171-92d4-975b1398d17f",
                                                "text": "Marcher la tête basse."
                                            },
                                            {
                                                "example_id": "f87610ca-d91f-42e5-a146-2d2028632bbf",
                                                "sense_id": "ce8a7ad1-36cb-3171-92d4-975b1398d17f",
                                                "text": "Un chien qui porte les oreilles basses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a624b7-4467-326e-bd5f-f743e459d8dc",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c116b1-7e68-4d69-8ad0-0d8868c16b6e",
                                                "sense_id": "64a624b7-4467-326e-bd5f-f743e459d8dc",
                                                "text": "Il est proche le jour où ton front s’inclinera vers le mien, où tu me diras de la voix tendre et basse et enivrée qui fait trembler mon âme : Tu es là."
                                            },
                                            {
                                                "example_id": "ca8a40e2-451e-47cd-8a31-b80dc0b44fd2",
                                                "sense_id": "64a624b7-4467-326e-bd5f-f743e459d8dc",
                                                "text": "Ce morceau est écrit dans un ton trop bas pour ma voix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qui est inférieur, moindre ou subalterne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440beba5-2eb5-47be-8189-ec463216be37",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "Le bas peuple est toujours prompt à grogner."
                                            },
                                            {
                                                "example_id": "aef818d2-ecb7-4f7c-ac74-1c08ce95f9ae",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "Les basses cartes du jeu."
                                            },
                                            {
                                                "example_id": "79564d0d-4319-4f11-b477-05b2f49f0084",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "Les taux bancaires sont bas en ce moment."
                                            },
                                            {
                                                "example_id": "e118909f-bd8c-4fa6-8ed0-2bb458f619aa",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "bas-Empire : L’empire romain ou l’Égypte à leur temps de décadence."
                                            },
                                            {
                                                "example_id": "f77f38bf-c40b-4398-8599-91615a193dd2",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "Basse époque : Dernière époque de l’histoire de l’Égypte ancienne, se terminant avec son absorption par l’empire romain."
                                            },
                                            {
                                                "example_id": "912b79f8-52e3-452a-aa53-4b4e8ab6d2d7",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "bas-latin : Langue latine en usage dans les derniers temps de l’Empire romain et au moyen âge."
                                            },
                                            {
                                                "example_id": "6bbefc96-c9fd-45a8-936e-cbac70b70df6",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": ". – Quand l’éducation des basses classes sera-t-elle assez forte pour empêcher les petites filles de rire lorsque leurs parents pleurent ?"
                                            },
                                            {
                                                "example_id": "0d600767-b436-46e4-acbe-b9d0c42235a0",
                                                "sense_id": "86fa29b8-dd9f-33d9-a626-f924ba2cf19f",
                                                "text": "Mais le propre de certaines personnes insécures est de taper sur les gens qu’elles perçoivent comme étant plus « bas » qu’elles, pour se sentir supérieures. C’est bas, justement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e733c98c-170b-3e9c-accd-8cd231168b1b",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qui est vil, méprisable, contraire à la noblesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ceef054-306f-47ca-8fd5-aba31ad9878f",
                                                "sense_id": "e733c98c-170b-3e9c-accd-8cd231168b1b",
                                                "text": "Une vengeance basse et cruelle. — C’est un homme bas et servile."
                                            },
                                            {
                                                "example_id": "ded5fbe6-fbd0-47f1-be16-9627a0461a0a",
                                                "sense_id": "e733c98c-170b-3e9c-accd-8cd231168b1b",
                                                "text": "Sans cesse en alerte, en constante défiance, les habitants de ces cavernes de pierre, n’avaient comme délassement que de basses orgies et le troussement crapuleux des maritornes."
                                            },
                                            {
                                                "example_id": "5583e478-baea-470d-84e4-2f983cba8d9a",
                                                "sense_id": "e733c98c-170b-3e9c-accd-8cd231168b1b",
                                                "text": "Ainsi les divertissements qui font le bonheur des hommes ne sont pas seulement bas, ils sont encore faux et trompeurs; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d00516d-86b0-3b56-ba35-6fd5002c08c7",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qui est trivial ou populaire, en parlant du registre de langage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "423229a9-b15b-46de-b2da-5fa1369e6e9e",
                                                "sense_id": "8d00516d-86b0-3b56-ba35-6fd5002c08c7",
                                                "text": "Cette expression est basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "697124c0-efbd-3f56-80e8-99f37535dfb3",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qualifie le ciel lorsqu’il est chargé de nuages moins élevés qu’à l’ordinaire, signe que le temps menace de pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c2787a-054d-4459-a176-67b6ccb3895f",
                                                "sense_id": "697124c0-efbd-3f56-80e8-99f37535dfb3",
                                                "text": "Le ciel bas pesait sur la terre, et les champs, vêtus d’ombres grises, avaient l’air de somnoler au long des jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77628132-07cf-38a0-b943-a203ac12eb7c",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qualifie les classes par où commencent les écoliers, les classes élémentaires."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d85bab3-156f-32d6-9951-14e34bf876aa",
                                        "entry_id": "98a6f9c8-d759-3059-be67-3526c5195da5",
                                        "glosses": [
                                            "Qualifiait, dans les places, les casemates et flancs de bastions qui servaient à défendre le fossé et la courtine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3519459b-fac4-395a-bdc8-81f6b797368a",
                                        "entry_id": "56b5acfe-ee04-3b61-8243-023a8fb09be1",
                                        "glosses": [
                                            "Partie inférieure d’un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9a786b-4333-4913-8b2e-ed28fbc7d714",
                                                "sense_id": "3519459b-fac4-395a-bdc8-81f6b797368a",
                                                "text": "[…], il regardait au bas de la falaise la Morava tenter avec peine de faire pénétrer ses eaux vertes dans les flots boueux du Danube, […]."
                                            },
                                            {
                                                "example_id": "70eda67e-9b76-4812-91ab-d5b1aee9973a",
                                                "sense_id": "3519459b-fac4-395a-bdc8-81f6b797368a",
                                                "text": "On trouve en Bretagne des anatifes cramponnés en colonies serrées au bas des à-pics rocheux sans cesse battus par les vagues."
                                            },
                                            {
                                                "example_id": "ee28faa0-5aaa-4e51-a02b-a5743960c11c",
                                                "sense_id": "3519459b-fac4-395a-bdc8-81f6b797368a",
                                                "text": "La salle des fêtes était habillée pour une grande cérémonie, de somptueux rideaux blancs et pourpres qui tombaient du haut plafond jusqu’au bas des portes et des fenêtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2bb2c8b-6fc8-38c8-8813-d4a19787e550",
                                        "entry_id": "56b5acfe-ee04-3b61-8243-023a8fb09be1",
                                        "glosses": [
                                            "Registre des sons graves"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00aec59-12ef-46f9-88b1-e222aef4ef7a",
                                                "sense_id": "f2bb2c8b-6fc8-38c8-8813-d4a19787e550",
                                                "text": "La voix de ce chanteur est belle dans le bas."
                                            },
                                            {
                                                "example_id": "282e50d3-f485-4be8-bd1d-2b1df4fc5cb4",
                                                "sense_id": "f2bb2c8b-6fc8-38c8-8813-d4a19787e550",
                                                "text": "Les notes du bas au piano, autrement dites ”les basses“."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde757e0-e65b-3226-a145-d20cd4b02ebb",
                                        "entry_id": "56b5acfe-ee04-3b61-8243-023a8fb09be1",
                                        "glosses": [
                                            "(Plurale tantum) (au pluriel uniquement) Vêtement très ajusté servant à couvrir les jambes."
                                        ],
                                        "tags": [
                                            "Ellipse de bas-de-chausses"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f19303e-d28a-4d46-ad80-9b5617eb5efc",
                                                "sense_id": "fde757e0-e65b-3226-a145-d20cd4b02ebb",
                                                "text": "Madame Derville voyait avec étonnement que son amie, toujours grondée par M. de Rênal, à cause de l’excessive simplicité de sa toilette, venait de prendre des bas à jour et de charmants petits souliers arrivés de Paris."
                                            },
                                            {
                                                "example_id": "d6d6d4a0-1371-42ed-a1d1-c8fbe346bfcb",
                                                "sense_id": "fde757e0-e65b-3226-a145-d20cd4b02ebb",
                                                "text": "Il fallait la voir regarder, de ses yeux bordés de rouge, les étalages des bas de soie brodés, et les chapeaux joliment chiffonnés, qui, chez les modistes, se dressent fièrement au haut des champignons de palissandre !"
                                            },
                                            {
                                                "example_id": "671fb9ac-e861-413d-b2af-fbc2b43811d6",
                                                "sense_id": "fde757e0-e65b-3226-a145-d20cd4b02ebb",
                                                "text": "— Une vraie grande dame, ajouta-t-il, et qui ne montre pas sa magnificence par des robes et des chapeaux. Elle porte ses chemises six semaines et quelquefois davantage. Les gentilshommes de sa suite lui ont vu des bas blancs, très sales, qui lui tombaient sur les talons. Les vertus des grandes reines d’Espagne revivent en elle. Ô ces bas sales, quelle gloire véritable !"
                                            },
                                            {
                                                "example_id": "fb985409-4e37-4e78-86dc-7e1beebd4226",
                                                "sense_id": "fde757e0-e65b-3226-a145-d20cd4b02ebb",
                                                "text": "Je n’aime point les fautes de goût. Vous en commettez en ce moment plusieurs. Vous portez des souliers vernis et des bas de soie avec un costume de voyage. Séparément, tout cela est bien. Réunies, ces choses hurlent de se trouver ensemble."
                                            },
                                            {
                                                "example_id": "17c581ab-cbb6-434e-9e86-cc50a09c0eca",
                                                "sense_id": "fde757e0-e65b-3226-a145-d20cd4b02ebb",
                                                "text": "Et il en voulait à Sophie de jouer avec lui comme avec un gosse, de ne point se gêner en sa présence, de tirer ses bas, de s’accroupir sur le lit, les genoux hauts, de continuer à ne pas boutonner son corsage, de le tenter, peut-être inconsciemment, d’éprouver sa résistance…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e093d15-61c2-3503-9dbc-4ad32bc36964",
                                        "entry_id": "56b5acfe-ee04-3b61-8243-023a8fb09be1",
                                        "glosses": [
                                            "Vêtement sous la ceinture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "071476f7-54ce-3ac4-8e09-ee81eff921d6",
                                        "entry_id": "56b5acfe-ee04-3b61-8243-023a8fb09be1",
                                        "glosses": [
                                            "Chaussette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1910f8be-c22e-4113-ada3-8bb13f823cce",
                                                "sense_id": "071476f7-54ce-3ac4-8e09-ee81eff921d6",
                                                "text": "[…] et cependant on rencontre encore des hommes coiffés du bonnet rayé bleu et rouge, vêtu de vadmel avec les bas de laine grise, la culotte courte à trois boutons et les espadrilles en peau de mouton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c20fe22-6220-3069-8266-b2c926441eaa",
                                        "entry_id": "56b5acfe-ee04-3b61-8243-023a8fb09be1",
                                        "glosses": [
                                            "Bas de laine, argent gagné, économies."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfbd793a-8cc2-4aaa-982e-af4b30a49c7a",
                                                "sense_id": "7c20fe22-6220-3069-8266-b2c926441eaa",
                                                "text": "La fille de joie est belle\nAu coin d'la rue là-bas\nElle a une clientèle\nQui lui remplit son bas. — (chanson « L'Accordéoniste » de Michel Emer, 1940, créée par Édith Piaf)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12da37af-92b8-3ed6-9774-398960fcd1cb",
                                        "entry_id": "6665a320-8d36-3d25-b3ed-2736c809fc00",
                                        "glosses": [
                                            "S’emploie avec les mêmes sens que l’adjectif, au propre et au figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d83b22c-5638-4da7-a0bd-dceb333fcff1",
                                                "sense_id": "12da37af-92b8-3ed6-9774-398960fcd1cb",
                                                "text": "Jamais le taux de la natalité française n’est descendu aussi bas qu’en 1871, où il a été de 2,26 pour 100.[…]. Aucune autre nation ne présente une proportion aussi faible."
                                            },
                                            {
                                                "example_id": "bb706bc0-5301-4365-a5b5-3b39d3bda580",
                                                "sense_id": "12da37af-92b8-3ed6-9774-398960fcd1cb",
                                                "text": "Cet oiseau vole bas."
                                            },
                                            {
                                                "example_id": "1e9e5939-bc9f-4bbb-ad07-30ff9dbb8c69",
                                                "sense_id": "12da37af-92b8-3ed6-9774-398960fcd1cb",
                                                "text": "Il habite deux étages plus bas."
                                            },
                                            {
                                                "example_id": "6175a6dc-973e-4747-a4e8-dfa32c01abaa",
                                                "sense_id": "12da37af-92b8-3ed6-9774-398960fcd1cb",
                                                "text": "Cette injure part de trop bas pour vous atteindre."
                                            },
                                            {
                                                "example_id": "5d326354-457e-4c4e-85a0-c933a71ca63b",
                                                "sense_id": "12da37af-92b8-3ed6-9774-398960fcd1cb",
                                                "text": "Parvenu à ce degré d’avilissement, on ne saurait tomber plus bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "659f9ead-b8f3-38ea-8dfb-2997545da3f5",
                                        "entry_id": "6665a320-8d36-3d25-b3ed-2736c809fc00",
                                        "glosses": [
                                            "Sans élever la voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b727b0-a04c-4144-96d5-f0d071c9795c",
                                                "sense_id": "659f9ead-b8f3-38ea-8dfb-2997545da3f5",
                                                "text": "Parler tout bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e501375-2d00-3e02-80e8-924967b92d42",
                                        "entry_id": "6665a320-8d36-3d25-b3ed-2736c809fc00",
                                        "glosses": [
                                            "Dans un ton grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc62a132-0469-41a1-b1ac-783893609d96",
                                                "sense_id": "1e501375-2d00-3e02-80e8-924967b92d42",
                                                "text": "Vous avez pris ce refrain trop bas en commençant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "498f67e1-82f0-36ba-ab5c-01ca05660819",
                                        "entry_id": "226e691e-ac47-3c61-a2fc-f39357603b03",
                                        "glosses": [
                                            "Bast ! Basta ! Bah ! Laissons tomber !"
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c9901a-ed4e-48b2-8ca4-15881024c91f",
                                                "sense_id": "498f67e1-82f0-36ba-ab5c-01ca05660819",
                                                "text": "Connaissez-vous le lavoir de Châtillon, monsieur le président ? C’est un joli établissement où l’on a tout prodigué pour la commodité de ces dames ; mais bas ! elles n’en ont pas la plus petite obligation au gouvernement ni à moi."
                                            },
                                            {
                                                "example_id": "7e7e2a62-f228-4b41-b495-6a227c46c5b2",
                                                "sense_id": "498f67e1-82f0-36ba-ab5c-01ca05660819",
                                                "text": "L’œuvre est à hue et l’homme à dia\nL’homme vous dit je ne suis pas\nje ne suis pour rien dans mon œuvre\nle « rien » se rebelle et dit bas\nle contraire […]"
                                            }
                                        ]
                                    }
                                ]
                            },
