{
    "word_family": [
        "доступ",
        "доступать",
        "доступить"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0fe7e961-9d8d-31a8-8e48-dc8a330f9fd8",
                    "sense_definition": "имеющий возможность быть использованным или достигнутым",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "availability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот сайт <w>доступен</w> для всех пользователей интернета.",
                            "target_lang_translations": {
                                "en": "This website is <w>accessible</w> to all internet users."
                            }
                        },
                        {
                            "text": "Вся необходимая информация <w>доступна</w> на официальном портале.",
                            "target_lang_translations": {
                                "en": "All necessary information is <w>available</w> on the official portal."
                            }
                        }
                    ],
                    "synonyms": [
                        "открытый"
                    ],
                    "antonyms": [
                        "закрытый",
                        "недоступный"
                    ],
                    "common_phrases": [
                        "широко доступный"
                    ],
                    "target_lang_definitions": {
                        "en": "Capable of being used, reached, or obtained."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accessible",
                                "target_lang_sense_clarification": "Easy to reach or obtain."
                            },
                            {
                                "target_lang_word": "available",
                                "target_lang_sense_clarification": "Ready for use or purchase."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8568e93a-67fd-399c-8afa-e88bee2e47cc",
                    "sense_definition": "имеющий невысокую цену, которую можно себе позволить",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ищем <w>доступное</w> жилье в центре города.",
                            "target_lang_translations": {
                                "en": "We are looking for <w>affordable</w> housing in the city center."
                            }
                        },
                        {
                            "text": "Эти товары вполне <w>доступны</w> для студентов.",
                            "target_lang_translations": {
                                "en": "These goods are quite <w>affordable</w> for students."
                            }
                        }
                    ],
                    "synonyms": [
                        "дешёвый"
                    ],
                    "antonyms": [
                        "дорогой"
                    ],
                    "common_phrases": [
                        "доступная цена"
                    ],
                    "target_lang_definitions": {
                        "en": "Reasonably priced; within one's financial means."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affordable",
                                "target_lang_sense_clarification": "Inexpensive enough to be bought."
                            },
                            {
                                "target_lang_word": "cheap",
                                "target_lang_sense_clarification": "Low in price."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0101a546-7bb6-32c2-9b4e-bf5f5b7ee2a3",
                    "sense_definition": "легкий для понимания и усвоения",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лектор объяснил сложные вещи в <w>доступной</w> форме.",
                            "target_lang_translations": {
                                "en": "The lecturer explained complex things in a <w>simple</w> way."
                            }
                        },
                        {
                            "text": "Язык этой книги очень <w>доступен</w> для начинающих.",
                            "target_lang_translations": {
                                "en": "The language of this book is very <w>comprehensible</w> for beginners."
                            }
                        }
                    ],
                    "synonyms": [
                        "понятный",
                        "ясный",
                        "простой"
                    ],
                    "antonyms": [
                        "сложный"
                    ],
                    "common_phrases": [
                        "доступный язык"
                    ],
                    "target_lang_definitions": {
                        "en": "Easy to understand or grasp."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simple",
                                "target_lang_sense_clarification": "Easy to understand; not complex."
                            },
                            {
                                "target_lang_word": "comprehensible",
                                "target_lang_sense_clarification": "Able to be understood."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ecc650-4fc8-366a-9f9e-567b3e36a69d",
                    "sense_definition": "открытый в общении, не создающий дистанции",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Несмотря на свою известность, он остается очень <w>доступным</w> человеком.",
                            "target_lang_translations": {
                                "en": "Despite his fame, he remains a very <w>accessible</w> person."
                            }
                        },
                        {
                            "text": "Наш руководитель всегда <w>доступен</w> для обсуждения новых идей.",
                            "target_lang_translations": {
                                "en": "Our manager is always <w>accessible</w> for discussing new ideas."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Approachable and friendly; not creating social distance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accessible",
                                "target_lang_sense_clarification": "Easy to talk to or approach."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}