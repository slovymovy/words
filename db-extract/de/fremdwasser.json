                ],
                "senses": [
                    {
                        "sense_id": "d1b78443-6ce9-3a69-90c5-5e2e82506dde",
                        "entry_id": "11dce5bf-e7a2-3ab6-bdee-baa0179c7df5",
                        "glosses": [
                            "unbelastetes Wasser, welches durch Undichtigkeiten in die Abwasseranlage eindringt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "15c42589-5c17-4d9d-a481-4f64a811658d",
                                "sense_id": "d1b78443-6ce9-3a69-90c5-5e2e82506dde",
                                "text": "„Fremdwasser ist das in Abwasseranlagen abfließende Wasser, welches weder durch häuslichen, gewerblichen, landwirtschaftlichen oder sonstigen Gebrauch in seinen Eigenschaften verändert ist noch bei Niederschlägen von bebauten oder befestigten Flächen gesammelt und bestimmungsgemäß eingeleitet wurde.“"
                            },
                            {
                                "example_id": "34e021bc-c1d0-4cd0-b76b-af773ae689be",
                                "sense_id": "d1b78443-6ce9-3a69-90c5-5e2e82506dde",
                                "text": "„Fremdwasser ist Wasser, das zwar in die Kanalisation gelangt, aber dort eigentlich nicht hingehört - wie etwa durch Undichtigkeiten eindringendes Grundwasser, unerlaubt eingeleitetes Drainagewasser oder Niederschlag, der durch Kanalschachtabdeckungen in einen Schmutzwasserkanal fließt.“"
                            },
                            {
                                "example_id": "eefe6917-1cc3-41a9-93c7-d19d9733469d",
                                "sense_id": "d1b78443-6ce9-3a69-90c5-5e2e82506dde",
                                "text": "„Fremdwasser ist in der Regel sauberes Grundwasser, welches durch defekte Kanäle und Schächte in die Kanalisation gelangt und sich dort mit dem Schmutzwasser vermischt.“"
                            },
                            {
                                "example_id": "d16abb7c-f028-4b4b-93d7-dfa196a7cd5f",
                                "sense_id": "d1b78443-6ce9-3a69-90c5-5e2e82506dde",
                                "text": "„Fremdwasser ist ein zusammenfassender Begriff für alle Wässer, die weder durch häuslichen oder gewerblich-industriellen Gebrauch verunreinigt wurden (Schmutzwasser) noch aus Niederschlägen stammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
