                "senses": [
                    {
                        "sense_id": "0f7201f0-c993-348c-ae1e-1a1dbcf271fd",
                        "entry_id": "cd9fc4ec-7172-3a60-addd-ce4797a45924",
                        "glosses": [
                            "истор. воен. морск. мореходный боевой корабль конца XIX — начала XX века, предназначавшийся для уничтожения кораблей противника торпедами ( «самодвижущимися минами»)"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "519a8981-dc01-4646-b5d7-a193b6371837",
                                "sense_id": "0f7201f0-c993-348c-ae1e-1a1dbcf271fd",
                                "text": "Затем, в случае выступления греки обязывались своими средствами перевезти десант с материальной частью, причём английское адмиралтейство должно было лишь усилить греческий флот двумя линейными кораблями, одним броненосным и тремя лёгкими крейсерами и флотилией миноносцев."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ff0d7e8-c3fa-4c39-bfbc-e5dcaedb606b",
                        "source_entry_id": "cd9fc4ec-7172-3a60-addd-ce4797a45924",
                        "source_sense_id": "0f7201f0-c993-348c-ae1e-1a1dbcf271fd",
                        "target_lang_word": "torpedo boat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torpedo boat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8344a10-3956-311c-a45e-5e3164a3386c",
                                        "entry_id": "751a6234-b623-328f-b50f-ebeafafc8bca",
                                        "glosses": [
                                            "A high-speed marine vessel (small warship or large boat) designed to fire torpedoes, especially in coastal waters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb78d8d1-ab15-426f-863d-ed9b14fc1cd0",
                        "source_entry_id": "cd9fc4ec-7172-3a60-addd-ce4797a45924",
                        "source_sense_id": "0f7201f0-c993-348c-ae1e-1a1dbcf271fd",
                        "target_lang_word": "torpilleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torpilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d56a73-226e-32dc-925a-1ab976445a50",
                                        "entry_id": "fe93feff-61e1-394a-8309-9b651161c6e8",
                                        "glosses": [
                                            "Navire léger et rapide qui a pour mission spéciale de torpiller. Ce type de navire de guerre spécialisé a aujourd'hui disparu."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6e96a20-4f08-4612-b5b4-1361fe03e47e",
                                                "sense_id": "e0d56a73-226e-32dc-925a-1ab976445a50",
                                                "text": "Un des petits torpilleurs qui s’étaient empannés près de la côte, démarra brutalement, piqua vers le large en faisant des zigzags, laissant derrière lui un profond sillage."
                                            },
                                            {
                                                "example_id": "f197bcab-5e18-431d-bf8f-3b1faa646beb",
                                                "sense_id": "e0d56a73-226e-32dc-925a-1ab976445a50",
                                                "text": "Les canons et les fusils, les torpilleurs et les cuirassés, la poudre et la dynamite, la fumée et le massacre emportent des milliards, des sommes plus que suffisantes à nourrir tout ce que l’Europe compte de faméliques et de va-nu-pieds."
                                            },
                                            {
                                                "example_id": "47f1b52a-f83e-45ce-905c-857dad94212d",
                                                "sense_id": "e0d56a73-226e-32dc-925a-1ab976445a50",
                                                "text": "À 4 heures du matin, le vaisseau allemand dépasse le torpilleur français Le Mousquet qui le prend, et pour cause, pour un bâtiment britannique et s’infiltre ainsi dans le port de Penang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb16588c-dfc7-3f07-bfc8-eddcdcd01045",
                                        "entry_id": "fe93feff-61e1-394a-8309-9b651161c6e8",
                                        "glosses": [
                                            "Officier ou marin chargé de la manœuvre des torpilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf525835-431d-4ea6-b1e5-314ae6b33c71",
                                                "sense_id": "cb16588c-dfc7-3f07-bfc8-eddcdcd01045",
                                                "text": "Un officier torpilleur."
                                            },
                                            {
                                                "example_id": "fe06b4a7-3e37-49d3-b4ce-37143d8fc500",
                                                "sense_id": "cb16588c-dfc7-3f07-bfc8-eddcdcd01045",
                                                "text": "Il y suivit les cours d’une école d’électricien avant, finalement, de s’engager dans la marine nationale comme canonnier, quartier-maître puis torpilleur et contre-torpilleur en Indochine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e977bb2-1e45-318e-8e20-4706ba093cd9",
                                        "entry_id": "fe93feff-61e1-394a-8309-9b651161c6e8",
                                        "glosses": [
                                            "Celui qui fait échouer quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ed7f0b-46f0-437a-86ac-5042d3f26883",
                                                "sense_id": "1e977bb2-1e45-318e-8e20-4706ba093cd9",
                                                "text": "C’est un torpilleur de projets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
