                                "target_senses": [
                                    {
                                        "sense_id": "cd018d2c-1586-3d88-a8a3-60b32ea85b71",
                                        "entry_id": "d852ae60-39af-3d5d-879f-48d2f5cb1ea8",
                                        "glosses": [
                                            "A historical region of colonial South America corresponding to present-day Bolivia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d5b7ff-a7ad-4bc4-96bf-f5ea6514b873",
                                                "sense_id": "cd018d2c-1586-3d88-a8a3-60b32ea85b71",
                                                "text": "It was concentrated in two areas—north-central Mexico around Zacatecas and Guanajuato, and the highlands of Upper Peru (modern Bolivia)—though there were significant secondary areas in Honduras and the Peruvian Andes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73a1f734-d4c9-42bf-b0b1-44a3fe168713",
