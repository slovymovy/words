                ],
                "senses": [
                    {
                        "sense_id": "6c181fda-461a-3e61-aa9c-2ac6052f5444",
                        "entry_id": "20fb4e4a-6e95-3187-a090-8b7e9af5403e",
                        "glosses": [
                            "Donner un caractère alimentaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9b3d13-2792-4f0e-8ed0-eb4a26dcdbc0",
                                "sense_id": "6c181fda-461a-3e61-aa9c-2ac6052f5444",
                                "text": "Nous constatons depuis plusieurs mois une prolifération d'émissions de cuisine. Est-ce à dire que nous sommes en train « d'alimentariser » les médias?"
                            },
                            {
                                "example_id": "7cfd8ba0-739c-4b53-ab84-a94a5ecd48b4",
                                "sense_id": "6c181fda-461a-3e61-aa9c-2ac6052f5444",
                                "text": "Je devrais « m’alimentariser » ! Me transformer en pâté, en saucisson, en steak saignant, en charlotte à la crème !"
                            },
                            {
                                "example_id": "26835f70-910d-41a2-9d92-d64380d17322",
                                "sense_id": "6c181fda-461a-3e61-aa9c-2ac6052f5444",
                                "text": "Pacifier et apaiser une opposition gabonaise alimentarisée."
                            }
                        ]
                    },
                    {
                        "sense_id": "b527b5e8-aa85-313f-84e6-69f6726c1ad0",
                        "entry_id": "20fb4e4a-6e95-3187-a090-8b7e9af5403e",
                        "glosses": [
                            "Alimenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee1d6ee-7ced-4a4e-8513-bab319c8e86a",
                                "sense_id": "b527b5e8-aa85-313f-84e6-69f6726c1ad0",
                                "text": "Les décals que vous voyez devant sont prévus pour \"alimentariser\" la citerne."
                            }
                        ]
                    }
