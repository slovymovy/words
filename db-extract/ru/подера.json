                                "example_id": "0498706c-51ea-4c04-9514-d75604838b4a",
                                "sense_id": "43a612b4-f851-3507-afba-6f4d40a46cc3",
                                "text": "Подера параболы — циркулярная кривая 3-го порядка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f8e9c1-4908-48dd-8e81-39dd47ffa243",
