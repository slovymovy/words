                "senses": [
                    {
                        "sense_id": "7aebdd5a-ced7-3824-8c3b-fb0675000f66",
                        "entry_id": "4d9934f0-e872-321c-86be-570cfb6fec33",
                        "glosses": [
                            "in die Hörschnecke eingepflanztes Gerät für Menschen mit geschädigtem Gehör, deren Hörnerv und Hörbahn noch funktioniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1dfde0-a842-4add-8513-bf320c8e28b7",
                                "sense_id": "7aebdd5a-ced7-3824-8c3b-fb0675000f66",
                                "text": "„Das Cochleaimplantat ist eine Hörprothese für (fast) gehörlose Menschen, deren Hörnerv noch intakt ist.“"
                            },
                            {
                                "example_id": "4654a0a6-7d6e-44fe-8a94-6733f622a33e",
                                "sense_id": "7aebdd5a-ced7-3824-8c3b-fb0675000f66",
                                "text": "„Obwohl der 28-Jährige ein Cochleaimplantat trägt – hinter seinem Ohr befindet sich ein Soundprozessor mit Sendespule und unter der Haut das eigentliche Implantat – stellt die seit mehr als einem Jahr herrschende Pandemie für ihn eine große Hürde in der Kommunikation dar.“"
                            },
                            {
                                "example_id": "496b9955-5cdf-4ecc-83b8-fc99ef6319a5",
                                "sense_id": "7aebdd5a-ced7-3824-8c3b-fb0675000f66",
                                "text": "„Hier wird das Cochleaimplantat verwendet, welches durch direkte Elektrostimulation des Hörnervs ein Hören bei starkem Hörverlust oder sogar bei Taubheit ermöglichen kann.“"
                            },
                            {
                                "example_id": "a2d93d74-ff4f-485a-a316-a9af249e7b0c",
                                "sense_id": "7aebdd5a-ced7-3824-8c3b-fb0675000f66",
                                "text": "„Das Cochleaimplantat ist die Grundlage für die Hör-Sprachentwicklung hochgradig hörgeschädigter Kinder und Erwachsener, denen herkömmliche Hörgeräte kein Sprachverstehen (mehr) ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
