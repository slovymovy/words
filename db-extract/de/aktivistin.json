                "senses": [
                    {
                        "sense_id": "631f0836-72d0-34a8-a680-ee19ff8366d8",
                        "entry_id": "b4c8a42f-68c8-3a2c-8394-b5d61973e22c",
                        "glosses": [
                            "Activiste (de genre féminin), militante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0fae0f-5ac6-4dca-b45e-d4fee919232b",
                                "sense_id": "631f0836-72d0-34a8-a680-ee19ff8366d8",
                                "text": "Iranische Sicherheitskräfte haben eine junge Aktivistin laut einem investigativen Bericht bei den Massenprotesten im Jahr 2022 sexuell missbraucht und getötet.",
                                "translation": "Selon un rapport d’investigation, les service de sécurité iraniens ont abusé sexuellement et tué une jeune militante lors des manifestations de masse de 2022."
                            },
                            {
                                "example_id": "edcaba65-3293-4ebc-bfa0-bb370f017106",
                                "sense_id": "631f0836-72d0-34a8-a680-ee19ff8366d8",
                                "text": "Um junge Frauen aus Krisenregionen zu Wort kommen zu lassen, brachte Plan International im November vier junge Aktivistinnen aus der Ukraine, Mali, Haiti sowie eine junge Frau mit iranischen Wurzeln zusammen.",
                                "translation": "Pour donner la parole à de jeunes femmes de régions en crise, Plan International a réuni en novembre quatre jeunes militantes d’Ukraine, du Mali, d’Haïti ainsi qu’une jeune femme d’origine iranienne."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
