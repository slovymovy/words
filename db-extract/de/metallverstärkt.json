                "senses": [
                    {
                        "sense_id": "e1731a76-647f-383e-bccd-7b24728e265d",
                        "entry_id": "7f9c6a61-a386-34f6-8b71-dba2b00a13a2",
                        "glosses": [
                            "mit Metall verstärkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f3b5f7-8a5b-4ae2-a426-f032dea65f0b",
                                "sense_id": "e1731a76-647f-383e-bccd-7b24728e265d",
                                "text": "„Ich holte einen metallverstärkten Tiefseetaucheranzug hervor und experimentierte mit der tragbaren Lampe und dem Luftregenerator.“"
                            },
                            {
                                "example_id": "86f24cc0-aa70-4fcc-81e6-1e71126e853d",
                                "sense_id": "e1731a76-647f-383e-bccd-7b24728e265d",
                                "text": "„Die Streifen zu Fuß trugen metallverstärkte Schlagstöcke; in den Einsatzräumen wurden große .45er Automatiks mit verbotenen Dum-Dum-Geschossen geladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
