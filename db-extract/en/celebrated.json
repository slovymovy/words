                    {
                        "translation_id": "d3f346fb-85db-4808-9914-c57f92cff804",
                        "source_entry_id": "d1a0da4e-6d11-3d4b-8945-bdb6b71032e4",
                        "source_sense_id": "4052d029-0577-3683-9c8a-75b15e5dbea4",
