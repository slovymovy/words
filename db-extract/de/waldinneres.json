                "senses": [
                    {
                        "sense_id": "6bfe285d-9eab-3d20-96cc-40dfe719c967",
                        "entry_id": "f1601f57-517f-3613-bcfc-aa68b2f6210f",
                        "glosses": [
                            "Bereich inmitten des Waldes mit einigem Abstand zum Waldrand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b972f99-216e-4b51-9a77-947577fc015f",
                                "sense_id": "6bfe285d-9eab-3d20-96cc-40dfe719c967",
                                "text": "Während man ins Waldinnere vordringt, verstummt der Lärm der Zivilisation mehr und mehr."
                            },
                            {
                                "example_id": "02b78964-389d-4e5e-a90f-3b7e1e8e9f90",
                                "sense_id": "6bfe285d-9eab-3d20-96cc-40dfe719c967",
                                "text": "„Weil der Waldkauz mit knapp einem Meter Flügelspannweite ein natürlicher Feind des nur amselgroßen Raufußkauzes ist, werden die Kästen für den Kleineren im Waldinneren und die für den Waldkauz eher am Waldrand angebracht.“"
                            },
                            {
                                "example_id": "67e538ef-f2e7-487b-a3ac-49d9a3122375",
                                "sense_id": "6bfe285d-9eab-3d20-96cc-40dfe719c967",
                                "text": "„Doch im Vergleich mit den im Grunde konservativen Kronbergern fühlt man sich angesichts des frühlingshaften Leuchtens etwa eines Waldinneren, fühlt sich der Betrachter angesichts von Pinselführung und Palette der vier zwischen 1927 und 1929 entstandenen Gemälde fast wie an der frischen, von den Hängen des Taunus herüberwehenden Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
