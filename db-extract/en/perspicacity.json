    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                "word": "perspicacity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e058ccb5-12d4-43c8-9283-ec9f449a21f9",
                        "entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "perspicacities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b071de92-ffad-38af-ba3a-d6673bdce050",
                        "entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "glosses": [
                            "Acute discernment or understanding; insight."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f7417b32-0774-4cbf-a448-7c51b32ea649",
                                "sense_id": "b071de92-ffad-38af-ba3a-d6673bdce050",
                                "text": "\"I understand,\" I said. \"The fact is that you have the money.\" His face brightened. He seemed pleased at my perspicacity."
                            },
                            {
                                "example_id": "3cbded33-bd4e-4cb0-9845-125a86cc8e35",
                                "sense_id": "b071de92-ffad-38af-ba3a-d6673bdce050",
                                "text": "The citizens chose a university. They reasoned, with considerable perspicacity, that taxes come and go in response to political considerations, but a university, once established, is a permanent benefit to a city and a nation."
                            },
                            {
                                "example_id": "8eba190f-7c1c-43ee-a60f-73cc3ee67c45",
                                "sense_id": "b071de92-ffad-38af-ba3a-d6673bdce050",
                                "text": "McEwan certainly has a flair for unusual points of view. Adam, like the baby-in-waiting who narrates Nutshell, is an extraordinarily smart, well-informed, and unorthodox character who catches his supposed caretakers off-guard with his perspicacity."
                            }
                        ]
                    },
                    {
                        "sense_id": "db027930-3817-3e99-88fd-a3df1f7dd9d4",
                        "entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "glosses": [
                            "The human faculty or power to mentally grasp or understand clearly."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f5d8c9ee-27e0-42a6-bdb2-e4ad48143c1a",
                                "sense_id": "db027930-3817-3e99-88fd-a3df1f7dd9d4",
                                "text": "His very veneration for his father-in-law, combined as it is with a total want of the most ordinary perspicacity, is an additional disqualification."
                            },
                            {
                                "example_id": "6807ac3b-2900-479b-9b40-14f4c6324cd8",
                                "sense_id": "db027930-3817-3e99-88fd-a3df1f7dd9d4",
                                "text": "As the former consists in the transmission of psychic states inappreciable to the normal perspicacity or senses, the transfer cannot pass through the medium of intelligence."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bff38cf-2266-3c86-947a-1faaec17263e",
                        "entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "glosses": [
                            "Keen eyesight."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "03b9c08b-e446-4e17-a3a1-92690751adae",
                                "sense_id": "9bff38cf-2266-3c86-947a-1faaec17263e",
                                "text": "Attentive consideration of the phenomena of vision has led to the invention of artificial aids by which the sight may be wonderfully strengthened and preserved, and man endowed at once with the perspicacity of the eagle or the minute scrutiny of the insect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e422d083-50ca-48d7-a601-fa4453239473",
                        "source_entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "source_sense_description": "Acute discernment or understanding; insight",
                        "target_lang_word": "verloop",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verloop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa15882-c1cf-3fcf-8e2c-e0708a6f453a",
                                        "entry_id": "b78bdcf3-a8b2-31e4-86a6-5791bb1dbfaa",
                                        "glosses": [
                                            "het weggaan van werknemers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a962b0-8bc4-442b-ae03-8cc7b34a105b",
                                                "sense_id": "1fa15882-c1cf-3fcf-8e2c-e0708a6f453a",
                                                "text": "Bij sommige bedrijven is het verloop erg hoog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff8037a-8cde-3fa5-9b0a-13d7b83503e5",
                                        "entry_id": "b78bdcf3-a8b2-31e4-86a6-5791bb1dbfaa",
                                        "glosses": [
                                            "overgang tussen twee delen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73eac4e-c3a2-4656-917c-48732540ad54",
                                                "sense_id": "cff8037a-8cde-3fa5-9b0a-13d7b83503e5",
                                                "text": "Zonder verloop kunnen die twee slangen niet op elkaar aangesloten worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870aa71d-39fc-3eb9-99b9-27c934d77203",
                                        "entry_id": "b78bdcf3-a8b2-31e4-86a6-5791bb1dbfaa",
                                        "glosses": [
                                            "de manier waarop een proces zich voltrekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71768520-dc12-44e0-be4a-8512af7469ae",
                                                "sense_id": "870aa71d-39fc-3eb9-99b9-27c934d77203",
                                                "text": "Het verloop van de onderhandelingen was erg stroef."
                                            },
                                            {
                                                "example_id": "fc6de1e9-2e76-468f-b871-bad732b47945",
                                                "sense_id": "870aa71d-39fc-3eb9-99b9-27c934d77203",
                                                "text": "Petito was sinds afgelopen juni met haar verloofde Brian Laundrie bezig aan een rondreis door de VS. Omdat het haar ambitie was reisschrijver te worden, beschreef ze het verloop van de trip via sociale media. In oktober zouden ze hun reis van de oostkust naar het westen in de staat Oregon afronden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verloop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a63cc6-f644-3274-a597-32e9e9badb37",
                                        "entry_id": "02f0f0d0-1457-307e-82ce-a0a273a79ec3",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van verlopen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe6a1be-d74e-4bb4-9028-b85e46024971",
                                                "sense_id": "f6a63cc6-f644-3274-a597-32e9e9badb37",
                                                "text": "Ik verloop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89484039-a1c6-309b-af8d-b81dee640b60",
                                        "entry_id": "02f0f0d0-1457-307e-82ce-a0a273a79ec3",
                                        "glosses": [
                                            "gebiedende wijs van verlopen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e4ce41-06fd-4851-8cd2-3b5ec2d66df8",
                                                "sense_id": "89484039-a1c6-309b-af8d-b81dee640b60",
                                                "text": "Verloop!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                        "entry_id": "02f0f0d0-1457-307e-82ce-a0a273a79ec3",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van verlopen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949a8fac-8c88-4234-bf10-8ed1fbb7f1f6",
                                                "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                                "text": "Verloop je?"
                                            },
                                            {
                                                "example_id": "d032f811-dd6a-464a-b7cb-94bceb05cea6",
                                                "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                                "text": "Mijn gehele base weight kreeg ik na verloop van tijd onder de 8 kilo."
                                            },
                                            {
                                                "example_id": "e11ebf26-533c-4aa2-b5eb-d979e352345e",
                                                "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                                "text": "Gevoed door mannelijke competitiedrang - werden na verloop van tijd de gerechten exquiser en de wijnen beter, en ook op het gebied van keukenapparatuur' en kookspullen begonnen we met elkaar te wedijveren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a312ab79-68b3-4c95-94c2-f561bccdccf2",
                        "source_entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "source_sense_description": "Acute discernment or understanding; insight",
                        "target_lang_word": "perspicacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perspicacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10df89fa-3452-3590-9f2e-ba885355fc75",
                                        "entry_id": "28ee9dbc-ad99-34e5-be65-dddae128d88a",
                                        "glosses": [
                                            "Pénétration d’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3fbe71-f4c4-492e-a668-84081af3bc36",
                                                "sense_id": "10df89fa-3452-3590-9f2e-ba885355fc75",
                                                "text": "On comptait sans un incident, que certainement aucune perspicacité humaine ne pouvait prévoir."
                                            },
                                            {
                                                "example_id": "cdcc1761-b738-4135-b4e3-2bf8fd328e23",
                                                "sense_id": "10df89fa-3452-3590-9f2e-ba885355fc75",
                                                "text": "J’ai rendu hommage à votre perspicacité tout à l’heure et je reconnais encore que vous avez fort bien pronostiqué en nous annonçant que le capitaine Brocq avait une maîtresse."
                                            },
                                            {
                                                "example_id": "7817b7b8-9a2b-4807-9dda-aeb566a54fbf",
                                                "sense_id": "10df89fa-3452-3590-9f2e-ba885355fc75",
                                                "text": "Lorsqu’elle établit le diagnostic d’hypertension artérielle pulmonaire chez une de ses patientes obèses dont l’anamnèse révèle qu'elle est traitée par le Médiator, son expérience et sa perspicacité l’amène à faire des rapprochements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c548cfdf-2958-4147-b8b0-527da4923c05",
                        "source_entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
