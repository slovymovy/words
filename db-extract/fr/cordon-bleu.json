                            {
                                "example_id": "3fe90131-1d60-4896-99e4-c7205633763a",
                                "sense_id": "494a8e6b-5157-33c8-ab4a-c5541a92388a",
                                "text": "S’il dispose de buissons pour cacher son nid et d’une nourriture bien équilibrée et riche en insectes variés, le cordon-bleu se reproduit assez volontiers en volière."
                            },
                            {
                                "example_id": "8b627bc2-8ac1-4b15-9ff4-8590d4579603",
                                "sense_id": "494a8e6b-5157-33c8-ab4a-c5541a92388a",
                                "text": "On connaît 5 espèces de Cordonbleus, parmi lesquelles se trouvent trois \"petites\" espèces à dominante bleue, traditionnellement dénommées \"Cordons-bleus\", et deux \"grandes\" espèces très colorées, connues jadis sous le nom de \"Grenadins\"."
                            }
                        ]
                    }
