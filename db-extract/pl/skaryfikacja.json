                        "entry_id": "79375fec-b439-3843-a663-ab4b34cde73a",
                        "glosses": [
                            "sztuka zdobienia ciała polegająca na nacinaniu, zadrapywaniu lub wypalaniu skóry tak, by w danym miejscu utworzyła się tkanka bliznowata"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0399b5b6-a236-4fa0-b9e1-0686abd92e45",
                                "sense_id": "f58174ea-f066-39e8-bc83-3380ae9f6382",
                                "text": "W grupach plemiennych zmiana statusu społecznego, wieku czy roli bardzo często była zaznaczana przez okaleczanie ciała, skaryfikację, poddawanie się próbom fizycznej wytrzymałości […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
