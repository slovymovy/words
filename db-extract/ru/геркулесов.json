                ],
                "senses": [
                    {
                        "sense_id": "06dcf9d6-2101-3706-a8f5-bec13e398947",
                        "entry_id": "ddbfa7b0-8ead-3aca-8312-e98fc8d929ce",
                        "glosses": [
                            "Herculean"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22e435b-f133-4f15-89da-8e987dec31ed",
                                "sense_id": "06dcf9d6-2101-3706-a8f5-bec13e398947",
                                "text": "геркуле́сов по́двиг",
                                "translation": "Herculean feat",
                                "english": "Herculean feat"
                            },
                            {
                                "example_id": "74a6e17b-c008-44c9-8ec3-1350a22f8c90",
                                "sense_id": "06dcf9d6-2101-3706-a8f5-bec13e398947",
                                "text": "геркуле́сова си́ла",
                                "translation": "Herculean might, Herculean strength",
                                "english": "Herculean might, Herculean strength"
                            },
                            {
                                "example_id": "cb6837e3-6f5e-4f05-8776-bb6311df2131",
                                "sense_id": "06dcf9d6-2101-3706-a8f5-bec13e398947",
                                "text": "геркуле́сово уси́лие",
                                "translation": "Herculean effort",
                                "english": "Herculean effort"
                            },
                            {
                                "example_id": "0cf2f55e-2e5c-4859-829e-b4f49d789758",
                                "sense_id": "06dcf9d6-2101-3706-a8f5-bec13e398947",
                                "text": "Э́то был лихо́й офице́р, облада́вший буква́льно геркулесовой си́лой, всегда́ весёлый, по ви́ду беспе́чный; с ним бы́ло прия́тно проводи́ть вре́мя, и все охо́тно шли к нему́.",
                                "translation": "He was a dashing officer, a man of literally Herculean strength, always joyful, and seemingly carefree; it was pleasant to spend time in his company, and everyone gladly visited him.",
                                "english": "He was a dashing officer, a man of literally Herculean strength, always joyful, and seemingly carefree; it was pleasant to spend time in his company, and everyone gladly visited him."
                            },
                            {
                                "example_id": "2609302b-f318-4068-8776-4ee7c996a80c",
                                "sense_id": "06dcf9d6-2101-3706-a8f5-bec13e398947",
                                "text": "Комната гостиницы на улице Фавр доверху наполнялась стопами исписанной бумаги и книжными тюками, зачастую приносимыми на геркуле́совом плече́ самого́ Бе́йля.",
                                "translation": "The hotel room on Rue Favre was filled to the ceiling with heaps of manuscripts and bundles of books, often borne on Beyle's own Herculean shoulder.",
                                "english": "The hotel room on Rue Favre was filled to the ceiling with heaps of manuscripts and bundles of books, often borne on Beyle's own Herculean shoulder."
                            }
                        ]
                    }
                ],
