                        "entry_id": "6ea9452c-df9d-357b-ad11-6417e7896076",
                        "glosses": [
                            "geroosterd brood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a91d56-dbf0-4399-8265-4465462a4861",
                                "sense_id": "dd7af3b6-aea9-3e7d-8663-c2bb1ec1ff13",
                                "text": "Rooster de boterhammen. Besmeer de toast met mosterdmayonaise, leg er plakken tomaat op en op elk stuk toast 2 ansjovisfilets."
                            },
                            {
                                "example_id": "59a38d62-7139-4205-aec6-e7f3192c37ce",
                                "sense_id": "dd7af3b6-aea9-3e7d-8663-c2bb1ec1ff13",
                                "text": "Hooguit wijk je dan in het weekeinde eens uit naar een croissantje of naar roereieren op toast."
                            },
                            {
                                "example_id": "eed12fe1-55ed-4bea-83e3-0c3034c5a853",
                                "sense_id": "dd7af3b6-aea9-3e7d-8663-c2bb1ec1ff13",
                                "text": "Misschien niet bij het ontbijt maar als de toast bij de lunch verschijnt een toost uitbrengen met een niet al te kostbare champagne, een gastroveelzijdige brut-editie."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5ec2fa3-f25b-39b4-a070-67b8ec7b4c5f",
                        "entry_id": "6ea9452c-df9d-357b-ad11-6417e7896076",
                        "glosses": [
                            "geroosterd sneetje van het bij [1] genoemde brood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b22a34-6b43-4d4c-8aba-3cc1294da96e",
                                "sense_id": "a5ec2fa3-f25b-39b4-a070-67b8ec7b4c5f",
                                "text": "Ik heb ooit tijdens een ontbijt eens een beschimmelde toast gekregen én een vervallen potje yoghurt."
                            }
                        ]
                    },
                    {
                        "sense_id": "d49af969-9793-3a37-8dd2-9918ad7c0800",
                        "entry_id": "6ea9452c-df9d-357b-ad11-6417e7896076",
                        "glosses": [
                            "verouderde spelling of vorm van toost in de betekenis \\\"heildronk\\\" tot 2006"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3f33fa4c-0813-458f-a52e-e2776e278bf3",
                                "sense_id": "d49af969-9793-3a37-8dd2-9918ad7c0800",
                                "text": "Haar butler James neemt hun plaatsen in, en ledigt ook hun glazen bij elke toast die ze op haar uitbrengen."
                            }
                        ]
                    }
