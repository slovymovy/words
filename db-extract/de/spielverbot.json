                ],
                "senses": [
                    {
                        "sense_id": "d92a41b3-cb44-3e7b-9fda-1b91c2ebafa4",
                        "entry_id": "b9a4d7e2-2e06-30c0-849e-4d1af2c74d88",
                        "glosses": [
                            "Untersagen von Spielen durch Schilder oder Vorschriften beziehungsweise Sperre eines Spielers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b1ec0a3-c8a2-4fc1-8b42-6f2d231bf295",
                                "sense_id": "d92a41b3-cb44-3e7b-9fda-1b91c2ebafa4",
                                "text": "„Nur ausnahmsweise wird von den Herrschern klipp und klar der wahre Grund der von ihnen verfügten Spielverbote eingestanden.“"
                            },
                            {
                                "example_id": "b43eb232-64b7-4f95-8871-d0d62ec892e5",
                                "sense_id": "d92a41b3-cb44-3e7b-9fda-1b91c2ebafa4",
                                "text": "„Die zahlreichen Spielverbote verändern und reduzieren das Spielverhalten.“"
                            },
                            {
                                "example_id": "d5c58e23-7970-41e8-8c8b-e7ba1181cff5",
                                "sense_id": "d92a41b3-cb44-3e7b-9fda-1b91c2ebafa4",
                                "text": "„Das Moralkomitee des iranischen Fußballverbands habe ein sechsmonatiges Spielverbot für Soscha Makani verhängt, nachdem es sein Verhalten überprüft habe, meldete die Nachrichtenagentur Isna am Mittwoch.“"
                            },
                            {
                                "example_id": "16be8be9-a697-44a6-9f81-3893245cb63b",
                                "sense_id": "d92a41b3-cb44-3e7b-9fda-1b91c2ebafa4",
                                "text": "„In seinem Urteil befand das Oberlandesgericht, aus dem Glücksspielstaatsvertrag lasse sich im vorliegenden Fall kein sofortiges Spielverbot ableiten.“"
                            },
                            {
                                "example_id": "11731158-369d-4cf2-b87d-3db186527a90",
                                "sense_id": "d92a41b3-cb44-3e7b-9fda-1b91c2ebafa4",
                                "text": "„Erledigt durch ein Spielverbot für die inhaftierten Mitglieder der vor rund anderthalb Jahren entstandenen Theatergruppe der offenen Justizvollzugsanstalt Meisenhof in Castrop-Rauxel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
