                                "target_lang_sense_clarification": "für dünne Fasern oder Lebensmittel"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tel",
                                "target_lang_sense_clarification": "saç veya ince lif"
                            },
                            {
                                "target_lang_word": "tutam",
                                "target_lang_sense_clarification": "saç için"
