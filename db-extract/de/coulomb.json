                                        "glosses": [
                                            "In the International System of Units, the derived unit of electric charge; the amount of electric charge carried by a current of 1 ampere flowing for 1 second. Symbol: C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019fe5ae-9abe-446b-9fac-98ef2f43a7c5",
                                                "sense_id": "96d0a513-29f0-3a83-aa9b-7fd5f11fc6c3",
                                                "text": "He is charged up with enough coulombs to make his hair stand on end."
                                            }
                                        ]
