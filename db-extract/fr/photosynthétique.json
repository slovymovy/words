                "senses": [
                    {
                        "sense_id": "f7a00180-cb17-32cf-ad82-0a14eabc82b5",
                        "entry_id": "cd18c259-9e1a-340b-a7c6-8a9381e2b627",
                        "glosses": [
                            "Relatif à la photosynthèse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fda1ea6d-9192-41cc-9c13-67a892b567f3",
                                "sense_id": "f7a00180-cb17-32cf-ad82-0a14eabc82b5",
                                "text": "Une réduction de l'activité photosynthétique est la conséquence d'un déficit de quasiment chacun des éléments essentiels, cependant le potentiel photosynthétique est particulièrement sensible aux apports d'azote."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca608688-dc30-30ab-9417-cd6e8684a5e1",
                        "entry_id": "cd18c259-9e1a-340b-a7c6-8a9381e2b627",
                        "glosses": [
                            "Qualifie un organisme qui est capable d’effectuer la photosynthèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a69279aa-f3cb-404a-86d2-f7aeb7623335",
                                "sense_id": "ca608688-dc30-30ab-9417-cd6e8684a5e1",
                                "text": "Des résultats qui laissent supposer que les algues unicellulaires et les trypanosomes auraient divergé à partir d’un ancêtre commun photosynthétique."
                            },
                            {
                                "example_id": "f1f647b1-cf35-4d38-89f7-f533bbd1bbe9",
                                "sense_id": "ca608688-dc30-30ab-9417-cd6e8684a5e1",
                                "text": "Une symbiose tripartite remplace la symbiose à deux partenaires. Le mycélium du champignon se développe entre une plante photosynthétique et une plante parasite qui ne l'est pas."
                            }
                        ]
                    }
