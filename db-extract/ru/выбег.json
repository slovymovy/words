                                ]
                            },
                            {
                                "target_word": "coasting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29b54eae-6368-34ff-a752-90fc18ba5769",
                                        "entry_id": "f9c4d029-c6d8-320d-9e99-d029698372d6",
                                        "glosses": [
                                            "The act of sailing along a coast, or from port to port."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9bb53d8-51ba-4606-bb10-98b5c8d6c465",
                                                "sense_id": "29b54eae-6368-34ff-a752-90fc18ba5769",
                                                "text": "Glory be to God, all sublunary coastings will soon be over. Yet a little while, and we shall get into an eternal harbour."
                                            },
                                            {
                                                "example_id": "15e219b4-9daf-4482-b470-0edc4e24eba6",
                                                "sense_id": "29b54eae-6368-34ff-a752-90fc18ba5769",
                                                "text": "She had been lying quietly in the harbour and making little coasting trips ever since we arrived in her twelve months before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ca8560-caf6-3a1e-839e-05223baaabea",
                                        "entry_id": "f9c4d029-c6d8-320d-9e99-d029698372d6",
                                        "glosses": [
                                            "The act of disengaging the gears of a moving vehicle and rolling along without the use of engine power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8acc229-7e43-4a9d-ba60-97a1d0cc8e66",
                                                "sense_id": "36ca8560-caf6-3a1e-839e-05223baaabea",
                                                "text": "Avanti West Coast has introduced the use of coasting with its Pendolino fleet, in an effort to keep disruption during overhead line equipment failures to a minimum. [...] The Class 390s coasted for three miles without power between Harrow & Wealdstone and Wembley Central, running under damaged OLE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37a4919-a666-355f-96ff-098cb32ff188",
                                        "entry_id": "f9c4d029-c6d8-320d-9e99-d029698372d6",
                                        "glosses": [
                                            "A progression of symptoms after treatment, before gradual improvement begins."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
