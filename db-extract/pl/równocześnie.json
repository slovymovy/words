                                        "entry_id": "0a6e28e8-b900-3cef-b8c8-fb807c2c516e",
                                        "glosses": [
                                            "A un tiempo, simultáneamente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34697e37-e46c-4d20-a7cf-6712491aa9c5",
                                                "sense_id": "abc1a611-68f9-3d97-8994-48192215d48d",
                                                "text": "El anarquismo es la filosofía política, a la vez que un repertorio de prácticas, que proponen una sociedad basada en el apoyo mutuo, la libertad y la igualdad económica."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
