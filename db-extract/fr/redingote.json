                                "target_senses": [
                                    {
                                        "sense_id": "9f896afd-fae1-35bd-937e-ddd9cb502b67",
                                        "entry_id": "2865e17c-c208-3031-a937-b7c37fa33515",
                                        "glosses": [
                                            "ruim vallende geklede herenjas die tot de knieën reikt, met brede schouders en smalle taille, zoals die in de 18e eeuw in de mode kwam en dat tot de tweede helft van de 19e eeuw bleef"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aea4128-cd5d-4276-99a8-29d06890bf39",
                                                "sense_id": "9f896afd-fae1-35bd-937e-ddd9cb502b67",
                                                "text": "De oude burger draagt een jas zonder opsmuksels, aan de lengte en de hoge split te zien een redingote, een kledingstuk dat heel kenmerkend voor de democratiserende tendens in de mode die de burgerij vanaf de jaren 1780 ging volgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37ea0eb9-1348-3dfb-8a0e-503154e0b1ad",
                                        "entry_id": "2865e17c-c208-3031-a937-b7c37fa33515",
                                        "glosses": [
                                            "jurk met een model dat aan de gelijknamige herenjas doet denken"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa4d99e-2654-4ae1-b09f-d67fecf8ed2e",
                                                "sense_id": "37ea0eb9-1348-3dfb-8a0e-503154e0b1ad",
                                                "text": "⧖ Op dit oogenblik is de strooming ten gunste der zijde al zeer sterk; redingote, panneaux en empire-model, die groote gladde oppervlakten aanbieden, vereischen fraaie stoffen, en de fabrieken te Lyon, aan de eischen van den tijd tegemoet komende, leveren prachtiger, — maar ook kostbaarder — werk, dan zij misschien ooit geleverd hebben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebba006d-6734-3ad4-ae4c-c3dd890c7152",
                                        "entry_id": "2865e17c-c208-3031-a937-b7c37fa33515",
                                        "glosses": [
                                            "damesmantel met een model dat aan de gelijknamige herenjas doet denken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8854ae9e-9f06-4c8c-91f1-824d25890fcc",
                                                "sense_id": "ebba006d-6734-3ad4-ae4c-c3dd890c7152",
                                                "text": "Een armelijk geklede man, waarschijnlijk de echtgenoot van de zittende vrouw, houdt zijn hand op voor een paar duiten die een in modieuze redingote geklede vrouw aan hem wil geven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06f7fdc8-10e2-4d73-92ec-1aceb08c352d",
                        "source_entry_id": "e5d1be73-62ab-3d43-b092-9ff91cb9d7db",
                        "target_lang_word": "wambuis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wambuis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "48789ed1-5e5e-391e-aa99-521c40067c5f",
                                        "entry_id": "1a233363-2092-3d82-9ded-40cba9229869",
                                        "glosses": [
                                            "vooral in vroeger tijden veel gedragen gewatteerd vest, vaak gemaakt van lagen linnen, in banen gestikt, met een opvulling van wol, katoen en haren, dat het lichaam van de hals tot op het middel bedekt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87590a7-0b1a-4168-94ff-2c790eb10afc",
                                                "sense_id": "48789ed1-5e5e-391e-aa99-521c40067c5f",
                                                "text": "Het hek zwaaide ineens open, en er verschenen een man en een jongen. Omdat ik onderweg helemaal niemand was tegengekomen, was ik blij mensen te zien. Ze droegen allebei eenvoudige wambuizen en hadden een pet op waardoor hun gezichten grotendeels bedekt werden, en de jongen had een kleine zeis achter zijn riem gestoken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53a9865-119b-4ff2-bf98-7934a6eb867a",
                        "source_entry_id": "e5d1be73-62ab-3d43-b092-9ff91cb9d7db",
                        "target_lang_word": "surdut",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surdut",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee8ac81-7de5-3437-bf70-e9dbdf0d20d0",
                                        "entry_id": "ce3861a3-db2f-3fb7-a043-6e93a0ffc8fa",
                                        "glosses": [
                                            "wizytowy ubiór męski z ciemnego materiału; długa, dwurzędowa marynarka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb8f5cf-9e16-4841-a4c7-ae425abe3263",
                                                "sense_id": "6ee8ac81-7de5-3437-bf70-e9dbdf0d20d0",
                                                "text": "Na próżno kapela wygrywała skoczne dryganty, sztajery i menuety, liberia, w białych kosmatych surdutach, niestrudzenie roznosiła słodkie muszkatele i alikanty, a czarujące gospodynie usiłowały ożywić gnuśną zabawę - nuda nie dała się rozproszyć."
                                            }
                                        ],
