                ],
                "senses": [
                    {
                        "sense_id": "c953ba3e-eb82-3abd-b790-15b65f0dbd4b",
                        "entry_id": "691274b1-d227-3b62-a9e0-0aa1c70ca71a",
                        "glosses": [
                            "jemand, der etwas nur aus der Distanz, von einer Abgrenzung her, aus einer Deckung heraus beobachtet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "252168b4-c53d-458e-b958-f624f6d1cf5b",
                                "sense_id": "c953ba3e-eb82-3abd-b790-15b65f0dbd4b",
                                "text": "„Während meiner Schulzeit fühlte ich mich oft wie ein Zaungast.“"
                            },
                            {
                                "example_id": "f23a70f8-9843-407d-8f67-398baf17ad8c",
                                "sense_id": "c953ba3e-eb82-3abd-b790-15b65f0dbd4b",
                                "text": "„Na, als Zaungast würde es schon gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f64940dd-3b60-433d-b4ed-61d78ab1201c",
                        "source_entry_id": "691274b1-d227-3b62-a9e0-0aa1c70ca71a",
                        "source_sense_id": "c953ba3e-eb82-3abd-b790-15b65f0dbd4b",
                        "source_sense_description": "jemand, der etwas nur aus der Distanz beobachtet",
                        "target_lang_word": "onlooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onlooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                        "entry_id": "c467616c-7b61-32cd-8da6-7d4a258a313b",
                                        "glosses": [
                                            "A spectator; someone looks on or watches, without becoming involved or participating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d641ad28-474d-44bd-a50c-f4c18285e8ad",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "I wasn’t involved in the fight; I was only an onlooker."
                                            },
                                            {
                                                "example_id": "e366a5ae-69d3-426e-93ff-51acaa5196e0",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "When the right-away was given, Driver Gibson would give a sonorous blast on Cardean's deep-toned hooter, and amid a flurry of swirling steam the train would move majestically out, with nearly half the city of Carlisle—or so it would appear—as onlookers on the platform."
                                            },
                                            {
                                                "example_id": "75a66cc0-3ee5-4b94-af99-b161fc96b076",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "As a result, while the train was being shunted at Bombay, the buffers became locked, producing a situation most intriguing for the onlookers, but exasperating for the exalted passengers and the unhappy railway authorities."
                                            },
                                            {
                                                "example_id": "2c382c57-be74-4bb2-b66e-57af6757c974",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "Please allow me to adjust my pants\nSo that I may dance the good time dance\nAnd put the onlookers and innocent bystanders into a trance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87c99013-e537-4636-974b-078064be327c",
                        "source_entry_id": "691274b1-d227-3b62-a9e0-0aa1c70ca71a",
                        "source_sense_id": "c953ba3e-eb82-3abd-b790-15b65f0dbd4b",
                        "source_sense_description": "jemand, der etwas nur aus der Distanz beobachtet",
                        "target_lang_word": "spectator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                        "entry_id": "e5cfde1e-618c-3cd1-af5c-7248bd8a941a",
                                        "glosses": [
                                            "One who watches an event; especially, an event held outdoors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f280f02-d3c9-42b8-84bd-1b8e20d45fe6",
                                                "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                                "text": "The cheering spectators watched the fireworks."
                                            },
                                            {
                                                "example_id": "5afc0e61-20f3-4c3c-a38e-738a23592965",
                                                "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                                "text": "Bart spies an opportunity to make a quick buck so he channels his inner carny and posits his sinking house as a natural wonder of the world and its inhabitants as freaks, barking to dazzled spectators, “Behold the horrors of the Slanty Shanty! See the twisted creatures that dwell within! Meet Cue-Ball, the man with no hair!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8068c67a-9cfd-38d8-aa8d-f521a4239ee7",
                                        "entry_id": "e5cfde1e-618c-3cd1-af5c-7248bd8a941a",
                                        "glosses": [
                                            "One who observes, sees, or views something; an observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d82f65-6963-4698-bd82-9187a40da04f",
                                                "sense_id": "8068c67a-9cfd-38d8-aa8d-f521a4239ee7",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2cfb00e-5f67-4008-bf4e-4fe1b33c6930",
                        "source_entry_id": "691274b1-d227-3b62-a9e0-0aa1c70ca71a",
                        "source_sense_id": "c953ba3e-eb82-3abd-b790-15b65f0dbd4b",
                        "source_sense_description": "jemand, der etwas nur aus der Distanz beobachtet",
                        "target_lang_word": "badaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "badaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f89c513e-9c96-3336-a07d-818c33b84fb1",
                                        "entry_id": "154e65a3-a54a-30d1-b46a-d34ec54de444",
                                        "glosses": [
                                            "Niais qui admire tout, s’amuse à tout, qui est d’une curiosité frivole.  ^([1])"
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c986e944-5da4-4882-b793-66ce61c74a83",
                                                "sense_id": "f89c513e-9c96-3336-a07d-818c33b84fb1",
                                                "text": "Par ces temps de pantagruélisme, où le succès, chez nous, est aux bateleurs, où la gloire est aux clowns, où le trapèze de Léotard fait merveille, où Blondin triomphe sur la corde roide, les badauds des deux mondes trouveraient peut-être encore des émotions neuves au spectacle des exercices de force et d’adresse des Cingalais."
                                            },
                                            {
                                                "example_id": "4cd6f919-51d7-489f-80e0-038537abe30d",
                                                "sense_id": "f89c513e-9c96-3336-a07d-818c33b84fb1",
                                                "text": "— Autour d’elle l’air est tout jeune et sent bon, comme le vent qui frivole dans les pommiers fleuris.\n— Eh badaud ! C’est qu’elle se met de l’eau de Cologne !"
                                            },
                                            {
                                                "example_id": "122f9f16-1696-445b-abb6-bf8a57776436",
                                                "sense_id": "f89c513e-9c96-3336-a07d-818c33b84fb1",
                                                "text": "Un des derniers se vantait d’être,\nEn éloquence si grand maître,\nQu’il rendrait disert un badaud,\nUn manant, un rustre, un lourdaud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0386bc83-4a82-3d93-a052-435caac6f1ac",
                                        "entry_id": "154e65a3-a54a-30d1-b46a-d34ec54de444",
                                        "glosses": [
                                            "Flâneur qui passe le temps en regardant tout ce qui lui semble extraordinaire ou nouveau. ^([2])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6558dc-b495-47dd-bba0-e7171367caea",
                                                "sense_id": "0386bc83-4a82-3d93-a052-435caac6f1ac",
                                                "text": "Tous les Parisiens sont des badauds quoique sur dix habitants de Paris il y ait neuf provinciaux."
                                            },
                                            {
                                                "example_id": "e8a7ac48-daec-4fff-810a-72e719a60247",
                                                "sense_id": "0386bc83-4a82-3d93-a052-435caac6f1ac",
                                                "text": "On arriva sur une petite place circulaire, où étaient dressées quelques boutiques, un bal, un manège. Il n’y avait pas grande foule, quelques badauds seulement circulaient."
                                            },
                                            {
                                                "example_id": "9b6b9d89-2c67-47c4-9855-36d09c0d7739",
                                                "sense_id": "0386bc83-4a82-3d93-a052-435caac6f1ac",
                                                "text": "Nous étions, en cet instant, comme des badauds qui lisent à l'extérieur la carte du restaurant et s’esbaudissent parce que tout alors paraît bon et possible."
                                            },
                                            {
                                                "example_id": "996495f5-61a2-44a4-9d1c-7563beed9fa0",
                                                "sense_id": "0386bc83-4a82-3d93-a052-435caac6f1ac",
                                                "text": "Les deux complices se gondolaient en leur for intérieur et se payaient la poire des badauds s'imaginant que c'était arrivé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "badaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd42a7e-531a-3a3c-9ec9-4f138d40c690",
                                        "entry_id": "a79dd985-d0cf-33c5-bac1-ed46b9b8469b",
                                        "glosses": [
                                            "Dont la curiosité est un peu naïve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd863de-54c7-40a8-83aa-d084fb0f2165",
                                                "sense_id": "7dd42a7e-531a-3a3c-9ec9-4f138d40c690",
                                                "text": "C’est un homme très badaud."
                                            },
                                            {
                                                "example_id": "5d365d38-1d4b-4755-8b14-ba58c3b0d436",
                                                "sense_id": "7dd42a7e-531a-3a3c-9ec9-4f138d40c690",
                                                "text": "Cette femme semble bien badaude, elle fera sans doute un bon client."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
