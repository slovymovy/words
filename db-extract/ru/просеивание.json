                                        ]
                                    },
                                    {
                                        "sense_id": "5687734c-00bc-3b62-866e-865d32f2b934",
                                        "entry_id": "bc37cd6d-cf22-3799-9bd4-2afc057f3258",
                                        "glosses": [
                                            "Opération consistant à trier les terres fouillées afin d’y retrouver des vestiges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272efc68-a0c5-4c36-9a0c-6304d1639dcf",
                                                "sense_id": "5687734c-00bc-3b62-866e-865d32f2b934",
                                                "text": "Grâce à la récolte minutieuse du moindre ossement et au tamisage fin des terres, on connaît de plus les habitudes alimentaires de l’époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c2b66e-03de-39e3-af22-57655ab362c9",
