{
    "word_family": [
        "anker",
        "verankering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52589c1c-3e1c-3199-a177-a2b42d92012e",
                    "sense_definition": "Vastleggen met een anker, meestal van een schip of boot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schip_verankeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapitein besloot het schip in de baai te <w>verankeren</w>.",
                            "target_lang_translations": {
                                "en": "The captain decided to <w>anchor</w> the ship in the bay."
                            }
                        },
                        {
                            "text": "Ze wilden de boot <w>verankeren</w> voor de storm uitbrak.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>anchor</w> the boat before the storm broke out."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het schip verankeren",
                        "een boot verankeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To secure with an anchor, usually referring to a ship or boat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anchor",
                                "target_lang_sense_clarification": "to secure a boat or ship"
                            },
                            {
                                "target_lang_word": "drop anchor",
                                "target_lang_sense_clarification": "to cast an anchor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a57e43a7-bc7a-3cbf-a13f-f3189687a9d7",
                    "sense_definition": "Stevig vastmaken of figuurlijk een vaste plaats geven in een structuur, beleid of wet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om deze rechten goed in de wet te <w>verankeren</w>.",
                            "target_lang_translations": {
                                "en": "It is important to properly <w>enshrine</w> these rights in law."
                            }
                        },
                        {
                            "text": "De organisatie wil duurzaamheid stevig in de wet <w>verankeren</w>.",
                            "target_lang_translations": {
                                "en": "The organization wants to firmly <w>embed</w> sustainability into the law."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastleggen",
                        "bevestigen"
                    ],
                    "antonyms": [
                        "losmaken"
                    ],
                    "common_phrases": [
                        "in de wet verankeren",
                        "stevig verankeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To fasten securely, or figuratively to establish firmly within a structure, policy, or law."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anchor",
                                "target_lang_sense_clarification": "figuratively establish or fix"
                            },
                            {
                                "target_lang_word": "embed",
                                "target_lang_sense_clarification": "firmly integrate into a system or law"
                            },
                            {
                                "target_lang_word": "enshrine",
                                "target_lang_sense_clarification": "formally protect or fix rights/principles in law"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}