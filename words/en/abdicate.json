{
    "word_family": [
        "abdication",
        "abdicator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "862ae5ac-8398-3f14-9045-f56bbd01ec45",
                    "sense_definition": "To formally give up or renounce a high office, throne, authority, or major responsibility.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "renounce_office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aging king decided to <w>abdicate</w> the throne in favor of his eldest daughter."
                        },
                        {
                            "text": "Leaders should not <w>abdicate</w> responsibility when a major crisis occurs."
                        }
                    ],
                    "synonyms": [
                        "renounce",
                        "relinquish",
                        "resign",
                        "surrender",
                        "give up"
                    ],
                    "antonyms": [
                        "claim",
                        "retain",
                        "maintain",
                        "occupy"
                    ],
                    "common_phrases": [
                        "abdicate the throne",
                        "abdicate responsibility"
                    ]
                },
                {
                    "sense_id": "2eb29a54-1159-3013-858a-41550549206b",
                    "sense_definition": "To formally step down from a throne or high office (used intransitively).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "renounce_office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under immense public pressure, the emperor chose to <w>abdicate</w> rather than face a revolution."
                        },
                        {
                            "text": "The prime minister refused to <w>abdicate</w> despite the growing political scandal."
                        }
                    ],
                    "synonyms": [
                        "resign",
                        "retire",
                        "stand down"
                    ],
                    "antonyms": [
                        "usurp",
                        "seize"
                    ],
                    "common_phrases": [
                        "choose to abdicate",
                        "refuse to abdicate"
                    ]
                },
                {
                    "sense_id": "d9ca87ca-e5f7-30a4-8f47-fb7e18ccefa1",
                    "sense_definition": "To disown, disinherit, or expel a family member, especially a child.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disown_family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, a father had the legal right to <w>abdicate</w> his son for dishonorable behavior."
                        },
                        {
                            "text": "The wealthy merchant threatened to <w>abdicate</w> his heir if he married without permission."
                        }
                    ],
                    "synonyms": [
                        "disown",
                        "disinherit",
                        "cast off"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of disowning a family member is archaic."
                        }
                    ]
                }
            ]
        }
    ]
}