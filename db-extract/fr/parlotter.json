                        "glosses": [
                            "Se livrer à un discours qui n'est qu'une parlotte ; s'adonner à des parlottes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33405bd2-a674-4a3f-847b-2f99f0ff8a71",
                                "sense_id": "52f4a4da-9a7a-3a86-b855-420369b40713",
                                "text": "Le programme ne serait-il pas une éternelle pierre d'achoppement où viendraient se heurter tous ceux qui voudraient agir au lieu de parlotter ?"
                            },
                            {
                                "example_id": "20ea88c1-5c9c-4ce9-918e-2f23220bc6cb",
                                "sense_id": "52f4a4da-9a7a-3a86-b855-420369b40713",
                                "text": "Mon Dieu ! Quelle manie de parlotter quand même avaient tous ces diseurs de bonne aventure !"
                            },
