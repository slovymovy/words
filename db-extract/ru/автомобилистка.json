                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7426e5e-8b55-4fb2-a16c-48b54beb85dd",
                                                "sense_id": "17b39437-8236-3ccf-97d2-ff7bd8d28fe3",
                                                "text": "Viele Autofahrerinnen halten nicht an Stoppschildern."
                                            },
                                            {
                                                "example_id": "617aa1d1-286d-4922-b6f8-4a172a2977f9",
                                                "sense_id": "17b39437-8236-3ccf-97d2-ff7bd8d28fe3",
                                                "text": "„In jedem Fallbericht ist von einer Frau die Rede, genauer von einer Autofahrerin, die angeblich immer wieder ihre Gestalt und ihr Outfit ändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4930d597-a1e7-4fed-bffe-bdc4d4d02caa",
                        "source_entry_id": "9d5a7b57-152e-3757-b04d-e761ff749e25",
                        "source_sense_id": "d00d31ad-c27a-3d94-9b8d-ec949e400a4b",
