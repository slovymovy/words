{
    "word_family": [
        "prancer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43daac53-31f8-33bd-88b6-d48cdce1c2e0",
                    "sense_definition": "To walk or behave in an energetic, confident, or showy manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prance_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excited children began to <w>prance</w> around the living room in their costumes.",
                            "target_lang_translations": {
                                "ru": "Взволнованные дети принялись <w>пританцовывать</w> по гостиной в своих костюмах."
                            }
                        },
                        {
                            "text": "He decided to <w>prance</w> about the stage to get everyone's attention.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>гарцевать</w> по сцене, чтобы привлечь всеобщее внимание."
                            }
                        }
                    ],
                    "synonyms": [
                        "strut",
                        "parade",
                        "frolic"
                    ],
                    "common_phrases": [
                        "prance around",
                        "prance about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить или вести себя энергично, уверенно или демонстративно, красуясь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарцевать",
                                "target_lang_sense_clarification": "двигаться красуясь или привлекая внимание"
                            },
                            {
                                "target_lang_word": "пританцовывать",
                                "target_lang_sense_clarification": "идти или двигаться энергично, с подскоками"
                            },
                            {
                                "target_lang_word": "важничать",
                                "target_lang_sense_clarification": "держаться заносчиво, красоваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f117a70-ed8e-3e93-b09f-7247f06dc1ee",
                    "sense_definition": "Of a horse or other animal: to spring forward on the hind legs or move with high, lively steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prance_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spirited stallion began to <w>prance</w> across the open meadow.",
                            "target_lang_translations": {
                                "ru": "Ретивый жеребец начал <w>гарцевать</w> по открытому лугу."
                            }
                        },
                        {
                            "text": "Spectators watched the horses <w>prance</w> gracefully during the parade.",
                            "target_lang_translations": {
                                "ru": "Зрители наблюдали, как грациозно <w>гарцевали</w> лошади во время парада."
                            }
                        }
                    ],
                    "synonyms": [
                        "caper",
                        "bound"
                    ],
                    "target_lang_definitions": {
                        "ru": "О лошади или другом животном: двигаться гарцующим шагом, скакать или вставать на дыбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарцевать",
                                "target_lang_sense_clarification": "о коне: вытанцовывать, идти игривым шагом"
                            },
                            {
                                "target_lang_word": "вставать на дыбы",
                                "target_lang_sense_clarification": "подниматься на задние ноги"
                            },
                            {
                                "target_lang_word": "скакать",
                                "target_lang_sense_clarification": "двигаться прыжками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc17f9a6-2f47-33cd-9ccf-4349e267f9f2",
                    "sense_definition": "A lively, springing, or swaggering step or movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prance_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked onto the stage with an exaggerated <w>prance</w> to entertain the audience.",
                            "target_lang_translations": {
                                "ru": "Она вышла на сцену с нарочито утрированной <w>гарцующей походкой</w>, чтобы позабавить публику."
                            }
                        },
                        {
                            "text": "There was a joyful <w>prance</w> in his step after he heard the good news.",
                            "target_lang_translations": {
                                "ru": "В его походке появилась радостная <w>пружинистость</w>, когда он услышал хорошую новость."
                            }
                        }
                    ],
                    "synonyms": [
                        "strut",
                        "swagger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оживленная, пружинистая или нарочито важная походка либо движение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарцевание",
                                "target_lang_sense_clarification": "походка с демонстративным шиком"
                            },
                            {
                                "target_lang_word": "подпрыгивающая походка",
                                "target_lang_sense_clarification": "легкий, пружинистый шаг"
                            },
                            {
                                "target_lang_word": "походка вразвалочку",
                                "target_lang_sense_clarification": "демонстративная или заносчивая поступь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}